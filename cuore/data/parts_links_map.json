{
  "_schema": "Explicit mapping tables for the derived parts-to-car view (services/parts_links.py). No vendor data rows: only catalogue section slug prefixes (the part after '--') and part-name patterns, mapped to CUORE system keys (mes.systems), sensor ids (sensors_stelvio_2018.json) and the fuses page. A section or part not listed stays unmatched and is counted as such. Marque/model specifics stay here, not in code.",
  "sections_to_systems": {
    "ignition-spark-plugs": "ignition",
    "battery-battery-tray": "electrical_supply",
    "power-distribution-center": "electrical_supply",
    "generators-alternators": "starting_charging",
    "starters": "starting_charging",
    "fuel-pump": "fuel",
    "fuel-rail": "fuel",
    "fuel-tank": "fuel",
    "fuel-tubes": "fuel",
    "vacuum-canister": "evap",
    "air-cleaner": "air_intake_boost",
    "throttle-body": "air_intake_boost",
    "manifolds-and-vacuum": "air_intake_boost",
    "turbo-and-super-chargers": "air_intake_boost",
    "radiator-and-related-parts-charge-air-cooler": "air_intake_boost",
    "accelerator-pedal": "engine_management",
    "crankcase-ventilation": "pcv",
    "engine-oiling": "lubrication",
    "egr-system": "exhaust_emissions",
    "exhaust-system": "exhaust_emissions",
    "drive-belts": "cooling",
    "water-pump": "cooling",
    "engine-coolant-reservoir": "cooling",
    "transmission-oil-cooler": "cooling",
    "air-conditioner": "hvac",
    "air-ducts": "hvac",
    "automatic-transmission": "transmission_driveline",
    "case-extension-oil-pan": "transmission_driveline",
    "gearshift-controls": "transmission_driveline",
    "oil-pump": "transmission_driveline",
    "valve-body": "transmission_driveline",
    "drive-shaft": "transmission_driveline",
    "front-axle": "transmission_driveline",
    "rear-axle": "transmission_driveline",
    "power-transfer-unit": "transmission_driveline",
    "brake-master-cylinder": "brakes_abs",
    "brake-pedals": "brakes_abs",
    "front-brakes": "brakes_abs",
    "rear-brakes": "brakes_abs",
    "hydraulic-control-unit": "brakes_abs",
    "parking-brake": "brakes_abs",
    "steering-column": "steering",
    "steering-gear": "steering",
    "front-stabilizer-bar": "suspension",
    "front-suspension": "suspension",
    "rear-suspension": "suspension",
    "tire-monitoring-system": "wheels_tpms",
    "wheels-tires-and-hardware": "wheels_tpms",
    "lamps-interior-and-exterior": "lighting",
    "instrument-panel-cluster": "infotainment_cluster",
    "radio-antenna": "infotainment_cluster",
    "navigation": "infotainment_cluster",
    "park-assist": "adas_sensors",
    "wiper-and-washer": "body_comfort",
    "horns": "body_comfort",
    "air-bags": "restraints",
    "seat-belts": "restraints"
  },
  "name_to_systems": [
    {"name": "ignition coil", "system": "ignition"},
    {"name": "purge", "system": "evap"},
    {"name": "leak detection pump|fuel vapor", "system": "evap"}
  ],
  "name_to_sensors": [
    {"name": "^map sensor", "sensors": ["map_sensor"]},
    {"name": "sensor coolant temperature", "sensors": ["coolant_temp"]},
    {"name": "^oxygen sensor", "sensors": ["o2_b1s1", "o2_b1s2"]},
    {"name": "^battery sensor", "sensors": ["ibs"]},
    {"name": "^tire pressure sensor", "sensors": ["tpms_fl", "tpms_fr", "tpms_rl", "tpms_rr"]},
    {"name": "^fuel pressure sensor", "sensors": ["fuel_rail_pressure"]},
    {"name": "^humidity sensor", "sensors": ["humidity_sensor"]},
    {"name": "leak detection pump", "sensors": ["esim"]}
  ],
  "name_to_fuses": [
    {"name": "\\bfuse\\b|\\brelay\\b"}
  ]
}
