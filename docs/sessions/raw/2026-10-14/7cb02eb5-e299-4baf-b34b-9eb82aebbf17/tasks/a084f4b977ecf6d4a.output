me\">\r","+    <span class=\"logo-slot\" role=\"img\" aria-label=\"CUORE logo\"></span>\r","+    CU<span>O</span>RE\r","+  </a>\r","+  {# The header's own tagline echo -- CSS keeps this hidden at every width\r","+     from 400-900px so it can never collide with the wordmark next to it\r","+     (R2's chrome-budget problem, same family as the logo-slot shrink\r","+     above); the hero band (_vbar.html) is the one place the tagline is\r","+     always shown, at every width. #}\r","+  <span class=\"top-tagline\">{{ marque_tagline if marque_tagline is defined and marque_tagline else \"Passion and the joy of driving\" }}</span>\r","+  <span class=\"profile\" title=\"Which half of the system this is\">{{ profile }}</span>\r","+  <button type=\"button\" id=\"theme-toggle\" class=\"icon-btn\" aria-label=\"Toggle dark/light theme\"\r","+          title=\"Toggle dark/light theme\">&#9680;</button>\r","+  <button type=\"button\" class=\"icon-btn no-print\" aria-label=\"Print this page\"\r","+          title=\"Print this page\" onclick=\"window.print()\">&#128424;</button>\r","+  <details class=\"navmenu\">\r","+    <summary class=\"icon-btn menu-btn\" aria-label=\"Menu\">&#9776;</summary>\r","+    <nav>\r","+      <a class=\"navutil\" href=\"/start\">Start</a>\r","+      <div class=\"navgroup\" title=\"A car's log history, read from the MES corpus\">\r","+        <a href=\"/vehicles\">Vehicles</a>\r","+        <a href=\"/modules\">Modules</a>\r","+        <a href=\"/recordings\">Recordings</a>\r","+        <a href=\"/logs\">Logs</a>\r","+      </div>\r","+      <div class=\"navgroup live\" title=\"The adapter, right now\">\r","+        <a href=\"/live\">Live link</a>\r","+        <a href=\"/coverage\">Coverage</a>\r","+      </div>\r","+      <a class=\"navutil\" href=\"/tools\">Tools</a>\r","+    </nav>\r","+  </details>\r","+</header>\r","+\r","+{% set vb %}{% block vehiclebar %}{% endblock %}{% endset %}\r","+{% if vb.strip() %}\r","+  {{ vb }}\r","+{% elif live_strip %}\r","+<div class=\"livestrip\" title=\"The live link's state — click through for the full picture\">\r","+  <a href=\"/live\">\r","+    {% if live_strip.error %}\r","+      <span class=\"chip plain\">live link unavailable</span> {{ live_strip.error }}\r","+    {% else %}\r","+      <span class=\"chip {{ 'ok' if live_strip.mes_state != 'connected' else 'returned' }}\">\r","+        MES {{ live_strip.mes_state or 'unknown' }}</span>\r","+      <span class=\"mono\">{{ live_strip.port or 'no port' }}{% if live_strip.baud %}@{{ live_strip.baud }}{% endif %}</span>\r","+      <span class=\"chip plain\">cable {{ live_strip.cable or 'none' }}</span>\r","+      <span class=\"small muted\">{{ live_strip.buses_verified }}/{{ live_strip.buses_total }} buses verified</span>\r","+      {% if live_strip.lock_holder and live_strip.lock_holder != 'cuore' %}\r","+        <span class=\"chip returned\">held by {{ live_strip.lock_holder }}</span>\r","+      {% endif %}\r","+    {% endif %}\r","+  </a>\r","+</div>\r","+{% endif %}\r","+\r","+<main>\r","+{% block content %}{% endblock %}\r","+\r","+<div class=\"foot\">\r","+  <span>CUORE {{ version }}</span>\r","+  <span>profile {{ profile }}</span>\r","+  <span>Simulation logs excluded unless asked for</span>\r","+  <span><kbd>?</kbd> keys</span>\r","+  <span class=\"muted\"><a href=\"/api/docs\" class=\"muted\">Developer API</a></span>\r","+</div>\r","+\r","+<div class=\"panel\" id=\"keyhelp\" hidden>\r","+  <h2>Keyboard</h2>\r","+  <table>\r","+    <tr><td class=\"k\"><kbd>g</kbd> <kbd>v</kbd></td><td>Vehicles</td></tr>\r","+    <tr><td class=\"k\"><kbd>g</kbd> <kbd>m</kbd></td><td>Modules</td></tr>\r","+    <tr><td class=\"k\"><kbd>g</kbd> <kbd>r</kbd></td><td>Recordings</td></tr>\r","+    <tr><td class=\"k\"><kbd>g</kbd> <kbd>l</kbd></td><td>Logs</td></tr>\r","+    <tr><td class=\"k\"><kbd>/</kbd></td><td>Focus the filter box</td></tr>\r","+    <tr><td class=\"k\"><kbd>j</kbd> <kbd>k</kbd></td><td>Move through rows</td></tr>\r","+    <