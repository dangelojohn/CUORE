mary(state, open_work, cleared_at, dossier)\n699:        \"cleared_at\": cleared_at.split(\" \")[0] if cleared_at else None,\n801:        date = _short_date(readiness.get(\"at\")) or verdict.get(\"cleared_at\") or \"the last read\"\n925:def _code_status(base: str, last_seen: str | None, cleared_at: str | None,\n931:    if cleared_at and last_seen and last_seen > cleared_at:\n933:    if base in last_findings and not (cleared_at and last_findings_ts\n934:                                      and cleared_at >= last_findings_ts):\n936:    if cleared_at and base in codes_cleared and (not last_seen or last_seen <= cleared_at):\n938:    if cleared_at is None and last_seen and last_seen in recent_ts[:3]:\n943:def _code_rows(vin: str, dossier: dict[str, Any], cleared_at: str | None,\n944:              clear_assessment: dict[str, Any] | None, recent_ts: list[str],\n954:    codes_cleared = {_base(c) for c in (clear_assessment or {}).get(\"codes_cleared\", [])}\n956:                      (clear_assessment or {}).get(\"codes_returned_in_session\", [])}\n958:                       (clear_assessment or {}).get(\"codes_that_would_not_clear\", [])}\n966:            status = _code_status(base, last_seen, cleared_at, codes_cleared,\n1211:    cleared_at, _cleared_by, clear_assessment = _clear_info(dossier)\n1213:    live_modules = _live_module_dtcs(vin, cleared_at)\n1226:    codes, code_counts = _code_rows(vin, dossier, cleared_at, clear_assessment,\n1235:        \"live_freeze_frames\": _build_live_freeze_frames(vin, cleared_at),\n1236:        \"mode06\": _build_mode06_view(vin, cleared_at),","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"serverClassifierContext":{"request":"c1b690ec-d489-4b3c-a01c-0e369f28abbb","context":{"git_state":{"cwd":"/c/Users/User/mcp-servers","root":null,"branch":null,"default_branch":null,"status":null,"visibility":null,"error":"pending"},"live_cwd":"/c/Users/User/mcp-servers","platform":"windows"}},"sourceToolAssistantUUID":"4c47