he live-observation schema yet -- ``since_clear``\n#: only carries ``mil_on``/``stored_dtc_count``/the monitor list. This is\n#: the one value read directly off the car in the same 2026-10-13 20:03\n#: session as the readiness observation below; it belongs here, not\n#: invented into that schema, until a PID $21 reader exists.\n_MIL_DISTANCE_KM: dict[str, float] = {\"ZASFAKPN5J7B88115\": 34}\n\n\ndef _mil_short_date(ts: str | None) -> str | None:\n    \"\"\"Normalize an ISO (``T``-separated) or bare-date timestamp to the\n    space form :func:`_short_date` expects, then format it -- kept local to\n    this block so the shared ``_parse_ts``/``_short_date`` helpers (which\n    only accept ``\"YYYY-MM-DD HH:MM:SS\"``) stay untouched.\"\"\"\n    if not ts:\n        return None\n    t = str(ts).replace(\"T\", \" \")\n    has_time = len(t) > 10\n    if not has_time:\n        t += \" 00:00:00\"\n    return _short_date(t, with_time=has_time)\n\n\ndef _first_mil_commanded(vin: str, after: str | None) -> dict[str, Any] | None:\n    \"\"\"The earliest from-car readiness observation after ``after`` (the\n    last clear) whose ``since_clear.mil_on`` is true -- when the ECM first\n    reported requesting the lamp since that clear, not merely the newest\n    time it still was. Never raises -- a broken store must never break the\n    verdict.\"\"\"\n    try:\n        obs = live_store.recent_observations(300, vin=vin, kind=\"readiness\")\n    except Exception:  # noqa: BLE001\n        return None\n    best = None\n    for o in obs:\n        if not live_store.is_from_car(o):\n            continue\n        at = o.get(\"at\") or \"\"\n        if after and at <= after:\n            continue\n        since = (o.get(\"data\") or {}).get(\"since_clear\") or {}\n        if not since.get(\"mil_on\"):\n            continue\n        if best is None or at < (best.get(\"at\") or \"\"):\n            best = o\n    return best\n\n\ndef _latest_dash_lamp_report(vin: str, after: str | None) -> dict[str, Any] | None:\n    \"\"\"The newest owner-reported ``incidents/warning_light_seen`` event for\n    this car, after ``after`` -- an ATTESTED statement, never a car\n    measurement (see ``cuore.live.owner_events``). Never raises.\"\"\"\n    try:\n        from ..live import owner_events as owner_events_store\n        rows = owner_events_store.load(vin)\n    except Exception:  # noqa: BLE001\n        return None\n    best = None\n    cleared_date = (after or \"\").split(\" \")[0].split(\"T\")[0]\n    for r in rows:\n        if r.get(\"category\") != \"incidents\" or r.get(\"kind\") != \"warning_light_seen\":\n            continue\n        at = str(r.get(\"at\") or \"\")\n        if cleared_date and at and at.split(\"T\")[0] < cleared_date:\n            # An attestation dated before the clear says nothing about the\n            # lamp's state since it.\n            continue\n        if best is None or at >= str(best.get(\"at\") or \"\"):\n            best = r\n    return best\n\n\ndef _build_mil_block(vin: str, cleared_at: str | None) -> dict[str, Any] | None:\n    \"\"\"The MIL-vs-dash-lamp finding for the Bench/Report MIL block, or\n    ``None`` when the car has not reported the MIL commanded on at all.\"\"\"\n    ecm = _first_mil_commanded(vin, cleared_at)\n    if ecm is None:\n        return None\n    ecm_since_short = _mil_short_date(ecm.get(\"at\"))\n    km = _MIL_DISTANCE_KM.get(vin)\n\n    dash = _latest_dash_lamp_report(vin, cleared_at)\n    dash_text = None\n    dash_attested_short = None\n    if dash is not None:\n        fields = dash.get(\"fields\") or {}\n        dash_text = fields.get(\"how_long\") or fields.get(\"which\")\n        dash_attested_short = _mil_short_date(str(dash.get(\"at\") or \"\"))\n\n    mismatch = bool(dash_text and \"not\" in dash_text.lower())\n\n    ecm_line = f\"ECM: MIL commanded ON since {ecm_since_short}\"\n    if km is not None:\n        ecm_line += f\", {km:g} km with MIL (read from the car {ecm_since_short})\"\n    dash_line = f\"Dash lamp: owner reports {dash_text or 'no report on file'}\"\n    if dash_attested_short:\n        dash_line += f\" (attested {dash_attested_short})\"\n\n    explanations = [\n        {\"text\": (\"the cluster did not receive or show the request (IPC has \"\n                  \"U1736-86/87 history, BCM U1713-2F failing now -- the MIL \"\n                  \"request travels over the bus)\"),\n         \"tests\": [\"mil_request_vs_lamp\", \"ipc_mil_status_read\"]},\n        {\"text\": \"lamp/bulb-check failure\", \"tests\": [\"mil_bulb_check\"]},\n        {\"text\": \"owner did not notice\", \"tests\": []},\n    ]\n\n    next_action_note = None\n    if mismatch:\n        next_action_note = (\n            \"The ECM is commanding the MIL on but the owner reports the dash lamp \"\n            \"has not lit -- consistent with a cluster/bus communication issue (IPC \"\n            \"U1736-86/87 history, BCM U1713-2F failing now), a bulb-check failure, \"\n            \"or simply not being noticed. Run mil_request_vs_lamp and \"\n            \"mil_bulb_check to settle it.\")\n\n    return {\n        \"ecm_mil_on_since\": ecm.get(\"at\"),\n        \"ecm_line\": ecm_line,\n        \"dash_line\": dash_line,\n        \"dash_reported\": dash_text,\n        \"dash_attested_at\": dash_attested_short,\n        \"mismatch\": mismatch,\n        \"explanations\": explanations,\n        \"next_action_note\": next_action_note,\n    }\n\n\ndef _build_verdict(vin: str, dossier: dict[str, Any], live_status: dict[str, Any] | None,","originalFile":null,"structuredPatch":[{"oldStart":587,"oldLines":6,"newStart":587,"newLines":146,"lines":["     return f\"{code_str} cleared {cleared_short}; monitors have not re-run. Not proof of repair.\""," "," ","+# --- MIL (check-engine lamp) vs ECM-commanded MIL ---------------------------","+#","+# Added 2026-10-14 (MIL diagnostics). The ECM's own PID $01 MIL bit and the","+# owner's own eyes disagree after the 2026-10-08 clear: the car reports the","+# lamp commanded on (read 2026-10-13 20:03), the owner reports never seeing","+# it lit since. Neither side resolves that alone -- this only files what","+# each side actually said, plus the three ordered, hedged explanations a","+# mechanic would check before touching anything, each paired with the test","+# that settles it (see mes.mechanic_tests: mil_bulb_check,","+# mil_request_vs_lamp, ipc_mil_status_read). It never states which","+# explanation is right -- that is exactly what those tests are for.","+","+#: Mode 01 PID $21 (distance travelled with the MIL commanded on) has no","+#: dedicated field in the live-observation schema yet -- ``since_clear``","+#: only carries ``mil_on``/``stored_dtc_count``/the monitor list. This is","+#: the one value read directly off the car in the same 2026-10-13 20:03","+#: session as the readiness observation below; it belongs here, not","+#: invented into that schema, until a PID $21 reader exists.","+_MIL_DISTANCE_KM: dict[str, float] = {\"ZASFAKPN5J7B88115\": 34}","+","+","+def _mil_short_date(ts: str | None) -> str | None:","+    \"\"\"Normalize an ISO (``T``-separated) or bare-date timestamp to the","+    space form :func:`_short_date` expects, then format it -- kept local to","+    this block so the shared ``_parse_ts``/``_short_date`` helpers (which","+    only accept ``\"YYYY-MM-DD HH:MM:SS\"``) stay untouched.\"\"\"","+    if not ts:","+        return None","+    t = str(ts).replace(\"T\", \" \")","+    has_time = len(t) > 10","+    if not has_time:","+        t += \" 00:00:00\"","+    return _short_date(t, with_time=has_time)","+","+","+def _first_mil_commanded(vin: str, after: str | None) -> dict[str, Any] | None:","+    \"\"\"The earliest from-car readiness observation after ``after`` (the","+    last clear) whose ``since_clear.mil_on`` is true -- when the ECM first","+    reported requesting the lamp since that clear, not merely the newest","+    time it still was. Never raises -- a broken store must never break the","+    verdict.\"\"\"","+    try:","+        obs = live_store.recent_observations(300, vin=vin, kind=\"readiness\")","+    except Exception:  # noqa: BLE001","+        return None","+    best = None","+    for o in obs:","+        if not live_store.is_from_car(o):","+            continue","+        at = o.get(\"at\") or \"\"","+        if after and at <= after:","+            continue","+        since = (o.get(\"data\") or {}).get(\"since_clear\") or {}","+        if not since.get(\"mil_on\"):","+            continue","+        if best is None or at < (best.get(\"at\") or \"\"):","+            best = o","+    return best","+","+","+def _latest_dash_lamp_report(vin: str, after: str | None) -> dict[str, Any] | None:","+    \"\"\"The newest owner-reported ``incidents/warning_light_seen`` event for","+    this car, after ``after`` -- an ATTESTED statement, never a car","+    measurement (see ``cuore.live.owner_events``). Never raises.\"\"\"","+    try:","+        from ..live import owner_events as owner_events_store","+        rows = owner_events_store.load(vin)","+    except Exception:  # noqa: BLE001","+        return None","+    best = None","+    cleared_date = (after or \"\").split(\" \")[0].split(\"T\")[0]","+    for r in rows:","+        if r.get(\"category\") != \"incidents\" or r.get(\"kind\") != \"warning_light_seen\":","+            continue","+        at = str(r.get(\"at\") or \"\")","+        if cleared_date and at and at.split(\"T\")[0] < cleared_date:","+            # An attestation dated before the clear says nothing about the","+            # lamp's state since it.","+            continue","+        if best is None or at >= str(best.get(\"at\") or \"\"):","+            best = r","+    return best","+","+","+def _build_mil_block(vin: str, cleared_at: str | None) -> dict[str, Any] | None:","+    \"\"\"The MIL-vs-dash-lamp finding for the Bench/Report MIL block, or","+    ``None`` when the car has not reported the MIL commanded on at all.\"\"\"","+    ecm = _first_mil_commanded(vin, cleared_at)","+    if ecm is None:","+        return None","+    ecm_since_short = _mil_short_date(ecm.get(\"at\"))","+    km = _MIL_DISTANCE_KM.get(vin)","+","+    dash = _latest_dash_lamp_report(vin, cleared_at)","+    dash_text = None","+    dash_attested_short = None","+    if dash is not None:","+        fields = dash.get(\"fields\") or {}","+        dash_text = fields.get(\"how_long\") or fields.get(\"which\")","+        dash_attested_short = _mil_short_date(str(dash.get(\"at\") or \"\"))","+","+    mismatch = bool(dash_text and \"not\" in dash_text.lower())","+","+    ecm_line = f\"ECM: MIL commanded ON since {ecm_since_short}\"","+    if km is not None:","+        ecm_line += f\", {km:g} km with MIL (read from the car {ecm_since_short})\"","+    dash_line = f\"Dash lamp: owner reports {dash_text or 'no report on file'}\"","+    if dash_attested_short:","+        dash_line += f\" (attested {dash_attested_short})\"","+","+    explanations = [","+        {\"text\": (\"the cluster did not receive or show the request (IPC has \"","+                  \"U1736-86/87 history, BCM U1713-2F failing now -- the MIL \"","+                  \"request travels over the bus)\"),","+         \"tests\": [\"mil_request_vs_lamp\", \"ipc_mil_status_read\"]},","+        {\"text\": \"lamp/bulb-check failure\", \"tests\": [\"mil_bulb_check\"]},","+        {\"text\": \"owner did not notice\", \"tests\": []},","+    ]","+","+    next_action_note = None","+    if mismatch:","+        next_action_note = (","+            \"The ECM is commanding the MIL on but the owner reports the dash lamp \"","+            \"has not lit -- consistent with a cluster/bus communication issue (IPC \"","+            \"U1736-86/87 history, BCM U1713-2F failing now), a bulb-check failure, \"","+            \"or simply not being noticed. Run mil_request_vs_lamp and \"","+            \"mil_bulb_check to settle it.\")","+","+    return {","+        \"ecm_mil_on_since\": ecm.get(\"at\"),","+        \"ecm_line\": ecm_line,","+        \"dash_line\": dash_line,","+        \"dash_reported\": dash_text,","+        \"dash_attested_at\": dash_attested_short,","+        \"mismatch\": mismatch,","+        \"explanations\": explanations,","+        \"next_action_note\": next_action_note,","+    }","+","+"," def _build_verdict(vin: str, dossier: dict[str, Any], live_status: dict[str, Any] | None,","                    open_work: list[dict[str, Any]]) -> dict[str, Any]:","     identity = dossier.get(\"identity\") or {}"]}],"userModified":false,"replaceAll":false,"contentNotInModelContext":true},"serverClassifierContext":{"request":"becafa0e-b4b1-4b4f-8063-58b8bb458b6c","context":{"git_state":{"cwd":"/c/Users/User/mcp-servers","root":null,"branch":null,"default_branch":null,"status":null,"visibility":null,"error":"pending"},"live_cwd":"/c/Users/User/mcp-servers","platform":"windows"}},"sourceToolAssistantUUID":"bd1f511e-0546-4843-9a99-4c7ea02beca9","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
