 not log.clear_results:","+                continue","+        elif e.kind == \"fes\":","+            try:","+                log = fes_mod.load_fes(e.path, timestamp=e.timestamp)","+            except Exception:","+                continue","+            if not log.clear_events:","+                continue","+        else:","+            continue","+        ts = str(e.timestamp)","+        if best is None or ts > best[0]:","+            best = (ts, e, log)","+    return best","+","+","+def _nearest_entry_after(entries: list[Any], ts: str, exclude_name: str) -> Any | None:","+    \"\"\"The chronologically-nearest log entry strictly after ``ts``, if any.\"\"\"","+    best = None","+    for e in entries:","+        if e.parse_error or not e.timestamp or e.name == exclude_name:","+            continue","+        et = str(e.timestamp)","+        if et <= ts:","+            continue","+        if best is None or et < str(best.timestamp):","+            best = e","+    return best","+","+","+def _clear_dict_from_global(entries: list[Any], entry: Any, log: Any,","+                            ts: str) -> dict[str, Any]:","+    \"\"\"Build the ``clear_assessment`` dict for a clear found by","+    :func:`_newest_global_clear`, in the same shape ``_scan_clear_between``","+    and :class:`analysis.ClearAssessment` already produce, so every reader","+    of ``current_picture.clear_assessment`` keeps working unchanged.","+    \"\"\"","+    if entry.kind == \"fes\":","+        ca = analysis.post_clear_assessment(log)","+        if ca:","+            return ca.to_dict()","+        return {","+            \"source\": entry.name, \"cleared_at\": ts, \"codes_cleared\": [],","+            \"verdict\": f\"Codes were cleared in {entry.name} at {ts}.\",","+            \"next_step\": \"Drive until the monitors re-run, then re-check.\",","+        }","+","+    # SCAN: a module's clear can be reported more than once in one file when","+    # an earlier clear attempt is incomplete (announced but cut short by a","+    # rescan) before a second attempt actually completes -- as on","+    # 2026-10-08, where the Engine/ECM block appears once with no result at","+    # all and again with SUCCESS. The last reported result per module is","+    # the one that actually happened.","+    last_by_key: dict[str, Any] = {}","+    for m in log.clear_results:","+        last_by_key[m.key] = m","+    ok = [m.name for m in last_by_key.values() if (m.clear_result or \"\").upper() == \"SUCCESS\"]","+    refused = {m.name: [x.full for x in m.dtcs] for m in last_by_key.values()","+               if (m.clear_result or \"\").upper() != \"SUCCESS\"}","+    codes_cleared = sorted({d.full for d in log.all_dtcs})","+","+    nxt = _nearest_entry_after(entries, ts, entry.name)","+    re_read_after_clear = False","+    tail_note = \"\"","+    if nxt is not None:","+        try:","+            if nxt.kind == \"scan\":","+                nlog = scan_mod.load_scan(nxt.path, timestamp=nxt.timestamp)","+                still_present = {d.full for d in nlog.all_dtcs} & set(codes_cleared)","+            else:","+                nlog = fes_mod.load_fes(nxt.path, timestamp=nxt.timestamp)","+                still_present = {d.full for d in nlog.dtcs} & set(codes_cleared)","+            re_read_after_clear = True","+            if still_present:","+                tail_note = (f\" {nxt.name} at {nxt.timestamp} still shows \"","+                             f\"{', '.join(sorted(still_present))} -- not cleared.\")","+            else:","+                tail_note = (f\" {nxt.name} at {nxt.timestamp} read clean. This is NOT \"","+                             f\"proof of repair: after a clear the ECU reports nothing \"","+                             f\"until the monitor that governs the code actually re-runs.\")","+        except Exception:","+            pass","+","+    return {","+        \"source\": entry.name,","+        \"cleared_at\": ts,","+        \"modules_cleared\": ok,","+        \"modules_refused\": refused,","+        \"codes_cleared\": codes_cleared,","+        \"re_read_after_clear\": re_read_after_clear,","+        \"verdict\": (f\"Codes were cleared by the all-systems scan {entry.name} at {ts} \"","+                    f\"({', '.join(codes_cleared) if codes_cleared else 'no codes listed'}).\"","+                    + tail_note),","+        \"next_step\": (\"Drive until the monitors re-run (EVAP: fuel 15-85 %, cold starts, \"","+                      \"several drives), then read the status bytes (verify_repair) or \"","+                      \"re-scan. A returning code is the answer; silence right after a \"","+                      \"clear is not.\"),","+    }","+","+"," def build(vin: str = \"\", vehicle: str = \"\",","           name: str = \"\") -> dict[str, Any]:","     \"\"\"Assemble the full workup for one vehicle."]}],"userModified":false,"replaceAll":false,"contentNotInModelContext":true},"serverClassifierContext":{"request":"ff6c244f-fb0f-43de-bbbc-516826f041c6","context":{"git_state":{"cwd":"/c/Users/User/mcp-servers","root":null,"branch":null,"default_branch":null,"status":null,"visibility":null,"error":"pending"},"live_cwd":"/c/Users/User/mcp-servers","platform":"windows"}},"sourceToolAssistantUUID":"00fa66e1-b73d-4bf4-9187-2485ad74b5f4","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
