=\"stylesheet\" href=\"{{ static_url('flow.css') }}\">","-<link rel=\"stylesheet\" href=\"{{ static_url('icons.css') }}\">","-<link rel=\"stylesheet\" href=\"{{ static_url('print.css') }}\" media=\"print\">","-</head>","-<body{% if vin is defined and vin %} data-vin=\"{{ vin }}\"{% endif %}>","-","-{% include \"_intro.html\" %}","-","-<header class=\"top\">","-  <a class=\"brand\" href=\"/\" aria-label=\"CUORE, home\">","-    <span class=\"logo-slot\" role=\"img\" aria-label=\"CUORE logo\"></span>","-    CU<span>O</span>RE","-  </a>","-  {# The header's own tagline echo -- CSS keeps this hidden at every width","-     from 400-900px so it can never collide with the wordmark next to it","-     (R2's chrome-budget problem, same family as the logo-slot shrink","-     above); the hero band (_vbar.html) is the one place the tagline is","-     always shown, at every width. #}","-  <span class=\"top-tagline\">{{ marque_tagline if marque_tagline is defined and marque_tagline else \"Passion and the joy of driving\" }}</span>","-  <span class=\"profile\" title=\"Which half of the system this is\">{{ profile }}</span>","-  <button type=\"button\" id=\"theme-toggle\" class=\"icon-btn\" aria-label=\"Toggle dark/light theme\"","-          title=\"Toggle dark/light theme\">&#9680;</button>","-  <button type=\"button\" class=\"icon-btn no-print\" aria-label=\"Print this page\"","-          title=\"Print this page\" onclick=\"window.print()\">&#128424;</button>","-  <details class=\"navmenu\">","-    <summary class=\"icon-btn menu-btn\" aria-label=\"Menu\">&#9776;</summary>","-    <nav>","-      <a class=\"navutil\" href=\"/start\">Start</a>","-      <div class=\"navgroup\" title=\"A car's log history, read from the MES corpus\">","-        <a href=\"/vehicles\">Vehicles</a>","-        <a href=\"/modules\">Modules</a>","-        <a href=\"/recordings\">Recordings</a>","-        <a href=\"/logs\">Logs</a>","-      </div>","-      <div class=\"navgroup live\" title=\"The adapter, right now\">","-        <a href=\"/live\">Live link</a>","-        <a href=\"/coverage\">Coverage</a>","-      </div>","-      <a class=\"navutil\" href=\"/tools\">Tools</a>","-    </nav>","-  </details>","-</header>","-","-{% set vb %}{% block vehiclebar %}{% endblock %}{% endset %}","-{% if vb.strip() %}","-  {{ vb }}","-{% elif live_strip %}","-<div class=\"livestrip\" title=\"The live link's state — click through for the full picture\">","-  <a href=\"/live\">","-    {% if live_strip.error %}","-      <span class=\"chip plain\">live link unavailable</span> {{ live_strip.error }}","-    {% else %}","-      <span class=\"chip {{ 'ok' if live_strip.mes_state != 'connected' else 'returned' }}\">","-        MES {{ live_strip.mes_state or 'unknown' }}</span>","-      <span class=\"mono\">{{ live_strip.port or 'no port' }}{% if live_strip.baud %}@{{ live_strip.baud }}{% endif %}</span>","-      <span class=\"chip plain\">cable {{ live_strip.cable or 'none' }}</span>","-      <span class=\"small muted\">{{ live_strip.buses_verified }}/{{ live_strip.buses_total }} buses verified</span>","-      {% if live_strip.lock_holder and live_strip.lock_holder != 'cuore' %}","-        <span class=\"chip returned\">held by {{ live_strip.lock_holder }}</span>","-      {% endif %}","-    {% endif %}","-  </a>","-</div>","-{% endif %}","-","-<main>","-{% block content %}{% endblock %}","-","-<div class=\"foot\">","-  <span>CUORE {{ version }}</span>","-  <span>profile {{ profile }}</span>","-  <span>Simulation logs excluded unless asked for</span>","-  <span><kbd>?</kbd> keys</span>","-  <span class=\"muted\"><a href=\"/api/docs\" class=\"muted\">Developer API</a></span>","-</div>","-","-<div class=\"panel\" id=\"keyhelp\" hidden>","-  <h2>Keyboard</h2>","-  <table>","-    <tr><td class=\"k\"><kbd>g</kbd> <kbd>v</kbd></td><td>Vehicles</td></tr>","-    <tr><td class=\"k\"><kbd>g</kbd> <kbd>m</kbd></td><td>Modules</td></tr>","-    <tr><td class=\"k\"><kbd>g</kbd> <kbd>r</kbd></td><td>Recordin