odule's docstring) via a","-   page-local `exp = experience_links(...)` set before this include.","+   published about a code, family or job, merged with whatever a driver or","+   mechanic has typed in themselves. Fed by the `experience_links` Jinja","+   global (registered as an import-time side effect by","+   cuore/web/experience_globals.py -- see that module's docstring, and","+   cuore/services/experience_bridge.py for the merge/tier/score contract)","+   via a page-local `exp = experience_links(...)` set before this include.","    Guarded so a page still renders -- with the empty state below -- before","    that global lands, and before mes.experience itself lands."," ","    Collapsed by default (<details class=\"card-details\">, no `open`) so the","    card doesn't crowd the page; the summary names the count and teases the","    top-scored link. Inside, four view links (?exp=relevant|videos|forums|","-   newest) re-render the already-scored list filtered/sorted without any","-   JS -- `request` is only defined when a route passes it into the","-   template context (it always does via `TemplateResponse(request, ...)`),","-   so this degrades to the default \"relevant\" view if it isn't. #}","-{% set exp = exp if exp is defined else {\"links\": [], \"count\": 0} %}","+   newest) re-render the already-tiered-then-scored list filtered/sorted","+   without any JS -- `request` is only defined when a route passes it into","+   the template context (it always does via `TemplateResponse(request,","+   ...)`), so this degrades to the default \"relevant\" view if it isn't.","+","+   The \"+ Add what you found\" form and every row's Edit/Delete/Flag/Worked","+   control are plain HTML (so the card still works with JS off, as a dead","+   end -- \"could not load, try again\" -- same posture as feedback.js's own","+   fallback note) enhanced by cuore/web/static/experience.js, which does","+   the actual fetch() round-trip to /api/experience/... and re-renders the","+   row in place. `vin` here is read from `document.body.dataset.vin` by","+   that script (same trick feedback.js uses), not from this template's own","+   `vin` variable -- the six call sites that include this partial use six","+   different variable names for the current code/family/job, which this","+   block also tries defensively (`is defined` guards) to prefill the","+   \"+ Add\" form's scope fields; a page with none of them just leaves scope","+   blank for the owner to fill in. #}","+{% set exp = exp if exp is defined else {\"links\": [], \"count\": 0, \"counts\": {}} %}"," {% set _exp_mode = (request.query_params.get('exp') if request is defined and request else none) or \"relevant\" %}"," ","+{% set _exp_scope_code = code if code is defined and code else \"\" %}","+{% set _exp_scope_family = _family if _family is defined and _family else (c.key if c is defined and c.key is defined else (_fam_key if _fam_key is defined and _fam_key else (job.family if job is defined and job.family is defined and job.family else \"\"))) %}","+{% set _exp_scope_job = _job if _job is defined and _job else (job.key if job is defined and job.key is defined and job.key else \"\") %}","+"," {% set _exp_kind_icon = {","   \"how_to_video\": \"[video]\",","   \"teardown\": \"[teardown]\",","   \"forum_thread\": \"[forum]\",","   \"owner_report\": \"[report]\",","-  \"sound_reference\": \"[sound]\"","+  \"sound_reference\": \"[sound]\",","+  \"video\": \"[video]\",","+  \"forum\": \"[forum]\",","+  \"article\": \"[article]\",","+  \"manual\": \"[manual]\",","+  \"audio\": \"[sound]\",","+  \"photo\": \"[photo]\",","+  \"note\": \"[note]\""," } %}"," ","+{% set _exp_role_label = {\"cuore\": \"CUORE curated\", \"mechanic\": \"Mechanic\", \"driver\": \"Driver\", \"owner\": \"Owner\"} %}","+{% set _exp_role_chip_class = {\"cuore\": \"ok\", \"mechanic\": \"warn\", \"driver\": \"plain\", \"owner\": \"plain\"} %}","+"," {% if _exp_mode == \"videos\" %}","-  {% set _exp_shown = exp.links|selectattr(\"kind\", \"equalto\", \"how_to_video\")|list %}","+  {% set _exp_shown = exp.links|selectattr(\"kind\", \"in\", [\"how_to_video\", \"video\"])|list %}"," {% elif _exp_mode == \"forums\" %}","-  {% set _exp_shown = exp.links|selectattr(\"kind\", \"equalto\", \"forum_thread\")|list %}","+  {% set _exp_shown = exp.links|selectattr(\"kind\", \"in\", [\"forum_thread\", \"forum\"])|list %}"," {% elif _exp_mode == \"newest\" %}","   {% set _exp_shown = exp.links|sort(attribute=\"date\", reverse=true)|list %}"," {% else %}","   {% set _exp_shown = exp.links %}"," {% endif %}"," ","-<div class=\"panel experience-card\">","+{% set _exp_counts = exp.counts or {} %}","+{% set _exp_count_bits = [] %}","+{% if _exp_counts.get(\"curated\") %}{% set _ = _exp_count_bits.append(_exp_counts[\"curated\"]|string ~ \" curated\") %}{% endif %}","+{% if _exp_counts.get(\"mechanic\") %}{% set _ = _exp_count_bits.append(_exp_counts[\"mechanic\"]|string ~ \" mechanic\") %}{% endif %}","+{% if _exp_counts.get(\"driver\") %}{% set _ = _exp_count_bits.append(_exp_counts[\"driver\"]|string ~ \" driver\") %}{% endif %}","+{% if _exp_counts.get(\"owner\") %}{% set _ = _exp_count_bits.append(_exp_counts[\"owner\"]|string ~ \" owner\") %}{% endif %}","+","+<div class=\"panel experience-card\" data-exp-card","+    data-exp-scope-code=\"{{ _exp_scope_code }}\" data-exp-scope-family=\"{{ _exp_scope_family }}\"","+    data-exp-scope-job=\"{{ _exp_scope_job }}\">","   {% if not exp.links %}","   <h3>Others' experience</h3>","   <p class=\"muted small\">No experience links yet for this item.</p>","   {% else %}","   <details class=\"card-details\">","-    <summary>Others' experience ({{ exp.count }}) &mdash; {{ exp.links[0].title }}</summary>","+    <summary>Others' experience ({{ exp.count }}){% if _exp_count_bits %} &mdash; {{ _exp_count_bits|join(\" &middot; \")|safe }}{% endif %}</summary>","     <p class=\"small muted exp-views\">","       view:","       <a href=\"?exp=relevant\">relevant</a> &middot;"]},{"oldStart":48,"oldLines":8,"newStart":86,"newLines":9,"lines":["       <a href=\"?exp=forums\">forums</a> &middot;","       <a href=\"?exp=newest\">newest</a>","     </p>","+    <div data-exp-list>","     {% for l in _exp_shown %}","-      <div class=\"exp-row\">","+      <div class=\"exp-row\" data-exp-row data-exp-id=\"{{ l.id }}\" data-exp-curated=\"{{ 'true' if l.curated else 'false' }}\">","         <span class=\"small muted\">#{{ loop.index }}</span>","         <span class=\"small\">{{ _exp_kind_icon.get(l.kind, \"[link]\") }}</span>","         <div class=\"exp-main\">"]},{"oldStart":57,"oldLines":12,"newStart":96,"newLines":75,"lines":["           <div class=\"small muted\">{{ l.source }}{% if l.date %} &middot; {{ l.date }}{% endif %}</div>","           {% if l.reason %}<div class=\"small muted\">{{ l.reason }}</div>{% endif %}","           {% if l.label %}<div class=\"small muted\">{{ l.label }}</div>{% endif %}","+          <div class=\"small muted exp-attrib\">","+            Found by {{ _exp_role_label.get((l.found_by or {}).get(\"role\"), \"Owner\") }}{% if (l.found_by or {}).get(\"name\") %} &middot; {{ l.found_by.name }}{% endif %}{% if l.found_at %} &middot; {{ l.found_at[:10] }}{% endif %}","+          </div>","+          {% if l.note %}<div class=\"small exp-note\" data-exp-note>{{ l.note }}</div>{% endif %}","+          {% if l.verified and l.verified.status %}","+            <span class=\"chip {{ 'ok' if l.verified.status == 'verified' else 'plain' }} small\" data-exp-verified>{{ l.verified.status }}</span>","+          {% endif %}","+          {% if l.rating and not l.curated %}","+            <span class=\"chip {{ 'ok' if l.rating == 'helped' else ('warn' if l.rating == 'wrong' else 'plain') }} small\" data-exp-rating>{{ l.rating }}</span>","+          {% endif %}","+          {% if l.worked_count %}<span class=\"small muted\">&middot; worked on this car: {{ l.worked_count }}</span>{% endif %}","+          {% if l.flags %}<span class=\"small muted\">&middot; flagged {{ l.flags|length }}x</span>{% endif %}","         </div>","+        <span class=\"chip {{ _exp_role_chip_class.get((l.found_by or {}).get('role'), 'plain') }}\" data-exp-role-chip>{{ _exp_role_label.get((l.found_by or {}).get(\"role\"), \"Owner\") }}</span>","         {% if l.reputation %}<span class=\"chip {{ 'ok' if l.reputation == 'high' else 'plain' }}\">{{ l.reputation }}</span>{% endif %}","+        <div class=\"exp-row-actions\">","+          {% if l.curated %}","+            <button type=\"button\" class=\"btn small\" data-exp-flag=\"{{ l.id }}\">Flag as wrong/outdated</button>","+          {% else %}","+            <button type=\"button\" class=\"btn small\" data-exp-edit=\"{{ l.id }}\">Edit</button>","+            <button type=\"button\" class=\"btn small\" data-exp-delete=\"{{ l.id }}\">Delete</button>","+          {% endif %}","+          <button type=\"button\" class=\"btn small\" data-exp-worked=\"{{ l.id }}\">Worked on this car?</button>","+        </div>","       </div>","     {% else %}","       <p class=\"muted small\">No links for this view.</p>","     {% endfor %}","+    </div>","+","+    <details class=\"exp-add\" data-exp-add>","+      <summary>+ Add what you found</summary>","+      <form data-exp-add-form novalidate>","+        <label class=\"small\">URL<input type=\"url\" name=\"url\" required maxlength=\"2000\" placeholder=\"https://...\"></label>","+        <label class=\"small\">Title (auto-fetched when reachable, else type it)<input type=\"text\" name=\"title\" maxlength=\"300\"></label>","+        <label class=\"small\">Kind","+          <select name=\"kind\">","+            <option value=\"video\">Video</option>","+            <option value=\"forum\">Forum thread</option>","+            <option value=\"article\">Article</option>","+            <option value=\"manual\">Manual</option>","+            <option value=\"audio\">Audio / sound reference</option>","+            <option value=\"photo\">Photo</option>","+            <option value=\"note\">Note</option>","+          </select>","+        </label>","+        <div class=\"small exp-role-chips\" data-exp-role-picker role=\"group\" aria-label=\"Who found it\">","+          <button type=\"button\" class=\"btn small\" data-role-chip=\"driver\" aria-pressed=\"false\">Driver</button>","+          <button type=\"button\" class=\"btn small\" data-role-chip=\"mechanic\" aria-pressed=\"true\">Mechanic</button>","+          <input type=\"hidden\" name=\"role\" value=\"mechanic\">","+        </div>","+        <label class=\"small\">Your name<input type=\"text\" name=\"name\" maxlength=\"200\" data-exp-name></label>","+        <label class=\"small\">Code<input type=\"text\" name=\"scope_code\" value=\"{{ _exp_scope_code }}\" maxlength=\"10\"></label>","+        <label class=\"small\">Family/system<input type=\"text\" name=\"scope_family\" value=\"{{ _exp_scope_family }}\" maxlength=\"200\"></label>","+        <label class=\"small\">Job<input type=\"text\" name=\"scope_job\" value=\"{{ _exp_scope_job }}\" maxlength=\"200\"></label>","+        <label class=\"small\">Note (why it helped)<textarea name=\"note\" maxlength=\"2000\"></textarea></label>","+        <label class=\"small\">Rating","+          <select name=\"rating\">","+            <option value=\"helped\">Helped</option>","+            <option value=\"unsure\" selected>Not sure yet</option>","+            <option value=\"wrong\">Was wrong</option>","+          </select>","+        </label>","+        <div class=\"exp-add-status small muted\" data-exp-add-status></div>","+        <div class=\"exp-add-actions\">","+          <button type=\"submit\" class=\"btn primary small\">Save</button>","+        </div>","+      </form>","+    </details>","   </details>","   {% endif %}"," </div>"]}]},{"filePath":"C:\\Users\\User\\mcp-servers\\docs\\handbook\\05-methods-and-gotchas.md","hunks":[{"oldStart":19,"oldLines":3,"newStart":19,"newLines":4,"lines":[" - `cuore/services/cache.py:get_or_build(key, build)` is a small in-process memo cache (16 entries, LRU) keyed on whatever makes the value stale -- never just the VIN. The shared convention across bridges: `(\"workup\", vin, mes_bridge.newest_mtime(vin))` for anything built from the MES log corpus (used by `bench_routes.py`, `flow_bridge.py`, `tests_bridge.py`, `timeline_bridge.py`, `dossier_bridge.py`, `jobs_bridge.py` and others -- this is what took the Report page from 30 s to 5 s and the Job page from 3.2 s to 0.3 s, 2026-10-13); `(\"scan_health\", vin, scan_id, observations.jsonl's mtime)` for the scan health report (`scan_health_bridge.py:build_cached`); `(\"bench_tree_candidates\", vin, codes, mtime)` for the Bench fault-tree view. A new or edited log/observation moves the mtime key component and the stale entry simply falls out -- no invalidation hook needed, but a cache key that forgets to include the right mtime will silently serve a stale page."," - Tell CUORE's phone URL moves with the PC's LAN address: cuore binds `CUORE_HOST=0.0.0.0` (set in the launchers) and the shop PC is on DHCP, so the IP in the `/m/{vin}/qr` URL (192.168.68.80 as of 2026-10-13; was 192.168.0.161) can change on a reboot or router restart -- check the current address before handing a phone the link, don't assume last session's. The Windows Firewall rule for inbound TCP 5000 needs an admin to run once (`New-NetFirewallRule -DisplayName \"CUORE 5000\" -Direction Inbound -Action Allow -Protocol TCP -LocalPort 5000 -Profile Any`); without it the LAN bind is correct but nothing outside the PC itself can reach the port."," - \"Read this photo\" (`POST /api/vision/{vin}/read`, `cuore/services/vision_bridge.py` + `cuore/api/vision.py`): a value read from a photo is a **suggestion the human confirms**, never a car measurement -- when the confirmed value is saved as an owner event, the caller stamps `fields_meta[key] = \"photo\"` on that field (same provenance convention `cuore.live.owner_events` already uses) so the record still says it came from a picture, not an instrument. Field names in the response are the real `cuore.live.owner_events.TAXONOMY` field names for the hints that map onto one kind (`fuel_pump` -> `fuel/fill_up`, `oil_bottle` -> `fluids/engine_oil_change`, `part_label` -> `parts_repairs_elsewhere/part_fitted_elsewhere`, `receipt` -> `fuel/fill_up`); `odometer` returns `odometer_km` with `suggested_kind: null` because that is the event's own top-level field, not a kind field. Provider is `CUORE_VISION_PROVIDER` (default `none`, which is deliberately the honest \"not set up, fill in by hand\" answer -- CUORE runs offline by rule, so a vision backend is never silently on). `claude` only turns on with `CUORE_VISION_PROVIDER=claude` **and** `ANTHROPIC_API_KEY` set -- that call leaves the LAN and goes to Anthropic over plain HTTPS via `urllib` (no `anthropic` SDK in this venv, and none was added), so it is the owner's explicit, informed choice, never a default. `tesseract` is a probe-only stub (`_find_tesseract` checks PATH and `C:\\Program Files\\Tesseract-OCR\\tesseract.exe`); nothing is installed there today and no OCR is wired up behind it. Tests (`cuore/tests/check_vision.py`) monkeypatch `cuore.services.vision_bridge.urllib.request.urlopen` to return a canned Messages-API body rather than calling the real network.","+- **Durable archive (2026-10-14):** `scripts/backup-cuore-state.ps1` is the incremental, append-only, sha256-dedup backup for both `C:\\ProgramData\\cuore` (-> `docs/vehicles/<VIN>/state-backup/<date>/`) and Claude Code session data -- transcripts, every `tasks\\*.output` agent transcript, and scratchpad screenshots/html/json (-> `docs/sessions/raw/<date>/<session-id>/`), regenerating `docs/sessions/<date>-agent-discoveries.md` for any session with new agent output; `scripts/save-session-artifacts.ps1` does the same for one named session id. Nothing already written is ever deleted or overwritten -- a file whose sha256 matches its last capture is just marked `skipped-unchanged`, not recopied. Secrets (`sk-ant-*`, `AKIA*`, `\"password\": \"...\"`) are redacted wherever text is copied or digested, even inside a gzipped (>5MB) file -- see `scripts/_backup-common.ps1`. `scripts/hooks/pre-push` is the versioned source for a git `pre-push` hook that runs this archive before every push; **it is not installed** (an automated installer for it was refused by the permission classifier as unauthorized persistence) -- the owner installs it by hand, once per clone: `Copy-Item scripts\\hooks\\pre-push .git\\hooks\\pre-push`. Because git fixes the set of commits a push will send *before* `pre-push` runs, a commit the hook makes is never part of that same push -- by design the hook aborts (exit 1) and asks for a plain `git push github main` re-run to pick it up; the archive step's own failures never block a push (logged to `docs/sessions/archive-errors.log`, hook exits 0)."]}]}],"moreFiles":0,"changedFiles":["C:\\Users\\User\\mcp-servers\\cuore\\api\\scanlog.py","C:\\Users\\User\\mcp-servers\\cuore\\web\\templates\\_experience.html","C:\\Users\\User\\mcp-servers\\docs\\handbook\\05-methods-and-gotchas.md"],"shared":true}},"serverClassifierContext":{"request":"fa3cc698-2917-43fe-befd-b6bce168ed5d","context":{"git_state":{"cwd":"/c/Users/User/mcp-servers","root":null,"branch":null,"default_branch":null,"status":null,"visibility":null,"error":"pending"},"live_cwd":"/c/Users/User/mcp-servers","platform":"windows"}},"sourceToolAssistantUUID":"85cda92e-80d8-4000-acb5-78a838591d3e","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
