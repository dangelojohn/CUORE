n385-    status: DtcStatus = DtcStatus.UNKNOWN\n386-    #: Position in the log's numbered list, when there was one.\n387-    index: int = 0\n388-    freeze_frame: dict[str, ParamValue] = field(default_factory=dict)\n389-    source_file: str = \"\"\n390-    timestamp: str = \"\"\n391-\n392-    @property\n393-    def full(self) -> str:\n394-        return f\"{self.code}-{self.ftb}\" if self.ftb else self.code\n395-\n396-    @property\n397-    def system(self) -> str:\n398-        return SYSTEM_NAMES.get(self.code[:1].upper(), \"Unknown\")\n399-\n400-    @property\n401-    def authority(self) -> str:\n402-        return code_authority(self.code)\n403-","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"serverClassifierContext":{"request":"469bcea9-19b7-4e6a-abab-6fac96f9c5ec","context":{"git_state":{"cwd":"/c/Users/User/mcp-servers","root":null,"branch":null,"default_branch":null,"status":null,"visibility":null,"error":"pending"},"live_cwd":"/c/Users/User/mcp-servers","platform":"windows"}},"sourceToolAssistantUUID":"c7a976db-d90a-4e3c-89bf-d99b8002e875","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
