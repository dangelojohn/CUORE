 id=\"fb-<step_id>\", data-fact=\"checklist|<step_id>\".\n      Array.prototype.slice.call(document.querySelectorAll('.checklist-step[id^=\"fb-\"]'))\n        .forEach(function (li) {\n          var fact = li.getAttribute(\"data-fact\") || \"\";\n          var stepId = fact.indexOf(\"checklist|\") === 0 ? fact.slice(10) : \"\";\n          var fn = null;\n          if (stepId.indexOf(\"test:\") === 0 && byTestId[stepId.slice(5)]) {\n            fn = byTestId[stepId.slice(5)];\n          } else {\n            var text = (li.querySelector(\".step-text\") || {}).textContent || \"\";\n            text = text.trim().toLowerCase();\n            fn = fns.filter(function (f) {\n              var name = f.name.toLowerCase();\n              return text.indexOf(name) !== -1 || name.indexOf(text) !== -1;\n            })[0] || null;\n          }\n          if (fn) insertCard(li, fn);\n        });\n    })\n    .catch(function () { /* handoff cards are a nice-to-have, never block the page */ });\n})();\n</script>\n","structuredPatch":[],"originalFile":null,"userModified":false},"serverClassifierContext":{"request":"8a1ab0e2-5a93-4d9b-aade-649709d5b169","context":{"git_state":{"cwd":"/c/Users/User/mcp-servers","root":null,"branch":null,"default_branch":null,"status":null,"visibility":null,"error":"pending"},"live_cwd":"/c/Users/User/mcp-servers","platform":"windows"}},"sourceToolAssistantUUID":"6fb177dc-7b61-402a-8ec5-60a0a146b6ae","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
