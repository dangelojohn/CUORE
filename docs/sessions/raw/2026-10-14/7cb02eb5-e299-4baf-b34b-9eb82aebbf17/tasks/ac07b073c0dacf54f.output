{"parentUuid":"e3996356-472d-4d86-abd3-a9018dfc4d8d","isSidechain":true,"promptId":"3332b329-cf49-4440-aab6-3dd05635f08d","agentId":"ac07b073c0dacf54f","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01WxaNLuTQfYhFtbfEfhVFY4","type":"tool_result","content":"\"\"\"Transport-neutral errors the routers map onto HTTP status codes.\n\nThe bridge raises these instead of returning ``{\"error\": ...}`` dicts, so a\nmissing vehicle is a 404 rather than a 200 carrying a failure the caller has to\nnotice. The exception is content that is *informative* even when it reports no\nresult -- ``fault_tree`` on codes no tree covers returns the list of trees that\ndo exist, and that is a successful answer to a reasonable question.\n\"\"\"\n\nfrom __future__ import annotations\n\n\nclass BridgeError(Exception):\n    \"\"\"Base for anything the service layer refuses to do.\"\"\"\n\n    status = 400\n\n\nclass NotFound(BridgeError):\n    \"\"\"The vehicle, log, code or recording does not exist in the corpus.\"\"\"\n\n    status = 404\n\n\nclass BadRequest(BridgeError):\n    \"\"\"Caller-supplied input is malformed, unsafe, or out of range.\"\"\"\n\n    status = 400","is_error":false}]},"uuid":"e184b32b-4366-41b0-9f41-f87348339c79","timestamp":"2026-10-14T11:13:20.114Z","toolUseResult":{"stdout":"\"\"\"Transport-neutral errors the routers map onto HTTP status codes.\n\nThe bridge raises these instead of returning ``{\"error\": ...}`` dicts, so a\nmissing vehicle is a 404 rather than a 200 carrying a failure the caller has to\nnotice. The exception is content that is *informative* even when it reports no\nresult -- ``fault_tree`` on codes no tree covers returns the list of trees that\ndo exist, and that is a successful answer to a reasonable question.\n\"\"\"\n\nfrom __future__ import annotations\n\n\nclass BridgeError(Exception):\n    \"\"\"Base for anything the service layer refuses to do.\"\"\"\n\n    status = 400\n\n\nclass NotFound(BridgeError):\n    \"\"\"The vehicle, log, code or recording does not exist in the corpus.\"\"\"\n\n    status = 404\n\n\nclass BadRequest(BridgeError):\n    \"\"\"Caller-supplied input is malformed, unsafe, or out of range.\"\"\"\n\n    status = 400","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"serverClassifierContext":{"request":"3b7127b2-0e3e-4201-8a4b-488caac15094","context":{"git_state":{"cwd":"/c/Users/User/mcp-servers","root":null,"branch":null,"default_branch":null,"status":null,"visibility":null,"error":"pending"},"live_cwd":"/c/Users/User/mcp-servers","platform":"windows"}},"sourceToolAssistantUUID":"e3996356-472d-4d86-abd3-a9018dfc4d8d","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
