ons.jsonl is untouched after archiving\r\n  [ok] the archive manifest lists observations.jsonl\r\n  [ok] the manifest's sha256 matches the archived copy\r\n  [ok] the archived copy exists on disk and matches byte-for-byte\r\n  [ok] integrity parses every line with no errors\r\n  [ok] integrity counts by kind include module_dtcs and freeze_frame\r\n  [ok] integrity counts by day include 2026-10-13\r\n  [ok] integrity reports absent files as not existing, not an error\r\n\r\nall 46 checks passed","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false,"bashEditDiff":{"files":[{"filePath":"C:\\Users\\User\\mcp-servers\\cuore\\tests\\check_mil.py","hunks":[{"oldStart":410,"oldLines":7,"newStart":410,"newLines":6,"lines":[" # ==========================================================================="," "," print(\"=== Bench / Report pages ===\")","-mes_bridge.newest_mtime.cache_clear() if hasattr(mes_bridge.newest_mtime, \"cache_clear\") else None"," client = TestClient(create_app())"," "," bench_resp = client.get(f\"/v/{VIN}\")"]}]}],"moreFiles":0,"changedFiles":["C:\\Users\\User\\mcp-servers\\cuore\\tests\\check_mil.py"]}},"serverClassifierContext":{"request":"a746bd35-8cec-4208-bd63-557e42afbcd5","context":{"git_state":{"cwd":"/c/Users/User/mcp-servers","root":null,"branch":null,"default_branch":null,"status":null,"visibility":null,"error":"pending"},"live_cwd":"/c/Users/User/mcp-servers","platform":"windows"}},"sourceToolAssistantUUID":"c633dfdb-c9aa-47ac-80cb-b24093453af1","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
