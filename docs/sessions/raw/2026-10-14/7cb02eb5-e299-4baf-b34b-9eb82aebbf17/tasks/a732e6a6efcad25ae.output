can_export_root() -> Path | None:\n    \"\"\"``CUORE_STATE_DIR/scans`` if it exists, else ``None``. This is\n    exports only (``cuore.live.scanlog.write_mes_export`` output, one\n    ``SCAN_YYMMDDHHMM.txt`` per exported live scan, grouped in a\n    per-VIN subfolder) -- ``observations.jsonl`` itself is never read or\n    linked from here.\"\"\"\n    d = _cuore_state_dir()\n    if d is None:\n        return None\n    scans = d / \"scans\"\n    return scans if scans.is_dir() else None\n\n\ndef iter_cuore_export_files() -> list[Path]:\n    \"\"\"Every MES-format scan export under ``CUORE_STATE_DIR/scans/<vin>/``,\n    unsorted -- the second log root (see the module docstring).\"\"\"\n    root = cuore_scan_export_root()\n    if root is None:\n        return []\n    out: list[Path] = []\n    try:\n        vin_dirs = [p for p in root.iterdir() if p.is_dir()]\n    except OSError:\n        return []\n    for vd in vin_dirs:\n        try:\n            files = list(vd.iterdir())\n        except OSError:\n            continue\n        for p in files:\n            try:\n                if p.is_file() and paths.is_log_name(p.name):\n                    out.append(p)\n            except OSError:\n                continue\n    return out","originalFile":null,"structuredPatch":[{"oldStart":59,"oldLines":6,"newStart":59,"newLines":65,"lines":["         return None"," "," ","+def _cuore_state_dir() -> Path | None:","+    \"\"\"The existing ``CUORE_STATE_DIR`` (or its usual fallbacks), read-only:","+    this module never creates it, only looks for ``scans/`` inside one that","+    already exists. Same candidate order as ``mes.jobs.state_dir`` /","+    ``cuore.live.config.state_dir``, kept independent of both so ``mes``","+    still never *imports* ``cuore`` for this.\"\"\"","+    env = os.environ.get(\"CUORE_STATE_DIR\")","+    candidates: list[Path] = []","+    if env:","+        candidates.append(Path(env))","+    if os.environ.get(\"PROGRAMDATA\"):","+        candidates.append(Path(os.environ[\"PROGRAMDATA\"], \"cuore\"))","+    if os.environ.get(\"LOCALAPPDATA\"):","+        candidates.append(Path(os.environ[\"LOCALAPPDATA\"], \"cuore\"))","+    candidates.append(Path.home() / \".cuore\")","+    for d in candidates:","+        if d.is_dir():","+            return d","+    return None","+","+","+def cuore_scan_export_root() -> Path | None:","+    \"\"\"``CUORE_STATE_DIR/scans`` if it exists, else ``None``. This is","+    exports only (``cuore.live.scanlog.write_mes_export`` output, one","+    ``SCAN_YYMMDDHHMM.txt`` per exported live scan, grouped in a","+    per-VIN subfolder) -- ``observations.jsonl`` itself is never read or","+    linked from here.\"\"\"","+    d = _cuore_state_dir()","+    if d is None:","+        return None","+    scans = d / \"scans\"","+    return scans if scans.is_dir() else None","+","+","+def iter_cuore_export_files() -> list[Path]:","+    \"\"\"Every MES-format scan export under ``CUORE_STATE_DIR/scans/<vin>/``,","+    unsorted -- the second log root (see the module docstring).\"\"\"","+    root = cuore_scan_export_root()","+    if root is None:","+        return []","+    out: list[Path] = []","+    try:","+        vin_dirs = [p for p in root.iterdir() if p.is_dir()]","+    except OSError:","+        return []","+    for vd in vin_dirs:","+        try:","+            files = list(vd.iterdir())","+        except OSError:","+            continue","+        for p in files:","+            try:","+                if p.is_file() and paths.is_log_name(p.name):","+                    out.append(p)","+            except OSError:","+                continue","+    return out","+","+"," @dataclass"," class LogEntry:","     \"\"\"One indexed log file and the cheap metadata read from it.\"\"\""]}],"userModified":false,"replaceAll":false,"contentNotInModelContext":true},"serverClassifierContext":{"request":"d0031495-3310-4c35-8643-a622d10d8c83","context":{"git_state":{"cwd":"/c/Users/User/mcp-servers","root":null,"branch":nul