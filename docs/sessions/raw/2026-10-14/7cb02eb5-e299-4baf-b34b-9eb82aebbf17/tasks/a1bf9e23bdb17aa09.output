{"parentUuid":"adef7044-0299-41c3-be8e-fb65c845cf8d","isSidechain":true,"agentId":"a1bf9e23bdb17aa09","message":{"model":"claude-sonnet-5","id":"msg_011Cg22FPB6X1mdYTZwfBiqq","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_013pMWw99Nn397hxxkcnjT1B","name":"Read","input":{"file_path":"C:\\Users\\User\\mcp-servers\\cuore\\live\\transport.py"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":7136,"cache_read_input_tokens":57962,"cache_creation":{"ephemeral_5m_input_tokens":7136,"ephemeral_1h_input_tokens":0},"output_tokens":2,"service_tier":"standard","inference_geo":"global"},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_013pMWw99Nn397hxxkcnjT1B":{"file_path":"C:\\Users\\User\\mcp-servers\\cuore\\live\\transport.py"}},"serverClassifierRequest":"4b01465f-a042-457a-850c-b02e8aab69de","apiBlockIndex":1,"requestId":"req_011Cg22FNwiaGTDYvRy8gNN7","attributionAgent":"general-purpose","type":"assistant","uuid":"dc455976-6566-4f26-9de0-bc33fcadfcee","timestamp":"2026-10-14T11:06:53.817Z","effort":"high","perTurnEffort":null,"userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
{"parentUuid":"dc455976-6566-4f26-9de0-bc33fcadfcee","isSidechain":true,"promptId":"d6e397a4-8ef0-4e3f-aa12-0e1ab89aceab","agentId":"a1bf9e23bdb17aa09","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_013pMWw99Nn397hxxkcnjT1B","type":"tool_result","content":"1\t\"\"\"AdapterLink: one adapter, opened per operation, one bus per session.\n2\t\n3\tThe link owns no open port between calls. ``session()`` resolves port and\n4\tspeed, checks the MES interlock, takes the process lock and the advisory lock\n5\tfile, opens the stream, initialises the adapter, selects the bus route for\n6\tthe declared cable, enforces the transmit policy, yields a :class:`Session`,\n7\tand closes everything on the way out. That is the whole contract, and it is\n8\twhat lets MultiEcuScan take the adapter the moment a call returns.\n9\t\n10\tCable state lives here too. It is declared, not detected; every result names\n11\tit; changing it clears every bus verification.\n12\t\"\"\"\n13\t\n14\tfrom __future__ import annotations\n15\t\n16\timport os\n17\timport re\n18\timport threading\n19\timport time\n20\tfrom contextlib import contextmanager\n21\tfrom datetime import datetime\n22\tfrom typing import Any, Callable, Iterator, Optional\n23\t\n24\tfrom . import audit, interlock\n25\tfrom .addressing import ECUAddress\n26\tfrom .buses import CABLES, CAN_C, BUSES, Bus, Route, header_bits_for_protocol, route_for\n27\tfrom .config import default_cable, resolve_baud, resolve_port\n28\tfrom .errors import AdapterFault, BadCommand, LinkUnavailable, Refused\n29\tfrom .framing import (adapter_error, looks_like_wrong_baud, negative_responses,\n30\t                      payloads_for, reassemble)\n31\tfrom .safety import assert_transmit_allowed, validate_command\n32\tfrom .stream import SerialStream, Stream\n33\t\n34\ttry:  # OBD_TIMEOUT is honoured for compatibility with the obd2-mcp registration\n35\t    DEFAULT_TIMEOUT = float(os.environ.get(\"OBD_TIMEOUT\", \"4\"))\n36\texcept ValueError:\n37\t    DEFAULT_TIMEOUT = 4.0\n38\tMIN_TIMEOUT, MAX_TIMEOUT = 0.2, 30.0\n39\t\n40\t#: STN preset -> ELM327 protocol number for adapters without ST commands.\n41\t_ELM_EQUIVALENT = {\"33\": \"6\", \"34\": \"7\", \"35\": \"8\", \"36\": \"9\", \"31\": \"6\", \"32\": \"7\"}\n42\t\n43\t\n44\tdef clamp_timeout(t: float) -> float:\n45\t    try:\n46\t        t = float(t)\n47\t    except (TypeError, ValueError):\n48\t        return DEFAULT_TIMEOUT\n49\t    return max(MIN_TIMEOUT, min(MAX_TIMEOUT, t))\n50\t\n51\t\n52\tclass Session:\n53\t    \"\"\"An open adapter, configured for one bus. Valid only inside ``session()``.\"\"\"\n54\t\n55\t    def __init__(self, link: \"AdapterLink\", stream: Stream, bus: Bus, route: Route,\n56\t                 *, passive: bool, confirmed: bool) -> None:\n57\t        self.link = link\n58\t        self.stream = stream\n59\t        self.bus = bus\n60\t        self.route = route\n61\t        self.passive = passive\n62\t        self.confirmed = confirmed\n63\t        self.headers_on = True\n64\t        self.header_bits = header_bits_for_protocol(route.stn_protocol)\n65\t        self._target: Optional[tuple[str, str]] = None\n66\t        self.opened_at = datetime.now().isoformat(timespec=\"seconds\")\n67\t\n68\t    # --- wire ----------------------------------------------------------\n69\t\n70\t    def cmd(self, command: str, timeout: float = DEFAULT_TIMEOUT) -> str:\n71\t        \"\"\"Send one command and read until the ``>`` prompt or the deadline.\n72\t\n73\t        A reply with no prompt is tagged ``TIMEOUT`` so it counts as an\n74\t        incomplete read rather than an empty result.\n75\t        \"\"\"\n76\t        command = validate_command(command)\n77\t        timeout = clamp_timeout(timeout)\n78\t        s = self.stream\n79\t        s.reset_input_buffer()\n80\t        s.write((command + \"\\r\").encode(\"ascii\"))\n81\t        s.flush()\n82\t        deadline = time.monotonic() + timeout\n83\t        buf = bytearray()\n84\t        got_prompt = False\n85\t        while time.monotonic() < deadline:\n86\t            chunk = s.read(s.in_waiting() or 1)\n87\t            if not chunk:\n88\t                continue\n89\t            buf.extend(chunk)\n90\t            if b\">\" in chunk:\n91\t                got_prompt = True\n92\t                break\n93\t        text = buf.decode(\"ascii\", errors=\"replace\").replace(\"\\r\", \"\\n\").strip(\" \\n>\")\n94\t        if text.upper().startswith(command.upper()):\n95\t            text = text[len(command):].lstrip(\" \\n\")\n96\t        if not got_prompt:\n97\t            text = (text + \"\\nTIMEOUT\").strip()\n98\t        return text\n99\t\n100\t    def query(self, request_hex: str, response_byte: str,\n101\t              timeout: float = DEFAULT_TIMEOUT) -> dict[str, Any]:\n102\t        \"\"\"Send a request; return raw text, error, and per-ECU positive payloads.\"\"\"\n103\t        raw = self.cmd(request_hex, timeout)\n104\t        err = adapter_error(raw)\n105\t        ecus = reassemble(raw, headers_on=self.headers_on) if not err else {}\n106\t        return {\"raw\": raw, \"error\": err or None, \"ecus\": payloads_for(ecus, response_byte),\n107\t                \"all_ecus\": ecus}\n108\t\n109\t    # --- addressing -----------------------------------------------------\n110\t\n111\t    def target(self, ecu: ECUAddress) -> None:\n112\t        \"\"\"Point requests at one module; idempotent within the session.\"\"\"\n113\t        if not ecu.usable and ecu.target is None:\n114\t            raise BadCommand(f\"module {ecu.code} has no known address\")\n115\t        self.target_raw(ecu.request_hex or \"\", ecu.response_hex or \"\")\n116\t\n117\t    def target_raw(self, request_hex: str, response_hex: str) -> None:\n118\t        pair = (request_hex.upper(), response_hex.upper())\n119\t        if self._target == pair:\n120\t            return\n121\t        self.cmd(f\"ATSH{pair[0]}\", 2)\n122\t        self.cmd(f\"ATCRA{pair[1]}\", 2)\n123\t        if self.link.is_stn:\n124\t            self.cmd(f\"STCFCPA {pair[0]},{pair[1]}\", 2)\n125\t        else:\n126\t            self.cmd(f\"ATFCSH{pair[0]}\", 2)\n127\t            self.cmd(\"ATFCSD300000\", 2)\n128\t            self.cmd(\"ATFCSM1\", 2)\n129\t        self._target = pair\n130\t        self.link._last_target = pair\n131\t\n132\t    def untarget(self) -> None:\n133\t        \"\"\"Back to functional/broadcast addressing for legislated OBD.\n134\t\n135\t        The adapter keeps ATSH/ATCRA across port closes, so a fresh session\n136\t        inherits the link's last physical target and clears it here rather\n137\t        than trusting its own (empty) memory.\n138\t        \"\"\"\n139\t        if self._target is None:\n140\t            self._target = getattr(self.link, \"_last_target\", None)\n141\t        # Always restate the functional header: the adapter remembers the last\n142\t        # ATSH across port closes and protocol switches, and a process restart\n143\t        # forgets what that was.\n144\t        if self.header_bits == 29:\n145\t            # 29-bit functional header the way the ELM/STN command set takes\n146\t            # it: priority byte via ATCP, lower 24 bits via ATSH. A single\n147\t            # 8-digit ATSH is not accepted by every firmware and silently\n148\t            # leaves the last header in force (read as NO DATA on the bench,\n149\t            # 2026-10-13, while the probe built this way got answers).\n150\t            self.cmd(\"ATCP18\", 2)\n151\t            self.cmd(\"ATSHDB33F1\", 2)\n152\t            self.cmd(\"ATSTFF\", 2)\n153\t        else:\n154\t            self.cmd(\"ATSH7DF\", 2)\n155\t        self.cmd(\"ATCRA\", 2)\n156\t        if self.link.is_stn:\n157\t            # Bench finding 2026-10-13 (vLinker FS r2, STN1170 v4.3.2): STFAC\n158\t            # removes the firmware's default pass filters too, after which\n159\t            # every reply is dropped and each request reads NO DATA. Re-issuing\n160\t            # the protocol select restores the defaults, and the functional\n161\t            # header must then be restated because STP resets it as well.\n162\t            self.cmd(\"STCFCPC\", 2)\n163\t            self.cmd(f\"STP {self.route.stn_protocol}\", 2)\n164\t            if self.header_bits == 29:\n165\t                self.cmd(\"ATCP18\", 2)\n166\t                self.cmd(\"ATSHDB33F1\", 2)\n167\t                self.cmd(\"ATSTFF\", 2)\n168\t            else:\n169\t                self.cmd(\"ATSH7DF\", 2)\n170\t        self._target = None\n171\t        self.link._last_target = None\n172\t\n173\t    # --- UDS primitive --------------------------------------------------\n174\t\n175\t    def uds(self, ecu: ECUAddress, service: int, payload: bytes = b\"\",\n176\t            timeout: float = DEFAULT_TIMEOUT, retries_on_pending: int = 3) -> dict[str, Any]:\n177\t        \"\"\"One UDS request to one module. Read-only services only (enforced upstream).\n178\t\n179\t        NRC ``0x78`` (responsePending) is handled by re-issuing the request\n180\t        after a short wait, up to ``retries_on_pending`` times, which is the\n181\t        practical equivalent of waiting P2* on an adapter that returns to its\n182\t        prompt after the first reply.\n183\t        \"\"\"\n184\t        self.target(ecu)\n185\t        req = f\"{service:02X}{payload.hex().upper()}\"\n186\t        resp_byte = f\"{service + 0x40:02X}\"\n187\t        svc_hex = f\"{service:02X}\"\n188\t        attempts = 0\n189\t        while True:\n190\t            attempts += 1\n191\t            q = self.query(req, resp_byte, timeout)\n192\t            nrc = negative_responses(q[\"all_ecus\"], svc_hex)\n193\t            pending = [h for h, code in nrc.items() if code == \"78\"]\n194\t            if pending and not q[\"ecus\"] and attempts <= retries_on_pending:\n195\t                time.sleep(0.3 * attempts)\n196\t                continue\n197\t            break\n198\t        mine = {h: d for h, d in q[\"ecus\"].items()\n199\t                if not ecu.response_hex or h == ecu.response_hex or h == \"\"}\n200\t        return {\"request\": req, \"raw\": q[\"raw\"], \"error\": q[\"error\"],\n201\t                \"positive\": mine, \"nrc\": {h: int(c, 16) for h, c in nrc.items()},\n202\t                \"attempts\": attempts, \"ecu\": ecu.code, \"bus\": self.bus.key}\n203\t\n204\t\n205\tclass AdapterLink:\n206\t    \"\"\"The one object that opens the adapter. Create one per process.\"\"\"\n207\t\n208\t    def __init__(self, stream_factory: Optional[Callable[[str, int], Stream]] = None,\n209\t                 process: str = \"cuore\") -> None:\n210\t        self.stream_factory = stream_factory or (lambda p, b: SerialStream(p, b))\n211\t        self.process = process\n212\t        self.lock = threading.RLock()\n213\t        self.cable: str = default_cable()\n214\t        self.identity: dict[str, str] = {}\n215\t        self.is_stn: bool = False\n216\t        self.port: Optional[str] = None\n217\t        self.baud: int = 0\n218\t        self.port_source = \"\"\n219\t        self.baud_source = \"\"\n220\t        self.last_open: Optional[str] = None\n221\t        self.last_error: Optional[str] = None\n222\t        self.verified: dict[str, dict[str, Any]] = {}   # bus_key -> {cable, frames, at, ts}\n223\t        # Auto-verify: a transmit session on an unverified (or stale) bus runs\n224\t        # the passive listen itself instead of refusing. Off with\n225\t        # CUORE_AUTO_VERIFY=0; the proof window is CUORE_VERIFY_TTL seconds.\n226\t        self.auto_verify: bool = os.environ.get(\"CUORE_AUTO_VERIFY\", \"1\") != \"0\"\n227\t        self.verify_ttl: float = float(os.environ.get(\"CUORE_VERIFY_TTL\", \"600\"))\n228\t        self.verifier: Optional[Callable[..., dict[str, Any]]] = None\n229\t        self.last_auto_verify: Optional[dict[str, Any]] = None\n230\t        self.vin: str = \"\"                               # last VIN the car reported\n231\t        self.current: Optional[Session] = None\n232\t\n233\t    # --- cable state ----------------------------------------------------\n234\t\n235\t    def set_cable(self, cable: str) -> dict[str, Any]:\n236\t        cable = (cable or \"none\").lower()\n237\t        if cable not in CABLES:\n238\t            raise BadCommand(f\"unknown cable {cable!r}; one of {list(CABLES)}\")\n239\t        with self.lock:\n240\t            changed = cable != self.cable\n241\t            self.cable = cable\n242\t            if changed:\n243\t                self.verified.clear()\n244\t            audit.record(\"cable_declared\", cable=cable, cleared_verifications=changed)\n245\t        return self.cable_state()\n246\t\n247\t    def cable_state(self) -> dict[str, Any]:\n248\t        buses = []\n249\t        for key, bus in BUSES.items():\n250\t            route = route_for(bus, self.cable)\n251\t            ver = self.verified.get(key) if self.is_verified(bus) else None\n252\t            buses.append({\n253\t                \"bus\": key, \"name\": bus.name, \"pins\": list(bus.pins), \"bitrate\": bus.bitrate,\n254\t                \"reachable_with_cable\": route is not None,\n255\t                \"route\": (None if route is None else {\n256\t                    \"stn_protocol\": route.stn_protocol, \"bitrate_override\": route.bitrate_override,\n257\t                    \"status\": route.status, \"note\": route.note}),\n258\t                \"verified\": bool(ver), \"verified_at\": (ver or {}).get(\"at\"),\n259\t                \"verified_frames\": (ver or {}).get(\"frames\"),\n260\t                \"verified_by\": (ver or {}).get(\"verified_by\"),\n261\t                \"transmit_needs_confirmation\": bus.transmit_needs_confirmation,\n262\t            })\n263\t        return {\"cable\": self.cable, \"buses\": buses}\n264\t\n265\t    def mark_verified(self, bus: Bus, frames: int, *, verified_by: str = \"passive_listen\",\n266\t                      **extra: Any) -> None:\n267\t        \"\"\"Record a bus as proven live under the declared cable.\n268\t\n269\t        ``verified_by`` names how: ``\"passive_listen\"`` (frames overheard\n270\t        with no transmission at all) or ``\"active_probe_0100\"`` (CAN-C behind\n271\t        a Security Gateway Module carries no broadcast traffic, so the only\n272\t        proof available is a reply to one legislated Mode 01 PID 00 request\n273\t        -- see :func:`cuore.live.ops._active_probe_0100`). ``extra`` is\n274\t        merged in for callers that want to carry e.g. the responding ECU ids.\n275\t        \"\"\"\n276\t        self.verified[bus.key] = {\"cable\": self.cable, \"frames\": frames,\n277\t                                  \"verified_by\": verified_by,\n278\t                                  \"at\": datetime.now().isoformat(timespec=\"seconds\"),\n279\t                                  \"ts\": time.monotonic(), **extra}\n280\t\n281\t    def is_verified(self, bus: Bus) -> bool:\n282\t        \"\"\"Verified under the declared cable, and recently enough to trust.\n283\t\n284\t        A proof older than ``verify_ttl`` is treated as absent: an adapter\n285\t        can lose the bus without the port noticing (a moved HS/MS switch, a\n286\t        half-seated plug), and a stale flag then turns every read into a\n287\t        confident-looking NO DATA.\n288\t        \"\"\"\n289\t        ver = self.verified.get(bus.key)\n290\t        if not ver or ver.get(\"cable\") != self.cable:\n291\t            return False\n292\t        ts = ver.get(\"ts\")\n293\t        return ts is None or self.verify_ttl <= 0 or time.monotonic() - ts <= self.verify_ttl\n294\t\n295\t    def _auto_verify(self, bus: Bus, allow_while_mes_connected: bool) -> None:\n296\t        \"\"\"Run the passive listen for a transmit session that lacks a fresh proof.\"\"\"\n297\t        verifier = self.verifier\n298\t        if verifier is None:\n299\t            from . import ops  # late: ops imports this module\n300\t            verifier = ops.verify_bus\n301\t        result = verifier(bus.key, seconds=self.auto_verify_seconds,\n302\t                          allow_while_mes_connected=allow_while_mes_connected)\n303\t        self.last_auto_verify = {\"bus\": bus.key, \"verified\": bool(result.get(\"verified\")),\n304\t                                 \"frames\": result.get(\"frames\"),\n305\t                                 \"stn_protocol\": result.get(\"stn_protocol\"),\n306\t                                 \"error\": result.get(\"error\"),\n307\t                                 \"at\": datetime.now().isoformat(timespec=\"seconds\")}\n308\t        audit.record(\"auto_verify\", **self.last_auto_verify)\n309\t        if not result.get(\"verified\"):\n310\t            # On can_c the passive listen is tried first, but behind a 2018+\n311\t            # Security Gateway Module that bus carries no broadcast traffic\n312\t            # at all -- verify_bus() then falls back to one active Mode 01\n313\t            # PID 00 probe (see ops._active_probe_0100) before giving up, and\n314\t            # result[\"note\"] already says so when that also got no reply.\n315\t            raise Refused(\n316\t                f\"bus {bus.key} is silent: an automatic passive listen under cable \"\n317\t                f\"{self.cable!r} heard no traffic, so nothing was sent. Check the cable is \"\n318\t                f\"fitted and declared, the adapter's HS/MS switch, that it is fully seated, \"\n319\t                f\"and the ignition. Listen detail: {result.get('note') or result.get('error')}\")\n320\t\n321\t    auto_verify_seconds: float = 2.0\n322\t\n323\t    # --- sessions -------------------------------------------------------\n324\t\n325\t    @contextmanager\n326\t    def session(self, purpose: str, *, bus: Bus = CAN_C, port: str = \"\", baud: int = 0,\n327\t                passive: bool = False, confirm: bool = False,\n328\t                allow_while_mes_connected: bool = False,\n329\t                stream: Optional[Stream] = None,\n330\t                route: Optional[Route] = None,\n331\t                _bypass_silence_guard: bool = False) -> Iterator[Session]:\n332\t        \"\"\"Open the adapter for one operation on one bus, then close it.\n333\t\n334\t        ``passive=True`` sets receive-only mode (no CAN ACK) and skips the\n335\t        transmit policy; it is how a bus gets verified in the first place.\n336\t\n337\t        ``route`` overrides the preferred route for this one session, so a\n338\t        passive listen can try a bus's other protocols. It must belong to the\n339\t        declared cable; reachability is still decided by the cable, never by\n340\t        the override.\n341\t\n342\t        ``_bypass_silence_guard`` is a private escape hatch for exactly one\n343\t        caller: :func:`cuore.live.ops._active_probe_0100`, which transmits\n344\t        the single legislated request that *establishes* verification on\n345\t        CAN-C in the first place and so cannot itself be blocked by the\n346\t        guard it is trying to satisfy, or trigger another round of\n347\t        auto-verify. It is never reached from send_raw, HTTP, or any other\n348\t        MCP tool, and the caller is responsible for only ever using it on\n349\t        can_c.\n350\t        \"\"\"\n351\t        with self.lock:\n352\t            chosen = route_for(bus, self.cable)\n353\t            if chosen is None:\n354\t                raise LinkUnavailable(\n355\t                    f\"bus {bus.key} is not reachable with cable {self.cable!r}; declare the \"\n356\t                    f\"right cable first\")\n357\t            if route is not None:\n358\t                if route.cable != self.cable:\n359\t                    raise LinkUnavailable(\n360\t                        f\"route for cable {route.cable!r} cannot be used while cable \"\n361\t                        f\"{self.cable!r} is declared\")\n362\t                chosen = route\n363\t            auto: Optional[dict[str, Any]] = None\n364\t            if not passive and not _bypass_silence_guard:\n365\t                if bus.transmit_needs_confirmation and not confirm:\n366\t                    # Refuse before listening: consent comes first on CAN-CH.\n367\t                    assert_transmit_allowed(\n368\t                        bus_key=bus.key, bus_cable_ok=True, verified=True,\n369\t                        needs_confirmation=True, confirmed=False)\n370\t                if not self.is_verified(bus) and self.auto_verify and stream is None:\n371\t                    self._auto_verify(bus, allow_while_mes_connected)\n372\t                    auto = self.last_auto_verify\n373\t                assert_transmit_allowed(\n374\t                    bus_key=bus.key, bus_cable_ok=True,\n375\t                    verified=self.is_verified(bus),\n376\t                    needs_confirmation=bus.transmit_needs_confirmation, confirmed=confirm)\n377\t            p, psrc = resolve_port(port)\n378\t            b, bsrc = resolve_baud(baud)\n379\t            if not p and stream is None:\n380\t                raise LinkUnavailable(\"no port configured: pass port=, set CUORE_OBD_PORT or \"\n381\t                                      \"OBD_PORT, or configure Interface 0 in MultiEcuScan\")\n382\t            ms = interlock.mes_status()\n383\t            if ms[\"state\"] == \"connected\" and not allow_while_mes_connected:\n384\t                raise LinkUnavailable(\n385\t                    f\"MultiEcuScan is connected to the vehicle (label {ms['label']!r}, pids \"\n386\t                    f\"{ms['pids']}). Disconnect in MES first, or pass \"\n387\t                    f\"allow_while_mes_connected=True if MES is on a different port.\")\n388\t            interlock.acquire(p or \"stream\", purpose, process=self.process)\n389\t            st = stream or self.stream_factory(p or \"\", b)\n390\t            try:\n391\t                st.open()\n392\t            except Exception as e:  # serial.SerialException, OSError\n393\t                interlock.release()\n394\t                hint = \"\"\n395\t                if \"denied\" in str(e).lower() or \"PermissionError\" in str(e):\n396\t                    hint = (\" The port is held by another process: MES if connected, another \"\n397\t                            \"cuore/obd2 instance, or a terminal program.\")\n398\t                self.last_error = f\"open {p}@{b} failed: {e}\"\n399\t                raise LinkUnavailable(f\"could not open {p}@{b} ({psrc}, {bsrc}): {e}.{hint}\")\n400\t            self.port, self.baud, self.port_source, self.baud_source = p, b, psrc, bsrc\n401\t            self.last_open = datetime.now().isoformat(timespec=\"seconds\")\n402\t            sess = Session(self, st, bus, chosen, passive=passive, confirmed=confirm)\n403\t            sess.auto_verified = auto\n404\t            self.current = sess\n405\t            audit.record(\"session_open\", purpose=purpose, bus=bus.key, cable=self.cable,\n406\t                         passive=passive, port=p, baud=b, stream=st.describe)\n407\t            try:\n408\t                self._init(sess)\n409\t                yield sess\n410\t                audit.record(\"session_close\", purpose=purpose, bus=bus.key, ok=True)\n411\t            except Exception as e:\n412\t                self.last_error = str(e)\n413\t                audit.record(\"session_close\", purpose=purpose, bus=bus.key, ok=False,\n414\t                             error=str(e))\n415\t                raise\n416\t            finally:\n417\t                self.current = None\n418\t                try:\n419\t                    st.close()\n420\t                except Exception:\n421\t                    pass\n422\t                interlock.release()\n423\t\n424\t    def _init(self, sess: Session) -> None:\n425\t        \"\"\"Per-open adapter configuration; never inherits interpreter state.\"\"\"\n426\t        r = sess.cmd(\"ATE0\", 2)\n427\t        if looks_like_wrong_baud(r):\n428\t            raise LinkUnavailable(\n429\t                f\"adapter replied with framing garbage at {self.baud} baud ({self.baud_source}); \"\n430\t                f\"almost always the wrong speed\")\n431\t        if \"TIMEOUT\" in r and not r.replace(\"TIMEOUT\", \"\").strip():\n432\t            raise LinkUnavailable(f\"no reply from the adapter on {self.port}; is it plugged in?\")\n433\t        # ATCAF1 is restated every session: the adapter keeps settings across\n434\t        # port closes, a monitor session may have switched formatting off,\n435\t        # and a request sent without the ISO-TP PCI byte is ignored by every\n436\t        # ECU -- read as NO DATA on the bench (2026-10-13) while the probe,\n437\t        # which set ATCAF1 itself, got answers on the same bus.\n438\t        for c in (\"ATL0\", \"ATS0\", \"ATH1\", \"ATAT1\", \"ATCAF1\"):\n439\t            sess.cmd(c, 2)\n440\t        if not self.identity:\n441\t            self._probe_identity(sess)\n442\t        route = sess.route\n443\t        if self.is_stn:\n444\t            sess.cmd(f\"STP {route.stn_protocol}\", 2)\n445\t            if route.bitrate_override:\n446\t                sess.cmd(f\"STPBR {route.bitrate_override}\", 2)\n447\t            # STCMM persists across port closes; a passive listen must not\n448\t            # leave the next request session in receive-only (no-ACK) mode.\n449\t            sess.cmd(\"STCMM 0\" if sess.passive else \"STCMM 1\", 2)\n450\t        else:\n451\t            elm = _ELM_EQUIVALENT.get(route.stn_protocol)\n452\t            if elm is None or route.bitrate_override:\n453\t                raise LinkUnavailable(\n454\t                    f\"bus {sess.bus.key} via route {route.stn_protocol} needs an STN adapter; \"\n455\t                    f\"this adapter identifies as {self.identity.get('ATI', 'unknown')}\")\n456\t            sess.cmd(f\"ATSP{elm}\", 2)\n457\t        sess.headers_on = True\n458\t\n459\t    def _probe_identity(self, sess: Session) -> None:\n460\t        ident: dict[str, str] = {}\n461\t        for c in (\"ATI\", \"AT@1\", \"STI\", \"STDI\", \"STMFR\", \"STSN\"):\n462\t            r = sess.cmd(c, 2)\n463\t            if r and r != \"?\" and not adapter_error(r):\n464\t                ident[c] = r\n465\t        self.identity = ident\n466\t        self.is_stn = \"STI\" in ident\n467\t\n468\t    # --- reporting ------------------------------------------------------\n469\t\n470\t    def adapter_info(self) -> dict[str, Any]:\n471\t        \"\"\"The ``AdapterInfo`` fields for ``/api/capabilities``, never raising.\"\"\"\n472\t        try:\n473\t            port, _ = resolve_port()\n474\t            blocked = interlock.blocked_by()\n475\t            return {\"present\": bool(port) and blocked is None, \"port\": port,\n476\t                    \"blocked_by\": blocked,\n477\t                    \"note\": (\"port opened per operation; \" +\n478\t                             (f\"adapter {self.identity.get('STDI') or self.identity.get('ATI')}\"\n479\t                              if self.identity else \"adapter not probed yet\"))}\n480\t        except Exception as e:  # pragma: no cover - defensive\n481\t            return {\"present\": False, \"port\": None, \"blocked_by\": None, \"note\": str(e)}\n482\t\n483\t    def status(self) -> dict[str, Any]:\n484\t        port, psrc = resolve_port()\n485\t        baud, bsrc = resolve_baud()\n486\t        return {\n487\t            \"port\": port, \"port_source\": psrc, \"baud\": baud, \"baud_source\": bsrc,\n488\t            \"adapter_identity\": self.identity or None, \"is_stn\": self.is_stn,\n489\t            \"last_open\": self.last_open, \"last_error\": self.last_error,\n490\t            \"mes\": interlock.mes_status(), \"lock\": interlock.read_lock(),\n491\t            \"lock_path\": str(interlock.lock_path()),\n492\t            \"cable\": self.cable_state(), \"vin\": self.vin or None,\n493\t            \"note\": \"the port is opened per operation and released after each call\",\n494\t        }\n495\t\n496\t\n497\t_LINK: Optional[AdapterLink] = None\n498\t_LINK_LOCK = threading.Lock()\n499\t\n500\t\n501\tdef link() -> AdapterLink:\n502\t    \"\"\"The process-wide link, created on first use.\"\"\"\n503\t    global _LINK\n504\t    with _LINK_LOCK:\n505\t        if _LINK is None:\n506\t            _LINK = AdapterLink()\n507\t        return _LINK\n508\t\n509\t\n510\tdef set_link(new: AdapterLink) -> None:\n511\t    \"\"\"Replace the process-wide link (tests inject a playback-backed one).\"\"\"\n512\t    global _LINK\n513\t    with _LINK_LOCK:\n514\t        _LINK = new\n515\t\n516\t\n517\t__all__ = [\"DEFAULT_TIMEOUT\", \"clamp_timeout\", \"Session\", \"AdapterLink\", \"link\", \"set_link\"]\n518\t"}]},"uuid":"c7631a4a-68fd-4dc5-b38f-10d034f5530f","timestamp":"2026-10-14T11:06:53.908Z","toolUseResult":{"type":"text","file":{"filePath":"C:\\Users\\User\\mcp-servers\\cuore\\live\\transport.py","content":"\"\"\"AdapterLink: one adapter, opened per operation, one bus per session.\n\nThe link owns no open port between calls. ``session()`` resolves port and\nspeed, checks the MES interlock, takes the process lock and the advisory lock\nfile, opens the stream, initialises the adapter, selects the bus route for\nthe declared cable, enforces the transmit policy, yields a :class:`Session`,\nand closes everything on the way out. That is the whole contract, and it is\nwhat lets MultiEcuScan take the adapter the moment a call returns.\n\nCable state lives here too. It is declared, not detected; every result names\nit; changing it clears every bus verification.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport os\nimport re\nimport threading\nimport time\nfrom contextlib import contextmanager\nfrom datetime import datetime\nfrom typing import Any, Callable, Iterator, Optional\n\nfrom . import audit, interlock\nfrom .addressing import ECUAddress\nfrom .buses import CABLES, CAN_C, BUSES, Bus, Route, header_bits_for_protocol, route_for\nfrom .config import default_cable, resolve_baud, resolve_port\nfrom .errors import AdapterFault, BadCommand, LinkUnavailable, Refused\nfrom .framing import (adapter_error, looks_like_wrong_baud, negative_responses,\n                      payloads_for, reassemble)\nfrom .safety import assert_transmit_allowed, validate_command\nfrom .stream import SerialStream, Stream\n\ntry:  # OBD_TIMEOUT is honoured for compatibility with the obd2-mcp registration\n    DEFAULT_TIMEOUT = float(os.environ.get(\"OBD_TIMEOUT\", \"4\"))\nexcept ValueError:\n    DEFAULT_TIMEOUT = 4.0\nMIN_TIMEOUT, MAX_TIMEOUT = 0.2, 30.0\n\n#: STN preset -> ELM327 protocol number for adapters without ST commands.\n_ELM_EQUIVALENT = {\"33\": \"6\", \"34\": \"7\", \"35\": \"8\", \"36\": \"9\", \"31\": \"6\", \"32\": \"7\"}\n\n\ndef clamp_timeout(t: float) -> float:\n    try:\n        t = float(t)\n    except (TypeError, ValueError):\n        return DEFAULT_TIMEOUT\n    return max(MIN_TIMEOUT, min(MAX_TIMEOUT, t))\n\n\nclass Session:\n    \"\"\"An open adapter, configured for one bus. Valid only inside ``session()``.\"\"\"\n\n    def __init__(self, link: \"AdapterLink\", stream: Stream, bus: Bus, route: Route,\n                 *, passive: bool, confirmed: bool) -> None:\n        self.link = link\n        self.stream = stream\n        self.bus = bus\n        self.route = route\n        self.passive = passive\n        self.confirmed = confirmed\n        self.headers_on = True\n        self.header_bits = header_bits_for_protocol(route.stn_protocol)\n        self._target: Optional[tuple[str, str]] = None\n        self.opened_at = datetime.now().isoformat(timespec=\"seconds\")\n\n    # --- wire ----------------------------------------------------------\n\n    def cmd(self, command: str, timeout: float = DEFAULT_TIMEOUT) -> str:\n        \"\"\"Send one command and read until the ``>`` prompt or the deadline.\n\n        A reply with no prompt is tagged ``TIMEOUT`` so it counts as an\n        incomplete read rather than an empty result.\n        \"\"\"\n        command = validate_command(command)\n        timeout = clamp_timeout(timeout)\n        s = self.stream\n        s.reset_input_buffer()\n        s.write((command + \"\\r\").encode(\"ascii\"))\n        s.flush()\n        deadline = time.monotonic() + timeout\n        buf = bytearray()\n        got_prompt = False\n        while time.monotonic() < deadline:\n            chunk = s.read(s.in_waiting() or 1)\n            if not chunk:\n                continue\n            buf.extend(chunk)\n            if b\">\" in chunk:\n                got_prompt = True\n                break\n        text = buf.decode(\"ascii\", errors=\"replace\").replace(\"\\r\", \"\\n\").strip(\" \\n>\")\n        if text.upper().startswith(command.upper()):\n            text = text[len(command):].lstrip(\" \\n\")\n        if not got_prompt:\n            text = (text + \"\\nTIMEOUT\").strip()\n        return text\n\n    def query(self, request_hex: str, response_byte: str,\n              timeout: float = DEFAULT_TIMEOUT) -> dict[str, Any]:\n        \"\"\"Send a request; return raw text, error, and per-ECU positive payloads.\"\"\"\n        raw = self.cmd(request_hex, timeout)\n        err = adapter_error(raw)\n        ecus = reassemble(raw, headers_on=self.headers_on) if not err else {}\n        return {\"raw\": raw, \"error\": err or None, \"ecus\": payloads_for(ecus, response_byte),\n                \"all_ecus\": ecus}\n\n    # --- addressing -----------------------------------------------------\n\n    def target(self, ecu: ECUAddress) -> None:\n        \"\"\"Point requests at one module; idempotent within the session.\"\"\"\n        if not ecu.usable and ecu.target is None:\n            raise BadCommand(f\"module {ecu.code} has no known address\")\n        self.target_raw(ecu.request_hex or \"\", ecu.response_hex or \"\")\n\n    def target_raw(self, request_hex: str, response_hex: str) -> None:\n        pair = (request_hex.upper(), response_hex.upper())\n        if self._target == pair:\n            return\n        self.cmd(f\"ATSH{pair[0]}\", 2)\n        self.cmd(f\"ATCRA{pair[1]}\", 2)\n        if self.link.is_stn:\n            self.cmd(f\"STCFCPA {pair[0]},{pair[1]}\", 2)\n        else:\n            self.cmd(f\"ATFCSH{pair[0]}\", 2)\n            self.cmd(\"ATFCSD300000\", 2)\n            self.cmd(\"ATFCSM1\", 2)\n        self._target = pair\n        self.link._last_target = pair\n\n    def untarget(self) -> None:\n        \"\"\"Back to functional/broadcast addressing for legislated OBD.\n\n        The adapter keeps ATSH/ATCRA across port closes, so a fresh session\n        inherits the link's last physical target and clears it here rather\n        than trusting its own (empty) memory.\n        \"\"\"\n        if self._target is None:\n            self._target = getattr(self.link, \"_last_target\", None)\n        # Always restate the functional header: the adapter remembers the last\n        # ATSH across port closes and protocol switches, and a process restart\n        # forgets what that was.\n        if self.header_bits == 29:\n            # 29-bit functional header the way the ELM/STN command set takes\n            # it: priority byte via ATCP, lower 24 bits via ATSH. A single\n            # 8-digit ATSH is not accepted by every firmware and silently\n            # leaves the last header in force (read as NO DATA on the bench,\n            # 2026-10-13, while the probe built this way got answers).\n            self.cmd(\"ATCP18\", 2)\n            self.cmd(\"ATSHDB33F1\", 2)\n            self.cmd(\"ATSTFF\", 2)\n        else:\n            self.cmd(\"ATSH7DF\", 2)\n        self.cmd(\"ATCRA\", 2)\n        if self.link.is_stn:\n            # Bench finding 2026-10-13 (vLinker FS r2, STN1170 v4.3.2): STFAC\n            # removes the firmware's default pass filters too, after which\n            # every reply is dropped and each request reads NO DATA. Re-issuing\n            # the protocol select restores the defaults, and the functional\n            # header must then be restated because STP resets it as well.\n            self.cmd(\"STCFCPC\", 2)\n            self.cmd(f\"STP {self.route.stn_protocol}\", 2)\n            if self.header_bits == 29:\n                self.cmd(\"ATCP18\", 2)\n                self.cmd(\"ATSHDB33F1\", 2)\n                self.cmd(\"ATSTFF\", 2)\n            else:\n                self.cmd(\"ATSH7DF\", 2)\n        self._target = None\n        self.link._last_target = None\n\n    # --- UDS primitive --------------------------------------------------\n\n    def uds(self, ecu: ECUAddress, service: int, payload: bytes = b\"\",\n            timeout: float = DEFAULT_TIMEOUT, retries_on_pending: int = 3) -> dict[str, Any]:\n        \"\"\"One UDS request to one module. Read-only services only (enforced upstream).\n\n        NRC ``0x78`` (responsePending) is handled by re-issuing the request\n        after a short wait, up to ``retries_on_pending`` times, which is the\n        practical equivalent of waiting P2* on an adapter that returns to its\n        prompt after the first reply.\n        \"\"\"\n        self.target(ecu)\n        req = f\"{service:02X}{payload.hex().upper()}\"\n        resp_byte = f\"{service + 0x40:02X}\"\n        svc_hex = f\"{service:02X}\"\n        attempts = 0\n        while True:\n            attempts += 1\n            q = self.query(req, resp_byte, timeout)\n            nrc = negative_responses(q[\"all_ecus\"], svc_hex)\n            pending = [h for h, code in nrc.items() if code == \"78\"]\n            if pending and not q[\"ecus\"] and attempts <= retries_on_pending:\n                time.sleep(0.3 * attempts)\n                continue\n            break\n        mine = {h: d for h, d in q[\"ecus\"].items()\n                if not ecu.response_hex or h == ecu.response_hex or h == \"\"}\n        return {\"request\": req, \"raw\": q[\"raw\"], \"error\": q[\"error\"],\n                \"positive\": mine, \"nrc\": {h: int(c, 16) for h, c in nrc.items()},\n                \"attempts\": attempts, \"ecu\": ecu.code, \"bus\": self.bus.key}\n\n\nclass AdapterLink:\n    \"\"\"The one object that opens the adapter. Create one per process.\"\"\"\n\n    def __init__(self, stream_factory: Optional[Callable[[str, int], Stream]] = None,\n                 process: str = \"cuore\") -> None:\n        self.stream_factory = stream_factory or (lambda p, b: SerialStream(p, b))\n        self.process = process\n        self.lock = threading.RLock()\n        self.cable: str = default_cable()\n        self.identity: dict[str, str] = {}\n        self.is_stn: bool = False\n        self.port: Optional[str] = None\n        self.baud: int = 0\n        self.port_source = \"\"\n        self.baud_source = \"\"\n        self.last_open: Optional[str] = None\n        self.last_error: Optional[str] = None\n        self.verified: dict[str, dict[str, Any]] = {}   # bus_key -> {cable, frames, at, ts}\n        # Auto-verify: a transmit session on an unverified (or stale) bus runs\n        # the passive listen itself instead of refusing. Off with\n        # CUORE_AUTO_VERIFY=0; the proof window is CUORE_VERIFY_TTL seconds.\n        self.auto_verify: bool = os.environ.get(\"CUORE_AUTO_VERIFY\", \"1\") != \"0\"\n        self.verify_ttl: float = float(os.environ.get(\"CUORE_VERIFY_TTL\", \"600\"))\n        self.verifier: Optional[Callable[..., dict[str, Any]]] = None\n        self.last_auto_verify: Optional[dict[str, Any]] = None\n        self.vin: str = \"\"                               # last VIN the car reported\n        self.current: Optional[Session] = None\n\n    # --- cable state ----------------------------------------------------\n\n    def set_cable(self, cable: str) -> dict[str, Any]:\n        cable = (cable or \"none\").lower()\n        if cable not in CABLES:\n            raise BadCommand(f\"unknown cable {cable!r}; one of {list(CABLES)}\")\n        with self.lock:\n            changed = cable != self.cable\n            self.cable = cable\n            if changed:\n                self.verified.clear()\n            audit.record(\"cable_declared\", cable=cable, cleared_verifications=changed)\n        return self.cable_state()\n\n    def cable_state(self) -> dict[str, Any]:\n        buses = []\n        for key, bus in BUSES.items():\n            route = route_for(bus, self.cable)\n            ver = self.verified.get(key) if self.is_verified(bus) else None\n            buses.append({\n                \"bus\": key, \"name\": bus.name, \"pins\": list(bus.pins), \"bitrate\": bus.bitrate,\n                \"reachable_with_cable\": route is not None,\n                \"route\": (None if route is None else {\n                    \"stn_protocol\": route.stn_protocol, \"bitrate_override\": route.bitrate_override,\n                    \"status\": route.status, \"note\": route.note}),\n                \"verified\": bool(ver), \"verified_at\": (ver or {}).get(\"at\"),\n                \"verified_frames\": (ver or {}).get(\"frames\"),\n                \"verified_by\": (ver or {}).get(\"verified_by\"),\n                \"transmit_needs_confirmation\": bus.transmit_needs_confirmation,\n            })\n        return {\"cable\": self.cable, \"buses\": buses}\n\n    def mark_verified(self, bus: Bus, frames: int, *, verified_by: str = \"passive_listen\",\n                      **extra: Any) -> None:\n        \"\"\"Record a bus as proven live under the declared cable.\n\n        ``verified_by`` names how: ``\"passive_listen\"`` (frames overheard\n        with no transmission at all) or ``\"active_probe_0100\"`` (CAN-C behind\n        a Security Gateway Module carries no broadcast traffic, so the only\n        proof available is a reply to one legislated Mode 01 PID 00 request\n        -- see :func:`cuore.live.ops._active_probe_0100`). ``extra`` is\n        merged in for callers that want to carry e.g. the responding ECU ids.\n        \"\"\"\n        self.verified[bus.key] = {\"cable\": self.cable, \"frames\": frames,\n                                  \"verified_by\": verified_by,\n                                  \"at\": datetime.now().isoformat(timespec=\"seconds\"),\n                                  \"ts\": time.monotonic(), **extra}\n\n    def is_verified(self, bus: Bus) -> bool:\n        \"\"\"Verified under the declared cable, and recently enough to trust.\n\n        A proof older than ``verify_ttl`` is treated as absent: an adapter\n        can lose the bus without the port noticing (a moved HS/MS switch, a\n        half-seated plug), and a stale flag then turns every read into a\n        confident-looking NO DATA.\n        \"\"\"\n        ver = self.verified.get(bus.key)\n        if not ver or ver.get(\"cable\") != self.cable:\n            return False\n        ts = ver.get(\"ts\")\n        return ts is None or self.verify_ttl <= 0 or time.monotonic() - ts <= self.verify_ttl\n\n    def _auto_verify(self, bus: Bus, allow_while_mes_connected: bool) -> None:\n        \"\"\"Run the passive listen for a transmit session that lacks a fresh proof.\"\"\"\n        verifier = self.verifier\n        if verifier is None:\n            from . import ops  # late: ops imports this module\n            verifier = ops.verify_bus\n        result = verifier(bus.key, seconds=self.auto_verify_seconds,\n                          allow_while_mes_connected=allow_while_mes_connected)\n        self.last_auto_verify = {\"bus\": bus.key, \"verified\": bool(result.get(\"verified\")),\n                                 \"frames\": result.get(\"frames\"),\n                                 \"stn_protocol\": result.get(\"stn_protocol\"),\n                                 \"error\": result.get(\"error\"),\n                                 \"at\": datetime.now().isoformat(timespec=\"seconds\")}\n        audit.record(\"auto_verify\", **self.last_auto_verify)\n        if not result.get(\"verified\"):\n            # On can_c the passive listen is tried first, but behind a 2018+\n            # Security Gateway Module that bus carries no broadcast traffic\n            # at all -- verify_bus() then falls back to one active Mode 01\n            # PID 00 probe (see ops._active_probe_0100) before giving up, and\n            # result[\"note\"] already says so when that also got no reply.\n            raise Refused(\n                f\"bus {bus.key} is silent: an automatic passive listen under cable \"\n                f\"{self.cable!r} heard no traffic, so nothing was sent. Check the cable is \"\n                f\"fitted and declared, the adapter's HS/MS switch, that it is fully seated, \"\n                f\"and the ignition. Listen detail: {result.get('note') or result.get('error')}\")\n\n    auto_verify_seconds: float = 2.0\n\n    # --- sessions -------------------------------------------------------\n\n    @contextmanager\n    def session(self, purpose: str, *, bus: Bus = CAN_C, port: str = \"\", baud: int = 0,\n                passive: bool = False, confirm: bool = False,\n                allow_while_mes_connected: bool = False,\n                stream: Optional[Stream] = None,\n                route: Optional[Route] = None,\n                _bypass_silence_guard: bool = False) -> Iterator[Session]:\n        \"\"\"Open the adapter for one operation on one bus, then close it.\n\n        ``passive=True`` sets receive-only mode (no CAN ACK) and skips the\n        transmit policy; it is how a bus gets verified in the first place.\n\n        ``route`` overrides the preferred route for this one session, so a\n        passive listen can try a bus's other protocols. It must belong to the\n        declared cable; reachability is still decided by the cable, never by\n        the override.\n\n        ``_bypass_silence_guard`` is a private escape hatch for exactly one\n        caller: :func:`cuore.live.ops._active_probe_0100`, which transmits\n        the single legislated request that *establishes* verification on\n        CAN-C in the first place and so cannot itself be blocked by the\n        guard it is trying to satisfy, or trigger another round of\n        auto-verify. It is never reached from send_raw, HTTP, or any other\n        MCP tool, and the caller is responsible for only ever using it on\n        can_c.\n        \"\"\"\n        with self.lock:\n            chosen = route_for(bus, self.cable)\n            if chosen is None:\n                raise LinkUnavailable(\n                    f\"bus {bus.key} is not reachable with cable {self.cable!r}; declare the \"\n                    f\"right cable first\")\n            if route is not None:\n                if route.cable != self.cable:\n                    raise LinkUnavailable(\n                        f\"route for cable {route.cable!r} cannot be used while cable \"\n                        f\"{self.cable!r} is declared\")\n                chosen = route\n            auto: Optional[dict[str, Any]] = None\n            if not passive and not _bypass_silence_guard:\n                if bus.transmit_needs_confirmation and not confirm:\n                    # Refuse before listening: consent comes first on CAN-CH.\n                    assert_transmit_allowed(\n                        bus_key=bus.key, bus_cable_ok=True, verified=True,\n                        needs_confirmation=True, confirmed=False)\n                if not self.is_verified(bus) and self.auto_verify and stream is None:\n                    self._auto_verify(bus, allow_while_mes_connected)\n                    auto = self.last_auto_verify\n                assert_transmit_allowed(\n                    bus_key=bus.key, bus_cable_ok=True,\n                    verified=self.is_verified(bus),\n                    needs_confirmation=bus.transmit_needs_confirmation, confirmed=confirm)\n            p, psrc = resolve_port(port)\n            b, bsrc = resolve_baud(baud)\n            if not p and stream is None:\n                raise LinkUnavailable(\"no port configured: pass port=, set CUORE_OBD_PORT or \"\n                                      \"OBD_PORT, or configure Interface 0 in MultiEcuScan\")\n            ms = interlock.mes_status()\n            if ms[\"state\"] == \"connected\" and not allow_while_mes_connected:\n                raise LinkUnavailable(\n                    f\"MultiEcuScan is connected to the vehicle (label {ms['label']!r}, pids \"\n                    f\"{ms['pids']}). Disconnect in MES first, or pass \"\n                    f\"allow_while_mes_connected=True if MES is on a different port.\")\n            interlock.acquire(p or \"stream\", purpose, process=self.process)\n            st = stream or self.stream_factory(p or \"\", b)\n            try:\n                st.open()\n            except Exception as e:  # serial.SerialException, OSError\n                interlock.release()\n                hint = \"\"\n                if \"denied\" in str(e).lower() or \"PermissionError\" in str(e):\n                    hint = (\" The port is held by another process: MES if connected, another \"\n                            \"cuore/obd2 instance, or a terminal program.\")\n                self.last_error = f\"open {p}@{b} failed: {e}\"\n                raise LinkUnavailable(f\"could not open {p}@{b} ({psrc}, {bsrc}): {e}.{hint}\")\n            self.port, self.baud, self.port_source, self.baud_source = p, b, psrc, bsrc\n            self.last_open = datetime.now().isoformat(timespec=\"seconds\")\n            sess = Session(self, st, bus, chosen, passive=passive, confirmed=confirm)\n            sess.auto_verified = auto\n            self.current = sess\n            audit.record(\"session_open\", purpose=purpose, bus=bus.key, cable=self.cable,\n                         passive=passive, port=p, baud=b, stream=st.describe)\n            try:\n                self._init(sess)\n                yield sess\n                audit.record(\"session_close\", purpose=purpose, bus=bus.key, ok=True)\n            except Exception as e:\n                self.last_error = str(e)\n                audit.record(\"session_close\", purpose=purpose, bus=bus.key, ok=False,\n                             error=str(e))\n                raise\n            finally:\n                self.current = None\n                try:\n                    st.close()\n                except Exception:\n                    pass\n                interlock.release()\n\n    def _init(self, sess: Session) -> None:\n        \"\"\"Per-open adapter configuration; never inherits interpreter state.\"\"\"\n        r = sess.cmd(\"ATE0\", 2)\n        if looks_like_wrong_baud(r):\n            raise LinkUnavailable(\n                f\"adapter replied with framing garbage at {self.baud} baud ({self.baud_source}); \"\n                f\"almost always the wrong speed\")\n        if \"TIMEOUT\" in r and not r.replace(\"TIMEOUT\", \"\").strip():\n            raise LinkUnavailable(f\"no reply from the adapter on {self.port}; is it plugged in?\")\n        # ATCAF1 is restated every session: the adapter keeps settings across\n        # port closes, a monitor session may have switched formatting off,\n        # and a request sent without the ISO-TP PCI byte is ignored by every\n        # ECU -- read as NO DATA on the bench (2026-10-13) while the probe,\n        # which set ATCAF1 itself, got answers on the same bus.\n        for c in (\"ATL0\", \"ATS0\", \"ATH1\", \"ATAT1\", \"ATCAF1\"):\n            sess.cmd(c, 2)\n        if not self.identity:\n            self._probe_identity(sess)\n        route = sess.route\n        if self.is_stn:\n            sess.cmd(f\"STP {route.stn_protocol}\", 2)\n            if route.bitrate_override:\n                sess.cmd(f\"STPBR {route.bitrate_override}\", 2)\n            # STCMM persists across port closes; a passive listen must not\n            # leave the next request session in receive-only (no-ACK) mode.\n            sess.cmd(\"STCMM 0\" if sess.passive else \"STCMM 1\", 2)\n        else:\n            elm = _ELM_EQUIVALENT.get(route.stn_protocol)\n            if elm is None or route.bitrate_override:\n                raise LinkUnavailable(\n                    f\"bus {sess.bus.key} via route {route.stn_protocol} needs an STN adapter; \"\n                    f\"this adapter identifies as {self.identity.get('ATI', 'unknown')}\")\n            sess.cmd(f\"ATSP{elm}\", 2)\n        sess.headers_on = True\n\n    def _probe_identity(self, sess: Session) -> None:\n        ident: dict[str, str] = {}\n        for c in (\"ATI\", \"AT@1\", \"STI\", \"STDI\", \"STMFR\", \"STSN\"):\n            r = sess.cmd(c, 2)\n            if r and r != \"?\" and not adapter_error(r):\n                ident[c] = r\n        self.identity = ident\n        self.is_stn = \"STI\" in ident\n\n    # --- reporting ------------------------------------------------------\n\n    def adapter_info(self) -> dict[str, Any]:\n        \"\"\"The ``AdapterInfo`` fields for ``/api/capabilities``, never raising.\"\"\"\n        try:\n            port, _ = resolve_port()\n            blocked = interlock.blocked_by()\n            return {\"present\": bool(port) and blocked is None, \"port\": port,\n                    \"blocked_by\": blocked,\n                    \"note\": (\"port opened per operation; \" +\n                             (f\"adapter {self.identity.get('STDI') or self.identity.get('ATI')}\"\n                              if self.identity else \"adapter not probed yet\"))}\n        except Exception as e:  # pragma: no cover - defensive\n            return {\"present\": False, \"port\": None, \"blocked_by\": None, \"note\": str(e)}\n\n    def status(self) -> dict[str, Any]:\n        port, psrc = resolve_port()\n        baud, bsrc = resolve_baud()\n        return {\n            \"port\": port, \"port_source\": psrc, \"baud\": baud, \"baud_source\": bsrc,\n            \"adapter_identity\": self.identity or None, \"is_stn\": self.is_stn,\n            \"last_open\": self.last_open, \"last_error\": self.last_error,\n            \"mes\": interlock.mes_status(), \"lock\": interlock.read_lock(),\n            \"lock_path\": str(interlock.lock_path()),\n            \"cable\": self.cable_state(), \"vin\": self.vin or None,\n            \"note\": \"the port is opened per operation and released after each call\",\n        }\n\n\n_LINK: Optional[AdapterLink] = None\n_LINK_LOCK = threading.Lock()\n\n\ndef link() -> AdapterLink:\n    \"\"\"The process-wide link, created on first use.\"\"\"\n    global _LINK\n    with _LINK_LOCK:\n        if _LINK is None:\n            _LINK = AdapterLink()\n        return _LINK\n\n\ndef set_link(new: AdapterLink) -> None:\n    \"\"\"Replace the process-wide link (tests inject a playback-backed one).\"\"\"\n    global _LINK\n    with _LINK_LOCK:\n        _LINK = new\n\n\n__all__ = [\"DEFAULT_TIMEOUT\", \"clamp_timeout\", \"Session\", \"AdapterLink\", \"link\", \"set_link\"]\n","numLines":518,"startLine":1,"totalLines":518}},"sourceToolAssistantUUID":"dc455976-6566-4f26-9de0-bc33fcadfcee","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
