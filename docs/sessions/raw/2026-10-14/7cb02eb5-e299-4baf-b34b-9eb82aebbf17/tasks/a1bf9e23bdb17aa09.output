{"parentUuid":"5914c0c6-7adb-481b-95ab-75a2daf5a193","isSidechain":true,"promptId":"3332b329-cf49-4440-aab6-3dd05635f08d","agentId":"a1bf9e23bdb17aa09","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014tDA5RcjQftfb4fA35MvJp","type":"tool_result","content":"230\t\n231\t\n232\t# ===========================================================================\n233\t# 2. computed-channel math (safe evaluator, no eval())\n234\t# ===========================================================================\n235\t\n236\tcheck_eq(\"boost = MAP - baro\", channels_mod.eval_expr(\n237\t    \"intake_map - barometric_pressure\", {\"intake_map\": 100.0, \"barometric_pressure\": 101.0}),\n238\t    -1.0)\n239\tcheck_eq(\"parentheses and precedence\", channels_mod.eval_expr(\n240\t    \"(a + b) * 2\", {\"a\": 1.0, \"b\": 2.0}), 6.0)\n241\tcheck(\"missing dependency raises ComputedError\",\n242\t      raises(channels_mod.ComputedError,\n243\t            lambda: channels_mod.eval_expr(\"missing_channel * 2\", {})))\n244\tcheck(\"a stray character raises ComputedError\",\n245\t      raises(channels_mod.ComputedError, lambda: channels_mod.eval_expr(\"a & b\", {\"a\": 1, \"b\": 1})))\n246\tcheck(\"no eval() is reachable: 'import' is just an unresolved identifier\",\n247\t      raises(channels_mod.ComputedError,\n248\t            lambda: channels_mod.eval_expr(\"__import__('os')\", {})))\n249\t\n250\t\n251\t# ===========================================================================\n252\t# 3 & 4. multi-PID batching, single-PID fallback, DID reads, the poller\n253\t# ===========================================================================\n254\t\n255\tfake1 = LiveFakeStream()\n256\tlk1 = AdapterLink(stream_factory=lambda p, b: fake1, process=\"check_live_data\")\n257\tset_link(lk1)\n258\tlk1.mark_verified(CAN_C, 10)\n259\t\n260\tp = poller_mod.LivePoller()\n261\tpoller_mod.set_poller(p)\n262\t\n263\tchans = channels_mod.resolve_channels([\"engine_rpm\", \"vehicle_speed\", \"engine_coolant_temp\",\n264\t                                       \"tcm_04fe\"])\n265\tstarted = p.start(chans, rates={\"engine_rpm\": 5.0, \"vehicle_speed\": 5.0,\n266\t                                \"engine_coolant_temp\": 0.5, \"tcm_04fe\": 1.0})\n267\tcheck(\"session start reports active\", started.get(\"active\") is True, str(started))\n268\t\n269\tcheck(\"the first poll tick sent the 3-way multi-PID request\",\n270\t      wait_until(lambda: \"010C0D05\" in fake1.sent), str(fake1.sent[:10]))\n271\t\n272\tsnap = wait_until(lambda: p.snapshot()[\"channels\"][\"engine_rpm\"][\"value\"] is not None)\n273\tcheck(\"engine_rpm decoded from the multi-PID reply\", snap)\n274\ts = p.snapshot()[\"channels\"]\n275\tcheck_eq(\"engine_rpm value\", s[\"engine_rpm\"][\"value\"], 2000.0)\n276\tcheck_eq(\"vehicle_speed value\", s[\"vehicle_speed\"][\"value\"], 60.0)\n277\tcheck_eq(\"engine_coolant_temp value\", s[\"engine_coolant_temp\"][\"value\"], 40.0)\n278\t\n279\tcheck(\"DID mode grouped under one retarget to TCM (0x18)\",\n280\t      wait_until(lambda: \"2204FE\" in fake1.sent), str(fake1.sent))\n281\ttcm_snap = wait_until(lambda: p.snapshot()[\"channels\"][\"tcm_04fe\"][\"value\"] is not None)\n282\tcheck(\"tcm_04fe (gearbox oil temp) decoded\", tcm_snap)\n283\tcheck_eq(\"tcm_04fe value (0x7D - 40)\", p.snapshot()[\"channels\"][\"tcm_04fe\"][\"value\"], 85.0)\n284\t\n285\tcheck_eq(\"multi-PID stays supported when the ECU answers every PID asked\",\n286\t         p.status()[\"multi_pid_supported\"], True)\n287\tcheck(\"the session held one port open (opens==1) despite many poll ticks\",\n288\t      wait_until(lambda: fake1.opens == 1) and fake1.opens == 1, str(fake1.opens))\n289\t\n290\tp.stop()\n291\tcheck(\"stop releases the adapter lock\", interlock.read_lock() is None, str(interlock.read_lock()))\n292\tcheck(\"stop leaves the link with no current session\", lk1.current is None)\n293\t\n294\t# -- fallback: an ECU that only answers part of a multi-PID request ---------\n295\t\n296\tpartial_replies = dict(PID_REPLIES)\n297\t# Coolant missing from the multi reply -- only two of the three groups answered.\n298\tpartial_replies[\"010C0D05\"] = _frames(\"7E8\", \"410C1F40\" + \"410D3C\")\n299\tfake2 = LiveFakeStream(partial_replies)\n300\tlk2 = AdapterLink(stream_factory=lambda p, b: fake2, process=\"check_live_data\")\n301\tset_link(lk2)\n302\tlk2.mark_verified(CAN_C, 10)\n303\t\n304\tp2 = poller_mod.LivePoller()\n305\tpoller_mod.set_poller(p2)\n306\tchans2 = channels_mod.resolve_channels([\"engine_rpm\", \"vehicle_speed\", \"engine_coolant_temp\"])\n307\tp2.start(chans2, rates={\"engine_rpm\": 5.0, \"vehicle_speed\": 5.0, \"engine_coolant_temp\": 5.0})\n308\tcheck(\"the multi-PID request is tried once\",\n309\t      wait_until(lambda: \"010C0D05\" in fake2.sent), str(fake2.sent[:10]))\n310\tcheck(\"an ECU answering fewer PIDs than asked turns multi-PID support off\",\n311\t      wait_until(lambda: p2.status()[\"multi_pid_supported\"] is False))\n312\tcheck(\"after falling back, coolant is polled as its own single-PID request\",\n313\t      wait_until(lambda: \"0105\" in fake2.sent), str(fake2.sent))\n314\tcheck(\"coolant still eventually decodes via the single-PID fallback\",\n315\t      wait_until(lambda: p2.snapshot()[\"channels\"][\"engine_coolant_temp\"][\"value\"] == 40.0))\n316\tp2.stop()\n317\t\n318\t\n319\t# ==========================================================================="}]},"uuid":"322cafe9-2589-42f1-b5b1-6116f68d97af","timestamp":"2026-10-14T11:14:04.229Z","toolUseResult":{"type":"text","file":{"filePath":"C:\\Users\\User\\mcp-servers\\cuore\\tests\\check_live_data.py","content":"\n\n# ===========================================================================\n# 2. computed-channel math (safe evaluator, no eval())\n# ===========================================================================\n\ncheck_eq(\"boost = MAP - baro\", channels_mod.eval_expr(\n    \"intake_map - barometric_pressure\", {\"intake_map\": 100.0, \"barometric_pressure\": 101.0}),\n    -1.0)\ncheck_eq(\"parentheses and precedence\", channels_mod.eval_expr(\n    \"(a + b) * 2\", {\"a\": 1.0, \"b\": 2.0}), 6.0)\ncheck(\"missing dependency raises ComputedError\",\n      raises(channels_mod.ComputedError,\n            lambda: channels_mod.eval_expr(\"missing_channel * 2\", {})))\ncheck(\"a stray character raises ComputedError\",\n      raises(channels_mod.ComputedError, lambda: channels_mod.eval_expr(\"a & b\", {\"a\": 1, \"b\": 1})))\ncheck(\"no eval() is reachable: 'import' is just an unresolved identifier\",\n      raises(channels_mod.ComputedError,\n            lambda: channels_mod.eval_expr(\"__import__('os')\", {})))\n\n\n# ===========================================================================\n# 3 & 4. multi-PID batching, single-PID fallback, DID reads, the poller\n# ===========================================================================\n\nfake1 = LiveFakeStream()\nlk1 = AdapterLink(stream_factory=lambda p, b: fake1, process=\"check_live_data\")\nset_link(lk1)\nlk1.mark_verified(CAN_C, 10)\n\np = poller_mod.LivePoller()\npoller_mod.set_poller(p)\n\nchans = channels_mod.resolve_channels([\"engine_rpm\", \"vehicle_speed\", \"engine_coolant_temp\",\n                                       \"tcm_04fe\"])\nstarted = p.start(chans, rates={\"engine_rpm\": 5.0, \"vehicle_speed\": 5.0,\n                                \"engine_coolant_temp\": 0.5, \"tcm_04fe\": 1.0})\ncheck(\"session start reports active\", started.get(\"active\") is True, str(started))\n\ncheck(\"the first poll tick sent the 3-way multi-PID request\",\n      wait_until(lambda: \"010C0D05\" in fake1.sent), str(fake1.sent[:10]))\n\nsnap = wait_until(lambda: p.snapshot()[\"channels\"][\"engine_rpm\"][\"value\"] is not None)\ncheck(\"engine_rpm decoded from the multi-PID reply\", snap)\ns = p.snapshot()[\"channels\"]\ncheck_eq(\"engine_rpm value\", s[\"engine_rpm\"][\"value\"], 2000.0)\ncheck_eq(\"vehicle_speed value\", s[\"vehicle_speed\"][\"value\"], 60.0)\ncheck_eq(\"engine_coolant_temp value\", s[\"engine_coolant_temp\"][\"value\"], 40.0)\n\ncheck(\"DID mode grouped under one retarget to TCM (0x18)\",\n      wait_until(lambda: \"2204FE\" in fake1.sent), str(fake1.sent))\ntcm_snap = wait_until(lambda: p.snapshot()[\"channels\"][\"tcm_04fe\"][\"value\"] is not None)\ncheck(\"tcm_04fe (gearbox oil temp) decoded\", tcm_snap)\ncheck_eq(\"tcm_04fe value (0x7D - 40)\", p.snapshot()[\"channels\"][\"tcm_04fe\"][\"value\"], 85.0)\n\ncheck_eq(\"multi-PID stays supported when the ECU answers every PID asked\",\n         p.status()[\"multi_pid_supported\"], True)\ncheck(\"the session held one port open (opens==1) despite many poll ticks\",\n      wait_until(lambda: fake1.opens == 1) and fake1.opens == 1, str(fake1.opens))\n\np.stop()\ncheck(\"stop releases the adapter lock\", interlock.read_lock() is None, str(interlock.read_lock()))\ncheck(\"stop leaves the link with no current session\", lk1.current is None)\n\n# -- fallback: an ECU that only answers part of a multi-PID request ---------\n\npartial_replies = dict(PID_REPLIES)\n# Coolant missing from the multi reply -- only two of the three groups answered.\npartial_replies[\"010C0D05\"] = _frames(\"7E8\", \"410C1F40\" + \"410D3C\")\nfake2 = LiveFakeStream(partial_replies)\nlk2 = AdapterLink(stream_factory=lambda p, b: fake2, process=\"check_live_data\")\nset_link(lk2)\nlk2.mark_verified(CAN_C, 10)\n\np2 = poller_mod.LivePoller()\npoller_mod.set_poller(p2)\nchans2 = channels_mod.resolve_channels([\"engine_rpm\", \"vehicle_speed\", \"engine_coolant_temp\"])\np2.start(chans2, rates={\"engine_rpm\": 5.0, \"vehicle_speed\": 5.0, \"engine_coolant_temp\": 5.0})\ncheck(\"the multi-PID request is tried once\",\n      wait_until(lambda: \"010C0D05\" in fake2.sent), str(fake2.sent[:10]))\ncheck(\"an ECU answering fewer PIDs than asked turns multi-PID support off\",\n      wait_until(lambda: p2.status()[\"multi_pid_supported\"] is False))\ncheck(\"after falling back, coolant is polled as its own single-PID request\",\n      wait_until(lambda: \"0105\" in fake2.sent), str(fake2.sent))\ncheck(\"coolant still eventually decodes via the single-PID fallback\",\n      wait_until(lambda: p2.snapshot()[\"channels\"][\"engine_coolant_temp\"][\"value\"] == 40.0))\np2.stop()\n\n\n# ===========================================================================","numLines":90,"startLine":230,"totalLines":624}},"sourceToolAssistantUUID":"5914c0c6-7adb-481b-95ab-75a2daf5a193","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
