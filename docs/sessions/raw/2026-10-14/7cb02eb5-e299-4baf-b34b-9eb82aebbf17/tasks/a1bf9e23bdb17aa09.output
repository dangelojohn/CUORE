{"parentUuid":"8693ac47-c1d6-4b3f-bac9-2c95286f7f67","isSidechain":true,"agentId":"a1bf9e23bdb17aa09","message":{"model":"claude-sonnet-5","id":"msg_011Cg22UzgPvXuH5qudPEC83","type":"message","role":"assistant","content":[{"type":"thinking","thinking":"","signature":""}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":798,"cache_read_input_tokens":141189,"cache_creation":{"ephemeral_5m_input_tokens":798,"ephemeral_1h_input_tokens":0},"output_tokens":3,"service_tier":"standard","inference_geo":"global"},"input_transformations":[],"diagnostics":null,"context_management":null},"serverClassifierRequest":"304e0d7b-f864-4335-b9d0-a4de5d44e8d9","apiBlockIndex":0,"requestId":"req_011Cg22UzPHuNKMDEQuUTwE4","attributionAgent":"general-purpose","type":"assistant","uuid":"b5e8cc30-fc5c-4433-ab42-5778b84dcb3c","timestamp":"2026-10-14T11:10:13.730Z","effort":"high","perTurnEffort":null,"userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
{"parentUuid":"b5e8cc30-fc5c-4433-ab42-5778b84dcb3c","isSidechain":true,"agentId":"a1bf9e23bdb17aa09","message":{"model":"claude-sonnet-5","id":"msg_011Cg22UzgPvXuH5qudPEC83","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01Fg6uEBqVskYo17k7qh9gK8","name":"Read","input":{"file_path":"C:\\Users\\User\\mcp-servers\\cuore\\live\\stream.py"},"caller":{"type":"direct"}}],"container":null,"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":798,"cache_read_input_tokens":141189,"output_tokens":1399,"output_tokens_details":{"thinking_tokens":1326},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":0,"ephemeral_5m_input_tokens":798},"inference_geo":"global","iterations":[{"input_tokens":2,"output_tokens":1399,"cache_read_input_tokens":141189,"cache_creation_input_tokens":798,"cache_creation":{"ephemeral_5m_input_tokens":798,"ephemeral_1h_input_tokens":0},"type":"message"}],"speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_01Fg6uEBqVskYo17k7qh9gK8":{"file_path":"C:\\Users\\User\\mcp-servers\\cuore\\live\\stream.py"}},"serverClassifierRequest":"304e0d7b-f864-4335-b9d0-a4de5d44e8d9","apiBlockIndex":1,"requestId":"req_011Cg22UzPHuNKMDEQuUTwE4","attributionAgent":"general-purpose","type":"assistant","uuid":"17f149d9-f98a-4822-9ee7-7a2e90a5c48e","timestamp":"2026-10-14T11:10:14.484Z","effort":"high","perTurnEffort":null,"userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
{"parentUuid":"17f149d9-f98a-4822-9ee7-7a2e90a5c48e","isSidechain":true,"promptId":"cde09b07-6881-403c-9d9a-f467b27b1473","agentId":"a1bf9e23bdb17aa09","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Fg6uEBqVskYo17k7qh9gK8","type":"tool_result","content":"1\t# Adapted from stelvio_scan (MIT): src/stelvio_scan/adapter/stream.py, recording/recorder.py, recording/player.py\n2\t\"\"\"Pluggable transport abstraction for live OBD2/ELM327 sessions.\n3\t\n4\tThis module has three intended uses:\n5\t\n6\t  1. Real adapter I/O — ``SerialStream`` (pyserial COM / virtual COM, e.g. a\n7\t     Bluetooth-paired ELM327) and ``TcpStream`` (Wi-Fi ELM327 clones that\n8\t     bridge a UART over a raw TCP socket, commonly 192.168.0.10:35000).\n9\t     Callers talk to either through the same minimal ``Stream`` interface\n10\t     and don't need to know which physical layer is underneath.\n11\t\n12\t  2. Wire capture of on-car sessions — wrap a real stream in\n13\t     ``RecordingStream`` (backed by a ``RecordingFile``) to tee every byte\n14\t     written and read into a JSONL log. These captures are meant to become\n15\t     test fixtures: a real session, recorded once on a real car, that can\n16\t     be replayed offline forever after.\n17\t\n18\t  3. No-hardware playback — ``PlaybackStream`` replays a JSONL recording\n19\t     back through the exact same ``Stream`` interface, so the rest of the\n20\t     stack (parsers, MES logic, UI) can be exercised in tests or at a desk\n21\t     without any adapter or vehicle attached.\n22\t\"\"\"\n23\tfrom __future__ import annotations\n24\t\n25\timport json\n26\timport logging\n27\timport socket\n28\timport threading\n29\timport time\n30\tfrom abc import ABC, abstractmethod\n31\tfrom collections import deque\n32\tfrom dataclasses import dataclass, field\n33\tfrom pathlib import Path\n34\t\n35\timport serial\n36\t\n37\tlog = logging.getLogger(__name__)\n38\t\n39\t\n40\t# ---- Stream interface -------------------------------------------------\n41\t\n42\tclass Stream(ABC):\n43\t    @abstractmethod\n44\t    def open(self) -> None: ...\n45\t\n46\t    @abstractmethod\n47\t    def close(self) -> None: ...\n48\t\n49\t    @abstractmethod\n50\t    def is_open(self) -> bool: ...\n51\t\n52\t    @abstractmethod\n53\t    def read(self, n: int) -> bytes:\n54\t        \"\"\"Read up to n bytes within the configured timeout. May return b\"\".\"\"\"\n55\t\n56\t    @abstractmethod\n57\t    def write(self, data: bytes) -> None: ...\n58\t\n59\t    def flush(self) -> None:\n60\t        \"\"\"Default no-op — most transports don't need it.\"\"\"\n61\t\n62\t    def reset_input_buffer(self) -> None:\n63\t        \"\"\"Drain any buffered input. Default no-op.\"\"\"\n64\t\n65\t    def reset_output_buffer(self) -> None:\n66\t        \"\"\"Drain any buffered output. Default no-op.\"\"\"\n67\t\n68\t    def in_waiting(self) -> int:\n69\t        \"\"\"Bytes known to be immediately available. Default 0 (unknown).\"\"\"\n70\t        return 0\n71\t\n72\t    @property\n73\t    def describe(self) -> str:\n74\t        \"\"\"Short human-readable description, e.g. \"serial COM3@115200\".\"\"\"\n75\t        return self.__class__.__name__\n76\t\n77\t\n78\t# ---- Serial -------------------------------------------------------------\n79\t\n80\tclass SerialStream(Stream):\n81\t    \"\"\"pyserial-backed COM port / virtual COM (e.g. Bluetooth pairing).\"\"\"\n82\t\n83\t    def __init__(self, port: str, baudrate: int, *, timeout: float = 0.25, write_timeout: float = 2.0):\n84\t        self.port = port\n85\t        self.baudrate = baudrate\n86\t        self.timeout = timeout\n87\t        self.write_timeout = write_timeout\n88\t        self._ser: serial.Serial | None = None\n89\t\n90\t    def open(self) -> None:\n91\t        # Let serial.SerialException propagate unchanged — the caller turns\n92\t        # e.g. \"Access is denied\" into a port-busy message.\n93\t        self._ser = serial.Serial(\n94\t            port=self.port,\n95\t            baudrate=self.baudrate,\n96\t            timeout=self.timeout,\n97\t            write_timeout=self.write_timeout,\n98\t        )\n99\t\n100\t    def close(self) -> None:\n101\t        if self._ser is not None:\n102\t            try:\n103\t                self._ser.close()\n104\t            finally:\n105\t                self._ser = None\n106\t\n107\t    def is_open(self) -> bool:\n108\t        return self._ser is not None and self._ser.is_open\n109\t\n110\t    def read(self, n: int) -> bytes:\n111\t        if self._ser is None:\n112\t            return b\"\"\n113\t        return self._ser.read(n)\n114\t\n115\t    def write(self, data: bytes) -> None:\n116\t        if self._ser is None:\n117\t            raise IOError(\"serial not open\")\n118\t        self._ser.write(data)\n119\t\n120\t    def flush(self) -> None:\n121\t        if self._ser is not None:\n122\t            self._ser.flush()\n123\t\n124\t    def reset_input_buffer(self) -> None:\n125\t        if self._ser is not None:\n126\t            self._ser.reset_input_buffer()\n127\t\n128\t    def reset_output_buffer(self) -> None:\n129\t        if self._ser is not None:\n130\t            self._ser.reset_output_buffer()\n131\t\n132\t    def in_waiting(self) -> int:\n133\t        if self._ser is None:\n134\t            return 0\n135\t        return self._ser.in_waiting\n136\t\n137\t    @property\n138\t    def describe(self) -> str:\n139\t        return f\"serial {self.port}@{self.baudrate}\"\n140\t\n141\t\n142\t# ---- TCP / Wi-Fi ----------------------------------------------------------\n143\t\n144\tclass TcpStream(Stream):\n145\t    \"\"\"TCP transport for Wi-Fi ELM327 adapters.\n146\t\n147\t    These adapters are typically ESP8266/ESP32 based. They expose a TCP\n148\t    server (commonly on 192.168.0.10:35000) that bridges directly to the\n149\t    ELM327 chip's UART. The wire format is identical to serial.\"\"\"\n150\t\n151\t    def __init__(self, host: str = \"192.168.0.10\", port: int = 35000, *, timeout: float = 0.25):\n152\t        self.host = host\n153\t        self.port = port\n154\t        self.timeout = timeout\n155\t        self._sock: socket.socket | None = None\n156\t\n157\t    def open(self) -> None:\n158\t        s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)\n159\t        s.settimeout(self.timeout)\n160\t        s.connect((self.host, self.port))\n161\t        # Disable Nagle so single-byte ELM commands aren't delayed.\n162\t        s.setsockopt(socket.IPPROTO_TCP, socket.TCP_NODELAY, 1)\n163\t        self._sock = s\n164\t\n165\t    def close(self) -> None:\n166\t        if self._sock is not None:\n167\t            try:\n168\t                try:\n169\t                    self._sock.shutdown(socket.SHUT_RDWR)\n170\t                except OSError:\n171\t                    pass\n172\t                self._sock.close()\n173\t            finally:\n174\t                self._sock = None\n175\t\n176\t    def is_open(self) -> bool:\n177\t        return self._sock is not None\n178\t\n179\t    def read(self, n: int) -> bytes:\n180\t        if self._sock is None:\n181\t            return b\"\"\n182\t        try:\n183\t            data = self._sock.recv(n)\n184\t            return data or b\"\"\n185\t        except socket.timeout:\n186\t            return b\"\"\n187\t\n188\t    def write(self, data: bytes) -> None:\n189\t        if self._sock is None:\n190\t            raise IOError(\"socket not open\")\n191\t        self._sock.sendall(data)\n192\t\n193\t    def reset_input_buffer(self) -> None:\n194\t        \"\"\"Drain any buffered bytes by setting a 0 timeout and reading until empty.\"\"\"\n195\t        if self._sock is None:\n196\t            return\n197\t        prior = self._sock.gettimeout()\n198\t        self._sock.settimeout(0.0)\n199\t        try:\n200\t            while True:\n201\t                try:\n202\t                    if not self._sock.recv(4096):\n203\t                        break\n204\t                except (BlockingIOError, socket.timeout):\n205\t                    break\n206\t        finally:\n207\t            self._sock.settimeout(prior)\n208\t\n209\t    @property\n210\t    def describe(self) -> str:\n211\t        return f\"tcp {self.host}:{self.port}\"\n212\t\n213\t\n214\t# ---- Recording ------------------------------------------------------------\n215\t\n216\t@dataclass\n217\tclass RecordingFile:\n218\t    \"\"\"JSONL sink for a recorded session.\n219\t\n220\t    Wire format (one JSON object per line):\n221\t      {\"t\": <monotonic_seconds_since_record_start>, \"kind\": \"write\", \"data\": \"<hex>\"}\n222\t      {\"t\": ..., \"kind\": \"read\",  \"data\": \"<hex>\"}\n223\t      {\"t\": 0,   \"kind\": \"header\", \"format\": 1, \"started_at\": <unix_ts>,\n224\t                  \"transport\": \"SerialStream\"|\"TcpStream\", \"note\": \"...\"}\n225\t      {\"t\": ..., \"kind\": \"footer\", \"bytes_written\": ..., \"bytes_read\": ...}\n226\t\n227\t    Non-intrusive: any exception during the file write is swallowed (so a\n228\t    misbehaving filesystem can't take down a live session).\n229\t    \"\"\"\n230\t\n231\t    path: Path\n232\t    fp: object | None = None\n233\t    started_monotonic: float = 0.0\n234\t    started_unix: float = 0.0\n235\t    bytes_written: int = 0\n236\t    bytes_read: int = 0\n237\t    # Reentrant — close() holds the lock and calls _write() which re-acquires.\n238\t    lock: threading.RLock = field(default_factory=threading.RLock)\n239\t\n240\t    def open(self, transport: str = \"\", note: str = \"\") -> None:\n241\t        self.path.parent.mkdir(parents=True, exist_ok=True)\n242\t        self.fp = self.path.open(\"w\", encoding=\"utf-8\")\n243\t        self.started_monotonic = time.monotonic()\n244\t        self.started_unix = time.time()\n245\t        self._write({\n246\t            \"t\": 0.0,\n247\t            \"kind\": \"header\",\n248\t            \"format\": 1,\n249\t            \"started_at\": self.started_unix,\n250\t            \"transport\": transport,\n251\t            \"note\": note,\n252\t        })\n253\t\n254\t    def close(self) -> None:\n255\t        with self.lock:\n256\t            if self.fp is not None:\n257\t                try:\n258\t                    self._write({\n259\t                        \"t\": time.monotonic() - self.started_monotonic,\n260\t                        \"kind\": \"footer\",\n261\t                        \"bytes_written\": self.bytes_written,\n262\t                        \"bytes_read\": self.bytes_read,\n263\t                    })\n264\t                    self.fp.flush()\n265\t                    self.fp.close()\n266\t                except Exception:\n267\t                    log.exception(\"recording close failed\")\n268\t                finally:\n269\t                    self.fp = None\n270\t\n271\t    def append(self, kind: str, data: bytes) -> None:\n272\t        if self.fp is None:\n273\t            return\n274\t        if kind == \"write\":\n275\t            self.bytes_written += len(data)\n276\t        elif kind == \"read\":\n277\t            self.bytes_read += len(data)\n278\t        try:\n279\t            self._write({\n280\t                \"t\": time.monotonic() - self.started_monotonic,\n281\t                \"kind\": kind,\n282\t                \"data\": data.hex().upper(),\n283\t            })\n284\t        except Exception:\n285\t            log.exception(\"recording append failed\")\n286\t\n287\t    def _write(self, obj: dict) -> None:\n288\t        with self.lock:\n289\t            self.fp.write(json.dumps(obj) + \"\\n\")\n290\t            # Flush after every event so a crash doesn't lose the tail.\n291\t            self.fp.flush()\n292\t\n293\t\n294\tclass RecordingStream(Stream):\n295\t    \"\"\"Wraps an inner Stream and tees every read/write into a RecordingFile.\"\"\"\n296\t\n297\t    def __init__(self, inner: Stream, recording: RecordingFile):\n298\t        self._inner = inner\n299\t        self._rec = recording\n300\t\n301\t    def open(self) -> None:\n302\t        self._inner.open()\n303\t        self._rec.open(transport=type(self._inner).__name__)\n304\t\n305\t    def close(self) -> None:\n306\t        try:\n307\t            self._inner.close()\n308\t        finally:\n309\t            self._rec.close()\n310\t\n311\t    def is_open(self) -> bool:\n312\t        return self._inner.is_open()\n313\t\n314\t    def read(self, n: int) -> bytes:\n315\t        data = self._inner.read(n)\n316\t        if data:\n317\t            self._rec.append(\"read\", data)\n318\t        return data\n319\t\n320\t    def write(self, data: bytes) -> None:\n321\t        self._inner.write(data)\n322\t        self._rec.append(\"write\", data)\n323\t\n324\t    def flush(self) -> None:\n325\t        self._inner.flush()\n326\t\n327\t    def reset_input_buffer(self) -> None:\n328\t        self._inner.reset_input_buffer()\n329\t\n330\t    def reset_output_buffer(self) -> None:\n331\t        self._inner.reset_output_buffer()\n332\t\n333\t    def in_waiting(self) -> int:\n334\t        return self._inner.in_waiting()\n335\t\n336\t    @property\n337\t    def describe(self) -> str:\n338\t        return f\"recording({self._inner.describe})\"\n339\t\n340\t\n341\t# ---- Playback ---------------------------------------------------------\n342\t\n343\tclass PlaybackError(RuntimeError):\n344\t    pass\n345\t\n346\t\n347\tclass PlaybackStream(Stream):\n348\t    \"\"\"Replays a recorded session (see RecordingFile) with no hardware attached.\n349\t\n350\t    Behaviour:\n351\t      - Open: read header line, position at first event.\n352\t      - Write: assert the bytes match the next 'write' event in the log\n353\t        (replays must follow the same request order as recording). On\n354\t        mismatch, raises PlaybackError so the caller knows the scenario\n355\t        diverged from the recording. Default (strict_writes=False) just\n356\t        consumes the write silently.\n357\t      - Read: return the data of the next 'read' event(s). If the log has\n358\t        no further read before the next write event, read() returns b\"\"\n359\t        (rather than reaching past the write) so a caller polling with a\n360\t        deadline sees a timeout instead of a later, out-of-order response.\n361\t      - reset_input_buffer / reset_output_buffer: no-op.\n362\t\n363\t    This is meant for offline analysis and no-hardware test fixtures. It is\n364\t    NOT a tool for replaying into a real adapter.\n365\t    \"\"\"\n366\t\n367\t    def __init__(self, path: Path | str, *, strict_writes: bool = False):\n368\t        \"\"\"`strict_writes`: if True, raise PlaybackError when the caller's\n369\t        write bytes don't match the next 'write' event in the recording.\n370\t        Default False — we just consume writes silently and serve queued\n371\t        reads, which is friendlier when the caller's command sequence has\n372\t        drifted.\"\"\"\n373\t        self.path = Path(path)\n374\t        self._strict = strict_writes\n375\t        self._fp = None\n376\t        self._read_queue: deque[bytes] = deque()\n377\t        # One-event lookahead: an event pulled from the log but not yet\n378\t        # consumed (e.g. a write event seen while looking for a read).\n379\t        self._pending: tuple[str, str] | None = None\n380\t        self._is_open = False\n381\t        self.header: dict = {}\n382\t\n383\t    def open(self) -> None:\n384\t        if self._is_open:\n385\t            return\n386\t        self._fp = self.path.open(\"r\", encoding=\"utf-8\")\n387\t        first = self._fp.readline().strip()\n388\t        if first:\n389\t            try:\n390\t                obj = json.loads(first)\n391\t                if obj.get(\"kind\") == \"header\":\n392\t                    self.header = obj\n393\t                else:\n394\t                    # No header — rewind.\n395\t                    self._fp.seek(0)\n396\t            except json.JSONDecodeError:\n397\t                raise PlaybackError(f\"first line of {self.path} is not valid JSON\")\n398\t        self._is_open = True\n399\t\n400\t    def close(self) -> None:\n401\t        if self._fp is not None:\n402\t            self._fp.close()\n403\t            self._fp = None\n404\t        self._is_open = False\n405\t        self._read_queue.clear()\n406\t        self._pending = None\n407\t\n408\t    def is_open(self) -> bool:\n409\t        return self._is_open\n410\t\n411\t    def _next_event(self) -> tuple[str, str] | None:\n412\t        \"\"\"Return the next (kind, hex_data) event of kind 'read'/'write',\n413\t        skipping header/footer/unknown lines. Consumes `_pending` first.\"\"\"\n414\t        if self._pending is not None:\n415\t            ev = self._pending\n416\t            self._pending = None\n417\t            return ev\n418\t        while self._fp is not None:\n419\t            line = self._fp.readline()\n420\t            if not line:\n421\t                return None\n422\t            line = line.strip()\n423\t            if not line:\n424\t                continue\n425\t            try:\n426\t                obj = json.loads(line)\n427\t            except json.JSONDecodeError:\n428\t                continue\n429\t            kind = obj.get(\"kind\")\n430\t            if kind in (\"read\", \"write\"):\n431\t                return (kind, obj.get(\"data\", \"\"))\n432\t            # header / footer / unknown — keep going\n433\t        return None\n434\t\n435\t    def write(self, data: bytes) -> None:\n436\t        # Pull events forward until we either hit a write event (which we\n437\t        # match against `data`) or end of file. Any read events seen along\n438\t        # the way are queued up for subsequent read() calls.\n439\t        while True:\n440\t            ev = self._next_event()\n441\t            if ev is None:\n442\t                if self._strict:\n443\t                    raise PlaybackError(\"playback ran out of writes\")\n444\t                return\n445\t            kind, hexdata = ev\n446\t            if kind == \"read\":\n447\t                self._read_queue.append(bytes.fromhex(hexdata))\n448\t                continue\n449\t            # kind == \"write\"\n450\t            expected = bytes.fromhex(hexdata)\n451\t            if self._strict and expected != data:\n452\t                raise PlaybackError(\n453\t                    f\"write mismatch: expected {expected.hex().upper()} got {data.hex().upper()}\"\n454\t                )\n455\t            return\n456\t\n457\t    def read(self, n: int) -> bytes:\n458\t        # First serve from the queue.\n459\t        if self._read_queue:\n460\t            chunk = self._read_queue.popleft()\n461\t            if len(chunk) > n:\n462\t                self._read_queue.appendleft(chunk[n:])\n463\t                return chunk[:n]\n464\t            return chunk\n465\t        # Otherwise advance the log to find the next read — but stop (and\n466\t        # push back) at a write event, since that belongs to the *next*\n467\t        # write() call, not to this read().\n468\t        ev = self._next_event()\n469\t        if ev is None:\n470\t            return b\"\"\n471\t        kind, hexdata = ev\n472\t        if kind == \"write\":\n473\t            self._pending = ev\n474\t            return b\"\"\n475\t        data = bytes.fromhex(hexdata)\n476\t        if len(data) > n:\n477\t            self._read_queue.appendleft(data[n:])\n478\t            return data[:n]\n479\t        return data\n480\t\n481\t    def in_waiting(self) -> int:\n482\t        if self._read_queue:\n483\t            return len(self._read_queue[0])\n484\t        return 0\n485\t\n486\t    @property\n487\t    def describe(self) -> str:\n488\t        return f\"playback {self.path}\"\n489\t"}]},"uuid":"4273fd94-8ad9-411d-b153-c7d99357636d","timestamp":"2026-10-14T11:10:14.629Z","toolUseResult":{"type":"text","file":{"filePath":"C:\\Users\\User\\mcp-servers\\cuore\\live\\stream.py","content":"# Adapted from stelvio_scan (MIT): src/stelvio_scan/adapter/stream.py, recording/recorder.py, recording/player.py\n\"\"\"Pluggable transport abstraction for live OBD2/ELM327 sessions.\n\nThis module has three intended uses:\n\n  1. Real adapter I/O — ``SerialStream`` (pyserial COM / virtual COM, e.g. a\n     Bluetooth-paired ELM327) and ``TcpStream`` (Wi-Fi ELM327 clones that\n     bridge a UART over a raw TCP socket, commonly 192.168.0.10:35000).\n     Callers talk to either through the same minimal ``Stream`` interface\n     and don't need to know which physical layer is underneath.\n\n  2. Wire capture of on-car sessions — wrap a real stream in\n     ``RecordingStream`` (backed by a ``RecordingFile``) to tee every byte\n     written and read into a JSONL log. These captures are meant to become\n     test fixtures: a real session, recorded once on a real car, that can\n     be replayed offline forever after.\n\n  3. No-hardware playback — ``PlaybackStream`` replays a JSONL recording\n     back through the exact same ``Stream`` interface, so the rest of the\n     stack (parsers, MES logic, UI) can be exercised in tests or at a desk\n     without any adapter or vehicle attached.\n\"\"\"\nfrom __future__ import annotations\n\nimport json\nimport logging\nimport socket\nimport threading\nimport time\nfrom abc import ABC, abstractmethod\nfrom collections import deque\nfrom dataclasses import dataclass, field\nfrom pathlib import Path\n\nimport serial\n\nlog = logging.getLogger(__name__)\n\n\n# ---- Stream interface -------------------------------------------------\n\nclass Stream(ABC):\n    @abstractmethod\n    def open(self) -> None: ...\n\n    @abstractmethod\n    def close(self) -> None: ...\n\n    @abstractmethod\n    def is_open(self) -> bool: ...\n\n    @abstractmethod\n    def read(self, n: int) -> bytes:\n        \"\"\"Read up to n bytes within the configured timeout. May return b\"\".\"\"\"\n\n    @abstractmethod\n    def write(self, data: bytes) -> None: ...\n\n    def flush(self) -> None:\n        \"\"\"Default no-op — most transports don't need it.\"\"\"\n\n    def reset_input_buffer(self) -> None:\n        \"\"\"Drain any buffered input. Default no-op.\"\"\"\n\n    def reset_output_buffer(self) -> None:\n        \"\"\"Drain any buffered output. Default no-op.\"\"\"\n\n    def in_waiting(self) -> int:\n        \"\"\"Bytes known to be immediately available. Default 0 (unknown).\"\"\"\n        return 0\n\n    @property\n    def describe(self) -> str:\n        \"\"\"Short human-readable description, e.g. \"serial COM3@115200\".\"\"\"\n        return self.__class__.__name__\n\n\n# ---- Serial -------------------------------------------------------------\n\nclass SerialStream(Stream):\n    \"\"\"pyserial-backed COM port / virtual COM (e.g. Bluetooth pairing).\"\"\"\n\n    def __init__(self, port: str, baudrate: int, *, timeout: float = 0.25, write_timeout: float = 2.0):\n        self.port = port\n        self.baudrate = baudrate\n        self.timeout = timeout\n        self.write_timeout = write_timeout\n        self._ser: serial.Serial | None = None\n\n    def open(self) -> None:\n        # Let serial.SerialException propagate unchanged — the caller turns\n        # e.g. \"Access is denied\" into a port-busy message.\n        self._ser = serial.Serial(\n            port=self.port,\n            baudrate=self.baudrate,\n            timeout=self.timeout,\n            write_timeout=self.write_timeout,\n        )\n\n    def close(self) -> None:\n        if self._ser is not None:\n            try:\n                self._ser.close()\n            finally:\n                self._ser = None\n\n    def is_open(self) -> bool:\n        return self._ser is not None and self._ser.is_open\n\n    def read(self, n: int) -> bytes:\n        if self._ser is None:\n            return b\"\"\n        return self._ser.read(n)\n\n    def write(self, data: bytes) -> None:\n        if self._ser is None:\n            raise IOError(\"serial not open\")\n        self._ser.write(data)\n\n    def flush(self) -> None:\n        if self._ser is not None:\n            self._ser.flush()\n\n    def reset_input_buffer(self) -> None:\n        if self._ser is not None:\n            self._ser.reset_input_buffer()\n\n    def reset_output_buffer(self) -> None:\n        if self._ser is not None:\n            self._ser.reset_output_buffer()\n\n    def in_waiting(self) -> int:\n        if self._ser is None:\n            return 0\n        return self._ser.in_waiting\n\n    @property\n    def describe(self) -> str:\n        return f\"serial {self.port}@{self.baudrate}\"\n\n\n# ---- TCP / Wi-Fi ----------------------------------------------------------\n\nclass TcpStream(Stream):\n    \"\"\"TCP transport for Wi-Fi ELM327 adapters.\n\n    These adapters are typically ESP8266/ESP32 based. They expose a TCP\n    server (commonly on 192.168.0.10:35000) that bridges directly to the\n    ELM327 chip's UART. The wire format is identical to serial.\"\"\"\n\n    def __init__(self, host: str = \"192.168.0.10\", port: int = 35000, *, timeout: float = 0.25):\n        self.host = host\n        self.port = port\n        self.timeout = timeout\n        self._sock: socket.socket | None = None\n\n    def open(self) -> None:\n        s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)\n        s.settimeout(self.timeout)\n        s.connect((self.host, self.port))\n        # Disable Nagle so single-byte ELM commands aren't delayed.\n        s.setsockopt(socket.IPPROTO_TCP, socket.TCP_NODELAY, 1)\n        self._sock = s\n\n    def close(self) -> None:\n        if self._sock is not None:\n            try:\n                try:\n                    self._sock.shutdown(socket.SHUT_RDWR)\n                except OSError:\n                    pass\n                self._sock.close()\n            finally:\n                self._sock = None\n\n    def is_open(self) -> bool:\n        return self._sock is not None\n\n    def read(self, n: int) -> bytes:\n        if self._sock is None:\n            return b\"\"\n        try:\n            data = self._sock.recv(n)\n            return data or b\"\"\n        except socket.timeout:\n            return b\"\"\n\n    def write(self, data: bytes) -> None:\n        if self._sock is None:\n            raise IOError(\"socket not open\")\n        self._sock.sendall(data)\n\n    def reset_input_buffer(self) -> None:\n        \"\"\"Drain any buffered bytes by setting a 0 timeout and reading until empty.\"\"\"\n        if self._sock is None:\n            return\n        prior = self._sock.gettimeout()\n        self._sock.settimeout(0.0)\n        try:\n            while True:\n                try:\n                    if not self._sock.recv(4096):\n                        break\n                except (BlockingIOError, socket.timeout):\n                    break\n        finally:\n            self._sock.settimeout(prior)\n\n    @property\n    def describe(self) -> str:\n        return f\"tcp {self.host}:{self.port}\"\n\n\n# ---- Recording ------------------------------------------------------------\n\n@dataclass\nclass RecordingFile:\n    \"\"\"JSONL sink for a recorded session.\n\n    Wire format (one JSON object per line):\n      {\"t\": <monotonic_seconds_since_record_start>, \"kind\": \"write\", \"data\": \"<hex>\"}\n      {\"t\": ..., \"kind\": \"read\",  \"data\": \"<hex>\"}\n      {\"t\": 0,   \"kind\": \"header\", \"format\": 1, \"started_at\": <unix_ts>,\n                  \"transport\": \"SerialStream\"|\"TcpStream\", \"note\": \"...\"}\n      {\"t\": ..., \"kind\": \"footer\", \"bytes_written\": ..., \"bytes_read\": ...}\n\n    Non-intrusive: any exception during the file write is swallowed (so a\n    misbehaving filesystem can't take down a live session).\n    \"\"\"\n\n    path: Path\n    fp: object | None = None\n    started_monotonic: float = 0.0\n    started_unix: float = 0.0\n    bytes_written: int = 0\n    bytes_read: int = 0\n    # Reentrant — close() holds the lock and calls _write() which re-acquires.\n    lock: threading.RLock = field(default_factory=threading.RLock)\n\n    def open(self, transport: str = \"\", note: str = \"\") -> None:\n        self.path.parent.mkdir(parents=True, exist_ok=True)\n        self.fp = self.path.open(\"w\", encoding=\"utf-8\")\n        self.started_monotonic = time.monotonic()\n        self.started_unix = time.time()\n        self._write({\n            \"t\": 0.0,\n            \"kind\": \"header\",\n            \"format\": 1,\n            \"started_at\": self.started_unix,\n            \"transport\": transport,\n            \"note\": note,\n        })\n\n    def close(self) -> None:\n        with self.lock:\n            if self.fp is not None:\n                try:\n                    self._write({\n                        \"t\": time.monotonic() - self.started_monotonic,\n                        \"kind\": \"footer\",\n                        \"bytes_written\": self.bytes_written,\n                        \"bytes_read\": self.bytes_read,\n                    })\n                    self.fp.flush()\n                    self.fp.close()\n                except Exception:\n                    log.exception(\"recording close failed\")\n                finally:\n                    self.fp = None\n\n    def append(self, kind: str, data: bytes) -> None:\n        if self.fp is None:\n            return\n        if kind == \"write\":\n            self.bytes_written += len(data)\n        elif kind == \"read\":\n            self.bytes_read += len(data)\n        try:\n            self._write({\n                \"t\": time.monotonic() - self.started_monotonic,\n                \"kind\": kind,\n                \"data\": data.hex().upper(),\n            })\n        except Exception:\n            log.exception(\"recording append failed\")\n\n    def _write(self, obj: dict) -> None:\n        with self.lock:\n            self.fp.write(json.dumps(obj) + \"\\n\")\n            # Flush after every event so a crash doesn't lose the tail.\n            self.fp.flush()\n\n\nclass RecordingStream(Stream):\n    \"\"\"Wraps an inner Stream and tees every read/write into a RecordingFile.\"\"\"\n\n    def __init__(self, inner: Stream, recording: RecordingFile):\n        self._inner = inner\n        self._rec = recording\n\n    def open(self) -> None:\n        self._inner.open()\n        self._rec.open(transport=type(self._inner).__name__)\n\n    def close(self) -> None:\n        try:\n            self._inner.close()\n        finally:\n            self._rec.close()\n\n    def is_open(self) -> bool:\n        return self._inner.is_open()\n\n    def read(self, n: int) -> bytes:\n        data = self._inner.read(n)\n        if data:\n            self._rec.append(\"read\", data)\n        return data\n\n    def write(self, data: bytes) -> None:\n        self._inner.write(data)\n        self._rec.append(\"write\", data)\n\n    def flush(self) -> None:\n        self._inner.flush()\n\n    def reset_input_buffer(self) -> None:\n        self._inner.reset_input_buffer()\n\n    def reset_output_buffer(self) -> None:\n        self._inner.reset_output_buffer()\n\n    def in_waiting(self) -> int:\n        return self._inner.in_waiting()\n\n    @property\n    def describe(self) -> str:\n        return f\"recording({self._inner.describe})\"\n\n\n# ---- Playback ---------------------------------------------------------\n\nclass PlaybackError(RuntimeError):\n    pass\n\n\nclass PlaybackStream(Stream):\n    \"\"\"Replays a recorded session (see RecordingFile) with no hardware attached.\n\n    Behaviour:\n      - Open: read header line, position at first event.\n      - Write: assert the bytes match the next 'write' event in the log\n        (replays must follow the same request order as recording). On\n        mismatch, raises PlaybackError so the caller knows the scenario\n        diverged from the recording. Default (strict_writes=False) just\n        consumes the write silently.\n      - Read: return the data of the next 'read' event(s). If the log has\n        no further read before the next write event, read() returns b\"\"\n        (rather than reaching past the write) so a caller polling with a\n        deadline sees a timeout instead of a later, out-of-order response.\n      - reset_input_buffer / reset_output_buffer: no-op.\n\n    This is meant for offline analysis and no-hardware test fixtures. It is\n    NOT a tool for replaying into a real adapter.\n    \"\"\"\n\n    def __init__(self, path: Path | str, *, strict_writes: bool = False):\n        \"\"\"`strict_writes`: if True, raise PlaybackError when the caller's\n        write bytes don't match the next 'write' event in the recording.\n        Default False — we just consume writes silently and serve queued\n        reads, which is friendlier when the caller's command sequence has\n        drifted.\"\"\"\n        self.path = Path(path)\n        self._strict = strict_writes\n        self._fp = None\n        self._read_queue: deque[bytes] = deque()\n        # One-event lookahead: an event pulled from the log but not yet\n        # consumed (e.g. a write event seen while looking for a read).\n        self._pending: tuple[str, str] | None = None\n        self._is_open = False\n        self.header: dict = {}\n\n    def open(self) -> None:\n        if self._is_open:\n            return\n        self._fp = self.path.open(\"r\", encoding=\"utf-8\")\n        first = self._fp.readline().strip()\n        if first:\n            try:\n                obj = json.loads(first)\n                if obj.get(\"kind\") == \"header\":\n                    self.header = obj\n                else:\n                    # No header — rewind.\n                    self._fp.seek(0)\n            except json.JSONDecodeError:\n                raise PlaybackError(f\"first line of {self.path} is not valid JSON\")\n        self._is_open = True\n\n    def close(self) -> None:\n        if self._fp is not None:\n            self._fp.close()\n            self._fp = None\n        self._is_open = False\n        self._read_queue.clear()\n        self._pending = None\n\n    def is_open(self) -> bool:\n        return self._is_open\n\n    def _next_event(self) -> tuple[str, str] | None:\n        \"\"\"Return the next (kind, hex_data) event of kind 'read'/'write',\n        skipping header/footer/unknown lines. Consumes `_pending` first.\"\"\"\n        if self._pending is not None:\n            ev = self._pending\n            self._pending = None\n            return ev\n        while self._fp is not None:\n            line = self._fp.readline()\n            if not line:\n                return None\n            line = line.strip()\n            if not line:\n                continue\n            try:\n                obj = json.loads(line)\n            except json.JSONDecodeError:\n                continue\n            kind = obj.get(\"kind\")\n            if kind in (\"read\", \"write\"):\n                return (kind, obj.get(\"data\", \"\"))\n            # header / footer / unknown — keep going\n        return None\n\n    def write(self, data: bytes) -> None:\n        # Pull events forward until we either hit a write event (which we\n        # match against `data`) or end of file. Any read events seen along\n        # the way are queued up for subsequent read() calls.\n        while True:\n            ev = self._next_event()\n            if ev is None:\n                if self._strict:\n                    raise PlaybackError(\"playback ran out of writes\")\n                return\n            kind, hexdata = ev\n            if kind == \"read\":\n                self._read_queue.append(bytes.fromhex(hexdata))\n                continue\n            # kind == \"write\"\n            expected = bytes.fromhex(hexdata)\n            if self._strict and expected != data:\n                raise PlaybackError(\n                    f\"write mismatch: expected {expected.hex().upper()} got {data.hex().upper()}\"\n                )\n            return\n\n    def read(self, n: int) -> bytes:\n        # First serve from the queue.\n        if self._read_queue:\n            chunk = self._read_queue.popleft()\n            if len(chunk) > n:\n                self._read_queue.appendleft(chunk[n:])\n                return chunk[:n]\n            return chunk\n        # Otherwise advance the log to find the next read — but stop (and\n        # push back) at a write event, since that belongs to the *next*\n        # write() call, not to this read().\n        ev = self._next_event()\n        if ev is None:\n            return b\"\"\n        kind, hexdata = ev\n        if kind == \"write\":\n            self._pending = ev\n            return b\"\"\n        data = bytes.fromhex(hexdata)\n        if len(data) > n:\n            self._read_queue.appendleft(data[n:])\n            return data[:n]\n        return data\n\n    def in_waiting(self) -> int:\n        if self._read_queue:\n            return len(self._read_queue[0])\n        return 0\n\n    @property\n    def describe(self) -> str:\n        return f\"playback {self.path}\"\n","numLines":489,"startLine":1,"totalLines":489}},"sourceToolAssistantUUID":"17f149d9-f98a-4822-9ee7-7a2e90a5c48e","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
