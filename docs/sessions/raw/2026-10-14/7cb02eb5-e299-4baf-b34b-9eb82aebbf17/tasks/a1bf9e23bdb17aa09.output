{"parentUuid":"a694c811-83de-46e2-b627-a512f70fd498","isSidechain":true,"promptId":"d6e397a4-8ef0-4e3f-aa12-0e1ab89aceab","agentId":"a1bf9e23bdb17aa09","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0198jn9x8kURi8KTfbmEB4us","type":"tool_result","content":"1\t\"\"\"Pure-data description of the Giorgio-platform CAN buses on this car.\n2\t\n3\tSource of truth: docs/reference/GIORGIO_MODULE_MAP.md (Table B, the\n4\tstructural finding, and the hazard entries). This module encodes exactly\n5\twhat that document says. Where the document says \"unknown\", this module\n6\tuses ``None``. Confidences are never upgraded past what the document\n7\tstates.\n8\t\n9\tStdlib only.\n10\t\"\"\"\n11\t\n12\tfrom __future__ import annotations\n13\t\n14\tfrom dataclasses import dataclass\n15\t\n16\tCABLES = (\"none\", \"blue_a5\", \"grey_a6\")\n17\t\n18\t\n19\t@dataclass(frozen=True)\n20\tclass Route:\n21\t    cable: str  # one of CABLES\n22\t    stn_protocol: str  # STN \"STP\" preset number as a string, e.g. \"34\", \"54\"\n23\t    bitrate_override: int | None  # e.g. 125000 when the HS preset must be re-rated after a re-pinning cable\n24\t    status: str  # \"confirmed\" | \"untested\" | \"unreachable\"\n25\t    note: str\n26\t\n27\t\n28\t@dataclass(frozen=True)\n29\tclass Bus:\n30\t    key: str  # \"can_c\" | \"can_ihs\" | \"can_ch\"\n31\t    name: str\n32\t    pins: tuple[int, int]\n33\t    bitrate: int  # the bus's own bitrate\n34\t    bitrate_confidence: str  # \"confirmed\" | \"inferred\"\n35\t    id_bits: int  # 29\n36\t    routes: tuple[Route, ...]  # every way to reach it, in preference order\n37\t    transmit_needs_confirmation: bool  # True for can_ch\n38\t    modules_seen: tuple[str, ...]  # MES codes actually observed on this bus on this car\n39\t    notes: str  # safety text from Table B\n40\t\n41\t\n42\tCAN_C = Bus(\n43\t    key=\"can_c\",\n44\t    name=\"CAN-C (diagnostic / powertrain)\",\n45\t    pins=(6, 14),\n46\t    bitrate=500000,\n47\t    bitrate_confidence=\"confirmed\",\n48\t    id_bits=29,\n49\t    routes=(\n50\t        Route(\n51\t            \"none\",\n52\t            \"34\",\n53\t            None,\n54\t            \"confirmed\",\n55\t            \"STP 34 (or STP 33 for the legislated 11-bit 7E0/7E8 pair); STPBRR expected 500000. \"\n56\t            \"On 2018+ Giorgio cars (Security Gateway Module) CAN-C is gateway-isolated: there is \"\n57\t            \"NO broadcast traffic on it at all, in either width -- a passive listen on STP 34 \"\n58\t            \"reading 0 frames does not mean the bus is dead. See the STP 33 route's note; \"\n59\t            \"ops.verify_bus() falls back to an active Mode 01 PID 00 probe for exactly this case.\",\n60\t        ),\n61\t        Route(\n62\t            \"none\",\n63\t            \"33\",\n64\t            None,\n65\t            \"untested\",\n66\t            \"11-bit legislated pair 7E0/7E8 at 500k. Giorgio broadcast traffic on CAN-C is \"\n67\t            \"largely 11-bit, so a monitor opened 29-bit-only can report zero frames on a \"\n68\t            \"perfectly healthy bus. Listened for after STP 34, never preferred for UDS. On \"\n69\t            \"2018+ cars behind the Security Gateway Module this route still carries no \"\n70\t            \"broadcast traffic either -- the gateway only answers a request, it never emits \"\n71\t            \"anything unprompted -- so a passive listen here is also 0 frames on a healthy \"\n72\t            \"car; verification instead sends one legislated Mode 01 PID 00 request (7DF) and \"\n73\t            \"accepts any 7E8-7EF reply as proof the bus is alive.\",\n74\t        ),\n75\t    ),\n76\t    transmit_needs_confirmation=False,\n77\t    modules_seen=(\"ECM\", \"IPC\", \"TCM\", \"DTCM\", \"ESM\", \"BCM\", \"RFHUB\", \"DASM\"),\n78\t    notes=(\n79\t        \"Live powertrain bus. Writes gated. Whole-vehicle serial UDS sweeps \"\n80\t        \"manufacture -87/-2F bystander codes (SCAN_2609041953 shows exactly \"\n81\t        \"that: DTCM U0100-87, BCM U171x-2F, EPS U1960-83). Pull DTC EX before \"\n82\t        \"clearing.\"\n83\t    ),\n84\t)\n85\t\n86\tCAN_IHS = Bus(\n87\t    key=\"can_ihs\",\n88\t    name=\"CAN-IHS (body / comfort / infotainment)\",\n89\t    pins=(3, 11),\n90\t    bitrate=125000,\n91\t    bitrate_confidence=\"confirmed\",\n92\t    id_bits=29,\n93\t    routes=(\n94\t        Route(\n95\t            \"blue_a5\",\n96\t            \"34\",\n97\t            125000,\n98\t            \"untested\",\n99\t            \"HS transceiver re-pinned onto 3/11 by the cable; never use STP 53/54 with the cable fitted\",\n100\t        ),\n101\t        Route(\n102\t            \"none\",\n103\t            \"54\",\n104\t            None,\n105\t            \"untested\",\n106\t            \"MS-CAN transceiver on adapter pins 3/11; verify STPRS changes and STPBRR reads 125000; auto-switch firmware may override\",\n107\t        ),\n108\t    ),\n109\t    transmit_needs_confirmation=False,\n110\t    modules_seen=(),\n111\t    notes=(\n112\t        \"Do not mix routes: with the A5 fitted, adapter pins 3/11 map to \"\n113\t        \"nothing defined, so use the HS preset plus STPBR, never STP \"\n114\t        \"53/54. Opening a 500k preset on a 125k bus emits error frames; \"\n115\t        \"set STCMM 0 before STPO when the rate is in doubt.\"\n116\t    ),\n117\t)\n118\t\n119\tCAN_CH = Bus(\n120\t    key=\"can_ch\",\n121\t    name=\"CAN-CH (chassis / ADAS / safety)\",\n122\t    pins=(12, 13),\n123\t    bitrate=500000,\n124\t    bitrate_confidence=\"inferred\",\n125\t    id_bits=29,\n126\t    routes=(\n127\t        Route(\n128\t            \"grey_a6\",\n129\t            \"34\",\n130\t            None,\n131\t            \"confirmed\",\n132\t            \"bitrate inferred 500k; if silent try STP 36 then STPBR 125000\",\n133\t        ),\n134\t    ),\n135\t    transmit_needs_confirmation=True,\n136\t    modules_seen=(\"ABS\", \"EPS\", \"ORC\", \"AFLS\", \"PAM\", \"HALF\"),\n137\t    notes=(\n138\t        \"Never transmit on CAN-CH without explicit human confirmation: \"\n139\t        \"brakes, airbag squibs and steering assist live here. Listen first \"\n140\t        \"with STCMM 0 + STM. FEPS hazard: the vLinker FS is a Ford tool \"\n141\t        \"whose 18V FEPS output is OBD pin 13, which on Giorgio is \"\n142\t        \"CAN-CH(-). Never issue any FEPS or programming-voltage command on \"\n143\t        \"this vehicle; whether the FS can be commanded to FEPS over serial \"\n144\t        \"is UNVERIFIED, treat as live.\"\n145\t    ),\n146\t)\n147\t\n148\tBUSES: dict[str, Bus] = {\n149\t    \"can_c\": CAN_C,\n150\t    \"can_ihs\": CAN_IHS,\n151\t    \"can_ch\": CAN_CH,\n152\t}\n153\t\n154\tPIN_1_9_WARNING = (\n155\t    \"do not use modified interfaces with a short between pins 1 and 9 on \"\n156\t    \"Giulia or Stelvio; it drops the bus. Continuity-check any cable \"\n157\t    \"before fitting.\"\n158\t)\n159\t\n160\t_HEADER_BITS_BY_PROTOCOL: dict[str, int] = {\n161\t    # ISO 15765-4 CAN STN \"STP\" preset numbers.\n162\t    \"31\": 11,\n163\t    \"33\": 11,\n164\t    \"35\": 11,\n165\t    \"51\": 11,\n166\t    \"53\": 11,\n167\t    \"32\": 29,\n168\t    \"34\": 29,\n169\t    \"36\": 29,\n170\t    \"52\": 29,\n171\t    \"54\": 29,\n172\t    # ELM-style short forms.\n173\t    \"6\": 11,\n174\t    \"8\": 11,\n175\t    \"7\": 29,\n176\t    \"9\": 29,\n177\t}\n178\t\n179\t\n180\tdef route_for(bus: Bus, cable: str) -> Route | None:\n181\t    \"\"\"The route on ``bus`` that works with ``cable``, or None.\"\"\"\n182\t    for route in bus.routes:\n183\t        if route.cable == cable:\n184\t            return route\n185\t    return None\n186\t\n187\t\n188\tdef routes_for(bus: Bus, cable: str) -> list[Route]:\n189\t    \"\"\"Every route on ``bus`` that works with ``cable``, in preference order.\n190\t\n191\t    A bus can be reachable under more than one adapter protocol. ``route_for``\n192\t    returns the preferred one and is what normal operations use; this returns\n193\t    the full candidate list, so a passive listen can try them all before\n194\t    concluding a bus is silent.\n195\t    \"\"\"\n196\t    return [route for route in bus.routes if route.cable == cable]\n197\t\n198\t\n199\tdef buses_for_cable(cable: str) -> list[Bus]:\n200\t    \"\"\"Buses reachable with ``cable``, in preference order.\"\"\"\n201\t    result = []\n202\t    for bus in BUSES.values():\n203\t        if route_for(bus, cable) is not None:\n204\t            result.append(bus)\n205\t    return result\n206\t\n207\t\n208\tdef header_bits_for_protocol(stn_protocol: str) -> int:\n209\t    \"\"\"11 or 29, per the STN STP preset (or ELM short form).\"\"\"\n210\t    return _HEADER_BITS_BY_PROTOCOL[stn_protocol]\n211\t"}]},"uuid":"299ad947-913f-4b19-84b2-b03331b0ff47","timestamp":"2026-10-14T11:06:54.170Z","toolUseResult":{"type":"text","file":{"filePath":"C:\\Users\\User\\mcp-servers\\cuore\\live\\buses.py","content":"\"\"\"Pure-data description of the Giorgio-platform CAN buses on this car.\n\nSource of truth: docs/reference/GIORGIO_MODULE_MAP.md (Table B, the\nstructural finding, and the hazard entries). This module encodes exactly\nwhat that document says. Where the document says \"unknown\", this module\nuses ``None``. Confidences are never upgraded past what the document\nstates.\n\nStdlib only.\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom dataclasses import dataclass\n\nCABLES = (\"none\", \"blue_a5\", \"grey_a6\")\n\n\n@dataclass(frozen=True)\nclass Route:\n    cable: str  # one of CABLES\n    stn_protocol: str  # STN \"STP\" preset number as a string, e.g. \"34\", \"54\"\n    bitrate_override: int | None  # e.g. 125000 when the HS preset must be re-rated after a re-pinning cable\n    status: str  # \"confirmed\" | \"untested\" | \"unreachable\"\n    note: str\n\n\n@dataclass(frozen=True)\nclass Bus:\n    key: str  # \"can_c\" | \"can_ihs\" | \"can_ch\"\n    name: str\n    pins: tuple[int, int]\n    bitrate: int  # the bus's own bitrate\n    bitrate_confidence: str  # \"confirmed\" | \"inferred\"\n    id_bits: int  # 29\n    routes: tuple[Route, ...]  # every way to reach it, in preference order\n    transmit_needs_confirmation: bool  # True for can_ch\n    modules_seen: tuple[str, ...]  # MES codes actually observed on this bus on this car\n    notes: str  # safety text from Table B\n\n\nCAN_C = Bus(\n    key=\"can_c\",\n    name=\"CAN-C (diagnostic / powertrain)\",\n    pins=(6, 14),\n    bitrate=500000,\n    bitrate_confidence=\"confirmed\",\n    id_bits=29,\n    routes=(\n        Route(\n            \"none\",\n            \"34\",\n            None,\n            \"confirmed\",\n            \"STP 34 (or STP 33 for the legislated 11-bit 7E0/7E8 pair); STPBRR expected 500000. \"\n            \"On 2018+ Giorgio cars (Security Gateway Module) CAN-C is gateway-isolated: there is \"\n            \"NO broadcast traffic on it at all, in either width -- a passive listen on STP 34 \"\n            \"reading 0 frames does not mean the bus is dead. See the STP 33 route's note; \"\n            \"ops.verify_bus() falls back to an active Mode 01 PID 00 probe for exactly this case.\",\n        ),\n        Route(\n            \"none\",\n            \"33\",\n            None,\n            \"untested\",\n            \"11-bit legislated pair 7E0/7E8 at 500k. Giorgio broadcast traffic on CAN-C is \"\n            \"largely 11-bit, so a monitor opened 29-bit-only can report zero frames on a \"\n            \"perfectly healthy bus. Listened for after STP 34, never preferred for UDS. On \"\n            \"2018+ cars behind the Security Gateway Module this route still carries no \"\n            \"broadcast traffic either -- the gateway only answers a request, it never emits \"\n            \"anything unprompted -- so a passive listen here is also 0 frames on a healthy \"\n            \"car; verification instead sends one legislated Mode 01 PID 00 request (7DF) and \"\n            \"accepts any 7E8-7EF reply as proof the bus is alive.\",\n        ),\n    ),\n    transmit_needs_confirmation=False,\n    modules_seen=(\"ECM\", \"IPC\", \"TCM\", \"DTCM\", \"ESM\", \"BCM\", \"RFHUB\", \"DASM\"),\n    notes=(\n        \"Live powertrain bus. Writes gated. Whole-vehicle serial UDS sweeps \"\n        \"manufacture -87/-2F bystander codes (SCAN_2609041953 shows exactly \"\n        \"that: DTCM U0100-87, BCM U171x-2F, EPS U1960-83). Pull DTC EX before \"\n        \"clearing.\"\n    ),\n)\n\nCAN_IHS = Bus(\n    key=\"can_ihs\",\n    name=\"CAN-IHS (body / comfort / infotainment)\",\n    pins=(3, 11),\n    bitrate=125000,\n    bitrate_confidence=\"confirmed\",\n    id_bits=29,\n    routes=(\n        Route(\n            \"blue_a5\",\n            \"34\",\n            125000,\n            \"untested\",\n            \"HS transceiver re-pinned onto 3/11 by the cable; never use STP 53/54 with the cable fitted\",\n        ),\n        Route(\n            \"none\",\n            \"54\",\n            None,\n            \"untested\",\n            \"MS-CAN transceiver on adapter pins 3/11; verify STPRS changes and STPBRR reads 125000; auto-switch firmware may override\",\n        ),\n    ),\n    transmit_needs_confirmation=False,\n    modules_seen=(),\n    notes=(\n        \"Do not mix routes: with the A5 fitted, adapter pins 3/11 map to \"\n        \"nothing defined, so use the HS preset plus STPBR, never STP \"\n        \"53/54. Opening a 500k preset on a 125k bus emits error frames; \"\n        \"set STCMM 0 before STPO when the rate is in doubt.\"\n    ),\n)\n\nCAN_CH = Bus(\n    key=\"can_ch\",\n    name=\"CAN-CH (chassis / ADAS / safety)\",\n    pins=(12, 13),\n    bitrate=500000,\n    bitrate_confidence=\"inferred\",\n    id_bits=29,\n    routes=(\n        Route(\n            \"grey_a6\",\n            \"34\",\n            None,\n            \"confirmed\",\n            \"bitrate inferred 500k; if silent try STP 36 then STPBR 125000\",\n        ),\n    ),\n    transmit_needs_confirmation=True,\n    modules_seen=(\"ABS\", \"EPS\", \"ORC\", \"AFLS\", \"PAM\", \"HALF\"),\n    notes=(\n        \"Never transmit on CAN-CH without explicit human confirmation: \"\n        \"brakes, airbag squibs and steering assist live here. Listen first \"\n        \"with STCMM 0 + STM. FEPS hazard: the vLinker FS is a Ford tool \"\n        \"whose 18V FEPS output is OBD pin 13, which on Giorgio is \"\n        \"CAN-CH(-). Never issue any FEPS or programming-voltage command on \"\n        \"this vehicle; whether the FS can be commanded to FEPS over serial \"\n        \"is UNVERIFIED, treat as live.\"\n    ),\n)\n\nBUSES: dict[str, Bus] = {\n    \"can_c\": CAN_C,\n    \"can_ihs\": CAN_IHS,\n    \"can_ch\": CAN_CH,\n}\n\nPIN_1_9_WARNING = (\n    \"do not use modified interfaces with a short between pins 1 and 9 on \"\n    \"Giulia or Stelvio; it drops the bus. Continuity-check any cable \"\n    \"before fitting.\"\n)\n\n_HEADER_BITS_BY_PROTOCOL: dict[str, int] = {\n    # ISO 15765-4 CAN STN \"STP\" preset numbers.\n    \"31\": 11,\n    \"33\": 11,\n    \"35\": 11,\n    \"51\": 11,\n    \"53\": 11,\n    \"32\": 29,\n    \"34\": 29,\n    \"36\": 29,\n    \"52\": 29,\n    \"54\": 29,\n    # ELM-style short forms.\n    \"6\": 11,\n    \"8\": 11,\n    \"7\": 29,\n    \"9\": 29,\n}\n\n\ndef route_for(bus: Bus, cable: str) -> Route | None:\n    \"\"\"The route on ``bus`` that works with ``cable``, or None.\"\"\"\n    for route in bus.routes:\n        if route.cable == cable:\n            return route\n    return None\n\n\ndef routes_for(bus: Bus, cable: str) -> list[Route]:\n    \"\"\"Every route on ``bus`` that works with ``cable``, in preference order.\n\n    A bus can be reachable under more than one adapter protocol. ``route_for``\n    returns the preferred one and is what normal operations use; this returns\n    the full candidate list, so a passive listen can try them all before\n    concluding a bus is silent.\n    \"\"\"\n    return [route for route in bus.routes if route.cable == cable]\n\n\ndef buses_for_cable(cable: str) -> list[Bus]:\n    \"\"\"Buses reachable with ``cable``, in preference order.\"\"\"\n    result = []\n    for bus in BUSES.values():\n        if route_for(bus, cable) is not None:\n            result.append(bus)\n    return result\n\n\ndef header_bits_for_protocol(stn_protocol: str) -> int:\n    \"\"\"11 or 29, per the STN STP preset (or ELM short form).\"\"\"\n    return _HEADER_BITS_BY_PROTOCOL[stn_protocol]\n","numLines":211,"startLine":1,"totalLines":211}},"sourceToolAssistantUUID":"a694c811-83de-46e2-b627-a512f70fd498","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
{"parentUuid":"299ad947-913f-4b19-84b2-b03331b0ff47","isSidechain":true,"agentId":"a1bf9e23bdb17aa09","message":{"model":"claude-sonnet-5","id":"msg_011Cg22FPB6X1mdYTZwfBiqq","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01CYkSSqF5VvaJJyaHKH9dn1","name":"Read","input":{"file_path":"C:\\Users\\User\\mcp-servers\\cuore\\live\\poller.py"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":7136,"cache_read_input_tokens":57962,"cache_creation":{"ephemeral_5m_input_tokens":7136,"ephemeral_1h_input_tokens":0},"output_tokens":2,"service_tier":"standard","inference_geo":"global"},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_01CYkSSqF5VvaJJyaHKH9dn1":{"file_path":"C:\\Users\\User\\mcp-servers\\cuore\\live\\poller.py"}},"serverClassifierRequest":"4b01465f-a042-457a-850c-b02e8aab69de","apiBlockIndex":3,"requestId":"req_011Cg22FNwiaGTDYvRy8gNN7","attributionAgent":"general-purpose","type":"assistant","uuid":"b74eaa1b-b37f-4175-a39a-b98858a41094","timestamp":"2026-10-14T11:06:54.576Z","effort":"high","perTurnEffort":null,"userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
{"parentUuid":"b74eaa1b-b37f-4175-a39a-b98858a41094","isSidechain":true,"promptId":"d6e397a4-8ef0-4e3f-aa12-0e1ab89aceab","agentId":"a1bf9e23bdb17aa09","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01CYkSSqF5VvaJJyaHKH9dn1","type":"tool_result","content":"1\t\"\"\"The live-data poller: one background thread, one adapter session, many channels.\n2\t\n3\t:class:`LivePoller` owns exactly one :class:`~cuore.live.transport.Session`\n4\tfor the whole run -- opened once in :meth:`LivePoller.start`'s worker thread\n5\tand held until :meth:`LivePoller.stop`. It round-robins the requested\n6\tchannels at their configured rate, batching Mode 01 PIDs (up to 6 per\n7\trequest) and grouping UDS DID reads per module, publishes every sample to\n8\tsubscribers (the SSE route), keeps a per-channel ring buffer, evaluates\n9\talarm thresholds with hysteresis, and can mirror the session to an MES-format\n10\tCSV recording.\n11\t\n12\tOnly read services (Mode 01, UDS 0x22, ``ATRV``) are ever sent -- nothing\n13\there writes to the vehicle. A session refuses to start while MultiEcuScan is\n14\tconnected (the ordinary interlock in :meth:`AdapterLink.session`); other live\n15\toperations refuse while a poll session is active (see the guard appended to\n16\t``ops.py``).\n17\t\"\"\"\n18\t\n19\tfrom __future__ import annotations\n20\t\n21\timport queue\n22\timport re\n23\timport threading\n24\timport time\n25\tfrom collections import deque\n26\tfrom dataclasses import dataclass\n27\tfrom datetime import datetime\n28\tfrom pathlib import Path\n29\tfrom typing import Any, Optional\n30\t\n31\tfrom . import audit, store\n32\tfrom . import uds as uds_mod\n33\tfrom .buses import CAN_C, header_bits_for_protocol, route_for\n34\tfrom .channels import Channel, ComputedError, eval_expr\n35\tfrom .config import state_dir\n36\tfrom .errors import BadCommand, LinkUnavailable, Refused\n37\tfrom .obd import PIDS_BY_HEX, decode_obd_dtcs, decode_pid\n38\tfrom .transport import Session, link\n39\t\n40\tMIN_TICK = 0.02\n41\tDEFAULT_RING_MINUTES = 5.0\n42\t_MAX_MULTI_PID = 6\n43\t#: \"Monitor DTCs\" (MES convention): read Mode 03/07 between channel reads,\n44\t#: no faster than this, so it never competes meaningfully with fast channels.\n45\tMIN_DTC_INTERVAL_S = 5.0\n46\tDEFAULT_DTC_INTERVAL_S = 10.0\n47\t\n48\t\n49\tdef _parse_multi_pid(data: list[str], pids: list[str]) -> dict[str, list[str]]:\n50\t    \"\"\"Split a ``41 <pid> <data> 41 <pid> <data> ...`` payload by the PIDs asked.\n51\t\n52\t    A multi-PID Mode 01 reply repeats the ``41`` response byte before each\n53\t    PID's own group. Stops at the first group that does not match the next\n54\t    PID asked -- the ECU answered fewer than requested, which is how a\n55\t    caller learns multi-PID does not fully work here and should fall back\n56\t    to single requests.\n57\t    \"\"\"\n58\t    out: dict[str, list[str]] = {}\n59\t    i = 0\n60\t    for pid in pids:\n61\t        if i + 1 >= len(data) or data[i] != \"41\" or data[i + 1] != pid:\n62\t            break\n63\t        spec = PIDS_BY_HEX.get(pid)\n64\t        n = spec.n_bytes if spec else 1\n65\t        if i + 2 + n > len(data):\n66\t            break\n67\t        out[pid] = data[i + 2:i + 2 + n]\n68\t        i += 2 + n\n69\t    return out\n70\t\n71\t\n72\t# ===========================================================================\n73\t# alarms\n74\t# ===========================================================================\n75\t\n76\t@dataclass\n77\tclass AlarmSpec:\n78\t    channel_id: str\n79\t    warn: Optional[float] = None\n80\t    alarm: Optional[float] = None\n81\t    direction: str = \"above\"       # \"above\" | \"below\"\n82\t    hysteresis: float = 0.0\n83\t\n84\t    def level_for(self, value: float, current: str) -> str:\n85\t        \"\"\"The alarm level ``value`` implies, given the level it is already at.\n86\t\n87\t        Crossing INTO a stricter level uses the raw threshold; leaving one\n88\t        requires clearing it by ``hysteresis`` first, so a value dithering\n89\t        right at the line does not re-fire on every sample.\n90\t        \"\"\"\n91\t        sign = 1.0 if self.direction == \"above\" else -1.0\n92\t        v = sign * value\n93\t        alarm = None if self.alarm is None else sign * self.alarm\n94\t        warn = None if self.warn is None else sign * self.warn\n95\t        h = abs(self.hysteresis)\n96\t\n97\t        def is_alarm() -> bool:\n98\t            if alarm is None:\n99\t                return False\n100\t            if v >= alarm:\n101\t                return True\n102\t            return current == \"alarm\" and v >= alarm - h\n103\t\n104\t        def is_warn() -> bool:\n105\t            if warn is None:\n106\t                return False\n107\t            if v >= warn:\n108\t                return True\n109\t            return current in (\"warn\", \"alarm\") and v >= warn - h\n110\t\n111\t        if is_alarm():\n112\t            return \"alarm\"\n113\t        if is_warn():\n114\t            return \"warn\"\n115\t        return \"ok\"\n116\t\n117\t    def to_dict(self) -> dict[str, Any]:\n118\t        return {\"channel\": self.channel_id, \"warn\": self.warn, \"alarm\": self.alarm,\n119\t                \"direction\": self.direction, \"hysteresis\": self.hysteresis}\n120\t\n121\t\n122\t# ===========================================================================\n123\t# CSV recording, in the MES graph-CSV shape mes.csvlog parses\n124\t# ===========================================================================\n125\t\n126\tclass CsvRecorder:\n127\t    \"\"\"Mirrors a live session to a CSV in the shape ``mes.csvlog.load_csv`` reads:\n128\t    ``Time`` first, ``TAG`` last, row 1 names, row 2 units, tab-separated.\"\"\"\n129\t\n130\t    def __init__(self, path: Path, channels: list[Channel]) -> None:\n131\t        self.path = path\n132\t        self.channels = channels\n133\t        self._fh = None\n134\t        self._last: dict[str, Any] = {}\n135\t        self._start: Optional[float] = None\n136\t        self._rows = 0\n137\t\n138\t    def start(self) -> None:\n139\t        self.path.parent.mkdir(parents=True, exist_ok=True)\n140\t        self._fh = self.path.open(\"w\", encoding=\"utf-8\", newline=\"\")\n141\t        names = [\"Time\"] + [c.name for c in self.channels] + [\"TAG\"]\n142\t        units = [\"sec\"] + [c.unit for c in self.channels] + [\" \"]\n143\t        self._fh.write(\"\\t\".join(f'\"{n}\"' for n in names) + \"\\n\")\n144\t        self._fh.write(\"\\t\".join(f'\"{u}\"' for u in units) + \"\\n\")\n145\t        self._fh.flush()\n146\t        self._start = time.monotonic()\n147\t\n148\t    def update(self, channel_id: str, value: Any) -> None:\n149\t        self._last[channel_id] = value\n150\t\n151\t    def write_row(self, tag: str = \"\") -> None:\n152\t        if self._fh is None or self._start is None:\n153\t            return\n154\t        t = time.monotonic() - self._start\n155\t        cells = [f\"{t:.3f}\"]\n156\t        for c in self.channels:\n157\t            v = self._last.get(c.id)\n158\t            if v is None:\n159\t                cells.append(\"\")\n160\t            elif isinstance(v, float):\n161\t                cells.append(f\"{v:.4f}\")\n162\t            else:\n163\t                cells.append(str(v))\n164\t        cells.append(f'\"{tag}\"' if tag else '\"\"')\n165\t        self._fh.write(\"\\t\".join(cells) + \"\\n\")\n166\t        self._fh.flush()\n167\t        self._rows += 1\n168\t\n169\t    def stop(self) -> None:\n170\t        if self._fh is not None:\n171\t            try:\n172\t                self._fh.close()\n173\t            finally:\n174\t                self._fh = None\n175\t\n176\t\n177\t# ===========================================================================\n178\t# the poller\n179\t# ===========================================================================\n180\t\n181\tclass LivePoller:\n182\t    \"\"\"One process-wide live-data session. Create one; use :func:`poller`.\"\"\"\n183\t\n184\t    def __init__(self) -> None:\n185\t        self._lock = threading.RLock()\n186\t        self._thread: Optional[threading.Thread] = None\n187\t        self._stop_event = threading.Event()\n188\t        self._channels: dict[str, Channel] = {}\n189\t        self._rates: dict[str, float] = {}\n190\t        self._ring_minutes = DEFAULT_RING_MINUTES\n191\t        self._ring: dict[str, deque] = {}\n192\t        self._last_value: dict[str, Any] = {}\n193\t        self._last_unit: dict[str, str] = {}\n194\t        self._sample_counts: dict[str, int] = {}\n195\t        self._subscribers: list[queue.Queue] = []\n196\t        self._alarms: dict[str, AlarmSpec] = {}\n197\t        self._alarm_level: dict[str, str] = {}\n198\t        self._started_at: Optional[float] = None\n199\t        self._error: Optional[str] = None\n200\t        self._recorder: Optional[CsvRecorder] = None\n201\t        self._pid_multi_ok = True\n202\t        self._opens = 0\n203\t        self._mode = \"did\"\n204\t        self._pid_route = None\n205\t        self._did_route = None\n206\t        self._holding = False\n207\t        self._monitor_dtcs = False\n208\t        self._dtc_interval = DEFAULT_DTC_INTERVAL_S\n209\t        #: (stored_codes, pending_codes) as of the last successful poll, or\n210\t        #: None before the first one -- the first read only establishes a\n211\t        #: baseline, it never reports a \"change\" for codes already present.\n212\t        self._dtc_state: Optional[tuple[set[str], set[str]]] = None\n213\t        #: code -> iso timestamp this poller session first saw it (stored or\n214\t        #: pending) -- read by :meth:`dtc_snapshot`, never by ``_run`` itself.\n215\t        self._dtc_first_seen: dict[str, str] = {}\n216\t\n217\t    # --- lifecycle -----------------------------------------------------\n218\t\n219\t    def is_active(self) -> bool:\n220\t        with self._lock:\n221\t            return self._thread is not None and self._thread.is_alive()\n222\t\n223\t    def holds_adapter(self) -> bool:\n224\t        \"\"\"True only once the session is actually open and polling.\n225\t\n226\t        Distinct from :meth:`is_active` (thread spawned) so the poller's own\n227\t        startup -- which opens its session through the ordinary\n228\t        :meth:`AdapterLink.session` path and may auto-verify the bus via\n229\t        ``ops.verify_bus`` -- is never refused by its own guard.\n230\t        \"\"\"\n231\t        with self._lock:\n232\t            return self._holding\n233\t\n234\t    def start(self, channels: list[Channel], rates: Optional[dict[str, float]] = None,\n235\t             monitor_dtcs: bool = False, dtc_interval_s: float = DEFAULT_DTC_INTERVAL_S\n236\t             ) -> dict[str, Any]:\n237\t        with self._lock:\n238\t            if self.is_active():\n239\t                raise Refused(\"a live-data poll session is already running; stop it first\")\n240\t            if not channels:\n241\t                raise BadCommand(\"no channels to poll\")\n242\t            for c in channels:\n243\t                if c.bus != \"can_c\" and c.kind != \"computed\":\n244\t                    raise BadCommand(f\"channel {c.id!r} is on bus {c.bus!r}; the live-data \"\n245\t                                     f\"poller currently serves can_c channels only\")\n246\t            self._channels = {c.id: c for c in channels}\n247\t            self._rates = {c.id: max(0.05, float((rates or {}).get(c.id, c.default_rate_hz)))\n248\t                          for c in channels}\n249\t            self._ring = {c.id: deque(maxlen=self._ring_len(self._rates[c.id])) for c in channels}\n250\t            self._last_value = {}\n251\t            self._last_unit = {}\n252\t            self._sample_counts = {c.id: 0 for c in channels}\n253\t            self._alarm_level = {}\n254\t            self._error = None\n255\t            self._pid_multi_ok = True\n256\t            self._started_at = None\n257\t            self._mode = \"did\"\n258\t            self._monitor_dtcs = bool(monitor_dtcs)\n259\t            self._dtc_interval = max(MIN_DTC_INTERVAL_S, float(dtc_interval_s))\n260\t            self._dtc_state = None\n261\t            self._dtc_first_seen = {}\n262\t            self._stop_event.clear()\n263\t            self._thread = threading.Thread(target=self._run, name=\"cuore-live-poller\",\n264\t                                            daemon=True)\n265\t            self._thread.start()\n266\t        # Give the worker a moment to open the session so a refusal (MES\n267\t        # connected, no port, adapter fault) surfaces to this call rather\n268\t        # than only showing up later in status().\n269\t        deadline = time.monotonic() + 3.0\n270\t        while time.monotonic() < deadline:\n271\t            with self._lock:\n272\t                if self._started_at is not None or self._error is not None:\n273\t                    break\n274\t                if self._thread is None or not self._thread.is_alive():\n275\t                    break\n276\t            time.sleep(0.02)\n277\t        with self._lock:\n278\t            if self._error is not None:\n279\t                err, self._thread = self._error, None\n280\t                raise LinkUnavailable(err)\n281\t            return self._status_locked()\n282\t\n283\t    def stop(self) -> dict[str, Any]:\n284\t        with self._lock:\n285\t            if not self.is_active():\n286\t                return {\"stopped\": False, \"note\": \"no live-data session running\"}\n287\t            self._stop_event.set()\n288\t            t = self._thread\n289\t        if t is not None:\n290\t            t.join(timeout=10)\n291\t        with self._lock:\n292\t            self._thread = None\n293\t            self._holding = False\n294\t            recorder, self._recorder = self._recorder, None\n295\t        if recorder is not None:\n296\t            recorder.stop()\n297\t        return {\"stopped\": True}\n298\t\n299\t    def _ring_len(self, rate_hz: float) -> int:\n300\t        return max(60, int(rate_hz * 60 * self._ring_minutes))\n301\t\n302\t    # --- status ----------------------------------------------------------\n303\t\n304\t    def status(self) -> dict[str, Any]:\n305\t        with self._lock:\n306\t            return self._status_locked()\n307\t\n308\t    def _status_locked(self) -> dict[str, Any]:\n309\t        active = self._thread is not None and self._thread.is_alive()\n310\t        elapsed = (time.monotonic() - self._started_at) if (self._started_at and active) else None\n311\t        achieved = {}\n312\t        if elapsed and elapsed > 0:\n313\t            achieved = {cid: round(n / elapsed, 3) for cid, n in self._sample_counts.items()}\n314\t        return {\n315\t            \"active\": active,\n316\t            \"channels\": [c.to_dict() for c in self._channels.values()],\n317\t            \"rates_hz\": dict(self._rates),\n318\t            \"achieved_hz\": achieved,\n319\t            \"elapsed_s\": round(elapsed, 1) if elapsed else None,\n320\t            \"recording\": str(self._recorder.path) if self._recorder else None,\n321\t            \"error\": self._error,\n322\t            \"multi_pid_supported\": self._pid_multi_ok,\n323\t            \"alarms\": {cid: a.to_dict() for cid, a in self._alarms.items()},\n324\t            \"monitor_dtcs\": self._monitor_dtcs,\n325\t            \"dtc_interval_s\": self._dtc_interval,\n326\t        }\n327\t\n328\t    def snapshot(self) -> dict[str, Any]:\n329\t        with self._lock:\n330\t            channels = {\n331\t                cid: {\"value\": self._last_value.get(cid), \"unit\": self._last_unit.get(cid, \"\"),\n332\t                     \"alarm\": self._alarm_level.get(cid, \"ok\")}\n333\t                for cid in self._channels\n334\t            }\n335\t            return {\"active\": self.is_active(), \"channels\": channels}\n336\t\n337\t    def dtc_snapshot(self) -> dict[str, Any]:\n338\t        \"\"\"Read-only view of \"Monitor DTCs\" state for a caller that wants to\n339\t        know about a code this session has seen without re-deriving the\n340\t        Mode 03/07 diff itself (see :mod:`cuore.services.systems_map_bridge`'s\n341\t        live-overlay ``new_codes``): ``{\"codes\": [...], \"first_seen\": {code:\n342\t        iso timestamp}}``. Empty before the first Monitor-DTCs cycle, or when\n343\t        ``monitor_dtcs`` was never requested for this session.\n344\t        \"\"\"\n345\t        with self._lock:\n346\t            if self._dtc_state is None:\n347\t                return {\"codes\": [], \"first_seen\": {}}\n348\t            stored, pending = self._dtc_state\n349\t            return {\"codes\": sorted(stored | pending), \"first_seen\": dict(self._dtc_first_seen)}\n350\t\n351\t    # --- alarms ------------------------------------------------------------\n352\t\n353\t    def set_alarm(self, channel_id: str, warn: Optional[float] = None,\n354\t                 alarm: Optional[float] = None, direction: str = \"above\",\n355\t                 hysteresis: float = 0.0) -> dict[str, Any]:\n356\t        if direction not in (\"above\", \"below\"):\n357\t            raise BadCommand(\"direction must be 'above' or 'below'\")\n358\t        with self._lock:\n359\t            spec = AlarmSpec(channel_id, warn, alarm, direction, hysteresis)\n360\t            self._alarms[channel_id] = spec\n361\t            self._alarm_level.pop(channel_id, None)\n362\t            return spec.to_dict()\n363\t\n364\t    def clear_alarm(self, channel_id: str) -> dict[str, Any]:\n365\t        with self._lock:\n366\t            self._alarms.pop(channel_id, None)\n367\t            self._alarm_level.pop(channel_id, None)\n368\t            return {\"channel\": channel_id, \"cleared\": True}\n369\t\n370\t    # --- subscribers (SSE) -------------------------------------------------\n371\t\n372\t    def subscribe(self) -> \"queue.Queue[dict[str, Any]]\":\n373\t        q: \"queue.Queue[dict[str, Any]]\" = queue.Queue(maxsize=2000)\n374\t        with self._lock:\n375\t            self._subscribers.append(q)\n376\t        return q\n377\t\n378\t    def unsubscribe(self, q: \"queue.Queue[dict[str, Any]]\") -> None:\n379\t        with self._lock:\n380\t            if q in self._subscribers:\n381\t                self._subscribers.remove(q)\n382\t\n383\t    def _broadcast(self, msg: dict[str, Any]) -> None:\n384\t        with self._lock:\n385\t            subs = list(self._subscribers)\n386\t        for q in subs:\n387\t            try:\n388\t                q.put_nowait(msg)\n389\t            except queue.Full:\n390\t                pass\n391\t\n392\t    # --- recording -----------------------------------------------------\n393\t\n394\t    def start_recording(self) -> dict[str, Any]:\n395\t        with self._lock:\n396\t            if not self.is_active():\n397\t                raise Refused(\"no live-data session running; start one first\")\n398\t            if self._recorder is not None:\n399\t                return {\"recording\": str(self._recorder.path), \"already_recording\": True}\n400\t            d = state_dir() / \"recordings\"\n401\t            path = d / f\"live_{datetime.now().strftime('%Y%m%d-%H%M%S')}.csv\"\n402\t            rec = CsvRecorder(path, list(self._channels.values()))\n403\t            rec.start()\n404\t            self._recorder = rec\n405\t            return {\"recording\": str(path)}\n406\t\n407\t    def stop_recording(self) -> dict[str, Any]:\n408\t        with self._lock:\n409\t            rec, self._recorder = self._recorder, None\n410\t        if rec is None:\n411\t            return {\"stopped\": False, \"note\": \"not recording\"}\n412\t        rec.stop()\n413\t        return {\"stopped\": True, \"path\": str(rec.path), \"rows\": rec._rows}\n414\t\n415\t    # --- the worker thread -----------------------------------------------\n416\t\n417\t    def _run(self) -> None:\n418\t        from . import ops as ops_mod  # local: ops imports poller lazily; avoid a cycle at import time\n419\t        lk = link()\n420\t        try:\n421\t            did_route = route_for(CAN_C, lk.cable)\n422\t            pid_route = ops_mod._obd_route()\n423\t            if pid_route is None:\n424\t                raise LinkUnavailable(\"no 11-bit legislated route on can_c for cable \"\n425\t                                      f\"{lk.cable!r}; Mode 01 PIDs need it\")\n426\t            self._pid_route, self._did_route = pid_route, did_route\n427\t            with lk.session(\"live_session\", bus=CAN_C) as sess:\n428\t                self._stream_desc = getattr(getattr(sess, \"stream\", None), \"describe\", \"\") or \"\"\n429\t                self._opens += 1\n430\t                self._mode = \"did\"\n431\t                with self._lock:\n432\t                    self._started_at = time.monotonic()\n433\t                    self._holding = True\n434\t                try:\n435\t                    next_due = {cid: 0.0 for cid in self._channels}\n436\t                    next_dtc_due = 0.0\n437\t                    while not self._stop_event.is_set():\n438\t                        now = time.monotonic()\n439\t                        due = [cid for cid, t in next_due.items() if t <= now]\n440\t                        dtc_due = self._monitor_dtcs and next_dtc_due <= now\n441\t                        if not due and not dtc_due:\n442\t                            time.sleep(MIN_TICK)\n443\t                            continue\n444\t                        pid_due = [c for c in due if self._channels[c].kind == \"pid\"]\n445\t                        did_due = [c for c in due if self._channels[c].kind == \"did\"]\n446\t                        batt_due = [c for c in due if self._channels[c].kind == \"battery\"]\n447\t                        comp_due = [c for c in due if self._channels[c].kind == \"computed\"]\n448\t                        touched: set[str] = set()\n449\t                        if pid_due:\n450\t                            self._switch_mode(sess, \"pid\")\n451\t                            touched |= self._poll_pids(sess, pid_due)\n452\t                        if did_due:\n453\t                            self._switch_mode(sess, \"did\")\n454\t                            touched |= self._poll_dids(sess, did_due)\n455\t                        if batt_due:\n456\t                            touched |= self._poll_battery(sess, batt_due)\n457\t                        if comp_due:\n458\t                            touched |= self._poll_computed(comp_due)\n459\t                        # DTC monitoring runs only on its own (much slower) schedule,\n460\t                        # after this tick's channel reads -- so it never displaces a\n461\t                        # fast channel's due sample, only ever adds a bounded, rare\n462\t                        # extra pair of requests once every dtc_interval seconds.\n463\t                        if dtc_due:\n464\t                            self._poll_dtcs(sess)\n465\t                            next_dtc_due = time.monotonic() + self._dtc_interval\n466\t                        later = time.monotonic()\n467\t                        for cid in due:\n468\t                            next_due[cid] = later + 1.0 / self._rates.get(cid, 1.0)\n469\t                        if touched:\n470\t                            with self._lock:\n471\t                                rec = self._recorder\n472\t                            if rec is not None:\n473\t                                rec.write_row()\n474\t                        time.sleep(MIN_TICK)\n475\t                finally:\n476\t                    with self._lock:\n477\t                        self._holding = False\n478\t        except Exception as e:  # noqa: BLE001 -- reported through status()/start()'s wait\n479\t            with self._lock:\n480\t                self._error = str(e)\n481\t                self._holding = False\n482\t\n483\t    def _switch_mode(self, sess: Session, want: str) -> None:\n484\t        if self._mode == want:\n485\t            return\n486\t        route = self._pid_route if want == \"pid\" else self._did_route\n487\t        if route is None:\n488\t            raise LinkUnavailable(f\"no route available for {want} mode\")\n489\t        if not sess.link.is_stn:\n490\t            raise LinkUnavailable(\"live-data polling of both PIDs and DIDs needs an STN adapter\")\n491\t        if sess.route.stn_protocol != route.stn_protocol:\n492\t            sess.cmd(f\"STP {route.stn_protocol}\", 2)\n493\t            if route.bitrate_override:\n494\t                sess.cmd(f\"STPBR {route.bitrate_override}\", 2)\n495\t            sess.route = route\n496\t            sess.header_bits = header_bits_for_protocol(route.stn_protocol)\n497\t            sess._target = None\n498\t        if want == \"pid\":\n499\t            sess.untarget()\n500\t        self._mode = want\n501\t\n502\t    # --- per-kind polling ---------------------------------------------------\n503\t\n504\t    def _poll_pids(self, sess: Session, due_ids: list[str]) -> set[str]:\n505\t        sess.untarget()\n506\t        # The up-to-6 cap only matters for a multi-PID batch; once multi-PID\n507\t        # is known unsupported every due channel is polled individually this\n508\t        # same tick, not just the first (each is its own request either way).\n509\t        ids = due_ids[:_MAX_MULTI_PID] if self._pid_multi_ok else due_ids\n510\t        pid_by_id: dict[str, str] = {cid: self._channels[cid].pid for cid in ids}\n511\t        pids = list(dict.fromkeys(pid_by_id.values()))\n512\t        touched: set[str] = set()\n513\t        if self._pid_multi_ok and len(pids) > 1:\n514\t            q = sess.query(\"01\" + \"\".join(pids), \"41\")\n515\t            data = next(iter(q[\"ecus\"].values()), None)\n516\t            if q[\"error\"] or not data:\n517\t                self._pid_multi_ok = False\n518\t                return touched\n519\t            parsed = _parse_multi_pid(data, pids)\n520\t            if len(parsed) < len(pids):\n521\t                self._pid_multi_ok = False\n522\t            for cid in ids:\n523\t                pid = pid_by_id[cid]\n524\t                if pid in parsed:\n525\t                    self._record_pid(cid, pid, parsed[pid])\n526\t                    touched.add(cid)\n527\t        else:\n528\t            for cid in ids:\n529\t                pid = pid_by_id[cid]\n530\t                q = sess.query(f\"01{pid}\", \"41\")\n531\t                data = next(iter(q[\"ecus\"].values()), None)\n532\t                if data and len(data) >= 2 and data[1] == pid:\n533\t                    self._record_pid(cid, pid, data[2:])\n534\t                    touched.add(cid)\n535\t        return touched\n536\t\n537\t    def _record_pid(self, cid: str, pid: str, raw: list[str]) -> None:\n538\t        spec = PIDS_BY_HEX.get(pid)\n539\t        decoded = decode_pid(pid, spec, raw)\n540\t        if \"value\" in decoded:\n541\t            self._publish(cid, decoded[\"value\"], decoded.get(\"unit\", \"\"))\n542\t\n543\t    def _poll_dids(self, sess: Session, due_ids: list[str]) -> set[str]:\n544\t        from .readall import FormulaError, eval_formula\n545\t        touched: set[str] = set()\n546\t        by_module: dict[str, list[str]] = {}\n547\t        for cid in due_ids:\n548\t            by_module.setdefault(self._channels[cid].module, []).append(cid)\n549\t        for module, cids in by_module.items():\n550\t            try:\n551\t                ecu = uds_mod.resolve_module(module)\n552\t            except BadCommand:\n553\t                continue\n554\t            sess.target(ecu)\n555\t            for cid in cids:\n556\t                ch = self._channels[cid]\n557\t                r = uds_mod.read_did(sess, ecu, ch.did, timeout=1.5)\n558\t                data = r.get(\"bytes\")\n559\t                if r.get(\"error\") or not data or not ch.formula:\n560\t                    continue\n561\t                try:\n562\t                    val = eval_formula(ch.formula, [int(b, 16) for b in data])\n563\t                except FormulaError:\n564\t                    continue\n565\t                if isinstance(val, dict):\n566\t                    val = val.get(ch.field)\n567\t                if val is None:\n568\t                    continue\n569\t                self._publish(cid, float(val), ch.unit)\n570\t                touched.add(cid)\n571\t        return touched\n572\t\n573\t    def _poll_battery(self, sess: Session, due_ids: list[str]) -> set[str]:\n574\t        raw = sess.cmd(\"ATRV\", 2)\n575\t        m = re.search(r\"(\\d+\\.\\d+)V\", raw)\n576\t        touched: set[str] = set()\n577\t        if m:\n578\t            v = float(m.group(1))\n579\t            for cid in due_ids:\n580\t                self._publish(cid, v, \"V\")\n581\t                touched.add(cid)\n582\t        return touched\n583\t\n584\t    def _poll_computed(self, due_ids: list[str]) -> set[str]:\n585\t        touched: set[str] = set()\n586\t        for cid in due_ids:\n587\t            ch = self._channels[cid]\n588\t            with self._lock:\n589\t                values = {dep: self._last_value.get(dep) for dep in ch.depends_on}\n590\t            if any(v is None for v in values.values()):\n591\t                continue\n592\t            try:\n593\t                val = eval_expr(ch.expr, values)\n594\t            except ComputedError:\n595\t                continue\n596\t            self._publish(cid, val, ch.unit)\n597\t            touched.add(cid)\n598\t        return touched\n599\t\n600\t    # --- \"Monitor DTCs\" (MES convention): Mode 03/07 between channel reads --\n601\t\n602\t    def _read_dtc_codes(self, sess: Session, mode: str, response_byte: str) -> Optional[set[str]]:\n603\t        \"\"\"Codes from one Mode 03/07 read, or None if the request did not complete.\n604\t\n605\t        Read-only OBD services only (Mode 03/07), same as everywhere else in\n606\t        this poller -- never Mode 04, never a write.\n607\t        \"\"\"\n608\t        q = sess.query(mode, response_byte)\n609\t        if q[\"error\"]:\n610\t            return None\n611\t        codes: set[str] = set()\n612\t        for data in q[\"ecus\"].values():\n613\t            codes.update(decode_obd_dtcs(data))\n614\t        return codes\n615\t\n616\t    def _poll_dtcs(self, sess: Session) -> None:\n617\t        self._switch_mode(sess, \"pid\")\n618\t        sess.untarget()\n619\t        stored = self._read_dtc_codes(sess, \"03\", \"43\")\n620\t        pending = self._read_dtc_codes(sess, \"07\", \"47\")\n621\t        if stored is None or pending is None:\n622\t            return   # adapter/bus error this cycle; try again next interval\n623\t        prev = self._dtc_state\n624\t        self._dtc_state = (stored, pending)\n625\t        now_iso = datetime.now().isoformat(timespec=\"seconds\")\n626\t        with self._lock:\n627\t            for code in stored | pending:\n628\t                self._dtc_first_seen.setdefault(code, now_iso)\n629\t        if prev is None:\n630\t            return   # first read only establishes the baseline, not a \"change\"\n631\t        prev_stored, prev_pending = prev\n632\t        added = (sorted(f\"{c} stored\" for c in stored - prev_stored) +\n633\t                sorted(f\"{c} pending\" for c in pending - prev_pending))\n634\t        removed = (sorted(f\"{c} stored\" for c in prev_stored - stored) +\n635\t                  sorted(f\"{c} pending\" for c in prev_pending - pending))\n636\t        if not added and not removed:\n637\t            return\n638\t        t = time.time()\n639\t        msg = {\"type\": \"dtc\", \"t\": t, \"added\": added, \"removed\": removed,\n640\t              \"stored\": sorted(stored), \"pending\": sorted(pending)}\n641\t        self._broadcast(msg)\n642\t        with self._lock:\n643\t            rec = self._recorder\n644\t        if rec is not None:\n645\t            # MES convention: one DTC transition per TAG entry, e.g. \"DTC+ P0456 pending\".\n646\t            for entry in added:\n647\t                rec.write_row(tag=f\"DTC+ {entry}\")\n648\t            for entry in removed:\n649\t                rec.write_row(tag=f\"DTC- {entry}\")\n650\t        store.record_observation(\n651\t            \"live_dtc_change\",\n652\t            {\"added\": added, \"removed\": removed, \"stored\": sorted(stored),\n653\t             \"pending\": sorted(pending)},\n654\t            stream=getattr(getattr(sess, \"stream\", None), \"describe\", \"\") or \"live_poller\")\n655\t\n656\t    # --- publish: ring buffer, alarms, subscribers, recorder --------------\n657\t\n658\t    def _publish(self, cid: str, value: Any, unit: str) -> None:\n659\t        t = time.time()\n660\t        alarm_level: Optional[str] = None\n661\t        spec = self._alarms.get(cid)\n662\t        if spec is not None and value is not None:\n663\t            current = self._alarm_level.get(cid, \"ok\")\n664\t            new_level = spec.level_for(float(value), current)\n665\t            if new_level != current:\n666\t                self._alarm_level[cid] = new_level\n667\t                if new_level != \"ok\":\n668\t                    self._record_alarm_event(cid, new_level, value)\n669\t            if new_level != \"ok\":\n670\t                alarm_level = new_level\n671\t        with self._lock:\n672\t            self._last_value[cid] = value\n673\t            self._last_unit[cid] = unit\n674\t            self._sample_counts[cid] = self._sample_counts.get(cid, 0) + 1\n675\t            ring = self._ring.get(cid)\n676\t            if ring is not None:\n677\t                ring.append((t, value))\n678\t            if self._recorder is not None:\n679\t                self._recorder.update(cid, value)\n680\t        msg: dict[str, Any] = {\"t\": t, \"channel\": cid, \"value\": value, \"unit\": unit}\n681\t        if alarm_level:\n682\t            msg[\"alarm\"] = alarm_level\n683\t        self._broadcast(msg)\n684\t\n685\t    def _record_alarm_event(self, cid: str, level: str, value: Any) -> None:\n686\t        # the session's real stream (e.g. \"serial COM3@115200\"), so a real\n687\t        # alarm counts as a read from the car and a fake-session one does not\n688\t        store.record_observation(\"live_alarm\", {\"channel\": cid, \"level\": level, \"value\": value},\n689\t                                 stream=getattr(self, \"_stream_desc\", \"\") or \"live_poller\")\n690\t        audit.record(\"live_alarm\", channel=cid, level=level, value=value)\n691\t\n692\t\n693\t_POLLER: Optional[LivePoller] = None\n694\t_POLLER_LOCK = threading.Lock()\n695\t\n696\t\n697\tdef poller() -> LivePoller:\n698\t    \"\"\"The process-wide live-data poller, created on first use.\"\"\"\n699\t    global _POLLER\n700\t    with _POLLER_LOCK:\n701\t        if _POLLER is None:\n702\t            _POLLER = LivePoller()\n703\t        return _POLLER\n704\t\n705\t\n706\tdef set_poller(new: LivePoller) -> None:\n707\t    \"\"\"Replace the process-wide poller (tests only).\"\"\"\n708\t    global _POLLER\n709\t    with _POLLER_LOCK:\n710\t        _POLLER = new\n711\t\n712\t\n713\t__all__ = [\"Channel\", \"AlarmSpec\", \"CsvRecorder\", \"LivePoller\", \"poller\", \"set_poller\"]\n714\t"}]},"uuid":"cb6ea124-73ee-46c7-8060-943b537ff07d","timestamp":"2026-10-14T11:06:54.792Z","toolUseResult":{"type":"text","file":{"filePath":"C:\\Users\\User\\mcp-servers\\cuore\\live\\poller.py","content":"\"\"\"The live-data poller: one background thread, one adapter session, many channels.\n\n:class:`LivePoller` owns exactly one :class:`~cuore.live.transport.Session`\nfor the whole run -- opened once in :meth:`LivePoller.start`'s worker thread\nand held until :meth:`LivePoller.stop`. It round-robins the requested\nchannels at their configured rate, batching Mode 01 PIDs (up to 6 per\nrequest) and grouping UDS DID reads per module, publishes every sample to\nsubscribers (the SSE route), keeps a per-channel ring buffer, evaluates\nalarm thresholds with hysteresis, and can mirror the session to an MES-format\nCSV recording.\n\nOnly read services (Mode 01, UDS 0x22, ``ATRV``) are ever sent -- nothing\nhere writes to the vehicle. A session refuses to start while MultiEcuScan is\nconnected (the ordinary interlock in :meth:`AdapterLink.session`); other live\noperations refuse while a poll session is active (see the guard appended to\n``ops.py``).\n\"\"\"\n\nfrom __future__ import annotations\n\nimport queue\nimport re\nimport threading\nimport time\nfrom collections import deque\nfrom dataclasses import dataclass\nfrom datetime import datetime\nfrom pathlib import Path\nfrom typing import Any, Optional\n\nfrom . import audit, store\nfrom . import uds as uds_mod\nfrom .buses import CAN_C, header_bits_for_protocol, route_for\nfrom .channels import Channel, ComputedError, eval_expr\nfrom .config import state_dir\nfrom .errors import BadCommand, LinkUnavailable, Refused\nfrom .obd import PIDS_BY_HEX, decode_obd_dtcs, decode_pid\nfrom .transport import Session, link\n\nMIN_TICK = 0.02\nDEFAULT_RING_MINUTES = 5.0\n_MAX_MULTI_PID = 6\n#: \"Monitor DTCs\" (MES convention): read Mode 03/07 between channel reads,\n#: no faster than this, so it never competes meaningfully with fast channels.\nMIN_DTC_INTERVAL_S = 5.0\nDEFAULT_DTC_INTERVAL_S = 10.0\n\n\ndef _parse_multi_pid(data: list[str], pids: list[str]) -> dict[str, list[str]]:\n    \"\"\"Split a ``41 <pid> <data> 41 <pid> <data> ...`` payload by the PIDs asked.\n\n    A multi-PID Mode 01 reply repeats the ``41`` response byte before each\n    PID's own group. Stops at the first group that does not match the next\n    PID asked -- the ECU answered fewer than requested, which is how a\n    caller learns multi-PID does not fully work here and should fall back\n    to single requests.\n    \"\"\"\n    out: dict[str, list[str]] = {}\n    i = 0\n    for pid in pids:\n        if i + 1 >= len(data) or data[i] != \"41\" or data[i + 1] != pid:\n            break\n        spec = PIDS_BY_HEX.get(pid)\n        n = spec.n_bytes if spec else 1\n        if i + 2 + n > len(data):\n            break\n        out[pid] = data[i + 2:i + 2 + n]\n        i += 2 + n\n    return out\n\n\n# ===========================================================================\n# alarms\n# ===========================================================================\n\n@dataclass\nclass AlarmSpec:\n    channel_id: str\n    warn: Optional[float] = None\n    alarm: Optional[float] = None\n    direction: str = \"above\"       # \"above\" | \"below\"\n    hysteresis: float = 0.0\n\n    def level_for(self, value: float, current: str) -> str:\n        \"\"\"The alarm level ``value`` implies, given the level it is already at.\n\n        Crossing INTO a stricter level uses the raw threshold; leaving one\n        requires clearing it by ``hysteresis`` first, so a value dithering\n        right at the line does not re-fire on every sample.\n        \"\"\"\n        sign = 1.0 if self.direction == \"above\" else -1.0\n        v = sign * value\n        alarm = None if self.alarm is None else sign * self.alarm\n        warn = None if self.warn is None else sign * self.warn\n        h = abs(self.hysteresis)\n\n        def is_alarm() -> bool:\n            if alarm is None:\n                return False\n            if v >= alarm:\n                return True\n            return current == \"alarm\" and v >= alarm - h\n\n        def is_warn() -> bool:\n            if warn is None:\n                return False\n            if v >= warn:\n                return True\n            return current in (\"warn\", \"alarm\") and v >= warn - h\n\n        if is_alarm():\n            return \"alarm\"\n        if is_warn():\n            return \"warn\"\n        return \"ok\"\n\n    def to_dict(self) -> dict[str, Any]:\n        return {\"channel\": self.channel_id, \"warn\": self.warn, \"alarm\": self.alarm,\n                \"direction\": self.direction, \"hysteresis\": self.hysteresis}\n\n\n# ===========================================================================\n# CSV recording, in the MES graph-CSV shape mes.csvlog parses\n# ===========================================================================\n\nclass CsvRecorder:\n    \"\"\"Mirrors a live session to a CSV in the shape ``mes.csvlog.load_csv`` reads:\n    ``Time`` first, ``TAG`` last, row 1 names, row 2 units, tab-separated.\"\"\"\n\n    def __init__(self, path: Path, channels: list[Channel]) -> None:\n        self.path = path\n        self.channels = channels\n        self._fh = None\n        self._last: dict[str, Any] = {}\n        self._start: Optional[float] = None\n        self._rows = 0\n\n    def start(self) -> None:\n        self.path.parent.mkdir(parents=True, exist_ok=True)\n        self._fh = self.path.open(\"w\", encoding=\"utf-8\", newline=\"\")\n        names = [\"Time\"] + [c.name for c in self.channels] + [\"TAG\"]\n        units = [\"sec\"] + [c.unit for c in self.channels] + [\" \"]\n        self._fh.write(\"\\t\".join(f'\"{n}\"' for n in names) + \"\\n\")\n        self._fh.write(\"\\t\".join(f'\"{u}\"' for u in units) + \"\\n\")\n        self._fh.flush()\n        self._start = time.monotonic()\n\n    def update(self, channel_id: str, value: Any) -> None:\n        self._last[channel_id] = value\n\n    def write_row(self, tag: str = \"\") -> None:\n        if self._fh is None or self._start is None:\n            return\n        t = time.monotonic() - self._start\n        cells = [f\"{t:.3f}\"]\n        for c in self.channels:\n            v = self._last.get(c.id)\n            if v is None:\n                cells.append(\"\")\n            elif isinstance(v, float):\n                cells.append(f\"{v:.4f}\")\n            else:\n                cells.append(str(v))\n        cells.append(f'\"{tag}\"' if tag else '\"\"')\n        self._fh.write(\"\\t\".join(cells) + \"\\n\")\n        self._fh.flush()\n        self._rows += 1\n\n    def stop(self) -> None:\n        if self._fh is not None:\n            try:\n                self._fh.close()\n            finally:\n                self._fh = None\n\n\n# ===========================================================================\n# the poller\n# ===========================================================================\n\nclass LivePoller:\n    \"\"\"One process-wide live-data session. Create one; use :func:`poller`.\"\"\"\n\n    def __init__(self) -> None:\n        self._lock = threading.RLock()\n        self._thread: Optional[threading.Thread] = None\n        self._stop_event = threading.Event()\n        self._channels: dict[str, Channel] = {}\n        self._rates: dict[str, float] = {}\n        self._ring_minutes = DEFAULT_RING_MINUTES\n        self._ring: dict[str, deque] = {}\n        self._last_value: dict[str, Any] = {}\n        self._last_unit: dict[str, str] = {}\n        self._sample_counts: dict[str, int] = {}\n        self._subscribers: list[queue.Queue] = []\n        self._alarms: dict[str, AlarmSpec] = {}\n        self._alarm_level: dict[str, str] = {}\n        self._started_at: Optional[float] = None\n        self._error: Optional[str] = None\n        self._recorder: Optional[CsvRecorder] = None\n        self._pid_multi_ok = True\n        self._opens = 0\n        self._mode = \"did\"\n        self._pid_route = None\n        self._did_route = None\n        self._holding = False\n        self._monitor_dtcs = False\n        self._dtc_interval = DEFAULT_DTC_INTERVAL_S\n        #: (stored_codes, pending_codes) as of the last successful poll, or\n        #: None before the first one -- the first read only establishes a\n        #: baseline, it never reports a \"change\" for codes already present.\n        self._dtc_state: Optional[tuple[set[str], set[str]]] = None\n        #: code -> iso timestamp this poller session first saw it (stored or\n        #: pending) -- read by :meth:`dtc_snapshot`, never by ``_run`` itself.\n        self._dtc_first_seen: dict[str, str] = {}\n\n    # --- lifecycle -----------------------------------------------------\n\n    def is_active(self) -> bool:\n        with self._lock:\n            return self._thread is not None and self._thread.is_alive()\n\n    def holds_adapter(self) -> bool:\n        \"\"\"True only once the session is actually open and polling.\n\n        Distinct from :meth:`is_active` (thread spawned) so the poller's own\n        startup -- which opens its session through the ordinary\n        :meth:`AdapterLink.session` path and may auto-verify the bus via\n        ``ops.verify_bus`` -- is never refused by its own guard.\n        \"\"\"\n        with self._lock:\n            return self._holding\n\n    def start(self, channels: list[Channel], rates: Optional[dict[str, float]] = None,\n             monitor_dtcs: bool = False, dtc_interval_s: float = DEFAULT_DTC_INTERVAL_S\n             ) -> dict[str, Any]:\n        with self._lock:\n            if self.is_active():\n                raise Refused(\"a live-data poll session is already running; stop it first\")\n            if not channels:\n                raise BadCommand(\"no channels to poll\")\n            for c in channels:\n                if c.bus != \"can_c\" and c.kind != \"computed\":\n                    raise BadCommand(f\"channel {c.id!r} is on bus {c.bus!r}; the live-data \"\n                                     f\"poller currently serves can_c channels only\")\n            self._channels = {c.id: c for c in channels}\n            self._rates = {c.id: max(0.05, float((rates or {}).get(c.id, c.default_rate_hz)))\n                          for c in channels}\n            self._ring = {c.id: deque(maxlen=self._ring_len(self._rates[c.id])) for c in channels}\n            self._last_value = {}\n            self._last_unit = {}\n            self._sample_counts = {c.id: 0 for c in channels}\n            self._alarm_level = {}\n            self._error = None\n            self._pid_multi_ok = True\n            self._started_at = None\n            self._mode = \"did\"\n            self._monitor_dtcs = bool(monitor_dtcs)\n            self._dtc_interval = max(MIN_DTC_INTERVAL_S, float(dtc_interval_s))\n            self._dtc_state = None\n            self._dtc_first_seen = {}\n            self._stop_event.clear()\n            self._thread = threading.Thread(target=self._run, name=\"cuore-live-poller\",\n                                            daemon=True)\n            self._thread.start()\n        # Give the worker a moment to open the session so a refusal (MES\n        # connected, no port, adapter fault) surfaces to this call rather\n        # than only showing up later in status().\n        deadline = time.monotonic() + 3.0\n        while time.monotonic() < deadline:\n            with self._lock:\n                if self._started_at is not None or self._error is not None:\n                    break\n                if self._thread is None or not self._thread.is_alive():\n                    break\n            time.sleep(0.02)\n        with self._lock:\n            if self._error is not None:\n                err, self._thread = self._error, None\n                raise LinkUnavailable(err)\n            return self._status_locked()\n\n    def stop(self) -> dict[str, Any]:\n        with self._lock:\n            if not self.is_active():\n                return {\"stopped\": False, \"note\": \"no live-data session running\"}\n            self._stop_event.set()\n            t = self._thread\n        if t is not None:\n            t.join(timeout=10)\n        with self._lock:\n            self._thread = None\n            self._holding = False\n            recorder, self._recorder = self._recorder, None\n        if recorder is not None:\n            recorder.stop()\n        return {\"stopped\": True}\n\n    def _ring_len(self, rate_hz: float) -> int:\n        return max(60, int(rate_hz * 60 * self._ring_minutes))\n\n    # --- status ----------------------------------------------------------\n\n    def status(self) -> dict[str, Any]:\n        with self._lock:\n            return self._status_locked()\n\n    def _status_locked(self) -> dict[str, Any]:\n        active = self._thread is not None and self._thread.is_alive()\n        elapsed = (time.monotonic() - self._started_at) if (self._started_at and active) else None\n        achieved = {}\n        if elapsed and elapsed > 0:\n            achieved = {cid: round(n / elapsed, 3) for cid, n in self._sample_counts.items()}\n        return {\n            \"active\": active,\n            \"channels\": [c.to_dict() for c in self._channels.values()],\n            \"rates_hz\": dict(self._rates),\n            \"achieved_hz\": achieved,\n            \"elapsed_s\": round(elapsed, 1) if elapsed else None,\n            \"recording\": str(self._recorder.path) if self._recorder else None,\n            \"error\": self._error,\n            \"multi_pid_supported\": self._pid_multi_ok,\n            \"alarms\": {cid: a.to_dict() for cid, a in self._alarms.items()},\n            \"monitor_dtcs\": self._monitor_dtcs,\n            \"dtc_interval_s\": self._dtc_interval,\n        }\n\n    def snapshot(self) -> dict[str, Any]:\n        with self._lock:\n            channels = {\n                cid: {\"value\": self._last_value.get(cid), \"unit\": self._last_unit.get(cid, \"\"),\n                     \"alarm\": self._alarm_level.get(cid, \"ok\")}\n                for cid in self._channels\n            }\n            return {\"active\": self.is_active(), \"channels\": channels}\n\n    def dtc_snapshot(self) -> dict[str, Any]:\n        \"\"\"Read-only view of \"Monitor DTCs\" state for a caller that wants to\n        know about a code this session has seen without re-deriving the\n        Mode 03/07 diff itself (see :mod:`cuore.services.systems_map_bridge`'s\n        live-overlay ``new_codes``): ``{\"codes\": [...], \"first_seen\": {code:\n        iso timestamp}}``. Empty before the first Monitor-DTCs cycle, or when\n        ``monitor_dtcs`` was never requested for this session.\n        \"\"\"\n        with self._lock:\n            if self._dtc_state is None:\n                return {\"codes\": [], \"first_seen\": {}}\n            stored, pending = self._dtc_state\n            return {\"codes\": sorted(stored | pending), \"first_seen\": dict(self._dtc_first_seen)}\n\n    # --- alarms ------------------------------------------------------------\n\n    def set_alarm(self, channel_id: str, warn: Optional[float] = None,\n                 alarm: Optional[float] = None, direction: str = \"above\",\n                 hysteresis: float = 0.0) -> dict[str, Any]:\n        if direction not in (\"above\", \"below\"):\n            raise BadCommand(\"direction must be 'above' or 'below'\")\n        with self._lock:\n            spec = AlarmSpec(channel_id, warn, alarm, direction, hysteresis)\n            self._alarms[channel_id] = spec\n            self._alarm_level.pop(channel_id, None)\n            return spec.to_dict()\n\n    def clear_alarm(self, channel_id: str) -> dict[str, Any]:\n        with self._lock:\n            self._alarms.pop(channel_id, None)\n            self._alarm_level.pop(channel_id, None)\n            return {\"channel\": channel_id, \"cleared\": True}\n\n    # --- subscribers (SSE) -------------------------------------------------\n\n    def subscribe(self) -> \"queue.Queue[dict[str, Any]]\":\n        q: \"queue.Queue[dict[str, Any]]\" = queue.Queue(maxsize=2000)\n        with self._lock:\n            self._subscribers.append(q)\n        return q\n\n    def unsubscribe(self, q: \"queue.Queue[dict[str, Any]]\") -> None:\n        with self._lock:\n            if q in self._subscribers:\n                self._subscribers.remove(q)\n\n    def _broadcast(self, msg: dict[str, Any]) -> None:\n        with self._lock:\n            subs = list(self._subscribers)\n        for q in subs:\n            try:\n                q.put_nowait(msg)\n            except queue.Full:\n                pass\n\n    # --- recording -----------------------------------------------------\n\n    def start_recording(self) -> dict[str, Any]:\n        with self._lock:\n            if not self.is_active():\n                raise Refused(\"no live-data session running; start one first\")\n            if self._recorder is not None:\n                return {\"recording\": str(self._recorder.path), \"already_recording\": True}\n            d = state_dir() / \"recordings\"\n            path = d / f\"live_{datetime.now().strftime('%Y%m%d-%H%M%S')}.csv\"\n            rec = CsvRecorder(path, list(self._channels.values()))\n            rec.start()\n            self._recorder = rec\n            return {\"recording\": str(path)}\n\n    def stop_recording(self) -> dict[str, Any]:\n        with self._lock:\n            rec, self._recorder = self._recorder, None\n        if rec is None:\n            return {\"stopped\": False, \"note\": \"not recording\"}\n        rec.stop()\n        return {\"stopped\": True, \"path\": str(rec.path), \"rows\": rec._rows}\n\n    # --- the worker thread -----------------------------------------------\n\n    def _run(self) -> None:\n        from . import ops as ops_mod  # local: ops imports poller lazily; avoid a cycle at import time\n        lk = link()\n        try:\n            did_route = route_for(CAN_C, lk.cable)\n            pid_route = ops_mod._obd_route()\n            if pid_route is None:\n                raise LinkUnavailable(\"no 11-bit legislated route on can_c for cable \"\n                                      f\"{lk.cable!r}; Mode 01 PIDs need it\")\n            self._pid_route, self._did_route = pid_route, did_route\n            with lk.session(\"live_session\", bus=CAN_C) as sess:\n                self._stream_desc = getattr(getattr(sess, \"stream\", None), \"describe\", \"\") or \"\"\n                self._opens += 1\n                self._mode = \"did\"\n                with self._lock:\n                    self._started_at = time.monotonic()\n                    self._holding = True\n                try:\n                    next_due = {cid: 0.0 for cid in self._channels}\n                    next_dtc_due = 0.0\n                    while not self._stop_event.is_set():\n                        now = time.monotonic()\n                        due = [cid for cid, t in next_due.items() if t <= now]\n                        dtc_due = self._monitor_dtcs and next_dtc_due <= now\n                        if not due and not dtc_due:\n                            time.sleep(MIN_TICK)\n                            continue\n                        pid_due = [c for c in due if self._channels[c].kind == \"pid\"]\n                        did_due = [c for c in due if self._channels[c].kind == \"did\"]\n                        batt_due = [c for c in due if self._channels[c].kind == \"battery\"]\n                        comp_due = [c for c in due if self._channels[c].kind == \"computed\"]\n                        touched: set[str] = set()\n                        if pid_due:\n                            self._switch_mode(sess, \"pid\")\n                            touched |= self._poll_pids(sess, pid_due)\n                        if did_due:\n                            self._switch_mode(sess, \"did\")\n                            touched |= self._poll_dids(sess, did_due)\n                        if batt_due:\n                            touched |= self._poll_battery(sess, batt_due)\n                        if comp_due:\n                            touched |= self._poll_computed(comp_due)\n                        # DTC monitoring runs only on its own (much slower) schedule,\n                        # after this tick's channel reads -- so it never displaces a\n                        # fast channel's due sample, only ever adds a bounded, rare\n                        # extra pair of requests once every dtc_interval seconds.\n                        if dtc_due:\n                            self._poll_dtcs(sess)\n                            next_dtc_due = time.monotonic() + self._dtc_interval\n                        later = time.monotonic()\n                        for cid in due:\n                            next_due[cid] = later + 1.0 / self._rates.get(cid, 1.0)\n                        if touched:\n                            with self._lock:\n                                rec = self._recorder\n                            if rec is not None:\n                                rec.write_row()\n                        time.sleep(MIN_TICK)\n                finally:\n                    with self._lock:\n                        self._holding = False\n        except Exception as e:  # noqa: BLE001 -- reported through status()/start()'s wait\n            with self._lock:\n                self._error = str(e)\n                self._holding = False\n\n    def _switch_mode(self, sess: Session, want: str) -> None:\n        if self._mode == want:\n            return\n        route = self._pid_route if want == \"pid\" else self._did_route\n        if route is None:\n            raise LinkUnavailable(f\"no route available for {want} mode\")\n        if not sess.link.is_stn:\n            raise LinkUnavailable(\"live-data polling of both PIDs and DIDs needs an STN adapter\")\n        if sess.route.stn_protocol != route.stn_protocol:\n            sess.cmd(f\"STP {route.stn_protocol}\", 2)\n            if route.bitrate_override:\n                sess.cmd(f\"STPBR {route.bitrate_override}\", 2)\n            sess.route = route\n            sess.header_bits = header_bits_for_protocol(route.stn_protocol)\n            sess._target = None\n        if want == \"pid\":\n            sess.untarget()\n        self._mode = want\n\n    # --- per-kind polling ---------------------------------------------------\n\n    def _poll_pids(self, sess: Session, due_ids: list[str]) -> set[str]:\n        sess.untarget()\n        # The up-to-6 cap only matters for a multi-PID batch; once multi-PID\n        # is known unsupported every due channel is polled individually this\n        # same tick, not just the first (each is its own request either way).\n        ids = due_ids[:_MAX_MULTI_PID] if self._pid_multi_ok else due_ids\n        pid_by_id: dict[str, str] = {cid: self._channels[cid].pid for cid in ids}\n        pids = list(dict.fromkeys(pid_by_id.values()))\n        touched: set[str] = set()\n        if self._pid_multi_ok and len(pids) > 1:\n            q = sess.query(\"01\" + \"\".join(pids), \"41\")\n            data = next(iter(q[\"ecus\"].values()), None)\n            if q[\"error\"] or not data:\n                self._pid_multi_ok = False\n                return touched\n            parsed = _parse_multi_pid(data, pids)\n            if len(parsed) < len(pids):\n                self._pid_multi_ok = False\n            for cid in ids:\n                pid = pid_by_id[cid]\n                if pid in parsed:\n                    self._record_pid(cid, pid, parsed[pid])\n                    touched.add(cid)\n        else:\n            for cid in ids:\n                pid = pid_by_id[cid]\n                q = sess.query(f\"01{pid}\", \"41\")\n                data = next(iter(q[\"ecus\"].values()), None)\n                if data and len(data) >= 2 and data[1] == pid:\n                    self._record_pid(cid, pid, data[2:])\n                    touched.add(cid)\n        return touched\n\n    def _record_pid(self, cid: str, pid: str, raw: list[str]) -> None:\n        spec = PIDS_BY_HEX.get(pid)\n        decoded = decode_pid(pid, spec, raw)\n        if \"value\" in decoded:\n            self._publish(cid, decoded[\"value\"], decoded.get(\"unit\", \"\"))\n\n    def _poll_dids(self, sess: Session, due_ids: list[str]) -> set[str]:\n        from .readall import FormulaError, eval_formula\n        touched: set[str] = set()\n        by_module: dict[str, list[str]] = {}\n        for cid in due_ids:\n            by_module.setdefault(self._channels[cid].module, []).append(cid)\n        for module, cids in by_module.items():\n            try:\n                ecu = uds_mod.resolve_module(module)\n            except BadCommand:\n                continue\n            sess.target(ecu)\n            for cid in cids:\n                ch = self._channels[cid]\n                r = uds_mod.read_did(sess, ecu, ch.did, timeout=1.5)\n                data = r.get(\"bytes\")\n                if r.get(\"error\") or not data or not ch.formula:\n                    continue\n                try:\n                    val = eval_formula(ch.formula, [int(b, 16) for b in data])\n                except FormulaError:\n                    continue\n                if isinstance(val, dict):\n                    val = val.get(ch.field)\n                if val is None:\n                    continue\n                self._publish(cid, float(val), ch.unit)\n                touched.add(cid)\n        return touched\n\n    def _poll_battery(self, sess: Session, due_ids: list[str]) -> set[str]:\n        raw = sess.cmd(\"ATRV\", 2)\n        m = re.search(r\"(\\d+\\.\\d+)V\", raw)\n        touched: set[str] = set()\n        if m:\n            v = float(m.group(1))\n            for cid in due_ids:\n                self._publish(cid, v, \"V\")\n                touched.add(cid)\n        return touched\n\n    def _poll_computed(self, due_ids: list[str]) -> set[str]:\n        touched: set[str] = set()\n        for cid in due_ids:\n            ch = self._channels[cid]\n            with self._lock:\n                values = {dep: self._last_value.get(dep) for dep in ch.depends_on}\n            if any(v is None for v in values.values()):\n                continue\n            try:\n                val = eval_expr(ch.expr, values)\n            except ComputedError:\n                continue\n            self._publish(cid, val, ch.unit)\n            touched.add(cid)\n        return touched\n\n    # --- \"Monitor DTCs\" (MES convention): Mode 03/07 between channel reads --\n\n    def _read_dtc_codes(self, sess: Session, mode: str, response_byte: str) -> Optional[set[str]]:\n        \"\"\"Codes from one Mode 03/07 read, or None if the request did not complete.\n\n        Read-only OBD services only (Mode 03/07), same as everywhere else in\n        this poller -- never Mode 04, never a write.\n        \"\"\"\n        q = sess.query(mode, response_byte)\n        if q[\"error\"]:\n            return None\n        codes: set[str] = set()\n        for data in q[\"ecus\"].values():\n            codes.update(decode_obd_dtcs(data))\n        return codes\n\n    def _poll_dtcs(self, sess: Session) -> None:\n        self._switch_mode(sess, \"pid\")\n        sess.untarget()\n        stored = self._read_dtc_codes(sess, \"03\", \"43\")\n        pending = self._read_dtc_codes(sess, \"07\", \"47\")\n        if stored is None or pending is None:\n            return   # adapter/bus error this cycle; try again next interval\n        prev = self._dtc_state\n        self._dtc_state = (stored, pending)\n        now_iso = datetime.now().isoformat(timespec=\"seconds\")\n        with self._lock:\n            for code in stored | pending:\n                self._dtc_first_seen.setdefault(code, now_iso)\n        if prev is None:\n            return   # first read only establishes the baseline, not a \"change\"\n        prev_stored, prev_pending = prev\n        added = (sorted(f\"{c} stored\" for c in stored - prev_stored) +\n                sorted(f\"{c} pending\" for c in pending - prev_pending))\n        removed = (sorted(f\"{c} stored\" for c in prev_stored - stored) +\n                  sorted(f\"{c} pending\" for c in prev_pending - pending))\n        if not added and not removed:\n            return\n        t = time.time()\n        msg = {\"type\": \"dtc\", \"t\": t, \"added\": added, \"removed\": removed,\n              \"stored\": sorted(stored), \"pending\": sorted(pending)}\n        self._broadcast(msg)\n        with self._lock:\n            rec = self._recorder\n        if rec is not None:\n            # MES convention: one DTC transition per TAG entry, e.g. \"DTC+ P0456 pending\".\n            for entry in added:\n                rec.write_row(tag=f\"DTC+ {entry}\")\n            for entry in removed:\n                rec.write_row(tag=f\"DTC- {entry}\")\n        store.record_observation(\n            \"live_dtc_change\",\n            {\"added\": added, \"removed\": removed, \"stored\": sorted(stored),\n             \"pending\": sorted(pending)},\n            stream=getattr(getattr(sess, \"stream\", None), \"describe\", \"\") or \"live_poller\")\n\n    # --- publish: ring buffer, alarms, subscribers, recorder --------------\n\n    def _publish(self, cid: str, value: Any, unit: str) -> None:\n        t = time.time()\n        alarm_level: Optional[str] = None\n        spec = self._alarms.get(cid)\n        if spec is not None and value is not None:\n            current = self._alarm_level.get(cid, \"ok\")\n            new_level = spec.level_for(float(value), current)\n            if new_level != current:\n                self._alarm_level[cid] = new_level\n                if new_level != \"ok\":\n                    self._record_alarm_event(cid, new_level, value)\n            if new_level != \"ok\":\n                alarm_level = new_level\n        with self._lock:\n            self._last_value[cid] = value\n            self._last_unit[cid] = unit\n            self._sample_counts[cid] = self._sample_counts.get(cid, 0) + 1\n            ring = self._ring.get(cid)\n            if ring is not None:\n                ring.append((t, value))\n            if self._recorder is not None:\n                self._recorder.update(cid, value)\n        msg: dict[str, Any] = {\"t\": t, \"channel\": cid, \"value\": value, \"unit\": unit}\n        if alarm_level:\n            msg[\"alarm\"] = alarm_level\n        self._broadcast(msg)\n\n    def _record_alarm_event(self, cid: str, level: str, value: Any) -> None:\n        # the session's real stream (e.g. \"serial COM3@115200\"), so a real\n        # alarm counts as a read from the car and a fake-session one does not\n        store.record_observation(\"live_alarm\", {\"channel\": cid, \"level\": level, \"value\": value},\n                                 stream=getattr(self, \"_stream_desc\", \"\") or \"live_poller\")\n        audit.record(\"live_alarm\", channel=cid, level=level, value=value)\n\n\n_POLLER: Optional[LivePoller] = None\n_POLLER_LOCK = threading.Lock()\n\n\ndef poller() -> LivePoller:\n    \"\"\"The process-wide live-data poller, created on first use.\"\"\"\n    global _POLLER\n    with _POLLER_LOCK:\n        if _POLLER is None:\n            _POLLER = LivePoller()\n        return _POLLER\n\n\ndef set_poller(new: LivePoller) -> None:\n    \"\"\"Replace the process-wide poller (tests only).\"\"\"\n    global _POLLER\n    with _POLLER_LOCK:\n        _POLLER = new\n\n\n__all__ = [\"Channel\", \"AlarmSpec\", \"CsvRecorder\", \"LivePoller\", \"poller\", \"set_poller\"]\n","numLines":714,"startLine":1,"totalLines":714}},"sourceToolAssistantUUID":"b74eaa1b-b37f-4175-a39a-b98858a41094","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
{"parentUuid":"cb6ea124-73ee-46c7-8060-943b537ff07d","isSidechain":true,"agentId":"a1bf9e23bdb17aa09","message":{"model":"claude-sonnet-5","id":"msg_011Cg22FPB6X1mdYTZwfBiqq","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01UeJr8aHAR2VFDZLyRNkCff","name":"Read","input":{"file_path":"C:\\Users\\User\\mcp-servers\\cuore\\live\\uds.py"},"caller":{"type":"direct"}}],"container":null,"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":7136,"cache_read_input_tokens":57962,"output_tokens":377,"output_tokens_details":{"thinking_tokens":97},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":0,"ephemeral_5m_input_tokens":7136},"inference_geo":"global","iterations":[{"input_tokens":2,"output_tokens":377,"cache_read_input_tokens":57962,"cache_creation_input_tokens":7136,"cache_creation":{"ephemeral_5m_input_tokens":7136,"ephemeral_1h_input_tokens":0},"type":"message"}],"speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_01UeJr8aHAR2VFDZLyRNkCff":{"file_path":"C:\\Users\\User\\mcp-servers\\cuore\\live\\uds.py"}},"serverClassifierRequest":"4b01465f-a042-457a-850c-b02e8aab69de","apiBlockIndex":4,"requestId":"req_011Cg22FNwiaGTDYvRy8gNN7","attributionAgent":"general-purpose","type":"assistant","uuid":"b890909c-9033-4e16-997a-f7e62c3240e0","timestamp":"2026-10-14T11:06:54.899Z","effort":"high","perTurnEffort":null,"userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
{"parentUuid":"b890909c-9033-4e16-997a-f7e62c3240e0","isSidechain":true,"promptId":"d6e397a4-8ef0-4e3f-aa12-0e1ab89aceab","agentId":"a1bf9e23bdb17aa09","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01UeJr8aHAR2VFDZLyRNkCff","type":"tool_result","content":"1\t\"\"\"Read-only UDS over a :class:`Session`: identity, DTCs, DIDs, discovery.\n2\t\n3\tEverything here goes through :func:`request`, which refuses any service not on\n4\tthe read-only allowlist before a byte leaves the adapter. DTCs come back in\n5\tthe MES vocabulary (``P0456-00``) so live codes join the corpus.\n6\t\"\"\"\n7\t\n8\tfrom __future__ import annotations\n9\t\n10\timport time\n11\tfrom typing import Any, Optional\n12\t\n13\tfrom . import audit, store\n14\tfrom . import identify\n15\tfrom .identify import IDENTITY_DIDS\n16\tfrom .addressing import ANNEX_C, DIDS, ECUAddress, Confidence, address_pair, by_code, on_bus, sweep_candidates\n17\tfrom .buses import Bus\n18\tfrom .obd import decode_uds_dtc_block\n19\tfrom .safety import assert_read_only_uds\n20\tfrom .transport import DEFAULT_TIMEOUT, Session\n21\t\n22\tNRC_TEXT: dict[int, str] = {\n23\t    0x10: \"generalReject\", 0x11: \"serviceNotSupported\", 0x12: \"subFunctionNotSupported\",\n24\t    0x13: \"incorrectMessageLengthOrInvalidFormat\", 0x14: \"responseTooLong\",\n25\t    0x21: \"busyRepeatRequest\", 0x22: \"conditionsNotCorrect\", 0x24: \"requestSequenceError\",\n26\t    0x31: \"requestOutOfRange\", 0x33: \"securityAccessDenied\", 0x35: \"invalidKey\",\n27\t    0x36: \"exceedNumberOfAttempts\", 0x37: \"requiredTimeDelayNotExpired\",\n28\t    0x78: \"requestCorrectlyReceived-ResponsePending\", 0x7E: \"subFunctionNotSupportedInActiveSession\",\n29\t    0x7F: \"serviceNotSupportedInActiveSession\",\n30\t}\n31\t\n32\t\n33\tdef nrc_text(code: int) -> str:\n34\t    return NRC_TEXT.get(code, f\"NRC 0x{code:02X}\")\n35\t\n36\t\n37\tdef request(sess: Session, ecu: ECUAddress, service: int, payload: bytes = b\"\",\n38\t            timeout: float = DEFAULT_TIMEOUT) -> dict[str, Any]:\n39\t    assert_read_only_uds(service, payload)\n40\t    r = sess.uds(ecu, service, payload, timeout)\n41\t    r[\"nrc_text\"] = {h: nrc_text(c) for h, c in r[\"nrc\"].items()}\n42\t    return r\n43\t\n44\t\n45\tdef _first_positive(r: dict[str, Any]) -> Optional[list[str]]:\n46\t    return next(iter(r[\"positive\"].values()), None)\n47\t\n48\t\n49\tdef read_did(sess: Session, ecu: ECUAddress, did: int, timeout: float = DEFAULT_TIMEOUT\n50\t             ) -> dict[str, Any]:\n51\t    r = request(sess, ecu, 0x22, did.to_bytes(2, \"big\"), timeout)\n52\t    out: dict[str, Any] = {\"ecu\": ecu.code, \"bus\": sess.bus.key, \"did\": f\"{did:04X}\",\n53\t                           \"name\": ANNEX_C.get(did), \"error\": r[\"error\"], \"nrc\": r[\"nrc_text\"] or None}\n54\t    spec = next((d for d in DIDS if d.module == ecu.code and d.did == did), None)\n55\t    if spec:\n56\t        out[\"name\"] = spec.name\n57\t        out[\"formula\"] = spec.formula\n58\t        out[\"unit\"] = spec.unit\n59\t        out[\"confidence\"] = spec.confidence\n60\t    data = _first_positive(r)\n61\t    if data and len(data) >= 3 and data[1] + data[2] == f\"{did:04X}\":\n62\t        payload = data[3:]\n63\t        out[\"bytes\"] = payload\n64\t        if did == 0xF190 or all(32 <= int(b, 16) < 127 for b in payload) and len(payload) >= 4:\n65\t            out[\"ascii\"] = \"\".join(chr(int(b, 16)) for b in payload if 32 <= int(b, 16) < 127)\n66\t    elif not r[\"error\"] and not r[\"nrc\"]:\n67\t        out[\"warning\"] = \"no answer\"\n68\t    return out\n69\t\n70\t\n71\tdef identity(sess: Session, ecu: ECUAddress) -> dict[str, Any]:\n72\t    \"\"\"The Annex C identity set every module should answer.\"\"\"\n73\t    out: dict[str, Any] = {\"ecu\": ecu.code, \"bus\": sess.bus.key, \"fields\": {}}\n74\t    for did in (0xF190, 0xF187, 0xF188, 0xF189, 0xF18C, 0xF191, 0xF192, 0xF194, 0xF195):\n75\t        r = read_did(sess, ecu, did, 2.5)\n76\t        if r.get(\"error\"):\n77\t            out[\"error\"] = r[\"error\"]\n78\t            break\n79\t        out[\"fields\"][f\"{did:04X}\"] = {\"name\": ANNEX_C.get(did), \"ascii\": r.get(\"ascii\"),\n80\t                                       \"bytes\": r.get(\"bytes\"), \"nrc\": r.get(\"nrc\")}\n81\t    return out\n82\t\n83\t\n84\tdef read_dtcs(sess: Session, ecu: ECUAddress, mask: int = 0xFF,\n85\t              timeout: float = DEFAULT_TIMEOUT) -> dict[str, Any]:\n86\t    r = request(sess, ecu, 0x19, bytes([0x02, mask]), timeout)\n87\t    out: dict[str, Any] = {\"ecu\": ecu.code, \"bus\": sess.bus.key, \"mask\": f\"{mask:02X}\",\n88\t                           \"error\": r[\"error\"], \"nrc\": r[\"nrc_text\"] or None, \"dtcs\": []}\n89\t    data = _first_positive(r)\n90\t    if data:\n91\t        records = decode_uds_dtc_block(data)\n92\t        out[\"dtcs\"] = records\n93\t        out[\"codes\"] = [rec[\"code\"] for rec in records]\n94\t        out[\"availability_mask\"] = data[2] if len(data) > 2 else None\n95\t    elif r[\"error\"]:\n96\t        out[\"note\"] = \"ADAPTER/BUS ERROR; this is not 'no codes'\"\n97\t    elif not r[\"nrc\"]:\n98\t        out[\"warning\"] = \"no answer from the module\"\n99\t    return out\n100\t\n101\t\n102\tdef tester_present(sess: Session, ecu: ECUAddress) -> dict[str, Any]:\n103\t    r = request(sess, ecu, 0x3E, b\"\\x80\", 1.5)\n104\t    return {\"ecu\": ecu.code, \"sent\": True, \"error\": r[\"error\"]}\n105\t\n106\t\n107\tdef scan_bus(sess: Session, bus: Bus, vin: Optional[str] = None,\n108\t             mask: int = 0xFF) -> dict[str, Any]:\n109\t    \"\"\"``0x19 02`` on every usable module of the bus, in registry order.\"\"\"\n110\t    results = []\n111\t    for ecu in on_bus(bus.key):\n112\t        target = _effective_target(ecu, vin)\n113\t        if target is None:\n114\t            results.append({\"ecu\": ecu.code, \"skipped\": \"no confirmed address\"})\n115\t            continue\n116\t        eff = _with_target(ecu, target)\n117\t        results.append(read_dtcs(sess, eff, mask))\n118\t    audit.record(\"scan_bus\", bus=bus.key, modules=len(results))\n119\t    return {\"bus\": bus.key, \"cable\": sess.link.cable, \"modules\": results}\n120\t\n121\t\n122\tdef _effective_target(ecu: ECUAddress, vin: Optional[str]) -> Optional[int]:\n123\t    if vin:\n124\t        confirmed = store.confirmed_targets(vin).get(ecu.code)\n125\t        if confirmed is not None:\n126\t            return confirmed\n127\t    return ecu.target if ecu.usable else None\n128\t\n129\t\n130\tdef _with_target(ecu: ECUAddress, target: int) -> ECUAddress:\n131\t    if ecu.target == target and ecu.confidence == Confidence.CONFIRMED:\n132\t        return ecu\n133\t    from dataclasses import replace\n134\t    return replace(ecu, target=target, confidence=Confidence.CONFIRMED,\n135\t                   source=f\"{ecu.source}; confirmed on this car\")\n136\t\n137\t\n138\tdef resolve_module(code: str, vin: Optional[str] = None) -> ECUAddress:\n139\t    from .errors import BadCommand\n140\t    ecu = by_code(code.upper())\n141\t    if ecu is None:\n142\t        raise BadCommand(f\"unknown module code {code!r}\")\n143\t    target = _effective_target(ecu, vin)\n144\t    if target is None:\n145\t        raise BadCommand(f\"module {ecu.code} has no confirmed address on this car; run discovery \"\n146\t                         f\"(confidence {ecu.confidence.value}, target \"\n147\t                         f\"{'unknown' if ecu.target is None else format(ecu.target, '02X')})\")\n148\t    return _with_target(ecu, target)\n149\t\n150\t\n151\tdef _ascii(data: list[str]) -> str:\n152\t    return \"\".join(chr(int(b, 16)) for b in data if 32 <= int(b, 16) < 127).strip()\n153\t\n154\t\n155\tdef _did_reply(q: dict[str, Any], did: str) -> tuple[Optional[list[str]], Optional[int]]:\n156\t    \"\"\"(positive payload after the echoed DID, NRC byte) from one query.\"\"\"\n157\t    for data in q[\"ecus\"].values():\n158\t        if len(data) >= 3 and data[1] + data[2] == did:\n159\t            return data[3:], None\n160\t    for data in (q.get(\"all_ecus\") or {}).values():\n161\t        if len(data) >= 3 and data[0].upper() == \"7F\" and data[1].upper() == \"22\":\n162\t            return None, int(data[2], 16)\n163\t    return None, None\n164\t\n165\t\n166\tdef discover(sess: Session, bus: Bus, *, vin_expected: Optional[str] = None,\n167\t             candidates: Optional[list[int]] = None, per_target_timeout: float = 0.25,\n168\t             stop_after: Optional[int] = None) -> dict[str, Any]:\n169\t    \"\"\"``22 F190`` at every candidate target; any reply is proof of a live node.\n170\t\n171\t    A positive VIN reply and a negative response (``7F 22 xx``) both prove a\n172\t    node lives at that address; only silence does not. Each live node is then\n173\t    named two ways: by address, when the registry already lists that target\n174\t    on this bus, and by identity, reading the Annex C DIDs and matching them\n175\t    to the hardware/software numbers Table A recorded from MES (see\n176\t    :mod:`identify`). An identity match is what turns an \"address unknown\"\n177\t    module into a confirmed one. Confirmed matches persist per VIN so the\n178\t    sweep runs once. Read-only by construction.\n179\t    \"\"\"\n180\t    targets = candidates if candidates is not None else sweep_candidates(bus.key)\n181\t    bus_modules = on_bus(bus.key)\n182\t    hits: list[dict[str, Any]] = []\n183\t    started = time.monotonic()\n184\t    tried = 0\n185\t    for ta in targets:\n186\t        tried += 1\n187\t        req_hex, resp_hex = address_pair(ta)\n188\t        sess.target_raw(req_hex, resp_hex)\n189\t        q = sess.query(\"22F190\", \"62\", per_target_timeout)\n190\t        if q[\"error\"] and q[\"error\"] != \"TIMEOUT\":\n191\t            hits.append({\"target\": f\"{ta:02X}\", \"error\": q[\"error\"]})\n192\t            if q[\"error\"] in (\"BUS ERROR\", \"CAN ERROR\", \"OUT OF MEMORY\"):\n193\t                break\n194\t            continue\n195\t        payload, nrc = _did_reply(q, \"F190\")\n196\t        if payload is None and nrc is None:\n197\t            continue\n198\t        vin = _ascii(payload) if payload else \"\"\n199\t        hit: dict[str, Any] = {\"target\": f\"{ta:02X}\", \"request\": req_hex, \"response\": resp_hex,\n200\t                               \"vin\": vin or None,\n201\t                               \"vin_nrc\": None if nrc is None else nrc_text(nrc),\n202\t                               \"vin_matches\": (vin == vin_expected) if (vin_expected and vin)\n203\t                               else None}\n204\t        known = [m for m in bus_modules if m.target == ta]\n205\t        if known:\n206\t            hit[\"registry_match\"] = known[0].code\n207\t        fields: dict[str, Optional[str]] = {}\n208\t        for did in IDENTITY_DIDS:\n209\t            dq = sess.query(f\"22{did:04X}\", \"62\", per_target_timeout)\n210\t            dp, _ = _did_reply(dq, f\"{did:04X}\")\n211\t            if dp:\n212\t                fields[f\"{did:04X}\"] = _ascii(dp)\n213\t        hit[\"identity\"] = fields\n214\t        ident = identify.match(fields, bus_modules)\n215\t        hit[\"identity_match\"] = ident\n216\t        named = hit.get(\"registry_match\")\n217\t        if ident.get(\"matched\"):\n218\t            if named and named != ident[\"matched\"]:\n219\t                hit[\"conflict\"] = (f\"address says {named}, identity says {ident['matched']}; \"\n220\t                                   f\"nothing persisted\")\n221\t                named = None\n222\t            else:\n223\t                named = ident[\"matched\"]\n224\t                hit[\"matched_by\"] = \"address+identity\" if hit.get(\"registry_match\") else \"identity\"\n225\t        elif named:\n226\t            hit[\"matched_by\"] = \"address\"\n227\t        hit[\"module\"] = named\n228\t        if \"F187\" in fields:\n229\t            hit[\"spare_part\"] = fields[\"F187\"]\n230\t        # Persist only with proof it is this car: its VIN at that address, or,\n231\t        # where the node refuses F190, both Table A numbers matching.\n232\t        this_car = bool(vin_expected) and (\n233\t            vin == vin_expected or (not vin and ident.get(\"score\", 0) >= 2))\n234\t        # Named by address, or by an identity strong enough to trust.\n235\t        trusted = (hit.get(\"matched_by\") in (\"address\", \"address+identity\")\n236\t                   or bool(ident.get(\"strong\")))\n237\t        if named and this_car and trusted and \"conflict\" not in hit:\n238\t            store.confirm_target(vin_expected, named, ta,\n239\t                                 source=f\"discover ({hit.get('matched_by')})\")\n240\t            hit[\"persisted\"] = True\n241\t        elif named and this_car and not trusted:\n242\t            hit[\"not_persisted\"] = (\"identity rests on one partial match; read the module's \"\n243\t                                    \"identity before trusting this address\")\n244\t        hits.append(hit)\n245\t        if stop_after and len([h for h in hits if h.get(\"module\")]) >= stop_after:\n246\t            break\n247\t    sess.untarget()\n248\t    audit.record(\"discover\", bus=bus.key, tried=tried, hits=len(hits))\n249\t    return {\"bus\": bus.key, \"cable\": sess.link.cable, \"tried\": tried,\n250\t            \"seconds\": round(time.monotonic() - started, 1), \"hits\": hits}\n251\t\n252\t\n253\t__all__ = [\"NRC_TEXT\", \"nrc_text\", \"request\", \"read_did\", \"identity\", \"read_dtcs\",\n254\t           \"tester_present\", \"scan_bus\", \"resolve_module\", \"discover\"]\n255\t"}]},"uuid":"944b8461-d0ac-458e-9715-75e0c503641b","timestamp":"2026-10-14T11:06:54.951Z","toolUseResult":{"type":"text","file":{"filePath":"C:\\Users\\User\\mcp-servers\\cuore\\live\\uds.py","content":"\"\"\"Read-only UDS over a :class:`Session`: identity, DTCs, DIDs, discovery.\n\nEverything here goes through :func:`request`, which refuses any service not on\nthe read-only allowlist before a byte leaves the adapter. DTCs come back in\nthe MES vocabulary (``P0456-00``) so live codes join the corpus.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport time\nfrom typing import Any, Optional\n\nfrom . import audit, store\nfrom . import identify\nfrom .identify import IDENTITY_DIDS\nfrom .addressing import ANNEX_C, DIDS, ECUAddress, Confidence, address_pair, by_code, on_bus, sweep_candidates\nfrom .buses import Bus\nfrom .obd import decode_uds_dtc_block\nfrom .safety import assert_read_only_uds\nfrom .transport import DEFAULT_TIMEOUT, Session\n\nNRC_TEXT: dict[int, str] = {\n    0x10: \"generalReject\", 0x11: \"serviceNotSupported\", 0x12: \"subFunctionNotSupported\",\n    0x13: \"incorrectMessageLengthOrInvalidFormat\", 0x14: \"responseTooLong\",\n    0x21: \"busyRepeatRequest\", 0x22: \"conditionsNotCorrect\", 0x24: \"requestSequenceError\",\n    0x31: \"requestOutOfRange\", 0x33: \"securityAccessDenied\", 0x35: \"invalidKey\",\n    0x36: \"exceedNumberOfAttempts\", 0x37: \"requiredTimeDelayNotExpired\",\n    0x78: \"requestCorrectlyReceived-ResponsePending\", 0x7E: \"subFunctionNotSupportedInActiveSession\",\n    0x7F: \"serviceNotSupportedInActiveSession\",\n}\n\n\ndef nrc_text(code: int) -> str:\n    return NRC_TEXT.get(code, f\"NRC 0x{code:02X}\")\n\n\ndef request(sess: Session, ecu: ECUAddress, service: int, payload: bytes = b\"\",\n            timeout: float = DEFAULT_TIMEOUT) -> dict[str, Any]:\n    assert_read_only_uds(service, payload)\n    r = sess.uds(ecu, service, payload, timeout)\n    r[\"nrc_text\"] = {h: nrc_text(c) for h, c in r[\"nrc\"].items()}\n    return r\n\n\ndef _first_positive(r: dict[str, Any]) -> Optional[list[str]]:\n    return next(iter(r[\"positive\"].values()), None)\n\n\ndef read_did(sess: Session, ecu: ECUAddress, did: int, timeout: float = DEFAULT_TIMEOUT\n             ) -> dict[str, Any]:\n    r = request(sess, ecu, 0x22, did.to_bytes(2, \"big\"), timeout)\n    out: dict[str, Any] = {\"ecu\": ecu.code, \"bus\": sess.bus.key, \"did\": f\"{did:04X}\",\n                           \"name\": ANNEX_C.get(did), \"error\": r[\"error\"], \"nrc\": r[\"nrc_text\"] or None}\n    spec = next((d for d in DIDS if d.module == ecu.code and d.did == did), None)\n    if spec:\n        out[\"name\"] = spec.name\n        out[\"formula\"] = spec.formula\n        out[\"unit\"] = spec.unit\n        out[\"confidence\"] = spec.confidence\n    data = _first_positive(r)\n    if data and len(data) >= 3 and data[1] + data[2] == f\"{did:04X}\":\n        payload = data[3:]\n        out[\"bytes\"] = payload\n        if did == 0xF190 or all(32 <= int(b, 16) < 127 for b in payload) and len(payload) >= 4:\n            out[\"ascii\"] = \"\".join(chr(int(b, 16)) for b in payload if 32 <= int(b, 16) < 127)\n    elif not r[\"error\"] and not r[\"nrc\"]:\n        out[\"warning\"] = \"no answer\"\n    return out\n\n\ndef identity(sess: Session, ecu: ECUAddress) -> dict[str, Any]:\n    \"\"\"The Annex C identity set every module should answer.\"\"\"\n    out: dict[str, Any] = {\"ecu\": ecu.code, \"bus\": sess.bus.key, \"fields\": {}}\n    for did in (0xF190, 0xF187, 0xF188, 0xF189, 0xF18C, 0xF191, 0xF192, 0xF194, 0xF195):\n        r = read_did(sess, ecu, did, 2.5)\n        if r.get(\"error\"):\n            out[\"error\"] = r[\"error\"]\n            break\n        out[\"fields\"][f\"{did:04X}\"] = {\"name\": ANNEX_C.get(did), \"ascii\": r.get(\"ascii\"),\n                                       \"bytes\": r.get(\"bytes\"), \"nrc\": r.get(\"nrc\")}\n    return out\n\n\ndef read_dtcs(sess: Session, ecu: ECUAddress, mask: int = 0xFF,\n              timeout: float = DEFAULT_TIMEOUT) -> dict[str, Any]:\n    r = request(sess, ecu, 0x19, bytes([0x02, mask]), timeout)\n    out: dict[str, Any] = {\"ecu\": ecu.code, \"bus\": sess.bus.key, \"mask\": f\"{mask:02X}\",\n                           \"error\": r[\"error\"], \"nrc\": r[\"nrc_text\"] or None, \"dtcs\": []}\n    data = _first_positive(r)\n    if data:\n        records = decode_uds_dtc_block(data)\n        out[\"dtcs\"] = records\n        out[\"codes\"] = [rec[\"code\"] for rec in records]\n        out[\"availability_mask\"] = data[2] if len(data) > 2 else None\n    elif r[\"error\"]:\n        out[\"note\"] = \"ADAPTER/BUS ERROR; this is not 'no codes'\"\n    elif not r[\"nrc\"]:\n        out[\"warning\"] = \"no answer from the module\"\n    return out\n\n\ndef tester_present(sess: Session, ecu: ECUAddress) -> dict[str, Any]:\n    r = request(sess, ecu, 0x3E, b\"\\x80\", 1.5)\n    return {\"ecu\": ecu.code, \"sent\": True, \"error\": r[\"error\"]}\n\n\ndef scan_bus(sess: Session, bus: Bus, vin: Optional[str] = None,\n             mask: int = 0xFF) -> dict[str, Any]:\n    \"\"\"``0x19 02`` on every usable module of the bus, in registry order.\"\"\"\n    results = []\n    for ecu in on_bus(bus.key):\n        target = _effective_target(ecu, vin)\n        if target is None:\n            results.append({\"ecu\": ecu.code, \"skipped\": \"no confirmed address\"})\n            continue\n        eff = _with_target(ecu, target)\n        results.append(read_dtcs(sess, eff, mask))\n    audit.record(\"scan_bus\", bus=bus.key, modules=len(results))\n    return {\"bus\": bus.key, \"cable\": sess.link.cable, \"modules\": results}\n\n\ndef _effective_target(ecu: ECUAddress, vin: Optional[str]) -> Optional[int]:\n    if vin:\n        confirmed = store.confirmed_targets(vin).get(ecu.code)\n        if confirmed is not None:\n            return confirmed\n    return ecu.target if ecu.usable else None\n\n\ndef _with_target(ecu: ECUAddress, target: int) -> ECUAddress:\n    if ecu.target == target and ecu.confidence == Confidence.CONFIRMED:\n        return ecu\n    from dataclasses import replace\n    return replace(ecu, target=target, confidence=Confidence.CONFIRMED,\n                   source=f\"{ecu.source}; confirmed on this car\")\n\n\ndef resolve_module(code: str, vin: Optional[str] = None) -> ECUAddress:\n    from .errors import BadCommand\n    ecu = by_code(code.upper())\n    if ecu is None:\n        raise BadCommand(f\"unknown module code {code!r}\")\n    target = _effective_target(ecu, vin)\n    if target is None:\n        raise BadCommand(f\"module {ecu.code} has no confirmed address on this car; run discovery \"\n                         f\"(confidence {ecu.confidence.value}, target \"\n                         f\"{'unknown' if ecu.target is None else format(ecu.target, '02X')})\")\n    return _with_target(ecu, target)\n\n\ndef _ascii(data: list[str]) -> str:\n    return \"\".join(chr(int(b, 16)) for b in data if 32 <= int(b, 16) < 127).strip()\n\n\ndef _did_reply(q: dict[str, Any], did: str) -> tuple[Optional[list[str]], Optional[int]]:\n    \"\"\"(positive payload after the echoed DID, NRC byte) from one query.\"\"\"\n    for data in q[\"ecus\"].values():\n        if len(data) >= 3 and data[1] + data[2] == did:\n            return data[3:], None\n    for data in (q.get(\"all_ecus\") or {}).values():\n        if len(data) >= 3 and data[0].upper() == \"7F\" and data[1].upper() == \"22\":\n            return None, int(data[2], 16)\n    return None, None\n\n\ndef discover(sess: Session, bus: Bus, *, vin_expected: Optional[str] = None,\n             candidates: Optional[list[int]] = None, per_target_timeout: float = 0.25,\n             stop_after: Optional[int] = None) -> dict[str, Any]:\n    \"\"\"``22 F190`` at every candidate target; any reply is proof of a live node.\n\n    A positive VIN reply and a negative response (``7F 22 xx``) both prove a\n    node lives at that address; only silence does not. Each live node is then\n    named two ways: by address, when the registry already lists that target\n    on this bus, and by identity, reading the Annex C DIDs and matching them\n    to the hardware/software numbers Table A recorded from MES (see\n    :mod:`identify`). An identity match is what turns an \"address unknown\"\n    module into a confirmed one. Confirmed matches persist per VIN so the\n    sweep runs once. Read-only by construction.\n    \"\"\"\n    targets = candidates if candidates is not None else sweep_candidates(bus.key)\n    bus_modules = on_bus(bus.key)\n    hits: list[dict[str, Any]] = []\n    started = time.monotonic()\n    tried = 0\n    for ta in targets:\n        tried += 1\n        req_hex, resp_hex = address_pair(ta)\n        sess.target_raw(req_hex, resp_hex)\n        q = sess.query(\"22F190\", \"62\", per_target_timeout)\n        if q[\"error\"] and q[\"error\"] != \"TIMEOUT\":\n            hits.append({\"target\": f\"{ta:02X}\", \"error\": q[\"error\"]})\n            if q[\"error\"] in (\"BUS ERROR\", \"CAN ERROR\", \"OUT OF MEMORY\"):\n                break\n            continue\n        payload, nrc = _did_reply(q, \"F190\")\n        if payload is None and nrc is None:\n            continue\n        vin = _ascii(payload) if payload else \"\"\n        hit: dict[str, Any] = {\"target\": f\"{ta:02X}\", \"request\": req_hex, \"response\": resp_hex,\n                               \"vin\": vin or None,\n                               \"vin_nrc\": None if nrc is None else nrc_text(nrc),\n                               \"vin_matches\": (vin == vin_expected) if (vin_expected and vin)\n                               else None}\n        known = [m for m in bus_modules if m.target == ta]\n        if known:\n            hit[\"registry_match\"] = known[0].code\n        fields: dict[str, Optional[str]] = {}\n        for did in IDENTITY_DIDS:\n            dq = sess.query(f\"22{did:04X}\", \"62\", per_target_timeout)\n            dp, _ = _did_reply(dq, f\"{did:04X}\")\n            if dp:\n                fields[f\"{did:04X}\"] = _ascii(dp)\n        hit[\"identity\"] = fields\n        ident = identify.match(fields, bus_modules)\n        hit[\"identity_match\"] = ident\n        named = hit.get(\"registry_match\")\n        if ident.get(\"matched\"):\n            if named and named != ident[\"matched\"]:\n                hit[\"conflict\"] = (f\"address says {named}, identity says {ident['matched']}; \"\n                                   f\"nothing persisted\")\n                named = None\n            else:\n                named = ident[\"matched\"]\n                hit[\"matched_by\"] = \"address+identity\" if hit.get(\"registry_match\") else \"identity\"\n        elif named:\n            hit[\"matched_by\"] = \"address\"\n        hit[\"module\"] = named\n        if \"F187\" in fields:\n            hit[\"spare_part\"] = fields[\"F187\"]\n        # Persist only with proof it is this car: its VIN at that address, or,\n        # where the node refuses F190, both Table A numbers matching.\n        this_car = bool(vin_expected) and (\n            vin == vin_expected or (not vin and ident.get(\"score\", 0) >= 2))\n        # Named by address, or by an identity strong enough to trust.\n        trusted = (hit.get(\"matched_by\") in (\"address\", \"address+identity\")\n                   or bool(ident.get(\"strong\")))\n        if named and this_car and trusted and \"conflict\" not in hit:\n            store.confirm_target(vin_expected, named, ta,\n                                 source=f\"discover ({hit.get('matched_by')})\")\n            hit[\"persisted\"] = True\n        elif named and this_car and not trusted:\n            hit[\"not_persisted\"] = (\"identity rests on one partial match; read the module's \"\n                                    \"identity before trusting this address\")\n        hits.append(hit)\n        if stop_after and len([h for h in hits if h.get(\"module\")]) >= stop_after:\n            break\n    sess.untarget()\n    audit.record(\"discover\", bus=bus.key, tried=tried, hits=len(hits))\n    return {\"bus\": bus.key, \"cable\": sess.link.cable, \"tried\": tried,\n            \"seconds\": round(time.monotonic() - started, 1), \"hits\": hits}\n\n\n__all__ = [\"NRC_TEXT\", \"nrc_text\", \"request\", \"read_did\", \"identity\", \"read_dtcs\",\n           \"tester_present\", \"scan_bus\", \"resolve_module\", \"discover\"]\n","numLines":255,"startLine":1,"totalLines":255}},"sourceToolAssistantUUID":"b890909c-9033-4e16-997a-f7e62c3240e0","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
