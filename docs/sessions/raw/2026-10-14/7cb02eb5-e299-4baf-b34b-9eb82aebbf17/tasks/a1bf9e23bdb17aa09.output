reissue that","+        :meth:`Session.untarget` otherwise needs (point d of","+        docs/research/OBD_CONNECTIVITY_REVIEW_2026-10-14.md)?","+","+        Returns ``\"pass_filter\"`` only on an unambiguous ``OK``; anything","+        else -- ``\"?\"`` (unrecognised), a timeout, an adapter error, or an","+        exception -- is ``\"stp_reissue\"``, which is the exact path this","+        codebase already proved works on the bench. The result is cached","+        on this link for its whole life, so the probe runs at most once per","+        process even though ``untarget()`` is called constantly.","+        \"\"\"","+        if self.pass_filter_mode is not None:","+            return self.pass_filter_mode","+        target = \"STFAP 1,DB33F1,FFFFFFFF\" if sess.header_bits == 29 else \"STFAP 1,7DF,FFFFFFFF\"","+        try:","+            r = sess.cmd(target, 1.5)","+        except Exception as e:  # noqa: BLE001 -- a probe must never fail the caller","+            audit.record(\"pass_filter_probe\", mode=\"stp_reissue\", error=str(e))","+            self.pass_filter_mode = \"stp_reissue\"","+            return self.pass_filter_mode","+        mode = \"pass_filter\" if r.strip().upper() == \"OK\" else \"stp_reissue\"","+        audit.record(\"pass_filter_probe\", mode=mode, reply=r)","+        self.pass_filter_mode = mode","+        return mode","+","+    @contextmanager","+    def raised_baud(self, sess: Session, target: int = 0) -> Iterator[bool]:","+        \"\"\"Best-effort, self-reverting UART-speed raise for the life of this","+        ``with`` block (point c of","+        docs/research/OBD_CONNECTIVITY_REVIEW_2026-10-14.md).","+","+        Uses the STN's temporary ``STSBR`` (never ``STWBR``, so a lost","+        revert still clears itself at the adapter's next power cycle) and","+        the stream's own :meth:`~cuore.live.stream.Stream.set_baud`. Yields","+        ``True`` only once the new rate is confirmed with ``STI``; on any","+        failure along the way -- the command not acknowledged, the","+        transport unable to change its own baud live, or the post-switch","+        ``STI`` not coming back clean -- it yields ``False`` and the caller","+        just keeps going at the session's existing speed. Either way, the","+        adapter and host stream are back at the original baud when this","+        block exits; the revert itself never raises.","+","+        ``target`` defaults to :attr:`adapter_baud_requested`","+        (``CUORE_ADAPTER_BAUD``, 0 = feature off). Never engaged","+        automatically by :meth:`AdapterLink.session`/``_init`` -- a caller","+        (e.g. the live-data poller, once it holds a session) opts in per","+        block. UNVERIFIED on the real adapter.","+        \"\"\"","+        target = target or self.adapter_baud_requested","+        original = self.baud","+        raised = False","+        result: dict[str, Any] = {\"requested\": target, \"from\": original, \"ok\": False}","+        try:","+            if target and target != original and self.is_stn and not sess.passive:","+                r = sess.cmd(f\"STSBR {target}\", 1.5)","+                if \"OK\" in r.upper() or r.strip() == \"\":","+                    if sess.stream.set_baud(target):","+                        time.sleep(0.05)","+                        sess.stream.reset_input_buffer()","+                        check = sess.cmd(\"STI\", 1.5)","+                        if (check and \"TIMEOUT\" not in check.upper()","+                                and not adapter_error(check)):","+                            raised = True","+                            result[\"ok\"] = True","+                        else:","+                            result[\"note\"] = f\"STI check failed after switch: {check!r}\"","+                            sess.stream.set_baud(original)","+                    else:","+                        result[\"note\"] = \"transport cannot change baud live\"","+                else:","+                    result[\"note\"] = f\"STSBR not acknowledged: {r!r}\"","+            self.last_baud_raise = result","+            if raised:","+                self.baud = target","+                audit.record(\"baud_raised\", **result)","+            yield raised","+        finally:","+            if raised:","+                try:","+                    sess.stream.set_baud(original)","+                    time.sleep(0.02)","+                    sess.stream.reset_input_buffer()","+                    sess.cmd(f\"STSBR {original}\", 1.5)","+                    sess.cmd(\"STI\", 1.0)","+                except Exception as e:  # noqa: BLE001 -- revert must never raise","+                    audit.record(\"baud_revert_failed\", error=str(e))","+                self.baud = original","+                audit.record(\"baud_reverted\", to=original)","+","     def _probe_identity(self, sess: Session) -> None:","         ident: dict[str, str] = {}","         for c in (\"ATI\", \"AT@1\", \"STI\", \"STDI\", \"STMFR\", \"STSN\"):"]}],"userModified":false,"replaceAll":false},"serverClassifierContext":{"request":"a5e43f5d-2c01-47e3-869e-0bc3d2348c11","context":{"git_state":{"cwd":"/c/Users/User/mcp-servers","root":null,"branch":null,"default_branch":null,"status":null,"visibility":null,"error":"pending"},"live_cwd":"/c/Users/User/mcp-servers","platform":"windows"}},"sourceToolAssistantUUID":"35b07e0b-9b35-456d-89b6-96630bfec763","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
