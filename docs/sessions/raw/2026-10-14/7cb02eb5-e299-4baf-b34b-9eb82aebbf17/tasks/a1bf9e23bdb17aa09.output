{"parentUuid":"82b34fc3-5c63-4da7-8f29-43facc9ccd07","isSidechain":true,"agentId":"a1bf9e23bdb17aa09","message":{"model":"claude-sonnet-5","id":"msg_011Cg24CiQPX6MuuwPp3ifVW","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01CMhp7ZDtgmQNRba2G5jQUA","name":"Read","input":{"file_path":"C:\\Users\\User\\mcp-servers\\cuore\\live\\safety.py"},"caller":{"type":"direct"}}],"container":null,"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1560,"cache_read_input_tokens":266805,"output_tokens":251,"output_tokens_details":{"thinking_tokens":178},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":0,"ephemeral_5m_input_tokens":1560},"inference_geo":"global","iterations":[{"input_tokens":2,"output_tokens":251,"cache_read_input_tokens":266805,"cache_creation_input_tokens":1560,"cache_creation":{"ephemeral_5m_input_tokens":1560,"ephemeral_1h_input_tokens":0},"type":"message"}],"speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_01CMhp7ZDtgmQNRba2G5jQUA":{"file_path":"C:\\Users\\User\\mcp-servers\\cuore\\live\\safety.py"}},"serverClassifierRequest":"92b9b790-42a3-4d12-b92b-8edffccbad2f","apiBlockIndex":1,"requestId":"req_011Cg24Ci8mnUrpeatvFQXxj","attributionAgent":"general-purpose","type":"assistant","uuid":"be8e8954-477c-43c3-ae22-4873cb608b7a","timestamp":"2026-10-14T11:32:31.832Z","effort":"high","perTurnEffort":null,"userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
{"parentUuid":"be8e8954-477c-43c3-ae22-4873cb608b7a","isSidechain":true,"promptId":"111f0939-8c91-43a2-a416-439abce475ed","agentId":"a1bf9e23bdb17aa09","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01CMhp7ZDtgmQNRba2G5jQUA","type":"tool_result","content":"1\t\"\"\"The gates. Every rule that decides whether a command reaches the adapter.\n2\t\n3\tThree independent checks, all pure functions of their inputs:\n4\t\n5\t* :func:`validate_command` -- one command per call; CR, LF and the STN batch\n6\t  separator are rejected so nothing can smuggle a second command past the\n7\t  classifier.\n8\t* :func:`classify_command` -- read / vehicle_write / adapter_state / blocked,\n9\t  with allowlists for AT and ST reads rather than a deny-list.\n10\t* :func:`assert_read_only_uds` and :func:`assert_transmit_allowed` -- the HTTP\n11\t  layer's guarantee that it has no write path, and the cable protocol that\n12\t  keeps a 500 kbps preset off a 125 kbps bus.\n13\t\"\"\"\n14\t\n15\tfrom __future__ import annotations\n16\t\n17\timport re\n18\t\n19\tfrom .errors import BadCommand, Refused\n20\t\n21\t#: UDS services that change vehicle state, with what they actually do.\n22\tWRITE_SERVICES: dict[str, str] = {\n23\t    \"10\": \"UDS DiagnosticSessionControl - changes the module's session; an extended \"\n24\t          \"session suppresses normal broadcasts and can itself trigger network DTCs\",\n25\t    \"11\": \"UDS ECUReset - resets the module\",\n26\t    \"14\": \"UDS ClearDiagnosticInformation - erases DTCs and readiness monitors\",\n27\t    \"27\": \"UDS SecurityAccess - repeated failures can lock the module out\",\n28\t    \"28\": \"UDS CommunicationControl - silences or alters bus traffic\",\n29\t    \"2C\": \"UDS DynamicallyDefineDataIdentifier - writes a definition into the module\",\n30\t    \"2E\": \"UDS WriteDataByIdentifier - writes configuration to a module\",\n31\t    \"2F\": \"UDS InputOutputControl - physically actuates hardware\",\n32\t    \"31\": \"UDS RoutineControl - runs adaptations and service routines\",\n33\t    \"34\": \"UDS RequestDownload - reflashing, can brick a module\",\n34\t    \"35\": \"UDS RequestUpload - reflashing related\",\n35\t    \"36\": \"UDS TransferData - reflashing, can brick a module\",\n36\t    \"37\": \"UDS RequestTransferExit - reflashing related\",\n37\t    \"3D\": \"UDS WriteMemoryByAddress - writes module memory\",\n38\t    \"85\": \"UDS ControlDTCSetting - suppresses DTC logging\",\n39\t    \"87\": \"UDS LinkControl - changes bus timing\",\n40\t}\n41\t\n42\t#: AT commands that only read adapter state. Anything else AT-prefixed\n43\t#: reconfigures the adapter.\n44\tAT_READ_ONLY = frozenset({\"ATI\", \"AT@1\", \"AT@2\", \"AT@3\", \"ATRV\", \"ATDP\", \"ATDPN\",\n45\t                          \"ATPPS\", \"ATIGN\", \"ATRD\", \"ATCS\"})\n46\t\n47\t#: STN commands that only read adapter state.\n48\tST_READ_ONLY = frozenset({\"STI\", \"STIX\", \"STDI\", \"STDIX\", \"STMFR\", \"STSN\", \"STPR\",\n49\t                          \"STPRS\", \"STPBRR\", \"STSLCS\", \"STCTRR\", \"STDICPO\", \"STDICES\",\n50\t                          \"STDITPO\", \"STVR\", \"STVRX\", \"STPTOR\", \"STCSWMR\"})\n51\t\n52\t#: Monitor modes never return to the prompt; they run only through capture.py.\n53\tMONITOR_COMMANDS = (\"ATMA\", \"ATMR\", \"ATMT\")\n54\t_ST_MONITOR_RE = re.compile(r\"^STMA?\\d*$\")\n55\t\n56\tHEX_DIGITS = frozenset(\"0123456789ABCDEF\")\n57\t\n58\t\n59\tdef is_adapter_only(cmd: str) -> bool:\n60\t    \"\"\"True for an AT/ST command that only reads the adapter itself (identity,\n61\t    battery voltage, current protocol, ...) and never puts a frame on the\n62\t    vehicle bus -- ``ATI``, ``ATRV``, ``STPRS``, ``ATDPN``, ``STI``, ``STDI``\n63\t    and the rest of :data:`AT_READ_ONLY`/:data:`ST_READ_ONLY`.\n64\t\n65\t    Used to keep these commands off the bus-silence guard: refusing ``ATRV``\n66\t    because CAN-C looks silent is wrong on its face, since ``ATRV`` never\n67\t    touches CAN-C at all.\n68\t    \"\"\"\n69\t    compact = cmd.strip().upper().replace(\" \", \"\")\n70\t    return compact in AT_READ_ONLY or compact in ST_READ_ONLY\n71\t\n72\t\n73\tdef validate_command(cmd: str) -> str:\n74\t    \"\"\"One command, one line. Raises :class:`BadCommand` otherwise.\"\"\"\n75\t    if not cmd or not cmd.strip():\n76\t        raise BadCommand(\"empty command\")\n77\t    if \"\\r\" in cmd or \"\\n\" in cmd:\n78\t        raise BadCommand(\"command contains a line terminator; one command per call\")\n79\t    if \"|\" in cmd:\n80\t        raise BadCommand(\"command contains '|', the STN batch separator; one command per call\")\n81\t    if any(ord(c) > 126 or ord(c) < 32 for c in cmd):\n82\t        raise BadCommand(\"command contains non-printable or non-ASCII characters\")\n83\t    return cmd.strip()\n84\t\n85\t\n86\tdef classify_command(cmd: str) -> tuple[str, str]:\n87\t    \"\"\"Return ``(kind, reason)``; kind is read, vehicle_write, adapter_state or blocked.\"\"\"\n88\t    compact = cmd.strip().upper().replace(\" \", \"\")\n89\t    if not compact:\n90\t        return \"blocked\", \"empty command\"\n91\t\n92\t    if compact.startswith(\"AT\"):\n93\t        if compact.startswith(MONITOR_COMMANDS):\n94\t            return \"blocked\", f\"{compact[:4]} is a monitor mode; it never returns to the prompt\"\n95\t        if compact.startswith(\"ATSH\"):\n96\t            return \"vehicle_write\", (\"ATSH redirects requests to another module, which can \"\n97\t                                     \"turn a following command into a write to an unintended ECU\")\n98\t        if compact in AT_READ_ONLY:\n99\t            return \"read\", \"\"\n100\t        return \"adapter_state\", (f\"{compact} changes adapter configuration (protocol, \"\n101\t                                 f\"headers, filters, timing, baud or persistent settings)\")\n102\t\n103\t    if compact.startswith(\"ST\"):\n104\t        if _ST_MONITOR_RE.match(compact):\n105\t            return \"blocked\", \"STM/STMA monitor modes never return to the prompt\"\n106\t        if compact.startswith(\"STPX\"):\n107\t            return \"vehicle_write\", (\"STPX transmits an arbitrary CAN frame with an arbitrary \"\n108\t                                     \"ID and payload; that is a write to the bus\")\n109\t        if compact in ST_READ_ONLY:\n110\t            return \"read\", \"\"\n111\t        return \"adapter_state\", (f\"{compact} changes adapter configuration (protocol, \"\n112\t                                 f\"filters, segmentation, periodic messages, baud or \"\n113\t                                 f\"power settings)\")\n114\t\n115\t    if any(c not in HEX_DIGITS for c in compact):\n116\t        return \"blocked\", f\"{cmd!r} is neither an AT/ST command nor hex\"\n117\t\n118\t    if compact in (\"04\", \"0400\"):\n119\t        return \"vehicle_write\", (\"OBD-II Mode 04 clears DTCs and resets readiness monitors; \"\n120\t                                 \"use the clear tool, which captures evidence first\")\n121\t    service = compact[:2]\n122\t    if service in WRITE_SERVICES:\n123\t        return \"vehicle_write\", WRITE_SERVICES[service]\n124\t    return \"read\", \"\"\n125\t\n126\t\n127\t#: The only UDS services the live layer may emit, and the sub-functions\n128\t#: allowed where it matters. There is no code path to anything else.\n129\tREAD_ONLY_UDS: dict[int, frozenset[int] | None] = {\n130\t    0x10: frozenset({0x01}),   # default session only\n131\t    0x19: None,                # ReadDTCInformation, any sub-function\n132\t    0x22: None,                # ReadDataByIdentifier\n133\t    0x3E: None,                # TesterPresent\n134\t}\n135\t\n136\t\n137\tdef assert_read_only_uds(service: int, payload: bytes = b\"\") -> None:\n138\t    \"\"\"Raise :class:`Refused` unless the service is on the read-only allowlist.\"\"\"\n139\t    allowed = READ_ONLY_UDS.get(service, \"absent\")\n140\t    if allowed == \"absent\":\n141\t        why = WRITE_SERVICES.get(format(service, \"02X\"), \"not on the read-only allowlist\")\n142\t        raise Refused(f\"UDS service 0x{service:02X} is not permitted on the live link: {why}\")\n143\t    if allowed is not None:\n144\t        sub = payload[0] if payload else None\n145\t        if sub is None or (sub & 0x7F) not in allowed:\n146\t            raise Refused(f\"UDS service 0x{service:02X} sub-function \"\n147\t                          f\"{'none' if sub is None else format(sub, '02X')} is not permitted; \"\n148\t                          f\"allowed: {sorted(format(s, '02X') for s in allowed)}\")\n149\t\n150\t\n151\tdef assert_transmit_allowed(*, bus_key: str, bus_cable_ok: bool, verified: bool,\n152\t                            needs_confirmation: bool, confirmed: bool) -> None:\n153\t    \"\"\"The cable protocol, enforced before any request leaves the adapter.\n154\t\n155\t    ``bus_cable_ok`` is whether the declared cable reaches this bus at all;\n156\t    ``verified`` is whether a passive listen has seen traffic on it under the\n157\t    current declaration; ``needs_confirmation`` is the per-bus flag (CAN-CH)\n158\t    and ``confirmed`` the per-session consent.\n159\t    \"\"\"\n160\t    if not bus_cable_ok:\n161\t        raise Refused(f\"bus {bus_key} is not reachable with the declared cable; \"\n162\t                      f\"declare the right cable first (set_cable / POST /api/live/cable)\")\n163\t    if not verified:\n164\t        raise Refused(f\"bus {bus_key} has not been verified under the current cable; \"\n165\t                      f\"run a passive listen first (verify_bus / POST /api/live/verify)\")\n166\t    if needs_confirmation and not confirmed:\n167\t        raise Refused(f\"bus {bus_key} carries brakes, airbag and steering; transmitting on it \"\n168\t                      f\"requires confirm=True on this call\")\n169\t\n170\t\n171\t#: UDS services/sub-functions an actuator-test *replay* may send. Distinct\n172\t#: from READ_ONLY_UDS: this adds 0x2F (InputOutputControlByIdentifier) and\n173\t#: 0x31 (RoutineControl) -- what an actuator test actually is -- and allows\n174\t#: 0x10 sub 0x03 (the extended session most actuator tests run in) alongside\n175\t#: the default session. Never anything else: no 0x27, no 0x2E, no reflash or\n176\t#: reset service. :mod:`actuate` applies this same allowlist at *learning*\n177\t#: time (:func:`actuate.extract_procedure`) to decide whether a captured\n178\t#: procedure is replayable at all; this function is the belt on the wire.\n179\tACTUATION_UDS: dict[int, frozenset[int] | None] = {\n180\t    0x10: frozenset({0x01, 0x03}),   # default or extended-diagnostic session only\n181\t    0x19: None,                      # ReadDTCInformation\n182\t    0x22: None,                      # ReadDataByIdentifier\n183\t    0x2F: None,                      # InputOutputControlByIdentifier\n184\t    0x31: None,                      # RoutineControl\n185\t    0x3E: None,                      # TesterPresent\n186\t}\n187\t\n188\t#: Modules an actuator-test replay refuses outright, regardless of consent\n189\t#: or confirm: brakes, airbag, steering, torque vectoring, the steering\n190\t#: lock, and (via the bus check below) anything else on CAN-CH.\n191\tACTUATION_BLOCKED_MODULES: frozenset[str] = frozenset({\n192\t    \"ABS\", \"EPS\", \"ORC\", \"HALF\", \"DASM\", \"ESL\", \"TVM\",\n193\t    # Driveline and security: shift-by-wire / park lock (TCM, ESM), the Q4\n194\t    # transfer case (DTCM) and the immobiliser/keyless hub (RFHUB). Actuating\n195\t    # any of these on a parked car can release park or disable starting.\n196\t    \"TCM\", \"ESM\", \"DTCM\", \"RFHUB\",\n197\t})\n198\t\n199\t\n200\tdef assert_actuation_allowed(service: int, payload: bytes = b\"\") -> None:\n201\t    \"\"\"Raise :class:`Refused` unless the service is on the actuation allowlist.\n202\t\n203\t    This is the gate every request an actuator replay sends must pass\n204\t    immediately before it reaches the adapter -- :meth:`Session.uds` sends\n205\t    any service, so this is the only thing standing between a learned\n206\t    procedure and the wire. It never loosens :data:`READ_ONLY_UDS`: a\n207\t    0x2F/0x31 request is still refused on the read-only path in :mod:`uds`.\n208\t    \"\"\"\n209\t    allowed = ACTUATION_UDS.get(service, \"absent\")\n210\t    if allowed == \"absent\":\n211\t        why = WRITE_SERVICES.get(format(service, \"02X\"), \"not on the actuation allowlist\")\n212\t        raise Refused(f\"UDS service 0x{service:02X} is not permitted during actuator replay: {why}\")\n213\t    if allowed is not None:\n214\t        sub = payload[0] if payload else None\n215\t        if sub is None or (sub & 0x7F) not in allowed:\n216\t            raise Refused(f\"UDS service 0x{service:02X} sub-function \"\n217\t                          f\"{'none' if sub is None else format(sub, '02X')} is not permitted \"\n218\t                          f\"during actuator replay; allowed: \"\n219\t                          f\"{sorted(format(s, '02X') for s in allowed)}\")\n220\t\n221\t\n222\tdef assert_actuation_module_allowed(module_code: str, bus_key: str) -> None:\n223\t    \"\"\"Raise :class:`Refused` for a module an actuator replay must never touch.\n224\t\n225\t    Checked before any traffic, independent of consent or confirm: this is\n226\t    not a confirmable risk, it is a refusal.\n227\t    \"\"\"\n228\t    code = (module_code or \"\").upper()\n229\t    if code in ACTUATION_BLOCKED_MODULES or bus_key == \"can_ch\":\n230\t        raise Refused(\n231\t            f\"actuator tests are refused on {code}: safety-critical (brakes, airbag, steering, \"\n232\t            f\"torque vectoring, driveline/park lock, immobiliser, or the CAN-CH bus); use \"\n233\t            f\"MultiEcuScan or wiTECH for this test, \"\n234\t            f\"never a replay here\")\n235\t\n236\t\n237\t__all__ = [\n238\t    \"WRITE_SERVICES\", \"AT_READ_ONLY\", \"ST_READ_ONLY\", \"MONITOR_COMMANDS\", \"READ_ONLY_UDS\",\n239\t    \"ACTUATION_UDS\", \"ACTUATION_BLOCKED_MODULES\",\n240\t    \"validate_command\", \"classify_command\", \"is_adapter_only\", \"assert_read_only_uds\",\n241\t    \"assert_transmit_allowed\", \"assert_actuation_allowed\", \"assert_actuation_module_allowed\",\n242\t]\n243\t"}]},"uuid":"dcf90a2f-1559-4768-99d8-3075799aca76","timestamp":"2026-10-14T11:32:32.040Z","toolUseResult":{"type":"text","file":{"filePath":"C:\\Users\\User\\mcp-servers\\cuore\\live\\safety.py","content":"\"\"\"The gates. Every rule that decides whether a command reaches the adapter.\n\nThree independent checks, all pure functions of their inputs:\n\n* :func:`validate_command` -- one command per call; CR, LF and the STN batch\n  separator are rejected so nothing can smuggle a second command past the\n  classifier.\n* :func:`classify_command` -- read / vehicle_write / adapter_state / blocked,\n  with allowlists for AT and ST reads rather than a deny-list.\n* :func:`assert_read_only_uds` and :func:`assert_transmit_allowed` -- the HTTP\n  layer's guarantee that it has no write path, and the cable protocol that\n  keeps a 500 kbps preset off a 125 kbps bus.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport re\n\nfrom .errors import BadCommand, Refused\n\n#: UDS services that change vehicle state, with what they actually do.\nWRITE_SERVICES: dict[str, str] = {\n    \"10\": \"UDS DiagnosticSessionControl - changes the module's session; an extended \"\n          \"session suppresses normal broadcasts and can itself trigger network DTCs\",\n    \"11\": \"UDS ECUReset - resets the module\",\n    \"14\": \"UDS ClearDiagnosticInformation - erases DTCs and readiness monitors\",\n    \"27\": \"UDS SecurityAccess - repeated failures can lock the module out\",\n    \"28\": \"UDS CommunicationControl - silences or alters bus traffic\",\n    \"2C\": \"UDS DynamicallyDefineDataIdentifier - writes a definition into the module\",\n    \"2E\": \"UDS WriteDataByIdentifier - writes configuration to a module\",\n    \"2F\": \"UDS InputOutputControl - physically actuates hardware\",\n    \"31\": \"UDS RoutineControl - runs adaptations and service routines\",\n    \"34\": \"UDS RequestDownload - reflashing, can brick a module\",\n    \"35\": \"UDS RequestUpload - reflashing related\",\n    \"36\": \"UDS TransferData - reflashing, can brick a module\",\n    \"37\": \"UDS RequestTransferExit - reflashing related\",\n    \"3D\": \"UDS WriteMemoryByAddress - writes module memory\",\n    \"85\": \"UDS ControlDTCSetting - suppresses DTC logging\",\n    \"87\": \"UDS LinkControl - changes bus timing\",\n}\n\n#: AT commands that only read adapter state. Anything else AT-prefixed\n#: reconfigures the adapter.\nAT_READ_ONLY = frozenset({\"ATI\", \"AT@1\", \"AT@2\", \"AT@3\", \"ATRV\", \"ATDP\", \"ATDPN\",\n                          \"ATPPS\", \"ATIGN\", \"ATRD\", \"ATCS\"})\n\n#: STN commands that only read adapter state.\nST_READ_ONLY = frozenset({\"STI\", \"STIX\", \"STDI\", \"STDIX\", \"STMFR\", \"STSN\", \"STPR\",\n                          \"STPRS\", \"STPBRR\", \"STSLCS\", \"STCTRR\", \"STDICPO\", \"STDICES\",\n                          \"STDITPO\", \"STVR\", \"STVRX\", \"STPTOR\", \"STCSWMR\"})\n\n#: Monitor modes never return to the prompt; they run only through capture.py.\nMONITOR_COMMANDS = (\"ATMA\", \"ATMR\", \"ATMT\")\n_ST_MONITOR_RE = re.compile(r\"^STMA?\\d*$\")\n\nHEX_DIGITS = frozenset(\"0123456789ABCDEF\")\n\n\ndef is_adapter_only(cmd: str) -> bool:\n    \"\"\"True for an AT/ST command that only reads the adapter itself (identity,\n    battery voltage, current protocol, ...) and never puts a frame on the\n    vehicle bus -- ``ATI``, ``ATRV``, ``STPRS``, ``ATDPN``, ``STI``, ``STDI``\n    and the rest of :data:`AT_READ_ONLY`/:data:`ST_READ_ONLY`.\n\n    Used to keep these commands off the bus-silence guard: refusing ``ATRV``\n    because CAN-C looks silent is wrong on its face, since ``ATRV`` never\n    touches CAN-C at all.\n    \"\"\"\n    compact = cmd.strip().upper().replace(\" \", \"\")\n    return compact in AT_READ_ONLY or compact in ST_READ_ONLY\n\n\ndef validate_command(cmd: str) -> str:\n    \"\"\"One command, one line. Raises :class:`BadCommand` otherwise.\"\"\"\n    if not cmd or not cmd.strip():\n        raise BadCommand(\"empty command\")\n    if \"\\r\" in cmd or \"\\n\" in cmd:\n        raise BadCommand(\"command contains a line terminator; one command per call\")\n    if \"|\" in cmd:\n        raise BadCommand(\"command contains '|', the STN batch separator; one command per call\")\n    if any(ord(c) > 126 or ord(c) < 32 for c in cmd):\n        raise BadCommand(\"command contains non-printable or non-ASCII characters\")\n    return cmd.strip()\n\n\ndef classify_command(cmd: str) -> tuple[str, str]:\n    \"\"\"Return ``(kind, reason)``; kind is read, vehicle_write, adapter_state or blocked.\"\"\"\n    compact = cmd.strip().upper().replace(\" \", \"\")\n    if not compact:\n        return \"blocked\", \"empty command\"\n\n    if compact.startswith(\"AT\"):\n        if compact.startswith(MONITOR_COMMANDS):\n            return \"blocked\", f\"{compact[:4]} is a monitor mode; it never returns to the prompt\"\n        if compact.startswith(\"ATSH\"):\n            return \"vehicle_write\", (\"ATSH redirects requests to another module, which can \"\n                                     \"turn a following command into a write to an unintended ECU\")\n        if compact in AT_READ_ONLY:\n            return \"read\", \"\"\n        return \"adapter_state\", (f\"{compact} changes adapter configuration (protocol, \"\n                                 f\"headers, filters, timing, baud or persistent settings)\")\n\n    if compact.startswith(\"ST\"):\n        if _ST_MONITOR_RE.match(compact):\n            return \"blocked\", \"STM/STMA monitor modes never return to the prompt\"\n        if compact.startswith(\"STPX\"):\n            return \"vehicle_write\", (\"STPX transmits an arbitrary CAN frame with an arbitrary \"\n                                     \"ID and payload; that is a write to the bus\")\n        if compact in ST_READ_ONLY:\n            return \"read\", \"\"\n        return \"adapter_state\", (f\"{compact} changes adapter configuration (protocol, \"\n                                 f\"filters, segmentation, periodic messages, baud or \"\n                                 f\"power settings)\")\n\n    if any(c not in HEX_DIGITS for c in compact):\n        return \"blocked\", f\"{cmd!r} is neither an AT/ST command nor hex\"\n\n    if compact in (\"04\", \"0400\"):\n        return \"vehicle_write\", (\"OBD-II Mode 04 clears DTCs and resets readiness monitors; \"\n                                 \"use the clear tool, which captures evidence first\")\n    service = compact[:2]\n    if service in WRITE_SERVICES:\n        return \"vehicle_write\", WRITE_SERVICES[service]\n    return \"read\", \"\"\n\n\n#: The only UDS services the live layer may emit, and the sub-functions\n#: allowed where it matters. There is no code path to anything else.\nREAD_ONLY_UDS: dict[int, frozenset[int] | None] = {\n    0x10: frozenset({0x01}),   # default session only\n    0x19: None,                # ReadDTCInformation, any sub-function\n    0x22: None,                # ReadDataByIdentifier\n    0x3E: None,                # TesterPresent\n}\n\n\ndef assert_read_only_uds(service: int, payload: bytes = b\"\") -> None:\n    \"\"\"Raise :class:`Refused` unless the service is on the read-only allowlist.\"\"\"\n    allowed = READ_ONLY_UDS.get(service, \"absent\")\n    if allowed == \"absent\":\n        why = WRITE_SERVICES.get(format(service, \"02X\"), \"not on the read-only allowlist\")\n        raise Refused(f\"UDS service 0x{service:02X} is not permitted on the live link: {why}\")\n    if allowed is not None:\n        sub = payload[0] if payload else None\n        if sub is None or (sub & 0x7F) not in allowed:\n            raise Refused(f\"UDS service 0x{service:02X} sub-function \"\n                          f\"{'none' if sub is None else format(sub, '02X')} is not permitted; \"\n                          f\"allowed: {sorted(format(s, '02X') for s in allowed)}\")\n\n\ndef assert_transmit_allowed(*, bus_key: str, bus_cable_ok: bool, verified: bool,\n                            needs_confirmation: bool, confirmed: bool) -> None:\n    \"\"\"The cable protocol, enforced before any request leaves the adapter.\n\n    ``bus_cable_ok`` is whether the declared cable reaches this bus at all;\n    ``verified`` is whether a passive listen has seen traffic on it under the\n    current declaration; ``needs_confirmation`` is the per-bus flag (CAN-CH)\n    and ``confirmed`` the per-session consent.\n    \"\"\"\n    if not bus_cable_ok:\n        raise Refused(f\"bus {bus_key} is not reachable with the declared cable; \"\n                      f\"declare the right cable first (set_cable / POST /api/live/cable)\")\n    if not verified:\n        raise Refused(f\"bus {bus_key} has not been verified under the current cable; \"\n                      f\"run a passive listen first (verify_bus / POST /api/live/verify)\")\n    if needs_confirmation and not confirmed:\n        raise Refused(f\"bus {bus_key} carries brakes, airbag and steering; transmitting on it \"\n                      f\"requires confirm=True on this call\")\n\n\n#: UDS services/sub-functions an actuator-test *replay* may send. Distinct\n#: from READ_ONLY_UDS: this adds 0x2F (InputOutputControlByIdentifier) and\n#: 0x31 (RoutineControl) -- what an actuator test actually is -- and allows\n#: 0x10 sub 0x03 (the extended session most actuator tests run in) alongside\n#: the default session. Never anything else: no 0x27, no 0x2E, no reflash or\n#: reset service. :mod:`actuate` applies this same allowlist at *learning*\n#: time (:func:`actuate.extract_procedure`) to decide whether a captured\n#: procedure is replayable at all; this function is the belt on the wire.\nACTUATION_UDS: dict[int, frozenset[int] | None] = {\n    0x10: frozenset({0x01, 0x03}),   # default or extended-diagnostic session only\n    0x19: None,                      # ReadDTCInformation\n    0x22: None,                      # ReadDataByIdentifier\n    0x2F: None,                      # InputOutputControlByIdentifier\n    0x31: None,                      # RoutineControl\n    0x3E: None,                      # TesterPresent\n}\n\n#: Modules an actuator-test replay refuses outright, regardless of consent\n#: or confirm: brakes, airbag, steering, torque vectoring, the steering\n#: lock, and (via the bus check below) anything else on CAN-CH.\nACTUATION_BLOCKED_MODULES: frozenset[str] = frozenset({\n    \"ABS\", \"EPS\", \"ORC\", \"HALF\", \"DASM\", \"ESL\", \"TVM\",\n    # Driveline and security: shift-by-wire / park lock (TCM, ESM), the Q4\n    # transfer case (DTCM) and the immobiliser/keyless hub (RFHUB). Actuating\n    # any of these on a parked car can release park or disable starting.\n    \"TCM\", \"ESM\", \"DTCM\", \"RFHUB\",\n})\n\n\ndef assert_actuation_allowed(service: int, payload: bytes = b\"\") -> None:\n    \"\"\"Raise :class:`Refused` unless the service is on the actuation allowlist.\n\n    This is the gate every request an actuator replay sends must pass\n    immediately before it reaches the adapter -- :meth:`Session.uds` sends\n    any service, so this is the only thing standing between a learned\n    procedure and the wire. It never loosens :data:`READ_ONLY_UDS`: a\n    0x2F/0x31 request is still refused on the read-only path in :mod:`uds`.\n    \"\"\"\n    allowed = ACTUATION_UDS.get(service, \"absent\")\n    if allowed == \"absent\":\n        why = WRITE_SERVICES.get(format(service, \"02X\"), \"not on the actuation allowlist\")\n        raise Refused(f\"UDS service 0x{service:02X} is not permitted during actuator replay: {why}\")\n    if allowed is not None:\n        sub = payload[0] if payload else None\n        if sub is None or (sub & 0x7F) not in allowed:\n            raise Refused(f\"UDS service 0x{service:02X} sub-function \"\n                          f\"{'none' if sub is None else format(sub, '02X')} is not permitted \"\n                          f\"during actuator replay; allowed: \"\n                          f\"{sorted(format(s, '02X') for s in allowed)}\")\n\n\ndef assert_actuation_module_allowed(module_code: str, bus_key: str) -> None:\n    \"\"\"Raise :class:`Refused` for a module an actuator replay must never touch.\n\n    Checked before any traffic, independent of consent or confirm: this is\n    not a confirmable risk, it is a refusal.\n    \"\"\"\n    code = (module_code or \"\").upper()\n    if code in ACTUATION_BLOCKED_MODULES or bus_key == \"can_ch\":\n        raise Refused(\n            f\"actuator tests are refused on {code}: safety-critical (brakes, airbag, steering, \"\n            f\"torque vectoring, driveline/park lock, immobiliser, or the CAN-CH bus); use \"\n            f\"MultiEcuScan or wiTECH for this test, \"\n            f\"never a replay here\")\n\n\n__all__ = [\n    \"WRITE_SERVICES\", \"AT_READ_ONLY\", \"ST_READ_ONLY\", \"MONITOR_COMMANDS\", \"READ_ONLY_UDS\",\n    \"ACTUATION_UDS\", \"ACTUATION_BLOCKED_MODULES\",\n    \"validate_command\", \"classify_command\", \"is_adapter_only\", \"assert_read_only_uds\",\n    \"assert_transmit_allowed\", \"assert_actuation_allowed\", \"assert_actuation_module_allowed\",\n]\n","numLines":243,"startLine":1,"totalLines":243}},"sourceToolAssistantUUID":"be8e8954-477c-43c3-ae22-4873cb608b7a","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
