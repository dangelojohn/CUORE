)","-check(\"sweep_bus_full: every module handled inside the ONE held session \"","-      \"(no nested session_open in the sent script)\", True)  # structural: no lk.session() called inside","+# ATE0 is sent exactly once per AdapterLink._init -- i.e. once per session","+# open. sweep_bus_full itself never opens a session (it only uses the one","+# passed in), so seeing it exactly once here proves every module's DTCs +","+# identity + DID were read inside that single held session, not one open","+# per module the way cuore.live.fullscan._sweep_bus_modules currently does.","+check_eq(\"sweep_bus_full: exactly one session open for every module read\",","+         stream5.sent.count(\"ATE0\"), 1, str(stream5.sent))"," "," "," # ==========================================================================="]}],"userModified":false,"replaceAll":false},"serverClassifierContext":{"request":"b441c40d-1b89-49f5-9981-e0e47e7ae604","context":{"git_state":{"cwd":"/c/Users/User/mcp-servers","root":null,"branch":null,"default_branch":null,"status":null,"visibility":null,"error":"pending"},"live_cwd":"/c/Users/User/mcp-servers","platform":"windows"}},"sourceToolAssistantUUID":"4e60aca0-b94a-4bda-8775-ea3f838f859b","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
