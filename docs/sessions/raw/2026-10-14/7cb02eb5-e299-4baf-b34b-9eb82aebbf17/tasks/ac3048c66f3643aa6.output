ackages/anyio/_core\n./.venv/Lib/site-packages/anyio/_core/__pycache__\n./.venv/Lib/site-packages/anyio/__pycache__\n./.venv/Lib/site-packages/anyio-4.14.2.dist-info\n./.venv/Lib/site-packages/anyio-4.14.2.dist-info/licenses\n./.venv/Lib/site-packages/attr\n./.venv/Lib/site-packages/attr/__pycache__\n./.venv/Lib/site-packages/attrs\n./.venv/Lib/site-packages/attrs/__pycache__\n./.venv/Lib/site-packages/attrs-26.1.0.dist-info\n./.venv/Lib/site-packages/attrs-26.1.0.dist-info/licenses\n./.venv/Lib/site-packages/blinker\n./.venv/Lib/site-packages/blinker/__pycache__\n./.venv/Lib/site-packages/blinker-1.9.0.dist-info\n./.venv/Lib/site-packages/certifi\n./.venv/Lib/site-packages/certifi/tests\n./.venv/Lib/site-packages/certifi/tests/__pycache__\n./.venv/Lib/site-packages/certifi/__pycache__\n./.venv/Lib/site-packages/certifi-2026.7.22.dist-info\n./.venv/Lib/site-packages/certifi-2026.7.22.dist-info/licenses\n./.venv/Lib/site-packages/cffi\n./.venv/Lib/site-packages/cffi/__pycache__\n./.venv/Lib/site-packages/cffi-2.1.1.dist-info\n./.venv/Lib/site-packages/cffi-2.1.1.dist-info/licenses\n./.venv/Lib/site-packages/charset_normalizer\n./.venv/Lib/site-packages/charset_normalizer/cli\n./.venv/Lib/site-packages/charset_normalizer/cli/__pycache__\n./.venv/Lib/site-packages/charset_normalizer/__pycache__\n./.venv/Lib/site-packages/charset_normalizer-3.5.1.dist-info\n./.venv/Lib/site-packages/charset_normalizer-3.5.1.dist-info/licenses\n./.venv/Lib/site-packages/click\n./.venv/Lib/site-packages/click/__pycache__\n./.venv/Lib/site-packages/click-8.5.0.dist-info\n./.venv/Lib/site-packages/click-8.5.0.dist-info/licenses\n./.venv/Lib/site-packages/comtypes\n./.venv/Lib/site-packages/comtypes/client\n./.venv/Lib/site-packages/comtypes/client/__pycache__\n./.venv/Lib/site-packages/comtypes/gen\n./.venv/Lib/site-packages/comtypes/gen/__pycache__\n./.venv/Lib/site-packages/comtypes/server\n./.venv/Lib/site-packages/comtypes/server/__pycache__\n./.venv/Lib/site-packages/comtypes/test\n./.