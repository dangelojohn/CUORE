{"parentUuid":"68bba9c9-2a6d-420d-9d7f-840d19ca20b5","isSidechain":true,"agentId":"ac3048c66f3643aa6","message":{"model":"claude-sonnet-5","id":"msg_011Cg2ZZT7qfgUBdt4aWPCR2","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01VhpxMjPY61WE99iEmBjRPA","name":"Read","input":{"file_path":"C:\\Users\\User\\mcp-servers\\cuore\\live\\channels.py"},"caller":{"type":"direct"}}],"container":null,"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":4364,"cache_read_input_tokens":80548,"output_tokens":284,"output_tokens_details":{"thinking_tokens":211},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":0,"ephemeral_5m_input_tokens":4364},"inference_geo":"global","iterations":[{"input_tokens":2,"output_tokens":284,"cache_read_input_tokens":80548,"cache_creation_input_tokens":4364,"cache_creation":{"ephemeral_5m_input_tokens":4364,"ephemeral_1h_input_tokens":0},"type":"message"}],"speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_01VhpxMjPY61WE99iEmBjRPA":{"file_path":"C:\\Users\\User\\mcp-servers\\cuore\\live\\channels.py"}},"serverClassifierRequest":"8a9a846a-f1ab-433c-a950-99db547d1219","apiBlockIndex":1,"requestId":"req_011Cg2ZZStSyWrr6HMzmLcUB","attributionAgent":"general-purpose","type":"assistant","uuid":"45ab7596-f3e0-4084-9ef8-ab03ebb46c8f","timestamp":"2026-10-14T17:57:31.381Z","effort":"high","perTurnEffort":null,"userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
{"parentUuid":"45ab7596-f3e0-4084-9ef8-ab03ebb46c8f","isSidechain":true,"promptId":"f5371174-bba0-4992-a14b-d71ea13c02eb","agentId":"ac3048c66f3643aa6","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01VhpxMjPY61WE99iEmBjRPA","type":"tool_result","content":"1\t\"\"\"The live-data channel model: a registry of everything the poller can sample.\n2\t\n3\tA channel is ``{id, name, unit, source}``. Four source kinds:\n4\t\n5\t* ``pid``    -- a Mode 01 PID (hex), decoded by :func:`obd.decode_pid`.\n6\t* ``did``    -- a module code + UDS DID (hex) + CarScanner formula, evaluated\n7\t  with :func:`readall.eval_formula`. Every catalogued DID for ECM, TCM, BCM,\n8\t  IPC and RFHUB (:func:`did_catalog.all_dids`) is included, at its recorded\n9\t  confidence. A DID whose formula answers with several named fields (the\n10\t  RFHUB tire DIDs: ``pressure=...; temp=...``) is expanded into one channel\n11\t  per field, sharing the one DID read.\n12\t* ``computed`` -- an arithmetic expression over other channel ids, evaluated\n13\t  by the small safe evaluator below (no ``eval()`` anywhere in this module).\n14\t* ``battery``  -- adapter ``ATRV``.\n15\t\n16\t:func:`available_channels` returns the whole registry; :func:`presets`\n17\tgroups channel ids for one-click starts on this car.\n18\t\"\"\"\n19\t\n20\tfrom __future__ import annotations\n21\t\n22\timport re\n23\tfrom dataclasses import dataclass\n24\tfrom typing import Any, Optional\n25\t\n26\tfrom . import did_catalog\n27\tfrom .addressing import by_code\n28\tfrom .errors import BadCommand\n29\tfrom .obd import PIDS_BY_HEX\n30\t\n31\tFAST_HZ = 5.0\n32\tMED_HZ = 1.0\n33\tSLOW_HZ = 0.5\n34\t\n35\t#: PIDs worth sampling quickly -- the ones that change fast enough to matter\n36\t#: for a live dashboard (RPM, speed, throttle). ``throttle_b``/\n37\t#: ``accel_pedal_d``/``accel_pedal_e`` (new J1979 PIDs 47/49/4A) are added\n38\t#: here on the same reasoning as ``throttle_position`` -- pedal/throttle\n39\t#: position tracks driver input in real time. Harmless if the decoder for\n40\t#: one of these names has not landed in ``cuore.live.obd`` yet: this set is\n41\t#: just names, consulted only once the matching PID channel exists.\n42\t_FAST_PIDS = {\"engine_rpm\", \"vehicle_speed\", \"throttle_position\",\n43\t             \"throttle_b\", \"accel_pedal_d\", \"accel_pedal_e\"}\n44\t#: Slow-moving readings: temperatures, ambient/barometric pressure, fuel level.\n45\t#: ``intake_air_temp_b1`` (PID 68), ``egr_temp`` (PID 6B) and\n46\t#: ``catalyst_temp_b1s1`` (PID 3C) are new J1979 temperature PIDs added on\n47\t#: the same reasoning as ``intake_air_temp``/``engine_oil_temp`` above.\n48\t_SLOW_PIDS = {\"engine_coolant_temp\", \"intake_air_temp\", \"ambient_air_temp\",\n49\t             \"barometric_pressure\", \"fuel_level\", \"engine_oil_temp\",\n50\t             \"intake_air_temp_b1\", \"egr_temp\", \"catalyst_temp_b1s1\"}\n51\t\n52\t#: Modules whose catalogued DIDs are worth exposing as channels.\n53\tDID_MODULES: tuple[str, ...] = (\"ECM\", \"TCM\", \"BCM\", \"IPC\", \"RFHUB\")\n54\t\n55\t\n56\t@dataclass(frozen=True)\n57\tclass Channel:\n58\t    id: str\n59\t    name: str\n60\t    unit: str\n61\t    kind: str                       # \"pid\" | \"did\" | \"computed\" | \"battery\"\n62\t    bus: str                        # \"can_c\" | \"can_ihs\" | \"can_ch\" | \"\"\n63\t    confidence: str\n64\t    default_rate_hz: float\n65\t    pid: str = \"\"\n66\t    module: str = \"\"\n67\t    did: int = 0\n68\t    formula: str = \"\"\n69\t    field: str = \"\"                 # sub-field name for a multi-field DID formula\n70\t    expr: str = \"\"\n71\t    depends_on: tuple[str, ...] = ()\n72\t    note: str = \"\"\n73\t\n74\t    def to_dict(self) -> dict[str, Any]:\n75\t        out: dict[str, Any] = {\n76\t            \"id\": self.id, \"name\": self.name, \"unit\": self.unit, \"kind\": self.kind,\n77\t            \"bus\": self.bus, \"confidence\": self.confidence,\n78\t            \"default_rate_hz\": self.default_rate_hz,\n79\t        }\n80\t        if self.kind == \"pid\":\n81\t            out[\"pid\"] = self.pid\n82\t        elif self.kind == \"did\":\n83\t            out[\"module\"] = self.module\n84\t            out[\"did\"] = f\"{self.did:04X}\"\n85\t            if self.formula:\n86\t                out[\"formula\"] = self.formula\n87\t            if self.field:\n88\t                out[\"field\"] = self.field\n89\t        elif self.kind == \"computed\":\n90\t            out[\"expr\"] = self.expr\n91\t            out[\"depends_on\"] = list(self.depends_on)\n92\t        if self.note:\n93\t            out[\"note\"] = self.note\n94\t        return out\n95\t\n96\t\n97\tdef _slug(name: str) -> str:\n98\t    s = re.sub(r\"[^a-z0-9]+\", \"_\", name.strip().lower()).strip(\"_\")\n99\t    return s or \"field\"\n100\t\n101\t\n102\tdef _pid_rate(name: str) -> float:\n103\t    if name in _FAST_PIDS:\n104\t        return FAST_HZ\n105\t    if name in _SLOW_PIDS:\n106\t        return SLOW_HZ\n107\t    return MED_HZ\n108\t\n109\t\n110\tdef _pid_channels() -> list[Channel]:\n111\t    return [\n112\t        Channel(id=spec.name, name=spec.name.replace(\"_\", \" \"), unit=spec.unit,\n113\t               kind=\"pid\", bus=\"can_c\", confidence=\"legislated\",\n114\t               default_rate_hz=_pid_rate(spec.name), pid=spec.pid,\n115\t               note=spec.description)\n116\t        for spec in PIDS_BY_HEX.values()\n117\t    ]\n118\t\n119\t\n120\tdef _battery_channel() -> Channel:\n121\t    return Channel(id=\"battery_voltage\", name=\"battery voltage\", unit=\"V\",\n122\t                   kind=\"battery\", bus=\"can_c\", confidence=\"legislated\",\n123\t                   default_rate_hz=SLOW_HZ)\n124\t\n125\t\n126\tdef _multi_field_names(formula: str) -> Optional[list[str]]:\n127\t    \"\"\"Field names of a real multi-field formula (``a=...; b=...``).\n128\t\n129\t    Distinguishes an actual multi-clause CarScanner formula from the\n130\t    ``\"multi-field\"`` sentinel some catalog rows use in place of a real,\n131\t    machine-parseable formula (e.g. the BCM IBS composite DID, whose fields\n132\t    are only described in prose) -- those get a single undecoded channel.\n133\t    \"\"\"\n134\t    if not formula or formula == \"multi-field\":\n135\t        return None\n136\t    if \";\" not in formula and \"=\" not in formula:\n137\t        return None\n138\t    names: list[str] = []\n139\t    for clause in formula.split(\";\"):\n140\t        clause = clause.strip()\n141\t        if not clause or \"=\" not in clause:\n142\t            return None\n143\t        name, _, _expr = clause.partition(\"=\")\n144\t        name = name.strip()\n145\t        if not name:\n146\t            return None\n147\t        names.append(name)\n148\t    return names or None\n149\t\n150\t\n151\tdef _did_channels() -> list[Channel]:\n152\t    out: list[Channel] = []\n153\t    for code in DID_MODULES:\n154\t        ecu = by_code(code)\n155\t        bus = ecu.bus_key if ecu else \"can_c\"\n156\t        for spec in did_catalog.all_dids(code, include_diesel=False):\n157\t            base_id = f\"{code.lower()}_{spec.did:04x}\"\n158\t            fields = _multi_field_names(spec.formula)\n159\t            if fields:\n160\t                for fname in fields:\n161\t                    out.append(Channel(\n162\t                        id=f\"{base_id}_{_slug(fname)}\", name=f\"{spec.name} ({fname})\",\n163\t                        unit=spec.unit, kind=\"did\", bus=bus, confidence=spec.confidence,\n164\t                        default_rate_hz=MED_HZ, module=code, did=spec.did,\n165\t                        formula=spec.formula, field=fname, note=spec.note))\n166\t            else:\n167\t                formula = \"\" if spec.formula == \"multi-field\" else spec.formula\n168\t                out.append(Channel(\n169\t                    id=base_id, name=spec.name, unit=spec.unit, kind=\"did\", bus=bus,\n170\t                    confidence=spec.confidence, default_rate_hz=MED_HZ, module=code,\n171\t                    did=spec.did, formula=formula, note=spec.note))\n172\t    return out\n173\t\n174\t\n175\t#: Sentinel used by a placeholder channel's ``did`` field to mean \"no real\n176\t#: DID exists -- never poll this\". A real catalogued DID is always nonzero,\n177\t#: so 0 is safe as a deliberate \"unknown\" marker (see :func:`resolve_channels`,\n178\t#: which refuses to add any channel using this sentinel to a poll list).\n179\tUNKNOWN_DID = 0\n180\t\n181\t#: ``cuore.live.did_catalog``'s own research note: the EVAP vent/canister\n182\t#: actuator is exposed on this car as an \"ESIM\" (Evaporative System\n183\t#: Integrity Monitor) UDS 0x31 RoutineControl, not a readable DID -- and\n184\t#: RoutineControl is a write service, refused outright by\n185\t#: ``assert_read_only_uds`` before a byte leaves the adapter. There is no\n186\t#: DID to catalogue, so this is a documented placeholder, not a real\n187\t#: channel: present in the registry (so it is visible and self-explaining\n188\t#: rather than silently missing) but never pollable (``did=UNKNOWN_DID``;\n189\t#: :func:`resolve_channels` refuses it) and never added to any preset.\n190\tdef _placeholder_channels() -> list[Channel]:\n191\t    return [\n192\t        Channel(id=\"esim_status\", name=\"ESIM status (no readable DID)\", unit=\"\",\n193\t               kind=\"did\", bus=\"can_c\", confidence=\"unknown_did\",\n194\t               default_rate_hz=SLOW_HZ, module=\"ECM\", did=UNKNOWN_DID,\n195\t               note=\"ESIM (Evaporative System Integrity Monitor) is exposed only \"\n196\t                    \"as a UDS 0x31 RoutineControl, not a readable DID, per \"\n197\t                    \"cuore.live.did_catalog's own research note -- refused by \"\n198\t                    \"assert_read_only_uds before a byte leaves the adapter. \"\n199\t                    \"Placeholder only: resolve_channels() refuses to poll it.\"),\n200\t    ]\n201\t\n202\t\n203\tdef _computed_channels() -> list[Channel]:\n204\t    return [\n205\t        Channel(id=\"boost\", name=\"boost (MAP - baro)\", unit=\"kPa\", kind=\"computed\",\n206\t               bus=\"can_c\", confidence=\"computed\", default_rate_hz=MED_HZ,\n207\t               expr=\"intake_map - barometric_pressure\",\n208\t               depends_on=(\"intake_map\", \"barometric_pressure\"),\n209\t               note=\"derived from the two legislated PIDs; compare against the \"\n210\t                    \"unverified ECM boost DID 195A\"),\n211\t    ]\n212\t\n213\t\n214\tdef _builtin_channels() -> list[Channel]:\n215\t    return (_pid_channels() + _did_channels() + [_battery_channel()]\n216\t           + _computed_channels() + _placeholder_channels())\n217\t\n218\t\n219\tdef builtin_channel_ids() -> set[str]:\n220\t    \"\"\"Ids of every channel this project ships with -- excludes saved custom channels.\n221\t\n222\t    :mod:`ui_store` uses this (not :func:`registry`) to decide whether a\n223\t    submitted custom channel id collides with something built-in -- as\n224\t    opposed to an existing custom channel of the same id simply being\n225\t    re-saved, which must be allowed.\n226\t    \"\"\"\n227\t    return {c.id for c in _builtin_channels()}\n228\t\n229\t\n230\tdef available_channels() -> list[Channel]:\n231\t    \"\"\"Every channel this project knows how to sample, including saved custom ones.\"\"\"\n232\t    from . import ui_store  # local: ui_store imports this module; avoid a cycle at import time\n233\t    return _builtin_channels() + ui_store.load_custom_channels()\n234\t\n235\t\n236\t_REGISTRY: Optional[dict[str, Channel]] = None\n237\t\n238\t\n239\tdef registry() -> dict[str, Channel]:\n240\t    global _REGISTRY\n241\t    if _REGISTRY is None:\n242\t        _REGISTRY = {c.id: c for c in available_channels()}\n243\t    return _REGISTRY\n244\t\n245\t\n246\tdef invalidate_registry() -> None:\n247\t    \"\"\"Force the next :func:`registry`/:func:`by_id` call to recompute.\n248\t\n249\t    Called after custom channels are saved so a running dashboard sees new\n250\t    custom channels (and formula/expr edits to existing ones) without a\n251\t    process restart.\n252\t    \"\"\"\n253\t    global _REGISTRY\n254\t    _REGISTRY = None\n255\t\n256\t\n257\tdef by_id(channel_id: str) -> Channel:\n258\t    ch = registry().get(channel_id)\n259\t    if ch is None:\n260\t        raise BadCommand(f\"unknown channel id {channel_id!r}\")\n261\t    return ch\n262\t\n263\t\n264\t#: One-click starts. Every id here must resolve through :func:`by_id`; a\n265\t#: mismatch would be a bug in this file, not caller input, so it is not\n266\t#: guarded -- :func:`resolve_channels` raising KeyError on a typo here during\n267\t#: development is preferable to silently dropping a channel from a preset.\n268\tPRESETS: dict[str, tuple[str, ...]] = {\n269\t    \"engine_basics\": (\"engine_rpm\", \"vehicle_speed\", \"engine_coolant_temp\",\n270\t                      \"intake_air_temp\", \"absolute_load\", \"throttle_position\",\n271\t                      \"battery_voltage\"),\n272\t    \"boost\": (\"intake_map\", \"barometric_pressure\", \"boost\", \"ecm_195a\"),\n273\t    \"evap_job\": (\"commanded_evap_purge\", \"fuel_level\", \"evap_vapor_pressure\",\n274\t                \"evap_vapor_pressure_abs\", \"engine_coolant_temp\", \"intake_air_temp\"),\n275\t    \"transmission\": (\"tcm_04fe\", \"tcm_0518\"),\n276\t    \"tpms\": (\"rfhub_40b1_pressure\", \"rfhub_40b1_temp\", \"rfhub_40b2_pressure\",\n277\t            \"rfhub_40b2_temp\", \"rfhub_40b3_pressure\", \"rfhub_40b3_temp\",\n278\t            \"rfhub_40b4_pressure\", \"rfhub_40b4_temp\"),\n279\t    # Deliberately omits \"esim_status\": no DID exists for it (see\n280\t    # _placeholder_channels), and resolve_channels() refuses to poll it --\n281\t    # a preset listing it would make this whole preset unresolvable.\n282\t    \"evap_test_a\": (\"fuel_level\", \"commanded_evap_purge\", \"evap_vapor_pressure_abs\",\n283\t                    \"engine_rpm\", \"engine_coolant_temp\"),\n284\t}\n285\t\n286\t\n287\tdef presets() -> dict[str, list[dict[str, Any]]]:\n288\t    reg = registry()\n289\t    return {name: [reg[cid].to_dict() for cid in ids if cid in reg]\n290\t            for name, ids in PRESETS.items()}\n291\t\n292\t\n293\t# ===========================================================================\n294\t# per-bus capture presets -- what a bypass cable unlocks, catalogue only\n295\t# ===========================================================================\n296\t#\n297\t# Distinct from PRESETS above: those are active-poll channel groups for the\n298\t# dashboard (a Mode 01 PID or a UDS DID the adapter is asked for at a rate).\n299\t# These describe what a *bus capture* (passive listen, see\n300\t# :mod:`cuore.live.buscapture`) is worth starting on CAN-IHS/CAN-CH once a\n301\t# bypass cable is declared. Every wanted item resolves against\n302\t# :data:`did_catalog.BROADCAST_SIGNALS` (public passive-signal research) or\n303\t# an accepted :mod:`cuore.live.learned` broadcast entry for the VIN -- never\n304\t# invented. An item with neither is reported ``\"unknown_did\"`` and is never\n305\t# polled or implied to exist.\n306\t\n307\t#: ``bus``/``cable`` say what :func:`cuore.live.buses.route_for` must allow\n308\t#: before this preset may start. ``wanted`` is ``(label, signal_name)``;\n309\t#: ``signal_name`` is a ``did_catalog.BROADCAST_SIGNALS`` ``\"signal\"`` value,\n310\t#: or ``None`` when no public broadcast-signal source was found for it (the\n311\t#: item is still listed, as ``\"unknown_did\"``, never silently dropped).\n312\tBUS_CAPTURE_PRESETS: dict[str, dict[str, Any]] = {\n313\t    \"chassis_a6\": {\n314\t        \"bus\": \"can_ch\", \"cable\": \"grey_a6\",\n315\t        \"name\": \"Chassis / ADAS (CAN-CH)\",\n316\t        \"wanted\": (\n317\t            (\"Wheel speed FL\", \"WHEEL_SPEED_FL\"),\n318\t            (\"Wheel speed FR\", \"WHEEL_SPEED_FR\"),\n319\t            (\"Wheel speed RL\", \"WHEEL_SPEED_RL\"),\n320\t            (\"Wheel speed RR\", \"WHEEL_SPEED_RR\"),\n321\t            (\"Brake pressure\", None),\n322\t            (\"Steering angle\", \"STEERING_ANGLE\"),\n323\t            (\"Yaw rate\", \"YAW_RATE\"),\n324\t        ),\n325\t    },\n326\t    \"body_a5\": {\n327\t        \"bus\": \"can_ihs\", \"cable\": \"blue_a5\",\n328\t        \"name\": \"Body / comfort (CAN-IHS)\",\n329\t        \"wanted\": (\n330\t            (\"HVAC temperature\", None),\n331\t            (\"Battery monitor\", None),\n332\t            (\"Driver door state\", None),\n333\t            (\"Passenger door state\", None),\n334\t        ),\n335\t    },\n336\t}\n337\t\n338\t\n339\tdef bus_capture_preset(name: str, vin: str = \"\") -> dict[str, Any]:\n340\t    \"\"\"One bus-capture preset: its bus/cable requirement and every wanted\n341\t    item resolved against the broadcast-signal catalogue, then (for anything\n342\t    the catalogue does not cover) this VIN's accepted learned broadcast\n343\t    signals. Never invents a scale or a channel for an item neither source\n344\t    has -- that item comes back ``status: \"unknown_did\"``.\"\"\"\n345\t    spec = BUS_CAPTURE_PRESETS.get(name)\n346\t    if spec is None:\n347\t        raise BadCommand(f\"unknown bus-capture preset {name!r}; one of \"\n348\t                         f\"{sorted(BUS_CAPTURE_PRESETS)}\")\n349\t    by_signal = {s[\"signal\"]: s for s in did_catalog.BROADCAST_SIGNALS}\n350\t    learned_by_name: dict[str, Any] = {}\n351\t    if vin:\n352\t        from . import learned as learned_mod\n353\t        for e in learned_mod.learned_broadcast(vin, bus=spec[\"bus\"]).get(vin, []):\n354\t            learned_by_name[(e.get(\"name\") or \"\").lower()] = e\n355\t\n356\t    items: list[dict[str, Any]] = []\n357\t    for label, signal_key in spec[\"wanted\"]:\n358\t        sig = by_signal.get(signal_key) if signal_key else None\n359\t        learned_entry = learned_by_name.get(label.lower())\n360\t        if sig is not None:\n361\t            items.append({\n362\t                \"label\": label, \"status\": \"known\", \"signal\": signal_key,\n363\t                \"can_id\": sig[\"can_id\"], \"unit\": sig.get(\"unit\", \"\"),\n364\t                \"confidence\": sig.get(\"confidence\", \"unverified\"),\n365\t                \"source\": sig.get(\"source\", \"\"), \"note\": sig.get(\"note\", \"\"),\n366\t            })\n367\t        elif learned_entry is not None:\n368\t            items.append({\n369\t                \"label\": label, \"status\": \"learned\", \"can_id\": learned_entry.get(\"id\"),\n370\t                \"field\": learned_entry.get(\"field\"), \"scale\": learned_entry.get(\"scale\"),\n371\t                \"note\": \"learned, unscaled\",\n372\t            })\n373\t        else:\n374\t            items.append({\"label\": label, \"status\": \"unknown_did\",\n375\t                          \"note\": \"no DID or broadcast signal in the catalogue, and nothing \"\n376\t                                  \"learned yet for this VIN -- not polled\"})\n377\t    return {\"preset\": name, \"name\": spec[\"name\"], \"bus\": spec[\"bus\"],\n378\t           \"cable_required\": spec[\"cable\"], \"items\": items}\n379\t\n380\t\n381\tdef resolve_channels(channel_ids: Optional[list[str]] = None, preset: str = \"\") -> list[Channel]:\n382\t    \"\"\"``channel_ids`` and/or a named preset, deduplicated, computed channels'\n383\t    dependencies pulled in automatically so they are always polled too.\"\"\"\n384\t    chosen: list[str] = []\n385\t    if preset:\n386\t        if preset not in PRESETS:\n387\t            raise BadCommand(f\"unknown preset {preset!r}; one of {sorted(PRESETS)}\")\n388\t        chosen.extend(PRESETS[preset])\n389\t    for cid in (channel_ids or []):\n390\t        if cid not in chosen:\n391\t            chosen.append(cid)\n392\t    if not chosen:\n393\t        raise BadCommand(\"pass channels=[...] or preset=...\")\n394\t\n395\t    result: list[Channel] = []\n396\t    seen: set[str] = set()\n397\t\n398\t    def add(cid: str) -> None:\n399\t        if cid in seen:\n400\t            return\n401\t        ch = by_id(cid)\n402\t        if ch.kind == \"did\" and ch.did == UNKNOWN_DID:\n403\t            raise BadCommand(\n404\t                f\"channel {cid!r} has no readable DID ({ch.note or 'unknown DID'}); \"\n405\t                \"it cannot be polled\")\n406\t        seen.add(cid)\n407\t        for dep in ch.depends_on:\n408\t            add(dep)\n409\t        result.append(ch)\n410\t\n411\t    for cid in chosen:\n412\t        add(cid)\n413\t    return result\n414\t\n415\t\n416\t# ===========================================================================\n417\t# the computed-channel evaluator: arithmetic over channel ids, no eval()\n418\t# ===========================================================================\n419\t\n420\tclass ComputedError(Exception):\n421\t    \"\"\"Raised for anything outside the safe arithmetic grammar below.\"\"\"\n422\t\n423\t\n424\t_OPS = frozenset(\"+-*/()\")\n425\t\n426\t\n427\tdef _tokenize_expr(text: str) -> list[tuple[str, str]]:\n428\t    tokens: list[tuple[str, str]] = []\n429\t    i, n = 0, len(text)\n430\t    while i < n:\n431\t        c = text[i]\n432\t        if c.isspace():\n433\t            i += 1\n434\t            continue\n435\t        if c in _OPS:\n436\t            tokens.append((c, c))\n437\t            i += 1\n438\t            continue\n439\t        if c.isdigit() or c == \".\":\n440\t            j = i\n441\t            seen_dot = False\n442\t            while j < n and (text[j].isdigit() or (text[j] == \".\" and not seen_dot)):\n443\t                seen_dot = seen_dot or text[j] == \".\"\n444\t                j += 1\n445\t            tokens.append((\"NUM\", text[i:j]))\n446\t            i = j\n447\t            continue\n448\t        if c.isalpha() or c == \"_\":\n449\t            j = i\n450\t            while j < n and (text[j].isalnum() or text[j] == \"_\"):\n451\t                j += 1\n452\t            tokens.append((\"ID\", text[i:j]))\n453\t            i = j\n454\t            continue\n455\t        raise ComputedError(f\"unsupported character {c!r} in expression {text!r}\")\n456\t    return tokens\n457\t\n458\t\n459\t# AST nodes: (\"num\", value) | (\"ref\", channel_id) | (\"unary\", op, node)\n460\t# | (\"binop\", op, left, right)\n461\t\n462\tclass _ExprParser:\n463\t    def __init__(self, tokens: list[tuple[str, str]]) -> None:\n464\t        self.tokens = tokens\n465\t        self.pos = 0\n466\t\n467\t    def _peek(self) -> tuple[Optional[str], Optional[str]]:\n468\t        return self.tokens[self.pos] if self.pos < len(self.tokens) else (None, None)\n469\t\n470\t    def _advance(self) -> tuple[Optional[str], Optional[str]]:\n471\t        tok = self._peek()\n472\t        self.pos += 1\n473\t        return tok\n474\t\n475\t    def _expect(self, kind: str) -> None:\n476\t        got, _ = self._advance()\n477\t        if got != kind:\n478\t            raise ComputedError(f\"expected {kind!r}, found {got!r}\")\n479\t\n480\t    def parse(self):\n481\t        node = self._expr()\n482\t        if self.pos != len(self.tokens):\n483\t            raise ComputedError(f\"unexpected trailing input at token {self.pos}\")\n484\t        return node\n485\t\n486\t    def _expr(self):\n487\t        node = self._term()\n488\t        while self._peek()[0] in (\"+\", \"-\"):\n489\t            op, _ = self._advance()\n490\t            node = (\"binop\", op, node, self._term())\n491\t        return node\n492\t\n493\t    def _term(self):\n494\t        node = self._factor()\n495\t        while self._peek()[0] in (\"*\", \"/\"):\n496\t            op, _ = self._advance()\n497\t            node = (\"binop\", op, node, self._factor())\n498\t        return node\n499\t\n500\t    def _factor(self):\n501\t        kind, _ = self._peek()\n502\t        if kind in (\"+\", \"-\"):\n503\t            self._advance()\n504\t            return (\"unary\", kind, self._factor())\n505\t        return self._primary()\n506\t\n507\t    def _primary(self):\n508\t        kind, val = self._advance()\n509\t        if kind == \"NUM\":\n510\t            return (\"num\", float(val))\n511\t        if kind == \"ID\":\n512\t            return (\"ref\", val)\n513\t        if kind == \"(\":\n514\t            node = self._expr()\n515\t            self._expect(\")\")\n516\t            return node\n517\t        raise ComputedError(f\"unexpected token {kind!r}\")\n518\t\n519\t\n520\tdef _eval_node(node, values: dict[str, float]) -> float:\n521\t    kind = node[0]\n522\t    if kind == \"num\":\n523\t        return node[1]\n524\t    if kind == \"ref\":\n525\t        v = values.get(node[1])\n526\t        if v is None:\n527\t            raise ComputedError(f\"expression references unavailable channel {node[1]!r}\")\n528\t        return v\n529\t    if kind == \"unary\":\n530\t        v = _eval_node(node[2], values)\n531\t        return -v if node[1] == \"-\" else v\n532\t    if kind == \"binop\":\n533\t        op = node[1]\n534\t        left = _eval_node(node[2], values)\n535\t        right = _eval_node(node[3], values)\n536\t        if op == \"+\":\n537\t            return left + right\n538\t        if op == \"-\":\n539\t            return left - right\n540\t        if op == \"*\":\n541\t            return left * right\n542\t        if op == \"/\":\n543\t            if right == 0:\n544\t                raise ComputedError(\"division by zero\")\n545\t            return left / right\n546\t    raise ComputedError(f\"malformed AST node {node!r}\")  # pragma: no cover - defensive\n547\t\n548\t\n549\tdef eval_expr(expr: str, values: dict[str, float]) -> float:\n550\t    \"\"\"Evaluate a computed-channel expression over ``{channel_id: value}``.\n551\t\n552\t    Arithmetic only (``+ - * /``, parentheses, unary minus, numbers and\n553\t    channel-id identifiers) -- there is no ``eval()`` anywhere in this\n554\t    module, so an expression outside the grammar simply cannot execute.\n555\t    \"\"\"\n556\t    text = expr.strip()\n557\t    if not text:\n558\t        raise ComputedError(\"empty expression\")\n559\t    return _eval_node(_ExprParser(_tokenize_expr(text)).parse(), values)\n560\t\n561\t\n562\t__all__ = [\"Channel\", \"available_channels\", \"registry\", \"invalidate_registry\",\n563\t          \"builtin_channel_ids\", \"by_id\", \"PRESETS\", \"presets\",\n564\t          \"BUS_CAPTURE_PRESETS\", \"bus_capture_preset\",\n565\t          \"resolve_channels\", \"ComputedError\", \"eval_expr\", \"DID_MODULES\",\n566\t          \"FAST_HZ\", \"MED_HZ\", \"SLOW_HZ\", \"UNKNOWN_DID\"]\n567\t"}]},"uuid":"bd680820-2a8d-465f-8626-3d08128b8517","timestamp":"2026-10-14T17:57:31.421Z","toolUseResult":{"type":"text","file":{"filePath":"C:\\Users\\User\\mcp-servers\\cuore\\live\\channels.py","content":"\"\"\"The live-data channel model: a registry of everything the poller can sample.\n\nA channel is ``{id, name, unit, source}``. Four source kinds:\n\n* ``pid``    -- a Mode 01 PID (hex), decoded by :func:`obd.decode_pid`.\n* ``did``    -- a module code + UDS DID (hex) + CarScanner formula, evaluated\n  with :func:`readall.eval_formula`. Every catalogued DID for ECM, TCM, BCM,\n  IPC and RFHUB (:func:`did_catalog.all_dids`) is included, at its recorded\n  confidence. A DID whose formula answers with several named fields (the\n  RFHUB tire DIDs: ``pressure=...; temp=...``) is expanded into one channel\n  per field, sharing the one DID read.\n* ``computed`` -- an arithmetic expression over other channel ids, evaluated\n  by the small safe evaluator below (no ``eval()`` anywhere in this module).\n* ``battery``  -- adapter ``ATRV``.\n\n:func:`available_channels` returns the whole registry; :func:`presets`\ngroups channel ids for one-click starts on this car.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport re\nfrom dataclasses import dataclass\nfrom typing import Any, Optional\n\nfrom . import did_catalog\nfrom .addressing import by_code\nfrom .errors import BadCommand\nfrom .obd import PIDS_BY_HEX\n\nFAST_HZ = 5.0\nMED_HZ = 1.0\nSLOW_HZ = 0.5\n\n#: PIDs worth sampling quickly -- the ones that change fast enough to matter\n#: for a live dashboard (RPM, speed, throttle). ``throttle_b``/\n#: ``accel_pedal_d``/``accel_pedal_e`` (new J1979 PIDs 47/49/4A) are added\n#: here on the same reasoning as ``throttle_position`` -- pedal/throttle\n#: position tracks driver input in real time. Harmless if the decoder for\n#: one of these names has not landed in ``cuore.live.obd`` yet: this set is\n#: just names, consulted only once the matching PID channel exists.\n_FAST_PIDS = {\"engine_rpm\", \"vehicle_speed\", \"throttle_position\",\n             \"throttle_b\", \"accel_pedal_d\", \"accel_pedal_e\"}\n#: Slow-moving readings: temperatures, ambient/barometric pressure, fuel level.\n#: ``intake_air_temp_b1`` (PID 68), ``egr_temp`` (PID 6B) and\n#: ``catalyst_temp_b1s1`` (PID 3C) are new J1979 temperature PIDs added on\n#: the same reasoning as ``intake_air_temp``/``engine_oil_temp`` above.\n_SLOW_PIDS = {\"engine_coolant_temp\", \"intake_air_temp\", \"ambient_air_temp\",\n             \"barometric_pressure\", \"fuel_level\", \"engine_oil_temp\",\n             \"intake_air_temp_b1\", \"egr_temp\", \"catalyst_temp_b1s1\"}\n\n#: Modules whose catalogued DIDs are worth exposing as channels.\nDID_MODULES: tuple[str, ...] = (\"ECM\", \"TCM\", \"BCM\", \"IPC\", \"RFHUB\")\n\n\n@dataclass(frozen=True)\nclass Channel:\n    id: str\n    name: str\n    unit: str\n    kind: str                       # \"pid\" | \"did\" | \"computed\" | \"battery\"\n    bus: str                        # \"can_c\" | \"can_ihs\" | \"can_ch\" | \"\"\n    confidence: str\n    default_rate_hz: float\n    pid: str = \"\"\n    module: str = \"\"\n    did: int = 0\n    formula: str = \"\"\n    field: str = \"\"                 # sub-field name for a multi-field DID formula\n    expr: str = \"\"\n    depends_on: tuple[str, ...] = ()\n    note: str = \"\"\n\n    def to_dict(self) -> dict[str, Any]:\n        out: dict[str, Any] = {\n            \"id\": self.id, \"name\": self.name, \"unit\": self.unit, \"kind\": self.kind,\n            \"bus\": self.bus, \"confidence\": self.confidence,\n            \"default_rate_hz\": self.default_rate_hz,\n        }\n        if self.kind == \"pid\":\n            out[\"pid\"] = self.pid\n        elif self.kind == \"did\":\n            out[\"module\"] = self.module\n            out[\"did\"] = f\"{self.did:04X}\"\n            if self.formula:\n                out[\"formula\"] = self.formula\n            if self.field:\n                out[\"field\"] = self.field\n        elif self.kind == \"computed\":\n            out[\"expr\"] = self.expr\n            out[\"depends_on\"] = list(self.depends_on)\n        if self.note:\n            out[\"note\"] = self.note\n        return out\n\n\ndef _slug(name: str) -> str:\n    s = re.sub(r\"[^a-z0-9]+\", \"_\", name.strip().lower()).strip(\"_\")\n    return s or \"field\"\n\n\ndef _pid_rate(name: str) -> float:\n    if name in _FAST_PIDS:\n        return FAST_HZ\n    if name in _SLOW_PIDS:\n        return SLOW_HZ\n    return MED_HZ\n\n\ndef _pid_channels() -> list[Channel]:\n    return [\n        Channel(id=spec.name, name=spec.name.replace(\"_\", \" \"), unit=spec.unit,\n               kind=\"pid\", bus=\"can_c\", confidence=\"legislated\",\n               default_rate_hz=_pid_rate(spec.name), pid=spec.pid,\n               note=spec.description)\n        for spec in PIDS_BY_HEX.values()\n    ]\n\n\ndef _battery_channel() -> Channel:\n    return Channel(id=\"battery_voltage\", name=\"battery voltage\", unit=\"V\",\n                   kind=\"battery\", bus=\"can_c\", confidence=\"legislated\",\n                   default_rate_hz=SLOW_HZ)\n\n\ndef _multi_field_names(formula: str) -> Optional[list[str]]:\n    \"\"\"Field names of a real multi-field formula (``a=...; b=...``).\n\n    Distinguishes an actual multi-clause CarScanner formula from the\n    ``\"multi-field\"`` sentinel some catalog rows use in place of a real,\n    machine-parseable formula (e.g. the BCM IBS composite DID, whose fields\n    are only described in prose) -- those get a single undecoded channel.\n    \"\"\"\n    if not formula or formula == \"multi-field\":\n        return None\n    if \";\" not in formula and \"=\" not in formula:\n        return None\n    names: list[str] = []\n    for clause in formula.split(\";\"):\n        clause = clause.strip()\n        if not clause or \"=\" not in clause:\n            return None\n        name, _, _expr = clause.partition(\"=\")\n        name = name.strip()\n        if not name:\n            return None\n        names.append(name)\n    return names or None\n\n\ndef _did_channels() -> list[Channel]:\n    out: list[Channel] = []\n    for code in DID_MODULES:\n        ecu = by_code(code)\n        bus = ecu.bus_key if ecu else \"can_c\"\n        for spec in did_catalog.all_dids(code, include_diesel=False):\n            base_id = f\"{code.lower()}_{spec.did:04x}\"\n            fields = _multi_field_names(spec.formula)\n            if fields:\n                for fname in fields:\n                    out.append(Channel(\n                        id=f\"{base_id}_{_slug(fname)}\", name=f\"{spec.name} ({fname})\",\n                        unit=spec.unit, kind=\"did\", bus=bus, confidence=spec.confidence,\n                        default_rate_hz=MED_HZ, module=code, did=spec.did,\n                        formula=spec.formula, field=fname, note=spec.note))\n            else:\n                formula = \"\" if spec.formula == \"multi-field\" else spec.formula\n                out.append(Channel(\n                    id=base_id, name=spec.name, unit=spec.unit, kind=\"did\", bus=bus,\n                    confidence=spec.confidence, default_rate_hz=MED_HZ, module=code,\n                    did=spec.did, formula=formula, note=spec.note))\n    return out\n\n\n#: Sentinel used by a placeholder channel's ``did`` field to mean \"no real\n#: DID exists -- never poll this\". A real catalogued DID is always nonzero,\n#: so 0 is safe as a deliberate \"unknown\" marker (see :func:`resolve_channels`,\n#: which refuses to add any channel using this sentinel to a poll list).\nUNKNOWN_DID = 0\n\n#: ``cuore.live.did_catalog``'s own research note: the EVAP vent/canister\n#: actuator is exposed on this car as an \"ESIM\" (Evaporative System\n#: Integrity Monitor) UDS 0x31 RoutineControl, not a readable DID -- and\n#: RoutineControl is a write service, refused outright by\n#: ``assert_read_only_uds`` before a byte leaves the adapter. There is no\n#: DID to catalogue, so this is a documented placeholder, not a real\n#: channel: present in the registry (so it is visible and self-explaining\n#: rather than silently missing) but never pollable (``did=UNKNOWN_DID``;\n#: :func:`resolve_channels` refuses it) and never added to any preset.\ndef _placeholder_channels() -> list[Channel]:\n    return [\n        Channel(id=\"esim_status\", name=\"ESIM status (no readable DID)\", unit=\"\",\n               kind=\"did\", bus=\"can_c\", confidence=\"unknown_did\",\n               default_rate_hz=SLOW_HZ, module=\"ECM\", did=UNKNOWN_DID,\n               note=\"ESIM (Evaporative System Integrity Monitor) is exposed only \"\n                    \"as a UDS 0x31 RoutineControl, not a readable DID, per \"\n                    \"cuore.live.did_catalog's own research note -- refused by \"\n                    \"assert_read_only_uds before a byte leaves the adapter. \"\n                    \"Placeholder only: resolve_channels() refuses to poll it.\"),\n    ]\n\n\ndef _computed_channels() -> list[Channel]:\n    return [\n        Channel(id=\"boost\", name=\"boost (MAP - baro)\", unit=\"kPa\", kind=\"computed\",\n               bus=\"can_c\", confidence=\"computed\", default_rate_hz=MED_HZ,\n               expr=\"intake_map - barometric_pressure\",\n               depends_on=(\"intake_map\", \"barometric_pressure\"),\n               note=\"derived from the two legislated PIDs; compare against the \"\n                    \"unverified ECM boost DID 195A\"),\n    ]\n\n\ndef _builtin_channels() -> list[Channel]:\n    return (_pid_channels() + _did_channels() + [_battery_channel()]\n           + _computed_channels() + _placeholder_channels())\n\n\ndef builtin_channel_ids() -> set[str]:\n    \"\"\"Ids of every channel this project ships with -- excludes saved custom channels.\n\n    :mod:`ui_store` uses this (not :func:`registry`) to decide whether a\n    submitted custom channel id collides with something built-in -- as\n    opposed to an existing custom channel of the same id simply being\n    re-saved, which must be allowed.\n    \"\"\"\n    return {c.id for c in _builtin_channels()}\n\n\ndef available_channels() -> list[Channel]:\n    \"\"\"Every channel this project knows how to sample, including saved custom ones.\"\"\"\n    from . import ui_store  # local: ui_store imports this module; avoid a cycle at import time\n    return _builtin_channels() + ui_store.load_custom_channels()\n\n\n_REGISTRY: Optional[dict[str, Channel]] = None\n\n\ndef registry() -> dict[str, Channel]:\n    global _REGISTRY\n    if _REGISTRY is None:\n        _REGISTRY = {c.id: c for c in available_channels()}\n    return _REGISTRY\n\n\ndef invalidate_registry() -> None:\n    \"\"\"Force the next :func:`registry`/:func:`by_id` call to recompute.\n\n    Called after custom channels are saved so a running dashboard sees new\n    custom channels (and formula/expr edits to existing ones) without a\n    process restart.\n    \"\"\"\n    global _REGISTRY\n    _REGISTRY = None\n\n\ndef by_id(channel_id: str) -> Channel:\n    ch = registry().get(channel_id)\n    if ch is None:\n        raise BadCommand(f\"unknown channel id {channel_id!r}\")\n    return ch\n\n\n#: One-click starts. Every id here must resolve through :func:`by_id`; a\n#: mismatch would be a bug in this file, not caller input, so it is not\n#: guarded -- :func:`resolve_channels` raising KeyError on a typo here during\n#: development is preferable to silently dropping a channel from a preset.\nPRESETS: dict[str, tuple[str, ...]] = {\n    \"engine_basics\": (\"engine_rpm\", \"vehicle_speed\", \"engine_coolant_temp\",\n                      \"intake_air_temp\", \"absolute_load\", \"throttle_position\",\n                      \"battery_voltage\"),\n    \"boost\": (\"intake_map\", \"barometric_pressure\", \"boost\", \"ecm_195a\"),\n    \"evap_job\": (\"commanded_evap_purge\", \"fuel_level\", \"evap_vapor_pressure\",\n                \"evap_vapor_pressure_abs\", \"engine_coolant_temp\", \"intake_air_temp\"),\n    \"transmission\": (\"tcm_04fe\", \"tcm_0518\"),\n    \"tpms\": (\"rfhub_40b1_pressure\", \"rfhub_40b1_temp\", \"rfhub_40b2_pressure\",\n            \"rfhub_40b2_temp\", \"rfhub_40b3_pressure\", \"rfhub_40b3_temp\",\n            \"rfhub_40b4_pressure\", \"rfhub_40b4_temp\"),\n    # Deliberately omits \"esim_status\": no DID exists for it (see\n    # _placeholder_channels), and resolve_channels() refuses to poll it --\n    # a preset listing it would make this whole preset unresolvable.\n    \"evap_test_a\": (\"fuel_level\", \"commanded_evap_purge\", \"evap_vapor_pressure_abs\",\n                    \"engine_rpm\", \"engine_coolant_temp\"),\n}\n\n\ndef presets() -> dict[str, list[dict[str, Any]]]:\n    reg = registry()\n    return {name: [reg[cid].to_dict() for cid in ids if cid in reg]\n            for name, ids in PRESETS.items()}\n\n\n# ===========================================================================\n# per-bus capture presets -- what a bypass cable unlocks, catalogue only\n# ===========================================================================\n#\n# Distinct from PRESETS above: those are active-poll channel groups for the\n# dashboard (a Mode 01 PID or a UDS DID the adapter is asked for at a rate).\n# These describe what a *bus capture* (passive listen, see\n# :mod:`cuore.live.buscapture`) is worth starting on CAN-IHS/CAN-CH once a\n# bypass cable is declared. Every wanted item resolves against\n# :data:`did_catalog.BROADCAST_SIGNALS` (public passive-signal research) or\n# an accepted :mod:`cuore.live.learned` broadcast entry for the VIN -- never\n# invented. An item with neither is reported ``\"unknown_did\"`` and is never\n# polled or implied to exist.\n\n#: ``bus``/``cable`` say what :func:`cuore.live.buses.route_for` must allow\n#: before this preset may start. ``wanted`` is ``(label, signal_name)``;\n#: ``signal_name`` is a ``did_catalog.BROADCAST_SIGNALS`` ``\"signal\"`` value,\n#: or ``None`` when no public broadcast-signal source was found for it (the\n#: item is still listed, as ``\"unknown_did\"``, never silently dropped).\nBUS_CAPTURE_PRESETS: dict[str, dict[str, Any]] = {\n    \"chassis_a6\": {\n        \"bus\": \"can_ch\", \"cable\": \"grey_a6\",\n        \"name\": \"Chassis / ADAS (CAN-CH)\",\n        \"wanted\": (\n            (\"Wheel speed FL\", \"WHEEL_SPEED_FL\"),\n            (\"Wheel speed FR\", \"WHEEL_SPEED_FR\"),\n            (\"Wheel speed RL\", \"WHEEL_SPEED_RL\"),\n            (\"Wheel speed RR\", \"WHEEL_SPEED_RR\"),\n            (\"Brake pressure\", None),\n            (\"Steering angle\", \"STEERING_ANGLE\"),\n            (\"Yaw rate\", \"YAW_RATE\"),\n        ),\n    },\n    \"body_a5\": {\n        \"bus\": \"can_ihs\", \"cable\": \"blue_a5\",\n        \"name\": \"Body / comfort (CAN-IHS)\",\n        \"wanted\": (\n            (\"HVAC temperature\", None),\n            (\"Battery monitor\", None),\n            (\"Driver door state\", None),\n            (\"Passenger door state\", None),\n        ),\n    },\n}\n\n\ndef bus_capture_preset(name: str, vin: str = \"\") -> dict[str, Any]:\n    \"\"\"One bus-capture preset: its bus/cable requirement and every wanted\n    item resolved against the broadcast-signal catalogue, then (for anything\n    the catalogue does not cover) this VIN's accepted learned broadcast\n    signals. Never invents a scale or a channel for an item neither source\n    has -- that item comes back ``status: \"unknown_did\"``.\"\"\"\n    spec = BUS_CAPTURE_PRESETS.get(name)\n    if spec is None:\n        raise BadCommand(f\"unknown bus-capture preset {name!r}; one of \"\n                         f\"{sorted(BUS_CAPTURE_PRESETS)}\")\n    by_signal = {s[\"signal\"]: s for s in did_catalog.BROADCAST_SIGNALS}\n    learned_by_name: dict[str, Any] = {}\n    if vin:\n        from . import learned as learned_mod\n        for e in learned_mod.learned_broadcast(vin, bus=spec[\"bus\"]).get(vin, []):\n            learned_by_name[(e.get(\"name\") or \"\").lower()] = e\n\n    items: list[dict[str, Any]] = []\n    for label, signal_key in spec[\"wanted\"]:\n        sig = by_signal.get(signal_key) if signal_key else None\n        learned_entry = learned_by_name.get(label.lower())\n        if sig is not None:\n            items.append({\n                \"label\": label, \"status\": \"known\", \"signal\": signal_key,\n                \"can_id\": sig[\"can_id\"], \"unit\": sig.get(\"unit\", \"\"),\n                \"confidence\": sig.get(\"confidence\", \"unverified\"),\n                \"source\": sig.get(\"source\", \"\"), \"note\": sig.get(\"note\", \"\"),\n            })\n        elif learned_entry is not None:\n            items.append({\n                \"label\": label, \"status\": \"learned\", \"can_id\": learned_entry.get(\"id\"),\n                \"field\": learned_entry.get(\"field\"), \"scale\": learned_entry.get(\"scale\"),\n                \"note\": \"learned, unscaled\",\n            })\n        else:\n            items.append({\"label\": label, \"status\": \"unknown_did\",\n                          \"note\": \"no DID or broadcast signal in the catalogue, and nothing \"\n                                  \"learned yet for this VIN -- not polled\"})\n    return {\"preset\": name, \"name\": spec[\"name\"], \"bus\": spec[\"bus\"],\n           \"cable_required\": spec[\"cable\"], \"items\": items}\n\n\ndef resolve_channels(channel_ids: Optional[list[str]] = None, preset: str = \"\") -> list[Channel]:\n    \"\"\"``channel_ids`` and/or a named preset, deduplicated, computed channels'\n    dependencies pulled in automatically so they are always polled too.\"\"\"\n    chosen: list[str] = []\n    if preset:\n        if preset not in PRESETS:\n            raise BadCommand(f\"unknown preset {preset!r}; one of {sorted(PRESETS)}\")\n        chosen.extend(PRESETS[preset])\n    for cid in (channel_ids or []):\n        if cid not in chosen:\n            chosen.append(cid)\n    if not chosen:\n        raise BadCommand(\"pass channels=[...] or preset=...\")\n\n    result: list[Channel] = []\n    seen: set[str] = set()\n\n    def add(cid: str) -> None:\n        if cid in seen:\n            return\n        ch = by_id(cid)\n        if ch.kind == \"did\" and ch.did == UNKNOWN_DID:\n            raise BadCommand(\n                f\"channel {cid!r} has no readable DID ({ch.note or 'unknown DID'}); \"\n                \"it cannot be polled\")\n        seen.add(cid)\n        for dep in ch.depends_on:\n            add(dep)\n        result.append(ch)\n\n    for cid in chosen:\n        add(cid)\n    return result\n\n\n# ===========================================================================\n# the computed-channel evaluator: arithmetic over channel ids, no eval()\n# ===========================================================================\n\nclass ComputedError(Exception):\n    \"\"\"Raised for anything outside the safe arithmetic grammar below.\"\"\"\n\n\n_OPS = frozenset(\"+-*/()\")\n\n\ndef _tokenize_expr(text: str) -> list[tuple[str, str]]:\n    tokens: list[tuple[str, str]] = []\n    i, n = 0, len(text)\n    while i < n:\n        c = text[i]\n        if c.isspace():\n            i += 1\n            continue\n        if c in _OPS:\n            tokens.append((c, c))\n            i += 1\n            continue\n        if c.isdigit() or c == \".\":\n            j = i\n            seen_dot = False\n            while j < n and (text[j].isdigit() or (text[j] == \".\" and not seen_dot)):\n                seen_dot = seen_dot or text[j] == \".\"\n                j += 1\n            tokens.append((\"NUM\", text[i:j]))\n            i = j\n            continue\n        if c.isalpha() or c == \"_\":\n            j = i\n            while j < n and (text[j].isalnum() or text[j] == \"_\"):\n                j += 1\n            tokens.append((\"ID\", text[i:j]))\n            i = j\n            continue\n        raise ComputedError(f\"unsupported character {c!r} in expression {text!r}\")\n    return tokens\n\n\n# AST nodes: (\"num\", value) | (\"ref\", channel_id) | (\"unary\", op, node)\n# | (\"binop\", op, left, right)\n\nclass _ExprParser:\n    def __init__(self, tokens: list[tuple[str, str]]) -> None:\n        self.tokens = tokens\n        self.pos = 0\n\n    def _peek(self) -> tuple[Optional[str], Optional[str]]:\n        return self.tokens[self.pos] if self.pos < len(self.tokens) else (None, None)\n\n    def _advance(self) -> tuple[Optional[str], Optional[str]]:\n        tok = self._peek()\n        self.pos += 1\n        return tok\n\n    def _expect(self, kind: str) -> None:\n        got, _ = self._advance()\n        if got != kind:\n            raise ComputedError(f\"expected {kind!r}, found {got!r}\")\n\n    def parse(self):\n        node = self._expr()\n        if self.pos != len(self.tokens):\n            raise ComputedError(f\"unexpected trailing input at token {self.pos}\")\n        return node\n\n    def _expr(self):\n        node = self._term()\n        while self._peek()[0] in (\"+\", \"-\"):\n            op, _ = self._advance()\n            node = (\"binop\", op, node, self._term())\n        return node\n\n    def _term(self):\n        node = self._factor()\n        while self._peek()[0] in (\"*\", \"/\"):\n            op, _ = self._advance()\n            node = (\"binop\", op, node, self._factor())\n        return node\n\n    def _factor(self):\n        kind, _ = self._peek()\n        if kind in (\"+\", \"-\"):\n            self._advance()\n            return (\"unary\", kind, self._factor())\n        return self._primary()\n\n    def _primary(self):\n        kind, val = self._advance()\n        if kind == \"NUM\":\n            return (\"num\", float(val))\n        if kind == \"ID\":\n            return (\"ref\", val)\n        if kind == \"(\":\n            node = self._expr()\n            self._expect(\")\")\n            return node\n        raise ComputedError(f\"unexpected token {kind!r}\")\n\n\ndef _eval_node(node, values: dict[str, float]) -> float:\n    kind = node[0]\n    if kind == \"num\":\n        return node[1]\n    if kind == \"ref\":\n        v = values.get(node[1])\n        if v is None:\n            raise ComputedError(f\"expression references unavailable channel {node[1]!r}\")\n        return v\n    if kind == \"unary\":\n        v = _eval_node(node[2], values)\n        return -v if node[1] == \"-\" else v\n    if kind == \"binop\":\n        op = node[1]\n        left = _eval_node(node[2], values)\n        right = _eval_node(node[3], values)\n        if op == \"+\":\n            return left + right\n        if op == \"-\":\n            return left - right\n        if op == \"*\":\n            return left * right\n        if op == \"/\":\n            if right == 0:\n                raise ComputedError(\"division by zero\")\n            return left / right\n    raise ComputedError(f\"malformed AST node {node!r}\")  # pragma: no cover - defensive\n\n\ndef eval_expr(expr: str, values: dict[str, float]) -> float:\n    \"\"\"Evaluate a computed-channel expression over ``{channel_id: value}``.\n\n    Arithmetic only (``+ - * /``, parentheses, unary minus, numbers and\n    channel-id identifiers) -- there is no ``eval()`` anywhere in this\n    module, so an expression outside the grammar simply cannot execute.\n    \"\"\"\n    text = expr.strip()\n    if not text:\n        raise ComputedError(\"empty expression\")\n    return _eval_node(_ExprParser(_tokenize_expr(text)).parse(), values)\n\n\n__all__ = [\"Channel\", \"available_channels\", \"registry\", \"invalidate_registry\",\n          \"builtin_channel_ids\", \"by_id\", \"PRESETS\", \"presets\",\n          \"BUS_CAPTURE_PRESETS\", \"bus_capture_preset\",\n          \"resolve_channels\", \"ComputedError\", \"eval_expr\", \"DID_MODULES\",\n          \"FAST_HZ\", \"MED_HZ\", \"SLOW_HZ\", \"UNKNOWN_DID\"]\n","numLines":567,"startLine":1,"totalLines":567}},"sourceToolAssistantUUID":"45ab7596-f3e0-4084-9ef8-ab03ebb46c8f","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
