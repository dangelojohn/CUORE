{"parentUuid":"2d123bab-9ca0-4984-ab70-ac1cc9b65b4f","isSidechain":true,"agentId":"ac3048c66f3643aa6","message":{"model":"claude-sonnet-5","id":"msg_011Cg2ZpXFZ75Jn29aYtYN5w","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01JZ55fpNRwX729qeZBviN2h","name":"Read","input":{"file_path":"C:\\Users\\User\\mcp-servers\\mes-log-mcp\\mes\\csvlog.py"},"caller":{"type":"direct"}}],"container":null,"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":877,"cache_read_input_tokens":153929,"output_tokens":80,"output_tokens_details":{"thinking_tokens":0},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":0,"ephemeral_5m_input_tokens":877},"inference_geo":"global","iterations":[{"input_tokens":2,"output_tokens":80,"cache_read_input_tokens":153929,"cache_creation_input_tokens":877,"cache_creation":{"ephemeral_5m_input_tokens":877,"ephemeral_1h_input_tokens":0},"type":"message"}],"speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_01JZ55fpNRwX729qeZBviN2h":{"file_path":"C:\\Users\\User\\mcp-servers\\mes-log-mcp\\mes\\csvlog.py"}},"serverClassifierRequest":"c71732fa-d783-445f-a434-6319c69498c4","apiBlockIndex":0,"requestId":"req_011Cg2ZpWzSHzzUvesV6q35f","attributionAgent":"general-purpose","type":"assistant","uuid":"e9161688-e11a-44c8-9ece-3cba6991dec9","timestamp":"2026-10-14T18:00:53.371Z","effort":"high","perTurnEffort":null,"userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
{"parentUuid":"e9161688-e11a-44c8-9ece-3cba6991dec9","isSidechain":true,"promptId":"2fb62f54-c7c9-43d1-b80f-515baf3fab1f","agentId":"ac3048c66f3643aa6","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01JZ55fpNRwX729qeZBviN2h","type":"tool_result","content":"1\t\"\"\"MES graph-subsystem CSV recordings: parsing and post-hoc trigger analysis.\n2\t\n3\tMES's graph engine (UI string IDs 5001-5041) records up to 4 graphs of 10\n4\tparameters each into a timestamped CSV -- the only output MES produces that\n5\thas real per-sample timing. The ``.txt`` session log has no per-sample\n6\ttimestamps at all, which is why :class:`mes.params.ParamSeries` carries a\n7\t\"sample rate unrecoverable\" warning. Here the rate is measured, not guessed.\n8\t\n9\tDocumented format (from vendor-doc inspection -- see\n10\t``docs/format/CSV_LOG_FORMAT.md`` for per-item confidence)::\n11\t\n12\t    \"Time\"  \"Engine speed\"  \"Fuel pressure\"  \"TAG\"\n13\t    \"sec\"   \"rpm\"           \"bar\"            \" \"\n14\t    0.00    1215.0000       366.3000         \"\"\n15\t\n16\t* UTF-16LE with BOM, text fields quoted.\n17\t* Separator per MES Settings (Tab on this install), so it is sniffed, not\n18\t  assumed.\n19\t* Row 1 = parameter names, row 2 = units, first column always ``Time`` in\n20\t  seconds, last column ``TAG``.\n21\t* Enabling \"Monitor DTCs\" writes DTCs into the recording. The exact rendering\n22\t  is UNCONFIRMED until the first real export -- every non-empty TAG cell is\n23\t  therefore surfaced as an event, and anything DTC-shaped inside one is\n24\t  extracted explicitly.\n25\t\n26\tNo CSV has ever been recorded on this install, so this parser is validated\n27\tagainst synthetic fixtures built from the documented sample. The first real\n28\texport should be diffed against ``docs/format/CSV_LOG_FORMAT.md`` and any\n29\tsurprise recorded there.\n30\t\"\"\"\n31\t\n32\tfrom __future__ import annotations\n33\t\n34\timport csv as _csv\n35\timport io\n36\timport re\n37\timport statistics\n38\tfrom dataclasses import dataclass, field\n39\tfrom datetime import datetime\n40\tfrom pathlib import Path\n41\tfrom typing import Any\n42\t\n43\tfrom . import params, paths\n44\tfrom .encoding import read_log_text\n45\tfrom .errors import MesParseError\n46\t\n47\t#: Candidate separators, tried against the header row. Tab is the current\n48\t#: Settings value on this install; the other two are the plausible alternates.\n49\t_SEPARATORS = (\"\\t\", \";\", \",\")\n50\t\n51\t#: DTC-shaped token inside a TAG cell.\n52\t_DTC_RE = re.compile(r\"\\b([PBCU][0-9A-F]{4})\\b\", re.IGNORECASE)\n53\t\n54\t#: ``<column> <op> <threshold>`` for trigger queries.\n55\t_COND_RE = re.compile(\n56\t    r\"^\\s*(.+?)\\s*(>=|<=|==|!=|>|<)\\s*([+-]?\\d+(?:[.,]\\d+)?)\\s*$\")\n57\t\n58\t_OPS = {\n59\t    \">\": lambda a, b: a > b,\n60\t    \"<\": lambda a, b: a < b,\n61\t    \">=\": lambda a, b: a >= b,\n62\t    \"<=\": lambda a, b: a <= b,\n63\t    \"==\": lambda a, b: a == b,\n64\t    \"!=\": lambda a, b: a != b,\n65\t}\n66\t\n67\t#: A time gap larger than this multiple of the median interval is reported as\n68\t#: a dropout -- the adapter stalling or MES losing the ECU mid-recording.\n69\tGAP_FACTOR = 3.0\n70\t\n71\t\n72\tdef _cell_number(text: str) -> float | None:\n73\t    \"\"\"Parse a numeric cell, tolerating a comma-decimal locale build.\"\"\"\n74\t    t = text.strip().strip('\"')\n75\t    if not t:\n76\t        return None\n77\t    try:\n78\t        return float(t)\n79\t    except ValueError:\n80\t        try:\n81\t            return float(t.replace(\",\", \".\"))\n82\t        except ValueError:\n83\t            return None\n84\t\n85\t\n86\t@dataclass(frozen=True)\n87\tclass Column:\n88\t    \"\"\"One recorded parameter column.\"\"\"\n89\t\n90\t    index: int\n91\t    name: str\n92\t    unit: str\n93\t\n94\t    def to_dict(self) -> dict[str, Any]:\n95\t        return {\"index\": self.index, \"name\": self.name, \"unit\": self.unit}\n96\t\n97\t\n98\t@dataclass\n99\tclass TagEvent:\n100\t    \"\"\"A non-empty TAG cell: an operator marker or a monitored DTC.\"\"\"\n101\t\n102\t    time: float\n103\t    text: str\n104\t    dtcs: list[str] = field(default_factory=list)\n105\t\n106\t    def to_dict(self) -> dict[str, Any]:\n107\t        d: dict[str, Any] = {\"time_s\": self.time, \"text\": self.text}\n108\t        if self.dtcs:\n109\t            d[\"dtcs\"] = self.dtcs\n110\t        return d\n111\t\n112\t\n113\t@dataclass\n114\tclass Recording:\n115\t    \"\"\"One parsed CSV recording.\"\"\"\n116\t\n117\t    path: Path\n118\t    encoding: str\n119\t    separator: str\n120\t    columns: list[Column]\n121\t    times: list[float]\n122\t    #: Raw cell text per row, aligned by column index. Cells stay strings and\n123\t    #: are typed on access -- enum parameters (\"Released\") are legal in any\n124\t    #: column, and a recording can run to thousands of rows.\n125\t    rows: list[list[str]]\n126\t    tags: list[TagEvent] = field(default_factory=list)\n127\t    warnings: list[str] = field(default_factory=list)\n128\t    ragged_rows: int = 0\n129\t    unparseable_times: int = 0\n130\t\n131\t    @property\n132\t    def name(self) -> str:\n133\t        return self.path.name\n134\t\n135\t    @property\n136\t    def duration(self) -> float:\n137\t        return (self.times[-1] - self.times[0]) if len(self.times) > 1 else 0.0\n138\t\n139\t    def timing(self) -> dict[str, Any]:\n140\t        \"\"\"Measured sample timing: rate, median interval, dropouts.\"\"\"\n141\t        out: dict[str, Any] = {\"samples\": len(self.times),\n142\t                               \"duration_s\": round(self.duration, 3)}\n143\t        if len(self.times) < 2:\n144\t            return out\n145\t        deltas = [b - a for a, b in zip(self.times, self.times[1:])]\n146\t        med = statistics.median(deltas)\n147\t        out[\"median_interval_s\"] = round(med, 4)\n148\t        if self.duration > 0:\n149\t            out[\"rate_hz\"] = round((len(self.times) - 1) / self.duration, 3)\n150\t        if med > 0:\n151\t            gaps = [{\"after_s\": round(self.times[i], 3),\n152\t                     \"gap_s\": round(d, 3)}\n153\t                    for i, d in enumerate(deltas) if d > GAP_FACTOR * med]\n154\t            if gaps:\n155\t                out[\"dropouts\"] = gaps\n156\t                out[\"dropout_note\"] = (\n157\t                    f\"intervals over {GAP_FACTOR}x the median -- the adapter \"\n158\t                    \"or ECU link stalled; values bracketing a gap are not \"\n159\t                    \"adjacent in time\")\n160\t        non_monotonic = sum(1 for d in deltas if d < 0)\n161\t        if non_monotonic:\n162\t            out[\"non_monotonic_steps\"] = non_monotonic\n163\t        return out\n164\t\n165\t    # -- column access -----------------------------------------------------\n166\t\n167\t    def find_column(self, ref: str) -> Column:\n168\t        \"\"\"Resolve a column by exact name, unique substring, or index.\n169\t\n170\t        Duplicate names are legal (the .txt format demonstrably repeats\n171\t        ``Engine oil pressure`` as an enum and a bar value in one block), so\n172\t        exact matches prefer the first and the ambiguity is reported through\n173\t        ``duplicate_names`` in :meth:`to_dict`.\n174\t        \"\"\"\n175\t        r = ref.strip()\n176\t        if r.isdigit():\n177\t            i = int(r)\n178\t            for c in self.columns:\n179\t                if c.index == i:\n180\t                    return c\n181\t            raise MesParseError(f\"no column with index {i}\")\n182\t        low = r.lower()\n183\t        exact = [c for c in self.columns if c.name.lower() == low]\n184\t        if exact:\n185\t            return exact[0]\n186\t        subs = [c for c in self.columns if low in c.name.lower()]\n187\t        if len(subs) == 1:\n188\t            return subs[0]\n189\t        if len(subs) > 1:\n190\t            raise MesParseError(\n191\t                f\"{ref!r} is ambiguous: matches \"\n192\t                + \", \".join(c.name for c in subs))\n193\t        raise MesParseError(\n194\t            f\"no column matching {ref!r}; available: \"\n195\t            + \", \".join(c.name for c in self.columns))\n196\t\n197\t    def series(self, ref: str) -> params.ParamSeries:\n198\t        \"\"\"One column as a typed :class:`ParamSeries`, stamped with times.\"\"\"\n199\t        col = self.find_column(ref)\n200\t        s = params.ParamSeries(name=col.name, unit=col.unit)\n201\t        for t, row in zip(self.times, self.rows):\n202\t            raw = row[col.index] if col.index < len(row) else \"\"\n203\t            s.add(params.parse_value(col.name, raw.strip().strip('\"')),\n204\t                  stamp=f\"{t:g}s\")\n205\t        return s\n206\t\n207\t    def numbers(self, ref: str) -> list[tuple[float, float]]:\n208\t        \"\"\"(time, value) pairs for a column, numeric samples only.\"\"\"\n209\t        col = self.find_column(ref)\n210\t        out: list[tuple[float, float]] = []\n211\t        for t, row in zip(self.times, self.rows):\n212\t            raw = row[col.index] if col.index < len(row) else \"\"\n213\t            n = _cell_number(raw)\n214\t            if n is not None:\n215\t                out.append((t, n))\n216\t        return out\n217\t\n218\t    def snapshot(self, at: float) -> dict[str, Any]:\n219\t        \"\"\"Every column's value at the sample nearest ``at`` seconds.\n220\t\n221\t        This is the post-hoc freeze frame: what everything read at the moment\n222\t        a tag fired or a threshold tripped.\n223\t        \"\"\"\n224\t        if not self.times:\n225\t            raise MesParseError(\"recording has no samples\")\n226\t        i = min(range(len(self.times)), key=lambda j: abs(self.times[j] - at))\n227\t        row = self.rows[i]\n228\t        vals: dict[str, str] = {}\n229\t        for c in self.columns:\n230\t            raw = row[c.index] if c.index < len(row) else \"\"\n231\t            v = params.parse_value(c.name, raw.strip().strip('\"'))\n232\t            text = v.display\n233\t            if v.is_numeric and not v.unit and c.unit:\n234\t                text = f\"{text} {c.unit}\"\n235\t            vals[c.name] = text\n236\t        return {\"requested_s\": at, \"sample_s\": self.times[i],\n237\t                \"sample_index\": i, \"values\": vals}\n238\t\n239\t    # -- trigger analysis ----------------------------------------------------\n240\t\n241\t    def crossings(self, condition: str) -> dict[str, Any]:\n242\t        \"\"\"Intervals where ``<column> <op> <value>`` held true.\n243\t\n244\t        Returns entry/exit times per interval with the extreme value inside\n245\t        it, rather than one hit per sample -- 400 rows above a threshold is\n246\t        one event, not 400.\n247\t        \"\"\"\n248\t        m = _COND_RE.match(condition)\n249\t        if not m:\n250\t            raise MesParseError(\n251\t                f\"cannot parse condition {condition!r}; expected \"\n252\t                \"'<column> <op> <value>' with op one of > < >= <= == !=\")\n253\t        ref, op, thr_text = m.group(1), m.group(2), m.group(3)\n254\t        threshold = float(thr_text.replace(\",\", \".\"))\n255\t        col = self.find_column(ref)\n256\t        test = _OPS[op]\n257\t\n258\t        pairs = self.numbers(str(col.index))\n259\t        intervals: list[dict[str, Any]] = []\n260\t        cur: dict[str, Any] | None = None\n261\t        for t, v in pairs:\n262\t            if test(v, threshold):\n263\t                if cur is None:\n264\t                    cur = {\"enter_s\": t, \"exit_s\": t, \"samples\": 0,\n265\t                           \"extreme\": v}\n266\t                cur[\"exit_s\"] = t\n267\t                cur[\"samples\"] += 1\n268\t                if op in (\"<\", \"<=\"):\n269\t                    cur[\"extreme\"] = min(cur[\"extreme\"], v)\n270\t                else:\n271\t                    cur[\"extreme\"] = max(cur[\"extreme\"], v)\n272\t            elif cur is not None:\n273\t                intervals.append(cur)\n274\t                cur = None\n275\t        if cur is not None:\n276\t            intervals.append(cur)\n277\t        for iv in intervals:\n278\t            iv[\"duration_s\"] = round(iv[\"exit_s\"] - iv[\"enter_s\"], 3)\n279\t        return {\n280\t            \"condition\": f\"{col.name} {op} {threshold:g}\",\n281\t            \"column\": col.to_dict(),\n282\t            \"numeric_samples\": len(pairs),\n283\t            \"intervals\": intervals,\n284\t            \"count\": len(intervals),\n285\t        }\n286\t\n287\t    # -- serialisation ---------------------------------------------------\n288\t\n289\t    def to_dict(self, preview_rows: int = 0) -> dict[str, Any]:\n290\t        names = [c.name for c in self.columns]\n291\t        dupes = sorted({n for n in names if names.count(n) > 1})\n292\t        d: dict[str, Any] = {\n293\t            \"file\": self.name,\n294\t            \"encoding\": self.encoding,\n295\t            \"separator\": {\"\\t\": \"tab\"}.get(self.separator, self.separator),\n296\t            \"columns\": [c.to_dict() for c in self.columns],\n297\t            \"timing\": self.timing(),\n298\t            \"tag_events\": [t.to_dict() for t in self.tags],\n299\t            \"dtcs_in_tags\": sorted({dtc for t in self.tags for dtc in t.dtcs}),\n300\t        }\n301\t        if dupes:\n302\t            d[\"duplicate_names\"] = dupes\n303\t        if self.ragged_rows:\n304\t            d[\"ragged_rows\"] = self.ragged_rows\n305\t        if self.unparseable_times:\n306\t            d[\"unparseable_times\"] = self.unparseable_times\n307\t        if self.warnings:\n308\t            d[\"warnings\"] = self.warnings\n309\t        if preview_rows > 0:\n310\t            d[\"preview\"] = [\n311\t                {\"time_s\": t,\n312\t                 **{c.name: (row[c.index] if c.index < len(row) else \"\")\n313\t                    for c in self.columns}}\n314\t                for t, row in list(zip(self.times, self.rows))[:preview_rows]\n315\t            ]\n316\t        return d\n317\t\n318\t\n319\tdef _sniff_separator(header: str) -> str:\n320\t    \"\"\"Pick the separator that yields the most columns on the header row.\"\"\"\n321\t    best, best_n = \"\\t\", 1\n322\t    for sep in _SEPARATORS:\n323\t        n = len(next(_csv.reader(io.StringIO(header), delimiter=sep)))\n324\t        if n > best_n:\n325\t            best, best_n = sep, n\n326\t    if best_n < 2:\n327\t        raise MesParseError(\n328\t            \"could not detect a separator on the header row -- not an MES \"\n329\t            \"CSV recording?\")\n330\t    return best\n331\t\n332\t\n333\tdef load_csv(path: Path) -> Recording:\n334\t    \"\"\"Parse one MES CSV recording.\"\"\"\n335\t    decoded = read_log_text(path)\n336\t    lines = [ln for ln in decoded.text.splitlines() if ln.strip()]\n337\t    if len(lines) < 2:\n338\t        raise MesParseError(\n339\t            f\"{path.name}: too short to be a recording \"\n340\t            f\"({len(lines)} non-empty lines)\")\n341\t\n342\t    warnings: list[str] = []\n343\t    sep = _sniff_separator(lines[0])\n344\t    reader = _csv.reader(io.StringIO(\"\\n\".join(lines)), delimiter=sep)\n345\t    table = [[c.strip() for c in row] for row in reader]\n346\t\n347\t    names = [c.strip().strip('\"') for c in table[0]]\n348\t    units = [c.strip().strip('\"') for c in table[1]] if len(table) > 1 else []\n349\t    while len(units) < len(names):\n350\t        units.append(\"\")\n351\t\n352\t    if not names or names[0].lower() != \"time\":\n353\t        warnings.append(\n354\t            f\"first column is {names[0]!r}, not 'Time' -- the documented \"\n355\t            \"format always leads with Time in seconds; timing fields may be \"\n356\t            \"wrong\")\n357\t    tag_index = len(names) - 1 if names and names[-1].upper() == \"TAG\" else -1\n358\t    if tag_index < 0:\n359\t        warnings.append(\"no trailing TAG column -- DTC/marker events \"\n360\t                        \"unavailable for this recording\")\n361\t\n362\t    columns = [\n363\t        Column(index=i, name=names[i],\n364\t               unit=params.canonical_unit(units[i]) if units[i].strip() else \"\")\n365\t        for i in range(len(names))\n366\t        if i != 0 and i != tag_index\n367\t    ]\n368\t\n369\t    times: list[float] = []\n370\t    rows: list[list[str]] = []\n371\t    tags: list[TagEvent] = []\n372\t    ragged = 0\n373\t    bad_times = 0\n374\t    for raw_row in table[2:]:\n375\t        if len(raw_row) != len(names):\n376\t            ragged += 1\n377\t            if len(raw_row) < len(names):\n378\t                raw_row = raw_row + [\"\"] * (len(names) - len(raw_row))\n379\t        t = _cell_number(raw_row[0])\n380\t        if t is None:\n381\t            bad_times += 1\n382\t            continue\n383\t        times.append(t)\n384\t        rows.append(raw_row)\n385\t        if 0 <= tag_index < len(raw_row):\n386\t            tag = raw_row[tag_index].strip().strip('\"').strip()\n387\t            if tag:\n388\t                tags.append(TagEvent(\n389\t                    time=t, text=tag,\n390\t                    dtcs=[m.upper() for m in _DTC_RE.findall(tag)]))\n391\t\n392\t    if decoded.control_chars:\n393\t        warnings.append(f\"{decoded.control_chars} stray control bytes removed\")\n394\t\n395\t    return Recording(\n396\t        path=path, encoding=decoded.encoding, separator=sep,\n397\t        columns=columns, times=times, rows=rows, tags=tags,\n398\t        warnings=warnings, ragged_rows=ragged, unparseable_times=bad_times)\n399\t\n400\t\n401\tdef list_recordings() -> list[dict[str, Any]]:\n402\t    \"\"\"Cheap inventory of every CSV in the CSV roots, newest mtime first.\n403\t\n404\t    The MES CSV filename convention is unknown (none has ever been written\n405\t    here), so unlike the .txt catalog there is no filename timestamp --\n406\t    mtime is all there is, and it is labelled as such.\n407\t    \"\"\"\n408\t    out: list[dict[str, Any]] = []\n409\t    for p in paths.iter_csv_files():\n410\t        try:\n411\t            st = p.stat()\n412\t        except OSError:\n413\t            continue\n414\t        entry: dict[str, Any] = {\n415\t            \"file\": p.name,\n416\t            \"size_bytes\": st.st_size,\n417\t            \"_mtime\": st.st_mtime,\n418\t            \"mtime\": datetime.fromtimestamp(st.st_mtime).isoformat(\n419\t                sep=\" \", timespec=\"seconds\"),\n420\t            \"timestamp_note\": (\"file mtime -- MES CSV filenames carry no \"\n421\t                               \"known session stamp\"),\n422\t        }\n423\t        try:\n424\t            rec = load_csv(p)\n425\t            entry.update({\n426\t                \"parameters\": [c.name for c in rec.columns],\n427\t                \"samples\": len(rec.times),\n428\t                \"duration_s\": round(rec.duration, 3),\n429\t                \"tag_events\": len(rec.tags),\n430\t            })\n431\t        except Exception as exc:\n432\t            entry[\"parse_error\"] = str(exc)\n433\t        out.append(entry)\n434\t    out.sort(key=lambda e: e[\"_mtime\"], reverse=True)\n435\t    for e in out:\n436\t        del e[\"_mtime\"]\n437\t    return out\n438\t\n439\t\n440\tdef load_named(name: str) -> Recording:\n441\t    \"\"\"Resolve a bare CSV filename through containment and parse it.\"\"\"\n442\t    return load_csv(paths.resolve_csv(name))\n443\t"}]},"uuid":"86b3b71e-1e44-41dd-9cea-5dcbbc83ae0e","timestamp":"2026-10-14T18:00:53.415Z","toolUseResult":{"type":"text","file":{"filePath":"C:\\Users\\User\\mcp-servers\\mes-log-mcp\\mes\\csvlog.py","content":"\"\"\"MES graph-subsystem CSV recordings: parsing and post-hoc trigger analysis.\n\nMES's graph engine (UI string IDs 5001-5041) records up to 4 graphs of 10\nparameters each into a timestamped CSV -- the only output MES produces that\nhas real per-sample timing. The ``.txt`` session log has no per-sample\ntimestamps at all, which is why :class:`mes.params.ParamSeries` carries a\n\"sample rate unrecoverable\" warning. Here the rate is measured, not guessed.\n\nDocumented format (from vendor-doc inspection -- see\n``docs/format/CSV_LOG_FORMAT.md`` for per-item confidence)::\n\n    \"Time\"  \"Engine speed\"  \"Fuel pressure\"  \"TAG\"\n    \"sec\"   \"rpm\"           \"bar\"            \" \"\n    0.00    1215.0000       366.3000         \"\"\n\n* UTF-16LE with BOM, text fields quoted.\n* Separator per MES Settings (Tab on this install), so it is sniffed, not\n  assumed.\n* Row 1 = parameter names, row 2 = units, first column always ``Time`` in\n  seconds, last column ``TAG``.\n* Enabling \"Monitor DTCs\" writes DTCs into the recording. The exact rendering\n  is UNCONFIRMED until the first real export -- every non-empty TAG cell is\n  therefore surfaced as an event, and anything DTC-shaped inside one is\n  extracted explicitly.\n\nNo CSV has ever been recorded on this install, so this parser is validated\nagainst synthetic fixtures built from the documented sample. The first real\nexport should be diffed against ``docs/format/CSV_LOG_FORMAT.md`` and any\nsurprise recorded there.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport csv as _csv\nimport io\nimport re\nimport statistics\nfrom dataclasses import dataclass, field\nfrom datetime import datetime\nfrom pathlib import Path\nfrom typing import Any\n\nfrom . import params, paths\nfrom .encoding import read_log_text\nfrom .errors import MesParseError\n\n#: Candidate separators, tried against the header row. Tab is the current\n#: Settings value on this install; the other two are the plausible alternates.\n_SEPARATORS = (\"\\t\", \";\", \",\")\n\n#: DTC-shaped token inside a TAG cell.\n_DTC_RE = re.compile(r\"\\b([PBCU][0-9A-F]{4})\\b\", re.IGNORECASE)\n\n#: ``<column> <op> <threshold>`` for trigger queries.\n_COND_RE = re.compile(\n    r\"^\\s*(.+?)\\s*(>=|<=|==|!=|>|<)\\s*([+-]?\\d+(?:[.,]\\d+)?)\\s*$\")\n\n_OPS = {\n    \">\": lambda a, b: a > b,\n    \"<\": lambda a, b: a < b,\n    \">=\": lambda a, b: a >= b,\n    \"<=\": lambda a, b: a <= b,\n    \"==\": lambda a, b: a == b,\n    \"!=\": lambda a, b: a != b,\n}\n\n#: A time gap larger than this multiple of the median interval is reported as\n#: a dropout -- the adapter stalling or MES losing the ECU mid-recording.\nGAP_FACTOR = 3.0\n\n\ndef _cell_number(text: str) -> float | None:\n    \"\"\"Parse a numeric cell, tolerating a comma-decimal locale build.\"\"\"\n    t = text.strip().strip('\"')\n    if not t:\n        return None\n    try:\n        return float(t)\n    except ValueError:\n        try:\n            return float(t.replace(\",\", \".\"))\n        except ValueError:\n            return None\n\n\n@dataclass(frozen=True)\nclass Column:\n    \"\"\"One recorded parameter column.\"\"\"\n\n    index: int\n    name: str\n    unit: str\n\n    def to_dict(self) -> dict[str, Any]:\n        return {\"index\": self.index, \"name\": self.name, \"unit\": self.unit}\n\n\n@dataclass\nclass TagEvent:\n    \"\"\"A non-empty TAG cell: an operator marker or a monitored DTC.\"\"\"\n\n    time: float\n    text: str\n    dtcs: list[str] = field(default_factory=list)\n\n    def to_dict(self) -> dict[str, Any]:\n        d: dict[str, Any] = {\"time_s\": self.time, \"text\": self.text}\n        if self.dtcs:\n            d[\"dtcs\"] = self.dtcs\n        return d\n\n\n@dataclass\nclass Recording:\n    \"\"\"One parsed CSV recording.\"\"\"\n\n    path: Path\n    encoding: str\n    separator: str\n    columns: list[Column]\n    times: list[float]\n    #: Raw cell text per row, aligned by column index. Cells stay strings and\n    #: are typed on access -- enum parameters (\"Released\") are legal in any\n    #: column, and a recording can run to thousands of rows.\n    rows: list[list[str]]\n    tags: list[TagEvent] = field(default_factory=list)\n    warnings: list[str] = field(default_factory=list)\n    ragged_rows: int = 0\n    unparseable_times: int = 0\n\n    @property\n    def name(self) -> str:\n        return self.path.name\n\n    @property\n    def duration(self) -> float:\n        return (self.times[-1] - self.times[0]) if len(self.times) > 1 else 0.0\n\n    def timing(self) -> dict[str, Any]:\n        \"\"\"Measured sample timing: rate, median interval, dropouts.\"\"\"\n        out: dict[str, Any] = {\"samples\": len(self.times),\n                               \"duration_s\": round(self.duration, 3)}\n        if len(self.times) < 2:\n            return out\n        deltas = [b - a for a, b in zip(self.times, self.times[1:])]\n        med = statistics.median(deltas)\n        out[\"median_interval_s\"] = round(med, 4)\n        if self.duration > 0:\n            out[\"rate_hz\"] = round((len(self.times) - 1) / self.duration, 3)\n        if med > 0:\n            gaps = [{\"after_s\": round(self.times[i], 3),\n                     \"gap_s\": round(d, 3)}\n                    for i, d in enumerate(deltas) if d > GAP_FACTOR * med]\n            if gaps:\n                out[\"dropouts\"] = gaps\n                out[\"dropout_note\"] = (\n                    f\"intervals over {GAP_FACTOR}x the median -- the adapter \"\n                    \"or ECU link stalled; values bracketing a gap are not \"\n                    \"adjacent in time\")\n        non_monotonic = sum(1 for d in deltas if d < 0)\n        if non_monotonic:\n            out[\"non_monotonic_steps\"] = non_monotonic\n        return out\n\n    # -- column access -----------------------------------------------------\n\n    def find_column(self, ref: str) -> Column:\n        \"\"\"Resolve a column by exact name, unique substring, or index.\n\n        Duplicate names are legal (the .txt format demonstrably repeats\n        ``Engine oil pressure`` as an enum and a bar value in one block), so\n        exact matches prefer the first and the ambiguity is reported through\n        ``duplicate_names`` in :meth:`to_dict`.\n        \"\"\"\n        r = ref.strip()\n        if r.isdigit():\n            i = int(r)\n            for c in self.columns:\n                if c.index == i:\n                    return c\n            raise MesParseError(f\"no column with index {i}\")\n        low = r.lower()\n        exact = [c for c in self.columns if c.name.lower() == low]\n        if exact:\n            return exact[0]\n        subs = [c for c in self.columns if low in c.name.lower()]\n        if len(subs) == 1:\n            return subs[0]\n        if len(subs) > 1:\n            raise MesParseError(\n                f\"{ref!r} is ambiguous: matches \"\n                + \", \".join(c.name for c in subs))\n        raise MesParseError(\n            f\"no column matching {ref!r}; available: \"\n            + \", \".join(c.name for c in self.columns))\n\n    def series(self, ref: str) -> params.ParamSeries:\n        \"\"\"One column as a typed :class:`ParamSeries`, stamped with times.\"\"\"\n        col = self.find_column(ref)\n        s = params.ParamSeries(name=col.name, unit=col.unit)\n        for t, row in zip(self.times, self.rows):\n            raw = row[col.index] if col.index < len(row) else \"\"\n            s.add(params.parse_value(col.name, raw.strip().strip('\"')),\n                  stamp=f\"{t:g}s\")\n        return s\n\n    def numbers(self, ref: str) -> list[tuple[float, float]]:\n        \"\"\"(time, value) pairs for a column, numeric samples only.\"\"\"\n        col = self.find_column(ref)\n        out: list[tuple[float, float]] = []\n        for t, row in zip(self.times, self.rows):\n            raw = row[col.index] if col.index < len(row) else \"\"\n            n = _cell_number(raw)\n            if n is not None:\n                out.append((t, n))\n        return out\n\n    def snapshot(self, at: float) -> dict[str, Any]:\n        \"\"\"Every column's value at the sample nearest ``at`` seconds.\n\n        This is the post-hoc freeze frame: what everything read at the moment\n        a tag fired or a threshold tripped.\n        \"\"\"\n        if not self.times:\n            raise MesParseError(\"recording has no samples\")\n        i = min(range(len(self.times)), key=lambda j: abs(self.times[j] - at))\n        row = self.rows[i]\n        vals: dict[str, str] = {}\n        for c in self.columns:\n            raw = row[c.index] if c.index < len(row) else \"\"\n            v = params.parse_value(c.name, raw.strip().strip('\"'))\n            text = v.display\n            if v.is_numeric and not v.unit and c.unit:\n                text = f\"{text} {c.unit}\"\n            vals[c.name] = text\n        return {\"requested_s\": at, \"sample_s\": self.times[i],\n                \"sample_index\": i, \"values\": vals}\n\n    # -- trigger analysis ----------------------------------------------------\n\n    def crossings(self, condition: str) -> dict[str, Any]:\n        \"\"\"Intervals where ``<column> <op> <value>`` held true.\n\n        Returns entry/exit times per interval with the extreme value inside\n        it, rather than one hit per sample -- 400 rows above a threshold is\n        one event, not 400.\n        \"\"\"\n        m = _COND_RE.match(condition)\n        if not m:\n            raise MesParseError(\n                f\"cannot parse condition {condition!r}; expected \"\n                \"'<column> <op> <value>' with op one of > < >= <= == !=\")\n        ref, op, thr_text = m.group(1), m.group(2), m.group(3)\n        threshold = float(thr_text.replace(\",\", \".\"))\n        col = self.find_column(ref)\n        test = _OPS[op]\n\n        pairs = self.numbers(str(col.index))\n        intervals: list[dict[str, Any]] = []\n        cur: dict[str, Any] | None = None\n        for t, v in pairs:\n            if test(v, threshold):\n                if cur is None:\n                    cur = {\"enter_s\": t, \"exit_s\": t, \"samples\": 0,\n                           \"extreme\": v}\n                cur[\"exit_s\"] = t\n                cur[\"samples\"] += 1\n                if op in (\"<\", \"<=\"):\n                    cur[\"extreme\"] = min(cur[\"extreme\"], v)\n                else:\n                    cur[\"extreme\"] = max(cur[\"extreme\"], v)\n            elif cur is not None:\n                intervals.append(cur)\n                cur = None\n        if cur is not None:\n            intervals.append(cur)\n        for iv in intervals:\n            iv[\"duration_s\"] = round(iv[\"exit_s\"] - iv[\"enter_s\"], 3)\n        return {\n            \"condition\": f\"{col.name} {op} {threshold:g}\",\n            \"column\": col.to_dict(),\n            \"numeric_samples\": len(pairs),\n            \"intervals\": intervals,\n            \"count\": len(intervals),\n        }\n\n    # -- serialisation ---------------------------------------------------\n\n    def to_dict(self, preview_rows: int = 0) -> dict[str, Any]:\n        names = [c.name for c in self.columns]\n        dupes = sorted({n for n in names if names.count(n) > 1})\n        d: dict[str, Any] = {\n            \"file\": self.name,\n            \"encoding\": self.encoding,\n            \"separator\": {\"\\t\": \"tab\"}.get(self.separator, self.separator),\n            \"columns\": [c.to_dict() for c in self.columns],\n            \"timing\": self.timing(),\n            \"tag_events\": [t.to_dict() for t in self.tags],\n            \"dtcs_in_tags\": sorted({dtc for t in self.tags for dtc in t.dtcs}),\n        }\n        if dupes:\n            d[\"duplicate_names\"] = dupes\n        if self.ragged_rows:\n            d[\"ragged_rows\"] = self.ragged_rows\n        if self.unparseable_times:\n            d[\"unparseable_times\"] = self.unparseable_times\n        if self.warnings:\n            d[\"warnings\"] = self.warnings\n        if preview_rows > 0:\n            d[\"preview\"] = [\n                {\"time_s\": t,\n                 **{c.name: (row[c.index] if c.index < len(row) else \"\")\n                    for c in self.columns}}\n                for t, row in list(zip(self.times, self.rows))[:preview_rows]\n            ]\n        return d\n\n\ndef _sniff_separator(header: str) -> str:\n    \"\"\"Pick the separator that yields the most columns on the header row.\"\"\"\n    best, best_n = \"\\t\", 1\n    for sep in _SEPARATORS:\n        n = len(next(_csv.reader(io.StringIO(header), delimiter=sep)))\n        if n > best_n:\n            best, best_n = sep, n\n    if best_n < 2:\n        raise MesParseError(\n            \"could not detect a separator on the header row -- not an MES \"\n            \"CSV recording?\")\n    return best\n\n\ndef load_csv(path: Path) -> Recording:\n    \"\"\"Parse one MES CSV recording.\"\"\"\n    decoded = read_log_text(path)\n    lines = [ln for ln in decoded.text.splitlines() if ln.strip()]\n    if len(lines) < 2:\n        raise MesParseError(\n            f\"{path.name}: too short to be a recording \"\n            f\"({len(lines)} non-empty lines)\")\n\n    warnings: list[str] = []\n    sep = _sniff_separator(lines[0])\n    reader = _csv.reader(io.StringIO(\"\\n\".join(lines)), delimiter=sep)\n    table = [[c.strip() for c in row] for row in reader]\n\n    names = [c.strip().strip('\"') for c in table[0]]\n    units = [c.strip().strip('\"') for c in table[1]] if len(table) > 1 else []\n    while len(units) < len(names):\n        units.append(\"\")\n\n    if not names or names[0].lower() != \"time\":\n        warnings.append(\n            f\"first column is {names[0]!r}, not 'Time' -- the documented \"\n            \"format always leads with Time in seconds; timing fields may be \"\n            \"wrong\")\n    tag_index = len(names) - 1 if names and names[-1].upper() == \"TAG\" else -1\n    if tag_index < 0:\n        warnings.append(\"no trailing TAG column -- DTC/marker events \"\n                        \"unavailable for this recording\")\n\n    columns = [\n        Column(index=i, name=names[i],\n               unit=params.canonical_unit(units[i]) if units[i].strip() else \"\")\n        for i in range(len(names))\n        if i != 0 and i != tag_index\n    ]\n\n    times: list[float] = []\n    rows: list[list[str]] = []\n    tags: list[TagEvent] = []\n    ragged = 0\n    bad_times = 0\n    for raw_row in table[2:]:\n        if len(raw_row) != len(names):\n            ragged += 1\n            if len(raw_row) < len(names):\n                raw_row = raw_row + [\"\"] * (len(names) - len(raw_row))\n        t = _cell_number(raw_row[0])\n        if t is None:\n            bad_times += 1\n            continue\n        times.append(t)\n        rows.append(raw_row)\n        if 0 <= tag_index < len(raw_row):\n            tag = raw_row[tag_index].strip().strip('\"').strip()\n            if tag:\n                tags.append(TagEvent(\n                    time=t, text=tag,\n                    dtcs=[m.upper() for m in _DTC_RE.findall(tag)]))\n\n    if decoded.control_chars:\n        warnings.append(f\"{decoded.control_chars} stray control bytes removed\")\n\n    return Recording(\n        path=path, encoding=decoded.encoding, separator=sep,\n        columns=columns, times=times, rows=rows, tags=tags,\n        warnings=warnings, ragged_rows=ragged, unparseable_times=bad_times)\n\n\ndef list_recordings() -> list[dict[str, Any]]:\n    \"\"\"Cheap inventory of every CSV in the CSV roots, newest mtime first.\n\n    The MES CSV filename convention is unknown (none has ever been written\n    here), so unlike the .txt catalog there is no filename timestamp --\n    mtime is all there is, and it is labelled as such.\n    \"\"\"\n    out: list[dict[str, Any]] = []\n    for p in paths.iter_csv_files():\n        try:\n            st = p.stat()\n        except OSError:\n            continue\n        entry: dict[str, Any] = {\n            \"file\": p.name,\n            \"size_bytes\": st.st_size,\n            \"_mtime\": st.st_mtime,\n            \"mtime\": datetime.fromtimestamp(st.st_mtime).isoformat(\n                sep=\" \", timespec=\"seconds\"),\n            \"timestamp_note\": (\"file mtime -- MES CSV filenames carry no \"\n                               \"known session stamp\"),\n        }\n        try:\n            rec = load_csv(p)\n            entry.update({\n                \"parameters\": [c.name for c in rec.columns],\n                \"samples\": len(rec.times),\n                \"duration_s\": round(rec.duration, 3),\n                \"tag_events\": len(rec.tags),\n            })\n        except Exception as exc:\n            entry[\"parse_error\"] = str(exc)\n        out.append(entry)\n    out.sort(key=lambda e: e[\"_mtime\"], reverse=True)\n    for e in out:\n        del e[\"_mtime\"]\n    return out\n\n\ndef load_named(name: str) -> Recording:\n    \"\"\"Resolve a bare CSV filename through containment and parse it.\"\"\"\n    return load_csv(paths.resolve_csv(name))\n","numLines":443,"startLine":1,"totalLines":443}},"sourceToolAssistantUUID":"e9161688-e11a-44c8-9ece-3cba6991dec9","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
