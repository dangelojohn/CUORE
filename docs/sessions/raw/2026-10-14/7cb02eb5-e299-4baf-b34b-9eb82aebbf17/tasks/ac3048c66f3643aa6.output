{"parentUuid":"10113a51-e9da-4257-8f2b-fd5d1e07e979","isSidechain":true,"promptId":"f5371174-bba0-4992-a14b-d71ea13c02eb","agentId":"ac3048c66f3643aa6","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01ABuy8JvEo9eTiegjXwUNMm","type":"tool_result","content":"1\t\"\"\"FastAPI application factory.\n2\t\n3\tTwo surfaces over one service layer:\n4\t\n5\t* ``/api/*`` -- JSON, mirroring the MCP tool surface call-for-call. This is\n6\t  what a future PWA, the in-car node, and Claude's tool layer all talk to.\n7\t* ``/`` -- server-rendered pages for bench use. They are a *client* of the same\n8\t  bridge, not a parallel implementation, so the two cannot disagree.\n9\t\n10\tServer-rendered rather than a single-page app on purpose: no build step, no\n11\tbundle to keep in sync, and it has to run on a Raspberry Pi.\n12\t\"\"\"\n13\t\n14\tfrom __future__ import annotations\n15\t\n16\timport logging\n17\tfrom contextlib import asynccontextmanager\n18\t\n19\tfrom . import __version__, bootstrap  # noqa: F401  -- bootstrap has a side effect\n20\t\n21\tfrom fastapi import FastAPI, Request  # noqa: E402\n22\tfrom fastapi.responses import JSONResponse  # noqa: E402\n23\tfrom fastapi.staticfiles import StaticFiles  # noqa: E402\n24\t\n25\tfrom mes.errors import MesError  # noqa: E402  -- needs bootstrap to have run\n26\t\n27\tfrom .api import attested as attested_api  # noqa: E402\n28\tfrom .api import buscapture as buscapture_api  # noqa: E402\n29\tfrom .api import modifications as modifications_api  # noqa: E402\n30\tfrom .api import scan_health as scan_health_api  # noqa: E402\n31\tfrom .api import cases as cases_api, checklists as checklists_api, dossier as dossier_api, electrical as electrical_api, feedback as feedback_api, flow as flow_api, jobs as jobs_api, known_good, live, live_ui, liveboard, logs, media as media_api, parts as parts_api, recordings, reference, shop as shop_api, system, systems as systems_api, systems_map as systems_map_api, tests as tests_api, timeline as timeline_api, tools as tools_api, tools_kb as tools_kb_api, experience as experience_api, vehicles  # noqa: E402\n32\tfrom .config import Settings, load  # noqa: E402\n33\tfrom .models import ErrorBody  # noqa: E402\n34\tfrom .services.errors import BridgeError  # noqa: E402\n35\tfrom .web import bench_routes  # noqa: E402\n36\tfrom .web import dashboard_routes  # noqa: E402\n37\tfrom .web import drivetrain_routes  # noqa: E402\n38\tfrom .web import dossier_routes  # noqa: E402\n39\tfrom .web import electrical_routes  # noqa: E402\n40\tfrom .web import fullscan_routes  # noqa: E402\n41\tfrom .web import labels_routes  # noqa: E402\n42\tfrom .web import live_dashboard_routes  # noqa: E402\n43\tfrom .web import liveboard_routes  # noqa: E402\n44\tfrom .web import learn_routes  # noqa: E402\n45\tfrom .web import owner_routes  # noqa: E402\n46\tfrom .api import owner_events as owner_events_api  # noqa: E402\n47\tfrom .api import scanlog as scanlog_api  # noqa: E402\n48\tfrom .api import vision as vision_api  # noqa: E402\n49\tfrom .web import media_routes  # noqa: E402\n50\tfrom .web import mods_routes  # noqa: E402\n51\tfrom .web import modules_routes  # noqa: E402\n52\tfrom .web import parts_routes  # noqa: E402\n53\tfrom .web import report_routes  # noqa: E402\n54\tfrom .web import routes as web_routes  # noqa: E402\n55\tfrom .web import scan_health_routes  # noqa: E402\n56\tfrom .web import scan_plan_routes  # noqa: E402\n57\tfrom .web import scanlog_routes  # noqa: E402\n58\tfrom .web import service_routes  # noqa: E402\n59\tfrom .web import shop_routes  # noqa: E402\n60\tfrom .web import system_routes  # noqa: E402\n61\tfrom .web import systems_routes  # noqa: E402\n62\tfrom .web import tests_routes  # noqa: E402\n63\tfrom .web import timeline_routes  # noqa: E402\n64\tfrom .web import tools_routes  # noqa: E402\n65\tfrom .web import inbox_routes  # noqa: E402\n66\tfrom .web import jobs_routes  # noqa: E402\n67\tfrom .web import flow_globals, tools_kb_globals  # noqa: F401\n68\tfrom .web import icons, i18n  # noqa: F401\n69\tfrom .web import static_version  # noqa: F401\n70\t\n71\tlog = logging.getLogger(\"cuore\")\n72\t\n73\tDESCRIPTION = \"\"\"\n74\tCompanion service over the MultiEcuScan diagnostic toolchain.\n75\t\n76\tEvery analysis here comes from the `mes` library and is unit-tested against the\n77\treal log corpus. Two conventions run through the whole API and are worth knowing\n78\tbefore reading any payload:\n79\t\n80\t* **Simulation logs are excluded by default.** Most of the FES corpus is MES\n81\t  practice data. Pass `include_simulation=true` deliberately, or not at all.\n82\t* **SCAN provenance is `unverifiable`, never clean.** That format carries no\n83\t  simulation marker, so claiming a SCAN is real would be a claim the file\n84\t  cannot support.\n85\t\"\"\"\n86\t\n87\t\n88\tdef create_app(settings: Settings | None = None) -> FastAPI:\n89\t    \"\"\"Build the ASGI app. Safe to call repeatedly (tests do).\"\"\"\n90\t    settings = settings or load()\n91\t\n92\t    @asynccontextmanager\n93\t    async def lifespan(app: FastAPI):\n94\t        log.info(\"CUORE %s starting: profile=%s bind=%s:%s\",\n95\t                 __version__, settings.profile.value, settings.host,\n96\t                 settings.port)\n97\t        if settings.unguarded_lan:\n98\t            log.warning(\n99\t                \"Bound to %s with no token set. The log corpus contains \"\n100\t                \"customer VINs and is now readable by every device on this \"\n101\t                \"network. Set CUORE_TOKEN.\", settings.host)\n102\t        yield\n103\t\n104\t    app = FastAPI(\n105\t        title=\"CUORE\",\n106\t        version=__version__,\n107\t        description=DESCRIPTION,\n108\t        lifespan=lifespan,\n109\t        docs_url=\"/api/docs\",\n110\t        redoc_url=None,\n111\t        openapi_url=\"/api/openapi.json\",\n112\t    )\n113\t    app.state.settings = settings\n114\t\n115\t    # --- error handling ---------------------------------------------------\n116\t    # The bridge raises transport-neutral errors. API callers get one uniform\n117\t    # JSON body so failure parses exactly one way; browsers get a page, because\n118\t    # a tech who mistypes a VIN should not be handed raw JSON.\n119\t\n120\t    def _render_failure(request: Request, exc: Exception, status: int):\n121\t        body = ErrorBody(error=type(exc).__name__, detail=str(exc),\n122\t                         status=status)\n123\t        if request.url.path.startswith(\"/api\"):\n124\t            return JSONResponse(status_code=status, content=body.model_dump())\n125\t        return web_routes.error_page(request, body)\n126\t\n127\t    @app.exception_handler(BridgeError)\n128\t    async def _bridge_error(request: Request, exc: BridgeError):\n129\t        return _render_failure(request, exc, exc.status)\n130\t\n131\t    # Anything the library raises that the bridge did not classify is a bad\n132\t    # request, not a server fault: these are parse and lookup failures driven\n133\t    # by caller input, and a 500 would misreport whose problem it is.\n134\t    @app.exception_handler(MesError)\n135\t    async def _mes_error(request: Request, exc: MesError):\n136\t        return _render_failure(request, exc, 400)\n137\t\n138\t    # --- routes -----------------------------------------------------------\n139\t    app.include_router(system.router, prefix=\"/api\")\n140\t    app.include_router(attested_api.router, prefix=\"/api\")\n141\t    app.include_router(scan_health_api.router, prefix=\"/api\")\n142\t    app.include_router(vehicles.router, prefix=\"/api\")\n143\t    app.include_router(reference.router, prefix=\"/api\")\n144\t    app.include_router(recordings.router, prefix=\"/api\")\n145\t    app.include_router(logs.router, prefix=\"/api\")\n146\t    app.include_router(live.router, prefix=\"/api\")\n147\t    app.include_router(live_ui.router, prefix=\"/api\")\n148\t    app.include_router(liveboard.router, prefix=\"/api\")\n149\t    app.include_router(buscapture_api.router, prefix=\"/api\")\n150\t    app.include_router(modifications_api.router, prefix=\"/api\")\n151\t    app.include_router(owner_events_api.router, prefix=\"/api\")\n152\t    app.include_router(scanlog_api.router, prefix=\"/api\")\n153\t    app.include_router(vision_api.router, prefix=\"/api\")\n154\t    app.include_router(tests_api.router, prefix=\"/api\")\n155\t    app.include_router(known_good.router, prefix=\"/api\")\n156\t    app.include_router(checklists_api.router, prefix=\"/api\")\n157\t    app.include_router(dossier_api.router, prefix=\"/api\")\n158\t    app.include_router(timeline_api.router, prefix=\"/api\")\n159\t    app.include_router(tools_api.router, prefix=\"/api\")\n160\t    app.include_router(experience_api.router, prefix=\"/api\")\n161\t    app.include_router(media_api.router, prefix=\"/api\")\n162\t    app.include_router(parts_api.router, prefix=\"/api\")\n163\t    app.include_router(feedback_api.router, prefix=\"/api\")\n164\t    app.include_router(jobs_api.router, prefix=\"/api\")\n165\t    app.include_router(systems_api.router, prefix=\"/api\")\n166\t    app.include_router(systems_map_api.router, prefix=\"/api\")\n167\t    app.include_router(electrical_api.router, prefix=\"/api\")\n168\t    app.include_router(flow_api.router, prefix=\"/api\")\n169\t    app.include_router(tools_kb_api.router, prefix=\"/api\")\n170\t    app.include_router(shop_api.router, prefix=\"/api\")\n171\t    app.include_router(cases_api.router, prefix=\"/api\")\n172\t    app.include_router(dashboard_routes.api_router, prefix=\"/api\")\n173\t    app.include_router(service_routes.api_router, prefix=\"/api\")\n174\t    app.include_router(drivetrain_routes.api_router, prefix=\"/api\")\n175\t    app.include_router(labels_routes.api_router, prefix=\"/api\")\n176\t    app.include_router(web_routes.router)\n177\t    app.include_router(scanlog_routes.router)\n178\t    app.include_router(scan_plan_routes.router)\n179\t    app.include_router(bench_routes.router)\n180\t    app.include_router(shop_routes.router)\n181\t    app.include_router(dashboard_routes.router)\n182\t    app.include_router(service_routes.router)\n183\t    app.include_router(drivetrain_routes.router)\n184\t    app.include_router(labels_routes.router)\n185\t    app.include_router(dossier_routes.router)\n186\t    app.include_router(timeline_routes.router)\n187\t    app.include_router(tools_routes.router)\n188\t    app.include_router(inbox_routes.router)\n189\t    app.include_router(jobs_routes.router)\n190\t    app.include_router(live_dashboard_routes.router)\n191\t    app.include_router(liveboard_routes.router)\n192\t    app.include_router(learn_routes.router)\n193\t    app.include_router(owner_routes.router)\n194\t    app.include_router(tests_routes.router)\n195\t    app.include_router(media_routes.router)\n196\t    app.include_router(parts_routes.router)\n197\t    app.include_router(mods_routes.router)\n198\t    app.include_router(report_routes.router)\n199\t    app.include_router(systems_routes.router)\n200\t    app.include_router(system_routes.router)\n201\t    app.include_router(electrical_routes.router)\n202\t    app.include_router(modules_routes.router)\n203\t    app.include_router(scan_health_routes.router)\n204\t    app.include_router(fullscan_routes.router)\n205\t\n206\t    # Every /static URL is already cache-busted by static_version.static_url's\n207\t    # ``?v=<mtime hash>`` query string, so a long max-age would be safe -- but\n208\t    # a stray hand-typed /static/ link (or icons.svg's #fragment reference,\n209\t    # which browsers don't even send back to the server to revalidate) must\n210\t    # never stick a tech with yesterday's CSS/JS. no-cache forces a\n211\t    # revalidation request every time instead of serving straight from disk\n212\t    # cache, which costs nothing on a bench LAN.\n213\t    @app.middleware(\"http\")\n214\t    async def _no_cache_static(request: Request, call_next):\n215\t        response = await call_next(request)\n216\t        if request.url.path.startswith(\"/static\"):\n217\t            response.headers[\"Cache-Control\"] = \"no-cache, must-revalidate\"\n218\t        return response\n219\t\n220\t    app.mount(\"/static\",\n221\t              StaticFiles(directory=str(web_routes.STATIC_DIR)),\n222\t              name=\"static\")\n223\t\n224\t    return app\n225\t"}]},"uuid":"6c98d35c-734a-476c-880e-6056ac788631","timestamp":"2026-10-14T17:57:17.753Z","toolUseResult":{"type":"text","file":{"filePath":"C:\\Users\\User\\mcp-servers\\cuore\\app.py","content":"\"\"\"FastAPI application factory.\n\nTwo surfaces over one service layer:\n\n* ``/api/*`` -- JSON, mirroring the MCP tool surface call-for-call. This is\n  what a future PWA, the in-car node, and Claude's tool layer all talk to.\n* ``/`` -- server-rendered pages for bench use. They are a *client* of the same\n  bridge, not a parallel implementation, so the two cannot disagree.\n\nServer-rendered rather than a single-page app on purpose: no build step, no\nbundle to keep in sync, and it has to run on a Raspberry Pi.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport logging\nfrom contextlib import asynccontextmanager\n\nfrom . import __version__, bootstrap  # noqa: F401  -- bootstrap has a side effect\n\nfrom fastapi import FastAPI, Request  # noqa: E402\nfrom fastapi.responses import JSONResponse  # noqa: E402\nfrom fastapi.staticfiles import StaticFiles  # noqa: E402\n\nfrom mes.errors import MesError  # noqa: E402  -- needs bootstrap to have run\n\nfrom .api import attested as attested_api  # noqa: E402\nfrom .api import buscapture as buscapture_api  # noqa: E402\nfrom .api import modifications as modifications_api  # noqa: E402\nfrom .api import scan_health as scan_health_api  # noqa: E402\nfrom .api import cases as cases_api, checklists as checklists_api, dossier as dossier_api, electrical as electrical_api, feedback as feedback_api, flow as flow_api, jobs as jobs_api, known_good, live, live_ui, liveboard, logs, media as media_api, parts as parts_api, recordings, reference, shop as shop_api, system, systems as systems_api, systems_map as systems_map_api, tests as tests_api, timeline as timeline_api, tools as tools_api, tools_kb as tools_kb_api, experience as experience_api, vehicles  # noqa: E402\nfrom .config import Settings, load  # noqa: E402\nfrom .models import ErrorBody  # noqa: E402\nfrom .services.errors import BridgeError  # noqa: E402\nfrom .web import bench_routes  # noqa: E402\nfrom .web import dashboard_routes  # noqa: E402\nfrom .web import drivetrain_routes  # noqa: E402\nfrom .web import dossier_routes  # noqa: E402\nfrom .web import electrical_routes  # noqa: E402\nfrom .web import fullscan_routes  # noqa: E402\nfrom .web import labels_routes  # noqa: E402\nfrom .web import live_dashboard_routes  # noqa: E402\nfrom .web import liveboard_routes  # noqa: E402\nfrom .web import learn_routes  # noqa: E402\nfrom .web import owner_routes  # noqa: E402\nfrom .api import owner_events as owner_events_api  # noqa: E402\nfrom .api import scanlog as scanlog_api  # noqa: E402\nfrom .api import vision as vision_api  # noqa: E402\nfrom .web import media_routes  # noqa: E402\nfrom .web import mods_routes  # noqa: E402\nfrom .web import modules_routes  # noqa: E402\nfrom .web import parts_routes  # noqa: E402\nfrom .web import report_routes  # noqa: E402\nfrom .web import routes as web_routes  # noqa: E402\nfrom .web import scan_health_routes  # noqa: E402\nfrom .web import scan_plan_routes  # noqa: E402\nfrom .web import scanlog_routes  # noqa: E402\nfrom .web import service_routes  # noqa: E402\nfrom .web import shop_routes  # noqa: E402\nfrom .web import system_routes  # noqa: E402\nfrom .web import systems_routes  # noqa: E402\nfrom .web import tests_routes  # noqa: E402\nfrom .web import timeline_routes  # noqa: E402\nfrom .web import tools_routes  # noqa: E402\nfrom .web import inbox_routes  # noqa: E402\nfrom .web import jobs_routes  # noqa: E402\nfrom .web import flow_globals, tools_kb_globals  # noqa: F401\nfrom .web import icons, i18n  # noqa: F401\nfrom .web import static_version  # noqa: F401\n\nlog = logging.getLogger(\"cuore\")\n\nDESCRIPTION = \"\"\"\nCompanion service over the MultiEcuScan diagnostic toolchain.\n\nEvery analysis here comes from the `mes` library and is unit-tested against the\nreal log corpus. Two conventions run through the whole API and are worth knowing\nbefore reading any payload:\n\n* **Simulation logs are excluded by default.** Most of the FES corpus is MES\n  practice data. Pass `include_simulation=true` deliberately, or not at all.\n* **SCAN provenance is `unverifiable`, never clean.** That format carries no\n  simulation marker, so claiming a SCAN is real would be a claim the file\n  cannot support.\n\"\"\"\n\n\ndef create_app(settings: Settings | None = None) -> FastAPI:\n    \"\"\"Build the ASGI app. Safe to call repeatedly (tests do).\"\"\"\n    settings = settings or load()\n\n    @asynccontextmanager\n    async def lifespan(app: FastAPI):\n        log.info(\"CUORE %s starting: profile=%s bind=%s:%s\",\n                 __version__, settings.profile.value, settings.host,\n                 settings.port)\n        if settings.unguarded_lan:\n            log.warning(\n                \"Bound to %s with no token set. The log corpus contains \"\n                \"customer VINs and is now readable by every device on this \"\n                \"network. Set CUORE_TOKEN.\", settings.host)\n        yield\n\n    app = FastAPI(\n        title=\"CUORE\",\n        version=__version__,\n        description=DESCRIPTION,\n        lifespan=lifespan,\n        docs_url=\"/api/docs\",\n        redoc_url=None,\n        openapi_url=\"/api/openapi.json\",\n    )\n    app.state.settings = settings\n\n    # --- error handling ---------------------------------------------------\n    # The bridge raises transport-neutral errors. API callers get one uniform\n    # JSON body so failure parses exactly one way; browsers get a page, because\n    # a tech who mistypes a VIN should not be handed raw JSON.\n\n    def _render_failure(request: Request, exc: Exception, status: int):\n        body = ErrorBody(error=type(exc).__name__, detail=str(exc),\n                         status=status)\n        if request.url.path.startswith(\"/api\"):\n            return JSONResponse(status_code=status, content=body.model_dump())\n        return web_routes.error_page(request, body)\n\n    @app.exception_handler(BridgeError)\n    async def _bridge_error(request: Request, exc: BridgeError):\n        return _render_failure(request, exc, exc.status)\n\n    # Anything the library raises that the bridge did not classify is a bad\n    # request, not a server fault: these are parse and lookup failures driven\n    # by caller input, and a 500 would misreport whose problem it is.\n    @app.exception_handler(MesError)\n    async def _mes_error(request: Request, exc: MesError):\n        return _render_failure(request, exc, 400)\n\n    # --- routes -----------------------------------------------------------\n    app.include_router(system.router, prefix=\"/api\")\n    app.include_router(attested_api.router, prefix=\"/api\")\n    app.include_router(scan_health_api.router, prefix=\"/api\")\n    app.include_router(vehicles.router, prefix=\"/api\")\n    app.include_router(reference.router, prefix=\"/api\")\n    app.include_router(recordings.router, prefix=\"/api\")\n    app.include_router(logs.router, prefix=\"/api\")\n    app.include_router(live.router, prefix=\"/api\")\n    app.include_router(live_ui.router, prefix=\"/api\")\n    app.include_router(liveboard.router, prefix=\"/api\")\n    app.include_router(buscapture_api.router, prefix=\"/api\")\n    app.include_router(modifications_api.router, prefix=\"/api\")\n    app.include_router(owner_events_api.router, prefix=\"/api\")\n    app.include_router(scanlog_api.router, prefix=\"/api\")\n    app.include_router(vision_api.router, prefix=\"/api\")\n    app.include_router(tests_api.router, prefix=\"/api\")\n    app.include_router(known_good.router, prefix=\"/api\")\n    app.include_router(checklists_api.router, prefix=\"/api\")\n    app.include_router(dossier_api.router, prefix=\"/api\")\n    app.include_router(timeline_api.router, prefix=\"/api\")\n    app.include_router(tools_api.router, prefix=\"/api\")\n    app.include_router(experience_api.router, prefix=\"/api\")\n    app.include_router(media_api.router, prefix=\"/api\")\n    app.include_router(parts_api.router, prefix=\"/api\")\n    app.include_router(feedback_api.router, prefix=\"/api\")\n    app.include_router(jobs_api.router, prefix=\"/api\")\n    app.include_router(systems_api.router, prefix=\"/api\")\n    app.include_router(systems_map_api.router, prefix=\"/api\")\n    app.include_router(electrical_api.router, prefix=\"/api\")\n    app.include_router(flow_api.router, prefix=\"/api\")\n    app.include_router(tools_kb_api.router, prefix=\"/api\")\n    app.include_router(shop_api.router, prefix=\"/api\")\n    app.include_router(cases_api.router, prefix=\"/api\")\n    app.include_router(dashboard_routes.api_router, prefix=\"/api\")\n    app.include_router(service_routes.api_router, prefix=\"/api\")\n    app.include_router(drivetrain_routes.api_router, prefix=\"/api\")\n    app.include_router(labels_routes.api_router, prefix=\"/api\")\n    app.include_router(web_routes.router)\n    app.include_router(scanlog_routes.router)\n    app.include_router(scan_plan_routes.router)\n    app.include_router(bench_routes.router)\n    app.include_router(shop_routes.router)\n    app.include_router(dashboard_routes.router)\n    app.include_router(service_routes.router)\n    app.include_router(drivetrain_routes.router)\n    app.include_router(labels_routes.router)\n    app.include_router(dossier_routes.router)\n    app.include_router(timeline_routes.router)\n    app.include_router(tools_routes.router)\n    app.include_router(inbox_routes.router)\n    app.include_router(jobs_routes.router)\n    app.include_router(live_dashboard_routes.router)\n    app.include_router(liveboard_routes.router)\n    app.include_router(learn_routes.router)\n    app.include_router(owner_routes.router)\n    app.include_router(tests_routes.router)\n    app.include_router(media_routes.router)\n    app.include_router(parts_routes.router)\n    app.include_router(mods_routes.router)\n    app.include_router(report_routes.router)\n    app.include_router(systems_routes.router)\n    app.include_router(system_routes.router)\n    app.include_router(electrical_routes.router)\n    app.include_router(modules_routes.router)\n    app.include_router(scan_health_routes.router)\n    app.include_router(fullscan_routes.router)\n\n    # Every /static URL is already cache-busted by static_version.static_url's\n    # ``?v=<mtime hash>`` query string, so a long max-age would be safe -- but\n    # a stray hand-typed /static/ link (or icons.svg's #fragment reference,\n    # which browsers don't even send back to the server to revalidate) must\n    # never stick a tech with yesterday's CSS/JS. no-cache forces a\n    # revalidation request every time instead of serving straight from disk\n    # cache, which costs nothing on a bench LAN.\n    @app.middleware(\"http\")\n    async def _no_cache_static(request: Request, call_next):\n        response = await call_next(request)\n        if request.url.path.startswith(\"/static\"):\n            response.headers[\"Cache-Control\"] = \"no-cache, must-revalidate\"\n        return response\n\n    app.mount(\"/static\",\n              StaticFiles(directory=str(web_routes.STATIC_DIR)),\n              name=\"static\")\n\n    return app\n","numLines":225,"startLine":1,"totalLines":225}},"sourceToolAssistantUUID":"10113a51-e9da-4257-8f2b-fd5d1e07e979","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
