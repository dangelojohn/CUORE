{"parentUuid":"a780f6e7-1b34-40d6-b98c-5bbfc8b8044d","isSidechain":true,"agentId":"ac3048c66f3643aa6","message":{"model":"claude-sonnet-5","id":"msg_011Cg2ZjcmYcKqXn8YNWKWhx","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_017ajYDRJdA7khv81bmghTHm","name":"Read","input":{"file_path":"C:\\Users\\User\\mcp-servers\\cuore\\live\\buscapture.py"},"caller":{"type":"direct"}}],"container":null,"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2931,"cache_read_input_tokens":128665,"output_tokens":452,"output_tokens_details":{"thinking_tokens":377},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":0,"ephemeral_5m_input_tokens":2931},"inference_geo":"global","iterations":[{"input_tokens":2,"output_tokens":452,"cache_read_input_tokens":128665,"cache_creation_input_tokens":2931,"cache_creation":{"ephemeral_5m_input_tokens":2931,"ephemeral_1h_input_tokens":0},"type":"message"}],"speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_017ajYDRJdA7khv81bmghTHm":{"file_path":"C:\\Users\\User\\mcp-servers\\cuore\\live\\buscapture.py"}},"serverClassifierRequest":"cffbb892-a343-4033-b51b-09e904a0fca5","apiBlockIndex":1,"requestId":"req_011Cg2Zjc3tQGfNCJuNwanKk","attributionAgent":"general-purpose","type":"assistant","uuid":"e235f6b9-c730-4693-bc73-5f196c25d943","timestamp":"2026-10-14T17:59:51.721Z","effort":"high","perTurnEffort":null,"userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
{"parentUuid":"e235f6b9-c730-4693-bc73-5f196c25d943","isSidechain":true,"promptId":"5b1f3ca0-47aa-46ad-b4cb-7ebe226b6ba4","agentId":"ac3048c66f3643aa6","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017ajYDRJdA7khv81bmghTHm","type":"tool_result","content":"1\t\"\"\"Bus capture and broadcast-signal learning on a declared bypass cable.\n2\t\n3\tTwo mechanic-facing flows, both built on the existing passive listen\n4\t(:func:`cuore.live.capture.listen`) and read-only by construction -- every\n5\tsession this module opens is ``passive=True``, so nothing here ever\n6\ttransmits a byte onto CAN-IHS or CAN-CH:\n7\t\n8\t* **bus capture** -- Start/Stop a passive listen on one bus, watch the live\n9\t  frame rate and distinct-ID count while it runs, Stop, then Save to a CSV\n10\t  recording in the same wire format cuore's own live sessions already write\n11\t  (:class:`cuore.live.poller.CsvRecorder`), tagged with the bus, the\n12\t  declared cable and the time, and logged as a from-car observation (kind\n13\t  ``\"bus_capture\"``) so the Scans area can show it.\n14\t* **learn a signal** -- the identical Start/Stop capture, kept as raw\n15\t  frames so :func:`rank_changed_bytes` can rank every ``(CAN id, byte\n16\t  offset)`` by how much it changed during the window a mechanic held a\n17\t  named physical action (brake pedal, door, HVAC fan...). The mechanic\n18\t  names the best candidate and :func:`learn_accept` saves it through\n19\t  :mod:`cuore.live.learned` as a ``\"broadcast\"`` entry with\n20\t  ``scale=\"unknown\"`` -- never a guessed scale.\n21\t\n22\tBoth refuse (:class:`Refused`) with no cable declared for the target bus,\n23\tor with the adapter held by the poller/MES -- :func:`cuore.live.transport.\n24\tAdapterLink.session`'s own interlock still applies once the background\n25\tthread opens the adapter, but the check here gives a clear refusal before\n26\ta thread is even started.\n27\t\"\"\"\n28\t\n29\tfrom __future__ import annotations\n30\t\n31\timport threading\n32\timport time\n33\tfrom collections import Counter\n34\tfrom datetime import datetime\n35\tfrom typing import Any, Optional\n36\t\n37\tfrom . import capture as capture_mod\n38\tfrom . import interlock\n39\tfrom . import replay\n40\tfrom . import store\n41\tfrom .buses import BUSES, Bus, route_for\n42\tfrom .channels import Channel\n43\tfrom .errors import BadCommand, Refused\n44\tfrom .poller import CsvRecorder\n45\tfrom .transport import link\n46\t\n47\t#: One capture window inside the background thread's loop. Short enough\n48\t#: that Stop takes effect within about a second, long enough not to thrash\n49\t#: the adapter's monitor start/interrupt cycle.\n50\t_WINDOW_S = 1.0\n51\t#: Safety cap on frames retained in memory / written to a recording. A\n52\t#: busy bus held open for minutes would otherwise grow without bound.\n53\t_MAX_FRAMES = 20000\n54\t\n55\t_LOCK = threading.Lock()\n56\t#: One session per bus -- starting a second capture/learn on the same bus\n57\t#: while one is running is refused, not queued.\n58\t_SESSIONS: dict[str, dict[str, Any]] = {}\n59\t\n60\t\n61\tdef _bus(key: str) -> Bus:\n62\t    b = BUSES.get((key or \"\").lower())\n63\t    if b is None:\n64\t        raise BadCommand(f\"unknown bus {key!r}; one of {list(BUSES)}\")\n65\t    return b\n66\t\n67\t\n68\tdef _check_ready(bus: Bus) -> None:\n69\t    \"\"\"Refuse before a thread starts: no cable, or the adapter is held.\"\"\"\n70\t    lk = link()\n71\t    if route_for(bus, lk.cable) is None:\n72\t        raise Refused(\n73\t            f\"no cable declared for {bus.key}: cable is {lk.cable!r}. Declare the bypass \"\n74\t            f\"cable that reaches {bus.key} first (set_cable).\")\n75\t    held = interlock.blocked_by()\n76\t    if held:\n77\t        raise Refused(f\"adapter is held: {held}\")\n78\t\n79\t\n80\tdef _new_state(bus: Bus, purpose: str, action: str = \"\") -> dict[str, Any]:\n81\t    return {\n82\t        \"bus\": bus.key, \"purpose\": purpose, \"action\": action, \"status\": \"running\",\n83\t        \"started_at\": datetime.now().isoformat(timespec=\"seconds\"), \"finished_at\": None,\n84\t        \"cable\": link().cable, \"stream\": \"\", \"frames\": [], \"ids\": Counter(),\n85\t        \"last_rate_hz\": 0.0, \"error\": None, \"saved_path\": None, \"saved_name\": None,\n86\t        \"_t0\": time.monotonic(), \"_stop\": threading.Event(), \"_thread\": None,\n87\t    }\n88\t\n89\t\n90\tdef _run(bus: Bus, state: dict[str, Any]) -> None:\n91\t    lk = link()\n92\t    session_start = time.monotonic()\n93\t    try:\n94\t        with lk.session(f\"bus_{state['purpose']}\", bus=bus, passive=True) as sess:\n95\t            state[\"stream\"] = sess.stream.describe\n96\t            while not state[\"_stop\"].is_set():\n97\t                window_t0 = time.monotonic() - session_start\n98\t                cap = capture_mod.listen(sess, seconds=_WINDOW_S, max_frames=2000)\n99\t                err = cap.get(\"error\")\n100\t                if err and err not in (\"DATA ERROR\", \"STOPPED\"):\n101\t                    state[\"error\"] = err\n102\t                state[\"last_rate_hz\"] = cap.get(\"rate_hz\", 0.0)\n103\t                for f in cap.get(\"frames\", []):\n104\t                    state[\"ids\"][f[\"id\"]] += 1\n105\t                    if len(state[\"frames\"]) < _MAX_FRAMES:\n106\t                        state[\"frames\"].append(\n107\t                            {\"t\": round(window_t0 + f[\"t\"], 4), \"id\": f[\"id\"], \"data\": f[\"data\"]})\n108\t    except Exception as e:  # noqa: BLE001 -- the thread must never die silently\n109\t        state[\"error\"] = str(e)\n110\t    finally:\n111\t        state[\"status\"] = \"stopped\"\n112\t        state[\"finished_at\"] = datetime.now().isoformat(timespec=\"seconds\")\n113\t\n114\t\n115\tdef _public(state: dict[str, Any]) -> dict[str, Any]:\n116\t    elapsed = round(time.monotonic() - state[\"_t0\"], 2)\n117\t    frame_count = sum(state[\"ids\"].values())\n118\t    return {\n119\t        \"bus\": state[\"bus\"], \"purpose\": state[\"purpose\"], \"action\": state[\"action\"],\n120\t        \"status\": state[\"status\"], \"cable\": state[\"cable\"],\n121\t        \"started_at\": state[\"started_at\"], \"finished_at\": state[\"finished_at\"],\n122\t        \"elapsed_s\": elapsed, \"frame_count\": frame_count, \"distinct_ids\": len(state[\"ids\"]),\n123\t        \"ids\": dict(state[\"ids\"].most_common(20)),\n124\t        \"rate_hz\": round(frame_count / elapsed, 1) if elapsed > 0 else 0.0,\n125\t        \"error\": state[\"error\"], \"saved_path\": state[\"saved_path\"],\n126\t        \"saved_name\": state[\"saved_name\"],\n127\t    }\n128\t\n129\t\n130\tdef _start(bus_key: str, purpose: str, action: str = \"\") -> dict[str, Any]:\n131\t    b = _bus(bus_key)\n132\t    with _LOCK:\n133\t        existing = _SESSIONS.get(b.key)\n134\t        if existing is not None and existing[\"status\"] == \"running\":\n135\t            raise Refused(f\"a {existing['purpose']} session is already running on {b.key}; \"\n136\t                          f\"stop it first\")\n137\t        _check_ready(b)\n138\t        state = _new_state(b, purpose, action)\n139\t        _SESSIONS[b.key] = state\n140\t    thread = threading.Thread(target=_run, args=(b, state), daemon=True,\n141\t                              name=f\"cuore-buscapture-{b.key}\")\n142\t    state[\"_thread\"] = thread\n143\t    thread.start()\n144\t    return _public(state)\n145\t\n146\t\n147\tdef _get(bus_key: str) -> dict[str, Any]:\n148\t    b = _bus(bus_key)\n149\t    state = _SESSIONS.get(b.key)\n150\t    if state is None:\n151\t        raise BadCommand(f\"no capture/learn session on {b.key}; start one first\")\n152\t    return state\n153\t\n154\t\n155\tdef _stop(bus_key: str) -> dict[str, Any]:\n156\t    state = _get(bus_key)\n157\t    state[\"_stop\"].set()\n158\t    thread = state.get(\"_thread\")\n159\t    if thread is not None:\n160\t        thread.join(timeout=5.0)\n161\t    return _public(state)\n162\t\n163\t\n164\t# ===========================================================================\n165\t# bus capture: Start / Stop / Save\n166\t# ===========================================================================\n167\t\n168\tdef capture_start(bus: str) -> dict[str, Any]:\n169\t    \"\"\"Start a passive capture on ``bus``. Refuses with no cable declared\n170\t    for that bus, the adapter held, or a session already running on it.\"\"\"\n171\t    return _start(bus, \"capture\")\n172\t\n173\t\n174\tdef capture_status(bus: str) -> dict[str, Any]:\n175\t    \"\"\"Live frame rate and distinct-ID counts of a running (or just-stopped)\n176\t    capture.\"\"\"\n177\t    return _public(_get(bus))\n178\t\n179\t\n180\tdef capture_stop(bus: str) -> dict[str, Any]:\n181\t    \"\"\"Stop a running capture; frames already read are kept for Save.\"\"\"\n182\t    state = _stop(bus)\n183\t    return state\n184\t\n185\t\n186\tdef capture_save(bus: str, vin: str = \"\") -> dict[str, Any]:\n187\t    \"\"\"Write the stopped capture to a CSV recording and log a from-car\n188\t    ``\"bus_capture\"`` observation. A capture must be stopped first. Saving\n189\t    twice is a no-op that returns the same recording.\"\"\"\n190\t    b = _bus(bus)\n191\t    state = _get(b.key)\n192\t    if state[\"status\"] == \"running\":\n193\t        raise BadCommand(\"this capture is still running; stop it first\")\n194\t    if state.get(\"saved_path\"):\n195\t        out = _public(state)\n196\t        out[\"already_saved\"] = True\n197\t        return out\n198\t\n199\t    ids = sorted(state[\"ids\"])\n200\t    channels = [Channel(id=f\"raw_{h}\", name=f\"CAN {h}\", unit=\"hex\", kind=\"broadcast\",\n201\t                        bus=b.key, confidence=\"raw_capture\", default_rate_hz=0.0)\n202\t               for h in ids]\n203\t    ts = datetime.now().strftime(\"%Y%m%d-%H%M%S\")\n204\t    name = f\"buscapture_{b.key}_{state['cable']}_{ts}.csv\"\n205\t    path = replay.cuore_recordings_dir() / name\n206\t    rec = CsvRecorder(path, channels)\n207\t    rec.start()\n208\t    for f in sorted(state[\"frames\"], key=lambda x: x[\"t\"]):\n209\t        rec.update(f\"raw_{f['id']}\", f[\"data\"])\n210\t        rec.write_row()\n211\t    rec.stop()\n212\t\n213\t    state[\"saved_path\"] = str(path)\n214\t    state[\"saved_name\"] = name\n215\t    frame_count = sum(state[\"ids\"].values())\n216\t    store.record_observation(\n217\t        \"bus_capture\",\n218\t        {\"bus\": b.key, \"cable\": state[\"cable\"], \"recording\": name, \"path\": str(path),\n219\t         \"frame_count\": frame_count, \"distinct_ids\": len(state[\"ids\"]),\n220\t         \"ids\": dict(state[\"ids\"])},\n221\t        vin=vin, bus=b.key, cable=state[\"cable\"], stream=state[\"stream\"] or \"\")\n222\t    out = _public(state)\n223\t    out[\"already_saved\"] = False\n224\t    return out\n225\t\n226\t\n227\t# ===========================================================================\n228\t# learn a signal: Start / Stop, then rank and accept\n229\t# ===========================================================================\n230\t\n231\tdef learn_start(bus: str, action: str) -> dict[str, Any]:\n232\t    \"\"\"Start the same passive capture, tagged with the physical action the\n233\t    mechanic is about to perform (e.g. \"press the brake pedal\").\"\"\"\n234\t    if not (action or \"\").strip():\n235\t        raise BadCommand(\"an action description is required (what the mechanic is doing)\")\n236\t    return _start(bus, \"learn\", action.strip())\n237\t\n238\t\n239\tdef learn_status(bus: str) -> dict[str, Any]:\n240\t    return _public(_get(bus))\n241\t\n242\t\n243\tdef rank_changed_bytes(frames: list[dict[str, Any]], top: int = 15) -> list[dict[str, Any]]:\n244\t    \"\"\"Rank every ``(CAN id, byte offset)`` by how much it changed across\n245\t    ``frames`` -- no marks needed, because the whole Start-to-Stop window is\n246\t    \"while the action was held\". Scored by the number of distinct values\n247\t    seen (a byte that never changes scores 0 and is dropped); ties broken by\n248\t    more transitions first, since a clean step (idle -> pressed) has fewer\n249\t    distinct values than a noisy one but is still the signal. Ignores a\n250\t    CAN id's last byte beyond the shortest frame seen for it, so it is\n251\t    never scored past data every frame on that id actually carried.\n252\t    \"\"\"\n253\t    by_id: dict[str, list[dict[str, Any]]] = {}\n254\t    for f in sorted(frames, key=lambda x: x[\"t\"]):\n255\t        by_id.setdefault(f[\"id\"], []).append(f)\n256\t\n257\t    candidates: list[dict[str, Any]] = []\n258\t    for can_id, fs in by_id.items():\n259\t        min_len = min(len(f[\"data\"]) // 2 for f in fs)\n260\t        for off in range(min_len):\n261\t            values = [int(f[\"data\"][2 * off:2 * off + 2], 16) for f in fs]\n262\t            distinct = sorted(set(values))\n263\t            if len(distinct) < 2:\n264\t                continue\n265\t            transitions = sum(1 for a, b in zip(values, values[1:]) if a != b)\n266\t            candidates.append({\n267\t                \"id\": can_id, \"offset\": off, \"width\": \"byte\",\n268\t                \"score\": len(distinct), \"transitions\": transitions,\n269\t                \"values_seen\": distinct,\n270\t                \"evidence\": [{\"t\": f[\"t\"], \"raw\": v} for f, v in zip(fs, values)][:20],\n271\t            })\n272\t    candidates.sort(key=lambda c: (c[\"score\"], c[\"transitions\"]))\n273\t    return candidates[:top]\n274\t\n275\t\n276\tdef learn_stop(bus: str) -> dict[str, Any]:\n277\t    \"\"\"Stop a running learn capture and rank the candidates it saw.\"\"\"\n278\t    state = _stop(bus)\n279\t    full = _get(bus)\n280\t    candidates = rank_changed_bytes(full[\"frames\"])\n281\t    out = _public(full)\n282\t    out[\"candidates\"] = candidates\n283\t    return out\n284\t\n285\t\n286\tdef learn_accept(vin: str, bus: str, can_id: str, offset: int, name: str) -> dict[str, Any]:\n287\t    \"\"\"Name the ranked candidate and save it as a learned broadcast signal.\n288\t\n289\t    ``scale`` is always ``\"unknown\"`` here (see :mod:`cuore.live.learned`):\n290\t    a raw byte's physical units are never guessed from one capture.\n291\t    \"\"\"\n292\t    from . import learned as learned_mod\n293\t    if not (vin or \"\").strip():\n294\t        raise BadCommand(\"a VIN is required to save a learned signal\")\n295\t    if not (name or \"\").strip():\n296\t        raise BadCommand(\"a name is required for the learned signal\")\n297\t    b = _bus(bus)\n298\t    field = {\"offset\": int(offset), \"width\": \"byte\"}\n299\t    return learned_mod.accept_broadcast(vin.strip(), b.key, can_id, name.strip(), field)\n300\t\n301\t\n302\t# ===========================================================================\n303\t# per-bus presets and the cable header\n304\t# ===========================================================================\n305\t\n306\tdef preset_info(name: str, vin: str = \"\") -> dict[str, Any]:\n307\t    \"\"\"One bus-capture preset's items, resolved against the catalogue and\n308\t    this VIN's learned broadcast signals. See :func:`cuore.live.channels.\n309\t    bus_capture_preset`.\"\"\"\n310\t    from . import channels as channels_mod\n311\t    return channels_mod.bus_capture_preset(name, vin)\n312\t\n313\t\n314\tdef preset_capture_start(name: str, vin: str = \"\") -> dict[str, Any]:\n315\t    \"\"\"Start a bus capture scoped to one preset's bus. Refuses\n316\t    (:class:`Refused`) unless the preset's required cable is declared --\n317\t    before :func:`capture_start`'s own cable/interlock check even runs.\"\"\"\n318\t    from . import channels as channels_mod\n319\t    spec = channels_mod.BUS_CAPTURE_PRESETS.get(name)\n320\t    if spec is None:\n321\t        raise BadCommand(f\"unknown bus-capture preset {name!r}; one of \"\n322\t                         f\"{sorted(channels_mod.BUS_CAPTURE_PRESETS)}\")\n323\t    lk = link()\n324\t    if lk.cable != spec[\"cable\"]:\n325\t        raise Refused(\n326\t            f\"preset {name!r} ({spec['name']}) needs cable {spec['cable']!r} declared; \"\n327\t            f\"the declared cable is {lk.cable!r}. Fit the cable and set_cable({spec['cable']!r}) \"\n328\t            f\"first.\")\n329\t    return capture_start(spec[\"bus\"])\n330\t\n331\t\n332\tdef cable_header(vin: str = \"\") -> dict[str, Any]:\n333\t    \"\"\"What the Live board's header shows: the declared cable, which buses\n334\t    it reaches, and which bus-capture presets it unlocks.\"\"\"\n335\t    from . import channels as channels_mod\n336\t    lk = link()\n337\t    state = lk.cable_state()\n338\t    presets = []\n339\t    for pname, spec in channels_mod.BUS_CAPTURE_PRESETS.items():\n340\t        presets.append({\"preset\": pname, \"name\": spec[\"name\"], \"bus\": spec[\"bus\"],\n341\t                        \"cable_required\": spec[\"cable\"], \"enabled\": lk.cable == spec[\"cable\"]})\n342\t    return {**state, \"presets\": presets}\n343\t\n344\t\n345\tdef set_cable(cable: str) -> dict[str, Any]:\n346\t    \"\"\"Declare the fitted cable (or ``\"none\"``). Clears stale bus\n347\t    verifications when the cable actually changes -- see\n348\t    :meth:`cuore.live.transport.AdapterLink.set_cable`. Returns the same\n349\t    shape as :func:`cable_header` so a \"Change cable\" confirmation can list\n350\t    what the new declaration enables in one call.\"\"\"\n351\t    link().set_cable(cable)\n352\t    return cable_header()\n353\t\n354\t\n355\t__all__ = [\"capture_start\", \"capture_status\", \"capture_stop\", \"capture_save\",\n356\t          \"learn_start\", \"learn_status\", \"learn_stop\", \"learn_accept\",\n357\t          \"rank_changed_bytes\", \"preset_info\", \"preset_capture_start\",\n358\t          \"cable_header\", \"set_cable\"]\n359\t"}]},"uuid":"433ddcf5-d7c4-48b0-ab1c-1ccded3c338d","timestamp":"2026-10-14T17:59:51.751Z","toolUseResult":{"type":"text","file":{"filePath":"C:\\Users\\User\\mcp-servers\\cuore\\live\\buscapture.py","content":"\"\"\"Bus capture and broadcast-signal learning on a declared bypass cable.\n\nTwo mechanic-facing flows, both built on the existing passive listen\n(:func:`cuore.live.capture.listen`) and read-only by construction -- every\nsession this module opens is ``passive=True``, so nothing here ever\ntransmits a byte onto CAN-IHS or CAN-CH:\n\n* **bus capture** -- Start/Stop a passive listen on one bus, watch the live\n  frame rate and distinct-ID count while it runs, Stop, then Save to a CSV\n  recording in the same wire format cuore's own live sessions already write\n  (:class:`cuore.live.poller.CsvRecorder`), tagged with the bus, the\n  declared cable and the time, and logged as a from-car observation (kind\n  ``\"bus_capture\"``) so the Scans area can show it.\n* **learn a signal** -- the identical Start/Stop capture, kept as raw\n  frames so :func:`rank_changed_bytes` can rank every ``(CAN id, byte\n  offset)`` by how much it changed during the window a mechanic held a\n  named physical action (brake pedal, door, HVAC fan...). The mechanic\n  names the best candidate and :func:`learn_accept` saves it through\n  :mod:`cuore.live.learned` as a ``\"broadcast\"`` entry with\n  ``scale=\"unknown\"`` -- never a guessed scale.\n\nBoth refuse (:class:`Refused`) with no cable declared for the target bus,\nor with the adapter held by the poller/MES -- :func:`cuore.live.transport.\nAdapterLink.session`'s own interlock still applies once the background\nthread opens the adapter, but the check here gives a clear refusal before\na thread is even started.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport threading\nimport time\nfrom collections import Counter\nfrom datetime import datetime\nfrom typing import Any, Optional\n\nfrom . import capture as capture_mod\nfrom . import interlock\nfrom . import replay\nfrom . import store\nfrom .buses import BUSES, Bus, route_for\nfrom .channels import Channel\nfrom .errors import BadCommand, Refused\nfrom .poller import CsvRecorder\nfrom .transport import link\n\n#: One capture window inside the background thread's loop. Short enough\n#: that Stop takes effect within about a second, long enough not to thrash\n#: the adapter's monitor start/interrupt cycle.\n_WINDOW_S = 1.0\n#: Safety cap on frames retained in memory / written to a recording. A\n#: busy bus held open for minutes would otherwise grow without bound.\n_MAX_FRAMES = 20000\n\n_LOCK = threading.Lock()\n#: One session per bus -- starting a second capture/learn on the same bus\n#: while one is running is refused, not queued.\n_SESSIONS: dict[str, dict[str, Any]] = {}\n\n\ndef _bus(key: str) -> Bus:\n    b = BUSES.get((key or \"\").lower())\n    if b is None:\n        raise BadCommand(f\"unknown bus {key!r}; one of {list(BUSES)}\")\n    return b\n\n\ndef _check_ready(bus: Bus) -> None:\n    \"\"\"Refuse before a thread starts: no cable, or the adapter is held.\"\"\"\n    lk = link()\n    if route_for(bus, lk.cable) is None:\n        raise Refused(\n            f\"no cable declared for {bus.key}: cable is {lk.cable!r}. Declare the bypass \"\n            f\"cable that reaches {bus.key} first (set_cable).\")\n    held = interlock.blocked_by()\n    if held:\n        raise Refused(f\"adapter is held: {held}\")\n\n\ndef _new_state(bus: Bus, purpose: str, action: str = \"\") -> dict[str, Any]:\n    return {\n        \"bus\": bus.key, \"purpose\": purpose, \"action\": action, \"status\": \"running\",\n        \"started_at\": datetime.now().isoformat(timespec=\"seconds\"), \"finished_at\": None,\n        \"cable\": link().cable, \"stream\": \"\", \"frames\": [], \"ids\": Counter(),\n        \"last_rate_hz\": 0.0, \"error\": None, \"saved_path\": None, \"saved_name\": None,\n        \"_t0\": time.monotonic(), \"_stop\": threading.Event(), \"_thread\": None,\n    }\n\n\ndef _run(bus: Bus, state: dict[str, Any]) -> None:\n    lk = link()\n    session_start = time.monotonic()\n    try:\n        with lk.session(f\"bus_{state['purpose']}\", bus=bus, passive=True) as sess:\n            state[\"stream\"] = sess.stream.describe\n            while not state[\"_stop\"].is_set():\n                window_t0 = time.monotonic() - session_start\n                cap = capture_mod.listen(sess, seconds=_WINDOW_S, max_frames=2000)\n                err = cap.get(\"error\")\n                if err and err not in (\"DATA ERROR\", \"STOPPED\"):\n                    state[\"error\"] = err\n                state[\"last_rate_hz\"] = cap.get(\"rate_hz\", 0.0)\n                for f in cap.get(\"frames\", []):\n                    state[\"ids\"][f[\"id\"]] += 1\n                    if len(state[\"frames\"]) < _MAX_FRAMES:\n                        state[\"frames\"].append(\n                            {\"t\": round(window_t0 + f[\"t\"], 4), \"id\": f[\"id\"], \"data\": f[\"data\"]})\n    except Exception as e:  # noqa: BLE001 -- the thread must never die silently\n        state[\"error\"] = str(e)\n    finally:\n        state[\"status\"] = \"stopped\"\n        state[\"finished_at\"] = datetime.now().isoformat(timespec=\"seconds\")\n\n\ndef _public(state: dict[str, Any]) -> dict[str, Any]:\n    elapsed = round(time.monotonic() - state[\"_t0\"], 2)\n    frame_count = sum(state[\"ids\"].values())\n    return {\n        \"bus\": state[\"bus\"], \"purpose\": state[\"purpose\"], \"action\": state[\"action\"],\n        \"status\": state[\"status\"], \"cable\": state[\"cable\"],\n        \"started_at\": state[\"started_at\"], \"finished_at\": state[\"finished_at\"],\n        \"elapsed_s\": elapsed, \"frame_count\": frame_count, \"distinct_ids\": len(state[\"ids\"]),\n        \"ids\": dict(state[\"ids\"].most_common(20)),\n        \"rate_hz\": round(frame_count / elapsed, 1) if elapsed > 0 else 0.0,\n        \"error\": state[\"error\"], \"saved_path\": state[\"saved_path\"],\n        \"saved_name\": state[\"saved_name\"],\n    }\n\n\ndef _start(bus_key: str, purpose: str, action: str = \"\") -> dict[str, Any]:\n    b = _bus(bus_key)\n    with _LOCK:\n        existing = _SESSIONS.get(b.key)\n        if existing is not None and existing[\"status\"] == \"running\":\n            raise Refused(f\"a {existing['purpose']} session is already running on {b.key}; \"\n                          f\"stop it first\")\n        _check_ready(b)\n        state = _new_state(b, purpose, action)\n        _SESSIONS[b.key] = state\n    thread = threading.Thread(target=_run, args=(b, state), daemon=True,\n                              name=f\"cuore-buscapture-{b.key}\")\n    state[\"_thread\"] = thread\n    thread.start()\n    return _public(state)\n\n\ndef _get(bus_key: str) -> dict[str, Any]:\n    b = _bus(bus_key)\n    state = _SESSIONS.get(b.key)\n    if state is None:\n        raise BadCommand(f\"no capture/learn session on {b.key}; start one first\")\n    return state\n\n\ndef _stop(bus_key: str) -> dict[str, Any]:\n    state = _get(bus_key)\n    state[\"_stop\"].set()\n    thread = state.get(\"_thread\")\n    if thread is not None:\n        thread.join(timeout=5.0)\n    return _public(state)\n\n\n# ===========================================================================\n# bus capture: Start / Stop / Save\n# ===========================================================================\n\ndef capture_start(bus: str) -> dict[str, Any]:\n    \"\"\"Start a passive capture on ``bus``. Refuses with no cable declared\n    for that bus, the adapter held, or a session already running on it.\"\"\"\n    return _start(bus, \"capture\")\n\n\ndef capture_status(bus: str) -> dict[str, Any]:\n    \"\"\"Live frame rate and distinct-ID counts of a running (or just-stopped)\n    capture.\"\"\"\n    return _public(_get(bus))\n\n\ndef capture_stop(bus: str) -> dict[str, Any]:\n    \"\"\"Stop a running capture; frames already read are kept for Save.\"\"\"\n    state = _stop(bus)\n    return state\n\n\ndef capture_save(bus: str, vin: str = \"\") -> dict[str, Any]:\n    \"\"\"Write the stopped capture to a CSV recording and log a from-car\n    ``\"bus_capture\"`` observation. A capture must be stopped first. Saving\n    twice is a no-op that returns the same recording.\"\"\"\n    b = _bus(bus)\n    state = _get(b.key)\n    if state[\"status\"] == \"running\":\n        raise BadCommand(\"this capture is still running; stop it first\")\n    if state.get(\"saved_path\"):\n        out = _public(state)\n        out[\"already_saved\"] = True\n        return out\n\n    ids = sorted(state[\"ids\"])\n    channels = [Channel(id=f\"raw_{h}\", name=f\"CAN {h}\", unit=\"hex\", kind=\"broadcast\",\n                        bus=b.key, confidence=\"raw_capture\", default_rate_hz=0.0)\n               for h in ids]\n    ts = datetime.now().strftime(\"%Y%m%d-%H%M%S\")\n    name = f\"buscapture_{b.key}_{state['cable']}_{ts}.csv\"\n    path = replay.cuore_recordings_dir() / name\n    rec = CsvRecorder(path, channels)\n    rec.start()\n    for f in sorted(state[\"frames\"], key=lambda x: x[\"t\"]):\n        rec.update(f\"raw_{f['id']}\", f[\"data\"])\n        rec.write_row()\n    rec.stop()\n\n    state[\"saved_path\"] = str(path)\n    state[\"saved_name\"] = name\n    frame_count = sum(state[\"ids\"].values())\n    store.record_observation(\n        \"bus_capture\",\n        {\"bus\": b.key, \"cable\": state[\"cable\"], \"recording\": name, \"path\": str(path),\n         \"frame_count\": frame_count, \"distinct_ids\": len(state[\"ids\"]),\n         \"ids\": dict(state[\"ids\"])},\n        vin=vin, bus=b.key, cable=state[\"cable\"], stream=state[\"stream\"] or \"\")\n    out = _public(state)\n    out[\"already_saved\"] = False\n    return out\n\n\n# ===========================================================================\n# learn a signal: Start / Stop, then rank and accept\n# ===========================================================================\n\ndef learn_start(bus: str, action: str) -> dict[str, Any]:\n    \"\"\"Start the same passive capture, tagged with the physical action the\n    mechanic is about to perform (e.g. \"press the brake pedal\").\"\"\"\n    if not (action or \"\").strip():\n        raise BadCommand(\"an action description is required (what the mechanic is doing)\")\n    return _start(bus, \"learn\", action.strip())\n\n\ndef learn_status(bus: str) -> dict[str, Any]:\n    return _public(_get(bus))\n\n\ndef rank_changed_bytes(frames: list[dict[str, Any]], top: int = 15) -> list[dict[str, Any]]:\n    \"\"\"Rank every ``(CAN id, byte offset)`` by how much it changed across\n    ``frames`` -- no marks needed, because the whole Start-to-Stop window is\n    \"while the action was held\". Scored by the number of distinct values\n    seen (a byte that never changes scores 0 and is dropped); ties broken by\n    more transitions first, since a clean step (idle -> pressed) has fewer\n    distinct values than a noisy one but is still the signal. Ignores a\n    CAN id's last byte beyond the shortest frame seen for it, so it is\n    never scored past data every frame on that id actually carried.\n    \"\"\"\n    by_id: dict[str, list[dict[str, Any]]] = {}\n    for f in sorted(frames, key=lambda x: x[\"t\"]):\n        by_id.setdefault(f[\"id\"], []).append(f)\n\n    candidates: list[dict[str, Any]] = []\n    for can_id, fs in by_id.items():\n        min_len = min(len(f[\"data\"]) // 2 for f in fs)\n        for off in range(min_len):\n            values = [int(f[\"data\"][2 * off:2 * off + 2], 16) for f in fs]\n            distinct = sorted(set(values))\n            if len(distinct) < 2:\n                continue\n            transitions = sum(1 for a, b in zip(values, values[1:]) if a != b)\n            candidates.append({\n                \"id\": can_id, \"offset\": off, \"width\": \"byte\",\n                \"score\": len(distinct), \"transitions\": transitions,\n                \"values_seen\": distinct,\n                \"evidence\": [{\"t\": f[\"t\"], \"raw\": v} for f, v in zip(fs, values)][:20],\n            })\n    candidates.sort(key=lambda c: (c[\"score\"], c[\"transitions\"]))\n    return candidates[:top]\n\n\ndef learn_stop(bus: str) -> dict[str, Any]:\n    \"\"\"Stop a running learn capture and rank the candidates it saw.\"\"\"\n    state = _stop(bus)\n    full = _get(bus)\n    candidates = rank_changed_bytes(full[\"frames\"])\n    out = _public(full)\n    out[\"candidates\"] = candidates\n    return out\n\n\ndef learn_accept(vin: str, bus: str, can_id: str, offset: int, name: str) -> dict[str, Any]:\n    \"\"\"Name the ranked candidate and save it as a learned broadcast signal.\n\n    ``scale`` is always ``\"unknown\"`` here (see :mod:`cuore.live.learned`):\n    a raw byte's physical units are never guessed from one capture.\n    \"\"\"\n    from . import learned as learned_mod\n    if not (vin or \"\").strip():\n        raise BadCommand(\"a VIN is required to save a learned signal\")\n    if not (name or \"\").strip():\n        raise BadCommand(\"a name is required for the learned signal\")\n    b = _bus(bus)\n    field = {\"offset\": int(offset), \"width\": \"byte\"}\n    return learned_mod.accept_broadcast(vin.strip(), b.key, can_id, name.strip(), field)\n\n\n# ===========================================================================\n# per-bus presets and the cable header\n# ===========================================================================\n\ndef preset_info(name: str, vin: str = \"\") -> dict[str, Any]:\n    \"\"\"One bus-capture preset's items, resolved against the catalogue and\n    this VIN's learned broadcast signals. See :func:`cuore.live.channels.\n    bus_capture_preset`.\"\"\"\n    from . import channels as channels_mod\n    return channels_mod.bus_capture_preset(name, vin)\n\n\ndef preset_capture_start(name: str, vin: str = \"\") -> dict[str, Any]:\n    \"\"\"Start a bus capture scoped to one preset's bus. Refuses\n    (:class:`Refused`) unless the preset's required cable is declared --\n    before :func:`capture_start`'s own cable/interlock check even runs.\"\"\"\n    from . import channels as channels_mod\n    spec = channels_mod.BUS_CAPTURE_PRESETS.get(name)\n    if spec is None:\n        raise BadCommand(f\"unknown bus-capture preset {name!r}; one of \"\n                         f\"{sorted(channels_mod.BUS_CAPTURE_PRESETS)}\")\n    lk = link()\n    if lk.cable != spec[\"cable\"]:\n        raise Refused(\n            f\"preset {name!r} ({spec['name']}) needs cable {spec['cable']!r} declared; \"\n            f\"the declared cable is {lk.cable!r}. Fit the cable and set_cable({spec['cable']!r}) \"\n            f\"first.\")\n    return capture_start(spec[\"bus\"])\n\n\ndef cable_header(vin: str = \"\") -> dict[str, Any]:\n    \"\"\"What the Live board's header shows: the declared cable, which buses\n    it reaches, and which bus-capture presets it unlocks.\"\"\"\n    from . import channels as channels_mod\n    lk = link()\n    state = lk.cable_state()\n    presets = []\n    for pname, spec in channels_mod.BUS_CAPTURE_PRESETS.items():\n        presets.append({\"preset\": pname, \"name\": spec[\"name\"], \"bus\": spec[\"bus\"],\n                        \"cable_required\": spec[\"cable\"], \"enabled\": lk.cable == spec[\"cable\"]})\n    return {**state, \"presets\": presets}\n\n\ndef set_cable(cable: str) -> dict[str, Any]:\n    \"\"\"Declare the fitted cable (or ``\"none\"``). Clears stale bus\n    verifications when the cable actually changes -- see\n    :meth:`cuore.live.transport.AdapterLink.set_cable`. Returns the same\n    shape as :func:`cable_header` so a \"Change cable\" confirmation can list\n    what the new declaration enables in one call.\"\"\"\n    link().set_cable(cable)\n    return cable_header()\n\n\n__all__ = [\"capture_start\", \"capture_status\", \"capture_stop\", \"capture_save\",\n          \"learn_start\", \"learn_status\", \"learn_stop\", \"learn_accept\",\n          \"rank_changed_bytes\", \"preset_info\", \"preset_capture_start\",\n          \"cable_header\", \"set_cable\"]\n","numLines":359,"startLine":1,"totalLines":359}},"sourceToolAssistantUUID":"e235f6b9-c730-4693-bc73-5f196c25d943","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
