 6)\n    offset_r = round(float(offset), 6)\n    formula = f\"{expr}*{scale_r}\"\n    if offset_r:\n        formula += f\" - {abs(offset_r)}\" if offset_r < 0 else f\" + {offset_r}\"","numLines":15,"startLine":243,"totalLines":358}},"sourceToolAssistantUUID":"e63d7da0-5591-4927-bb3a-8cdcaeb504b2","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
