{"parentUuid":"fd520f13-d1f4-41b8-92b9-65ad2e84bb1d","isSidechain":true,"promptId":"3b2e7c35-1a45-4dd2-a323-bff2a4559d42","agentId":"ac3048c66f3643aa6","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01U1x9hudg3RRGLtwrgqiNA7","type":"tool_result","content":"1\t\"\"\"Regression checks for cuore.live.learn / cuore.live.learned.\n2\t\n3\tSame posture as ``cuore/tests/check_live.py``: plain script, ``check()``,\n4\texit 1 on failure, no pytest, no mocking framework -- hand-built frame lists\n5\tin the exact shape :func:`cuore.live.capture.listen` returns them.\n6\t\n7\tRun:\n8\t    .venv/Scripts/python.exe cuore/tests/check_learn.py\n9\t\"\"\"\n10\t\n11\tfrom __future__ import annotations\n12\t\n13\timport os\n14\timport sys\n15\timport tempfile\n16\tfrom pathlib import Path\n17\t\n18\t# Before any cuore import: state must go to a throwaway directory.\n19\tos.environ[\"CUORE_STATE_DIR\"] = tempfile.mkdtemp(prefix=\"cuore-check-learn-\")\n20\t\n21\tsys.path.insert(0, str(Path(__file__).resolve().parents[2]))\n22\t\n23\tfrom cuore.live import learned  # noqa: E402\n24\tfrom cuore.live.learn import correlate, did_series, isotp_reassemble, uds_transactions  # noqa: E402\n25\t\n26\tVIN = \"ZASFAKPN5J7B88115\"\n27\t\n28\tfailures: list[str] = []\n29\tchecks = 0\n30\t\n31\t\n32\tdef check(label: str, cond: bool, detail: str = \"\") -> None:\n33\t    global checks\n34\t    checks += 1\n35\t    if not cond:\n36\t        failures.append(f\"{label}{(' -- ' + detail) if detail else ''}\")\n37\t\n38\t\n39\tdef check_eq(label: str, got, want, extra: str = \"\") -> None:\n40\t    detail = f\"got {got!r} want {want!r}\"\n41\t    if extra:\n42\t        detail += f\" ({extra})\"\n43\t    check(label, got == want, detail)\n44\t\n45\t\n46\tdef frame(t: float, can_id: str, byte_list: list[str]) -> dict:\n47\t    return {\"t\": t, \"id\": can_id, \"data\": \"\".join(byte_list)}\n48\t\n49\t\n50\tdef sf(byte_values: list[int]) -> list[str]:\n51\t    \"\"\"Single-frame ISO-TP bytes: PCI 0N + N data bytes.\"\"\"\n52\t    n = len(byte_values)\n53\t    assert n <= 7\n54\t    return [f\"0{n:X}\"] + [f\"{v:02X}\" for v in byte_values]\n55\t\n56\t\n57\tdef ff(total_len: int, first_bytes: list[int]) -> list[str]:\n58\t    \"\"\"First-frame ISO-TP bytes: PCI 1N NN (12-bit length) + up to 6 data bytes.\"\"\"\n59\t    pci_hi = 0x10 | ((total_len >> 8) & 0x0F)\n60\t    pci_lo = total_len & 0xFF\n61\t    return [f\"{pci_hi:02X}\", f\"{pci_lo:02X}\"] + [f\"{v:02X}\" for v in first_bytes]\n62\t\n63\t\n64\tdef cf(seq: int, more_bytes: list[int]) -> list[str]:\n65\t    \"\"\"Consecutive-frame ISO-TP bytes: PCI 2N + up to 7 data bytes.\"\"\"\n66\t    return [f\"{0x20 | (seq & 0x0F):02X}\"] + [f\"{v:02X}\" for v in more_bytes]\n67\t\n68\t\n69\t# ===========================================================================\n70\t# 1. isotp_reassemble\n71\t# ===========================================================================\n72\t\n73\t# Single frame.\n74\tframes = [frame(0.0, \"18DAF110\", sf([0x62, 0xF1, 0x90]))]\n75\tr = isotp_reassemble(frames)\n76\tcheck_eq(\"isotp single frame: one message\", len(r[\"messages\"]), 1)\n77\tcheck_eq(\"isotp single frame: data\", r[\"messages\"][0][\"data\"], [\"62\", \"F1\", \"90\"])\n78\tcheck_eq(\"isotp single frame: no drops\", r[\"dropped\"], 0)\n79\t\n80\t# Multi-frame: 10 total bytes, FF carries 6, one CF carries the last 4.\n81\tmf_frames = [\n82\t    frame(0.0, \"18DAF110\", ff(10, [0x62, 0x10, 0x05, 0x00, 0x00, 0x00])),\n83\t    frame(0.01, \"18DAF110\", cf(1, [0x00, 0x00, 0x00, 0x00])),\n84\t]\n85\tr = isotp_reassemble(mf_frames)\n86\tcheck_eq(\"isotp multi-frame: one message\", len(r[\"messages\"]), 1)\n87\tcheck_eq(\"isotp multi-frame: length\", len(r[\"messages\"][0][\"data\"]), 10)\n88\tcheck_eq(\"isotp multi-frame: starts at FF time\", r[\"messages\"][0][\"t\"], 0.0)\n89\tcheck_eq(\"isotp multi-frame: no drops\", r[\"dropped\"], 0)\n90\t\n91\t# Interleaved IDs: two different ECUs' FF/CF frames woven together in time.\n92\tinterleaved = [\n93\t    frame(0.00, \"18DAF110\", ff(10, [0x62, 0x10, 0x05, 0x00, 0x00, 0x00])),\n94\t    frame(0.01, \"18DAF118\", ff(9, [0x62, 0x20, 0x01, 0x00, 0x00, 0x00])),\n95\t    frame(0.02, \"18DAF110\", cf(1, [0x00, 0x00, 0x00, 0x00])),\n96\t    frame(0.03, \"18DAF118\", cf(1, [0x00, 0x00, 0x00])),\n97\t]\n98\tr = isotp_reassemble(interleaved)\n99\tcheck_eq(\"isotp interleaved: two messages\", len(r[\"messages\"]), 2)\n100\tby_id = {m[\"id\"]: m for m in r[\"messages\"]}\n101\tcheck_eq(\"isotp interleaved: F110 length\", len(by_id[\"18DAF110\"][\"data\"]), 10)\n102\tcheck_eq(\"isotp interleaved: F118 length\", len(by_id[\"18DAF118\"][\"data\"]), 9)\n103\tcheck_eq(\"isotp interleaved: no drops\", r[\"dropped\"], 0)\n104\t\n105\t# Incomplete message (FF with no CF ever arriving) is dropped, counted.\n106\tincomplete = [frame(0.0, \"18DAF110\", ff(10, [0x62, 0x10, 0x05, 0x00, 0x00, 0x00]))]\n107\tr = isotp_reassemble(incomplete)\n108\tcheck_eq(\"isotp incomplete: no messages\", len(r[\"messages\"]), 0)\n109\tcheck_eq(\"isotp incomplete: one drop counted\", r[\"dropped\"], 1)\n110\t\n111\t# A new first frame for the same ID while one is pending drops the old one.\n112\tsuperseded = [\n113\t    frame(0.0, \"18DAF110\", ff(10, [0x62, 0x10, 0x05, 0x00, 0x00, 0x00])),\n114\t    frame(0.05, \"18DAF110\", ff(10, [0x62, 0x10, 0x06, 0x00, 0x00, 0x00])),\n115\t    frame(0.06, \"18DAF110\", cf(1, [0x00, 0x00, 0x00, 0x00])),\n116\t]\n117\tr = isotp_reassemble(superseded)\n118\tcheck_eq(\"isotp superseded: one completed message\", len(r[\"messages\"]), 1)\n119\tcheck_eq(\"isotp superseded: one drop counted\", r[\"dropped\"], 1)\n120\t\n121\t\n122\t# ===========================================================================\n123\t# 2. uds_transactions: pairing, incl. NRC\n124\t# ===========================================================================\n125\t\n126\treq_resp = [\n127\t    frame(1.000, \"18DA10F1\", sf([0x22, 0x12, 0x34])),\n128\t    frame(1.020, \"18DAF110\", sf([0x62, 0x12, 0x34, 0xAA, 0xBB])),\n129\t]\n130\ttx = uds_transactions(req_resp)\n131\tcheck_eq(\"uds_transactions: one transaction\", len(tx), 1)\n132\tt0 = tx[0]\n133\tcheck_eq(\"uds_transactions: target\", t0[\"target\"], \"10\")\n134\tcheck_eq(\"uds_transactions: tester\", t0[\"tester\"], \"F1\")\n135\tcheck_eq(\"uds_transactions: service\", t0[\"service\"], \"22\")\n136\tcheck_eq(\"uds_transactions: did\", t0[\"did\"], \"1234\")\n137\tcheck_eq(\"uds_transactions: data\", t0[\"data\"], [\"AA\", \"BB\"])\n138\tcheck_eq(\"uds_transactions: nrc is None on positive\", t0[\"nrc\"], None)\n139\t\n140\t# NRC 7F 22 31 (requestOutOfRange on a read-DID request).\n141\tnrc_frames = [\n142\t    frame(2.000, \"18DA10F1\", sf([0x22, 0x12, 0x34])),\n143\t    frame(2.015, \"18DAF110\", sf([0x7F, 0x22, 0x31])),\n144\t]\n145\ttx_nrc = uds_transactions(nrc_frames)\n146\tcheck_eq(\"uds_transactions NRC: one transaction\", len(tx_nrc), 1)\n147\tcheck_eq(\"uds_transactions NRC: nrc byte\", tx_nrc[0][\"nrc\"], \"31\")\n148\tcheck_eq(\"uds_transactions NRC: did unset (no positive data)\", tx_nrc[0][\"did\"], None)\n149\t\n150\t# A tester address other than F1 must pair correctly (never hard-coded).\n151\tother_tester = [\n152\t    frame(3.000, \"18DA1005\", sf([0x22, 0x12, 0x34])),\n153\t    frame(3.020, \"18DA0510\", sf([0x62, 0x12, 0x34, 0x01])),\n154\t]\n155\ttx_other = uds_transactions(other_tester)\n156\tcheck_eq(\"uds_transactions non-F1 tester: paired\", len(tx_other), 1)\n157\tcheck_eq(\"uds_transactions non-F1 tester: tester byte\", tx_other[0][\"tester\"], \"05\")\n158\tcheck_eq(\"uds_transactions non-F1 tester: data\", tx_other[0][\"data\"], [\"01\"])\n159\t\n160\t# Multi-DID request, unambiguous split (each DID's data length differs\n161\t# enough that the DID bytes only line up one way). Response payload (after\n162\t# the 0x62 service byte, 9 bytes total): DID1=1000 + 3 data bytes (AA BB CC),\n163\t# then DID2=1002 + 1 data byte (01). FF carries the first 6 payload bytes\n164\t# (service + DID1 + its 3 data bytes), one CF carries the last 3.\n165\tmulti_frames = [\n166\t    frame(4.000, \"18DA10F1\", sf([0x22, 0x10, 0x00, 0x10, 0x02])),\n167\t    frame(4.020, \"18DAF110\", ff(9, [0x62, 0x10, 0x00, 0xAA, 0xBB, 0xCC])),\n168\t    frame(4.021, \"18DAF110\", cf(1, [0x10, 0x02, 0x01])),\n169\t]\n170\ttx_multi = uds_transactions(multi_frames)\n171\tcheck_eq(\"uds_transactions multi-DID: one transaction\", len(tx_multi), 1)\n172\tdids_out = {d[\"did\"]: d[\"data\"] for d in (tx_multi[0][\"dids\"] or [])}\n173\tcheck_eq(\"uds_transactions multi-DID: DID1 data\", dids_out.get(\"1000\"), [\"AA\", \"BB\", \"CC\"])\n174\tcheck_eq(\"uds_transactions multi-DID: DID2 data\", dids_out.get(\"1002\"), [\"01\"])\n175\t\n176\t# Request with no response at all.\n177\tlonely = [frame(5.0, \"18DA10F1\", sf([0x22, 0x12, 0x34]))]\n178\ttx_lonely = uds_transactions(lonely)\n179\tcheck_eq(\"uds_transactions lonely request: still recorded\", len(tx_lonely), 1)\n180\tcheck_eq(\"uds_transactions lonely request: no response\", tx_lonely[0][\"response\"], None)\n181\tcheck_eq(\"uds_transactions lonely request: t_resp None\", tx_lonely[0][\"t_resp\"], None)\n182\t\n183\t\n184\t# ===========================================================================\n185\t# 3. did_series\n186\t# ===========================================================================\n187\t\n188\tseries = did_series(tx)\n189\tcheck(\"did_series: key present\", (\"10\", \"1234\") in series)\n190\tcheck_eq(\"did_series: one point\", len(series[(\"10\", \"1234\")]), 1)\n191\tcheck_eq(\"did_series: point bytes\", series[(\"10\", \"1234\")][0][\"bytes\"], [\"AA\", \"BB\"])\n192\t\n193\t\n194\t# ===========================================================================\n195\t# 4. correlate: EVAP pressure switch -> byte 2 bit 0\n196\t# ===========================================================================\n197\t#\n198\t# DID 0x1234 on target 0x10, 4-byte payload. Byte 2 varies noisily (other\n199\t# unrelated flags in the same byte) but its bit 0 tracks Closed/Open exactly;\n200\t# no whole-byte or 16-bit field is consistent across the noisy values, so\n201\t# only the bit-level candidate should reach a perfect score.\n202\t\n203\tswitch_marks = [\n204\t    {\"t\": 1.0, \"label\": \"EVAP pressure switch\", \"value\": \"Closed\"},\n205\t    {\"t\": 2.0, \"label\": \"EVAP pressure switch\", \"value\": \"Open\"},\n206\t    {\"t\": 3.0, \"label\": \"EVAP pressure switch\", \"value\": \"Closed\"},\n207\t    {\"t\": 4.0, \"label\": \"EVAP pressure switch\", \"value\": \"Open\"},\n208\t]\n209\tswitch_byte2 = {1.0: 0x01, 2.0: 0x00, 3.0: 0x05, 4.0: 0x02}  # bit0: 1,0,1,0\n210\t\n211\tswitch_frames = []\n212\tfor mk in switch_marks:\n213\t    t = mk[\"t\"]\n214\t    switch_frames.append(frame(t, \"18DA10F1\", sf([0x22, 0x12, 0x34])))\n215\t    b2 = switch_byte2[t]\n216\t    switch_frames.append(frame(t + 0.01, \"18DAF110\",\n217\t                               sf([0x62, 0x12, 0x34, 0x00, 0x00, b2, 0x00])))\n218\t\n219\tswitch_tx = uds_transactions(switch_frames)\n220\tcheck_eq(\"switch capture: 4 transactions\", len(switch_tx), 4)\n221\tswitch_series = did_series(switch_tx)\n222\tswitch_candidates = correlate(switch_series, switch_marks)\n223\tcheck(\"switch correlate: candidates found\", len(switch_candidates) > 0)\n224\ttop = switch_candidates[0] if switch_candidates else {}\n225\tcheck_eq(\"switch correlate: top target\", top.get(\"target\"), \"10\")\n226\tcheck_eq(\"switch correlate: top did\", top.get(\"did\"), \"1234\")\n227\tcheck_eq(\"switch correlate: top score is perfect\", top.get(\"score\"), 1.0)\n228\tcheck_eq(\"switch correlate: top field is byte2 bit0\", top.get(\"field\"), {\"offset\": 2, \"bit\": 0})\n229\tn_perfect = sum(1 for c in switch_candidates if c[\"score\"] == 1.0)\n230\tcheck_eq(\"switch correlate: exactly one perfect candidate\", n_perfect, 1,\n231\t        str([c[\"field\"] for c in switch_candidates if c[\"score\"] == 1.0]))\n232\t\n233\t\n234\t# ===========================================================================\n235\t# 5. correlate: numeric fuel level -> scale/offset recovery\n236\t# ===========================================================================\n237\t\n238\tfuel_marks = [\n239\t    {\"t\": 10.0, \"label\": \"Fuel level\", \"value\": 10.0},\n240\t    {\"t\": 20.0, \"label\": \"Fuel level\", \"value\": 42.5},\n241\t    {\"t\": 30.0, \"label\": \"Fuel level\", \"value\": 75.0},\n242\t]\n243\t# raw = value * 2  (scale 0.5, offset 0) -> 20, 85, 150, all fit one byte\n244\tfuel_frames = []\n245\tfor mk in fuel_marks:\n246\t    t = mk[\"t\"]\n247\t    raw = round(mk[\"value\"] * 2)\n248\t    fuel_frames.append(frame(t, \"18DA10F1\", sf([0x22, 0x10, 0x05])))\n249\t    fuel_frames.append(frame(t + 0.01, \"18DAF110\", sf([0x62, 0x10, 0x05, raw])))\n250\t\n251\tfuel_tx = uds_transactions(fuel_frames)\n252\tfuel_series = did_series(fuel_tx)\n253\tfuel_candidates = correlate(fuel_series, fuel_marks)\n254\tcheck(\"fuel correlate: candidates found\", len(fuel_candidates) > 0)\n255\tfuel_top = fuel_candidates[0] if fuel_candidates else {}\n256\tcheck_eq(\"fuel correlate: top target/did\", (fuel_top.get(\"target\"), fuel_top.get(\"did\")),\n257\t        (\"10\", \"1005\"))\n258\tcheck(\"fuel correlate: r2 near 1.0\", abs(fuel_top.get(\"r2\", 0.0) - 1.0) < 1e-6,\n259\t     repr(fuel_top.get(\"r2\")))\n260\tcheck(\"fuel correlate: scale near 0.5\", abs(fuel_top.get(\"scale\", 0.0) - 0.5) < 1e-6,\n261\t     repr(fuel_top.get(\"scale\")))\n262\tcheck(\"fuel correlate: offset near 0.0\", abs(fuel_top.get(\"offset\", 1.0) - 0.0) < 1e-6,\n263\t     repr(fuel_top.get(\"offset\")))\n264\t\n265\t\n266\t# ===========================================================================\n267\t# 6. learned.py persistence round trip\n268\t# ===========================================================================\n269\t\n270\tentry = learned.accept(\n271\t    VIN, \"ECM\", \"1234\", \"EVAP pressure switch\", {\"offset\": 2, \"bit\": 0},\n272\t    evidence=top.get(\"evidence\"),\n273\t)\n274\tcheck_eq(\"learned.accept: confidence stamped\", entry[\"confidence\"], learned.CONFIDENCE)\n275\t\n276\tgot = learned.learned(VIN)\n277\tcheck_eq(\"learned.learned: vin key present\", list(got.keys()), [VIN])\n278\tcheck_eq(\"learned.learned: one entry\", len(got[VIN]), 1)\n279\tcheck_eq(\"learned.learned: round-tripped did\", got[VIN][0][\"did\"], \"1234\")\n280\tcheck_eq(\"learned.learned: round-tripped field\", got[VIN][0][\"field\"], {\"offset\": 2, \"bit\": 0})\n281\tcheck_eq(\"learned.learned: confidence text\", got[VIN][0][\"confidence\"],\n282\t        \"learned from wiTECH capture\")\n283\t\n284\t# Re-accepting the same (module, did, field) replaces, does not duplicate.\n285\tlearned.accept(VIN, \"ECM\", \"1234\", \"EVAP pressure switch (renamed)\", {\"offset\": 2, \"bit\": 0})\n286\tgot2 = learned.learned(VIN)\n287\tcheck_eq(\"learned.accept: replace not duplicate\", len(got2[VIN]), 1)\n288\tcheck_eq(\"learned.accept: replaced name\", got2[VIN][0][\"name\"], \"EVAP pressure switch (renamed)\")\n289\t\n290\t# reject() records separately and does not disturb the accepted entry.\n291\tlearned.reject(VIN, \"ECM\", \"1234\", {\"offset\": 0, \"width\": \"byte\"}, reason=\"pure noise\")\n292\tgot3 = learned.learned(VIN)\n293\tcheck_eq(\"learned.reject: appended alongside accepted\", len(got3[VIN]), 2)\n294\tstatuses = sorted(e[\"status\"] for e in got3[VIN])\n295\tcheck_eq(\"learned.reject: one accepted one rejected\", statuses, [\"accepted\", \"rejected\"])\n296\t\n297\t# Actually persisted to disk, not just held in memory.\n298\tcheck(\"learned.path: file exists on disk\", learned.path().exists())\n299\traw_json = learned.path().read_text(encoding=\"utf-8\")\n300\tcheck(\"learned.path: VIN present in raw file\", VIN in raw_json)\n301\t\n302\t\n303\t# ===========================================================================\n304\t# report\n305\t# ===========================================================================\n306\t\n307\tprint(f\"checks run: {checks}\")\n308\tif failures:\n309\t    print(f\"FAILURES: {len(failures)}\")\n310\t    for f in failures:\n311\t        print(\"  -\", f)\n312\t    sys.exit(1)\n313\tprint(\"all green\")\n314\t"}]},"uuid":"f37541b3-01d8-4236-85bf-5940fa91e481","timestamp":"2026-10-14T18:02:58.524Z","toolUseResult":{"type":"text","file":{"filePath":"C:\\Users\\User\\mcp-servers\\cuore\\tests\\check_learn.py","content":"\"\"\"Regression checks for cuore.live.learn / cuore.live.learned.\n\nSame posture as ``cuore/tests/check_live.py``: plain script, ``check()``,\nexit 1 on failure, no pytest, no mocking framework -- hand-built frame lists\nin the exact shape :func:`cuore.live.capture.listen` returns them.\n\nRun:\n    .venv/Scripts/python.exe cuore/tests/check_learn.py\n\"\"\"\n\nfrom __future__ import annotations\n\nimport os\nimport sys\nimport tempfile\nfrom pathlib import Path\n\n# Before any cuore import: state must go to a throwaway directory.\nos.environ[\"CUORE_STATE_DIR\"] = tempfile.mkdtemp(prefix=\"cuore-check-learn-\")\n\nsys.path.insert(0, str(Path(__file__).resolve().parents[2]))\n\nfrom cuore.live import learned  # noqa: E402\nfrom cuore.live.learn import correlate, did_series, isotp_reassemble, uds_transactions  # noqa: E402\n\nVIN = \"ZASFAKPN5J7B88115\"\n\nfailures: list[str] = []\nchecks = 0\n\n\ndef check(label: str, cond: bool, detail: str = \"\") -> None:\n    global checks\n    checks += 1\n    if not cond:\n        failures.append(f\"{label}{(' -- ' + detail) if detail else ''}\")\n\n\ndef check_eq(label: str, got, want, extra: str = \"\") -> None:\n    detail = f\"got {got!r} want {want!r}\"\n    if extra:\n        detail += f\" ({extra})\"\n    check(label, got == want, detail)\n\n\ndef frame(t: float, can_id: str, byte_list: list[str]) -> dict:\n    return {\"t\": t, \"id\": can_id, \"data\": \"\".join(byte_list)}\n\n\ndef sf(byte_values: list[int]) -> list[str]:\n    \"\"\"Single-frame ISO-TP bytes: PCI 0N + N data bytes.\"\"\"\n    n = len(byte_values)\n    assert n <= 7\n    return [f\"0{n:X}\"] + [f\"{v:02X}\" for v in byte_values]\n\n\ndef ff(total_len: int, first_bytes: list[int]) -> list[str]:\n    \"\"\"First-frame ISO-TP bytes: PCI 1N NN (12-bit length) + up to 6 data bytes.\"\"\"\n    pci_hi = 0x10 | ((total_len >> 8) & 0x0F)\n    pci_lo = total_len & 0xFF\n    return [f\"{pci_hi:02X}\", f\"{pci_lo:02X}\"] + [f\"{v:02X}\" for v in first_bytes]\n\n\ndef cf(seq: int, more_bytes: list[int]) -> list[str]:\n    \"\"\"Consecutive-frame ISO-TP bytes: PCI 2N + up to 7 data bytes.\"\"\"\n    return [f\"{0x20 | (seq & 0x0F):02X}\"] + [f\"{v:02X}\" for v in more_bytes]\n\n\n# ===========================================================================\n# 1. isotp_reassemble\n# ===========================================================================\n\n# Single frame.\nframes = [frame(0.0, \"18DAF110\", sf([0x62, 0xF1, 0x90]))]\nr = isotp_reassemble(frames)\ncheck_eq(\"isotp single frame: one message\", len(r[\"messages\"]), 1)\ncheck_eq(\"isotp single frame: data\", r[\"messages\"][0][\"data\"], [\"62\", \"F1\", \"90\"])\ncheck_eq(\"isotp single frame: no drops\", r[\"dropped\"], 0)\n\n# Multi-frame: 10 total bytes, FF carries 6, one CF carries the last 4.\nmf_frames = [\n    frame(0.0, \"18DAF110\", ff(10, [0x62, 0x10, 0x05, 0x00, 0x00, 0x00])),\n    frame(0.01, \"18DAF110\", cf(1, [0x00, 0x00, 0x00, 0x00])),\n]\nr = isotp_reassemble(mf_frames)\ncheck_eq(\"isotp multi-frame: one message\", len(r[\"messages\"]), 1)\ncheck_eq(\"isotp multi-frame: length\", len(r[\"messages\"][0][\"data\"]), 10)\ncheck_eq(\"isotp multi-frame: starts at FF time\", r[\"messages\"][0][\"t\"], 0.0)\ncheck_eq(\"isotp multi-frame: no drops\", r[\"dropped\"], 0)\n\n# Interleaved IDs: two different ECUs' FF/CF frames woven together in time.\ninterleaved = [\n    frame(0.00, \"18DAF110\", ff(10, [0x62, 0x10, 0x05, 0x00, 0x00, 0x00])),\n    frame(0.01, \"18DAF118\", ff(9, [0x62, 0x20, 0x01, 0x00, 0x00, 0x00])),\n    frame(0.02, \"18DAF110\", cf(1, [0x00, 0x00, 0x00, 0x00])),\n    frame(0.03, \"18DAF118\", cf(1, [0x00, 0x00, 0x00])),\n]\nr = isotp_reassemble(interleaved)\ncheck_eq(\"isotp interleaved: two messages\", len(r[\"messages\"]), 2)\nby_id = {m[\"id\"]: m for m in r[\"messages\"]}\ncheck_eq(\"isotp interleaved: F110 length\", len(by_id[\"18DAF110\"][\"data\"]), 10)\ncheck_eq(\"isotp interleaved: F118 length\", len(by_id[\"18DAF118\"][\"data\"]), 9)\ncheck_eq(\"isotp interleaved: no drops\", r[\"dropped\"], 0)\n\n# Incomplete message (FF with no CF ever arriving) is dropped, counted.\nincomplete = [frame(0.0, \"18DAF110\", ff(10, [0x62, 0x10, 0x05, 0x00, 0x00, 0x00]))]\nr = isotp_reassemble(incomplete)\ncheck_eq(\"isotp incomplete: no messages\", len(r[\"messages\"]), 0)\ncheck_eq(\"isotp incomplete: one drop counted\", r[\"dropped\"], 1)\n\n# A new first frame for the same ID while one is pending drops the old one.\nsuperseded = [\n    frame(0.0, \"18DAF110\", ff(10, [0x62, 0x10, 0x05, 0x00, 0x00, 0x00])),\n    frame(0.05, \"18DAF110\", ff(10, [0x62, 0x10, 0x06, 0x00, 0x00, 0x00])),\n    frame(0.06, \"18DAF110\", cf(1, [0x00, 0x00, 0x00, 0x00])),\n]\nr = isotp_reassemble(superseded)\ncheck_eq(\"isotp superseded: one completed message\", len(r[\"messages\"]), 1)\ncheck_eq(\"isotp superseded: one drop counted\", r[\"dropped\"], 1)\n\n\n# ===========================================================================\n# 2. uds_transactions: pairing, incl. NRC\n# ===========================================================================\n\nreq_resp = [\n    frame(1.000, \"18DA10F1\", sf([0x22, 0x12, 0x34])),\n    frame(1.020, \"18DAF110\", sf([0x62, 0x12, 0x34, 0xAA, 0xBB])),\n]\ntx = uds_transactions(req_resp)\ncheck_eq(\"uds_transactions: one transaction\", len(tx), 1)\nt0 = tx[0]\ncheck_eq(\"uds_transactions: target\", t0[\"target\"], \"10\")\ncheck_eq(\"uds_transactions: tester\", t0[\"tester\"], \"F1\")\ncheck_eq(\"uds_transactions: service\", t0[\"service\"], \"22\")\ncheck_eq(\"uds_transactions: did\", t0[\"did\"], \"1234\")\ncheck_eq(\"uds_transactions: data\", t0[\"data\"], [\"AA\", \"BB\"])\ncheck_eq(\"uds_transactions: nrc is None on positive\", t0[\"nrc\"], None)\n\n# NRC 7F 22 31 (requestOutOfRange on a read-DID request).\nnrc_frames = [\n    frame(2.000, \"18DA10F1\", sf([0x22, 0x12, 0x34])),\n    frame(2.015, \"18DAF110\", sf([0x7F, 0x22, 0x31])),\n]\ntx_nrc = uds_transactions(nrc_frames)\ncheck_eq(\"uds_transactions NRC: one transaction\", len(tx_nrc), 1)\ncheck_eq(\"uds_transactions NRC: nrc byte\", tx_nrc[0][\"nrc\"], \"31\")\ncheck_eq(\"uds_transactions NRC: did unset (no positive data)\", tx_nrc[0][\"did\"], None)\n\n# A tester address other than F1 must pair correctly (never hard-coded).\nother_tester = [\n    frame(3.000, \"18DA1005\", sf([0x22, 0x12, 0x34])),\n    frame(3.020, \"18DA0510\", sf([0x62, 0x12, 0x34, 0x01])),\n]\ntx_other = uds_transactions(other_tester)\ncheck_eq(\"uds_transactions non-F1 tester: paired\", len(tx_other), 1)\ncheck_eq(\"uds_transactions non-F1 tester: tester byte\", tx_other[0][\"tester\"], \"05\")\ncheck_eq(\"uds_transactions non-F1 tester: data\", tx_other[0][\"data\"], [\"01\"])\n\n# Multi-DID request, unambiguous split (each DID's data length differs\n# enough that the DID bytes only line up one way). Response payload (after\n# the 0x62 service byte, 9 bytes total): DID1=1000 + 3 data bytes (AA BB CC),\n# then DID2=1002 + 1 data byte (01). FF carries the first 6 payload bytes\n# (service + DID1 + its 3 data bytes), one CF carries the last 3.\nmulti_frames = [\n    frame(4.000, \"18DA10F1\", sf([0x22, 0x10, 0x00, 0x10, 0x02])),\n    frame(4.020, \"18DAF110\", ff(9, [0x62, 0x10, 0x00, 0xAA, 0xBB, 0xCC])),\n    frame(4.021, \"18DAF110\", cf(1, [0x10, 0x02, 0x01])),\n]\ntx_multi = uds_transactions(multi_frames)\ncheck_eq(\"uds_transactions multi-DID: one transaction\", len(tx_multi), 1)\ndids_out = {d[\"did\"]: d[\"data\"] for d in (tx_multi[0][\"dids\"] or [])}\ncheck_eq(\"uds_transactions multi-DID: DID1 data\", dids_out.get(\"1000\"), [\"AA\", \"BB\", \"CC\"])\ncheck_eq(\"uds_transactions multi-DID: DID2 data\", dids_out.get(\"1002\"), [\"01\"])\n\n# Request with no response at all.\nlonely = [frame(5.0, \"18DA10F1\", sf([0x22, 0x12, 0x34]))]\ntx_lonely = uds_transactions(lonely)\ncheck_eq(\"uds_transactions lonely request: still recorded\", len(tx_lonely), 1)\ncheck_eq(\"uds_transactions lonely request: no response\", tx_lonely[0][\"response\"], None)\ncheck_eq(\"uds_transactions lonely request: t_resp None\", tx_lonely[0][\"t_resp\"], None)\n\n\n# ===========================================================================\n# 3. did_series\n# ===========================================================================\n\nseries = did_series(tx)\ncheck(\"did_series: key present\", (\"10\", \"1234\") in series)\ncheck_eq(\"did_series: one point\", len(series[(\"10\", \"1234\")]), 1)\ncheck_eq(\"did_series: point bytes\", series[(\"10\", \"1234\")][0][\"bytes\"], [\"AA\", \"BB\"])\n\n\n# ===========================================================================\n# 4. correlate: EVAP pressure switch -> byte 2 bit 0\n# ===========================================================================\n#\n# DID 0x1234 on target 0x10, 4-byte payload. Byte 2 varies noisily (other\n# unrelated flags in the same byte) but its bit 0 tracks Closed/Open exactly;\n# no whole-byte or 16-bit field is consistent across the noisy values, so\n# only the bit-level candidate should reach a perfect score.\n\nswitch_marks = [\n    {\"t\": 1.0, \"label\": \"EVAP pressure switch\", \"value\": \"Closed\"},\n    {\"t\": 2.0, \"label\": \"EVAP pressure switch\", \"value\": \"Open\"},\n    {\"t\": 3.0, \"label\": \"EVAP pressure switch\", \"value\": \"Closed\"},\n    {\"t\": 4.0, \"label\": \"EVAP pressure switch\", \"value\": \"Open\"},\n]\nswitch_byte2 = {1.0: 0x01, 2.0: 0x00, 3.0: 0x05, 4.0: 0x02}  # bit0: 1,0,1,0\n\nswitch_frames = []\nfor mk in switch_marks:\n    t = mk[\"t\"]\n    switch_frames.append(frame(t, \"18DA10F1\", sf([0x22, 0x12, 0x34])))\n    b2 = switch_byte2[t]\n    switch_frames.append(frame(t + 0.01, \"18DAF110\",\n                               sf([0x62, 0x12, 0x34, 0x00, 0x00, b2, 0x00])))\n\nswitch_tx = uds_transactions(switch_frames)\ncheck_eq(\"switch capture: 4 transactions\", len(switch_tx), 4)\nswitch_series = did_series(switch_tx)\nswitch_candidates = correlate(switch_series, switch_marks)\ncheck(\"switch correlate: candidates found\", len(switch_candidates) > 0)\ntop = switch_candidates[0] if switch_candidates else {}\ncheck_eq(\"switch correlate: top target\", top.get(\"target\"), \"10\")\ncheck_eq(\"switch correlate: top did\", top.get(\"did\"), \"1234\")\ncheck_eq(\"switch correlate: top score is perfect\", top.get(\"score\"), 1.0)\ncheck_eq(\"switch correlate: top field is byte2 bit0\", top.get(\"field\"), {\"offset\": 2, \"bit\": 0})\nn_perfect = sum(1 for c in switch_candidates if c[\"score\"] == 1.0)\ncheck_eq(\"switch correlate: exactly one perfect candidate\", n_perfect, 1,\n        str([c[\"field\"] for c in switch_candidates if c[\"score\"] == 1.0]))\n\n\n# ===========================================================================\n# 5. correlate: numeric fuel level -> scale/offset recovery\n# ===========================================================================\n\nfuel_marks = [\n    {\"t\": 10.0, \"label\": \"Fuel level\", \"value\": 10.0},\n    {\"t\": 20.0, \"label\": \"Fuel level\", \"value\": 42.5},\n    {\"t\": 30.0, \"label\": \"Fuel level\", \"value\": 75.0},\n]\n# raw = value * 2  (scale 0.5, offset 0) -> 20, 85, 150, all fit one byte\nfuel_frames = []\nfor mk in fuel_marks:\n    t = mk[\"t\"]\n    raw = round(mk[\"value\"] * 2)\n    fuel_frames.append(frame(t, \"18DA10F1\", sf([0x22, 0x10, 0x05])))\n    fuel_frames.append(frame(t + 0.01, \"18DAF110\", sf([0x62, 0x10, 0x05, raw])))\n\nfuel_tx = uds_transactions(fuel_frames)\nfuel_series = did_series(fuel_tx)\nfuel_candidates = correlate(fuel_series, fuel_marks)\ncheck(\"fuel correlate: candidates found\", len(fuel_candidates) > 0)\nfuel_top = fuel_candidates[0] if fuel_candidates else {}\ncheck_eq(\"fuel correlate: top target/did\", (fuel_top.get(\"target\"), fuel_top.get(\"did\")),\n        (\"10\", \"1005\"))\ncheck(\"fuel correlate: r2 near 1.0\", abs(fuel_top.get(\"r2\", 0.0) - 1.0) < 1e-6,\n     repr(fuel_top.get(\"r2\")))\ncheck(\"fuel correlate: scale near 0.5\", abs(fuel_top.get(\"scale\", 0.0) - 0.5) < 1e-6,\n     repr(fuel_top.get(\"scale\")))\ncheck(\"fuel correlate: offset near 0.0\", abs(fuel_top.get(\"offset\", 1.0) - 0.0) < 1e-6,\n     repr(fuel_top.get(\"offset\")))\n\n\n# ===========================================================================\n# 6. learned.py persistence round trip\n# ===========================================================================\n\nentry = learned.accept(\n    VIN, \"ECM\", \"1234\", \"EVAP pressure switch\", {\"offset\": 2, \"bit\": 0},\n    evidence=top.get(\"evidence\"),\n)\ncheck_eq(\"learned.accept: confidence stamped\", entry[\"confidence\"], learned.CONFIDENCE)\n\ngot = learned.learned(VIN)\ncheck_eq(\"learned.learned: vin key present\", list(got.keys()), [VIN])\ncheck_eq(\"learned.learned: one entry\", len(got[VIN]), 1)\ncheck_eq(\"learned.learned: round-tripped did\", got[VIN][0][\"did\"], \"1234\")\ncheck_eq(\"learned.learned: round-tripped field\", got[VIN][0][\"field\"], {\"offset\": 2, \"bit\": 0})\ncheck_eq(\"learned.learned: confidence text\", got[VIN][0][\"confidence\"],\n        \"learned from wiTECH capture\")\n\n# Re-accepting the same (module, did, field) replaces, does not duplicate.\nlearned.accept(VIN, \"ECM\", \"1234\", \"EVAP pressure switch (renamed)\", {\"offset\": 2, \"bit\": 0})\ngot2 = learned.learned(VIN)\ncheck_eq(\"learned.accept: replace not duplicate\", len(got2[VIN]), 1)\ncheck_eq(\"learned.accept: replaced name\", got2[VIN][0][\"name\"], \"EVAP pressure switch (renamed)\")\n\n# reject() records separately and does not disturb the accepted entry.\nlearned.reject(VIN, \"ECM\", \"1234\", {\"offset\": 0, \"width\": \"byte\"}, reason=\"pure noise\")\ngot3 = learned.learned(VIN)\ncheck_eq(\"learned.reject: appended alongside accepted\", len(got3[VIN]), 2)\nstatuses = sorted(e[\"status\"] for e in got3[VIN])\ncheck_eq(\"learned.reject: one accepted one rejected\", statuses, [\"accepted\", \"rejected\"])\n\n# Actually persisted to disk, not just held in memory.\ncheck(\"learned.path: file exists on disk\", learned.path().exists())\nraw_json = learned.path().read_text(encoding=\"utf-8\")\ncheck(\"learned.path: VIN present in raw file\", VIN in raw_json)\n\n\n# ===========================================================================\n# report\n# ===========================================================================\n\nprint(f\"checks run: {checks}\")\nif failures:\n    print(f\"FAILURES: {len(failures)}\")\n    for f in failures:\n        print(\"  -\", f)\n    sys.exit(1)\nprint(\"all green\")\n","numLines":314,"startLine":1,"totalLines":314}},"sourceToolAssistantUUID":"fd520f13-d1f4-41b8-92b9-65ad2e84bb1d","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
