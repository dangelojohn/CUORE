\"Fit candidates from the last alignment, with their fit numbers (R²,","+    scale, offset, sample count) -- review on ``/v/{vin}/learn-mes`` before","+    accepting.\"\"\"","+    return _via(\"GET\", \"/mes-learn/candidates\", lambda: _mes_learn.candidates())","+","+","+@mcp.tool()","+def mes_learn_accept(candidate_id: str, vin: str, name: str) -> str:","+    \"\"\"Accept a fit candidate: saved through ``cuore.live.learned`` as a","+    MES-learned, scaled DID mapping (confidence ``SINGLE-SOURCE (learned)``,","+    never a catalogue DID) -- usable by the Live board as a named channel.\"\"\"","+    return _via(\"POST\", f\"/mes-learn/candidates/{candidate_id}/accept\",","+               lambda: _mes_learn.accept(candidate_id, vin, name), body={\"vin\": vin, \"name\": name})","+","+"," if __name__ == \"__main__\":","     mcp.run()"]}],"userModified":false,"replaceAll":false,"contentNotInModelContext":true},"serverClassifierContext":{"request":"e675a5b8-8b53-4825-9262-60b8860d6634","context":{"git_state":{"cwd":"/c/Users/User/mcp-servers","root":null,"branch":null,"default_branch":null,"status":null,"visibility":null,"error":"pending"},"live_cwd":"/c/Users/User/mcp-servers","platform":"windows"}},"sourceToolAssistantUUID":"413e552e-4fd3-47b5-84b0-a249959f782c","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
