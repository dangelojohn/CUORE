s/check_live.py:596:    _orig_mes_status = interlock.mes_status\ncuore/tests/check_live.py:597:    interlock.mes_status = lambda: {\"running\": True, \"pids\": [999],\ncuore/tests/check_live.py:608:        interlock.mes_status = _orig_mes_status\ncuore/tests/check_live_data.py:64:interlock.mes_status = lambda: {\"running\": False, \"pids\": [], \"state\": \"not_running\",\ncuore/tests/check_review6_logic.py:281:#     label (same mes_state, same wording).\ncuore/tests/check_review6_logic.py:284:live_not_running = {\"mes_state\": \"not_running\", \"port\": \"COM3\", \"lock_holder\": None}\ncuore/tests/check_review6_logic.py:294:live_connected = {\"mes_state\": \"connected\", \"port\": \"COM3\", \"lock_holder\": \"MultiEcuScan\"}\ncuore/tests/check_tools.py:36:no_port_state.update(port=None, port_exists=False, mes_state=\"not_running\",\ncuore/web/routes.py:73:            \"mes_state\": (s.get(\"mes\") or {}).get(\"state\"),\ncuore/web/tools_routes.py:60:        \"port\": None, \"mes_state\": None, \"cable\": None,\ncuore/web/tools_routes.py:67:        out[\"mes_state\"] = (s.get(\"mes\") or {}).get(\"state\")","is_error":false}]},"uuid":"f2e5019a-39d9-472e-a45d-8113836dad05","timestamp":"2026-10-14T17:59:28.761Z","toolUseResult":{"stdout":"obd2-mcp/server.py:124:def mes_state() -> str:\nobd2-mcp/server.py:126:    from cuore.live.interlock import mes_status\nobd2-mcp/server.py:127:    return _json(mes_status)\nobd2-mcp/server.py:131:def mes_settings() -> str:\nobd2-mcp/server.py:133:    return _via(\"GET\", \"/live/mes\", ops.mes_settings)\ncuore/api/dossier.py:28:                \"mes_state\": (s.get(\"mes\") or {}).get(\"state\"),\ncuore/api/live.py:35:def live_mes_settings() -> dict[str, Any]:\ncuore/api/live.py:36:    return ops.mes_settings()\ncuore/live/fullscan.py:511:    ms = interlock.mes_status()\ncuore/live/fullscan.py:733:    ms = interlock.mes_status()\ncuore/live/fullscan.py:804:        ms = interlock.mes_status()\ncuore/live/interlock.py:94:def mes_statu