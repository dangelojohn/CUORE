{"parentUuid":"97d395cc-c0d8-4a90-9db9-2107266df043","isSidechain":true,"agentId":"ac3048c66f3643aa6","message":{"model":"claude-sonnet-5","id":"msg_011Cg2ZbN82JDvbS8amPy9if","type":"message","role":"assistant","content":[{"type":"thinking","thinking":"","signature":""}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":8743,"cache_read_input_tokens":96419,"cache_creation":{"ephemeral_5m_input_tokens":8743,"ephemeral_1h_input_tokens":0},"output_tokens":2,"service_tier":"standard","inference_geo":"global"},"input_transformations":[],"diagnostics":null,"context_management":null},"serverClassifierRequest":"a7cd6c81-d297-4295-99f6-40e6dbaf6513","apiBlockIndex":0,"requestId":"req_011Cg2ZbMr9RoNNPeFLXpFn1","attributionAgent":"general-purpose","type":"assistant","uuid":"5dd4d69c-b8ae-465c-a901-837645174f8b","timestamp":"2026-10-14T17:58:27.415Z","effort":"high","perTurnEffort":null,"userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
{"parentUuid":"5dd4d69c-b8ae-465c-a901-837645174f8b","isSidechain":true,"agentId":"ac3048c66f3643aa6","message":{"model":"claude-sonnet-5","id":"msg_011Cg2ZbN82JDvbS8amPy9if","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01TEZKkDxQmkiXXfSEQSVijE","name":"Read","input":{"file_path":"C:\\Users\\User\\mcp-servers\\cuore\\live\\readall.py"},"caller":{"type":"direct"}}],"container":null,"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":8743,"cache_read_input_tokens":96419,"output_tokens":2924,"output_tokens_details":{"thinking_tokens":2851},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":0,"ephemeral_5m_input_tokens":8743},"inference_geo":"global","iterations":[{"input_tokens":2,"output_tokens":2924,"cache_read_input_tokens":96419,"cache_creation_input_tokens":8743,"cache_creation":{"ephemeral_5m_input_tokens":8743,"ephemeral_1h_input_tokens":0},"type":"message"}],"speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_01TEZKkDxQmkiXXfSEQSVijE":{"file_path":"C:\\Users\\User\\mcp-servers\\cuore\\live\\readall.py"}},"serverClassifierRequest":"a7cd6c81-d297-4295-99f6-40e6dbaf6513","apiBlockIndex":1,"requestId":"req_011Cg2ZbMr9RoNNPeFLXpFn1","attributionAgent":"general-purpose","type":"assistant","uuid":"2e63c1e0-88df-460c-b2d4-5357af0cc720","timestamp":"2026-10-14T17:58:27.998Z","effort":"high","perTurnEffort":null,"userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
{"parentUuid":"2e63c1e0-88df-460c-b2d4-5357af0cc720","isSidechain":true,"promptId":"5b1f3ca0-47aa-46ad-b4cb-7ebe226b6ba4","agentId":"ac3048c66f3643aa6","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01TEZKkDxQmkiXXfSEQSVijE","type":"tool_result","content":"1\t\"\"\"Session-level \"read everything we know how to ask for\" on one module.\n2\t\n3\tTwo pieces:\n4\t\n5\t* A tiny, safe CarScanner-formula evaluator (no ``eval``). CarScanner/MES\n6\t  formulas are arithmetic over response-data byte letters (``A``, ``B``,\n7\t  ``C`` ... in order after the echoed DID), ``+ - * /``, parentheses, and\n8\t  ``SIGNED(...)``. That is a small enough grammar to hand-parse; anything\n9\t  outside it (a stray identifier, a bitwise operator, an unbalanced paren)\n10\t  raises :class:`FormulaError` rather than ever being handed to Python's\n11\t  ``eval``.\n12\t* :func:`read_all` and :func:`discover_dids`, both read-only, both going\n13\t  through :func:`uds.read_did` (so the read-only allowlist in\n14\t  :mod:`safety` still gates every byte on the wire).\n15\t\n16\tStdlib only besides the ``cuore.live`` imports.\n17\t\"\"\"\n18\t\n19\tfrom __future__ import annotations\n20\t\n21\tfrom typing import Any, Optional, Union\n22\t\n23\tfrom . import audit\n24\tfrom . import did_catalog\n25\tfrom . import uds as uds_mod\n26\tfrom .addressing import ECUAddress\n27\tfrom .transport import Session\n28\t\n29\t# ===========================================================================\n30\t# formula evaluator\n31\t# ===========================================================================\n32\t\n33\t\n34\tclass FormulaError(Exception):\n35\t    \"\"\"Raised for anything that is not a safe, recognised CarScanner formula.\"\"\"\n36\t\n37\t\n38\t_SIMPLE_OPS = frozenset(\"+-*/()\")\n39\t_NRC_31 = \"requestOutOfRange\"\n40\t\n41\t\n42\tdef _tokenize(text: str) -> list[tuple[str, str]]:\n43\t    tokens: list[tuple[str, str]] = []\n44\t    i, n = 0, len(text)\n45\t    while i < n:\n46\t        c = text[i]\n47\t        if c.isspace():\n48\t            i += 1\n49\t            continue\n50\t        if c in _SIMPLE_OPS:\n51\t            tokens.append((c, c))\n52\t            i += 1\n53\t            continue\n54\t        if c.isdigit() or c == \".\":\n55\t            j = i\n56\t            seen_dot = False\n57\t            while j < n and (text[j].isdigit() or (text[j] == \".\" and not seen_dot)):\n58\t                seen_dot = seen_dot or text[j] == \".\"\n59\t                j += 1\n60\t            tokens.append((\"NUM\", text[i:j]))\n61\t            i = j\n62\t            continue\n63\t        if c.isalpha():\n64\t            j = i\n65\t            while j < n and text[j].isalpha():\n66\t                j += 1\n67\t            word = text[i:j]\n68\t            if word == \"SIGNED\":\n69\t                tokens.append((\"SIGNED\", word))\n70\t            elif len(word) == 1 and word.isupper():\n71\t                tokens.append((\"LETTER\", word))\n72\t            else:\n73\t                raise FormulaError(f\"unsupported identifier {word!r} in formula {text!r}\")\n74\t            i = j\n75\t            continue\n76\t        raise FormulaError(f\"unsupported character {c!r} in formula {text!r}\")\n77\t    return tokens\n78\t\n79\t\n80\t# AST nodes are plain tuples: (\"num\", value) | (\"byte\", \"A\") | (\"signed\", node)\n81\t# | (\"unary\", \"-\", node) | (\"binop\", \"+\", left, right)\n82\t\n83\tclass _Parser:\n84\t    def __init__(self, tokens: list[tuple[str, str]]) -> None:\n85\t        self.tokens = tokens\n86\t        self.pos = 0\n87\t\n88\t    def _peek(self) -> tuple[Optional[str], Optional[str]]:\n89\t        if self.pos < len(self.tokens):\n90\t            return self.tokens[self.pos]\n91\t        return None, None\n92\t\n93\t    def _advance(self) -> tuple[Optional[str], Optional[str]]:\n94\t        tok = self._peek()\n95\t        self.pos += 1\n96\t        return tok\n97\t\n98\t    def _expect(self, kind: str) -> None:\n99\t        got, _ = self._advance()\n100\t        if got != kind:\n101\t            raise FormulaError(f\"expected {kind!r}, found {got!r}\")\n102\t\n103\t    def parse(self):\n104\t        node = self._expr()\n105\t        if self.pos != len(self.tokens):\n106\t            raise FormulaError(f\"unexpected trailing input at token {self.pos}\")\n107\t        return node\n108\t\n109\t    def _expr(self):\n110\t        node = self._term()\n111\t        while self._peek()[0] in (\"+\", \"-\"):\n112\t            op, _ = self._advance()\n113\t            node = (\"binop\", op, node, self._term())\n114\t        return node\n115\t\n116\t    def _term(self):\n117\t        node = self._factor()\n118\t        while self._peek()[0] in (\"*\", \"/\"):\n119\t            op, _ = self._advance()\n120\t            node = (\"binop\", op, node, self._factor())\n121\t        return node\n122\t\n123\t    def _factor(self):\n124\t        kind, _ = self._peek()\n125\t        if kind in (\"+\", \"-\"):\n126\t            self._advance()\n127\t            return (\"unary\", kind, self._factor())\n128\t        return self._primary()\n129\t\n130\t    def _primary(self):\n131\t        kind, val = self._advance()\n132\t        if kind == \"NUM\":\n133\t            return (\"num\", float(val) if \".\" in val else int(val))\n134\t        if kind == \"LETTER\":\n135\t            return (\"byte\", val)\n136\t        if kind == \"SIGNED\":\n137\t            self._expect(\"(\")\n138\t            node = self._expr()\n139\t            self._expect(\")\")\n140\t            return (\"signed\", node)\n141\t        if kind == \"(\":\n142\t            node = self._expr()\n143\t            self._expect(\")\")\n144\t            return node\n145\t        raise FormulaError(f\"unexpected token {kind!r}\")\n146\t\n147\t\n148\tdef _parse_expr(text: str):\n149\t    return _Parser(_tokenize(text)).parse()\n150\t\n151\t\n152\tdef _signed(value: Any) -> int:\n153\t    \"\"\"Two's-complement reinterpretation, byte-width chosen by magnitude.\n154\t\n155\t    Covers both ``SIGNED(A)`` (one byte) and ``SIGNED((A*256)+B)`` (two\n156\t    bytes combined first, then sign-corrected) -- both forms are used in\n157\t    the sourced formulas.\n158\t    \"\"\"\n159\t    try:\n160\t        iv = int(value)\n161\t    except (TypeError, ValueError):\n162\t        raise FormulaError(f\"SIGNED() operand is not an integer: {value!r}\")\n163\t    if float(iv) != float(value):\n164\t        raise FormulaError(f\"SIGNED() operand is not an integer: {value!r}\")\n165\t    for bits in (8, 16, 24, 32, 40, 48, 56, 64):\n166\t        span = 1 << bits\n167\t        if 0 <= iv < span:\n168\t            return iv - span if iv >= span // 2 else iv\n169\t    raise FormulaError(f\"SIGNED() operand out of range: {value!r}\")\n170\t\n171\t\n172\tdef _eval_node(node, data: list[int]) -> float:\n173\t    kind = node[0]\n174\t    if kind == \"num\":\n175\t        return node[1]\n176\t    if kind == \"byte\":\n177\t        idx = ord(node[1]) - ord(\"A\")\n178\t        if idx < 0 or idx >= len(data):\n179\t            raise FormulaError(\n180\t                f\"formula references byte {node[1]!r} but only {len(data)} byte(s) were returned\")\n181\t        return data[idx]\n182\t    if kind == \"signed\":\n183\t        return _signed(_eval_node(node[1], data))\n184\t    if kind == \"unary\":\n185\t        v = _eval_node(node[2], data)\n186\t        return -v if node[1] == \"-\" else v\n187\t    if kind == \"binop\":\n188\t        op = node[1]\n189\t        left = _eval_node(node[2], data)\n190\t        right = _eval_node(node[3], data)\n191\t        if op == \"+\":\n192\t            return left + right\n193\t        if op == \"-\":\n194\t            return left - right\n195\t        if op == \"*\":\n196\t            return left * right\n197\t        if op == \"/\":\n198\t            if right == 0:\n199\t                raise FormulaError(\"division by zero\")\n200\t            return left / right\n201\t    raise FormulaError(f\"malformed AST node {node!r}\")  # pragma: no cover - defensive\n202\t\n203\t\n204\tdef eval_formula(formula: str, data: list[int]) -> Union[float, dict[str, float]]:\n205\t    \"\"\"Evaluate one CarScanner-style formula against response-data bytes.\n206\t\n207\t    ``data`` is the response payload after the echoed DID, in order (``A``\n208\t    is ``data[0]``, ``B`` is ``data[1]``, ...). A plain formula (no ``;`` or\n209\t    ``=``) returns one number. A multi-field formula such as\n210\t    ``\"pressure=((A*256)+B)/1000; temp=E-50\"`` (the RFHUB tire DIDs' shape)\n211\t    returns ``{\"pressure\": ..., \"temp\": ...}``.\n212\t\n213\t    Raises :class:`FormulaError` for an empty formula, the ``\"multi-field\"``\n214\t    sentinel some catalog rows use in place of a real formula, or anything\n215\t    outside the safe grammar (unknown identifier, stray character, wrong\n216\t    argument count, missing byte, division by zero). There is no ``eval()``\n217\t    anywhere in this module: a formula that is not in the grammar simply\n218\t    cannot execute.\n219\t    \"\"\"\n220\t    text = formula.strip()\n221\t    if not text:\n222\t        raise FormulaError(\"empty formula\")\n223\t    if \";\" in text or \"=\" in text:\n224\t        out: dict[str, float] = {}\n225\t        for clause in text.split(\";\"):\n226\t            clause = clause.strip()\n227\t            if not clause:\n228\t                continue\n229\t            if \"=\" not in clause:\n230\t                raise FormulaError(f\"multi-field formula clause missing '=': {clause!r}\")\n231\t            name, expr = clause.split(\"=\", 1)\n232\t            name = name.strip()\n233\t            if not name:\n234\t                raise FormulaError(f\"multi-field formula clause missing a name: {clause!r}\")\n235\t            out[name] = _eval_node(_parse_expr(expr), data)\n236\t        return out\n237\t    return _eval_node(_parse_expr(text), data)\n238\t\n239\t\n240\t# ===========================================================================\n241\t# read_all\n242\t# ===========================================================================\n243\t\n244\tdef read_all(sess: Session, ecu: ECUAddress, include_unverified: bool = True) -> dict[str, Any]:\n245\t    \"\"\"Annex C identity plus every catalog DID for ``ecu``, decoded where possible.\n246\t\n247\t    Read-only: every byte on the wire goes through :func:`uds.read_did`,\n248\t    which goes through :func:`safety.assert_read_only_uds`. ``ecu`` must\n249\t    already carry a usable target (see :func:`uds.resolve_module`); this\n250\t    function does not resolve or discover addresses.\n251\t\n252\t    ``include_unverified=False`` restricts the sweep to catalog rows whose\n253\t    ``confidence`` is exactly ``\"confirmed\"`` -- on this car today that is\n254\t    only the Annex C identity set, since no module DID here has been\n255\t    confirmed on the 2.0T yet.\n256\t    \"\"\"\n257\t    identity = uds_mod.identity(sess, ecu)\n258\t    specs = did_catalog.all_dids(ecu.code, include_diesel=False)\n259\t    if not include_unverified:\n260\t        specs = [s for s in specs if s.confidence == \"confirmed\"]\n261\t\n262\t    dids: list[dict[str, Any]] = []\n263\t    counts = {\"answered\": 0, \"nrc\": 0, \"no_answer\": 0, \"error\": 0}\n264\t    for spec in specs:\n265\t        r = uds_mod.read_did(sess, ecu, spec.did)\n266\t        entry: dict[str, Any] = {\n267\t            \"did\": f\"{spec.did:04X}\", \"name\": spec.name, \"unit\": spec.unit,\n268\t            \"confidence\": spec.confidence, \"formula\": spec.formula,\n269\t            \"source\": spec.source, \"note\": spec.note,\n270\t            \"bytes\": r.get(\"bytes\"), \"ascii\": r.get(\"ascii\"),\n271\t            \"nrc\": r.get(\"nrc\"), \"error\": r.get(\"error\"),\n272\t        }\n273\t        if r.get(\"error\"):\n274\t            entry[\"status\"] = \"error\"\n275\t            counts[\"error\"] += 1\n276\t        elif r.get(\"bytes\"):\n277\t            entry[\"status\"] = \"answered\"\n278\t            counts[\"answered\"] += 1\n279\t            if spec.formula and spec.formula != \"multi-field\":\n280\t                try:\n281\t                    entry[\"value\"] = eval_formula(spec.formula,\n282\t                                                  [int(b, 16) for b in r[\"bytes\"]])\n283\t                except FormulaError as e:\n284\t                    entry[\"decode_error\"] = str(e)\n285\t        elif r.get(\"nrc\"):\n286\t            entry[\"status\"] = \"nrc\"\n287\t            counts[\"nrc\"] += 1\n288\t        else:\n289\t            entry[\"status\"] = \"no_answer\"\n290\t            counts[\"no_answer\"] += 1\n291\t        dids.append(entry)\n292\t\n293\t    audit.record(\"read_all\", ecu=ecu.code, total=len(dids), **counts)\n294\t    return {\n295\t        \"ecu\": ecu.code, \"bus\": sess.bus.key, \"identity\": identity, \"dids\": dids,\n296\t        \"summary\": {\"total\": len(dids), **counts},\n297\t    }\n298\t\n299\t\n300\t# ===========================================================================\n301\t# discover_dids\n302\t# ===========================================================================\n303\t\n304\t#: A conservative default sweep: Annex C plus the two blocks this project has\n305\t#: actually found live data in (0x1000s ECM/TCM signals, 0x0100s BCM/IPC).\n306\tDEFAULT_DISCOVERY_RANGES: tuple[tuple[int, int], ...] = (\n307\t    (0xF180, 0xF1FF), (0x1000, 0x10FF), (0x1900, 0x19FF), (0x0100, 0x01FF),\n308\t)\n309\t\n310\t\n311\tdef discover_dids(sess: Session, ecu: ECUAddress,\n312\t                   ranges: Optional[tuple[tuple[int, int], ...]] = None,\n313\t                   per_did_timeout: float = 0.15, max_dids: int = 2000) -> dict[str, Any]:\n314\t    \"\"\"Read-only ``0x22`` sweep over ``ranges`` against one already-targeted module.\n315\t\n316\t    For CAN-C modules. This does not special-case or bypass the CAN-CH\n317\t    confirm-before-transmit gate: ``session()``/``assert_transmit_allowed()``\n318\t    already enforce it, and pointing this at a CAN-CH ``ecu`` without a\n319\t    confirmed session simply raises :class:`errors.Refused` on the first\n320\t    request, exactly as any other read would. On CAN-CH prefer a short,\n321\t    human-reviewed ``ranges`` list -- every DID here is a request against\n322\t    brakes, steering or airbag hardware.\n323\t\n324\t    Stops early (``stopped_early`` set) on a bus-level error (anything\n325\t    other than a plain timeout, matching :func:`uds.discover`'s posture).\n326\t    A response with a positive payload is a hit; a negative response whose\n327\t    NRC is anything other than ``0x31`` (requestOutOfRange -- \"no such\n328\t    DID\", the overwhelming majority of the sweep) is recorded as\n329\t    interesting; plain requestOutOfRange and silent timeouts are neither.\n330\t    \"\"\"\n331\t    if ranges is None:\n332\t        ranges = DEFAULT_DISCOVERY_RANGES\n333\t    hits: list[dict[str, Any]] = []\n334\t    interesting_nrcs: list[dict[str, Any]] = []\n335\t    tried = 0\n336\t    stopped_early: Optional[str] = None\n337\t    for start, end in ranges:\n338\t        if stopped_early:\n339\t            break\n340\t        for did in range(start, end + 1):\n341\t            if tried >= max_dids:\n342\t                stopped_early = stopped_early or \"max_dids reached\"\n343\t                break\n344\t            tried += 1\n345\t            r = uds_mod.read_did(sess, ecu, did, timeout=per_did_timeout)\n346\t            if r.get(\"error\") and r[\"error\"] != \"TIMEOUT\":\n347\t                stopped_early = r[\"error\"]\n348\t                break\n349\t            if r.get(\"error\") == \"TIMEOUT\":\n350\t                continue  # a single silent DID, not a bus fault\n351\t            if r.get(\"bytes\"):\n352\t                hits.append({\"did\": f\"{did:04X}\", \"bytes\": r[\"bytes\"], \"ascii\": r.get(\"ascii\")})\n353\t                continue\n354\t            nrc = r.get(\"nrc\")\n355\t            if nrc:\n356\t                interesting = {h: t for h, t in nrc.items() if t != _NRC_31}\n357\t                if interesting:\n358\t                    interesting_nrcs.append({\"did\": f\"{did:04X}\", \"nrc\": interesting})\n359\t            # else: silent (no answer / timeout) -- neither a hit nor interesting\n360\t\n361\t    audit.record(\"discover_dids\", ecu=ecu.code, tried=tried, hits=len(hits),\n362\t                 nrcs=len(interesting_nrcs), stopped_early=stopped_early)\n363\t    return {\n364\t        \"ecu\": ecu.code, \"bus\": sess.bus.key, \"tried\": tried, \"stopped_early\": stopped_early,\n365\t        \"positive\": hits, \"nrcs\": interesting_nrcs,\n366\t    }\n367\t\n368\t\n369\t__all__ = [\"FormulaError\", \"eval_formula\", \"read_all\", \"discover_dids\",\n370\t           \"DEFAULT_DISCOVERY_RANGES\"]\n371\t"}]},"uuid":"3d00d22d-a7da-4324-94dc-7f9407006bda","timestamp":"2026-10-14T17:58:28.030Z","toolUseResult":{"type":"text","file":{"filePath":"C:\\Users\\User\\mcp-servers\\cuore\\live\\readall.py","content":"\"\"\"Session-level \"read everything we know how to ask for\" on one module.\n\nTwo pieces:\n\n* A tiny, safe CarScanner-formula evaluator (no ``eval``). CarScanner/MES\n  formulas are arithmetic over response-data byte letters (``A``, ``B``,\n  ``C`` ... in order after the echoed DID), ``+ - * /``, parentheses, and\n  ``SIGNED(...)``. That is a small enough grammar to hand-parse; anything\n  outside it (a stray identifier, a bitwise operator, an unbalanced paren)\n  raises :class:`FormulaError` rather than ever being handed to Python's\n  ``eval``.\n* :func:`read_all` and :func:`discover_dids`, both read-only, both going\n  through :func:`uds.read_did` (so the read-only allowlist in\n  :mod:`safety` still gates every byte on the wire).\n\nStdlib only besides the ``cuore.live`` imports.\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom typing import Any, Optional, Union\n\nfrom . import audit\nfrom . import did_catalog\nfrom . import uds as uds_mod\nfrom .addressing import ECUAddress\nfrom .transport import Session\n\n# ===========================================================================\n# formula evaluator\n# ===========================================================================\n\n\nclass FormulaError(Exception):\n    \"\"\"Raised for anything that is not a safe, recognised CarScanner formula.\"\"\"\n\n\n_SIMPLE_OPS = frozenset(\"+-*/()\")\n_NRC_31 = \"requestOutOfRange\"\n\n\ndef _tokenize(text: str) -> list[tuple[str, str]]:\n    tokens: list[tuple[str, str]] = []\n    i, n = 0, len(text)\n    while i < n:\n        c = text[i]\n        if c.isspace():\n            i += 1\n            continue\n        if c in _SIMPLE_OPS:\n            tokens.append((c, c))\n            i += 1\n            continue\n        if c.isdigit() or c == \".\":\n            j = i\n            seen_dot = False\n            while j < n and (text[j].isdigit() or (text[j] == \".\" and not seen_dot)):\n                seen_dot = seen_dot or text[j] == \".\"\n                j += 1\n            tokens.append((\"NUM\", text[i:j]))\n            i = j\n            continue\n        if c.isalpha():\n            j = i\n            while j < n and text[j].isalpha():\n                j += 1\n            word = text[i:j]\n            if word == \"SIGNED\":\n                tokens.append((\"SIGNED\", word))\n            elif len(word) == 1 and word.isupper():\n                tokens.append((\"LETTER\", word))\n            else:\n                raise FormulaError(f\"unsupported identifier {word!r} in formula {text!r}\")\n            i = j\n            continue\n        raise FormulaError(f\"unsupported character {c!r} in formula {text!r}\")\n    return tokens\n\n\n# AST nodes are plain tuples: (\"num\", value) | (\"byte\", \"A\") | (\"signed\", node)\n# | (\"unary\", \"-\", node) | (\"binop\", \"+\", left, right)\n\nclass _Parser:\n    def __init__(self, tokens: list[tuple[str, str]]) -> None:\n        self.tokens = tokens\n        self.pos = 0\n\n    def _peek(self) -> tuple[Optional[str], Optional[str]]:\n        if self.pos < len(self.tokens):\n            return self.tokens[self.pos]\n        return None, None\n\n    def _advance(self) -> tuple[Optional[str], Optional[str]]:\n        tok = self._peek()\n        self.pos += 1\n        return tok\n\n    def _expect(self, kind: str) -> None:\n        got, _ = self._advance()\n        if got != kind:\n            raise FormulaError(f\"expected {kind!r}, found {got!r}\")\n\n    def parse(self):\n        node = self._expr()\n        if self.pos != len(self.tokens):\n            raise FormulaError(f\"unexpected trailing input at token {self.pos}\")\n        return node\n\n    def _expr(self):\n        node = self._term()\n        while self._peek()[0] in (\"+\", \"-\"):\n            op, _ = self._advance()\n            node = (\"binop\", op, node, self._term())\n        return node\n\n    def _term(self):\n        node = self._factor()\n        while self._peek()[0] in (\"*\", \"/\"):\n            op, _ = self._advance()\n            node = (\"binop\", op, node, self._factor())\n        return node\n\n    def _factor(self):\n        kind, _ = self._peek()\n        if kind in (\"+\", \"-\"):\n            self._advance()\n            return (\"unary\", kind, self._factor())\n        return self._primary()\n\n    def _primary(self):\n        kind, val = self._advance()\n        if kind == \"NUM\":\n            return (\"num\", float(val) if \".\" in val else int(val))\n        if kind == \"LETTER\":\n            return (\"byte\", val)\n        if kind == \"SIGNED\":\n            self._expect(\"(\")\n            node = self._expr()\n            self._expect(\")\")\n            return (\"signed\", node)\n        if kind == \"(\":\n            node = self._expr()\n            self._expect(\")\")\n            return node\n        raise FormulaError(f\"unexpected token {kind!r}\")\n\n\ndef _parse_expr(text: str):\n    return _Parser(_tokenize(text)).parse()\n\n\ndef _signed(value: Any) -> int:\n    \"\"\"Two's-complement reinterpretation, byte-width chosen by magnitude.\n\n    Covers both ``SIGNED(A)`` (one byte) and ``SIGNED((A*256)+B)`` (two\n    bytes combined first, then sign-corrected) -- both forms are used in\n    the sourced formulas.\n    \"\"\"\n    try:\n        iv = int(value)\n    except (TypeError, ValueError):\n        raise FormulaError(f\"SIGNED() operand is not an integer: {value!r}\")\n    if float(iv) != float(value):\n        raise FormulaError(f\"SIGNED() operand is not an integer: {value!r}\")\n    for bits in (8, 16, 24, 32, 40, 48, 56, 64):\n        span = 1 << bits\n        if 0 <= iv < span:\n            return iv - span if iv >= span // 2 else iv\n    raise FormulaError(f\"SIGNED() operand out of range: {value!r}\")\n\n\ndef _eval_node(node, data: list[int]) -> float:\n    kind = node[0]\n    if kind == \"num\":\n        return node[1]\n    if kind == \"byte\":\n        idx = ord(node[1]) - ord(\"A\")\n        if idx < 0 or idx >= len(data):\n            raise FormulaError(\n                f\"formula references byte {node[1]!r} but only {len(data)} byte(s) were returned\")\n        return data[idx]\n    if kind == \"signed\":\n        return _signed(_eval_node(node[1], data))\n    if kind == \"unary\":\n        v = _eval_node(node[2], data)\n        return -v if node[1] == \"-\" else v\n    if kind == \"binop\":\n        op = node[1]\n        left = _eval_node(node[2], data)\n        right = _eval_node(node[3], data)\n        if op == \"+\":\n            return left + right\n        if op == \"-\":\n            return left - right\n        if op == \"*\":\n            return left * right\n        if op == \"/\":\n            if right == 0:\n                raise FormulaError(\"division by zero\")\n            return left / right\n    raise FormulaError(f\"malformed AST node {node!r}\")  # pragma: no cover - defensive\n\n\ndef eval_formula(formula: str, data: list[int]) -> Union[float, dict[str, float]]:\n    \"\"\"Evaluate one CarScanner-style formula against response-data bytes.\n\n    ``data`` is the response payload after the echoed DID, in order (``A``\n    is ``data[0]``, ``B`` is ``data[1]``, ...). A plain formula (no ``;`` or\n    ``=``) returns one number. A multi-field formula such as\n    ``\"pressure=((A*256)+B)/1000; temp=E-50\"`` (the RFHUB tire DIDs' shape)\n    returns ``{\"pressure\": ..., \"temp\": ...}``.\n\n    Raises :class:`FormulaError` for an empty formula, the ``\"multi-field\"``\n    sentinel some catalog rows use in place of a real formula, or anything\n    outside the safe grammar (unknown identifier, stray character, wrong\n    argument count, missing byte, division by zero). There is no ``eval()``\n    anywhere in this module: a formula that is not in the grammar simply\n    cannot execute.\n    \"\"\"\n    text = formula.strip()\n    if not text:\n        raise FormulaError(\"empty formula\")\n    if \";\" in text or \"=\" in text:\n        out: dict[str, float] = {}\n        for clause in text.split(\";\"):\n            clause = clause.strip()\n            if not clause:\n                continue\n            if \"=\" not in clause:\n                raise FormulaError(f\"multi-field formula clause missing '=': {clause!r}\")\n            name, expr = clause.split(\"=\", 1)\n            name = name.strip()\n            if not name:\n                raise FormulaError(f\"multi-field formula clause missing a name: {clause!r}\")\n            out[name] = _eval_node(_parse_expr(expr), data)\n        return out\n    return _eval_node(_parse_expr(text), data)\n\n\n# ===========================================================================\n# read_all\n# ===========================================================================\n\ndef read_all(sess: Session, ecu: ECUAddress, include_unverified: bool = True) -> dict[str, Any]:\n    \"\"\"Annex C identity plus every catalog DID for ``ecu``, decoded where possible.\n\n    Read-only: every byte on the wire goes through :func:`uds.read_did`,\n    which goes through :func:`safety.assert_read_only_uds`. ``ecu`` must\n    already carry a usable target (see :func:`uds.resolve_module`); this\n    function does not resolve or discover addresses.\n\n    ``include_unverified=False`` restricts the sweep to catalog rows whose\n    ``confidence`` is exactly ``\"confirmed\"`` -- on this car today that is\n    only the Annex C identity set, since no module DID here has been\n    confirmed on the 2.0T yet.\n    \"\"\"\n    identity = uds_mod.identity(sess, ecu)\n    specs = did_catalog.all_dids(ecu.code, include_diesel=False)\n    if not include_unverified:\n        specs = [s for s in specs if s.confidence == \"confirmed\"]\n\n    dids: list[dict[str, Any]] = []\n    counts = {\"answered\": 0, \"nrc\": 0, \"no_answer\": 0, \"error\": 0}\n    for spec in specs:\n        r = uds_mod.read_did(sess, ecu, spec.did)\n        entry: dict[str, Any] = {\n            \"did\": f\"{spec.did:04X}\", \"name\": spec.name, \"unit\": spec.unit,\n            \"confidence\": spec.confidence, \"formula\": spec.formula,\n            \"source\": spec.source, \"note\": spec.note,\n            \"bytes\": r.get(\"bytes\"), \"ascii\": r.get(\"ascii\"),\n            \"nrc\": r.get(\"nrc\"), \"error\": r.get(\"error\"),\n        }\n        if r.get(\"error\"):\n            entry[\"status\"] = \"error\"\n            counts[\"error\"] += 1\n        elif r.get(\"bytes\"):\n            entry[\"status\"] = \"answered\"\n            counts[\"answered\"] += 1\n            if spec.formula and spec.formula != \"multi-field\":\n                try:\n                    entry[\"value\"] = eval_formula(spec.formula,\n                                                  [int(b, 16) for b in r[\"bytes\"]])\n                except FormulaError as e:\n                    entry[\"decode_error\"] = str(e)\n        elif r.get(\"nrc\"):\n            entry[\"status\"] = \"nrc\"\n            counts[\"nrc\"] += 1\n        else:\n            entry[\"status\"] = \"no_answer\"\n            counts[\"no_answer\"] += 1\n        dids.append(entry)\n\n    audit.record(\"read_all\", ecu=ecu.code, total=len(dids), **counts)\n    return {\n        \"ecu\": ecu.code, \"bus\": sess.bus.key, \"identity\": identity, \"dids\": dids,\n        \"summary\": {\"total\": len(dids), **counts},\n    }\n\n\n# ===========================================================================\n# discover_dids\n# ===========================================================================\n\n#: A conservative default sweep: Annex C plus the two blocks this project has\n#: actually found live data in (0x1000s ECM/TCM signals, 0x0100s BCM/IPC).\nDEFAULT_DISCOVERY_RANGES: tuple[tuple[int, int], ...] = (\n    (0xF180, 0xF1FF), (0x1000, 0x10FF), (0x1900, 0x19FF), (0x0100, 0x01FF),\n)\n\n\ndef discover_dids(sess: Session, ecu: ECUAddress,\n                   ranges: Optional[tuple[tuple[int, int], ...]] = None,\n                   per_did_timeout: float = 0.15, max_dids: int = 2000) -> dict[str, Any]:\n    \"\"\"Read-only ``0x22`` sweep over ``ranges`` against one already-targeted module.\n\n    For CAN-C modules. This does not special-case or bypass the CAN-CH\n    confirm-before-transmit gate: ``session()``/``assert_transmit_allowed()``\n    already enforce it, and pointing this at a CAN-CH ``ecu`` without a\n    confirmed session simply raises :class:`errors.Refused` on the first\n    request, exactly as any other read would. On CAN-CH prefer a short,\n    human-reviewed ``ranges`` list -- every DID here is a request against\n    brakes, steering or airbag hardware.\n\n    Stops early (``stopped_early`` set) on a bus-level error (anything\n    other than a plain timeout, matching :func:`uds.discover`'s posture).\n    A response with a positive payload is a hit; a negative response whose\n    NRC is anything other than ``0x31`` (requestOutOfRange -- \"no such\n    DID\", the overwhelming majority of the sweep) is recorded as\n    interesting; plain requestOutOfRange and silent timeouts are neither.\n    \"\"\"\n    if ranges is None:\n        ranges = DEFAULT_DISCOVERY_RANGES\n    hits: list[dict[str, Any]] = []\n    interesting_nrcs: list[dict[str, Any]] = []\n    tried = 0\n    stopped_early: Optional[str] = None\n    for start, end in ranges:\n        if stopped_early:\n            break\n        for did in range(start, end + 1):\n            if tried >= max_dids:\n                stopped_early = stopped_early or \"max_dids reached\"\n                break\n            tried += 1\n            r = uds_mod.read_did(sess, ecu, did, timeout=per_did_timeout)\n            if r.get(\"error\") and r[\"error\"] != \"TIMEOUT\":\n                stopped_early = r[\"error\"]\n                break\n            if r.get(\"error\") == \"TIMEOUT\":\n                continue  # a single silent DID, not a bus fault\n            if r.get(\"bytes\"):\n                hits.append({\"did\": f\"{did:04X}\", \"bytes\": r[\"bytes\"], \"ascii\": r.get(\"ascii\")})\n                continue\n            nrc = r.get(\"nrc\")\n            if nrc:\n                interesting = {h: t for h, t in nrc.items() if t != _NRC_31}\n                if interesting:\n                    interesting_nrcs.append({\"did\": f\"{did:04X}\", \"nrc\": interesting})\n            # else: silent (no answer / timeout) -- neither a hit nor interesting\n\n    audit.record(\"discover_dids\", ecu=ecu.code, tried=tried, hits=len(hits),\n                 nrcs=len(interesting_nrcs), stopped_early=stopped_early)\n    return {\n        \"ecu\": ecu.code, \"bus\": sess.bus.key, \"tried\": tried, \"stopped_early\": stopped_early,\n        \"positive\": hits, \"nrcs\": interesting_nrcs,\n    }\n\n\n__all__ = [\"FormulaError\", \"eval_formula\", \"read_all\", \"discover_dids\",\n           \"DEFAULT_DISCOVERY_RANGES\"]\n","numLines":371,"startLine":1,"totalLines":371}},"sourceToolAssistantUUID":"2e63c1e0-88df-460c-b2d4-5357af0cc720","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
