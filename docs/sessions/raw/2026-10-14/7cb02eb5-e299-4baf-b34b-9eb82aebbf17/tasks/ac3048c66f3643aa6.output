 no ``SIGNED()``, so it cannot express a signed field).\n_MES_BYTE_LETTERS = \"ABCDEFGHIJKLMNOP\"\n\n\ndef _mes_key(module_code: str, did: str, field: Optional[dict[str, Any]]) -> tuple[str, str, str]:\n    return (module_code.upper(), did.upper(), json.dumps(field or {}, sort_keys=True))\n\n\ndef _mes_formula(field: dict[str, Any], scale: float, offset: float) -> str:\n    off = int(field.get(\"offset\", 0))\n    width = field.get(\"width\", \"byte\")\n    signed = bool(field.get(\"signed\", False))\n    if off < 0 or off >= len(_MES_BYTE_LETTERS) or (width == \"u16\" and off + 1 >= len(_MES_BYTE_LETTERS)):","numLines":18,"startLine":230,"totalLines":358}},"sourceToolAssistantUUID":"b280cc03-4c22-40a8-bc39-241deb373645","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
