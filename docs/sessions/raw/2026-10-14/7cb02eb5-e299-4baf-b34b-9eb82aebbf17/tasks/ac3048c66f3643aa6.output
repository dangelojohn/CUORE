cally\n    equivalent two's-complement for the full 16-bit value either way.\n    \"\"\"\n    off = int(field.get(\"offset\", 0))\n    width = field.get(\"width\", \"byte\")\n    signed = bool(field.get(\"signed\", False))\n    if off < 0 or off >= len(_MES_BYTE_LETTERS) or (width == \"u16\" and off + 1 >= len(_MES_BYTE_LETTERS)):\n        raise ValueError(f\"offset {off} out of range for a formula letter\")\n    hi, lo = _MES_BYTE_LETTERS[off], (_MES_BYTE_LETTERS[off + 1] if width == \"u16\" else \"\")\n    if width == \"u16\":\n        expr = f\"(({f'SIGNED({hi})' if signed else hi}*256)+{lo})\"\n    else:\n        expr = f\"SIGNED({hi})\" if signed else hi\n    scale_r = round(float(scale), 6)","originalFile":null,"structuredPatch":[{"oldStart":241,"oldLines":15,"newStart":241,"newLines":29,"lines":[" "," "," def _mes_formula(field: dict[str, Any], scale: float, offset: float) -> str:","+    \"\"\"Build the CarScanner-style formula for one learned field.","+","+    For a signed 2-byte field this deliberately writes","+    ``(SIGNED(<hi>)*256)+<lo>`` -- sign-correcting the HIGH byte alone --","+    rather than ``SIGNED((<hi>*256)+<lo>)``. :func:`cuore.live.readall.","+    _signed` picks its two's-complement width by the *magnitude* of its","+    operand, trying 8 bits first: wrapping the already-combined 16-bit value","+    in ``SIGNED()`` misreads any raw value whose high byte is 0 (so the","+    combined value is < 256) as an 8-bit negative number instead of a small","+    positive 16-bit one. Sign-correcting the high byte on its own is always","+    unambiguous (a lone byte is always 8 bits) and is algebraically","+    equivalent two's-complement for the full 16-bit value either way.","+    \"\"\"","     off = int(field.get(\"offset\", 0))","     width = field.get(\"width\", \"byte\")","     signed = bool(field.get(\"signed\", False))","     if off < 0 or off >= len(_MES_BYTE_LETTERS) or (width == \"u16\" and off + 1 >= len(_MES_BYTE_LETTERS)):","         raise ValueError(f\"offset {off} out of range for a formula letter\")","-    expr = (_MES_BYTE_LETTERS[off] if width != \"u16\" else","-           f\"(({_MES_BYTE_LETTERS[off]}*256)+{_MES_BYTE_LETTERS[off + 1]})\")","-    if signed:","-        expr = f\"SIGNED({expr})\"","+    hi, lo = _MES_BYTE_LETTERS[off], (_MES_BYTE_LETTERS[off + 1] if width == \"u16\" else \"\")","+    if width == \"u16\":","+        expr = f\"(({f'SIGNED({hi})' if signed else hi}*256)+{lo})\"","+    else:","+        expr = f\"SIGNED({hi})\" if signed else hi","     scale_r = round(float(scale), 6)","     offset_r = round(float(offset), 6)","     formula = f\"{expr}*{scale_r}\""]}],"userModified":false,"replaceAll":false,"contentNotInModelContext":true},"serverClassifierContext":{"request":"123bd64c-60ee-40e0-9372-04530b6aeb71","context":{"git_state":{"cwd":"/c/Users/User/mcp-servers","root":null,"branch":null,"default_branch":null,"status":null,"visibility":null,"error":"pending"},"live_cwd":"/c/Users/User/mcp-servers","platform":"windows"}},"sourceToolAssistantUUID":"58f3f312-1141-4745-900b-cc6eeddaf434","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
