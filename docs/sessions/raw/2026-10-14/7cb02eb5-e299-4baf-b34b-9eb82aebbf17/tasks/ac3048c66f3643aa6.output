{"parentUuid":"937ec92e-26a8-40b8-b93e-8392e480dcf3","isSidechain":true,"agentId":"ac3048c66f3643aa6","message":{"model":"claude-sonnet-5","id":"msg_011Cg2ZaToo22niaWhr5verx","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01DeWbuQmJRyBZm2Z8JLjUGn","name":"Read","input":{"file_path":"C:\\Users\\User\\mcp-servers\\cuore\\live\\ui_store.py"},"caller":{"type":"direct"}}],"container":null,"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1103,"cache_read_input_tokens":95316,"output_tokens":1025,"output_tokens_details":{"thinking_tokens":950},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":0,"ephemeral_5m_input_tokens":1103},"inference_geo":"global","iterations":[{"input_tokens":2,"output_tokens":1025,"cache_read_input_tokens":95316,"cache_creation_input_tokens":1103,"cache_creation":{"ephemeral_5m_input_tokens":1103,"ephemeral_1h_input_tokens":0},"type":"message"}],"speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_01DeWbuQmJRyBZm2Z8JLjUGn":{"file_path":"C:\\Users\\User\\mcp-servers\\cuore\\live\\ui_store.py"}},"serverClassifierRequest":"6b1497cd-b961-41c9-81b9-fcef6cf5016b","apiBlockIndex":1,"requestId":"req_011Cg2ZaT6Pg72egXdoPeScZ","attributionAgent":"general-purpose","type":"assistant","uuid":"21ac68ed-f16d-43d7-8889-402c8e588b39","timestamp":"2026-10-14T17:57:52.553Z","effort":"high","perTurnEffort":null,"userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
{"parentUuid":"21ac68ed-f16d-43d7-8889-402c8e588b39","isSidechain":true,"promptId":"f5371174-bba0-4992-a14b-d71ea13c02eb","agentId":"ac3048c66f3643aa6","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01DeWbuQmJRyBZm2Z8JLjUGn","type":"tool_result","content":"1\t\"\"\"Dashboard-UI-only state: custom (Torque-style) channels, snapshots, triggers.\n2\t\n3\tNothing here talks to the adapter. Custom channels are validated against the\n4\tsame safe arithmetic grammar the built-in computed channels use\n5\t(:func:`cuore.live.channels.eval_expr`) so there is still no ``eval()`` in the\n6\tsystem; :func:`load_custom_channels` hands back ordinary\n7\t:class:`~cuore.live.channels.Channel` objects so a future wiring step can fold\n8\tthem into the poller's registry with no special case.\n9\t\"\"\"\n10\t\n11\tfrom __future__ import annotations\n12\t\n13\timport json\n14\timport re\n15\timport threading\n16\timport uuid\n17\tfrom datetime import datetime\n18\tfrom pathlib import Path\n19\tfrom typing import Any, Optional\n20\t\n21\tfrom ..services.errors import BadRequest, NotFound\n22\tfrom . import channels as channels_mod\n23\tfrom .addressing import by_code\n24\tfrom .config import state_dir\n25\t\n26\t_LOCK = threading.Lock()\n27\t\n28\t_ID_RE = re.compile(r\"^[a-z0-9][a-z0-9_]{0,63}$\")\n29\t_DID_RE = re.compile(r\"^[0-9A-Fa-f]{4}$\")\n30\t\n31\t#: Sample bytes A, B, C, ... used to validate a Torque-style byte formula.\n32\t#: (Arbitrary but fixed and documented, per the task's own example.)\n33\t_SAMPLE_BYTES = [0x12, 0x34, 0x56, 0x78, 0x9A, 0xBC, 0xDE, 0xF0]\n34\t_BYTE_NAMES = \"ABCDEFGH\"\n35\t\n36\t\n37\t# ===========================================================================\n38\t# custom channels\n39\t# ===========================================================================\n40\t\n41\tdef custom_channels_path() -> Path:\n42\t    return state_dir() / \"custom_channels.json\"\n43\t\n44\t\n45\tdef _load_raw() -> list[dict[str, Any]]:\n46\t    p = custom_channels_path()\n47\t    if not p.exists():\n48\t        return []\n49\t    try:\n50\t        data = json.loads(p.read_text(encoding=\"utf-8\"))\n51\t    except (OSError, ValueError):\n52\t        return []\n53\t    return list(data.get(\"channels\", [])) if isinstance(data, dict) else []\n54\t\n55\t\n56\tdef _save_raw(channels: list[dict[str, Any]]) -> None:\n57\t    custom_channels_path().write_text(\n58\t        json.dumps({\"channels\": channels}, indent=2), encoding=\"utf-8\")\n59\t\n60\t\n61\tdef _validate_formula(cid: str, formula: str) -> None:\n62\t    if not isinstance(formula, str) or not formula.strip():\n63\t        raise BadRequest(f\"custom channel {cid!r}: formula is required for kind='did'\")\n64\t    values = {name: float(b) for name, b in zip(_BYTE_NAMES, _SAMPLE_BYTES)}\n65\t    try:\n66\t        channels_mod.eval_expr(formula, values)\n67\t    except channels_mod.ComputedError as exc:\n68\t        raise BadRequest(f\"custom channel {cid!r}: invalid formula {formula!r}: {exc}\") from exc\n69\t\n70\t\n71\t_IDENT_RE = re.compile(r\"[A-Za-z_][A-Za-z0-9_]*\")\n72\t\n73\t\n74\tdef _referenced_ids(expr: str) -> set[str]:\n75\t    \"\"\"Every identifier ``expr`` names -- channel ids it depends on.\n76\t\n77\t    Uses a plain identifier scan rather than the private tokenizer in\n78\t    :mod:`channels`, since all that is needed here is the set of names, not a\n79\t    parse tree; the arithmetic grammar itself is still enforced by\n80\t    :func:`channels.eval_expr` below.\n81\t    \"\"\"\n82\t    return set(_IDENT_RE.findall(expr))\n83\t\n84\t\n85\tdef _validate_computed(cid: str, expr: str, known_ids: set[str]) -> set[str]:\n86\t    if not isinstance(expr, str) or not expr.strip():\n87\t        raise BadRequest(f\"custom channel {cid!r}: expr is required for kind='computed'\")\n88\t    refs = _referenced_ids(expr)\n89\t    unknown = refs - known_ids\n90\t    if unknown:\n91\t        raise BadRequest(f\"custom channel {cid!r}: expr references unknown channel(s) \"\n92\t                         f\"{sorted(unknown)}\")\n93\t    dummy = {r: 1.0 for r in refs}\n94\t    try:\n95\t        channels_mod.eval_expr(expr, dummy)\n96\t    except channels_mod.ComputedError as exc:\n97\t        raise BadRequest(f\"custom channel {cid!r}: invalid expr {expr!r}: {exc}\") from exc\n98\t    return refs\n99\t\n100\t\n101\tdef _check_cycles(deps: dict[str, set[str]]) -> None:\n102\t    \"\"\"Raise :class:`BadRequest` if the computed-channel dependency graph has a cycle.\"\"\"\n103\t    WHITE, GRAY, BLACK = 0, 1, 2\n104\t    color = {cid: WHITE for cid in deps}\n105\t\n106\t    def visit(cid: str, stack: list[str]) -> None:\n107\t        color[cid] = GRAY\n108\t        for dep in deps.get(cid, ()):\n109\t            if dep not in deps:\n110\t                continue  # depends on a registry channel, not another custom one\n111\t            if color.get(dep) == GRAY:\n112\t                cycle = \" -> \".join(stack + [dep])\n113\t                raise BadRequest(f\"custom channels have a cycle: {cycle}\")\n114\t            if color.get(dep) == WHITE:\n115\t                visit(dep, stack + [dep])\n116\t        color[cid] = BLACK\n117\t\n118\t    for cid in deps:\n119\t        if color[cid] == WHITE:\n120\t            visit(cid, [cid])\n121\t\n122\t\n123\tdef validate_custom_channels(raw: list[dict[str, Any]]) -> list[dict[str, Any]]:\n124\t    \"\"\"Validate the whole submitted list at once (ids must be unique, cycle-free).\"\"\"\n125\t    if not isinstance(raw, list):\n126\t        raise BadRequest(\"channels must be a list\")\n127\t    # Built-in ids only -- not the full registry, which (via load_custom_channels)\n128\t    # now includes previously-saved custom channels too. Checking against the\n129\t    # full registry would make re-saving (editing) an existing custom channel\n130\t    # collide with its own earlier self.\n131\t    registry_ids = channels_mod.builtin_channel_ids()\n132\t    seen: set[str] = set()\n133\t\n134\t    # Pass 1: shape/id checks only, so a computed channel may forward-reference\n135\t    # another custom channel defined later in the same submitted list.\n136\t    for ch in raw:\n137\t        if not isinstance(ch, dict):\n138\t            raise BadRequest(\"each custom channel must be an object\")\n139\t        cid = ch.get(\"id\")\n140\t        if not isinstance(cid, str) or not _ID_RE.match(cid):\n141\t            raise BadRequest(f\"custom channel id must match {_ID_RE.pattern!r}, got {cid!r}\")\n142\t        if cid in seen:\n143\t            raise BadRequest(f\"duplicate custom channel id {cid!r}\")\n144\t        if cid in registry_ids:\n145\t            raise BadRequest(f\"custom channel id {cid!r} collides with a built-in channel\")\n146\t        seen.add(cid)\n147\t        name = ch.get(\"name\")\n148\t        if not isinstance(name, str) or not name.strip():\n149\t            raise BadRequest(f\"custom channel {cid!r}: name is required\")\n150\t        unit = ch.get(\"unit\", \"\")\n151\t        if not isinstance(unit, str):\n152\t            raise BadRequest(f\"custom channel {cid!r}: unit must be a string\")\n153\t        kind = ch.get(\"kind\")\n154\t        if kind not in (\"did\", \"computed\"):\n155\t            raise BadRequest(f\"custom channel {cid!r}: kind must be 'did' or 'computed', \"\n156\t                             f\"got {kind!r}\")\n157\t\n158\t    known_ids = registry_ids | seen\n159\t\n160\t    # Pass 2: per-kind validation, now that every id in this submission is known.\n161\t    out: list[dict[str, Any]] = []\n162\t    deps: dict[str, set[str]] = {}\n163\t    for ch in raw:\n164\t        cid = ch[\"id\"]\n165\t        entry: dict[str, Any] = {\"id\": cid, \"name\": ch[\"name\"], \"unit\": ch.get(\"unit\", \"\"),\n166\t                                 \"kind\": ch[\"kind\"]}\n167\t        if ch[\"kind\"] == \"did\":\n168\t            module = ch.get(\"module\")\n169\t            ecu = by_code(module.upper()) if isinstance(module, str) else None\n170\t            if ecu is None:\n171\t                raise BadRequest(f\"custom channel {cid!r}: unknown module {module!r}\")\n172\t            if ecu.bus_key != \"can_c\":\n173\t                raise BadRequest(f\"custom channel {cid!r}: module {module!r} is on bus \"\n174\t                                 f\"{ecu.bus_key!r}; the live-data poller currently serves \"\n175\t                                 f\"can_c channels only\")\n176\t            did = ch.get(\"did\")\n177\t            if not isinstance(did, str) or not _DID_RE.match(did):\n178\t                raise BadRequest(f\"custom channel {cid!r}: did must be 4 hex digits, \"\n179\t                                 f\"got {did!r}\")\n180\t            formula = ch.get(\"formula\", \"\")\n181\t            _validate_formula(cid, formula)\n182\t            entry.update({\"module\": module.upper(), \"did\": did.upper(), \"formula\": formula})\n183\t        else:\n184\t            expr = ch.get(\"expr\", \"\")\n185\t            refs = _validate_computed(cid, expr, known_ids)\n186\t            entry[\"expr\"] = expr\n187\t            deps[cid] = refs\n188\t        out.append(entry)\n189\t\n190\t    _check_cycles(deps)\n191\t    return out\n192\t\n193\t\n194\tdef load_custom_channels_raw() -> dict[str, Any]:\n195\t    return {\"channels\": _load_raw()}\n196\t\n197\t\n198\tdef save_custom_channels(raw: list[dict[str, Any]]) -> dict[str, Any]:\n199\t    validated = validate_custom_channels(raw)\n200\t    with _LOCK:\n201\t        _save_raw(validated)\n202\t    channels_mod.invalidate_registry()\n203\t    return {\"channels\": validated}\n204\t\n205\t\n206\tdef load_custom_channels() -> list[channels_mod.Channel]:\n207\t    \"\"\"User-defined channels as ordinary :class:`Channel` objects.\n208\t\n209\t    Marked ``confidence=\"USER-DEFINED\"`` so the registry can tell them apart\n210\t    from anything catalogued from the vehicle. Not wired into\n211\t    :func:`channels.registry` here -- that integration belongs to whoever owns\n212\t    the poller/registry wiring; this function only hands back well-formed\n213\t    objects for that step.\n214\t    \"\"\"\n215\t    out: list[channels_mod.Channel] = []\n216\t    for ch in _load_raw():\n217\t        if ch.get(\"kind\") == \"did\":\n218\t            out.append(channels_mod.Channel(\n219\t                id=ch[\"id\"], name=ch[\"name\"], unit=ch.get(\"unit\", \"\"), kind=\"did\",\n220\t                bus=\"can_c\", confidence=\"USER-DEFINED\", default_rate_hz=channels_mod.MED_HZ,\n221\t                module=ch.get(\"module\", \"\"), did=int(ch.get(\"did\", \"0\"), 16),\n222\t                formula=ch.get(\"formula\", \"\"),\n223\t                note=\"Torque-style byte algebra: A, B, C... map to successive \"\n224\t                     \"response bytes\"))\n225\t        else:\n226\t            refs = tuple(sorted(_referenced_ids(ch.get(\"expr\", \"\"))))\n227\t            out.append(channels_mod.Channel(\n228\t                id=ch[\"id\"], name=ch[\"name\"], unit=ch.get(\"unit\", \"\"), kind=\"computed\",\n229\t                bus=\"can_c\", confidence=\"USER-DEFINED\", default_rate_hz=channels_mod.MED_HZ,\n230\t                expr=ch.get(\"expr\", \"\"), depends_on=refs))\n231\t    return out\n232\t\n233\t\n234\t# ===========================================================================\n235\t# snapshots\n236\t# ===========================================================================\n237\t\n238\t_VALID_SOURCES = {\"live\", \"replay\", \"demo\"}\n239\t\n240\t\n241\tdef snapshots_path() -> Path:\n242\t    return state_dir() / \"live_snapshots.jsonl\"\n243\t\n244\t\n245\tdef save_snapshot(layout: str, page: str, source: str, values: dict[str, Any],\n246\t                  note: str = \"\") -> dict[str, Any]:\n247\t    if source not in _VALID_SOURCES:\n248\t        raise BadRequest(f\"source must be one of {sorted(_VALID_SOURCES)}, got {source!r}\")\n249\t    if not isinstance(values, dict):\n250\t        raise BadRequest(\"values must be an object of {channel: {value, unit, ...}}\")\n251\t    for cid, v in values.items():\n252\t        if not isinstance(v, dict) or \"value\" not in v:\n253\t            raise BadRequest(f\"values[{cid!r}] must be an object with at least 'value'\")\n254\t    entry = {\n255\t        \"id\": f\"snap_{datetime.now().strftime('%Y%m%d-%H%M%S')}_{uuid.uuid4().hex[:8]}\",\n256\t        \"at\": datetime.now().isoformat(timespec=\"seconds\"),\n257\t        \"layout\": layout, \"page\": page, \"source\": source, \"values\": values,\n258\t        \"note\": note or \"\",\n259\t    }\n260\t    with _LOCK:\n261\t        with snapshots_path().open(\"a\", encoding=\"utf-8\") as f:\n262\t            f.write(json.dumps(entry) + \"\\n\")\n263\t    return entry\n264\t\n265\t\n266\tdef _read_all_snapshots() -> list[dict[str, Any]]:\n267\t    p = snapshots_path()\n268\t    if not p.exists():\n269\t        return []\n270\t    out = []\n271\t    for line in p.read_text(encoding=\"utf-8\").splitlines():\n272\t        line = line.strip()\n273\t        if not line:\n274\t            continue\n275\t        try:\n276\t            out.append(json.loads(line))\n277\t        except ValueError:\n278\t            continue\n279\t    return out\n280\t\n281\t\n282\tdef list_snapshots(limit: int = 50) -> list[dict[str, Any]]:\n283\t    entries = _read_all_snapshots()\n284\t    return list(reversed(entries))[:limit]\n285\t\n286\t\n287\tdef get_snapshot(snapshot_id: str) -> dict[str, Any]:\n288\t    for e in _read_all_snapshots():\n289\t        if e.get(\"id\") == snapshot_id:\n290\t            return e\n291\t    raise NotFound(f\"no snapshot {snapshot_id!r}\")\n292\t\n293\t\n294\tdef snapshot_csv(entry: dict[str, Any]) -> str:\n295\t    \"\"\"One-row MES-format CSV: names row, units row, one data row, no TAG.\"\"\"\n296\t    values: dict[str, Any] = entry.get(\"values\", {})\n297\t    cids = list(values)\n298\t    names = [\"Time\"] + cids + [\"TAG\"]\n299\t    units = [\"sec\"] + [str(values[c].get(\"unit\", \"\")) for c in cids] + [\" \"]\n300\t    cells = [\"0.000\"]\n301\t    for c in cids:\n302\t        v = values[c].get(\"value\")\n303\t        cells.append(\"\" if v is None else str(v))\n304\t    cells.append(\"\")\n305\t    lines = [\n306\t        \"\\t\".join(f'\"{n}\"' for n in names),\n307\t        \"\\t\".join(f'\"{u}\"' for u in units),\n308\t        \"\\t\".join(cells[:-1] + [f'\"{cells[-1]}\"']),\n309\t    ]\n310\t    return \"\\n\".join(lines) + \"\\n\"\n311\t\n312\t\n313\t# ===========================================================================\n314\t# triggers\n315\t# ===========================================================================\n316\t\n317\t_OPS = {\">\", \"<\", \">=\", \"<=\", \"==\", \"crosses_above\", \"crosses_below\"}\n318\t_ALARM_LEVELS = {\"warn\", \"alarm\"}\n319\t_ACTIONS = {\"record_start\", \"record_stop\", \"snapshot\", \"beep\", \"speak\", \"mark\"}\n320\t\n321\t\n322\tdef triggers_path() -> Path:\n323\t    return state_dir() / \"live_triggers.json\"\n324\t\n325\t\n326\tdef _known_channel_ids() -> set[str]:\n327\t    return set(channels_mod.registry()) | {c[\"id\"] for c in _load_raw()}\n328\t\n329\t\n330\tdef validate_trigger_rule(rule: dict[str, Any]) -> dict[str, Any]:\n331\t    if not isinstance(rule, dict):\n332\t        raise BadRequest(\"each trigger rule must be an object\")\n333\t    rid = rule.get(\"id\")\n334\t    if not isinstance(rid, str) or not rid.strip():\n335\t        raise BadRequest(\"trigger rule id is required\")\n336\t    enabled = rule.get(\"enabled\", True)\n337\t    if not isinstance(enabled, bool):\n338\t        raise BadRequest(f\"trigger {rid!r}: enabled must be a boolean\")\n339\t    when = rule.get(\"when\")\n340\t    if not isinstance(when, dict):\n341\t        raise BadRequest(f\"trigger {rid!r}: when must be an object\")\n342\t    known = _known_channel_ids()\n343\t    if \"op\" in when or \"value\" in when:\n344\t        op = when.get(\"op\")\n345\t        if op not in _OPS:\n346\t            raise BadRequest(f\"trigger {rid!r}: when.op must be one of {sorted(_OPS)}, \"\n347\t                             f\"got {op!r}\")\n348\t        channel = when.get(\"channel\")\n349\t        if not isinstance(channel, str) or channel not in known:\n350\t            raise BadRequest(f\"trigger {rid!r}: when.channel {channel!r} is unknown\")\n351\t        value = when.get(\"value\")\n352\t        if not isinstance(value, (int, float)) or isinstance(value, bool):\n353\t            raise BadRequest(f\"trigger {rid!r}: when.value must be a number\")\n354\t        when_out = {\"channel\": channel, \"op\": op, \"value\": float(value)}\n355\t    elif \"alarm\" in when:\n356\t        level = when.get(\"alarm\")\n357\t        if level not in _ALARM_LEVELS:\n358\t            raise BadRequest(f\"trigger {rid!r}: when.alarm must be one of \"\n359\t                             f\"{sorted(_ALARM_LEVELS)}, got {level!r}\")\n360\t        channel = when.get(\"channel\")\n361\t        if channel is not None and channel not in known:\n362\t            raise BadRequest(f\"trigger {rid!r}: when.channel {channel!r} is unknown\")\n363\t        when_out = {\"alarm\": level}\n364\t        if channel is not None:\n365\t            when_out[\"channel\"] = channel\n366\t    elif \"dtc\" in when:\n367\t        dtc = when.get(\"dtc\")\n368\t        if not isinstance(dtc, str) or not dtc.strip():\n369\t            raise BadRequest(f\"trigger {rid!r}: when.dtc must be a non-empty string \"\n370\t                             \"('any' or a code like 'P0456')\")\n371\t        when_out = {\"dtc\": dtc.strip()}\n372\t    else:\n373\t        raise BadRequest(f\"trigger {rid!r}: when must specify either \"\n374\t                         \"channel/op/value, alarm, or dtc\")\n375\t\n376\t    action = rule.get(\"action\")\n377\t    if action not in _ACTIONS:\n378\t        raise BadRequest(f\"trigger {rid!r}: action must be one of {sorted(_ACTIONS)}, \"\n379\t                         f\"got {action!r}\")\n380\t    cooldown = rule.get(\"cooldown_s\", 0)\n381\t    if not isinstance(cooldown, (int, float)) or isinstance(cooldown, bool) or cooldown < 0:\n382\t        raise BadRequest(f\"trigger {rid!r}: cooldown_s must be a non-negative number\")\n383\t\n384\t    out = {\"id\": rid, \"enabled\": enabled, \"when\": when_out, \"action\": action,\n385\t          \"cooldown_s\": float(cooldown)}\n386\t    text = rule.get(\"text\")\n387\t    if text is not None:\n388\t        if not isinstance(text, str):\n389\t            raise BadRequest(f\"trigger {rid!r}: text must be a string\")\n390\t        out[\"text\"] = text\n391\t    return out\n392\t\n393\t\n394\tdef load_triggers() -> dict[str, Any]:\n395\t    p = triggers_path()\n396\t    if not p.exists():\n397\t        return {\"rules\": []}\n398\t    try:\n399\t        data = json.loads(p.read_text(encoding=\"utf-8\"))\n400\t    except (OSError, ValueError):\n401\t        return {\"rules\": []}\n402\t    return {\"rules\": list(data.get(\"rules\", []))} if isinstance(data, dict) else {\"rules\": []}\n403\t\n404\t\n405\tdef save_triggers(rules: list[dict[str, Any]]) -> dict[str, Any]:\n406\t    if not isinstance(rules, list):\n407\t        raise BadRequest(\"rules must be a list\")\n408\t    seen: set[str] = set()\n409\t    validated = []\n410\t    for r in rules:\n411\t        vr = validate_trigger_rule(r)\n412\t        if vr[\"id\"] in seen:\n413\t            raise BadRequest(f\"duplicate trigger id {vr['id']!r}\")\n414\t        seen.add(vr[\"id\"])\n415\t        validated.append(vr)\n416\t    with _LOCK:\n417\t        triggers_path().write_text(json.dumps({\"rules\": validated}, indent=2),\n418\t                                   encoding=\"utf-8\")\n419\t    return {\"rules\": validated}\n420\t\n421\t\n422\t__all__ = [\"custom_channels_path\", \"load_custom_channels_raw\", \"save_custom_channels\",\n423\t          \"load_custom_channels\", \"snapshots_path\", \"save_snapshot\", \"list_snapshots\",\n424\t          \"get_snapshot\", \"snapshot_csv\", \"triggers_path\", \"load_triggers\", \"save_triggers\",\n425\t          \"validate_custom_channels\", \"validate_trigger_rule\"]\n426\t"}]},"uuid":"e71ba74c-8d17-48c0-aced-0cb883d68ea3","timestamp":"2026-10-14T17:57:52.585Z","toolUseResult":{"type":"text","file":{"filePath":"C:\\Users\\User\\mcp-servers\\cuore\\live\\ui_store.py","content":"\"\"\"Dashboard-UI-only state: custom (Torque-style) channels, snapshots, triggers.\n\nNothing here talks to the adapter. Custom channels are validated against the\nsame safe arithmetic grammar the built-in computed channels use\n(:func:`cuore.live.channels.eval_expr`) so there is still no ``eval()`` in the\nsystem; :func:`load_custom_channels` hands back ordinary\n:class:`~cuore.live.channels.Channel` objects so a future wiring step can fold\nthem into the poller's registry with no special case.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport json\nimport re\nimport threading\nimport uuid\nfrom datetime import datetime\nfrom pathlib import Path\nfrom typing import Any, Optional\n\nfrom ..services.errors import BadRequest, NotFound\nfrom . import channels as channels_mod\nfrom .addressing import by_code\nfrom .config import state_dir\n\n_LOCK = threading.Lock()\n\n_ID_RE = re.compile(r\"^[a-z0-9][a-z0-9_]{0,63}$\")\n_DID_RE = re.compile(r\"^[0-9A-Fa-f]{4}$\")\n\n#: Sample bytes A, B, C, ... used to validate a Torque-style byte formula.\n#: (Arbitrary but fixed and documented, per the task's own example.)\n_SAMPLE_BYTES = [0x12, 0x34, 0x56, 0x78, 0x9A, 0xBC, 0xDE, 0xF0]\n_BYTE_NAMES = \"ABCDEFGH\"\n\n\n# ===========================================================================\n# custom channels\n# ===========================================================================\n\ndef custom_channels_path() -> Path:\n    return state_dir() / \"custom_channels.json\"\n\n\ndef _load_raw() -> list[dict[str, Any]]:\n    p = custom_channels_path()\n    if not p.exists():\n        return []\n    try:\n        data = json.loads(p.read_text(encoding=\"utf-8\"))\n    except (OSError, ValueError):\n        return []\n    return list(data.get(\"channels\", [])) if isinstance(data, dict) else []\n\n\ndef _save_raw(channels: list[dict[str, Any]]) -> None:\n    custom_channels_path().write_text(\n        json.dumps({\"channels\": channels}, indent=2), encoding=\"utf-8\")\n\n\ndef _validate_formula(cid: str, formula: str) -> None:\n    if not isinstance(formula, str) or not formula.strip():\n        raise BadRequest(f\"custom channel {cid!r}: formula is required for kind='did'\")\n    values = {name: float(b) for name, b in zip(_BYTE_NAMES, _SAMPLE_BYTES)}\n    try:\n        channels_mod.eval_expr(formula, values)\n    except channels_mod.ComputedError as exc:\n        raise BadRequest(f\"custom channel {cid!r}: invalid formula {formula!r}: {exc}\") from exc\n\n\n_IDENT_RE = re.compile(r\"[A-Za-z_][A-Za-z0-9_]*\")\n\n\ndef _referenced_ids(expr: str) -> set[str]:\n    \"\"\"Every identifier ``expr`` names -- channel ids it depends on.\n\n    Uses a plain identifier scan rather than the private tokenizer in\n    :mod:`channels`, since all that is needed here is the set of names, not a\n    parse tree; the arithmetic grammar itself is still enforced by\n    :func:`channels.eval_expr` below.\n    \"\"\"\n    return set(_IDENT_RE.findall(expr))\n\n\ndef _validate_computed(cid: str, expr: str, known_ids: set[str]) -> set[str]:\n    if not isinstance(expr, str) or not expr.strip():\n        raise BadRequest(f\"custom channel {cid!r}: expr is required for kind='computed'\")\n    refs = _referenced_ids(expr)\n    unknown = refs - known_ids\n    if unknown:\n        raise BadRequest(f\"custom channel {cid!r}: expr references unknown channel(s) \"\n                         f\"{sorted(unknown)}\")\n    dummy = {r: 1.0 for r in refs}\n    try:\n        channels_mod.eval_expr(expr, dummy)\n    except channels_mod.ComputedError as exc:\n        raise BadRequest(f\"custom channel {cid!r}: invalid expr {expr!r}: {exc}\") from exc\n    return refs\n\n\ndef _check_cycles(deps: dict[str, set[str]]) -> None:\n    \"\"\"Raise :class:`BadRequest` if the computed-channel dependency graph has a cycle.\"\"\"\n    WHITE, GRAY, BLACK = 0, 1, 2\n    color = {cid: WHITE for cid in deps}\n\n    def visit(cid: str, stack: list[str]) -> None:\n        color[cid] = GRAY\n        for dep in deps.get(cid, ()):\n            if dep not in deps:\n                continue  # depends on a registry channel, not another custom one\n            if color.get(dep) == GRAY:\n                cycle = \" -> \".join(stack + [dep])\n                raise BadRequest(f\"custom channels have a cycle: {cycle}\")\n            if color.get(dep) == WHITE:\n                visit(dep, stack + [dep])\n        color[cid] = BLACK\n\n    for cid in deps:\n        if color[cid] == WHITE:\n            visit(cid, [cid])\n\n\ndef validate_custom_channels(raw: list[dict[str, Any]]) -> list[dict[str, Any]]:\n    \"\"\"Validate the whole submitted list at once (ids must be unique, cycle-free).\"\"\"\n    if not isinstance(raw, list):\n        raise BadRequest(\"channels must be a list\")\n    # Built-in ids only -- not the full registry, which (via load_custom_channels)\n    # now includes previously-saved custom channels too. Checking against the\n    # full registry would make re-saving (editing) an existing custom channel\n    # collide with its own earlier self.\n    registry_ids = channels_mod.builtin_channel_ids()\n    seen: set[str] = set()\n\n    # Pass 1: shape/id checks only, so a computed channel may forward-reference\n    # another custom channel defined later in the same submitted list.\n    for ch in raw:\n        if not isinstance(ch, dict):\n            raise BadRequest(\"each custom channel must be an object\")\n        cid = ch.get(\"id\")\n        if not isinstance(cid, str) or not _ID_RE.match(cid):\n            raise BadRequest(f\"custom channel id must match {_ID_RE.pattern!r}, got {cid!r}\")\n        if cid in seen:\n            raise BadRequest(f\"duplicate custom channel id {cid!r}\")\n        if cid in registry_ids:\n            raise BadRequest(f\"custom channel id {cid!r} collides with a built-in channel\")\n        seen.add(cid)\n        name = ch.get(\"name\")\n        if not isinstance(name, str) or not name.strip():\n            raise BadRequest(f\"custom channel {cid!r}: name is required\")\n        unit = ch.get(\"unit\", \"\")\n        if not isinstance(unit, str):\n            raise BadRequest(f\"custom channel {cid!r}: unit must be a string\")\n        kind = ch.get(\"kind\")\n        if kind not in (\"did\", \"computed\"):\n            raise BadRequest(f\"custom channel {cid!r}: kind must be 'did' or 'computed', \"\n                             f\"got {kind!r}\")\n\n    known_ids = registry_ids | seen\n\n    # Pass 2: per-kind validation, now that every id in this submission is known.\n    out: list[dict[str, Any]] = []\n    deps: dict[str, set[str]] = {}\n    for ch in raw:\n        cid = ch[\"id\"]\n        entry: dict[str, Any] = {\"id\": cid, \"name\": ch[\"name\"], \"unit\": ch.get(\"unit\", \"\"),\n                                 \"kind\": ch[\"kind\"]}\n        if ch[\"kind\"] == \"did\":\n            module = ch.get(\"module\")\n            ecu = by_code(module.upper()) if isinstance(module, str) else None\n            if ecu is None:\n                raise BadRequest(f\"custom channel {cid!r}: unknown module {module!r}\")\n            if ecu.bus_key != \"can_c\":\n                raise BadRequest(f\"custom channel {cid!r}: module {module!r} is on bus \"\n                                 f\"{ecu.bus_key!r}; the live-data poller currently serves \"\n                                 f\"can_c channels only\")\n            did = ch.get(\"did\")\n            if not isinstance(did, str) or not _DID_RE.match(did):\n                raise BadRequest(f\"custom channel {cid!r}: did must be 4 hex digits, \"\n                                 f\"got {did!r}\")\n            formula = ch.get(\"formula\", \"\")\n            _validate_formula(cid, formula)\n            entry.update({\"module\": module.upper(), \"did\": did.upper(), \"formula\": formula})\n        else:\n            expr = ch.get(\"expr\", \"\")\n            refs = _validate_computed(cid, expr, known_ids)\n            entry[\"expr\"] = expr\n            deps[cid] = refs\n        out.append(entry)\n\n    _check_cycles(deps)\n    return out\n\n\ndef load_custom_channels_raw() -> dict[str, Any]:\n    return {\"channels\": _load_raw()}\n\n\ndef save_custom_channels(raw: list[dict[str, Any]]) -> dict[str, Any]:\n    validated = validate_custom_channels(raw)\n    with _LOCK:\n        _save_raw(validated)\n    channels_mod.invalidate_registry()\n    return {\"channels\": validated}\n\n\ndef load_custom_channels() -> list[channels_mod.Channel]:\n    \"\"\"User-defined channels as ordinary :class:`Channel` objects.\n\n    Marked ``confidence=\"USER-DEFINED\"`` so the registry can tell them apart\n    from anything catalogued from the vehicle. Not wired into\n    :func:`channels.registry` here -- that integration belongs to whoever owns\n    the poller/registry wiring; this function only hands back well-formed\n    objects for that step.\n    \"\"\"\n    out: list[channels_mod.Channel] = []\n    for ch in _load_raw():\n        if ch.get(\"kind\") == \"did\":\n            out.append(channels_mod.Channel(\n                id=ch[\"id\"], name=ch[\"name\"], unit=ch.get(\"unit\", \"\"), kind=\"did\",\n                bus=\"can_c\", confidence=\"USER-DEFINED\", default_rate_hz=channels_mod.MED_HZ,\n                module=ch.get(\"module\", \"\"), did=int(ch.get(\"did\", \"0\"), 16),\n                formula=ch.get(\"formula\", \"\"),\n                note=\"Torque-style byte algebra: A, B, C... map to successive \"\n                     \"response bytes\"))\n        else:\n            refs = tuple(sorted(_referenced_ids(ch.get(\"expr\", \"\"))))\n            out.append(channels_mod.Channel(\n                id=ch[\"id\"], name=ch[\"name\"], unit=ch.get(\"unit\", \"\"), kind=\"computed\",\n                bus=\"can_c\", confidence=\"USER-DEFINED\", default_rate_hz=channels_mod.MED_HZ,\n                expr=ch.get(\"expr\", \"\"), depends_on=refs))\n    return out\n\n\n# ===========================================================================\n# snapshots\n# ===========================================================================\n\n_VALID_SOURCES = {\"live\", \"replay\", \"demo\"}\n\n\ndef snapshots_path() -> Path:\n    return state_dir() / \"live_snapshots.jsonl\"\n\n\ndef save_snapshot(layout: str, page: str, source: str, values: dict[str, Any],\n                  note: str = \"\") -> dict[str, Any]:\n    if source not in _VALID_SOURCES:\n        raise BadRequest(f\"source must be one of {sorted(_VALID_SOURCES)}, got {source!r}\")\n    if not isinstance(values, dict):\n        raise BadRequest(\"values must be an object of {channel: {value, unit, ...}}\")\n    for cid, v in values.items():\n        if not isinstance(v, dict) or \"value\" not in v:\n            raise BadRequest(f\"values[{cid!r}] must be an object with at least 'value'\")\n    entry = {\n        \"id\": f\"snap_{datetime.now().strftime('%Y%m%d-%H%M%S')}_{uuid.uuid4().hex[:8]}\",\n        \"at\": datetime.now().isoformat(timespec=\"seconds\"),\n        \"layout\": layout, \"page\": page, \"source\": source, \"values\": values,\n        \"note\": note or \"\",\n    }\n    with _LOCK:\n        with snapshots_path().open(\"a\", encoding=\"utf-8\") as f:\n            f.write(json.dumps(entry) + \"\\n\")\n    return entry\n\n\ndef _read_all_snapshots() -> list[dict[str, Any]]:\n    p = snapshots_path()\n    if not p.exists():\n        return []\n    out = []\n    for line in p.read_text(encoding=\"utf-8\").splitlines():\n        line = line.strip()\n        if not line:\n            continue\n        try:\n            out.append(json.loads(line))\n        except ValueError:\n            continue\n    return out\n\n\ndef list_snapshots(limit: int = 50) -> list[dict[str, Any]]:\n    entries = _read_all_snapshots()\n    return list(reversed(entries))[:limit]\n\n\ndef get_snapshot(snapshot_id: str) -> dict[str, Any]:\n    for e in _read_all_snapshots():\n        if e.get(\"id\") == snapshot_id:\n            return e\n    raise NotFound(f\"no snapshot {snapshot_id!r}\")\n\n\ndef snapshot_csv(entry: dict[str, Any]) -> str:\n    \"\"\"One-row MES-format CSV: names row, units row, one data row, no TAG.\"\"\"\n    values: dict[str, Any] = entry.get(\"values\", {})\n    cids = list(values)\n    names = [\"Time\"] + cids + [\"TAG\"]\n    units = [\"sec\"] + [str(values[c].get(\"unit\", \"\")) for c in cids] + [\" \"]\n    cells = [\"0.000\"]\n    for c in cids:\n        v = values[c].get(\"value\")\n        cells.append(\"\" if v is None else str(v))\n    cells.append(\"\")\n    lines = [\n        \"\\t\".join(f'\"{n}\"' for n in names),\n        \"\\t\".join(f'\"{u}\"' for u in units),\n        \"\\t\".join(cells[:-1] + [f'\"{cells[-1]}\"']),\n    ]\n    return \"\\n\".join(lines) + \"\\n\"\n\n\n# ===========================================================================\n# triggers\n# ===========================================================================\n\n_OPS = {\">\", \"<\", \">=\", \"<=\", \"==\", \"crosses_above\", \"crosses_below\"}\n_ALARM_LEVELS = {\"warn\", \"alarm\"}\n_ACTIONS = {\"record_start\", \"record_stop\", \"snapshot\", \"beep\", \"speak\", \"mark\"}\n\n\ndef triggers_path() -> Path:\n    return state_dir() / \"live_triggers.json\"\n\n\ndef _known_channel_ids() -> set[str]:\n    return set(channels_mod.registry()) | {c[\"id\"] for c in _load_raw()}\n\n\ndef validate_trigger_rule(rule: dict[str, Any]) -> dict[str, Any]:\n    if not isinstance(rule, dict):\n        raise BadRequest(\"each trigger rule must be an object\")\n    rid = rule.get(\"id\")\n    if not isinstance(rid, str) or not rid.strip():\n        raise BadRequest(\"trigger rule id is required\")\n    enabled = rule.get(\"enabled\", True)\n    if not isinstance(enabled, bool):\n        raise BadRequest(f\"trigger {rid!r}: enabled must be a boolean\")\n    when = rule.get(\"when\")\n    if not isinstance(when, dict):\n        raise BadRequest(f\"trigger {rid!r}: when must be an object\")\n    known = _known_channel_ids()\n    if \"op\" in when or \"value\" in when:\n        op = when.get(\"op\")\n        if op not in _OPS:\n            raise BadRequest(f\"trigger {rid!r}: when.op must be one of {sorted(_OPS)}, \"\n                             f\"got {op!r}\")\n        channel = when.get(\"channel\")\n        if not isinstance(channel, str) or channel not in known:\n            raise BadRequest(f\"trigger {rid!r}: when.channel {channel!r} is unknown\")\n        value = when.get(\"value\")\n        if not isinstance(value, (int, float)) or isinstance(value, bool):\n            raise BadRequest(f\"trigger {rid!r}: when.value must be a number\")\n        when_out = {\"channel\": channel, \"op\": op, \"value\": float(value)}\n    elif \"alarm\" in when:\n        level = when.get(\"alarm\")\n        if level not in _ALARM_LEVELS:\n            raise BadRequest(f\"trigger {rid!r}: when.alarm must be one of \"\n                             f\"{sorted(_ALARM_LEVELS)}, got {level!r}\")\n        channel = when.get(\"channel\")\n        if channel is not None and channel not in known:\n            raise BadRequest(f\"trigger {rid!r}: when.channel {channel!r} is unknown\")\n        when_out = {\"alarm\": level}\n        if channel is not None:\n            when_out[\"channel\"] = channel\n    elif \"dtc\" in when:\n        dtc = when.get(\"dtc\")\n        if not isinstance(dtc, str) or not dtc.strip():\n            raise BadRequest(f\"trigger {rid!r}: when.dtc must be a non-empty string \"\n                             \"('any' or a code like 'P0456')\")\n        when_out = {\"dtc\": dtc.strip()}\n    else:\n        raise BadRequest(f\"trigger {rid!r}: when must specify either \"\n                         \"channel/op/value, alarm, or dtc\")\n\n    action = rule.get(\"action\")\n    if action not in _ACTIONS:\n        raise BadRequest(f\"trigger {rid!r}: action must be one of {sorted(_ACTIONS)}, \"\n                         f\"got {action!r}\")\n    cooldown = rule.get(\"cooldown_s\", 0)\n    if not isinstance(cooldown, (int, float)) or isinstance(cooldown, bool) or cooldown < 0:\n        raise BadRequest(f\"trigger {rid!r}: cooldown_s must be a non-negative number\")\n\n    out = {\"id\": rid, \"enabled\": enabled, \"when\": when_out, \"action\": action,\n          \"cooldown_s\": float(cooldown)}\n    text = rule.get(\"text\")\n    if text is not None:\n        if not isinstance(text, str):\n            raise BadRequest(f\"trigger {rid!r}: text must be a string\")\n        out[\"text\"] = text\n    return out\n\n\ndef load_triggers() -> dict[str, Any]:\n    p = triggers_path()\n    if not p.exists():\n        return {\"rules\": []}\n    try:\n        data = json.loads(p.read_text(encoding=\"utf-8\"))\n    except (OSError, ValueError):\n        return {\"rules\": []}\n    return {\"rules\": list(data.get(\"rules\", []))} if isinstance(data, dict) else {\"rules\": []}\n\n\ndef save_triggers(rules: list[dict[str, Any]]) -> dict[str, Any]:\n    if not isinstance(rules, list):\n        raise BadRequest(\"rules must be a list\")\n    seen: set[str] = set()\n    validated = []\n    for r in rules:\n        vr = validate_trigger_rule(r)\n        if vr[\"id\"] in seen:\n            raise BadRequest(f\"duplicate trigger id {vr['id']!r}\")\n        seen.add(vr[\"id\"])\n        validated.append(vr)\n    with _LOCK:\n        triggers_path().write_text(json.dumps({\"rules\": validated}, indent=2),\n                                   encoding=\"utf-8\")\n    return {\"rules\": validated}\n\n\n__all__ = [\"custom_channels_path\", \"load_custom_channels_raw\", \"save_custom_channels\",\n          \"load_custom_channels\", \"snapshots_path\", \"save_snapshot\", \"list_snapshots\",\n          \"get_snapshot\", \"snapshot_csv\", \"triggers_path\", \"load_triggers\", \"save_triggers\",\n          \"validate_custom_channels\", \"validate_trigger_rule\"]\n","numLines":426,"startLine":1,"totalLines":426}},"sourceToolAssistantUUID":"21ac68ed-f16d-43d7-8889-402c8e588b39","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
