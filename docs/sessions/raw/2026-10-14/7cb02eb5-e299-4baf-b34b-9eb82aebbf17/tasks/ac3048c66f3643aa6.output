{"parentUuid":"cefa214a-210f-4a1d-b0e2-03caa391e53f","isSidechain":true,"agentId":"ac3048c66f3643aa6","message":{"model":"claude-sonnet-5","id":"msg_011Cg2ZYoAL8JmcYAJ3fBprt","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01HFKrcykwBuzVELZzuEiio9","name":"Read","input":{"file_path":"C:\\Users\\User\\mcp-servers\\cuore\\live\\learn.py"},"caller":{"type":"direct"}}],"container":null,"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":4620,"cache_read_input_tokens":67805,"output_tokens":231,"output_tokens_details":{"thinking_tokens":158},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":0,"ephemeral_5m_input_tokens":4620},"inference_geo":"global","iterations":[{"input_tokens":2,"output_tokens":231,"cache_read_input_tokens":67805,"cache_creation_input_tokens":4620,"cache_creation":{"ephemeral_5m_input_tokens":4620,"ephemeral_1h_input_tokens":0},"type":"message"}],"speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_01HFKrcykwBuzVELZzuEiio9":{"file_path":"C:\\Users\\User\\mcp-servers\\cuore\\live\\learn.py"}},"serverClassifierRequest":"cf37016c-2935-4062-b36b-b867d8554862","apiBlockIndex":1,"requestId":"req_011Cg2ZYntTVvgg46XCKo6RL","attributionAgent":"general-purpose","type":"assistant","uuid":"bb8d41d5-7694-465a-9aad-5728217cd898","timestamp":"2026-10-14T17:57:21.663Z","effort":"high","perTurnEffort":null,"userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
{"parentUuid":"bb8d41d5-7694-465a-9aad-5728217cd898","isSidechain":true,"promptId":"f5371174-bba0-4992-a14b-d71ea13c02eb","agentId":"ac3048c66f3643aa6","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01HFKrcykwBuzVELZzuEiio9","type":"tool_result","content":"1\t\"\"\"Reconstruct what wiTECH asked and heard, from a passive capture alone.\n2\t\n3\tNothing here talks to the adapter. Given the frame list :func:`capture.listen`\n4\talready returns (``[{\"t\", \"id\", \"data\"}]`` with headers on, ``data`` the\n5\tconcatenated hex bytes of one raw CAN frame -- see :mod:`framing`), this\n6\tmodule rebuilds the ISO-TP messages, pairs UDS requests with responses,\n7\tgroups per-(target, DID) time series, and correlates those series against\n8\twhat a technician noted on wiTECH's own data display.\n9\t\n10\tAddressing is generic 29-bit physical, per :mod:`addressing`: a request is\n11\t``18DA<TA><SA>`` and its response is the same two bytes swapped,\n12\t``18DA<SA><TA>``. The tester byte is whatever wiTECH used -- never assumed to\n13\tbe ``F1``.\n14\t\n15\tPure functions, stdlib only.\n16\t\"\"\"\n17\t\n18\tfrom __future__ import annotations\n19\t\n20\timport re\n21\tfrom collections import Counter, defaultdict\n22\tfrom typing import Any, Optional\n23\t\n24\t_ID_RE = re.compile(r\"^18DA([0-9A-F]{2})([0-9A-F]{2})$\")\n25\t\n26\t#: UDS service IDs that appear on the *request* side. A response is either\n27\t#: ``0x7F`` (negative) or ``request + 0x40`` (positive) -- this is what lets\n28\t#: pairing work without knowing in advance which byte is the tester.\n29\tREQUEST_SERVICES: frozenset[int] = frozenset({\n30\t    0x10, 0x11, 0x14, 0x19, 0x1A, 0x22, 0x23, 0x24, 0x27, 0x28, 0x29, 0x2A,\n31\t    0x2C, 0x2E, 0x2F, 0x31, 0x34, 0x35, 0x36, 0x37, 0x38, 0x3D, 0x3E, 0x85,\n32\t})\n33\t\n34\t#: Services this module decodes DIDs for. Everything else is paired and kept\n35\t#: raw, per the spec (\"only read services decoded\").\n36\t_READ_SERVICES: frozenset[int] = frozenset({0x22, 0x2E})\n37\t\n38\t\n39\t# ===========================================================================\n40\t# ISO-TP reassembly\n41\t# ===========================================================================\n42\t\n43\tdef isotp_reassemble(frames: list[dict[str, Any]]) -> dict[str, Any]:\n44\t    \"\"\"Rebuild ISO-TP messages per CAN ID from raw ``capture.listen`` frames.\n45\t\n46\t    PCI types: ``0N`` single frame of N bytes, ``1N NN`` first frame with a\n47\t    12-bit length, ``2N`` consecutive frame (sequence number ignored --\n48\t    passive capture cannot lose frames the way a live bus can drop them, and\n49\t    nothing here needs to detect that), ``3N`` flow control (ignored: this\n50\t    tool never transmits and flow control from the real tester is not a\n51\t    payload). Interleaved IDs are tracked independently: one pending\n52\t    assembly per CAN ID.\n53\t\n54\t    A new single/first frame that arrives while an assembly for that ID is\n55\t    still incomplete drops the old one (counted). Anything still incomplete\n56\t    when the frame list ends is dropped the same way.\n57\t\n58\t    Returns ``{\"messages\": [{\"t\", \"id\", \"data\"}, ...], \"dropped\": int}``,\n59\t    messages sorted by ``t``. ``data`` is a list of hex byte strings.\n60\t    \"\"\"\n61\t    pending: dict[str, dict[str, Any]] = {}\n62\t    messages: list[dict[str, Any]] = []\n63\t    dropped = 0\n64\t\n65\t    for f in sorted(frames, key=lambda x: x[\"t\"]):\n66\t        hdr = f[\"id\"]\n67\t        raw = str(f.get(\"data\") or \"\")\n68\t        if len(raw) < 2:\n69\t            continue\n70\t        b = [raw[i:i + 2] for i in range(0, len(raw) - 1, 2)]\n71\t        if not b:\n72\t            continue\n73\t        pci = int(b[0], 16)\n74\t        ftype = pci >> 4\n75\t\n76\t        if ftype == 0:\n77\t            if hdr in pending:\n78\t                dropped += 1\n79\t                del pending[hdr]\n80\t            n = pci & 0x0F\n81\t            data = b[1:1 + n] if n else b[1:]\n82\t            messages.append({\"t\": f[\"t\"], \"id\": hdr, \"data\": data})\n83\t        elif ftype == 1:\n84\t            if len(b) < 2:\n85\t                continue\n86\t            if hdr in pending:\n87\t                dropped += 1\n88\t            expected = ((pci & 0x0F) << 8) | int(b[1], 16)\n89\t            pending[hdr] = {\"expected\": expected, \"data\": list(b[2:]), \"t\": f[\"t\"]}\n90\t        elif ftype == 2:\n91\t            st = pending.get(hdr)\n92\t            if st is None:\n93\t                continue  # orphan consecutive frame, no first frame seen -- ignore\n94\t            st[\"data\"].extend(b[1:])\n95\t            if len(st[\"data\"]) >= st[\"expected\"]:\n96\t                messages.append({\"t\": st[\"t\"], \"id\": hdr, \"data\": st[\"data\"][:st[\"expected\"]]})\n97\t                del pending[hdr]\n98\t        else:\n99\t            continue  # flow control (3N) or reserved -- never a payload\n100\t\n101\t    dropped += len(pending)\n102\t    messages.sort(key=lambda m: m[\"t\"])\n103\t    return {\"messages\": messages, \"dropped\": dropped}\n104\t\n105\t\n106\t# ===========================================================================\n107\t# UDS request/response pairing\n108\t# ===========================================================================\n109\t\n110\tdef _split_multi_did(payload: list[str], dids: list[int]\n111\t                     ) -> Optional[list[tuple[int, list[str]]]]:\n112\t    \"\"\"Split a multi-DID ``0x22`` response into ``[(did, data), ...]``.\n113\t\n114\t    Data lengths are unknown, so every way of cutting the response so that\n115\t    each DID's two echoed bytes land exactly where expected is tried. The\n116\t    split is used only when it is unique; more than one valid cut (or none)\n117\t    means the boundary is genuinely ambiguous from this data alone.\n118\t    \"\"\"\n119\t    did_hex = [f\"{d:04X}\" for d in dids]\n120\t    n = len(payload)\n121\t    results: list[list[tuple[int, list[str]]]] = []\n122\t\n123\t    def rec(pos: int, idx: int, acc: list[tuple[int, list[str]]]) -> None:\n124\t        if len(results) > 1:\n125\t            return\n126\t        if idx == len(dids):\n127\t            if pos == n:\n128\t                results.append(list(acc))\n129\t            return\n130\t        if pos + 2 > n or payload[pos] + payload[pos + 1] != did_hex[idx]:\n131\t            return\n132\t        min_remaining = 2 * (len(dids) - idx - 1)\n133\t        max_data_len = n - (pos + 2) - min_remaining\n134\t        for dl in range(0, max(0, max_data_len) + 1):\n135\t            rec(pos + 2 + dl, idx + 1, acc + [(dids[idx], payload[pos + 2:pos + 2 + dl])])\n136\t            if len(results) > 1:\n137\t                return\n138\t\n139\t    rec(0, 0, [])\n140\t    return results[0] if len(results) == 1 else None\n141\t\n142\t\n143\tdef _decode_read(tr: dict[str, Any], req_data: list[str], resp_data: list[str],\n144\t                 svc: int) -> None:\n145\t    if svc == 0x22:\n146\t        req_payload = req_data[1:]\n147\t        dids = [int(req_payload[k] + req_payload[k + 1], 16)\n148\t                for k in range(0, len(req_payload) - 1, 2)]\n149\t        resp_payload = resp_data[1:]\n150\t        if len(dids) == 1:\n151\t            dh = f\"{dids[0]:04X}\"\n152\t            tr[\"did\"] = dh\n153\t            if len(resp_payload) >= 2 and resp_payload[0] + resp_payload[1] == dh:\n154\t                tr[\"data\"] = resp_payload[2:]\n155\t            else:\n156\t                tr[\"data\"] = resp_payload  # DID not echoed as expected -- keep raw\n157\t        elif len(dids) > 1:\n158\t            split = _split_multi_did(resp_payload, dids)\n159\t            if split is not None:\n160\t                tr[\"dids\"] = [{\"did\": f\"{d:04X}\", \"data\": data} for d, data in split]\n161\t            else:\n162\t                tr[\"multi_did_raw\"] = True\n163\t    elif svc == 0x2E:\n164\t        # WriteDataByIdentifier: the DID and the written value are in the\n165\t        # *request*; the response only echoes the DID.\n166\t        req_payload = req_data[1:]\n167\t        if len(req_payload) >= 2:\n168\t            tr[\"did\"] = req_payload[0] + req_payload[1]\n169\t            tr[\"data\"] = req_payload[2:]\n170\t\n171\t\n172\tdef uds_transactions(frames: list[dict[str, Any]]) -> list[dict[str, Any]]:\n173\t    \"\"\"Pair UDS requests with responses, in time order.\n174\t\n175\t    Each transaction: ``{t_req, t_resp, target, tester, service, request,\n176\t    response, nrc, did, data, dids, multi_did_raw}``. ``target``/``tester``\n177\t    are hex byte strings (``\"10\"``, ``\"F1\"``); ``did``/``data`` are set for a\n178\t    single-DID ``0x22``/``0x2E``; ``dids`` is a list of ``{\"did\",\"data\"}``\n179\t    when a multi-DID ``0x22`` request could be split unambiguously;\n180\t    ``multi_did_raw`` is ``True`` when it could not be. A request with no\n181\t    matching response has ``t_resp``/``response`` as ``None``.\n182\t    \"\"\"\n183\t    msgs = isotp_reassemble(frames)[\"messages\"]\n184\t    used = [False] * len(msgs)\n185\t    out: list[dict[str, Any]] = []\n186\t\n187\t    for i, m in enumerate(msgs):\n188\t        if used[i] or not m[\"data\"]:\n189\t            continue\n190\t        mo = _ID_RE.match(m[\"id\"])\n191\t        if not mo:\n192\t            continue\n193\t        svc = int(m[\"data\"][0], 16)\n194\t        if svc not in REQUEST_SERVICES:\n195\t            continue\n196\t        ta, sa = mo.group(1), mo.group(2)\n197\t        resp_id = f\"18DA{sa}{ta}\"\n198\t\n199\t        match_idx = None\n200\t        for j in range(i + 1, len(msgs)):\n201\t            if used[j] or msgs[j][\"id\"] != resp_id or not msgs[j][\"data\"]:\n202\t                continue\n203\t            rb = int(msgs[j][\"data\"][0], 16)\n204\t            if rb == 0x7F and len(msgs[j][\"data\"]) >= 2 and int(msgs[j][\"data\"][1], 16) == svc:\n205\t                match_idx = j\n206\t                break\n207\t            if rb == (svc + 0x40) & 0xFF:\n208\t                match_idx = j\n209\t                break\n210\t\n211\t        tr: dict[str, Any] = {\n212\t            \"t_req\": m[\"t\"], \"t_resp\": None, \"target\": ta, \"tester\": sa,\n213\t            \"service\": f\"{svc:02X}\", \"request\": m[\"data\"], \"response\": None,\n214\t            \"nrc\": None, \"did\": None, \"data\": None, \"dids\": None,\n215\t            \"multi_did_raw\": False,\n216\t        }\n217\t        used[i] = True\n218\t        if match_idx is not None:\n219\t            used[match_idx] = True\n220\t            m2 = msgs[match_idx]\n221\t            tr[\"t_resp\"] = m2[\"t\"]\n222\t            tr[\"response\"] = m2[\"data\"]\n223\t            if int(m2[\"data\"][0], 16) == 0x7F:\n224\t                tr[\"nrc\"] = m2[\"data\"][2] if len(m2[\"data\"]) >= 3 else None\n225\t            elif svc in _READ_SERVICES:\n226\t                _decode_read(tr, m[\"data\"], m2[\"data\"], svc)\n227\t        out.append(tr)\n228\t\n229\t    out.sort(key=lambda t: t[\"t_req\"])\n230\t    return out\n231\t\n232\t\n233\t# ===========================================================================\n234\t# Per-DID time series\n235\t# ===========================================================================\n236\t\n237\tdef did_series(transactions: list[dict[str, Any]]) -> dict[tuple[str, str], list[dict[str, Any]]]:\n238\t    \"\"\"``{(target, did): [{\"t\", \"bytes\"}, ...]}`` in time order.\n239\t\n240\t    ``target``/``did`` are hex strings (``\"10\"``, ``\"1234\"``). Both\n241\t    single-DID transactions and the individually-split entries of an\n242\t    unambiguous multi-DID transaction contribute.\n243\t    \"\"\"\n244\t    series: dict[tuple[str, str], list[dict[str, Any]]] = defaultdict(list)\n245\t    for tr in sorted(transactions, key=lambda t: t[\"t_req\"]):\n246\t        t = tr[\"t_resp\"] if tr[\"t_resp\"] is not None else tr[\"t_req\"]\n247\t        if tr.get(\"did\") and tr.get(\"data\") is not None:\n248\t            series[(tr[\"target\"], tr[\"did\"])].append({\"t\": t, \"bytes\": tr[\"data\"]})\n249\t        for entry in (tr.get(\"dids\") or []):\n250\t            series[(tr[\"target\"], entry[\"did\"])].append({\"t\": t, \"bytes\": entry[\"data\"]})\n251\t    for pts in series.values():\n252\t        pts.sort(key=lambda p: p[\"t\"])\n253\t    return dict(series)\n254\t\n255\t\n256\t# ===========================================================================\n257\t# Correlation against technician marks\n258\t# ===========================================================================\n259\t\n260\tdef _nearest(pts: list[dict[str, Any]], t: float) -> Optional[dict[str, Any]]:\n261\t    if not pts:\n262\t        return None\n263\t    return min(pts, key=lambda p: abs(p[\"t\"] - t))\n264\t\n265\t\n266\tdef _consistency(samples: list[tuple[Any, int]]) -> float:\n267\t    \"\"\"1.0 when every label value maps to exactly one raw value and every\n268\t    label value maps to a *different* raw value; a partial score otherwise\n269\t    (the fraction of samples matching the modal raw value for their label).\"\"\"\n270\t    by_value: dict[Any, list[int]] = defaultdict(list)\n271\t    for lv, rv in samples:\n272\t        by_value[lv].append(rv)\n273\t    if len(by_value) < 2:\n274\t        return 0.0\n275\t    consistent = all(len(set(rvs)) == 1 for rvs in by_value.values())\n276\t    if consistent:\n277\t        reps = [rvs[0] for rvs in by_value.values()]\n278\t        if len(set(reps)) == len(reps):\n279\t            return 1.0\n280\t        return 0.6  # discriminates nothing -- same raw value regardless of label\n281\t    total = len(samples)\n282\t    correct = sum(Counter(rvs).most_common(1)[0][1] for rvs in by_value.values())\n283\t    return correct / total if total else 0.0\n284\t\n285\t\n286\tdef _categorical_candidates(target: str, did: str, label: str, pts: list[dict[str, Any]],\n287\t                            marks: list[dict[str, Any]], max_len: int) -> list[dict[str, Any]]:\n288\t    cands: list[dict[str, Any]] = []\n289\t    for off in range(max_len):\n290\t        samples: list[tuple[Any, int]] = []\n291\t        ok = True\n292\t        for mk in marks:\n293\t            p = _nearest(pts, mk[\"t\"])\n294\t            if p is None or off >= len(p[\"bytes\"]):\n295\t                ok = False\n296\t                break\n297\t            samples.append((mk[\"value\"], int(p[\"bytes\"][off], 16)))\n298\t        if not ok:\n299\t            continue\n300\t        ev = [{\"t\": mk[\"t\"], \"value\": mk[\"value\"], \"raw\": rv}\n301\t              for mk, (_, rv) in zip(marks, samples)]\n302\t        cands.append({\"target\": target, \"did\": did, \"label\": label, \"kind\": \"categorical\",\n303\t                      \"field\": {\"offset\": off, \"width\": \"byte\"},\n304\t                      \"score\": _consistency(samples), \"evidence\": ev})\n305\t        for bit in range(8):\n306\t            bit_samples = [(lv, (rv >> bit) & 1) for lv, rv in samples]\n307\t            bev = [{\"t\": mk[\"t\"], \"value\": mk[\"value\"], \"raw\": rv}\n308\t                   for mk, (_, rv) in zip(marks, bit_samples)]\n309\t            cands.append({\"target\": target, \"did\": did, \"label\": label, \"kind\": \"categorical\",\n310\t                          \"field\": {\"offset\": off, \"bit\": bit},\n311\t                          \"score\": _consistency(bit_samples), \"evidence\": bev})\n312\t    for off in range(max_len - 1):\n313\t        samples = []\n314\t        ok = True\n315\t        for mk in marks:\n316\t            p = _nearest(pts, mk[\"t\"])\n317\t            if p is None or off + 1 >= len(p[\"bytes\"]):\n318\t                ok = False\n319\t                break\n320\t            v = (int(p[\"bytes\"][off], 16) << 8) | int(p[\"bytes\"][off + 1], 16)\n321\t            samples.append((mk[\"value\"], v))\n322\t        if not ok:\n323\t            continue\n324\t        ev = [{\"t\": mk[\"t\"], \"value\": mk[\"value\"], \"raw\": rv}\n325\t              for mk, (_, rv) in zip(marks, samples)]\n326\t        cands.append({\"target\": target, \"did\": did, \"label\": label, \"kind\": \"categorical\",\n327\t                      \"field\": {\"offset\": off, \"width\": \"u16\"},\n328\t                      \"score\": _consistency(samples), \"evidence\": ev})\n329\t    return cands\n330\t\n331\t\n332\tdef _linreg(xs: list[float], ys: list[float]) -> tuple[float, float, float]:\n333\t    n = len(xs)\n334\t    mx, my = sum(xs) / n, sum(ys) / n\n335\t    sxx = sum((x - mx) ** 2 for x in xs)\n336\t    if sxx == 0:\n337\t        return 0.0, my, 0.0\n338\t    scale = sum((x - mx) * (y - my) for x, y in zip(xs, ys)) / sxx\n339\t    offset = my - scale * mx\n340\t    ss_res = sum((y - (scale * x + offset)) ** 2 for x, y in zip(xs, ys))\n341\t    ss_tot = sum((y - my) ** 2 for y in ys)\n342\t    if ss_tot == 0:\n343\t        return scale, offset, 1.0 if ss_res == 0 else 0.0\n344\t    return scale, offset, 1 - ss_res / ss_tot\n345\t\n346\t\n347\tdef _numeric_candidates(target: str, did: str, label: str, pts: list[dict[str, Any]],\n348\t                        marks: list[dict[str, Any]], max_len: int) -> list[dict[str, Any]]:\n349\t    cands: list[dict[str, Any]] = []\n350\t    fields = [(\"byte\", off, 1) for off in range(max_len)]\n351\t    fields += [(\"u16\", off, 2) for off in range(max_len - 1)]\n352\t    for kind, off, width in fields:\n353\t        xs: list[float] = []\n354\t        ys: list[float] = []\n355\t        ev: list[dict[str, Any]] = []\n356\t        ok = True\n357\t        for mk in marks:\n358\t            p = _nearest(pts, mk[\"t\"])\n359\t            if p is None or off + width > len(p[\"bytes\"]):\n360\t                ok = False\n361\t                break\n362\t            raw = (int(p[\"bytes\"][off], 16) if width == 1 else\n363\t                   (int(p[\"bytes\"][off], 16) << 8) | int(p[\"bytes\"][off + 1], 16))\n364\t            xs.append(raw)\n365\t            ys.append(mk[\"value\"])\n366\t            ev.append({\"t\": mk[\"t\"], \"value\": mk[\"value\"], \"raw\": raw})\n367\t        if not ok or len(set(xs)) < 2:\n368\t            continue\n369\t        scale, offset, r2 = _linreg(xs, ys)\n370\t        cands.append({\"target\": target, \"did\": did, \"label\": label, \"kind\": \"numeric\",\n371\t                      \"field\": {\"offset\": off, \"width\": kind},\n372\t                      \"scale\": scale, \"offset\": offset, \"score\": r2, \"r2\": r2,\n373\t                      \"evidence\": ev})\n374\t    return cands\n375\t\n376\t\n377\tdef correlate(series: dict[tuple[str, str], list[dict[str, Any]]],\n378\t             marks: list[dict[str, Any]]) -> list[dict[str, Any]]:\n379\t    \"\"\"Rank (target, did, field) candidates against technician-noted marks.\n380\t\n381\t    ``marks``: ``[{\"t\", \"label\", \"value\"}, ...]``. Marks are grouped by\n382\t    ``label``; string values are treated categorically (every byte, every\n383\t    bit within a byte, and every 16-bit big-endian field are checked for a\n384\t    value that is the same whenever the label value repeats and different\n385\t    whenever it changes); numeric values get a linear least-squares fit\n386\t    (``value = scale*raw + offset``) over 1- and 2-byte fields, scored by\n387\t    R². Returns candidates sorted by score descending, each carrying its\n388\t    evidence (the raw byte(s) read back at each mark's nearest sample).\n389\t    \"\"\"\n390\t    by_label: dict[str, list[dict[str, Any]]] = defaultdict(list)\n391\t    for m in marks:\n392\t        by_label[m[\"label\"]].append(m)\n393\t\n394\t    out: list[dict[str, Any]] = []\n395\t    for label, mks in by_label.items():\n396\t        numeric = all(isinstance(mk[\"value\"], (int, float)) and not isinstance(mk[\"value\"], bool)\n397\t                      for mk in mks)\n398\t        for (target, did), pts in series.items():\n399\t            if not pts:\n400\t                continue\n401\t            max_len = max(len(p[\"bytes\"]) for p in pts)\n402\t            if max_len == 0:\n403\t                continue\n404\t            if numeric:\n405\t                out.extend(_numeric_candidates(target, did, label, pts, mks, max_len))\n406\t            else:\n407\t                out.extend(_categorical_candidates(target, did, label, pts, mks, max_len))\n408\t    out.sort(key=lambda c: c[\"score\"], reverse=True)\n409\t    return out\n410\t\n411\t\n412\t__all__ = [\"isotp_reassemble\", \"uds_transactions\", \"did_series\", \"correlate\",\n413\t           \"REQUEST_SERVICES\"]\n414\t"}]},"uuid":"eee6ffff-6365-40e2-b603-cc5a7813f16c","timestamp":"2026-10-14T17:57:21.697Z","toolUseResult":{"type":"text","file":{"filePath":"C:\\Users\\User\\mcp-servers\\cuore\\live\\learn.py","content":"\"\"\"Reconstruct what wiTECH asked and heard, from a passive capture alone.\n\nNothing here talks to the adapter. Given the frame list :func:`capture.listen`\nalready returns (``[{\"t\", \"id\", \"data\"}]`` with headers on, ``data`` the\nconcatenated hex bytes of one raw CAN frame -- see :mod:`framing`), this\nmodule rebuilds the ISO-TP messages, pairs UDS requests with responses,\ngroups per-(target, DID) time series, and correlates those series against\nwhat a technician noted on wiTECH's own data display.\n\nAddressing is generic 29-bit physical, per :mod:`addressing`: a request is\n``18DA<TA><SA>`` and its response is the same two bytes swapped,\n``18DA<SA><TA>``. The tester byte is whatever wiTECH used -- never assumed to\nbe ``F1``.\n\nPure functions, stdlib only.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport re\nfrom collections import Counter, defaultdict\nfrom typing import Any, Optional\n\n_ID_RE = re.compile(r\"^18DA([0-9A-F]{2})([0-9A-F]{2})$\")\n\n#: UDS service IDs that appear on the *request* side. A response is either\n#: ``0x7F`` (negative) or ``request + 0x40`` (positive) -- this is what lets\n#: pairing work without knowing in advance which byte is the tester.\nREQUEST_SERVICES: frozenset[int] = frozenset({\n    0x10, 0x11, 0x14, 0x19, 0x1A, 0x22, 0x23, 0x24, 0x27, 0x28, 0x29, 0x2A,\n    0x2C, 0x2E, 0x2F, 0x31, 0x34, 0x35, 0x36, 0x37, 0x38, 0x3D, 0x3E, 0x85,\n})\n\n#: Services this module decodes DIDs for. Everything else is paired and kept\n#: raw, per the spec (\"only read services decoded\").\n_READ_SERVICES: frozenset[int] = frozenset({0x22, 0x2E})\n\n\n# ===========================================================================\n# ISO-TP reassembly\n# ===========================================================================\n\ndef isotp_reassemble(frames: list[dict[str, Any]]) -> dict[str, Any]:\n    \"\"\"Rebuild ISO-TP messages per CAN ID from raw ``capture.listen`` frames.\n\n    PCI types: ``0N`` single frame of N bytes, ``1N NN`` first frame with a\n    12-bit length, ``2N`` consecutive frame (sequence number ignored --\n    passive capture cannot lose frames the way a live bus can drop them, and\n    nothing here needs to detect that), ``3N`` flow control (ignored: this\n    tool never transmits and flow control from the real tester is not a\n    payload). Interleaved IDs are tracked independently: one pending\n    assembly per CAN ID.\n\n    A new single/first frame that arrives while an assembly for that ID is\n    still incomplete drops the old one (counted). Anything still incomplete\n    when the frame list ends is dropped the same way.\n\n    Returns ``{\"messages\": [{\"t\", \"id\", \"data\"}, ...], \"dropped\": int}``,\n    messages sorted by ``t``. ``data`` is a list of hex byte strings.\n    \"\"\"\n    pending: dict[str, dict[str, Any]] = {}\n    messages: list[dict[str, Any]] = []\n    dropped = 0\n\n    for f in sorted(frames, key=lambda x: x[\"t\"]):\n        hdr = f[\"id\"]\n        raw = str(f.get(\"data\") or \"\")\n        if len(raw) < 2:\n            continue\n        b = [raw[i:i + 2] for i in range(0, len(raw) - 1, 2)]\n        if not b:\n            continue\n        pci = int(b[0], 16)\n        ftype = pci >> 4\n\n        if ftype == 0:\n            if hdr in pending:\n                dropped += 1\n                del pending[hdr]\n            n = pci & 0x0F\n            data = b[1:1 + n] if n else b[1:]\n            messages.append({\"t\": f[\"t\"], \"id\": hdr, \"data\": data})\n        elif ftype == 1:\n            if len(b) < 2:\n                continue\n            if hdr in pending:\n                dropped += 1\n            expected = ((pci & 0x0F) << 8) | int(b[1], 16)\n            pending[hdr] = {\"expected\": expected, \"data\": list(b[2:]), \"t\": f[\"t\"]}\n        elif ftype == 2:\n            st = pending.get(hdr)\n            if st is None:\n                continue  # orphan consecutive frame, no first frame seen -- ignore\n            st[\"data\"].extend(b[1:])\n            if len(st[\"data\"]) >= st[\"expected\"]:\n                messages.append({\"t\": st[\"t\"], \"id\": hdr, \"data\": st[\"data\"][:st[\"expected\"]]})\n                del pending[hdr]\n        else:\n            continue  # flow control (3N) or reserved -- never a payload\n\n    dropped += len(pending)\n    messages.sort(key=lambda m: m[\"t\"])\n    return {\"messages\": messages, \"dropped\": dropped}\n\n\n# ===========================================================================\n# UDS request/response pairing\n# ===========================================================================\n\ndef _split_multi_did(payload: list[str], dids: list[int]\n                     ) -> Optional[list[tuple[int, list[str]]]]:\n    \"\"\"Split a multi-DID ``0x22`` response into ``[(did, data), ...]``.\n\n    Data lengths are unknown, so every way of cutting the response so that\n    each DID's two echoed bytes land exactly where expected is tried. The\n    split is used only when it is unique; more than one valid cut (or none)\n    means the boundary is genuinely ambiguous from this data alone.\n    \"\"\"\n    did_hex = [f\"{d:04X}\" for d in dids]\n    n = len(payload)\n    results: list[list[tuple[int, list[str]]]] = []\n\n    def rec(pos: int, idx: int, acc: list[tuple[int, list[str]]]) -> None:\n        if len(results) > 1:\n            return\n        if idx == len(dids):\n            if pos == n:\n                results.append(list(acc))\n            return\n        if pos + 2 > n or payload[pos] + payload[pos + 1] != did_hex[idx]:\n            return\n        min_remaining = 2 * (len(dids) - idx - 1)\n        max_data_len = n - (pos + 2) - min_remaining\n        for dl in range(0, max(0, max_data_len) + 1):\n            rec(pos + 2 + dl, idx + 1, acc + [(dids[idx], payload[pos + 2:pos + 2 + dl])])\n            if len(results) > 1:\n                return\n\n    rec(0, 0, [])\n    return results[0] if len(results) == 1 else None\n\n\ndef _decode_read(tr: dict[str, Any], req_data: list[str], resp_data: list[str],\n                 svc: int) -> None:\n    if svc == 0x22:\n        req_payload = req_data[1:]\n        dids = [int(req_payload[k] + req_payload[k + 1], 16)\n                for k in range(0, len(req_payload) - 1, 2)]\n        resp_payload = resp_data[1:]\n        if len(dids) == 1:\n            dh = f\"{dids[0]:04X}\"\n            tr[\"did\"] = dh\n            if len(resp_payload) >= 2 and resp_payload[0] + resp_payload[1] == dh:\n                tr[\"data\"] = resp_payload[2:]\n            else:\n                tr[\"data\"] = resp_payload  # DID not echoed as expected -- keep raw\n        elif len(dids) > 1:\n            split = _split_multi_did(resp_payload, dids)\n            if split is not None:\n                tr[\"dids\"] = [{\"did\": f\"{d:04X}\", \"data\": data} for d, data in split]\n            else:\n                tr[\"multi_did_raw\"] = True\n    elif svc == 0x2E:\n        # WriteDataByIdentifier: the DID and the written value are in the\n        # *request*; the response only echoes the DID.\n        req_payload = req_data[1:]\n        if len(req_payload) >= 2:\n            tr[\"did\"] = req_payload[0] + req_payload[1]\n            tr[\"data\"] = req_payload[2:]\n\n\ndef uds_transactions(frames: list[dict[str, Any]]) -> list[dict[str, Any]]:\n    \"\"\"Pair UDS requests with responses, in time order.\n\n    Each transaction: ``{t_req, t_resp, target, tester, service, request,\n    response, nrc, did, data, dids, multi_did_raw}``. ``target``/``tester``\n    are hex byte strings (``\"10\"``, ``\"F1\"``); ``did``/``data`` are set for a\n    single-DID ``0x22``/``0x2E``; ``dids`` is a list of ``{\"did\",\"data\"}``\n    when a multi-DID ``0x22`` request could be split unambiguously;\n    ``multi_did_raw`` is ``True`` when it could not be. A request with no\n    matching response has ``t_resp``/``response`` as ``None``.\n    \"\"\"\n    msgs = isotp_reassemble(frames)[\"messages\"]\n    used = [False] * len(msgs)\n    out: list[dict[str, Any]] = []\n\n    for i, m in enumerate(msgs):\n        if used[i] or not m[\"data\"]:\n            continue\n        mo = _ID_RE.match(m[\"id\"])\n        if not mo:\n            continue\n        svc = int(m[\"data\"][0], 16)\n        if svc not in REQUEST_SERVICES:\n            continue\n        ta, sa = mo.group(1), mo.group(2)\n        resp_id = f\"18DA{sa}{ta}\"\n\n        match_idx = None\n        for j in range(i + 1, len(msgs)):\n            if used[j] or msgs[j][\"id\"] != resp_id or not msgs[j][\"data\"]:\n                continue\n            rb = int(msgs[j][\"data\"][0], 16)\n            if rb == 0x7F and len(msgs[j][\"data\"]) >= 2 and int(msgs[j][\"data\"][1], 16) == svc:\n                match_idx = j\n                break\n            if rb == (svc + 0x40) & 0xFF:\n                match_idx = j\n                break\n\n        tr: dict[str, Any] = {\n            \"t_req\": m[\"t\"], \"t_resp\": None, \"target\": ta, \"tester\": sa,\n            \"service\": f\"{svc:02X}\", \"request\": m[\"data\"], \"response\": None,\n            \"nrc\": None, \"did\": None, \"data\": None, \"dids\": None,\n            \"multi_did_raw\": False,\n        }\n        used[i] = True\n        if match_idx is not None:\n            used[match_idx] = True\n            m2 = msgs[match_idx]\n            tr[\"t_resp\"] = m2[\"t\"]\n            tr[\"response\"] = m2[\"data\"]\n            if int(m2[\"data\"][0], 16) == 0x7F:\n                tr[\"nrc\"] = m2[\"data\"][2] if len(m2[\"data\"]) >= 3 else None\n            elif svc in _READ_SERVICES:\n                _decode_read(tr, m[\"data\"], m2[\"data\"], svc)\n        out.append(tr)\n\n    out.sort(key=lambda t: t[\"t_req\"])\n    return out\n\n\n# ===========================================================================\n# Per-DID time series\n# ===========================================================================\n\ndef did_series(transactions: list[dict[str, Any]]) -> dict[tuple[str, str], list[dict[str, Any]]]:\n    \"\"\"``{(target, did): [{\"t\", \"bytes\"}, ...]}`` in time order.\n\n    ``target``/``did`` are hex strings (``\"10\"``, ``\"1234\"``). Both\n    single-DID transactions and the individually-split entries of an\n    unambiguous multi-DID transaction contribute.\n    \"\"\"\n    series: dict[tuple[str, str], list[dict[str, Any]]] = defaultdict(list)\n    for tr in sorted(transactions, key=lambda t: t[\"t_req\"]):\n        t = tr[\"t_resp\"] if tr[\"t_resp\"] is not None else tr[\"t_req\"]\n        if tr.get(\"did\") and tr.get(\"data\") is not None:\n            series[(tr[\"target\"], tr[\"did\"])].append({\"t\": t, \"bytes\": tr[\"data\"]})\n        for entry in (tr.get(\"dids\") or []):\n            series[(tr[\"target\"], entry[\"did\"])].append({\"t\": t, \"bytes\": entry[\"data\"]})\n    for pts in series.values():\n        pts.sort(key=lambda p: p[\"t\"])\n    return dict(series)\n\n\n# ===========================================================================\n# Correlation against technician marks\n# ===========================================================================\n\ndef _nearest(pts: list[dict[str, Any]], t: float) -> Optional[dict[str, Any]]:\n    if not pts:\n        return None\n    return min(pts, key=lambda p: abs(p[\"t\"] - t))\n\n\ndef _consistency(samples: list[tuple[Any, int]]) -> float:\n    \"\"\"1.0 when every label value maps to exactly one raw value and every\n    label value maps to a *different* raw value; a partial score otherwise\n    (the fraction of samples matching the modal raw value for their label).\"\"\"\n    by_value: dict[Any, list[int]] = defaultdict(list)\n    for lv, rv in samples:\n        by_value[lv].append(rv)\n    if len(by_value) < 2:\n        return 0.0\n    consistent = all(len(set(rvs)) == 1 for rvs in by_value.values())\n    if consistent:\n        reps = [rvs[0] for rvs in by_value.values()]\n        if len(set(reps)) == len(reps):\n            return 1.0\n        return 0.6  # discriminates nothing -- same raw value regardless of label\n    total = len(samples)\n    correct = sum(Counter(rvs).most_common(1)[0][1] for rvs in by_value.values())\n    return correct / total if total else 0.0\n\n\ndef _categorical_candidates(target: str, did: str, label: str, pts: list[dict[str, Any]],\n                            marks: list[dict[str, Any]], max_len: int) -> list[dict[str, Any]]:\n    cands: list[dict[str, Any]] = []\n    for off in range(max_len):\n        samples: list[tuple[Any, int]] = []\n        ok = True\n        for mk in marks:\n            p = _nearest(pts, mk[\"t\"])\n            if p is None or off >= len(p[\"bytes\"]):\n                ok = False\n                break\n            samples.append((mk[\"value\"], int(p[\"bytes\"][off], 16)))\n        if not ok:\n            continue\n        ev = [{\"t\": mk[\"t\"], \"value\": mk[\"value\"], \"raw\": rv}\n              for mk, (_, rv) in zip(marks, samples)]\n        cands.append({\"target\": target, \"did\": did, \"label\": label, \"kind\": \"categorical\",\n                      \"field\": {\"offset\": off, \"width\": \"byte\"},\n                      \"score\": _consistency(samples), \"evidence\": ev})\n        for bit in range(8):\n            bit_samples = [(lv, (rv >> bit) & 1) for lv, rv in samples]\n            bev = [{\"t\": mk[\"t\"], \"value\": mk[\"value\"], \"raw\": rv}\n                   for mk, (_, rv) in zip(marks, bit_samples)]\n            cands.append({\"target\": target, \"did\": did, \"label\": label, \"kind\": \"categorical\",\n                          \"field\": {\"offset\": off, \"bit\": bit},\n                          \"score\": _consistency(bit_samples), \"evidence\": bev})\n    for off in range(max_len - 1):\n        samples = []\n        ok = True\n        for mk in marks:\n            p = _nearest(pts, mk[\"t\"])\n            if p is None or off + 1 >= len(p[\"bytes\"]):\n                ok = False\n                break\n            v = (int(p[\"bytes\"][off], 16) << 8) | int(p[\"bytes\"][off + 1], 16)\n            samples.append((mk[\"value\"], v))\n        if not ok:\n            continue\n        ev = [{\"t\": mk[\"t\"], \"value\": mk[\"value\"], \"raw\": rv}\n              for mk, (_, rv) in zip(marks, samples)]\n        cands.append({\"target\": target, \"did\": did, \"label\": label, \"kind\": \"categorical\",\n                      \"field\": {\"offset\": off, \"width\": \"u16\"},\n                      \"score\": _consistency(samples), \"evidence\": ev})\n    return cands\n\n\ndef _linreg(xs: list[float], ys: list[float]) -> tuple[float, float, float]:\n    n = len(xs)\n    mx, my = sum(xs) / n, sum(ys) / n\n    sxx = sum((x - mx) ** 2 for x in xs)\n    if sxx == 0:\n        return 0.0, my, 0.0\n    scale = sum((x - mx) * (y - my) for x, y in zip(xs, ys)) / sxx\n    offset = my - scale * mx\n    ss_res = sum((y - (scale * x + offset)) ** 2 for x, y in zip(xs, ys))\n    ss_tot = sum((y - my) ** 2 for y in ys)\n    if ss_tot == 0:\n        return scale, offset, 1.0 if ss_res == 0 else 0.0\n    return scale, offset, 1 - ss_res / ss_tot\n\n\ndef _numeric_candidates(target: str, did: str, label: str, pts: list[dict[str, Any]],\n                        marks: list[dict[str, Any]], max_len: int) -> list[dict[str, Any]]:\n    cands: list[dict[str, Any]] = []\n    fields = [(\"byte\", off, 1) for off in range(max_len)]\n    fields += [(\"u16\", off, 2) for off in range(max_len - 1)]\n    for kind, off, width in fields:\n        xs: list[float] = []\n        ys: list[float] = []\n        ev: list[dict[str, Any]] = []\n        ok = True\n        for mk in marks:\n            p = _nearest(pts, mk[\"t\"])\n            if p is None or off + width > len(p[\"bytes\"]):\n                ok = False\n                break\n            raw = (int(p[\"bytes\"][off], 16) if width == 1 else\n                   (int(p[\"bytes\"][off], 16) << 8) | int(p[\"bytes\"][off + 1], 16))\n            xs.append(raw)\n            ys.append(mk[\"value\"])\n            ev.append({\"t\": mk[\"t\"], \"value\": mk[\"value\"], \"raw\": raw})\n        if not ok or len(set(xs)) < 2:\n            continue\n        scale, offset, r2 = _linreg(xs, ys)\n        cands.append({\"target\": target, \"did\": did, \"label\": label, \"kind\": \"numeric\",\n                      \"field\": {\"offset\": off, \"width\": kind},\n                      \"scale\": scale, \"offset\": offset, \"score\": r2, \"r2\": r2,\n                      \"evidence\": ev})\n    return cands\n\n\ndef correlate(series: dict[tuple[str, str], list[dict[str, Any]]],\n             marks: list[dict[str, Any]]) -> list[dict[str, Any]]:\n    \"\"\"Rank (target, did, field) candidates against technician-noted marks.\n\n    ``marks``: ``[{\"t\", \"label\", \"value\"}, ...]``. Marks are grouped by\n    ``label``; string values are treated categorically (every byte, every\n    bit within a byte, and every 16-bit big-endian field are checked for a\n    value that is the same whenever the label value repeats and different\n    whenever it changes); numeric values get a linear least-squares fit\n    (``value = scale*raw + offset``) over 1- and 2-byte fields, scored by\n    R². Returns candidates sorted by score descending, each carrying its\n    evidence (the raw byte(s) read back at each mark's nearest sample).\n    \"\"\"\n    by_label: dict[str, list[dict[str, Any]]] = defaultdict(list)\n    for m in marks:\n        by_label[m[\"label\"]].append(m)\n\n    out: list[dict[str, Any]] = []\n    for label, mks in by_label.items():\n        numeric = all(isinstance(mk[\"value\"], (int, float)) and not isinstance(mk[\"value\"], bool)\n                      for mk in mks)\n        for (target, did), pts in series.items():\n            if not pts:\n                continue\n            max_len = max(len(p[\"bytes\"]) for p in pts)\n            if max_len == 0:\n                continue\n            if numeric:\n                out.extend(_numeric_candidates(target, did, label, pts, mks, max_len))\n            else:\n                out.extend(_categorical_candidates(target, did, label, pts, mks, max_len))\n    out.sort(key=lambda c: c[\"score\"], reverse=True)\n    return out\n\n\n__all__ = [\"isotp_reassemble\", \"uds_transactions\", \"did_series\", \"correlate\",\n           \"REQUEST_SERVICES\"]\n","numLines":414,"startLine":1,"totalLines":414}},"sourceToolAssistantUUID":"bb8d41d5-7694-465a-9aad-5728217cd898","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
