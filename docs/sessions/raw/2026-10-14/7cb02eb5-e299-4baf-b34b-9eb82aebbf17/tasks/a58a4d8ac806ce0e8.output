n bulletins if b.get(\"id\") == \"9100471\"]","+    flooded_evidence_for = [","+        _ref(\"bulletin\", b[\"id\"], f\"{b['id']}: {b['title']}\") for b in flooded_bulletins","+    ]","+","     out = [","         {\"text\": \"EVAP: ESIM signal path\", \"system\": \"EVAP\",","          \"evidence_for\": esim_evidence_for, \"evidence_against\": [],"]},{"oldStart":165,"oldLines":6,"newStart":178,"newLines":13,"lines":["          \"evidence_against\": calib_evidence_against,","          \"next_test\": \"Check PCM calibration level against the latest EVAP \"","                       \"TSB before condemning hardware (SLVT or Mode $06).\"},","+        {\"text\": \"EVAP: flooded canister (TSB 9100471)\", \"system\": \"EVAP\",","+         \"evidence_for\": flooded_evidence_for,","+         \"evidence_against\": [],","+         \"next_test\": \"Inspect the vapour line at the FDM port for an internal \"","+                      \"disconnect/kink that would flood the canister with liquid \"","+                      \"fuel (TSB 9100471); if confirmed, replace both the \"","+                      \"canister and the ESIM.\"},","     ]","     return out"," "]},{"oldStart":712,"oldLines":6,"newStart":732,"newLines":118,"lines":["         return None"," "," ","+def add_test_evidence_new_hypothesis(vin: str, text: str, step_id: str, label: str,","+                                     result: str, *, supports: str = \"for\",","+                                     system: str = \"\", job_id: Optional[str] = None,","+                                     by: Optional[str] = None","+                                     ) -> Optional[dict[str, Any]]:","+    \"\"\"Step 6's result sheet, \"or create one\" path (Review #6 item 4): when","+    a test row names no existing hypothesis, create a new one from free","+    text (picked from the suggested list, or typed) and attach this test","+    result to it as evidence in the same step -- never a separate","+    \"create, then remember to come back and attach\" round trip. Returns","+    the new hypothesis dict, or ``None`` (never raises) when there is no","+    text, no job to attach it to, or the create itself is refused --","+    recording the result elsewhere must not be blocked by this failing.","+    \"\"\"","+    text = (text or \"\").strip()","+    if not text:","+        return None","+    jid = job_id","+    if jid is None:","+        job = jobs_mod.current(vin)","+        if job is None:","+            jobs_for_vin = jobs_mod.load(vin)","+            job = jobs_for_vin[-1] if jobs_for_vin else None","+        jid = job[\"id\"] if job else None","+    if not jid:","+        return None","+    try:","+        hyp = add_hypothesis(jid, text, system=system, by=by)","+    except BadRequest:","+        return None","+    hyp_id = hyp.get(\"id\")","+    if not hyp_id:","+        return None","+    add_test_evidence(vin, hyp_id, step_id, label, result, supports=supports,","+                      job_id=jid, by=by)","+    return hyp","+","+","+#: Checklist step-id prefix the Tests surface writes under","+#: (``tests_bridge.step_id``) -- re-declared here (not imported, to avoid","+#: a tests_bridge<->jobs_bridge import cycle) since both modules write and","+#: read the same ``cuore.live.checklists`` entries under this namespace.","+_TEST_STEP_PREFIX = \"test:\"","+","+","+def _test_result_label(view: dict[str, Any], step_id: str) -> str:","+    \"\"\"This checklist row's own human text: a fault-tree step's own text","+    off the open-work card that named it, or (for a Tests-surface row,","+    ``step_id`` = ``\"test:<id>\"``) that test's own catalogue name. Falls","+    back to the bare id -- never invented, same posture as","+    ``cuore.api.checklists._step_text``, which this mirrors for the ids","+    that one does not cover (Tests-surface ids).\"\"\"","+    if step_id.startswith(_TEST_STEP_PREFIX):","+        t = mechanic_tests.test(step_id[len(_TEST_STEP_PREFIX):])","+        return (t.get(\"name\") or step_id) if t else step_id","+    for card in view.get(\"open_work\", []):","+        for s in card.get(\"steps\", []):","+            if s.get(\"id\") == step_id:","+                return s.get(\"text\") or step_id","+    return step_id","+","+","+def recorded_test_results(vin: str, view: dict[str, Any]) -> list[dict[str, Any]]:","+    \"\"\"Every checklist row with a recorded pass/fail result for this car --","+    step 6's own result sheet and the Tests surface both write through the","+    same ``cuore.live.checklists`` store under one step-id namespace, so","+    this is the one list that covers both (Review #6 item 4: \"recorded","+    test results ... must appear in the + Evidence for/against picker\").","+    Shaped with a ready-to-POST ``ref`` (the same ``kind=\"test\"`` shape","+    :func:`add_test_evidence` attaches), whether or not a hypothesis","+    already claims the result -- ``linked_hypothesis_id`` says which, if","+    any. Never raises.\"\"\"","+    try:","+        checklist = checklist_store.get(vin)","+    except Exception:  # noqa: BLE001","+        return []","+    out: list[dict[str, Any]] = []","+    for step_id, entry in (checklist or {}).items():","+        result = entry.get(\"result\")","+        if result not in (\"pass\", \"fail\"):","+            continue","+        label = f\"{_test_result_label(view, step_id)}: {result}\"","+        if entry.get(\"value\") is not None:","+            label += f\" {entry['value']:g}{entry.get('unit') or ''}\"","+        out.append({","+            \"step_id\": step_id, \"result\": result, \"label\": label,","+            \"at\": entry.get(\"done_at\"),","+            \"linked_hypothesis_id\": entry.get(\"hypothesis_id\"),","+            \"ref\": {\"kind\": \"test\", \"id\": step_id, \"label\": label, \"result\": result},","+        })","+    out.sort(key=lambda r: r.get(\"at\") or \"\", reverse=True)","+    return out","+","+","+def evidence_candidates(vin: str, view: dict[str, Any]) -> dict[str, Any]:","+    \"\"\"Every real, recorded result the job page's '+ Evidence for/against'","+    picker should be able to offer (Review #6 item 4) -- test results","+    (step 6 + the Tests surface), Mode $06 FAILs read from the car, and","+    freeze frames, with the ones that are test *conditions* (fuel out of","+    the EVAP window when the code set -- never themselves evidence FOR a","+    hypothesis) split into their own ``conditions`` key. The template","+    still decides how/whether to render each group -- this only exposes","+    the data; nothing here writes anything.\"\"\"","+    mode06 = view.get(\"mode06\") or {}","+    return {","+        \"test_results\": recorded_test_results(vin, view),","+        \"mode06_fails\": mode06.get(\"fails\") or [],","+        \"freeze_frames\": view.get(\"evidence_freeze_frames\") or [],","+        \"conditions\": view.get(\"condition_freeze_frames\") or [],","+    }","+","+"," def _next_unresolved_test(h: dict[str, Any], view: dict[str, Any]) -> str:","     \"\"\"Job UX run 2, R4: once the hypothesis's own next-test step has a","     linked result, the fault tree's *next* untested step for this system --"]},{"oldStart":855,"oldLines":15,"newStart":987,"newLines":29,"lines":[" ","     reviewed = bool(job) and tools_kb_bridge.has_review(vin, job[\"id\"])"," ","+    symptoms = _symptoms(vin)","+","     # R4: the view's own display copy of each hypothesis gets its","     # next_test recomputed fresh every render -- never mutates the stored","     # job, same posture as jobs_routes.py's active/deleted split below it.","-    if job and job.get(\"hypotheses\"):","+    if job:","         job = dict(job)","-        job[\"hypotheses\"] = [","-            {**h, \"next_test\": _display_next_test(h, dossier_view)}","-            for h in job[\"hypotheses\"]","-        ]","+        if job.get(\"hypotheses\"):","+            job[\"hypotheses\"] = [","+                {**h, \"next_test\": _display_next_test(h, dossier_view)}","+                for h in job[\"hypotheses\"]","+            ]","+        # Review #6 item 1: step 1's complaint and step 2's symptom log are","+        # two different stores (``mes.jobs``' own ``complaint`` field, set","+        # only at intake, vs ``mes.symptoms`` via ``timeline_bridge`` --","+        # see ``_symptoms``); a job opened with no typed complaint showed","+        # \"(no complaint recorded)\" right above a real symptom already on","+        # file. Never overwrites a complaint that was actually typed --","+        # only fills the display copy when it is empty, from the newest","+        # symptom report (``_symptoms`` is oldest-first), the same source","+        # step 2 and the verdict's own basis already read.","+        if not (job.get(\"complaint\") or \"\").strip() and symptoms:","+            job[\"complaint\"] = symptoms[-1].get(\"text\") or job.get(\"complaint\")"," ","     return {","         \"vin\": vin,"]},{"oldStart":876,"oldLines":7,"newStart":1022,"newLines":7,"lines":["         \"suggested_hypotheses_top\": suggestions_top,","         \"suggested_hypotheses_rest\": suggestions_rest,","         \"step_registry\": step_registry(),","-        \"symptoms\": _symptoms(vin),","+        \"symptoms\": symptoms,","         \"notes\": _notes(vin),","         \"media_count\": _media_count(vin),","         \"feedback_open_count\": _feedback_open_count(vin),"]},{"oldStart":887,"oldLines":6,"newStart":1033,"newLines":7,"lines":["         \"tools_step_choices\": TOOLS_STEP_CHOICES,","         \"tools_panel\": panel,","         \"tools_reviewed\": reviewed,","+        \"evidence_candidates\": evidence_candidates(vin, dossier_view),","     }"," "," "]},{"oldStart":896,"oldLines":6,"newStart":1043,"newLines":8,"lines":["           \"add_hypothesis\", \"set_hypothesis\", \"edit_hypothesis\",","           \"delete_hypothesis\", \"undelete_hypothesis\", \"add_evidence\",","           \"remove_evidence\", \"resolve_evidence\", \"add_test_evidence\",","+          \"add_test_evidence_new_hypothesis\", \"recorded_test_results\",","+          \"evidence_candidates\",","           \"add_action\", \"attach\", \"get_job\", \"add_suggested_hypothesis\",","           \"step_registry\", \"RuleViolation\", \"TOOLS_STEP_CHOICES\",","           \"tools_panel\", \"add_tool_usage\"]"]}]},{"filePath":"C:\\Users\\User\\mcp-servers\\cuore\\services\\mes_bridge.py","hunks":[{"oldStart":185,"oldLines":11,"newStart":185,"newLines":60,"lines":[" # --- per-vehicle analysis -------------------------------------------------"," "," ","+#: Every from-car observation kind that counts as a scan session of this","+#: car, same as a MES log (Review #6 item 1: \"one data date, one truth\") --","+#: a live read on the car is not a second, disagreeing clock from the MES","+#: log corpus's own ``identity.last_log``.","+_LIVE_SCAN_KINDS = (\"obd_dtcs\", \"module_dtcs\", \"readiness\", \"mode06\",","+                   \"freeze_frame\", \"freeze_frame_set\", \"pids_snapshot\", \"pid\")","+","+","+def _newest_live_read(vin: str) -> str | None:","+    \"\"\"The newest from-car observation timestamp across every kind that","+    counts as a scan session (see :data:`_LIVE_SCAN_KINDS`), in the MES","+    log corpus's own \"YYYY-MM-DD HH:MM:SS\" shape -- or ``None`` when the","+    live store is unavailable, untagged for this VIN, or simply has","+    nothing on file yet. Never raises.\"\"\"","+    if not vin.strip():","+        return None","+    try:","+        from ..live import store as live_store","+    except Exception:  # noqa: BLE001 -- optional dependency, see module docstring","+        return None","+    best: str | None = None","+    for kind in _LIVE_SCAN_KINDS:","+        try:","+            obs = live_store.recent_observations(50, vin=vin, kind=kind)","+        except Exception:  # noqa: BLE001","+            continue","+        for o in obs:","+            if not live_store.is_from_car(o):","+                continue","+            at = o.get(\"at\") or \"\"","+            if at and (best is None or at > best):","+                best = at","+    return best.replace(\"T\", \" \") if best else None","+","+"," def workup(vin: str = \"\", vehicle: str = \"\") -> dict[str, Any]:","-    \"\"\"The pre-work dossier. Raises :class:`NotFound` when no logs match.\"\"\"","+    \"\"\"The pre-work dossier. Raises :class:`NotFound` when no logs match.","+","+    ``identity.last_log`` is bumped to the newest from-car live read (see","+    :func:`_newest_live_read`) when that read is newer than the newest MES","+    log on file -- so the header, the report, and every other page that","+    quotes \"data through\" agree with the date the verdict already uses","+    (Review #6 item 1): a live read taken straight off the car tonight is","+    itself a scan session, not a fact the \"data through\" date can ignore","+    just because it never passed through a MES log file.","+    \"\"\"","     dossier = workup_mod.build(vin=vin, vehicle=vehicle)","     if \"error\" in dossier:","         raise NotFound(dossier[\"error\"])","+    identity = dossier.get(\"identity\")","+    if isinstance(identity, dict):","+        live_at = _newest_live_read(vin or identity.get(\"vin\") or \"\")","+        if live_at and live_at > (identity.get(\"last_log\") or \"\"):","+            identity[\"last_log\"] = live_at","     return dossier"," "," "]}]},{"filePath":"C:\\Users\\User\\mcp-servers\\cuore\\services\\system_detail_bridge.py","hunks":[{"oldStart":33,"oldLines":6,"newStart":33,"newLines":7,"lines":[" "," from __future__ import annotations"," ","+import re"," from typing import Any, Optional"," "," from .. import bootstrap  # noqa: F401 -- side effect: puts `mes` on sys.path"]},{"oldStart":64,"oldLines":6,"newStart":65,"newLines":12,"lines":[" #: its steps at render time."," _NETWORK_CASCADE_TEST = \"check BCM supply and grounds first\""," ","+#: The sourced CAN-C/IHS termination test (``mes.mechanic_tests``), always","+#: the last \"check first\" row -- the bus itself is suspected only after","+#: supply/ground/connector are ruled out (same order as ``mes.faulttree``'s","+#: NETWORK_CASCADE N5/N6 and the new framing bullet on that tree).","+_CAN_TERMINATION_TEST_ID = \"can_bus_resistance_test\"","+"," #: The one marker every sourcing gap renders as -- never a guess, never a"," #: blank. Matches the wording already used across maintenance.html /"," #: torque.html / drivetrain_section.html / _code_brief.html."]},{"oldStart":206,"oldLines":6,"newStart":213,"newLines":238,"lines":["     return names"," "," ","+# --- network event (the ``network`` system page) ----------------------------","+#","+# Every module-reported communication-type code across *all* modules'","+# ``module_dtcs`` observations -- not just the ones ``systems_map_bridge.","+# module_dtc_overlay`` happens to attribute to the \"network\" systems-graph","+# key (it attributes a U-code to the *reporting module's own* system, e.g.","+# BCM -> body_comfort, by design -- see that module's docstring -- so a","+# U-code almost never lands on \"network\" there). This section is the one","+# place on the page that gathers them back up across modules, reusing","+# ``mes.analysis.is_communication_dtc`` (never a second, locally-invented","+# rule for \"is this a comms code\") and its module docstring's own wording","+# for the collapse: \"that is one power or bus event [...] not N module","+# faults.\"","+","+def _network_event(vin: str) -> Optional[dict[str, Any]]:","+    try:","+        from mes import live_obs as live_obs_mod2  # noqa: PLC0415","+        from mes import analysis as analysis_mod2  # noqa: PLC0415","+        from mes import dtc as dtc_mod2  # noqa: PLC0415","+        from mes import dtc_descriptions as desc_mod2  # noqa: PLC0415","+    except Exception:  # noqa: BLE001 -- a missing mes module must never 500 the page","+        return None","+","+    try:","+        observations = live_obs_mod2.load(vin, \"module_dtcs\")","+    except Exception:  # noqa: BLE001","+        observations = []","+    try:","+        history = analysis_mod2.dtc_history(vin=vin)","+    except Exception:  # noqa: BLE001","+        history = {}","+","+    rows: dict[str, dict[str, Any]] = {}","+    window_members: dict[str, set[str]] = {}","+","+    for obs in observations:","+        data = obs.get(\"data\") or {}","+        ecu = str(data.get(\"ecu\") or \"\").upper()","+        at = obs.get(\"at\")","+        for rec in data.get(\"dtcs\") or []:","+            full = str(rec.get(\"code\") or \"\")","+            if not full:","+                continue","+            base = full.split(\"-\", 1)[0].strip().upper()","+            ftb = full.split(\"-\")[-1] if \"-\" in full else None","+            try:","+                desc_text = desc_mod2.code_description(base).get(\"text\") or \"\"","+            except Exception:  # noqa: BLE001","+                desc_text = \"\"","+            probe = dtc_mod2.Dtc(code=base, ftb=ftb, component=ecu, description=desc_text)","+            try:","+                is_comm = analysis_mod2.is_communication_dtc(probe)","+            except Exception:  # noqa: BLE001","+                is_comm = base.startswith(\"U\")","+            if not is_comm:","+                continue","+            flags = rec.get(\"flags\") or {}","+            if flags.get(\"testFailed\"):","+                state = \"failing now\"","+            elif (flags.get(\"confirmedDTC\") or flags.get(\"pendingDTC\")","+                  or flags.get(\"testFailedSinceLastClear\")):","+                state = \"history\"","+            else:","+                continue  # merely tracked -- the module has never actually found it","+            member_key = f\"{ecu}:{full}\"","+            if at:","+                window_members.setdefault(at, set()).add(member_key)","+            try:","+                ft = dtc_mod2.failure_type(ftb) if ftb else None","+            except Exception:  # noqa: BLE001","+                ft = None","+            hist = history.get(base)","+            row = rows.get(member_key)","+            if row is None:","+                rows[member_key] = row = {","+                    \"code\": base, \"full\": full, \"module\": ecu,","+                    \"failure_type\": ft.text if ft else None,","+                    \"status\": state,","+                    \"car_first_seen\": at, \"car_last_seen\": at,","+                    \"mes_first_seen\": hist.first_seen if hist and hist.first_seen else None,","+                    \"mes_last_seen\": hist.last_seen if hist and hist.last_seen else None,","+                }","+            else:","+                if at:","+                    row[\"car_first_seen\"] = min(row[\"car_first_seen\"] or at, at)","+                    row[\"car_last_seen\"] = max(row[\"car_last_seen\"] or at, at)","+                if state == \"failing now\":","+                    row[\"status\"] = \"failing now\"  # failing-now on any read wins","+","+    code_rows = sorted(rows.values(), key=lambda r: (r[\"module\"], r[\"full\"]))","+","+    window_at, members = (max(window_members.items(), key=lambda kv: len(kv[1]))","+                          if window_members else (None, set()))","+    # Same threshold mes.analysis.NETWORK_EVENT_MIN_MODULES already uses for","+    # its own module-level collapse, applied here per-code (several codes","+    # on one module still name one event, same as several modules do).","+    min_codes = getattr(analysis_mod2, \"NETWORK_EVENT_MIN_MODULES\", 3)","+    is_event = len(members) >= min_codes","+    modules_involved = sorted({m.split(\":\", 1)[0] for m in members})","+    statement = None","+    if is_event:","+        statement = (","+            f\"{len(members)} lost-communication codes across \"","+            f\"{len(modules_involved)} module(s) ({', '.join(modules_involved)}) \"","+            f\"share the scan at {window_at} -- mes.analysis's own family \"","+            \"rule: that is one power or bus event, not \"","+            f\"{len(members)} separate module faults.\"","+        )","+    return {","+        \"codes\": code_rows, \"is_event\": is_event, \"window_at\": window_at,","+        \"modules_involved\": modules_involved, \"statement\": statement,","+    }","+","+","+# --- BCM \"check first\" checklist (the ``body_comfort`` system page) ---------","+","+def _bcm_check_first(vin: str, attested_map: dict[str, dict[str, Any]]","+                     ) -> list[dict[str, Any]]:","+    \"\"\"Battery -> BCM supply fuses -> BCM grounds -> connector, in that","+    order, reusing ``mes.electrical.network_check_first``'s own already-","+    placed elements -- the *same* path ``components.wiring_paths`` draws","+    for this page's own open network codes, never a second hand-picked","+    list -- then the one sourced CAN-C/IHS termination test last (the bus","+    is suspected only after supply/ground/connector are ruled out).\"\"\"","+    rows: list[dict[str, Any]] = []","+    try:","+        all_inspections = electrical_bridge.list_inspections(vin)","+    except Exception:  # noqa: BLE001","+        all_inspections = []","+    latest_by_el: dict[str, dict[str, Any]] = {}","+    for insp in all_inspections:","+        eid = insp.get(\"element\")","+        if not eid:","+            continue","+        if eid not in latest_by_el or (insp.get(\"at\") or \"\") > (latest_by_el[eid].get(\"at\") or \"\"):","+            latest_by_el[eid] = insp","+","+    def _row_for(el: dict[str, Any], group: str) -> dict[str, Any]:","+        eid = el.get(\"id\")","+        loc = el.get(\"location\") or {}","+        location_note_raw = loc.get(\"description\") or None","+        latest_insp = latest_by_el.get(eid)","+        return {","+            \"id\": eid, \"group\": group, \"label\": el.get(\"label\") or eid,","+            \"zone\": loc.get(\"zone\") or UNKNOWN_MARKER,","+            \"location_note\": location_note_raw or UNKNOWN_MARKER,","+            \"location_fact\": _fact(attested_map, f\"element:{eid}:location\", location_note_raw),","+            \"location_confidence\": loc.get(\"confidence\") or \"UNKNOWN\",","+            \"inspection_hint\": el.get(\"inspection_hint\") or UNKNOWN_MARKER,","+            \"latest_inspection\": ({","+                \"condition\": latest_insp.get(\"condition\"), \"at\": latest_insp.get(\"at\"),","+                \"by\": latest_insp.get(\"by\"),","+            } if latest_insp else None),","+            \"inspect_href\": f\"/v/{vin}/electrical?system={layout_bridge.canonical_system(el)}#el-{eid}\",","+            \"is_test\": False,","+        }","+","+    try:","+        battery = electrical_bridge.get_element(\"battery\")","+    except Exception:  # noqa: BLE001","+        battery = None","+    if battery:","+        rows.append(_row_for(battery, \"Battery terminals\"))","+","+    try:","+        from mes import electrical as electrical_mod2  # noqa: PLC0415","+        hops = electrical_mod2.network_check_first()","+    except Exception:  # noqa: BLE001","+        hops = []","+    _ROLE_GROUPS = {\"supply\": \"BCM supply fuse\", \"protection\": \"BCM supply fuse\",","+                    \"connector\": \"Connector condition\", \"ground\": \"BCM ground\"}","+    for hop in hops:","+        role = hop.get(\"role\")","+        group = _ROLE_GROUPS.get(role)","+        el = hop.get(\"details\")","+        if not group or not el:","+            continue  # \"controller\" (the BCM itself) is not a check-first row","+        rows.append(_row_for(el, group))","+","+    try:","+        from mes import mechanic_tests as _mech2  # noqa: PLC0415","+        can_test = _mech2.test(_CAN_TERMINATION_TEST_ID)","+    except Exception:  # noqa: BLE001","+        can_test = None","+    if can_test:","+        pcs = can_test.get(\"pass_criteria\") or []","+        spec_text = None","+        if pcs:","+            pc = pcs[0]","+            spec_text = f\"{pc.get('spec')} {pc.get('unit')}\".strip()","+        rows.append({","+            \"id\": _CAN_TERMINATION_TEST_ID, \"group\": \"CAN-C/IHS termination\",","+            \"label\": can_test.get(\"name\") or \"CAN bus resistance test\",","+            \"zone\": None, \"location_note\": None, \"location_fact\": None,","+            \"location_confidence\": None,","+            \"inspection_hint\": can_test.get(\"purpose\") or \"\",","+            \"spec_text\": spec_text,","+            \"latest_inspection\": None,","+            \"inspect_href\": f\"/v/{vin}/tests#test-{_CAN_TERMINATION_TEST_ID}\",","+            \"is_test\": True,","+        })","+    return rows","+","+","+# --- EVAP <-> network cross-reference (the ``evap`` system page) ------------","+","+def _evap_network_crossref(vin: str, corr: dict[str, Any]) -> Optional[dict[str, Any]]:","+    \"\"\"EVAP's own one-line pointer at the network event, built from the","+    *same* evap/network co-occurrence row ``systems_bridge.correlate``","+    already computes (``mes.systems.correlate``'s own ``reading`` sentence","+    carries \"{together} of {total} session(s)\" -- parsed back out here","+    rather than recomputed) -- never a new correlation, and worded as","+    correlation only (\"have appeared alongside\"), never a cause claim.\"\"\"","+    for row in corr.get(\"co_occurrence\") or []:","+        if {row.get(\"a\"), row.get(\"b\")} != {\"evap\", \"network\"}:","+            continue","+        together = row.get(\"sessions_together\")","+        m = re.search(r\"in (\\d+) of (\\d+) session\", row.get(\"reading\") or \"\")","+        total = int(m.group(2)) if m else None","+        if not together or not total:","+            continue","+        return {","+            \"sessions_together\": together, \"total_sessions\": total,","+            \"text\": (f\"Network codes have appeared alongside EVAP codes in \"","+                    f\"{together} of {total} sessions on this car; the \"","+                    \"fuel-level signal reaches the ECM over the bus — see \"","+                    \"the network event.\"),","+            \"href\": f\"/v/{vin}/systems/network\",","+        }","+    return None","+","+"," # --- the view model -----------------------------------------------------------"," "," def build_system_view(vin: str, key: str) -> Optional[dict[str, Any]]:"]},{"oldStart":641,"oldLines":6,"newStart":880,"newLines":17,"lines":["         freeze_frames_view.append({\"code\": ff.get(\"code\"), \"rows\": rows,","                                    \"href\": f\"/v/{vin}/code/{base}\"})"," ","+    # --- 11. network event / BCM check-first / EVAP<->network crossref -------","+    # Each is scoped to the one page it belongs on: the network event is a","+    # whole-car, cross-module picture that only makes sense on \"network\"","+    # itself; the check-first checklist is the BCM's own, on \"body_comfort\"","+    # (the system that holds the BCM, see systems_map_bridge._MODULE_SYSTEM);","+    # the crossref is EVAP's own pointer at the network page. A page outside","+    # its own scope gets the field's empty/`` None`` default, never a guess.","+    network_event = _network_event(vin) if key == \"network\" else None","+    bcm_check_first = _bcm_check_first(vin, attested_map) if key == \"body_comfort\" else []","+    evap_network_crossref = _evap_network_crossref(vin, corr) if key == \"evap\" else None","+","     return {","         \"key\": key, \"label\": label,","         \"status_strip\": status_strip,"]},{"oldStart":655,"oldLines":6,"newStart":905,"newLines":9,"lines":["         \"freeze_frames\": freeze_frames_view,","         \"live_mode06\": live_mode06,","         \"live_freeze_frames\": live_freeze,","+        \"network_event\": network_event,","+        \"bcm_check_first\": bcm_check_first,","+        \"evap_network_crossref\": evap_network_crossref,","         \"unknown_marker\": UNKNOWN_MARKER,","         \"attested_footnote\": (\"Mechanic inputs are attested claims, not car measurements: \""