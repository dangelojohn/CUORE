s\"]:\ndiff --git a/cuore/tests/check_job_ux.py b/cuore/tests/check_job_ux.py\nindex 9379489..8985d14 100644\n--- a/cuore/tests/check_job_ux.py\n+++ b/cuore/tests/check_job_ux.py\n@@ -33,6 +33,7 @@ import socket\n import subprocess\n import sys\n import tempfile\n+import shutil\n import time\n import urllib.request\n from pathlib import Path\n@@ -40,6 +41,38 @@ from pathlib import Path\n os.environ[\"CUORE_STATE_DIR\"] = tempfile.mkdtemp(prefix=\"cuore-check-jobux-\")\n os.environ.pop(\"CUORE_AUDIT_PATH\", None)\n \n+# MES_LOG_DIR: a read-only copy of the real MultiEcuScan corpus (never the\n+# real install dir itself -- this test must never write there), plus one\n+# synthetic scan this test owns. The corpus moves forward in real time as\n+# the mechanic keeps working this car -- P0456 was the one still-ACTIVE\n+# chronic EVAP code when fix item 1 below was written (2026-10-08), but by\n+# 2026-10-14 the real corpus's own later clears/rescans have carried every\n+# chronic code to STALE/CLEARED_UNVERIFIED (none left ACTIVE at all), which\n+# would make the ?codes= highlight check below untestable against the real\n+# corpus alone. One extra scan, dated after the newest real clear, that\n+# reports P0456 again -- the exact \"returned after clear\" shape the real\n+# corpus itself held on 2026-10-08/13 -- keeps this check deterministic\n+# without weakening it and without touching the real install's own files.\n+_REAL_MES_DIR = Path(r\"C:\\Program Files (x86)\\MultiEcuScan\")\n+_MES_LOG_DIR = Path(tempfile.mkdtemp(prefix=\"cuore-check-jobux-logs-\"))\n+os.environ[\"MES_LOG_DIR\"] = str(_MES_LOG_DIR)\n+if _REAL_MES_DIR.exists():\n+    for _f in _REAL_MES_DIR.iterdir():\n+        if _f.is_file():\n+            shutil.copyfile(_f, _MES_LOG_DIR / _f.name)\n+(_MES_LOG_DIR / \"SCAN_2610140800.txt\").write_text(\n+    \"Scan vehicle for available modules and check each module for errors...\\n\\n\"\n+    \"Engine / ECM\\n\"\n+    \"Magneti Marelli IAW 10JA CF6/EOBD Injection (2.0)\\n\"\n+    \"ISO Code: 00 01 50 40 18\\n\"\n+    f\"VIN code: {'ZASFAKPN5J7B88115'}\\n\"\n+    \"Hardware number: MM10JAHW232 - Ver: 00\\n\"\n+    \"Software number: P235QB39 - Ver: 0000\\n\"\n+    \"Errors found:\\n\"\n+    \"P0456-00 - Evaporation system leak\\n\",\n+    encoding=\"utf-8\",\n+)\n+\n ROOT = Path(__file__).resolve().parents[2]\n sys.path.insert(0, str(ROOT))\n \ndiff --git a/cuore/tests/check_liveboard_page.py b/cuore/tests/check_liveboard_page.py\nindex dcc4b61..2f1daad 100644\n--- a/cuore/tests/check_liveboard_page.py\n+++ b/cuore/tests/check_liveboard_page.py\n@@ -284,11 +284,13 @@ uvicorn.run(app, host=\"127.0.0.1\", port={port}, log_level=\"warning\")\n                     })\n                     # Cold-cache first request (vehicle bar off the real MES\n                     # corpus workup) plus the /api/liveboard fetch and the\n-                    # first demo tick.\n-                    time.sleep(3.0)\n-\n-                    # ---- check: demo mode renders >=5 groups with values ----\n-                    counts = cdp.eval_json(\n+                    # first demo tick -- a fixed sleep(3.0) here proved\n+                    # flaky as the real corpus grew (same lesson\n+                    # check_job_ux.py/check_electrical_page.py/\n+                    # check_feedback_page.py already took: a short poll is\n+                    # cheap and robust), so poll for window.CuoreLiveboard\n+                    # instead of guessing a fixed warmup time.\n+                    _counts_js = (\n                         \"(function(){\"\n                         \"var groups=document.querySelectorAll('.lb-group').length;\"\n                         \"var withVal=Array.prototype.filter.call(\"\n@@ -297,7 +299,15 @@ uvicorn.run(app, host=\"127.0.0.1\", port={port}, log_level=\"warning\")\n                         \"return JSON.stringify({groups:groups, withVal:withVal});\"\n                         \"})()\"\n                     )\n-                    counts = json.loads(counts) if counts else {}\n+                    _lb_deadline = time.time() + 20.0\n+                    counts: dict = {}\n+                    while time.time() < _lb_deadline:\n+                        if cdp.eval_json(\"!!window.CuoreLiveboard\") is True:\n+                            raw_counts = cdp.eval_json(_counts_js)\n+                            counts = json.loads(raw_counts) if raw_counts else {}\n+                            if counts.get(\"groups\", 0) >= 5 and counts.get(\"withVal\", 0) >= 5:\n+                                break\n+                        time.sleep(0.3)\n                     check(\"demo mode rendered a page (window.CuoreLiveboard present)\",\n                           cdp.eval_json(\"!!window.CuoreLiveboard\") is True)\n                     check(\"demo mode renders at least 5 groups\",\ndiff --git a/cuore/tests/check_mil.py b/cuore/tests/check_mil.py\nindex 4882469..81d013a 100644\n--- a/cuore/tests/check_mil.py\n+++ b/cuore/tests/check_mil.py\n@@ -250,12 +250,26 @@ _FALLBACK_READINESS = (\n     '\"data\": {\"since_clear\": {\"mil_on\": true, \"stored_dtc_count\": 1, '\n     '\"monitors\": [], \"all_complete\": true}}}'\n )\n+# PID $21 (distance travelled with the MIL commanded on), read from the car\n+# in the same session as the readiness observation above. As of d5f9f2d,\n+# dossier_bridge._mil_distance_km() no longer reads a hard-coded per-VIN\n+# literal -- it reads this straight out of a real ``pids_snapshot``/``pid``\n+# observation (``is_from_car`` -- a ``stream`` that starts with \"serial\").\n+# Baked in unconditionally (never conditioned on the real observations\n+# file), so this check stays deterministic whether or not a real PID $21\n+# read happens to be on file for 2026-10-13 on this machine.\n+_FALLBACK_PID21_DISTANCE = (\n+    '{\"at\": \"2026-10-13T20:03:05\", \"kind\": \"pids_snapshot\", \"vin\": \"' + VIN + '\", '\n+    '\"bus\": \"can_c\", \"cable\": \"none\", \"stream\": \"serial COM3@115200\", '\n+    '\"data\": {\"by_ecu\": {\"ECM\": {\"21\": {\"value\": 34, \"unit\": \"km\"}}}}}'\n+)\n if _REAL_OBSERVATIONS.exists():\n     _fixture_lines = [ln for ln in\n                       _REAL_OBSERVATIONS.read_text(encoding=\"utf-8\").splitlines()\n                       if '\"2026-10-13' in ln]\n else:\n     _fixture_lines = [_FALLBACK_READINESS]\n+_fixture_lines.append(_FALLBACK_PID21_DISTANCE)\n if _fixture_lines:\n     (Path(os.environ[\"CUORE_STATE_DIR\"]) / \"observations.jsonl\").write_text(\n         \"\\n\".join(_fixture_lines) + \"\\n\", encoding=\"utf-8\")\ndiff --git a/cuore/tests/check_system_page.py b/cuore/tests/check_system_page.py\nindex 07fad81..f157b67 100644\n--- a/cuore/tests/check_system_page.py\n+++ b/cuore/tests/check_system_page.py\n@@ -23,6 +23,21 @@ from pathlib import Path\n os.environ[\"CUORE_STATE_DIR\"] = tempfile.mkdtemp(prefix=\"cuore-check-system-\")\n os.environ.pop(\"CUORE_AUDIT_PATH\", None)\n \n+# Network-event / BCM check-first fixture: ``mes.live_obs.observations_path``\n+# picks the first *writable* CUORE_STATE_DIR candidate that already holds a\n+# file, else falls through to %PROGRAMDATA%\\cuore\\observations.jsonl. Copying\n+# just the 2026-10-13 lines (tonight's live module sweep: BCM U1713-2F\n+# failing now, U1765-86/U1736-87 history, IPC U1736-86/87, RFHUB B1040-64)\n+# into CUORE_STATE_DIR makes this fixture deterministic -- read-only against\n+# the real file, never modified, never relied on to still hold these exact\n+# lines next time it is read.\n+_REAL_OBSERVATIONS = Path(os.environ.get(\"PROGRAMDATA\", r\"C:\\ProgramData\")) / \"cuore\" / \"observations.jsonl\"\n+if _REAL_OBSERVATIONS.exists():\n+    _fixture_lines = [ln for ln in _REAL_OBSERVATIONS.read_text(encoding=\"utf-8\").splitlines()\n+                      if '\"2026-10-13' in ln]\n+    (Path(os.environ[\"CUORE_STATE_DIR\"]) / \"observations.jsonl\").write_text(\n+        \"\\n\".join(_fixture_lines) + (\"\\n\" if _fixture_lines else \"\"), encoding=\"utf-8\")\n+\n ROOT = Path(__file__).resolve().parents[2]\n sys.path.insert(0, str(ROOT))\n \n@@ -184,6 +199,61 @@ check(\"map page carries a scroll hint for the graph wrap\", \"sys-graph-hint\" in m\n check(\"the graph wrap stays scoped to overflow-x (never page-level overflow)\",\n      \"overflow-x\" in (ROOT / \"cuore\" / \"web\" / \"static\" / \"systems.css\").read_text(encoding=\"utf-8\"))\n \n+print(\"=== network event: U-codes across modules collapse into one event ===\")\n+network_resp = client.get(f\"/v/{VIN}/systems/network\")\n+check(\"network page responds 200\", network_resp.status_code == 200, str(network_resp.status_code))\n+check(\"network page shows U1713-2F\", \"U1713-2F\" in network_resp.text)\n+check(\"network page marks U1713-2F failing now\", \"failing now\" in network_resp.text)\n+check(\"network page gives U1713's FTB meaning (signal erratic)\",\n+     \"signal erratic\" in network_resp.text)\n+check(\"network page names the reporting modules (BCM/IPC/RFHUB)\",\n+     \"BCM\" in network_resp.text and \"IPC\" in network_resp.text and \"RFHUB\" in network_resp.text)\n+check(\"network page collapses >=3 comms codes into one event (mes.analysis wording)\",\n+     \"one power or bus event\" in network_resp.text)\n+\n+_ne_marker = \"Network event (\"\n+_ne_idx = network_resp.text.find(_ne_marker)\n+check(\"network page has a Network event section\", _ne_idx != -1)\n+if _ne_idx != -1:\n+    _ne_section = network_resp.text[_ne_idx:].split(\"</details>\", 1)[0]\n+    check(\"the network event section lists at least 3 codes\",\n+         _ne_section.count('class=\"sysd-row\"') >= 3, str(_ne_section.count('class=\"sysd-row\"')))\n+\n+print(\"=== U1713's fault tree: diagnostic order before suspecting the bus ===\")\n+check(\"network page's fault tree checks supply/ground/connector before the bus\",\n+     \"before suspecting the bus\" in network_resp.text)\n+check(\"that diagnostic-order line carries both confidence qualifiers\",\n+     \"CORROBORATED\" in network_resp.text and \"SINGLE-SOURCE\" in network_resp.text)\n+\n+print(\"=== BCM check-first checklist (body_comfort page) ===\")\n+check(\"body_comfort page has a Check first section\", \"Check first (\" in body_resp.text)\n+_cf_idx = body_resp.text.find(\"Check first (\")\n+if _cf_idx != -1:\n+    _cf_section = body_resp.text[_cf_idx:].split(\"</details>\", 1)[0]\n+    _cf_rows = _cf_section.count('class=\"sysd-row\"')\n+    check(\"BCM check-first checklist has >=5 rows\", _cf_rows >= 5, str(_cf_rows))\n+    check(\"check-first rows link to the inspection form or the test page\",\n+         \"Record inspection\" in _cf_section and \"Run test\" in _cf_section)\n+    check(\"check-first checklist includes the battery, a BCM ground and the CAN termination test\",\n+         \"Battery terminals\" in _cf_section and \"BCM ground\" in _cf_section\n+         and \"CAN-C/IHS termination\" in _cf_section)\n+else:\n+    check(\"BCM check-first checklist has >=5 rows\", False)\n+    check(\"check-first rows link to the inspection form or the test page\", False)\n+    check(\"check-first checklist includes the battery, a BCM ground and the CAN termination test\", False)\n+\n+print(\"=== EVAP <-> network cross-reference ===\")\n+_xref_re = re.compile(\n+    r\"Network codes have appeared alongside EVAP codes in (\\d+) of (\\d+) sessions on this car\")\n+_xref_match = _xref_re.search(evap_resp.text)\n+check(\"evap page shows the network/EVAP cross-reference line\", bool(_xref_match))\n+if _xref_match:\n+    together, total = int(_xref_match.group(1)), int(_xref_match.group(2))\n+    check(\"cross-reference counts are real (positive, together <= total)\",\n+         0 < together <= total, f\"{together} of {total}\")\n+check(\"evap cross-reference links to the network event, never claims a cause\",\n+     f'/v/{VIN}/systems/network' in evap_resp.text and \"the fuel-level signal reaches the ECM over the bus\" in evap_resp.text)\n+\n print()\n if failures:\n     print(f\"{len(failures)}/{checks} check(s) failed:\")\ndiff --git a/cuore/web/templates/tests.html b/cuore/web/templates/tests.html\nindex e191010..0ebc4c3 100644\n--- a/cuore/web/templates/tests.html\n+++ b/cuore/web/templates/tests.html\n@@ -61,9 +61,18 @@\n \n     {% if t.blocker %}\n     <div class=\"ts-blocker\">\n+      {% if t.blocker.window %}\n       Blocked: fuel level {{ t.blocker.level }}% is {{ t.blocker.direction }} the\n       {{ t.blocker.window[0] }}-{{ t.blocker.window[1] }}% EVAP verification window --\n       this test's result may not be meaningful until fuel level is back in range.\n+      {% else %}\n+      {# Review #6 item 2's \"stale fuel reading\" shape (tests_bridge.py's\n+         own comment: \"warns, it never hard-blocks\") -- no window/level/\n+         direction on this shape, only reason/at/source, so this never\n+         reads as a hard block. #}\n+      Note: {{ t.blocker.reason }}{% if t.blocker.at %} (fuel last read {{ t.blocker.at }}{% if t.blocker.source %} -- {{ t.blocker.source }}{% endif %}){% endif %} --\n+      this test's result may not be meaningful until the fuel reading is reverified.\n+      {% endif %}\n     </div>\n     {% endif %}","is_error":false}]},"uuid":"d524ce3c-e8e9-4449-9e89-430573842dfc","timestamp":"2026-10-14T15:33:39.995Z","toolUseResult":{"stdout":"diff --git a/cuore/tests/check_bench.py b/cuore/tests/check_bench.py\nindex a4bcffd..df69a80 100644\n--- a/cuore/tests/check_bench.py\n+++ b/cuore/tests/check_bench.py\n@@ -293,12 +293,21 @@ if bench[\"next_actions\"]:\n           str(checklist_store.get(VIN).get(fault_step_id)))\n \n # 4. preconditions show MES status\n+# Review #6 item 1: the precondition's own label now tracks the same\n+# mes_state/scanner_label() the \"Scanner:\" strip shows (was a static \"MES\n+# running\" that read backwards -- \"BLOCKED: MES running\" -- whenever MES\n+# was in fact not running), so the label text here is \"MES \" + whatever\n+# scanner_label() currently say