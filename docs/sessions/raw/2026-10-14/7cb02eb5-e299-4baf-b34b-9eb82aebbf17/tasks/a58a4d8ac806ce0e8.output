 <summary><h2 class=\"sysd-h\">Status</h2>\n+    {% for chip in mods_non_stock(vin) if mods_non_stock is defined %}<span class=\"chip chronic\" title=\"{{ chip.detail }}\">{{ chip.label }}</span>{% endfor %}\n+  </summary>\n   {% set ss = view.status_strip %}\n \n   {% if ss.codes %}\n@@ -126,6 +135,36 @@\n     {% if ss.last_evidence %}{{ ss.last_evidence }}{% else %}no evidence on file yet{% endif %}</p>\n </details>\n \n+{# --- 1b. network event (network system page only) ------------------------ #}\n+{% if view.network_event %}\n+<details class=\"panel sysd-section\" open data-fact=\"system:{{ view.key }}|network event\">\n+  <summary><h2 class=\"sysd-h\">Network event ({{ view.network_event.codes|length }})</h2></summary>\n+  {% set ne = view.network_event %}\n+  {% if ne.statement %}\n+  <p class=\"small\"><span class=\"chip status-active\">one power or bus event</span> {{ ne.statement }}</p>\n+  {% else %}\n+  <p class=\"small muted\">Fewer than three lost-communication codes share one scan window on this car right\n+    now -- not grouped into one event yet.</p>\n+  {% endif %}\n+  {% if ne.codes %}\n+  <ul class=\"sysd-list\">\n+    {% for c in ne.codes %}\n+    <li class=\"sysd-row\">\n+      <a class=\"chip-code sm\" href=\"/v/{{ vin }}/code/{{ c.code }}\">{{ c.full }}</a>\n+      <span class=\"small muted\">{{ c.module }}</span>\n+      <span class=\"chip {{ 'status-active' if c.status == 'failing now' else 'status-cleared_unverified' }}\">{{ c.status }}</span>\n+      {% if c.failure_type %}<span class=\"small muted\">{{ c.failure_type }}</span>{% endif %}\n+      <div class=\"small muted\">From the car: {{ c.car_first_seen or \"—\" }}\n+        {% if c.car_last_seen and c.car_last_seen != c.car_first_seen %}&rarr; {{ c.car_last_seen }}{% endif %}\n+        &middot; From MES logs: {{ c.mes_first_seen or \"no corpus history yet\" }}\n+        {% if c.mes_last_seen and c.mes_last_seen != c.mes_first_seen %}&rarr; {{ c.mes_last_seen }}{% endif %}</div>\n+  