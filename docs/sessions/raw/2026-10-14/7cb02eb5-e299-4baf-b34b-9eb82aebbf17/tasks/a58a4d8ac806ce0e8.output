{"parentUuid":"60eb66cf-3afe-449c-8cba-a717a93e524d","isSidechain":true,"promptId":"a817728b-4ce4-439e-8445-245c0462ba3d","agentId":"a58a4d8ac806ce0e8","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_016FRb7tomwZyYhmyQuumSYf","type":"tool_result","content":"1100\t        \"summary\": summary,\n1101\t        \"basis\": basis,\n1102\t        \"cleared_at\": cleared_at.split(\" \")[0] if cleared_at else None,\n1103\t        \"cleared_by\": cleared_by,\n1104\t        \"readiness\": readiness,\n1105\t        \"mil_on\": readiness.get(\"mil_on\") if readiness else None,\n1106\t        \"mil\": _build_mil_block(vin, cleared_at),\n1107\t        \"actions\": _verdict_actions(vin, enabled),\n1108\t    }\n1109\t\n1110\t\n1111\t# --- verdict.next_action -- the one-sentence \"what do I do right now\" -------\n1112\t#\n1113\t# Added for the bench page (cuore/services/bench_bridge.py): a mechanic\n1114\t# landing on a car should not have to read the verdict's basis list and the\n1115\t# open-work cards to work out what to actually do next. Nothing here is a\n1116\t# new judgement -- it just combines the verdict state already computed above\n1117\t# with the same fuel-out-of-window flag :func:`_build_freeze_frames` already\n1118\t# derives and the same open-work steps :func:`_build_open_work` already\n1119\t# orders, into the one sentence (plus a short ``blocker`` label and the\n1120\t# ``next_step_id`` it points at) the bench page's headline needs.\n1121\t\n1122\t\n1123\tdef _first_unchecked_step(open_work: list[dict[str, Any]]\n1124\t                          ) -> tuple[dict[str, Any] | None, dict[str, Any] | None]:\n1125\t    \"\"\"The first not-yet-done step across every open-work card, in the same\n1126\t    order the cards themselves are already in (curated families first, then\n1127\t    the generic ones) -- ``(card, step)``, or ``(None, None)`` if every step\n1128\t    on file is ticked.\"\"\"\n1129\t    for card in open_work:\n1130\t        for step in card.get(\"steps\") or []:\n1131\t            if not step.get(\"done\"):\n1132\t                return card, step\n1133\t    return None, None\n1134\t\n1135\t\n1136\tdef _step_bit(step: dict[str, Any] | None) -> str | None:\n1137\t    \"\"\"\"<step text> (<bulletin>)\" -- the fragment both the ACTIVE_FAULTS and\n1138\t    fuel-blocked UNVERIFIED_REPAIR sentences below quote verbatim.\"\"\"\n1139\t    if step is None:\n1140\t        return None\n1141\t    bulletin = step.get(\"ref\") or \"no bulletin on file\"\n1142\t    return f\"{step['text']} ({bulletin})\"\n1143\t\n1144\t\n1145\tdef _fuel_out_of_window(vin: str, freeze_frames: list[dict[str, Any]],\n1146\t                        readiness_at: str | None) -> dict[str, Any] | None:\n1147\t    \"\"\":func:`fuel_status` for this car, or ``None`` when there is no fuel\n1148\t    reading at all, or the reading is in-window. One gate value (Review #6\n1149\t    item 2), with the staleness flag :func:`_verdict_next_action` turns\n1150\t    into a warning instead of a hard block.\"\"\"\n1151\t    status = fuel_status(freeze_frames, vin=vin, readiness_at=readiness_at)\n1152\t    if status.get(\"direction\") is None:\n1153\t        return None\n1154\t    return status\n1155\t\n1156\t\n1157\tdef _verdict_next_action(vin: str, verdict: dict[str, Any],\n1158\t                         open_work: list[dict[str, Any]],\n1159\t                         freeze_frames: list[dict[str, Any]],\n1160\t                         mode06: dict[str, Any] | None = None\n1161\t                         ) -> tuple[str, str, str | None]:\n1162\t    \"\"\"``(next_action sentence, blocker label, next_step_id)`` for one\n1163\t    verdict. Never raises -- a missing open-work step or freeze frame just\n1164\t    means a shorter sentence, not a broken one.\"\"\"\n1165\t    state = verdict.get(\"state\")\n1166\t    _card, step = _first_unchecked_step(open_work)\n1167\t    step_id = step.get(\"id\") if step else None\n1168\t    bit = _step_bit(step)\n1169\t"}]},"uuid":"bb56df4b-e56d-43a9-9fe8-b83b699a9477","timestamp":"2026-10-14T15:33:20.906Z","toolUseResult":{"type":"text","file":{"filePath":"C:\\Users\\User\\mcp-servers\\cuore\\services\\dossier_bridge.py","content":"        \"summary\": summary,\n        \"basis\": basis,\n        \"cleared_at\": cleared_at.split(\" \")[0] if cleared_at else None,\n        \"cleared_by\": cleared_by,\n        \"readiness\": readiness,\n        \"mil_on\": readiness.get(\"mil_on\") if readiness else None,\n        \"mil\": _build_mil_block(vin, cleared_at),\n        \"actions\": _verdict_actions(vin, enabled),\n    }\n\n\n# --- verdict.next_action -- the one-sentence \"what do I do right now\" -------\n#\n# Added for the bench page (cuore/services/bench_bridge.py): a mechanic\n# landing on a car should not have to read the verdict's basis list and the\n# open-work cards to work out what to actually do next. Nothing here is a\n# new judgement -- it just combines the verdict state already computed above\n# with the same fuel-out-of-window flag :func:`_build_freeze_frames` already\n# derives and the same open-work steps :func:`_build_open_work` already\n# orders, into the one sentence (plus a short ``blocker`` label and the\n# ``next_step_id`` it points at) the bench page's headline needs.\n\n\ndef _first_unchecked_step(open_work: list[dict[str, Any]]\n                          ) -> tuple[dict[str, Any] | None, dict[str, Any] | None]:\n    \"\"\"The first not-yet-done step across every open-work card, in the same\n    order the cards themselves are already in (curated families first, then\n    the generic ones) -- ``(card, step)``, or ``(None, None)`` if every step\n    on file is ticked.\"\"\"\n    for card in open_work:\n        for step in card.get(\"steps\") or []:\n            if not step.get(\"done\"):\n                return card, step\n    return None, None\n\n\ndef _step_bit(step: dict[str, Any] | None) -> str | None:\n    \"\"\"\"<step text> (<bulletin>)\" -- the fragment both the ACTIVE_FAULTS and\n    fuel-blocked UNVERIFIED_REPAIR sentences below quote verbatim.\"\"\"\n    if step is None:\n        return None\n    bulletin = step.get(\"ref\") or \"no bulletin on file\"\n    return f\"{step['text']} ({bulletin})\"\n\n\ndef _fuel_out_of_window(vin: str, freeze_frames: list[dict[str, Any]],\n                        readiness_at: str | None) -> dict[str, Any] | None:\n    \"\"\":func:`fuel_status` for this car, or ``None`` when there is no fuel\n    reading at all, or the reading is in-window. One gate value (Review #6\n    item 2), with the staleness flag :func:`_verdict_next_action` turns\n    into a warning instead of a hard block.\"\"\"\n    status = fuel_status(freeze_frames, vin=vin, readiness_at=readiness_at)\n    if status.get(\"direction\") is None:\n        return None\n    return status\n\n\ndef _verdict_next_action(vin: str, verdict: dict[str, Any],\n                         open_work: list[dict[str, Any]],\n                         freeze_frames: list[dict[str, Any]],\n                         mode06: dict[str, Any] | None = None\n                         ) -> tuple[str, str, str | None]:\n    \"\"\"``(next_action sentence, blocker label, next_step_id)`` for one\n    verdict. Never raises -- a missing open-work step or freeze frame just\n    means a shorter sentence, not a broken one.\"\"\"\n    state = verdict.get(\"state\")\n    _card, step = _first_unchecked_step(open_work)\n    step_id = step.get(\"id\") if step else None\n    bit = _step_bit(step)\n","numLines":70,"startLine":1100,"totalLines":1795}},"sourceToolAssistantUUID":"60eb66cf-3afe-449c-8cba-a717a93e524d","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
