{"parentUuid":"d62dd6ae-16a8-4db7-bfaf-90a9a632561c","isSidechain":true,"agentId":"a13f3ca3e19263a03","message":{"model":"claude-sonnet-5","id":"msg_011Cg2WLrofF5zwKtRtipSxB","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01RzTZRLgHvggXSkvGTc3f67","name":"Read","input":{"file_path":"C:\\Users\\User\\mcp-servers\\cuore\\tests\\_edge_cleanup.py"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1831,"cache_read_input_tokens":63442,"cache_creation":{"ephemeral_5m_input_tokens":1831,"ephemeral_1h_input_tokens":0},"output_tokens":2,"service_tier":"standard","inference_geo":"global"},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_01RzTZRLgHvggXSkvGTc3f67":{"file_path":"C:\\Users\\User\\mcp-servers\\cuore\\tests\\_edge_cleanup.py"}},"serverClassifierRequest":"d64c7074-aa96-4b7d-94f2-0d9c15918d3e","apiBlockIndex":1,"requestId":"req_011Cg2WLrY3Uz1BxuqqseQcF","attributionAgent":"general-purpose","type":"assistant","uuid":"1825c833-71f9-4705-887b-6d865f723065","timestamp":"2026-10-14T17:15:21.766Z","effort":"high","perTurnEffort":null,"userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
{"parentUuid":"1825c833-71f9-4705-887b-6d865f723065","isSidechain":true,"promptId":"cc4dbf1e-79de-4dba-bef6-7dc85562f73f","agentId":"a13f3ca3e19263a03","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01RzTZRLgHvggXSkvGTc3f67","type":"tool_result","content":"1\t\"\"\"Stop every headless Edge process a test started.\n2\t\n3\tEdge detaches from the process the test launches (the launcher exits and the\n4\treal browser, GPU and renderer processes live on), so Popen.terminate() alone\n5\tleaked the whole browser: 43 test runs left 266 msedge.exe processes running\n6\t(found 2026-09-26). Each test uses its own throwaway --user-data-dir, so\n7\tevery process whose command line names that directory is ours to stop.\n8\t\"\"\"\n9\tfrom __future__ import annotations\n10\t\n11\timport subprocess\n12\tfrom pathlib import Path\n13\t\n14\t\n15\tdef kill_edge_profile(profile_dir: str | Path) -> int:\n16\t    \"\"\"Kill every msedge.exe whose command line contains ``profile_dir``.\n17\t    Returns how many were stopped. Never touches the user's own Edge, whose\n18\t    command line does not name a temp test profile.\"\"\"\n19\t    needle = str(profile_dir).replace(\"'\", \"''\")\n20\t    ps = (\"$n = '\" + needle + \"'; $k = 0; \"\n21\t          \"Get-CimInstance Win32_Process -Filter \\\"Name='msedge.exe'\\\" | \"\n22\t          \"Where-Object { $_.CommandLine -and $_.CommandLine.Contains($n) } | \"\n23\t          \"ForEach-Object { Stop-Process -Id $_.ProcessId -Force -ErrorAction SilentlyContinue; $k++ }; $k\")\n24\t    try:\n25\t        out = subprocess.run([\"powershell\", \"-NoProfile\", \"-Command\", ps],\n26\t                             capture_output=True, text=True, timeout=30).stdout.strip()\n27\t        return int(out or 0)\n28\t    except Exception:  # noqa: BLE001 -- cleanup must never fail a test run\n29\t        return 0\n30\t"}]},"uuid":"b569c35d-8459-46a2-a421-1d8e567a7bfd","timestamp":"2026-10-14T17:15:21.837Z","toolUseResult":{"type":"text","file":{"filePath":"C:\\Users\\User\\mcp-servers\\cuore\\tests\\_edge_cleanup.py","content":"\"\"\"Stop every headless Edge process a test started.\n\nEdge detaches from the process the test launches (the launcher exits and the\nreal browser, GPU and renderer processes live on), so Popen.terminate() alone\nleaked the whole browser: 43 test runs left 266 msedge.exe processes running\n(found 2026-09-26). Each test uses its own throwaway --user-data-dir, so\nevery process whose command line names that directory is ours to stop.\n\"\"\"\nfrom __future__ import annotations\n\nimport subprocess\nfrom pathlib import Path\n\n\ndef kill_edge_profile(profile_dir: str | Path) -> int:\n    \"\"\"Kill every msedge.exe whose command line contains ``profile_dir``.\n    Returns how many were stopped. Never touches the user's own Edge, whose\n    command line does not name a temp test profile.\"\"\"\n    needle = str(profile_dir).replace(\"'\", \"''\")\n    ps = (\"$n = '\" + needle + \"'; $k = 0; \"\n          \"Get-CimInstance Win32_Process -Filter \\\"Name='msedge.exe'\\\" | \"\n          \"Where-Object { $_.CommandLine -and $_.CommandLine.Contains($n) } | \"\n          \"ForEach-Object { Stop-Process -Id $_.ProcessId -Force -ErrorAction SilentlyContinue; $k++ }; $k\")\n    try:\n        out = subprocess.run([\"powershell\", \"-NoProfile\", \"-Command\", ps],\n                             capture_output=True, text=True, timeout=30).stdout.strip()\n        return int(out or 0)\n    except Exception:  # noqa: BLE001 -- cleanup must never fail a test run\n        return 0\n","numLines":30,"startLine":1,"totalLines":30}},"sourceToolAssistantUUID":"1825c833-71f9-4705-887b-6d865f723065","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
{"parentUuid":"b569c35d-8459-46a2-a421-1d8e567a7bfd","isSidechain":true,"agentId":"a13f3ca3e19263a03","message":{"model":"claude-sonnet-5","id":"msg_011Cg2WLrofF5zwKtRtipSxB","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01Ud1EuaqJnati2bnPazzuoi","name":"Read","input":{"file_path":"C:\\Users\\User\\mcp-servers\\cuore\\tests\\check_owner_page.py"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1831,"cache_read_input_tokens":63442,"cache_creation":{"ephemeral_5m_input_tokens":1831,"ephemeral_1h_input_tokens":0},"output_tokens":2,"service_tier":"standard","inference_geo":"global"},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_01Ud1EuaqJnati2bnPazzuoi":{"file_path":"C:\\Users\\User\\mcp-servers\\cuore\\tests\\check_owner_page.py"}},"serverClassifierRequest":"d64c7074-aa96-4b7d-94f2-0d9c15918d3e","apiBlockIndex":2,"requestId":"req_011Cg2WLrY3Uz1BxuqqseQcF","attributionAgent":"general-purpose","type":"assistant","uuid":"64545fcd-90ea-46ca-bfb5-51d3b26f9543","timestamp":"2026-10-14T17:15:22.219Z","effort":"high","perTurnEffort":null,"userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
{"parentUuid":"64545fcd-90ea-46ca-bfb5-51d3b26f9543","isSidechain":true,"promptId":"cc4dbf1e-79de-4dba-bef6-7dc85562f73f","agentId":"a13f3ca3e19263a03","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Ud1EuaqJnati2bnPazzuoi","type":"tool_result","content":"1\t\"\"\"Smoke checks for \"Tell CUORE\" (cuore/live/owner_events.py,\n2\tcuore/services/owner_events_bridge.py, cuore/api/owner_events.py,\n3\tcuore/web/owner_routes.py).\n4\t\n5\t``CUORE_STATE_DIR`` is pointed at a fresh tempdir BEFORE anything cuore/mes\n6\tis imported (same posture as ``check_feedback_page.py``). Neither\n7\t``cuore.web.owner_routes`` nor ``cuore.api.owner_events`` is wired into\n8\t``cuore.app`` yet -- ``app.py`` is owned by another agent -- so this\n9\tincludes them itself if ``create_app()`` did not already pick them up.\n10\t\n11\tTestClient only, no Edge, no subprocess server -- everything here runs\n12\tagainst one in-process app.\n13\t\n14\tRun:\n15\t    .venv/Scripts/python.exe cuore/tests/check_owner_page.py\n16\t\"\"\"\n17\t\n18\tfrom __future__ import annotations\n19\t\n20\timport io\n21\timport json\n22\timport os\n23\timport re\n24\timport sys\n25\timport tempfile\n26\tfrom datetime import datetime, timedelta\n27\tfrom pathlib import Path\n28\t\n29\tos.environ[\"CUORE_STATE_DIR\"] = tempfile.mkdtemp(prefix=\"cuore-check-owner-page-\")\n30\tos.environ.pop(\"CUORE_AUDIT_PATH\", None)\n31\t\n32\tROOT = Path(__file__).resolve().parents[2]\n33\tsys.path.insert(0, str(ROOT))\n34\t\n35\tfrom fastapi.testclient import TestClient  # noqa: E402\n36\t\n37\tfrom cuore.app import create_app  # noqa: E402\n38\tfrom cuore.web import owner_routes  # noqa: E402\n39\tfrom cuore.api import owner_events as owner_events_api  # noqa: E402\n40\tfrom cuore.live import owner_events as store  # noqa: E402\n41\tfrom cuore.services import mes_bridge, systems_bridge  # noqa: E402\n42\t\n43\tVIN = \"ZASFAKPN5J7B88115\"  # the Stelvio -- real corpus, has EVAP codes\n44\t\n45\tfailures: list[str] = []\n46\tchecks = 0\n47\t\n48\t\n49\tdef check(label: str, condition: bool, detail: str = \"\") -> None:\n50\t    global checks\n51\t    checks += 1\n52\t    if not condition:\n53\t        failures.append(f\"{label}{(' -- ' + detail) if detail else ''}\")\n54\t\n55\t\n56\tdef _app_with_router():\n57\t    app = create_app()\n58\t    if not any(getattr(r, \"path\", \"\") == \"/m/{vin}\" for r in app.routes):\n59\t        app.include_router(owner_routes.router)\n60\t    if not any(getattr(r, \"path\", \"\") == \"/owner/{vin}/taxonomy\" for r in app.routes):\n61\t        app.include_router(owner_events_api.router, prefix=\"/api\")\n62\t    return app\n63\t\n64\t\n65\tclient = TestClient(_app_with_router())\n66\t\n67\tVALID_SYSTEM_KEYS = set(systems_bridge.systems().keys())\n68\t\n69\t\n70\t# === 1. taxonomy shape =======================================================\n71\t\n72\ttax = store.TAXONOMY\n73\tcheck(\"taxonomy has at least 8 categories\", len(tax) >= 8, str(len(tax)))\n74\ttotal_kinds = sum(len(c[\"kinds\"]) for c in tax.values())\n75\tcheck(\"taxonomy has at least 40 kinds\", total_kinds >= 40, str(total_kinds))\n76\t\n77\tbad_systems = []\n78\tfor cat_key, cat in tax.items():\n79\t    for kind_key, kd in cat[\"kinds\"].items():\n80\t        for sys_key in kd[\"systems\"]:\n81\t            if sys_key not in VALID_SYSTEM_KEYS:\n82\t                bad_systems.append(f\"{cat_key}/{kind_key}: {sys_key}\")\n83\tcheck(\"every kind's systems are valid mes.systems keys\", not bad_systems, \"; \".join(bad_systems))\n84\t\n85\tr = client.get(f\"/api/owner/{VIN}/taxonomy\")\n86\tcheck(\"taxonomy API responds 200\", r.status_code == 200, str(r.status_code))\n87\tcheck(\"taxonomy API carries the same category count\",\n88\t      len(r.json()[\"categories\"]) == len(tax))\n89\t\n90\t\n91\t# === 2. POST fill-up, stores and shows on history with \"reported\" label =====\n92\t\n93\tr = client.post(f\"/api/owner/{VIN}/events\", json={\n94\t    \"category\": \"fuel\", \"kind\": \"fill_up\", \"by_role\": \"owner\",\n95\t    \"fields\": {\"octane\": \"91\", \"cap_clicked\": False, \"litres\": 42.0},\n96\t})\n97\tcheck(\"fill-up POST responds 200\", r.status_code == 200, str(r.status_code))\n98\tfillup = r.json()\n99\tcheck(\"stored kind is fill_up\", fillup.get(\"kind\") == \"fill_up\")\n100\tcheck(\"stored confidence is 'reported'\", fillup.get(\"confidence\") == \"reported\")\n101\tfillup_id = fillup.get(\"id\")\n102\tcheck(\"fill-up got an id\", bool(fillup_id))\n103\t\n104\tr = client.get(f\"/m/{VIN}/history\")\n105\tcheck(\"history page responds 200\", r.status_code == 200, str(r.status_code))\n106\tcheck(\"history shows the fill-up\", \"Fill-up\" in r.text)\n107\tcheck(\"history shows the 'reported' badge\", \"reported\" in r.text.lower())\n108\t\n109\t\n110\t# === 3. bad kind -> 400 ======================================================\n111\t\n112\tr = client.post(f\"/api/owner/{VIN}/events\", json={\n113\t    \"category\": \"fuel\", \"kind\": \"not_a_real_kind\", \"by_role\": \"owner\", \"fields\": {},\n114\t})\n115\tcheck(\"unknown kind returns 400\", r.status_code == 400, str(r.status_code))\n116\t\n117\tr = client.post(f\"/api/owner/{VIN}/events\", json={\n118\t    \"category\": \"not_a_real_category\", \"kind\": \"fill_up\", \"by_role\": \"owner\", \"fields\": {},\n119\t})\n120\tcheck(\"unknown category returns 400\", r.status_code == 400, str(r.status_code))\n121\t\n122\t\n123\t# === 4. correlation: the fill-up as \"possible link\" for an EVAP code ========\n124\t\n125\tevap_code = None\n126\tevap_at = None\n127\ttry:\n128\t    dossier = mes_bridge.workup(vin=VIN)\n129\t    history = dossier.get(\"history\") or {}\n130\t    for bucket in (\"chronic\", \"returned_after_clear\", \"seen_once\"):\n131\t        for rec in history.get(bucket, []):\n132\t            code = (rec.get(\"dtc\") or \"\").split(\"-\")[0].strip().upper()\n133\t            hits = systems_bridge.systems_for_code(code)\n134\t            if any(h.get(\"system\") == \"evap\" for h in hits):\n135\t                occs = sorted(rec.get(\"occurrences\", []), key=lambda o: o.get(\"timestamp\") or \"\")\n136\t                if occs and occs[0].get(\"timestamp\"):\n137\t                    evap_code, evap_at = code, occs[0][\"timestamp\"]\n138\t                    break\n139\t        if evap_code:\n140\t            break\n141\texcept Exception as exc:  # noqa: BLE001\n142\t    check(\"could read this VIN's DTC history to find an EVAP code\", False,\n143\t          f\"{type(exc).__name__}: {exc}\")\n144\t\n145\tif evap_code and evap_at:\n146\t    near_at = (datetime.strptime(evap_at[:19].replace(\"T\", \" \"), \"%Y-%m-%d %H:%M:%S\")\n147\t              - timedelta(days=2)).isoformat(timespec=\"seconds\")\n148\t    r = client.post(f\"/api/owner/{VIN}/events\", json={\n149\t        \"category\": \"fuel\", \"kind\": \"fill_up\", \"by_role\": \"owner\", \"at\": near_at,\n150\t        \"fields\": {\"octane\": \"91\", \"cap_clicked\": False},\n151\t    })\n152\t    check(\"second (near-EVAP-code) fill-up POST responds 200\", r.status_code == 200,\n153\t          str(r.status_code))\n154\t\n155\t    r = client.get(f\"/api/owner/{VIN}/correlations\")\n156\t    check(\"correlations endpoint responds 200\", r.status_code == 200, str(r.status_code))\n157\t    corr = r.json().get(\"correlations\", [])\n158\t    hit = next((c for c in corr if c.get(\"code\") == evap_code), None)\n159\t    check(f\"correlation found for {evap_code}\", hit is not None, str(corr)[:300])\n160\t    if hit:\n161\t        check(\"correlation is worded 'owner-reported, possible link', never 'cause'\",\n162\t              hit.get(\"note\") == \"owner-reported, possible link\")\n163\t        check(\"correlation carries the near fill-up event\",\n164\t              any(e.get(\"kind\") == \"fill_up\" for e in hit.get(\"owner_events\", [])))\n165\telse:\n166\t    check(\"found an EVAP code with a dated occurrence on this VIN to correlate against\",\n167\t          False, \"no EVAP-implicated code found in this VIN's corpus\")\n168\t\n169\t\n170\t# === 5. messages: a CUORE prompt for an active EVAP code ====================\n171\t\n172\tr = client.get(f\"/api/owner/{VIN}/messages\")\n173\tcheck(\"messages endpoint responds 200\", r.status_code == 200, str(r.status_code))\n174\tmsgs = r.json().get(\"messages\", [])\n175\tcheck(\"at least one message exists\", len(msgs) > 0, str(len(msgs)))\n176\tcuore_prompts = [m for m in msgs if m.get(\"author\") == \"cuore\"]\n177\tcheck(\"messages include at least one CUORE-authored prompt\", len(cuore_prompts) > 0,\n178\t      str(msgs)[:300])\n179\tif evap_code:\n180\t    # Filed/deduped per (family, question_id), not per code (N5, fixed\n181\t    # 2026-10-14 -- see docs/research/MECHANIC_REVIEW_5_2026-10-14.md), so\n182\t    # this filters on the \"evap\" family section rather than the literal\n183\t    # code that triggered it.\n184\t    evap_prompt = [m for m in cuore_prompts if m.get(\"target\", {}).get(\"section\") == \"evap\"]\n185\t    check(f\"a CUORE prompt targets the EVAP family triggered by the active code {evap_code}\",\n186\t          len(evap_prompt) > 0, str(cuore_prompts)[:300])\n187\t\n188\tr = client.get(f\"/m/{VIN}/messages\")\n189\tcheck(\"messages page responds 200\", r.status_code == 200, str(r.status_code))\n190\t\n191\t\n192\t# === 6. reply stores ==========================================================\n193\t\n194\tif cuore_prompts:\n195\t    mid = cuore_prompts[0][\"id\"]\n196\t    r = client.post(f\"/api/owner/{VIN}/messages/{mid}/reply\",\n197\t                    json={\"text\": \"yes, filled up two days ago, cap clicked\", \"by\": \"owner\"})\n198\t    check(\"reply POST responds 200\", r.status_code == 200, str(r.status_code))\n199\t    check(\"reply stored under answer.text\",\n200\t          r.json().get(\"answer\", {}).get(\"text\", \"\").startswith(\"yes, filled up\"))\n201\t\n202\t    r = client.get(f\"/api/owner/{VIN}/messages\")\n203\t    replied = next((m for m in r.json()[\"messages\"] if m[\"id\"] == mid), None)\n204\t    check(\"message status is now answered\", replied is not None\n205\t          and replied.get(\"status\") == \"answered\", str(replied))\n206\t\n207\t\n208\t# === 7. /m/{vin} renders with the bottom nav, no desktop tab bar ============\n209\t\n210\tr = client.get(f\"/m/{VIN}\")\n211\tcheck(\"/m/{vin} responds 200\", r.status_code == 200, str(r.status_code))\n212\tcheck(\"mobile page carries the bottom nav\", \"m-bottomnav\" in r.text)\n213\tcheck(\"mobile page has no desktop vtabs strip\", 'class=\"vtabs\"' not in r.text)\n214\tcheck(\"mobile page carries the ATTESTED footer\", \"ATTESTED\" in r.text)\n215\tcheck(\"mobile page sets a phone viewport meta\",\n216\t      'name=\"viewport\"' in r.text and \"width=device-width\" in r.text)\n217\t\n218\t\n219\t# === 8. nothing under 12px in the mobile CSS (font sizes specifically --\n220\t# a 1px border or an 8px gap is normal layout, not the \"nothing under 12px\"\n221\t# rule, which is about text legibility) ======================================\n222\t\n223\tcss_path = ROOT / \"cuore\" / \"web\" / \"static\" / \"m.css\"\n224\tcss_text = css_path.read_text(encoding=\"utf-8\")\n225\t# TYPE_AND_UI_AUDIT_2026-10-14's foundation pass (R1) moved every font-size\n226\t# in this file from a raw px value onto the shared 7-step scale token --\n227\t# var(--fs-xs) is 12px, var(--fs-sm) 14px, and so on (cuore.css's :root).\n228\t# Recognise both forms so this 12px floor still means something.\n229\t_SCALE_PX = {\"xs\": 12, \"sm\": 14, \"md\": 16, \"lg\": 18, \"xl\": 20, \"2xl\": 22, \"3xl\": 28}\n230\tfont_sizes = re.findall(r\"font-size:\\s*(\\d+(?:\\.\\d+)?)px\", css_text)\n231\tfont_sizes += [str(_SCALE_PX[tok]) for tok in re.findall(r\"font-size:\\s*var\\(--fs-([a-z0-9]+)\\)\", css_text)]\n232\tcheck(\"m.css declares at least one font-size\", len(font_sizes) > 0)\n233\ttoo_small = [v for v in font_sizes if float(v) < 12]\n234\tcheck(\"no font-size in m.css is under 12px\", not too_small, str(too_small))\n235\t\n236\t\n237\t# --- remembered free-text fields (oil filter brand etc.), 2026-10-13 --------\n238\tdef _check_remembered_values() -> None:\n239\t    from cuore.live import owner_events as _store\n240\t    _store.add(VIN, \"fluids\", \"engine_oil_change\", by_role=\"mechanic\",\n241\t               fields={\"brand\": \"Selenia\", \"filter_brand\": \"UFI\", \"filter_part_no\": \"23.598.00\"})\n242\t    _store.add(\"OTHERVIN00000001\", \"fluids\", \"engine_oil_change\", by_role=\"mechanic\",\n243\t               fields={\"brand\": \"Petronas\", \"filter_brand\": \"Mann Filter\"})\n244\t    rv = _store.recent_values(VIN, \"engine_oil_change\", \"filter_brand\")\n245\t    check(\"remembered: this car's filter brand first, then the garage's\", rv[:2] == [\"UFI\", \"Mann Filter\"], str(rv))\n246\t    html = client.get(f\"/m/{VIN}/add/fluids/engine_oil_change\").text\n247\t    check(\"oil-change form: filter brand is open text with a datalist of last-used values\",\n248\t          'name=\"filter_brand\"' in html and 'list=\"dl-filter_brand\"' in html and \">UFI<\" in html)\n249\t    check(\"oil-change form: filter part number field present\", 'name=\"filter_part_no\"' in html)\n250\t\n251\t\n252\t_check_remembered_values()\n253\t\n254\t\n255\t# === 9. Mobile rebuild (2026-10-13): hero + quick actions + intro overlay ===\n256\t\n257\thome_html = client.get(f\"/m/{VIN}\").text\n258\tcheck(\"home responds with the four quick-action tiles\",\n259\t      home_html.count('class=\"m-quick-card') == 4, str(home_html.count('class=\"m-quick-card')))\n260\tfor label in (\"Fill-up\", \"Oil &amp; fluids\", \"Battery &amp; electrical\", \"Snap &amp; fill\"):\n261\t    check(f\"home shows the {label!r} quick action\", label in home_html)\n262\tcheck(\"home carries the opening-reveal overlay markup\",\n263\t      \"intro-overlay\" in home_html and 'id=\"intro-dismiss\"' in home_html)\n264\t\n265\t\n266\t# === 10. fill-up form: octane chip preselects the last used =================\n267\t\n268\tr = client.post(f\"/api/owner/{VIN}/events\", json={\n269\t    \"category\": \"fuel\", \"kind\": \"fill_up\", \"by_role\": \"owner\",\n270\t    \"fields\": {\"octane\": \"93\", \"cap_clicked\": True, \"litres\": 38.0, \"station\": \"Petro-Canada\"},\n271\t})\n272\tcheck(\"a second fill-up (octane 93) POST responds 200\", r.status_code == 200, str(r.status_code))\n273\t\n274\tfillup_form_html = client.get(f\"/m/{VIN}/add/fuel/fill_up\").text\n275\tcheck(\"fill-up form renders the octane chips\", 'name=\"octane\"' in fillup_form_html and \">93<\" in fillup_form_html)\n276\tcheck(\"fill-up form preselects the last-used octane (93), not the earlier 91\",\n277\t      'value=\"93\" checked' in fillup_form_html, fillup_form_html.count('checked'))\n278\tcheck(\"fill-up form preselects the last-used station (Petro-Canada)\",\n279\t      'value=\"Petro-Canada\"' in fillup_form_html)\n280\t\n281\t\n282\t# === 11. snap page: camera tile with capture=environment ====================\n283\t\n284\tsnap_html = client.get(f\"/m/{VIN}/snap\").text\n285\tcheck(\"snap page responds 200 and carries the camera file input\",\n286\t      'type=\"file\"' in snap_html and 'capture=\"environment\"' in snap_html\n287\t      and 'accept=\"image/*\"' in snap_html)\n288\tcheck(\"snap page offers the hint chips\", 'name=\"hint\"' in snap_html)\n289\t\n290\t\n291\t# === 12. HTML form path: source_octane=photo -> fields_meta.octane==\"photo\" =\n292\t\n293\tr = client.post(f\"/m/{VIN}/add/fuel/fill_up\", data={\n294\t    \"station\": \"Shell\", \"octane\": \"91\", \"litres\": \"40\", \"price\": \"60\",\n295\t    \"source_octane\": \"photo\",\n296\t}, follow_redirects=False)\n297\tcheck(\"fill-up form POST (source_octane=photo) redirects to the confirm screen\",\n298\t      r.status_code == 303 and \"/confirm/\" in r.headers.get(\"location\", \"\"),\n299\t      f\"{r.status_code} {r.headers.get('location')}\")\n300\t_confirm_event_id = r.headers.get(\"location\", \"\").rsplit(\"/\", 1)[-1]\n301\t_photo_event = next((e for e in store.load(VIN) if e.get(\"id\") == _confirm_event_id), None)\n302\tcheck(\"the stored event exists\", _photo_event is not None, _confirm_event_id)\n303\tif _photo_event:\n304\t    check(\"fields_meta.octane == 'photo' on the stored event\",\n305\t          (_photo_event.get(\"fields_meta\") or {}).get(\"octane\") == \"photo\",\n306\t          str(_photo_event.get(\"fields_meta\")))\n307\t\n308\tconfirm_html = client.get(r.headers.get(\"location\", \"\")).text\n309\tcheck(\"confirm screen (record card) responds and shows the photo chip\",\n310\t      \"m-card\" in confirm_html and \"m-chip-photo\" in confirm_html)\n311\t\n312\t\n313\t# === 13. JSON API: fields_meta accepted, validated to known field keys and\n314\t# to \"photo\"/\"typed\" values (the API-contract follow-up, 2026-10-13) ========\n315\t\n316\tr = client.post(f\"/api/owner/{VIN}/events\", json={\n317\t    \"category\": \"fuel\", \"kind\": \"fill_up\", \"by_role\": \"owner\",\n318\t    \"fields\": {\"octane\": \"89\", \"litres\": 10.0},\n319\t    \"fields_meta\": {\"octane\": \"photo\", \"not_a_real_field\": \"photo\", \"litres\": \"not-a-valid-value\"},\n320\t})\n321\tcheck(\"JSON API accepts a fields_meta body key\", r.status_code == 200, str(r.status_code))\n322\t_api_meta = (r.json().get(\"fields_meta\") or {})\n323\tcheck(\"JSON API stores fields_meta.octane == 'photo'\", _api_meta.get(\"octane\") == \"photo\", str(_api_meta))\n324\tcheck(\"JSON API drops a fields_meta key that isn't a real field of this kind\",\n325\t      \"not_a_real_field\" not in _api_meta, str(_api_meta))\n326\tcheck(\"JSON API drops a fields_meta value that isn't 'photo'/'typed'\",\n327\t      \"litres\" not in _api_meta, str(_api_meta))\n328\t\n329\t\n330\t# === 14. the vision endpoint now exists (wired by another agent) but still\n331\t# defaults to provider \"none\" -- the Snap page's own no-JS POST must not\n332\t# depend on it ever succeeding ===============================================\n333\t\n334\tvision_resp = client.post(f\"/api/vision/{VIN}/read\",\n335\t                          files={\"file\": (\"x.jpg\", b\"not a real jpeg\", \"image/jpeg\")},\n336\t                          data={\"hint\": \"fuel_pump\"})\n337\tcheck(\"vision endpoint responds 200 (default provider is 'none')\",\n338\t      vision_resp.status_code == 200, str(vision_resp.status_code))\n339\tcheck(\"default vision provider reports unavailable (no key configured)\",\n340\t      vision_resp.json().get(\"available\") is False, str(vision_resp.json()))\n341\t\n342\tsnap_post = client.post(f\"/m/{VIN}/snap\",\n343\t                        files={\"photo\": (\"pump.jpg\", b\"not a real jpeg\", \"image/jpeg\")},\n344\t                        data={\"hint\": \"fuel_pump\"}, follow_redirects=False)\n345\tcheck(\"snap POST (no JS, vision unavailable) still redirects somewhere useful\",\n346\t      snap_post.status_code == 303, str(snap_post.status_code))\n347\tcheck(\"snap's own fallback routes a fuel_pump hint straight to fuel/fill_up\",\n348\t      \"/add/fuel/fill_up\" in snap_post.headers.get(\"location\", \"\"),\n349\t      snap_post.headers.get(\"location\"))\n350\tcheck(\"the photo taken on the snap screen carries through as media_id\",\n351\t      \"media_id=\" in snap_post.headers.get(\"location\", \"\"))\n352\t\n353\t\n354\t# === 15. Edit (2026-10-13): PATCH octane 91 -> 94, history shows it, audit\n355\t# has one entry, fields_meta flips to typed for the edited key only ========\n356\t\n357\tr = client.post(f\"/api/owner/{VIN}/events\", json={\n358\t    \"category\": \"fuel\", \"kind\": \"fill_up\", \"by_role\": \"owner\",\n359\t    \"fields\": {\"octane\": \"91\", \"litres\": 40.0, \"cap_clicked\": True},\n360\t    \"fields_meta\": {\"octane\": \"photo\"},\n361\t})\n362\tcheck(\"fill-up to edit POSTs 200\", r.status_code == 200, str(r.status_code))\n363\tedit_id = r.json()[\"id\"]\n364\t\n365\tr = client.patch(f\"/api/owner/{VIN}/events/{edit_id}\", json={\n366\t    \"fields\": {\"octane\": \"94\"}, \"by_role\": \"mechanic\",\n367\t})\n368\tcheck(\"PATCH edit responds 200\", r.status_code == 200, str(r.status_code))\n369\tedited = r.json()\n370\t\n371\tr = client.get(f\"/api/owner/{VIN}/events\")\n372\tstored = next((e for e in r.json()[\"events\"] if e[\"id\"] == edit_id), None)\n373\tcheck(\"stored event now shows octane 94\", stored is not None\n374\t      and stored.get(\"fields\", {}).get(\"octane\") == \"94\", str(stored))\n375\tcheck(\"audit has exactly one entry\", stored is not None and len(stored.get(\"audit\") or []) == 1,\n376\t      str(stored.get(\"audit\") if stored else None))\n377\tif stored:\n378\t    entry = stored[\"audit\"][0]\n379\t    check(\"audit entry's by.role is the editor ('mechanic')\",\n380\t          entry.get(\"by\", {}).get(\"role\") == \"mechanic\", str(entry))\n381\t    check(\"audit entry records only the octane change\",\n382\t          list((entry.get(\"changes\", {}).get(\"fields\") or {}).keys()) == [\"octane\"], str(entry))\n383\t    check(\"fields_meta.octane flips to 'typed' (value actually changed)\",\n384\t          (stored.get(\"fields_meta\") or {}).get(\"octane\") == \"typed\", str(stored.get(\"fields_meta\")))\n385\tcheck(\"edited_at is set on the stored event\", stored is not None and stored.get(\"edited_at\"),\n386\t      str(stored.get(\"edited_at\") if stored else None))\n387\t\n388\tr = client.get(f\"/m/{VIN}/history\")\n389\tcheck(\"history page shows the edited octane (94)\", \"94\" in r.text)\n390\tcheck(\"history page shows the 'Edited' marker\", \"Edited\" in r.text)\n391\t\n392\t\n393\t# === 16. PATCH with an unknown field key -> 400 =============================\n394\t\n395\tr = client.patch(f\"/api/owner/{VIN}/events/{edit_id}\", json={\"fields\": {\"not_a_real_field\": \"x\"}})\n396\tcheck(\"PATCH with an unknown field key returns 400\", r.status_code == 400, str(r.status_code))\n397\t\n398\t\n399\t# === 17. PATCH on a deleted event -> 404 =====================================\n400\t\n401\tr = client.post(f\"/api/owner/{VIN}/events\", json={\n402\t    \"category\": \"fuel\", \"kind\": \"fill_up\", \"by_role\": \"owner\", \"fields\": {\"litres\": 20.0},\n403\t})\n404\tto_delete_id = r.json()[\"id\"]\n405\tr = client.delete(f\"/api/owner/{VIN}/events/{to_delete_id}\")\n406\tcheck(\"DELETE responds 200\", r.status_code == 200, str(r.status_code))\n407\t\n408\tr = client.patch(f\"/api/owner/{VIN}/events/{to_delete_id}\", json={\"fields\": {\"litres\": 25.0}})\n409\tcheck(\"PATCH on a deleted event returns 404\", r.status_code == 404, str(r.status_code))\n410\t\n411\tr = client.patch(f\"/api/owner/{VIN}/events/not-a-real-id\", json={\"fields\": {\"litres\": 25.0}})\n412\tcheck(\"PATCH on an unknown id returns 404\", r.status_code == 404, str(r.status_code))\n413\t\n414\t\n415\t# === 18. Edit via the HTML form: GET prefills, POST stores, history shows it,\n416\t# and the Delete-at-bottom web action soft-deletes with an Undo screen =======\n417\t\n418\tr = client.post(f\"/m/{VIN}/add/fuel/fill_up\", data={\n419\t    \"station\": \"Costco\", \"octane\": \"91\", \"litres\": \"35\", \"price\": \"50\",\n420\t}, follow_redirects=False)\n421\thtml_edit_id = r.headers.get(\"location\", \"\").rsplit(\"/\", 1)[-1]\n422\t\n423\tedit_form_html = client.get(f\"/m/{VIN}/edit/{html_edit_id}\").text\n424\tcheck(\"edit form responds and is titled 'Edit fill-up'\", \"Edit fill-up\" in edit_form_html)\n425\tcheck(\"edit form prefills the saved octane (91)\", 'value=\"91\" checked' in edit_form_html)\n426\tcheck(\"edit form carries a Delete action\", 'm-delete-btn' in edit_form_html\n427\t      and f\"/m/{VIN}/history/{html_edit_id}/delete\" in edit_form_html)\n428\tcheck(\"edit form carries a Cancel action\", \"Cancel\" in edit_form_html)\n429\t\n430\tr = client.post(f\"/m/{VIN}/edit/{html_edit_id}\", data={\n431\t    \"station\": \"Costco\", \"octane\": \"94\", \"litres\": \"35\", \"price\": \"50\",\n432\t    \"by_role\": \"owner\",\n433\t}, follow_redirects=False)\n434\tcheck(\"HTML edit form POST redirects to the edit confirm screen\",\n435\t      r.status_code == 303 and f\"/m/{VIN}/edit/{html_edit_id}/confirm\" in r.headers.get(\"location\", \"\"),\n436\t      f\"{r.status_code} {r.headers.get('location')}\")\n437\t\n438\tconfirm2 = client.get(r.headers.get(\"location\", \"\"))\n439\tcheck(\"edit confirm screen shows 'Edited' and the audit disclosure\",\n440\t      \"Edited\" in confirm2.text and \"m-audit\" in confirm2.text)\n441\t\n442\thtml_event = next((e for e in store.load(VIN) if e.get(\"id\") == html_edit_id), None)\n443\tcheck(\"HTML-form edit actually stored octane 94\",\n444\t      html_event is not None and html_event.get(\"fields\", {}).get(\"octane\") == \"94\",\n445\t      str(html_event))\n446\tcheck(\"HTML-form edit: litres/station/cap_clicked re-submitted unchanged add no spurious changes\",\n447\t      html_event is not None and len(html_event.get(\"audit\") or []) == 1\n448\t      and list((html_event[\"audit\"][0].get(\"changes\", {}).get(\"fields\") or {}).keys()) == [\"octane\"],\n449\t      str(html_event.get(\"audit\") if html_event else None))\n450\t\n451\tr = client.post(f\"/m/{VIN}/history/{html_edit_id}/delete\", follow_redirects=False)\n452\tcheck(\"web Delete action redirects to the deleted/Undo screen\",\n453\t      r.status_code == 303 and f\"/m/{VIN}/deleted/{html_edit_id}\" in r.headers.get(\"location\", \"\"),\n454\t      f\"{r.status_code} {r.headers.get('location')}\")\n455\tdeleted_html = client.get(r.headers.get(\"location\", \"\")).text\n456\tcheck(\"deleted screen offers Undo\", \"Undo\" in deleted_html)\n457\t\n458\tr = client.get(f\"/m/{VIN}/history\")\n459\tcheck(\"deleted event no longer shows on history\", html_edit_id not in r.text or \"Costco\" not in r.text)\n460\t\n461\tr = client.post(f\"/m/{VIN}/history/{html_edit_id}/restore\", follow_redirects=False)\n462\tcheck(\"Undo (restore) redirects back to history\", r.status_code == 303, str(r.status_code))\n463\trestored = next((e for e in store.load(VIN) if e.get(\"id\") == html_edit_id), None)\n464\tcheck(\"restore brings the event back (not deleted)\", restored is not None\n465\t      and not restored.get(\"deleted\"), str(restored))\n466\t\n467\t\n468\t# === 19. Scan-done message + live-scan EVAP/network prompts with one-tap\n469\t# chip answers (2026-10-14). Fixture: real ``obd_dtcs``/``mode06``/\n470\t# ``module_dtcs`` observation lines for this VIN, read verbatim from\n471\t# ``C:\\ProgramData\\cuore\\observations.jsonl`` at test time and appended to\n472\t# this test's own isolated ``CUORE_STATE_DIR`` -- the real file is only\n473\t# ever read, never written. ====================================================\n474\t\n475\t_REAL_OBSERVATIONS = Path(r\"C:\\ProgramData\\cuore\\observations.jsonl\")\n476\t\n477\t#: The 2026-10-13 ~20:02-20:03 cluster: P0440 stored/pending/permanent, the\n478\t#: readiness read that tags the cluster with this VIN, and the Mode 06 read\n479\t#: carrying MID 3A's (large-leak) failed row.\n480\t_SCAN_DONE_AT = {\"2026-10-13T20:02:56\", \"2026-10-13T20:02:57\", \"2026-10-13T20:02:58\",\n481\t                \"2026-10-13T20:03:00\", \"2026-10-13T20:03:54\"}\n482\t#: The later BCM module scan carrying the active U1713-2F network code.\n483\t_BCM_AT = {\"2026-10-13T20:24:25\"}\n484\t\n485\t\n486\tdef _copy_real_observation_lines(wanted_ats: set, ecu: str = \"\") -> list[str]:\n487\t    \"\"\"Verbatim JSON lines from the real observations file whose own\n488\t    ``at`` is in ``wanted_ats`` (and, when ``ecu`` is given, whose\n489\t    ``data.ecu`` matches -- the 20:24:25 timestamp carries five separate\n490\t    ``module_dtcs`` rows, one per ECU). Read-only: this never opens the\n491\t    real file for writing.\"\"\"\n492\t    if not _REAL_OBSERVATIONS.exists():\n493\t        return []\n494\t    out: list[str] = []\n495\t    for line in _REAL_OBSERVATIONS.read_text(encoding=\"utf-8\").splitlines():\n496\t        line = line.strip()\n497\t        if not line:\n498\t            continue\n499\t        try:\n500\t            obj = json.loads(line)\n501\t        except ValueError:\n502\t            continue\n503\t        if obj.get(\"at\") not in wanted_ats:\n504\t            continue\n505\t        if ecu and (obj.get(\"data\") or {}).get(\"ecu\") != ecu:\n506\t            continue\n507\t        out.append(line)\n508\t    return out\n509\t\n510\t\n511\tdef _append_test_observations(lines: list[str]) -> None:\n512\t    from cuore.live import store as live_store\n513\t    p = live_store.observations_path()\n514\t    p.parent.mkdir(parents=True, exist_ok=True)\n515\t    with p.open(\"a\", encoding=\"utf-8\") as f:\n516\t        for line in lines:\n517\t            f.write(line + \"\\n\")\n518\t\n519\t\n520\tdef _badge_count(html: str) -> \"int | None\":\n521\t    m = re.search(r'class=\"m-badge\">(\\d+)<', html)\n522\t    return int(m.group(1)) if m else None\n523\t\n524\t\n525\tscan_fixture_lines = _copy_real_observation_lines(_SCAN_DONE_AT)\n526\tcheck(\"fixture: found the real P0440 + Mode 06 (MID 3A) lines to copy\",\n527\t      len(scan_fixture_lines) == 5, str(len(scan_fixture_lines)))\n528\t_append_test_observations(scan_fixture_lines)\n529\t\n530\tr = client.get(f\"/api/owner/{VIN}/messages\")\n531\tcheck(\"messages endpoint responds 200 after the scan fixture\", r.status_code == 200, str(r.status_code))\n532\tmsgs = r.json()[\"messages\"]\n533\t\n534\tscan_msgs = [m for m in msgs if m.get(\"target\", {}).get(\"section\") == \"scan\"]\n535\tcheck(\"exactly one scan-done message was filed\", len(scan_msgs) == 1, str(scan_msgs)[:300])\n536\tscan_text = scan_msgs[0][\"text\"] if scan_msgs else \"\"\n537\t# 2026-10-14 honesty fix: this fixture's cluster (obd_dtcs/readiness/mode06\n538\t# only) carries no scan_coverage observation -- it is a manual, partial\n539\t# read, never a full bus sweep -- so the opening line must say \"Partial\n540\t# scan\", never claim a counted \"Scan 1 of 10\" that didn't happen.\n541\tcheck(\"scan-done message says 'Partial scan' (no scan_coverage observation \"\n542\t      \"on this cluster -- a manual read, not a counted scan)\",\n543\t      \"Partial scan\" in scan_text, scan_text)\n544\tcheck(\"scan-done message says 0 of 10 complete scans on file (this partial \"\n545\t      \"read doesn't count)\",\n546\t      \"0 of 10 complete scans\" in scan_text, scan_text)\n547\tcheck(\"scan-done message asks not to clear the light\", \"don't clear\" in scan_text, scan_text)\n548\tcheck(\"scan-done message names the fuel-vapour system not holding vacuum\",\n549\t      \"fuel-vapour\" in scan_text and \"vacuum\" in scan_text, scan_text)\n550\tcheck(\"scan-done message names the large-leak test, not small/gross\",\n551\t      \"large-leak\" in scan_text, scan_text)\n552\tcheck(\"scan-done message says nothing else failed\",\n553\t      \"Nothing else failed\" in scan_text, scan_text)\n554\tcheck(\"scan-done message points at the ESIM switch test next\",\n555\t      \"ESIM switch test\" in scan_text, scan_text)\n556\tcheck(\"scan-done message carries the EVAP owner actions (fill level/cap/overfill)\",\n557\t      \"cap\" in scan_text and \"top\" in scan_text, scan_text)\n558\tcheck(\"scan-done message never says 'cause' or 'fixed'\",\n559\t      \"cause\" not in scan_text.lower() and \"fixed\" not in scan_text.lower(), scan_text)\n560\t\n561\t# Re-reading must not refile the same scan's note a second time.\n562\tr2 = client.get(f\"/api/owner/{VIN}/messages\")\n563\tscan_msgs2 = [m for m in r2.json()[\"messages\"] if m.get(\"target\", {}).get(\"section\") == \"scan\"]\n564\tcheck(\"the scan-done message is deduped per scan id on a second read\",\n565\t      len(scan_msgs2) == 1, str(scan_msgs2)[:300])\n566\t\n567\tp0440_prompts = [m for m in msgs if m.get(\"author\") == \"cuore\"\n568\t                and m.get(\"target\", {}).get(\"section\") == \"evap\"]\n569\tcheck(\"a CUORE prompt fired for the evap family triggered by the active P0440\",\n570\t      len(p0440_prompts) >= 1, str(p0440_prompts)[:300])\n571\tfillup_prompt = next((m for m in p0440_prompts\n572\t                      if m.get(\"target\", {}).get(\"item\") == \"evap_fillup_recent\"), None)\n573\tcheck(\"the fill-up/cap/pump question fired for P0440\", fillup_prompt is not None,\n574\t      str(p0440_prompts)[:300])\n575\tif fillup_prompt:\n576\t    check(\"question covers fill-up, cap and pump-stop\",\n577\t          all(s in fillup_prompt[\"text\"] for s in (\"fill up\", \"cap\", \"pump\")),\n578\t          fillup_prompt[\"text\"])\n579\t    check(\"the open question carries its one-tap chips\",\n580\t          len(fillup_prompt.get(\"chips\") or []) >= 3, str(fillup_prompt.get(\"chips\")))\n581\t\n582\tr = client.get(f\"/m/{VIN}/messages\")\n583\tcheck(\"messages page responds 200 with the scan-done note and chips\",\n584\t      r.status_code == 200 and \"Partial scan\" in r.text and \"m-chip-btn\" in r.text,\n585\t      str(r.status_code))\n586\t\n587\t# --- the later BCM scan: U1713-2F (active) fires the network prompt --------\n588\t\n589\tbcm_fixture_lines = _copy_real_observation_lines(_BCM_AT, ecu=\"BCM\")\n590\tcheck(\"fixture: found the real BCM module_dtcs line (U1713-2F)\",\n591\t      len(bcm_fixture_lines) == 1, str(len(bcm_fixture_lines)))\n592\t_append_test_observations(bcm_fixture_lines)\n593\t\n594\tr = client.get(f\"/api/owner/{VIN}/messages\")\n595\tmsgs = r.json()[\"messages\"]\n596\tu1713_prompts = [m for m in msgs if m.get(\"author\") == \"cuore\"\n597\t                and m.get(\"target\", {}).get(\"section\") == \"network\"]\n598\tcheck(\"a CUORE prompt fired for the network family triggered by the active BCM code U1713\",\n599\t      len(u1713_prompts) >= 1, str(msgs)[:400])\n600\tnetwork_prompt = next((m for m in u1713_prompts\n601\t                       if m.get(\"target\", {}).get(\"item\") == \"network_recent_elec\"), None)\n602\tcheck(\"network prompt text covers aftermarket electrical, battery and car wash\",\n603\t      network_prompt is not None\n604\t      and all(s in network_prompt[\"text\"] for s in\n605\t             (\"aftermarket electrical\", \"Battery changed\", \"Car washed\")),\n606\t      str(network_prompt))\n607\t\n608\t# --- reply -> matching owner event, via the JSON API (EVAP chip) -----------\n609\t\n610\tif fillup_prompt:\n611\t    chip = next(c for c in fillup_prompt[\"chips\"] if c.get(\"category\"))\n612\t    open_before = sum(1 for m in msgs if m.get(\"status\") == \"open\")\n613\t    home_before = _badge_count(client.get(f\"/m/{VIN}\").text)\n614\t\n615\t    r = client.post(f\"/api/owner/{VIN}/messages/{fillup_prompt['id']}/reply\",\n616\t                    json={\"text\": chip[\"label\"], \"by\": \"owner\"})\n617\t    check(\"chip-answer reply (JSON API) responds 200\", r.status_code == 200, str(r.status_code))\n618\t    check(\"message is now answered\", r.json().get(\"status\") == \"answered\", str(r.json()))\n619\t\n620\t    r = client.get(f\"/api/owner/{VIN}/messages\")\n621\t    open_after = sum(1 for m in r.json()[\"messages\"] if m.get(\"status\") == \"open\")\n622\t    check(\"open/unread message count drops by 1 after the reply\",\n623\t          open_after == open_before - 1, f\"{open_before} -> {open_after}\")\n624\t    home_after = _badge_count(client.get(f\"/m/{VIN}\").text)\n625\t    check(\"home badge count drops by 1 after the reply\",\n626\t          home_before is not None and home_after == home_before - 1,\n627\t          f\"{home_before} -> {home_after}\")\n628\t\n629\t    new_event = next((e for e in store.load(VIN) if e.get(\"category\") == \"fuel\"\n630\t                      and e.get(\"kind\") == \"fill_up\"\n631\t                      and (e.get(\"fields\") or {}).get(\"cap_clicked\") is True\n632\t                      and (e.get(\"fields\") or {}).get(\"overfilled\") is False), None)\n633\t    check(\"the chip answer created the matching fuel/fill_up owner event\",\n634\t          new_event is not None, str(new_event))\n635\t\n636\t# --- reply -> matching owner event, via the HTML chip form (network chip) --\n637\t\n638\tif network_prompt and network_prompt.get(\"chips\"):\n639\t    chip2 = next(c for c in network_prompt[\"chips\"] if c.get(\"category\"))\n640\t    r = client.post(f\"/m/{VIN}/messages/{network_prompt['id']}/reply\",\n641\t                    data={\"text\": chip2[\"label\"], \"by\": \"mechanic\"},\n642\t                    follow_redirects=False)\n643\t    check(\"HTML chip-form reply redirects to messages#saved\",\n644\t          r.status_code == 303 and \"messages#saved\" in r.headers.get(\"location\", \"\"),\n645\t          f\"{r.status_code} {r.headers.get('location')}\")\n646\t    new_event2 = next((e for e in store.load(VIN)\n647\t                       if e.get(\"category\") == chip2[\"category\"]\n648\t                       and e.get(\"kind\") == chip2[\"kind\"]\n649\t                       and e.get(\"by\", {}).get(\"role\") == \"mechanic\"), None)\n650\t    check(f\"the network chip answer created a {chip2['category']}/{chip2['kind']} owner event\",\n651\t          new_event2 is not None, str(new_event2))\n652\t\n653\t\n654\t# === 20. Print label (2026-10-14): the oil-change/service label route off\n655\t# an owner event, reusing cuore.services.labels_bridge's own generator; the\n656\t# 48px button on the confirm card, History and the edit screen; a\n657\t# non-printable kind's clear 404. ============================================\n658\t\n659\tr = client.post(f\"/api/owner/{VIN}/events\", json={\n660\t    \"category\": \"fluids\", \"kind\": \"engine_oil_change\", \"by_role\": \"mechanic\",\n661\t    \"fields\": {\"brand\": \"Selenia\", \"viscosity\": \"5W-30\", \"qty\": 4.5,\n662\t              \"filter_changed\": True, \"filter_brand\": \"UFI\",\n663\t              \"filter_part_no\": \"23.598.00\"},\n664\t    \"odometer_km\": 123456,\n665\t})\n666\tcheck(\"oil-change POST (for the print test) responds 200\", r.status_code == 200,\n667\t      str(r.status_code))\n668\toil_event = r.json()\n669\toil_id = oil_event.get(\"id\")\n670\t\n671\tr = client.get(f\"/m/{VIN}/labels/{oil_id}\")\n672\tcheck(\"the label route responds 200 for a saved oil change\",\n673\t      r.status_code == 200, str(r.status_code))\n674\tcheck(\"the label route's content-type is application/pdf\",\n675\t      r.headers.get(\"content-type\", \"\").startswith(\"application/pdf\"),\n676\t      r.headers.get(\"content-type\"))\n677\tcheck(\"the label PDF starts with the %PDF header\", r.content[:5] == b\"%PDF-\",\n678\t      str(r.content[:5]))\n679\ttry:\n680\t    from pypdf import PdfReader\n681\t    label_text = PdfReader(io.BytesIO(r.content)).pages[0].extract_text()\n682\t    check(\"the printed label carries the filter brand (UFI)\", \"UFI\" in label_text,\n683\t          label_text)\n684\t    check(\"the printed label carries the filter part number\",\n685\t          \"23.598.00\" in label_text, label_text)\n686\texcept ImportError:\n687\t    check(\"pypdf available to verify label text content (optional)\", True)\n688\t\n689\tr = client.post(f\"/api/owner/{VIN}/events\", json={\n690\t    \"category\": \"fluids\", \"kind\": \"engine_oil_topup\", \"by_role\": \"owner\",\n691\t    \"fields\": {\"qty\": 0.5},\n692\t})\n693\tcheck(\"oil top-up POST (non-printable kind) responds 200\", r.status_code == 200,\n694\t      str(r.status_code))\n695\ttopup_id = r.json().get(\"id\")\n696\t\n697\tr = client.get(f\"/m/{VIN}/labels/{topup_id}\")\n698\tcheck(\"a non-printable kind's label route is 404\", r.status_code == 404,\n699\t      str(r.status_code))\n700\tcheck(\"the 404 names what IS printable, not just a bare 'not found'\",\n701\t      \"printable\" in r.json().get(\"detail\", \"\").lower(), str(r.json()))\n702\t\n703\tr = client.get(f\"/m/{VIN}/labels/not-a-real-id\")\n704\tcheck(\"an unknown event id's label route is 404\", r.status_code == 404, str(r.status_code))\n705\t\n706\tconfirm_href = f\"/m/{VIN}/add/fluids/engine_oil_change/confirm/{oil_id}\"\n707\tconfirm_html = client.get(confirm_href).text\n708\tcheck(\"the confirm card carries a Print label button for a printable kind\",\n709\t      \"Print label\" in confirm_html and f\"/m/{VIN}/labels/{oil_id}\" in confirm_html,\n710\t      confirm_href)\n711\t\n712\thistory_html = client.get(f\"/m/{VIN}/history\").text\n713\tcheck(\"the History page carries a Print label button for the oil-change entry\",\n714\t      \"Print label\" in history_html and f\"/m/{VIN}/labels/{oil_id}\" in history_html)\n715\t\n716\tedit_html = client.get(f\"/m/{VIN}/edit/{oil_id}\").text\n717\tcheck(\"the edit screen carries a Print label button\",\n718\t      \"Print label\" in edit_html and f\"/m/{VIN}/labels/{oil_id}\" in edit_html)\n719\t\n720\ttopup_edit_html = client.get(f\"/m/{VIN}/edit/{topup_id}\").text\n721\tcheck(\"the edit screen shows no Print label button for a non-printable kind\",\n722\t      \"Print label\" not in topup_edit_html)\n723\t\n724\tprint_list_html = client.get(f\"/m/{VIN}/print\").text\n725\tcheck(\"/m/{vin}/print responds 200 and lists the printable oil-change record\",\n726\t      f\"/m/{VIN}/labels/{oil_id}\" in print_list_html)\n727\tcheck(\"/m/{vin}/print offers at least one label-size chip\",\n728\t      'href=\"?size=' in print_list_html)\n729\t\n730\thome_html_print = client.get(f\"/m/{VIN}\").text\n731\tcheck(\"home's 'Everything else' carries a Print entry\",\n732\t      f\"/m/{VIN}/print\" in home_html_print and \">Print<\" in home_html_print)\n733\t\n734\tr_sized = client.get(f\"/m/{VIN}/labels/{oil_id}\", params={\"size\": \"avery_5520\"})\n735\tcheck(\"the label route accepts an explicit ?size= and still returns a PDF\",\n736\t      r_sized.status_code == 200 and r_sized.content[:5] == b\"%PDF-\",\n737\t      str(r_sized.status_code))\n738\tcheck(\"the label route remembers the last-used size via a cookie\",\n739\t      \"cuore_label_size\" in r_sized.cookies, dict(r_sized.cookies))\n740\t\n741\t# driveline_fluid prints as the dedicated \"transmission_service\" label kind\n742\t# (fluid spec/brand/pan-filter part no/fill temp), not the generic\n743\t# \"service\" kind -- see cuore.web.owner_routes._PRINTABLE_KINDS.\n744\tr = client.post(f\"/api/owner/{VIN}/events\", json={\n745\t    \"category\": \"fluids\", \"kind\": \"driveline_fluid\", \"by_role\": \"mechanic\",\n746\t    \"fields\": {\"which\": \"transmission\", \"fluid_spec\": \"ZF LifeguardFluid 8\",\n747\t              \"brand\": \"Mopar\", \"qty\": 9.0, \"pan_filter_part_no\": \"68227481AA\",\n748\t              \"fill_temp_c\": 38, \"method\": \"pan drop\"},\n749\t    \"odometer_km\": 80000,\n750\t})\n751\tcheck(\"driveline_fluid POST (for the print test) responds 200\", r.status_code == 200,\n752\t      str(r.status_code))\n753\tdriveline_id = r.json().get(\"id\")\n754\t\n755\tr = client.get(f\"/m/{VIN}/labels/{driveline_id}\")\n756\tcheck(\"the label route responds 200 for a saved driveline_fluid event\",\n757\t     r.status_code == 200, str(r.status_code))\n758\ttry:\n759\t    from pypdf import PdfReader as _PdfReader2\n760\t    tx_label_text = _PdfReader2(io.BytesIO(r.content)).pages[0].extract_text()\n761\t    check(\"the printed transmission label carries the fill temperature\",\n762\t         \"38\" in tx_label_text and \"30-50\" in tx_label_text, tx_label_text)\n763\t    check(\"the printed transmission label carries the fluid spec\",\n764\t         \"LifeguardFluid\" in tx_label_text, tx_label_text)\n765\t    check(\"the printed transmission label carries the pan/filter part number\",\n766\t         \"68227481AA\" in tx_label_text, tx_label_text)\n767\texcept ImportError:\n768\t    check(\"pypdf available to verify transmission label text (optional)\", True)\n769\t\n770\t\n771\tprint(f\"{checks} checks, {len(failures)} failures\")\n772\tfor f in failures:\n773\t    print(\" -\", f)\n774\tif failures:\n775\t    sys.exit(1)\n776\t"}]},"uuid":"8e93badf-d520-4b0a-bff3-18892fe6c97f","timestamp":"2026-10-14T17:15:22.429Z","toolUseResult":{"type":"text","file":{"filePath":"C:\\Users\\User\\mcp-servers\\cuore\\tests\\check_owner_page.py","content":"\"\"\"Smoke checks for \"Tell CUORE\" (cuore/live/owner_events.py,\ncuore/services/owner_events_bridge.py, cuore/api/owner_events.py,\ncuore/web/owner_routes.py).\n\n``CUORE_STATE_DIR`` is pointed at a fresh tempdir BEFORE anything cuore/mes\nis imported (same posture as ``check_feedback_page.py``). Neither\n``cuore.web.owner_routes`` nor ``cuore.api.owner_events`` is wired into\n``cuore.app`` yet -- ``app.py`` is owned by another agent -- so this\nincludes them itself if ``create_app()`` did not already pick them up.\n\nTestClient only, no Edge, no subprocess server -- everything here runs\nagainst one in-process app.\n\nRun:\n    .venv/Scripts/python.exe cuore/tests/check_owner_page.py\n\"\"\"\n\nfrom __future__ import annotations\n\nimport io\nimport json\nimport os\nimport re\nimport sys\nimport tempfile\nfrom datetime import datetime, timedelta\nfrom pathlib import Path\n\nos.environ[\"CUORE_STATE_DIR\"] = tempfile.mkdtemp(prefix=\"cuore-check-owner-page-\")\nos.environ.pop(\"CUORE_AUDIT_PATH\", None)\n\nROOT = Path(__file__).resolve().parents[2]\nsys.path.insert(0, str(ROOT))\n\nfrom fastapi.testclient import TestClient  # noqa: E402\n\nfrom cuore.app import create_app  # noqa: E402\nfrom cuore.web import owner_routes  # noqa: E402\nfrom cuore.api import owner_events as owner_events_api  # noqa: E402\nfrom cuore.live import owner_events as store  # noqa: E402\nfrom cuore.services import mes_bridge, systems_bridge  # noqa: E402\n\nVIN = \"ZASFAKPN5J7B88115\"  # the Stelvio -- real corpus, has EVAP codes\n\nfailures: list[str] = []\nchecks = 0\n\n\ndef check(label: str, condition: bool, detail: str = \"\") -> None:\n    global checks\n    checks += 1\n    if not condition:\n        failures.append(f\"{label}{(' -- ' + detail) if detail else ''}\")\n\n\ndef _app_with_router():\n    app = create_app()\n    if not any(getattr(r, \"path\", \"\") == \"/m/{vin}\" for r in app.routes):\n        app.include_router(owner_routes.router)\n    if not any(getattr(r, \"path\", \"\") == \"/owner/{vin}/taxonomy\" for r in app.routes):\n        app.include_router(owner_events_api.router, prefix=\"/api\")\n    return app\n\n\nclient = TestClient(_app_with_router())\n\nVALID_SYSTEM_KEYS = set(systems_bridge.systems().keys())\n\n\n# === 1. taxonomy shape =======================================================\n\ntax = store.TAXONOMY\ncheck(\"taxonomy has at least 8 categories\", len(tax) >= 8, str(len(tax)))\ntotal_kinds = sum(len(c[\"kinds\"]) for c in tax.values())\ncheck(\"taxonomy has at least 40 kinds\", total_kinds >= 40, str(total_kinds))\n\nbad_systems = []\nfor cat_key, cat in tax.items():\n    for kind_key, kd in cat[\"kinds\"].items():\n        for sys_key in kd[\"systems\"]:\n            if sys_key not in VALID_SYSTEM_KEYS:\n                bad_systems.append(f\"{cat_key}/{kind_key}: {sys_key}\")\ncheck(\"every kind's systems are valid mes.systems keys\", not bad_systems, \"; \".join(bad_systems))\n\nr = client.get(f\"/api/owner/{VIN}/taxonomy\")\ncheck(\"taxonomy API responds 200\", r.status_code == 200, str(r.status_code))\ncheck(\"taxonomy API carries the same category count\",\n      len(r.json()[\"categories\"]) == len(tax))\n\n\n# === 2. POST fill-up, stores and shows on history with \"reported\" label =====\n\nr = client.post(f\"/api/owner/{VIN}/events\", json={\n    \"category\": \"fuel\", \"kind\": \"fill_up\", \"by_role\": \"owner\",\n    \"fields\": {\"octane\": \"91\", \"cap_clicked\": False, \"litres\": 42.0},\n})\ncheck(\"fill-up POST responds 200\", r.status_code == 200, str(r.status_code))\nfillup = r.json()\ncheck(\"stored kind is fill_up\", fillup.get(\"kind\") == \"fill_up\")\ncheck(\"stored confidence is 'reported'\", fillup.get(\"confidence\") == \"reported\")\nfillup_id = fillup.get(\"id\")\ncheck(\"fill-up got an id\", bool(fillup_id))\n\nr = client.get(f\"/m/{VIN}/history\")\ncheck(\"history page responds 200\", r.status_code == 200, str(r.status_code))\ncheck(\"history shows the fill-up\", \"Fill-up\" in r.text)\ncheck(\"history shows the 'reported' badge\", \"reported\" in r.text.lower())\n\n\n# === 3. bad kind -> 400 ======================================================\n\nr = client.post(f\"/api/owner/{VIN}/events\", json={\n    \"category\": \"fuel\", \"kind\": \"not_a_real_kind\", \"by_role\": \"owner\", \"fields\": {},\n})\ncheck(\"unknown kind returns 400\", r.status_code == 400, str(r.status_code))\n\nr = client.post(f\"/api/owner/{VIN}/events\", json={\n    \"category\": \"not_a_real_category\", \"kind\": \"fill_up\", \"by_role\": \"owner\", \"fields\": {},\n})\ncheck(\"unknown category returns 400\", r.status_code == 400, str(r.status_code))\n\n\n# === 4. correlation: the fill-up as \"possible link\" for an EVAP code ========\n\nevap_code = None\nevap_at = None\ntry:\n    dossier = mes_bridge.workup(vin=VIN)\n    history = dossier.get(\"history\") or {}\n    for bucket in (\"chronic\", \"returned_after_clear\", \"seen_once\"):\n        for rec in history.get(bucket, []):\n            code = (rec.get(\"dtc\") or \"\").split(\"-\")[0].strip().upper()\n            hits = systems_bridge.systems_for_code(code)\n            if any(h.get(\"system\") == \"evap\" for h in hits):\n                occs = sorted(rec.get(\"occurrences\", []), key=lambda o: o.get(\"timestamp\") or \"\")\n                if occs and occs[0].get(\"timestamp\"):\n                    evap_code, evap_at = code, occs[0][\"timestamp\"]\n                    break\n        if evap_code:\n            break\nexcept Exception as exc:  # noqa: BLE001\n    check(\"could read this VIN's DTC history to find an EVAP code\", False,\n          f\"{type(exc).__name__}: {exc}\")\n\nif evap_code and evap_at:\n    near_at = (datetime.strptime(evap_at[:19].replace(\"T\", \" \"), \"%Y-%m-%d %H:%M:%S\")\n              - timedelta(days=2)).isoformat(timespec=\"seconds\")\n    r = client.post(f\"/api/owner/{VIN}/events\", json={\n        \"category\": \"fuel\", \"kind\": \"fill_up\", \"by_role\": \"owner\", \"at\": near_at,\n        \"fields\": {\"octane\": \"91\", \"cap_clicked\": False},\n    })\n    check(\"second (near-EVAP-code) fill-up POST responds 200\", r.status_code == 200,\n          str(r.status_code))\n\n    r = client.get(f\"/api/owner/{VIN}/correlations\")\n    check(\"correlations endpoint responds 200\", r.status_code == 200, str(r.status_code))\n    corr = r.json().get(\"correlations\", [])\n    hit = next((c for c in corr if c.get(\"code\") == evap_code), None)\n    check(f\"correlation found for {evap_code}\", hit is not None, str(corr)[:300])\n    if hit:\n        check(\"correlation is worded 'owner-reported, possible link', never 'cause'\",\n              hit.get(\"note\") == \"owner-reported, possible link\")\n        check(\"correlation carries the near fill-up event\",\n              any(e.get(\"kind\") == \"fill_up\" for e in hit.get(\"owner_events\", [])))\nelse:\n    check(\"found an EVAP code with a dated occurrence on this VIN to correlate against\",\n          False, \"no EVAP-implicated code found in this VIN's corpus\")\n\n\n# === 5. messages: a CUORE prompt for an active EVAP code ====================\n\nr = client.get(f\"/api/owner/{VIN}/messages\")\ncheck(\"messages endpoint responds 200\", r.status_code == 200, str(r.status_code))\nmsgs = r.json().get(\"messages\", [])\ncheck(\"at least one message exists\", len(msgs) > 0, str(len(msgs)))\ncuore_prompts = [m for m in msgs if m.get(\"author\") == \"cuore\"]\ncheck(\"messages include at least one CUORE-authored prompt\", len(cuore_prompts) > 0,\n      str(msgs)[:300])\nif evap_code:\n    # Filed/deduped per (family, question_id), not per code (N5, fixed\n    # 2026-10-14 -- see docs/research/MECHANIC_REVIEW_5_2026-10-14.md), so\n    # this filters on the \"evap\" family section rather than the literal\n    # code that triggered it.\n    evap_prompt = [m for m in cuore_prompts if m.get(\"target\", {}).get(\"section\") == \"evap\"]\n    check(f\"a CUORE prompt targets the EVAP family triggered by the active code {evap_code}\",\n          len(evap_prompt) > 0, str(cuore_prompts)[:300])\n\nr = client.get(f\"/m/{VIN}/messages\")\ncheck(\"messages page responds 200\", r.status_code == 200, str(r.status_code))\n\n\n# === 6. reply stores ==========================================================\n\nif cuore_prompts:\n    mid = cuore_prompts[0][\"id\"]\n    r = client.post(f\"/api/owner/{VIN}/messages/{mid}/reply\",\n                    json={\"text\": \"yes, filled up two days ago, cap clicked\", \"by\": \"owner\"})\n    check(\"reply POST responds 200\", r.status_code == 200, str(r.status_code))\n    check(\"reply stored under answer.text\",\n          r.json().get(\"answer\", {}).get(\"text\", \"\").startswith(\"yes, filled up\"))\n\n    r = client.get(f\"/api/owner/{VIN}/messages\")\n    replied = next((m for m in r.json()[\"messages\"] if m[\"id\"] == mid), None)\n    check(\"message status is now answered\", replied is not None\n          and replied.get(\"status\") == \"answered\", str(replied))\n\n\n# === 7. /m/{vin} renders with the bottom nav, no desktop tab bar ============\n\nr = client.get(f\"/m/{VIN}\")\ncheck(\"/m/{vin} responds 200\", r.status_code == 200, str(r.status_code))\ncheck(\"mobile page carries the bottom nav\", \"m-bottomnav\" in r.text)\ncheck(\"mobile page has no desktop vtabs strip\", 'class=\"vtabs\"' not in r.text)\ncheck(\"mobile page carries the ATTESTED footer\", \"ATTESTED\" in r.text)\ncheck(\"mobile page sets a phone viewport meta\",\n      'name=\"viewport\"' in r.text and \"width=device-width\" in r.text)\n\n\n# === 8. nothing under 12px in the mobile CSS (font sizes specifically --\n# a 1px border or an 8px gap is normal layout, not the \"nothing under 12px\"\n# rule, which is about text legibility) ======================================\n\ncss_path = ROOT / \"cuore\" / \"web\" / \"static\" / \"m.css\"\ncss_text = css_path.read_text(encoding=\"utf-8\")\n# TYPE_AND_UI_AUDIT_2026-10-14's foundation pass (R1) moved every font-size\n# in this file from a raw px value onto the shared 7-step scale token --\n# var(--fs-xs) is 12px, var(--fs-sm) 14px, and so on (cuore.css's :root).\n# Recognise both forms so this 12px floor still means something.\n_SCALE_PX = {\"xs\": 12, \"sm\": 14, \"md\": 16, \"lg\": 18, \"xl\": 20, \"2xl\": 22, \"3xl\": 28}\nfont_sizes = re.findall(r\"font-size:\\s*(\\d+(?:\\.\\d+)?)px\", css_text)\nfont_sizes += [str(_SCALE_PX[tok]) for tok in re.findall(r\"font-size:\\s*var\\(--fs-([a-z0-9]+)\\)\", css_text)]\ncheck(\"m.css declares at least one font-size\", len(font_sizes) > 0)\ntoo_small = [v for v in font_sizes if float(v) < 12]\ncheck(\"no font-size in m.css is under 12px\", not too_small, str(too_small))\n\n\n# --- remembered free-text fields (oil filter brand etc.), 2026-10-13 --------\ndef _check_remembered_values() -> None:\n    from cuore.live import owner_events as _store\n    _store.add(VIN, \"fluids\", \"engine_oil_change\", by_role=\"mechanic\",\n               fields={\"brand\": \"Selenia\", \"filter_brand\": \"UFI\", \"filter_part_no\": \"23.598.00\"})\n    _store.add(\"OTHERVIN00000001\", \"fluids\", \"engine_oil_change\", by_role=\"mechanic\",\n               fields={\"brand\": \"Petronas\", \"filter_brand\": \"Mann Filter\"})\n    rv = _store.recent_values(VIN, \"engine_oil_change\", \"filter_brand\")\n    check(\"remembered: this car's filter brand first, then the garage's\", rv[:2] == [\"UFI\", \"Mann Filter\"], str(rv))\n    html = client.get(f\"/m/{VIN}/add/fluids/engine_oil_change\").text\n    check(\"oil-change form: filter brand is open text with a datalist of last-used values\",\n          'name=\"filter_brand\"' in html and 'list=\"dl-filter_brand\"' in html and \">UFI<\" in html)\n    check(\"oil-change form: filter part number field present\", 'name=\"filter_part_no\"' in html)\n\n\n_check_remembered_values()\n\n\n# === 9. Mobile rebuild (2026-10-13): hero + quick actions + intro overlay ===\n\nhome_html = client.get(f\"/m/{VIN}\").text\ncheck(\"home responds with the four quick-action tiles\",\n      home_html.count('class=\"m-quick-card') == 4, str(home_html.count('class=\"m-quick-card')))\nfor label in (\"Fill-up\", \"Oil &amp; fluids\", \"Battery &amp; electrical\", \"Snap &amp; fill\"):\n    check(f\"home shows the {label!r} quick action\", label in home_html)\ncheck(\"home carries the opening-reveal overlay markup\",\n      \"intro-overlay\" in home_html and 'id=\"intro-dismiss\"' in home_html)\n\n\n# === 10. fill-up form: octane chip preselects the last used =================\n\nr = client.post(f\"/api/owner/{VIN}/events\", json={\n    \"category\": \"fuel\", \"kind\": \"fill_up\", \"by_role\": \"owner\",\n    \"fields\": {\"octane\": \"93\", \"cap_clicked\": True, \"litres\": 38.0, \"station\": \"Petro-Canada\"},\n})\ncheck(\"a second fill-up (octane 93) POST responds 200\", r.status_code == 200, str(r.status_code))\n\nfillup_form_html = client.get(f\"/m/{VIN}/add/fuel/fill_up\").text\ncheck(\"fill-up form renders the octane chips\", 'name=\"octane\"' in fillup_form_html and \">93<\" in fillup_form_html)\ncheck(\"fill-up form preselects the last-used octane (93), not the earlier 91\",\n      'value=\"93\" checked' in fillup_form_html, fillup_form_html.count('checked'))\ncheck(\"fill-up form preselects the last-used station (Petro-Canada)\",\n      'value=\"Petro-Canada\"' in fillup_form_html)\n\n\n# === 11. snap page: camera tile with capture=environment ====================\n\nsnap_html = client.get(f\"/m/{VIN}/snap\").text\ncheck(\"snap page responds 200 and carries the camera file input\",\n      'type=\"file\"' in snap_html and 'capture=\"environment\"' in snap_html\n      and 'accept=\"image/*\"' in snap_html)\ncheck(\"snap page offers the hint chips\", 'name=\"hint\"' in snap_html)\n\n\n# === 12. HTML form path: source_octane=photo -> fields_meta.octane==\"photo\" =\n\nr = client.post(f\"/m/{VIN}/add/fuel/fill_up\", data={\n    \"station\": \"Shell\", \"octane\": \"91\", \"litres\": \"40\", \"price\": \"60\",\n    \"source_octane\": \"photo\",\n}, follow_redirects=False)\ncheck(\"fill-up form POST (source_octane=photo) redirects to the confirm screen\",\n      r.status_code == 303 and \"/confirm/\" in r.headers.get(\"location\", \"\"),\n      f\"{r.status_code} {r.headers.get('location')}\")\n_confirm_event_id = r.headers.get(\"location\", \"\").rsplit(\"/\", 1)[-1]\n_photo_event = next((e for e in store.load(VIN) if e.get(\"id\") == _confirm_event_id), None)\ncheck(\"the stored event exists\", _photo_event is not None, _confirm_event_id)\nif _photo_event:\n    check(\"fields_meta.octane == 'photo' on the stored event\",\n          (_photo_event.get(\"fields_meta\") or {}).get(\"octane\") == \"photo\",\n          str(_photo_event.get(\"fields_meta\")))\n\nconfirm_html = client.get(r.headers.get(\"location\", \"\")).text\ncheck(\"confirm screen (record card) responds and shows the photo chip\",\n      \"m-card\" in confirm_html and \"m-chip-photo\" in confirm_html)\n\n\n# === 13. JSON API: fields_meta accepted, validated to known field keys and\n# to \"photo\"/\"typed\" values (the API-contract follow-up, 2026-10-13) ========\n\nr = client.post(f\"/api/owner/{VIN}/events\", json={\n    \"category\": \"fuel\", \"kind\": \"fill_up\", \"by_role\": \"owner\",\n    \"fields\": {\"octane\": \"89\", \"litres\": 10.0},\n    \"fields_meta\": {\"octane\": \"photo\", \"not_a_real_field\": \"photo\", \"litres\": \"not-a-valid-value\"},\n})\ncheck(\"JSON API accepts a fields_meta body key\", r.status_code == 200, str(r.status_code))\n_api_meta = (r.json().get(\"fields_meta\") or {})\ncheck(\"JSON API stores fields_meta.octane == 'photo'\", _api_meta.get(\"octane\") == \"photo\", str(_api_meta))\ncheck(\"JSON API drops a fields_meta key that isn't a real field of this kind\",\n      \"not_a_real_field\" not in _api_meta, str(_api_meta))\ncheck(\"JSON API drops a fields_meta value that isn't 'photo'/'typed'\",\n      \"litres\" not in _api_meta, str(_api_meta))\n\n\n# === 14. the vision endpoint now exists (wired by another agent) but still\n# defaults to provider \"none\" -- the Snap page's own no-JS POST must not\n# depend on it ever succeeding ===============================================\n\nvision_resp = client.post(f\"/api/vision/{VIN}/read\",\n                          files={\"file\": (\"x.jpg\", b\"not a real jpeg\", \"image/jpeg\")},\n                          data={\"hint\": \"fuel_pump\"})\ncheck(\"vision endpoint responds 200 (default provider is 'none')\",\n      vision_resp.status_code == 200, str(vision_resp.status_code))\ncheck(\"default vision provider reports unavailable (no key configured)\",\n      vision_resp.json().get(\"available\") is False, str(vision_resp.json()))\n\nsnap_post = client.post(f\"/m/{VIN}/snap\",\n                        files={\"photo\": (\"pump.jpg\", b\"not a real jpeg\", \"image/jpeg\")},\n                        data={\"hint\": \"fuel_pump\"}, follow_redirects=False)\ncheck(\"snap POST (no JS, vision unavailable) still redirects somewhere useful\",\n      snap_post.status_code == 303, str(snap_post.status_code))\ncheck(\"snap's own fallback routes a fuel_pump hint straight to fuel/fill_up\",\n      \"/add/fuel/fill_up\" in snap_post.headers.get(\"location\", \"\"),\n      snap_post.headers.get(\"location\"))\ncheck(\"the photo taken on the snap screen carries through as media_id\",\n      \"media_id=\" in snap_post.headers.get(\"location\", \"\"))\n\n\n# === 15. Edit (2026-10-13): PATCH octane 91 -> 94, history shows it, audit\n# has one entry, fields_meta flips to typed for the edited key only ========\n\nr = client.post(f\"/api/owner/{VIN}/events\", json={\n    \"category\": \"fuel\", \"kind\": \"fill_up\", \"by_role\": \"owner\",\n    \"fields\": {\"octane\": \"91\", \"litres\": 40.0, \"cap_clicked\": True},\n    \"fields_meta\": {\"octane\": \"photo\"},\n})\ncheck(\"fill-up to edit POSTs 200\", r.status_code == 200, str(r.status_code))\nedit_id = r.json()[\"id\"]\n\nr = client.patch(f\"/api/owner/{VIN}/events/{edit_id}\", json={\n    \"fields\": {\"octane\": \"94\"}, \"by_role\": \"mechanic\",\n})\ncheck(\"PATCH edit responds 200\", r.status_code == 200, str(r.status_code))\nedited = r.json()\n\nr = client.get(f\"/api/owner/{VIN}/events\")\nstored = next((e for e in r.json()[\"events\"] if e[\"id\"] == edit_id), None)\ncheck(\"stored event now shows octane 94\", stored is not None\n      and stored.get(\"fields\", {}).get(\"octane\") == \"94\", str(stored))\ncheck(\"audit has exactly one entry\", stored is not None and len(stored.get(\"audit\") or []) == 1,\n      str(stored.get(\"audit\") if stored else None))\nif stored:\n    entry = stored[\"audit\"][0]\n    check(\"audit entry's by.role is the editor ('mechanic')\",\n          entry.get(\"by\", {}).get(\"role\") == \"mechanic\", str(entry))\n    check(\"audit entry records only the octane change\",\n          list((entry.get(\"changes\", {}).get(\"fields\") or {}).keys()) == [\"octane\"], str(entry))\n    check(\"fields_meta.octane flips to 'typed' (value actually changed)\",\n          (stored.get(\"fields_meta\") or {}).get(\"octane\") == \"typed\", str(stored.get(\"fields_meta\")))\ncheck(\"edited_at is set on the stored event\", stored is not None and stored.get(\"edited_at\"),\n      str(stored.get(\"edited_at\") if stored else None))\n\nr = client.get(f\"/m/{VIN}/history\")\ncheck(\"history page shows the edited octane (94)\", \"94\" in r.text)\ncheck(\"history page shows the 'Edited' marker\", \"Edited\" in r.text)\n\n\n# === 16. PATCH with an unknown field key -> 400 =============================\n\nr = client.patch(f\"/api/owner/{VIN}/events/{edit_id}\", json={\"fields\": {\"not_a_real_field\": \"x\"}})\ncheck(\"PATCH with an unknown field key returns 400\", r.status_code == 400, str(r.status_code))\n\n\n# === 17. PATCH on a deleted event -> 404 =====================================\n\nr = client.post(f\"/api/owner/{VIN}/events\", json={\n    \"category\": \"fuel\", \"kind\": \"fill_up\", \"by_role\": \"owner\", \"fields\": {\"litres\": 20.0},\n})\nto_delete_id = r.json()[\"id\"]\nr = client.delete(f\"/api/owner/{VIN}/events/{to_delete_id}\")\ncheck(\"DELETE responds 200\", r.status_code == 200, str(r.status_code))\n\nr = client.patch(f\"/api/owner/{VIN}/events/{to_delete_id}\", json={\"fields\": {\"litres\": 25.0}})\ncheck(\"PATCH on a deleted event returns 404\", r.status_code == 404, str(r.status_code))\n\nr = client.patch(f\"/api/owner/{VIN}/events/not-a-real-id\", json={\"fields\": {\"litres\": 25.0}})\ncheck(\"PATCH on an unknown id returns 404\", r.status_code == 404, str(r.status_code))\n\n\n# === 18. Edit via the HTML form: GET prefills, POST stores, history shows it,\n# and the Delete-at-bottom web action soft-deletes with an Undo screen =======\n\nr = client.post(f\"/m/{VIN}/add/fuel/fill_up\", data={\n    \"station\": \"Costco\", \"octane\": \"91\", \"litres\": \"35\", \"price\": \"50\",\n}, follow_redirects=False)\nhtml_edit_id = r.headers.get(\"location\", \"\").rsplit(\"/\", 1)[-1]\n\nedit_form_html = client.get(f\"/m/{VIN}/edit/{html_edit_id}\").text\ncheck(\"edit form responds and is titled 'Edit fill-up'\", \"Edit fill-up\" in edit_form_html)\ncheck(\"edit form prefills the saved octane (91)\", 'value=\"91\" checked' in edit_form_html)\ncheck(\"edit form carries a Delete action\", 'm-delete-btn' in edit_form_html\n      and f\"/m/{VIN}/history/{html_edit_id}/delete\" in edit_form_html)\ncheck(\"edit form carries a Cancel action\", \"Cancel\" in edit_form_html)\n\nr = client.post(f\"/m/{VIN}/edit/{html_edit_id}\", data={\n    \"station\": \"Costco\", \"octane\": \"94\", \"litres\": \"35\", \"price\": \"50\",\n    \"by_role\": \"owner\",\n}, follow_redirects=False)\ncheck(\"HTML edit form POST redirects to the edit confirm screen\",\n      r.status_code == 303 and f\"/m/{VIN}/edit/{html_edit_id}/confirm\" in r.headers.get(\"location\", \"\"),\n      f\"{r.status_code} {r.headers.get('location')}\")\n\nconfirm2 = client.get(r.headers.get(\"location\", \"\"))\ncheck(\"edit confirm screen shows 'Edited' and the audit disclosure\",\n      \"Edited\" in confirm2.text and \"m-audit\" in confirm2.text)\n\nhtml_event = next((e for e in store.load(VIN) if e.get(\"id\") == html_edit_id), None)\ncheck(\"HTML-form edit actually stored octane 94\",\n      html_event is not None and html_event.get(\"fields\", {}).get(\"octane\") == \"94\",\n      str(html_event))\ncheck(\"HTML-form edit: litres/station/cap_clicked re-submitted unchanged add no spurious changes\",\n      html_event is not None and len(html_event.get(\"audit\") or []) == 1\n      and list((html_event[\"audit\"][0].get(\"changes\", {}).get(\"fields\") or {}).keys()) == [\"octane\"],\n      str(html_event.get(\"audit\") if html_event else None))\n\nr = client.post(f\"/m/{VIN}/history/{html_edit_id}/delete\", follow_redirects=False)\ncheck(\"web Delete action redirects to the deleted/Undo screen\",\n      r.status_code == 303 and f\"/m/{VIN}/deleted/{html_edit_id}\" in r.headers.get(\"location\", \"\"),\n      f\"{r.status_code} {r.headers.get('location')}\")\ndeleted_html = client.get(r.headers.get(\"location\", \"\")).text\ncheck(\"deleted screen offers Undo\", \"Undo\" in deleted_html)\n\nr = client.get(f\"/m/{VIN}/history\")\ncheck(\"deleted event no longer shows on history\", html_edit_id not in r.text or \"Costco\" not in r.text)\n\nr = client.post(f\"/m/{VIN}/history/{html_edit_id}/restore\", follow_redirects=False)\ncheck(\"Undo (restore) redirects back to history\", r.status_code == 303, str(r.status_code))\nrestored = next((e for e in store.load(VIN) if e.get(\"id\") == html_edit_id), None)\ncheck(\"restore brings the event back (not deleted)\", restored is not None\n      and not restored.get(\"deleted\"), str(restored))\n\n\n# === 19. Scan-done message + live-scan EVAP/network prompts with one-tap\n# chip answers (2026-10-14). Fixture: real ``obd_dtcs``/``mode06``/\n# ``module_dtcs`` observation lines for this VIN, read verbatim from\n# ``C:\\ProgramData\\cuore\\observations.jsonl`` at test time and appended to\n# this test's own isolated ``CUORE_STATE_DIR`` -- the real file is only\n# ever read, never written. ====================================================\n\n_REAL_OBSERVATIONS = Path(r\"C:\\ProgramData\\cuore\\observations.jsonl\")\n\n#: The 2026-10-13 ~20:02-20:03 cluster: P0440 stored/pending/permanent, the\n#: readiness read that tags the cluster with this VIN, and the Mode 06 read\n#: carrying MID 3A's (large-leak) failed row.\n_SCAN_DONE_AT = {\"2026-10-13T20:02:56\", \"2026-10-13T20:02:57\", \"2026-10-13T20:02:58\",\n                \"2026-10-13T20:03:00\", \"2026-10-13T20:03:54\"}\n#: The later BCM module scan carrying the active U1713-2F network code.\n_BCM_AT = {\"2026-10-13T20:24:25\"}\n\n\ndef _copy_real_observation_lines(wanted_ats: set, ecu: str = \"\") -> list[str]:\n    \"\"\"Verbatim JSON lines from the real observations file whose own\n    ``at`` is in ``wanted_ats`` (and, when ``ecu`` is given, whose\n    ``data.ecu`` matches -- the 20:24:25 timestamp carries five separate\n    ``module_dtcs`` rows, one per ECU). Read-only: this never opens the\n    real file for writing.\"\"\"\n    if not _REAL_OBSERVATIONS.exists():\n        return []\n    out: list[str] = []\n    for line in _REAL_OBSERVATIONS.read_text(encoding=\"utf-8\").splitlines():\n        line = line.strip()\n        if not line:\n            continue\n        try:\n            obj = json.loads(line)\n        except ValueError:\n            continue\n        if obj.get(\"at\") not in wanted_ats:\n            continue\n        if ecu and (obj.get(\"data\") or {}).get(\"ecu\") != ecu:\n            continue\n        out.append(line)\n    return out\n\n\ndef _append_test_observations(lines: list[str]) -> None:\n    from cuore.live import store as live_store\n    p = live_store.observations_path()\n    p.parent.mkdir(parents=True, exist_ok=True)\n    with p.open(\"a\", encoding=\"utf-8\") as f:\n        for line in lines:\n            f.write(line + \"\\n\")\n\n\ndef _badge_count(html: str) -> \"int | None\":\n    m = re.search(r'class=\"m-badge\">(\\d+)<', html)\n    return int(m.group(1)) if m else None\n\n\nscan_fixture_lines = _copy_real_observation_lines(_SCAN_DONE_AT)\ncheck(\"fixture: found the real P0440 + Mode 06 (MID 3A) lines to copy\",\n      len(scan_fixture_lines) == 5, str(len(scan_fixture_lines)))\n_append_test_observations(scan_fixture_lines)\n\nr = client.get(f\"/api/owner/{VIN}/messages\")\ncheck(\"messages endpoint responds 200 after the scan fixture\", r.status_code == 200, str(r.status_code))\nmsgs = r.json()[\"messages\"]\n\nscan_msgs = [m for m in msgs if m.get(\"target\", {}).get(\"section\") == \"scan\"]\ncheck(\"exactly one scan-done message was filed\", len(scan_msgs) == 1, str(scan_msgs)[:300])\nscan_text = scan_msgs[0][\"text\"] if scan_msgs else \"\"\n# 2026-10-14 honesty fix: this fixture's cluster (obd_dtcs/readiness/mode06\n# only) carries no scan_coverage observation -- it is a manual, partial\n# read, never a full bus sweep -- so the opening line must say \"Partial\n# scan\", never claim a counted \"Scan 1 of 10\" that didn't happen.\ncheck(\"scan-done message says 'Partial scan' (no scan_coverage observation \"\n      \"on this cluster -- a manual read, not a counted scan)\",\n      \"Partial scan\" in scan_text, scan_text)\ncheck(\"scan-done message says 0 of 10 complete scans on file (this partial \"\n      \"read doesn't count)\",\n      \"0 of 10 complete scans\" in scan_text, scan_text)\ncheck(\"scan-done message asks not to clear the light\", \"don't clear\" in scan_text, scan_text)\ncheck(\"scan-done message names the fuel-vapour system not holding vacuum\",\n      \"fuel-vapour\" in scan_text and \"vacuum\" in scan_text, scan_text)\ncheck(\"scan-done message names the large-leak test, not small/gross\",\n      \"large-leak\" in scan_text, scan_text)\ncheck(\"scan-done message says nothing else failed\",\n      \"Nothing else failed\" in scan_text, scan_text)\ncheck(\"scan-done message points at the ESIM switch test next\",\n      \"ESIM switch test\" in scan_text, scan_text)\ncheck(\"scan-done message carries the EVAP owner actions (fill level/cap/overfill)\",\n      \"cap\" in scan_text and \"top\" in scan_text, scan_text)\ncheck(\"scan-done message never says 'cause' or 'fixed'\",\n      \"cause\" not in scan_text.lower() and \"fixed\" not in scan_text.lower(), scan_text)\n\n# Re-reading must not refile the same scan's note a second time.\nr2 = client.get(f\"/api/owner/{VIN}/messages\")\nscan_msgs2 = [m for m in r2.json()[\"messages\"] if m.get(\"target\", {}).get(\"section\") == \"scan\"]\ncheck(\"the scan-done message is deduped per scan id on a second read\",\n      len(scan_msgs2) == 1, str(scan_msgs2)[:300])\n\np0440_prompts = [m for m in msgs if m.get(\"author\") == \"cuore\"\n                and m.get(\"target\", {}).get(\"section\") == \"evap\"]\ncheck(\"a CUORE prompt fired for the evap family triggered by the active P0440\",\n      len(p0440_prompts) >= 1, str(p0440_prompts)[:300])\nfillup_prompt = next((m for m in p0440_prompts\n                      if m.get(\"target\", {}).get(\"item\") == \"evap_fillup_recent\"), None)\ncheck(\"the fill-up/cap/pump question fired for P0440\", fillup_prompt is not None,\n      str(p0440_prompts)[:300])\nif fillup_prompt:\n    check(\"question covers fill-up, cap and pump-stop\",\n          all(s in fillup_prompt[\"text\"] for s in (\"fill up\", \"cap\", \"pump\")),\n          fillup_prompt[\"text\"])\n    check(\"the open question carries its one-tap chips\",\n          len(fillup_prompt.get(\"chips\") or []) >= 3, str(fillup_prompt.get(\"chips\")))\n\nr = client.get(f\"/m/{VIN}/messages\")\ncheck(\"messages page responds 200 with the scan-done note and chips\",\n      r.status_code == 200 and \"Partial scan\" in r.text and \"m-chip-btn\" in r.text,\n      str(r.status_code))\n\n# --- the later BCM scan: U1713-2F (active) fires the network prompt --------\n\nbcm_fixture_lines = _copy_real_observation_lines(_BCM_AT, ecu=\"BCM\")\ncheck(\"fixture: found the real BCM module_dtcs line (U1713-2F)\",\n      len(bcm_fixture_lines) == 1, str(len(bcm_fixture_lines)))\n_append_test_observations(bcm_fixture_lines)\n\nr = client.get(f\"/api/owner/{VIN}/messages\")\nmsgs = r.json()[\"messages\"]\nu1713_prompts = [m for m in msgs if m.get(\"author\") == \"cuore\"\n                and m.get(\"target\", {}).get(\"section\") == \"network\"]\ncheck(\"a CUORE prompt fired for the network family triggered by the active BCM code U1713\",\n      len(u1713_prompts) >= 1, str(msgs)[:400])\nnetwork_prompt = next((m for m in u1713_prompts\n                       if m.get(\"target\", {}).get(\"item\") == \"network_recent_elec\"), None)\ncheck(\"network prompt text covers aftermarket electrical, battery and car wash\",\n      network_prompt is not None\n      and all(s in network_prompt[\"text\"] for s in\n             (\"aftermarket electrical\", \"Battery changed\", \"Car washed\")),\n      str(network_prompt))\n\n# --- reply -> matching owner event, via the JSON API (EVAP chip) -----------\n\nif fillup_prompt:\n    chip = next(c for c in fillup_prompt[\"chips\"] if c.get(\"category\"))\n    open_before = sum(1 for m in msgs if m.get(\"status\") == \"open\")\n    home_before = _badge_count(client.get(f\"/m/{VIN}\").text)\n\n    r = client.post(f\"/api/owner/{VIN}/messages/{fillup_prompt['id']}/reply\",\n                    json={\"text\": chip[\"label\"], \"by\": \"owner\"})\n    check(\"chip-answer reply (JSON API) responds 200\", r.status_code == 200, str(r.status_code))\n    check(\"message is now answered\", r.json().get(\"status\") == \"answered\", str(r.json()))\n\n    r = client.get(f\"/api/owner/{VIN}/messages\")\n    open_after = sum(1 for m in r.json()[\"messages\"] if m.get(\"status\") == \"open\")\n    check(\"open/unread message count drops by 1 after the reply\",\n          open_after == open_before - 1, f\"{open_before} -> {open_after}\")\n    home_after = _badge_count(client.get(f\"/m/{VIN}\").text)\n    check(\"home badge count drops by 1 after the reply\",\n          home_before is not None and home_after == home_before - 1,\n          f\"{home_before} -> {home_after}\")\n\n    new_event = next((e for e in store.load(VIN) if e.get(\"category\") == \"fuel\"\n                      and e.get(\"kind\") == \"fill_up\"\n                      and (e.get(\"fields\") or {}).get(\"cap_clicked\") is True\n                      and (e.get(\"fields\") or {}).get(\"overfilled\") is False), None)\n    check(\"the chip answer created the matching fuel/fill_up owner event\",\n          new_event is not None, str(new_event))\n\n# --- reply -> matching owner event, via the HTML chip form (network chip) --\n\nif network_prompt and network_prompt.get(\"chips\"):\n    chip2 = next(c for c in network_prompt[\"chips\"] if c.get(\"category\"))\n    r = client.post(f\"/m/{VIN}/messages/{network_prompt['id']}/reply\",\n                    data={\"text\": chip2[\"label\"], \"by\": \"mechanic\"},\n                    follow_redirects=False)\n    check(\"HTML chip-form reply redirects to messages#saved\",\n          r.status_code == 303 and \"messages#saved\" in r.headers.get(\"location\", \"\"),\n          f\"{r.status_code} {r.headers.get('location')}\")\n    new_event2 = next((e for e in store.load(VIN)\n                       if e.get(\"category\") == chip2[\"category\"]\n                       and e.get(\"kind\") == chip2[\"kind\"]\n                       and e.get(\"by\", {}).get(\"role\") == \"mechanic\"), None)\n    check(f\"the network chip answer created a {chip2['category']}/{chip2['kind']} owner event\",\n          new_event2 is not None, str(new_event2))\n\n\n# === 20. Print label (2026-10-14): the oil-change/service label route off\n# an owner event, reusing cuore.services.labels_bridge's own generator; the\n# 48px button on the confirm card, History and the edit screen; a\n# non-printable kind's clear 404. ============================================\n\nr = client.post(f\"/api/owner/{VIN}/events\", json={\n    \"category\": \"fluids\", \"kind\": \"engine_oil_change\", \"by_role\": \"mechanic\",\n    \"fields\": {\"brand\": \"Selenia\", \"viscosity\": \"5W-30\", \"qty\": 4.5,\n              \"filter_changed\": True, \"filter_brand\": \"UFI\",\n              \"filter_part_no\": \"23.598.00\"},\n    \"odometer_km\": 123456,\n})\ncheck(\"oil-change POST (for the print test) responds 200\", r.status_code == 200,\n      str(r.status_code))\noil_event = r.json()\noil_id = oil_event.get(\"id\")\n\nr = client.get(f\"/m/{VIN}/labels/{oil_id}\")\ncheck(\"the label route responds 200 for a saved oil change\",\n      r.status_code == 200, str(r.status_code))\ncheck(\"the label route's content-type is application/pdf\",\n      r.headers.get(\"content-type\", \"\").startswith(\"application/pdf\"),\n      r.headers.get(\"content-type\"))\ncheck(\"the label PDF starts with the %PDF header\", r.content[:5] == b\"%PDF-\",\n      str(r.content[:5]))\ntry:\n    from pypdf import PdfReader\n    label_text = PdfReader(io.BytesIO(r.content)).pages[0].extract_text()\n    check(\"the printed label carries the filter brand (UFI)\", \"UFI\" in label_text,\n          label_text)\n    check(\"the printed label carries the filter part number\",\n          \"23.598.00\" in label_text, label_text)\nexcept ImportError:\n    check(\"pypdf available to verify label text content (optional)\", True)\n\nr = client.post(f\"/api/owner/{VIN}/events\", json={\n    \"category\": \"fluids\", \"kind\": \"engine_oil_topup\", \"by_role\": \"owner\",\n    \"fields\": {\"qty\": 0.5},\n})\ncheck(\"oil top-up POST (non-printable kind) responds 200\", r.status_code == 200,\n      str(r.status_code))\ntopup_id = r.json().get(\"id\")\n\nr = client.get(f\"/m/{VIN}/labels/{topup_id}\")\ncheck(\"a non-printable kind's label route is 404\", r.status_code == 404,\n      str(r.status_code))\ncheck(\"the 404 names what IS printable, not just a bare 'not found'\",\n      \"printable\" in r.json().get(\"detail\", \"\").lower(), str(r.json()))\n\nr = client.get(f\"/m/{VIN}/labels/not-a-real-id\")\ncheck(\"an unknown event id's label route is 404\", r.status_code == 404, str(r.status_code))\n\nconfirm_href = f\"/m/{VIN}/add/fluids/engine_oil_change/confirm/{oil_id}\"\nconfirm_html = client.get(confirm_href).text\ncheck(\"the confirm card carries a Print label button for a printable kind\",\n      \"Print label\" in confirm_html and f\"/m/{VIN}/labels/{oil_id}\" in confirm_html,\n      confirm_href)\n\nhistory_html = client.get(f\"/m/{VIN}/history\").text\ncheck(\"the History page carries a Print label button for the oil-change entry\",\n      \"Print label\" in history_html and f\"/m/{VIN}/labels/{oil_id}\" in history_html)\n\nedit_html = client.get(f\"/m/{VIN}/edit/{oil_id}\").text\ncheck(\"the edit screen carries a Print label button\",\n      \"Print label\" in edit_html and f\"/m/{VIN}/labels/{oil_id}\" in edit_html)\n\ntopup_edit_html = client.get(f\"/m/{VIN}/edit/{topup_id}\").text\ncheck(\"the edit screen shows no Print label button for a non-printable kind\",\n      \"Print label\" not in topup_edit_html)\n\nprint_list_html = client.get(f\"/m/{VIN}/print\").text\ncheck(\"/m/{vin}/print responds 200 and lists the printable oil-change record\",\n      f\"/m/{VIN}/labels/{oil_id}\" in print_list_html)\ncheck(\"/m/{vin}/print offers at least one label-size chip\",\n      'href=\"?size=' in print_list_html)\n\nhome_html_print = client.get(f\"/m/{VIN}\").text\ncheck(\"home's 'Everything else' carries a Print entry\",\n      f\"/m/{VIN}/print\" in home_html_print and \">Print<\" in home_html_print)\n\nr_sized = client.get(f\"/m/{VIN}/labels/{oil_id}\", params={\"size\": \"avery_5520\"})\ncheck(\"the label route accepts an explicit ?size= and still returns a PDF\",\n      r_sized.status_code == 200 and r_sized.content[:5] == b\"%PDF-\",\n      str(r_sized.status_code))\ncheck(\"the label route remembers the last-used size via a cookie\",\n      \"cuore_label_size\" in r_sized.cookies, dict(r_sized.cookies))\n\n# driveline_fluid prints as the dedicated \"transmission_service\" label kind\n# (fluid spec/brand/pan-filter part no/fill temp), not the generic\n# \"service\" kind -- see cuore.web.owner_routes._PRINTABLE_KINDS.\nr = client.post(f\"/api/owner/{VIN}/events\", json={\n    \"category\": \"fluids\", \"kind\": \"driveline_fluid\", \"by_role\": \"mechanic\",\n    \"fields\": {\"which\": \"transmission\", \"fluid_spec\": \"ZF LifeguardFluid 8\",\n              \"brand\": \"Mopar\", \"qty\": 9.0, \"pan_filter_part_no\": \"68227481AA\",\n              \"fill_temp_c\": 38, \"method\": \"pan drop\"},\n    \"odometer_km\": 80000,\n})\ncheck(\"driveline_fluid POST (for the print test) responds 200\", r.status_code == 200,\n      str(r.status_code))\ndriveline_id = r.json().get(\"id\")\n\nr = client.get(f\"/m/{VIN}/labels/{driveline_id}\")\ncheck(\"the label route responds 200 for a saved driveline_fluid event\",\n     r.status_code == 200, str(r.status_code))\ntry:\n    from pypdf import PdfReader as _PdfReader2\n    tx_label_text = _PdfReader2(io.BytesIO(r.content)).pages[0].extract_text()\n    check(\"the printed transmission label carries the fill temperature\",\n         \"38\" in tx_label_text and \"30-50\" in tx_label_text, tx_label_text)\n    check(\"the printed transmission label carries the fluid spec\",\n         \"LifeguardFluid\" in tx_label_text, tx_label_text)\n    check(\"the printed transmission label carries the pan/filter part number\",\n         \"68227481AA\" in tx_label_text, tx_label_text)\nexcept ImportError:\n    check(\"pypdf available to verify transmission label text (optional)\", True)\n\n\nprint(f\"{checks} checks, {len(failures)} failures\")\nfor f in failures:\n    print(\" -\", f)\nif failures:\n    sys.exit(1)\n","numLines":776,"startLine":1,"totalLines":776}},"sourceToolAssistantUUID":"64545fcd-90ea-46ca-bfb5-51d3b26f9543","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
{"parentUuid":"8e93badf-d520-4b0a-bff3-18892fe6c97f","isSidechain":true,"agentId":"a13f3ca3e19263a03","message":{"model":"claude-sonnet-5","id":"msg_011Cg2WLrofF5zwKtRtipSxB","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01BmTwo8z2kJ2d2CZqDfnNq5","name":"Read","input":{"file_path":"C:\\Users\\User\\mcp-servers\\cuore\\tests\\check_screens.py"},"caller":{"type":"direct"}}],"container":null,"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1831,"cache_read_input_tokens":63442,"output_tokens":630,"output_tokens_details":{"thinking_tokens":404},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":0,"ephemeral_5m_input_tokens":1831},"inference_geo":"global","iterations":[{"input_tokens":2,"output_tokens":630,"cache_read_input_tokens":63442,"cache_creation_input_tokens":1831,"cache_creation":{"ephemeral_5m_input_tokens":1831,"ephemeral_1h_input_tokens":0},"type":"message"}],"speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_01BmTwo8z2kJ2d2CZqDfnNq5":{"file_path":"C:\\Users\\User\\mcp-servers\\cuore\\tests\\check_screens.py"}},"serverClassifierRequest":"d64c7074-aa96-4b7d-94f2-0d9c15918d3e","apiBlockIndex":3,"requestId":"req_011Cg2WLrY3Uz1BxuqqseQcF","attributionAgent":"general-purpose","type":"assistant","uuid":"84f203b3-d8a1-4374-adbc-c9fa489838a8","timestamp":"2026-10-14T17:15:22.627Z","effort":"high","perTurnEffort":null,"userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
{"parentUuid":"84f203b3-d8a1-4374-adbc-c9fa489838a8","isSidechain":true,"promptId":"cc4dbf1e-79de-4dba-bef6-7dc85562f73f","agentId":"a13f3ca3e19263a03","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01BmTwo8z2kJ2d2CZqDfnNq5","type":"tool_result","content":"1\t\"\"\"Checks for the \"one step per screen\" job page redesign: the ``?step=N``\n2\tquery param on ``/v/{vin}/job`` (cuore/web/jobs_routes.py, job.html), the\n3\t12-icon process map, and the header language chooser (POST /lang).\n4\t\n5\tSame posture as check_jobs_page.py: ``CUORE_STATE_DIR`` pointed at a\n6\tthrowaway directory before cuore is imported, the Stelvio (real corpus) as\n7\tthe fixture vehicle. Lighter on purpose -- everything except the overflow\n8\tcheck runs against a plain ``TestClient`` (no server, no browser); only the\n9\tno-overflow check needs real layout, so only that one spins up a server +\n10\theadless Edge, and it takes no screenshot (just reads scrollWidth over\n11\tCDP) to keep this cheap to run.\n12\t\n13\tFive checks:\n14\t  1. ``?step=7`` renders step 7's full content and the other 11 steps as\n15\t     headline rows only (11 ``.step-headline`` rows, step 7's own\n16\t     ``step-title`` heading present, no other step's heading present).\n17\t  2. The process map renders all 12 step icons, with exactly one marked\n18\t     current.\n19\t  3. ``?step=12`` shows the release link.\n20\t  4. POST /lang (it) sets the cookie; the job page then carries Italian\n21\t     labels (e.g. \"Rilascio\" for step 12's headline, with no ?step= so\n22\t     step 1 is current and step 12 is a headline row).\n23\t  5. No page-level horizontal overflow at 400px (CDP, no screenshot).\n24\t\n25\tRun:\n26\t    .venv/Scripts/python.exe cuore/tests/check_screens.py\n27\t\"\"\"\n28\t\n29\tfrom __future__ import annotations\n30\t\n31\timport itertools\n32\timport json\n33\timport os\n34\timport re\n35\timport socket\n36\timport subprocess\n37\timport sys\n38\timport tempfile\n39\timport time\n40\timport urllib.parse\n41\timport urllib.request\n42\tfrom pathlib import Path\n43\t\n44\tos.environ[\"CUORE_STATE_DIR\"] = tempfile.mkdtemp(prefix=\"cuore-check-screens-\")\n45\tos.environ.pop(\"CUORE_AUDIT_PATH\", None)\n46\t\n47\tROOT = Path(__file__).resolve().parents[2]\n48\tsys.path.insert(0, str(ROOT))\n49\t\n50\tfrom fastapi.testclient import TestClient  # noqa: E402\n51\t\n52\tfrom cuore.app import create_app  # noqa: E402\n53\tfrom cuore.web.i18n import DEFAULT_LANG, t as _t  # noqa: E402\n54\t\n55\tVIN = \"ZASFAKPN5J7B88115\"  # the Stelvio -- real corpus, chronic P0455/P0440/P0456\n56\t\n57\tfailures: list[str] = []\n58\tchecks = 0\n59\t\n60\t\n61\tdef check(label: str, cond: bool, detail: str = \"\") -> None:\n62\t    global checks\n63\t    checks += 1\n64\t    if not cond:\n65\t        failures.append(f\"{label}{(' -- ' + detail) if detail else ''}\")\n66\t\n67\t\n68\tclient = TestClient(create_app())\n69\t\n70\topen_resp = client.post(f\"/v/{VIN}/job/open\",\n71\t                        data={\"technician\": \"tester\", \"complaint\": \"CEL, smells like gas\"},\n72\t                        follow_redirects=True)\n73\tcheck(\"opening a case for the fixture responds 200\", open_resp.status_code == 200,\n74\t      str(open_resp.status_code))\n75\t\n76\t\n77\t# --- 1. ?step=7 shows step 7's full content, the rest as headlines --------\n78\t\n79\tstep7 = client.get(f\"/v/{VIN}/job\", params={\"step\": \"7\"})\n80\tcheck(\"?step=7 responds 200\", step7.status_code == 200, str(step7.status_code))\n81\ttext7 = step7.text\n82\tcheck(\"?step=7 shows step 7's own heading\", 'id=\"step-7\"' in text7, \"no id=\\\"step-7\\\"\")\n83\tfor n in [1, 2, 3, 4, 5, 6, 8, 9, 10, 11, 12]:\n84\t    check(f\"?step=7 does not show step {n}'s full heading\", f'id=\"step-{n}\"' not in text7,\n85\t          f\"id=\\\"step-{n}\\\" found on the step=7 screen\")\n86\t_headline_count = text7.count('<a class=\"step-headline ')\n87\tcheck(\"?step=7 shows exactly 11 headline rows\",\n88\t      _headline_count == 11, f\"found {_headline_count}\")\n89\t\n90\t\n91\t# --- 2. process map: 12 icons, exactly one current -------------------------\n92\t\n93\t_pm_count = text7.count('<a class=\"pm-step ')\n94\tcheck(\"process map renders all 12 step icons\", _pm_count == 12, f\"found {_pm_count}\")\n95\tcheck(\"process map marks exactly one step current\",\n96\t      len(re.findall(r'class=\"pm-step [^\"]*\\bpm-current\\b', text7)) == 1,\n97\t      str(len(re.findall(r'pm-current', text7))))\n98\tcheck(\"process map's current icon links to step 7\",\n99\t      re.search(r'<a class=\"pm-step[^\"]*pm-current[^\"]*\"\\s+href=\"/v/' + re.escape(VIN)\n100\t               + r'/job\\?step=7\"', text7) is not None,\n101\t      \"no pm-current anchor pointing at ?step=7\")\n102\t\n103\t\n104\t# --- 3. ?step=12 shows the release link -------------------------------------\n105\t\n106\tstep12 = client.get(f\"/v/{VIN}/job\", params={\"step\": \"12\"})\n107\tcheck(\"?step=12 responds 200\", step12.status_code == 200, str(step12.status_code))\n108\tcheck(\"?step=12 shows the release link\", f'/v/{VIN}/release' in step12.text and\n109\t      # \"Go to release\" goes through t() (mechanic-UX review item 5). The\n110\t      # language chooser has been removed -- it did not work -- so t()\n111\t      # always renders English now, regardless of any lang cookie.\n112\t      _t(\"go_to_release\", DEFAULT_LANG) in step12.text, \"release link/text not found\")\n113\tcheck(\"?step=12 shows step 12's own heading\", 'id=\"step-12\"' in step12.text,\n114\t      \"no id=\\\"step-12\\\"\")\n115\t\n116\t\n117\t# --- 4. the removed language chooser stays gone, and a stray lang cookie\n118\t#        has no effect (t() ignores it and always renders English) --------\n119\t\n120\tcheck(\"the /lang route is gone\", client.post(\n121\t    \"/lang\", data={\"lang\": \"it\", \"next\": f\"/v/{VIN}/job\"},\n122\t    follow_redirects=False).status_code == 404, \"POST /lang still routes somewhere\")\n123\tcheck(\"no header language chooser form is rendered\",\n124\t      'action=\"/lang\"' not in step12.text and \"lang-picker\" not in step12.text,\n125\t      \"a /lang chooser form is still in the page\")\n126\t\n127\tclient.cookies.set(\"lang\", \"it\")\n128\tjob_cookie_it = client.get(f\"/v/{VIN}/job\")\n129\tcheck(\"job page responds 200 with a stray lang=it cookie set\",\n130\t      job_cookie_it.status_code == 200, str(job_cookie_it.status_code))\n131\tcheck(\"job page still shows the English step label (Release) with lang=it cookie set\",\n132\t      _t(\"release\", DEFAULT_LANG) in job_cookie_it.text and \"Rilascio\" not in job_cookie_it.text,\n133\t      \"English label not found, or Italian text leaked through, with a stray lang=it cookie\")\n134\tclient.cookies.delete(\"lang\")\n135\t\n136\t\n137\t# --- 5. no horizontal overflow at 400px (CDP, no screenshot) ---------------\n138\t\n139\tprint(\"=== overflow check at 400px (no screenshot) ===\")\n140\tEDGE_CANDIDATES = [\n141\t    r\"C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe\",\n142\t    r\"C:\\Program Files\\Microsoft\\Edge\\Application\\msedge.exe\",\n143\t]\n144\t\n145\t\n146\tdef find_edge() -> str:\n147\t    for candidate in EDGE_CANDIDATES:\n148\t        if Path(candidate).exists():\n149\t            return candidate\n150\t    return \"\"\n151\t\n152\t\n153\tdef free_port() -> int:\n154\t    s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)\n155\t    s.bind((\"127.0.0.1\", 0))\n156\t    port = s.getsockname()[1]\n157\t    s.close()\n158\t    return port\n159\t\n160\t\n161\tclass CDP:\n162\t    def __init__(self, ws_url: str) -> None:\n163\t        from websockets.sync.client import connect\n164\t        self.ws = connect(ws_url, max_size=None, open_timeout=20)\n165\t        self._ids = itertools.count(1)\n166\t\n167\t    def send(self, method: str, params: dict | None = None, timeout: float = 20):\n168\t        msg_id = next(self._ids)\n169\t        self.ws.send(json.dumps({\"id\": msg_id, \"method\": method, \"params\": params or {}}))\n170\t        deadline = time.time() + timeout\n171\t        while time.time() < deadline:\n172\t            raw = self.ws.recv(timeout=max(0.1, deadline - time.time()))\n173\t            msg = json.loads(raw)\n174\t            if msg.get(\"id\") == msg_id:\n175\t                if \"error\" in msg:\n176\t                    raise RuntimeError(f\"CDP {method} failed: {msg['error']}\")\n177\t                return msg.get(\"result\", {})\n178\t        raise TimeoutError(f\"CDP {method} timed out waiting for response\")\n179\t\n180\t    def close(self) -> None:\n181\t        try:\n182\t            self.ws.close()\n183\t        except Exception:\n184\t            pass\n185\t\n186\t\n187\tdef wait_for_devtools(port: int, timeout: float = 20) -> None:\n188\t    deadline = time.time() + timeout\n189\t    last_err: Exception | None = None\n190\t    while time.time() < deadline:\n191\t        try:\n192\t            with urllib.request.urlopen(f\"http://127.0.0.1:{port}/json/version\", timeout=2) as r:\n193\t                json.loads(r.read().decode(\"utf-8\"))\n194\t                return\n195\t        except Exception as exc:  # noqa: BLE001\n196\t            last_err = exc\n197\t            time.sleep(0.2)\n198\t    raise RuntimeError(f\"headless Edge devtools endpoint never came up: {last_err}\")\n199\t\n200\t\n201\tdef open_target(port: int, url: str) -> dict:\n202\t    req = urllib.request.Request(f\"http://127.0.0.1:{port}/json/new?{url}\", method=\"PUT\")\n203\t    with urllib.request.urlopen(req, timeout=10) as r:\n204\t        return json.loads(r.read().decode(\"utf-8\"))\n205\t\n206\t\n207\tdef wait_for_port(port: int, timeout: float = 15.0) -> bool:\n208\t    deadline = time.monotonic() + timeout\n209\t    while time.monotonic() < deadline:\n210\t        try:\n211\t            with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:\n212\t                s.settimeout(0.3)\n213\t                s.connect((\"127.0.0.1\", port))\n214\t                return True\n215\t        except OSError:\n216\t            time.sleep(0.2)\n217\t    return False\n218\t\n219\t\n220\tedge = find_edge()\n221\tserver_dir = tempfile.mkdtemp(prefix=\"cuore-check-screens-server-\")\n222\tport = free_port()\n223\tenv = dict(os.environ)\n224\tenv[\"CUORE_STATE_DIR\"] = server_dir\n225\t\n226\t_SERVER_SNIPPET = f\"\"\"\n227\timport sys\n228\tsys.path.insert(0, {str(ROOT)!r})\n229\tfrom cuore.app import create_app\n230\timport uvicorn\n231\t\n232\tapp = create_app()\n233\tuvicorn.run(app, host=\"127.0.0.1\", port={port}, log_level=\"warning\")\n234\t\"\"\"\n235\t\n236\tif not edge:\n237\t    check(\"headless Edge is available for the overflow check\", False, str(EDGE_CANDIDATES))\n238\telse:\n239\t    server_proc = subprocess.Popen(\n240\t        [sys.executable, \"-c\", _SERVER_SNIPPET],\n241\t        cwd=str(ROOT), env=env,\n242\t        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,\n243\t    )\n244\t    try:\n245\t        up = wait_for_port(port)\n246\t        check(\"uvicorn came up on the free port\", up, f\"port {port}\")\n247\t        if up:\n248\t            data = urllib.parse.urlencode(\n249\t                {\"technician\": \"tester\", \"complaint\": \"CEL, smells like gas\"}).encode()\n250\t            try:\n251\t                urllib.request.urlopen(\n252\t                    urllib.request.Request(f\"http://127.0.0.1:{port}/v/{VIN}/job/open\",\n253\t                                           data=data, method=\"POST\"), timeout=25)\n254\t            except Exception as exc:  # noqa: BLE001\n255\t                check(\"seeding a job on the overflow-check server\", False, str(exc))\n256\t\n257\t            time.sleep(1.0)\n258\t            devtools_port = free_port()\n259\t            profile_dir = Path(tempfile.mkdtemp(prefix=\"cuore-edge-screens-\"))\n260\t            edge_proc = subprocess.Popen(\n261\t                [edge, \"--headless=new\", f\"--remote-debugging-port={devtools_port}\",\n262\t                 f\"--user-data-dir={profile_dir}\", \"--no-first-run\", \"--window-size=400,1400\",\n263\t                 \"about:blank\"],\n264\t                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,\n265\t            )\n266\t            try:\n267\t                wait_for_devtools(devtools_port)\n268\t                url = f\"http://127.0.0.1:{port}/v/{VIN}/job?step=7\"\n269\t                target = open_target(devtools_port, url)\n270\t                cdp = CDP(target[\"webSocketDebuggerUrl\"])\n271\t                try:\n272\t                    cdp.send(\"Page.enable\")\n273\t                    cdp.send(\"Runtime.enable\")\n274\t                    time.sleep(1.2)\n275\t                    cdp.send(\"Emulation.setDeviceMetricsOverride\", {\n276\t                        \"width\": 400, \"height\": 1400, \"deviceScaleFactor\": 1, \"mobile\": True,\n277\t                    })\n278\t                    time.sleep(0.5)\n279\t\n280\t                    nav = cdp.send(\"Runtime.evaluate\", {\n281\t                        \"expression\": \"document.readyState\", \"returnByValue\": True})\n282\t                    check(\"job page (step=7) loaded in the headless browser\",\n283\t                          nav.get(\"result\", {}).get(\"value\") in (\"complete\", \"interactive\"),\n284\t                          str(nav))\n285\t\n286\t                    overflow = cdp.send(\"Runtime.evaluate\", {\n287\t                        \"expression\": (\n288\t                            \"JSON.stringify({sw: document.documentElement.scrollWidth, \"\n289\t                            \"cw: document.documentElement.clientWidth})\"),\n290\t                        \"returnByValue\": True,\n291\t                    })\n292\t                    dims = json.loads(overflow.get(\"result\", {}).get(\"value\", \"{}\"))\n293\t                    sw, cw = dims.get(\"sw\", 0), dims.get(\"cw\", 0)\n294\t                    check(\"no page-level horizontal overflow at 400px\",\n295\t                         sw <= cw + 1, f\"scrollWidth={sw} clientWidth={cw}\")\n296\t                finally:\n297\t                    cdp.close()\n298\t            except Exception as exc:  # noqa: BLE001\n299\t                check(\"headless Edge measured the job page over CDP\", False,\n300\t                     f\"{type(exc).__name__}: {exc}\")\n301\t            finally:\n302\t                edge_proc.terminate()\n303\t                try:\n304\t                    edge_proc.wait(timeout=5)\n305\t                except Exception:\n306\t                    edge_proc.kill()\n307\t                from _edge_cleanup import kill_edge_profile\n308\t                kill_edge_profile(profile_dir)\n309\t    finally:\n310\t        server_proc.terminate()\n311\t        try:\n312\t            server_proc.wait(timeout=5)\n313\t        except Exception:\n314\t            server_proc.kill()\n315\t\n316\t\n317\t# --- report ------------------------------------------------------------------\n318\t\n319\tprint()\n320\tif failures:\n321\t    print(f\"{len(failures)}/{checks} check(s) failed:\")\n322\t    for f in failures:\n323\t        print(f\"  - {f}\")\n324\t    sys.exit(1)\n325\tprint(f\"all {checks} checks passed\")\n326\t"}]},"uuid":"2606431c-cd58-437e-839f-96704704335d","timestamp":"2026-10-14T17:15:22.662Z","toolUseResult":{"type":"text","file":{"filePath":"C:\\Users\\User\\mcp-servers\\cuore\\tests\\check_screens.py","content":"\"\"\"Checks for the \"one step per screen\" job page redesign: the ``?step=N``\nquery param on ``/v/{vin}/job`` (cuore/web/jobs_routes.py, job.html), the\n12-icon process map, and the header language chooser (POST /lang).\n\nSame posture as check_jobs_page.py: ``CUORE_STATE_DIR`` pointed at a\nthrowaway directory before cuore is imported, the Stelvio (real corpus) as\nthe fixture vehicle. Lighter on purpose -- everything except the overflow\ncheck runs against a plain ``TestClient`` (no server, no browser); only the\nno-overflow check needs real layout, so only that one spins up a server +\nheadless Edge, and it takes no screenshot (just reads scrollWidth over\nCDP) to keep this cheap to run.\n\nFive checks:\n  1. ``?step=7`` renders step 7's full content and the other 11 steps as\n     headline rows only (11 ``.step-headline`` rows, step 7's own\n     ``step-title`` heading present, no other step's heading present).\n  2. The process map renders all 12 step icons, with exactly one marked\n     current.\n  3. ``?step=12`` shows the release link.\n  4. POST /lang (it) sets the cookie; the job page then carries Italian\n     labels (e.g. \"Rilascio\" for step 12's headline, with no ?step= so\n     step 1 is current and step 12 is a headline row).\n  5. No page-level horizontal overflow at 400px (CDP, no screenshot).\n\nRun:\n    .venv/Scripts/python.exe cuore/tests/check_screens.py\n\"\"\"\n\nfrom __future__ import annotations\n\nimport itertools\nimport json\nimport os\nimport re\nimport socket\nimport subprocess\nimport sys\nimport tempfile\nimport time\nimport urllib.parse\nimport urllib.request\nfrom pathlib import Path\n\nos.environ[\"CUORE_STATE_DIR\"] = tempfile.mkdtemp(prefix=\"cuore-check-screens-\")\nos.environ.pop(\"CUORE_AUDIT_PATH\", None)\n\nROOT = Path(__file__).resolve().parents[2]\nsys.path.insert(0, str(ROOT))\n\nfrom fastapi.testclient import TestClient  # noqa: E402\n\nfrom cuore.app import create_app  # noqa: E402\nfrom cuore.web.i18n import DEFAULT_LANG, t as _t  # noqa: E402\n\nVIN = \"ZASFAKPN5J7B88115\"  # the Stelvio -- real corpus, chronic P0455/P0440/P0456\n\nfailures: list[str] = []\nchecks = 0\n\n\ndef check(label: str, cond: bool, detail: str = \"\") -> None:\n    global checks\n    checks += 1\n    if not cond:\n        failures.append(f\"{label}{(' -- ' + detail) if detail else ''}\")\n\n\nclient = TestClient(create_app())\n\nopen_resp = client.post(f\"/v/{VIN}/job/open\",\n                        data={\"technician\": \"tester\", \"complaint\": \"CEL, smells like gas\"},\n                        follow_redirects=True)\ncheck(\"opening a case for the fixture responds 200\", open_resp.status_code == 200,\n      str(open_resp.status_code))\n\n\n# --- 1. ?step=7 shows step 7's full content, the rest as headlines --------\n\nstep7 = client.get(f\"/v/{VIN}/job\", params={\"step\": \"7\"})\ncheck(\"?step=7 responds 200\", step7.status_code == 200, str(step7.status_code))\ntext7 = step7.text\ncheck(\"?step=7 shows step 7's own heading\", 'id=\"step-7\"' in text7, \"no id=\\\"step-7\\\"\")\nfor n in [1, 2, 3, 4, 5, 6, 8, 9, 10, 11, 12]:\n    check(f\"?step=7 does not show step {n}'s full heading\", f'id=\"step-{n}\"' not in text7,\n          f\"id=\\\"step-{n}\\\" found on the step=7 screen\")\n_headline_count = text7.count('<a class=\"step-headline ')\ncheck(\"?step=7 shows exactly 11 headline rows\",\n      _headline_count == 11, f\"found {_headline_count}\")\n\n\n# --- 2. process map: 12 icons, exactly one current -------------------------\n\n_pm_count = text7.count('<a class=\"pm-step ')\ncheck(\"process map renders all 12 step icons\", _pm_count == 12, f\"found {_pm_count}\")\ncheck(\"process map marks exactly one step current\",\n      len(re.findall(r'class=\"pm-step [^\"]*\\bpm-current\\b', text7)) == 1,\n      str(len(re.findall(r'pm-current', text7))))\ncheck(\"process map's current icon links to step 7\",\n      re.search(r'<a class=\"pm-step[^\"]*pm-current[^\"]*\"\\s+href=\"/v/' + re.escape(VIN)\n               + r'/job\\?step=7\"', text7) is not None,\n      \"no pm-current anchor pointing at ?step=7\")\n\n\n# --- 3. ?step=12 shows the release link -------------------------------------\n\nstep12 = client.get(f\"/v/{VIN}/job\", params={\"step\": \"12\"})\ncheck(\"?step=12 responds 200\", step12.status_code == 200, str(step12.status_code))\ncheck(\"?step=12 shows the release link\", f'/v/{VIN}/release' in step12.text and\n      # \"Go to release\" goes through t() (mechanic-UX review item 5). The\n      # language chooser has been removed -- it did not work -- so t()\n      # always renders English now, regardless of any lang cookie.\n      _t(\"go_to_release\", DEFAULT_LANG) in step12.text, \"release link/text not found\")\ncheck(\"?step=12 shows step 12's own heading\", 'id=\"step-12\"' in step12.text,\n      \"no id=\\\"step-12\\\"\")\n\n\n# --- 4. the removed language chooser stays gone, and a stray lang cookie\n#        has no effect (t() ignores it and always renders English) --------\n\ncheck(\"the /lang route is gone\", client.post(\n    \"/lang\", data={\"lang\": \"it\", \"next\": f\"/v/{VIN}/job\"},\n    follow_redirects=False).status_code == 404, \"POST /lang still routes somewhere\")\ncheck(\"no header language chooser form is rendered\",\n      'action=\"/lang\"' not in step12.text and \"lang-picker\" not in step12.text,\n      \"a /lang chooser form is still in the page\")\n\nclient.cookies.set(\"lang\", \"it\")\njob_cookie_it = client.get(f\"/v/{VIN}/job\")\ncheck(\"job page responds 200 with a stray lang=it cookie set\",\n      job_cookie_it.status_code == 200, str(job_cookie_it.status_code))\ncheck(\"job page still shows the English step label (Release) with lang=it cookie set\",\n      _t(\"release\", DEFAULT_LANG) in job_cookie_it.text and \"Rilascio\" not in job_cookie_it.text,\n      \"English label not found, or Italian text leaked through, with a stray lang=it cookie\")\nclient.cookies.delete(\"lang\")\n\n\n# --- 5. no horizontal overflow at 400px (CDP, no screenshot) ---------------\n\nprint(\"=== overflow check at 400px (no screenshot) ===\")\nEDGE_CANDIDATES = [\n    r\"C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe\",\n    r\"C:\\Program Files\\Microsoft\\Edge\\Application\\msedge.exe\",\n]\n\n\ndef find_edge() -> str:\n    for candidate in EDGE_CANDIDATES:\n        if Path(candidate).exists():\n            return candidate\n    return \"\"\n\n\ndef free_port() -> int:\n    s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)\n    s.bind((\"127.0.0.1\", 0))\n    port = s.getsockname()[1]\n    s.close()\n    return port\n\n\nclass CDP:\n    def __init__(self, ws_url: str) -> None:\n        from websockets.sync.client import connect\n        self.ws = connect(ws_url, max_size=None, open_timeout=20)\n        self._ids = itertools.count(1)\n\n    def send(self, method: str, params: dict | None = None, timeout: float = 20):\n        msg_id = next(self._ids)\n        self.ws.send(json.dumps({\"id\": msg_id, \"method\": method, \"params\": params or {}}))\n        deadline = time.time() + timeout\n        while time.time() < deadline:\n            raw = self.ws.recv(timeout=max(0.1, deadline - time.time()))\n            msg = json.loads(raw)\n            if msg.get(\"id\") == msg_id:\n                if \"error\" in msg:\n                    raise RuntimeError(f\"CDP {method} failed: {msg['error']}\")\n                return msg.get(\"result\", {})\n        raise TimeoutError(f\"CDP {method} timed out waiting for response\")\n\n    def close(self) -> None:\n        try:\n            self.ws.close()\n        except Exception:\n            pass\n\n\ndef wait_for_devtools(port: int, timeout: float = 20) -> None:\n    deadline = time.time() + timeout\n    last_err: Exception | None = None\n    while time.time() < deadline:\n        try:\n            with urllib.request.urlopen(f\"http://127.0.0.1:{port}/json/version\", timeout=2) as r:\n                json.loads(r.read().decode(\"utf-8\"))\n                return\n        except Exception as exc:  # noqa: BLE001\n            last_err = exc\n            time.sleep(0.2)\n    raise RuntimeError(f\"headless Edge devtools endpoint never came up: {last_err}\")\n\n\ndef open_target(port: int, url: str) -> dict:\n    req = urllib.request.Request(f\"http://127.0.0.1:{port}/json/new?{url}\", method=\"PUT\")\n    with urllib.request.urlopen(req, timeout=10) as r:\n        return json.loads(r.read().decode(\"utf-8\"))\n\n\ndef wait_for_port(port: int, timeout: float = 15.0) -> bool:\n    deadline = time.monotonic() + timeout\n    while time.monotonic() < deadline:\n        try:\n            with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:\n                s.settimeout(0.3)\n                s.connect((\"127.0.0.1\", port))\n                return True\n        except OSError:\n            time.sleep(0.2)\n    return False\n\n\nedge = find_edge()\nserver_dir = tempfile.mkdtemp(prefix=\"cuore-check-screens-server-\")\nport = free_port()\nenv = dict(os.environ)\nenv[\"CUORE_STATE_DIR\"] = server_dir\n\n_SERVER_SNIPPET = f\"\"\"\nimport sys\nsys.path.insert(0, {str(ROOT)!r})\nfrom cuore.app import create_app\nimport uvicorn\n\napp = create_app()\nuvicorn.run(app, host=\"127.0.0.1\", port={port}, log_level=\"warning\")\n\"\"\"\n\nif not edge:\n    check(\"headless Edge is available for the overflow check\", False, str(EDGE_CANDIDATES))\nelse:\n    server_proc = subprocess.Popen(\n        [sys.executable, \"-c\", _SERVER_SNIPPET],\n        cwd=str(ROOT), env=env,\n        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,\n    )\n    try:\n        up = wait_for_port(port)\n        check(\"uvicorn came up on the free port\", up, f\"port {port}\")\n        if up:\n            data = urllib.parse.urlencode(\n                {\"technician\": \"tester\", \"complaint\": \"CEL, smells like gas\"}).encode()\n            try:\n                urllib.request.urlopen(\n                    urllib.request.Request(f\"http://127.0.0.1:{port}/v/{VIN}/job/open\",\n                                           data=data, method=\"POST\"), timeout=25)\n            except Exception as exc:  # noqa: BLE001\n                check(\"seeding a job on the overflow-check server\", False, str(exc))\n\n            time.sleep(1.0)\n            devtools_port = free_port()\n            profile_dir = Path(tempfile.mkdtemp(prefix=\"cuore-edge-screens-\"))\n            edge_proc = subprocess.Popen(\n                [edge, \"--headless=new\", f\"--remote-debugging-port={devtools_port}\",\n                 f\"--user-data-dir={profile_dir}\", \"--no-first-run\", \"--window-size=400,1400\",\n                 \"about:blank\"],\n                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,\n            )\n            try:\n                wait_for_devtools(devtools_port)\n                url = f\"http://127.0.0.1:{port}/v/{VIN}/job?step=7\"\n                target = open_target(devtools_port, url)\n                cdp = CDP(target[\"webSocketDebuggerUrl\"])\n                try:\n                    cdp.send(\"Page.enable\")\n                    cdp.send(\"Runtime.enable\")\n                    time.sleep(1.2)\n                    cdp.send(\"Emulation.setDeviceMetricsOverride\", {\n                        \"width\": 400, \"height\": 1400, \"deviceScaleFactor\": 1, \"mobile\": True,\n                    })\n                    time.sleep(0.5)\n\n                    nav = cdp.send(\"Runtime.evaluate\", {\n                        \"expression\": \"document.readyState\", \"returnByValue\": True})\n                    check(\"job page (step=7) loaded in the headless browser\",\n                          nav.get(\"result\", {}).get(\"value\") in (\"complete\", \"interactive\"),\n                          str(nav))\n\n                    overflow = cdp.send(\"Runtime.evaluate\", {\n                        \"expression\": (\n                            \"JSON.stringify({sw: document.documentElement.scrollWidth, \"\n                            \"cw: document.documentElement.clientWidth})\"),\n                        \"returnByValue\": True,\n                    })\n                    dims = json.loads(overflow.get(\"result\", {}).get(\"value\", \"{}\"))\n                    sw, cw = dims.get(\"sw\", 0), dims.get(\"cw\", 0)\n                    check(\"no page-level horizontal overflow at 400px\",\n                         sw <= cw + 1, f\"scrollWidth={sw} clientWidth={cw}\")\n                finally:\n                    cdp.close()\n            except Exception as exc:  # noqa: BLE001\n                check(\"headless Edge measured the job page over CDP\", False,\n                     f\"{type(exc).__name__}: {exc}\")\n            finally:\n                edge_proc.terminate()\n                try:\n                    edge_proc.wait(timeout=5)\n                except Exception:\n                    edge_proc.kill()\n                from _edge_cleanup import kill_edge_profile\n                kill_edge_profile(profile_dir)\n    finally:\n        server_proc.terminate()\n        try:\n            server_proc.wait(timeout=5)\n        except Exception:\n            server_proc.kill()\n\n\n# --- report ------------------------------------------------------------------\n\nprint()\nif failures:\n    print(f\"{len(failures)}/{checks} check(s) failed:\")\n    for f in failures:\n        print(f\"  - {f}\")\n    sys.exit(1)\nprint(f\"all {checks} checks passed\")\n","numLines":326,"startLine":1,"totalLines":326}},"sourceToolAssistantUUID":"84f203b3-d8a1-4374-adbc-c9fa489838a8","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
