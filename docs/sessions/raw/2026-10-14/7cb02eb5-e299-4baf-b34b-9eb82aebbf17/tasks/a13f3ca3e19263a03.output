ock; font-size: var(--fs-3xl); font-weight: var(--fw-light); text-transform: uppercase;\n1466:.hero-verdict-state.v-active-faults     { color: var(--sev-returned); }\n1467:.hero-verdict-state.v-unverified-repair { color: var(--sev-chronic); }\n1468:.hero-verdict-state.v-verified-clean    { color: var(--ok); }\n1469:.hero-verdict-state.v-no-data           { color: var(--ink-3); }\n1470:.hero-verdict-sentence {\n1471:  font-size: var(--fs-xl); font-weight: var(--fw-light); color: rgba(255,255,255,.88);\n1474:.hero-figures { display: flex; gap: var(--space-5); flex-wrap: wrap; margin-top: var(--space-3); }\n1475:.hero-figure { display: flex; flex-direction: column; }\n1476:.hero-figure-value { font-size: var(--fs-3xl); font-weight: var(--fw-light); color: #fff; line-height: 1.1; }\n1477:.hero-figure-value.flagged { color: var(--sev-chronic); }\n1478:.hero-figure-label {\n1487:  .hero-img { height: 30vh; min-height: 30vh; }\n1488:  .hero-name { font-size: var(--fs-3xl); }\n1489:  .hero-verdict-state { font-size: var(--fs-3xl); }\n1490:  .hero-figures { gap: var(--space-4); }\n1491:  .hero-figure-value { font-size: var(--fs-3xl); }\n1576:  font-size: var(--fs-3xl); font-weight: var(--fw-light); letter-spacing: .04em; color: #fff;\n1683: * .hero-img / .hero-name rules above regardless of source order, so this\n1686:/* R4: no longer clips -- the shared :root fix above already keeps .hero-text in flow, so a 2-line vehicle name simply grows the band instead of being cut off. */\n1688:.vhero.vhero-compact .hero-img {\n1691:.vhero.vhero-compact .hero-text {\n1696:.vhero.vhero-compact .hero-head { display: flex; align-items: baseline; gap: var(--space-2); }\n1697:.vhero.vhero-compact .hero-name { font-size: var(--fs-3xl); font-weight: var(--fw-light); color: #fff; letter-spacing: 0; }\n1698:.vhero.vhero-compact .hero-verdict {\n1701:.hero-verdict-chip {\n1705:.hero-verdict-chip.v-active-faults     { color: var(--sev-returned); background: var(--sev-returned-bg); }\n1706:.hero-verdict-chip.v-unverified-repair { color: var(--sev-chronic); background: var(--sev-chronic-bg); }\n1707:.hero-verdict-chip.v-verified-clean    { color: var(--ok); background: var(--ok-bg); }\n1708:.hero-verdict-chip.v-no-data           { color: var(--ink-3); background: var(--surface-2); }\n1709:.hero-next-sentence {\n1710:  margin: 0; font-size: var(--fs-xl); font-weight: var(--fw-light); line-height: 1.3; max-width: 72ch;\n1743:th, .ff-name, .hero-figure-label, .feedback-badge, .count-badge .chip.sm,\n1748:.bench-shortcut, .hero-verdict-chip {","is_error":false}]},"uuid":"bd96037f-4bc4-4f50-954d-e41de225bd6d","timestamp":"2026-10-14T17:16:02.313Z","toolUseResult":{"stdout":"48:  --fw-light:    300; /* Marque/Emphasis-pass display weight: h1/h2, hero name,\n309: * width (see .hero-tagline). Only re-appears on a wide enough desktop\n1307:h1 { font-weight: var(--fw-light); font-size: var(--fs-3xl); line-height: 1.3; letter-spacing: -.01em; }\n1312:  font-size: var(--fs-2xl); font-weight: var(--fw-light); letter-spacing: -.01em; text-transform: none;\n1370: * R4: .hero-text used to be `position: absolute; bottom: 0` inside a\n1372: * collapsed to just .hero-img's height, and whenever the text's own\n1377: * get `grid-area: 1/1`) -- .hero-text sits in normal flow, grid auto-sizes\n1383:.hero-img {\n1387:.hero-text {\n1392:.hero-name { font-size: var(--fs-2xl); font-weight: var(--fw-light); color: #fff; }\n1393:.hero-vin, .hero-km { font-family: var(--mono); font-size: var(--fs-sm); color: rgba(255,255,255,.82); }\n1400:  .hero-img { height: 120px; }\n1401:  .hero-name { font-size: var(--fs-xl); }\n1421: * a handful of new selectors (.hero-head/.hero-tagline/.hero-verdict*\n1422: * /.hero-figure*, .step-oneliner). Nothing above this point is rewritten.\n1435:  font-size: var(--fs-2xl); font-weight: var(--fw-light); letter-spacing: -.01em; text-transform: none;\n1441:  font-size: var(--fs-xl); font-weight: var(--fw-light); color: var(--ink-2); margin: 0 0 var(--space-2);