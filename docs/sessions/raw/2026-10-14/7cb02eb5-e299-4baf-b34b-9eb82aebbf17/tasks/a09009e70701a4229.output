ercase label */\n57\t  --mono-scale: 0.92em;    /* inline mono optically matches the sans scale */\n58\t\n59\t  --pad: 14px;\n60\t  --radius:      3px;\n61\t  --radius-sm:   4px;\n62\t  --radius-pill: 999px;\n63\t  --tap: 44px;\n64\t  --space-6: 32px;\n65\t  --space-7: 48px;\n66\t  --vline-h: 49px; /* R7: .vline's own rendered height -- flow.css's sticky .flow-bar sits at top:var(--vline-h) instead of also claiming top:0 */\n67\t\n68\t  /* Colour: neutral true black (what users actually see), re-derived from\n69\t   * itself rather than left mixed with the blue-grey tokens the palette\n70\t   * started from (--raised #262d33 etc). */\n71\t  --bg:         #000;\n72\t  --surface:    #0b0c0d;\n73\t  --surface-2:  #141617;\n74\t  --raised:     #1d2022;\n75\t  --rule:       #2a2d30;\n76\t  --rule-soft:  #1c1f21;\n77\t\n78\t  --ink:        #f2f4f5;\n79\t  --ink-2:      #b9c0c5;\n80\t  --ink-3:      #8f99a1;   /* >= 4.5:1 on --surface-2 */\n81\t\n82\t  --accent:     #e8565c;     /* identity + destructive emphasis only */\n83\t  --accent-ink: #1a0506;     /* text ON a solid --accent fill (see G5) */\n84\t  --accent-dim: #3a1e20;\n85\t\n86\t  /* Semantic severity. Deliberately not the accent: a code's state must not\n87\t   * read as \"the brand colour\", and these four have to be distinguishable\n88\t   * from each other at a glance across a workshop. */\n89\t  --sev-returned: #e8565c;   --sev-returned-bg: #33191b;\n90\t  --sev-chronic:  #d9a63c;   --sev-chronic-bg:  #2e2513;\n91\t  --sev-cleared:  #6aa6d8;   --sev-cleared-bg:  #16242e;\n92\t  --sev-once:     #7d888f;   --sev-once-bg:     #21282c;\n93\t  /* True green, not the teal this token used to carry -- it now sits at the\n94\t   * same lightness/saturation the other four severities use, but reads as\n95\t   * unambiguously \"good\" the way it does on this app's subject rather than\n96\t   * being mistaken for --sev-cleared's blue. */\n97\t  --ok:           #52b579;   --ok-bg:           #12291d;\n98\t\n99\t  /* Per-code-family colours for cuore/web/timeline_svg.py. Chosen to stay\n100\t   * visually distinct from --accent and from each other, and from\n101\t   * --sev-cleared's blue. */\n102\t  --fam-mil:     #e8565c;\n103\t  --fam-evap:    #3fb0ae;\n104\t  --fam-network: #a986ef;\n105\t  --fam-body:    #d98a3c;\n106\t  --fam-chassis: #5b8fd9;\n107\t  --fam-engine:  #8fae4a;\n108\t}\n109\t\n110\t@media (prefers-color-scheme: light) {\n111\t  :root:not([data-theme=\"dark\"]) {\n112\t    color-scheme: light;\n113\t    --bg:        #eef0f2;\n114\t    --surface:   #f7f8f9;\n115\t    --surface-2: #e8ebee;\n116\t    --raised:    #dde2e6;\n117\t    --rule:      #ccd3d8;\n118\t    --rule-soft: #dee3e7;\n119\t    --ink:       #14181b;\n120\t    --ink-2:     #3d464c;\n121\t    --ink-3:     #5b656c;  /* 4.98:1 on --surface-2 (old #68737a was 4.06:1) */\n122\t    --accent:    #9e1b21;\n123\t    --accent-ink:#fff;\n124\t    --accent-dim:#f0dcdc;\n125\t    --sev-returned: #9e1b21;  --sev-returned-bg: #f4dedf;\n126\t    --sev-chronic:  #8a5d06;  --sev-chronic-bg:  #f5e8cd;\n127\t    --sev-cleared:  #1e5b86;  --sev-cleared-bg:  #dce9f2;\n128\t    --sev-once:     #5c666d;  --sev-once-bg:     #e2e6e9;\n129\t    --ok:           #1e6b3f;  --ok-bg:           #dcefe1;\n130\t    --fam-mil:     #9e1b21;\n131\t    --fam-evap:    #1f7a78;\n132\t    --fam-network: #6b4fb0;\n133\t    --fam-body:    #a85a10;\n134\t    --fam-chassis: #2a5ea8;"}]},"uuid":"5bccdf51-0d96-4181-a2f8-cf09bc5add70","timestamp":"2026-10-14T16:46:35.952Z","toolUseResult":{"type":"text","file":{"filePath":"C:\\Users\\User\\mcp-servers\\cuore\\web\\static\\cuore.css","content":":root {\n  color-scheme: dark;\n\n  --sans: system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\",\n          Arial, sans-serif;\n  --mono: ui-monospace, \"SFMono-Regular\", \"Cascadia Mono\", Menlo, Consolas,\n          \"Liberation Mono\", monospace;\n\n  /* Scale: 7 steps, nothing else. No other font-size value is permitted\n   * anywhere in this stylesheet (cuore/tests/check_type_scale.py enforces\n   * this) -- see the \"Rules for the codebase going forward\" note below. */\n  --fs-xs:  0.75rem;    /* 12px  caption, badges, table meta (absolute floor) */\n  --fs-sm:  0.875rem;   /* 14px  secondary text, labels, chips, table body */\n  --fs-md:  1rem;       /* 16px  body, inputs (16 = no iOS zoom) */\n  --fs-lg:  1.125rem;   /* 18px  lead / card titles / h4 */\n  --fs-xl:  1.25rem;    /* 20px  h3 */\n  --fs-2xl: clamp(1.375rem, 1.1rem + 1vw, 1.625rem); /* 22-26px h2 */\n  --fs-3xl: clamp(1.75rem, 1.3rem + 2vw, 2.25rem);   /* 28-36px h1 / hero */\n\n  --lh-tight: 1.2;   /* headings, hero */\n  --lh-snug:  1.35;  /* chips, buttons, table cells, cards */\n  --lh-body:  1.55;  /* paragraphs */\n\n  --fw-light:    300; /* Marque/Emphasis-pass display weight: h1/h2, hero name,\n                          verdict state, verdict sentence, key figures, step\n                          one-liner, intro wordmark -- restored 2026-10-14 */\n  --fw-regular:  400;\n  --fw-medium:   500;\n  --fw-semibold: 600; /* replaces old 650 on chrome/UI elements only */\n  --fw-bold:     700; /* numbers/emphasis only */\n\n  --tracking-caps: 0.06em; /* one value for every uppercase label */\n  --mono-scale: 0.92em;    /* inline mono optically matches the sans scale */\n\n  --pad: 14px;\n  --radius:      3px;\n  --radius-sm:   4px;\n  --radius-pill: 999px;\n  --tap: 44px;\n  --space-6: 32px;\n  --space-7: 48px;\n  --vline-h: 49px; /* R7: .vline's own rendered height -- flow.css's sticky .flow-bar sits at top:var(--vline-h) instead of also claiming top:0 */\n\n  /* Colour: neutral true black (what users actually see), re-derived from\n   * itself rather than left mixed with the blue-grey tokens the palette\n   * started from (--raised #262d33 etc). */\n  --bg:         #000;\n  --surface:    #0b0c0d;\n  --surface-2:  #141617;\n  --raised:     #1d2022;\n  --rule:       #2a2d30;\n  --rule-soft:  #1c1f21;\n\n  --ink:        #f2f4f5;\n  --ink-2:      #b9c0c5;\n  --ink-3:      #8f99a1;   /* >= 4.5:1 on --surface-2 */\n\n  --accent:     #e8565c;     /* identity + destructive emphasis only */\n  --accent-ink: #1a0506;     /* text ON a solid --accent fill (see G5) */\n  --accent-dim: #3a1e20;\n\n  /* Semantic severity. Deliberately not the accent: a code's state must not\n   * read as \"the brand colour\", and these four have to be distinguishable\n   * from each other at a glance across a workshop. */\n  --sev-returned: #e8565c;   --sev-returned-bg: #33191b;\n  --sev-chronic:  #d9a63c;   --sev-chronic-bg:  #2e2513;\n  --sev-cleared:  #6aa6d8;   --sev-cleared-bg:  #16242e;\n  --sev-once:     #7d888f;   --sev-once-bg:     #21282c;\n  /* True green, not the teal this token used to carry -- it now sits at the\n   * same lightness/saturation the other four severities use, but reads as\n   * unambiguously \"good\" the way it does on this app's subject rather than\n   * being mistaken for --sev-cleared's blue. */\n  --ok:           #52b579;   --ok-bg:           #12291d;\n\n  /* Per-code-family colours for cuore/web/timeline_svg.py. Chosen to stay\n   * visually distinct from --accent and from each other, and from\n   * --sev-cleared's blue. */\n  --fam-mil:     #e8565c;\n  --fam-evap:    #3fb0ae;\n  --fam-network: #a986ef;\n  --fam-body:    #d98a3c;\n  --fam-chassis: #5b8fd9;\n  --fam-engine:  #8fae4a;\n}\n\n@media (prefers-color-scheme: light) {\n  :root:not([data-theme=\"dark\"]) {\n    color-scheme: light;\n    --bg:        #eef0f2;\n    --surface:   #f7f8f9;\n    --surface-2: #e8ebee;\n    --raised:    #dde2e6;\n    --rule:      #ccd3d8;\n    --rule-soft: #dee3e7;\n    --ink:       #14181b;\n    --ink-2:     #3d464c;\n    --ink-3:     #5b656c;  /* 4.98:1 on --surface-2 (old #68737a was 4.06:1) */\n    --accent:    #9e1b21;\n    --accent-ink:#fff;\n    --accent-dim:#f0dcdc;\n    --sev-returned: #9e1b21;  --sev-returned-bg: #f4dedf;\n    --sev-chronic:  #8a5d06;  --sev-chronic-bg:  #f5e8cd;\n    --sev-cleared: