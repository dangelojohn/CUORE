 cursor: pointer; font-family: inherit;\n< 644:  font-family: var(--mono); font-size: 12px; background: var(--surface-2); color: var(--ink);\n< 669:  font-family: var(--mono); font-size: 12px; font-weight: 650; color: var(--ink);\n< 693:  font-family: var(--mono); font-size: 11.5px; color: var(--ink-3); font-weight: 500;\n< 725:  flex: none; font-family: var(--mono); font-size: 8.5px; letter-spacing: .02em;\n< 1057:  font-size: 13px; font-family: inherit; cursor: pointer;\n< 1123:  font-size: 13px; font-family: inherit; cursor: pointer;\n< 1238:.hero-vin, .hero-km { font-family: var(--mono); font-size: 13px; color: rgba(255,255,255,.82); }\n< 1370:.pm-step .pm-n { font-size: 10px; font-family: var(--mono); }\n---\n> 28:  --sans: system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\",\n> 30:  --mono: ui-monospace, \"SFMono-Regular\", \"Cascadia Mono\", Menlo, Consolas,\n> 207:  font-family: var(--sans);\n> 218: * font-family:inherit themselves. One rule, every control. */\n> 235:  font-family: var(--mono); font-size: var(--mono-scale); font-variant-ligatures: none;\n> 311:  font-family: var(--mono); text-transform: uppercase; pointer-events: none;\n> 343:  font-family: var(--mono); font-size: var(--fs-xs); color: var(--ink-3);\n> 374:  font-family: var(--mono); font-size: var(--fs-xs); color: var(--ink-3);\n> 379:  font-family: var(--mono); font-size: var(--fs-xs); color: var(--ink-3);\n> 411:.mono { font-family: var(--mono); font-variant-numeric: tabular-nums; }\n> 457:td.n, th.n { text-align: right; font-family: var(--mono);\n> 459:td .mono, td.mono { font-family: var(--mono); font-size: var(--fs-xs);\n> 472:  display: inline-block; font-family: var(--mono);\n> 504:  display: block; font-family: var(--mono); font-size: var(--fs-xs);\n> 516:  font-family: var(--mono); font-size: var(--fs-xs); color: var(--ok); margin-top: 4px;\n> 534:  padding: 7px 9px; font-family: inherit; font-size: var(--fs-sm);\n> 542:  padding: 7px 14px; font-size: var(--fs-sm); fo