{"parentUuid":"bf268196-77c2-4dfd-801f-85a13dfb8b41","isSidechain":true,"agentId":"a09009e70701a4229","message":{"model":"claude-sonnet-5","id":"msg_011Cg2TNp1SzMxnTUhWbtY1f","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_017DQ4Nve8xvv59wXf5JZraF","name":"Read","input":{"file_path":"C:\\Users\\User\\mcp-servers\\cuore\\tests\\check_type_scale.py"},"caller":{"type":"direct"}}],"container":null,"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":3631,"cache_read_input_tokens":119931,"output_tokens":309,"output_tokens_details":{"thinking_tokens":113},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":0,"ephemeral_5m_input_tokens":3631},"inference_geo":"global","iterations":[{"input_tokens":2,"output_tokens":309,"cache_read_input_tokens":119931,"cache_creation_input_tokens":3631,"cache_creation":{"ephemeral_5m_input_tokens":3631,"ephemeral_1h_input_tokens":0},"type":"message"}],"speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_017DQ4Nve8xvv59wXf5JZraF":{"file_path":"C:\\Users\\User\\mcp-servers\\cuore\\tests\\check_type_scale.py"}},"serverClassifierRequest":"c4a8c26a-2ce9-423a-b43a-b5ad49a1700c","apiBlockIndex":2,"requestId":"req_011Cg2TNobQ1j7yFYMyBJXpN","attributionAgent":"general-purpose","type":"assistant","uuid":"9732dee7-bfe0-42c5-9030-a9cc4f12e10f","timestamp":"2026-10-14T16:36:25.778Z","effort":"high","perTurnEffort":null,"userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
{"parentUuid":"9732dee7-bfe0-42c5-9030-a9cc4f12e10f","isSidechain":true,"promptId":"1c6f2dc4-d93b-4328-a442-b4c97ea56d4f","agentId":"a09009e70701a4229","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017DQ4Nve8xvv59wXf5JZraF","type":"tool_result","content":"1\t\"\"\"Checks for TYPE_AND_UI_AUDIT_2026-10-14's foundation pass (section 1 +\n2\troot causes R1/R2/R6): one 7-step type scale, one colour-token :root block\n3\tper theme, one body font-size rule, and no horizontal page overflow at\n4\t485px on the three pages the audit measured it on (Bench, Job, Scan).\n5\t\n6\tStatic checks (always run, no server/browser needed):\n7\t  1. Every ``font-size`` declaration in the CSS files this pass owns\n8\t     (cuore.css, flow.css, icons.css, print.css, fullscan.css,\n9\t     liveboard.css, feedback.css, job.css, tests.css, scanlog.css,\n10\t     scan_health.css, system.css, systems.css, mods.css, m.css) is one of\n11\t     the 7 scale tokens (``var(--fs-xs|sm|md|lg|xl|2xl|3xl)``), ``0``,\n12\t     ``inherit``, or a ``pt`` value inside print.css (the one physical-unit\n13\t     exception the spec calls out for the print medium).\n14\t  2. cuore.css defines exactly one bare ``:root { ... }`` colour/type\n15\t     token block (the dark foundation) and exactly one\n16\t     ``:root[data-theme=\"light\"] { ... }`` block, whose declared custom\n17\t     properties are the identical *set* of names as the\n18\t     ``@media (prefers-color-scheme: light) { :root:not(...) { ... } }``\n19\t     mirror -- i.e. light is declared twice (the mechanism: explicit\n20\t     override + system-preference fallback), never three times, and\n21\t     never with a different token set between the two.\n22\t  3. cuore.css declares exactly one ``body { ... font-size ... }`` rule.\n23\t\n24\tBrowser check (Bench/Job/Scan, 485px, dark): if headless Edge is on this\n25\tmachine, a real uvicorn server + CDP measure ``document.documentElement\n26\t.scrollWidth`` vs ``innerWidth`` -- the audit's own acceptance line\n27\t(\"document.scrollWidth must equal the viewport at 485px\"). Edge missing ->\n28\tthis half is skipped with a note, the static checks above still run and\n29\tstill gate the suite.\n30\t\n31\tRun:\n32\t    .venv/Scripts/python.exe cuore/tests/check_type_scale.py\n33\t\"\"\"\n34\t\n35\tfrom __future__ import annotations\n36\t\n37\timport itertools\n38\timport json\n39\timport os\n40\timport re\n41\timport socket\n42\timport subprocess\n43\timport sys\n44\timport tempfile\n45\timport time\n46\timport urllib.request\n47\tfrom pathlib import Path\n48\t\n49\tos.environ[\"CUORE_STATE_DIR\"] = tempfile.mkdtemp(prefix=\"cuore-check-typescale-\")\n50\tos.environ.pop(\"CUORE_AUDIT_PATH\", None)\n51\t\n52\tROOT = Path(__file__).resolve().parents[2]\n53\tSTATIC_DIR = ROOT / \"cuore\" / \"web\" / \"static\"\n54\tsys.path.insert(0, str(ROOT))\n55\t\n56\tVIN = \"ZASFAKPN5J7B88115\"  # the Stelvio -- real corpus\n57\t\n58\tOWNED_CSS = [\n59\t    \"cuore.css\", \"flow.css\", \"icons.css\", \"print.css\", \"fullscan.css\",\n60\t    \"liveboard.css\", \"feedback.css\", \"job.css\", \"tests.css\", \"scanlog.css\",\n61\t    \"scan_health.css\", \"system.css\", \"systems.css\", \"mods.css\", \"m.css\",\n62\t]\n63\t\n64\tSCALE_TOKENS = {\"xs\", \"sm\", \"md\", \"lg\", \"xl\", \"2xl\", \"3xl\"}\n65\t\n66\tEDGE_CANDIDATES = [\n67\t    r\"C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe\",\n68\t    r\"C:\\Program Files\\Microsoft\\Edge\\Application\\msedge.exe\",\n69\t]\n70\t\n71\tfailures: list[str] = []\n72\tchecks = 0\n73\t\n74\t\n75\tdef check(label: str, cond: bool, detail: str = \"\") -> None:\n76\t    global checks\n77\t    checks += 1\n78\t    if not cond:\n79\t        failures.append(f\"{label}{(' -- ' + detail) if detail else ''}\")\n80\t\n81\t\n82\t_COMMENT_RE = re.compile(r\"/\\*.*?\\*/\", re.DOTALL)\n83\t_FONT_SIZE_RE = re.compile(r\"font-size\\s*:\\s*([^;}\\n]+)\")\n84\t_ALLOWED_VALUE_RE = re.compile(\n85\t    r\"^var\\(--fs-(?:xs|sm|md|lg|xl|2xl|3xl)\\)$|^0$|^inherit$\"\n86\t    r\"|^var\\(--mono-scale\\)$\"  # code/kbd/samp/.mono: a relative *scale* on\n87\t                               # top of whichever --fs-* token is already in\n88\t                               # play, not a competing absolute size\n89\t    r\"|^100%$\"                 # html{font-size:100%} -- the rem base reset,\n90\t                               # not a content font-size\n91\t)\n92\t_PT_RE = re.compile(r\"^[0-9.]+pt$\")\n93\t\n94\t\n95\tdef _strip_comments(css: str) -> str:\n96\t    return _COMMENT_RE.sub(\"\", css)\n97\t\n98\t\n99\t# ---------------------------------------------------------------------------\n100\t# Static check 1: scale-token-only font-size\n101\t# ---------------------------------------------------------------------------\n102\t\n103\tbad_sizes: list[str] = []\n104\tseen_distinct: set[str] = set()\n105\tfor fname in OWNED_CSS:\n106\t    path = STATIC_DIR / fname\n107\t    if not path.exists():\n108\t        bad_sizes.append(f\"{fname}: file missing\")\n109\t        continue\n110\t    text = _strip_comments(path.read_text(encoding=\"utf-8\"))\n111\t    for m in _FONT_SIZE_RE.finditer(text):\n112\t        value = m.group(1).strip()\n113\t        seen_distinct.add(value)\n114\t        if _ALLOWED_VALUE_RE.match(value):\n115\t            continue\n116\t        if fname == \"print.css\" and _PT_RE.match(value):\n117\t            continue\n118\t        bad_sizes.append(f\"{fname}: font-size: {value}\")\n119\t\n120\tcheck(\"every font-size in the owned CSS uses only the 7 scale tokens \"\n121\t      \"(plus 0/inherit, plus print.css pt values)\",\n122\t      not bad_sizes, \"; \".join(bad_sizes[:15]) + (\"...\" if len(bad_sizes) > 15 else \"\"))\n123\t\n124\tdistinct_tokens = {v for v in seen_distinct if _ALLOWED_VALUE_RE.match(v)}\n125\tdistinct_scale = {v for v in distinct_tokens if v.startswith(\"var(--fs-\")}\n126\tcheck(f\"<= 7 distinct scale tokens actually used (found {len(distinct_scale)})\",\n127\t      len(distinct_scale) <= 7, \", \".join(sorted(distinct_scale)))\n128\t\n129\t# ---------------------------------------------------------------------------\n130\t# Static check 2: one :root colour/type block per theme in cuore.css\n131\t# ---------------------------------------------------------------------------\n132\t\n133\tcuore_css_raw = (STATIC_DIR / \"cuore.css\").read_text(encoding=\"utf-8\")\n134\tcuore_css = _strip_comments(cuore_css_raw)\n135\t\n136\tbare_root_blocks = re.findall(r\"(?m)^:root\\s*\\{\", cuore_css)\n137\tlight_explicit_blocks = re.findall(r'(?m)^:root\\[data-theme=\"light\"\\]\\s*\\{', cuore_css)\n138\t\n139\t# A handful of small, single-purpose bare :root blocks are fine (the\n140\t# data-marque accent swap is its own attribute-selector block, not a bare\n141\t# :root) -- what R2 forbids is multiple bare :root blocks that each\n142\t# redeclare the *same* colour/type tokens with different values. Detect\n143\t# that directly: collect every custom-property name declared inside any\n144\t# bare `:root { ... }` block and make sure each name is declared in at\n145\t# most one such block.\n146\troot_prop_owner: dict[str, str] = {}\n147\tdupe_props: list[str] = []\n148\tfor idx, m in enumerate(re.finditer(r\"(?m)^:root\\s*\\{([^}]*)\\}\", cuore_css)):\n149\t    body = m.group(1)\n150\t    for prop_m in re.finditer(r\"(--[a-zA-Z0-9-]+)\\s*:\", body):\n151\t        prop = prop_m.group(1)\n152\t        if prop in root_prop_owner and root_prop_owner[prop] != idx:\n153\t            dupe_props.append(prop)\n154\t        root_prop_owner[prop] = idx\n155\t\n156\tcheck(\"no colour/type custom property is declared in more than one bare \"\n157\t      \":root block in cuore.css\",\n158\t      not dupe_props, \", \".join(sorted(set(dupe_props))))\n159\t\n160\tcheck('exactly one :root[data-theme=\"light\"] block in cuore.css',\n161\t      len(light_explicit_blocks) == 1, f\"found {len(light_explicit_blocks)}\")\n162\t\n163\t# The light override and its prefers-color-scheme mirror must declare the\n164\t# same *set* of custom-property names (the spec's own example does this on\n165\t# purpose -- a mechanism, not a duplicate -- but the two must actually agree).\n166\tlight_explicit_m = re.search(r'(?m)^:root\\[data-theme=\"light\"\\]\\s*\\{([^}]*)\\}', cuore_css)\n167\tlight_media_m = re.search(\n168\t    r'@media \\(prefers-color-scheme: light\\)\\s*\\{\\s*:root:not\\(\\[data-theme=\"dark\"\\]\\)\\s*\\{([^}]*)\\}',\n169\t    cuore_css)\n170\tif light_explicit_m and light_media_m:\n171\t    explicit_props = set(re.findall(r\"(--[a-zA-Z0-9-]+)\\s*:\", light_explicit_m.group(1)))\n172\t    media_props = set(re.findall(r\"(--[a-zA-Z0-9-]+)\\s*:\", light_media_m.group(1)))\n173\t    check(\"the light :root override and its prefers-color-scheme mirror \"\n174\t          \"declare the same set of custom properties\",\n175\t          explicit_props == media_props,\n176\t          f\"only-in-explicit={explicit_props - media_props} \"\n177\t          f\"only-in-media={media_props - explicit_props}\")\n178\telse:\n179\t    check(\"light :root override and prefers-color-scheme mirror both found\", False,\n180\t          f\"explicit={'found' if light_explicit_m else 'MISSING'} \"\n181\t          f\"media={'found' if light_media_m else 'MISSING'}\")\n182\t\n183\t# ---------------------------------------------------------------------------\n184\t# Static check 3: one body font-size rule\n185\t# ---------------------------------------------------------------------------\n186\t\n187\tbody_rules_with_fs = re.findall(r\"(?m)^body\\s*\\{[^}]*font-size[^}]*\\}\", cuore_css)\n188\tcheck(\"exactly one body rule sets font-size in cuore.css\",\n189\t      len(body_rules_with_fs) == 1, f\"found {len(body_rules_with_fs)}\")\n190\t\n191\t# button/input/select/textarea inherit the page font (R3)\n192\tcheck(\"button/input/select/textarea inherit the page font (R3)\",\n193\t      \"button, input, select, textarea {\" in cuore_css\n194\t      and \"font: inherit\" in cuore_css, \"\")\n195\t\n196\tprint(f\"static checks done: {checks} so far, {len(failures)} failing\")\n197\t\n198\t# ---------------------------------------------------------------------------\n199\t# Browser check: no horizontal overflow at 485px on Bench/Job/Scan\n200\t# ---------------------------------------------------------------------------\n201\t\n202\t\n203\tdef find_edge() -> str:\n204\t    for candidate in EDGE_CANDIDATES:\n205\t        if Path(candidate).exists():\n206\t            return candidate\n207\t    return \"\"\n208\t\n209\t\n210\tdef free_port() -> int:\n211\t    s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)\n212\t    s.bind((\"127.0.0.1\", 0))\n213\t    port = s.getsockname()[1]\n214\t    s.close()\n215\t    return port\n216\t\n217\t\n218\tclass CDP:\n219\t    def __init__(self, ws_url: str) -> None:\n220\t        from websockets.sync.client import connect\n221\t        self.ws = connect(ws_url, max_size=None, open_timeout=20)\n222\t        self._ids = itertools.count(1)\n223\t\n224\t    def send(self, method: str, params: dict | None = None, timeout: float = 20):\n225\t        msg_id = next(self._ids)\n226\t        self.ws.send(json.dumps({\"id\": msg_id, \"method\": method, \"params\": params or {}}))\n227\t        deadline = time.time() + timeout\n228\t        while time.time() < deadline:\n229\t            raw = self.ws.recv(timeout=max(0.1, deadline - time.time()))\n230\t            msg = json.loads(raw)\n231\t            if msg.get(\"id\") == msg_id:\n232\t                if \"error\" in msg:\n233\t                    raise RuntimeError(f\"CDP {method} failed: {msg['error']}\")\n234\t                return msg.get(\"result\", {})\n235\t        raise TimeoutError(f\"CDP {method} timed out waiting for response\")\n236\t\n237\t    def close(self) -> None:\n238\t        try:\n239\t            self.ws.close()\n240\t        except Exception:\n241\t            pass\n242\t\n243\t    def eval_value(self, expr: str):\n244\t        out = self.send(\"Runtime.evaluate\", {\"expression\": expr, \"returnByValue\": True})\n245\t        return out.get(\"result\", {}).get(\"value\")\n246\t\n247\t\n248\tdef wait_for_devtools(port: int, timeout: float = 20) -> None:\n249\t    deadline = time.time() + timeout\n250\t    last_err: Exception | None = None\n251\t    while time.time() < deadline:\n252\t        try:\n253\t            with urllib.request.urlopen(f\"http://127.0.0.1:{port}/json/version\", timeout=2) as r:\n254\t                json.loads(r.read().decode(\"utf-8\"))\n255\t                return\n256\t        except Exception as exc:  # noqa: BLE001\n257\t            last_err = exc\n258\t            time.sleep(0.2)\n259\t    raise RuntimeError(f\"headless Edge devtools endpoint never came up: {last_err}\")\n260\t\n261\t\n262\tdef open_target(port: int, url: str) -> dict:\n263\t    req = urllib.request.Request(f\"http://127.0.0.1:{port}/json/new?{url}\", method=\"PUT\")\n264\t    with urllib.request.urlopen(req, timeout=10) as r:\n265\t        return json.loads(r.read().decode(\"utf-8\"))\n266\t\n267\t\n268\tdef wait_for_port(port: int, timeout: float = 15.0) -> bool:\n269\t    deadline = time.monotonic() + timeout\n270\t    while time.monotonic() < deadline:\n271\t        try:\n272\t            with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:\n273\t                s.settimeout(0.3)\n274\t                s.connect((\"127.0.0.1\", port))\n275\t                return True\n276\t        except OSError:\n277\t            time.sleep(0.2)\n278\t    return False\n279\t\n280\t\n281\tdef wait_for_navigation(cdp: CDP, timeout: float = 15.0) -> bool:\n282\t    deadline = time.time() + timeout\n283\t    while time.time() < deadline:\n284\t        val = cdp.eval_value(\n285\t            \"JSON.stringify({href: location.href, ready: document.readyState})\")\n286\t        try:\n287\t            state = json.loads(val or \"{}\")\n288\t        except ValueError:\n289\t            state = {}\n290\t        if state.get(\"href\", \"about:blank\") != \"about:blank\" and state.get(\"ready\") == \"complete\":\n291\t            return True\n292\t        time.sleep(0.3)\n293\t    return False\n294\t\n295\t\n296\tdef navigate(devtools_port: int, url: str, width: int, height: int) -> CDP:\n297\t    target = open_target(devtools_port, \"about:blank\")\n298\t    cdp = CDP(target[\"webSocketDebuggerUrl\"])\n299\t    cdp.send(\"Page.enable\")\n300\t    cdp.send(\"Runtime.enable\")\n301\t    cdp.send(\"Emulation.setEmulatedMedia\",\n302\t             {\"features\": [{\"name\": \"prefers-color-scheme\", \"value\": \"dark\"}]})\n303\t    cdp.send(\"Page.navigate\", {\"url\": url})\n304\t    wait_for_navigation(cdp)\n305\t    cdp.send(\"Emulation.setDeviceMetricsOverride\", {\n306\t        \"width\": width, \"height\": height, \"deviceScaleFactor\": 1, \"mobile\": True,\n307\t    })\n308\t    time.sleep(0.4)\n309\t    return cdp\n310\t\n311\t\n312\tedge = find_edge()\n313\tif not edge:\n314\t    print(\"headless Edge not found -- skipping the browser scrollWidth checks \"\n315\t          \"(static checks above still gate this suite)\")\n316\telse:\n317\t    server_dir = tempfile.mkdtemp(prefix=\"cuore-check-typescale-server-\")\n318\t    port = free_port()\n319\t    env = dict(os.environ)\n320\t    env[\"CUORE_STATE_DIR\"] = server_dir\n321\t\n322\t    _SERVER_SNIPPET = f\"\"\"\n323\timport sys\n324\tsys.path.insert(0, {str(ROOT)!r})\n325\tfrom cuore.app import create_app\n326\timport uvicorn\n327\t\n328\tapp = create_app()\n329\tuvicorn.run(app, host=\"127.0.0.1\", port={port}, log_level=\"warning\")\n330\t\"\"\"\n331\t\n332\t    server_proc = subprocess.Popen(\n333\t        [sys.executable, \"-c\", _SERVER_SNIPPET],\n334\t        cwd=str(ROOT), env=env,\n335\t        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,\n336\t    )\n337\t    try:\n338\t        if not wait_for_port(port):\n339\t            print(\"uvicorn never came up -- skipping the browser checks\")\n340\t        else:\n341\t            time.sleep(0.3)\n342\t            devtools_port = free_port()\n343\t            profile_dir = Path(tempfile.mkdtemp(prefix=\"cuore-edge-typescale-\"))\n344\t            edge_proc = subprocess.Popen(\n345\t                [edge, \"--headless=new\", f\"--remote-debugging-port={devtools_port}\",\n346\t                 f\"--user-data-dir={profile_dir}\", \"--no-first-run\",\n347\t                 \"--window-size=485,1200\", \"about:blank\"],\n348\t                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,\n349\t            )\n350\t            try:\n351\t                wait_for_devtools(devtools_port)\n352\t\n353\t                pages = {\n354\t                    \"bench\": f\"http://127.0.0.1:{port}/v/{VIN}\",\n355\t                    \"job\": f\"http://127.0.0.1:{port}/v/{VIN}/job\",\n356\t                    \"scan\": f\"http://127.0.0.1:{port}/v/{VIN}/scan\",\n357\t                }\n358\t                for name, url in pages.items():\n359\t                    cdp = navigate(devtools_port, url, 485, 1200)\n360\t                    try:\n361\t                        dims = json.loads(cdp.eval_value(\n362\t                            \"JSON.stringify({sw: document.documentElement.scrollWidth, \"\n363\t                            \"cw: document.documentElement.clientWidth})\"))\n364\t                        sw, cw = dims.get(\"sw\", 0), dims.get(\"cw\", 0)\n365\t                        check(f\"no horizontal overflow at 485px on {name}\",\n366\t                              sw <= cw + 1, f\"scrollWidth={sw} clientWidth={cw}\")\n367\t                    finally:\n368\t                        cdp.close()\n369\t            finally:\n370\t                edge_proc.terminate()\n371\t                try:\n372\t                    edge_proc.wait(timeout=5)\n373\t                except Exception:\n374\t                    edge_proc.kill()\n375\t                from _edge_cleanup import kill_edge_profile\n376\t                kill_edge_profile(profile_dir)\n377\t    finally:\n378\t        server_proc.terminate()\n379\t        try:\n380\t            server_proc.wait(timeout=5)\n381\t        except Exception:\n382\t            server_proc.kill()\n383\t\n384\t\n385\t# --- report ------------------------------------------------------------------\n386\t\n387\tprint()\n388\tif failures:\n389\t    print(f\"{len(failures)}/{checks} check(s) failed:\")\n390\t    for f in failures:\n391\t        print(f\"  - {f}\")\n392\t    sys.exit(1)\n393\tprint(f\"all {checks} checks passed\")\n394\t"}]},"uuid":"5fc7d421-b091-445d-ac22-c38274c55f64","timestamp":"2026-10-14T16:36:25.806Z","toolUseResult":{"type":"text","file":{"filePath":"C:\\Users\\User\\mcp-servers\\cuore\\tests\\check_type_scale.py","content":"\"\"\"Checks for TYPE_AND_UI_AUDIT_2026-10-14's foundation pass (section 1 +\nroot causes R1/R2/R6): one 7-step type scale, one colour-token :root block\nper theme, one body font-size rule, and no horizontal page overflow at\n485px on the three pages the audit measured it on (Bench, Job, Scan).\n\nStatic checks (always run, no server/browser needed):\n  1. Every ``font-size`` declaration in the CSS files this pass owns\n     (cuore.css, flow.css, icons.css, print.css, fullscan.css,\n     liveboard.css, feedback.css, job.css, tests.css, scanlog.css,\n     scan_health.css, system.css, systems.css, mods.css, m.css) is one of\n     the 7 scale tokens (``var(--fs-xs|sm|md|lg|xl|2xl|3xl)``), ``0``,\n     ``inherit``, or a ``pt`` value inside print.css (the one physical-unit\n     exception the spec calls out for the print medium).\n  2. cuore.css defines exactly one bare ``:root { ... }`` colour/type\n     token block (the dark foundation) and exactly one\n     ``:root[data-theme=\"light\"] { ... }`` block, whose declared custom\n     properties are the identical *set* of names as the\n     ``@media (prefers-color-scheme: light) { :root:not(...) { ... } }``\n     mirror -- i.e. light is declared twice (the mechanism: explicit\n     override + system-preference fallback), never three times, and\n     never with a different token set between the two.\n  3. cuore.css declares exactly one ``body { ... font-size ... }`` rule.\n\nBrowser check (Bench/Job/Scan, 485px, dark): if headless Edge is on this\nmachine, a real uvicorn server + CDP measure ``document.documentElement\n.scrollWidth`` vs ``innerWidth`` -- the audit's own acceptance line\n(\"document.scrollWidth must equal the viewport at 485px\"). Edge missing ->\nthis half is skipped with a note, the static checks above still run and\nstill gate the suite.\n\nRun:\n    .venv/Scripts/python.exe cuore/tests/check_type_scale.py\n\"\"\"\n\nfrom __future__ import annotations\n\nimport itertools\nimport json\nimport os\nimport re\nimport socket\nimport subprocess\nimport sys\nimport tempfile\nimport time\nimport urllib.request\nfrom pathlib import Path\n\nos.environ[\"CUORE_STATE_DIR\"] = tempfile.mkdtemp(prefix=\"cuore-check-typescale-\")\nos.environ.pop(\"CUORE_AUDIT_PATH\", None)\n\nROOT = Path(__file__).resolve().parents[2]\nSTATIC_DIR = ROOT / \"cuore\" / \"web\" / \"static\"\nsys.path.insert(0, str(ROOT))\n\nVIN = \"ZASFAKPN5J7B88115\"  # the Stelvio -- real corpus\n\nOWNED_CSS = [\n    \"cuore.css\", \"flow.css\", \"icons.css\", \"print.css\", \"fullscan.css\",\n    \"liveboard.css\", \"feedback.css\", \"job.css\", \"tests.css\", \"scanlog.css\",\n    \"scan_health.css\", \"system.css\", \"systems.css\", \"mods.css\", \"m.css\",\n]\n\nSCALE_TOKENS = {\"xs\", \"sm\", \"md\", \"lg\", \"xl\", \"2xl\", \"3xl\"}\n\nEDGE_CANDIDATES = [\n    r\"C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe\",\n    r\"C:\\Program Files\\Microsoft\\Edge\\Application\\msedge.exe\",\n]\n\nfailures: list[str] = []\nchecks = 0\n\n\ndef check(label: str, cond: bool, detail: str = \"\") -> None:\n    global checks\n    checks += 1\n    if not cond:\n        failures.append(f\"{label}{(' -- ' + detail) if detail else ''}\")\n\n\n_COMMENT_RE = re.compile(r\"/\\*.*?\\*/\", re.DOTALL)\n_FONT_SIZE_RE = re.compile(r\"font-size\\s*:\\s*([^;}\\n]+)\")\n_ALLOWED_VALUE_RE = re.compile(\n    r\"^var\\(--fs-(?:xs|sm|md|lg|xl|2xl|3xl)\\)$|^0$|^inherit$\"\n    r\"|^var\\(--mono-scale\\)$\"  # code/kbd/samp/.mono: a relative *scale* on\n                               # top of whichever --fs-* token is already in\n                               # play, not a competing absolute size\n    r\"|^100%$\"                 # html{font-size:100%} -- the rem base reset,\n                               # not a content font-size\n)\n_PT_RE = re.compile(r\"^[0-9.]+pt$\")\n\n\ndef _strip_comments(css: str) -> str:\n    return _COMMENT_RE.sub(\"\", css)\n\n\n# ---------------------------------------------------------------------------\n# Static check 1: scale-token-only font-size\n# ---------------------------------------------------------------------------\n\nbad_sizes: list[str] = []\nseen_distinct: set[str] = set()\nfor fname in OWNED_CSS:\n    path = STATIC_DIR / fname\n    if not path.exists():\n        bad_sizes.append(f\"{fname}: file missing\")\n        continue\n    text = _strip_comments(path.read_text(encoding=\"utf-8\"))\n    for m in _FONT_SIZE_RE.finditer(text):\n        value = m.group(1).strip()\n        seen_distinct.add(value)\n        if _ALLOWED_VALUE_RE.match(value):\n            continue\n        if fname == \"print.css\" and _PT_RE.match(value):\n            continue\n        bad_sizes.append(f\"{fname}: font-size: {value}\")\n\ncheck(\"every font-size in the owned CSS uses only the 7 scale tokens \"\n      \"(plus 0/inherit, plus print.css pt values)\",\n      not bad_sizes, \"; \".join(bad_sizes[:15]) + (\"...\" if len(bad_sizes) > 15 else \"\"))\n\ndistinct_tokens = {v for v in seen_distinct if _ALLOWED_VALUE_RE.match(v)}\ndistinct_scale = {v for v in distinct_tokens if v.startswith(\"var(--fs-\")}\ncheck(f\"<= 7 distinct scale tokens actually used (found {len(distinct_scale)})\",\n      len(distinct_scale) <= 7, \", \".join(sorted(distinct_scale)))\n\n# ---------------------------------------------------------------------------\n# Static check 2: one :root colour/type block per theme in cuore.css\n# ---------------------------------------------------------------------------\n\ncuore_css_raw = (STATIC_DIR / \"cuore.css\").read_text(encoding=\"utf-8\")\ncuore_css = _strip_comments(cuore_css_raw)\n\nbare_root_blocks = re.findall(r\"(?m)^:root\\s*\\{\", cuore_css)\nlight_explicit_blocks = re.findall(r'(?m)^:root\\[data-theme=\"light\"\\]\\s*\\{', cuore_css)\n\n# A handful of small, single-purpose bare :root blocks are fine (the\n# data-marque accent swap is its own attribute-selector block, not a bare\n# :root) -- what R2 forbids is multiple bare :root blocks that each\n# redeclare the *same* colour/type tokens with different values. Detect\n# that directly: collect every custom-property name declared inside any\n# bare `:root { ... }` block and make sure each name is declared in at\n# most one such block.\nroot_prop_owner: dict[str, str] = {}\ndupe_props: list[str] = []\nfor idx, m in enumerate(re.finditer(r\"(?m)^:root\\s*\\{([^}]*)\\}\", cuore_css)):\n    body = m.group(1)\n    for prop_m in re.finditer(r\"(--[a-zA-Z0-9-]+)\\s*:\", body):\n        prop = prop_m.group(1)\n        if prop in root_prop_owner and root_prop_owner[prop] != idx:\n            dupe_props.append(prop)\n        root_prop_owner[prop] = idx\n\ncheck(\"no colour/type custom property is declared in more than one bare \"\n      \":root block in cuore.css\",\n      not dupe_props, \", \".join(sorted(set(dupe_props))))\n\ncheck('exactly one :root[data-theme=\"light\"] block in cuore.css',\n      len(light_explicit_blocks) == 1, f\"found {len(light_explicit_blocks)}\")\n\n# The light override and its prefers-color-scheme mirror must declare the\n# same *set* of custom-property names (the spec's own example does this on\n# purpose -- a mechanism, not a duplicate -- but the two must actually agree).\nlight_explicit_m = re.search(r'(?m)^:root\\[data-theme=\"light\"\\]\\s*\\{([^}]*)\\}', cuore_css)\nlight_media_m = re.search(\n    r'@media \\(prefers-color-scheme: light\\)\\s*\\{\\s*:root:not\\(\\[data-theme=\"dark\"\\]\\)\\s*\\{([^}]*)\\}',\n    cuore_css)\nif light_explicit_m and light_media_m:\n    explicit_props = set(re.findall(r\"(--[a-zA-Z0-9-]+)\\s*:\", light_explicit_m.group(1)))\n    media_props = set(re.findall(r\"(--[a-zA-Z0-9-]+)\\s*:\", light_media_m.group(1)))\n    check(\"the light :root override and its prefers-color-scheme mirror \"\n          \"declare the same set of custom properties\",\n          explicit_props == media_props,\n          f\"only-in-explicit={explicit_props - media_props} \"\n          f\"only-in-media={media_props - explicit_props}\")\nelse:\n    check(\"light :root override and prefers-color-scheme mirror both found\", False,\n          f\"explicit={'found' if light_explicit_m else 'MISSING'} \"\n          f\"media={'found' if light_media_m else 'MISSING'}\")\n\n# ---------------------------------------------------------------------------\n# Static check 3: one body font-size rule\n# ---------------------------------------------------------------------------\n\nbody_rules_with_fs = re.findall(r\"(?m)^body\\s*\\{[^}]*font-size[^}]*\\}\", cuore_css)\ncheck(\"exactly one body rule sets font-size in cuore.css\",\n      len(body_rules_with_fs) == 1, f\"found {len(body_rules_with_fs)}\")\n\n# button/input/select/textarea inherit the page font (R3)\ncheck(\"button/input/select/textarea inherit the page font (R3)\",\n      \"button, input, select, textarea {\" in cuore_css\n      and \"font: inherit\" in cuore_css, \"\")\n\nprint(f\"static checks done: {checks} so far, {len(failures)} failing\")\n\n# ---------------------------------------------------------------------------\n# Browser check: no horizontal overflow at 485px on Bench/Job/Scan\n# ---------------------------------------------------------------------------\n\n\ndef find_edge() -> str:\n    for candidate in EDGE_CANDIDATES:\n        if Path(candidate).exists():\n            return candidate\n    return \"\"\n\n\ndef free_port() -> int:\n    s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)\n    s.bind((\"127.0.0.1\", 0))\n    port = s.getsockname()[1]\n    s.close()\n    return port\n\n\nclass CDP:\n    def __init__(self, ws_url: str) -> None:\n        from websockets.sync.client import connect\n        self.ws = connect(ws_url, max_size=None, open_timeout=20)\n        self._ids = itertools.count(1)\n\n    def send(self, method: str, params: dict | None = None, timeout: float = 20):\n        msg_id = next(self._ids)\n        self.ws.send(json.dumps({\"id\": msg_id, \"method\": method, \"params\": params or {}}))\n        deadline = time.time() + timeout\n        while time.time() < deadline:\n            raw = self.ws.recv(timeout=max(0.1, deadline - time.time()))\n            msg = json.loads(raw)\n            if msg.get(\"id\") == msg_id:\n                if \"error\" in msg:\n                    raise RuntimeError(f\"CDP {method} failed: {msg['error']}\")\n                return msg.get(\"result\", {})\n        raise TimeoutError(f\"CDP {method} timed out waiting for response\")\n\n    def close(self) -> None:\n        try:\n            self.ws.close()\n        except Exception:\n            pass\n\n    def eval_value(self, expr: str):\n        out = self.send(\"Runtime.evaluate\", {\"expression\": expr, \"returnByValue\": True})\n        return out.get(\"result\", {}).get(\"value\")\n\n\ndef wait_for_devtools(port: int, timeout: float = 20) -> None:\n    deadline = time.time() + timeout\n    last_err: Exception | None = None\n    while time.time() < deadline:\n        try:\n            with urllib.request.urlopen(f\"http://127.0.0.1:{port}/json/version\", timeout=2) as r:\n                json.loads(r.read().decode(\"utf-8\"))\n                return\n        except Exception as exc:  # noqa: BLE001\n            last_err = exc\n            time.sleep(0.2)\n    raise RuntimeError(f\"headless Edge devtools endpoint never came up: {last_err}\")\n\n\ndef open_target(port: int, url: str) -> dict:\n    req = urllib.request.Request(f\"http://127.0.0.1:{port}/json/new?{url}\", method=\"PUT\")\n    with urllib.request.urlopen(req, timeout=10) as r:\n        return json.loads(r.read().decode(\"utf-8\"))\n\n\ndef wait_for_port(port: int, timeout: float = 15.0) -> bool:\n    deadline = time.monotonic() + timeout\n    while time.monotonic() < deadline:\n        try:\n            with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:\n                s.settimeout(0.3)\n                s.connect((\"127.0.0.1\", port))\n                return True\n        except OSError:\n            time.sleep(0.2)\n    return False\n\n\ndef wait_for_navigation(cdp: CDP, timeout: float = 15.0) -> bool:\n    deadline = time.time() + timeout\n    while time.time() < deadline:\n        val = cdp.eval_value(\n            \"JSON.stringify({href: location.href, ready: document.readyState})\")\n        try:\n            state = json.loads(val or \"{}\")\n        except ValueError:\n            state = {}\n        if state.get(\"href\", \"about:blank\") != \"about:blank\" and state.get(\"ready\") == \"complete\":\n            return True\n        time.sleep(0.3)\n    return False\n\n\ndef navigate(devtools_port: int, url: str, width: int, height: int) -> CDP:\n    target = open_target(devtools_port, \"about:blank\")\n    cdp = CDP(target[\"webSocketDebuggerUrl\"])\n    cdp.send(\"Page.enable\")\n    cdp.send(\"Runtime.enable\")\n    cdp.send(\"Emulation.setEmulatedMedia\",\n             {\"features\": [{\"name\": \"prefers-color-scheme\", \"value\": \"dark\"}]})\n    cdp.send(\"Page.navigate\", {\"url\": url})\n    wait_for_navigation(cdp)\n    cdp.send(\"Emulation.setDeviceMetricsOverride\", {\n        \"width\": width, \"height\": height, \"deviceScaleFactor\": 1, \"mobile\": True,\n    })\n    time.sleep(0.4)\n    return cdp\n\n\nedge = find_edge()\nif not edge:\n    print(\"headless Edge not found -- skipping the browser scrollWidth checks \"\n          \"(static checks above still gate this suite)\")\nelse:\n    server_dir = tempfile.mkdtemp(prefix=\"cuore-check-typescale-server-\")\n    port = free_port()\n    env = dict(os.environ)\n    env[\"CUORE_STATE_DIR\"] = server_dir\n\n    _SERVER_SNIPPET = f\"\"\"\nimport sys\nsys.path.insert(0, {str(ROOT)!r})\nfrom cuore.app import create_app\nimport uvicorn\n\napp = create_app()\nuvicorn.run(app, host=\"127.0.0.1\", port={port}, log_level=\"warning\")\n\"\"\"\n\n    server_proc = subprocess.Popen(\n        [sys.executable, \"-c\", _SERVER_SNIPPET],\n        cwd=str(ROOT), env=env,\n        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,\n    )\n    try:\n        if not wait_for_port(port):\n            print(\"uvicorn never came up -- skipping the browser checks\")\n        else:\n            time.sleep(0.3)\n            devtools_port = free_port()\n            profile_dir = Path(tempfile.mkdtemp(prefix=\"cuore-edge-typescale-\"))\n            edge_proc = subprocess.Popen(\n                [edge, \"--headless=new\", f\"--remote-debugging-port={devtools_port}\",\n                 f\"--user-data-dir={profile_dir}\", \"--no-first-run\",\n                 \"--window-size=485,1200\", \"about:blank\"],\n                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,\n            )\n            try:\n                wait_for_devtools(devtools_port)\n\n                pages = {\n                    \"bench\": f\"http://127.0.0.1:{port}/v/{VIN}\",\n                    \"job\": f\"http://127.0.0.1:{port}/v/{VIN}/job\",\n                    \"scan\": f\"http://127.0.0.1:{port}/v/{VIN}/scan\",\n                }\n                for name, url in pages.items():\n                    cdp = navigate(devtools_port, url, 485, 1200)\n                    try:\n                        dims = json.loads(cdp.eval_value(\n                            \"JSON.stringify({sw: document.documentElement.scrollWidth, \"\n                            \"cw: document.documentElement.clientWidth})\"))\n                        sw, cw = dims.get(\"sw\", 0), dims.get(\"cw\", 0)\n                        check(f\"no horizontal overflow at 485px on {name}\",\n                              sw <= cw + 1, f\"scrollWidth={sw} clientWidth={cw}\")\n                    finally:\n                        cdp.close()\n            finally:\n                edge_proc.terminate()\n                try:\n                    edge_proc.wait(timeout=5)\n                except Exception:\n                    edge_proc.kill()\n                from _edge_cleanup import kill_edge_profile\n                kill_edge_profile(profile_dir)\n    finally:\n        server_proc.terminate()\n        try:\n            server_proc.wait(timeout=5)\n        except Exception:\n            server_proc.kill()\n\n\n# --- report ------------------------------------------------------------------\n\nprint()\nif failures:\n    print(f\"{len(failures)}/{checks} check(s) failed:\")\n    for f in failures:\n        print(f\"  - {f}\")\n    sys.exit(1)\nprint(f\"all {checks} checks passed\")\n","numLines":394,"startLine":1,"totalLines":394}},"sourceToolAssistantUUID":"9732dee7-bfe0-42c5-9030-a9cc4f12e10f","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
