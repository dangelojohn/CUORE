xt.indexOf('background: var(--bg)') !== -1 && r.cssText.indexOf('body') !== -1)) {\n                  rules.push({href: ss.href, text: r.cssText.slice(0,200)});\n                }\n              }\n            } catch(e) { rules.push({err: String(e)}); }\n          }\n          return rules;\n        })())\"\"\")\n        print(\"matching body rules across all sheets:\", matched)\n        mq = ev(\"window.matchMedia('(prefers-color-scheme: dark)').matches\")\n        print(\"matchMedia dark:\", mq)","originalFile":"import itertools, json, os, socket, subprocess, sys, tempfile, time, urllib.request\nfrom pathlib import Path\n\nROOT = Path(r\"C:/Users/User/mcp-servers\")\nPYTHON = str(ROOT / \".venv\" / \"Scripts\" / \"python.exe\")\nVIN = \"ZASFAKPN5J7B88115\"\nEDGE = r\"C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe\"\n\ndef free_port():\n    s = socket.socket(socket.AF_INET, socket.SOCK_STREAM); s.bind((\"127.0.0.1\", 0))\n    p = s.getsockname()[1]; s.close(); return p\n\nport = free_port()\nenv = dict(os.environ)\nenv[\"CUORE_STATE_DIR\"] = tempfile.mkdtemp(prefix=\"cuore-dbg2-\")\nenv.pop(\"CUORE_AUDIT_PATH\", None)\nsnippet = f\"\"\"\nimport sys\nsys.path.insert(0, {str(ROOT)!r})\nfrom cuore.app import create_app\nimport uvicorn\napp = create_app()\nuvicorn.run(app, host=\"127.0.0.1\", port={port}, log_level=\"warning\")\n\"\"\"\nproc = subprocess.Popen([PYTHON, \"-c\", snippet], cwd=str(ROOT), env=env,\n                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)\ntry:\n    deadline = time.monotonic() + 15\n    up = False\n    while time.monotonic() < deadline:\n        try:\n            with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:\n                s.settimeout(0.3); s.connect((\"127.0.0.1\", port)); up = True; break\n        except OSError:\n            time.sleep(0.2)\n    print(\"server up:\", up)\n    time.sleep(0.5)\n\n    devtools_port = free_port()\n    profile_dir = Path(tempfile.mkdtemp(prefix=\"cuore-dbg2-edge-\"))\n    edge_proc = subprocess.Popen(\n        [EDGE, \"--headless=new\", f\"--remote-debugging-port={devtools_port}\",\n         f\"--user-data-dir={profile_dir}\", \"--no-first-run\", \"about:blank\"],\n        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)\n    try:\n        deadline = time.time() + 20\n        while time.time() < deadline:\n            try:\n                with urllib.request.urlopen(f\"http://127.0.0.1:{devtools_port}/json/version\", timeout=2) as r:\n                    json.loads(r.read().decode()); break\n            except Exception:\n                time.sleep(0.2)\n\n        req = urllib.request.Request(f\"http://127.0.0.1:{devtools_port}/json/new?about:blank\", method=\"PUT\")\n        with urllib.request.urlopen(req, timeout=10) as r:\n            target = json.loads(r.read().decode())\n\n        from websockets.sync.client import connect\n        ws = connect(target[\"webSocketDebuggerUrl\"], max_size=None, open_timeout=20)\n        ids = itertools.count(1)\n        def send(method, params=None, timeout=20):\n            mid = next(ids)\n            ws.send(json.dumps({\"id\": mid, \"method\": method, \"params\": params or {}}))\n            dl = time.time() + timeout\n            while time.time() < dl:\n                raw = ws.recv(timeout=max(0.1, dl - time.time()))\n                msg = json.loads(raw)\n                if msg.get(\"id\") == mid:\n                    if \"error\" in msg: raise RuntimeError(msg[\"error\"])\n                    return msg.get(\"result\", {})\n            raise TimeoutError(method)\n        def ev(expr):\n            out = send(\"Runtime.evaluate\", {\"expression\": expr, \"returnByValue\": True})\n            return out.get(\"result\", {}).get(\"value\")\n\n        send(\"Page.enable\"); send(\"Runtime.enable\")\n        send(\"Emulation.setEmulatedMedia\", {\"features\": [{\"name\": \"prefers-color-scheme\", \"value\": \"dark\"}]})\n        send(\"Page.navigate\", {\"url\": f\"http://127.0.0.1:{port}/v/{VIN}\"})\n        time.sleep(1.0)\n        for i in range(10):\n            state = ev(\"JSON.stringify({ready: document.readyState, href: location.href, \"\n                       \"sheets: document.styleSheets.length, \"\n                       \"rules0: (document.styleSheets[0] && (function(){try{return document.styleSheets[0].cssRules.length}catch(e){return 'ERR:'+e}})())})\")\n            print(i, state)\n            time.sleep(0.5)\n        html = ev(\"document.querySelector('link[rel=stylesheet]') ? document.querySelector('link[rel=stylesheet]').href : 'NONE'\")\n        print(\"first stylesheet link href:\", html)\n        bg = ev(\"getComputedStyle(document.body).backgroundColor\")\n        print(\"final body bg:\", bg)\n        err = ev(\"JSON.stringify(window.__cuore_css_error || null)\")\n        print(\"css error marker:\", err)\n        ws.close()\n    finally:\n        edge_proc.terminate()\n        try: edge_proc.wait(timeout=5)\n        except Exception: edge_proc.kill()\nfinally:\n    proc.terminate()\n    try: proc.wait(timeout=5)\n    except Exception: proc.kill()\n","structuredPatch":[{"oldStart":87,"oldLines":8,"newStart":87,"newLines":26,"lines":["         print(\"first stylesheet link href:\", html)","         bg = ev(\"getComputedStyle(document.body).backgroundColor\")","         print(\"final body bg:\", bg)","-        err = ev(\"JSON.stringify(window.__cuore_css_error || null)\")","-        print(\"css error marker:\", err)","+        varbg = ev(\"getComputedStyle(document.documentElement).getPropertyValue('--bg')\")","+        print(\"resolved --bg on documentElement:\", repr(varbg))","+        varbg_body = ev(\"getComputedStyle(document.body).getPropertyValue('--bg')\")","+        print(\"resolved --bg on body:\", repr(varbg_body))","+        matched = ev(\"\"\"JSON.stringify((function(){","+          var rules = [];","+          for (var ss of document.styleSheets) {","+            try {","+              for (var r of ss.cssRules) {","+                if (r.selectorText === 'body' || (r.cssText && r.cssText.indexOf('background: var(--bg)') !== -1 && r.cssText.indexOf('body') !== -1)) {","+                  rules.push({href: ss.href, text: r.cssText.slice(0,200)});","+                }","+              }","+            } catch(e) { rules.push({err: String(e)}); }","+          }","+          return rules;","+        })())\"\"\")","+        print(\"matching body rules across all sheets:\", matched)","+        mq = ev(\"window.matchMedia('(prefers-color-scheme: dark)').matches\")","+        print(\"matchMedia dark:\", mq)","         ws.close()","     finally:","         edge_proc.terminate()"]}],"userModified":false,"replaceAll":false,"contentNotInModelContext":true},"sourceToolAssistantUUID":"651154cd-25bb-4f4c-9ccb-04491312d45e","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
