 -- drive the actual grade,","     since a two-sided row like battery voltage is still graded on both","     sides here. Never invents a limit.","+","+    Pass ``vin`` to also gate on marque/platform (:func:`mes.known_good.","+    bands_for_vin`): a channel whose only row does not apply to this VIN","+    grades \"unknown\" exactly like a channel with no row at all, but with","+    wording that says so -- distinct from the plain \"nothing sourced","+    anywhere\" text used when the row is missing/UNKNOWN regardless of vin.","     \"\"\"","     name = _channel_name(channel_id)","-    gate = known_good_bridge.sourced_band(channel_id)","+    gate = known_good_bridge.sourced_band(channel_id, vin=vin)","     if gate is None:","+        if vin and known_good_bridge.sourced_band(channel_id) is not None:","+            # A sourced band exists, just not for this VIN's marque/","+            # platform -- never say \"no sourced reference range\" here,","+            # that would imply nothing was ever researched for it.","+            return {\"level\": \"unknown\",","+                    \"text\": f\"No reference band on file for this model for \"","+                            f\"{name} -- {TECHAUTHORITY}.\"}","         return {\"level\": \"unknown\",","                 \"text\": f\"No sourced reference range for {name}; the sourced-range \"","                         \"check cannot be made.\"}","-    row = known_good_bridge.known_good_for(channel_id) or {}","+    row = known_good_bridge.known_good_for(channel_id, vin=vin) or {}","     direction = row.get(\"direction\") or \"both\"","     level = _grade(float(value), row.get(\"normal\"), row.get(\"alarm\"), direction)","     source = row.get(\"source\") or \"sourced range\""]}]}],"moreFiles":0,"changedFiles":["C:\\Users\\User\\mcp-servers\\cuore\\services\\liveboard_bridge.py"]}},"serverClassifierContext":{"request":"902b06d1-a6a3-4be6-912b-c283c373e7b3","context":{"git_state":{"cwd":"/c/Users/User/mcp-servers","root":null