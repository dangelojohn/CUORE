id, \"name\": data.get(\"name\") or first.get(\"name\") or pid,\n478\t                 \"value\": first.get(\"value\"), \"unit\": first.get(\"unit\"),\n479\t                 \"dtc\": first.get(\"dtc\")}\n480\t        if pid not in frames or at > frames[pid].get(\"_at\", \"\"):\n481\t            entry[\"_at\"] = at\n482\t            frames[pid] = entry\n483\t        if latest_at is None or at > latest_at:\n484\t            latest_at = at\n485\t    if not frames:\n486\t        return None\n487\t    for e in frames.values():\n488\t        e.pop(\"_at\", None)\n489\t    params = sorted(frames.values(), key=lambda p: p[\"pid\"])\n490\t    at_short = (latest_at[:16].replace(\"T\", \" \") if latest_at else None)\n491\t    return {\"at\": latest_at, \"at_short\": at_short, \"params\": params}\n492\t\n493\t\n494\t# --- Mode $06, read directly from the car ------------------------------------\n495\t\n496\t_MODE06_FRIENDLY = {\"3A\": \"large-leak test\", \"3C\": \"small-leak test (0.020\\\")\"}\n497\t\n498\t\n499\tdef _mode06_fail_label(mid: str, name: str, value: Any, unit: str | None,\n500\t                       min_: Any, date_short: str | None) -> str:\n501\t    unit = unit or \"\"\n502\t\n503\t    def fmt(v: Any) -> str:\n504\t        if isinstance(v, (int, float)):\n505\t            s = f\"{v:g}\"\n506\t            return f\"{s} {unit}\".strip()\n507\t        return str(v)\n508\t    return f\"Mode 06 {name}: FAIL {fmt(value)} vs min {fmt(min_)} (car, {date_short})\"\n509\t\n510\t\n511\tdef _build_mode06_view(vin: str, after: str | None) -> dict[str, Any] | None:\n512\t    \"\"\"The latest from-car Mode $06 read since the clear, shaped into a\n513\t    flat list of MID/TID rows plus the failing EVAP rows as ready-made\n514\t    evidence items -- never auto-attached, just offered.\"\"\"\n515\t    try:\n516\t        obs = live_store.recent_observations(50, vin=vin, kind=\"mode06\")\n517\t    except Exception:  # noqa: BLE001\n518\t        return None\n519\t    best = None\n520\t    for o in obs:\n521\t        if not live_store.is_from_car(o):\n522\t            continue\n523\t        at = o.get(\"at\") or \"\"\n524\t        if after and at <= after:\n525\t            continue\n526\t        if best is None or at > (best.get(\"at\") or \"\"):\n527\t            best = o\n528\t    if best is None:\n529\t        return None"}]},"uuid":"302865c0-b346-47c0-9e9a-6a44a5c06988","timestamp":"2026-10-14T12:07:23.950Z","toolUseResult":{"type":"text","file":{"filePath":"C:\\Users\\User\\mcp-servers\\cuore\\services\\dossier_bridge.py","content":"            state = _module_dtc_state(d.get(\"flags\") or {})\n            if state is None:\n                continue\n            key = (ecu, code)\n            if key not in best or at > best[key][\"at\"]:\n                best[key] = {\"ecu\": ecu, \"code\": code, \"state\": state, \"at\": at,\n                            \"status\": d.get(\"status\")}\n    return sorted(best.values(), key=lambda r: (r[\"ecu\"], r[\"code\"]))\n\n\n# --- freeze frames read directly from the car (Mode 02 sweep) ---------------\n\n\ndef _build_live_freeze_frames(vin: str, after: str | None) -> dict[str, Any] | None:\n    \"\"\"The latest from-car Mode 02 sweep, one row per PID, or ``None`` when\n    nothing has been read since the clear. Reads the ``freeze_frame``\n    observation kind :func:`cuore.live.ops.obd_freeze_frame` records.\"\"\"\n    try:\n        obs = live_store.recent_observations(1000, vin=vin, kind=\"freeze_frame\")\n    except Exception:  # noqa: BLE001\n        return None\n    frames: dict[str, dict[str, Any]] = {}\n    latest_at: str | None = None\n    for o in obs:\n        if not live_store.is_from_car(o):\n            continue\n        at = o.get(\"at\") or \"\"\n        if after and at <= after:\n            continue\n        data = o.get(\"data\") or {}\n        pid = data.get(\"pid\")\n        if not pid:\n            continue\n        by_ecu = data.get(\"by_ecu\") or {}\n        first = next(iter(by_ecu.values()), None)\n        if not first:\n            continue\n        entry = {\"pid\": pid, \"name\": data.get(\"name\") or first.get(\"name\") or pid,\n                 \"value\": first.get(\"value\"), \"unit\": first.get(\"unit\"),\n                 \"dtc\": first.get(\"dtc\")}\n        if pid not in frames or at > frames[pid].get(\"_at\", \"\"):\n            entry[\"_at\"] = at\n            frames[pid] = entry\n        if latest_at is None or at > latest_at:\n            latest_at = at\n    if not frames:\n        return None\n    for e in frames.values():\n        e.pop(\"_at\", None)\n    params = sorted(frames.values(), key=lambda p: p[\"pid\"])\n    at_short = (latest_at[:16].replace(\"T\", \" \") if latest_at else None)\n    return {\"at\": latest_at, \"at_short\": at_short, \"params\": params}\n\n\n# --- Mode $06, read directly from the car ------------------------------------\n\n_MODE06_FRIENDLY = {\"3A\": \"large-leak test\", \"3C\": \"small-leak test (0.020\\\")\"}\n\n\ndef _mode06_fail_label(mid: str, name: str, value: Any, unit: str | None,\n                       min_: Any, date_short: str | None) -> str:\n    unit = unit or \"\"\n\n    def fmt(v: Any) -> str:\n        if isinstance(v, (int, float)):\n            s = f\"{v:g}\"\n            return f\"{s} {unit}\".strip()\n        return str(v)\n    return f\"Mode 06 {name}: FAIL {fmt(value)} vs min {fmt(min_)} (car, {date_short})\"\n\n\ndef _build_mode06_view(vin: str, after: str | None) -> dict[str, Any] | None:\n    \"\"\"The latest from-car Mode $06 read since the clear, shaped into a\n    flat list of MID/TID rows plus the failing EVAP rows as ready-made\n    evidence items -- never auto-attached, just offered.\"\"\"\n    try:\n        obs = live_store.recent_observations(50, vin=vin, kind=\"mode06\")\n    except Exception:  # noqa: BLE001\n        return None\n    best = None\n    for o in obs:\n        if not live_store.is_from_car(o):\n            continue\n        at = o.get(\"at\") or \"\"\n        if after and at <= after:\n            continue\n        if best is None or at > (best.get(\"at\") or \"\"):\n            best = o\n    if best is None:\n        return None","numLines":90,"startLine":440,"totalLines":1496}},"sourceToolAssistantUUID":"7a1ce01e-0b49-4798-8577-66811b13d07e","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
