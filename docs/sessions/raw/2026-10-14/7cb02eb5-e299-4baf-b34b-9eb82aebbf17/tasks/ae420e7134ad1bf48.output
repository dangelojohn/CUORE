{"parentUuid":"2c7250da-42a3-4187-9263-afe321a42a95","isSidechain":true,"promptId":"be0d48f1-d65f-4148-84ab-7fc82e18525f","agentId":"ae420e7134ad1bf48","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018aUUPBw5NLEfjWFPDYgZP6","type":"tool_result","content":"600\t\n601\t# --- header bits ---------------------------------------------------------\n602\t\n603\t\n604\tdef _vehicle_name(vin: str, dossier: dict[str, Any]) -> str:\n605\t    \"\"\"Never \"(unnamed vehicle)\" -- ``shop_bridge.resolve_vehicle_name``\n606\t    already guarantees that (corpus name, then dossier identity, then a WMI\n607\t    decode, then the VIN itself); if that bridge is unavailable for any\n608\t    reason, fall back to the dossier's own identity field, then the VIN.\"\"\"\n609\t    if shop_bridge is not None:\n610\t        try:\n611\t            name = shop_bridge.resolve_vehicle_name(vin)\n612\t            if name:\n613\t                return name\n614\t        except Exception:  # noqa: BLE001\n615\t            pass\n616\t    return (dossier.get(\"identity\") or {}).get(\"vehicle\") or vin\n617\t\n618\t\n619\tdef _complaint(vin: str) -> str | None:\n620\t    if shop_bridge is None:\n621\t        return None\n622\t    try:\n623\t        visit = shop_bridge.current_visit_for_vin(vin)\n624\t    except Exception:  # noqa: BLE001\n625\t        return None\n626\t    return (visit or {}).get(\"complaint\") or None\n627\t\n628\t\n629\tdef _case_hint(vin: str, open_codes: list[str]) -> str | None:\n630\t    \"\"\"One line from ``cases_bridge.prefill`` -- only when a prior case\n631\t    actually matched; the honest \"no prior case on file\" summary\n632\t    ``mes.cases.prefill`` returns otherwise is not a hint worth a mechanic's\n633\t    attention.\"\"\"\n634\t    if cases_bridge is None:\n635\t        return None\n636\t    try:\n637\t        prefill = cases_bridge.prefill(vin, open_codes)\n638\t    except Exception:  # noqa: BLE001\n639\t        return None\n640\t    if not prefill.get(\"matched_case\"):\n641\t        return None\n642\t    return prefill.get(\"summary\")\n643\t\n644\t\n645\tdef _fuel_gate(vin: str, freeze_frames: list[dict[str, Any]]) -> dict[str, Any]:\n646\t    \"\"\"The live fuel gate (BENCH_UX_SPEC_2026-10-08.md C10): current fuel %,\n647\t    the 15-85% EVAP window, and litres to burn to reach 85% -- only when a\n648\t    sourced tank capacity exists for this VIN; ``None`` (UNKNOWN) otherwise,\n649\t    never a guessed number.\"\"\"\n650\t    status = dossier_bridge.fuel_status(freeze_frames)\n651\t    capacity = _tank_capacity_litres(vin)\n652\t    litres = None\n653\t    if (status[\"level\"] is not None and status[\"direction\"] == \"above\"\n654\t            and capacity is not None):\n655\t        litres = round((status[\"level\"] - status[\"window\"][1]) / 100.0 * capacity, 1)\n656\t    return {**status, \"tank_capacity_l\": capacity, \"litres_to_target\": litres}\n657\t\n658\t\n659\tdef _tank_capacity_litres(vin: str) -> float | None:\n660\t    \"\"\"Sourced tank capacity for this VIN (``mes.maintenance_specs`` /\n661\t    ``mes.service``), or ``None`` (UNKNOWN) -- this corpus carries no such\n662\t    spec today, so this always reads UNKNOWN in practice; kept as a real\n663\t    lookup (not a hardcoded None) so a future sourced spec picks it up for\n664\t    free.\"\"\"\n665\t    try:\n666\t        from mes import maintenance_specs  # local: optional, see module docstring\n667\t        getter = getattr(maintenance_specs, \"fuel_tank_capacity_l\", None)\n668\t        if callable(getter):\n669\t            return getter(vin)\n670\t    except Exception:  # noqa: BLE001\n671\t        pass\n672\t    return None\n673\t\n674\t"}]},"uuid":"58c581ae-c644-4dbf-90e3-78de22daaf93","timestamp":"2026-10-14T12:17:53.256Z","toolUseResult":{"type":"text","file":{"filePath":"C:\\Users\\User\\mcp-servers\\cuore\\services\\bench_bridge.py","content":"\n# --- header bits ---------------------------------------------------------\n\n\ndef _vehicle_name(vin: str, dossier: dict[str, Any]) -> str:\n    \"\"\"Never \"(unnamed vehicle)\" -- ``shop_bridge.resolve_vehicle_name``\n    already guarantees that (corpus name, then dossier identity, then a WMI\n    decode, then the VIN itself); if that bridge is unavailable for any\n    reason, fall back to the dossier's own identity field, then the VIN.\"\"\"\n    if shop_bridge is not None:\n        try:\n            name = shop_bridge.resolve_vehicle_name(vin)\n            if name:\n                return name\n        except Exception:  # noqa: BLE001\n            pass\n    return (dossier.get(\"identity\") or {}).get(\"vehicle\") or vin\n\n\ndef _complaint(vin: str) -> str | None:\n    if shop_bridge is None:\n        return None\n    try:\n        visit = shop_bridge.current_visit_for_vin(vin)\n    except Exception:  # noqa: BLE001\n        return None\n    return (visit or {}).get(\"complaint\") or None\n\n\ndef _case_hint(vin: str, open_codes: list[str]) -> str | None:\n    \"\"\"One line from ``cases_bridge.prefill`` -- only when a prior case\n    actually matched; the honest \"no prior case on file\" summary\n    ``mes.cases.prefill`` returns otherwise is not a hint worth a mechanic's\n    attention.\"\"\"\n    if cases_bridge is None:\n        return None\n    try:\n        prefill = cases_bridge.prefill(vin, open_codes)\n    except Exception:  # noqa: BLE001\n        return None\n    if not prefill.get(\"matched_case\"):\n        return None\n    return prefill.get(\"summary\")\n\n\ndef _fuel_gate(vin: str, freeze_frames: list[dict[str, Any]]) -> dict[str, Any]:\n    \"\"\"The live fuel gate (BENCH_UX_SPEC_2026-10-08.md C10): current fuel %,\n    the 15-85% EVAP window, and litres to burn to reach 85% -- only when a\n    sourced tank capacity exists for this VIN; ``None`` (UNKNOWN) otherwise,\n    never a guessed number.\"\"\"\n    status = dossier_bridge.fuel_status(freeze_frames)\n    capacity = _tank_capacity_litres(vin)\n    litres = None\n    if (status[\"level\"] is not None and status[\"direction\"] == \"above\"\n            and capacity is not None):\n        litres = round((status[\"level\"] - status[\"window\"][1]) / 100.0 * capacity, 1)\n    return {**status, \"tank_capacity_l\": capacity, \"litres_to_target\": litres}\n\n\ndef _tank_capacity_litres(vin: str) -> float | None:\n    \"\"\"Sourced tank capacity for this VIN (``mes.maintenance_specs`` /\n    ``mes.service``), or ``None`` (UNKNOWN) -- this corpus carries no such\n    spec today, so this always reads UNKNOWN in practice; kept as a real\n    lookup (not a hardcoded None) so a future sourced spec picks it up for\n    free.\"\"\"\n    try:\n        from mes import maintenance_specs  # local: optional, see module docstring\n        getter = getattr(maintenance_specs, \"fuel_tank_capacity_l\", None)\n        if callable(getter):\n            return getter(vin)\n    except Exception:  # noqa: BLE001\n        pass\n    return None\n\n","numLines":75,"startLine":600,"totalLines":890}},"sourceToolAssistantUUID":"2c7250da-42a3-4187-9263-afe321a42a95","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
