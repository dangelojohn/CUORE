{"parentUuid":"5d72478e-9846-44bb-a54f-a7815202e999","isSidechain":true,"agentId":"ae420e7134ad1bf48","message":{"model":"claude-sonnet-5","id":"msg_011Cg26yTecuu7APaAgFTM2P","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01KvwYFJf3Lgv9kKJ3jctZH4","name":"Read","input":{"file_path":"C:\\Users\\User\\mcp-servers\\cuore\\services\\mes_bridge.py"},"caller":{"type":"direct"}}],"container":null,"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":9646,"cache_read_input_tokens":91740,"output_tokens":498,"output_tokens_details":{"thinking_tokens":421},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":0,"ephemeral_5m_input_tokens":9646},"inference_geo":"global","iterations":[{"input_tokens":2,"output_tokens":498,"cache_read_input_tokens":91740,"cache_creation_input_tokens":9646,"cache_creation":{"ephemeral_5m_input_tokens":9646,"ephemeral_1h_input_tokens":0},"type":"message"}],"speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_01KvwYFJf3Lgv9kKJ3jctZH4":{"file_path":"C:\\Users\\User\\mcp-servers\\cuore\\services\\mes_bridge.py"}},"serverClassifierRequest":"9f85bfa3-9ba6-4141-a6ae-8db04d89db46","apiBlockIndex":1,"requestId":"req_011Cg26yTQEHnsQWNtMW2v5r","attributionAgent":"general-purpose","type":"assistant","uuid":"e1043b55-3fa7-48c6-9b07-778a7acd45f3","timestamp":"2026-10-14T12:08:55.896Z","effort":"high","perTurnEffort":null,"userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
{"parentUuid":"e1043b55-3fa7-48c6-9b07-778a7acd45f3","isSidechain":true,"promptId":"69fd3a36-77b0-4682-8147-3d9be25bf8f4","agentId":"ae420e7134ad1bf48","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01KvwYFJf3Lgv9kKJ3jctZH4","type":"tool_result","content":"1\t\"\"\"The only module in CUORE that imports :mod:`mes`.\n2\t\n3\tEvery route reaches the analysis library through here. That is deliberate:\n4\t``mes-log-mcp/server.py`` already exposes this library as MCP tools, and the\n5\ttwo surfaces must not drift. Each function below mirrors its MCP counterpart\n6\tcall-for-call, so a change in the library shows up identically in both.\n7\t\n8\tNothing here re-implements analysis. Chronic classification, TSB matching,\n9\tfault-tree content and the evidence gate's criteria live in ``mes`` and are\n10\tunit-tested there against the real corpus; this file only calls them and\n11\ttranslates \"no result\" into an exception the HTTP layer can turn into a\n12\tstatus code.\n13\t\"\"\"\n14\t\n15\tfrom __future__ import annotations\n16\t\n17\timport re\n18\tfrom typing import Any, Optional\n19\t\n20\tfrom .. import bootstrap  # noqa: F401  -- side effect: puts `mes` on sys.path\n21\tfrom .errors import BadRequest, NotFound\n22\t\n23\tfrom mes import (  # noqa: E402  -- must follow the bootstrap import\n24\t    analysis,\n25\t    catalog,\n26\t    compare,\n27\t    csvlog,\n28\t    dealer as dealer_mod,\n29\t    dtc as dtc_mod,\n30\t    dtc_text,\n31\t    encoding,\n32\t    faulttree,\n33\t    fes,\n34\t    knowledge,\n35\t    modules,\n36\t    notes as notes_mod,\n37\t    paths,\n38\t    platform as platform_mod,\n39\t    scan,\n40\t    verdict,\n41\t)\n42\tfrom mes import workup as workup_mod  # noqa: E402\n43\tfrom mes.errors import MesError  # noqa: E402\n44\t\n45\tCATALOG = catalog.CATALOG\n46\t\n47\t\n48\t# --- corpus ---------------------------------------------------------------\n49\t\n50\t\n51\tdef corpus_status() -> dict[str, Any]:\n52\t    \"\"\"Health and inventory: roots, real vs simulated counts, parse errors.\"\"\"\n53\t    return CATALOG.stats()\n54\t\n55\t\n56\tdef log_roots() -> dict[str, Any]:\n57\t    \"\"\"The MES log directories being watched, and whether they exist.\"\"\"\n58\t    return {\n59\t        \"configured\": [str(r) for r in paths.configured_roots()],\n60\t        \"existing\": [str(r) for r in paths.existing_roots()],\n61\t        \"csv_configured\": [str(r) for r in paths.csv_roots()],\n62\t        \"csv_existing\": [str(r) for r in paths.existing_csv_roots()],\n63\t        \"env_overrides\": [\"MES_LOG_DIRS\", \"MES_LOG_DIR\",\n64\t                          \"MES_CSV_DIRS\", \"MES_CSV_DIR\"],\n65\t    }\n66\t\n67\t\n68\tdef vehicles(*, real_only: bool = False) -> list[dict[str, Any]]:\n69\t    \"\"\"Every distinct vehicle in the corpus, keyed by VIN where recoverable.\n70\t\n71\t    ``real_only`` keeps the two cars that actually exist -- a resolvable VIN\n72\t    and at least one non-simulated log -- and drops the simulation pseudo\n73\t    vehicles, whose \"VIN\" is MES's practice-data placeholder.\n74\t    \"\"\"\n75\t    found = CATALOG.vehicles()\n76\t    if not real_only:\n77\t        return found\n78\t    return [v for v in found\n79\t            if v.get(\"real_logs\", 0) > 0 and len(v.get(\"vin\", \"\")) >= 11]\n80\t\n81\t\n82\tdef newest_mtime(vin: str = \"\") -> float:\n83\t    \"\"\"Newest file mtime across a vehicle's logs -- the cache key for workup.\"\"\"\n84\t    entries = CATALOG.select(vin=vin) if vin else CATALOG.entries()\n85\t    return max((e.mtime for e in entries), default=0.0)\n86\t\n87\t\n88\t# --- logs -----------------------------------------------------------------\n89\t\n90\t\n91\tdef list_logs(*, kind: str = \"\", vehicle: str = \"\", vin: str = \"\",\n92\t              since: str = \"\", until: str = \"\", limit: int = 30,\n93\t              include_simulation: bool = False) -> dict[str, Any]:\n94\t    \"\"\"Filtered log index, newest first by session timestamp.\"\"\"\n95\t    entries = CATALOG.select(kind=kind, vehicle=vehicle, vin=vin, since=since,\n96\t                             until=until, limit=limit,\n97\t                             include_simulation=include_simulation)\n98\t    return {\n99\t        \"count\": len(entries),\n100\t        \"filters\": {\"kind\": kind, \"vehicle\": vehicle, \"vin\": vin,\n101\t                    \"since\": since, \"until\": until,\n102\t                    \"include_simulation\": include_simulation},\n103\t        \"logs\": [e.to_dict() for e in entries],\n104\t    }\n105\t\n106\t\n107\tdef read_log(name: str, *, max_bytes: int = 200_000) -> dict[str, Any]:\n108\t    \"\"\"Read one MES log verbatim.\n109\t\n110\t    Resolution goes through :func:`mes.paths.resolve_log`, which requires a\n111\t    bare filename matching a MES log pattern and verifies the fully resolved\n112\t    real path is inside a configured root. That check is the whole security\n113\t    boundary of this endpoint: an earlier version of the MCP server built the\n114\t    path by concatenation, which on Windows let both ``..`` and an absolute\n115\t    path escape it. Do not replace this with ``Path(root) / name``.\n116\t    \"\"\"\n117\t    try:\n118\t        path = paths.resolve_log(name)\n119\t    except MesError as exc:\n120\t        raise BadRequest(str(exc)) from exc\n121\t\n122\t    decoded = encoding.read_log_text(path, max_bytes=max_bytes)\n123\t    kind, raw_stamp, vehicle = paths.classify_name(path.name)\n124\t    stamp = catalog.parse_stamp(raw_stamp)\n125\t    out: dict[str, Any] = {\n126\t        \"file\": path.name,\n127\t        \"kind\": kind,\n128\t        \"timestamp\": stamp.isoformat(sep=\" \") if stamp else raw_stamp,\n129\t        \"vehicle\": vehicle,\n130\t        \"encoding\": decoded.encoding,\n131\t        \"size_bytes\": decoded.size_bytes,\n132\t        \"truncated\": decoded.truncated,\n133\t        \"text\": decoded.text,\n134\t    }\n135\t    if decoded.control_chars:\n136\t        out[\"stray_control_bytes_removed\"] = decoded.control_chars\n137\t    if \"SIMULATION MODE\" in decoded.text:\n138\t        out[\"simulation\"] = True\n139\t        out[\"warning\"] = \"SIMULATION MODE - this data is not from a vehicle\"\n140\t    elif kind == \"scan\":\n141\t        out[\"provenance\"] = (\"unverifiable - SCAN logs carry no simulation \"\n142\t                             \"marker\")\n143\t    return out\n144\t\n145\t\n146\tdef search_logs(pattern: str, *, kind: str = \"\", vehicle: str = \"\",\n147\t                vin: str = \"\", context_lines: int = 2, max_matches: int = 40,\n148\t                include_simulation: bool = False) -> dict[str, Any]:\n149\t    \"\"\"Case-insensitive regex search across logs, newest first.\"\"\"\n150\t    if not pattern.strip():\n151\t        raise BadRequest(\"a search pattern is required\")\n152\t    try:\n153\t        rx = re.compile(pattern, re.IGNORECASE)\n154\t    except re.error as exc:\n155\t        raise BadRequest(f\"invalid regular expression: {exc}\") from exc\n156\t\n157\t    entries = CATALOG.select(kind=kind, vehicle=vehicle, vin=vin,\n158\t                             include_simulation=include_simulation)\n159\t    hits: list[dict[str, Any]] = []\n160\t    for entry in entries:\n161\t        try:\n162\t            lines = encoding.read_log_text(entry.path).splitlines()\n163\t        except Exception as exc:  # one unreadable file must not sink a search\n164\t            hits.append({\"file\": entry.name, \"error\": str(exc)})\n165\t            continue\n166\t        for i, line in enumerate(lines):\n167\t            if not rx.search(line):\n168\t                continue\n169\t            lo = max(0, i - context_lines)\n170\t            hi = min(len(lines), i + context_lines + 1)\n171\t            hits.append({\n172\t                \"file\": entry.name,\n173\t                \"timestamp\": entry.timestamp,\n174\t                \"simulation\": entry.simulation,\n175\t                \"line\": i + 1,\n176\t                \"match\": line.strip(),\n177\t                \"context\": [f\"{j + 1}: {lines[j]}\" for j in range(lo, hi)],\n178\t            })\n179\t            if len(hits) >= max_matches:\n180\t                return {\"count\": len(hits), \"truncated\": True,\n181\t                        \"matches\": hits}\n182\t    return {\"count\": len(hits), \"truncated\": False, \"matches\": hits}\n183\t\n184\t\n185\t# --- per-vehicle analysis -------------------------------------------------\n186\t\n187\t\n188\tdef workup(vin: str = \"\", vehicle: str = \"\") -> dict[str, Any]:\n189\t    \"\"\"The pre-work dossier. Raises :class:`NotFound` when no logs match.\"\"\"\n190\t    dossier = workup_mod.build(vin=vin, vehicle=vehicle)\n191\t    if \"error\" in dossier:\n192\t        raise NotFound(dossier[\"error\"])\n193\t    return dossier\n194\t\n195\t\n196\tdef marque_for_vin(vin: str) -> str:\n197\t    \"\"\"``\"alfa\"``/``\"maserati\"``/``\"ferrari\"``/``\"unknown\"`` for this VIN's\n198\t    WMI -- the only thing the web layer's ``data-marque`` theming needs.\n199\t    Pure passthrough to :func:`mes.platform.marque_for_vin`; never raises,\n200\t    never guesses (an unrecognised WMI is ``\"unknown\"``, not a default\n201\t    marque -- the caller decides what to show for that).\"\"\"\n202\t    return platform_mod.marque_for_vin(vin)\n203\t\n204\t\n205\tdef vehicle_report(vin: str = \"\", vehicle: str = \"\") -> dict[str, Any]:\n206\t    \"\"\"Identity, odometer span and chronic faults for one vehicle.\"\"\"\n207\t    report = analysis.vehicle_summary(vin=vin, vehicle=vehicle)\n208\t    if \"error\" in report:\n209\t        raise NotFound(report[\"error\"])\n210\t    return report\n211\t\n212\t\n213\tdef live_vs_log(vin: str, module: str = \"\") -> dict[str, Any]:\n214\t    \"\"\"Newest log read vs newest live read, one row per code, per module.\n215\t\n216\t    Passthrough to :func:`mes.compare.live_vs_log`; see that module for the\n217\t    join and classification rules.\n218\t    \"\"\"\n219\t    if not vin.strip():\n220\t        raise BadRequest(\"a VIN is required\")\n221\t    result = compare.live_vs_log(vin, module=module)\n222\t    if \"error\" in result:\n223\t        raise BadRequest(result[\"error\"])\n224\t    return result\n225\t\n226\t\n227\tdef _classified(record: Any) -> dict[str, Any]:\n228\t    \"\"\"A DTC record as a dict, with its classification made explicit.\n229\t\n230\t    ``DtcRecord.to_dict`` reports the classification only as a prose\n231\t    ``assessment`` string; ``chronic`` and ``returned_after_clear`` are\n232\t    properties that do not survive serialisation. Clients need the booleans to\n233\t    colour a row, and re-deriving \"chronic\" from the odometer span in a\n234\t    template would fork the rule -- so read the library's own properties here\n235\t    and publish them. One definition, in ``mes.analysis.DtcRecord``.\n236\t\n237\t    ``severity`` collapses the same facts onto the four states the UI shows,\n238\t    ordered by what changes a decision: a code that came back after a clear is\n239\t    live and reproducing; a chronic one has persisted over distance; a cleared\n240\t    one proves nothing until a monitor re-runs.\n241\t    \"\"\"\n242\t    out = record.to_dict()\n243\t    out[\"chronic\"] = record.chronic\n244\t    out[\"returned_after_clear\"] = record.returned_after_clear\n245\t\n246\t    if record.returned_after_clear:\n247\t        severity = \"returned\"\n248\t    elif record.chronic:\n249\t        severity = \"chronic\"\n250\t    elif \"cleared\" in record.statuses and record.session_count <= 1:\n251\t        severity = \"cleared\"\n252\t    elif record.session_count <= 1:\n253\t        severity = \"seen-once\"\n254\t    else:\n255\t        severity = \"recurring\"\n256\t    out[\"severity\"] = severity\n257\t    return out\n258\t\n259\t\n260\tdef extract_dtcs(*, vin: str = \"\", vehicle: str = \"\", since: str = \"\",\n261\t                 include_simulation: bool = False) -> dict[str, Any]:\n262\t    \"\"\"Every DTC with first-seen, last-seen, session count and odometer span.\n263\t\n264\t    Ordered so the codes that decide a diagnosis come first: returned-after-\n265\t    clear, then chronic, then the rest.\n266\t    \"\"\"\n267\t    entries = CATALOG.select(vin=vin, vehicle=vehicle, since=since,\n268\t                             include_simulation=include_simulation)\n269\t    history = analysis.dtc_history(entries)\n270\t    records = sorted(history.values(),\n271\t                     key=lambda r: (not r.returned_after_clear,\n272\t                                    not r.chronic, r.dtc))\n273\t    return {\n274\t        \"count\": len(records),\n275\t        \"logs_considered\": len(entries),\n276\t        \"simulation_included\": include_simulation,\n277\t        \"dtcs\": [_classified(r) for r in records],\n278\t    }\n279\t\n280\t\n281\tdef dtc_history(code: str, *, vin: str = \"\") -> dict[str, Any]:\n282\t    \"\"\"One code's complete life across sessions.\"\"\"\n283\t    wanted = code.strip().upper()\n284\t    if not wanted:\n285\t        raise BadRequest(\"a DTC is required\")\n286\t    history = analysis.dtc_history(vin=vin)\n287\t    matches = {k: v for k, v in history.items()\n288\t               if wanted in (k, k.split(\"-\")[0])}\n289\t    if not matches:\n290\t        raise NotFound(\n291\t            f\"{wanted} appears in no real log for this vehicle \"\n292\t            \"(simulation logs are excluded by default)\")\n293\t    return {\"code\": wanted,\n294\t            \"matches\": [_classified(r) for r in matches.values()]}\n295\t\n296\t\n297\tdef freeze_frames(*, code: str = \"\", name: str = \"\",\n298\t                  vin: str = \"\") -> dict[str, Any]:\n299\t    \"\"\"The ~25 parameters captured when a code set.\n300\t\n301\t    This is the evidence that separates a cold-start fault from a highway one,\n302\t    and it is destroyed by a clear -- which is why the UI reads it before\n303\t    offering one.\n304\t    \"\"\"\n305\t    wanted = code.strip().upper()\n306\t    if name.strip():\n307\t        try:\n308\t            entries = [CATALOG.by_name(name)]\n309\t        except MesError as exc:\n310\t            raise NotFound(str(exc)) from exc\n311\t    else:\n312\t        entries = CATALOG.select(kind=\"fes\", vin=vin)\n313\t\n314\t    found: list[dict[str, Any]] = []\n315\t    for entry in entries:\n316\t        if entry.kind != \"fes\" or entry.parse_error:\n317\t            continue\n318\t        log = fes.load_fes(entry.path, timestamp=entry.timestamp)\n319\t        for d in log.dtcs:\n320\t            if wanted and wanted not in (d.full, d.code):\n321\t                continue\n322\t            if not d.freeze_frame:\n323\t                continue\n324\t            found.append({\n325\t                \"dtc\": d.full,\n326\t                \"description\": d.description,\n327\t                \"status\": d.status.value,\n328\t                \"status_meaning\": d.status.explanation,\n329\t                \"file\": entry.name,\n330\t                \"timestamp\": entry.timestamp,\n331\t                \"ecu\": log.ecu_description,\n332\t                \"vin\": log.vin,\n333\t                \"freeze_frame\": {k: v.display\n334\t                                 for k, v in d.freeze_frame.items()},\n335\t            })\n336\t    if not found:\n337\t        raise NotFound(f\"no freeze frame for {code or '(any code)'}\")\n338\t    return {\"count\": len(found), \"frames\": found}\n339\t\n340\t\n341\tdef actuator_history(*, vin: str = \"\", operation: str = \"\") -> dict[str, Any]:\n342\t    \"\"\"Every actuator test and adjustment ever run, and why any failed.\"\"\"\n343\t    entries = CATALOG.select(kind=\"fes\", vin=vin)\n344\t    runs: list[dict[str, Any]] = []\n345\t    for entry in entries:\n346\t        if entry.parse_error:\n347\t            continue\n348\t        log = fes.load_fes(entry.path, timestamp=entry.timestamp)\n349\t        for a in log.actuators:\n350\t            if operation.strip() and operation.lower() not in a.operation.lower():\n351\t                continue\n352\t            row = a.to_dict()\n353\t            row.update({\"file\": entry.name, \"timestamp\": entry.timestamp,\n354\t                        \"ecu\": log.ecu_description})\n355\t            runs.append(row)\n356\t    runs.sort(key=lambda r: r.get(\"timestamp\") or \"\", reverse=True)\n357\t    failed = [r for r in runs if r.get(\"outcome\") == \"FAILED TO EXECUTE\"]\n358\t    return {\n359\t        \"count\": len(runs),\n360\t        \"failed\": len(failed),\n361\t        \"runs\": runs,\n362\t        \"note\": (\"MES actuator tests on the IAW 10JA require key-on \"\n363\t                 \"engine-off; 'Engine running' is an interlock, not a fault.\"),\n364\t    }\n365\t\n366\t\n367\t# --- sessions and scans ---------------------------------------------------\n368\t\n369\t\n370\tdef analyze_session(*, name: str = \"\", vin: str = \"\") -> dict[str, Any]:\n371\t    \"\"\"One FES engineering session: identity, DTCs, clears, actuators.\"\"\"\n372\t    try:\n373\t        entry = catalog.resolve_or_latest(name, kind=\"fes\", vin=vin)\n374\t    except MesError as exc:\n375\t        raise NotFound(str(exc)) from exc\n376\t    log = fes.load_fes(entry.path, timestamp=entry.timestamp)\n377\t    out = log.to_dict()\n378\t    out[\"file\"] = entry.name\n379\t    out[\"timestamp\"] = entry.timestamp\n380\t    cleared = analysis.post_clear_assessment(log)\n381\t    if cleared:\n382\t        out[\"clear_assessment\"] = cleared.to_dict()\n383\t    return out\n384\t\n385\t\n386\tdef analyze_scan(*, name: str = \"\", vin: str = \"\") -> dict[str, Any]:\n387\t    \"\"\"One all-systems SCAN: per-module status, with network-cascade detection.\"\"\"\n388\t    try:\n389\t        entry = catalog.resolve_or_latest(name, kind=\"scan\", vin=vin)\n390\t    except MesError as exc:\n391\t        raise NotFound(str(exc)) from exc\n392\t    log = scan.load_scan(entry.path, timestamp=entry.timestamp)\n393\t    out = log.to_dict()\n394\t    out[\"file\"] = entry.name\n395\t    out[\"timestamp\"] = entry.timestamp\n396\t    by_module = {m.name: m.dtcs for m in log.modules if m.dtcs}\n397\t    event = analysis.detect_network_event(by_module)\n398\t    if event:\n399\t        out[\"network_event\"] = event.to_dict()\n400\t    out[\"provenance\"] = (\"unverifiable - SCAN logs carry no simulation marker\")\n401\t    return out\n402\t\n403\t\n404\tdef list_parameters(*, name: str = \"\", vin: str = \"\") -> dict[str, Any]:\n405\t    \"\"\"Live parameters a FES session recorded, unioned across samples.\"\"\"\n406\t    try:\n407\t        entry = catalog.resolve_or_latest(name, kind=\"fes\", vin=vin)\n408\t    except MesError as exc:\n409\t        raise NotFound(str(exc)) from exc\n410\t    log = fes.load_fes(entry.path, timestamp=entry.timestamp)\n411\t    if not log.samples:\n412\t        return {\"file\": entry.name, \"samples\": 0,\n413\t                \"note\": \"this session logged no live parameters\"}\n414\t    return {\n415\t        \"file\": entry.name,\n416\t        \"timestamp\": entry.timestamp,\n417\t        \"ecu\": log.ecu_description,\n418\t        \"samples\": len(log.samples),\n419\t        \"parameter_count\": len(log.param_names()),\n420\t        \"parameters\": log.param_names(),\n421\t    }\n422\t\n423\t\n424\tdef parameter_series(parameter: str, *, name: str = \"\",\n425\t                     vin: str = \"\") -> dict[str, Any]:\n426\t    \"\"\"One session parameter as an ordered series with statistics.\"\"\"\n427\t    try:\n428\t        entry = catalog.resolve_or_latest(name, kind=\"fes\", vin=vin)\n429\t    except MesError as exc:\n430\t        raise NotFound(str(exc)) from exc\n431\t    log = fes.load_fes(entry.path, timestamp=entry.timestamp)\n432\t    series = log.series(parameter)\n433\t    if not series.samples:\n434\t        raise NotFound(f\"'{parameter}' was not logged in {entry.name}\")\n435\t    out = series.stats()\n436\t    out[\"file\"] = entry.name\n437\t    out[\"values\"] = [s.display for s in series.samples]\n438\t    out[\"timing_note\"] = (\"MES records no per-sample timestamp; order is file \"\n439\t                          \"order and the sample rate is unknown\")\n440\t    if out.get(\"static\"):\n441\t        out[\"interpretation\"] = (\n442\t            \"This value never changed across the whole session -- consistent \"\n443\t            \"with a substituted default or a modelled value rather than a \"\n444\t            \"live measurement. Confirm before treating it as a reading.\")\n445\t    return out\n446\t\n447\t\n448\t# --- decision support -----------------------------------------------------\n449\t\n450\t\n451\tdef fault_tree(codes: str = \"\", *, vin: str = \"\") -> dict[str, Any]:\n452\t    \"\"\"Applicable isolation sequences, annotated with this car's evidence.\n453\t\n454\t    Returns successfully even when nothing matches: the payload then carries\n455\t    the trees that *do* exist, which is the useful answer to \"is there a tree\n456\t    for this?\".\n457\t    \"\"\"\n458\t    code_list = [c for c in re.split(r\"[,\\s;]+\", codes) if c.strip()]\n459\t    if not code_list:\n460\t        return {\n461\t            \"error\": \"no codes given\",\n462\t            \"available\": [{\"tree\": t.key, \"title\": t.title,\n463\t                           \"applies_to\": sorted(t.codes)}\n464\t                          for t in faulttree.TREES],\n465\t        }\n466\t    return faulttree.evaluate(code_list, vin=vin)\n467\t\n468\t\n469\tdef assess_verdict(*, vin: str, codes: str, component: str, mechanism: str,\n470\t                   measurements: str,\n471\t                   disconfirming_test: str) -> dict[str, Any]:\n472\t    \"\"\"The evidence gate.\n473\t\n474\t    The only non-read operation in the P1 surface, and it writes nothing to\n475\t    the car -- it evaluates a proposed diagnosis against four criteria and\n476\t    refuses CONFIRMED unless all of them hold.\n477\t    \"\"\"\n478\t    result = verdict.assess(vin=vin, codes=codes, component=component,\n479\t                            mechanism=mechanism, measurements=measurements,\n480\t                            disconfirming_test=disconfirming_test)\n481\t    if \"error\" in result and \"verdict\" not in result:\n482\t        raise BadRequest(result[\"error\"])\n483\t    return result\n484\t\n485\t\n486\tdef open_codes_for(dossier: dict[str, Any]) -> list[str]:\n487\t    \"\"\"The codes a dossier should route to a fault tree.\n488\t\n489\t    Two sources, unioned:\n490\t\n491\t    * the newest session that held findings -- preferred over the newest\n492\t      session outright, because the latter is often the empty post-clear\n493\t      re-read and routing off it produces \"no codes\" on a car that plainly\n494\t      has some;\n495\t    * every chronic or returned-after-clear code in the car's history.\n496\t\n497\t    The second source matters more than it looks. On this Stelvio the newest\n498\t    session shows a cleared ``P0440`` while the code that actually decides the\n499\t    diagnosis is a chronic ``P0456`` spanning 26,500 km. Routing on the latest\n500\t    session alone would send the tree after the wrong fault.\n501\t    \"\"\"\n502\t    codes: set[str] = set()\n503\t\n504\t    current = dossier.get(\"current_picture\", {})\n505\t    for key in (\"last_session_with_findings\", \"latest_session\"):\n506\t        session = current.get(key) or {}\n507\t        found = [d.get(\"code\") or d.get(\"dtc\") or \"\"\n508\t                 for d in session.get(\"dtcs\", [])]\n509\t        found = [knowledge.base_code(c) for c in found if c]\n510\t        if found:\n511\t            codes.update(found)\n512\t            break\n513\t\n514\t    history = dossier.get(\"history\", {})\n515\t    for bucket in (\"chronic\", \"returned_after_clear\"):\n516\t        for record in history.get(bucket, []):\n517\t            raw = record.get(\"dtc\") or record.get(\"code\") or \"\"\n518\t            if raw:\n519\t                codes.add(knowledge.base_code(raw))\n520\t\n521\t    return sorted(codes)\n522\t\n523\t\n524\t# --- dealer (wiTECH) results -----------------------------------------------\n525\t\n526\t\n527\tdef dealer_record(vin: str, kind: str, data: dict[str, Any],\n528\t                  note: str = \"\") -> dict[str, Any]:\n529\t    \"\"\"Record one technician-entered wiTECH result. Raises BadRequest on\n530\t    anything the store's per-kind validation rejects.\"\"\"\n531\t    if not vin.strip():\n532\t        raise BadRequest(\"a VIN is required\")\n533\t    try:\n534\t        return dealer_mod.record(vin, kind, data, note=note)\n535\t    except ValueError as exc:\n536\t        raise BadRequest(str(exc)) from exc\n537\t\n538\t\n539\tdef dealer_results(vin: str) -> dict[str, Any]:\n540\t    \"\"\"Every dealer result recorded for this VIN, oldest first.\"\"\"\n541\t    if not vin.strip():\n542\t        raise BadRequest(\"a VIN is required\")\n543\t    return {\"vin\": vin, \"results\": dealer_mod.load(vin)}\n544\t\n545\t\n546\t# --- technician notes -------------------------------------------------------\n547\t\n548\t\n549\tdef add_note(vin: str, text: str, target_kind: str = \"vehicle\", target_id: str = \"\",\n550\t            author: str = \"technician\", tags: Optional[list[str]] = None) -> dict[str, Any]:\n551\t    \"\"\"Record one technician note. Raises BadRequest on invalid input.\"\"\"\n552\t    if not vin.strip():\n553\t        raise BadRequest(\"a VIN is required\")\n554\t    try:\n555\t        return notes_mod.add(vin, text, target_kind, target_id=target_id,\n556\t                             author=author, tags=tags)\n557\t    except ValueError as exc:\n558\t        raise BadRequest(str(exc)) from exc\n559\t\n560\t\n561\tdef notes(vin: str, target_kind: str = \"\", target_id: str = \"\") -> dict[str, Any]:\n562\t    \"\"\"Notes for this VIN, oldest first, filtered by target when given.\"\"\"\n563\t    if not vin.strip():\n564\t        raise BadRequest(\"a VIN is required\")\n565\t    return {\"vin\": vin,\n566\t            \"notes\": notes_mod.load(vin, target_kind=target_kind or None,\n567\t                                    target_id=target_id)}\n568\t\n569\t\n570\tdef edit_note(id: str, text: str) -> dict[str, Any]:\n571\t    \"\"\"Amend a note's text. Never rewrites history.\"\"\"\n572\t    try:\n573\t        return notes_mod.edit(id, text)\n574\t    except ValueError as exc:\n575\t        raise BadRequest(str(exc)) from exc\n576\t\n577\t\n578\tdef hide_note(id: str) -> dict[str, Any]:\n579\t    \"\"\"Hide a note (soft delete). Never rewrites history.\"\"\"\n580\t    try:\n581\t        return notes_mod.hide(id)\n582\t    except ValueError as exc:\n583\t        raise BadRequest(str(exc)) from exc\n584\t\n585\t\n586\t# --- reference ------------------------------------------------------------\n587\t\n588\t\n589\tdef module_registry(*, abbrev: str = \"\", domain: str = \"\") -> dict[str, Any]:\n590\t    \"\"\"The 126-module registry: one module, one domain, or the whole map.\"\"\"\n591\t    if abbrev.strip():\n592\t        info = modules.describe(abbrev)\n593\t        if \"error\" in info:\n594\t            raise NotFound(info[\"error\"])\n595\t        return info\n596\t    grouped = modules.by_domain()\n597\t    if domain.strip():\n598\t        key = domain.strip().lower()\n599\t        if key not in grouped:\n600\t            raise NotFound(f\"unknown domain '{domain}'\")\n601\t        return {\"domain\": key,\n602\t                \"modules\": [m.to_dict() for m in grouped[key]]}\n603\t    return {\n604\t        \"stats\": modules.registry_stats(),\n605\t        \"by_domain\": {d: [m.to_dict() for m in v]\n606\t                      for d, v in sorted(grouped.items())},\n607\t    }\n608\t\n609\t\n610\tdef failure_type(byte: str) -> dict[str, Any]:\n611\t    \"\"\"Decode the two hex digits after the dash in a UDS DTC.\"\"\"\n612\t    ft = dtc_mod.failure_type(byte.strip())\n613\t    if ft is None:\n614\t        raise NotFound(f\"no failure type for '{byte}'\")\n615\t    return ft.to_dict()\n616\t\n617\t\n618\tdef describe_dtc(code: str, module: str = \"\") -> dict[str, Any]:\n619\t    \"\"\"Look up a DTC's description in MES's own shipped language files.\n620\t\n621\t    Mirrors the ``dtc_description`` MCP tool call-for-call. This is a\n622\t    fallback for a code no log gave text for, not a general database: MES's\n623\t    ``English.dat``/``English.txt`` carry no DTC-code key at all (see\n624\t    ``docs/format/MES_LANGUAGE_FILES.md``), so against the currently\n625\t    installed files this raises :class:`NotFound` for virtually every real\n626\t    code. The lookup itself is genuine and forward-compatible.\n627\t    \"\"\"\n628\t    if not code.strip():\n629\t        raise BadRequest(\"a DTC code is required\")\n630\t    result = dtc_text.describe(code, module.strip() or None)\n631\t    if result is None:\n632\t        raise NotFound(\n633\t            f\"'{code}' has no entry in MES's shipped language files -- no \"\n634\t            \"DTC-code key exists in the currently installed \"\n635\t            \"English.dat/English.txt (docs/format/MES_LANGUAGE_FILES.md)\")\n636\t    return result\n637\t\n638\t\n639\t# --- CSV recordings -------------------------------------------------------\n640\t\n641\t\n642\tdef list_recordings() -> dict[str, Any]:\n643\t    \"\"\"CSV recordings from MES's graph subsystem, newest first.\"\"\"\n644\t    recs = csvlog.list_recordings()\n645\t    out: dict[str, Any] = {\n646\t        \"count\": len(recs),\n647\t        \"recordings\": recs,\n648\t        \"roots\": [str(r) for r in paths.csv_roots()],\n649\t    }\n650\t    if not recs:\n651\t        out[\"note\"] = (\n652\t            \"No CSV recordings found. In MES: Graph tab, add parameters, then \"\n653\t            \"CSV Start / Stop. The export lands in the Settings 'Export \"\n654\t            \"Folder'. Point MES_CSV_DIR at it if it differs from the log \"\n655\t            \"folder.\")\n656\t    return out\n657\t\n658\t\n659\tdef _recording(name: str):\n660\t    try:\n661\t        return csvlog.load_named(name)\n662\t    except MesError as exc:\n663\t        raise NotFound(str(exc)) from exc\n664\t\n665\t\n666\tdef read_recording(name: str, *, preview_rows: int = 10) -> dict[str, Any]:\n667\t    \"\"\"One recording: columns, measured timing, dropouts, TAG/DTC events.\"\"\"\n668\t    return _recording(name).to_dict(preview_rows=preview_rows)\n669\t\n670\t\n671\tdef recording_series(name: str, parameter: str) -> dict[str, Any]:\n672\t    \"\"\"One recorded parameter as a *timed* series -- real timestamps, unlike\n673\t    a .txt session, so the statistics are physically meaningful.\"\"\"\n674\t    rec = _recording(name)\n675\t    series = rec.series(parameter)\n676\t    if not series.samples:\n677\t        raise NotFound(f\"'{parameter}' is not a column in {rec.name}\")\n678\t    out = series.stats()\n679\t    out[\"file\"] = rec.name\n680\t    out[\"values\"] = [{\"t\": stamp, \"value\": s.display}\n681\t                     for stamp, s in zip(series.stamps, series.samples)]\n682\t    if out.get(\"static\"):\n683\t        out[\"interpretation\"] = (\n684\t            \"This value never changed across the recording -- consistent with \"\n685\t            \"a substituted default rather than a live measurement.\")\n686\t    return out\n687\t\n688\t\n689\tdef recording_events(name: str, *, condition: str = \"\") -> dict[str, Any]:\n690\t    \"\"\"TAG/DTC events and dropouts; with a condition, excursion intervals.\"\"\"\n691\t    rec = _recording(name)\n692\t    out: dict[str, Any] = {\n693\t        \"file\": rec.name,\n694\t        \"timing\": rec.timing(),\n695\t        \"tag_events\": [t.to_dict() for t in rec.tags],\n696\t        \"dtcs_in_tags\": sorted({d for t in rec.tags for d in t.dtcs}),\n697\t    }\n698\t    if condition.strip():\n699\t        try:\n700\t            out[\"threshold\"] = rec.crossings(condition)\n701\t        except MesError as exc:\n702\t            raise BadRequest(str(exc)) from exc\n703\t    return out\n704\t\n705\t\n706\tdef recording_snapshot(name: str, at_seconds: float) -> dict[str, Any]:\n707\t    \"\"\"The post-hoc freeze frame: every value at the sample nearest a time.\"\"\"\n708\t    rec = _recording(name)\n709\t    return {\"file\": rec.name, **rec.snapshot(at_seconds)}\n710\t"}]},"uuid":"0d1f79ad-6f59-4ccd-8803-c906c8d64a49","timestamp":"2026-10-14T12:08:56.123Z","toolUseResult":{"type":"text","file":{"filePath":"C:\\Users\\User\\mcp-servers\\cuore\\services\\mes_bridge.py","content":"\"\"\"The only module in CUORE that imports :mod:`mes`.\n\nEvery route reaches the analysis library through here. That is deliberate:\n``mes-log-mcp/server.py`` already exposes this library as MCP tools, and the\ntwo surfaces must not drift. Each function below mirrors its MCP counterpart\ncall-for-call, so a change in the library shows up identically in both.\n\nNothing here re-implements analysis. Chronic classification, TSB matching,\nfault-tree content and the evidence gate's criteria live in ``mes`` and are\nunit-tested there against the real corpus; this file only calls them and\ntranslates \"no result\" into an exception the HTTP layer can turn into a\nstatus code.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport re\nfrom typing import Any, Optional\n\nfrom .. import bootstrap  # noqa: F401  -- side effect: puts `mes` on sys.path\nfrom .errors import BadRequest, NotFound\n\nfrom mes import (  # noqa: E402  -- must follow the bootstrap import\n    analysis,\n    catalog,\n    compare,\n    csvlog,\n    dealer as dealer_mod,\n    dtc as dtc_mod,\n    dtc_text,\n    encoding,\n    faulttree,\n    fes,\n    knowledge,\n    modules,\n    notes as notes_mod,\n    paths,\n    platform as platform_mod,\n    scan,\n    verdict,\n)\nfrom mes import workup as workup_mod  # noqa: E402\nfrom mes.errors import MesError  # noqa: E402\n\nCATALOG = catalog.CATALOG\n\n\n# --- corpus ---------------------------------------------------------------\n\n\ndef corpus_status() -> dict[str, Any]:\n    \"\"\"Health and inventory: roots, real vs simulated counts, parse errors.\"\"\"\n    return CATALOG.stats()\n\n\ndef log_roots() -> dict[str, Any]:\n    \"\"\"The MES log directories being watched, and whether they exist.\"\"\"\n    return {\n        \"configured\": [str(r) for r in paths.configured_roots()],\n        \"existing\": [str(r) for r in paths.existing_roots()],\n        \"csv_configured\": [str(r) for r in paths.csv_roots()],\n        \"csv_existing\": [str(r) for r in paths.existing_csv_roots()],\n        \"env_overrides\": [\"MES_LOG_DIRS\", \"MES_LOG_DIR\",\n                          \"MES_CSV_DIRS\", \"MES_CSV_DIR\"],\n    }\n\n\ndef vehicles(*, real_only: bool = False) -> list[dict[str, Any]]:\n    \"\"\"Every distinct vehicle in the corpus, keyed by VIN where recoverable.\n\n    ``real_only`` keeps the two cars that actually exist -- a resolvable VIN\n    and at least one non-simulated log -- and drops the simulation pseudo\n    vehicles, whose \"VIN\" is MES's practice-data placeholder.\n    \"\"\"\n    found = CATALOG.vehicles()\n    if not real_only:\n        return found\n    return [v for v in found\n            if v.get(\"real_logs\", 0) > 0 and len(v.get(\"vin\", \"\")) >= 11]\n\n\ndef newest_mtime(vin: str = \"\") -> float:\n    \"\"\"Newest file mtime across a vehicle's logs -- the cache key for workup.\"\"\"\n    entries = CATALOG.select(vin=vin) if vin else CATALOG.entries()\n    return max((e.mtime for e in entries), default=0.0)\n\n\n# --- logs -----------------------------------------------------------------\n\n\ndef list_logs(*, kind: str = \"\", vehicle: str = \"\", vin: str = \"\",\n              since: str = \"\", until: str = \"\", limit: int = 30,\n              include_simulation: bool = False) -> dict[str, Any]:\n    \"\"\"Filtered log index, newest first by session timestamp.\"\"\"\n    entries = CATALOG.select(kind=kind, vehicle=vehicle, vin=vin, since=since,\n                             until=until, limit=limit,\n                             include_simulation=include_simulation)\n    return {\n        \"count\": len(entries),\n        \"filters\": {\"kind\": kind, \"vehicle\": vehicle, \"vin\": vin,\n                    \"since\": since, \"until\": until,\n                    \"include_simulation\": include_simulation},\n        \"logs\": [e.to_dict() for e in entries],\n    }\n\n\ndef read_log(name: str, *, max_bytes: int = 200_000) -> dict[str, Any]:\n    \"\"\"Read one MES log verbatim.\n\n    Resolution goes through :func:`mes.paths.resolve_log`, which requires a\n    bare filename matching a MES log pattern and verifies the fully resolved\n    real path is inside a configured root. That check is the whole security\n    boundary of this endpoint: an earlier version of the MCP server built the\n    path by concatenation, which on Windows let both ``..`` and an absolute\n    path escape it. Do not replace this with ``Path(root) / name``.\n    \"\"\"\n    try:\n        path = paths.resolve_log(name)\n    except MesError as exc:\n        raise BadRequest(str(exc)) from exc\n\n    decoded = encoding.read_log_text(path, max_bytes=max_bytes)\n    kind, raw_stamp, vehicle = paths.classify_name(path.name)\n    stamp = catalog.parse_stamp(raw_stamp)\n    out: dict[str, Any] = {\n        \"file\": path.name,\n        \"kind\": kind,\n        \"timestamp\": stamp.isoformat(sep=\" \") if stamp else raw_stamp,\n        \"vehicle\": vehicle,\n        \"encoding\": decoded.encoding,\n        \"size_bytes\": decoded.size_bytes,\n        \"truncated\": decoded.truncated,\n        \"text\": decoded.text,\n    }\n    if decoded.control_chars:\n        out[\"stray_control_bytes_removed\"] = decoded.control_chars\n    if \"SIMULATION MODE\" in decoded.text:\n        out[\"simulation\"] = True\n        out[\"warning\"] = \"SIMULATION MODE - this data is not from a vehicle\"\n    elif kind == \"scan\":\n        out[\"provenance\"] = (\"unverifiable - SCAN logs carry no simulation \"\n                             \"marker\")\n    return out\n\n\ndef search_logs(pattern: str, *, kind: str = \"\", vehicle: str = \"\",\n                vin: str = \"\", context_lines: int = 2, max_matches: int = 40,\n                include_simulation: bool = False) -> dict[str, Any]:\n    \"\"\"Case-insensitive regex search across logs, newest first.\"\"\"\n    if not pattern.strip():\n        raise BadRequest(\"a search pattern is required\")\n    try:\n        rx = re.compile(pattern, re.IGNORECASE)\n    except re.error as exc:\n        raise BadRequest(f\"invalid regular expression: {exc}\") from exc\n\n    entries = CATALOG.select(kind=kind, vehicle=vehicle, vin=vin,\n                             include_simulation=include_simulation)\n    hits: list[dict[str, Any]] = []\n    for entry in entries:\n        try:\n            lines = encoding.read_log_text(entry.path).splitlines()\n        except Exception as exc:  # one unreadable file must not sink a search\n            hits.append({\"file\": entry.name, \"error\": str(exc)})\n            continue\n        for i, line in enumerate(lines):\n            if not rx.search(line):\n                continue\n            lo = max(0, i - context_lines)\n            hi = min(len(lines), i + context_lines + 1)\n            hits.append({\n                \"file\": entry.name,\n                \"timestamp\": entry.timestamp,\n                \"simulation\": entry.simulation,\n                \"line\": i + 1,\n                \"match\": line.strip(),\n                \"context\": [f\"{j + 1}: {lines[j]}\" for j in range(lo, hi)],\n            })\n            if len(hits) >= max_matches:\n                return {\"count\": len(hits), \"truncated\": True,\n                        \"matches\": hits}\n    return {\"count\": len(hits), \"truncated\": False, \"matches\": hits}\n\n\n# --- per-vehicle analysis -------------------------------------------------\n\n\ndef workup(vin: str = \"\", vehicle: str = \"\") -> dict[str, Any]:\n    \"\"\"The pre-work dossier. Raises :class:`NotFound` when no logs match.\"\"\"\n    dossier = workup_mod.build(vin=vin, vehicle=vehicle)\n    if \"error\" in dossier:\n        raise NotFound(dossier[\"error\"])\n    return dossier\n\n\ndef marque_for_vin(vin: str) -> str:\n    \"\"\"``\"alfa\"``/``\"maserati\"``/``\"ferrari\"``/``\"unknown\"`` for this VIN's\n    WMI -- the only thing the web layer's ``data-marque`` theming needs.\n    Pure passthrough to :func:`mes.platform.marque_for_vin`; never raises,\n    never guesses (an unrecognised WMI is ``\"unknown\"``, not a default\n    marque -- the caller decides what to show for that).\"\"\"\n    return platform_mod.marque_for_vin(vin)\n\n\ndef vehicle_report(vin: str = \"\", vehicle: str = \"\") -> dict[str, Any]:\n    \"\"\"Identity, odometer span and chronic faults for one vehicle.\"\"\"\n    report = analysis.vehicle_summary(vin=vin, vehicle=vehicle)\n    if \"error\" in report:\n        raise NotFound(report[\"error\"])\n    return report\n\n\ndef live_vs_log(vin: str, module: str = \"\") -> dict[str, Any]:\n    \"\"\"Newest log read vs newest live read, one row per code, per module.\n\n    Passthrough to :func:`mes.compare.live_vs_log`; see that module for the\n    join and classification rules.\n    \"\"\"\n    if not vin.strip():\n        raise BadRequest(\"a VIN is required\")\n    result = compare.live_vs_log(vin, module=module)\n    if \"error\" in result:\n        raise BadRequest(result[\"error\"])\n    return result\n\n\ndef _classified(record: Any) -> dict[str, Any]:\n    \"\"\"A DTC record as a dict, with its classification made explicit.\n\n    ``DtcRecord.to_dict`` reports the classification only as a prose\n    ``assessment`` string; ``chronic`` and ``returned_after_clear`` are\n    properties that do not survive serialisation. Clients need the booleans to\n    colour a row, and re-deriving \"chronic\" from the odometer span in a\n    template would fork the rule -- so read the library's own properties here\n    and publish them. One definition, in ``mes.analysis.DtcRecord``.\n\n    ``severity`` collapses the same facts onto the four states the UI shows,\n    ordered by what changes a decision: a code that came back after a clear is\n    live and reproducing; a chronic one has persisted over distance; a cleared\n    one proves nothing until a monitor re-runs.\n    \"\"\"\n    out = record.to_dict()\n    out[\"chronic\"] = record.chronic\n    out[\"returned_after_clear\"] = record.returned_after_clear\n\n    if record.returned_after_clear:\n        severity = \"returned\"\n    elif record.chronic:\n        severity = \"chronic\"\n    elif \"cleared\" in record.statuses and record.session_count <= 1:\n        severity = \"cleared\"\n    elif record.session_count <= 1:\n        severity = \"seen-once\"\n    else:\n        severity = \"recurring\"\n    out[\"severity\"] = severity\n    return out\n\n\ndef extract_dtcs(*, vin: str = \"\", vehicle: str = \"\", since: str = \"\",\n                 include_simulation: bool = False) -> dict[str, Any]:\n    \"\"\"Every DTC with first-seen, last-seen, session count and odometer span.\n\n    Ordered so the codes that decide a diagnosis come first: returned-after-\n    clear, then chronic, then the rest.\n    \"\"\"\n    entries = CATALOG.select(vin=vin, vehicle=vehicle, since=since,\n                             include_simulation=include_simulation)\n    history = analysis.dtc_history(entries)\n    records = sorted(history.values(),\n                     key=lambda r: (not r.returned_after_clear,\n                                    not r.chronic, r.dtc))\n    return {\n        \"count\": len(records),\n        \"logs_considered\": len(entries),\n        \"simulation_included\": include_simulation,\n        \"dtcs\": [_classified(r) for r in records],\n    }\n\n\ndef dtc_history(code: str, *, vin: str = \"\") -> dict[str, Any]:\n    \"\"\"One code's complete life across sessions.\"\"\"\n    wanted = code.strip().upper()\n    if not wanted:\n        raise BadRequest(\"a DTC is required\")\n    history = analysis.dtc_history(vin=vin)\n    matches = {k: v for k, v in history.items()\n               if wanted in (k, k.split(\"-\")[0])}\n    if not matches:\n        raise NotFound(\n            f\"{wanted} appears in no real log for this vehicle \"\n            \"(simulation logs are excluded by default)\")\n    return {\"code\": wanted,\n            \"matches\": [_classified(r) for r in matches.values()]}\n\n\ndef freeze_frames(*, code: str = \"\", name: str = \"\",\n                  vin: str = \"\") -> dict[str, Any]:\n    \"\"\"The ~25 parameters captured when a code set.\n\n    This is the evidence that separates a cold-start fault from a highway one,\n    and it is destroyed by a clear -- which is why the UI reads it before\n    offering one.\n    \"\"\"\n    wanted = code.strip().upper()\n    if name.strip():\n        try:\n            entries = [CATALOG.by_name(name)]\n        except MesError as exc:\n            raise NotFound(str(exc)) from exc\n    else:\n        entries = CATALOG.select(kind=\"fes\", vin=vin)\n\n    found: list[dict[str, Any]] = []\n    for entry in entries:\n        if entry.kind != \"fes\" or entry.parse_error:\n            continue\n        log = fes.load_fes(entry.path, timestamp=entry.timestamp)\n        for d in log.dtcs:\n            if wanted and wanted not in (d.full, d.code):\n                continue\n            if not d.freeze_frame:\n                continue\n            found.append({\n                \"dtc\": d.full,\n                \"description\": d.description,\n                \"status\": d.status.value,\n                \"status_meaning\": d.status.explanation,\n                \"file\": entry.name,\n                \"timestamp\": entry.timestamp,\n                \"ecu\": log.ecu_description,\n                \"vin\": log.vin,\n                \"freeze_frame\": {k: v.display\n                                 for k, v in d.freeze_frame.items()},\n            })\n    if not found:\n        raise NotFound(f\"no freeze frame for {code or '(any code)'}\")\n    return {\"count\": len(found), \"frames\": found}\n\n\ndef actuator_history(*, vin: str = \"\", operation: str = \"\") -> dict[str, Any]:\n    \"\"\"Every actuator test and adjustment ever run, and why any failed.\"\"\"\n    entries = CATALOG.select(kind=\"fes\", vin=vin)\n    runs: list[dict[str, Any]] = []\n    for entry in entries:\n        if entry.parse_error:\n            continue\n        log = fes.load_fes(entry.path, timestamp=entry.timestamp)\n        for a in log.actuators:\n            if operation.strip() and operation.lower() not in a.operation.lower():\n                continue\n            row = a.to_dict()\n            row.update({\"file\": entry.name, \"timestamp\": entry.timestamp,\n                        \"ecu\": log.ecu_description})\n            runs.append(row)\n    runs.sort(key=lambda r: r.get(\"timestamp\") or \"\", reverse=True)\n    failed = [r for r in runs if r.get(\"outcome\") == \"FAILED TO EXECUTE\"]\n    return {\n        \"count\": len(runs),\n        \"failed\": len(failed),\n        \"runs\": runs,\n        \"note\": (\"MES actuator tests on the IAW 10JA require key-on \"\n                 \"engine-off; 'Engine running' is an interlock, not a fault.\"),\n    }\n\n\n# --- sessions and scans ---------------------------------------------------\n\n\ndef analyze_session(*, name: str = \"\", vin: str = \"\") -> dict[str, Any]:\n    \"\"\"One FES engineering session: identity, DTCs, clears, actuators.\"\"\"\n    try:\n        entry = catalog.resolve_or_latest(name, kind=\"fes\", vin=vin)\n    except MesError as exc:\n        raise NotFound(str(exc)) from exc\n    log = fes.load_fes(entry.path, timestamp=entry.timestamp)\n    out = log.to_dict()\n    out[\"file\"] = entry.name\n    out[\"timestamp\"] = entry.timestamp\n    cleared = analysis.post_clear_assessment(log)\n    if cleared:\n        out[\"clear_assessment\"] = cleared.to_dict()\n    return out\n\n\ndef analyze_scan(*, name: str = \"\", vin: str = \"\") -> dict[str, Any]:\n    \"\"\"One all-systems SCAN: per-module status, with network-cascade detection.\"\"\"\n    try:\n        entry = catalog.resolve_or_latest(name, kind=\"scan\", vin=vin)\n    except MesError as exc:\n        raise NotFound(str(exc)) from exc\n    log = scan.load_scan(entry.path, timestamp=entry.timestamp)\n    out = log.to_dict()\n    out[\"file\"] = entry.name\n    out[\"timestamp\"] = entry.timestamp\n    by_module = {m.name: m.dtcs for m in log.modules if m.dtcs}\n    event = analysis.detect_network_event(by_module)\n    if event:\n        out[\"network_event\"] = event.to_dict()\n    out[\"provenance\"] = (\"unverifiable - SCAN logs carry no simulation marker\")\n    return out\n\n\ndef list_parameters(*, name: str = \"\", vin: str = \"\") -> dict[str, Any]:\n    \"\"\"Live parameters a FES session recorded, unioned across samples.\"\"\"\n    try:\n        entry = catalog.resolve_or_latest(name, kind=\"fes\", vin=vin)\n    except MesError as exc:\n        raise NotFound(str(exc)) from exc\n    log = fes.load_fes(entry.path, timestamp=entry.timestamp)\n    if not log.samples:\n        return {\"file\": entry.name, \"samples\": 0,\n                \"note\": \"this session logged no live parameters\"}\n    return {\n        \"file\": entry.name,\n        \"timestamp\": entry.timestamp,\n        \"ecu\": log.ecu_description,\n        \"samples\": len(log.samples),\n        \"parameter_count\": len(log.param_names()),\n        \"parameters\": log.param_names(),\n    }\n\n\ndef parameter_series(parameter: str, *, name: str = \"\",\n                     vin: str = \"\") -> dict[str, Any]:\n    \"\"\"One session parameter as an ordered series with statistics.\"\"\"\n    try:\n        entry = catalog.resolve_or_latest(name, kind=\"fes\", vin=vin)\n    except MesError as exc:\n        raise NotFound(str(exc)) from exc\n    log = fes.load_fes(entry.path, timestamp=entry.timestamp)\n    series = log.series(parameter)\n    if not series.samples:\n        raise NotFound(f\"'{parameter}' was not logged in {entry.name}\")\n    out = series.stats()\n    out[\"file\"] = entry.name\n    out[\"values\"] = [s.display for s in series.samples]\n    out[\"timing_note\"] = (\"MES records no per-sample timestamp; order is file \"\n                          \"order and the sample rate is unknown\")\n    if out.get(\"static\"):\n        out[\"interpretation\"] = (\n            \"This value never changed across the whole session -- consistent \"\n            \"with a substituted default or a modelled value rather than a \"\n            \"live measurement. Confirm before treating it as a reading.\")\n    return out\n\n\n# --- decision support -----------------------------------------------------\n\n\ndef fault_tree(codes: str = \"\", *, vin: str = \"\") -> dict[str, Any]:\n    \"\"\"Applicable isolation sequences, annotated with this car's evidence.\n\n    Returns successfully even when nothing matches: the payload then carries\n    the trees that *do* exist, which is the useful answer to \"is there a tree\n    for this?\".\n    \"\"\"\n    code_list = [c for c in re.split(r\"[,\\s;]+\", codes) if c.strip()]\n    if not code_list:\n        return {\n            \"error\": \"no codes given\",\n            \"available\": [{\"tree\": t.key, \"title\": t.title,\n                           \"applies_to\": sorted(t.codes)}\n                          for t in faulttree.TREES],\n        }\n    return faulttree.evaluate(code_list, vin=vin)\n\n\ndef assess_verdict(*, vin: str, codes: str, component: str, mechanism: str,\n                   measurements: str,\n                   disconfirming_test: str) -> dict[str, Any]:\n    \"\"\"The evidence gate.\n\n    The only non-read operation in the P1 surface, and it writes nothing to\n    the car -- it evaluates a proposed diagnosis against four criteria and\n    refuses CONFIRMED unless all of them hold.\n    \"\"\"\n    result = verdict.assess(vin=vin, codes=codes, component=component,\n                            mechanism=mechanism, measurements=measurements,\n                            disconfirming_test=disconfirming_test)\n    if \"error\" in result and \"verdict\" not in result:\n        raise BadRequest(result[\"error\"])\n    return result\n\n\ndef open_codes_for(dossier: dict[str, Any]) -> list[str]:\n    \"\"\"The codes a dossier should route to a fault tree.\n\n    Two sources, unioned:\n\n    * the newest session that held findings -- preferred over the newest\n      session outright, because the latter is often the empty post-clear\n      re-read and routing off it produces \"no codes\" on a car that plainly\n      has some;\n    * every chronic or returned-after-clear code in the car's history.\n\n    The second source matters more than it looks. On this Stelvio the newest\n    session shows a cleared ``P0440`` while the code that actually decides the\n    diagnosis is a chronic ``P0456`` spanning 26,500 km. Routing on the latest\n    session alone would send the tree after the wrong fault.\n    \"\"\"\n    codes: set[str] = set()\n\n    current = dossier.get(\"current_picture\", {})\n    for key in (\"last_session_with_findings\", \"latest_session\"):\n        session = current.get(key) or {}\n        found = [d.get(\"code\") or d.get(\"dtc\") or \"\"\n                 for d in session.get(\"dtcs\", [])]\n        found = [knowledge.base_code(c) for c in found if c]\n        if found:\n            codes.update(found)\n            break\n\n    history = dossier.get(\"history\", {})\n    for bucket in (\"chronic\", \"returned_after_clear\"):\n        for record in history.get(bucket, []):\n            raw = record.get(\"dtc\") or record.get(\"code\") or \"\"\n            if raw:\n                codes.add(knowledge.base_code(raw))\n\n    return sorted(codes)\n\n\n# --- dealer (wiTECH) results -----------------------------------------------\n\n\ndef dealer_record(vin: str, kind: str, data: dict[str, Any],\n                  note: str = \"\") -> dict[str, Any]:\n    \"\"\"Record one technician-entered wiTECH result. Raises BadRequest on\n    anything the store's per-kind validation rejects.\"\"\"\n    if not vin.strip():\n        raise BadRequest(\"a VIN is required\")\n    try:\n        return dealer_mod.record(vin, kind, data, note=note)\n    except ValueError as exc:\n        raise BadRequest(str(exc)) from exc\n\n\ndef dealer_results(vin: str) -> dict[str, Any]:\n    \"\"\"Every dealer result recorded for this VIN, oldest first.\"\"\"\n    if not vin.strip():\n        raise BadRequest(\"a VIN is required\")\n    return {\"vin\": vin, \"results\": dealer_mod.load(vin)}\n\n\n# --- technician notes -------------------------------------------------------\n\n\ndef add_note(vin: str, text: str, target_kind: str = \"vehicle\", target_id: str = \"\",\n            author: str = \"technician\", tags: Optional[list[str]] = None) -> dict[str, Any]:\n    \"\"\"Record one technician note. Raises BadRequest on invalid input.\"\"\"\n    if not vin.strip():\n        raise BadRequest(\"a VIN is required\")\n    try:\n        return notes_mod.add(vin, text, target_kind, target_id=target_id,\n                             author=author, tags=tags)\n    except ValueError as exc:\n        raise BadRequest(str(exc)) from exc\n\n\ndef notes(vin: str, target_kind: str = \"\", target_id: str = \"\") -> dict[str, Any]:\n    \"\"\"Notes for this VIN, oldest first, filtered by target when given.\"\"\"\n    if not vin.strip():\n        raise BadRequest(\"a VIN is required\")\n    return {\"vin\": vin,\n            \"notes\": notes_mod.load(vin, target_kind=target_kind or None,\n                                    target_id=target_id)}\n\n\ndef edit_note(id: str, text: str) -> dict[str, Any]:\n    \"\"\"Amend a note's text. Never rewrites history.\"\"\"\n    try:\n        return notes_mod.edit(id, text)\n    except ValueError as exc:\n        raise BadRequest(str(exc)) from exc\n\n\ndef hide_note(id: str) -> dict[str, Any]:\n    \"\"\"Hide a note (soft delete). Never rewrites history.\"\"\"\n    try:\n        return notes_mod.hide(id)\n    except ValueError as exc:\n        raise BadRequest(str(exc)) from exc\n\n\n# --- reference ------------------------------------------------------------\n\n\ndef module_registry(*, abbrev: str = \"\", domain: str = \"\") -> dict[str, Any]:\n    \"\"\"The 126-module registry: one module, one domain, or the whole map.\"\"\"\n    if abbrev.strip():\n        info = modules.describe(abbrev)\n        if \"error\" in info:\n            raise NotFound(info[\"error\"])\n        return info\n    grouped = modules.by_domain()\n    if domain.strip():\n        key = domain.strip().lower()\n        if key not in grouped:\n            raise NotFound(f\"unknown domain '{domain}'\")\n        return {\"domain\": key,\n                \"modules\": [m.to_dict() for m in grouped[key]]}\n    return {\n        \"stats\": modules.registry_stats(),\n        \"by_domain\": {d: [m.to_dict() for m in v]\n                      for d, v in sorted(grouped.items())},\n    }\n\n\ndef failure_type(byte: str) -> dict[str, Any]:\n    \"\"\"Decode the two hex digits after the dash in a UDS DTC.\"\"\"\n    ft = dtc_mod.failure_type(byte.strip())\n    if ft is None:\n        raise NotFound(f\"no failure type for '{byte}'\")\n    return ft.to_dict()\n\n\ndef describe_dtc(code: str, module: str = \"\") -> dict[str, Any]:\n    \"\"\"Look up a DTC's description in MES's own shipped language files.\n\n    Mirrors the ``dtc_description`` MCP tool call-for-call. This is a\n    fallback for a code no log gave text for, not a general database: MES's\n    ``English.dat``/``English.txt`` carry no DTC-code key at all (see\n    ``docs/format/MES_LANGUAGE_FILES.md``), so against the currently\n    installed files this raises :class:`NotFound` for virtually every real\n    code. The lookup itself is genuine and forward-compatible.\n    \"\"\"\n    if not code.strip():\n        raise BadRequest(\"a DTC code is required\")\n    result = dtc_text.describe(code, module.strip() or None)\n    if result is None:\n        raise NotFound(\n            f\"'{code}' has no entry in MES's shipped language files -- no \"\n            \"DTC-code key exists in the currently installed \"\n            \"English.dat/English.txt (docs/format/MES_LANGUAGE_FILES.md)\")\n    return result\n\n\n# --- CSV recordings -------------------------------------------------------\n\n\ndef list_recordings() -> dict[str, Any]:\n    \"\"\"CSV recordings from MES's graph subsystem, newest first.\"\"\"\n    recs = csvlog.list_recordings()\n    out: dict[str, Any] = {\n        \"count\": len(recs),\n        \"recordings\": recs,\n        \"roots\": [str(r) for r in paths.csv_roots()],\n    }\n    if not recs:\n        out[\"note\"] = (\n            \"No CSV recordings found. In MES: Graph tab, add parameters, then \"\n            \"CSV Start / Stop. The export lands in the Settings 'Export \"\n            \"Folder'. Point MES_CSV_DIR at it if it differs from the log \"\n            \"folder.\")\n    return out\n\n\ndef _recording(name: str):\n    try:\n        return csvlog.load_named(name)\n    except MesError as exc:\n        raise NotFound(str(exc)) from exc\n\n\ndef read_recording(name: str, *, preview_rows: int = 10) -> dict[str, Any]:\n    \"\"\"One recording: columns, measured timing, dropouts, TAG/DTC events.\"\"\"\n    return _recording(name).to_dict(preview_rows=preview_rows)\n\n\ndef recording_series(name: str, parameter: str) -> dict[str, Any]:\n    \"\"\"One recorded parameter as a *timed* series -- real timestamps, unlike\n    a .txt session, so the statistics are physically meaningful.\"\"\"\n    rec = _recording(name)\n    series = rec.series(parameter)\n    if not series.samples:\n        raise NotFound(f\"'{parameter}' is not a column in {rec.name}\")\n    out = series.stats()\n    out[\"file\"] = rec.name\n    out[\"values\"] = [{\"t\": stamp, \"value\": s.display}\n                     for stamp, s in zip(series.stamps, series.samples)]\n    if out.get(\"static\"):\n        out[\"interpretation\"] = (\n            \"This value never changed across the recording -- consistent with \"\n            \"a substituted default rather than a live measurement.\")\n    return out\n\n\ndef recording_events(name: str, *, condition: str = \"\") -> dict[str, Any]:\n    \"\"\"TAG/DTC events and dropouts; with a condition, excursion intervals.\"\"\"\n    rec = _recording(name)\n    out: dict[str, Any] = {\n        \"file\": rec.name,\n        \"timing\": rec.timing(),\n        \"tag_events\": [t.to_dict() for t in rec.tags],\n        \"dtcs_in_tags\": sorted({d for t in rec.tags for d in t.dtcs}),\n    }\n    if condition.strip():\n        try:\n            out[\"threshold\"] = rec.crossings(condition)\n        except MesError as exc:\n            raise BadRequest(str(exc)) from exc\n    return out\n\n\ndef recording_snapshot(name: str, at_seconds: float) -> dict[str, Any]:\n    \"\"\"The post-hoc freeze frame: every value at the sample nearest a time.\"\"\"\n    rec = _recording(name)\n    return {\"file\": rec.name, **rec.snapshot(at_seconds)}\n","numLines":710,"startLine":1,"totalLines":710}},"sourceToolAssistantUUID":"e1043b55-3fa7-48c6-9b07-778a7acd45f3","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
