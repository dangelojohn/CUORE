\"dtc\", \"\")","             base = _base(full)","             last_seen = rec.get(\"last_seen\")","-            status = _code_status(base, last_seen, cleared_at, codes_cleared,","-                                  codes_returned, codes_uncleared, last_findings,","-                                  last_findings_ts, recent_ts)","+            status_detail = None","+            live = live_signal.get(base)","+            # Review #6 item 1: a code this car's logs call cleared (the","+            # last MES-log occurrence is at/before the clear) but that the","+            # car itself has reported again since -- read straight off it,","+            # not through a second log file -- returned: erased and set","+            # again. The MES log alone would call this CLEARED_UNVERIFIED,","+            # disagreeing with the verdict, which already treats a live","+            # read as decisive (see ``_build_verdict``'s own","+            # ``live_active_codes``).","+            if live and cleared_at and base in codes_cleared and live[\"at\"] > cleared_at:","+                status = \"ACTIVE\"","+                if not last_seen or live[\"at\"] > last_seen:","+                    last_seen = live[\"at\"]","+                cleared_short = _short_date(cleared_at)","+                live_short = live[\"at\"][:16].replace(\"T\", \" \")","+                status_detail = (f\"returned -- erased {cleared_short}, set again \"","+                                 f\"{live_short} (read from the car)\")","+            else:","+                status = _code_status(base, last_seen, cleared_at, codes_cleared,","+                                      codes_returned, codes_uncleared, last_findings,","+                                      last_findings_ts, recent_ts)","+                if live and live[\"active\"] and status != \"ACTIVE\":","+                    status = \"ACTIVE\"","+                    if not last_seen or live[\"at\"] > last_seen:","+                        last_seen = live[\"at\"]","             distance = rec.get(\"distance_span_km\")","             rows.append({","                 \"code\": base, \"dtc\": full,"]},{"oldStart":1311,"oldLines":6,"newStart":1337,"newLines":7,"lines":["                 \"system\": _SYSTEM_BY_LETTER.get(base[:1], base[:1] if base else None),","                 \"bucket\": bucket,","                 \"status\": status, \"status_label\": _STATUS_LABEL[status],","+                \"status_detail\": status_detail,","                 \"sessions\": rec.get(\"sessions\"),","                 \"last_seen_short\": _short_date(last_seen),","                 \"last_seen\": last_seen, \"first_seen\": rec.get(\"first_seen\"),"]},{"oldStart":1318,"oldLines":7,"newStart":1345,"newLines":32,"lines":["                 \"href\": f\"/v/{vin}/code/{base}\",","                 \"family\": family_map.get(base),","             })","+            seen_bases.add(base)"," ","+    # Review #6 item 1: a code read only live (U1736: never logged to a","+    # MES file, only ever seen in a from-car module sweep) still belongs","+    # on the Codes list -- the mechanic's own \"every code this car has","+    # shown\" list must not silently exclude it just because no log file","+    # ever carried it.","+    for base, live in sorted(live_signal.items()):","+        if base in seen_bases:","+            continue","+        status = \"ACTIVE\" if live[\"active\"] else \"STALE\"","+        rows.append({","+            \"code\": base, \"dtc\": base,","+            \"description\": \"\",","+            \"system\": _SYSTEM_BY_LETTER.get(base[:1], base[:1] if base else None),","+            \"bucket\": \"live_only\",","+            \"status\": status, \"status_label\": _STATUS_LABEL[status],","+            \"status_detail\": \"read live; never logged to a file\",","+            \"sessions\": None,","+            \"last_seen_short\": live[\"at\"][:16].replace(\"T\", \" \"),","+            \"last_seen\": live[\"at\"], \"first_seen\": l