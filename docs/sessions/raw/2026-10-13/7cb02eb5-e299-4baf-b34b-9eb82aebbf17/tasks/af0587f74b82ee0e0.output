{"parentUuid":"9facc4d9-bd88-41e0-9e73-7f41a992f1fb","isSidechain":true,"promptId":"18814b70-8b7e-4c43-946c-5c9dac496990","agentId":"af0587f74b82ee0e0","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_019s2Q7YEtNumUiwPzQ4zUyd","type":"tool_result","content":"170\t                    confidence=spec.confidence, default_rate_hz=MED_HZ, module=code,\n171\t                    did=spec.did, formula=formula, note=spec.note))\n172\t    return out\n173\t\n174\t\n175\t#: Sentinel used by a placeholder channel's ``did`` field to mean \"no real\n176\t#: DID exists -- never poll this\". A real catalogued DID is always nonzero,\n177\t#: so 0 is safe as a deliberate \"unknown\" marker (see :func:`resolve_channels`,\n178\t#: which refuses to add any channel using this sentinel to a poll list).\n179\tUNKNOWN_DID = 0\n180\t\n181\t#: ``cuore.live.did_catalog``'s own research note: the EVAP vent/canister\n182\t#: actuator is exposed on this car as an \"ESIM\" (Evaporative System\n183\t#: Integrity Monitor) UDS 0x31 RoutineControl, not a readable DID -- and\n184\t#: RoutineControl is a write service, refused outright by\n185\t#: ``assert_read_only_uds`` before a byte leaves the adapter. There is no\n186\t#: DID to catalogue, so this is a documented placeholder, not a real\n187\t#: channel: present in the registry (so it is visible and self-explaining\n188\t#: rather than silently missing) but never pollable (``did=UNKNOWN_DID``;\n189\t#: :func:`resolve_channels` refuses it) and never added to any preset.\n190\tdef _placeholder_channels() -> list[Channel]:\n191\t    return [\n192\t        Channel(id=\"esim_status\", name=\"ESIM status (no readable DID)\", unit=\"\",\n193\t               kind=\"did\", bus=\"can_c\", confidence=\"unknown_did\",\n194\t               default_rate_hz=SLOW_HZ, module=\"ECM\", did=UNKNOWN_DID,\n195\t               note=\"ESIM (Evaporative System Integrity Monitor) is exposed only \"\n196\t                    \"as a UDS 0x31 RoutineControl, not a readable DID, per \"\n197\t                    \"cuore.live.did_catalog's own research note -- refused by \"\n198\t                    \"assert_read_only_uds before a byte leaves the adapter. \"\n199\t                    \"Placeholder only: resolve_channels() refuses to poll it.\"),\n200\t    ]\n201\t\n202\t\n203\tdef _computed_channels() -> list[Channel]:\n204\t    return [\n205\t        Channel(id=\"boost\", name=\"boost (MAP - baro)\", unit=\"kPa\", kind=\"computed\",\n206\t               bus=\"can_c\", confidence=\"computed\", default_rate_hz=MED_HZ,\n207\t               expr=\"intake_map - barometric_pressure\",\n208\t               depends_on=(\"intake_map\", \"barometric_pressure\"),\n209\t               note=\"derived from the two legislated PIDs; compare against the \"\n210\t                    \"unverified ECM boost DID 195A\"),\n211\t    ]\n212\t\n213\t\n214\tdef _builtin_channels() -> list[Channel]:\n215\t    return (_pid_channels() + _did_channels() + [_battery_channel()]\n216\t           + _computed_channels() + _placeholder_channels())\n217\t\n218\t\n219\tdef builtin_channel_ids() -> set[str]:\n220\t    \"\"\"Ids of every channel this project ships with -- excludes saved custom channels.\n221\t\n222\t    :mod:`ui_store` uses this (not :func:`registry`) to decide whether a\n223\t    submitted custom channel id collides with something built-in -- as\n224\t    opposed to an existing custom channel of the same id simply being\n225\t    re-saved, which must be allowed.\n226\t    \"\"\"\n227\t    return {c.id for c in _builtin_channels()}\n228\t\n229\t\n230\tdef available_channels() -> list[Channel]:\n231\t    \"\"\"Every channel this project knows how to sample, including saved custom ones.\"\"\"\n232\t    from . import ui_store  # local: ui_store imports this module; avoid a cycle at import time\n233\t    return _builtin_channels() + ui_store.load_custom_channels()\n234\t\n235\t\n236\t_REGISTRY: Optional[dict[str, Channel]] = None\n237\t\n238\t\n239\tdef registry() -> dict[str, Channel]:\n240\t    global _REGISTRY\n241\t    if _REGISTRY is None:\n242\t        _REGISTRY = {c.id: c for c in available_channels()}\n243\t    return _REGISTRY\n244\t\n245\t\n246\tdef invalidate_registry() -> None:\n247\t    \"\"\"Force the next :func:`registry`/:func:`by_id` call to recompute.\n248\t\n249\t    Called after custom channels are saved so a running dashboard sees new\n250\t    custom channels (and formula/expr edits to existing ones) without a\n251\t    process restart.\n252\t    \"\"\"\n253\t    global _REGISTRY\n254\t    _REGISTRY = None\n255\t\n256\t\n257\tdef by_id(channel_id: str) -> Channel:\n258\t    ch = registry().get(channel_id)\n259\t    if ch is None:\n260\t        raise BadCommand(f\"unknown channel id {channel_id!r}\")\n261\t    return ch\n262\t\n263\t\n264\t#: One-click starts. Every id here must resolve through :func:`by_id`; a\n265\t#: mismatch would be a bug in this file, not caller input, so it is not\n266\t#: guarded -- :func:`resolve_channels` raising KeyError on a typo here during\n267\t#: development is preferable to silently dropping a channel from a preset.\n268\tPRESETS: dict[str, tuple[str, ...]] = {\n269\t    \"engine_basics\": (\"engine_rpm\", \"vehicle_speed\", \"engine_coolant_temp\",\n270\t                      \"intake_air_temp\", \"absolute_load\", \"throttle_position\",\n271\t                      \"battery_voltage\"),\n272\t    \"boost\": (\"intake_map\", \"barometric_pressure\", \"boost\", \"ecm_195a\"),\n273\t    \"evap_job\": (\"commanded_evap_purge\", \"fuel_level\", \"evap_vapor_pressure\",\n274\t                \"evap_vapor_pressure_abs\", \"engine_coolant_temp\", \"intake_air_temp\"),\n275\t    \"transmission\": (\"tcm_04fe\", \"tcm_0518\"),\n276\t    \"tpms\": (\"rfhub_40b1_pressure\", \"rfhub_40b1_temp\", \"rfhub_40b2_pressure\",\n277\t            \"rfhub_40b2_temp\", \"rfhub_40b3_pressure\", \"rfhub_40b3_temp\",\n278\t            \"rfhub_40b4_pressure\", \"rfhub_40b4_temp\"),\n279\t    # Deliberately omits \"esim_status\": no DID exists for it (see\n280\t    # _placeholder_channels), and resolve_channels() refuses to poll it --\n281\t    # a preset listing it would make this whole preset unresolvable.\n282\t    \"evap_test_a\": (\"fuel_level\", \"commanded_evap_purge\", \"evap_vapor_pressure_abs\",\n283\t                    \"engine_rpm\", \"engine_coolant_temp\"),\n284\t}\n285\t\n286\t\n287\tdef presets() -> dict[str, list[dict[str, Any]]]:\n288\t    reg = registry()\n289\t    return {name: [reg[cid].to_dict() for cid in ids if cid in reg]\n290\t            for name, ids in PRESETS.items()}\n291\t\n292\t\n293\t# ===========================================================================\n294\t# per-bus capture presets -- what a bypass cable unlocks, catalogue only\n295\t# ===========================================================================\n296\t#\n297\t# Distinct from PRESETS above: those are active-poll channel groups for the\n298\t# dashboard (a Mode 01 PID or a UDS DID the adapter is asked for at a rate).\n299\t# These describe what a *bus capture* (passive listen, see"}]},"uuid":"5ffb228e-2cac-46be-8578-085693b33235","timestamp":"2026-10-14T05:31:17.811Z","toolUseResult":{"type":"text","file":{"filePath":"C:\\Users\\User\\mcp-servers\\cuore\\live\\channels.py","content":"                    confidence=spec.confidence, default_rate_hz=MED_HZ, module=code,\n                    did=spec.did, formula=formula, note=spec.note))\n    return out\n\n\n#: Sentinel used by a placeholder channel's ``did`` field to mean \"no real\n#: DID exists -- never poll this\". A real catalogued DID is always nonzero,\n#: so 0 is safe as a deliberate \"unknown\" marker (see :func:`resolve_channels`,\n#: which refuses to add any channel using this sentinel to a poll list).\nUNKNOWN_DID = 0\n\n#: ``cuore.live.did_catalog``'s own research note: the EVAP vent/canister\n#: actuator is exposed on this car as an \"ESIM\" (Evaporative System\n#: Integrity Monitor) UDS 0x31 RoutineControl, not a readable DID -- and\n#: RoutineControl is a write service, refused outright by\n#: ``assert_read_only_uds`` before a byte leaves the adapter. There is no\n#: DID to catalogue, so this is a documented placeholder, not a real\n#: channel: present in the registry (so it is visible and self-explaining\n#: rather than silently missing) but never pollable (``did=UNKNOWN_DID``;\n#: :func:`resolve_channels` refuses it) and never added to any preset.\ndef _placeholder_channels() -> list[Channel]:\n    return [\n        Channel(id=\"esim_status\", name=\"ESIM status (no readable DID)\", unit=\"\",\n               kind=\"did\", bus=\"can_c\", confidence=\"unknown_did\",\n               default_rate_hz=SLOW_HZ, module=\"ECM\", did=UNKNOWN_DID,\n               note=\"ESIM (Evaporative System Integrity Monitor) is exposed only \"\n                    \"as a UDS 0x31 RoutineControl, not a readable DID, per \"\n                    \"cuore.live.did_catalog's own research note -- refused by \"\n                    \"assert_read_only_uds before a byte leaves the adapter. \"\n                    \"Placeholder only: resolve_channels() refuses to poll it.\"),\n    ]\n\n\ndef _computed_channels() -> list[Channel]:\n    return [\n        Channel(id=\"boost\", name=\"boost (MAP - baro)\", unit=\"kPa\", kind=\"computed\",\n               bus=\"can_c\", confidence=\"computed\", default_rate_hz=MED_HZ,\n               expr=\"intake_map - barometric_pressure\",\n               depends_on=(\"intake_map\", \"barometric_pressure\"),\n               note=\"derived from the two legislated PIDs; compare against the \"\n                    \"unverified ECM boost DID 195A\"),\n    ]\n\n\ndef _builtin_channels() -> list[Channel]:\n    return (_pid_channels() + _did_channels() + [_battery_channel()]\n           + _computed_channels() + _placeholder_channels())\n\n\ndef builtin_channel_ids() -> set[str]:\n    \"\"\"Ids of every channel this project ships with -- excludes saved custom channels.\n\n    :mod:`ui_store` uses this (not :func:`registry`) to decide whether a\n    submitted custom channel id collides with something built-in -- as\n    opposed to an existing custom channel of the same id simply being\n    re-saved, which must be allowed.\n    \"\"\"\n    return {c.id for c in _builtin_channels()}\n\n\ndef available_channels() -> list[Channel]:\n    \"\"\"Every channel this project knows how to sample, including saved custom ones.\"\"\"\n    from . import ui_store  # local: ui_store imports this module; avoid a cycle at import time\n    return _builtin_channels() + ui_store.load_custom_channels()\n\n\n_REGISTRY: Optional[dict[str, Channel]] = None\n\n\ndef registry() -> dict[str, Channel]:\n    global _REGISTRY\n    if _REGISTRY is None:\n        _REGISTRY = {c.id: c for c in available_channels()}\n    return _REGISTRY\n\n\ndef invalidate_registry() -> None:\n    \"\"\"Force the next :func:`registry`/:func:`by_id` call to recompute.\n\n    Called after custom channels are saved so a running dashboard sees new\n    custom channels (and formula/expr edits to existing ones) without a\n    process restart.\n    \"\"\"\n    global _REGISTRY\n    _REGISTRY = None\n\n\ndef by_id(channel_id: str) -> Channel:\n    ch = registry().get(channel_id)\n    if ch is None:\n        raise BadCommand(f\"unknown channel id {channel_id!r}\")\n    return ch\n\n\n#: One-click starts. Every id here must resolve through :func:`by_id`; a\n#: mismatch would be a bug in this file, not caller input, so it is not\n#: guarded -- :func:`resolve_channels` raising KeyError on a typo here during\n#: development is preferable to silently dropping a channel from a preset.\nPRESETS: dict[str, tuple[str, ...]] = {\n    \"engine_basics\": (\"engine_rpm\", \"vehicle_speed\", \"engine_coolant_temp\",\n                      \"intake_air_temp\", \"absolute_load\", \"throttle_position\",\n                      \"battery_voltage\"),\n    \"boost\": (\"intake_map\", \"barometric_pressure\", \"boost\", \"ecm_195a\"),\n    \"evap_job\": (\"commanded_evap_purge\", \"fuel_level\", \"evap_vapor_pressure\",\n                \"evap_vapor_pressure_abs\", \"engine_coolant_temp\", \"intake_air_temp\"),\n    \"transmission\": (\"tcm_04fe\", \"tcm_0518\"),\n    \"tpms\": (\"rfhub_40b1_pressure\", \"rfhub_40b1_temp\", \"rfhub_40b2_pressure\",\n            \"rfhub_40b2_temp\", \"rfhub_40b3_pressure\", \"rfhub_40b3_temp\",\n            \"rfhub_40b4_pressure\", \"rfhub_40b4_temp\"),\n    # Deliberately omits \"esim_status\": no DID exists for it (see\n    # _placeholder_channels), and resolve_channels() refuses to poll it --\n    # a preset listing it would make this whole preset unresolvable.\n    \"evap_test_a\": (\"fuel_level\", \"commanded_evap_purge\", \"evap_vapor_pressure_abs\",\n                    \"engine_rpm\", \"engine_coolant_temp\"),\n}\n\n\ndef presets() -> dict[str, list[dict[str, Any]]]:\n    reg = registry()\n    return {name: [reg[cid].to_dict() for cid in ids if cid in reg]\n            for name, ids in PRESETS.items()}\n\n\n# ===========================================================================\n# per-bus capture presets -- what a bypass cable unlocks, catalogue only\n# ===========================================================================\n#\n# Distinct from PRESETS above: those are active-poll channel groups for the\n# dashboard (a Mode 01 PID or a UDS DID the adapter is asked for at a rate).\n# These describe what a *bus capture* (passive listen, see","numLines":130,"startLine":170,"totalLines":567}},"sourceToolAssistantUUID":"9facc4d9-bd88-41e0-9e73-7f41a992f1fb","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
