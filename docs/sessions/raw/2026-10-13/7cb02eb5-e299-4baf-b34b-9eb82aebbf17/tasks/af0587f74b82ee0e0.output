{"parentUuid":"fc01f1c3-11cd-451b-8bd5-53fc374c5343","isSidechain":true,"agentId":"af0587f74b82ee0e0","message":{"model":"claude-sonnet-5","id":"msg_011Cg1aaMxvaW4nWcHt3W9dH","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01Ho71yRYaBKuSSaihrAxaLo","name":"Read","input":{"file_path":"C:\\Users\\User\\mcp-servers\\cuore\\services\\tests_bridge.py"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":6736,"cache_read_input_tokens":57204,"cache_creation":{"ephemeral_5m_input_tokens":6736,"ephemeral_1h_input_tokens":0},"output_tokens":4,"service_tier":"standard","inference_geo":"global"},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_01Ho71yRYaBKuSSaihrAxaLo":{"file_path":"C:\\Users\\User\\mcp-servers\\cuore\\services\\tests_bridge.py"}},"serverClassifierRequest":"3acc524c-02db-44b3-8971-41c863f858b6","apiBlockIndex":1,"requestId":"req_011Cg1aaMcqhCU5ZYVn6U9s6","attributionAgent":"general-purpose","type":"assistant","uuid":"469e0670-5cc4-4fda-b44a-1c2692239347","timestamp":"2026-10-14T05:30:13.370Z","effort":"high","perTurnEffort":null,"userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
{"parentUuid":"469e0670-5cc4-4fda-b44a-1c2692239347","isSidechain":true,"promptId":"18814b70-8b7e-4c43-946c-5c9dac496990","agentId":"af0587f74b82ee0e0","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Ho71yRYaBKuSSaihrAxaLo","type":"tool_result","content":"1\t\"\"\"The Tests surface: a catalogue of every mechanic test (:mod:`mes.mechanic_tests`)\n2\tgrouped by category, each with this vehicle's latest recorded result and a\n3\trelevance ranking against its open codes and its job's open hypotheses.\n4\t\n5\tSame posture as :mod:`cuore.services.liveboard_bridge`: one bridge module,\n6\tread-mostly, the single place ``cuore`` touches :mod:`mes.mechanic_tests` and\n7\t:mod:`mes.jobs` for this feature. Results are written through the existing\n8\tchecklist result store (:mod:`cuore.live.checklists`), keyed\n9\t``step_id = \"test:<test_id>\"`` so they already flow into the job's\n10\thypothesis evidence path the same way a job-page test row does (see\n11\t:mod:`cuore.api.checklists`'s own ``/result`` route, and\n12\t:func:`cuore.services.jobs_bridge.add_test_evidence`) -- :mod:`cuore.api.tests`\n13\tcalls that same function, never a second copy of the auto-attach logic.\n14\t\n15\tNothing here writes to the car. ``bench_bridge.build_bench`` is read for its\n16\t``fuel_gate`` only, to flag the EVAP fuel-level verification window on the\n17\ttests it actually affects (the ESIM/EVAP monitor-verification family) --\n18\tsame blocker the bench page itself already shows.\n19\t\"\"\"\n20\t\n21\tfrom __future__ import annotations\n22\t\n23\tfrom typing import Any, Optional\n24\t\n25\tfrom .. import bootstrap  # noqa: F401  -- side effect: puts `mes` on sys.path\n26\tfrom ..live import checklists as checklist_store\n27\tfrom . import cache, mes_bridge\n28\tfrom .errors import BadRequest\n29\t\n30\tfrom mes import mechanic_tests  # noqa: E402\n31\t\n32\ttry:\n33\t    from mes import jobs as jobs_mod  # noqa: E402\n34\texcept Exception:  # noqa: BLE001 -- the tests page must still render\n35\t    jobs_mod = None\n36\t\n37\ttry:\n38\t    from . import bench_bridge\n39\texcept Exception:  # noqa: BLE001 -- blocker awareness is a nice-to-have\n40\t    bench_bridge = None\n41\t\n42\t#: Step-id prefix for a test result in the checklist store -- see module\n43\t#: docstring. Every write/read against ``checklist_store`` for this feature\n44\t#: goes through :func:`_step_id`, never a hand-built string.\n45\t_STEP_PREFIX = \"test:\"\n46\t\n47\t#: The family this catalogue's EVAP tests (``evap_smoke``, ``esim_vacuum_test_a``,\n48\t#: ``purge_vent_actuation``) share with the bench's own fuel-window blocker --\n49\t#: shown as a caution on these specific tests, not a generic banner on every\n50\t#: test.\n51\t_EVAP_MONITOR_TEST_IDS = (\"evap_smoke\", \"esim_vacuum_test_a\", \"purge_vent_actuation\")\n52\t\n53\tRESULT_COUNT_KEYS = (\"pass\", \"fail\", \"inconclusive\", \"not_possible\", \"not_done\")\n54\t\n55\t\n56\tdef step_id(test_id: str) -> str:\n57\t    return f\"{_STEP_PREFIX}{test_id}\"\n58\t\n59\t\n60\tdef test_id_from_step(step: str) -> Optional[str]:\n61\t    \"\"\"The test id a ``\"test:<id>\"`` step id names, or ``None`` if ``step``\n62\t    is not one of this feature's step ids.\"\"\"\n63\t    if not step.startswith(_STEP_PREFIX):\n64\t        return None\n65\t    return step[len(_STEP_PREFIX):]\n66\t\n67\t\n68\tdef _cached_dossier(vin: str) -> dict[str, Any]:\n69\t    mtime = mes_bridge.newest_mtime(vin)\n70\t    return cache.get_or_build((\"workup\", vin, mtime), lambda: mes_bridge.workup(vin=vin))\n71\t\n72\t\n73\tdef _open_codes(vin: str, dossier: dict[str, Any]) -> list[str]:\n74\t    try:\n75\t        return mes_bridge.open_codes_for(dossier)\n76\t    except Exception:  # noqa: BLE001 -- relevance ranking is best-effort\n77\t        return []\n78\t\n79\t\n80\tdef _open_hypotheses(vin: str) -> list[dict[str, Any]]:\n81\t    if jobs_mod is None:\n82\t        return []\n83\t    try:\n84\t        job = jobs_mod.current(vin)\n85\t    except Exception:  # noqa: BLE001\n86\t        return []\n87\t    if job is None:\n88\t        return []\n89\t    return [h for h in job.get(\"hypotheses\", [])\n90\t           if h.get(\"status\") == \"open\" and not h.get(\"deleted\")]\n91\t\n92\t\n93\tdef open_hypotheses_for_form(vin: str) -> list[dict[str, Any]]:\n94\t    \"\"\"``{id, text, system}`` for every open hypothesis on this VIN's\n95\t    current job -- the select list the result form offers.\"\"\"\n96\t    return [{\"id\": h[\"id\"], \"text\": h.get(\"text\") or \"\", \"system\": h.get(\"system\") or \"\"}\n97\t           for h in _open_hypotheses(vin)]\n98\t\n99\t\n100\tdef _fuel_gate(vin: str) -> dict[str, Any]:\n101\t    if bench_bridge is None:\n102\t        return {}\n103\t    try:\n104\t        return bench_bridge.build_bench(vin).get(\"fuel_gate\") or {}\n105\t    except Exception:  # noqa: BLE001 -- blocker awareness must never 500 the page\n106\t        return {}\n107\t\n108\t\n109\tdef _from_car(vin: str, dossier: dict[str, Any]) -> dict[str, Any] | None:\n110\t    \"\"\"A read-only \"From the car\" strip: this vehicle's latest from-car\n111\t    Mode $06 read, if any. Never marks any catalogue test's own row --\n112\t    see the module docstring's cross-reference to the job-page evidence\n113\t    path, which is the only thing allowed to do that.\"\"\"\n114\t    try:\n115\t        from . import dossier_bridge\n116\t        return dossier_bridge.build_view(vin, dossier, None).get(\"mode06\")\n117\t    except Exception:  # noqa: BLE001 -- the strip is a nice-to-have\n118\t        return None\n119\t\n120\t\n121\tdef _result_entry(vin: str, test_id: str) -> dict[str, Any]:\n122\t    entry = checklist_store.get(vin).get(step_id(test_id)) or {}\n123\t    result = entry.get(\"result\")\n124\t    return {\n125\t        \"result\": result or \"not_done\",\n126\t        \"value\": entry.get(\"value\"),\n127\t        \"unit\": entry.get(\"unit\") or \"\",\n128\t        \"reason\": entry.get(\"reason\") or \"\",\n129\t        \"hypothesis_id\": entry.get(\"hypothesis_id\"),\n130\t        \"when\": entry.get(\"done_at\"),\n131\t        \"by\": entry.get(\"done_by\") or \"\",\n132\t        \"media_ids\": entry.get(\"media_ids\") or [],\n133\t    }\n134\t\n135\t\n136\tdef _base_code(code: str) -> str:\n137\t    code = (code or \"\").strip().upper()\n138\t    return code[:5] if len(code) >= 5 else code\n139\t\n140\t\n141\tdef _why_for(t: dict[str, Any], open_codes: list[str],\n142\t            open_hyps: list[dict[str, Any]]) -> list[str]:\n143\t    why: list[str] = []\n144\t    bases = [_base_code(c) for c in open_codes if c]\n145\t    for rel in t[\"related_codes\"]:\n146\t        rel_u = rel.strip().upper()\n147\t        matched = sorted({c for c, b in zip(open_codes, bases) if b.startswith(rel_u)})\n148\t        if matched:\n149\t            why.append(f\"open code {', '.join(matched)}\")\n150\t    for h in open_hyps:\n151\t        if (h.get(\"system\") or \"\").strip().lower() in t[\"systems\"]:\n152\t            why.append(f\"open hypothesis: {h.get('text') or h['id']}\")\n153\t    return why\n154\t\n155\t\n156\tdef build_tests_view(vin: str) -> dict[str, Any]:\n157\t    \"\"\"Everything ``tests.html`` needs: the full catalogue, each test's\n158\t    latest result, relevance ranking, and category/summary counts.\"\"\"\n159\t    vin = (vin or \"\").strip()\n160\t    if not vin:\n161\t        raise BadRequest(\"a VIN is required\")\n162\t\n163\t    dossier = _cached_dossier(vin)\n164\t    open_codes = _open_codes(vin, dossier)\n165\t    open_hyps = _open_hypotheses(vin)\n166\t    fuel_gate = _fuel_gate(vin)\n167\t    fuel_blocked = fuel_gate.get(\"in_window\") is False\n168\t\n169\t    # Marque-filtered catalogue (MECHANIC_REVIEW_4/check_marque_port.py):\n170\t    # a test whose own applies_to rules out this vehicle's marque (e.g. the\n171\t    # Stelvio-specific wiTECH/ESIM-bench tests, which name the real Stelvio\n172\t    # VIN in their sourced pass_criteria text) must never render on another\n173\t    # marque's Tests page. mechanic_tests.all_tests() is the unfiltered\n174\t    # catalogue; tests_for_marque() is the one this page actually shows.\n175\t    catalogue = mechanic_tests.tests_for_marque(mes_bridge.marque_for_vin(vin))\n176\t\n177\t    code_test_ids = {t[\"id\"] for t in mechanic_tests.tests_for_codes(open_codes)}\n178\t    hyp_systems = [h.get(\"system\") or \"\" for h in open_hyps if h.get(\"system\")]\n179\t    sys_test_ids = {t[\"id\"] for t in mechanic_tests.tests_for_systems(hyp_systems)} if hyp_systems else set()\n180\t    recommended_ids = code_test_ids | sys_test_ids\n181\t\n182\t    rows: list[dict[str, Any]] = []\n183\t    counts = {k: 0 for k in RESULT_COUNT_KEYS}\n184\t    for t in catalogue:\n185\t        rid = t[\"id\"]\n186\t        latest = _result_entry(vin, rid)\n187\t        counts[latest[\"result\"]] = counts.get(latest[\"result\"], 0) + 1\n188\t        blocker = None\n189\t        if fuel_blocked and rid in _EVAP_MONITOR_TEST_IDS:\n190\t            blocker = {\n191\t                \"reason\": \"fuel out of window\",\n192\t                \"window\": fuel_gate.get(\"window\"),\n193\t                \"level\": fuel_gate.get(\"level\"),\n194\t                \"direction\": fuel_gate.get(\"direction\"),\n195\t            }\n196\t        rows.append({\n197\t            **t,\n198\t            \"step_id\": step_id(rid),\n199\t            \"latest_result\": latest,\n200\t            \"recommended\": rid in recommended_ids,\n201\t            \"why\": _why_for(t, open_codes, open_hyps) if rid in recommended_ids else [],\n202\t            \"blocker\": blocker,\n203\t        })\n204\t\n205\t    rows.sort(key=lambda r: (0 if r[\"recommended\"] else 1, r[\"category\"], r[\"name\"]))\n206\t    categories = sorted({t[\"category\"] for t in catalogue})\n207\t\n208\t    return {\n209\t        \"vin\": vin,\n210\t        \"tests\": rows,\n211\t        \"categories\": categories,\n212\t        \"counts\": counts,\n213\t        \"total\": len(rows),\n214\t        \"open_codes\": open_codes,\n215\t        \"open_hypotheses\": open_hypotheses_for_form(vin),\n216\t        \"fuel_gate\": fuel_gate,\n217\t        \"from_car\": _from_car(vin, dossier),\n218\t    }\n219\t\n220\t\n221\tdef record_result(vin: str, test_id: str, result: Optional[str], *, reason: str = \"\",\n222\t                  value: Optional[float] = None, unit: str = \"\",\n223\t                  hypothesis_id: Optional[str] = None, supports: str = \"for\",\n224\t                  by: str = \"\") -> dict[str, Any]:\n225\t    \"\"\"Store one test's result and, when it names a hypothesis and the\n226\t    result is pass/fail, auto-attach it as evidence -- the same contract\n227\t    ``cuore.api.checklists``'s ``/result`` route already uses\n228\t    (:func:`cuore.services.jobs_bridge.add_test_evidence`), reused here\n229\t    rather than duplicated. ``supports`` is \"for\"/\"against\", exactly as\n230\t    that route's own field -- the caller (the result form) decides which\n231\t    side of the hypothesis this result counts toward; a plain pass/fail is\n232\t    not itself for/against any particular hypothesis without the tech\n233\t    saying so.\"\"\"\n234\t    if mechanic_tests.test(test_id) is None:\n235\t        raise BadRequest(f\"unknown test id {test_id!r}\")\n236\t    if result is not None and result not in mechanic_tests.POSTABLE_RESULTS:\n237\t        raise BadRequest(\"result must be one of: \"\n238\t                         + \", \".join(mechanic_tests.POSTABLE_RESULTS) + \", or null\")\n239\t    if supports not in (\"for\", \"against\"):\n240\t        raise BadRequest(\"supports must be 'for' or 'against'\")\n241\t    sid = step_id(test_id)\n242\t    entry = checklist_store.set_result(vin, sid, result, reason=reason, value=value,\n243\t                                       unit=unit, hypothesis_id=hypothesis_id, by=by)\n244\t    if hypothesis_id and result in (\"pass\", \"fail\"):\n245\t        t = mechanic_tests.test(test_id)\n246\t        label = f\"{t['name']}: {result}\"\n247\t        if value is not None:\n248\t            label += f\" {value:g}{unit}\"\n249\t        try:\n250\t            from . import jobs_bridge\n251\t            jobs_bridge.add_test_evidence(vin, hypothesis_id, sid, label, result,\n252\t                                          supports=supports, by=by)\n253\t        except Exception:  # noqa: BLE001 -- the result must still save\n254\t            pass\n255\t    return {\"vin\": vin, \"test_id\": test_id, \"step_id\": sid, **entry}\n256\t\n257\t\n258\t__all__ = [\"build_tests_view\", \"record_result\", \"step_id\", \"test_id_from_step\",\n259\t          \"open_hypotheses_for_form\", \"RESULT_COUNT_KEYS\"]\n260\t"}]},"uuid":"a1cf6242-926a-466d-a9c3-a8373b2b77f8","timestamp":"2026-10-14T05:30:13.407Z","toolUseResult":{"type":"text","file":{"filePath":"C:\\Users\\User\\mcp-servers\\cuore\\services\\tests_bridge.py","content":"\"\"\"The Tests surface: a catalogue of every mechanic test (:mod:`mes.mechanic_tests`)\ngrouped by category, each with this vehicle's latest recorded result and a\nrelevance ranking against its open codes and its job's open hypotheses.\n\nSame posture as :mod:`cuore.services.liveboard_bridge`: one bridge module,\nread-mostly, the single place ``cuore`` touches :mod:`mes.mechanic_tests` and\n:mod:`mes.jobs` for this feature. Results are written through the existing\nchecklist result store (:mod:`cuore.live.checklists`), keyed\n``step_id = \"test:<test_id>\"`` so they already flow into the job's\nhypothesis evidence path the same way a job-page test row does (see\n:mod:`cuore.api.checklists`'s own ``/result`` route, and\n:func:`cuore.services.jobs_bridge.add_test_evidence`) -- :mod:`cuore.api.tests`\ncalls that same function, never a second copy of the auto-attach logic.\n\nNothing here writes to the car. ``bench_bridge.build_bench`` is read for its\n``fuel_gate`` only, to flag the EVAP fuel-level verification window on the\ntests it actually affects (the ESIM/EVAP monitor-verification family) --\nsame blocker the bench page itself already shows.\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom typing import Any, Optional\n\nfrom .. import bootstrap  # noqa: F401  -- side effect: puts `mes` on sys.path\nfrom ..live import checklists as checklist_store\nfrom . import cache, mes_bridge\nfrom .errors import BadRequest\n\nfrom mes import mechanic_tests  # noqa: E402\n\ntry:\n    from mes import jobs as jobs_mod  # noqa: E402\nexcept Exception:  # noqa: BLE001 -- the tests page must still render\n    jobs_mod = None\n\ntry:\n    from . import bench_bridge\nexcept Exception:  # noqa: BLE001 -- blocker awareness is a nice-to-have\n    bench_bridge = None\n\n#: Step-id prefix for a test result in the checklist store -- see module\n#: docstring. Every write/read against ``checklist_store`` for this feature\n#: goes through :func:`_step_id`, never a hand-built string.\n_STEP_PREFIX = \"test:\"\n\n#: The family this catalogue's EVAP tests (``evap_smoke``, ``esim_vacuum_test_a``,\n#: ``purge_vent_actuation``) share with the bench's own fuel-window blocker --\n#: shown as a caution on these specific tests, not a generic banner on every\n#: test.\n_EVAP_MONITOR_TEST_IDS = (\"evap_smoke\", \"esim_vacuum_test_a\", \"purge_vent_actuation\")\n\nRESULT_COUNT_KEYS = (\"pass\", \"fail\", \"inconclusive\", \"not_possible\", \"not_done\")\n\n\ndef step_id(test_id: str) -> str:\n    return f\"{_STEP_PREFIX}{test_id}\"\n\n\ndef test_id_from_step(step: str) -> Optional[str]:\n    \"\"\"The test id a ``\"test:<id>\"`` step id names, or ``None`` if ``step``\n    is not one of this feature's step ids.\"\"\"\n    if not step.startswith(_STEP_PREFIX):\n        return None\n    return step[len(_STEP_PREFIX):]\n\n\ndef _cached_dossier(vin: str) -> dict[str, Any]:\n    mtime = mes_bridge.newest_mtime(vin)\n    return cache.get_or_build((\"workup\", vin, mtime), lambda: mes_bridge.workup(vin=vin))\n\n\ndef _open_codes(vin: str, dossier: dict[str, Any]) -> list[str]:\n    try:\n        return mes_bridge.open_codes_for(dossier)\n    except Exception:  # noqa: BLE001 -- relevance ranking is best-effort\n        return []\n\n\ndef _open_hypotheses(vin: str) -> list[dict[str, Any]]:\n    if jobs_mod is None:\n        return []\n    try:\n        job = jobs_mod.current(vin)\n    except Exception:  # noqa: BLE001\n        return []\n    if job is None:\n        return []\n    return [h for h in job.get(\"hypotheses\", [])\n           if h.get(\"status\") == \"open\" and not h.get(\"deleted\")]\n\n\ndef open_hypotheses_for_form(vin: str) -> list[dict[str, Any]]:\n    \"\"\"``{id, text, system}`` for every open hypothesis on this VIN's\n    current job -- the select list the result form offers.\"\"\"\n    return [{\"id\": h[\"id\"], \"text\": h.get(\"text\") or \"\", \"system\": h.get(\"system\") or \"\"}\n           for h in _open_hypotheses(vin)]\n\n\ndef _fuel_gate(vin: str) -> dict[str, Any]:\n    if bench_bridge is None:\n        return {}\n    try:\n        return bench_bridge.build_bench(vin).get(\"fuel_gate\") or {}\n    except Exception:  # noqa: BLE001 -- blocker awareness must never 500 the page\n        return {}\n\n\ndef _from_car(vin: str, dossier: dict[str, Any]) -> dict[str, Any] | None:\n    \"\"\"A read-only \"From the car\" strip: this vehicle's latest from-car\n    Mode $06 read, if any. Never marks any catalogue test's own row --\n    see the module docstring's cross-reference to the job-page evidence\n    path, which is the only thing allowed to do that.\"\"\"\n    try:\n        from . import dossier_bridge\n        return dossier_bridge.build_view(vin, dossier, None).get(\"mode06\")\n    except Exception:  # noqa: BLE001 -- the strip is a nice-to-have\n        return None\n\n\ndef _result_entry(vin: str, test_id: str) -> dict[str, Any]:\n    entry = checklist_store.get(vin).get(step_id(test_id)) or {}\n    result = entry.get(\"result\")\n    return {\n        \"result\": result or \"not_done\",\n        \"value\": entry.get(\"value\"),\n        \"unit\": entry.get(\"unit\") or \"\",\n        \"reason\": entry.get(\"reason\") or \"\",\n        \"hypothesis_id\": entry.get(\"hypothesis_id\"),\n        \"when\": entry.get(\"done_at\"),\n        \"by\": entry.get(\"done_by\") or \"\",\n        \"media_ids\": entry.get(\"media_ids\") or [],\n    }\n\n\ndef _base_code(code: str) -> str:\n    code = (code or \"\").strip().upper()\n    return code[:5] if len(code) >= 5 else code\n\n\ndef _why_for(t: dict[str, Any], open_codes: list[str],\n            open_hyps: list[dict[str, Any]]) -> list[str]:\n    why: list[str] = []\n    bases = [_base_code(c) for c in open_codes if c]\n    for rel in t[\"related_codes\"]:\n        rel_u = rel.strip().upper()\n        matched = sorted({c for c, b in zip(open_codes, bases) if b.startswith(rel_u)})\n        if matched:\n            why.append(f\"open code {', '.join(matched)}\")\n    for h in open_hyps:\n        if (h.get(\"system\") or \"\").strip().lower() in t[\"systems\"]:\n            why.append(f\"open hypothesis: {h.get('text') or h['id']}\")\n    return why\n\n\ndef build_tests_view(vin: str) -> dict[str, Any]:\n    \"\"\"Everything ``tests.html`` needs: the full catalogue, each test's\n    latest result, relevance ranking, and category/summary counts.\"\"\"\n    vin = (vin or \"\").strip()\n    if not vin:\n        raise BadRequest(\"a VIN is required\")\n\n    dossier = _cached_dossier(vin)\n    open_codes = _open_codes(vin, dossier)\n    open_hyps = _open_hypotheses(vin)\n    fuel_gate = _fuel_gate(vin)\n    fuel_blocked = fuel_gate.get(\"in_window\") is False\n\n    # Marque-filtered catalogue (MECHANIC_REVIEW_4/check_marque_port.py):\n    # a test whose own applies_to rules out this vehicle's marque (e.g. the\n    # Stelvio-specific wiTECH/ESIM-bench tests, which name the real Stelvio\n    # VIN in their sourced pass_criteria text) must never render on another\n    # marque's Tests page. mechanic_tests.all_tests() is the unfiltered\n    # catalogue; tests_for_marque() is the one this page actually shows.\n    catalogue = mechanic_tests.tests_for_marque(mes_bridge.marque_for_vin(vin))\n\n    code_test_ids = {t[\"id\"] for t in mechanic_tests.tests_for_codes(open_codes)}\n    hyp_systems = [h.get(\"system\") or \"\" for h in open_hyps if h.get(\"system\")]\n    sys_test_ids = {t[\"id\"] for t in mechanic_tests.tests_for_systems(hyp_systems)} if hyp_systems else set()\n    recommended_ids = code_test_ids | sys_test_ids\n\n    rows: list[dict[str, Any]] = []\n    counts = {k: 0 for k in RESULT_COUNT_KEYS}\n    for t in catalogue:\n        rid = t[\"id\"]\n        latest = _result_entry(vin, rid)\n        counts[latest[\"result\"]] = counts.get(latest[\"result\"], 0) + 1\n        blocker = None\n        if fuel_blocked and rid in _EVAP_MONITOR_TEST_IDS:\n            blocker = {\n                \"reason\": \"fuel out of window\",\n                \"window\": fuel_gate.get(\"window\"),\n                \"level\": fuel_gate.get(\"level\"),\n                \"direction\": fuel_gate.get(\"direction\"),\n            }\n        rows.append({\n            **t,\n            \"step_id\": step_id(rid),\n            \"latest_result\": latest,\n            \"recommended\": rid in recommended_ids,\n            \"why\": _why_for(t, open_codes, open_hyps) if rid in recommended_ids else [],\n            \"blocker\": blocker,\n        })\n\n    rows.sort(key=lambda r: (0 if r[\"recommended\"] else 1, r[\"category\"], r[\"name\"]))\n    categories = sorted({t[\"category\"] for t in catalogue})\n\n    return {\n        \"vin\": vin,\n        \"tests\": rows,\n        \"categories\": categories,\n        \"counts\": counts,\n        \"total\": len(rows),\n        \"open_codes\": open_codes,\n        \"open_hypotheses\": open_hypotheses_for_form(vin),\n        \"fuel_gate\": fuel_gate,\n        \"from_car\": _from_car(vin, dossier),\n    }\n\n\ndef record_result(vin: str, test_id: str, result: Optional[str], *, reason: str = \"\",\n                  value: Optional[float] = None, unit: str = \"\",\n                  hypothesis_id: Optional[str] = None, supports: str = \"for\",\n                  by: str = \"\") -> dict[str, Any]:\n    \"\"\"Store one test's result and, when it names a hypothesis and the\n    result is pass/fail, auto-attach it as evidence -- the same contract\n    ``cuore.api.checklists``'s ``/result`` route already uses\n    (:func:`cuore.services.jobs_bridge.add_test_evidence`), reused here\n    rather than duplicated. ``supports`` is \"for\"/\"against\", exactly as\n    that route's own field -- the caller (the result form) decides which\n    side of the hypothesis this result counts toward; a plain pass/fail is\n    not itself for/against any particular hypothesis without the tech\n    saying so.\"\"\"\n    if mechanic_tests.test(test_id) is None:\n        raise BadRequest(f\"unknown test id {test_id!r}\")\n    if result is not None and result not in mechanic_tests.POSTABLE_RESULTS:\n        raise BadRequest(\"result must be one of: \"\n                         + \", \".join(mechanic_tests.POSTABLE_RESULTS) + \", or null\")\n    if supports not in (\"for\", \"against\"):\n        raise BadRequest(\"supports must be 'for' or 'against'\")\n    sid = step_id(test_id)\n    entry = checklist_store.set_result(vin, sid, result, reason=reason, value=value,\n                                       unit=unit, hypothesis_id=hypothesis_id, by=by)\n    if hypothesis_id and result in (\"pass\", \"fail\"):\n        t = mechanic_tests.test(test_id)\n        label = f\"{t['name']}: {result}\"\n        if value is not None:\n            label += f\" {value:g}{unit}\"\n        try:\n            from . import jobs_bridge\n            jobs_bridge.add_test_evidence(vin, hypothesis_id, sid, label, result,\n                                          supports=supports, by=by)\n        except Exception:  # noqa: BLE001 -- the result must still save\n            pass\n    return {\"vin\": vin, \"test_id\": test_id, \"step_id\": sid, **entry}\n\n\n__all__ = [\"build_tests_view\", \"record_result\", \"step_id\", \"test_id_from_step\",\n          \"open_hypotheses_for_form\", \"RESULT_COUNT_KEYS\"]\n","numLines":260,"startLine":1,"totalLines":260}},"sourceToolAssistantUUID":"469e0670-5cc4-4fda-b44a-1c2692239347","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
{"parentUuid":"a1cf6242-926a-466d-a9c3-a8373b2b77f8","isSidechain":true,"agentId":"af0587f74b82ee0e0","message":{"model":"claude-sonnet-5","id":"msg_011Cg1aaMxvaW4nWcHt3W9dH","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_011mmLtq7rBeTLq4uQA2SKLV","name":"Read","input":{"file_path":"C:\\Users\\User\\mcp-servers\\mes-log-mcp\\mes\\mechanic_tests.py"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":6736,"cache_read_input_tokens":57204,"cache_creation":{"ephemeral_5m_input_tokens":6736,"ephemeral_1h_input_tokens":0},"output_tokens":4,"service_tier":"standard","inference_geo":"global"},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_011mmLtq7rBeTLq4uQA2SKLV":{"file_path":"C:\\Users\\User\\mcp-servers\\mes-log-mcp\\mes\\mechanic_tests.py"}},"serverClassifierRequest":"3acc524c-02db-44b3-8971-41c863f858b6","apiBlockIndex":2,"requestId":"req_011Cg1aaMcqhCU5ZYVn6U9s6","attributionAgent":"general-purpose","type":"assistant","uuid":"dbf50f86-3afb-4210-9873-e941b6452440","timestamp":"2026-10-14T05:30:13.920Z","effort":"high","perTurnEffort":null,"userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
{"parentUuid":"dbf50f86-3afb-4210-9873-e941b6452440","isSidechain":true,"promptId":"18814b70-8b7e-4c43-946c-5c9dac496990","agentId":"af0587f74b82ee0e0","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_011mmLtq7rBeTLq4uQA2SKLV","type":"tool_result","content":"1\t\"\"\"Mechanic test catalogue: every shop-floor diagnostic test that applies to\n2\tthe 2018 Alfa Romeo Stelvio 2.0T GME (Giorgio platform), cross-marked for\n3\tthe Giulia 2.0T (same engine/platform family) and the Maserati Grecale 2.0T\n4\t(Giorgio-derived platform, same Stellantis GME-T4 engine family).\n5\t\n6\tSame house rules as :mod:`mes.known_good` / :mod:`mes.systems`: nothing in\n7\there is invented. Every ``pass_criteria`` row carries a ``source`` and a\n8\t``confidence`` --\n9\t\n10\t* ``CONFIRMED``     -- stated in a manufacturer document (FCA/Stellantis\n11\t                       TechAuthority, DOT/FMVSS regulatory standard).\n12\t* ``CORROBORATED``  -- two independent sources agree, or lifted straight\n13\t                       from a ``mes.known_good`` row already carrying that\n14\t                       confidence for this exact channel.\n15\t* ``SINGLE-SOURCE``  -- one source, including a generic/industry-practice\n16\t                       rule of thumb used as an explicit, named fallback\n17\t                       (never confused with a manufacturer figure).\n18\t* ``UNKNOWN``       -- no sourced number exists; the car's own service\n19\t                       manual / TechAuthority is pointed to instead, and\n20\t                       ``spec`` is prose (\"see service manual\"), never a\n21\t                       guessed number. A numeric ``spec`` is never paired\n22\t                       with ``UNKNOWN`` -- enforced at load time below.\n23\t\n24\tFour read-only lookups, the whole public surface:\n25\t\n26\t* :func:`all_tests`        -- every test, as a list.\n27\t* :func:`test`              -- one test by id, or ``None``.\n28\t* :func:`tests_for_codes`   -- tests whose ``related_codes`` match any of\n29\t                               the given DTCs (prefix match, e.g. \"P0455\"\n30\t                               matches a related_codes entry \"P04\").\n31\t* :func:`tests_for_systems` -- tests touching any of the given\n32\t                               :mod:`mes.systems` system ids.\n33\t\n34\tResearch pass done 2026-10-08, same posture as ``known_good.py``'s own\n35\tresearch-pass note: public sources (OBD-II/repair-reference sites, DOT/SAE\n36\tstandards, this repo's own ``mes.known_good``/``mes.systems`` sourced rows)\n37\tplus explicit, named industry-practice rules of thumb where no\n38\tmanufacturer figure exists. No paywalled/bot-gated FCA TechAuthority\n39\tdocument was read for this pass -- every TechAuthority pointer below is a\n40\t\"go get it\", never a claim that document was read.\n41\t\"\"\"\n42\t\n43\tfrom __future__ import annotations\n44\t\n45\tfrom typing import Any, Optional\n46\t\n47\tfrom .systems import CONFIDENCE_LEVELS, CONFIRMED, CORROBORATED, SINGLE_SOURCE, UNKNOWN\n48\tfrom .systems import SYSTEMS\n49\t\n50\t#: Same wording as the rest of this package's UNKNOWN notes.\n51\tTECHAUTHORITY = \"use the service manual, TechAuthority\"\n52\t\n53\t#: Generic/industry-practice rule-of-thumb source label, named explicitly\n54\t#: per instruction -- never confused with a model-specific or\n55\t#: manufacturer-sourced figure.\n56\tINDUSTRY_PRACTICE = \"industry practice\"\n57\t\n58\tCAR_STATES = (\"KOEO\", \"KOER\", \"cold\", \"hot\", \"driving\", \"key-off\")\n59\t\n60\t#: ``not_done`` is a display-only state (no result recorded yet) -- never a\n61\t#: value a caller posts. :data:`POSTABLE_RESULTS` is what a result-recording\n62\t#: call should validate against.\n63\tRESULTS = (\"pass\", \"fail\", \"inconclusive\", \"not_possible\", \"not_done\")\n64\tPOSTABLE_RESULTS = (\"pass\", \"fail\", \"inconclusive\", \"not_possible\")\n65\t\n66\tCATEGORIES = (\n67\t    \"emissions\", \"intake_boost\", \"cooling\", \"fuel\", \"lubrication\",\n68\t    \"leak_detection\", \"mechanical_engine\", \"ignition\", \"electrical\",\n69\t    \"network\", \"brakes\", \"driveline\", \"exhaust\", \"inspection\",\n70\t)\n71\t\n72\t#: Models this catalogue cross-marks, beyond the Stelvio 2018 2.0T this\n73\t#: catalogue is built for -- every test defaults ``True`` for the Stelvio\n74\t#: (the catalogue's whole reason to exist) and is marked per-test for the\n75\t#: other two.\n76\t_MODELS = (\"stelvio_2.0t_2018\", \"giulia_2.0t\", \"grecale_2.0t\")\n77\t\n78\tTESTS: dict[str, dict[str, Any]] = {}\n79\t\n80\t_ORDER: list[str] = []\n81\t\n82\t\n83\tdef _applies(giulia: bool = True, grecale: bool = True) -> dict[str, bool]:\n84\t    \"\"\"``stelvio_2.0t_2018`` is always ``True`` -- this whole catalogue is\n85\t    built for that car. ``giulia``/``grecale`` default ``True`` (same\n86\t    engine family / Giorgio-derived platform) and are set ``False`` on the\n87\t    few tests that are genuinely Stelvio/FCA-procedure-specific.\"\"\"\n88\t    return {\"stelvio_2.0t_2018\": True, \"giulia_2.0t\": giulia, \"grecale_2.0t\": grecale}\n89\t\n90\t\n91\tdef _pc(parameter: str, spec: Any, unit: str, source: str, confidence: str) -> dict[str, Any]:\n92\t    if confidence not in CONFIDENCE_LEVELS:\n93\t        raise ValueError(f\"bad confidence {confidence!r} for pass_criteria {parameter!r}\")\n94\t    if confidence == UNKNOWN and isinstance(spec, (int, float)):\n95\t        raise ValueError(f\"pass_criteria {parameter!r} has a numeric spec with UNKNOWN \"\n96\t                         \"confidence -- never invent a number\")\n97\t    return {\"parameter\": parameter, \"spec\": spec, \"unit\": unit,\n98\t           \"source\": source, \"confidence\": confidence}\n99\t\n100\t\n101\tdef _t(id_: str, name: str, category: str, systems: list[str], applies_to: dict[str, bool],\n102\t      purpose: str, car_state: str, when_to_use: str, tools: list[str],\n103\t      procedure: list[str], pass_criteria: list[dict[str, Any]], fail_means: str,\n104\t      related_codes: list[str], supports_hypotheses: list[str],\n105\t      refutes_hypotheses: list[str], duration_min: int, safety: str = \"\",\n106\t      hazards: Optional[list[str]] = None) -> None:\n107\t    if id_ in TESTS:\n108\t        raise ValueError(f\"duplicate test id {id_!r}\")\n109\t    if category not in CATEGORIES:\n110\t        raise ValueError(f\"bad category {category!r} for {id_!r}\")\n111\t    for s in systems:\n112\t        if s not in SYSTEMS:\n113\t            raise ValueError(f\"unknown system {s!r} for test {id_!r}\")\n114\t    if car_state not in CAR_STATES:\n115\t        raise ValueError(f\"bad car_state {car_state!r} for {id_!r}\")\n116\t    for key in applies_to:\n117\t        if key not in _MODELS:\n118\t            raise ValueError(f\"unknown model {key!r} in applies_to for {id_!r}\")\n119\t    TESTS[id_] = {\n120\t        \"id\": id_, \"name\": name, \"category\": category, \"systems\": list(systems),\n121\t        \"applies_to\": dict(applies_to), \"purpose\": purpose, \"car_state\": car_state,\n122\t        \"when_to_use\": when_to_use, \"tools\": list(tools), \"procedure\": list(procedure),\n123\t        \"pass_criteria\": list(pass_criteria), \"fail_means\": fail_means,\n124\t        \"related_codes\": list(related_codes), \"supports_hypotheses\": list(supports_hypotheses),\n125\t        \"refutes_hypotheses\": list(refutes_hypotheses), \"duration_min\": duration_min,\n126\t        \"safety\": safety, \"hazards\": list(hazards or []),\n127\t    }\n128\t    _ORDER.append(id_)\n129\t\n130\t\n131\t# ===========================================================================\n132\t# Emissions / EVAP\n133\t# ===========================================================================\n134\t\n135\t_t(\"evap_smoke\", \"EVAP smoke test\", \"emissions\", [\"evap\"], _applies(),\n136\t  purpose=\"Find a leak in the fuel vapor system by filling it with visible/UV smoke \"\n137\t          \"under gentle pressure and watching for where it escapes.\",\n138\t  car_state=\"key-off\",\n139\t  when_to_use=\"P0442/P0455/P0456 or any EVAP small/large leak code, before replacing \"\n140\t              \"any EVAP part on a guess.\",\n141\t  tools=[\"smoke machine\", \"EVAP service port adapter or purge line disconnect\",\n142\t        \"UV light (if using UV dye smoke)\", \"shop light / mirror\"],\n143\t  procedure=[\n144\t      \"Confirm fuel level is in the 15-85% window (vapor space needed to see smoke).\",\n145\t      \"Connect smoke machine to the EVAP system (purge line or service port), low \"\n146\t      \"pressure (~0.5-1 psi / per machine instructions).\",\n147\t      \"Cap the system and let smoke fill for 1-2 minutes.\",\n148\t      \"Inspect gas cap, filler neck, fuel tank seams, EVAP canister, purge/vent valve \"\n149\t      \"connections and hoses for escaping smoke.\",\n150\t      \"Note exact leak location(s); photograph for the job file.\",\n151\t  ],\n152\t  pass_criteria=[_pc(\"visible leak\", \"none found\", \"\", TECHAUTHORITY, UNKNOWN)],\n153\t  fail_means=\"A located, visible leak point identifies the failed component directly \"\n154\t             \"-- no further guessing needed for that leak.\",\n155\t  related_codes=[\"P0442\", \"P0455\", \"P0456\", \"P0457\"],\n156\t  supports_hypotheses=[\"EVAP leak\"], refutes_hypotheses=[\"EVAP leak\"],\n157\t  duration_min=20, safety=\"Use smoke machine per its own manual; do not exceed its \"\n158\t                          \"rated pressure -- EVAP components are not designed for \"\n159\t                          \"boost-level pressure.\",\n160\t  hazards=[\"fuel vapor\"])\n161\t\n162\t_t(\"intake_boost_smoke_leak\", \"Intake/boost leak smoke test\", \"intake_boost\",\n163\t  [\"air_intake_boost\"], _applies(),\n164\t  purpose=\"Find an air leak between the throttle body/MAF and the turbo/intercooler \"\n165\t          \"piping using smoke under light vacuum or low pressure.\",\n166\t  car_state=\"key-off\",\n167\t  when_to_use=\"Rough idle, lean fuel trims, boost-related codes, or a whistle/hiss \"\n168\t              \"under load.\",\n169\t  tools=[\"smoke machine\", \"intake blanking plate or adapter\"],\n170\t  procedure=[\n171\t      \"Block the intake tract at the throttle body (or feed smoke in through a vacuum \"\n172\t      \"port with the engine off).\",\n173\t      \"Fill the tract with smoke at low pressure.\",\n174\t      \"Inspect every clamp, boot, intercooler seam and sensor o-ring for escaping smoke.\",\n175\t      \"Note exact leak location(s).\",\n176\t  ],\n177\t  pass_criteria=[_pc(\"visible leak\", \"none found\", \"\", TECHAUTHORITY, UNKNOWN)],\n178\t  fail_means=\"A located leak point explains lean trims/rough idle/boost loss directly.\",\n179\t  related_codes=[\"P0171\", \"P0101\", \"P0299\", \"P0106\"],\n180\t  supports_hypotheses=[\"intake leak\", \"boost leak\"],\n181\t  refutes_hypotheses=[\"intake leak\", \"boost leak\"],\n182\t  duration_min=20, hazards=[])\n183\t\n184\t_t(\"purge_vent_actuation\", \"EVAP purge/vent solenoid actuation check\", \"emissions\",\n185\t  [\"evap\"], _applies(),\n186\t  purpose=\"Confirm the purge and vent solenoids actually open/close on command, \"\n187\t          \"rather than assuming the commanded state matches reality.\",\n188\t  car_state=\"KOEO\",\n189\t  when_to_use=\"Before condemning a purge or vent valve on a code alone -- commanded \"\n190\t              \"vs. actual state mismatches are a common root cause.\",\n191\t  tools=[\"scan tool with bidirectional control (MCP actuator control)\",\n192\t        \"stethoscope or hand on the valve body\"],\n193\t  procedure=[\n194\t      \"Command the purge solenoid open via the MCP actuator-control interface; \"\n195\t      \"listen/feel for the valve clicking.\",\n196\t      \"Command the vent solenoid closed, then open; listen/feel for each transition.\",\n197\t      \"Read back commanded vs. observed state if the scan tool reports both.\",\n198\t  ],\n199\t  pass_criteria=[_pc(\"actuation on command\", \"valve clicks/moves on each command\",\n200\t                     \"\", TECHAUTHORITY, UNKNOWN)],\n201\t  fail_means=\"A valve that does not actuate on command is the fault, independent of \"\n202\t             \"any smoke result.\",\n203\t  related_codes=[\"P0443\", \"P0446\", \"P0449\", \"P1443\"],\n204\t  supports_hypotheses=[\"EVAP leak\", \"EVAP valve stuck\"],\n205\t  refutes_hypotheses=[\"EVAP valve stuck\"],\n206\t  duration_min=10,\n207\t  safety=\"HTTP surface is read-only; this test is only available through the MCP \"\n208\t         \"actuator-control tool, never through the HTTP job/tests API -- it writes a \"\n209\t         \"live command to the car.\",\n210\t  hazards=[])\n211\t\n212\t_t(\"esim_vacuum_test_a\", \"ESIM vacuum test (Test A)\", \"emissions\", [\"evap\"],\n213\t  _applies(grecale=False),\n214\t  purpose=\"FCA's own leak-detection-pump (ESIM) self-test procedure, Test A -- \"\n215\t          \"exercises the pump's own vacuum/pressure switch logic rather than a \"\n216\t          \"manual smoke fill.\",\n217\t  car_state=\"KOEO\",\n218\t  when_to_use=\"When the EVAP leak-detection pump itself is suspect (no leak found by \"\n219\t              \"smoke, but a P0455/0456 persists), or to corroborate a smoke-test \"\n220\t              \"result.\",\n221\t  tools=[\"scan tool with FCA/Stellantis ESIM test routine support\"],\n222\t  procedure=[\n223\t      \"Confirm fuel level is in the EVAP-verification window (15-85%).\",\n224\t      \"Run the scan tool's ESIM Test A routine per its on-screen steps.\",\n225\t      \"Record the pass/fail result the routine itself reports.\",\n226\t  ],\n227\t  pass_criteria=[_pc(\"ESIM Test A result\", \"see service manual\", \"\",\n228\t                     TECHAUTHORITY, UNKNOWN)],\n229\t  fail_means=\"A failed Test A points at the leak-detection pump assembly itself, not \"\n230\t             \"necessarily a leak elsewhere in the system.\",\n231\t  related_codes=[\"P0455\", \"P0456\", \"P2450\", \"P2451\"],\n232\t  supports_hypotheses=[\"EVAP leak\", \"ESIM signal path\"],\n233\t  refutes_hypotheses=[\"ESIM signal path\"],\n234\t  duration_min=10, hazards=[])\n235\t\n236\t_t(\"evap_test_a_esim_switch\", \"wiTECH Test A: ESIM switch\", \"emissions\", [\"evap\"],\n237\t  _applies(grecale=False),\n238\t  purpose=\"Make the ESIM's vacuum switch close with a hand pump while watching the \"\n239\t          \"ECU's own switch reading in wiTECH 2 -- checks the switch, connector, \"\n240\t          \"wiring and ECU input in one pass without unplugging anything. This is \"\n241\t          \"the next_test for the 'EVAP: ESIM signal path' hypothesis on the Stelvio \"\n242\t          \"ZASFAKPN5J7B88115 EVAP case (three clean smoke tests, every EVAP part \"\n243\t          \"new, P0440/P0455/P0456 still return).\",\n244\t  car_state=\"KOEO\",\n245\t  when_to_use=\"EVAP system already smoke-tested sealed and every EVAP part is new, \"\n246\t              \"yet P0440/P0455/P0456 keep returning -- run this before the ESIM \"\n247\t              \"wiring test or any further parts purchase, right after the wiTECH \"\n248\t              \"flash check.\",\n249\t  tools=[\"wiTECH 2 account, laptop and interface\",\n250\t        \"hand vacuum pump with a short hose that fits the ESIM's canister-side port\",\n251\t        \"flat trim tool and torch for the driver-side rear wheel liner\"],\n252\t  procedure=[\n253\t      \"Park, engine off and cool, park brake on; disconnect MultiEcuScan/cuore so \"\n254\t      \"only wiTECH is on the OBD port.\",\n255\t      \"Open the driver-side rear wheel liner; find the ESIM on the vent side of the \"\n256\t      \"canister. Leave it plugged in; identify its canister-side and fresh-air hoses.\",\n257\t      \"Connect wiTECH, ignition RUN, engine off; sign in, select the vehicle, \"\n258\t      \"confirm VIN ZASFAKPN5J7B88115.\",\n259\t      \"Topology > ECM > live data; search for the ESIM/EVAP pressure or leak-\"\n260\t      \"detection switch parameter (words: ESIM, EVAP, leak, pressure switch, NVLD) \"\n261\t      \"and add fuel level too. If no such parameter exists, note it and fall back \"\n262\t      \"to the ESIM wiring test's meter-based Test B.\",\n263\t      \"Baseline: nothing on the ESIM hose -- record the switch state (expect open).\",\n264\t      \"Disconnect the canister-side hose, fit the hand pump, pump slowly and watch \"\n265\t      \"for wiTECH to show closed; hold ~30 s, then release and confirm it reopens. \"\n266\t      \"Repeat three times, noting any delay.\",\n267\t      \"While held closed with vacuum, gently flex the ESIM connector and harness \"\n268\t      \"along the wheel well; any flicker to open is an intermittent connection.\",\n269\t      \"Release vacuum, refit the hose and liner, ignition OFF, disconnect wiTECH. \"\n270\t      \"Do not clear codes.\",\n271\t  ],\n272\t  pass_criteria=[_pc(\n273\t      \"ESIM/EVAP switch parameter in wiTECH, under hand vacuum\",\n274\t      \"closes with vacuum, holds closed about 30 s, reopens on release, every run, \"\n275\t      \"no flicker on wiggle\",\n276\t      \"\", \"Stelvio wiTECH Test A - ESIM Switch (repo procedure for VIN \"\n277\t          \"ZASFAKPN5J7B88115 -- the exact wiTECH parameter name and switch \"\n278\t          \"threshold are not from an FCA document; search for the parameter and \"\n279\t          \"apply vacuum gently per the sheet)\", UNKNOWN)],\n280\t  fail_means=\"Never changes: the ECU does not see the switch -- go to the ESIM \"\n281\t             \"wiring test. Changes but flickers on wiggle: intermittent connector \"\n282\t             \"or harness fault -- same sheet, steps B1/B5. Closes, holds and \"\n283\t             \"reopens cleanly every time with no flicker: the whole signal path \"\n284\t             \"(switch, connector, wiring, ECU input) works, which moves the case to \"\n285\t             \"the wiTECH flash check / ECM calibration.\",\n286\t  related_codes=[\"P0440\", \"P0455\", \"P0456\"],\n287\t  supports_hypotheses=[\"EVAP: ESIM signal path\", \"EVAP: ECM calibration\"],\n288\t  refutes_hypotheses=[\"EVAP: ESIM signal path\"],\n289\t  duration_min=20,\n290\t  safety=\"Apply vacuum gently by hand; never use shop air on the ESIM. Fuel vapor \"\n291\t         \"at the canister/wheel well -- no sparks or open flame.\",\n292\t  hazards=[\"fuel vapor\"])\n293\t\n294\t_t(\"esim_bench_test\", \"ESIM bench test\", \"emissions\", [\"evap\"],\n295\t  _applies(grecale=False),\n296\t  purpose=\"Bench-check the ESIM's vacuum switch, internal seal and pressure relief \"\n297\t          \"off the car, against a new unit where possible, to decide whether the \"\n298\t          \"ESIM itself (rather than its wiring or the ECM) is at fault.\",\n299\t  car_state=\"key-off\",\n300\t  when_to_use=\"After wiTECH Test A shows the switch never closes, or changes only \"\n301\t              \"sluggishly/at high vacuum -- before condemning the ESIM on the scan \"\n302\t              \"tool reading alone.\",\n303\t  tools=[\"multimeter (ohms/continuity)\", \"hand vacuum pump with short hose\",\n304\t        \"low-range vacuum gauge or a water manometer\", \"rubber vacuum caps\",\n305\t        \"flat trim tool and torch\", \"a new ESIM for side-by-side comparison \"\n306\t        \"(optional but best)\"],\n307\t  procedure=[\n308\t      \"Remove the driver-side rear wheel liner; ignition off; unplug the ESIM \"\n309\t      \"connector and inspect it for corrosion, water, bent pins or a loose lock.\",\n310\t      \"Remove the ESIM or free both hoses, marking which port faces the canister \"\n311\t      \"and which faces fresh air.\",\n312\t      \"Meter across the switch terminals at atmospheric pressure: expect open \"\n313\t      \"(OL / no continuity).\",\n314\t      \"Apply gentle vacuum to the canister-side port (fresh-air side open): the \"\n315\t      \"switch should close at a small vacuum, hold with the vacuum steady, and \"\n316\t      \"reopen on release.\",\n317\t      \"Apply gentle low pressure to the canister-side port: it should vent through \"\n318\t      \"to the fresh-air side rather than holding.\",\n319\t      \"With the meter connected and the switch held closed, tap the body and \"\n320\t      \"wiggle the terminals, watching for a flickering or dropped-out reading.\",\n321\t  ],\n322\t  pass_criteria=[_pc(\n323\t      \"ESIM bench behavior (rest / vacuum close / hold / release / relief / tap)\",\n324\t      \"matches a new ESIM at every step; no factory threshold is published for \"\n325\t      \"this part\",\n326\t      \"\", \"Stelvio ESIM Bench Test (repo procedure; FCA bulletin 9100469 confirms \"\n327\t          \"the ESIM is a separate, individually replaceable part, but publishes \"\n328\t          \"no bench-test procedure, switch threshold or pinout)\", UNKNOWN)],\n329\t  fail_means=\"Switch never closes, vacuum bleeds away once closed, closes only at \"\n330\t             \"much higher vacuum than a new unit, or the reading flickers when \"\n331\t             \"tapped: the ESIM itself is the fault -- replace only the ESIM \"\n332\t             \"(FCA bulletin 9100469). Behaves like a new unit on every step: the \"\n333\t             \"ESIM is exonerated and the case moves to its wiring or the ECM \"\n334\t             \"calibration.\",\n335\t  related_codes=[\"P0440\", \"P0455\", \"P0456\"],\n336\t  supports_hypotheses=[\"EVAP: ESIM signal path\", \"EVAP: ECM calibration\"],\n337\t  refutes_hypotheses=[\"EVAP: ESIM signal path\"],\n338\t  duration_min=30,\n339\t  safety=\"Work outdoors or ventilated, away from sparks/flame; ignition OFF before \"\n340\t         \"unplugging; apply vacuum/pressure gently -- never shop air, which can \"\n341\t         \"damage the diaphragm.\",\n342\t  hazards=[\"fuel vapor\"])\n343\t\n344\t_t(\"esim_wiring_test\", \"ESIM wiring test\", \"electrical\", [\"evap\", \"electrical_supply\"],\n345\t  _applies(grecale=False),\n346\t  purpose=\"Trace the ESIM switch's signal and ground circuit from the ESIM \"\n347\t          \"connector to the ECM -- connector condition, signal reference voltage, \"\n348\t          \"ground, end-to-end resistance and a jumper test -- to localise a fault \"\n349\t          \"that wiTECH Test A showed but a bench test of the ESIM itself cleared.\",\n350\t  car_state=\"KOEO\",\n351\t  when_to_use=\"Run only after the wiTECH flash check and Test A: if Test A never \"\n352\t              \"changes or flickers, and no ESIM circuit DTC (e.g. P24D6) has set \"\n353\t              \"(pointing at intermittent/high-resistance rather than a clean \"\n354\t              \"break), this sheet isolates where in the circuit the fault is.\",\n355\t  tools=[\"digital multimeter with back-probe pins or a breakout lead\",\n356\t        \"hand vacuum pump and short hose\", \"fused jumper lead (low-amp fuse)\",\n357\t        \"the FCA wiring diagram for this VIN (connector/pin IDs, wire colours, \"\n358\t        \"reference voltage -- fill in before testing; see the Stelvio ESIM \"\n359\t        \"Wiring Diagram Lookup sheet)\"],\n360\t  procedure=[\n361\t      \"B1 Connector: ignition OFF, unplug the ESIM; check for corrosion, water, \"\n362\t      \"bent/pushed-back pins, loose terminal grip, and harness chafe at the \"\n363\t      \"wheel-well edge.\",\n364\t      \"B2 Signal reference: connector unplugged, ignition RUN; harness-side signal \"\n365\t      \"pin to chassis ground should read the diagram's reference voltage (0 V = \"\n366\t      \"open/not driven; battery voltage where a low reference is expected = short \"\n367\t      \"to power).\",\n368\t      \"B3 Ground: harness-side ground pin to battery negative -- near 0 V \"\n369\t      \"(ignition RUN) and a few ohms or less (ignition OFF).\",\n370\t      \"B4 End to end: battery negative disconnected, ECU connector unplugged; each \"\n371\t      \"wire ESIM pin to ECU pin should read a fraction of an ohm (several ohms = \"\n372\t      \"high resistance, OL = break); each wire to ground/B+ should be open. \"\n373\t      \"Reconnect ECU, battery last.\",\n374\t      \"B5 Jumper: battery on, ignition RUN, ESIM unplugged, wiTECH ECM data \"\n375\t      \"display open; fused jumper from signal pin to ground pin (what a closed \"\n376\t      \"switch does) should make wiTECH show closed; wiggle the harness while \"\n377\t      \"watching for a flicker.\",\n378\t  ],\n379\t  pass_criteria=[_pc(\n380\t      \"ESIM signal/ground circuit (B2-B5) against the FCA wiring diagram for \"\n381\t      \"this VIN\",\n382\t      \"see the FCA wiring diagram for this VIN -- pin IDs, wire colours and \"\n383\t      \"reference voltage are not published in this catalogue\", \"\",\n384\t      TECHAUTHORITY, UNKNOWN)],\n385\t  fail_means=\"B5 stays open with a good B2-B4: fault is in the ECU input itself. \"\n386\t             \"B2/B3/B4 out of range: open, short or high resistance in that \"\n387\t             \"circuit -- repair with an FCA-approved terminal/splice repair. \"\n388\t             \"Flicker on wiggle: intermittent connector or chafe point. B5 shows \"\n389\t             \"closed while Test A failed: wiring and ECU input are good and the \"\n390\t             \"ESIM switch/contacts are the fault -- bench-test or replace.\",\n391\t  related_codes=[\"P0440\", \"P0455\", \"P0456\"],\n392\t  supports_hypotheses=[\"EVAP: ESIM signal path\"],\n393\t  refutes_hypotheses=[\"EVAP: ESIM signal path\"],\n394\t  duration_min=40,\n395\t  safety=\"Back-probe only, never spread terminals; battery negative OFF before \"\n396\t         \"unplugging the ECU; use a fused jumper; fuel vapor at the canister -- \"\n397\t         \"no sparks.\",\n398\t  hazards=[\"fuel vapor\", \"electrical\"])\n399\t\n400\t_t(\"witech_flash_check\", \"wiTECH ECM flash check\", \"emissions\", [\"evap\"],\n401\t  _applies(grecale=False),\n402\t  purpose=\"Compare the ECM's Current ECU Part Number against wiTECH's New ECU Part \"\n403\t          \"Number on the Flash tab to decide, in minutes, whether an EVAP-relevant \"\n404\t          \"calibration update is even outstanding before chasing hardware.\",\n405\t  car_state=\"KOEO\",\n406\t  when_to_use=\"First decisive step on the EVAP fault tree once smoke tests show the \"\n407\t              \"system sealed -- before wiTECH Test A, the ESIM bench test or the \"\n408\t              \"wiring test, since a 'different' result sends the case straight to \"\n409\t              \"the ECM flash repair instead.\",\n410\t  tools=[\"wiTECH 2 account, laptop and MicroPod II (or wiTECH-supported) interface\",\n411\t        \"stand-alone voltmeter\"],\n412\t  procedure=[\n413\t      \"Connect the wiTECH interface; ignition RUN, engine off.\",\n414\t      \"Sign in to wiTECH 2, select the vehicle, confirm the VIN.\",\n415\t      \"Topology > ECM > Flash tab.\",\n416\t      \"Compare Current ECU Part Number with New ECU Part Number; record both.\",\n417\t  ],\n418\t  pass_criteria=[_pc(\n419\t      \"ECM Current ECU Part Number vs New ECU Part Number on the wiTECH Flash tab\",\n420\t      \"Current already equals New -- the ECM is on the latest calibration in the \"\n421\t      \"18-030-17-family flash\",\n422\t      \"\", \"TSB 18-030-17 REV. B (PCM flash family whose fixed-DTC lists include \"\n423\t          \"P0440/P0441/P0455/P0456; applies to Giulia/Stelvio) -- compared \"\n424\t          \"against the wiTECH Flash tab reading taken on this VIN\", CONFIRMED)],\n425\t  fail_means=\"Current differs from New: a newer calibration exists and has not \"\n426\t             \"been applied -- proceed to the ECM flash repair step before any \"\n427\t             \"further EVAP hardware is condemned. Current equals New and the \"\n428\t             \"codes still return: the software lead is closed -- proceed to \"\n429\t             \"wiTECH Test A.\",\n430\t  related_codes=[\"P0440\", \"P0455\", \"P0456\"],\n431\t  supports_hypotheses=[\"EVAP: ECM calibration\"],\n432\t  refutes_hypotheses=[\"EVAP: ECM calibration\"],\n433\t  duration_min=10, hazards=[])\n434\t\n435\t_t(\"ecm_flash\", \"ECM flash procedure (wiTECH)\", \"emissions\", [\"evap\"],\n436\t  _applies(giulia=False, grecale=False),\n437\t  purpose=\"Repair step, not a diagnostic test: reprogram the PCM to the newest \"\n438\t          \"calibration, then run the PROXI Alignment and Phonic Wheel Replacement \"\n439\t          \"routines the flash requires, exactly as FCA's own dealer instructions \"\n440\t          \"specify for this car.\",\n441\t  car_state=\"KOEO\",\n442\t  when_to_use=\"Only after the wiTECH flash check finds Current ECU Part Number \"\n443\t              \"different from New -- this is the fix, run once that check says a \"\n444\t              \"newer calibration exists.\",\n445\t  tools=[\"wiTECH 2 account, laptop and MicroPod II (or wiTECH-supported) interface\",\n446\t        \"battery charger/maintainer able to hold 13.2-13.5 V\",\n447\t        \"stand-alone voltmeter (not the charger's own meter)\"],\n448\t  procedure=[\n449\t      \"Connect a charger and confirm 13.2-13.5 V at the battery with a stand-alone \"\n450\t      \"voltmeter; keep it there for the whole procedure.\",\n451\t      \"Connect the wiTECH interface; ignition RUN, engine off; sign in, select the \"\n452\t      \"vehicle, confirm the VIN.\",\n453\t      \"Topology > ECM > Flash tab; confirm Current differs from New (if not, stop \"\n454\t      \"-- nothing to flash).\",\n455\t      \"Accept the flash agreement, select Flash ECU, follow the on-screen steps to \"\n456\t      \"completion (about 8 minutes); watch the voltmeter throughout and never \"\n457\t      \"interrupt the flash -- if it aborts, restart it.\",\n458\t      \"BCM > Misc. Functions > PROXI Alignment.\",\n459\t      \"View DTCs; Topology > Action Items > All DTCs > Clear All DTCs (the flash \"\n460\t      \"sets codes in other modules -- expected).\",\n461\t      \"ECM > Misc. Functions > Phonic Wheel Replacement, to completion -- if \"\n462\t      \"skipped or done wrong, DTC P1300 stays active.\",\n463\t      \"Clear All DTCs again; re-open the ECM Flash tab and confirm Current now \"\n464\t      \"equals New.\",\n465\t      \"BCM Flash tab: update the BCM too if its Current differs from New.\",\n466\t      \"Ignition OFF, disconnect wiTECH, remove the charger.\",\n467\t  ],\n468\t  pass_criteria=[_pc(\n469\t      \"ECM Current ECU Part Number after the flash, plus PROXI Alignment and \"\n470\t      \"Phonic Wheel Replacement completion\",\n471\t      \"Current equals New; both routines completed; no P1300 after the flash\",\n472\t      \"\", \"FCA US LLC Customer Satisfaction Notification W05 (March 2020) and \"\n473\t          \"TSB 18-026-20 (March 25, 2020), 2018 GU Stelvio 2.0L EC2\", CONFIRMED)],\n474\t  fail_means=\"Flash does not complete, P1300 sets (Phonic Wheel step missed or \"\n475\t             \"wrong), or P0440/P0455/P0456 return after several verification \"\n476\t             \"drives (fuel 15-85%, cold starts) with the ECM now current -- the \"\n477\t             \"ECM calibration hypothesis is then disconfirmed for this code \"\n478\t             \"family and the case returns to the ESIM signal path.\",\n479\t  related_codes=[\"P0440\", \"P0455\", \"P0456\"],\n480\t  supports_hypotheses=[\"EVAP: ECM calibration\"],\n481\t  refutes_hypotheses=[\"EVAP: ECM calibration\"],\n482\t  duration_min=45,\n483\t  safety=\"Battery charger must hold 13.2-13.5 V for the whole flash (add electrical \"\n484\t         \"load, e.g. lights/blower, if it reads high); never interrupt the flash; \"\n485\t         \"only the wiTECH interface on the OBD port.\",\n486\t  hazards=[\"electrical\"])\n487\t\n488\t_t(\"evap_mode06_review\", \"EVAP Mode $06 review\", \"emissions\", [\"evap\"],\n489\t  _applies(),\n490\t  purpose=\"Read-only interpretation of the ECU's own on-board EVAP monitor test \"\n491\t          \"results (OBDMIDs 0x39/0x3A/0x3C/0x3D) against its own stored pass/fail \"\n492\t          \"limits, rather than a binary DTC -- turns 'no code yet' into 'test ran, \"\n493\t          \"measured X against limit Y', without substituting any number of this \"\n494\t          \"catalogue's own.\",\n495\t  car_state=\"KOEO\",\n496\t  when_to_use=\"Alongside or after the other EVAP tests, whenever a from-car Mode \"\n497\t              \"$06 read is available, to see the ECU's own measured leak-test \"\n498\t              \"values rather than only the DTC bucket.\",\n499\t  tools=[\"MCP obd2 read_mode06 tool, or cuore's /live/obd/mode06 route \"\n500\t        \"(cuore.live.mode06) -- read-only, no actuation\"],\n501\t  procedure=[\n502\t      \"Confirm the car has driven since the last code clear, with fuel in the \"\n503\t      \"15-85% window and at least one cold start, so the EVAP monitors have had \"\n504\t      \"a chance to run.\",\n505\t      \"Run Mode 06 (MCP obd2 read_mode06, or GET /live/obd/mode06) over the OBD \"\n506\t      \"port.\",\n507\t      \"Read OBDMID 0x39 (EVAP monitor, cap off / gross leak), 0x3A (0.090\\\" leak), \"\n508\t      \"0x3C (0.020\\\" leak) and 0x3D (EVAP purge flow monitor) -- each record's \"\n509\t      \"measured value and its own min/max limits exactly as the ECU reports them.\",\n510\t      \"Note which MIDs responded with data, which came back NO DATA, and which \"\n511\t      \"got a negative response (not supported) -- never guess a missing one.\",\n512\t      \"Read the result together with the active/pending/permanent DTCs for the \"\n513\t      \"same drive cycle, not alone.\",\n514\t  ],\n515\t  pass_criteria=[_pc(\n516\t      \"EVAP OBDMID 0x39/0x3A/0x3C/0x3D measured value vs. min/max limit\",\n517\t      \"limits come from the car -- read the ECU's own min/max fields in the Mode \"\n518\t      \"$06 reply; no figure is published in this catalogue\",\n519\t      \"\", \"SAE J1979 Appendix D / ISO 15031-5 OBDMID definitions \"\n520\t          \"(cuore.live.mode06.OBDMID_NAMES); numeric limits are the ECU's own, \"\n521\t          \"not a document figure\", UNKNOWN)],\n522\t  fail_means=\"A MID whose measured value falls outside its own reported min/max \"\n523\t             \"window is a failed on-board monitor for that leak size or purge \"\n524\t             \"flow -- corroborating evidence either for an active leak (ESIM \"\n525\t             \"signal path) or for a calibration-level false fail, never decisive \"\n526\t             \"alone.\",\n527\t  related_codes=[\"P0440\", \"P0455\", \"P0456\"],\n528\t  supports_hypotheses=[\"EVAP: ESIM signal path\", \"EVAP: ECM calibration\"],\n529\t  refutes_hypotheses=[\"EVAP: ESIM signal path\", \"EVAP: ECM calibration\"],\n530\t  duration_min=10, hazards=[])\n531\t\n532\t_t(\"fuel_trim_o2_observation\", \"Fuel trim / O2 sensor observation\", \"fuel\",\n533\t  [\"fuel\", \"engine_management\"], _applies(),\n534\t  purpose=\"Watch live short/long-term fuel trim and O2 sensor voltage to spot a lean \"\n535\t          \"or rich condition and whether the O2 sensor is actively switching.\",\n536\t  car_state=\"hot\",\n537\t  when_to_use=\"Any suspected intake/EVAP/fuel-delivery leak, or a misfire with no \"\n538\t              \"obvious mechanical cause -- read before and after a repair to confirm \"\n539\t              \"trims recovered.\",\n540\t  tools=[\"scan tool (live PIDs)\"],\n541\t  procedure=[\n542\t      \"Warm engine to closed-loop operation.\",\n543\t      \"Record short- and long-term fuel trim, bank 1 (and bank 2 if the platform \"\n544\t      \"reports it) at idle and at a steady 2000 rpm.\",\n545\t      \"Record O2 sensor voltage; confirm it is actively switching, not static.\",\n546\t  ],\n547\t  pass_criteria=[\n548\t      _pc(\"short_fuel_trim_b1\", [-10, 10], \"%\",\n549\t         \"https://www.obd-codes.com/faq/fuel-trims.php\", CORROBORATED),\n550\t      _pc(\"long_fuel_trim_b1\", [-10, 10], \"%\",\n551\t         \"https://www.obd-codes.com/faq/fuel-trims.php\", CORROBORATED),\n552\t      _pc(\"o2_b1s1_voltage switching\", \"actively cycling ~0.1-0.9 V, not static\", \"V\",\n553\t         \"https://www.fluke.com/en-us/learn/blog/digital-multimeters/\"\n554\t         \"how-to-monitor-oxygen-sensor-voltage-with-a-multimeter\", CORROBORATED),\n555\t  ],\n556\t  fail_means=\"Trim beyond roughly +/-20% (same generic band) or a static O2 voltage \"\n557\t             \"points at an unmetered air/fuel leak or a failing sensor, not yet \"\n558\t             \"isolated to a part.\",\n559\t  related_codes=[\"P0171\", \"P0172\", \"P0174\", \"P0175\", \"P0300\"],\n560\t  supports_hypotheses=[\"intake leak\", \"EVAP leak\", \"fuel delivery fault\"],\n561\t  refutes_hypotheses=[\"intake leak\", \"fuel delivery fault\"],\n562\t  duration_min=10, hazards=[])\n563\t\n564\t_t(\"misfire_counters\", \"Misfire counter review\", \"ignition\",\n565\t  [\"ignition\", \"engine_management\"], _applies(),\n566\t  purpose=\"Read the ECM's per-cylinder misfire counters to see which cylinder(s) are \"\n567\t          \"actually misfiring, rather than guessing from a generic P0300.\",\n568\t  car_state=\"driving\",\n569\t  when_to_use=\"P0300 or any per-cylinder misfire code, before swapping coils/plugs/\"\n570\t              \"injectors.\",\n571\t  tools=[\"scan tool (Mode $06 or manufacturer-specific misfire data)\"],\n572\t  procedure=[\n573\t      \"Clear counters if the tool allows, or note current values.\",\n574\t      \"Drive through the condition that triggers the complaint (idle, load, cruise).\",\n575\t      \"Read counters again; compare per-cylinder counts.\",\n576\t  ],\n577\t  pass_criteria=[_pc(\"misfire count\", \"0 or negligible, evenly low across cylinders\",\n578\t                     \"counts\", TECHAUTHORITY, UNKNOWN)],\n579\t  fail_means=\"One cylinder dominating the count points at that cylinder's ignition/\"\n580\t             \"injector/mechanical path; counts spread evenly across all cylinders \"\n581\t             \"points at a common-cause fault (fuel pressure, vacuum leak).\",\n582\t  related_codes=[\"P0300\", \"P0301\", \"P0302\", \"P0303\", \"P0304\"],\n583\t  supports_hypotheses=[\"misfire, single cylinder\", \"misfire, all cylinders\"],\n584\t  refutes_hypotheses=[],\n585\t  duration_min=15, hazards=[])\n586\t\n587\t# ===========================================================================\n588\t# Cooling\n589\t# ===========================================================================\n590\t\n591\t_t(\"cooling_system_pressure_test\", \"Cooling system pressure test\", \"cooling\",\n592\t  [\"cooling\"], _applies(),\n593\t  purpose=\"Pressurize the cooling system cold to find external leaks (hoses, \"\n594\t          \"radiator, water pump, head gasket externally) without running the engine.\",\n595\t  car_state=\"cold\",\n596\t  when_to_use=\"Any coolant loss with no visible puddle, low-coolant warning, or \"\n597\t              \"before condemning a head gasket on overheating alone.\",\n598\t  tools=[\"cooling system pressure tester with radiator-cap adapter\"],\n599\t  procedure=[\n600\t      \"Engine cold. Remove cap, fit the pressure tester.\",\n601\t      \"Pump to the cap's rated pressure (see cap markings / service manual).\",\n602\t      \"Hold for 2 minutes; watch the gauge and every hose/fitting/the water pump \"\n603\t      \"weep hole.\",\n604\t      \"A pressure drop with no visible external leak raises suspicion of an internal \"\n605\t      \"leak (head gasket, cracked head/block) -- follow with the block (combustion-\"\n606\t      \"gas) test.\",\n607\t  ],\n608\t  pass_criteria=[_pc(\"pressure drop over 2 min\", \"<10%\", \"%\", INDUSTRY_PRACTICE,\n609\t                     SINGLE_SOURCE)],\n610\t  fail_means=\"A visible external leak identifies the failed part directly; a drop \"\n611\t             \"with no visible leak is evidence for an internal leak.\",\n612\t  related_codes=[\"P0217\"],\n613\t  supports_hypotheses=[\"coolant loss\", \"head gasket\"],\n614\t  refutes_hypotheses=[\"head gasket\"],\n615\t  duration_min=20, safety=\"Cooling system may still be warm/pressurized from a prior \"\n616\t                          \"drive -- let it cool fully before opening.\",\n617\t  hazards=[\"hot coolant\"])\n618\t\n619\t_t(\"radiator_cap_test\", \"Radiator cap pressure test\", \"cooling\", [\"cooling\"], _applies(),\n620\t  purpose=\"Confirm the cap itself holds its rated pressure before condemning the \"\n621\t          \"system -- a weak cap causes coolant loss/boil-over that looks like a \"\n622\t          \"system leak.\",\n623\t  car_state=\"cold\",\n624\t  when_to_use=\"Coolant loss with no obvious system leak, or before reusing a cap \"\n625\t              \"after any other cooling work.\",\n626\t  tools=[\"cooling system pressure tester with cap adapter\"],\n627\t  procedure=[\n628\t      \"Fit the cap alone to the tester's cap adapter.\",\n629\t      \"Pump until the cap releases; read the release pressure.\",\n630\t      \"Compare to the cap's own rated/stamped pressure.\",\n631\t  ],\n632\t  pass_criteria=[_pc(\"release pressure vs. rated\", \"see service manual / cap marking\",\n633\t                     \"\", TECHAUTHORITY, UNKNOWN)],\n634\t  fail_means=\"A cap that releases well below its rated pressure is the leak/boil-\"\n635\t             \"over cause by itself -- replace it before re-testing the system.\",\n636\t  related_codes=[\"P0217\"],\n637\t  supports_hypotheses=[\"coolant loss\"], refutes_hypotheses=[\"coolant loss\"],\n638\t  duration_min=5, hazards=[\"hot coolant\"])\n639\t\n640\t_t(\"coolant_block_test\", \"Coolant combustion-gas (block) test\", \"cooling\",\n641\t  [\"cooling\", \"engine_management\"], _applies(),\n642\t  purpose=\"Chemically detect combustion gases (CO2) bubbling into the coolant -- the \"\n643\t          \"classic head-gasket/cracked-head check.\",\n644\t  car_state=\"hot\",\n645\t  when_to_use=\"Suspected internal coolant leak (white exhaust smoke, chronic \"\n646\t              \"overheating, coolant loss with no external leak, oil/coolant cross-\"\n647\t              \"contamination).\",\n648\t  tools=[\"block tester (combustion-leak detection fluid + bulb)\"],\n649\t  procedure=[\n650\t      \"Engine warm, coolant level correct.\",\n651\t      \"Fit the tester over the radiator/expansion-tank neck, below the fill line, \"\n652\t      \"without touching coolant.\",\n653\t      \"Squeeze the bulb to draw vapor through the fluid; run the engine at idle/\"\n654\t      \"light load for the tool's specified time.\",\n655\t      \"Watch the fluid colour change (blue -> yellow typically indicates CO2 present).\",\n656\t  ],\n657\t  pass_criteria=[_pc(\"fluid colour change\", \"no change (stays blue/green)\", \"\",\n658\t                     TECHAUTHORITY, UNKNOWN)],\n659\t  fail_means=\"A positive colour change is strong evidence of combustion gas in the \"\n660\t             \"coolant -- head gasket or cracked head/block, not a hose/radiator leak.\",\n661\t  related_codes=[\"P0217\"],\n662\t  supports_hypotheses=[\"head gasket\"], refutes_hypotheses=[\"head gasket\"],\n663\t  duration_min=10, hazards=[\"hot coolant\", \"hot engine surfaces\"])\n664\t\n665\t# ===========================================================================\n666\t# Fuel\n667\t# ===========================================================================\n668\t\n669\t_t(\"fuel_pressure_test\", \"Fuel pressure test (low side + high side)\", \"fuel\",\n670\t  [\"fuel\"], _applies(),\n671\t  purpose=\"Confirm the low-pressure (tank-to-pump) and high-pressure (direct-\"\n672\t          \"injection rail) fuel systems are each within spec, read live rather than \"\n673\t          \"assumed from a code.\",\n674\t  car_state=\"KOER\",\n675\t  when_to_use=\"Hard start, stumble under load, lean trims with no leak found, or any \"\n676\t              \"fuel-pressure-related code.\",\n677\t  tools=[\"scan tool (live fuel pressure PIDs, low and high side)\",\n678\t        \"mechanical fuel pressure gauge (low side, if the PID is suspect)\"],\n679\t  procedure=[\n680\t      \"Low side: read the scan-tool low-pressure PID at idle and under load; cross-\"\n681\t      \"check with a mechanical gauge at the test port if the PID reading is in \"\n682\t      \"doubt.\",\n683\t      \"High side: read the DI rail pressure PID at idle, under load, and watch its \"\n684\t      \"response during a quick throttle blip.\",\n685\t      \"Compare both to spec (see service manual -- this platform's DI rail target \"\n686\t      \"varies with load and is not a single fixed number).\",\n687\t  ],\n688\t  pass_criteria=[_pc(\"low-side pressure\", \"see service manual\", \"\", TECHAUTHORITY,\n689\t                     UNKNOWN),\n690\t                _pc(\"high-side (DI rail) pressure\", \"see service manual\", \"\",\n691\t                    TECHAUTHORITY, UNKNOWN)],\n692\t  fail_means=\"Low side out of spec points at the in-tank pump/filter/regulator; \"\n693\t             \"high side out of spec (with a good low side) points at the high-\"\n694\t             \"pressure pump or rail components.\",\n695\t  related_codes=[\"P0087\", \"P0088\", \"P0191\", \"P0192\", \"P0193\", \"P1093\"],\n696\t  supports_hypotheses=[\"fuel delivery fault\"], refutes_hypotheses=[\"fuel delivery fault\"],\n697\t  duration_min=20, safety=\"Direct-injection rail pressure is very high -- never \"\n698\t                          \"loosen a high-pressure fitting with the system \"\n699\t                          \"pressurized or the engine running.\",\n700\t  hazards=[\"fuel pressure\", \"fuel\"])\n701\t\n702\t_t(\"injector_balance_test\", \"Injector balance / contribution test\", \"fuel\",\n703\t  [\"fuel\", \"engine_management\"], _applies(),\n704\t  purpose=\"Compare each injector's actual contribution to combustion (via fuel \"\n705\t          \"trim shift or a dedicated balance-test routine) to find a weak or \"\n706\t          \"clogged injector.\",\n707\t  car_state=\"KOER\",\n708\t  when_to_use=\"A misfire isolated to one cylinder after ignition components are \"\n709\t              \"already confirmed good.\",\n710\t  tools=[\"scan tool with injector balance/contribution test support\"],\n711\t  procedure=[\n712\t      \"Run the scan tool's injector balance/contribution routine if the platform \"\n713\t      \"supports it (cuts each injector in turn, measures RPM drop or fuel-trim \"\n714\t      \"shift).\",\n715\t      \"If no dedicated routine exists, swap the suspect injector with a known-good \"\n716\t      \"one and see if the misfire follows the part.\",\n717\t  ],\n718\t  pass_criteria=[_pc(\"contribution across cylinders\", \"even across all cylinders\", \"\",\n719\t                     TECHAUTHORITY, UNKNOWN)],\n720\t  fail_means=\"One cylinder contributing noticeably less (or the misfire following \"\n721\t             \"the swapped part) identifies that injector.\",\n722\t  related_codes=[\"P0301\", \"P0302\", \"P0303\", \"P0304\", \"P0263\", \"P0266\"],\n723\t  supports_hypotheses=[\"misfire, single cylinder\"], refutes_hypotheses=[],\n724\t  duration_min=20, hazards=[\"fuel pressure\"])\n725\t\n726\t# ===========================================================================\n727\t# Lubrication\n728\t# ===========================================================================\n729\t\n730\t_t(\"oil_pressure_test\", \"Oil pressure test (PID + mechanical gauge)\", \"lubrication\",\n731\t  [\"lubrication\"], _applies(),\n732\t  purpose=\"Confirm actual oil pressure rather than trusting a low-oil-pressure \"\n733\t          \"warning or a suspect sender/PID alone.\",\n734\t  car_state=\"hot\",\n735\t  when_to_use=\"Low oil pressure warning/code, knocking noise, or before any major \"\n736\t              \"engine work to establish a baseline.\",\n737\t  tools=[\"scan tool (oil pressure PID, if supported)\",\n738\t        \"mechanical oil pressure gauge (adapts to the sender port)\"],\n739\t  procedure=[\n740\t      \"Warm engine to normal operating temperature.\",\n741\t      \"Read the scan-tool oil pressure PID at idle and at a steady 2500-3000 rpm, \"\n742\t      \"if the ECM reports one.\",\n743\t      \"Cross-check with a mechanical gauge at the sender port -- the PID can be \"\n744\t      \"wrong if the sender itself is marginal.\",\n745\t  ],\n746\t  pass_criteria=[_pc(\"oil pressure, hot idle and 3000 rpm\", \"see service manual\", \"\",\n747\t                     TECHAUTHORITY, UNKNOWN)],\n748\t  fail_means=\"Low pressure confirmed on the mechanical gauge (not just the PID) \"\n749\t             \"points at the pump, bearings, or oil pickup/level -- a genuine \"\n750\t             \"mechanical concern, stop driving the car until resolved.\",\n751\t  related_codes=[\"P0520\", \"P0521\", \"P0522\", \"P0523\"],\n752\t  supports_hypotheses=[\"low oil pressure\"], refutes_hypotheses=[\"low oil pressure\"],\n753\t  duration_min=15, safety=\"A confirmed low mechanical reading means the engine \"\n754\t                          \"should not be driven further until the cause is found.\",\n755\t  hazards=[\"hot engine surfaces\", \"hot oil\"])\n756\t\n757\t_t(\"oil_uv_dye_leak\", \"Oil UV-dye leak test\", \"leak_detection\",\n758\t  [\"lubrication\"], _applies(),\n759\t  purpose=\"Find the exact source of an external oil leak using UV dye and a UV \"\n760\t          \"light, instead of guessing from a general wet-underside appearance.\",\n761\t  car_state=\"driving\",\n762\t  when_to_use=\"Any oil leak where the source isn't obvious from a visual alone.\",\n763\t  tools=[\"UV dye (oil-compatible)\", \"UV light\", \"shop light\"],\n764\t  procedure=[\n765\t      \"Add the manufacturer-specified amount of UV dye to the oil (or use pre-dyed \"\n766\t      \"oil).\",\n767\t      \"Drive the car normally for a day or more to circulate the dye and let the \"\n768\t      \"leak show.\",\n769\t      \"With the car on a lift, scan every seal/gasket/fitting with the UV light in \"\n770\t      \"a darkened area.\",\n771\t      \"Note the exact glowing point(s); clean and re-check after the repair to \"\n772\t      \"confirm the leak stopped.\",\n773\t  ],\n774\t  pass_criteria=[_pc(\"UV glow at seal/gasket\", \"none found\", \"\", TECHAUTHORITY, UNKNOWN)],\n775\t  fail_means=\"A glowing point identifies the exact leaking seal/gasket/fitting.\",\n776\t  related_codes=[], supports_hypotheses=[\"oil leak\"], refutes_hypotheses=[\"oil leak\"],\n777\t  duration_min=30, hazards=[\"hot oil\", \"UV light exposure -- wear UV-blocking glasses\"])\n778\t\n779\t# ===========================================================================\n780\t# Cooling / A-C leak detection\n781\t# ===========================================================================\n782\t\n783\t_t(\"coolant_uv_dye_leak\", \"Coolant UV-dye leak test\", \"leak_detection\",\n784\t  [\"cooling\"], _applies(),\n785\t  purpose=\"Find the exact source of a coolant leak using UV dye, especially a slow \"\n786\t          \"leak with no visible puddle.\",\n787\t  car_state=\"driving\",\n788\t  when_to_use=\"Coolant loss with no leak found by the pressure test, or to confirm a \"\n789\t              \"repair stopped a known small leak.\",\n790\t  tools=[\"UV dye (coolant-compatible)\", \"UV light\"],\n791\t  procedure=[\n792\t      \"Add UV dye to the coolant per the dye manufacturer's dosage.\",\n793\t      \"Drive/idle the car through a full warm-up and cool-down cycle to circulate \"\n794\t      \"the dye.\",\n795\t      \"Inspect every hose, clamp, radiator seam, heater core and water pump with \"\n796\t      \"the UV light.\",\n797\t      \"Note the exact glowing point(s).\",\n798\t  ],\n799\t  pass_criteria=[_pc(\"UV glow at hose/seam/pump\", \"none found\", \"\", TECHAUTHORITY,\n800\t                     UNKNOWN)],\n801\t  fail_means=\"A glowing point identifies the exact leaking component.\",\n802\t  related_codes=[\"P0217\"], supports_hypotheses=[\"coolant loss\"],\n803\t  refutes_hypotheses=[\"coolant loss\"], duration_min=30,\n804\t  hazards=[\"hot coolant\", \"UV light exposure -- wear UV-blocking glasses\"])\n805\t\n806\t_t(\"ac_uv_dye_leak_and_pressures\", \"A/C UV-dye leak test and system pressures\",\n807\t  \"leak_detection\", [\"hvac\"], _applies(),\n808\t  purpose=\"Find a refrigerant leak with UV dye and confirm the A/C system's high/\"\n809\t          \"low-side pressures are within spec for ambient conditions.\",\n810\t  car_state=\"driving\",\n811\t  when_to_use=\"Weak or no A/C cooling, or a low-refrigerant warning.\",\n812\t  tools=[\"UV dye (A/C-compatible, pre-charged in refrigerant or injected)\", \"UV light\",\n813\t        \"manifold gauge set\"],\n814\t  procedure=[\n815\t      \"Connect the manifold gauge set to the high- and low-side service ports.\",\n816\t      \"Run the A/C on max cold, record high- and low-side pressures against the \"\n817\t      \"pressure/temperature chart for the ambient temperature.\",\n818\t      \"If dye is already in the system (or inject it), run the system, then scan \"\n819\t      \"every fitting/condenser/evaporator-drain area with the UV light.\",\n820\t  ],\n821\t  pass_criteria=[\n822\t      _pc(\"high/low side pressure vs. P/T chart\", \"see service manual / refrigerant \"\n823\t          \"P-T chart\", \"\", TECHAUTHORITY, UNKNOWN),\n824\t      _pc(\"UV glow at fitting/component\", \"none found\", \"\", TECHAUTHORITY, UNKNOWN),\n825\t  ],\n826\t  fail_means=\"Pressures outside the P/T-chart band point at charge level or a \"\n827\t             \"component (compressor, expansion valve); a UV glow identifies the \"\n828\t             \"exact leak point.\",\n829\t  related_codes=[], supports_hypotheses=[\"A/C leak\", \"A/C charge fault\"],\n830\t  refutes_hypotheses=[\"A/C leak\", \"A/C charge fault\"], duration_min=30,\n831\t  safety=\"R-1234yf (or R-134a on older stock) requires certified recovery/charging \"\n832\t         \"equipment -- never vent refrigerant to atmosphere.\",\n833\t  hazards=[\"refrigerant\", \"high pressure\", \"UV light exposure\"])\n834\t\n835\t# ===========================================================================\n836\t# Mechanical engine\n837\t# ===========================================================================\n838\t\n839\t_t(\"compression_test\", \"Compression test\", \"mechanical_engine\",\n840\t  [\"engine_management\"], _applies(),\n841\t  purpose=\"Measure each cylinder's cranking compression to find a mechanical \"\n842\t          \"problem (valve, ring, head gasket) a scan tool can't see directly.\",\n843\t  car_state=\"KOEO\",\n844\t  when_to_use=\"Low power, rough idle with no electrical cause found, or before any \"\n845\t              \"major engine work to establish a baseline.\",\n846\t  tools=[\"compression tester (threaded gauge, per spark-plug-hole thread)\",\n847\t        \"disable fuel/ignition per service manual procedure\"],\n848\t  procedure=[\n849\t      \"Warm engine, then disable fuel delivery and ignition per the service \"\n850\t      \"manual's cranking-compression procedure.\",\n851\t      \"Remove all spark plugs; fit the gauge to cylinder 1.\",\n852\t      \"Crank through 4-5 compression strokes (throttle held open); record the \"\n853\t      \"highest steady reading.\",\n854\t      \"Repeat for every cylinder.\",\n855\t  ],\n856\t  pass_criteria=[\n857\t      _pc(\"absolute compression\", \"see service manual\", \"psi\", TECHAUTHORITY, UNKNOWN),\n858\t      _pc(\"cylinder-to-cylinder variation\", 10, \"%\", INDUSTRY_PRACTICE, SINGLE_SOURCE),\n859\t  ],\n860\t  fail_means=\"Any cylinder reading more than ~10% below the others points at that \"\n861\t             \"cylinder's valves/rings/head gasket; low on all cylinders points at a \"\n862\t             \"timing or common mechanical fault.\",\n863\t  related_codes=[\"P0300\", \"P0301\", \"P0302\", \"P0303\", \"P0304\"],\n864\t  supports_hypotheses=[\"misfire, single cylinder\", \"low compression\"],\n865\t  refutes_hypotheses=[\"low compression\"], duration_min=30,\n866\t  safety=\"Fuel and ignition must be disabled per the service manual before \"\n867\t         \"cranking with plugs out.\",\n868\t  hazards=[\"moving car -- do not crank with transmission in gear\"])\n869\t\n870\t_t(\"relative_compression_test\", \"Relative compression test (starter current / scan \"\n871\t  \"tool)\", \"mechanical_engine\", [\"engine_management\", \"starting_charging\"], _applies(),\n872\t  purpose=\"A quicker, no-plugs-out alternative to a full compression test: compares \"\n873\t          \"the starter's current/RPM signature cylinder-to-cylinder while cranking \"\n874\t          \"on a healthy, fueled engine.\",\n875\t  car_state=\"KOEO\",\n876\t  when_to_use=\"Quick screen for an obvious low-compression cylinder before committing \"\n877\t              \"to a full compression/leak-down test.\",\n878\t  tools=[\"scan tool with relative-compression routine, or a current clamp + scope on \"\n879\t        \"the starter feed\"],\n880\t  procedure=[\n881\t      \"Disable fuel/ignition only if the chosen tool's routine requires it; many \"\n882\t      \"scan-tool routines crank the engine as-is.\",\n883\t      \"Run the routine (or crank while logging starter current); it reports a \"\n884\t      \"relative value per cylinder based on the load dip as each piston compresses.\",\n885\t      \"Compare the per-cylinder values.\",\n886\t  ],\n887\t  pass_criteria=[_pc(\"cylinder-to-cylinder variation\", 10, \"%\", INDUSTRY_PRACTICE,\n888\t                     SINGLE_SOURCE)],\n889\t  fail_means=\"A cylinder standing out from the rest is a candidate for a full \"\n890\t             \"compression or leak-down test to confirm.\",\n891\t  related_codes=[\"P0300\", \"P0301\", \"P0302\", \"P0303\", \"P0304\"],\n892\t  supports_hypotheses=[\"misfire, single cylinder\", \"low compression\"],\n893\t  refutes_hypotheses=[\"low compression\"], duration_min=10, hazards=[])\n894\t\n895\t_t(\"cylinder_leak_down_test\", \"Cylinder leak-down test\", \"mechanical_engine\",\n896\t  [\"engine_management\"], _applies(),\n897\t  purpose=\"Pressurize each cylinder at TDC with shop air to find and identify \"\n898\t          \"exactly where a low-compression cylinder is leaking (rings, intake \"\n899\t          \"valve, exhaust valve, head gasket).\",\n900\t  car_state=\"KOEO\",\n901\t  when_to_use=\"After a compression or relative-compression test flags a weak \"\n902\t              \"cylinder -- to tell rings from valves from head gasket.\",\n903\t  tools=[\"leak-down tester\", \"shop air supply\", \"way to hold the crank at TDC \"\n904\t        \"(socket on the crank bolt)\"],\n905\t  procedure=[\n906\t      \"Remove the spark plug for the cylinder under test; bring that cylinder to \"\n907\t      \"TDC on the compression stroke.\",\n908\t      \"Fit the leak-down tester, apply shop air, and read the leakage percentage.\",\n909\t      \"Listen at the throttle body (intake valve leak), the exhaust pipe (exhaust \"\n910\t      \"valve leak), the oil fill (ring leak) and the radiator neck (head gasket \"\n911\t      \"leak) for escaping air.\",\n912\t  ],\n913\t  pass_criteria=[\n914\t      _pc(\"leak-down percentage\", 10, \"%\", INDUSTRY_PRACTICE, SINGLE_SOURCE),\n915\t      _pc(\"leak-down percentage, borderline\", [10, 20], \"%\", INDUSTRY_PRACTICE,\n916\t          SINGLE_SOURCE),\n917\t  ],\n918\t  fail_means=\"Over ~20% leakage is a real concern; where the air is heard escaping \"\n919\t             \"from identifies rings vs. intake valve vs. exhaust valve vs. head \"\n920\t             \"gasket directly.\",\n921\t  related_codes=[\"P0300\", \"P0301\", \"P0302\", \"P0303\", \"P0304\"],\n922\t  supports_hypotheses=[\"low compression\", \"head gasket\"],\n923\t  refutes_hypotheses=[\"head gasket\"], duration_min=30,\n924\t  hazards=[\"shop air pressure -- cylinder can rotate off TDC under pressure\"])\n925\t\n926\t_t(\"intake_vacuum_gauge_test\", \"Intake vacuum gauge test\", \"mechanical_engine\",\n927\t  [\"air_intake_boost\", \"engine_management\"], _applies(),\n928\t  purpose=\"A quick, broad mechanical-health check at idle using a vacuum gauge on a \"\n929\t          \"manifold port -- steady vacuum vs. fluctuating/low vacuum points toward \"\n930\t          \"different fault families before any teardown.\",\n931\t  car_state=\"hot\",\n932\t  when_to_use=\"Rough idle or low power with no code pointing anywhere specific.\",\n933\t  tools=[\"vacuum gauge\", \"manifold vacuum port/adapter\"],\n934\t  procedure=[\n935\t      \"Warm engine, connect vacuum gauge to a manifold vacuum port.\",\n936\t      \"Read steady idle vacuum; note any needle flutter, slow drift, or rhythmic \"\n937\t      \"drop.\",\n938\t      \"Briefly snap the throttle open/closed and watch the gauge's response.\",\n939\t  ],\n940\t  pass_criteria=[_pc(\"steady idle vacuum\", [17, 21], \"inHg\", INDUSTRY_PRACTICE,\n941\t                     SINGLE_SOURCE)],\n942\t  fail_means=\"Low and steady = worn rings/late timing; needle fluttering rapidly = \"\n943\t             \"worn valve guides or weak spring; a periodic drop = a leaking valve \"\n944\t             \"on one cylinder; slowly drifting down = restricted exhaust.\",\n945\t  related_codes=[], supports_hypotheses=[\"low compression\", \"exhaust restriction\"],\n946\t  refutes_hypotheses=[], duration_min=10, hazards=[])\n947\t\n948\t_t(\"crankcase_vacuum_pcv_test\", \"Crankcase vacuum / PCV system test\", \"mechanical_engine\",\n949\t  [\"pcv\"], _applies(),\n950\t  purpose=\"Confirm the PCV/crankcase ventilation system is holding its designed \"\n951\t          \"slight vacuum and not venting oil mist or pressurizing the crankcase.\",\n952\t  car_state=\"hot\",\n953\t  when_to_use=\"Oil consumption with no external leak found, oil in the intake \"\n954\t              \"piping, or a whistling/hissing noise from the valve cover area.\",\n955\t  tools=[\"manometer or vacuum gauge on the oil fill cap/dipstick tube\",\n956\t        \"smoke machine (to find a leaking PCV hose)\"],\n957\t  procedure=[\n958\t      \"Warm engine at idle; connect the gauge in place of the oil fill cap \"\n959\t      \"(temporarily) or at a dedicated test point.\",\n960\t      \"Read the crankcase pressure/vacuum.\",\n961\t      \"If pressurized rather than under slight vacuum, smoke-test the PCV hoses/\"\n962\t      \"valve for a stuck-open or disconnected path.\",\n963\t  ],\n964\t  pass_criteria=[_pc(\"crankcase pressure\", \"slight vacuum, not positive pressure\",\n965\t                     \"inH2O\", INDUSTRY_PRACTICE, SINGLE_SOURCE)],\n966\t  fail_means=\"A pressurized (not vacuum) crankcase points at a stuck/plugged PCV \""}]},"uuid":"4da6fd77-3e41-4941-ad43-280c0b40e22e","timestamp":"2026-10-14T05:30:14.121Z","toolUseResult":{"type":"text","file":{"filePath":"C:\\Users\\User\\mcp-servers\\mes-log-mcp\\mes\\mechanic_tests.py","content":"\"\"\"Mechanic test catalogue: every shop-floor diagnostic test that applies to\nthe 2018 Alfa Romeo Stelvio 2.0T GME (Giorgio platform), cross-marked for\nthe Giulia 2.0T (same engine/platform family) and the Maserati Grecale 2.0T\n(Giorgio-derived platform, same Stellantis GME-T4 engine family).\n\nSame house rules as :mod:`mes.known_good` / :mod:`mes.systems`: nothing in\nhere is invented. Every ``pass_criteria`` row carries a ``source`` and a\n``confidence`` --\n\n* ``CONFIRMED``     -- stated in a manufacturer document (FCA/Stellantis\n                       TechAuthority, DOT/FMVSS regulatory standard).\n* ``CORROBORATED``  -- two independent sources agree, or lifted straight\n                       from a ``mes.known_good`` row already carrying that\n                       confidence for this exact channel.\n* ``SINGLE-SOURCE``  -- one source, including a generic/industry-practice\n                       rule of thumb used as an explicit, named fallback\n                       (never confused with a manufacturer figure).\n* ``UNKNOWN``       -- no sourced number exists; the car's own service\n                       manual / TechAuthority is pointed to instead, and\n                       ``spec`` is prose (\"see service manual\"), never a\n                       guessed number. A numeric ``spec`` is never paired\n                       with ``UNKNOWN`` -- enforced at load time below.\n\nFour read-only lookups, the whole public surface:\n\n* :func:`all_tests`        -- every test, as a list.\n* :func:`test`              -- one test by id, or ``None``.\n* :func:`tests_for_codes`   -- tests whose ``related_codes`` match any of\n                               the given DTCs (prefix match, e.g. \"P0455\"\n                               matches a related_codes entry \"P04\").\n* :func:`tests_for_systems` -- tests touching any of the given\n                               :mod:`mes.systems` system ids.\n\nResearch pass done 2026-10-08, same posture as ``known_good.py``'s own\nresearch-pass note: public sources (OBD-II/repair-reference sites, DOT/SAE\nstandards, this repo's own ``mes.known_good``/``mes.systems`` sourced rows)\nplus explicit, named industry-practice rules of thumb where no\nmanufacturer figure exists. No paywalled/bot-gated FCA TechAuthority\ndocument was read for this pass -- every TechAuthority pointer below is a\n\"go get it\", never a claim that document was read.\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom typing import Any, Optional\n\nfrom .systems import CONFIDENCE_LEVELS, CONFIRMED, CORROBORATED, SINGLE_SOURCE, UNKNOWN\nfrom .systems import SYSTEMS\n\n#: Same wording as the rest of this package's UNKNOWN notes.\nTECHAUTHORITY = \"use the service manual, TechAuthority\"\n\n#: Generic/industry-practice rule-of-thumb source label, named explicitly\n#: per instruction -- never confused with a model-specific or\n#: manufacturer-sourced figure.\nINDUSTRY_PRACTICE = \"industry practice\"\n\nCAR_STATES = (\"KOEO\", \"KOER\", \"cold\", \"hot\", \"driving\", \"key-off\")\n\n#: ``not_done`` is a display-only state (no result recorded yet) -- never a\n#: value a caller posts. :data:`POSTABLE_RESULTS` is what a result-recording\n#: call should validate against.\nRESULTS = (\"pass\", \"fail\", \"inconclusive\", \"not_possible\", \"not_done\")\nPOSTABLE_RESULTS = (\"pass\", \"fail\", \"inconclusive\", \"not_possible\")\n\nCATEGORIES = (\n    \"emissions\", \"intake_boost\", \"cooling\", \"fuel\", \"lubrication\",\n    \"leak_detection\", \"mechanical_engine\", \"ignition\", \"electrical\",\n    \"network\", \"brakes\", \"driveline\", \"exhaust\", \"inspection\",\n)\n\n#: Models this catalogue cross-marks, beyond the Stelvio 2018 2.0T this\n#: catalogue is built for -- every test defaults ``True`` for the Stelvio\n#: (the catalogue's whole reason to exist) and is marked per-test for the\n#: other two.\n_MODELS = (\"stelvio_2.0t_2018\", \"giulia_2.0t\", \"grecale_2.0t\")\n\nTESTS: dict[str, dict[str, Any]] = {}\n\n_ORDER: list[str] = []\n\n\ndef _applies(giulia: bool = True, grecale: bool = True) -> dict[str, bool]:\n    \"\"\"``stelvio_2.0t_2018`` is always ``True`` -- this whole catalogue is\n    built for that car. ``giulia``/``grecale`` default ``True`` (same\n    engine family / Giorgio-derived platform) and are set ``False`` on the\n    few tests that are genuinely Stelvio/FCA-procedure-specific.\"\"\"\n    return {\"stelvio_2.0t_2018\": True, \"giulia_2.0t\": giulia, \"grecale_2.0t\": grecale}\n\n\ndef _pc(parameter: str, spec: Any, unit: str, source: str, confidence: str) -> dict[str, Any]:\n    if confidence not in CONFIDENCE_LEVELS:\n        raise ValueError(f\"bad confidence {confidence!r} for pass_criteria {parameter!r}\")\n    if confidence == UNKNOWN and isinstance(spec, (int, float)):\n        raise ValueError(f\"pass_criteria {parameter!r} has a numeric spec with UNKNOWN \"\n                         \"confidence -- never invent a number\")\n    return {\"parameter\": parameter, \"spec\": spec, \"unit\": unit,\n           \"source\": source, \"confidence\": confidence}\n\n\ndef _t(id_: str, name: str, category: str, systems: list[str], applies_to: dict[str, bool],\n      purpose: str, car_state: str, when_to_use: str, tools: list[str],\n      procedure: list[str], pass_criteria: list[dict[str, Any]], fail_means: str,\n      related_codes: list[str], supports_hypotheses: list[str],\n      refutes_hypotheses: list[str], duration_min: int, safety: str = \"\",\n      hazards: Optional[list[str]] = None) -> None:\n    if id_ in TESTS:\n        raise ValueError(f\"duplicate test id {id_!r}\")\n    if category not in CATEGORIES:\n        raise ValueError(f\"bad category {category!r} for {id_!r}\")\n    for s in systems:\n        if s not in SYSTEMS:\n            raise ValueError(f\"unknown system {s!r} for test {id_!r}\")\n    if car_state not in CAR_STATES:\n        raise ValueError(f\"bad car_state {car_state!r} for {id_!r}\")\n    for key in applies_to:\n        if key not in _MODELS:\n            raise ValueError(f\"unknown model {key!r} in applies_to for {id_!r}\")\n    TESTS[id_] = {\n        \"id\": id_, \"name\": name, \"category\": category, \"systems\": list(systems),\n        \"applies_to\": dict(applies_to), \"purpose\": purpose, \"car_state\": car_state,\n        \"when_to_use\": when_to_use, \"tools\": list(tools), \"procedure\": list(procedure),\n        \"pass_criteria\": list(pass_criteria), \"fail_means\": fail_means,\n        \"related_codes\": list(related_codes), \"supports_hypotheses\": list(supports_hypotheses),\n        \"refutes_hypotheses\": list(refutes_hypotheses), \"duration_min\": duration_min,\n        \"safety\": safety, \"hazards\": list(hazards or []),\n    }\n    _ORDER.append(id_)\n\n\n# ===========================================================================\n# Emissions / EVAP\n# ===========================================================================\n\n_t(\"evap_smoke\", \"EVAP smoke test\", \"emissions\", [\"evap\"], _applies(),\n  purpose=\"Find a leak in the fuel vapor system by filling it with visible/UV smoke \"\n          \"under gentle pressure and watching for where it escapes.\",\n  car_state=\"key-off\",\n  when_to_use=\"P0442/P0455/P0456 or any EVAP small/large leak code, before replacing \"\n              \"any EVAP part on a guess.\",\n  tools=[\"smoke machine\", \"EVAP service port adapter or purge line disconnect\",\n        \"UV light (if using UV dye smoke)\", \"shop light / mirror\"],\n  procedure=[\n      \"Confirm fuel level is in the 15-85% window (vapor space needed to see smoke).\",\n      \"Connect smoke machine to the EVAP system (purge line or service port), low \"\n      \"pressure (~0.5-1 psi / per machine instructions).\",\n      \"Cap the system and let smoke fill for 1-2 minutes.\",\n      \"Inspect gas cap, filler neck, fuel tank seams, EVAP canister, purge/vent valve \"\n      \"connections and hoses for escaping smoke.\",\n      \"Note exact leak location(s); photograph for the job file.\",\n  ],\n  pass_criteria=[_pc(\"visible leak\", \"none found\", \"\", TECHAUTHORITY, UNKNOWN)],\n  fail_means=\"A located, visible leak point identifies the failed component directly \"\n             \"-- no further guessing needed for that leak.\",\n  related_codes=[\"P0442\", \"P0455\", \"P0456\", \"P0457\"],\n  supports_hypotheses=[\"EVAP leak\"], refutes_hypotheses=[\"EVAP leak\"],\n  duration_min=20, safety=\"Use smoke machine per its own manual; do not exceed its \"\n                          \"rated pressure -- EVAP components are not designed for \"\n                          \"boost-level pressure.\",\n  hazards=[\"fuel vapor\"])\n\n_t(\"intake_boost_smoke_leak\", \"Intake/boost leak smoke test\", \"intake_boost\",\n  [\"air_intake_boost\"], _applies(),\n  purpose=\"Find an air leak between the throttle body/MAF and the turbo/intercooler \"\n          \"piping using smoke under light vacuum or low pressure.\",\n  car_state=\"key-off\",\n  when_to_use=\"Rough idle, lean fuel trims, boost-related codes, or a whistle/hiss \"\n              \"under load.\",\n  tools=[\"smoke machine\", \"intake blanking plate or adapter\"],\n  procedure=[\n      \"Block the intake tract at the throttle body (or feed smoke in through a vacuum \"\n      \"port with the engine off).\",\n      \"Fill the tract with smoke at low pressure.\",\n      \"Inspect every clamp, boot, intercooler seam and sensor o-ring for escaping smoke.\",\n      \"Note exact leak location(s).\",\n  ],\n  pass_criteria=[_pc(\"visible leak\", \"none found\", \"\", TECHAUTHORITY, UNKNOWN)],\n  fail_means=\"A located leak point explains lean trims/rough idle/boost loss directly.\",\n  related_codes=[\"P0171\", \"P0101\", \"P0299\", \"P0106\"],\n  supports_hypotheses=[\"intake leak\", \"boost leak\"],\n  refutes_hypotheses=[\"intake leak\", \"boost leak\"],\n  duration_min=20, hazards=[])\n\n_t(\"purge_vent_actuation\", \"EVAP purge/vent solenoid actuation check\", \"emissions\",\n  [\"evap\"], _applies(),\n  purpose=\"Confirm the purge and vent solenoids actually open/close on command, \"\n          \"rather than assuming the commanded state matches reality.\",\n  car_state=\"KOEO\",\n  when_to_use=\"Before condemning a purge or vent valve on a code alone -- commanded \"\n              \"vs. actual state mismatches are a common root cause.\",\n  tools=[\"scan tool with bidirectional control (MCP actuator control)\",\n        \"stethoscope or hand on the valve body\"],\n  procedure=[\n      \"Command the purge solenoid open via the MCP actuator-control interface; \"\n      \"listen/feel for the valve clicking.\",\n      \"Command the vent solenoid closed, then open; listen/feel for each transition.\",\n      \"Read back commanded vs. observed state if the scan tool reports both.\",\n  ],\n  pass_criteria=[_pc(\"actuation on command\", \"valve clicks/moves on each command\",\n                     \"\", TECHAUTHORITY, UNKNOWN)],\n  fail_means=\"A valve that does not actuate on command is the fault, independent of \"\n             \"any smoke result.\",\n  related_codes=[\"P0443\", \"P0446\", \"P0449\", \"P1443\"],\n  supports_hypotheses=[\"EVAP leak\", \"EVAP valve stuck\"],\n  refutes_hypotheses=[\"EVAP valve stuck\"],\n  duration_min=10,\n  safety=\"HTTP surface is read-only; this test is only available through the MCP \"\n         \"actuator-control tool, never through the HTTP job/tests API -- it writes a \"\n         \"live command to the car.\",\n  hazards=[])\n\n_t(\"esim_vacuum_test_a\", \"ESIM vacuum test (Test A)\", \"emissions\", [\"evap\"],\n  _applies(grecale=False),\n  purpose=\"FCA's own leak-detection-pump (ESIM) self-test procedure, Test A -- \"\n          \"exercises the pump's own vacuum/pressure switch logic rather than a \"\n          \"manual smoke fill.\",\n  car_state=\"KOEO\",\n  when_to_use=\"When the EVAP leak-detection pump itself is suspect (no leak found by \"\n              \"smoke, but a P0455/0456 persists), or to corroborate a smoke-test \"\n              \"result.\",\n  tools=[\"scan tool with FCA/Stellantis ESIM test routine support\"],\n  procedure=[\n      \"Confirm fuel level is in the EVAP-verification window (15-85%).\",\n      \"Run the scan tool's ESIM Test A routine per its on-screen steps.\",\n      \"Record the pass/fail result the routine itself reports.\",\n  ],\n  pass_criteria=[_pc(\"ESIM Test A result\", \"see service manual\", \"\",\n                     TECHAUTHORITY, UNKNOWN)],\n  fail_means=\"A failed Test A points at the leak-detection pump assembly itself, not \"\n             \"necessarily a leak elsewhere in the system.\",\n  related_codes=[\"P0455\", \"P0456\", \"P2450\", \"P2451\"],\n  supports_hypotheses=[\"EVAP leak\", \"ESIM signal path\"],\n  refutes_hypotheses=[\"ESIM signal path\"],\n  duration_min=10, hazards=[])\n\n_t(\"evap_test_a_esim_switch\", \"wiTECH Test A: ESIM switch\", \"emissions\", [\"evap\"],\n  _applies(grecale=False),\n  purpose=\"Make the ESIM's vacuum switch close with a hand pump while watching the \"\n          \"ECU's own switch reading in wiTECH 2 -- checks the switch, connector, \"\n          \"wiring and ECU input in one pass without unplugging anything. This is \"\n          \"the next_test for the 'EVAP: ESIM signal path' hypothesis on the Stelvio \"\n          \"ZASFAKPN5J7B88115 EVAP case (three clean smoke tests, every EVAP part \"\n          \"new, P0440/P0455/P0456 still return).\",\n  car_state=\"KOEO\",\n  when_to_use=\"EVAP system already smoke-tested sealed and every EVAP part is new, \"\n              \"yet P0440/P0455/P0456 keep returning -- run this before the ESIM \"\n              \"wiring test or any further parts purchase, right after the wiTECH \"\n              \"flash check.\",\n  tools=[\"wiTECH 2 account, laptop and interface\",\n        \"hand vacuum pump with a short hose that fits the ESIM's canister-side port\",\n        \"flat trim tool and torch for the driver-side rear wheel liner\"],\n  procedure=[\n      \"Park, engine off and cool, park brake on; disconnect MultiEcuScan/cuore so \"\n      \"only wiTECH is on the OBD port.\",\n      \"Open the driver-side rear wheel liner; find the ESIM on the vent side of the \"\n      \"canister. Leave it plugged in; identify its canister-side and fresh-air hoses.\",\n      \"Connect wiTECH, ignition RUN, engine off; sign in, select the vehicle, \"\n      \"confirm VIN ZASFAKPN5J7B88115.\",\n      \"Topology > ECM > live data; search for the ESIM/EVAP pressure or leak-\"\n      \"detection switch parameter (words: ESIM, EVAP, leak, pressure switch, NVLD) \"\n      \"and add fuel level too. If no such parameter exists, note it and fall back \"\n      \"to the ESIM wiring test's meter-based Test B.\",\n      \"Baseline: nothing on the ESIM hose -- record the switch state (expect open).\",\n      \"Disconnect the canister-side hose, fit the hand pump, pump slowly and watch \"\n      \"for wiTECH to show closed; hold ~30 s, then release and confirm it reopens. \"\n      \"Repeat three times, noting any delay.\",\n      \"While held closed with vacuum, gently flex the ESIM connector and harness \"\n      \"along the wheel well; any flicker to open is an intermittent connection.\",\n      \"Release vacuum, refit the hose and liner, ignition OFF, disconnect wiTECH. \"\n      \"Do not clear codes.\",\n  ],\n  pass_criteria=[_pc(\n      \"ESIM/EVAP switch parameter in wiTECH, under hand vacuum\",\n      \"closes with vacuum, holds closed about 30 s, reopens on release, every run, \"\n      \"no flicker on wiggle\",\n      \"\", \"Stelvio wiTECH Test A - ESIM Switch (repo procedure for VIN \"\n          \"ZASFAKPN5J7B88115 -- the exact wiTECH parameter name and switch \"\n          \"threshold are not from an FCA document; search for the parameter and \"\n          \"apply vacuum gently per the sheet)\", UNKNOWN)],\n  fail_means=\"Never changes: the ECU does not see the switch -- go to the ESIM \"\n             \"wiring test. Changes but flickers on wiggle: intermittent connector \"\n             \"or harness fault -- same sheet, steps B1/B5. Closes, holds and \"\n             \"reopens cleanly every time with no flicker: the whole signal path \"\n             \"(switch, connector, wiring, ECU input) works, which moves the case to \"\n             \"the wiTECH flash check / ECM calibration.\",\n  related_codes=[\"P0440\", \"P0455\", \"P0456\"],\n  supports_hypotheses=[\"EVAP: ESIM signal path\", \"EVAP: ECM calibration\"],\n  refutes_hypotheses=[\"EVAP: ESIM signal path\"],\n  duration_min=20,\n  safety=\"Apply vacuum gently by hand; never use shop air on the ESIM. Fuel vapor \"\n         \"at the canister/wheel well -- no sparks or open flame.\",\n  hazards=[\"fuel vapor\"])\n\n_t(\"esim_bench_test\", \"ESIM bench test\", \"emissions\", [\"evap\"],\n  _applies(grecale=False),\n  purpose=\"Bench-check the ESIM's vacuum switch, internal seal and pressure relief \"\n          \"off the car, against a new unit where possible, to decide whether the \"\n          \"ESIM itself (rather than its wiring or the ECM) is at fault.\",\n  car_state=\"key-off\",\n  when_to_use=\"After wiTECH Test A shows the switch never closes, or changes only \"\n              \"sluggishly/at high vacuum -- before condemning the ESIM on the scan \"\n              \"tool reading alone.\",\n  tools=[\"multimeter (ohms/continuity)\", \"hand vacuum pump with short hose\",\n        \"low-range vacuum gauge or a water manometer\", \"rubber vacuum caps\",\n        \"flat trim tool and torch\", \"a new ESIM for side-by-side comparison \"\n        \"(optional but best)\"],\n  procedure=[\n      \"Remove the driver-side rear wheel liner; ignition off; unplug the ESIM \"\n      \"connector and inspect it for corrosion, water, bent pins or a loose lock.\",\n      \"Remove the ESIM or free both hoses, marking which port faces the canister \"\n      \"and which faces fresh air.\",\n      \"Meter across the switch terminals at atmospheric pressure: expect open \"\n      \"(OL / no continuity).\",\n      \"Apply gentle vacuum to the canister-side port (fresh-air side open): the \"\n      \"switch should close at a small vacuum, hold with the vacuum steady, and \"\n      \"reopen on release.\",\n      \"Apply gentle low pressure to the canister-side port: it should vent through \"\n      \"to the fresh-air side rather than holding.\",\n      \"With the meter connected and the switch held closed, tap the body and \"\n      \"wiggle the terminals, watching for a flickering or dropped-out reading.\",\n  ],\n  pass_criteria=[_pc(\n      \"ESIM bench behavior (rest / vacuum close / hold / release / relief / tap)\",\n      \"matches a new ESIM at every step; no factory threshold is published for \"\n      \"this part\",\n      \"\", \"Stelvio ESIM Bench Test (repo procedure; FCA bulletin 9100469 confirms \"\n          \"the ESIM is a separate, individually replaceable part, but publishes \"\n          \"no bench-test procedure, switch threshold or pinout)\", UNKNOWN)],\n  fail_means=\"Switch never closes, vacuum bleeds away once closed, closes only at \"\n             \"much higher vacuum than a new unit, or the reading flickers when \"\n             \"tapped: the ESIM itself is the fault -- replace only the ESIM \"\n             \"(FCA bulletin 9100469). Behaves like a new unit on every step: the \"\n             \"ESIM is exonerated and the case moves to its wiring or the ECM \"\n             \"calibration.\",\n  related_codes=[\"P0440\", \"P0455\", \"P0456\"],\n  supports_hypotheses=[\"EVAP: ESIM signal path\", \"EVAP: ECM calibration\"],\n  refutes_hypotheses=[\"EVAP: ESIM signal path\"],\n  duration_min=30,\n  safety=\"Work outdoors or ventilated, away from sparks/flame; ignition OFF before \"\n         \"unplugging; apply vacuum/pressure gently -- never shop air, which can \"\n         \"damage the diaphragm.\",\n  hazards=[\"fuel vapor\"])\n\n_t(\"esim_wiring_test\", \"ESIM wiring test\", \"electrical\", [\"evap\", \"electrical_supply\"],\n  _applies(grecale=False),\n  purpose=\"Trace the ESIM switch's signal and ground circuit from the ESIM \"\n          \"connector to the ECM -- connector condition, signal reference voltage, \"\n          \"ground, end-to-end resistance and a jumper test -- to localise a fault \"\n          \"that wiTECH Test A showed but a bench test of the ESIM itself cleared.\",\n  car_state=\"KOEO\",\n  when_to_use=\"Run only after the wiTECH flash check and Test A: if Test A never \"\n              \"changes or flickers, and no ESIM circuit DTC (e.g. P24D6) has set \"\n              \"(pointing at intermittent/high-resistance rather than a clean \"\n              \"break), this sheet isolates where in the circuit the fault is.\",\n  tools=[\"digital multimeter with back-probe pins or a breakout lead\",\n        \"hand vacuum pump and short hose\", \"fused jumper lead (low-amp fuse)\",\n        \"the FCA wiring diagram for this VIN (connector/pin IDs, wire colours, \"\n        \"reference voltage -- fill in before testing; see the Stelvio ESIM \"\n        \"Wiring Diagram Lookup sheet)\"],\n  procedure=[\n      \"B1 Connector: ignition OFF, unplug the ESIM; check for corrosion, water, \"\n      \"bent/pushed-back pins, loose terminal grip, and harness chafe at the \"\n      \"wheel-well edge.\",\n      \"B2 Signal reference: connector unplugged, ignition RUN; harness-side signal \"\n      \"pin to chassis ground should read the diagram's reference voltage (0 V = \"\n      \"open/not driven; battery voltage where a low reference is expected = short \"\n      \"to power).\",\n      \"B3 Ground: harness-side ground pin to battery negative -- near 0 V \"\n      \"(ignition RUN) and a few ohms or less (ignition OFF).\",\n      \"B4 End to end: battery negative disconnected, ECU connector unplugged; each \"\n      \"wire ESIM pin to ECU pin should read a fraction of an ohm (several ohms = \"\n      \"high resistance, OL = break); each wire to ground/B+ should be open. \"\n      \"Reconnect ECU, battery last.\",\n      \"B5 Jumper: battery on, ignition RUN, ESIM unplugged, wiTECH ECM data \"\n      \"display open; fused jumper from signal pin to ground pin (what a closed \"\n      \"switch does) should make wiTECH show closed; wiggle the harness while \"\n      \"watching for a flicker.\",\n  ],\n  pass_criteria=[_pc(\n      \"ESIM signal/ground circuit (B2-B5) against the FCA wiring diagram for \"\n      \"this VIN\",\n      \"see the FCA wiring diagram for this VIN -- pin IDs, wire colours and \"\n      \"reference voltage are not published in this catalogue\", \"\",\n      TECHAUTHORITY, UNKNOWN)],\n  fail_means=\"B5 stays open with a good B2-B4: fault is in the ECU input itself. \"\n             \"B2/B3/B4 out of range: open, short or high resistance in that \"\n             \"circuit -- repair with an FCA-approved terminal/splice repair. \"\n             \"Flicker on wiggle: intermittent connector or chafe point. B5 shows \"\n             \"closed while Test A failed: wiring and ECU input are good and the \"\n             \"ESIM switch/contacts are the fault -- bench-test or replace.\",\n  related_codes=[\"P0440\", \"P0455\", \"P0456\"],\n  supports_hypotheses=[\"EVAP: ESIM signal path\"],\n  refutes_hypotheses=[\"EVAP: ESIM signal path\"],\n  duration_min=40,\n  safety=\"Back-probe only, never spread terminals; battery negative OFF before \"\n         \"unplugging the ECU; use a fused jumper; fuel vapor at the canister -- \"\n         \"no sparks.\",\n  hazards=[\"fuel vapor\", \"electrical\"])\n\n_t(\"witech_flash_check\", \"wiTECH ECM flash check\", \"emissions\", [\"evap\"],\n  _applies(grecale=False),\n  purpose=\"Compare the ECM's Current ECU Part Number against wiTECH's New ECU Part \"\n          \"Number on the Flash tab to decide, in minutes, whether an EVAP-relevant \"\n          \"calibration update is even outstanding before chasing hardware.\",\n  car_state=\"KOEO\",\n  when_to_use=\"First decisive step on the EVAP fault tree once smoke tests show the \"\n              \"system sealed -- before wiTECH Test A, the ESIM bench test or the \"\n              \"wiring test, since a 'different' result sends the case straight to \"\n              \"the ECM flash repair instead.\",\n  tools=[\"wiTECH 2 account, laptop and MicroPod II (or wiTECH-supported) interface\",\n        \"stand-alone voltmeter\"],\n  procedure=[\n      \"Connect the wiTECH interface; ignition RUN, engine off.\",\n      \"Sign in to wiTECH 2, select the vehicle, confirm the VIN.\",\n      \"Topology > ECM > Flash tab.\",\n      \"Compare Current ECU Part Number with New ECU Part Number; record both.\",\n  ],\n  pass_criteria=[_pc(\n      \"ECM Current ECU Part Number vs New ECU Part Number on the wiTECH Flash tab\",\n      \"Current already equals New -- the ECM is on the latest calibration in the \"\n      \"18-030-17-family flash\",\n      \"\", \"TSB 18-030-17 REV. B (PCM flash family whose fixed-DTC lists include \"\n          \"P0440/P0441/P0455/P0456; applies to Giulia/Stelvio) -- compared \"\n          \"against the wiTECH Flash tab reading taken on this VIN\", CONFIRMED)],\n  fail_means=\"Current differs from New: a newer calibration exists and has not \"\n             \"been applied -- proceed to the ECM flash repair step before any \"\n             \"further EVAP hardware is condemned. Current equals New and the \"\n             \"codes still return: the software lead is closed -- proceed to \"\n             \"wiTECH Test A.\",\n  related_codes=[\"P0440\", \"P0455\", \"P0456\"],\n  supports_hypotheses=[\"EVAP: ECM calibration\"],\n  refutes_hypotheses=[\"EVAP: ECM calibration\"],\n  duration_min=10, hazards=[])\n\n_t(\"ecm_flash\", \"ECM flash procedure (wiTECH)\", \"emissions\", [\"evap\"],\n  _applies(giulia=False, grecale=False),\n  purpose=\"Repair step, not a diagnostic test: reprogram the PCM to the newest \"\n          \"calibration, then run the PROXI Alignment and Phonic Wheel Replacement \"\n          \"routines the flash requires, exactly as FCA's own dealer instructions \"\n          \"specify for this car.\",\n  car_state=\"KOEO\",\n  when_to_use=\"Only after the wiTECH flash check finds Current ECU Part Number \"\n              \"different from New -- this is the fix, run once that check says a \"\n              \"newer calibration exists.\",\n  tools=[\"wiTECH 2 account, laptop and MicroPod II (or wiTECH-supported) interface\",\n        \"battery charger/maintainer able to hold 13.2-13.5 V\",\n        \"stand-alone voltmeter (not the charger's own meter)\"],\n  procedure=[\n      \"Connect a charger and confirm 13.2-13.5 V at the battery with a stand-alone \"\n      \"voltmeter; keep it there for the whole procedure.\",\n      \"Connect the wiTECH interface; ignition RUN, engine off; sign in, select the \"\n      \"vehicle, confirm the VIN.\",\n      \"Topology > ECM > Flash tab; confirm Current differs from New (if not, stop \"\n      \"-- nothing to flash).\",\n      \"Accept the flash agreement, select Flash ECU, follow the on-screen steps to \"\n      \"completion (about 8 minutes); watch the voltmeter throughout and never \"\n      \"interrupt the flash -- if it aborts, restart it.\",\n      \"BCM > Misc. Functions > PROXI Alignment.\",\n      \"View DTCs; Topology > Action Items > All DTCs > Clear All DTCs (the flash \"\n      \"sets codes in other modules -- expected).\",\n      \"ECM > Misc. Functions > Phonic Wheel Replacement, to completion -- if \"\n      \"skipped or done wrong, DTC P1300 stays active.\",\n      \"Clear All DTCs again; re-open the ECM Flash tab and confirm Current now \"\n      \"equals New.\",\n      \"BCM Flash tab: update the BCM too if its Current differs from New.\",\n      \"Ignition OFF, disconnect wiTECH, remove the charger.\",\n  ],\n  pass_criteria=[_pc(\n      \"ECM Current ECU Part Number after the flash, plus PROXI Alignment and \"\n      \"Phonic Wheel Replacement completion\",\n      \"Current equals New; both routines completed; no P1300 after the flash\",\n      \"\", \"FCA US LLC Customer Satisfaction Notification W05 (March 2020) and \"\n          \"TSB 18-026-20 (March 25, 2020), 2018 GU Stelvio 2.0L EC2\", CONFIRMED)],\n  fail_means=\"Flash does not complete, P1300 sets (Phonic Wheel step missed or \"\n             \"wrong), or P0440/P0455/P0456 return after several verification \"\n             \"drives (fuel 15-85%, cold starts) with the ECM now current -- the \"\n             \"ECM calibration hypothesis is then disconfirmed for this code \"\n             \"family and the case returns to the ESIM signal path.\",\n  related_codes=[\"P0440\", \"P0455\", \"P0456\"],\n  supports_hypotheses=[\"EVAP: ECM calibration\"],\n  refutes_hypotheses=[\"EVAP: ECM calibration\"],\n  duration_min=45,\n  safety=\"Battery charger must hold 13.2-13.5 V for the whole flash (add electrical \"\n         \"load, e.g. lights/blower, if it reads high); never interrupt the flash; \"\n         \"only the wiTECH interface on the OBD port.\",\n  hazards=[\"electrical\"])\n\n_t(\"evap_mode06_review\", \"EVAP Mode $06 review\", \"emissions\", [\"evap\"],\n  _applies(),\n  purpose=\"Read-only interpretation of the ECU's own on-board EVAP monitor test \"\n          \"results (OBDMIDs 0x39/0x3A/0x3C/0x3D) against its own stored pass/fail \"\n          \"limits, rather than a binary DTC -- turns 'no code yet' into 'test ran, \"\n          \"measured X against limit Y', without substituting any number of this \"\n          \"catalogue's own.\",\n  car_state=\"KOEO\",\n  when_to_use=\"Alongside or after the other EVAP tests, whenever a from-car Mode \"\n              \"$06 read is available, to see the ECU's own measured leak-test \"\n              \"values rather than only the DTC bucket.\",\n  tools=[\"MCP obd2 read_mode06 tool, or cuore's /live/obd/mode06 route \"\n        \"(cuore.live.mode06) -- read-only, no actuation\"],\n  procedure=[\n      \"Confirm the car has driven since the last code clear, with fuel in the \"\n      \"15-85% window and at least one cold start, so the EVAP monitors have had \"\n      \"a chance to run.\",\n      \"Run Mode 06 (MCP obd2 read_mode06, or GET /live/obd/mode06) over the OBD \"\n      \"port.\",\n      \"Read OBDMID 0x39 (EVAP monitor, cap off / gross leak), 0x3A (0.090\\\" leak), \"\n      \"0x3C (0.020\\\" leak) and 0x3D (EVAP purge flow monitor) -- each record's \"\n      \"measured value and its own min/max limits exactly as the ECU reports them.\",\n      \"Note which MIDs responded with data, which came back NO DATA, and which \"\n      \"got a negative response (not supported) -- never guess a missing one.\",\n      \"Read the result together with the active/pending/permanent DTCs for the \"\n      \"same drive cycle, not alone.\",\n  ],\n  pass_criteria=[_pc(\n      \"EVAP OBDMID 0x39/0x3A/0x3C/0x3D measured value vs. min/max limit\",\n      \"limits come from the car -- read the ECU's own min/max fields in the Mode \"\n      \"$06 reply; no figure is published in this catalogue\",\n      \"\", \"SAE J1979 Appendix D / ISO 15031-5 OBDMID definitions \"\n          \"(cuore.live.mode06.OBDMID_NAMES); numeric limits are the ECU's own, \"\n          \"not a document figure\", UNKNOWN)],\n  fail_means=\"A MID whose measured value falls outside its own reported min/max \"\n             \"window is a failed on-board monitor for that leak size or purge \"\n             \"flow -- corroborating evidence either for an active leak (ESIM \"\n             \"signal path) or for a calibration-level false fail, never decisive \"\n             \"alone.\",\n  related_codes=[\"P0440\", \"P0455\", \"P0456\"],\n  supports_hypotheses=[\"EVAP: ESIM signal path\", \"EVAP: ECM calibration\"],\n  refutes_hypotheses=[\"EVAP: ESIM signal path\", \"EVAP: ECM calibration\"],\n  duration_min=10, hazards=[])\n\n_t(\"fuel_trim_o2_observation\", \"Fuel trim / O2 sensor observation\", \"fuel\",\n  [\"fuel\", \"engine_management\"], _applies(),\n  purpose=\"Watch live short/long-term fuel trim and O2 sensor voltage to spot a lean \"\n          \"or rich condition and whether the O2 sensor is actively switching.\",\n  car_state=\"hot\",\n  when_to_use=\"Any suspected intake/EVAP/fuel-delivery leak, or a misfire with no \"\n              \"obvious mechanical cause -- read before and after a repair to confirm \"\n              \"trims recovered.\",\n  tools=[\"scan tool (live PIDs)\"],\n  procedure=[\n      \"Warm engine to closed-loop operation.\",\n      \"Record short- and long-term fuel trim, bank 1 (and bank 2 if the platform \"\n      \"reports it) at idle and at a steady 2000 rpm.\",\n      \"Record O2 sensor voltage; confirm it is actively switching, not static.\",\n  ],\n  pass_criteria=[\n      _pc(\"short_fuel_trim_b1\", [-10, 10], \"%\",\n         \"https://www.obd-codes.com/faq/fuel-trims.php\", CORROBORATED),\n      _pc(\"long_fuel_trim_b1\", [-10, 10], \"%\",\n         \"https://www.obd-codes.com/faq/fuel-trims.php\", CORROBORATED),\n      _pc(\"o2_b1s1_voltage switching\", \"actively cycling ~0.1-0.9 V, not static\", \"V\",\n         \"https://www.fluke.com/en-us/learn/blog/digital-multimeters/\"\n         \"how-to-monitor-oxygen-sensor-voltage-with-a-multimeter\", CORROBORATED),\n  ],\n  fail_means=\"Trim beyond roughly +/-20% (same generic band) or a static O2 voltage \"\n             \"points at an unmetered air/fuel leak or a failing sensor, not yet \"\n             \"isolated to a part.\",\n  related_codes=[\"P0171\", \"P0172\", \"P0174\", \"P0175\", \"P0300\"],\n  supports_hypotheses=[\"intake leak\", \"EVAP leak\", \"fuel delivery fault\"],\n  refutes_hypotheses=[\"intake leak\", \"fuel delivery fault\"],\n  duration_min=10, hazards=[])\n\n_t(\"misfire_counters\", \"Misfire counter review\", \"ignition\",\n  [\"ignition\", \"engine_management\"], _applies(),\n  purpose=\"Read the ECM's per-cylinder misfire counters to see which cylinder(s) are \"\n          \"actually misfiring, rather than guessing from a generic P0300.\",\n  car_state=\"driving\",\n  when_to_use=\"P0300 or any per-cylinder misfire code, before swapping coils/plugs/\"\n              \"injectors.\",\n  tools=[\"scan tool (Mode $06 or manufacturer-specific misfire data)\"],\n  procedure=[\n      \"Clear counters if the tool allows, or note current values.\",\n      \"Drive through the condition that triggers the complaint (idle, load, cruise).\",\n      \"Read counters again; compare per-cylinder counts.\",\n  ],\n  pass_criteria=[_pc(\"misfire count\", \"0 or negligible, evenly low across cylinders\",\n                     \"counts\", TECHAUTHORITY, UNKNOWN)],\n  fail_means=\"One cylinder dominating the count points at that cylinder's ignition/\"\n             \"injector/mechanical path; counts spread evenly across all cylinders \"\n             \"points at a common-cause fault (fuel pressure, vacuum leak).\",\n  related_codes=[\"P0300\", \"P0301\", \"P0302\", \"P0303\", \"P0304\"],\n  supports_hypotheses=[\"misfire, single cylinder\", \"misfire, all cylinders\"],\n  refutes_hypotheses=[],\n  duration_min=15, hazards=[])\n\n# ===========================================================================\n# Cooling\n# ===========================================================================\n\n_t(\"cooling_system_pressure_test\", \"Cooling system pressure test\", \"cooling\",\n  [\"cooling\"], _applies(),\n  purpose=\"Pressurize the cooling system cold to find external leaks (hoses, \"\n          \"radiator, water pump, head gasket externally) without running the engine.\",\n  car_state=\"cold\",\n  when_to_use=\"Any coolant loss with no visible puddle, low-coolant warning, or \"\n              \"before condemning a head gasket on overheating alone.\",\n  tools=[\"cooling system pressure tester with radiator-cap adapter\"],\n  procedure=[\n      \"Engine cold. Remove cap, fit the pressure tester.\",\n      \"Pump to the cap's rated pressure (see cap markings / service manual).\",\n      \"Hold for 2 minutes; watch the gauge and every hose/fitting/the water pump \"\n      \"weep hole.\",\n      \"A pressure drop with no visible external leak raises suspicion of an internal \"\n      \"leak (head gasket, cracked head/block) -- follow with the block (combustion-\"\n      \"gas) test.\",\n  ],\n  pass_criteria=[_pc(\"pressure drop over 2 min\", \"<10%\", \"%\", INDUSTRY_PRACTICE,\n                     SINGLE_SOURCE)],\n  fail_means=\"A visible external leak identifies the failed part directly; a drop \"\n             \"with no visible leak is evidence for an internal leak.\",\n  related_codes=[\"P0217\"],\n  supports_hypotheses=[\"coolant loss\", \"head gasket\"],\n  refutes_hypotheses=[\"head gasket\"],\n  duration_min=20, safety=\"Cooling system may still be warm/pressurized from a prior \"\n                          \"drive -- let it cool fully before opening.\",\n  hazards=[\"hot coolant\"])\n\n_t(\"radiator_cap_test\", \"Radiator cap pressure test\", \"cooling\", [\"cooling\"], _applies(),\n  purpose=\"Confirm the cap itself holds its rated pressure before condemning the \"\n          \"system -- a weak cap causes coolant loss/boil-over that looks like a \"\n          \"system leak.\",\n  car_state=\"cold\",\n  when_to_use=\"Coolant loss with no obvious system leak, or before reusing a cap \"\n              \"after any other cooling work.\",\n  tools=[\"cooling system pressure tester with cap adapter\"],\n  procedure=[\n      \"Fit the cap alone to the tester's cap adapter.\",\n      \"Pump until the cap releases; read the release pressure.\",\n      \"Compare to the cap's own rated/stamped pressure.\",\n  ],\n  pass_criteria=[_pc(\"release pressure vs. rated\", \"see service manual / cap marking\",\n                     \"\", TECHAUTHORITY, UNKNOWN)],\n  fail_means=\"A cap that releases well below its rated pressure is the leak/boil-\"\n             \"over cause by itself -- replace it before re-testing the system.\",\n  related_codes=[\"P0217\"],\n  supports_hypotheses=[\"coolant loss\"], refutes_hypotheses=[\"coolant loss\"],\n  duration_min=5, hazards=[\"hot coolant\"])\n\n_t(\"coolant_block_test\", \"Coolant combustion-gas (block) test\", \"cooling\",\n  [\"cooling\", \"engine_management\"], _applies(),\n  purpose=\"Chemically detect combustion gases (CO2) bubbling into the coolant -- the \"\n          \"classic head-gasket/cracked-head check.\",\n  car_state=\"hot\",\n  when_to_use=\"Suspected internal coolant leak (white exhaust smoke, chronic \"\n              \"overheating, coolant loss with no external leak, oil/coolant cross-\"\n              \"contamination).\",\n  tools=[\"block tester (combustion-leak detection fluid + bulb)\"],\n  procedure=[\n      \"Engine warm, coolant level correct.\",\n      \"Fit the tester over the radiator/expansion-tank neck, below the fill line, \"\n      \"without touching coolant.\",\n      \"Squeeze the bulb to draw vapor through the fluid; run the engine at idle/\"\n      \"light load for the tool's specified time.\",\n      \"Watch the fluid colour change (blue -> yellow typically indicates CO2 present).\",\n  ],\n  pass_criteria=[_pc(\"fluid colour change\", \"no change (stays blue/green)\", \"\",\n                     TECHAUTHORITY, UNKNOWN)],\n  fail_means=\"A positive colour change is strong evidence of combustion gas in the \"\n             \"coolant -- head gasket or cracked head/block, not a hose/radiator leak.\",\n  related_codes=[\"P0217\"],\n  supports_hypotheses=[\"head gasket\"], refutes_hypotheses=[\"head gasket\"],\n  duration_min=10, hazards=[\"hot coolant\", \"hot engine surfaces\"])\n\n# ===========================================================================\n# Fuel\n# ===========================================================================\n\n_t(\"fuel_pressure_test\", \"Fuel pressure test (low side + high side)\", \"fuel\",\n  [\"fuel\"], _applies(),\n  purpose=\"Confirm the low-pressure (tank-to-pump) and high-pressure (direct-\"\n          \"injection rail) fuel systems are each within spec, read live rather than \"\n          \"assumed from a code.\",\n  car_state=\"KOER\",\n  when_to_use=\"Hard start, stumble under load, lean trims with no leak found, or any \"\n              \"fuel-pressure-related code.\",\n  tools=[\"scan tool (live fuel pressure PIDs, low and high side)\",\n        \"mechanical fuel pressure gauge (low side, if the PID is suspect)\"],\n  procedure=[\n      \"Low side: read the scan-tool low-pressure PID at idle and under load; cross-\"\n      \"check with a mechanical gauge at the test port if the PID reading is in \"\n      \"doubt.\",\n      \"High side: read the DI rail pressure PID at idle, under load, and watch its \"\n      \"response during a quick throttle blip.\",\n      \"Compare both to spec (see service manual -- this platform's DI rail target \"\n      \"varies with load and is not a single fixed number).\",\n  ],\n  pass_criteria=[_pc(\"low-side pressure\", \"see service manual\", \"\", TECHAUTHORITY,\n                     UNKNOWN),\n                _pc(\"high-side (DI rail) pressure\", \"see service manual\", \"\",\n                    TECHAUTHORITY, UNKNOWN)],\n  fail_means=\"Low side out of spec points at the in-tank pump/filter/regulator; \"\n             \"high side out of spec (with a good low side) points at the high-\"\n             \"pressure pump or rail components.\",\n  related_codes=[\"P0087\", \"P0088\", \"P0191\", \"P0192\", \"P0193\", \"P1093\"],\n  supports_hypotheses=[\"fuel delivery fault\"], refutes_hypotheses=[\"fuel delivery fault\"],\n  duration_min=20, safety=\"Direct-injection rail pressure is very high -- never \"\n                          \"loosen a high-pressure fitting with the system \"\n                          \"pressurized or the engine running.\",\n  hazards=[\"fuel pressure\", \"fuel\"])\n\n_t(\"injector_balance_test\", \"Injector balance / contribution test\", \"fuel\",\n  [\"fuel\", \"engine_management\"], _applies(),\n  purpose=\"Compare each injector's actual contribution to combustion (via fuel \"\n          \"trim shift or a dedicated balance-test routine) to find a weak or \"\n          \"clogged injector.\",\n  car_state=\"KOER\",\n  when_to_use=\"A misfire isolated to one cylinder after ignition components are \"\n              \"already confirmed good.\",\n  tools=[\"scan tool with injector balance/contribution test support\"],\n  procedure=[\n      \"Run the scan tool's injector balance/contribution routine if the platform \"\n      \"supports it (cuts each injector in turn, measures RPM drop or fuel-trim \"\n      \"shift).\",\n      \"If no dedicated routine exists, swap the suspect injector with a known-good \"\n      \"one and see if the misfire follows the part.\",\n  ],\n  pass_criteria=[_pc(\"contribution across cylinders\", \"even across all cylinders\", \"\",\n                     TECHAUTHORITY, UNKNOWN)],\n  fail_means=\"One cylinder contributing noticeably less (or the misfire following \"\n             \"the swapped part) identifies that injector.\",\n  related_codes=[\"P0301\", \"P0302\", \"P0303\", \"P0304\", \"P0263\", \"P0266\"],\n  supports_hypotheses=[\"misfire, single cylinder\"], refutes_hypotheses=[],\n  duration_min=20, hazards=[\"fuel pressure\"])\n\n# ===========================================================================\n# Lubrication\n# ===========================================================================\n\n_t(\"oil_pressure_test\", \"Oil pressure test (PID + mechanical gauge)\", \"lubrication\",\n  [\"lubrication\"], _applies(),\n  purpose=\"Confirm actual oil pressure rather than trusting a low-oil-pressure \"\n          \"warning or a suspect sender/PID alone.\",\n  car_state=\"hot\",\n  when_to_use=\"Low oil pressure warning/code, knocking noise, or before any major \"\n              \"engine work to establish a baseline.\",\n  tools=[\"scan tool (oil pressure PID, if supported)\",\n        \"mechanical oil pressure gauge (adapts to the sender port)\"],\n  procedure=[\n      \"Warm engine to normal operating temperature.\",\n      \"Read the scan-tool oil pressure PID at idle and at a steady 2500-3000 rpm, \"\n      \"if the ECM reports one.\",\n      \"Cross-check with a mechanical gauge at the sender port -- the PID can be \"\n      \"wrong if the sender itself is marginal.\",\n  ],\n  pass_criteria=[_pc(\"oil pressure, hot idle and 3000 rpm\", \"see service manual\", \"\",\n                     TECHAUTHORITY, UNKNOWN)],\n  fail_means=\"Low pressure confirmed on the mechanical gauge (not just the PID) \"\n             \"points at the pump, bearings, or oil pickup/level -- a genuine \"\n             \"mechanical concern, stop driving the car until resolved.\",\n  related_codes=[\"P0520\", \"P0521\", \"P0522\", \"P0523\"],\n  supports_hypotheses=[\"low oil pressure\"], refutes_hypotheses=[\"low oil pressure\"],\n  duration_min=15, safety=\"A confirmed low mechanical reading means the engine \"\n                          \"should not be driven further until the cause is found.\",\n  hazards=[\"hot engine surfaces\", \"hot oil\"])\n\n_t(\"oil_uv_dye_leak\", \"Oil UV-dye leak test\", \"leak_detection\",\n  [\"lubrication\"], _applies(),\n  purpose=\"Find the exact source of an external oil leak using UV dye and a UV \"\n          \"light, instead of guessing from a general wet-underside appearance.\",\n  car_state=\"driving\",\n  when_to_use=\"Any oil leak where the source isn't obvious from a visual alone.\",\n  tools=[\"UV dye (oil-compatible)\", \"UV light\", \"shop light\"],\n  procedure=[\n      \"Add the manufacturer-specified amount of UV dye to the oil (or use pre-dyed \"\n      \"oil).\",\n      \"Drive the car normally for a day or more to circulate the dye and let the \"\n      \"leak show.\",\n      \"With the car on a lift, scan every seal/gasket/fitting with the UV light in \"\n      \"a darkened area.\",\n      \"Note the exact glowing point(s); clean and re-check after the repair to \"\n      \"confirm the leak stopped.\",\n  ],\n  pass_criteria=[_pc(\"UV glow at seal/gasket\", \"none found\", \"\", TECHAUTHORITY, UNKNOWN)],\n  fail_means=\"A glowing point identifies the exact leaking seal/gasket/fitting.\",\n  related_codes=[], supports_hypotheses=[\"oil leak\"], refutes_hypotheses=[\"oil leak\"],\n  duration_min=30, hazards=[\"hot oil\", \"UV light exposure -- wear UV-blocking glasses\"])\n\n# ===========================================================================\n# Cooling / A-C leak detection\n# ===========================================================================\n\n_t(\"coolant_uv_dye_leak\", \"Coolant UV-dye leak test\", \"leak_detection\",\n  [\"cooling\"], _applies(),\n  purpose=\"Find the exact source of a coolant leak using UV dye, especially a slow \"\n          \"leak with no visible puddle.\",\n  car_state=\"driving\",\n  when_to_use=\"Coolant loss with no leak found by the pressure test, or to confirm a \"\n              \"repair stopped a known small leak.\",\n  tools=[\"UV dye (coolant-compatible)\", \"UV light\"],\n  procedure=[\n      \"Add UV dye to the coolant per the dye manufacturer's dosage.\",\n      \"Drive/idle the car through a full warm-up and cool-down cycle to circulate \"\n      \"the dye.\",\n      \"Inspect every hose, clamp, radiator seam, heater core and water pump with \"\n      \"the UV light.\",\n      \"Note the exact glowing point(s).\",\n  ],\n  pass_criteria=[_pc(\"UV glow at hose/seam/pump\", \"none found\", \"\", TECHAUTHORITY,\n                     UNKNOWN)],\n  fail_means=\"A glowing point identifies the exact leaking component.\",\n  related_codes=[\"P0217\"], supports_hypotheses=[\"coolant loss\"],\n  refutes_hypotheses=[\"coolant loss\"], duration_min=30,\n  hazards=[\"hot coolant\", \"UV light exposure -- wear UV-blocking glasses\"])\n\n_t(\"ac_uv_dye_leak_and_pressures\", \"A/C UV-dye leak test and system pressures\",\n  \"leak_detection\", [\"hvac\"], _applies(),\n  purpose=\"Find a refrigerant leak with UV dye and confirm the A/C system's high/\"\n          \"low-side pressures are within spec for ambient conditions.\",\n  car_state=\"driving\",\n  when_to_use=\"Weak or no A/C cooling, or a low-refrigerant warning.\",\n  tools=[\"UV dye (A/C-compatible, pre-charged in refrigerant or injected)\", \"UV light\",\n        \"manifold gauge set\"],\n  procedure=[\n      \"Connect the manifold gauge set to the high- and low-side service ports.\",\n      \"Run the A/C on max cold, record high- and low-side pressures against the \"\n      \"pressure/temperature chart for the ambient temperature.\",\n      \"If dye is already in the system (or inject it), run the system, then scan \"\n      \"every fitting/condenser/evaporator-drain area with the UV light.\",\n  ],\n  pass_criteria=[\n      _pc(\"high/low side pressure vs. P/T chart\", \"see service manual / refrigerant \"\n          \"P-T chart\", \"\", TECHAUTHORITY, UNKNOWN),\n      _pc(\"UV glow at fitting/component\", \"none found\", \"\", TECHAUTHORITY, UNKNOWN),\n  ],\n  fail_means=\"Pressures outside the P/T-chart band point at charge level or a \"\n             \"component (compressor, expansion valve); a UV glow identifies the \"\n             \"exact leak point.\",\n  related_codes=[], supports_hypotheses=[\"A/C leak\", \"A/C charge fault\"],\n  refutes_hypotheses=[\"A/C leak\", \"A/C charge fault\"], duration_min=30,\n  safety=\"R-1234yf (or R-134a on older stock) requires certified recovery/charging \"\n         \"equipment -- never vent refrigerant to atmosphere.\",\n  hazards=[\"refrigerant\", \"high pressure\", \"UV light exposure\"])\n\n# ===========================================================================\n# Mechanical engine\n# ===========================================================================\n\n_t(\"compression_test\", \"Compression test\", \"mechanical_engine\",\n  [\"engine_management\"], _applies(),\n  purpose=\"Measure each cylinder's cranking compression to find a mechanical \"\n          \"problem (valve, ring, head gasket) a scan tool can't see directly.\",\n  car_state=\"KOEO\",\n  when_to_use=\"Low power, rough idle with no electrical cause found, or before any \"\n              \"major engine work to establish a baseline.\",\n  tools=[\"compression tester (threaded gauge, per spark-plug-hole thread)\",\n        \"disable fuel/ignition per service manual procedure\"],\n  procedure=[\n      \"Warm engine, then disable fuel delivery and ignition per the service \"\n      \"manual's cranking-compression procedure.\",\n      \"Remove all spark plugs; fit the gauge to cylinder 1.\",\n      \"Crank through 4-5 compression strokes (throttle held open); record the \"\n      \"highest steady reading.\",\n      \"Repeat for every cylinder.\",\n  ],\n  pass_criteria=[\n      _pc(\"absolute compression\", \"see service manual\", \"psi\", TECHAUTHORITY, UNKNOWN),\n      _pc(\"cylinder-to-cylinder variation\", 10, \"%\", INDUSTRY_PRACTICE, SINGLE_SOURCE),\n  ],\n  fail_means=\"Any cylinder reading more than ~10% below the others points at that \"\n             \"cylinder's valves/rings/head gasket; low on all cylinders points at a \"\n             \"timing or common mechanical fault.\",\n  related_codes=[\"P0300\", \"P0301\", \"P0302\", \"P0303\", \"P0304\"],\n  supports_hypotheses=[\"misfire, single cylinder\", \"low compression\"],\n  refutes_hypotheses=[\"low compression\"], duration_min=30,\n  safety=\"Fuel and ignition must be disabled per the service manual before \"\n         \"cranking with plugs out.\",\n  hazards=[\"moving car -- do not crank with transmission in gear\"])\n\n_t(\"relative_compression_test\", \"Relative compression test (starter current / scan \"\n  \"tool)\", \"mechanical_engine\", [\"engine_management\", \"starting_charging\"], _applies(),\n  purpose=\"A quicker, no-plugs-out alternative to a full compression test: compares \"\n          \"the starter's current/RPM signature cylinder-to-cylinder while cranking \"\n          \"on a healthy, fueled engine.\",\n  car_state=\"KOEO\",\n  when_to_use=\"Quick screen for an obvious low-compression cylinder before committing \"\n              \"to a full compression/leak-down test.\",\n  tools=[\"scan tool with relative-compression routine, or a current clamp + scope on \"\n        \"the starter feed\"],\n  procedure=[\n      \"Disable fuel/ignition only if the chosen tool's routine requires it; many \"\n      \"scan-tool routines crank the engine as-is.\",\n      \"Run the routine (or crank while logging starter current); it reports a \"\n      \"relative value per cylinder based on the load dip as each piston compresses.\",\n      \"Compare the per-cylinder values.\",\n  ],\n  pass_criteria=[_pc(\"cylinder-to-cylinder variation\", 10, \"%\", INDUSTRY_PRACTICE,\n                     SINGLE_SOURCE)],\n  fail_means=\"A cylinder standing out from the rest is a candidate for a full \"\n             \"compression or leak-down test to confirm.\",\n  related_codes=[\"P0300\", \"P0301\", \"P0302\", \"P0303\", \"P0304\"],\n  supports_hypotheses=[\"misfire, single cylinder\", \"low compression\"],\n  refutes_hypotheses=[\"low compression\"], duration_min=10, hazards=[])\n\n_t(\"cylinder_leak_down_test\", \"Cylinder leak-down test\", \"mechanical_engine\",\n  [\"engine_management\"], _applies(),\n  purpose=\"Pressurize each cylinder at TDC with shop air to find and identify \"\n          \"exactly where a low-compression cylinder is leaking (rings, intake \"\n          \"valve, exhaust valve, head gasket).\",\n  car_state=\"KOEO\",\n  when_to_use=\"After a compression or relative-compression test flags a weak \"\n              \"cylinder -- to tell rings from valves from head gasket.\",\n  tools=[\"leak-down tester\", \"shop air supply\", \"way to hold the crank at TDC \"\n        \"(socket on the crank bolt)\"],\n  procedure=[\n      \"Remove the spark plug for the cylinder under test; bring that cylinder to \"\n      \"TDC on the compression stroke.\",\n      \"Fit the leak-down tester, apply shop air, and read the leakage percentage.\",\n      \"Listen at the throttle body (intake valve leak), the exhaust pipe (exhaust \"\n      \"valve leak), the oil fill (ring leak) and the radiator neck (head gasket \"\n      \"leak) for escaping air.\",\n  ],\n  pass_criteria=[\n      _pc(\"leak-down percentage\", 10, \"%\", INDUSTRY_PRACTICE, SINGLE_SOURCE),\n      _pc(\"leak-down percentage, borderline\", [10, 20], \"%\", INDUSTRY_PRACTICE,\n          SINGLE_SOURCE),\n  ],\n  fail_means=\"Over ~20% leakage is a real concern; where the air is heard escaping \"\n             \"from identifies rings vs. intake valve vs. exhaust valve vs. head \"\n             \"gasket directly.\",\n  related_codes=[\"P0300\", \"P0301\", \"P0302\", \"P0303\", \"P0304\"],\n  supports_hypotheses=[\"low compression\", \"head gasket\"],\n  refutes_hypotheses=[\"head gasket\"], duration_min=30,\n  hazards=[\"shop air pressure -- cylinder can rotate off TDC under pressure\"])\n\n_t(\"intake_vacuum_gauge_test\", \"Intake vacuum gauge test\", \"mechanical_engine\",\n  [\"air_intake_boost\", \"engine_management\"], _applies(),\n  purpose=\"A quick, broad mechanical-health check at idle using a vacuum gauge on a \"\n          \"manifold port -- steady vacuum vs. fluctuating/low vacuum points toward \"\n          \"different fault families before any teardown.\",\n  car_state=\"hot\",\n  when_to_use=\"Rough idle or low power with no code pointing anywhere specific.\",\n  tools=[\"vacuum gauge\", \"manifold vacuum port/adapter\"],\n  procedure=[\n      \"Warm engine, connect vacuum gauge to a manifold vacuum port.\",\n      \"Read steady idle vacuum; note any needle flutter, slow drift, or rhythmic \"\n      \"drop.\",\n      \"Briefly snap the throttle open/closed and watch the gauge's response.\",\n  ],\n  pass_criteria=[_pc(\"steady idle vacuum\", [17, 21], \"inHg\", INDUSTRY_PRACTICE,\n                     SINGLE_SOURCE)],\n  fail_means=\"Low and steady = worn rings/late timing; needle fluttering rapidly = \"\n             \"worn valve guides or weak spring; a periodic drop = a leaking valve \"\n             \"on one cylinder; slowly drifting down = restricted exhaust.\",\n  related_codes=[], supports_hypotheses=[\"low compression\", \"exhaust restriction\"],\n  refutes_hypotheses=[], duration_min=10, hazards=[])\n\n_t(\"crankcase_vacuum_pcv_test\", \"Crankcase vacuum / PCV system test\", \"mechanical_engine\",\n  [\"pcv\"], _applies(),\n  purpose=\"Confirm the PCV/crankcase ventilation system is holding its designed \"\n          \"slight vacuum and not venting oil mist or pressurizing the crankcase.\",\n  car_state=\"hot\",\n  when_to_use=\"Oil consumption with no external leak found, oil in the intake \"\n              \"piping, or a whistling/hissing noise from the valve cover area.\",\n  tools=[\"manometer or vacuum gauge on the oil fill cap/dipstick tube\",\n        \"smoke machine (to find a leaking PCV hose)\"],\n  procedure=[\n      \"Warm engine at idle; connect the gauge in place of the oil fill cap \"\n      \"(temporarily) or at a dedicated test point.\",\n      \"Read the crankcase pressure/vacuum.\",\n      \"If pressurized rather than under slight vacuum, smoke-test the PCV hoses/\"\n      \"valve for a stuck-open or disconnected path.\",\n  ],\n  pass_criteria=[_pc(\"crankcase pressure\", \"slight vacuum, not positive pressure\",\n                     \"inH2O\", INDUSTRY_PRACTICE, SINGLE_SOURCE)],\n  fail_means=\"A pressurized (not vacuum) crankcase points at a stuck/plugged PCV \"","numLines":966,"startLine":1,"totalLines":1549,"truncatedByTokenCap":true}},"sourceToolAssistantUUID":"dbf50f86-3afb-4210-9873-e941b6452440","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
