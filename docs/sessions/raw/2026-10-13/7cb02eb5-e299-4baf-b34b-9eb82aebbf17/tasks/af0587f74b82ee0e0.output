-height: 44px; padding: 4px 12px; border-radius: 999px;\n35\t  border: 1px solid var(--rule); background: var(--surface-2); color: var(--ink-2);\n36\t  font-size: 13px; cursor: pointer;\n37\t}\n38\t.ts-filter-chip.is-on { color: var(--ink); border-color: var(--accent, var(--ink-3)); background: var(--surface); font-weight: 650; }\n39\t\n40\t/* ---------- test rows ---------- */\n41\t.ts-list { display: flex; flex-direction: column; gap: 10px; padding-bottom: 32px; }\n42\t.ts-row {\n43\t  border: 1px solid var(--rule); border-radius: var(--radius); background: var(--surface);\n44\t  padding: 10px 12px; scroll-margin-top: 90px;\n45\t}\n46\t.ts-row[data-recommended=\"1\"] { border-left: 3px solid var(--accent, var(--ok)); }\n47\t\n48\t.ts-row-head {\n49\t  display: flex; align-items: center; gap: 8px; flex-wrap: wrap; font-size: 16px;\n50\t}\n51\t.ts-row-name { font-weight: 650; color: var(--ink); flex: 1 1 auto; min-width: 0; }\n52\t.ts-cat-chip, .ts-state-chip {\n53\t  font-size: 12px; letter-spacing: .04em; text-transform: uppercase;\n54\t  padding: 2px 8px; border-radius: var(--radius); background: var(--surface-2);\n55\t  border: 1px solid var(--rule); color: var(--ink-3);\n56\t}\n57\t.ts-duration { font-size: 12px; color: var(--ink-3); white-space: nowrap; }\n58\t\n59\t.ts-result-chip {\n60\t  font-size: 12px; font-weight: 700; letter-spacing: .04em;\n61\t  padding: 3px 9px; border-radius: var(--radius); border: 1px solid var(--rule);\n62\t  background: var(--surface-2); color: var(--ink-3);\n63\t}\n64\t.ts-result-pass { color: var(--ok); border-color: var(--ok); background: var(--ok-bg); }\n65\t.ts-result-fail { color: var(--sev-returned); border-color: var(--sev-returned); background: var(--sev-returned-bg); }\n66\t.ts-result-inconclusive { color: var(--sev-chronic); border-color: var(--sev-chronic); background: var(--sev-chronic-bg); }\n67\t.ts-result-not_possible { color: var(--ink-3); background: var(--surface-2); }\n68\t.ts-result-not_done { color: var(--ink-3); background: transparent; }\n69\t\n70\t.ts-why {\n71\t  margin-top: 6px; font-size: 13px; color: var(--ok); overflow-wrap: anywhere;\n72\t}\n73\t.ts-blocker {\n74\t  margin-top: 6px; padding: 6px 8px; border-radius: var(--radius);\n75\t  background: var(--sev-chronic-bg); border: 1px solid var(--sev-chronic);\n76\t  color: var(--sev-chronic); font-size: 13px;\n77\t}\n78\t.ts-latest {\n79\t  margin-top: 6px; font-size: 13px; color: var(--ink-2); overflow-wrap: anywhere;\n80\t}\n81\t\n82\t/* ---------- details ---------- */\n83\t.ts-details { margin-top: 8px; }\n84\t.ts-details summary {\n85\t  cursor: pointer; min-height: 36px; display: flex; align-items: center;\n86\t  font-size: 13px; color: var(--ink-2);\n87\t}\n88\t.ts-purpose { font-size: 14px; color: var(--ink); }\n89\t.ts-procedure { margin: 6px 0; padding-left: 22px; font-size: 14px; }\n90\t.ts-procedure li { margin-bottom: 4px; }\n91\t.ts-hazards { color: var(--sev-returned); }\n92\t\n93\t.ts-criteria { width: 100%; border-collapse: collapse; font-size: 13px; margin: 8px 0; }\n94\t.ts-criteria th, .ts-criteria td {\n95\t  text-align: left; padding: 4px 8px; border-bottom: 1px solid var(--rule-soft);\n96\t}\n97\t.ts-criteria-wrap { overflow-x: auto; }\n98\t.ts-conf-chip {\n99\t  font-size: 12px; letter-spacing: .04em; padding: 1px 7px; border-radius: var(--radius);\n100\t  border: 1px solid var(--rule); background: var(--surface-2); color: var(--ink-3);\n101\t}\n102\t.ts-conf-confirmed    { color: var(--ok); border-color: var(--ok); background: var(--ok-bg); }\n103\t.ts-conf-corroborated { color: var(--ink); border-color: var(--ink-3); }\n104\t.ts-conf-single_source{ color: var(--sev-chronic); border-color: var(--sev-chronic); }\n105\t.ts-conf-unknown      { color: var(--ink-3); }\n106\t\n107\t/* ---------- result form: two big 48px buttons + two smaller ones ---------- */\n108\t.ts-result-form { margin-top: 10px; }\n109\t.ts-buttons { display: flex; gap: 8px; flex-wrap: wrap; }\n110\t.ts-btn {\n111\t  min-height: 48px; border-radius: var(--radius); border: 1px solid var(--rule);\n112\t  background: var(--surface-2); color: var(--ink); font-size: 15px; font-weight: 650;\n113\t  cursor: pointer; flex: 1 1 120px;\n114\t}\n115\t.ts-btn-pass { color: var(--ok); border-color: var(--ok); }\n116\t.ts-btn-pass:hover, .ts-btn-pass.is-chosen { background: var(--ok-bg); }\n117\t.ts-btn-fail { color: var(--sev-returned); border-color: var(--sev-returned); }\n118\t.ts-btn-fail:hover, .ts-btn-fail.is-chosen { background: var(--sev-returned-bg); }\n119\t.ts-btn-sm { flex: 1 1 100px; font-size: 13px; font-weight: 500; min-height: 44px; }\n120\t.ts-btn-sm.is-chosen { border-color: var(--sev-chronic); color: var(--sev-chronic); }\n121\t\n122\t.ts-extra {\n123\t  display: flex; flex-wrap: wrap; gap: 10px; align-items: end; margin-top: 10px;\n124\t  padding: 10px; border-radius: var(--radius); background: var(--surface-2);\n125\t  border: 1px solid var(--rule);\n126\t}\n127\t.ts-field {\n128\t  display: flex; flex-direction: column; gap: 2px; font-size: 12px;\n129\t  color: var(--ink-2);\n130\t}\n131\t.ts-field input, .ts-field select {\n132\t  min-height: 36px; font-size: 14px; padding: 4px 6px; border-radius: var(--radius);\n133\t  border: 1px solid var(--rule); background: var(--surface); color: var(--ink);\n134\t}\n135\t.ts-unit { width: 64px; margin-left: 4px; }\n136\t.ts-save { min-height: 44px; flex: 0 0 auto; padding: 0 20px; }\n137\t\n138\t.ts-status { font-size: 13px; margin-top: 6px; }\n139\t.ts-status.is-ok { color: var(--ok); }\n140\t.ts-status.is-error { color: var(--sev-returned); }\n141\t\n142\t@media (max-width: 480px) {\n143\t  .ts-btn { flex: 1 1 45%; }\n144\t}\n145\t"}]},"uuid":"25188246-30ea-499a-becc-5132fb4cf7d4","timestamp":"2026-10-14T05:30:58.135Z","toolUseResult":{"type":"text","file":{"filePath":"C:\\Users\\User\\mcp-servers\\cuore\\web\\static\\tests.css","content":"/* Tests -- the shop-floor mechanic-test catalogue (/v/{vin}/tests).\n *\n * Single column, 16px body text, 48px-tall buttons, true-black-friendly\n * (reuses cuore.css's tokens throughout -- --ink/--ink-2/--ink-3,\n * --surface/--surface-2, --rule/--rule-soft, --radius, --ok/--sev-chronic/\n * --sev-returned for the result chips, --accent for the marque theme).\n * Nothing new is invented here, this is additive chrome for one page, same\n * posture as liveboard.css.\n */\n\n/* ---------- summary strip ---------- */\n.ts-summary {\n  display: flex; align-items: center; gap: 10px; flex-wrap: wrap;\n  padding: 10px 0; border-bottom: 1px solid var(--rule-soft);\n  font-size: 16px;\n}\n.ts-summary-main { font-weight: 650; color: var(--ink); }\n.ts-summary-chip {\n  padding: 3px 10px; border-radius: var(--radius); font-size: 13px;\n  border: 1px solid var(--rule); background: var(--surface-2); color: var(--ink-2);\n}\n.ts-chip-pass { color: var(--ok); border-color: var(--ok); background: var(--ok-bg); }\n.ts-chip-fail { color: var(--sev-returned); border-color: var(--sev-returned); background: var(--sev-returned-bg); }\n.ts-chip-inconclusive { color: var(--sev-chronic); border-color: var(--sev-chronic); background: var(--sev-chronic-bg); }\n.ts-chip-not_possible { color: var(--ink-3); background: var(--surface-2); }\n\n/* ---------- filter chips ---------- */\n.ts-filters {\n  display: flex; gap: 6px; flex-wrap: wrap; padding: 10px 0;\n}\n.ts-filter-chip {\n  /* F5 (MECHANIC_REVIEW_3): the legend-documented tap targets must be\n     >=44px tall, not just wide. */\n  min-height: 44px; padding: 4px 12px; border-radius: 999px;\n  border: 1px solid var(--rule); background: var(--surface-2); color: var(--ink-2);\n  font-size: 13px; cursor: pointer;\n}\n.ts-filter-chip.is-on { color: var(--ink); border-color: var(--accent, var(--ink-3)); background: var(--surface); font-weight: 650; }\n\n/* ---------- test rows ---------- */\n.ts-list { display: flex; flex-direction: column; gap: 10px; padding-bottom: 32px; }\n.ts-row {\n  border: 1px solid var(--rule); border-radius: var(--radius); background: var(--surface);\n  padding: 10px 12px; scroll-margin-top: 90px;\n}\n.ts-row[data-recommended=\"1\"] { border-left: 3px solid var(--accent, var(--ok)); }\n\n.ts-row-head {\n  display: flex; align-items: center; gap: 8px; flex-wrap: wrap; font-size: 16px;\n}\n.ts-row-name { font-weight: 650; color: var(--ink); flex: 1 1 auto; min-width: 0; }\n.ts-cat-chip, .ts-state-chip {\n  font-size: 12px; letter-spacing: .04em; text-transform: uppercase;\n  padding: 2px 8px; border-radius: var(--radius); background: var(--surface-2);\n  border: 1px solid var(--rule); color: var(--ink-3);\n}\n.ts-duration { font-size: 12px; color: var(--ink-3); white-space: nowrap; }\n\n.ts-result-chip {\n  font-size: 12px; font-weight: 700; letter-spacing: .04em;\n  padding: 3px 9px; border-radius: var(--radius); border: 1px solid var(--rule);\n  background: var(--surface-2); color: var(--ink-3);\n}\n.ts-result-pass { color: var(--ok); border-color: var(--ok); background: var(--ok-bg); }\n.ts-result-fail { color: var(--sev-returned); border-color: var(--sev-returned); background: var(--sev-returned-bg); }\n.ts-result-inconclusive { color: var(--sev-chronic); border-color: var(--sev-chronic); background: var(--sev-chronic-bg); }\n.ts-result-not_possible { color: var(--ink-3); background: var(--surface-2); }\n.ts-result-not_done { color: var(--ink-3); background: transparent; }\n\n.ts-why {\n  margin-top: 6px; font-size: 13px; color: var(--ok); overflow-wrap: anywhere;\n}\n.ts-blocker {\n  margin-top: 6px; padding: 6px 8px; border-radius: var(--radius);\n  background: var(--sev-chronic-bg); border: 1px solid var(--sev-chronic);\n  color: var(--sev-chronic); font-size: 13px;\n}\n.ts-latest {\n  margin-top: 6px; font-size: 13px; color: var(--ink-2); overflow-wrap: anywhere;\n}\n\n/* ---------- details ---------- */\n.ts-details { margin-top: 8px; }\n.ts-details summary {\n  cursor: pointer; min-height: 36px; display: flex; align-items: center;\n  font-size: 13px; color: var(--ink-2);\n}\n.ts-purpose { font-size: 14px; color: var(--ink); }\n.ts-procedure { margin: 6px 0; padding-left: 22px; font-size: 14px; }\n.ts-procedure li { margin-bottom: 4px; }\n.ts-hazards { color: var(--sev-returned); }\n\n.ts-criteria { width: 100%; border-collapse: collapse; font-size: 13px; margin: 8px 0; }\n.ts-criteria th, .ts-criteria td {\n  text-align: left; padding: 4px 8px; border-bottom: 1px solid var(--rule-soft);\n}\n.ts-criteria-wrap { overflow-x: auto; }\n.ts-conf-chip {\n  font-size: 12px; letter-spacing: .04em; padding: 1px 7px; border-radius: var(--radius);\n  border: 1px solid var(--rule); background: var(--surface-2); color: var(--ink-3);\n}\n.ts-conf-confirmed    { color: var(--ok); border-color: var(--ok); background: var(--ok-bg); }\n.ts-conf-corroborated { color: var(--ink); border-color: var(--ink-3); }\n.ts-conf-single_source{ color: var(--sev-chronic); border-color: var(--sev-chronic); }\n.ts-conf-unknown      { color: var(--ink-3); }\n\n/* ---------- result form: two big 48px buttons + two smaller ones ---------- */\n.ts-result-form { margin-top: 10px; }\n.ts-buttons { display: flex; gap: 8px; flex-wrap: wrap; }\n.ts-btn {\n  min-height: 48px; border-radius: var(--radius); border: 1px solid var(--rule);\n  background: var(--surface-2); color: var(--ink); font-size: 15px; font-weight: 650;\n  cursor: pointer; flex: 1 1 120px;\n}\n.ts-btn-pass { color: var(--ok); border-color: var(--ok); }\n.ts-btn-pass:hover, .ts-btn-pass.is-chosen { background: var(--ok-bg); }\n.ts-btn-fail { color: var(--sev-returned); border-color: var(--sev-returned); }\n.ts-btn-fail:hover, .ts-btn-fail.is-chosen { background: var(--sev-returned-bg); }\n.ts-btn-sm { flex: 1 1 100px; font-size: 13px; font-weight: 500; min-height: 44px; }\n.ts-btn-sm.is-chosen { border-color: var(--sev-chronic); color: var(--sev-chronic); }\n\n.ts-extra {\n  display: flex; flex-wrap: wrap; gap: 10px; align-items: end; margin-top: 10px;\n  padding: 10px; border-radius: var(--radius); background: var(--surface-2);\n  border: 1px solid var(--rule);\n}\n.ts-field {\n  display: flex; flex-direction: column; gap: 2px; font-size: 12px;\n  color: var(--ink-2);\n}\n.ts-field input, .ts-field select {\n  min-height: 36px; font-size: 14px; padding: 4px 6px; border-radius: var(--radius);\n  border: 1px solid var(--rule); background: var(--surface); color: var(--ink);\n}\n.ts-unit { width: 64px; margin-left: 4px; }\n.ts-save { min-height: 44px; flex: 0 0 auto; padding: 0 20px; }\n\n.ts-status { font-size: 13px; margin-top: 6px; }\n.ts-status.is-ok { color: var(--ok); }\n.ts-status.is-error { color: var(--sev-returned); }\n\n@media (max-width: 480px) {\n  .ts-btn { flex: 1 1 45%; }\n}\n","numLines":145,"startLine":1,"totalLines":145}},"sourceToolAssistantUUID":"7582e7a4-9fd4-4505-9df5-1f712509953e","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
