ory/name grouping.\n    rows.sort(key=lambda r: (\n        (0, _hyp_rank(r, open_hyps, next_test_ids), \"\", \"\")\n        if r[\"recommended\"] else (1, 0, r[\"category\"], r[\"name\"])\n    ))\n    categories = sorted({t[\"category\"] for t in catalogue})","originalFile":null,"structuredPatch":[{"oldStart":205,"oldLines":6,"newStart":205,"newLines":7,"lines":["     hyp_systems = [h.get(\"system\") or \"\" for h in open_hyps if h.get(\"system\")]","     sys_test_ids = {t[\"id\"] for t in mechanic_tests.tests_for_systems(hyp_systems)} if hyp_systems else set()","     recommended_ids = code_test_ids | sys_test_ids","+    next_test_ids = {h[\"next_test\"] for h in open_hyps if h.get(\"next_test\")}"," ","     rows: list[dict[str, Any]] = []","     counts = {k: 0 for k in RESULT_COUNT_KEYS}"]},{"oldStart":225,"oldLines":11,"newStart":226,"newLines":22,"lines":["             \"step_id\": step_id(rid),","             \"latest_result\": latest,","             \"recommended\": rid in recommended_ids,","-            \"why\": _why_for(t, open_codes, open_hyps) if rid in recommended_ids else [],","+            \"why\": _why_for(t, open_codes, open_hyps, next_test_ids) if rid in recommended_ids else [],","             \"blocker\": blocker,","         })"," ","-    rows.sort(key=lambda r: (0 if r[\"recommended\"] else 1, r[\"category\"], r[\"name\"]))","+    # Recommended rows rank by the fault tree's next test, then by","+    # supports_hypotheses match (_hyp_rank), with the catalogue's own order","+    # (mechanic_tests._ORDER, already the order `rows` was built in) as the","+    # stable tiebreak -- e.g. the EVAP: ESIM signal path line reads Test A","+    # (evap_test_a_esim_switch, the hypothesis's own next_test), then the","+    # ESIM commanded vent test, then the ESIM wiring test, exactly the","+    # sequence those three tests' own when_to_use text cross-references.","+    # Everything not recommended keeps the prior category/name grouping.","+    rows.sort(key=lambda 