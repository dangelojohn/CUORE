was captured to corroborate against.\n    \"\"\"\n    out: dict[str, Any] = {\"status\": d[0]}\n    if len(d) >= 2:\n        out[\"commanded_pct\"] = round(d[1] * 100 / 255, 3)\n    if len(d) >= 3:\n        out[\"actual_pct\"] = round(d[2] * 100 / 255, 3)\n    return out\n\n\ndef decode_supported_pids(base: str, data: list[str]) -> tuple[list[str], bool]:","originalFile":null,"structuredPatch":[{"oldStart":132,"oldLines":6,"newStart":132,"newLines":134,"lines":["     return out"," "," ","+#: ISO 15031-5 Table O2 sensors present bitmap (PID 0x13), bit -> (bank, sensor).","+_O2_PRESENT_BITS: tuple[tuple[int, str], ...] = (","+    (0, \"bank1_sensor1\"), (1, \"bank1_sensor2\"), (2, \"bank1_sensor3\"), (3, \"bank1_sensor4\"),","+    (4, \"bank2_sensor1\"), (5, \"bank2_sensor2\"), (6, \"bank2_sensor3\"), (7, \"bank2_sensor4\"),","+)","+","+","+def _decode_o2_present(d: list[int]) -> dict[str, bool]:","+    \"\"\"PID 0x13: which of the up to 8 O2 sensors are present.\"\"\"","+    byte = d[0]","+    return {name: bool(byte & (1 << bit)) for bit, name in _O2_PRESENT_BITS}","+","+","+def _decode_o2_voltage_trim(d: list[int]) -> dict[str, Any]:","+    \"\"\"PID 0x15 (and the 0x14-0x1B family): sensor voltage + short term fuel","+    trim. 0xFF in the trim byte means the sensor is not used for trim.","+    \"\"\"","+    voltage = round(d[0] / 200, 3)","+    trim_raw = d[1]","+    trim = None if trim_raw == 0xFF else round(trim_raw / 1.28 - 100, 3)","+    return {\"voltage_V\": voltage, \"stft_pct\": trim}","+","+","+#: SAE J1979 Table \"OBD requirements to which the vehicle is designed\" (PID 0x1C).","+_OBD_STANDARDS: dict[int, str] = {","+    0x01: \"OBD-II (California ARB)\", 0x02: \"OBD (Federal EPA)\",","+    0x03: \"OBD and OBD-II\", 0x04: \"OBD-I\", 0x05: \"Not OBD compliant\",","+    0x06: \"EOBD\", 0x07: \"EOBD and OBD-II\", 0x08: \"EOBD and OBD\",","+    0x09: \"EOBD, OBD and OBD II\", 0x0A: \"JOBD\", 0x0B: \"JOBD and OBD II\",","+    0x0C: \"JOBD and EOBD\", 0x0D: \"