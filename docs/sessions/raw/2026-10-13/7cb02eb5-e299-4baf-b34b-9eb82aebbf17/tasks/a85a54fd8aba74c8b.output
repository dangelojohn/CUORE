{"parentUuid":"ad917cb3-72f7-4522-93cc-70abadaa70b1","isSidechain":true,"promptId":"df226819-4f0d-4979-bf53-3ffca405c7dd","agentId":"a85a54fd8aba74c8b","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014VZdpmXZPGYjwsrbkCJeeZ","type":"tool_result","content":"1\t\"\"\"OBD-II Mode $06 (on-board monitoring test results), CAN format per\n2\tISO 15031-5 / SAE J1979.\n3\t\n4\tPure decoders plus one session-level reader, mirroring the split in\n5\t:mod:`obd.py` (pure) and :mod:`ops.py` (wiring). Reuses\n6\t:func:`obd.decode_supported_pids` for the supported-MID bitmaps: the 32-bit\n7\t\"is this ID supported / is the next block supported\" convention Mode 01 uses\n8\tfor PIDs is the same one Mode 06 uses for OBDMIDs.\n9\t\n10\tRecord layout (SAE J1979 / ISO 15031-5, CAN): ``46`` then repeating 9-byte\n11\trecords OBDMID(1) TID(1) UASID(1) value(2) min(2) max(2); every record\n12\tcarries its own OBDMID. Not yet checked against a live reply from this car.\n13\t\n14\tUnit-and-Scaling ID (UASID) table: only entries this module's author is\n15\tactually confident about are filled in; scaling formulas for the rest of\n16\tISO 15031-5 Table E.1 were not reliably recalled, so per the \"return raw\n17\trather than guess\" instruction they resolve to ``{\"scaling\": \"unknown\"}``\n18\twith the raw integer preserved. See the module docstring section below the\n19\ttable for exactly what is and is not covered.\n20\t\"\"\"\n21\t\n22\tfrom __future__ import annotations\n23\t\n24\tfrom typing import Any, Optional\n25\t\n26\tfrom .framing import negative_responses, no_data\n27\tfrom .obd import decode_supported_pids\n28\t\n29\t# --- OBDMID names (SAE J1979 Appendix D / ISO 15031-5) ----------------------\n30\t#\n31\t# Filled in for the ranges the request called out explicitly. Anything not in\n32\t# this table returns None from :func:`obdmid_name` -- never a guessed name.\n33\t\n34\tOBDMID_NAMES: dict[str, str] = {\n35\t    # O2 sensor monitors: bank 1-4, sensor 1-4 (Appendix D groups these as\n36\t    # 16 consecutive MIDs; bank/sensor split below is the conventional one,\n37\t    # not independently verified against the standard's exact wording).\n38\t    \"01\": \"O2 sensor monitor bank 1 sensor 1\",\n39\t    \"02\": \"O2 sensor monitor bank 1 sensor 2\",\n40\t    \"03\": \"O2 sensor monitor bank 1 sensor 3\",\n41\t    \"04\": \"O2 sensor monitor bank 1 sensor 4\",\n42\t    \"05\": \"O2 sensor monitor bank 2 sensor 1\",\n43\t    \"06\": \"O2 sensor monitor bank 2 sensor 2\",\n44\t    \"07\": \"O2 sensor monitor bank 2 sensor 3\",\n45\t    \"08\": \"O2 sensor monitor bank 2 sensor 4\",\n46\t    \"09\": \"O2 sensor monitor bank 3 sensor 1\",\n47\t    \"0A\": \"O2 sensor monitor bank 3 sensor 2\",\n48\t    \"0B\": \"O2 sensor monitor bank 3 sensor 3\",\n49\t    \"0C\": \"O2 sensor monitor bank 3 sensor 4\",\n50\t    \"0D\": \"O2 sensor monitor bank 4 sensor 1\",\n51\t    \"0E\": \"O2 sensor monitor bank 4 sensor 2\",\n52\t    \"0F\": \"O2 sensor monitor bank 4 sensor 3\",\n53\t    \"10\": \"O2 sensor monitor bank 4 sensor 4\",\n54\t    # Catalyst monitor, bank 1-4.\n55\t    \"21\": \"Catalyst monitor bank 1\",\n56\t    \"22\": \"Catalyst monitor bank 2\",\n57\t    \"23\": \"Catalyst monitor bank 3\",\n58\t    \"24\": \"Catalyst monitor bank 4\",\n59\t    # EGR monitor, bank 1-4.\n60\t    \"31\": \"EGR monitor bank 1\",\n61\t    \"32\": \"EGR monitor bank 2\",\n62\t    \"33\": \"EGR monitor bank 3\",\n63\t    \"34\": \"EGR monitor bank 4\",\n64\t    # VVT monitor, bank 1-4.\n65\t    \"35\": \"VVT monitor bank 1\",\n66\t    \"36\": \"VVT monitor bank 2\",\n67\t    \"37\": \"VVT monitor bank 3\",\n68\t    \"38\": \"VVT monitor bank 4\",\n69\t    # EVAP monitors.\n70\t    \"39\": \"EVAP monitor (cap off / gross leak)\",\n71\t    \"3A\": 'EVAP monitor 0.090\" leak',\n72\t    \"3B\": 'EVAP monitor 0.040\" leak',\n73\t    \"3C\": 'EVAP monitor 0.020\" leak',\n74\t    \"3D\": \"EVAP purge flow monitor\",\n75\t    # Misfire monitors: 0xA1 is the general/summary data, 0xA2-0xAD are\n76\t    # cylinders 1-12.\n77\t    \"A1\": \"Misfire monitor general data\",\n78\t    \"A2\": \"Misfire monitor cylinder 1\",\n79\t    \"A3\": \"Misfire monitor cylinder 2\",\n80\t    \"A4\": \"Misfire monitor cylinder 3\",\n81\t    \"A5\": \"Misfire monitor cylinder 4\",\n82\t    \"A6\": \"Misfire monitor cylinder 5\",\n83\t    \"A7\": \"Misfire monitor cylinder 6\",\n84\t    \"A8\": \"Misfire monitor cylinder 7\",\n85\t    \"A9\": \"Misfire monitor cylinder 8\",\n86\t    \"AA\": \"Misfire monitor cylinder 9\",\n87\t    \"AB\": \"Misfire monitor cylinder 10\",\n88\t    \"AC\": \"Misfire monitor cylinder 11\",\n89\t    \"AD\": \"Misfire monitor cylinder 12\",\n90\t}\n91\t\n92\t#: EVAP OBDMIDs in the order the request lists them.\n93\tEVAP_MIDS: tuple[str, ...] = (\"39\", \"3A\", \"3B\", \"3C\", \"3D\")\n94\t\n95\t\n96\tdef obdmid_name(mid: str) -> Optional[str]:\n97\t    return OBDMID_NAMES.get(mid.upper())\n98\t\n99\t\n100\t# --- Unit-and-Scaling ID table -----------------------------------------------\n101\t#\n102\t# (unit, per-count multiplier) for the base (unsigned, 0x00-0x7F) IDs this\n103\t# module is confident about. A UASID with bit 0x80 set is the signed mirror\n104\t# of (uasid & 0x7F): same unit and multiplier, but the raw 16-bit field is\n105\t# two's-complement rather than unsigned -- that halving of the ID space is a\n106\t# structural fact of the table, independent of which individual entries are\n107\t# known here.\n108\t_UASID_TABLE: dict[int, tuple[str, float]] = {\n109\t    0x01: (\"raw\", 1.0),      # raw count / no scaling\n110\t    0x0A: (\"mV\", 0.122),     # voltage, 0.122 mV per count\n111\t    0x10: (\"ms\", 1.0),       # time, 1 ms per count\n112\t    0x24: (\"count\", 1.0),    # counter, 1 per count\n113\t}\n114\t#: UASIDs the request flagged but this module could not pin down confidently\n115\t#: enough to scale (kept out of _UASID_TABLE deliberately -- see decode_uasid).\n116\tUNCERTAIN_UASIDS: tuple[str, ...] = (\"0B\", \"14\", \"FD\", \"FE\")\n117\t\n118\t\n119\tdef _twos_complement16(v: int) -> int:\n120\t    return v - 0x10000 if v & 0x8000 else v\n121\t\n122\t\n123\tdef decode_uasid(uasid_hex: str, raw: int) -> dict[str, Any]:\n124\t    \"\"\"Scale one raw 16-bit Mode 06 field per its Unit-and-Scaling ID.\n125\t\n126\t    Returns ``{\"unit\": ..., \"value\": ..., \"scaling\": \"known\"|\"unknown\"}``.\n127\t    Falls back to the untouched raw integer with ``\"scaling\": \"unknown\"``\n128\t    whenever the UASID (or its unsigned base, for a signed one) is not in\n129\t    ``_UASID_TABLE`` -- deliberately, rather than guessing a formula.\n130\t    \"\"\"\n131\t    try:\n132\t        uid = int(uasid_hex, 16)\n133\t    except (TypeError, ValueError):\n134\t        return {\"unit\": None, \"value\": raw, \"scaling\": \"unknown\"}\n135\t    signed = bool(uid & 0x80)\n136\t    base = uid & 0x7F\n137\t    entry = _UASID_TABLE.get(base)\n138\t    if entry is None:\n139\t        return {\"unit\": None, \"value\": raw, \"scaling\": \"unknown\"}\n140\t    unit, scale = entry\n141\t    value = _twos_complement16(raw) if signed else raw\n142\t    scaled = value * scale\n143\t    return {\"unit\": unit, \"value\": round(scaled, 6) if scale != 1.0 else int(scaled),\n144\t            \"scaling\": \"known\"}\n145\t\n146\t\n147\tdef decode_supported_mid_bitmap(base: str, data: list[str]) -> tuple[list[str], bool]:\n148\t    \"\"\"Supported OBDMIDs from a ``46 <base> A B C D`` bitmap, and whether the\n149\t    next block is supported. Delegates to :func:`obd.decode_supported_pids`:\n150\t    the bit convention (MSB = base+1, LSB of the last byte = \"next block\n151\t    supported\") is identical to Mode 01's supported-PID bitmaps.\n152\t    \"\"\"\n153\t    return decode_supported_pids(base, data)\n154\t\n155\t\n156\t# --- test-result records -----------------------------------------------------\n157\t\n158\t#: SAE J1979 / ISO 15031-5 CAN format: the Mode $06 response is ``46`` followed\n159\t#: by repeating 9-byte records, each carrying its own OBDMID:\n160\t#: OBDMID(1) TID(1) UASID(1) value(2) min(2) max(2). An 8-byte stride (no\n161\t#: MID per record) misreads every record after the first.\n162\t_RECORD_LEN = 9\n163\t\n164\t\n165\tdef _u16(hi: str, lo: str) -> int:\n166\t    return (int(hi, 16) << 8) | int(lo, 16)\n167\t\n168\t\n169\tdef decode_mode06_records(mid: str, payload: list[str]) -> list[dict[str, Any]]:\n170\t    \"\"\"Decode the repeating test-result records of one Mode $06 reply.\n171\t\n172\t    ``payload`` is the byte list following ``46 <mid>`` (``data[2:]``), so\n173\t    the first record's OBDMID has already been consumed as the echo; it is\n174\t    put back and every record (9 bytes, own OBDMID) is read the same way.\n175\t    Records whose OBDMID differs from the requested one are still decoded\n176\t    under their own MID. Trailing bytes that do not fill a record are\n177\t    ignored rather than raising.\n178\t    \"\"\"\n179\t    full = [mid.upper()] + [b.upper() for b in payload]\n180\t    out: list[dict[str, Any]] = []\n181\t    for i in range(0, len(full) - _RECORD_LEN + 1, _RECORD_LEN):\n182\t        rmid, tid, uasid = full[i], full[i + 1], full[i + 2]\n183\t        raw_value = _u16(full[i + 3], full[i + 4])\n184\t        raw_min = _u16(full[i + 5], full[i + 6])\n185\t        raw_max = _u16(full[i + 7], full[i + 8])\n186\t        dv = decode_uasid(uasid, raw_value)\n187\t        dmin = decode_uasid(uasid, raw_min)\n188\t        dmax = decode_uasid(uasid, raw_max)\n189\t        value, vmin, vmax = dv[\"value\"], dmin[\"value\"], dmax[\"value\"]\n190\t        passed = vmin <= value <= vmax\n191\t        out.append({\n192\t            \"mid\": rmid, \"mid_name\": obdmid_name(rmid), \"tid\": tid, \"uasid\": uasid,\n193\t            \"unit\": dv[\"unit\"], \"value\": value, \"min\": vmin, \"max\": vmax,\n194\t            \"passed\": passed,\n195\t            \"raw\": {\"value\": raw_value, \"min\": raw_min, \"max\": raw_max,\n196\t                    \"scaling\": dv[\"scaling\"]},\n197\t        })\n198\t    return out\n199\t\n200\t\n201\tdef evap_summary(read_result: dict[str, Any]) -> list[str]:\n202\t    \"\"\"Plain-English sentences for the EVAP OBDMIDs (0x39-0x3D) in a\n203\t    :func:`read_mode06` result. The sentence compares the test value against\n204\t    the MAX limit -- these are upper-bound leak/flow thresholds -- even\n205\t    though ``passed`` itself uses the full min<=value<=max range.\n206\t    \"\"\"\n207\t    results = read_result.get(\"results\") or {}\n208\t    lines: list[str] = []\n209\t    for mid in EVAP_MIDS:\n210\t        name = obdmid_name(mid) or f\"MID {mid}\"\n211\t        entry = results.get(mid) or {}\n212\t        by_ecu = entry.get(\"by_ecu\") or {}\n213\t        records = [r for recs in by_ecu.values() for r in recs]\n214\t        if not records:\n215\t            lines.append(f\"{name}: not supported by this ECU\")\n216\t            continue\n217\t        for r in records:\n218\t            verdict = \"PASS\" if r[\"passed\"] else \"FAIL\"\n219\t            unit = r.get(\"unit\")\n220\t            suffix = f\" {unit}\" if unit and unit not in (\"raw\",) else \"\"\n221\t            lines.append(f\"{name}: value {r['value']}{suffix} vs limit {r['max']}{suffix} \"\n222\t                        f\"-> {verdict}\")\n223\t    return lines\n224\t\n225\t\n226\t# --- session reader -----------------------------------------------------------\n227\t\n228\t_SUPPORTED_BASES = (\"00\", \"20\", \"40\", \"60\", \"80\", \"A0\", \"C0\", \"E0\")\n229\t\n230\t\n231\tdef _negative_lines(all_ecus: dict[str, list[str]]) -> dict[str, str]:\n232\t    from .uds import NRC_TEXT  # local: keep this module free of the UDS client import\n233\t    codes = negative_responses(all_ecus, \"06\")\n234\t    return {hdr: f\"NRC 0x{code} ({NRC_TEXT.get(int(code, 16), 'unknown')})\"\n235\t            for hdr, code in codes.items()}\n236\t\n237\t\n238\tdef read_mode06(sess: Any, mids: Optional[list[str]] = None) -> dict[str, Any]:\n239\t    \"\"\"Mode 06 discovery + test results. Never raises on NO DATA or a\n240\t    negative response (0x7F 06 xx = the MID is not supported) -- both are\n241\t    recorded in the result instead.\n242\t\n243\t    With ``mids=None``, discovers supported OBDMIDs per ECU first (``06 00``,\n244\t    ``06 20``, ... while the previous bitmap's last bit says the next range\n245\t    is supported) and reads every MID any ECU reported as supported. Passing\n246\t    ``mids`` skips discovery and reads exactly those MIDs.\n247\t    \"\"\"\n248\t    sess.untarget()\n249\t    out: dict[str, Any] = {\"raw\": {}, \"supported\": {}, \"results\": {}}\n250\t    if mids is None:\n251\t        discovered: dict[str, list[str]] = {}\n252\t        for base in _SUPPORTED_BASES:\n253\t            q = sess.query(f\"06{base}\", \"46\")\n254\t            out[\"raw\"][f\"supported_{base}\"] = q[\"raw\"]\n255\t            if q[\"error\"]:\n256\t                out.setdefault(\"errors\", {})[base] = q[\"error\"]\n257\t                break\n258\t            any_next = False\n259\t            for hdr, data in q[\"ecus\"].items():\n260\t                if len(data) < 6 or data[1] != base:\n261\t                    continue\n262\t                supported, more = decode_supported_mid_bitmap(base, data[2:6])\n263\t                discovered.setdefault(hdr, []).extend(supported)\n264\t                any_next = any_next or more\n265\t            if not any_next:\n266\t                break\n267\t        out[\"supported\"] = discovered\n268\t        mids = sorted({m for lst in discovered.values() for m in lst})\n269\t    else:\n270\t        mids = [m.upper() for m in mids]\n271\t        out[\"supported\"] = {\"requested\": list(mids)}\n272\t    for mid in mids:\n273\t        q = sess.query(f\"06{mid}\", \"46\")\n274\t        out[\"raw\"][mid] = q[\"raw\"]\n275\t        entry: dict[str, Any] = {}\n276\t        if q[\"error\"]:\n277\t            entry[\"error\"] = f\"ADAPTER/BUS ERROR: {q['error']}; the read did not complete\"\n278\t            out[\"results\"][mid] = entry\n279\t            continue\n280\t        by_ecu: dict[str, list[dict[str, Any]]] = {}\n281\t        for hdr, data in q[\"ecus\"].items():\n282\t            if len(data) < 2 or data[1] != mid:\n283\t                continue\n284\t            recs = decode_mode06_records(mid, data[2:])\n285\t            if recs:\n286\t                by_ecu[hdr] = recs\n287\t        neg = _negative_lines(q[\"all_ecus\"])\n288\t        if neg:\n289\t            entry[\"negative\"] = neg\n290\t        if by_ecu:\n291\t            entry[\"by_ecu\"] = by_ecu\n292\t        elif not neg:\n293\t            entry[\"warning\"] = \"NO DATA\" if no_data(q[\"raw\"]) else \"no ECU answered this MID\"\n294\t        out[\"results\"][mid] = entry\n295\t    return out\n296\t\n297\t\n298\t__all__ = [\n299\t    \"OBDMID_NAMES\", \"EVAP_MIDS\", \"obdmid_name\", \"UNCERTAIN_UASIDS\", \"decode_uasid\",\n300\t    \"decode_supported_mid_bitmap\", \"decode_mode06_records\", \"evap_summary\", \"read_mode06\",\n301\t]\n302\t"}]},"uuid":"abddb513-3a79-4adb-88b4-786da3a2bc28","timestamp":"2026-10-14T00:27:17.504Z","toolUseResult":{"type":"text","file":{"filePath":"C:\\Users\\User\\mcp-servers\\cuore\\live\\mode06.py","content":"\"\"\"OBD-II Mode $06 (on-board monitoring test results), CAN format per\nISO 15031-5 / SAE J1979.\n\nPure decoders plus one session-level reader, mirroring the split in\n:mod:`obd.py` (pure) and :mod:`ops.py` (wiring). Reuses\n:func:`obd.decode_supported_pids` for the supported-MID bitmaps: the 32-bit\n\"is this ID supported / is the next block supported\" convention Mode 01 uses\nfor PIDs is the same one Mode 06 uses for OBDMIDs.\n\nRecord layout (SAE J1979 / ISO 15031-5, CAN): ``46`` then repeating 9-byte\nrecords OBDMID(1) TID(1) UASID(1) value(2) min(2) max(2); every record\ncarries its own OBDMID. Not yet checked against a live reply from this car.\n\nUnit-and-Scaling ID (UASID) table: only entries this module's author is\nactually confident about are filled in; scaling formulas for the rest of\nISO 15031-5 Table E.1 were not reliably recalled, so per the \"return raw\nrather than guess\" instruction they resolve to ``{\"scaling\": \"unknown\"}``\nwith the raw integer preserved. See the module docstring section below the\ntable for exactly what is and is not covered.\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom typing import Any, Optional\n\nfrom .framing import negative_responses, no_data\nfrom .obd import decode_supported_pids\n\n# --- OBDMID names (SAE J1979 Appendix D / ISO 15031-5) ----------------------\n#\n# Filled in for the ranges the request called out explicitly. Anything not in\n# this table returns None from :func:`obdmid_name` -- never a guessed name.\n\nOBDMID_NAMES: dict[str, str] = {\n    # O2 sensor monitors: bank 1-4, sensor 1-4 (Appendix D groups these as\n    # 16 consecutive MIDs; bank/sensor split below is the conventional one,\n    # not independently verified against the standard's exact wording).\n    \"01\": \"O2 sensor monitor bank 1 sensor 1\",\n    \"02\": \"O2 sensor monitor bank 1 sensor 2\",\n    \"03\": \"O2 sensor monitor bank 1 sensor 3\",\n    \"04\": \"O2 sensor monitor bank 1 sensor 4\",\n    \"05\": \"O2 sensor monitor bank 2 sensor 1\",\n    \"06\": \"O2 sensor monitor bank 2 sensor 2\",\n    \"07\": \"O2 sensor monitor bank 2 sensor 3\",\n    \"08\": \"O2 sensor monitor bank 2 sensor 4\",\n    \"09\": \"O2 sensor monitor bank 3 sensor 1\",\n    \"0A\": \"O2 sensor monitor bank 3 sensor 2\",\n    \"0B\": \"O2 sensor monitor bank 3 sensor 3\",\n    \"0C\": \"O2 sensor monitor bank 3 sensor 4\",\n    \"0D\": \"O2 sensor monitor bank 4 sensor 1\",\n    \"0E\": \"O2 sensor monitor bank 4 sensor 2\",\n    \"0F\": \"O2 sensor monitor bank 4 sensor 3\",\n    \"10\": \"O2 sensor monitor bank 4 sensor 4\",\n    # Catalyst monitor, bank 1-4.\n    \"21\": \"Catalyst monitor bank 1\",\n    \"22\": \"Catalyst monitor bank 2\",\n    \"23\": \"Catalyst monitor bank 3\",\n    \"24\": \"Catalyst monitor bank 4\",\n    # EGR monitor, bank 1-4.\n    \"31\": \"EGR monitor bank 1\",\n    \"32\": \"EGR monitor bank 2\",\n    \"33\": \"EGR monitor bank 3\",\n    \"34\": \"EGR monitor bank 4\",\n    # VVT monitor, bank 1-4.\n    \"35\": \"VVT monitor bank 1\",\n    \"36\": \"VVT monitor bank 2\",\n    \"37\": \"VVT monitor bank 3\",\n    \"38\": \"VVT monitor bank 4\",\n    # EVAP monitors.\n    \"39\": \"EVAP monitor (cap off / gross leak)\",\n    \"3A\": 'EVAP monitor 0.090\" leak',\n    \"3B\": 'EVAP monitor 0.040\" leak',\n    \"3C\": 'EVAP monitor 0.020\" leak',\n    \"3D\": \"EVAP purge flow monitor\",\n    # Misfire monitors: 0xA1 is the general/summary data, 0xA2-0xAD are\n    # cylinders 1-12.\n    \"A1\": \"Misfire monitor general data\",\n    \"A2\": \"Misfire monitor cylinder 1\",\n    \"A3\": \"Misfire monitor cylinder 2\",\n    \"A4\": \"Misfire monitor cylinder 3\",\n    \"A5\": \"Misfire monitor cylinder 4\",\n    \"A6\": \"Misfire monitor cylinder 5\",\n    \"A7\": \"Misfire monitor cylinder 6\",\n    \"A8\": \"Misfire monitor cylinder 7\",\n    \"A9\": \"Misfire monitor cylinder 8\",\n    \"AA\": \"Misfire monitor cylinder 9\",\n    \"AB\": \"Misfire monitor cylinder 10\",\n    \"AC\": \"Misfire monitor cylinder 11\",\n    \"AD\": \"Misfire monitor cylinder 12\",\n}\n\n#: EVAP OBDMIDs in the order the request lists them.\nEVAP_MIDS: tuple[str, ...] = (\"39\", \"3A\", \"3B\", \"3C\", \"3D\")\n\n\ndef obdmid_name(mid: str) -> Optional[str]:\n    return OBDMID_NAMES.get(mid.upper())\n\n\n# --- Unit-and-Scaling ID table -----------------------------------------------\n#\n# (unit, per-count multiplier) for the base (unsigned, 0x00-0x7F) IDs this\n# module is confident about. A UASID with bit 0x80 set is the signed mirror\n# of (uasid & 0x7F): same unit and multiplier, but the raw 16-bit field is\n# two's-complement rather than unsigned -- that halving of the ID space is a\n# structural fact of the table, independent of which individual entries are\n# known here.\n_UASID_TABLE: dict[int, tuple[str, float]] = {\n    0x01: (\"raw\", 1.0),      # raw count / no scaling\n    0x0A: (\"mV\", 0.122),     # voltage, 0.122 mV per count\n    0x10: (\"ms\", 1.0),       # time, 1 ms per count\n    0x24: (\"count\", 1.0),    # counter, 1 per count\n}\n#: UASIDs the request flagged but this module could not pin down confidently\n#: enough to scale (kept out of _UASID_TABLE deliberately -- see decode_uasid).\nUNCERTAIN_UASIDS: tuple[str, ...] = (\"0B\", \"14\", \"FD\", \"FE\")\n\n\ndef _twos_complement16(v: int) -> int:\n    return v - 0x10000 if v & 0x8000 else v\n\n\ndef decode_uasid(uasid_hex: str, raw: int) -> dict[str, Any]:\n    \"\"\"Scale one raw 16-bit Mode 06 field per its Unit-and-Scaling ID.\n\n    Returns ``{\"unit\": ..., \"value\": ..., \"scaling\": \"known\"|\"unknown\"}``.\n    Falls back to the untouched raw integer with ``\"scaling\": \"unknown\"``\n    whenever the UASID (or its unsigned base, for a signed one) is not in\n    ``_UASID_TABLE`` -- deliberately, rather than guessing a formula.\n    \"\"\"\n    try:\n        uid = int(uasid_hex, 16)\n    except (TypeError, ValueError):\n        return {\"unit\": None, \"value\": raw, \"scaling\": \"unknown\"}\n    signed = bool(uid & 0x80)\n    base = uid & 0x7F\n    entry = _UASID_TABLE.get(base)\n    if entry is None:\n        return {\"unit\": None, \"value\": raw, \"scaling\": \"unknown\"}\n    unit, scale = entry\n    value = _twos_complement16(raw) if signed else raw\n    scaled = value * scale\n    return {\"unit\": unit, \"value\": round(scaled, 6) if scale != 1.0 else int(scaled),\n            \"scaling\": \"known\"}\n\n\ndef decode_supported_mid_bitmap(base: str, data: list[str]) -> tuple[list[str], bool]:\n    \"\"\"Supported OBDMIDs from a ``46 <base> A B C D`` bitmap, and whether the\n    next block is supported. Delegates to :func:`obd.decode_supported_pids`:\n    the bit convention (MSB = base+1, LSB of the last byte = \"next block\n    supported\") is identical to Mode 01's supported-PID bitmaps.\n    \"\"\"\n    return decode_supported_pids(base, data)\n\n\n# --- test-result records -----------------------------------------------------\n\n#: SAE J1979 / ISO 15031-5 CAN format: the Mode $06 response is ``46`` followed\n#: by repeating 9-byte records, each carrying its own OBDMID:\n#: OBDMID(1) TID(1) UASID(1) value(2) min(2) max(2). An 8-byte stride (no\n#: MID per record) misreads every record after the first.\n_RECORD_LEN = 9\n\n\ndef _u16(hi: str, lo: str) -> int:\n    return (int(hi, 16) << 8) | int(lo, 16)\n\n\ndef decode_mode06_records(mid: str, payload: list[str]) -> list[dict[str, Any]]:\n    \"\"\"Decode the repeating test-result records of one Mode $06 reply.\n\n    ``payload`` is the byte list following ``46 <mid>`` (``data[2:]``), so\n    the first record's OBDMID has already been consumed as the echo; it is\n    put back and every record (9 bytes, own OBDMID) is read the same way.\n    Records whose OBDMID differs from the requested one are still decoded\n    under their own MID. Trailing bytes that do not fill a record are\n    ignored rather than raising.\n    \"\"\"\n    full = [mid.upper()] + [b.upper() for b in payload]\n    out: list[dict[str, Any]] = []\n    for i in range(0, len(full) - _RECORD_LEN + 1, _RECORD_LEN):\n        rmid, tid, uasid = full[i], full[i + 1], full[i + 2]\n        raw_value = _u16(full[i + 3], full[i + 4])\n        raw_min = _u16(full[i + 5], full[i + 6])\n        raw_max = _u16(full[i + 7], full[i + 8])\n        dv = decode_uasid(uasid, raw_value)\n        dmin = decode_uasid(uasid, raw_min)\n        dmax = decode_uasid(uasid, raw_max)\n        value, vmin, vmax = dv[\"value\"], dmin[\"value\"], dmax[\"value\"]\n        passed = vmin <= value <= vmax\n        out.append({\n            \"mid\": rmid, \"mid_name\": obdmid_name(rmid), \"tid\": tid, \"uasid\": uasid,\n            \"unit\": dv[\"unit\"], \"value\": value, \"min\": vmin, \"max\": vmax,\n            \"passed\": passed,\n            \"raw\": {\"value\": raw_value, \"min\": raw_min, \"max\": raw_max,\n                    \"scaling\": dv[\"scaling\"]},\n        })\n    return out\n\n\ndef evap_summary(read_result: dict[str, Any]) -> list[str]:\n    \"\"\"Plain-English sentences for the EVAP OBDMIDs (0x39-0x3D) in a\n    :func:`read_mode06` result. The sentence compares the test value against\n    the MAX limit -- these are upper-bound leak/flow thresholds -- even\n    though ``passed`` itself uses the full min<=value<=max range.\n    \"\"\"\n    results = read_result.get(\"results\") or {}\n    lines: list[str] = []\n    for mid in EVAP_MIDS:\n        name = obdmid_name(mid) or f\"MID {mid}\"\n        entry = results.get(mid) or {}\n        by_ecu = entry.get(\"by_ecu\") or {}\n        records = [r for recs in by_ecu.values() for r in recs]\n        if not records:\n            lines.append(f\"{name}: not supported by this ECU\")\n            continue\n        for r in records:\n            verdict = \"PASS\" if r[\"passed\"] else \"FAIL\"\n            unit = r.get(\"unit\")\n            suffix = f\" {unit}\" if unit and unit not in (\"raw\",) else \"\"\n            lines.append(f\"{name}: value {r['value']}{suffix} vs limit {r['max']}{suffix} \"\n                        f\"-> {verdict}\")\n    return lines\n\n\n# --- session reader -----------------------------------------------------------\n\n_SUPPORTED_BASES = (\"00\", \"20\", \"40\", \"60\", \"80\", \"A0\", \"C0\", \"E0\")\n\n\ndef _negative_lines(all_ecus: dict[str, list[str]]) -> dict[str, str]:\n    from .uds import NRC_TEXT  # local: keep this module free of the UDS client import\n    codes = negative_responses(all_ecus, \"06\")\n    return {hdr: f\"NRC 0x{code} ({NRC_TEXT.get(int(code, 16), 'unknown')})\"\n            for hdr, code in codes.items()}\n\n\ndef read_mode06(sess: Any, mids: Optional[list[str]] = None) -> dict[str, Any]:\n    \"\"\"Mode 06 discovery + test results. Never raises on NO DATA or a\n    negative response (0x7F 06 xx = the MID is not supported) -- both are\n    recorded in the result instead.\n\n    With ``mids=None``, discovers supported OBDMIDs per ECU first (``06 00``,\n    ``06 20``, ... while the previous bitmap's last bit says the next range\n    is supported) and reads every MID any ECU reported as supported. Passing\n    ``mids`` skips discovery and reads exactly those MIDs.\n    \"\"\"\n    sess.untarget()\n    out: dict[str, Any] = {\"raw\": {}, \"supported\": {}, \"results\": {}}\n    if mids is None:\n        discovered: dict[str, list[str]] = {}\n        for base in _SUPPORTED_BASES:\n            q = sess.query(f\"06{base}\", \"46\")\n            out[\"raw\"][f\"supported_{base}\"] = q[\"raw\"]\n            if q[\"error\"]:\n                out.setdefault(\"errors\", {})[base] = q[\"error\"]\n                break\n            any_next = False\n            for hdr, data in q[\"ecus\"].items():\n                if len(data) < 6 or data[1] != base:\n                    continue\n                supported, more = decode_supported_mid_bitmap(base, data[2:6])\n                discovered.setdefault(hdr, []).extend(supported)\n                any_next = any_next or more\n            if not any_next:\n                break\n        out[\"supported\"] = discovered\n        mids = sorted({m for lst in discovered.values() for m in lst})\n    else:\n        mids = [m.upper() for m in mids]\n        out[\"supported\"] = {\"requested\": list(mids)}\n    for mid in mids:\n        q = sess.query(f\"06{mid}\", \"46\")\n        out[\"raw\"][mid] = q[\"raw\"]\n        entry: dict[str, Any] = {}\n        if q[\"error\"]:\n            entry[\"error\"] = f\"ADAPTER/BUS ERROR: {q['error']}; the read did not complete\"\n            out[\"results\"][mid] = entry\n            continue\n        by_ecu: dict[str, list[dict[str, Any]]] = {}\n        for hdr, data in q[\"ecus\"].items():\n            if len(data) < 2 or data[1] != mid:\n                continue\n            recs = decode_mode06_records(mid, data[2:])\n            if recs:\n                by_ecu[hdr] = recs\n        neg = _negative_lines(q[\"all_ecus\"])\n        if neg:\n            entry[\"negative\"] = neg\n        if by_ecu:\n            entry[\"by_ecu\"] = by_ecu\n        elif not neg:\n            entry[\"warning\"] = \"NO DATA\" if no_data(q[\"raw\"]) else \"no ECU answered this MID\"\n        out[\"results\"][mid] = entry\n    return out\n\n\n__all__ = [\n    \"OBDMID_NAMES\", \"EVAP_MIDS\", \"obdmid_name\", \"UNCERTAIN_UASIDS\", \"decode_uasid\",\n    \"decode_supported_mid_bitmap\", \"decode_mode06_records\", \"evap_summary\", \"read_mode06\",\n]\n","numLines":302,"startLine":1,"totalLines":302}},"sourceToolAssistantUUID":"ad917cb3-72f7-4522-93cc-70abadaa70b1","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
