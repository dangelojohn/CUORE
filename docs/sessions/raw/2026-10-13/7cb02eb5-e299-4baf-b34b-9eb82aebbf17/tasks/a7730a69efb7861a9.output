{"parentUuid":"d96cf37f-3a22-4ce0-9d4e-c0d6b80705cd","isSidechain":true,"agentId":"a7730a69efb7861a9","message":{"model":"claude-sonnet-5","id":"msg_011Cfpj3kry9o9H1RRbLpCQr","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_013PMTDBdfw9H35gc5o4jQDs","name":"Read","input":{"file_path":"C:\\Users\\User\\mcp-servers\\cuore\\tests\\check_systems_page.py"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":203,"cache_read_input_tokens":175110,"cache_creation":{"ephemeral_5m_input_tokens":203,"ephemeral_1h_input_tokens":0},"output_tokens":21,"service_tier":"standard","inference_geo":"not_available"},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_013PMTDBdfw9H35gc5o4jQDs":{"file_path":"C:\\Users\\User\\mcp-servers\\cuore\\tests\\check_systems_page.py"}},"serverClassifierRequest":"9df3407b-e63a-465c-91fe-182d07803755","apiBlockIndex":0,"requestId":"req_011Cfpj3karwtcPaFXZ1ZAEA","attributionAgent":"general-purpose","type":"assistant","uuid":"76219787-a1e9-4451-a543-103bc1022e7d","timestamp":"2026-10-08T11:54:46.913Z","effort":"high","perTurnEffort":null,"userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
{"parentUuid":"76219787-a1e9-4451-a543-103bc1022e7d","isSidechain":true,"promptId":"8d7a9b8a-0751-4afa-abdb-27ba48fb0f3e","agentId":"a7730a69efb7861a9","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_013PMTDBdfw9H35gc5o4jQDs","type":"tool_result","content":"1\t\"\"\"Checks for the system-dependency view (``/v/{vin}/systems``), the\n2\t``_system_badge.html`` chips on ``code.html``, and the timeline's\n3\t``?lanes=systems`` grouping mode.\n4\t\n5\tSame posture as ``cuore/tests/check_timeline_page.py`` (CDP screenshot\n6\tplumbing copied from there almost verbatim): ``CUORE_STATE_DIR`` is pointed\n7\tat a throwaway directory before cuore is imported, and\n8\t``cuore/web/systems_routes.py``/``cuore/web/timeline_routes.py`` are not\n9\tnecessarily wired into ``cuore/app.py`` yet, so this includes them itself\n10\tif ``create_app()`` did not already pick them up.\n11\t\n12\t``cuore/services/systems_bridge.py`` is being built in parallel by another\n13\tagent and may not exist yet -- every route this touches falls back to its\n14\town fixture in that case, so every check below runs either way.\n15\t\n16\tRun:\n17\t    .venv/Scripts/python.exe cuore/tests/check_systems_page.py\n18\t\"\"\"\n19\t\n20\tfrom __future__ import annotations\n21\t\n22\timport base64\n23\timport itertools\n24\timport json\n25\timport os\n26\timport socket\n27\timport subprocess\n28\timport sys\n29\timport tempfile\n30\timport time\n31\timport urllib.request\n32\tfrom pathlib import Path\n33\t\n34\tos.environ[\"CUORE_STATE_DIR\"] = tempfile.mkdtemp(prefix=\"cuore-check-systems-\")\n35\tos.environ.pop(\"CUORE_AUDIT_PATH\", None)\n36\t\n37\tROOT = Path(__file__).resolve().parents[2]\n38\tsys.path.insert(0, str(ROOT))\n39\t\n40\tfrom fastapi.testclient import TestClient  # noqa: E402\n41\t\n42\tfrom cuore.app import create_app  # noqa: E402\n43\tfrom cuore.web import systems_routes, timeline_routes  # noqa: E402\n44\t\n45\tfrom websockets.sync.client import connect  # noqa: E402\n46\t\n47\tVIN = \"ZASFAKPN5J7B88115\"           # the Stelvio -- real corpus\n48\tEDGE_CANDIDATES = [\n49\t    r\"C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe\",\n50\t    r\"C:\\Program Files\\Microsoft\\Edge\\Application\\msedge.exe\",\n51\t]\n52\tSCRATCHPAD = Path(r\"C:\\Users\\User\\AppData\\Local\\Temp\\claude\\C--Users-User\"\n53\t                  r\"\\7cb02eb5-e299-4baf-b34b-9eb82aebbf17\\scratchpad\")\n54\t\n55\tfailures: list[str] = []\n56\tchecks = 0\n57\t\n58\t\n59\tdef check(label: str, cond: bool, detail: str = \"\") -> None:\n60\t    global checks\n61\t    checks += 1\n62\t    mark = \"ok\" if cond else \"FAIL\"\n63\t    print(f\"  [{mark}] {label}\" + (f\" -- {detail}\" if detail and not cond else \"\"))\n64\t    if not cond:\n65\t        failures.append(label)\n66\t\n67\t\n68\tdef _app_with_routers():\n69\t    app = create_app()\n70\t    if not any(getattr(r, \"path\", \"\").startswith(\"/v/{vin}/systems\") for r in app.routes):\n71\t        app.include_router(systems_routes.router)\n72\t    if not any(getattr(r, \"path\", \"\").startswith(\"/v/{vin}/timeline\") for r in app.routes):\n73\t        app.include_router(timeline_routes.router)\n74\t    return app\n75\t\n76\t\n77\t# ===========================================================================\n78\t# TestClient checks\n79\t# ===========================================================================\n80\t\n81\tprint(\"=== systems page (TestClient) ===\")\n82\tclient = TestClient(_app_with_routers())\n83\t\n84\tpage = client.get(f\"/v/{VIN}/systems\")\n85\tcheck(\"systems page responds 200\", page.status_code == 200, str(page.status_code))\n86\tcheck(\"no template error leaked onto the page\",\n87\t      \"Jinja2\" not in page.text and \"Traceback\" not in page.text)\n88\tcheck(\"dependency graph svg present\", \"<svg\" in page.text and \"System dependency graph\" in page.text)\n89\tcheck(\"legend present (status + edge-confidence keys)\",\n90\t      \"cleared, unverified\" in page.text and \"single source\" in page.text)\n91\tcheck(\"dashed/dotted edge strokes are emitted (stroke-dasharray)\",\n92\t      \"stroke-dasharray\" in page.text)\n93\tcheck(\"per-system card anchors present (id=\\\"sys-...\\\")\", 'id=\"sys-evap\"' in page.text)\n94\tcheck(\"vbar carries a Systems tab\", \">Systems<\" in page.text)\n95\t\n96\tprint(\"=== code page system badge ===\")\n97\tcode_resp = client.get(f\"/v/{VIN}/code/P0455\")\n98\tcheck(\"code page responds 200\", code_resp.status_code == 200, str(code_resp.status_code))\n99\tcheck(\"EVAP system badge present on P0455\", \"sysb-row\" in code_resp.text and \"EVAP\" in code_resp.text\n100\t      and \"(primary)\" in code_resp.text)\n101\tcheck(\"badge links to the systems page\", f'/v/{VIN}/systems#sys-evap' in code_resp.text)\n102\t\n103\tprint(\"=== timeline ?lanes=systems ===\")\n104\ttl_resp = client.get(f\"/v/{VIN}/timeline?lanes=systems\")\n105\tcheck(\"timeline lanes=systems responds 200\", tl_resp.status_code == 200, str(tl_resp.status_code))\n106\tcheck(\"group toggle present\", \">System<\" in tl_resp.text and \">Family<\" in tl_resp.text)\n107\ttl_family = client.get(f\"/v/{VIN}/timeline\")\n108\tcheck(\"timeline default (family) still responds 200\", tl_family.status_code == 200)\n109\t\n110\t\n111\t# ===========================================================================\n112\t# CDP plumbing (copied from check_timeline_page.py)\n113\t# ===========================================================================\n114\t\n115\tdef find_edge() -> str:\n116\t    for candidate in EDGE_CANDIDATES:\n117\t        if Path(candidate).exists():\n118\t            return candidate\n119\t    return \"\"\n120\t\n121\t\n122\tdef free_port() -> int:\n123\t    s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)\n124\t    s.bind((\"127.0.0.1\", 0))\n125\t    port = s.getsockname()[1]\n126\t    s.close()\n127\t    return port\n128\t\n129\t\n130\tclass CDP:\n131\t    def __init__(self, ws_url: str) -> None:\n132\t        self.ws = connect(ws_url, max_size=None, open_timeout=20)\n133\t        self._ids = itertools.count(1)\n134\t\n135\t    def send(self, method: str, params: dict | None = None, timeout: float = 20):\n136\t        msg_id = next(self._ids)\n137\t        self.ws.send(json.dumps({\"id\": msg_id, \"method\": method, \"params\": params or {}}))\n138\t        deadline = time.time() + timeout\n139\t        while time.time() < deadline:\n140\t            raw = self.ws.recv(timeout=max(0.1, deadline - time.time()))\n141\t            msg = json.loads(raw)\n142\t            if msg.get(\"id\") == msg_id:\n143\t                if \"error\" in msg:\n144\t                    raise RuntimeError(f\"CDP {method} failed: {msg['error']}\")\n145\t                return msg.get(\"result\", {})\n146\t        raise TimeoutError(f\"CDP {method} timed out waiting for response\")\n147\t\n148\t    def close(self) -> None:\n149\t        try:\n150\t            self.ws.close()\n151\t        except Exception:\n152\t            pass\n153\t\n154\t\n155\tdef wait_for_devtools(port: int, timeout: float = 20) -> None:\n156\t    deadline = time.time() + timeout\n157\t    last_err: Exception | None = None\n158\t    while time.time() < deadline:\n159\t        try:\n160\t            with urllib.request.urlopen(f\"http://127.0.0.1:{port}/json/version\", timeout=2) as r:\n161\t                json.loads(r.read().decode(\"utf-8\"))\n162\t                return\n163\t        except Exception as exc:  # noqa: BLE001\n164\t            last_err = exc\n165\t            time.sleep(0.2)\n166\t    raise RuntimeError(f\"headless Edge devtools endpoint never came up: {last_err}\")\n167\t\n168\t\n169\tdef open_target(port: int, url: str) -> dict:\n170\t    req = urllib.request.Request(f\"http://127.0.0.1:{port}/json/new?{url}\", method=\"PUT\")\n171\t    with urllib.request.urlopen(req, timeout=10) as r:\n172\t        return json.loads(r.read().decode(\"utf-8\"))\n173\t\n174\t\n175\tdef wait_for_port(port: int, timeout: float = 15.0) -> bool:\n176\t    deadline = time.monotonic() + timeout\n177\t    while time.monotonic() < deadline:\n178\t        try:\n179\t            with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:\n180\t                s.settimeout(0.3)\n181\t                s.connect((\"127.0.0.1\", port))\n182\t                return True\n183\t        except OSError:\n184\t            time.sleep(0.2)\n185\t    return False\n186\t\n187\t\n188\t# ===========================================================================\n189\t# one 400px screenshot + the horizontal-overflow check\n190\t# ===========================================================================\n191\t\n192\tprint(\"=== screenshot + overflow at 400px ===\")\n193\tedge = find_edge()\n194\tserver_dir = tempfile.mkdtemp(prefix=\"cuore-check-systems-server-\")\n195\tport = free_port()\n196\tenv = dict(os.environ)\n197\tenv[\"CUORE_STATE_DIR\"] = server_dir\n198\t\n199\t_SERVER_SNIPPET = f\"\"\"\n200\timport sys\n201\tsys.path.insert(0, {str(ROOT)!r})\n202\tfrom cuore.app import create_app\n203\tfrom cuore.web import systems_routes, timeline_routes\n204\timport uvicorn\n205\t\n206\tapp = create_app()\n207\tif not any(getattr(r, \"path\", \"\").startswith(\"/v/{{vin}}/systems\") for r in app.routes):\n208\t    app.include_router(systems_routes.router)\n209\tif not any(getattr(r, \"path\", \"\").startswith(\"/v/{{vin}}/timeline\") for r in app.routes):\n210\t    app.include_router(timeline_routes.router)\n211\tuvicorn.run(app, host=\"127.0.0.1\", port={port}, log_level=\"warning\")\n212\t\"\"\"\n213\t\n214\tif not edge:\n215\t    check(\"headless Edge is available for the screenshot\", False, str(EDGE_CANDIDATES))\n216\telse:\n217\t    server_proc = subprocess.Popen(\n218\t        [sys.executable, \"-c\", _SERVER_SNIPPET],\n219\t        cwd=str(ROOT), env=env,\n220\t        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,\n221\t    )\n222\t    try:\n223\t        up = wait_for_port(port)\n224\t        check(\"uvicorn came up on the free port\", up, f\"port {port}\")\n225\t        if up:\n226\t            time.sleep(0.5)\n227\t            devtools_port = free_port()\n228\t            profile_dir = Path(tempfile.mkdtemp(prefix=\"cuore-edge-systems-\"))\n229\t            edge_proc = subprocess.Popen(\n230\t                [edge, \"--headless=new\", f\"--remote-debugging-port={devtools_port}\",\n231\t                 f\"--user-data-dir={profile_dir}\", \"--no-first-run\", \"--window-size=400,1400\",\n232\t                 \"about:blank\"],\n233\t                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,\n234\t            )\n235\t            try:\n236\t                wait_for_devtools(devtools_port)\n237\t                url = f\"http://127.0.0.1:{port}/v/{VIN}/systems\"\n238\t                target = open_target(devtools_port, url)\n239\t                cdp = CDP(target[\"webSocketDebuggerUrl\"])\n240\t                try:\n241\t                    cdp.send(\"Page.enable\")\n242\t                    cdp.send(\"Runtime.enable\")\n243\t                    time.sleep(2.0)  # cold-cache first request: real MES-corpus workup\n244\t                    cdp.send(\"Emulation.setDeviceMetricsOverride\", {\n245\t                        \"width\": 400, \"height\": 1400, \"deviceScaleFactor\": 1, \"mobile\": True,\n246\t                    })\n247\t                    time.sleep(0.6)\n248\t                    overflow = cdp.send(\"Runtime.evaluate\", {\n249\t                        \"expression\": (\n250\t                            \"JSON.stringify({sw: document.documentElement.scrollWidth, \"\n251\t                            \"cw: document.documentElement.clientWidth})\"),\n252\t                        \"returnByValue\": True,\n253\t                    })\n254\t                    dims = json.loads(overflow.get(\"result\", {}).get(\"value\", \"{}\"))\n255\t                    sw, cw = dims.get(\"sw\", 0), dims.get(\"cw\", 0)\n256\t                    check(\"no page-level horizontal overflow at 400px\",\n257\t                         sw <= cw + 1, f\"scrollWidth={sw} clientWidth={cw}\")\n258\t\n259\t                    SCRATCHPAD.mkdir(parents=True, exist_ok=True)\n260\t                    out_path = SCRATCHPAD / \"systems_phone.png\"\n261\t                    shot = cdp.send(\"Page.captureScreenshot\",\n262\t                                   {\"format\": \"png\", \"captureBeyondViewport\": False})\n263\t                    out_path.write_bytes(base64.b64decode(shot[\"data\"]))\n264\t                    check(\"screenshot captured\", out_path.exists() and out_path.stat().st_size > 0,\n265\t                         str(out_path))\n266\t                    if out_path.exists():\n267\t                        print(f\"  wrote {out_path} ({out_path.stat().st_size} bytes)\")\n268\t                finally:\n269\t                    cdp.close()\n270\t            except Exception as exc:  # noqa: BLE001\n271\t                check(\"headless Edge captured the screenshot over CDP\", False, f\"{type(exc).__name__}: {exc}\")\n272\t            finally:\n273\t                edge_proc.terminate()\n274\t                try:\n275\t                    edge_proc.wait(timeout=5)\n276\t                except Exception:\n277\t                    edge_proc.kill()\n278\t                from _edge_cleanup import kill_edge_profile\n279\t                kill_edge_profile(profile_dir)\n280\t    finally:\n281\t        server_proc.terminate()\n282\t        try:\n283\t            server_proc.wait(timeout=10)\n284\t        except subprocess.TimeoutExpired:\n285\t            server_proc.kill()\n286\t            server_proc.wait(timeout=10)\n287\t\n288\t\n289\t# ===========================================================================\n290\t# report\n291\t# ===========================================================================\n292\t\n293\tprint()\n294\tif failures:\n295\t    print(f\"{len(failures)}/{checks} check(s) failed:\")\n296\t    for f in failures:\n297\t        print(f\"  - {f}\")\n298\t    print(f\"{checks - len(failures)}/{checks} checks passed\")\n299\t    sys.exit(1)\n300\tprint(f\"{checks}/{checks} checks passed\")\n301\t"}]},"uuid":"e51cae56-4bd9-4cce-bad4-6f2530dc99d5","timestamp":"2026-10-08T11:54:46.933Z","toolUseResult":{"type":"text","file":{"filePath":"C:\\Users\\User\\mcp-servers\\cuore\\tests\\check_systems_page.py","content":"\"\"\"Checks for the system-dependency view (``/v/{vin}/systems``), the\n``_system_badge.html`` chips on ``code.html``, and the timeline's\n``?lanes=systems`` grouping mode.\n\nSame posture as ``cuore/tests/check_timeline_page.py`` (CDP screenshot\nplumbing copied from there almost verbatim): ``CUORE_STATE_DIR`` is pointed\nat a throwaway directory before cuore is imported, and\n``cuore/web/systems_routes.py``/``cuore/web/timeline_routes.py`` are not\nnecessarily wired into ``cuore/app.py`` yet, so this includes them itself\nif ``create_app()`` did not already pick them up.\n\n``cuore/services/systems_bridge.py`` is being built in parallel by another\nagent and may not exist yet -- every route this touches falls back to its\nown fixture in that case, so every check below runs either way.\n\nRun:\n    .venv/Scripts/python.exe cuore/tests/check_systems_page.py\n\"\"\"\n\nfrom __future__ import annotations\n\nimport base64\nimport itertools\nimport json\nimport os\nimport socket\nimport subprocess\nimport sys\nimport tempfile\nimport time\nimport urllib.request\nfrom pathlib import Path\n\nos.environ[\"CUORE_STATE_DIR\"] = tempfile.mkdtemp(prefix=\"cuore-check-systems-\")\nos.environ.pop(\"CUORE_AUDIT_PATH\", None)\n\nROOT = Path(__file__).resolve().parents[2]\nsys.path.insert(0, str(ROOT))\n\nfrom fastapi.testclient import TestClient  # noqa: E402\n\nfrom cuore.app import create_app  # noqa: E402\nfrom cuore.web import systems_routes, timeline_routes  # noqa: E402\n\nfrom websockets.sync.client import connect  # noqa: E402\n\nVIN = \"ZASFAKPN5J7B88115\"           # the Stelvio -- real corpus\nEDGE_CANDIDATES = [\n    r\"C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe\",\n    r\"C:\\Program Files\\Microsoft\\Edge\\Application\\msedge.exe\",\n]\nSCRATCHPAD = Path(r\"C:\\Users\\User\\AppData\\Local\\Temp\\claude\\C--Users-User\"\n                  r\"\\7cb02eb5-e299-4baf-b34b-9eb82aebbf17\\scratchpad\")\n\nfailures: list[str] = []\nchecks = 0\n\n\ndef check(label: str, cond: bool, detail: str = \"\") -> None:\n    global checks\n    checks += 1\n    mark = \"ok\" if cond else \"FAIL\"\n    print(f\"  [{mark}] {label}\" + (f\" -- {detail}\" if detail and not cond else \"\"))\n    if not cond:\n        failures.append(label)\n\n\ndef _app_with_routers():\n    app = create_app()\n    if not any(getattr(r, \"path\", \"\").startswith(\"/v/{vin}/systems\") for r in app.routes):\n        app.include_router(systems_routes.router)\n    if not any(getattr(r, \"path\", \"\").startswith(\"/v/{vin}/timeline\") for r in app.routes):\n        app.include_router(timeline_routes.router)\n    return app\n\n\n# ===========================================================================\n# TestClient checks\n# ===========================================================================\n\nprint(\"=== systems page (TestClient) ===\")\nclient = TestClient(_app_with_routers())\n\npage = client.get(f\"/v/{VIN}/systems\")\ncheck(\"systems page responds 200\", page.status_code == 200, str(page.status_code))\ncheck(\"no template error leaked onto the page\",\n      \"Jinja2\" not in page.text and \"Traceback\" not in page.text)\ncheck(\"dependency graph svg present\", \"<svg\" in page.text and \"System dependency graph\" in page.text)\ncheck(\"legend present (status + edge-confidence keys)\",\n      \"cleared, unverified\" in page.text and \"single source\" in page.text)\ncheck(\"dashed/dotted edge strokes are emitted (stroke-dasharray)\",\n      \"stroke-dasharray\" in page.text)\ncheck(\"per-system card anchors present (id=\\\"sys-...\\\")\", 'id=\"sys-evap\"' in page.text)\ncheck(\"vbar carries a Systems tab\", \">Systems<\" in page.text)\n\nprint(\"=== code page system badge ===\")\ncode_resp = client.get(f\"/v/{VIN}/code/P0455\")\ncheck(\"code page responds 200\", code_resp.status_code == 200, str(code_resp.status_code))\ncheck(\"EVAP system badge present on P0455\", \"sysb-row\" in code_resp.text and \"EVAP\" in code_resp.text\n      and \"(primary)\" in code_resp.text)\ncheck(\"badge links to the systems page\", f'/v/{VIN}/systems#sys-evap' in code_resp.text)\n\nprint(\"=== timeline ?lanes=systems ===\")\ntl_resp = client.get(f\"/v/{VIN}/timeline?lanes=systems\")\ncheck(\"timeline lanes=systems responds 200\", tl_resp.status_code == 200, str(tl_resp.status_code))\ncheck(\"group toggle present\", \">System<\" in tl_resp.text and \">Family<\" in tl_resp.text)\ntl_family = client.get(f\"/v/{VIN}/timeline\")\ncheck(\"timeline default (family) still responds 200\", tl_family.status_code == 200)\n\n\n# ===========================================================================\n# CDP plumbing (copied from check_timeline_page.py)\n# ===========================================================================\n\ndef find_edge() -> str:\n    for candidate in EDGE_CANDIDATES:\n        if Path(candidate).exists():\n            return candidate\n    return \"\"\n\n\ndef free_port() -> int:\n    s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)\n    s.bind((\"127.0.0.1\", 0))\n    port = s.getsockname()[1]\n    s.close()\n    return port\n\n\nclass CDP:\n    def __init__(self, ws_url: str) -> None:\n        self.ws = connect(ws_url, max_size=None, open_timeout=20)\n        self._ids = itertools.count(1)\n\n    def send(self, method: str, params: dict | None = None, timeout: float = 20):\n        msg_id = next(self._ids)\n        self.ws.send(json.dumps({\"id\": msg_id, \"method\": method, \"params\": params or {}}))\n        deadline = time.time() + timeout\n        while time.time() < deadline:\n            raw = self.ws.recv(timeout=max(0.1, deadline - time.time()))\n            msg = json.loads(raw)\n            if msg.get(\"id\") == msg_id:\n                if \"error\" in msg:\n                    raise RuntimeError(f\"CDP {method} failed: {msg['error']}\")\n                return msg.get(\"result\", {})\n        raise TimeoutError(f\"CDP {method} timed out waiting for response\")\n\n    def close(self) -> None:\n        try:\n            self.ws.close()\n        except Exception:\n            pass\n\n\ndef wait_for_devtools(port: int, timeout: float = 20) -> None:\n    deadline = time.time() + timeout\n    last_err: Exception | None = None\n    while time.time() < deadline:\n        try:\n            with urllib.request.urlopen(f\"http://127.0.0.1:{port}/json/version\", timeout=2) as r:\n                json.loads(r.read().decode(\"utf-8\"))\n                return\n        except Exception as exc:  # noqa: BLE001\n            last_err = exc\n            time.sleep(0.2)\n    raise RuntimeError(f\"headless Edge devtools endpoint never came up: {last_err}\")\n\n\ndef open_target(port: int, url: str) -> dict:\n    req = urllib.request.Request(f\"http://127.0.0.1:{port}/json/new?{url}\", method=\"PUT\")\n    with urllib.request.urlopen(req, timeout=10) as r:\n        return json.loads(r.read().decode(\"utf-8\"))\n\n\ndef wait_for_port(port: int, timeout: float = 15.0) -> bool:\n    deadline = time.monotonic() + timeout\n    while time.monotonic() < deadline:\n        try:\n            with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:\n                s.settimeout(0.3)\n                s.connect((\"127.0.0.1\", port))\n                return True\n        except OSError:\n            time.sleep(0.2)\n    return False\n\n\n# ===========================================================================\n# one 400px screenshot + the horizontal-overflow check\n# ===========================================================================\n\nprint(\"=== screenshot + overflow at 400px ===\")\nedge = find_edge()\nserver_dir = tempfile.mkdtemp(prefix=\"cuore-check-systems-server-\")\nport = free_port()\nenv = dict(os.environ)\nenv[\"CUORE_STATE_DIR\"] = server_dir\n\n_SERVER_SNIPPET = f\"\"\"\nimport sys\nsys.path.insert(0, {str(ROOT)!r})\nfrom cuore.app import create_app\nfrom cuore.web import systems_routes, timeline_routes\nimport uvicorn\n\napp = create_app()\nif not any(getattr(r, \"path\", \"\").startswith(\"/v/{{vin}}/systems\") for r in app.routes):\n    app.include_router(systems_routes.router)\nif not any(getattr(r, \"path\", \"\").startswith(\"/v/{{vin}}/timeline\") for r in app.routes):\n    app.include_router(timeline_routes.router)\nuvicorn.run(app, host=\"127.0.0.1\", port={port}, log_level=\"warning\")\n\"\"\"\n\nif not edge:\n    check(\"headless Edge is available for the screenshot\", False, str(EDGE_CANDIDATES))\nelse:\n    server_proc = subprocess.Popen(\n        [sys.executable, \"-c\", _SERVER_SNIPPET],\n        cwd=str(ROOT), env=env,\n        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,\n    )\n    try:\n        up = wait_for_port(port)\n        check(\"uvicorn came up on the free port\", up, f\"port {port}\")\n        if up:\n            time.sleep(0.5)\n            devtools_port = free_port()\n            profile_dir = Path(tempfile.mkdtemp(prefix=\"cuore-edge-systems-\"))\n            edge_proc = subprocess.Popen(\n                [edge, \"--headless=new\", f\"--remote-debugging-port={devtools_port}\",\n                 f\"--user-data-dir={profile_dir}\", \"--no-first-run\", \"--window-size=400,1400\",\n                 \"about:blank\"],\n                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,\n            )\n            try:\n                wait_for_devtools(devtools_port)\n                url = f\"http://127.0.0.1:{port}/v/{VIN}/systems\"\n                target = open_target(devtools_port, url)\n                cdp = CDP(target[\"webSocketDebuggerUrl\"])\n                try:\n                    cdp.send(\"Page.enable\")\n                    cdp.send(\"Runtime.enable\")\n                    time.sleep(2.0)  # cold-cache first request: real MES-corpus workup\n                    cdp.send(\"Emulation.setDeviceMetricsOverride\", {\n                        \"width\": 400, \"height\": 1400, \"deviceScaleFactor\": 1, \"mobile\": True,\n                    })\n                    time.sleep(0.6)\n                    overflow = cdp.send(\"Runtime.evaluate\", {\n                        \"expression\": (\n                            \"JSON.stringify({sw: document.documentElement.scrollWidth, \"\n                            \"cw: document.documentElement.clientWidth})\"),\n                        \"returnByValue\": True,\n                    })\n                    dims = json.loads(overflow.get(\"result\", {}).get(\"value\", \"{}\"))\n                    sw, cw = dims.get(\"sw\", 0), dims.get(\"cw\", 0)\n                    check(\"no page-level horizontal overflow at 400px\",\n                         sw <= cw + 1, f\"scrollWidth={sw} clientWidth={cw}\")\n\n                    SCRATCHPAD.mkdir(parents=True, exist_ok=True)\n                    out_path = SCRATCHPAD / \"systems_phone.png\"\n                    shot = cdp.send(\"Page.captureScreenshot\",\n                                   {\"format\": \"png\", \"captureBeyondViewport\": False})\n                    out_path.write_bytes(base64.b64decode(shot[\"data\"]))\n                    check(\"screenshot captured\", out_path.exists() and out_path.stat().st_size > 0,\n                         str(out_path))\n                    if out_path.exists():\n                        print(f\"  wrote {out_path} ({out_path.stat().st_size} bytes)\")\n                finally:\n                    cdp.close()\n            except Exception as exc:  # noqa: BLE001\n                check(\"headless Edge captured the screenshot over CDP\", False, f\"{type(exc).__name__}: {exc}\")\n            finally:\n                edge_proc.terminate()\n                try:\n                    edge_proc.wait(timeout=5)\n                except Exception:\n                    edge_proc.kill()\n                from _edge_cleanup import kill_edge_profile\n                kill_edge_profile(profile_dir)\n    finally:\n        server_proc.terminate()\n        try:\n            server_proc.wait(timeout=10)\n        except subprocess.TimeoutExpired:\n            server_proc.kill()\n            server_proc.wait(timeout=10)\n\n\n# ===========================================================================\n# report\n# ===========================================================================\n\nprint()\nif failures:\n    print(f\"{len(failures)}/{checks} check(s) failed:\")\n    for f in failures:\n        print(f\"  - {f}\")\n    print(f\"{checks - len(failures)}/{checks} checks passed\")\n    sys.exit(1)\nprint(f\"{checks}/{checks} checks passed\")\n","numLines":301,"startLine":1,"totalLines":301}},"sourceToolAssistantUUID":"76219787-a1e9-4451-a543-103bc1022e7d","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
