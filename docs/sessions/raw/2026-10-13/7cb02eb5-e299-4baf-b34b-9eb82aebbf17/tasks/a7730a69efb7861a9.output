{"parentUuid":"97e57281-f2b0-4743-b28c-2280395236be","isSidechain":true,"agentId":"a7730a69efb7861a9","message":{"model":"claude-sonnet-5","id":"msg_011CfpiL96maxNVAsJtDGv6X","type":"message","role":"assistant","content":[{"type":"thinking","thinking":"","signature":""}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":5313,"cache_read_input_tokens":57039,"cache_creation":{"ephemeral_5m_input_tokens":5313,"ephemeral_1h_input_tokens":0},"output_tokens":2,"service_tier":"standard","inference_geo":"not_available"},"input_transformations":[],"diagnostics":null,"context_management":null},"serverClassifierRequest":"9ed0e821-4ec7-4f6b-88da-dffe657851c3","apiBlockIndex":0,"requestId":"req_011CfpiL8rt1sPU77fgQPHPo","attributionAgent":"general-purpose","type":"assistant","uuid":"f4edb0f9-fa11-4b21-9032-81bc98246f55","timestamp":"2026-10-08T11:45:22.748Z","effort":"high","perTurnEffort":null,"userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
{"parentUuid":"f4edb0f9-fa11-4b21-9032-81bc98246f55","isSidechain":true,"agentId":"a7730a69efb7861a9","message":{"model":"claude-sonnet-5","id":"msg_011CfpiL96maxNVAsJtDGv6X","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_011rF8CrSNhyf6o47YpzdHaN","name":"Read","input":{"file_path":"C:\\Users\\User\\mcp-servers\\mes-log-mcp\\mes\\systems.py"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":5313,"cache_read_input_tokens":57039,"cache_creation":{"ephemeral_5m_input_tokens":5313,"ephemeral_1h_input_tokens":0},"output_tokens":2,"service_tier":"standard","inference_geo":"not_available"},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_011rF8CrSNhyf6o47YpzdHaN":{"file_path":"C:\\Users\\User\\mcp-servers\\mes-log-mcp\\mes\\systems.py"}},"serverClassifierRequest":"9ed0e821-4ec7-4f6b-88da-dffe657851c3","apiBlockIndex":1,"requestId":"req_011CfpiL8rt1sPU77fgQPHPo","attributionAgent":"general-purpose","type":"assistant","uuid":"92101773-2336-4ad8-8bde-85c9818dfe37","timestamp":"2026-10-08T11:45:23.296Z","effort":"high","perTurnEffort":null,"userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
{"parentUuid":"92101773-2336-4ad8-8bde-85c9818dfe37","isSidechain":true,"promptId":"b7d5245f-77ce-48c1-8f3f-a89a5e1f4f71","agentId":"a7730a69efb7861a9","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_011rF8CrSNhyf6o47YpzdHaN","type":"tool_result","content":"1\t\"\"\"Vehicle SYSTEMS as a correlational dimension, cutting across every DTC.\n2\t\n3\tA code lookup answers \"what fault is this\"; it does not answer \"what else on\n4\tthis car shares a cause with it\". This module adds that second axis: every\n5\tDTC is assigned to one or more ordered vehicle systems (``SYSTEMS``), with a\n6\t``depends_on`` graph recording which systems are documented as upstream of\n7\twhich others (a BCM supply fault cascading into network U-codes, an EVAP\n8\tleak code that can trace back to the fuel tank/cap it shares with the fuel\n9\tsystem). ``mes.workup``/``mes.analysis`` already answer \"what DTCs happened,\n10\twhen, together\" per vehicle; :func:`correlate` reuses that corpus data and\n11\tprojects it onto the system graph.\n12\t\n13\tNothing here is invented. Every ``depends_on`` edge and every exact-code\n14\tsystem assignment carries a ``source`` -- either a citation (this project's\n15\town ``mes.knowledge`` TSB table, ``mes.code_feel``, ``mes.parts``, or the\n16\tgeneric SAE J2012 DTC-prefix convention, named as generic every time it is\n17\tused) or, for a relationship nobody has sourced, ``confidence=\"UNKNOWN\"``\n18\twith a note pointing at the service manual -- never a silently guessed\n19\tdependency. :func:`correlate` is equally careful with its own output: it\n20\tnever asserts a dependency is *proven*, only that the corpus shows two\n21\tsystems' codes appearing together, worded as \"could be upstream\", with the\n22\tsession counts that back (or don't back) that reading.\n23\t\n24\tConfidence levels (same scale as the rest of this package):\n25\t\n26\t* ``CONFIRMED``     -- stated in this repo's own sourced table (an FCA/Alfa\n27\t                       TSB in ``mes.knowledge``, or a documented part/DTC\n28\t                       definition) or the DTC's own SAE-defined meaning\n29\t                       (e.g. a P0300-04 misfire code by definition implicates\n30\t                       ignition and fuel delivery).\n31\t* ``CORROBORATED``  -- two independent sourced findings agree (e.g. the\n32\t                       U-code -> network assignment: SAE's communication-DTC\n33\t                       range, corroborated by ``mes.knowledge.match_codes``'\n34\t                       own network-cascade family rule).\n35\t* ``SINGLE-SOURCE``  -- one source, or a generic SAE range convention used as\n36\t                       a last-resort, explicitly generic fallback.\n37\t* ``UNKNOWN``       -- no sourced relationship found; recorded as such\n38\t                       rather than guessed.\n39\t\"\"\"\n40\t\n41\tfrom __future__ import annotations\n42\t\n43\timport re\n44\tfrom datetime import date\n45\tfrom typing import Any, Optional\n46\t\n47\tCONFIRMED = \"CONFIRMED\"\n48\tCORROBORATED = \"CORROBORATED\"\n49\tSINGLE_SOURCE = \"SINGLE-SOURCE\"\n50\tUNKNOWN = \"UNKNOWN\"\n51\t\n52\tCONFIDENCE_LEVELS = (CONFIRMED, CORROBORATED, SINGLE_SOURCE, UNKNOWN)\n53\t\n54\t#: Same wording as ``mes.code_feel``/``mes.parts``/``mes.maintenance_specs``,\n55\t#: so an UNKNOWN confidence always reads the same way across this package.\n56\t_UNKNOWN_NOTE = \"not established in any source checked -- use the service manual (TechAuthority)\"\n57\t\n58\t#: Strip the failure-type byte: \"P0456-00\" -> \"P0456\". Mirrors\n59\t#: ``mes.knowledge.base_code`` / ``mes.code_feel.base_code``, reimplemented\n60\t#: here rather than imported so this module stays a standalone lookup table.\n61\t_BASE_RE = re.compile(r\"^([PBCU][0-9A-F]{4})\", re.IGNORECASE)\n62\t\n63\t\n64\tdef base_code(code: str) -> str:\n65\t    m = _BASE_RE.match((code or \"\").strip().upper())\n66\t    return m.group(1) if m else (code or \"\").strip().upper()\n67\t\n68\t\n69\t# --- the system graph -------------------------------------------------------\n70\t\n71\tdef _dep(system: str, why: str, confidence: str, source: Optional[str] = None) -> dict[str, Any]:\n72\t    \"\"\"One ``depends_on`` edge. Enforces the house rule at definition time:\n73\t    a non-UNKNOWN confidence must carry a real citation; an UNKNOWN one gets\n74\t    the standard note if the caller didn't supply one.\"\"\"\n75\t    if confidence not in CONFIDENCE_LEVELS:\n76\t        raise ValueError(f\"bad confidence {confidence!r}\")\n77\t    if confidence == UNKNOWN and not source:\n78\t        source = _UNKNOWN_NOTE\n79\t    if not source:\n80\t        raise ValueError(f\"dependency on {system!r} has no source -- \"\n81\t                          \"mark confidence UNKNOWN or cite one\")\n82\t    return {\"system\": system, \"why\": why, \"confidence\": confidence, \"source\": source}\n83\t\n84\t\n85\tdef _system(key: str, label: str, components: list[str], *,\n86\t            live_channels: Optional[list[str]] = None,\n87\t            maintenance_items: Optional[list[str]] = None,\n88\t            parts: Optional[list[str]] = None,\n89\t            depends_on: Optional[list[dict[str, Any]]] = None) -> dict[str, Any]:\n90\t    return {\n91\t        \"key\": key,\n92\t        \"label\": label,\n93\t        \"components\": list(components),\n94\t        \"live_channels\": list(live_channels or []),\n95\t        \"maintenance_items\": list(maintenance_items or []),\n96\t        \"parts\": list(parts or []),\n97\t        \"depends_on\": list(depends_on or []),\n98\t    }\n99\t\n100\t\n101\t#: Sources reused by several edges below, named once.\n102\t_S1808000005 = \"mes.knowledge Bulletin S1808000005 (BCM power-feed/fuse F82 cascade into U-codes)\"\n103\t_S2008000032 = \"mes.knowledge Bulletin S2008000032 (connector XY201 / grounds G003A-B multi-module cascade)\"\n104\t_S1708000262 = \"mes.knowledge Bulletin S1708000262 REV. A (intermittent CAN-private/LIN codes -- spread terminals)\"\n105\t_S2308000004 = \"mes.knowledge Bulletin S2308000004 (cranks/no-start -- verify ECM/PCM B+ feeds and grounds)\"\n106\t_S2008000078 = \"mes.knowledge Bulletin S2008000078 REV. A (U0102 on RWD is a software/config fault, not a bus fault)\"\n107\t_S1821000001 = \"mes.knowledge Bulletin S1821000001 REV. A (AWD tyre-circumference mismatch causes driveline shudder)\"\n108\t_EVAP_SOURCES = (\"mes.parts esim/purge_valve (ECM-commanded solenoid/pump) + \"\n109\t                 \"mes.code_feel EVAP section + mes.knowledge EVAP bulletins \"\n110\t                 \"(S2125000002, 9100469/9100471, 18-030-17)\")\n111\t_EVAP_FUEL_SOURCES = (\"mes.code_feel EVAP section + carparts.com/fs1inc.com P0455/P0456 \"\n112\t                      \"writeups (EVAP shares the tank, fuel cap and fuel-level/pressure \"\n113\t                      \"signal path with the fuel system)\")\n114\t_RFHUB_SOURCE = (\"mes.electrical 'rfhub_module' entry (network address CONFIRMED \"\n115\t                 \"and documented to carry TPMS data, per GIORGIO_MODULE_MAP.md; \"\n116\t                 \"module identity as RFHUB itself is INFERRED, per that same entry)\")\n117\t\n118\t#: Ordered as given: the \"natural\" reading order for a dossier, roughly\n119\t#: supply -> network -> the engine's own systems -> driveline -> chassis ->\n120\t#: comfort/sensor/HVAC extras.\n121\tSYSTEMS: dict[str, dict[str, Any]] = {\n122\t    \"electrical_supply\": _system(\n123\t        \"electrical_supply\", \"Electrical supply\",\n124\t        [\"12V battery\", \"alternator\", \"chassis/engine grounds\", \"fuses\",\n125\t         \"BCM power feeds\"],\n126\t        live_channels=[\"battery_voltage\"],\n127\t        maintenance_items=[\"battery_12v\"],\n128\t        parts=[\"battery_12v\"],\n129\t        depends_on=[],\n130\t    ),\n131\t    \"network\": _system(\n132\t        \"network\", \"Network / CAN buses\",\n133\t        [\"CAN-C\", \"CAN-IHS\", \"CAN-CH\", \"gateway modules\", \"BCM\"],\n134\t        live_channels=[],\n135\t        maintenance_items=[],\n136\t        parts=[],\n137\t        depends_on=[\n138\t            _dep(\"electrical_supply\",\n139\t                 \"BCM power feeds and chassis grounds are a documented root \"\n140\t                 \"cause of multi-module U-code cascades, not per-module bus \"\n141\t                 \"faults.\",\n142\t                 CONFIRMED, f\"{_S1808000005}; {_S2008000032}; {_S1708000262}\"),\n143\t        ],\n144\t    ),\n145\t    \"ignition\": _system(\n146\t        \"ignition\", \"Ignition\",\n147\t        [\"spark plugs\", \"ignition coils\", \"crank/cam position sensors\"],\n148\t        live_channels=[\"engine_rpm\"],\n149\t        maintenance_items=[\"spark_plugs\", \"ignition_coils_inspect\"],\n150\t        parts=[\"spark_plug\", \"ignition_coil\"],\n151\t        depends_on=[\n152\t            _dep(\"electrical_supply\",\n153\t                 \"Coils and the igniter driver need a stable B+ supply; a \"\n154\t                 \"no-start/cranks-only complaint is diagnosed by verifying \"\n155\t                 \"ECM/PCM B+ feeds and grounds before suspecting ignition \"\n156\t                 \"parts.\",\n157\t                 CONFIRMED, _S2308000004),\n158\t        ],\n159\t    ),\n160\t    \"fuel\": _system(\n161\t        \"fuel\", \"Fuel\",\n162\t        [\"fuel tank\", \"fuel pump\", \"fuel pressure sensor\", \"fuel filter\",\n163\t         \"injectors\", \"fuel cap\"],\n164\t        live_channels=[\"fuel_level\"],\n165\t        maintenance_items=[\"fuel_filter\"],\n166\t        parts=[],\n167\t        depends_on=[\n168\t            _dep(\"electrical_supply\",\n169\t                 \"The fuel pump and injectors are electrically driven, so a \"\n170\t                 \"weak supply/ground can present as a fuel-delivery fault.\",\n171\t                 UNKNOWN),\n172\t        ],\n173\t    ),\n174\t    \"evap\": _system(\n175\t        \"evap\", \"EVAP (evaporative emissions)\",\n176\t        [\"ESIM\", \"purge valve\", \"canister\", \"vent valve\", \"fuel cap\",\n177\t         \"vapor lines\", \"recirculation-line quick-connect\"],\n178\t        live_channels=[\"commanded_evap_purge\", \"evap_vapor_pressure\",\n179\t                      \"evap_vapor_pressure_abs\", \"fuel_level\"],\n180\t        maintenance_items=[],\n181\t        parts=[\"esim\", \"purge_valve\", \"evap_canister\", \"evap_quick_connect\"],\n182\t        depends_on=[\n183\t            _dep(\"electrical_supply\",\n184\t                 \"The ESIM and purge valve are ECM-commanded electrical \"\n185\t                 \"components (a leak-detection pump and a solenoid); a weak \"\n186\t                 \"supply/ground can disrupt the self-test they rely on.\",\n187\t                 SINGLE_SOURCE, _EVAP_SOURCES),\n188\t            _dep(\"fuel\",\n189\t                 \"EVAP shares the tank, fuel cap and fuel-level/pressure \"\n190\t                 \"signal path with the fuel system; a fuel-cap or tank-side \"\n191\t                 \"fault can present as an EVAP leak code.\",\n192\t                 CORROBORATED, _EVAP_FUEL_SOURCES),\n193\t        ],\n194\t    ),\n195\t    \"air_intake_boost\": _system(\n196\t        \"air_intake_boost\", \"Air intake / boost\",\n197\t        [\"intake tract\", \"MAP sensor\", \"turbocharger\", \"intercooler\",\n198\t         \"boost hoses\", \"throttle body\"],\n199\t        live_channels=[\"intake_map\", \"barometric_pressure\", \"boost\",\n200\t                      \"ecm_195a\", \"intake_air_temp\", \"absolute_load\",\n201\t                      \"throttle_position\"],\n202\t        maintenance_items=[\"engine_air_filter\", \"throttle_body_clean\",\n203\t                           \"intake_boost_hoses_inspect\"],\n204\t        parts=[\"engine_air_filter\", \"turbo_intercooler_hose\"],\n205\t        depends_on=[\n206\t            _dep(\"exhaust_emissions\",\n207\t                 \"The turbocharger is driven by exhaust gas, so an \"\n208\t                 \"exhaust-side restriction or a failing turbo housing can \"\n209\t                 \"present as a boost/MAP-sensor fault.\",\n210\t                 SINGLE_SOURCE,\n211\t                 \"general turbocharger architecture (exhaust-driven turbine) \"\n212\t                 \"-- no GU/Stelvio-specific TSB citation found\"),\n213\t        ],\n214\t    ),\n215\t    \"cooling\": _system(\n216\t        \"cooling\", \"Cooling\",\n217\t        [\"radiator\", \"coolant\", \"water pump\", \"thermostat\", \"cooling fan\"],\n218\t        live_channels=[\"engine_coolant_temp\"],\n219\t        maintenance_items=[\"coolant\"],\n220\t        parts=[\"coolant\"],\n221\t        depends_on=[],\n222\t    ),\n223\t    \"lubrication\": _system(\n224\t        \"lubrication\", \"Lubrication (oil)\",\n225\t        [\"oil pump\", \"oil filter\", \"oil pressure/level sensors\"],\n226\t        live_channels=[\"engine_oil_temp\"],\n227\t        maintenance_items=[],\n228\t        parts=[\"engine_oil\", \"oil_filter\", \"drain_plug_gasket\"],\n229\t        depends_on=[],\n230\t    ),\n231\t    \"exhaust_emissions\": _system(\n232\t        \"exhaust_emissions\", \"Exhaust / emissions\",\n233\t        [\"catalytic converter\", \"O2 sensors\", \"exhaust manifold\",\n234\t         \"turbo exhaust housing\"],\n235\t        live_channels=[],\n236\t        maintenance_items=[],\n237\t        parts=[],\n238\t        depends_on=[\n239\t            _dep(\"ignition\",\n240\t                 \"A misfire dumps unburned fuel into the exhaust and can \"\n241\t                 \"set secondary catalyst/O2 codes.\",\n242\t                 SINGLE_SOURCE,\n243\t                 \"general emissions-system architecture -- no GU/Stelvio-\"\n244\t                 \"specific TSB citation found\"),\n245\t        ],\n246\t    ),\n247\t    \"transmission_driveline\": _system(\n248\t        \"transmission_driveline\", \"Transmission / driveline\",\n249\t        [\"ZF 8HP transmission\", \"Q4 transfer case\", \"differentials\",\n250\t         \"driveshafts\", \"valve body\"],\n251\t        live_channels=[\"tcm_04fe\", \"tcm_0518\"],\n252\t        maintenance_items=[],\n253\t        parts=[\"transmission_fluid\", \"transfer_case_fluid\"],\n254\t        depends_on=[\n255\t            _dep(\"network\",\n256\t                 \"U0102 'lost communication with transfer case' can be an \"\n257\t                 \"ECM software/configuration fault (AWD software on a RWD \"\n258\t                 \"build) rather than a transfer-case hardware or bus fault.\",\n259\t                 CONFIRMED, _S2008000078),\n260\t            _dep(\"suspension\",\n261\t                 \"Tyre circumference mismatch on AWD causes shudder/bind and \"\n262\t                 \"can damage the transfer case; this is ruled out before any \"\n263\t                 \"driveline hardware is condemned.\",\n264\t                 CONFIRMED, _S1821000001),\n265\t        ],\n266\t    ),\n267\t    \"brakes_abs\": _system(\n268\t        \"brakes_abs\", \"Brakes / ABS\",\n269\t        [\"brake pads\", \"rotors\", \"calipers\", \"ABS/ESC modulator\",\n270\t         \"wheel speed sensors\", \"EPB\"],\n271\t        live_channels=[],\n272\t        maintenance_items=[\"brake_fluid\"],\n273\t        parts=[\"brake_pads_front\", \"brake_pads_rear\", \"brake_rotor_front\",\n274\t              \"brake_rotor_rear\", \"brake_fluid\"],\n275\t        depends_on=[\n276\t            _dep(\"electrical_supply\",\n277\t                 \"The ABS/ESC modulator and wheel-speed sensors are \"\n278\t                 \"electrically supplied module hardware, like the other \"\n279\t                 \"modules that cascade from a BCM supply fault.\",\n280\t                 UNKNOWN),\n281\t        ],\n282\t    ),\n283\t    \"steering\": _system(\n284\t        \"steering\", \"Steering\",\n285\t        [\"EPS motor/rack\", \"steering angle sensor\", \"steering column\"],\n286\t        live_channels=[],\n287\t        maintenance_items=[\"power_steering\"],\n288\t        parts=[],\n289\t        depends_on=[\n290\t            _dep(\"electrical_supply\",\n291\t                 \"EPS is an electrically driven power-steering system; a \"\n292\t                 \"weak supply affects assist.\",\n293\t                 UNKNOWN),\n294\t        ],\n295\t    ),\n296\t    \"suspension\": _system(\n297\t        \"suspension\", \"Suspension\",\n298\t        [\"shocks/struts\", \"springs\", \"control arms\", \"bushings\",\n299\t         \"tires/wheels\"],\n300\t        live_channels=[],\n301\t        maintenance_items=[],\n302\t        parts=[\"tpms_sensor\"],\n303\t        depends_on=[],\n304\t    ),\n305\t    \"body_comfort\": _system(\n306\t        \"body_comfort\", \"Body / comfort\",\n307\t        [\"BCM\", \"door/window modules\", \"central locking\",\n308\t         \"interior lighting\", \"wipers\"],\n309\t        live_channels=[],\n310\t        maintenance_items=[\"wipers\", \"hood_and_door_lubrication\"],\n311\t        parts=[\"wiper_blades\"],\n312\t        depends_on=[\n313\t            _dep(\"network\",\n314\t                 \"Most body-module codes gateway through the BCM onto the \"\n315\t                 \"vehicle's CAN/LIN buses; an intermittent bus/terminal \"\n316\t                 \"fault can present as a body-module fault.\",\n317\t                 SINGLE_SOURCE, _S1708000262),\n318\t            _dep(\"electrical_supply\",\n319\t                 \"BCM supply-side faults (e.g. fuse F82) are documented to \"\n320\t                 \"cascade into multiple module/body symptoms.\",\n321\t                 CONFIRMED, _S1808000005),\n322\t        ],\n323\t    ),\n324\t    \"adas_sensors\": _system(\n325\t        \"adas_sensors\", \"ADAS / sensors\",\n326\t        [\"forward camera\", \"radar\", \"park-assist sensors\",\n327\t         \"driver-assist ECU\"],\n328\t        live_channels=[],\n329\t        maintenance_items=[],\n330\t        parts=[],\n331\t        depends_on=[\n332\t            _dep(\"network\",\n333\t                 \"ADAS/chassis-module codes often ride the same gatewayed \"\n334\t                 \"CAN buses as other modules affected by bus/supply events.\",\n335\t                 UNKNOWN),\n336\t        ],\n337\t    ),\n338\t    \"hvac\": _system(\n339\t        \"hvac\", \"HVAC\",\n340\t        [\"A/C compressor\", \"blower motor\", \"cabin air filter\",\n341\t         \"climate control module\", \"refrigerant circuit\"],\n342\t        live_channels=[],\n343\t        maintenance_items=[\"cabin_air_filter\", \"a_c_cabin_service\"],\n344\t        parts=[\"cabin_air_filter\"],\n345\t        depends_on=[],\n346\t    ),\n347\t    \"pcv\": _system(\n348\t        \"pcv\", \"PCV (crankcase ventilation)\",\n349\t        [\"crankcase breather\", \"PCV valve/housing\", \"breather hoses\",\n350\t         \"intake connection\"],\n351\t        live_channels=[],\n352\t        maintenance_items=[\"pcv_system\"],\n353\t        parts=[],\n354\t        depends_on=[\n355\t            _dep(\"lubrication\",\n356\t                 \"The PCV system vents the crankcase that the lubrication \"\n357\t                 \"system pressurizes with combustion blow-by; a \"\n358\t                 \"lubrication-side fault (excess blow-by, overfill) can \"\n359\t                 \"overwhelm the PCV valve/hoses.\",\n360\t                 SINGLE_SOURCE,\n361\t                 \"general PCV system architecture (crankcase ventilation \"\n362\t                 \"draws from the lubrication system's crankcase) -- no \"\n363\t                 \"GU/Stelvio-specific TSB citation found\"),\n364\t            _dep(\"air_intake_boost\",\n365\t                 \"The PCV valve/hoses route crankcase vapor into the \"\n366\t                 \"intake tract under vacuum; a stuck-open valve or split \"\n367\t                 \"hose is a documented source of unmetered air (a vacuum \"\n368\t                 \"leak) that can present as a lean or boost-side fault.\",\n369\t                 SINGLE_SOURCE,\n370\t                 \"general PCV system architecture (crankcase-to-intake \"\n371\t                 \"vacuum connection) -- no GU/Stelvio-specific TSB \"\n372\t                 \"citation found\"),\n373\t        ],\n374\t    ),\n375\t    \"engine_management\": _system(\n376\t        \"engine_management\", \"Engine management (ECM / sensors)\",\n377\t        [\"ECM\", \"crank/cam position sensors\", \"ECM-internal diagnostics\"],\n378\t        live_channels=[],\n379\t        maintenance_items=[],\n380\t        parts=[],\n381\t        depends_on=[\n382\t            _dep(\"electrical_supply\",\n383\t                 \"The ECM/PCM itself needs a stable B+ feed and ground; a \"\n384\t                 \"cranks/no-start complaint is diagnosed by verifying \"\n385\t                 \"ECM/PCM B+ feeds and grounds before suspecting an \"\n386\t                 \"ECM-internal fault.\",\n387\t                 CONFIRMED, _S2308000004),\n388\t        ],\n389\t    ),\n390\t    \"valve_control\": _system(\n391\t        \"valve_control\", \"Valve control (MultiAir / cam phasing)\",\n392\t        [\"MultiAir solenoid/actuator\", \"camshaft position actuator\",\n393\t         \"cam phaser\", \"camshaft position sensors\"],\n394\t        live_channels=[],\n395\t        maintenance_items=[],\n396\t        parts=[],\n397\t        depends_on=[\n398\t            _dep(\"lubrication\",\n399\t                 \"MultiAir/cam-phasing actuators are oil-pressure-\"\n400\t                 \"actuated; low oil pressure or dirty oil is a documented \"\n401\t                 \"cause of camshaft-actuator timing faults on \"\n402\t                 \"oil-pressure-actuated valve systems in general.\",\n403\t                 SINGLE_SOURCE,\n404\t                 \"general MultiAir/cam-phaser architecture (oil-pressure-\"\n405\t                 \"actuated) -- no GU/Stelvio-specific TSB citation found\"),\n406\t        ],\n407\t    ),\n408\t    \"starting_charging\": _system(\n409\t        \"starting_charging\", \"Starting / charging\",\n410\t        [\"starter motor\", \"DBSM (dual battery switch module)\",\n411\t         \"stop-start system\", \"alternator/charging circuit\"],\n412\t        live_channels=[],\n413\t        maintenance_items=[\"battery_12v\"],\n414\t        parts=[\"battery_12v\"],\n415\t        depends_on=[\n416\t            _dep(\"electrical_supply\",\n417\t                 \"A cranks/no-start or stop-start-disabled complaint is \"\n418\t                 \"diagnosed by verifying ECM/PCM B+ feeds and grounds \"\n419\t                 \"before suspecting the starter or DBSM hardware.\",\n420\t                 CONFIRMED, _S2308000004),\n421\t        ],\n422\t    ),\n423\t    \"security_immobiliser\": _system(\n424\t        \"security_immobiliser\", \"Security / immobiliser\",\n425\t        [\"immobiliser (BCM-hosted)\", \"WIN (wireless ignition node)\",\n426\t         \"RFHUB (passive entry / keyfob)\", \"PROXI master\"],\n427\t        live_channels=[],\n428\t        maintenance_items=[],\n429\t        parts=[],\n430\t        depends_on=[\n431\t            _dep(\"network\",\n432\t                 \"Immobiliser functions are hosted on the BCM, which is \"\n433\t                 \"also the documented B-CAN/C-CAN gateway; an intermittent \"\n434\t                 \"bus/terminal fault can present as a security-module \"\n435\t                 \"fault.\",\n436\t                 SINGLE_SOURCE, _S1708000262),\n437\t            _dep(\"electrical_supply\",\n438\t                 \"BCM supply-side faults (e.g. fuse F82) are documented to \"\n439\t                 \"cascade into multiple module/body symptoms, and the \"\n440\t                 \"immobiliser is hosted on the BCM.\",\n441\t                 CONFIRMED, _S1808000005),\n442\t        ],\n443\t    ),\n444\t    \"infotainment_cluster\": _system(\n445\t        \"infotainment_cluster\", \"Infotainment / cluster\",\n446\t        [\"IPC (instrument panel cluster)\", \"Uconnect head unit\",\n447\t         \"radio/navigation/media modules\"],\n448\t        live_channels=[],\n449\t        maintenance_items=[],\n450\t        parts=[],\n451\t        depends_on=[\n452\t            _dep(\"network\",\n453\t                 \"Infotainment/cluster modules gateway through the BCM \"\n454\t                 \"onto the vehicle's CAN/LIN buses; an intermittent bus/\"\n455\t                 \"terminal fault can present as an infotainment/cluster \"\n456\t                 \"fault.\",\n457\t                 SINGLE_SOURCE, _S1708000262),\n458\t            _dep(\"electrical_supply\",\n459\t                 \"BCM supply-side faults (e.g. fuse F82) are documented to \"\n460\t                 \"cascade into multiple module symptoms, infotainment/\"\n461\t                 \"cluster included.\",\n462\t                 CONFIRMED, _S1808000005),\n463\t        ],\n464\t    ),\n465\t    \"lighting\": _system(\n466\t        \"lighting\", \"Lighting\",\n467\t        [\"headlamps\", \"taillamps\", \"turn signal/marker lamps\",\n468\t         \"AFLS/AHLM/AHBM lighting modules\"],\n469\t        live_channels=[],\n470\t        maintenance_items=[],\n471\t        parts=[],\n472\t        depends_on=[\n473\t            _dep(\"electrical_supply\",\n474\t                 \"Lamps and lighting-control modules are electrical \"\n475\t                 \"loads; a weak supply/ground can present as a lighting \"\n476\t                 \"fault.\",\n477\t                 UNKNOWN),\n478\t        ],\n479\t    ),\n480\t    \"wheels_tpms\": _system(\n481\t        \"wheels_tpms\", \"Wheels / TPMS\",\n482\t        [\"TPMS sensors\", \"RFHUB (TPMS RF receive)\"],\n483\t        live_channels=[],\n484\t        maintenance_items=[],\n485\t        parts=[\"tpms_sensor\"],\n486\t        depends_on=[\n487\t            _dep(\"network\",\n488\t                 \"TPMS data is received over the network by the RFHUB, \"\n489\t                 \"whose network address is confirmed in this project's \"\n490\t                 \"own module map (module identity as RFHUB itself is \"\n491\t                 \"inferred).\",\n492\t                 SINGLE_SOURCE, _RFHUB_SOURCE),\n493\t        ],\n494\t    ),\n495\t    \"restraints\": _system(\n496\t        \"restraints\", \"Restraints (airbags / ORC)\",\n497\t        [\"ORC (occupant restraint controller)\", \"airbags\",\n498\t         \"pretensioners\", \"OCM (occupant classification)\",\n499\t         \"SIS (side-impact satellite sensors)\"],\n500\t        live_channels=[],\n501\t        maintenance_items=[],\n502\t        parts=[],\n503\t        depends_on=[\n504\t            _dep(\"electrical_supply\",\n505\t                 \"The ORC and its satellite sensors are electrically \"\n506\t                 \"supplied safety modules; a weak supply/ground could \"\n507\t                 \"affect them like other modules, but no sourced \"\n508\t                 \"restraints-specific cascade was found.\",\n509\t                 UNKNOWN),\n510\t        ],\n511\t    ),\n512\t}\n513\t\n514\t\n515\tdef systems() -> dict[str, dict[str, Any]]:\n516\t    \"\"\"Every system in the graph, in reading order.\"\"\"\n517\t    return SYSTEMS\n518\t\n519\t\n520\t# --- code -> system(s) -------------------------------------------------------\n521\t\n522\t#: Generic (not vehicle-specific) SAE J2012 range-convention sources, named\n523\t#: as generic every time they are the only thing backing an assignment.\n524\t_SAE_SOURCE = (\"SAE J2012 DTC prefix/range convention (generic category, \"\n525\t              \"not vehicle-specific -- informational fallback only)\")\n526\t_SAE_SOURCE_P06 = (\"SAE J2012 P06xx range (Computer & Auxiliary Outputs -- \"\n527\t                   \"ECM/PCM internal); mapped to 'engine_management' \"\n528\t                   \"(a documented approximation, not a sourced fact)\")\n529\t_SAE_SOURCE_CHASSIS = (\"SAE J2012 C-prefix range (chassis: brakes/steering/\"\n530\t                       \"suspension); mapped to 'brakes_abs' as the default \"\n531\t                       \"chassis bucket (a documented approximation -- a \"\n532\t                       \"specific C-code may actually be steering or \"\n533\t                       \"suspension)\")\n534\t_SAE_SOURCE_BODY = \"SAE J2012 B-prefix range (body)\"\n535\t_U_CODE_SOURCE = (\"SAE J2012 U-prefix range (network/communication), \"\n536\t                  \"corroborated by mes.knowledge.match_codes' own network-\"\n537\t                  \"cascade family rule (3+ lost-communication U-codes)\")\n538\t\n539\t#: Exact-code rules, checked before any family/range fallback. Each entry's\n540\t#: ``systems`` are the PRIMARY systems for every code it lists.\n541\t_EXACT_RULES: tuple[dict[str, Any], ...] = (\n542\t    {\"codes\": (\"P0440\", \"P0441\", \"P0455\", \"P0456\", \"P0457\", \"P1CEA\"),\n543\t     \"systems\": (\"evap\",), \"confidence\": CONFIRMED,\n544\t     \"source\": (\"mes.knowledge BULLETINS (S2125000002, 9100469/9100471, \"\n545\t               \"9100468, 9100325, 18-048-23, 18-030-17) + mes.code_feel \"\n546\t               \"EVAP section\")},\n547\t    {\"codes\": (\"P0300\", \"P0301\", \"P0302\", \"P0303\", \"P0304\"),\n548\t     \"systems\": (\"ignition\", \"fuel\"), \"confidence\": CONFIRMED,\n549\t     \"source\": (\"SAE J2012 misfire-code definition (a cylinder misfire by \"\n550\t               \"definition implicates spark and fuel delivery) + \"\n551\t               \"mes.code_feel misfire fallback entry\")},\n552\t    {\"codes\": (\"P0171\", \"P0172\"),\n553\t     \"systems\": (\"fuel\", \"air_intake_boost\"), \"confidence\": CONFIRMED,\n554\t     \"source\": (\"SAE J2012 fuel-trim code definition (System Too Lean/Rich \"\n555\t               \"implicates fuel delivery and air-metering/intake leaks)\")},\n556\t    {\"codes\": (\"B1040\", \"U1700\"),\n557\t     \"systems\": (\"network\",), \"confidence\": CONFIRMED,\n558\t     \"source\": (\"mes.knowledge Bulletin S1808000005 (BCM power/comms \"\n559\t               \"cascade) -- B1040/U1700 are BCM communications codes\")},\n560\t    {\"codes\": (\"B1176\",),\n561\t     \"systems\": (\"body_comfort\",), \"confidence\": SINGLE_SOURCE,\n562\t     \"source\": \"generic body-module DTC definition (B1176); no GU/Stelvio-specific TSB found\"},\n563\t    {\"codes\": (\"C141B\", \"C141C\"),\n564\t     \"systems\": (\"adas_sensors\",), \"confidence\": SINGLE_SOURCE,\n565\t     \"source\": \"generic chassis/ADAS DTC definition (C141B/C141C); no GU/Stelvio-specific TSB found\"},\n566\t    {\"codes\": (\"C104B\",),\n567\t     \"systems\": (\"brakes_abs\",), \"confidence\": SINGLE_SOURCE,\n568\t     \"source\": \"generic chassis DTC definition (C104B, ABS/ESC range); no GU/Stelvio-specific TSB found\"},\n569\t    {\"codes\": (\"P0098\", \"P00F5\", \"P105E\", \"P1189\"),\n570\t     \"systems\": (\"air_intake_boost\",), \"confidence\": CONFIRMED,\n571\t     \"source\": (\"SAE J2012 IAT2/boost-pressure sensor circuit code \"\n572\t               \"definitions (P0098/P00F5/P105E/P1189)\")},\n573\t    {\"codes\": (\"P0010\", \"P0011\", \"P0012\", \"P0013\", \"P0014\"),\n574\t     \"systems\": (\"valve_control\",), \"confidence\": CONFIRMED,\n575\t     \"source\": (\"SAE J2012 camshaft position actuator/timing code \"\n576\t               \"definitions ('A'/'B' camshaft actuator circuit and timing \"\n577\t               \"over-advanced/over-retarded) -- generic SAE definition, \"\n578\t               \"not vehicle-specific\")},\n579\t)\n580\t\n581\t#: Keyword fallback for P1xxx (manufacturer-defined) codes, and for B-codes\n582\t#: (body) that need routing to a more specific body-adjacent system before\n583\t#: falling back to the generic body bucket, with no exact entry above:\n584\t#: matched against the code's own description text, never guessed from the\n585\t#: code number alone. First match wins.\n586\t_KEYWORDS: tuple[tuple[tuple[str, ...], str], ...] = (\n587\t    ((\"evap\", \"purge\", \"canister\", \"vent valve\", \"esim\"), \"evap\"),\n588\t    ((\"crankcase\",), \"pcv\"),\n589\t    ((\"multiair\", \"vvt\", \"variable valve\", \"cam phase\"), \"valve_control\"),\n590\t    ((\"turbo\", \"boost\", \"charge air\", \"supercharg\", \"map sensor\"), \"air_intake_boost\"),\n591\t    ((\"misfire\", \"ignition coil\", \"spark\"), \"ignition\"),\n592\t    ((\"airbag\", \"air bag\", \"restraint\", \"occupant restraint\"), \"restraints\"),\n593\t    ((\"headlamp\", \"headlight\", \"taillamp\", \"tail lamp\", \"turn signal\",\n594\t      \"lamp\", \"bulb\"), \"lighting\"),\n595\t    ((\"injector\", \"fuel pump\", \"fuel pressure\", \"fuel rail\", \"fuel trim\"), \"fuel\"),\n596\t    ((\"transmission\", \"shift\", \"gear ratio\", \"clutch\", \"valve body\", \"tcm\"), \"transmission_driveline\"),\n597\t    ((\"communication\", \"network\", \"can bus\", \" bus \"), \"network\"),\n598\t    ((\"battery\", \"charging system\", \"alternator\", \"voltage\"), \"electrical_supply\"),\n599\t    ((\"coolant\", \"thermostat\", \"radiator\", \"overheat\"), \"cooling\"),\n600\t    ((\"oil pressure\", \"oil level\", \"lubrication\"), \"lubrication\"),\n601\t    ((\"catalyst\", \"oxygen sensor\", \"o2 sensor\", \"exhaust\"), \"exhaust_emissions\"),\n602\t    ((\"brake\", \"abs\", \"stability\"), \"brakes_abs\"),\n603\t    ((\"steering\",), \"steering\"),\n604\t    ((\"suspension\", \"shock\", \"strut\"), \"suspension\"),\n605\t    ((\"hvac\", \"air condition\", \"blower\", \"climate\"), \"hvac\"),\n606\t    ((\"body control\", \"door module\", \"window\", \"central lock\"), \"body_comfort\"),\n607\t    ((\"camera\", \"radar\", \"lane\", \"park assist\"), \"adas_sensors\"),\n608\t)\n609\t\n610\t_KEYWORD_SOURCE = (\"description keyword match (manufacturer P1xxx code, or \"\n611\t                   \"a B-code, with no exact entry); the keyword list itself \"\n612\t                   \"is this module's own best-effort mapping, not an \"\n613\t                   \"external citation -- treat as a lead\")\n614\t\n615\t\n616\tdef _keyword_system(description: str) -> Optional[str]:\n617\t    d = (description or \"\").lower()\n618\t    if not d:\n619\t        return None\n620\t    for keywords, sys_key in _KEYWORDS:\n621\t        if any(k in d for k in keywords):\n622\t            return sys_key\n623\t    return None\n624\t\n625\t\n626\tdef _sae_fallback(base: str) -> Optional[dict[str, Any]]:\n627\t    \"\"\"The SAE J2012 prefix/range convention, as a generic last resort.\"\"\"\n628\t    if len(base) < 3:\n629\t        return None\n630\t    letter, rest = base[0], base[1:]\n631\t    if letter == \"P\":\n632\t        prefix2 = rest[:2]\n633\t        if prefix2 == \"01\":\n634\t            return {\"systems\": (\"fuel\", \"air_intake_boost\"),\n635\t                    \"confidence\": SINGLE_SOURCE, \"source\": _SAE_SOURCE}\n636\t        if prefix2 == \"03\":\n637\t            return {\"systems\": (\"ignition\",),\n638\t                    \"confidence\": SINGLE_SOURCE, \"source\": _SAE_SOURCE}\n639\t        if prefix2 == \"04\":\n640\t            return {\"systems\": (\"evap\",),\n641\t                    \"confidence\": SINGLE_SOURCE, \"source\": _SAE_SOURCE}\n642\t        if prefix2 == \"05\":\n643\t            return {\"systems\": (\"air_intake_boost\", \"electrical_supply\"),\n644\t                    \"confidence\": SINGLE_SOURCE, \"source\": _SAE_SOURCE}\n645\t        if prefix2 == \"06\":\n646\t            return {\"systems\": (\"engine_management\",),\n647\t                    \"confidence\": SINGLE_SOURCE, \"source\": _SAE_SOURCE_P06}\n648\t        if prefix2 in (\"07\", \"08\", \"09\"):\n649\t            return {\"systems\": (\"transmission_driveline\",),\n650\t                    \"confidence\": SINGLE_SOURCE, \"source\": _SAE_SOURCE}\n651\t        return None\n652\t    if letter == \"C\":\n653\t        return {\"systems\": (\"brakes_abs\",),\n654\t                \"confidence\": SINGLE_SOURCE, \"source\": _SAE_SOURCE_CHASSIS}\n655\t    if letter == \"B\":\n656\t        return {\"systems\": (\"body_comfort\",),\n657\t                \"confidence\": SINGLE_SOURCE, \"source\": _SAE_SOURCE_BODY}\n658\t    if letter == \"U\":\n659\t        return {\"systems\": (\"network\",),\n660\t                \"confidence\": CORROBORATED, \"source\": _U_CODE_SOURCE}\n661\t    return None\n662\t\n663\t\n664\tdef systems_for_code(code: str, description: str = \"\") -> list[dict[str, Any]]:\n665\t    \"\"\"Every system this code implicates: primaries first, then whatever\n666\t    systems the primaries' own ``depends_on`` names as upstream.\n667\t\n668\t    Resolution order: exact-code table, then \"any U-code is network\" (a\n669\t    family rule, not a guess -- see ``_U_CODE_SOURCE``), then a P1xxx or\n670\t    B-code description-keyword match, then the generic SAE range fallback,\n671\t    then give up honestly (one ``UNKNOWN`` row naming no system).\n672\t\n673\t    A code's primary system(s) automatically pull in their declared\n674\t    ``depends_on`` edges as ``role=\"upstream\"`` rows, so (for example) every\n675\t    EVAP code always carries electrical_supply and fuel upstream without\n676\t    that having to be hand-maintained per code here too.\n677\t    \"\"\"\n678\t    base = base_code(code)\n679\t    primaries: list[tuple[Optional[str], str, str]] = []  # (system, confidence, source)\n680\t\n681\t    matched = False\n682\t    for rule in _EXACT_RULES:\n683\t        if base in rule[\"codes\"]:\n684\t            for sys_key in rule[\"systems\"]:\n685\t                primaries.append((sys_key, rule[\"confidence\"], rule[\"source\"]))\n686\t            matched = True\n687\t            break\n688\t\n689\t    if not matched and base.startswith(\"U\"):\n690\t        primaries.append((\"network\", CORROBORATED, _U_CODE_SOURCE))\n691\t        matched = True\n692\t\n693\t    if not matched and (base.startswith(\"P1\") or base.startswith(\"B\")):\n694\t        sys_key = _keyword_system(description)\n695\t        if sys_key:\n696\t            primaries.append((sys_key, SINGLE_SOURCE, _KEYWORD_SOURCE))\n697\t            matched = True\n698\t\n699\t    if not matched:\n700\t        fb = _sae_fallback(base)\n701\t        if fb:\n702\t            for sys_key in fb[\"systems\"]:\n703\t                primaries.append((sys_key, fb[\"confidence\"], fb[\"source\"]))\n704\t            matched = True\n705\t\n706\t    out: list[dict[str, Any]] = []\n707\t    seen: set[str] = set()\n708\t    if not matched:\n709\t        out.append({\"system\": \"UNKNOWN\", \"role\": \"primary\",\n710\t                   \"confidence\": UNKNOWN, \"source\": _UNKNOWN_NOTE})\n711\t        return out\n712\t\n713\t    for sys_key, confidence, source in primaries:\n714\t        if sys_key in seen:\n715\t            continue\n716\t        seen.add(sys_key)\n717\t        out.append({\"system\": sys_key, \"role\": \"primary\",\n718\t                   \"confidence\": confidence, \"source\": source})\n719\t\n720\t    for sys_key, _conf, _src in primaries:\n721\t        sys_def = SYSTEMS.get(sys_key)\n722\t        if sys_def is None:\n723\t            continue\n724\t        for dep in sys_def[\"depends_on\"]:\n725\t            if dep[\"system\"] in seen:\n726\t                continue\n727\t            seen.add(dep[\"system\"])\n728\t            out.append({\"system\": dep[\"system\"], \"role\": \"upstream\",\n729\t                       \"confidence\": dep[\"confidence\"], \"source\": dep[\"source\"]})\n730\t    return out\n731\t\n732\t\n733\tdef _primary_systems(code: str, description: str = \"\") -> list[str]:\n734\t    return [e[\"system\"] for e in systems_for_code(code, description)\n735\t            if e[\"role\"] == \"primary\" and e[\"system\"] != \"UNKNOWN\"]\n736\t\n737\t\n738\t# --- corpus correlation -----------------------------------------------------\n739\t\n740\tdef correlate(vin: str) -> dict[str, Any]:\n741\t    \"\"\"Project one vehicle's whole DTC corpus onto the system graph.\n742\t\n743\t    Built from :func:`mes.analysis.dtc_history` (the same per-occurrence\n744\t    file/timestamp data :func:`mes.workup.build` uses) plus\n745\t    ``mes.workup.build`` itself for the current-picture open codes and the\n746\t    latest clear assessment, used only to classify each system's\n747\t    ``status``. Simulation logs are excluded (``dtc_history``'s default).\n748\t\n749\t    Returns ``{\"error\": ...}`` if no logs match this VIN -- never a\n750\t    half-empty dossier.\n751\t    \"\"\"\n752\t    from . import analysis, workup as workup_mod\n753\t\n754\t    history = analysis.dtc_history(vin=vin)\n755\t    if not history:\n756\t        return {\"error\": \"no logs match\", \"vin\": vin}\n757\t\n758\t    primary_map: dict[str, list[str]] = {}\n759\t    for code, rec in history.items():\n760\t        descr = rec.descriptions[0] if rec.descriptions else \"\"\n761\t        primary_map[code] = _primary_systems(code, descr)\n762\t\n763\t    # --- per-session (per-file) system sets ---------------------------------\n764\t    session_codes: dict[str, set[str]] = {}\n765\t    for code, rec in history.items():\n766\t        for occ in rec.occurrences:\n767\t            fname = occ.get(\"file\")\n768\t            if not fname:\n769\t                continue\n770\t            session_codes.setdefault(fname, set()).add(code)\n771\t    session_systems: dict[str, set[str]] = {\n772\t        fname: {s for c in codes for s in primary_map.get(c, [])}\n773\t        for fname, codes in session_codes.items()\n774\t    }\n775\t    total_sessions = len(session_systems)\n776\t\n777\t    # --- current picture, for status classification only -------------------\n778\t    try:\n779\t        dossier = workup_mod.build(vin=vin)\n780\t    except Exception:  # noqa: BLE001 -- status is a nice-to-have, never fatal\n781\t        dossier = {}\n782\t    cp = dossier.get(\"current_picture\", {}) if isinstance(dossier, dict) else {}\n783\t    latest = cp.get(\"latest_session\") or {}\n784\t    open_codes = {d.get(\"dtc\") for d in latest.get(\"dtcs\", []) if d.get(\"dtc\")}\n785\t    clear = cp.get(\"clear_assessment\") or {}\n786\t    cleared_codes = set(clear.get(\"codes_cleared\") or [])\n787\t\n788\t    # --- by_system -----------------------------------------------------------\n789\t    by_system: list[dict[str, Any]] = []\n790\t    for sys_key in SYSTEMS:\n791\t        codes_here = sorted(c for c, syss in primary_map.items() if sys_key in syss)\n792\t        if not codes_here:\n793\t            by_system.append({\"system\": sys_key, \"codes\": [], \"sessions\": 0,\n794\t                              \"first\": None, \"last\": None, \"status\": \"clean\"})\n795\t            continue\n796\t        sessions_here = sum(1 for syss in session_systems.values() if sys_key in syss)\n797\t        firsts = [history[c].first_seen for c in codes_here if history[c].first_seen]\n798\t        lasts = [history[c].last_seen for c in codes_here if history[c].last_seen]\n799\t        if open_codes & set(codes_here):\n800\t            status = \"active\"\n801\t        elif cleared_codes & set(codes_here):\n802\t            status = \"cleared_unverified\"\n803\t        else:\n804\t            status = \"stale\"\n805\t        by_system.append({\n806\t            \"system\": sys_key, \"codes\": codes_here, \"sessions\": sessions_here,\n807\t            \"first\": min(firsts) if firsts else None,\n808\t            \"last\": max(lasts) if lasts else None,\n809\t            \"status\": status,\n810\t        })\n811\t\n812\t    # --- co-occurrence, pairs with >= 2 shared sessions only ----------------\n813\t    active = [row[\"system\"] for row in by_system if row[\"sessions\"] > 0]\n814\t    co_occurrence: list[dict[str, Any]] = []\n815\t    for i, a in enumerate(active):\n816\t        for b in active[i + 1:]:\n817\t            sessions_a = sum(1 for syss in session_systems.values() if a in syss)\n818\t            sessions_b = sum(1 for syss in session_systems.values() if b in syss)\n819\t            together = sum(1 for syss in session_systems.values()\n820\t                           if a in syss and b in syss)\n821\t            if together < 2:\n822\t                continue\n823\t            expected = (sessions_a * sessions_b) / total_sessions if total_sessions else 0\n824\t            lift = round(together / expected, 2) if expected else None\n825\t            label_a, label_b = SYSTEMS[a][\"label\"], SYSTEMS[b][\"label\"]\n826\t            reading = (\n827\t                f\"{label_a} and {label_b} codes appeared together in \"\n828\t                f\"{together} of {total_sessions} session(s) ({sessions_a} had \"\n829\t                f\"{label_a} codes, {sessions_b} had {label_b} codes); lift \"\n830\t                f\"{lift if lift is not None else 'n/a'} -- correlation only, \"\n831\t                \"could point at a shared cause or be coincidental overlap.\"\n832\t            )\n833\t            co_occurrence.append({\"a\": a, \"b\": b, \"sessions_together\": together,\n834\t                                   \"sessions_a\": sessions_a, \"sessions_b\": sessions_b,\n835\t                                   \"lift\": lift, \"reading\": reading})\n836\t\n837\t    # --- chains: depends_on edges, with corpus evidence where it exists ------\n838\t    chains: list[dict[str, Any]] = []\n839\t    for row in by_system:\n840\t        sys_key = row[\"system\"]\n841\t        if row[\"sessions\"] == 0:\n842\t            continue\n843\t        deps = SYSTEMS[sys_key][\"depends_on\"]\n844\t        if not deps:\n845\t            continue\n846\t        possible_upstream = []\n847\t        for dep in deps:\n848\t            evidence = None\n849\t            for co in co_occurrence:\n850\t                if {co[\"a\"], co[\"b\"]} == {sys_key, dep[\"system\"]}:\n851\t                    evidence = (f\"{co['sessions_together']} of {total_sessions} \"\n852\t                               f\"session(s) with {SYSTEMS[sys_key]['label']} codes \"\n853\t                               f\"also carried {SYSTEMS[dep['system']]['label']} \"\n854\t                               f\"codes (lift {co['lift']}) -- could be upstream, \"\n855\t                               \"not proven.\")\n856\t                    break\n857\t            possible_upstream.append({\"system\": dep[\"system\"], \"why\": dep[\"why\"],\n858\t                                      \"evidence\": evidence})\n859\t        chains.append({\"issue\": f\"{SYSTEMS[sys_key]['label']} codes\",\n860\t                       \"possible_upstream\": possible_upstream})\n861\t\n862\t    # --- findings, plain dated sentences -------------------------------------\n863\t    today = date.today().isoformat()\n864\t    findings: list[str] = []\n865\t    for row in by_system:\n866\t        if row[\"sessions\"] == 0:\n867\t            continue\n868\t        findings.append(\n869\t            f\"{today}: {SYSTEMS[row['system']]['label']} shows \"\n870\t            f\"{len(row['codes'])} code(s) across {row['sessions']} \"\n871\t            f\"session(s) ({row['first']} to {row['last']}), status={row['status']}.\"\n872\t        )\n873\t    for co in co_occurrence:\n874\t        findings.append(f\"{today}: {co['reading']}\")\n875\t    if not findings:\n876\t        findings.append(f\"{today}: no DTCs found for {vin} across the corpus.\")\n877\t\n878\t    return {\n879\t        \"vin\": vin,\n880\t        \"by_system\": by_system,\n881\t        \"co_occurrence\": co_occurrence,\n882\t        \"chains\": chains,\n883\t        \"findings\": findings,\n884\t    }\n885\t\n886\t\n887\t__all__ = [\"SYSTEMS\", \"systems\", \"systems_for_code\", \"correlate\", \"base_code\",\n888\t           \"CONFIRMED\", \"CORROBORATED\", \"SINGLE_SOURCE\", \"UNKNOWN\"]\n889\t"}]},"uuid":"f37f1f78-ce72-47cf-a025-515cba499b38","timestamp":"2026-10-08T11:45:23.664Z","toolUseResult":{"type":"text","file":{"filePath":"C:\\Users\\User\\mcp-servers\\mes-log-mcp\\mes\\systems.py","content":"\"\"\"Vehicle SYSTEMS as a correlational dimension, cutting across every DTC.\n\nA code lookup answers \"what fault is this\"; it does not answer \"what else on\nthis car shares a cause with it\". This module adds that second axis: every\nDTC is assigned to one or more ordered vehicle systems (``SYSTEMS``), with a\n``depends_on`` graph recording which systems are documented as upstream of\nwhich others (a BCM supply fault cascading into network U-codes, an EVAP\nleak code that can trace back to the fuel tank/cap it shares with the fuel\nsystem). ``mes.workup``/``mes.analysis`` already answer \"what DTCs happened,\nwhen, together\" per vehicle; :func:`correlate` reuses that corpus data and\nprojects it onto the system graph.\n\nNothing here is invented. Every ``depends_on`` edge and every exact-code\nsystem assignment carries a ``source`` -- either a citation (this project's\nown ``mes.knowledge`` TSB table, ``mes.code_feel``, ``mes.parts``, or the\ngeneric SAE J2012 DTC-prefix convention, named as generic every time it is\nused) or, for a relationship nobody has sourced, ``confidence=\"UNKNOWN\"``\nwith a note pointing at the service manual -- never a silently guessed\ndependency. :func:`correlate` is equally careful with its own output: it\nnever asserts a dependency is *proven*, only that the corpus shows two\nsystems' codes appearing together, worded as \"could be upstream\", with the\nsession counts that back (or don't back) that reading.\n\nConfidence levels (same scale as the rest of this package):\n\n* ``CONFIRMED``     -- stated in this repo's own sourced table (an FCA/Alfa\n                       TSB in ``mes.knowledge``, or a documented part/DTC\n                       definition) or the DTC's own SAE-defined meaning\n                       (e.g. a P0300-04 misfire code by definition implicates\n                       ignition and fuel delivery).\n* ``CORROBORATED``  -- two independent sourced findings agree (e.g. the\n                       U-code -> network assignment: SAE's communication-DTC\n                       range, corroborated by ``mes.knowledge.match_codes``'\n                       own network-cascade family rule).\n* ``SINGLE-SOURCE``  -- one source, or a generic SAE range convention used as\n                       a last-resort, explicitly generic fallback.\n* ``UNKNOWN``       -- no sourced relationship found; recorded as such\n                       rather than guessed.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport re\nfrom datetime import date\nfrom typing import Any, Optional\n\nCONFIRMED = \"CONFIRMED\"\nCORROBORATED = \"CORROBORATED\"\nSINGLE_SOURCE = \"SINGLE-SOURCE\"\nUNKNOWN = \"UNKNOWN\"\n\nCONFIDENCE_LEVELS = (CONFIRMED, CORROBORATED, SINGLE_SOURCE, UNKNOWN)\n\n#: Same wording as ``mes.code_feel``/``mes.parts``/``mes.maintenance_specs``,\n#: so an UNKNOWN confidence always reads the same way across this package.\n_UNKNOWN_NOTE = \"not established in any source checked -- use the service manual (TechAuthority)\"\n\n#: Strip the failure-type byte: \"P0456-00\" -> \"P0456\". Mirrors\n#: ``mes.knowledge.base_code`` / ``mes.code_feel.base_code``, reimplemented\n#: here rather than imported so this module stays a standalone lookup table.\n_BASE_RE = re.compile(r\"^([PBCU][0-9A-F]{4})\", re.IGNORECASE)\n\n\ndef base_code(code: str) -> str:\n    m = _BASE_RE.match((code or \"\").strip().upper())\n    return m.group(1) if m else (code or \"\").strip().upper()\n\n\n# --- the system graph -------------------------------------------------------\n\ndef _dep(system: str, why: str, confidence: str, source: Optional[str] = None) -> dict[str, Any]:\n    \"\"\"One ``depends_on`` edge. Enforces the house rule at definition time:\n    a non-UNKNOWN confidence must carry a real citation; an UNKNOWN one gets\n    the standard note if the caller didn't supply one.\"\"\"\n    if confidence not in CONFIDENCE_LEVELS:\n        raise ValueError(f\"bad confidence {confidence!r}\")\n    if confidence == UNKNOWN and not source:\n        source = _UNKNOWN_NOTE\n    if not source:\n        raise ValueError(f\"dependency on {system!r} has no source -- \"\n                          \"mark confidence UNKNOWN or cite one\")\n    return {\"system\": system, \"why\": why, \"confidence\": confidence, \"source\": source}\n\n\ndef _system(key: str, label: str, components: list[str], *,\n            live_channels: Optional[list[str]] = None,\n            maintenance_items: Optional[list[str]] = None,\n            parts: Optional[list[str]] = None,\n            depends_on: Optional[list[dict[str, Any]]] = None) -> dict[str, Any]:\n    return {\n        \"key\": key,\n        \"label\": label,\n        \"components\": list(components),\n        \"live_channels\": list(live_channels or []),\n        \"maintenance_items\": list(maintenance_items or []),\n        \"parts\": list(parts or []),\n        \"depends_on\": list(depends_on or []),\n    }\n\n\n#: Sources reused by several edges below, named once.\n_S1808000005 = \"mes.knowledge Bulletin S1808000005 (BCM power-feed/fuse F82 cascade into U-codes)\"\n_S2008000032 = \"mes.knowledge Bulletin S2008000032 (connector XY201 / grounds G003A-B multi-module cascade)\"\n_S1708000262 = \"mes.knowledge Bulletin S1708000262 REV. A (intermittent CAN-private/LIN codes -- spread terminals)\"\n_S2308000004 = \"mes.knowledge Bulletin S2308000004 (cranks/no-start -- verify ECM/PCM B+ feeds and grounds)\"\n_S2008000078 = \"mes.knowledge Bulletin S2008000078 REV. A (U0102 on RWD is a software/config fault, not a bus fault)\"\n_S1821000001 = \"mes.knowledge Bulletin S1821000001 REV. A (AWD tyre-circumference mismatch causes driveline shudder)\"\n_EVAP_SOURCES = (\"mes.parts esim/purge_valve (ECM-commanded solenoid/pump) + \"\n                 \"mes.code_feel EVAP section + mes.knowledge EVAP bulletins \"\n                 \"(S2125000002, 9100469/9100471, 18-030-17)\")\n_EVAP_FUEL_SOURCES = (\"mes.code_feel EVAP section + carparts.com/fs1inc.com P0455/P0456 \"\n                      \"writeups (EVAP shares the tank, fuel cap and fuel-level/pressure \"\n                      \"signal path with the fuel system)\")\n_RFHUB_SOURCE = (\"mes.electrical 'rfhub_module' entry (network address CONFIRMED \"\n                 \"and documented to carry TPMS data, per GIORGIO_MODULE_MAP.md; \"\n                 \"module identity as RFHUB itself is INFERRED, per that same entry)\")\n\n#: Ordered as given: the \"natural\" reading order for a dossier, roughly\n#: supply -> network -> the engine's own systems -> driveline -> chassis ->\n#: comfort/sensor/HVAC extras.\nSYSTEMS: dict[str, dict[str, Any]] = {\n    \"electrical_supply\": _system(\n        \"electrical_supply\", \"Electrical supply\",\n        [\"12V battery\", \"alternator\", \"chassis/engine grounds\", \"fuses\",\n         \"BCM power feeds\"],\n        live_channels=[\"battery_voltage\"],\n        maintenance_items=[\"battery_12v\"],\n        parts=[\"battery_12v\"],\n        depends_on=[],\n    ),\n    \"network\": _system(\n        \"network\", \"Network / CAN buses\",\n        [\"CAN-C\", \"CAN-IHS\", \"CAN-CH\", \"gateway modules\", \"BCM\"],\n        live_channels=[],\n        maintenance_items=[],\n        parts=[],\n        depends_on=[\n            _dep(\"electrical_supply\",\n                 \"BCM power feeds and chassis grounds are a documented root \"\n                 \"cause of multi-module U-code cascades, not per-module bus \"\n                 \"faults.\",\n                 CONFIRMED, f\"{_S1808000005}; {_S2008000032}; {_S1708000262}\"),\n        ],\n    ),\n    \"ignition\": _system(\n        \"ignition\", \"Ignition\",\n        [\"spark plugs\", \"ignition coils\", \"crank/cam position sensors\"],\n        live_channels=[\"engine_rpm\"],\n        maintenance_items=[\"spark_plugs\", \"ignition_coils_inspect\"],\n        parts=[\"spark_plug\", \"ignition_coil\"],\n        depends_on=[\n            _dep(\"electrical_supply\",\n                 \"Coils and the igniter driver need a stable B+ supply; a \"\n                 \"no-start/cranks-only complaint is diagnosed by verifying \"\n                 \"ECM/PCM B+ feeds and grounds before suspecting ignition \"\n                 \"parts.\",\n                 CONFIRMED, _S2308000004),\n        ],\n    ),\n    \"fuel\": _system(\n        \"fuel\", \"Fuel\",\n        [\"fuel tank\", \"fuel pump\", \"fuel pressure sensor\", \"fuel filter\",\n         \"injectors\", \"fuel cap\"],\n        live_channels=[\"fuel_level\"],\n        maintenance_items=[\"fuel_filter\"],\n        parts=[],\n        depends_on=[\n            _dep(\"electrical_supply\",\n                 \"The fuel pump and injectors are electrically driven, so a \"\n                 \"weak supply/ground can present as a fuel-delivery fault.\",\n                 UNKNOWN),\n        ],\n    ),\n    \"evap\": _system(\n        \"evap\", \"EVAP (evaporative emissions)\",\n        [\"ESIM\", \"purge valve\", \"canister\", \"vent valve\", \"fuel cap\",\n         \"vapor lines\", \"recirculation-line quick-connect\"],\n        live_channels=[\"commanded_evap_purge\", \"evap_vapor_pressure\",\n                      \"evap_vapor_pressure_abs\", \"fuel_level\"],\n        maintenance_items=[],\n        parts=[\"esim\", \"purge_valve\", \"evap_canister\", \"evap_quick_connect\"],\n        depends_on=[\n            _dep(\"electrical_supply\",\n                 \"The ESIM and purge valve are ECM-commanded electrical \"\n                 \"components (a leak-detection pump and a solenoid); a weak \"\n                 \"supply/ground can disrupt the self-test they rely on.\",\n                 SINGLE_SOURCE, _EVAP_SOURCES),\n            _dep(\"fuel\",\n                 \"EVAP shares the tank, fuel cap and fuel-level/pressure \"\n                 \"signal path with the fuel system; a fuel-cap or tank-side \"\n                 \"fault can present as an EVAP leak code.\",\n                 CORROBORATED, _EVAP_FUEL_SOURCES),\n        ],\n    ),\n    \"air_intake_boost\": _system(\n        \"air_intake_boost\", \"Air intake / boost\",\n        [\"intake tract\", \"MAP sensor\", \"turbocharger\", \"intercooler\",\n         \"boost hoses\", \"throttle body\"],\n        live_channels=[\"intake_map\", \"barometric_pressure\", \"boost\",\n                      \"ecm_195a\", \"intake_air_temp\", \"absolute_load\",\n                      \"throttle_position\"],\n        maintenance_items=[\"engine_air_filter\", \"throttle_body_clean\",\n                           \"intake_boost_hoses_inspect\"],\n        parts=[\"engine_air_filter\", \"turbo_intercooler_hose\"],\n        depends_on=[\n            _dep(\"exhaust_emissions\",\n                 \"The turbocharger is driven by exhaust gas, so an \"\n                 \"exhaust-side restriction or a failing turbo housing can \"\n                 \"present as a boost/MAP-sensor fault.\",\n                 SINGLE_SOURCE,\n                 \"general turbocharger architecture (exhaust-driven turbine) \"\n                 \"-- no GU/Stelvio-specific TSB citation found\"),\n        ],\n    ),\n    \"cooling\": _system(\n        \"cooling\", \"Cooling\",\n        [\"radiator\", \"coolant\", \"water pump\", \"thermostat\", \"cooling fan\"],\n        live_channels=[\"engine_coolant_temp\"],\n        maintenance_items=[\"coolant\"],\n        parts=[\"coolant\"],\n        depends_on=[],\n    ),\n    \"lubrication\": _system(\n        \"lubrication\", \"Lubrication (oil)\",\n        [\"oil pump\", \"oil filter\", \"oil pressure/level sensors\"],\n        live_channels=[\"engine_oil_temp\"],\n        maintenance_items=[],\n        parts=[\"engine_oil\", \"oil_filter\", \"drain_plug_gasket\"],\n        depends_on=[],\n    ),\n    \"exhaust_emissions\": _system(\n        \"exhaust_emissions\", \"Exhaust / emissions\",\n        [\"catalytic converter\", \"O2 sensors\", \"exhaust manifold\",\n         \"turbo exhaust housing\"],\n        live_channels=[],\n        maintenance_items=[],\n        parts=[],\n        depends_on=[\n            _dep(\"ignition\",\n                 \"A misfire dumps unburned fuel into the exhaust and can \"\n                 \"set secondary catalyst/O2 codes.\",\n                 SINGLE_SOURCE,\n                 \"general emissions-system architecture -- no GU/Stelvio-\"\n                 \"specific TSB citation found\"),\n        ],\n    ),\n    \"transmission_driveline\": _system(\n        \"transmission_driveline\", \"Transmission / driveline\",\n        [\"ZF 8HP transmission\", \"Q4 transfer case\", \"differentials\",\n         \"driveshafts\", \"valve body\"],\n        live_channels=[\"tcm_04fe\", \"tcm_0518\"],\n        maintenance_items=[],\n        parts=[\"transmission_fluid\", \"transfer_case_fluid\"],\n        depends_on=[\n            _dep(\"network\",\n                 \"U0102 'lost communication with transfer case' can be an \"\n                 \"ECM software/configuration fault (AWD software on a RWD \"\n                 \"build) rather than a transfer-case hardware or bus fault.\",\n                 CONFIRMED, _S2008000078),\n            _dep(\"suspension\",\n                 \"Tyre circumference mismatch on AWD causes shudder/bind and \"\n                 \"can damage the transfer case; this is ruled out before any \"\n                 \"driveline hardware is condemned.\",\n                 CONFIRMED, _S1821000001),\n        ],\n    ),\n    \"brakes_abs\": _system(\n        \"brakes_abs\", \"Brakes / ABS\",\n        [\"brake pads\", \"rotors\", \"calipers\", \"ABS/ESC modulator\",\n         \"wheel speed sensors\", \"EPB\"],\n        live_channels=[],\n        maintenance_items=[\"brake_fluid\"],\n        parts=[\"brake_pads_front\", \"brake_pads_rear\", \"brake_rotor_front\",\n              \"brake_rotor_rear\", \"brake_fluid\"],\n        depends_on=[\n            _dep(\"electrical_supply\",\n                 \"The ABS/ESC modulator and wheel-speed sensors are \"\n                 \"electrically supplied module hardware, like the other \"\n                 \"modules that cascade from a BCM supply fault.\",\n                 UNKNOWN),\n        ],\n    ),\n    \"steering\": _system(\n        \"steering\", \"Steering\",\n        [\"EPS motor/rack\", \"steering angle sensor\", \"steering column\"],\n        live_channels=[],\n        maintenance_items=[\"power_steering\"],\n        parts=[],\n        depends_on=[\n            _dep(\"electrical_supply\",\n                 \"EPS is an electrically driven power-steering system; a \"\n                 \"weak supply affects assist.\",\n                 UNKNOWN),\n        ],\n    ),\n    \"suspension\": _system(\n        \"suspension\", \"Suspension\",\n        [\"shocks/struts\", \"springs\", \"control arms\", \"bushings\",\n         \"tires/wheels\"],\n        live_channels=[],\n        maintenance_items=[],\n        parts=[\"tpms_sensor\"],\n        depends_on=[],\n    ),\n    \"body_comfort\": _system(\n        \"body_comfort\", \"Body / comfort\",\n        [\"BCM\", \"door/window modules\", \"central locking\",\n         \"interior lighting\", \"wipers\"],\n        live_channels=[],\n        maintenance_items=[\"wipers\", \"hood_and_door_lubrication\"],\n        parts=[\"wiper_blades\"],\n        depends_on=[\n            _dep(\"network\",\n                 \"Most body-module codes gateway through the BCM onto the \"\n                 \"vehicle's CAN/LIN buses; an intermittent bus/terminal \"\n                 \"fault can present as a body-module fault.\",\n                 SINGLE_SOURCE, _S1708000262),\n            _dep(\"electrical_supply\",\n                 \"BCM supply-side faults (e.g. fuse F82) are documented to \"\n                 \"cascade into multiple module/body symptoms.\",\n                 CONFIRMED, _S1808000005),\n        ],\n    ),\n    \"adas_sensors\": _system(\n        \"adas_sensors\", \"ADAS / sensors\",\n        [\"forward camera\", \"radar\", \"park-assist sensors\",\n         \"driver-assist ECU\"],\n        live_channels=[],\n        maintenance_items=[],\n        parts=[],\n        depends_on=[\n            _dep(\"network\",\n                 \"ADAS/chassis-module codes often ride the same gatewayed \"\n                 \"CAN buses as other modules affected by bus/supply events.\",\n                 UNKNOWN),\n        ],\n    ),\n    \"hvac\": _system(\n        \"hvac\", \"HVAC\",\n        [\"A/C compressor\", \"blower motor\", \"cabin air filter\",\n         \"climate control module\", \"refrigerant circuit\"],\n        live_channels=[],\n        maintenance_items=[\"cabin_air_filter\", \"a_c_cabin_service\"],\n        parts=[\"cabin_air_filter\"],\n        depends_on=[],\n    ),\n    \"pcv\": _system(\n        \"pcv\", \"PCV (crankcase ventilation)\",\n        [\"crankcase breather\", \"PCV valve/housing\", \"breather hoses\",\n         \"intake connection\"],\n        live_channels=[],\n        maintenance_items=[\"pcv_system\"],\n        parts=[],\n        depends_on=[\n            _dep(\"lubrication\",\n                 \"The PCV system vents the crankcase that the lubrication \"\n                 \"system pressurizes with combustion blow-by; a \"\n                 \"lubrication-side fault (excess blow-by, overfill) can \"\n                 \"overwhelm the PCV valve/hoses.\",\n                 SINGLE_SOURCE,\n                 \"general PCV system architecture (crankcase ventilation \"\n                 \"draws from the lubrication system's crankcase) -- no \"\n                 \"GU/Stelvio-specific TSB citation found\"),\n            _dep(\"air_intake_boost\",\n                 \"The PCV valve/hoses route crankcase vapor into the \"\n                 \"intake tract under vacuum; a stuck-open valve or split \"\n                 \"hose is a documented source of unmetered air (a vacuum \"\n                 \"leak) that can present as a lean or boost-side fault.\",\n                 SINGLE_SOURCE,\n                 \"general PCV system architecture (crankcase-to-intake \"\n                 \"vacuum connection) -- no GU/Stelvio-specific TSB \"\n                 \"citation found\"),\n        ],\n    ),\n    \"engine_management\": _system(\n        \"engine_management\", \"Engine management (ECM / sensors)\",\n        [\"ECM\", \"crank/cam position sensors\", \"ECM-internal diagnostics\"],\n        live_channels=[],\n        maintenance_items=[],\n        parts=[],\n        depends_on=[\n            _dep(\"electrical_supply\",\n                 \"The ECM/PCM itself needs a stable B+ feed and ground; a \"\n                 \"cranks/no-start complaint is diagnosed by verifying \"\n                 \"ECM/PCM B+ feeds and grounds before suspecting an \"\n                 \"ECM-internal fault.\",\n                 CONFIRMED, _S2308000004),\n        ],\n    ),\n    \"valve_control\": _system(\n        \"valve_control\", \"Valve control (MultiAir / cam phasing)\",\n        [\"MultiAir solenoid/actuator\", \"camshaft position actuator\",\n         \"cam phaser\", \"camshaft position sensors\"],\n        live_channels=[],\n        maintenance_items=[],\n        parts=[],\n        depends_on=[\n            _dep(\"lubrication\",\n                 \"MultiAir/cam-phasing actuators are oil-pressure-\"\n                 \"actuated; low oil pressure or dirty oil is a documented \"\n                 \"cause of camshaft-actuator timing faults on \"\n                 \"oil-pressure-actuated valve systems in general.\",\n                 SINGLE_SOURCE,\n                 \"general MultiAir/cam-phaser architecture (oil-pressure-\"\n                 \"actuated) -- no GU/Stelvio-specific TSB citation found\"),\n        ],\n    ),\n    \"starting_charging\": _system(\n        \"starting_charging\", \"Starting / charging\",\n        [\"starter motor\", \"DBSM (dual battery switch module)\",\n         \"stop-start system\", \"alternator/charging circuit\"],\n        live_channels=[],\n        maintenance_items=[\"battery_12v\"],\n        parts=[\"battery_12v\"],\n        depends_on=[\n            _dep(\"electrical_supply\",\n                 \"A cranks/no-start or stop-start-disabled complaint is \"\n                 \"diagnosed by verifying ECM/PCM B+ feeds and grounds \"\n                 \"before suspecting the starter or DBSM hardware.\",\n                 CONFIRMED, _S2308000004),\n        ],\n    ),\n    \"security_immobiliser\": _system(\n        \"security_immobiliser\", \"Security / immobiliser\",\n        [\"immobiliser (BCM-hosted)\", \"WIN (wireless ignition node)\",\n         \"RFHUB (passive entry / keyfob)\", \"PROXI master\"],\n        live_channels=[],\n        maintenance_items=[],\n        parts=[],\n        depends_on=[\n            _dep(\"network\",\n                 \"Immobiliser functions are hosted on the BCM, which is \"\n                 \"also the documented B-CAN/C-CAN gateway; an intermittent \"\n                 \"bus/terminal fault can present as a security-module \"\n                 \"fault.\",\n                 SINGLE_SOURCE, _S1708000262),\n            _dep(\"electrical_supply\",\n                 \"BCM supply-side faults (e.g. fuse F82) are documented to \"\n                 \"cascade into multiple module/body symptoms, and the \"\n                 \"immobiliser is hosted on the BCM.\",\n                 CONFIRMED, _S1808000005),\n        ],\n    ),\n    \"infotainment_cluster\": _system(\n        \"infotainment_cluster\", \"Infotainment / cluster\",\n        [\"IPC (instrument panel cluster)\", \"Uconnect head unit\",\n         \"radio/navigation/media modules\"],\n        live_channels=[],\n        maintenance_items=[],\n        parts=[],\n        depends_on=[\n            _dep(\"network\",\n                 \"Infotainment/cluster modules gateway through the BCM \"\n                 \"onto the vehicle's CAN/LIN buses; an intermittent bus/\"\n                 \"terminal fault can present as an infotainment/cluster \"\n                 \"fault.\",\n                 SINGLE_SOURCE, _S1708000262),\n            _dep(\"electrical_supply\",\n                 \"BCM supply-side faults (e.g. fuse F82) are documented to \"\n                 \"cascade into multiple module symptoms, infotainment/\"\n                 \"cluster included.\",\n                 CONFIRMED, _S1808000005),\n        ],\n    ),\n    \"lighting\": _system(\n        \"lighting\", \"Lighting\",\n        [\"headlamps\", \"taillamps\", \"turn signal/marker lamps\",\n         \"AFLS/AHLM/AHBM lighting modules\"],\n        live_channels=[],\n        maintenance_items=[],\n        parts=[],\n        depends_on=[\n            _dep(\"electrical_supply\",\n                 \"Lamps and lighting-control modules are electrical \"\n                 \"loads; a weak supply/ground can present as a lighting \"\n                 \"fault.\",\n                 UNKNOWN),\n        ],\n    ),\n    \"wheels_tpms\": _system(\n        \"wheels_tpms\", \"Wheels / TPMS\",\n        [\"TPMS sensors\", \"RFHUB (TPMS RF receive)\"],\n        live_channels=[],\n        maintenance_items=[],\n        parts=[\"tpms_sensor\"],\n        depends_on=[\n            _dep(\"network\",\n                 \"TPMS data is received over the network by the RFHUB, \"\n                 \"whose network address is confirmed in this project's \"\n                 \"own module map (module identity as RFHUB itself is \"\n                 \"inferred).\",\n                 SINGLE_SOURCE, _RFHUB_SOURCE),\n        ],\n    ),\n    \"restraints\": _system(\n        \"restraints\", \"Restraints (airbags / ORC)\",\n        [\"ORC (occupant restraint controller)\", \"airbags\",\n         \"pretensioners\", \"OCM (occupant classification)\",\n         \"SIS (side-impact satellite sensors)\"],\n        live_channels=[],\n        maintenance_items=[],\n        parts=[],\n        depends_on=[\n            _dep(\"electrical_supply\",\n                 \"The ORC and its satellite sensors are electrically \"\n                 \"supplied safety modules; a weak supply/ground could \"\n                 \"affect them like other modules, but no sourced \"\n                 \"restraints-specific cascade was found.\",\n                 UNKNOWN),\n        ],\n    ),\n}\n\n\ndef systems() -> dict[str, dict[str, Any]]:\n    \"\"\"Every system in the graph, in reading order.\"\"\"\n    return SYSTEMS\n\n\n# --- code -> system(s) -------------------------------------------------------\n\n#: Generic (not vehicle-specific) SAE J2012 range-convention sources, named\n#: as generic every time they are the only thing backing an assignment.\n_SAE_SOURCE = (\"SAE J2012 DTC prefix/range convention (generic category, \"\n              \"not vehicle-specific -- informational fallback only)\")\n_SAE_SOURCE_P06 = (\"SAE J2012 P06xx range (Computer & Auxiliary Outputs -- \"\n                   \"ECM/PCM internal); mapped to 'engine_management' \"\n                   \"(a documented approximation, not a sourced fact)\")\n_SAE_SOURCE_CHASSIS = (\"SAE J2012 C-prefix range (chassis: brakes/steering/\"\n                       \"suspension); mapped to 'brakes_abs' as the default \"\n                       \"chassis bucket (a documented approximation -- a \"\n                       \"specific C-code may actually be steering or \"\n                       \"suspension)\")\n_SAE_SOURCE_BODY = \"SAE J2012 B-prefix range (body)\"\n_U_CODE_SOURCE = (\"SAE J2012 U-prefix range (network/communication), \"\n                  \"corroborated by mes.knowledge.match_codes' own network-\"\n                  \"cascade family rule (3+ lost-communication U-codes)\")\n\n#: Exact-code rules, checked before any family/range fallback. Each entry's\n#: ``systems`` are the PRIMARY systems for every code it lists.\n_EXACT_RULES: tuple[dict[str, Any], ...] = (\n    {\"codes\": (\"P0440\", \"P0441\", \"P0455\", \"P0456\", \"P0457\", \"P1CEA\"),\n     \"systems\": (\"evap\",), \"confidence\": CONFIRMED,\n     \"source\": (\"mes.knowledge BULLETINS (S2125000002, 9100469/9100471, \"\n               \"9100468, 9100325, 18-048-23, 18-030-17) + mes.code_feel \"\n               \"EVAP section\")},\n    {\"codes\": (\"P0300\", \"P0301\", \"P0302\", \"P0303\", \"P0304\"),\n     \"systems\": (\"ignition\", \"fuel\"), \"confidence\": CONFIRMED,\n     \"source\": (\"SAE J2012 misfire-code definition (a cylinder misfire by \"\n               \"definition implicates spark and fuel delivery) + \"\n               \"mes.code_feel misfire fallback entry\")},\n    {\"codes\": (\"P0171\", \"P0172\"),\n     \"systems\": (\"fuel\", \"air_intake_boost\"), \"confidence\": CONFIRMED,\n     \"source\": (\"SAE J2012 fuel-trim code definition (System Too Lean/Rich \"\n               \"implicates fuel delivery and air-metering/intake leaks)\")},\n    {\"codes\": (\"B1040\", \"U1700\"),\n     \"systems\": (\"network\",), \"confidence\": CONFIRMED,\n     \"source\": (\"mes.knowledge Bulletin S1808000005 (BCM power/comms \"\n               \"cascade) -- B1040/U1700 are BCM communications codes\")},\n    {\"codes\": (\"B1176\",),\n     \"systems\": (\"body_comfort\",), \"confidence\": SINGLE_SOURCE,\n     \"source\": \"generic body-module DTC definition (B1176); no GU/Stelvio-specific TSB found\"},\n    {\"codes\": (\"C141B\", \"C141C\"),\n     \"systems\": (\"adas_sensors\",), \"confidence\": SINGLE_SOURCE,\n     \"source\": \"generic chassis/ADAS DTC definition (C141B/C141C); no GU/Stelvio-specific TSB found\"},\n    {\"codes\": (\"C104B\",),\n     \"systems\": (\"brakes_abs\",), \"confidence\": SINGLE_SOURCE,\n     \"source\": \"generic chassis DTC definition (C104B, ABS/ESC range); no GU/Stelvio-specific TSB found\"},\n    {\"codes\": (\"P0098\", \"P00F5\", \"P105E\", \"P1189\"),\n     \"systems\": (\"air_intake_boost\",), \"confidence\": CONFIRMED,\n     \"source\": (\"SAE J2012 IAT2/boost-pressure sensor circuit code \"\n               \"definitions (P0098/P00F5/P105E/P1189)\")},\n    {\"codes\": (\"P0010\", \"P0011\", \"P0012\", \"P0013\", \"P0014\"),\n     \"systems\": (\"valve_control\",), \"confidence\": CONFIRMED,\n     \"source\": (\"SAE J2012 camshaft position actuator/timing code \"\n               \"definitions ('A'/'B' camshaft actuator circuit and timing \"\n               \"over-advanced/over-retarded) -- generic SAE definition, \"\n               \"not vehicle-specific\")},\n)\n\n#: Keyword fallback for P1xxx (manufacturer-defined) codes, and for B-codes\n#: (body) that need routing to a more specific body-adjacent system before\n#: falling back to the generic body bucket, with no exact entry above:\n#: matched against the code's own description text, never guessed from the\n#: code number alone. First match wins.\n_KEYWORDS: tuple[tuple[tuple[str, ...], str], ...] = (\n    ((\"evap\", \"purge\", \"canister\", \"vent valve\", \"esim\"), \"evap\"),\n    ((\"crankcase\",), \"pcv\"),\n    ((\"multiair\", \"vvt\", \"variable valve\", \"cam phase\"), \"valve_control\"),\n    ((\"turbo\", \"boost\", \"charge air\", \"supercharg\", \"map sensor\"), \"air_intake_boost\"),\n    ((\"misfire\", \"ignition coil\", \"spark\"), \"ignition\"),\n    ((\"airbag\", \"air bag\", \"restraint\", \"occupant restraint\"), \"restraints\"),\n    ((\"headlamp\", \"headlight\", \"taillamp\", \"tail lamp\", \"turn signal\",\n      \"lamp\", \"bulb\"), \"lighting\"),\n    ((\"injector\", \"fuel pump\", \"fuel pressure\", \"fuel rail\", \"fuel trim\"), \"fuel\"),\n    ((\"transmission\", \"shift\", \"gear ratio\", \"clutch\", \"valve body\", \"tcm\"), \"transmission_driveline\"),\n    ((\"communication\", \"network\", \"can bus\", \" bus \"), \"network\"),\n    ((\"battery\", \"charging system\", \"alternator\", \"voltage\"), \"electrical_supply\"),\n    ((\"coolant\", \"thermostat\", \"radiator\", \"overheat\"), \"cooling\"),\n    ((\"oil pressure\", \"oil level\", \"lubrication\"), \"lubrication\"),\n    ((\"catalyst\", \"oxygen sensor\", \"o2 sensor\", \"exhaust\"), \"exhaust_emissions\"),\n    ((\"brake\", \"abs\", \"stability\"), \"brakes_abs\"),\n    ((\"steering\",), \"steering\"),\n    ((\"suspension\", \"shock\", \"strut\"), \"suspension\"),\n    ((\"hvac\", \"air condition\", \"blower\", \"climate\"), \"hvac\"),\n    ((\"body control\", \"door module\", \"window\", \"central lock\"), \"body_comfort\"),\n    ((\"camera\", \"radar\", \"lane\", \"park assist\"), \"adas_sensors\"),\n)\n\n_KEYWORD_SOURCE = (\"description keyword match (manufacturer P1xxx code, or \"\n                   \"a B-code, with no exact entry); the keyword list itself \"\n                   \"is this module's own best-effort mapping, not an \"\n                   \"external citation -- treat as a lead\")\n\n\ndef _keyword_system(description: str) -> Optional[str]:\n    d = (description or \"\").lower()\n    if not d:\n        return None\n    for keywords, sys_key in _KEYWORDS:\n        if any(k in d for k in keywords):\n            return sys_key\n    return None\n\n\ndef _sae_fallback(base: str) -> Optional[dict[str, Any]]:\n    \"\"\"The SAE J2012 prefix/range convention, as a generic last resort.\"\"\"\n    if len(base) < 3:\n        return None\n    letter, rest = base[0], base[1:]\n    if letter == \"P\":\n        prefix2 = rest[:2]\n        if prefix2 == \"01\":\n            return {\"systems\": (\"fuel\", \"air_intake_boost\"),\n                    \"confidence\": SINGLE_SOURCE, \"source\": _SAE_SOURCE}\n        if prefix2 == \"03\":\n            return {\"systems\": (\"ignition\",),\n                    \"confidence\": SINGLE_SOURCE, \"source\": _SAE_SOURCE}\n        if prefix2 == \"04\":\n            return {\"systems\": (\"evap\",),\n                    \"confidence\": SINGLE_SOURCE, \"source\": _SAE_SOURCE}\n        if prefix2 == \"05\":\n            return {\"systems\": (\"air_intake_boost\", \"electrical_supply\"),\n                    \"confidence\": SINGLE_SOURCE, \"source\": _SAE_SOURCE}\n        if prefix2 == \"06\":\n            return {\"systems\": (\"engine_management\",),\n                    \"confidence\": SINGLE_SOURCE, \"source\": _SAE_SOURCE_P06}\n        if prefix2 in (\"07\", \"08\", \"09\"):\n            return {\"systems\": (\"transmission_driveline\",),\n                    \"confidence\": SINGLE_SOURCE, \"source\": _SAE_SOURCE}\n        return None\n    if letter == \"C\":\n        return {\"systems\": (\"brakes_abs\",),\n                \"confidence\": SINGLE_SOURCE, \"source\": _SAE_SOURCE_CHASSIS}\n    if letter == \"B\":\n        return {\"systems\": (\"body_comfort\",),\n                \"confidence\": SINGLE_SOURCE, \"source\": _SAE_SOURCE_BODY}\n    if letter == \"U\":\n        return {\"systems\": (\"network\",),\n                \"confidence\": CORROBORATED, \"source\": _U_CODE_SOURCE}\n    return None\n\n\ndef systems_for_code(code: str, description: str = \"\") -> list[dict[str, Any]]:\n    \"\"\"Every system this code implicates: primaries first, then whatever\n    systems the primaries' own ``depends_on`` names as upstream.\n\n    Resolution order: exact-code table, then \"any U-code is network\" (a\n    family rule, not a guess -- see ``_U_CODE_SOURCE``), then a P1xxx or\n    B-code description-keyword match, then the generic SAE range fallback,\n    then give up honestly (one ``UNKNOWN`` row naming no system).\n\n    A code's primary system(s) automatically pull in their declared\n    ``depends_on`` edges as ``role=\"upstream\"`` rows, so (for example) every\n    EVAP code always carries electrical_supply and fuel upstream without\n    that having to be hand-maintained per code here too.\n    \"\"\"\n    base = base_code(code)\n    primaries: list[tuple[Optional[str], str, str]] = []  # (system, confidence, source)\n\n    matched = False\n    for rule in _EXACT_RULES:\n        if base in rule[\"codes\"]:\n            for sys_key in rule[\"systems\"]:\n                primaries.append((sys_key, rule[\"confidence\"], rule[\"source\"]))\n            matched = True\n            break\n\n    if not matched and base.startswith(\"U\"):\n        primaries.append((\"network\", CORROBORATED, _U_CODE_SOURCE))\n        matched = True\n\n    if not matched and (base.startswith(\"P1\") or base.startswith(\"B\")):\n        sys_key = _keyword_system(description)\n        if sys_key:\n            primaries.append((sys_key, SINGLE_SOURCE, _KEYWORD_SOURCE))\n            matched = True\n\n    if not matched:\n        fb = _sae_fallback(base)\n        if fb:\n            for sys_key in fb[\"systems\"]:\n                primaries.append((sys_key, fb[\"confidence\"], fb[\"source\"]))\n            matched = True\n\n    out: list[dict[str, Any]] = []\n    seen: set[str] = set()\n    if not matched:\n        out.append({\"system\": \"UNKNOWN\", \"role\": \"primary\",\n                   \"confidence\": UNKNOWN, \"source\": _UNKNOWN_NOTE})\n        return out\n\n    for sys_key, confidence, source in primaries:\n        if sys_key in seen:\n            continue\n        seen.add(sys_key)\n        out.append({\"system\": sys_key, \"role\": \"primary\",\n                   \"confidence\": confidence, \"source\": source})\n\n    for sys_key, _conf, _src in primaries:\n        sys_def = SYSTEMS.get(sys_key)\n        if sys_def is None:\n            continue\n        for dep in sys_def[\"depends_on\"]:\n            if dep[\"system\"] in seen:\n                continue\n            seen.add(dep[\"system\"])\n            out.append({\"system\": dep[\"system\"], \"role\": \"upstream\",\n                       \"confidence\": dep[\"confidence\"], \"source\": dep[\"source\"]})\n    return out\n\n\ndef _primary_systems(code: str, description: str = \"\") -> list[str]:\n    return [e[\"system\"] for e in systems_for_code(code, description)\n            if e[\"role\"] == \"primary\" and e[\"system\"] != \"UNKNOWN\"]\n\n\n# --- corpus correlation -----------------------------------------------------\n\ndef correlate(vin: str) -> dict[str, Any]:\n    \"\"\"Project one vehicle's whole DTC corpus onto the system graph.\n\n    Built from :func:`mes.analysis.dtc_history` (the same per-occurrence\n    file/timestamp data :func:`mes.workup.build` uses) plus\n    ``mes.workup.build`` itself for the current-picture open codes and the\n    latest clear assessment, used only to classify each system's\n    ``status``. Simulation logs are excluded (``dtc_history``'s default).\n\n    Returns ``{\"error\": ...}`` if no logs match this VIN -- never a\n    half-empty dossier.\n    \"\"\"\n    from . import analysis, workup as workup_mod\n\n    history = analysis.dtc_history(vin=vin)\n    if not history:\n        return {\"error\": \"no logs match\", \"vin\": vin}\n\n    primary_map: dict[str, list[str]] = {}\n    for code, rec in history.items():\n        descr = rec.descriptions[0] if rec.descriptions else \"\"\n        primary_map[code] = _primary_systems(code, descr)\n\n    # --- per-session (per-file) system sets ---------------------------------\n    session_codes: dict[str, set[str]] = {}\n    for code, rec in history.items():\n        for occ in rec.occurrences:\n            fname = occ.get(\"file\")\n            if not fname:\n                continue\n            session_codes.setdefault(fname, set()).add(code)\n    session_systems: dict[str, set[str]] = {\n        fname: {s for c in codes for s in primary_map.get(c, [])}\n        for fname, codes in session_codes.items()\n    }\n    total_sessions = len(session_systems)\n\n    # --- current picture, for status classification only -------------------\n    try:\n        dossier = workup_mod.build(vin=vin)\n    except Exception:  # noqa: BLE001 -- status is a nice-to-have, never fatal\n        dossier = {}\n    cp = dossier.get(\"current_picture\", {}) if isinstance(dossier, dict) else {}\n    latest = cp.get(\"latest_session\") or {}\n    open_codes = {d.get(\"dtc\") for d in latest.get(\"dtcs\", []) if d.get(\"dtc\")}\n    clear = cp.get(\"clear_assessment\") or {}\n    cleared_codes = set(clear.get(\"codes_cleared\") or [])\n\n    # --- by_system -----------------------------------------------------------\n    by_system: list[dict[str, Any]] = []\n    for sys_key in SYSTEMS:\n        codes_here = sorted(c for c, syss in primary_map.items() if sys_key in syss)\n        if not codes_here:\n            by_system.append({\"system\": sys_key, \"codes\": [], \"sessions\": 0,\n                              \"first\": None, \"last\": None, \"status\": \"clean\"})\n            continue\n        sessions_here = sum(1 for syss in session_systems.values() if sys_key in syss)\n        firsts = [history[c].first_seen for c in codes_here if history[c].first_seen]\n        lasts = [history[c].last_seen for c in codes_here if history[c].last_seen]\n        if open_codes & set(codes_here):\n            status = \"active\"\n        elif cleared_codes & set(codes_here):\n            status = \"cleared_unverified\"\n        else:\n            status = \"stale\"\n        by_system.append({\n            \"system\": sys_key, \"codes\": codes_here, \"sessions\": sessions_here,\n            \"first\": min(firsts) if firsts else None,\n            \"last\": max(lasts) if lasts else None,\n            \"status\": status,\n        })\n\n    # --- co-occurrence, pairs with >= 2 shared sessions only ----------------\n    active = [row[\"system\"] for row in by_system if row[\"sessions\"] > 0]\n    co_occurrence: list[dict[str, Any]] = []\n    for i, a in enumerate(active):\n        for b in active[i + 1:]:\n            sessions_a = sum(1 for syss in session_systems.values() if a in syss)\n            sessions_b = sum(1 for syss in session_systems.values() if b in syss)\n            together = sum(1 for syss in session_systems.values()\n                           if a in syss and b in syss)\n            if together < 2:\n                continue\n            expected = (sessions_a * sessions_b) / total_sessions if total_sessions else 0\n            lift = round(together / expected, 2) if expected else None\n            label_a, label_b = SYSTEMS[a][\"label\"], SYSTEMS[b][\"label\"]\n            reading = (\n                f\"{label_a} and {label_b} codes appeared together in \"\n                f\"{together} of {total_sessions} session(s) ({sessions_a} had \"\n                f\"{label_a} codes, {sessions_b} had {label_b} codes); lift \"\n                f\"{lift if lift is not None else 'n/a'} -- correlation only, \"\n                \"could point at a shared cause or be coincidental overlap.\"\n            )\n            co_occurrence.append({\"a\": a, \"b\": b, \"sessions_together\": together,\n                                   \"sessions_a\": sessions_a, \"sessions_b\": sessions_b,\n                                   \"lift\": lift, \"reading\": reading})\n\n    # --- chains: depends_on edges, with corpus evidence where it exists ------\n    chains: list[dict[str, Any]] = []\n    for row in by_system:\n        sys_key = row[\"system\"]\n        if row[\"sessions\"] == 0:\n            continue\n        deps = SYSTEMS[sys_key][\"depends_on\"]\n        if not deps:\n            continue\n        possible_upstream = []\n        for dep in deps:\n            evidence = None\n            for co in co_occurrence:\n                if {co[\"a\"], co[\"b\"]} == {sys_key, dep[\"system\"]}:\n                    evidence = (f\"{co['sessions_together']} of {total_sessions} \"\n                               f\"session(s) with {SYSTEMS[sys_key]['label']} codes \"\n                               f\"also carried {SYSTEMS[dep['system']]['label']} \"\n                               f\"codes (lift {co['lift']}) -- could be upstream, \"\n                               \"not proven.\")\n                    break\n            possible_upstream.append({\"system\": dep[\"system\"], \"why\": dep[\"why\"],\n                                      \"evidence\": evidence})\n        chains.append({\"issue\": f\"{SYSTEMS[sys_key]['label']} codes\",\n                       \"possible_upstream\": possible_upstream})\n\n    # --- findings, plain dated sentences -------------------------------------\n    today = date.today().isoformat()\n    findings: list[str] = []\n    for row in by_system:\n        if row[\"sessions\"] == 0:\n            continue\n        findings.append(\n            f\"{today}: {SYSTEMS[row['system']]['label']} shows \"\n            f\"{len(row['codes'])} code(s) across {row['sessions']} \"\n            f\"session(s) ({row['first']} to {row['last']}), status={row['status']}.\"\n        )\n    for co in co_occurrence:\n        findings.append(f\"{today}: {co['reading']}\")\n    if not findings:\n        findings.append(f\"{today}: no DTCs found for {vin} across the corpus.\")\n\n    return {\n        \"vin\": vin,\n        \"by_system\": by_system,\n        \"co_occurrence\": co_occurrence,\n        \"chains\": chains,\n        \"findings\": findings,\n    }\n\n\n__all__ = [\"SYSTEMS\", \"systems\", \"systems_for_code\", \"correlate\", \"base_code\",\n           \"CONFIRMED\", \"CORROBORATED\", \"SINGLE_SOURCE\", \"UNKNOWN\"]\n","numLines":889,"startLine":1,"totalLines":889}},"sourceToolAssistantUUID":"92101773-2336-4ad8-8bde-85c9818dfe37","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
{"parentUuid":"f37f1f78-ce72-47cf-a025-515cba499b38","isSidechain":true,"agentId":"a7730a69efb7861a9","message":{"model":"claude-sonnet-5","id":"msg_011CfpiL96maxNVAsJtDGv6X","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01GebvqgJLeLcQ4q4SAq1iWP","name":"Read","input":{"file_path":"C:\\Users\\User\\mcp-servers\\cuore\\web\\systems_routes.py"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":5313,"cache_read_input_tokens":57039,"cache_creation":{"ephemeral_5m_input_tokens":5313,"ephemeral_1h_input_tokens":0},"output_tokens":2,"service_tier":"standard","inference_geo":"not_available"},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_01GebvqgJLeLcQ4q4SAq1iWP":{"file_path":"C:\\Users\\User\\mcp-servers\\cuore\\web\\systems_routes.py"}},"serverClassifierRequest":"9ed0e821-4ec7-4f6b-88da-dffe657851c3","apiBlockIndex":2,"requestId":"req_011CfpiL8rt1sPU77fgQPHPo","attributionAgent":"general-purpose","type":"assistant","uuid":"7e2ce5cd-4789-4e9d-b03b-5fd67866ba30","timestamp":"2026-10-08T11:45:23.746Z","effort":"high","perTurnEffort":null,"userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
{"parentUuid":"7e2ce5cd-4789-4e9d-b03b-5fd67866ba30","isSidechain":true,"promptId":"b7d5245f-77ce-48c1-8f3f-a89a5e1f4f71","agentId":"a7730a69efb7861a9","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01GebvqgJLeLcQ4q4SAq1iWP","type":"tool_result","content":"1\t\"\"\"``GET /v/{vin}/systems``: the cross-system dependency view -- which\n2\tsystems may sit upstream of a given code's family, and where this\n3\tvehicle's own history corroborates that (or merely guesses at it).\n4\t\n5\tSame posture as :mod:`cuore.web.timeline_routes`/:mod:`cuore.web.\n6\tparts_routes` (both built the same way, concurrently with other agents):\n7\ta separate router, reusing ``_dossier``/``_page``/``_set_active_vehicle``/\n8\t``_vehicle_bar`` from :mod:`cuore.web.routes` by import rather than\n9\tduplicating that plumbing.\n10\t\n11\tThe data contract lives in ``cuore.services.systems_bridge``\n12\t(``systems()``, ``systems_for_code(code, description=\"\")``,\n13\t``correlate(vin)``), built in parallel by another agent and not\n14\tnecessarily present yet. Every call into it is wrapped and falls back to\n15\ta fixture built to the exact shape the contract specifies, so this page --\n16\tand the ``_system_badge.html`` chips on ``code.html``/``vehicle.html``/\n17\t``report.html`` -- are developable and testable before that module lands.\n18\tOnce it exists, nothing here needs to change -- the lazy import just\n19\tstarts succeeding.\n20\t\n21\tRegisters two Jinja globals the same way :mod:`cuore.web.timeline_routes`\n22\tregisters ``code_feel`` and :mod:`cuore.web.parts_routes` registers\n23\t``parts_for`` -- on both ``Jinja2Templates`` instances this feature's\n24\tpages use (``cuore.web.routes``'s, for ``code.html``/``vehicle.html``/\n25\t``report.html``, and ``cuore.web.service_routes``'s, the same\n26\ttwo-environments wrinkle :mod:`cuore.web.experience_globals` already\n27\tdocuments and works around):\n28\t\n29\t* ``systems_for_code(code, description=\"\")`` -- the badge list for one code.\n30\t* ``system_label(key)`` -- a system key's display label, for anywhere a\n31\t  badge or table only has the bare key (falls back to a title-cased key\n32\t  for one this page has never seen).\n33\t\n34\tNot registered on the app here -- ``app.py`` is owned by another agent\n35\twhile this was built. The two lines needed there (next to the other\n36\t``web`` router imports/includes):\n37\t\n38\t    ``from .web import systems_routes``\n39\t    ``app.include_router(systems_routes.router)``\n40\t\"\"\"\n41\t\n42\tfrom __future__ import annotations\n43\t\n44\timport importlib\n45\tfrom typing import Any\n46\t\n47\tfrom fastapi import APIRouter, Depends, Request\n48\tfrom fastapi.responses import HTMLResponse\n49\t\n50\tfrom ..api.deps import require_token\n51\tfrom ..services import known_good_bridge, parts_bridge\n52\tfrom . import systems_svg\n53\tfrom .routes import _dossier, _page, _set_active_vehicle, _vehicle_bar\n54\tfrom .routes import templates as _shared_templates\n55\t\n56\trouter = APIRouter(include_in_schema=False, dependencies=[Depends(require_token)])\n57\t\n58\t#: depends_on confidence -> edge line style, the same three buckets\n59\t#: systems_svg.py draws (solid covers both CONFIRMED and CORROBORATED).\n60\tCONFIDENCE_STYLE: dict[str, str] = {\n61\t    \"CONFIRMED\": \"solid\", \"CORROBORATED\": \"solid\",\n62\t    \"SINGLE-SOURCE\": \"dashed\", \"UNKNOWN\": \"dotted\",\n63\t}\n64\t#: role/confidence combinations the badge treats as \"not yet nailed down\" --\n65\t#: these get a trailing \"?\" on the badge rather than a second colour.\n66\t_LOW_CONFIDENCE = {\"SINGLE-SOURCE\", \"UNKNOWN\"}\n67\t\n68\tSTATUS_LABEL = systems_svg.STATUS_TEXT\n69\t#: status -> the existing status-chip CSS class (cuore.css already defines\n70\t#: .chip.status-active/.status-cleared_unverified/.status-stale and the\n71\t#: plain .chip.ok -- no new classes needed here). Vocabulary matches\n72\t#: mes.systems.correlate() exactly: active/cleared_unverified/clean/stale.\n73\tSTATUS_CHIP_CLASS = {\"active\": \"status-active\", \"cleared_unverified\": \"status-cleared_unverified\",\n74\t                     \"clean\": \"ok\", \"stale\": \"status-stale\"}\n75\t\n76\t\n77\t# --- fixture: the exact shape cuore.services.systems_bridge returns, built\n78\t# directly against the real ``mes.systems`` contract (same keys, same\n79\t# vocabulary -- \"electrical_supply\" not \"electrical\", status one of\n80\t# active/cleared_unverified/clean/stale, live_channels/parts as plain known\n81\t# good/parts keys, not inline dicts) so this fixture and the real module\n82\t# are interchangeable to every consumer below. ----------------------------\n83\t\n84\tdef _fixture_systems() -> list[dict[str, Any]]:\n85\t    return [\n86\t        {\"key\": \"electrical_supply\", \"label\": \"Electrical supply\",\n87\t         \"components\": [\"12V battery\", \"alternator\", \"chassis/engine grounds\", \"fuses\"],\n88\t         \"live_channels\": [\"battery_voltage\"],\n89\t         \"maintenance_items\": [\"battery_12v\"], \"parts\": [\"battery_12v\"], \"depends_on\": []},\n90\t        {\"key\": \"network\", \"label\": \"Network / CAN buses\",\n91\t         \"components\": [\"CAN-C\", \"CAN-IHS\", \"gateway modules\", \"BCM\"],\n92\t         \"live_channels\": [], \"maintenance_items\": [], \"parts\": [],\n93\t         \"depends_on\": [{\"system\": \"electrical_supply\",\n94\t                          \"why\": \"BCM power feeds and chassis grounds are a documented root cause \"\n95\t                                \"of multi-module U-code cascades, not per-module bus faults.\",\n96\t                          \"confidence\": \"CONFIRMED\", \"source\": \"mes.knowledge bulletins\"}]},\n97\t        {\"key\": \"evap\", \"label\": \"EVAP (evaporative emissions)\",\n98\t         \"components\": [\"purge valve\", \"vent valve\", \"fuel cap\", \"NVLD\"],\n99\t         \"live_channels\": [], \"maintenance_items\": [], \"parts\": [\"evap_purge_valve\"],\n100\t         \"depends_on\": [{\"system\": \"electrical_supply\",\n101\t                          \"why\": \"the purge valve solenoid is an ECM-commanded, power-fed actuator\",\n102\t                          \"confidence\": \"SINGLE-SOURCE\", \"source\": \"mes.parts esim/purge_valve\"},\n103\t                         {\"system\": \"fuel\",\n104\t                          \"why\": \"EVAP shares the tank, fuel cap and fuel-level/pressure signal path \"\n105\t                                \"with the fuel system\",\n106\t                          \"confidence\": \"CORROBORATED\", \"source\": \"mes.code_feel EVAP section\"}]},\n107\t        {\"key\": \"fuel\", \"label\": \"Fuel\", \"components\": [\"fuel pump\", \"fuel level sensor\"],\n108\t         \"live_channels\": [], \"maintenance_items\": [], \"parts\": [], \"depends_on\": []},\n109\t        {\"key\": \"brakes_abs\", \"label\": \"Brakes / ABS\", \"components\": [\"ABS module\", \"wheel speed sensors\"],\n110\t         \"live_channels\": [], \"maintenance_items\": [], \"parts\": [],\n111\t         \"depends_on\": [{\"system\": \"electrical_supply\", \"why\": \"speculative -- not yet corroborated on this car\",\n112\t                          \"confidence\": \"UNKNOWN\", \"source\": \"none yet\"}]},\n113\t    ]\n114\t\n115\t\n116\tdef _fixture_systems_for_code(code: str, description: str = \"\") -> list[dict[str, Any]]:\n117\t    c = (code or \"\").upper()\n118\t    if c.startswith(\"P04\"):\n119\t        return [{\"system\": \"evap\", \"role\": \"primary\", \"confidence\": \"CONFIRMED\", \"source\": \"DTC prefix table\"},\n120\t                {\"system\": \"electrical_supply\", \"role\": \"upstream\", \"confidence\": \"SINGLE-SOURCE\",\n121\t                 \"source\": \"systems depends_on graph\"},\n122\t                {\"system\": \"fuel\", \"role\": \"upstream\", \"confidence\": \"CORROBORATED\",\n123\t                 \"source\": \"systems depends_on graph\"}]\n124\t    if c.startswith(\"U0\"):\n125\t        return [{\"system\": \"network\", \"role\": \"primary\", \"confidence\": \"CORROBORATED\", \"source\": \"DTC prefix table\"},\n126\t                {\"system\": \"electrical_supply\", \"role\": \"upstream\", \"confidence\": \"CONFIRMED\",\n127\t                 \"source\": \"systems depends_on graph\"}]\n128\t    if c.startswith(\"C\"):\n129\t        return [{\"system\": \"brakes_abs\", \"role\": \"primary\", \"confidence\": \"CONFIRMED\", \"source\": \"DTC prefix table\"},\n130\t                {\"system\": \"electrical_supply\", \"role\": \"upstream\", \"confidence\": \"UNKNOWN\",\n131\t                 \"source\": \"systems depends_on graph\"}]\n132\t    return []\n133\t\n134\t\n135\tdef _fixture_correlate(vin: str) -> dict[str, Any]:\n136\t    return {\n137\t        \"by_system\": [\n138\t            {\"system\": \"evap\", \"codes\": [\"P0440\", \"P0455\", \"P0456\"], \"sessions\": 11,\n139\t             \"first\": \"2025-09-24\", \"last\": \"2026-08-27\", \"status\": \"cleared_unverified\"},\n140\t            {\"system\": \"network\", \"codes\": [\"U0100\"], \"sessions\": 2,\n141\t             \"first\": \"2026-01-15\", \"last\": \"2026-01-15\", \"status\": \"stale\"},\n142\t            {\"system\": \"electrical_supply\", \"codes\": [], \"sessions\": 0, \"first\": None, \"last\": None,\n143\t             \"status\": \"clean\"},\n144\t            {\"system\": \"fuel\", \"codes\": [], \"sessions\": 0, \"first\": None, \"last\": None, \"status\": \"clean\"},\n145\t            {\"system\": \"brakes_abs\", \"codes\": [], \"sessions\": 0, \"first\": None, \"last\": None, \"status\": \"stale\"},\n146\t        ],\n147\t        \"co_occurrence\": [\n148\t            {\"a\": \"evap\", \"b\": \"electrical_supply\", \"sessions_together\": 0, \"sessions_a\": 11, \"sessions_b\": 0,\n149\t             \"lift\": 1.0, \"reading\": \"no electrical-supply session on file yet to corroborate against\"},\n150\t        ],\n151\t        \"chains\": [\n152\t            {\"issue\": \"EVAP leak codes (P0440/P0455/P0456) will not verify clean\",\n153\t             \"possible_upstream\": [\n154\t                 {\"system\": \"electrical_supply\", \"why\": \"purge valve solenoid control circuit\",\n155\t                  \"evidence\": \"TSB 18-030-17 (ECM calibration) is the leading verdict for this car; \"\n156\t                              \"no electrical fault has been corroborated on it yet\"},\n157\t             ]},\n158\t        ],\n159\t        \"findings\": [\n160\t            \"EVAP is the only system with an active/cleared-unverified code on this car -- every \"\n161\t            \"other system is stale (no live or session data) rather than confirmed clean.\",\n162\t        ],\n163\t    }\n164\t\n165\t\n166\tdef _bridge():\n167\t    \"\"\"``cuore.services.systems_bridge``, or ``None`` if it has not landed.\"\"\"\n168\t    try:\n169\t        from ..services import systems_bridge\n170\t        return systems_bridge\n171\t    except ImportError:\n172\t        return None\n173\t\n174\t\n175\tdef _systems() -> list[dict[str, Any]]:\n176\t    \"\"\"Normalises to a list either way: ``mes.systems.systems()`` actually\n177\t    returns an ordered ``{key: record}`` dict (\"every vehicle system in\n178\t    the graph, in reading order\" -- a Python dict preserves that just as\n179\t    well as a list), while this fixture (and the contract as first\n180\t    specified) uses a plain list. Every consumer below only ever wants\n181\t    the list of records, so that's what this always hands back.\"\"\"\n182\t    bridge = _bridge()\n183\t    if bridge is None:\n184\t        return _fixture_systems()\n185\t    try:\n186\t        raw = bridge.systems()\n187\t    except Exception:  # noqa: BLE001 -- a knowledge-table miss must never 500 a page\n188\t        return _fixture_systems()\n189\t    if isinstance(raw, dict):\n190\t        return list(raw.values())\n191\t    return list(raw or [])\n192\t\n193\t\n194\tdef _systems_for_code(code: str, description: str = \"\") -> list[dict[str, Any]]:\n195\t    bridge = _bridge()\n196\t    if bridge is None:\n197\t        return _fixture_systems_for_code(code, description)\n198\t    try:\n199\t        return bridge.systems_for_code(code, description) or []\n200\t    except Exception:  # noqa: BLE001\n201\t        return []\n202\t\n203\t\n204\tdef _correlate(vin: str) -> dict[str, Any]:\n205\t    bridge = _bridge()\n206\t    if bridge is None:\n207\t        return _fixture_correlate(vin)\n208\t    try:\n209\t        return bridge.correlate(vin) or {}\n210\t    except Exception:  # noqa: BLE001\n211\t        return _fixture_correlate(vin)\n212\t\n213\t\n214\tdef _live_channel_info(channel_id: str) -> dict[str, Any]:\n215\t    \"\"\"One system's ``live_channels`` entry (a bare known-good channel key,\n216\t    e.g. ``\"battery_voltage\"``) resolved to a display name and its\n217\t    known-good band note, via :mod:`cuore.services.known_good_bridge` --\n218\t    the same source ``cuore.live.layouts``' gauges read. Never raises: an\n219\t    unresolvable or UNKNOWN-confidence channel still shows (by its id) with\n220\t    a plain \"no sourced band yet\" note rather than vanishing or 500ing.\"\"\"\n221\t    row, band = None, None\n222\t    try:\n223\t        row = known_good_bridge.known_good_for(channel_id)\n224\t    except Exception:  # noqa: BLE001\n225\t        pass\n226\t    try:\n227\t        band = known_good_bridge.sourced_band(channel_id)\n228\t    except Exception:  # noqa: BLE001\n229\t        pass\n230\t    name = (row or {}).get(\"name\") or channel_id.replace(\"_\", \" \").title()\n231\t    note = (band or {}).get(\"note\") or \"no sourced band yet\"\n232\t    return {\"name\": name, \"band\": note}\n233\t\n234\t\n235\tdef _system_parts(part_keys: list[str]) -> list[dict[str, Any]]:\n236\t    \"\"\"One system's ``parts`` entry (a list of bare part keys, e.g.\n237\t    ``\"battery_12v\"``) resolved to full part dicts via\n238\t    :mod:`cuore.services.parts_bridge`, ready for ``_part_card.html``. A key\n239\t    with nothing on file is dropped, not shown as an empty card.\"\"\"\n240\t    out = []\n241\t    for key in part_keys or []:\n242\t        try:\n243\t            p = parts_bridge.part(key)\n244\t        except Exception:  # noqa: BLE001\n245\t            p = None\n246\t        if p:\n247\t            out.append(p)\n248\t    return out\n249\t\n250\t\n251\tdef _system_label(key: str) -> str:\n252\t    for s in _systems():\n253\t        if s.get(\"key\") == key:\n254\t            return s.get(\"label\") or key\n255\t    return (key or \"\").replace(\"_\", \" \").title()\n256\t\n257\t\n258\t_shared_templates.env.globals[\"systems_for_code\"] = _systems_for_code\n259\t_shared_templates.env.globals[\"system_label\"] = _system_label\n260\t\n261\tfor _module_name in (\"service_routes\", \"drivetrain_routes\", \"timeline_routes\"):\n262\t    try:\n263\t        _mod = importlib.import_module(f\".{_module_name}\", __package__)\n264\t        _tmpl = getattr(_mod, \"templates\", None) or getattr(_mod, \"_shared_templates\", None)\n265\t        if _tmpl is not None and _tmpl is not _shared_templates:\n266\t            _tmpl.env.globals[\"systems_for_code\"] = _systems_for_code\n267\t            _tmpl.env.globals[\"system_label\"] = _system_label\n268\t    except Exception:  # noqa: BLE001 -- import-time side effect, must never raise\n269\t        pass\n270\t\n271\t\n272\t# --- the page's view model --------------------------------------------------\n273\t\n274\tdef _build_view(vin: str) -> dict[str, Any]:\n275\t    systems = _systems()\n276\t    corr = _correlate(vin)\n277\t    by_system = {r.get(\"system\"): r for r in (corr.get(\"by_system\") or [])}\n278\t    labels = {s.get(\"key\"): s.get(\"label\") or s.get(\"key\") for s in systems}\n279\t\n280\t    nodes, cards = [], []\n281\t    for s in systems:\n282\t        key = s.get(\"key\")\n283\t        row = by_system.get(key) or {}\n284\t        status = row.get(\"status\") or \"stale\"\n285\t        codes = row.get(\"codes\") or []\n286\t        nodes.append({\"key\": key, \"label\": s.get(\"label\") or key,\n287\t                     \"status\": status, \"code_count\": len(codes)})\n288\t        cards.append({\n289\t            \"key\": key, \"label\": s.get(\"label\") or key,\n290\t            \"status\": status, \"status_label\": STATUS_LABEL.get(status, status),\n291\t            \"status_chip_class\": STATUS_CHIP_CLASS.get(status, \"status-stale\"),\n292\t            \"codes\": codes, \"sessions\": row.get(\"sessions\"),\n293\t            \"first\": row.get(\"first\"), \"last\": row.get(\"last\"),\n294\t            \"components\": s.get(\"components\") or [],\n295\t            \"live_channels\": [_live_channel_info(ch) for ch in (s.get(\"live_channels\") or [])],\n296\t            \"maintenance_items\": [m.replace(\"_\", \" \") for m in (s.get(\"maintenance_items\") or [])],\n297\t            \"parts\": _system_parts(s.get(\"parts\") or []),\n298\t            \"depends_on\": [\n299\t                {**dep, \"confidence\": (dep.get(\"confidence\") or \"UNKNOWN\").upper(),\n300\t                 \"system_label\": labels.get(dep.get(\"system\"), dep.get(\"system\"))}\n301\t                for dep in (s.get(\"depends_on\") or [])\n302\t            ],\n303\t        })\n304\t\n305\t    edges = []\n306\t    for s in systems:\n307\t        for dep in s.get(\"depends_on\") or []:\n308\t            conf = (dep.get(\"confidence\") or \"UNKNOWN\").upper()\n309\t            edges.append({\"a\": s.get(\"key\"), \"b\": dep.get(\"system\"), \"confidence\": conf,\n310\t                         \"style\": CONFIDENCE_STYLE.get(conf, \"dotted\"),\n311\t                         \"why\": dep.get(\"why\"), \"source\": dep.get(\"source\")})\n312\t\n313\t    co_occurrence = [\n314\t        {**row, \"a_label\": labels.get(row.get(\"a\"), row.get(\"a\")),\n315\t         \"b_label\": labels.get(row.get(\"b\"), row.get(\"b\"))}\n316\t        for row in (corr.get(\"co_occurrence\") or [])\n317\t    ]\n318\t\n319\t    chains = []\n320\t    for ch in corr.get(\"chains\") or []:\n321\t        upstream = [{**u, \"system_label\": labels.get(u.get(\"system\"), u.get(\"system\"))}\n322\t                   for u in (ch.get(\"possible_upstream\") or [])]\n323\t        chains.append({**ch, \"possible_upstream\": upstream})\n324\t\n325\t    return {\n326\t        \"nodes\": nodes, \"edges\": edges, \"cards\": cards,\n327\t        \"co_occurrence\": co_occurrence, \"chains\": chains,\n328\t        \"findings\": corr.get(\"findings\") or [],\n329\t    }\n330\t\n331\t\n332\t# --- the page ---------------------------------------------------------------\n333\t\n334\t\n335\t@router.get(\"/v/{vin}/systems\", response_class=HTMLResponse)\n336\tdef systems_page(request: Request, vin: str) -> HTMLResponse:\n337\t    \"\"\"The dependency graph: which systems may sit upstream of which codes,\n338\t    and what this vehicle's own history does and does not corroborate.\"\"\"\n339\t    dossier = _dossier(vin)\n340\t    view = _build_view(vin)\n341\t    svg = systems_svg.render(view[\"nodes\"], view[\"edges\"])\n342\t    response = _page(request, \"systems.html\", vin=vin, bar=_vehicle_bar(vin, dossier),\n343\t                     tab=\"systems\", view=view, svg=svg)\n344\t    _set_active_vehicle(response, vin)\n345\t    return response\n346\t\n347\t\n348\t__all__ = [\"router\"]\n349\t"}]},"uuid":"9525b1ef-f2e6-4648-8420-541546414c2d","timestamp":"2026-10-08T11:45:23.771Z","toolUseResult":{"type":"text","file":{"filePath":"C:\\Users\\User\\mcp-servers\\cuore\\web\\systems_routes.py","content":"\"\"\"``GET /v/{vin}/systems``: the cross-system dependency view -- which\nsystems may sit upstream of a given code's family, and where this\nvehicle's own history corroborates that (or merely guesses at it).\n\nSame posture as :mod:`cuore.web.timeline_routes`/:mod:`cuore.web.\nparts_routes` (both built the same way, concurrently with other agents):\na separate router, reusing ``_dossier``/``_page``/``_set_active_vehicle``/\n``_vehicle_bar`` from :mod:`cuore.web.routes` by import rather than\nduplicating that plumbing.\n\nThe data contract lives in ``cuore.services.systems_bridge``\n(``systems()``, ``systems_for_code(code, description=\"\")``,\n``correlate(vin)``), built in parallel by another agent and not\nnecessarily present yet. Every call into it is wrapped and falls back to\na fixture built to the exact shape the contract specifies, so this page --\nand the ``_system_badge.html`` chips on ``code.html``/``vehicle.html``/\n``report.html`` -- are developable and testable before that module lands.\nOnce it exists, nothing here needs to change -- the lazy import just\nstarts succeeding.\n\nRegisters two Jinja globals the same way :mod:`cuore.web.timeline_routes`\nregisters ``code_feel`` and :mod:`cuore.web.parts_routes` registers\n``parts_for`` -- on both ``Jinja2Templates`` instances this feature's\npages use (``cuore.web.routes``'s, for ``code.html``/``vehicle.html``/\n``report.html``, and ``cuore.web.service_routes``'s, the same\ntwo-environments wrinkle :mod:`cuore.web.experience_globals` already\ndocuments and works around):\n\n* ``systems_for_code(code, description=\"\")`` -- the badge list for one code.\n* ``system_label(key)`` -- a system key's display label, for anywhere a\n  badge or table only has the bare key (falls back to a title-cased key\n  for one this page has never seen).\n\nNot registered on the app here -- ``app.py`` is owned by another agent\nwhile this was built. The two lines needed there (next to the other\n``web`` router imports/includes):\n\n    ``from .web import systems_routes``\n    ``app.include_router(systems_routes.router)``\n\"\"\"\n\nfrom __future__ import annotations\n\nimport importlib\nfrom typing import Any\n\nfrom fastapi import APIRouter, Depends, Request\nfrom fastapi.responses import HTMLResponse\n\nfrom ..api.deps import require_token\nfrom ..services import known_good_bridge, parts_bridge\nfrom . import systems_svg\nfrom .routes import _dossier, _page, _set_active_vehicle, _vehicle_bar\nfrom .routes import templates as _shared_templates\n\nrouter = APIRouter(include_in_schema=False, dependencies=[Depends(require_token)])\n\n#: depends_on confidence -> edge line style, the same three buckets\n#: systems_svg.py draws (solid covers both CONFIRMED and CORROBORATED).\nCONFIDENCE_STYLE: dict[str, str] = {\n    \"CONFIRMED\": \"solid\", \"CORROBORATED\": \"solid\",\n    \"SINGLE-SOURCE\": \"dashed\", \"UNKNOWN\": \"dotted\",\n}\n#: role/confidence combinations the badge treats as \"not yet nailed down\" --\n#: these get a trailing \"?\" on the badge rather than a second colour.\n_LOW_CONFIDENCE = {\"SINGLE-SOURCE\", \"UNKNOWN\"}\n\nSTATUS_LABEL = systems_svg.STATUS_TEXT\n#: status -> the existing status-chip CSS class (cuore.css already defines\n#: .chip.status-active/.status-cleared_unverified/.status-stale and the\n#: plain .chip.ok -- no new classes needed here). Vocabulary matches\n#: mes.systems.correlate() exactly: active/cleared_unverified/clean/stale.\nSTATUS_CHIP_CLASS = {\"active\": \"status-active\", \"cleared_unverified\": \"status-cleared_unverified\",\n                     \"clean\": \"ok\", \"stale\": \"status-stale\"}\n\n\n# --- fixture: the exact shape cuore.services.systems_bridge returns, built\n# directly against the real ``mes.systems`` contract (same keys, same\n# vocabulary -- \"electrical_supply\" not \"electrical\", status one of\n# active/cleared_unverified/clean/stale, live_channels/parts as plain known\n# good/parts keys, not inline dicts) so this fixture and the real module\n# are interchangeable to every consumer below. ----------------------------\n\ndef _fixture_systems() -> list[dict[str, Any]]:\n    return [\n        {\"key\": \"electrical_supply\", \"label\": \"Electrical supply\",\n         \"components\": [\"12V battery\", \"alternator\", \"chassis/engine grounds\", \"fuses\"],\n         \"live_channels\": [\"battery_voltage\"],\n         \"maintenance_items\": [\"battery_12v\"], \"parts\": [\"battery_12v\"], \"depends_on\": []},\n        {\"key\": \"network\", \"label\": \"Network / CAN buses\",\n         \"components\": [\"CAN-C\", \"CAN-IHS\", \"gateway modules\", \"BCM\"],\n         \"live_channels\": [], \"maintenance_items\": [], \"parts\": [],\n         \"depends_on\": [{\"system\": \"electrical_supply\",\n                          \"why\": \"BCM power feeds and chassis grounds are a documented root cause \"\n                                \"of multi-module U-code cascades, not per-module bus faults.\",\n                          \"confidence\": \"CONFIRMED\", \"source\": \"mes.knowledge bulletins\"}]},\n        {\"key\": \"evap\", \"label\": \"EVAP (evaporative emissions)\",\n         \"components\": [\"purge valve\", \"vent valve\", \"fuel cap\", \"NVLD\"],\n         \"live_channels\": [], \"maintenance_items\": [], \"parts\": [\"evap_purge_valve\"],\n         \"depends_on\": [{\"system\": \"electrical_supply\",\n                          \"why\": \"the purge valve solenoid is an ECM-commanded, power-fed actuator\",\n                          \"confidence\": \"SINGLE-SOURCE\", \"source\": \"mes.parts esim/purge_valve\"},\n                         {\"system\": \"fuel\",\n                          \"why\": \"EVAP shares the tank, fuel cap and fuel-level/pressure signal path \"\n                                \"with the fuel system\",\n                          \"confidence\": \"CORROBORATED\", \"source\": \"mes.code_feel EVAP section\"}]},\n        {\"key\": \"fuel\", \"label\": \"Fuel\", \"components\": [\"fuel pump\", \"fuel level sensor\"],\n         \"live_channels\": [], \"maintenance_items\": [], \"parts\": [], \"depends_on\": []},\n        {\"key\": \"brakes_abs\", \"label\": \"Brakes / ABS\", \"components\": [\"ABS module\", \"wheel speed sensors\"],\n         \"live_channels\": [], \"maintenance_items\": [], \"parts\": [],\n         \"depends_on\": [{\"system\": \"electrical_supply\", \"why\": \"speculative -- not yet corroborated on this car\",\n                          \"confidence\": \"UNKNOWN\", \"source\": \"none yet\"}]},\n    ]\n\n\ndef _fixture_systems_for_code(code: str, description: str = \"\") -> list[dict[str, Any]]:\n    c = (code or \"\").upper()\n    if c.startswith(\"P04\"):\n        return [{\"system\": \"evap\", \"role\": \"primary\", \"confidence\": \"CONFIRMED\", \"source\": \"DTC prefix table\"},\n                {\"system\": \"electrical_supply\", \"role\": \"upstream\", \"confidence\": \"SINGLE-SOURCE\",\n                 \"source\": \"systems depends_on graph\"},\n                {\"system\": \"fuel\", \"role\": \"upstream\", \"confidence\": \"CORROBORATED\",\n                 \"source\": \"systems depends_on graph\"}]\n    if c.startswith(\"U0\"):\n        return [{\"system\": \"network\", \"role\": \"primary\", \"confidence\": \"CORROBORATED\", \"source\": \"DTC prefix table\"},\n                {\"system\": \"electrical_supply\", \"role\": \"upstream\", \"confidence\": \"CONFIRMED\",\n                 \"source\": \"systems depends_on graph\"}]\n    if c.startswith(\"C\"):\n        return [{\"system\": \"brakes_abs\", \"role\": \"primary\", \"confidence\": \"CONFIRMED\", \"source\": \"DTC prefix table\"},\n                {\"system\": \"electrical_supply\", \"role\": \"upstream\", \"confidence\": \"UNKNOWN\",\n                 \"source\": \"systems depends_on graph\"}]\n    return []\n\n\ndef _fixture_correlate(vin: str) -> dict[str, Any]:\n    return {\n        \"by_system\": [\n            {\"system\": \"evap\", \"codes\": [\"P0440\", \"P0455\", \"P0456\"], \"sessions\": 11,\n             \"first\": \"2025-09-24\", \"last\": \"2026-08-27\", \"status\": \"cleared_unverified\"},\n            {\"system\": \"network\", \"codes\": [\"U0100\"], \"sessions\": 2,\n             \"first\": \"2026-01-15\", \"last\": \"2026-01-15\", \"status\": \"stale\"},\n            {\"system\": \"electrical_supply\", \"codes\": [], \"sessions\": 0, \"first\": None, \"last\": None,\n             \"status\": \"clean\"},\n            {\"system\": \"fuel\", \"codes\": [], \"sessions\": 0, \"first\": None, \"last\": None, \"status\": \"clean\"},\n            {\"system\": \"brakes_abs\", \"codes\": [], \"sessions\": 0, \"first\": None, \"last\": None, \"status\": \"stale\"},\n        ],\n        \"co_occurrence\": [\n            {\"a\": \"evap\", \"b\": \"electrical_supply\", \"sessions_together\": 0, \"sessions_a\": 11, \"sessions_b\": 0,\n             \"lift\": 1.0, \"reading\": \"no electrical-supply session on file yet to corroborate against\"},\n        ],\n        \"chains\": [\n            {\"issue\": \"EVAP leak codes (P0440/P0455/P0456) will not verify clean\",\n             \"possible_upstream\": [\n                 {\"system\": \"electrical_supply\", \"why\": \"purge valve solenoid control circuit\",\n                  \"evidence\": \"TSB 18-030-17 (ECM calibration) is the leading verdict for this car; \"\n                              \"no electrical fault has been corroborated on it yet\"},\n             ]},\n        ],\n        \"findings\": [\n            \"EVAP is the only system with an active/cleared-unverified code on this car -- every \"\n            \"other system is stale (no live or session data) rather than confirmed clean.\",\n        ],\n    }\n\n\ndef _bridge():\n    \"\"\"``cuore.services.systems_bridge``, or ``None`` if it has not landed.\"\"\"\n    try:\n        from ..services import systems_bridge\n        return systems_bridge\n    except ImportError:\n        return None\n\n\ndef _systems() -> list[dict[str, Any]]:\n    \"\"\"Normalises to a list either way: ``mes.systems.systems()`` actually\n    returns an ordered ``{key: record}`` dict (\"every vehicle system in\n    the graph, in reading order\" -- a Python dict preserves that just as\n    well as a list), while this fixture (and the contract as first\n    specified) uses a plain list. Every consumer below only ever wants\n    the list of records, so that's what this always hands back.\"\"\"\n    bridge = _bridge()\n    if bridge is None:\n        return _fixture_systems()\n    try:\n        raw = bridge.systems()\n    except Exception:  # noqa: BLE001 -- a knowledge-table miss must never 500 a page\n        return _fixture_systems()\n    if isinstance(raw, dict):\n        return list(raw.values())\n    return list(raw or [])\n\n\ndef _systems_for_code(code: str, description: str = \"\") -> list[dict[str, Any]]:\n    bridge = _bridge()\n    if bridge is None:\n        return _fixture_systems_for_code(code, description)\n    try:\n        return bridge.systems_for_code(code, description) or []\n    except Exception:  # noqa: BLE001\n        return []\n\n\ndef _correlate(vin: str) -> dict[str, Any]:\n    bridge = _bridge()\n    if bridge is None:\n        return _fixture_correlate(vin)\n    try:\n        return bridge.correlate(vin) or {}\n    except Exception:  # noqa: BLE001\n        return _fixture_correlate(vin)\n\n\ndef _live_channel_info(channel_id: str) -> dict[str, Any]:\n    \"\"\"One system's ``live_channels`` entry (a bare known-good channel key,\n    e.g. ``\"battery_voltage\"``) resolved to a display name and its\n    known-good band note, via :mod:`cuore.services.known_good_bridge` --\n    the same source ``cuore.live.layouts``' gauges read. Never raises: an\n    unresolvable or UNKNOWN-confidence channel still shows (by its id) with\n    a plain \"no sourced band yet\" note rather than vanishing or 500ing.\"\"\"\n    row, band = None, None\n    try:\n        row = known_good_bridge.known_good_for(channel_id)\n    except Exception:  # noqa: BLE001\n        pass\n    try:\n        band = known_good_bridge.sourced_band(channel_id)\n    except Exception:  # noqa: BLE001\n        pass\n    name = (row or {}).get(\"name\") or channel_id.replace(\"_\", \" \").title()\n    note = (band or {}).get(\"note\") or \"no sourced band yet\"\n    return {\"name\": name, \"band\": note}\n\n\ndef _system_parts(part_keys: list[str]) -> list[dict[str, Any]]:\n    \"\"\"One system's ``parts`` entry (a list of bare part keys, e.g.\n    ``\"battery_12v\"``) resolved to full part dicts via\n    :mod:`cuore.services.parts_bridge`, ready for ``_part_card.html``. A key\n    with nothing on file is dropped, not shown as an empty card.\"\"\"\n    out = []\n    for key in part_keys or []:\n        try:\n            p = parts_bridge.part(key)\n        except Exception:  # noqa: BLE001\n            p = None\n        if p:\n            out.append(p)\n    return out\n\n\ndef _system_label(key: str) -> str:\n    for s in _systems():\n        if s.get(\"key\") == key:\n            return s.get(\"label\") or key\n    return (key or \"\").replace(\"_\", \" \").title()\n\n\n_shared_templates.env.globals[\"systems_for_code\"] = _systems_for_code\n_shared_templates.env.globals[\"system_label\"] = _system_label\n\nfor _module_name in (\"service_routes\", \"drivetrain_routes\", \"timeline_routes\"):\n    try:\n        _mod = importlib.import_module(f\".{_module_name}\", __package__)\n        _tmpl = getattr(_mod, \"templates\", None) or getattr(_mod, \"_shared_templates\", None)\n        if _tmpl is not None and _tmpl is not _shared_templates:\n            _tmpl.env.globals[\"systems_for_code\"] = _systems_for_code\n            _tmpl.env.globals[\"system_label\"] = _system_label\n    except Exception:  # noqa: BLE001 -- import-time side effect, must never raise\n        pass\n\n\n# --- the page's view model --------------------------------------------------\n\ndef _build_view(vin: str) -> dict[str, Any]:\n    systems = _systems()\n    corr = _correlate(vin)\n    by_system = {r.get(\"system\"): r for r in (corr.get(\"by_system\") or [])}\n    labels = {s.get(\"key\"): s.get(\"label\") or s.get(\"key\") for s in systems}\n\n    nodes, cards = [], []\n    for s in systems:\n        key = s.get(\"key\")\n        row = by_system.get(key) or {}\n        status = row.get(\"status\") or \"stale\"\n        codes = row.get(\"codes\") or []\n        nodes.append({\"key\": key, \"label\": s.get(\"label\") or key,\n                     \"status\": status, \"code_count\": len(codes)})\n        cards.append({\n            \"key\": key, \"label\": s.get(\"label\") or key,\n            \"status\": status, \"status_label\": STATUS_LABEL.get(status, status),\n            \"status_chip_class\": STATUS_CHIP_CLASS.get(status, \"status-stale\"),\n            \"codes\": codes, \"sessions\": row.get(\"sessions\"),\n            \"first\": row.get(\"first\"), \"last\": row.get(\"last\"),\n            \"components\": s.get(\"components\") or [],\n            \"live_channels\": [_live_channel_info(ch) for ch in (s.get(\"live_channels\") or [])],\n            \"maintenance_items\": [m.replace(\"_\", \" \") for m in (s.get(\"maintenance_items\") or [])],\n            \"parts\": _system_parts(s.get(\"parts\") or []),\n            \"depends_on\": [\n                {**dep, \"confidence\": (dep.get(\"confidence\") or \"UNKNOWN\").upper(),\n                 \"system_label\": labels.get(dep.get(\"system\"), dep.get(\"system\"))}\n                for dep in (s.get(\"depends_on\") or [])\n            ],\n        })\n\n    edges = []\n    for s in systems:\n        for dep in s.get(\"depends_on\") or []:\n            conf = (dep.get(\"confidence\") or \"UNKNOWN\").upper()\n            edges.append({\"a\": s.get(\"key\"), \"b\": dep.get(\"system\"), \"confidence\": conf,\n                         \"style\": CONFIDENCE_STYLE.get(conf, \"dotted\"),\n                         \"why\": dep.get(\"why\"), \"source\": dep.get(\"source\")})\n\n    co_occurrence = [\n        {**row, \"a_label\": labels.get(row.get(\"a\"), row.get(\"a\")),\n         \"b_label\": labels.get(row.get(\"b\"), row.get(\"b\"))}\n        for row in (corr.get(\"co_occurrence\") or [])\n    ]\n\n    chains = []\n    for ch in corr.get(\"chains\") or []:\n        upstream = [{**u, \"system_label\": labels.get(u.get(\"system\"), u.get(\"system\"))}\n                   for u in (ch.get(\"possible_upstream\") or [])]\n        chains.append({**ch, \"possible_upstream\": upstream})\n\n    return {\n        \"nodes\": nodes, \"edges\": edges, \"cards\": cards,\n        \"co_occurrence\": co_occurrence, \"chains\": chains,\n        \"findings\": corr.get(\"findings\") or [],\n    }\n\n\n# --- the page ---------------------------------------------------------------\n\n\n@router.get(\"/v/{vin}/systems\", response_class=HTMLResponse)\ndef systems_page(request: Request, vin: str) -> HTMLResponse:\n    \"\"\"The dependency graph: which systems may sit upstream of which codes,\n    and what this vehicle's own history does and does not corroborate.\"\"\"\n    dossier = _dossier(vin)\n    view = _build_view(vin)\n    svg = systems_svg.render(view[\"nodes\"], view[\"edges\"])\n    response = _page(request, \"systems.html\", vin=vin, bar=_vehicle_bar(vin, dossier),\n                     tab=\"systems\", view=view, svg=svg)\n    _set_active_vehicle(response, vin)\n    return response\n\n\n__all__ = [\"router\"]\n","numLines":349,"startLine":1,"totalLines":349}},"sourceToolAssistantUUID":"7e2ce5cd-4789-4e9d-b03b-5fd67866ba30","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
{"parentUuid":"9525b1ef-f2e6-4648-8420-541546414c2d","isSidechain":true,"agentId":"a7730a69efb7861a9","message":{"model":"claude-sonnet-5","id":"msg_011CfpiL96maxNVAsJtDGv6X","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_011DfHiQVUaabjnyZauu4zRN","name":"Read","input":{"file_path":"C:\\Users\\User\\mcp-servers\\cuore\\web\\systems_svg.py"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":5313,"cache_read_input_tokens":57039,"cache_creation":{"ephemeral_5m_input_tokens":5313,"ephemeral_1h_input_tokens":0},"output_tokens":2,"service_tier":"standard","inference_geo":"not_available"},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_011DfHiQVUaabjnyZauu4zRN":{"file_path":"C:\\Users\\User\\mcp-servers\\cuore\\web\\systems_svg.py"}},"serverClassifierRequest":"9ed0e821-4ec7-4f6b-88da-dffe657851c3","apiBlockIndex":3,"requestId":"req_011CfpiL8rt1sPU77fgQPHPo","attributionAgent":"general-purpose","type":"assistant","uuid":"3b9d4be7-85e7-4872-8f11-509fbc7bf204","timestamp":"2026-10-08T11:45:23.886Z","effort":"high","perTurnEffort":null,"userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
{"parentUuid":"3b9d4be7-85e7-4872-8f11-509fbc7bf204","isSidechain":true,"promptId":"b7d5245f-77ce-48c1-8f3f-a89a5e1f4f71","agentId":"a7730a69efb7861a9","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_011DfHiQVUaabjnyZauu4zRN","type":"tool_result","content":"1\t\"\"\"Server-side inline SVG for the /v/{vin}/systems dependency graph.\n2\t\n3\tSame posture as :mod:`cuore.web.timeline_svg` (its docstring explains why):\n4\tno JS, no CDN, no charting library. Colour comes from the CSS custom\n5\tproperties already in ``cuore.css`` -- the same red/amber/green/grey\n6\tseverity ramp the rest of the app uses for a code's status chip -- so the\n7\tgraph reads correctly in both themes without this module knowing which is\n8\tactive.\n9\t\n10\tVisual grammar (restated in the page's own legend, so nothing here is\n11\tcolour-only):\n12\t\n13\t* Node fill/stroke = that system's status, from ``correlate()``'s\n14\t  ``by_system`` rows: red active, amber cleared-but-unverified, green\n15\t  verified clean, grey stale/no data.\n16\t* Node badge = that system's open code count (a small filled circle with\n17\t  a number), omitted when zero.\n18\t* Edge *line style* carries ``depends_on`` confidence, never colour:\n19\t  solid for CONFIRMED/CORROBORATED, dashed for SINGLE-SOURCE, dotted for\n20\t  UNKNOWN. An arrowhead marks the direction (A depends on B).\n21\t* Every node and every edge carries its own ``<title>`` (hover/long-press\n22\t  text), so nothing here is readable only by colour, dash pattern or\n23\t  position.\n24\t* Nodes are plain ``<a href=\"#sys-{key}\">`` wraps -- \"tapping\" one is just\n25\t  an in-page anchor jump to its card below, no JS required.\n26\t\n27\tLayout is a small fixed grid keyed by the systems this app already knows\n28\tabout (see ``_GRID``), not force-directed -- stable across reloads and\n29\tcheap to reason about. Any system key this module has never seen (a\n30\t``systems_bridge`` taxonomy change) is placed in an overflow row below the\n31\tknown grid rather than breaking the page.\n32\t\"\"\"\n33\t\n34\tfrom __future__ import annotations\n35\t\n36\tfrom typing import Any\n37\tfrom xml.sax.saxutils import escape as _esc\n38\t\n39\t_SVG_NS = 'xmlns=\"http://www.w3.org/2000/svg\"'\n40\t\n41\tNODE_W, NODE_H = 118, 46\n42\t_COL_W, _ROW_H = 160, 80\n43\t_MARGIN = 24\n44\t\n45\t#: Hand-placed (col, row) for the systems most commonly implicated (the\n46\t#: ones with ``depends_on`` edges and/or real DTC history on this app's\n47\t#: test vehicle). Mes.systems' full taxonomy runs to 16 systems -- anything\n48\t#: not named here lands in a wrapped overflow grid -- see ``_positions``.\n49\t_GRID: dict[str, tuple[int, int]] = {\n50\t    \"electrical_supply\": (0, 0),\n51\t    \"network\":           (1, 0),\n52\t    \"fuel\":              (2, 0),\n53\t    \"evap\":              (3, 0),\n54\t    \"ignition\":          (0, 1),\n55\t    \"brakes_abs\":        (1, 1),\n56\t    \"body_comfort\":      (2, 1),\n57\t    \"adas_sensors\":      (3, 1),\n58\t}\n59\t#: Overflow rows (any system key outside ``_GRID``) wrap at this many\n60\t#: columns instead of running one unbroken row.\n61\t_OVERFLOW_COLS = 4\n62\t\n63\t#: Status vocabulary exactly as ``mes.systems.correlate()`` emits it.\n64\tSTATUS_COLOR: dict[str, str] = {\n65\t    \"active\":            \"var(--sev-returned)\",\n66\t    \"cleared_unverified\": \"var(--sev-chronic)\",\n67\t    \"clean\":             \"var(--ok)\",\n68\t    \"stale\":             \"var(--ink-3)\",\n69\t}\n70\t_STATUS_BG: dict[str, str] = {\n71\t    \"active\":            \"var(--sev-returned-bg)\",\n72\t    \"cleared_unverified\": \"var(--sev-chronic-bg)\",\n73\t    \"clean\":             \"var(--ok-bg)\",\n74\t    \"stale\":             \"var(--surface-2)\",\n75\t}\n76\tSTATUS_TEXT: dict[str, str] = {\n77\t    \"active\": \"active\", \"cleared_unverified\": \"cleared, unverified\",\n78\t    \"clean\": \"verified clean\", \"stale\": \"stale / no data\",\n79\t}\n80\t#: depends_on confidence -> (dash pattern, legend label). CONFIRMED and\n81\t#: CORROBORATED both read as a plain solid line -- the distinction between\n82\t#: them is explained in each edge's own <title> and the card text, not the\n83\t#: line itself (there are only three line *styles* to go around).\n84\t_DASH: dict[str, str] = {\"SINGLE-SOURCE\": \"8,5\", \"UNKNOWN\": \"2,4\"}\n85\tCONFIDENCE_TEXT: dict[str, str] = {\n86\t    \"CONFIRMED\": \"confirmed\", \"CORROBORATED\": \"corroborated\",\n87\t    \"SINGLE-SOURCE\": \"single source\", \"UNKNOWN\": \"unverified / unknown\",\n88\t}\n89\t\n90\t\n91\tdef _no_data_svg(message: str = \"No systems data yet.\") -> str:\n92\t    w, h = 400, 70\n93\t    return (\n94\t        f'<svg {_SVG_NS} viewBox=\"0 0 {w} {h}\" width=\"100%\" role=\"img\" '\n95\t        f'aria-label=\"System dependency graph: {_esc(message)}\">'\n96\t        f'<title>System dependency graph</title>'\n97\t        f'<text x=\"{w/2}\" y=\"{h/2}\" text-anchor=\"middle\" dominant-baseline=\"middle\" '\n98\t        f'fill=\"var(--ink-3)\" font-size=\"13\" font-family=\"var(--sans), sans-serif\">'\n99\t        f'{_esc(message)}</text></svg>'\n100\t    )\n101\t\n102\t\n103\tdef _positions(keys: list[str]) -> dict[str, tuple[float, float]]:\n104\t    pos: dict[str, tuple[float, float]] = {}\n105\t    max_row = max((r for _, r in _GRID.values()), default=-1)\n106\t    overflow_i = 0\n107\t    for key in keys:\n108\t        if key in _GRID:\n109\t            col, row = _GRID[key]\n110\t        else:\n111\t            col = overflow_i % _OVERFLOW_COLS\n112\t            row = max_row + 1 + overflow_i // _OVERFLOW_COLS\n113\t            overflow_i += 1\n114\t        pos[key] = (_MARGIN + col * _COL_W + NODE_W / 2, _MARGIN + row * _ROW_H + NODE_H / 2)\n115\t    return pos\n116\t\n117\t\n118\tdef render(nodes: list[dict[str, Any]], edges: list[dict[str, Any]]) -> str:\n119\t    \"\"\"``nodes``: ``[{key, label, status, code_count}]``.\n120\t    ``edges``: ``[{a, b, confidence, why}]`` meaning *a depends_on b*.\"\"\"\n121\t    if not nodes:\n122\t        return _no_data_svg()\n123\t    keys = [n[\"key\"] for n in nodes if n.get(\"key\")]\n124\t    pos = _positions(keys)\n125\t    if not pos:\n126\t        return _no_data_svg()\n127\t    xs, ys = [p[0] for p in pos.values()], [p[1] for p in pos.values()]\n128\t    width = int(max(xs) + NODE_W / 2 + _MARGIN)\n129\t    height = int(max(ys) + NODE_H / 2 + _MARGIN)\n130\t    by_key = {n[\"key\"]: n for n in nodes}\n131\t\n132\t    parts: list[str] = [\n133\t        f'<svg {_SVG_NS} viewBox=\"0 0 {width} {height}\" width=\"{width}\" height=\"{height}\" '\n134\t        f'role=\"img\" aria-label=\"System dependency graph, {len(nodes)} systems\">',\n135\t        '<title>System dependency graph</title>',\n136\t        '<defs><marker id=\"sys-arrow\" markerWidth=\"8\" markerHeight=\"8\" refX=\"7\" refY=\"4\" '\n137\t        'orient=\"auto\"><path d=\"M0,0 L8,4 L0,8 z\" fill=\"var(--ink-3)\"/></marker></defs>',\n138\t    ]\n139\t\n140\t    for e in edges:\n141\t        a, b = e.get(\"a\"), e.get(\"b\")\n142\t        if a not in pos or b not in pos:\n143\t            continue\n144\t        x1, y1 = pos[a]\n145\t        x2, y2 = pos[b]\n146\t        conf = (e.get(\"confidence\") or \"UNKNOWN\").upper()\n147\t        dash = _DASH.get(conf)\n148\t        dash_attr = f' stroke-dasharray=\"{dash}\"' if dash else \"\"\n149\t        a_label = by_key.get(a, {}).get(\"label\", a)\n150\t        b_label = by_key.get(b, {}).get(\"label\", b)\n151\t        title = f\"{a_label} depends on {b_label} ({CONFIDENCE_TEXT.get(conf, conf.lower())})\"\n152\t        if e.get(\"why\"):\n153\t            title += f\": {e['why']}\"\n154\t        # Trim the line endpoints back off the node rectangles a little so\n155\t        # the arrowhead does not sit buried under the next node's fill.\n156\t        dx, dy = x2 - x1, y2 - y1\n157\t        dist = max(1.0, (dx * dx + dy * dy) ** 0.5)\n158\t        trim = NODE_W / 2 + 4\n159\t        x1t, y1t = x1 + dx / dist * trim, y1 + dy / dist * trim\n160\t        x2t, y2t = x2 - dx / dist * trim, y2 - dy / dist * trim\n161\t        parts.append(\n162\t            f'<g><line x1=\"{x1t:.1f}\" y1=\"{y1t:.1f}\" x2=\"{x2t:.1f}\" y2=\"{y2t:.1f}\" '\n163\t            f'stroke=\"var(--ink-3)\" stroke-width=\"1.6\"{dash_attr} marker-end=\"url(#sys-arrow)\"/>'\n164\t            f'<title>{_esc(title)}</title></g>')\n165\t\n166\t    for n in nodes:\n167\t        key = n.get(\"key\")\n168\t        if key not in pos:\n169\t            continue\n170\t        x, y = pos[key]\n171\t        status = n.get(\"status\") or \"stale\"\n172\t        fill = _STATUS_BG.get(status, \"var(--surface-2)\")\n173\t        stroke = STATUS_COLOR.get(status, \"var(--ink-3)\")\n174\t        count = n.get(\"code_count\") or 0\n175\t        label = n.get(\"label\") or key\n176\t        title = f\"{label} -- {STATUS_TEXT.get(status, status)}, {count} code(s)\"\n177\t        inner = (\n178\t            f'<rect x=\"{x - NODE_W/2:.1f}\" y=\"{y - NODE_H/2:.1f}\" width=\"{NODE_W}\" height=\"{NODE_H}\" '\n179\t            f'rx=\"10\" fill=\"{fill}\" stroke=\"{stroke}\" stroke-width=\"2\"/>'\n180\t            f'<text x=\"{x:.1f}\" y=\"{y + 4:.1f}\" text-anchor=\"middle\" font-size=\"11.5\" '\n181\t            f'fill=\"var(--ink)\" font-family=\"var(--sans), sans-serif\">{_esc(label)}</text>')\n182\t        if count:\n183\t            bx, by = x + NODE_W / 2 - 10, y - NODE_H / 2 + 10\n184\t            inner += (f'<circle cx=\"{bx:.1f}\" cy=\"{by:.1f}\" r=\"9\" fill=\"{stroke}\"/>'\n185\t                      f'<text x=\"{bx:.1f}\" y=\"{by + 3.2:.1f}\" text-anchor=\"middle\" '\n186\t                      f'font-size=\"10\" fill=\"var(--surface)\" font-family=\"var(--mono), monospace\">{count}</text>')\n187\t        parts.append(f'<a href=\"#sys-{_esc(key)}\"><g>{inner}<title>{_esc(title)}</title></g></a>')\n188\t\n189\t    parts.append(\"</svg>\")\n190\t    return \"\".join(parts)\n191\t\n192\t\n193\t__all__ = [\"render\", \"STATUS_COLOR\", \"STATUS_TEXT\", \"CONFIDENCE_TEXT\"]\n194\t"}]},"uuid":"9cf0afbf-5278-4824-94c0-11e01e417649","timestamp":"2026-10-08T11:45:23.907Z","toolUseResult":{"type":"text","file":{"filePath":"C:\\Users\\User\\mcp-servers\\cuore\\web\\systems_svg.py","content":"\"\"\"Server-side inline SVG for the /v/{vin}/systems dependency graph.\n\nSame posture as :mod:`cuore.web.timeline_svg` (its docstring explains why):\nno JS, no CDN, no charting library. Colour comes from the CSS custom\nproperties already in ``cuore.css`` -- the same red/amber/green/grey\nseverity ramp the rest of the app uses for a code's status chip -- so the\ngraph reads correctly in both themes without this module knowing which is\nactive.\n\nVisual grammar (restated in the page's own legend, so nothing here is\ncolour-only):\n\n* Node fill/stroke = that system's status, from ``correlate()``'s\n  ``by_system`` rows: red active, amber cleared-but-unverified, green\n  verified clean, grey stale/no data.\n* Node badge = that system's open code count (a small filled circle with\n  a number), omitted when zero.\n* Edge *line style* carries ``depends_on`` confidence, never colour:\n  solid for CONFIRMED/CORROBORATED, dashed for SINGLE-SOURCE, dotted for\n  UNKNOWN. An arrowhead marks the direction (A depends on B).\n* Every node and every edge carries its own ``<title>`` (hover/long-press\n  text), so nothing here is readable only by colour, dash pattern or\n  position.\n* Nodes are plain ``<a href=\"#sys-{key}\">`` wraps -- \"tapping\" one is just\n  an in-page anchor jump to its card below, no JS required.\n\nLayout is a small fixed grid keyed by the systems this app already knows\nabout (see ``_GRID``), not force-directed -- stable across reloads and\ncheap to reason about. Any system key this module has never seen (a\n``systems_bridge`` taxonomy change) is placed in an overflow row below the\nknown grid rather than breaking the page.\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom typing import Any\nfrom xml.sax.saxutils import escape as _esc\n\n_SVG_NS = 'xmlns=\"http://www.w3.org/2000/svg\"'\n\nNODE_W, NODE_H = 118, 46\n_COL_W, _ROW_H = 160, 80\n_MARGIN = 24\n\n#: Hand-placed (col, row) for the systems most commonly implicated (the\n#: ones with ``depends_on`` edges and/or real DTC history on this app's\n#: test vehicle). Mes.systems' full taxonomy runs to 16 systems -- anything\n#: not named here lands in a wrapped overflow grid -- see ``_positions``.\n_GRID: dict[str, tuple[int, int]] = {\n    \"electrical_supply\": (0, 0),\n    \"network\":           (1, 0),\n    \"fuel\":              (2, 0),\n    \"evap\":              (3, 0),\n    \"ignition\":          (0, 1),\n    \"brakes_abs\":        (1, 1),\n    \"body_comfort\":      (2, 1),\n    \"adas_sensors\":      (3, 1),\n}\n#: Overflow rows (any system key outside ``_GRID``) wrap at this many\n#: columns instead of running one unbroken row.\n_OVERFLOW_COLS = 4\n\n#: Status vocabulary exactly as ``mes.systems.correlate()`` emits it.\nSTATUS_COLOR: dict[str, str] = {\n    \"active\":            \"var(--sev-returned)\",\n    \"cleared_unverified\": \"var(--sev-chronic)\",\n    \"clean\":             \"var(--ok)\",\n    \"stale\":             \"var(--ink-3)\",\n}\n_STATUS_BG: dict[str, str] = {\n    \"active\":            \"var(--sev-returned-bg)\",\n    \"cleared_unverified\": \"var(--sev-chronic-bg)\",\n    \"clean\":             \"var(--ok-bg)\",\n    \"stale\":             \"var(--surface-2)\",\n}\nSTATUS_TEXT: dict[str, str] = {\n    \"active\": \"active\", \"cleared_unverified\": \"cleared, unverified\",\n    \"clean\": \"verified clean\", \"stale\": \"stale / no data\",\n}\n#: depends_on confidence -> (dash pattern, legend label). CONFIRMED and\n#: CORROBORATED both read as a plain solid line -- the distinction between\n#: them is explained in each edge's own <title> and the card text, not the\n#: line itself (there are only three line *styles* to go around).\n_DASH: dict[str, str] = {\"SINGLE-SOURCE\": \"8,5\", \"UNKNOWN\": \"2,4\"}\nCONFIDENCE_TEXT: dict[str, str] = {\n    \"CONFIRMED\": \"confirmed\", \"CORROBORATED\": \"corroborated\",\n    \"SINGLE-SOURCE\": \"single source\", \"UNKNOWN\": \"unverified / unknown\",\n}\n\n\ndef _no_data_svg(message: str = \"No systems data yet.\") -> str:\n    w, h = 400, 70\n    return (\n        f'<svg {_SVG_NS} viewBox=\"0 0 {w} {h}\" width=\"100%\" role=\"img\" '\n        f'aria-label=\"System dependency graph: {_esc(message)}\">'\n        f'<title>System dependency graph</title>'\n        f'<text x=\"{w/2}\" y=\"{h/2}\" text-anchor=\"middle\" dominant-baseline=\"middle\" '\n        f'fill=\"var(--ink-3)\" font-size=\"13\" font-family=\"var(--sans), sans-serif\">'\n        f'{_esc(message)}</text></svg>'\n    )\n\n\ndef _positions(keys: list[str]) -> dict[str, tuple[float, float]]:\n    pos: dict[str, tuple[float, float]] = {}\n    max_row = max((r for _, r in _GRID.values()), default=-1)\n    overflow_i = 0\n    for key in keys:\n        if key in _GRID:\n            col, row = _GRID[key]\n        else:\n            col = overflow_i % _OVERFLOW_COLS\n            row = max_row + 1 + overflow_i // _OVERFLOW_COLS\n            overflow_i += 1\n        pos[key] = (_MARGIN + col * _COL_W + NODE_W / 2, _MARGIN + row * _ROW_H + NODE_H / 2)\n    return pos\n\n\ndef render(nodes: list[dict[str, Any]], edges: list[dict[str, Any]]) -> str:\n    \"\"\"``nodes``: ``[{key, label, status, code_count}]``.\n    ``edges``: ``[{a, b, confidence, why}]`` meaning *a depends_on b*.\"\"\"\n    if not nodes:\n        return _no_data_svg()\n    keys = [n[\"key\"] for n in nodes if n.get(\"key\")]\n    pos = _positions(keys)\n    if not pos:\n        return _no_data_svg()\n    xs, ys = [p[0] for p in pos.values()], [p[1] for p in pos.values()]\n    width = int(max(xs) + NODE_W / 2 + _MARGIN)\n    height = int(max(ys) + NODE_H / 2 + _MARGIN)\n    by_key = {n[\"key\"]: n for n in nodes}\n\n    parts: list[str] = [\n        f'<svg {_SVG_NS} viewBox=\"0 0 {width} {height}\" width=\"{width}\" height=\"{height}\" '\n        f'role=\"img\" aria-label=\"System dependency graph, {len(nodes)} systems\">',\n        '<title>System dependency graph</title>',\n        '<defs><marker id=\"sys-arrow\" markerWidth=\"8\" markerHeight=\"8\" refX=\"7\" refY=\"4\" '\n        'orient=\"auto\"><path d=\"M0,0 L8,4 L0,8 z\" fill=\"var(--ink-3)\"/></marker></defs>',\n    ]\n\n    for e in edges:\n        a, b = e.get(\"a\"), e.get(\"b\")\n        if a not in pos or b not in pos:\n            continue\n        x1, y1 = pos[a]\n        x2, y2 = pos[b]\n        conf = (e.get(\"confidence\") or \"UNKNOWN\").upper()\n        dash = _DASH.get(conf)\n        dash_attr = f' stroke-dasharray=\"{dash}\"' if dash else \"\"\n        a_label = by_key.get(a, {}).get(\"label\", a)\n        b_label = by_key.get(b, {}).get(\"label\", b)\n        title = f\"{a_label} depends on {b_label} ({CONFIDENCE_TEXT.get(conf, conf.lower())})\"\n        if e.get(\"why\"):\n            title += f\": {e['why']}\"\n        # Trim the line endpoints back off the node rectangles a little so\n        # the arrowhead does not sit buried under the next node's fill.\n        dx, dy = x2 - x1, y2 - y1\n        dist = max(1.0, (dx * dx + dy * dy) ** 0.5)\n        trim = NODE_W / 2 + 4\n        x1t, y1t = x1 + dx / dist * trim, y1 + dy / dist * trim\n        x2t, y2t = x2 - dx / dist * trim, y2 - dy / dist * trim\n        parts.append(\n            f'<g><line x1=\"{x1t:.1f}\" y1=\"{y1t:.1f}\" x2=\"{x2t:.1f}\" y2=\"{y2t:.1f}\" '\n            f'stroke=\"var(--ink-3)\" stroke-width=\"1.6\"{dash_attr} marker-end=\"url(#sys-arrow)\"/>'\n            f'<title>{_esc(title)}</title></g>')\n\n    for n in nodes:\n        key = n.get(\"key\")\n        if key not in pos:\n            continue\n        x, y = pos[key]\n        status = n.get(\"status\") or \"stale\"\n        fill = _STATUS_BG.get(status, \"var(--surface-2)\")\n        stroke = STATUS_COLOR.get(status, \"var(--ink-3)\")\n        count = n.get(\"code_count\") or 0\n        label = n.get(\"label\") or key\n        title = f\"{label} -- {STATUS_TEXT.get(status, status)}, {count} code(s)\"\n        inner = (\n            f'<rect x=\"{x - NODE_W/2:.1f}\" y=\"{y - NODE_H/2:.1f}\" width=\"{NODE_W}\" height=\"{NODE_H}\" '\n            f'rx=\"10\" fill=\"{fill}\" stroke=\"{stroke}\" stroke-width=\"2\"/>'\n            f'<text x=\"{x:.1f}\" y=\"{y + 4:.1f}\" text-anchor=\"middle\" font-size=\"11.5\" '\n            f'fill=\"var(--ink)\" font-family=\"var(--sans), sans-serif\">{_esc(label)}</text>')\n        if count:\n            bx, by = x + NODE_W / 2 - 10, y - NODE_H / 2 + 10\n            inner += (f'<circle cx=\"{bx:.1f}\" cy=\"{by:.1f}\" r=\"9\" fill=\"{stroke}\"/>'\n                      f'<text x=\"{bx:.1f}\" y=\"{by + 3.2:.1f}\" text-anchor=\"middle\" '\n                      f'font-size=\"10\" fill=\"var(--surface)\" font-family=\"var(--mono), monospace\">{count}</text>')\n        parts.append(f'<a href=\"#sys-{_esc(key)}\"><g>{inner}<title>{_esc(title)}</title></g></a>')\n\n    parts.append(\"</svg>\")\n    return \"\".join(parts)\n\n\n__all__ = [\"render\", \"STATUS_COLOR\", \"STATUS_TEXT\", \"CONFIDENCE_TEXT\"]\n","numLines":194,"startLine":1,"totalLines":194}},"sourceToolAssistantUUID":"3b9d4be7-85e7-4872-8f11-509fbc7bf204","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
{"parentUuid":"9cf0afbf-5278-4824-94c0-11e01e417649","isSidechain":true,"agentId":"a7730a69efb7861a9","message":{"model":"claude-sonnet-5","id":"msg_011CfpiL96maxNVAsJtDGv6X","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01Ut6CADUMeWZQsZxaHAMfw2","name":"Read","input":{"file_path":"C:\\Users\\User\\mcp-servers\\mes-log-mcp\\tests\\check_systems.py"},"caller":{"type":"direct"}}],"container":null,"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":5313,"cache_read_input_tokens":57039,"output_tokens":381,"output_tokens_details":{"thinking_tokens":81},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":0,"ephemeral_5m_input_tokens":5313},"inference_geo":"not_available","iterations":[{"input_tokens":2,"output_tokens":381,"cache_read_input_tokens":57039,"cache_creation_input_tokens":5313,"cache_creation":{"ephemeral_5m_input_tokens":5313,"ephemeral_1h_input_tokens":0},"type":"message"}],"speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_01Ut6CADUMeWZQsZxaHAMfw2":{"file_path":"C:\\Users\\User\\mcp-servers\\mes-log-mcp\\tests\\check_systems.py"}},"serverClassifierRequest":"9ed0e821-4ec7-4f6b-88da-dffe657851c3","apiBlockIndex":4,"requestId":"req_011CfpiL8rt1sPU77fgQPHPo","attributionAgent":"general-purpose","type":"assistant","uuid":"4db5f9f0-9d68-4a6a-a2cd-3aa319adb9b8","timestamp":"2026-10-08T11:45:24.327Z","effort":"high","perTurnEffort":null,"userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
{"parentUuid":"4db5f9f0-9d68-4a6a-a2cd-3aa319adb9b8","isSidechain":true,"promptId":"b7d5245f-77ce-48c1-8f3f-a89a5e1f4f71","agentId":"a7730a69efb7861a9","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Ut6CADUMeWZQsZxaHAMfw2","type":"tool_result","content":"1\t\"\"\"Smoke checks for mes.systems: the vehicle-systems graph, code -> system\n2\tassignment, and the real-corpus correlation.\n3\t\n4\tRun:\n5\t    .venv/Scripts/python.exe mes-log-mcp/tests/check_systems.py\n6\t\"\"\"\n7\t\n8\tfrom __future__ import annotations\n9\t\n10\timport sys\n11\tfrom pathlib import Path\n12\t\n13\t_MES_ROOT = Path(__file__).resolve().parents[1]\n14\t_REPO_ROOT = _MES_ROOT.parent\n15\tsys.path.insert(0, str(_MES_ROOT))\n16\tsys.path.insert(0, str(_REPO_ROOT))\n17\t\n18\tfrom mes import systems  # noqa: E402\n19\t\n20\tVIN = \"ZASFAKPN5J7B88115\"  # the Stelvio this toolchain already knows about\n21\t\n22\tfailures: list[str] = []\n23\tchecks = 0\n24\t\n25\t\n26\tdef check(label: str, condition: bool, detail: str = \"\") -> None:\n27\t    global checks\n28\t    checks += 1\n29\t    mark = \"ok\" if condition else \"FAIL\"\n30\t    print(f\"  [{mark}] {label}\" + (f\" -- {detail}\" if detail and not condition else \"\"))\n31\t    if not condition:\n32\t        failures.append(label)\n33\t\n34\t\n35\tprint(\"=== every depends_on edge is sourced or UNKNOWN ===\")\n36\tfor sys_key, row in systems.SYSTEMS.items():\n37\t    for dep in row[\"depends_on\"]:\n38\t        has_source = bool(dep.get(\"source\"))\n39\t        check(f\"{sys_key} -> {dep['system']} has a source\",\n40\t              has_source, str(dep))\n41\t        if dep[\"confidence\"] == systems.UNKNOWN:\n42\t            check(f\"{sys_key} -> {dep['system']} UNKNOWN carries the standard note\",\n43\t                  \"TechAuthority\" in dep[\"source\"] or \"not established\" in dep[\"source\"],\n44\t                  dep[\"source\"])\n45\t        else:\n46\t            check(f\"{sys_key} -> {dep['system']} non-UNKNOWN is not the placeholder note\",\n47\t                  dep[\"source\"] != systems._UNKNOWN_NOTE, dep[\"source\"])\n48\t\n49\tprint(\"=== systems() ===\")\n50\tall_systems = systems.systems()\n51\tcheck(\"25 systems in the graph\", len(all_systems) == 25, str(len(all_systems)))\n52\tcheck(\"every system has at least one component\",\n53\t      all(row[\"components\"] for row in all_systems.values()))\n54\t\n55\tprint(\"=== pcv (new system) ===\")\n56\tpcv_deps = systems.SYSTEMS[\"pcv\"][\"depends_on\"]\n57\tcheck(\"pcv exists with a sourced or UNKNOWN depends_on\",\n58\t      bool(pcv_deps) and all(bool(d.get(\"source\")) for d in pcv_deps),\n59\t      str(pcv_deps))\n60\t\n61\tcrankcase_code = systems.systems_for_code(\"P1C44\", \"Crankcase ventilation valve stuck open\")\n62\tcheck(\"a 'crankcase' description routes to pcv\",\n63\t      any(e[\"system\"] == \"pcv\" for e in crankcase_code), crankcase_code)\n64\t\n65\tprint(\"=== systems_for_code ===\")\n66\tp0455 = systems.systems_for_code(\"P0455\")\n67\tcheck(\"P0455 has an evap primary row\",\n68\t      any(e[\"system\"] == \"evap\" and e[\"role\"] == \"primary\" for e in p0455), p0455)\n69\tcheck(\"P0455 has electrical_supply upstream\",\n70\t      any(e[\"system\"] == \"electrical_supply\" and e[\"role\"] == \"upstream\" for e in p0455),\n71\t      p0455)\n72\tcheck(\"P0455 has fuel upstream\",\n73\t      any(e[\"system\"] == \"fuel\" and e[\"role\"] == \"upstream\" for e in p0455), p0455)\n74\t\n75\tp0455_suffix = systems.systems_for_code(\"P0455-00\")\n76\tcheck(\"failure byte ignored (P0455-00 same as P0455)\",\n77\t      {(e[\"system\"], e[\"role\"]) for e in p0455_suffix} ==\n78\t      {(e[\"system\"], e[\"role\"]) for e in p0455}, p0455_suffix)\n79\t\n80\tu1713 = systems.systems_for_code(\"U1713\")\n81\tcheck(\"U1713 -> network\", any(e[\"system\"] == \"network\" for e in u1713), u1713)\n82\t\n83\tmisfire = systems.systems_for_code(\"P0302\")\n84\tcheck(\"P0302 misfire -> ignition + fuel primaries\",\n85\t      {\"ignition\", \"fuel\"} <= {e[\"system\"] for e in misfire if e[\"role\"] == \"primary\"},\n86\t      misfire)\n87\t\n88\tunknown_code = systems.systems_for_code(\"P9999\")\n89\tcheck(\"an unrouteable code returns one honest UNKNOWN row\",\n90\t      unknown_code == [{\"system\": \"UNKNOWN\", \"role\": \"primary\",\n91\t                        \"confidence\": systems.UNKNOWN,\n92\t                        \"source\": systems._UNKNOWN_NOTE}],\n93\t      unknown_code)\n94\t\n95\tp1_keyword = systems.systems_for_code(\"P1C00\", \"EVAP purge control circuit malfunction\")\n96\tcheck(\"P1xxx keyword match (evap) when no exact entry exists\",\n97\t      any(e[\"system\"] == \"evap\" for e in p1_keyword), p1_keyword)\n98\t\n99\tprint(\"=== correlate (real corpus) ===\")\n100\tresult = systems.correlate(VIN)\n101\tcheck(\"no error for the known VIN\", \"error\" not in result, str(result))\n102\tby_system = {row[\"system\"]: row for row in result.get(\"by_system\", [])}\n103\tcheck(\"by_system covers every system key\",\n104\t      set(by_system) == set(systems.SYSTEMS), str(set(by_system)))\n105\tcheck(\"evap present with >= 4 sessions\",\n106\t      by_system.get(\"evap\", {}).get(\"sessions\", 0) >= 4,\n107\t      str(by_system.get(\"evap\")))\n108\tcheck(\"network present with >= 4 sessions\",\n109\t      by_system.get(\"network\", {}).get(\"sessions\", 0) >= 4,\n110\t      str(by_system.get(\"network\")))\n111\tcheck(\"at least one co-occurrence row\",\n112\t      len(result.get(\"co_occurrence\", [])) >= 1, str(result.get(\"co_occurrence\")))\n113\tcheck(\"co-occurrence rows only for pairs sharing >= 2 sessions\",\n114\t      all(row[\"sessions_together\"] >= 2 for row in result.get(\"co_occurrence\", [])))\n115\tcheck(\"findings is a non-empty list of strings\",\n116\t      bool(result.get(\"findings\")) and all(isinstance(f, str) for f in result[\"findings\"]))\n117\t_label_to_key = {v[\"label\"]: k for k, v in systems.SYSTEMS.items()}\n118\tcheck(\"chains only built for systems with sessions > 0\",\n119\t      all(by_system[_label_to_key[c[\"issue\"].rsplit(\" codes\", 1)[0]]][\"sessions\"] > 0\n120\t          for c in result.get(\"chains\", [])))\n121\t\n122\tunknown_vin = systems.correlate(\"NOPE123NOTREAL0000\")\n123\tcheck(\"unknown VIN is an error, not an empty graph\", \"error\" in unknown_vin, str(unknown_vin))\n124\t\n125\tprint()\n126\tif failures:\n127\t    print(f\"{len(failures)} FAILURES: {failures}\")\n128\t    sys.exit(1)\n129\tprint(f\"all {checks} checks passed\")\n130\t"}]},"uuid":"cafcf2dc-9ad5-4f8f-aa76-14930a8dc8c8","timestamp":"2026-10-08T11:45:24.356Z","toolUseResult":{"type":"text","file":{"filePath":"C:\\Users\\User\\mcp-servers\\mes-log-mcp\\tests\\check_systems.py","content":"\"\"\"Smoke checks for mes.systems: the vehicle-systems graph, code -> system\nassignment, and the real-corpus correlation.\n\nRun:\n    .venv/Scripts/python.exe mes-log-mcp/tests/check_systems.py\n\"\"\"\n\nfrom __future__ import annotations\n\nimport sys\nfrom pathlib import Path\n\n_MES_ROOT = Path(__file__).resolve().parents[1]\n_REPO_ROOT = _MES_ROOT.parent\nsys.path.insert(0, str(_MES_ROOT))\nsys.path.insert(0, str(_REPO_ROOT))\n\nfrom mes import systems  # noqa: E402\n\nVIN = \"ZASFAKPN5J7B88115\"  # the Stelvio this toolchain already knows about\n\nfailures: list[str] = []\nchecks = 0\n\n\ndef check(label: str, condition: bool, detail: str = \"\") -> None:\n    global checks\n    checks += 1\n    mark = \"ok\" if condition else \"FAIL\"\n    print(f\"  [{mark}] {label}\" + (f\" -- {detail}\" if detail and not condition else \"\"))\n    if not condition:\n        failures.append(label)\n\n\nprint(\"=== every depends_on edge is sourced or UNKNOWN ===\")\nfor sys_key, row in systems.SYSTEMS.items():\n    for dep in row[\"depends_on\"]:\n        has_source = bool(dep.get(\"source\"))\n        check(f\"{sys_key} -> {dep['system']} has a source\",\n              has_source, str(dep))\n        if dep[\"confidence\"] == systems.UNKNOWN:\n            check(f\"{sys_key} -> {dep['system']} UNKNOWN carries the standard note\",\n                  \"TechAuthority\" in dep[\"source\"] or \"not established\" in dep[\"source\"],\n                  dep[\"source\"])\n        else:\n            check(f\"{sys_key} -> {dep['system']} non-UNKNOWN is not the placeholder note\",\n                  dep[\"source\"] != systems._UNKNOWN_NOTE, dep[\"source\"])\n\nprint(\"=== systems() ===\")\nall_systems = systems.systems()\ncheck(\"25 systems in the graph\", len(all_systems) == 25, str(len(all_systems)))\ncheck(\"every system has at least one component\",\n      all(row[\"components\"] for row in all_systems.values()))\n\nprint(\"=== pcv (new system) ===\")\npcv_deps = systems.SYSTEMS[\"pcv\"][\"depends_on\"]\ncheck(\"pcv exists with a sourced or UNKNOWN depends_on\",\n      bool(pcv_deps) and all(bool(d.get(\"source\")) for d in pcv_deps),\n      str(pcv_deps))\n\ncrankcase_code = systems.systems_for_code(\"P1C44\", \"Crankcase ventilation valve stuck open\")\ncheck(\"a 'crankcase' description routes to pcv\",\n      any(e[\"system\"] == \"pcv\" for e in crankcase_code), crankcase_code)\n\nprint(\"=== systems_for_code ===\")\np0455 = systems.systems_for_code(\"P0455\")\ncheck(\"P0455 has an evap primary row\",\n      any(e[\"system\"] == \"evap\" and e[\"role\"] == \"primary\" for e in p0455), p0455)\ncheck(\"P0455 has electrical_supply upstream\",\n      any(e[\"system\"] == \"electrical_supply\" and e[\"role\"] == \"upstream\" for e in p0455),\n      p0455)\ncheck(\"P0455 has fuel upstream\",\n      any(e[\"system\"] == \"fuel\" and e[\"role\"] == \"upstream\" for e in p0455), p0455)\n\np0455_suffix = systems.systems_for_code(\"P0455-00\")\ncheck(\"failure byte ignored (P0455-00 same as P0455)\",\n      {(e[\"system\"], e[\"role\"]) for e in p0455_suffix} ==\n      {(e[\"system\"], e[\"role\"]) for e in p0455}, p0455_suffix)\n\nu1713 = systems.systems_for_code(\"U1713\")\ncheck(\"U1713 -> network\", any(e[\"system\"] == \"network\" for e in u1713), u1713)\n\nmisfire = systems.systems_for_code(\"P0302\")\ncheck(\"P0302 misfire -> ignition + fuel primaries\",\n      {\"ignition\", \"fuel\"} <= {e[\"system\"] for e in misfire if e[\"role\"] == \"primary\"},\n      misfire)\n\nunknown_code = systems.systems_for_code(\"P9999\")\ncheck(\"an unrouteable code returns one honest UNKNOWN row\",\n      unknown_code == [{\"system\": \"UNKNOWN\", \"role\": \"primary\",\n                        \"confidence\": systems.UNKNOWN,\n                        \"source\": systems._UNKNOWN_NOTE}],\n      unknown_code)\n\np1_keyword = systems.systems_for_code(\"P1C00\", \"EVAP purge control circuit malfunction\")\ncheck(\"P1xxx keyword match (evap) when no exact entry exists\",\n      any(e[\"system\"] == \"evap\" for e in p1_keyword), p1_keyword)\n\nprint(\"=== correlate (real corpus) ===\")\nresult = systems.correlate(VIN)\ncheck(\"no error for the known VIN\", \"error\" not in result, str(result))\nby_system = {row[\"system\"]: row for row in result.get(\"by_system\", [])}\ncheck(\"by_system covers every system key\",\n      set(by_system) == set(systems.SYSTEMS), str(set(by_system)))\ncheck(\"evap present with >= 4 sessions\",\n      by_system.get(\"evap\", {}).get(\"sessions\", 0) >= 4,\n      str(by_system.get(\"evap\")))\ncheck(\"network present with >= 4 sessions\",\n      by_system.get(\"network\", {}).get(\"sessions\", 0) >= 4,\n      str(by_system.get(\"network\")))\ncheck(\"at least one co-occurrence row\",\n      len(result.get(\"co_occurrence\", [])) >= 1, str(result.get(\"co_occurrence\")))\ncheck(\"co-occurrence rows only for pairs sharing >= 2 sessions\",\n      all(row[\"sessions_together\"] >= 2 for row in result.get(\"co_occurrence\", [])))\ncheck(\"findings is a non-empty list of strings\",\n      bool(result.get(\"findings\")) and all(isinstance(f, str) for f in result[\"findings\"]))\n_label_to_key = {v[\"label\"]: k for k, v in systems.SYSTEMS.items()}\ncheck(\"chains only built for systems with sessions > 0\",\n      all(by_system[_label_to_key[c[\"issue\"].rsplit(\" codes\", 1)[0]]][\"sessions\"] > 0\n          for c in result.get(\"chains\", [])))\n\nunknown_vin = systems.correlate(\"NOPE123NOTREAL0000\")\ncheck(\"unknown VIN is an error, not an empty graph\", \"error\" in unknown_vin, str(unknown_vin))\n\nprint()\nif failures:\n    print(f\"{len(failures)} FAILURES: {failures}\")\n    sys.exit(1)\nprint(f\"all {checks} checks passed\")\n","numLines":130,"startLine":1,"totalLines":130}},"sourceToolAssistantUUID":"4db5f9f0-9d68-4a6a-a2cd-3aa319adb9b8","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
