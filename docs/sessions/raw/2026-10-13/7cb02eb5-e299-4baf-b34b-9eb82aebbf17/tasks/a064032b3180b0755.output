_page(request: Request, name: str, **ctx: Any) -> HTMLResponse:\n123:def error_page(request: Request, body: Any) -> HTMLResponse:\n308:def vehicles_page(request: Request) -> HTMLResponse:\n312:    return _page(request, \"index.html\",\n351:    response = _page(request, \"vehicle.html\", vin=vin, d=dossier, bar=bar,\n390:    response = _page(request, \"codes.html\", vin=vin, rows=rows, data=data,\n410:    response = _page(request, \"code.html\", vin=vin, code=code_upper,\n428:    response = _page(request, \"tree.html\", vin=vin, codes=codes, result=result,\n459:    response = _page(request, \"gate.html\", vin=vin, result=None,\n529:    response = _page(request, \"gate.html\", vin=vin, result=result,\n576:    return _page(request, \"modules.html\", data=data, domain=domain, view=view,\n582:    return _page(request, \"recordings.html\",\n596:    return _page(request, \"recording.html\", name=name, data=data,\n607:    return _page(request, \"logs.html\", data=data, vin=vin, kind=kind,\n675:def _live_page(request: Request, vin: str = \"\", **extra: Any) -> HTMLResponse:\n686:    return _page(request, \"live.html\", **ctx)\n690:def live_page(request: Request, cable_error: str = \"\", vin: str = \"\") -> HTMLResponse:\n695:    return _live_page(request, vin=vin, **extra)","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"serverClassifierContext":{"request":"ef18b7f9-8bed-45a7-963a-7dd4de9a07fb","context":{"git_state":{"cwd":"/c/Users/User/mcp-servers","root":"/c/Users/User/mcp-servers","branch":"main","default_branch":null,"status":{"clean":false,"counts":{"staged":0,"modified":0,"untracked":null,"untracked_normal":1},"porcelain":null,"truncated":false},"visibility":{"origin":null,"push_remote":"origin","remotes":[{"name":"github","host":"github.com","remote":"dangelojohn/CUORE","visibility":"unknown"}],"visibility_cache":[]}},"live_cwd":"/c/Users/User/mcp-servers","platform":"windows"}},"sourceToolAssistantUUID":"012381e5-9a01-4e17-85ae-9615992e8b