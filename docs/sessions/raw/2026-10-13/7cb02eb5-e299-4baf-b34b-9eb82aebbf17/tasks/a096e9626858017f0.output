{"parentUuid":"101ac832-abd9-45e6-8bd5-2e5fe6ee2d5a","isSidechain":true,"agentId":"a096e9626858017f0","message":{"model":"claude-sonnet-5","id":"msg_011Cfor18MXX8GgvGYefJMmY","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01XQhoQmvSKV58BGojDwpF4C","name":"Read","input":{"file_path":"C:\\Users\\User\\mcp-servers\\mes-log-mcp\\tests\\check_compare.py"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":56752,"cache_read_input_tokens":0,"cache_creation":{"ephemeral_5m_input_tokens":56752,"ephemeral_1h_input_tokens":0},"output_tokens":5,"service_tier":"standard","inference_geo":"not_available"},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_01XQhoQmvSKV58BGojDwpF4C":{"file_path":"C:\\Users\\User\\mcp-servers\\mes-log-mcp\\tests\\check_compare.py"}},"serverClassifierRequest":"1fa470ea-c987-4cf3-ac10-0900d73e13c9","apiBlockIndex":1,"requestId":"req_011Cfor17vjHb1xNCakbA9WX","attributionAgent":"general-purpose","type":"assistant","uuid":"cf9b80a5-6a66-47d3-b963-f793c184b0ae","timestamp":"2026-10-08T00:45:23.992Z","effort":"high","perTurnEffort":null,"userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
{"parentUuid":"cf9b80a5-6a66-47d3-b963-f793c184b0ae","isSidechain":true,"promptId":"e7a39671-b35b-4b26-95cc-0b7762615cd1","agentId":"a096e9626858017f0","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01XQhoQmvSKV58BGojDwpF4C","type":"tool_result","content":"1\t\"\"\"Smoke checks for mes.compare.live_vs_log.\n2\t\n3\tPhase 1 builds a small synthetic log corpus (via MES_LOG_DIR) plus a\n4\thand-written live-observations JSONL (via MES_LIVE_OBSERVATIONS) and exercises\n5\tevery one of the six classes against it, including a \"scripted\" stream entry\n6\tthat must be ignored.\n7\t\n8\tPhase 2 points MES_LOG_DIR back at the real corpus (no override) and re-runs\n9\tlive_vs_log against the SAME temp live observations, checking that the real\n10\tECM EVAP codes (P0455/P0456/P0440) come back with a determinate class given\n11\tthe fake live read: that read (2026-01-01, long before the real 2026-09-25\n12\tclear) predates the newest real clear, while the real corpus's newest ECM\n13\tread (the 20:28 post-clear FES session) is clean and postdates it -- so the\n14\tlive evidence is stale and the log is believed: \"logged_not_live\".\n15\t\"\"\"\n16\t\n17\timport json\n18\timport os\n19\timport sys\n20\timport tempfile\n21\tfrom pathlib import Path\n22\t\n23\tsys.path.insert(0, str(Path(__file__).resolve().parents[1]))\n24\t\n25\tVIN = \"ZASFAKPN5J7B88115\"\n26\tfailures = []\n27\t\n28\t\n29\tdef check(label, cond, detail=\"\"):\n30\t    mark = \"ok\" if cond else \"FAIL\"\n31\t    print(f\"  [{mark}] {label}\" + (f\" -- {detail}\" if detail and not cond else \"\"))\n32\t    if not cond:\n33\t        failures.append(label)\n34\t\n35\t\n36\tdef row_for(result, module, code):\n37\t    for m in result[\"modules\"]:\n38\t        if m[\"module\"] == module:\n39\t            for r in m[\"rows\"]:\n40\t                if r[\"code\"] == code:\n41\t                    return r\n42\t    return None\n43\t\n44\t\n45\t# --- build the synthetic log corpus -----------------------------------------\n46\ttmp_logs = tempfile.mkdtemp(prefix=\"mes_compare_logs_\")\n47\t\n48\tSCAN_A = f\"\"\"Dashboard / IPC (Instrument Panel Cluster)\n49\tInstrument Panel Test\n50\tISO Code: 00 03 50 8B 14\n51\tVIN code: {VIN}\n52\tHardware number: HW2 - Ver: 01\n53\tSoftware number: SW2 - Ver: 01\n54\tErrors found:\n55\tP0400-00 - Test IPC fault\n56\t\"\"\"\n57\t\n58\tSCAN_B = f\"\"\"Engine / ECM\n59\tSome ECU\n60\tISO Code: 00 01 50 40 18\n61\tVIN code: {VIN}\n62\tHardware number: HW1 - Ver: 01\n63\tSoftware number: SW1 - Ver: 01\n64\t\n65\tCLEARING STORED FAULT CODES...\n66\t\"\"\"\n67\t\n68\tSCAN_C = f\"\"\"Engine / ECM\n69\tMagneti Marelli Test ECU\n70\tISO Code: 00 01 50 40 18\n71\tVIN code: {VIN}\n72\tHardware number: HW1 - Ver: 01\n73\tSoftware number: SW1 - Ver: 01\n74\tErrors found:\n75\tP0455-00 - Evaporation system leak\n76\tP0456-00 - Evaporation system leak\n77\tP0440-00 - Evaporation control valve\n78\t\n79\tGearbox / TCM (Automatic Transmission)\n80\tZF Test Gearbox\n81\tISO Code: 00 0B 50 AA 14\n82\tVIN code: {VIN}\n83\tHardware number: HW3 - Ver: 01\n84\tSoftware number: SW3 - Ver: 01\n85\tErrors found:\n86\tP0200-00 - Test TCM fault\n87\t\n88\tBody / BCM (Body Computer Module)\n89\tBody Computer Test\n90\tISO Code: 00 00 70 7C 15\n91\tVIN code: {VIN}\n92\tHardware number: HW4 - Ver: 01\n93\tSoftware number: SW4 - Ver: 01\n94\t\n95\tBody / RFHUB (Radio Frequency Hub Module)\n96\tRFHUB Test\n97\tISO Code: 00 41 50 89 15\n98\tVIN code: {VIN}\n99\tHardware number: HW5 - Ver: 01\n100\tSoftware number: SW5 - Ver: 01\n101\tErrors found:\n102\tP0500-00 - Test RFHUB fault\n103\t\"\"\"\n104\t\n105\t(Path(tmp_logs) / \"SCAN_2601010000.txt\").write_text(SCAN_A, encoding=\"utf-8\")\n106\t(Path(tmp_logs) / \"SCAN_2601010003.txt\").write_text(SCAN_B, encoding=\"utf-8\")\n107\t(Path(tmp_logs) / \"SCAN_2601010010.txt\").write_text(SCAN_C, encoding=\"utf-8\")\n108\t\n109\t# newest_clear (from SCAN_2601010003.txt) = 2026-01-01 00:03:00\n110\t#   IPC   log @ 00:00 (stale) / live @ 00:02 (stale)      -> stale_both\n111\t#   ECM   log @ 00:10 (fresh, P0455/P0456/P0440) / live @ 00:15 (fresh, active)\n112\t#                                                          -> live_and_logged\n113\t#   TCM   log @ 00:10 (P0200) / live @ 00:16 (clean, newer)-> logged_not_live\n114\t#   BCM   log @ 00:10 (clean) / live @ 00:17 (P0300 active, newer) -> live_not_logged\n115\t#   RFHUB log @ 00:10 (P0500) / no live read               -> no_live_read\n116\t#   DASM  no log / live @ 00:18 (P0600 active)             -> no_log\n117\t\n118\tlive_lines = [\n119\t    {\"at\": \"2026-01-01T00:02:00\", \"kind\": \"module_dtcs\", \"vin\": VIN,\n120\t     \"stream\": \"serial COM3@115200\",\n121\t     \"data\": {\"ecu\": \"IPC\", \"codes\": [\"P0400-00\"],\n122\t              \"dtcs\": [{\"code\": \"P0400-00\", \"status\": 13}]}},\n123\t    {\"at\": \"2026-01-01T00:16:00\", \"kind\": \"module_dtcs\", \"vin\": VIN,\n124\t     \"stream\": \"serial COM3@115200\",\n125\t     \"data\": {\"ecu\": \"TCM\", \"codes\": [], \"dtcs\": []}},\n126\t    {\"at\": \"2026-01-01T00:17:00\", \"kind\": \"module_dtcs\", \"vin\": VIN,\n127\t     \"stream\": \"serial COM3@115200\",\n128\t     \"data\": {\"ecu\": \"BCM\", \"codes\": [\"P0300-00\"],\n129\t              \"dtcs\": [{\"code\": \"P0300-00\", \"status\": 13}]}},\n130\t    {\"at\": \"2026-01-01T00:18:00\", \"kind\": \"module_dtcs\", \"vin\": VIN,\n131\t     \"stream\": \"serial COM3@115200\",\n132\t     \"data\": {\"ecu\": \"DASM\", \"codes\": [\"P0600-00\"],\n133\t              \"dtcs\": [{\"code\": \"P0600-00\", \"status\": 13}]}},\n134\t    {\"at\": \"2026-01-01T00:15:00\", \"kind\": \"module_dtcs\", \"vin\": VIN,\n135\t     \"stream\": \"serial COM3@115200\",\n136\t     \"data\": {\"ecu\": \"ECM\", \"codes\": [\"P0455-00\", \"P0456-00\", \"P0440-00\"],\n137\t              \"dtcs\": [{\"code\": \"P0455-00\", \"status\": 13},\n138\t                       {\"code\": \"P0456-00\", \"status\": 13},\n139\t                       {\"code\": \"P0440-00\", \"status\": 13}]}},\n140\t    # scripted -- must be ignored even though it is last in the file (and\n141\t    # would otherwise look like the newest ECM read, claiming it clean).\n142\t    {\"at\": \"2026-01-01T00:20:00\", \"kind\": \"module_dtcs\", \"vin\": VIN,\n143\t     \"stream\": \"scripted\",\n144\t     \"data\": {\"ecu\": \"ECM\", \"codes\": [], \"dtcs\": []}},\n145\t]\n146\t\n147\ttmp_live = tempfile.NamedTemporaryFile(\n148\t    prefix=\"mes_compare_live_\", suffix=\".jsonl\", delete=False, mode=\"w\",\n149\t    encoding=\"utf-8\")\n150\tfor obj in live_lines:\n151\t    tmp_live.write(json.dumps(obj) + \"\\n\")\n152\ttmp_live.close()\n153\t\n154\t_orig_log_dir = os.environ.get(\"MES_LOG_DIR\")\n155\t_orig_log_dirs = os.environ.get(\"MES_LOG_DIRS\")\n156\t_orig_live = os.environ.get(\"MES_LIVE_OBSERVATIONS\")\n157\t\n158\tos.environ.pop(\"MES_LOG_DIRS\", None)\n159\tos.environ[\"MES_LOG_DIR\"] = tmp_logs\n160\tos.environ[\"MES_LIVE_OBSERVATIONS\"] = tmp_live.name\n161\t\n162\tfrom mes import compare  # noqa: E402  (import after env vars are set)\n163\t\n164\tprint(\"=== synthetic corpus: every class ===\")\n165\tresult = compare.live_vs_log(VIN)\n166\tcheck(\"newest_clear picked up from SCAN_2601010003.txt\",\n167\t      result[\"newest_clear\"] == \"2026-01-01 00:03:00\", result[\"newest_clear\"])\n168\t\n169\tr = row_for(result, \"IPC\", \"P0400-00\")\n170\tcheck(\"IPC P0400 -> stale_both\", r and r[\"class\"] == \"stale_both\", r)\n171\t\n172\tfor code in (\"P0455-00\", \"P0456-00\", \"P0440-00\"):\n173\t    r = row_for(result, \"ECM\", code)\n174\t    check(f\"ECM {code} -> live_and_logged (scripted entry ignored)\",\n175\t          r and r[\"class\"] == \"live_and_logged\", r)\n176\t\n177\tr = row_for(result, \"TCM\", \"P0200-00\")\n178\tcheck(\"TCM P0200 -> logged_not_live\", r and r[\"class\"] == \"logged_not_live\", r)\n179\t\n180\tr = row_for(result, \"BCM\", \"P0300-00\")\n181\tcheck(\"BCM P0300 -> live_not_logged\", r and r[\"class\"] == \"live_not_logged\", r)\n182\t\n183\tr = row_for(result, \"RFHUB\", \"P0500-00\")\n184\tcheck(\"RFHUB P0500 -> no_live_read\", r and r[\"class\"] == \"no_live_read\", r)\n185\t\n186\tr = row_for(result, \"DASM\", \"P0600-00\")\n187\tcheck(\"DASM P0600 -> no_log\", r and r[\"class\"] == \"no_log\", r)\n188\t\n189\tcheck(\"summary counts every class once\",\n190\t      result[\"summary\"] == {\"stale_both\": 1, \"live_and_logged\": 3,\n191\t                            \"logged_not_live\": 1, \"live_not_logged\": 1,\n192\t                            \"no_live_read\": 1, \"no_log\": 1},\n193\t      result[\"summary\"])\n194\t\n195\tprint(\"\\n=== module filter ===\")\n196\tonly_ecm = compare.live_vs_log(VIN, module=\"ECM\")\n197\tcheck(\"module filter narrows to one module\",\n198\t      [m[\"module\"] for m in only_ecm[\"modules\"]] == [\"ECM\"],\n199\t      only_ecm[\"modules\"])\n200\t\n201\t# --- phase 2: real corpus, same fake live observations ----------------------\n202\tos.environ.pop(\"MES_LOG_DIR\", None)\n203\tos.environ.pop(\"MES_LOG_DIRS\", None)\n204\t\n205\tprint(\"\\n=== real corpus + fake live observations ===\")\n206\treal = compare.live_vs_log(VIN)\n207\tcheck(\"real newest_clear is the 2026-09-25 20:27 scan clear\",\n208\t      real[\"newest_clear\"] == \"2026-09-25 20:27:00\", real[\"newest_clear\"])\n209\t\n210\tfor code in (\"P0455-00\", \"P0456-00\", \"P0440-00\"):\n211\t    r = row_for(real, \"ECM\", code)\n212\t    check(f\"real corpus ECM {code} -> logged_not_live \"\n213\t          f\"(fake live predates the real clear; the real post-clear FES read \"\n214\t          f\"is clean)\",\n215\t          r and r[\"class\"] == \"logged_not_live\", r)\n216\t    reading = (r or {}).get(\"reading\", \"\").lower()\n217\t    check(f\"real corpus ECM {code}: a re-read after a clear is never called a pass\",\n218\t          \"passed\" not in reading.replace(\"absent is not passed\", \"\")\n219\t          and \"not that the fault is fixed\" in reading, reading)\n220\t\n221\t# --- restore environment -----------------------------------------------------\n222\tif _orig_log_dir is None:\n223\t    os.environ.pop(\"MES_LOG_DIR\", None)\n224\telse:\n225\t    os.environ[\"MES_LOG_DIR\"] = _orig_log_dir\n226\tif _orig_log_dirs is None:\n227\t    os.environ.pop(\"MES_LOG_DIRS\", None)\n228\telse:\n229\t    os.environ[\"MES_LOG_DIRS\"] = _orig_log_dirs\n230\tif _orig_live is None:\n231\t    os.environ.pop(\"MES_LIVE_OBSERVATIONS\", None)\n232\telse:\n233\t    os.environ[\"MES_LIVE_OBSERVATIONS\"] = _orig_live\n234\t\n235\tprint()\n236\tif failures:\n237\t    print(f\"{len(failures)} FAILURES: {failures}\")\n238\t    sys.exit(1)\n239\tprint(\"all checks passed\")\n240\t"}]},"uuid":"8ca69fca-72a7-46a7-ab1f-eca8fc2592e9","timestamp":"2026-10-08T00:45:24.050Z","toolUseResult":{"type":"text","file":{"filePath":"C:\\Users\\User\\mcp-servers\\mes-log-mcp\\tests\\check_compare.py","content":"\"\"\"Smoke checks for mes.compare.live_vs_log.\n\nPhase 1 builds a small synthetic log corpus (via MES_LOG_DIR) plus a\nhand-written live-observations JSONL (via MES_LIVE_OBSERVATIONS) and exercises\nevery one of the six classes against it, including a \"scripted\" stream entry\nthat must be ignored.\n\nPhase 2 points MES_LOG_DIR back at the real corpus (no override) and re-runs\nlive_vs_log against the SAME temp live observations, checking that the real\nECM EVAP codes (P0455/P0456/P0440) come back with a determinate class given\nthe fake live read: that read (2026-01-01, long before the real 2026-09-25\nclear) predates the newest real clear, while the real corpus's newest ECM\nread (the 20:28 post-clear FES session) is clean and postdates it -- so the\nlive evidence is stale and the log is believed: \"logged_not_live\".\n\"\"\"\n\nimport json\nimport os\nimport sys\nimport tempfile\nfrom pathlib import Path\n\nsys.path.insert(0, str(Path(__file__).resolve().parents[1]))\n\nVIN = \"ZASFAKPN5J7B88115\"\nfailures = []\n\n\ndef check(label, cond, detail=\"\"):\n    mark = \"ok\" if cond else \"FAIL\"\n    print(f\"  [{mark}] {label}\" + (f\" -- {detail}\" if detail and not cond else \"\"))\n    if not cond:\n        failures.append(label)\n\n\ndef row_for(result, module, code):\n    for m in result[\"modules\"]:\n        if m[\"module\"] == module:\n            for r in m[\"rows\"]:\n                if r[\"code\"] == code:\n                    return r\n    return None\n\n\n# --- build the synthetic log corpus -----------------------------------------\ntmp_logs = tempfile.mkdtemp(prefix=\"mes_compare_logs_\")\n\nSCAN_A = f\"\"\"Dashboard / IPC (Instrument Panel Cluster)\nInstrument Panel Test\nISO Code: 00 03 50 8B 14\nVIN code: {VIN}\nHardware number: HW2 - Ver: 01\nSoftware number: SW2 - Ver: 01\nErrors found:\nP0400-00 - Test IPC fault\n\"\"\"\n\nSCAN_B = f\"\"\"Engine / ECM\nSome ECU\nISO Code: 00 01 50 40 18\nVIN code: {VIN}\nHardware number: HW1 - Ver: 01\nSoftware number: SW1 - Ver: 01\n\nCLEARING STORED FAULT CODES...\n\"\"\"\n\nSCAN_C = f\"\"\"Engine / ECM\nMagneti Marelli Test ECU\nISO Code: 00 01 50 40 18\nVIN code: {VIN}\nHardware number: HW1 - Ver: 01\nSoftware number: SW1 - Ver: 01\nErrors found:\nP0455-00 - Evaporation system leak\nP0456-00 - Evaporation system leak\nP0440-00 - Evaporation control valve\n\nGearbox / TCM (Automatic Transmission)\nZF Test Gearbox\nISO Code: 00 0B 50 AA 14\nVIN code: {VIN}\nHardware number: HW3 - Ver: 01\nSoftware number: SW3 - Ver: 01\nErrors found:\nP0200-00 - Test TCM fault\n\nBody / BCM (Body Computer Module)\nBody Computer Test\nISO Code: 00 00 70 7C 15\nVIN code: {VIN}\nHardware number: HW4 - Ver: 01\nSoftware number: SW4 - Ver: 01\n\nBody / RFHUB (Radio Frequency Hub Module)\nRFHUB Test\nISO Code: 00 41 50 89 15\nVIN code: {VIN}\nHardware number: HW5 - Ver: 01\nSoftware number: SW5 - Ver: 01\nErrors found:\nP0500-00 - Test RFHUB fault\n\"\"\"\n\n(Path(tmp_logs) / \"SCAN_2601010000.txt\").write_text(SCAN_A, encoding=\"utf-8\")\n(Path(tmp_logs) / \"SCAN_2601010003.txt\").write_text(SCAN_B, encoding=\"utf-8\")\n(Path(tmp_logs) / \"SCAN_2601010010.txt\").write_text(SCAN_C, encoding=\"utf-8\")\n\n# newest_clear (from SCAN_2601010003.txt) = 2026-01-01 00:03:00\n#   IPC   log @ 00:00 (stale) / live @ 00:02 (stale)      -> stale_both\n#   ECM   log @ 00:10 (fresh, P0455/P0456/P0440) / live @ 00:15 (fresh, active)\n#                                                          -> live_and_logged\n#   TCM   log @ 00:10 (P0200) / live @ 00:16 (clean, newer)-> logged_not_live\n#   BCM   log @ 00:10 (clean) / live @ 00:17 (P0300 active, newer) -> live_not_logged\n#   RFHUB log @ 00:10 (P0500) / no live read               -> no_live_read\n#   DASM  no log / live @ 00:18 (P0600 active)             -> no_log\n\nlive_lines = [\n    {\"at\": \"2026-01-01T00:02:00\", \"kind\": \"module_dtcs\", \"vin\": VIN,\n     \"stream\": \"serial COM3@115200\",\n     \"data\": {\"ecu\": \"IPC\", \"codes\": [\"P0400-00\"],\n              \"dtcs\": [{\"code\": \"P0400-00\", \"status\": 13}]}},\n    {\"at\": \"2026-01-01T00:16:00\", \"kind\": \"module_dtcs\", \"vin\": VIN,\n     \"stream\": \"serial COM3@115200\",\n     \"data\": {\"ecu\": \"TCM\", \"codes\": [], \"dtcs\": []}},\n    {\"at\": \"2026-01-01T00:17:00\", \"kind\": \"module_dtcs\", \"vin\": VIN,\n     \"stream\": \"serial COM3@115200\",\n     \"data\": {\"ecu\": \"BCM\", \"codes\": [\"P0300-00\"],\n              \"dtcs\": [{\"code\": \"P0300-00\", \"status\": 13}]}},\n    {\"at\": \"2026-01-01T00:18:00\", \"kind\": \"module_dtcs\", \"vin\": VIN,\n     \"stream\": \"serial COM3@115200\",\n     \"data\": {\"ecu\": \"DASM\", \"codes\": [\"P0600-00\"],\n              \"dtcs\": [{\"code\": \"P0600-00\", \"status\": 13}]}},\n    {\"at\": \"2026-01-01T00:15:00\", \"kind\": \"module_dtcs\", \"vin\": VIN,\n     \"stream\": \"serial COM3@115200\",\n     \"data\": {\"ecu\": \"ECM\", \"codes\": [\"P0455-00\", \"P0456-00\", \"P0440-00\"],\n              \"dtcs\": [{\"code\": \"P0455-00\", \"status\": 13},\n                       {\"code\": \"P0456-00\", \"status\": 13},\n                       {\"code\": \"P0440-00\", \"status\": 13}]}},\n    # scripted -- must be ignored even though it is last in the file (and\n    # would otherwise look like the newest ECM read, claiming it clean).\n    {\"at\": \"2026-01-01T00:20:00\", \"kind\": \"module_dtcs\", \"vin\": VIN,\n     \"stream\": \"scripted\",\n     \"data\": {\"ecu\": \"ECM\", \"codes\": [], \"dtcs\": []}},\n]\n\ntmp_live = tempfile.NamedTemporaryFile(\n    prefix=\"mes_compare_live_\", suffix=\".jsonl\", delete=False, mode=\"w\",\n    encoding=\"utf-8\")\nfor obj in live_lines:\n    tmp_live.write(json.dumps(obj) + \"\\n\")\ntmp_live.close()\n\n_orig_log_dir = os.environ.get(\"MES_LOG_DIR\")\n_orig_log_dirs = os.environ.get(\"MES_LOG_DIRS\")\n_orig_live = os.environ.get(\"MES_LIVE_OBSERVATIONS\")\n\nos.environ.pop(\"MES_LOG_DIRS\", None)\nos.environ[\"MES_LOG_DIR\"] = tmp_logs\nos.environ[\"MES_LIVE_OBSERVATIONS\"] = tmp_live.name\n\nfrom mes import compare  # noqa: E402  (import after env vars are set)\n\nprint(\"=== synthetic corpus: every class ===\")\nresult = compare.live_vs_log(VIN)\ncheck(\"newest_clear picked up from SCAN_2601010003.txt\",\n      result[\"newest_clear\"] == \"2026-01-01 00:03:00\", result[\"newest_clear\"])\n\nr = row_for(result, \"IPC\", \"P0400-00\")\ncheck(\"IPC P0400 -> stale_both\", r and r[\"class\"] == \"stale_both\", r)\n\nfor code in (\"P0455-00\", \"P0456-00\", \"P0440-00\"):\n    r = row_for(result, \"ECM\", code)\n    check(f\"ECM {code} -> live_and_logged (scripted entry ignored)\",\n          r and r[\"class\"] == \"live_and_logged\", r)\n\nr = row_for(result, \"TCM\", \"P0200-00\")\ncheck(\"TCM P0200 -> logged_not_live\", r and r[\"class\"] == \"logged_not_live\", r)\n\nr = row_for(result, \"BCM\", \"P0300-00\")\ncheck(\"BCM P0300 -> live_not_logged\", r and r[\"class\"] == \"live_not_logged\", r)\n\nr = row_for(result, \"RFHUB\", \"P0500-00\")\ncheck(\"RFHUB P0500 -> no_live_read\", r and r[\"class\"] == \"no_live_read\", r)\n\nr = row_for(result, \"DASM\", \"P0600-00\")\ncheck(\"DASM P0600 -> no_log\", r and r[\"class\"] == \"no_log\", r)\n\ncheck(\"summary counts every class once\",\n      result[\"summary\"] == {\"stale_both\": 1, \"live_and_logged\": 3,\n                            \"logged_not_live\": 1, \"live_not_logged\": 1,\n                            \"no_live_read\": 1, \"no_log\": 1},\n      result[\"summary\"])\n\nprint(\"\\n=== module filter ===\")\nonly_ecm = compare.live_vs_log(VIN, module=\"ECM\")\ncheck(\"module filter narrows to one module\",\n      [m[\"module\"] for m in only_ecm[\"modules\"]] == [\"ECM\"],\n      only_ecm[\"modules\"])\n\n# --- phase 2: real corpus, same fake live observations ----------------------\nos.environ.pop(\"MES_LOG_DIR\", None)\nos.environ.pop(\"MES_LOG_DIRS\", None)\n\nprint(\"\\n=== real corpus + fake live observations ===\")\nreal = compare.live_vs_log(VIN)\ncheck(\"real newest_clear is the 2026-09-25 20:27 scan clear\",\n      real[\"newest_clear\"] == \"2026-09-25 20:27:00\", real[\"newest_clear\"])\n\nfor code in (\"P0455-00\", \"P0456-00\", \"P0440-00\"):\n    r = row_for(real, \"ECM\", code)\n    check(f\"real corpus ECM {code} -> logged_not_live \"\n          f\"(fake live predates the real clear; the real post-clear FES read \"\n          f\"is clean)\",\n          r and r[\"class\"] == \"logged_not_live\", r)\n    reading = (r or {}).get(\"reading\", \"\").lower()\n    check(f\"real corpus ECM {code}: a re-read after a clear is never called a pass\",\n          \"passed\" not in reading.replace(\"absent is not passed\", \"\")\n          and \"not that the fault is fixed\" in reading, reading)\n\n# --- restore environment -----------------------------------------------------\nif _orig_log_dir is None:\n    os.environ.pop(\"MES_LOG_DIR\", None)\nelse:\n    os.environ[\"MES_LOG_DIR\"] = _orig_log_dir\nif _orig_log_dirs is None:\n    os.environ.pop(\"MES_LOG_DIRS\", None)\nelse:\n    os.environ[\"MES_LOG_DIRS\"] = _orig_log_dirs\nif _orig_live is None:\n    os.environ.pop(\"MES_LIVE_OBSERVATIONS\", None)\nelse:\n    os.environ[\"MES_LIVE_OBSERVATIONS\"] = _orig_live\n\nprint()\nif failures:\n    print(f\"{len(failures)} FAILURES: {failures}\")\n    sys.exit(1)\nprint(\"all checks passed\")\n","numLines":240,"startLine":1,"totalLines":240}},"sourceToolAssistantUUID":"cf9b80a5-6a66-47d3-b963-f793c184b0ae","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
