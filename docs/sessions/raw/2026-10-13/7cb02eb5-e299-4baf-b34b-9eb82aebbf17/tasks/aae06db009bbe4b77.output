ndencies=[Depends(require_token)])","numLines":20,"startLine":1,"totalLines":187}},"sourceToolAssistantUUID":"69944d6d-23d4-40c9-b9c6-8d088a497d04","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
