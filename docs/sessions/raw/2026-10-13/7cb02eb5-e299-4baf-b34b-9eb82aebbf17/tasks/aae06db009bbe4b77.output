{"parentUuid":"56949e1b-8628-4873-816a-7c33caad236f","isSidechain":true,"agentId":"aae06db009bbe4b77","message":{"model":"claude-sonnet-5","id":"msg_011CfqHSLmkAAE67YVx8YaeT","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01P3Zman4Ks3D3yHsHe7b5uM","name":"Read","input":{"file_path":"C:\\Users\\User\\mcp-servers\\cuore\\tests\\check_jobs_page.py"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1178,"cache_read_input_tokens":98537,"cache_creation":{"ephemeral_5m_input_tokens":1178,"ephemeral_1h_input_tokens":0},"output_tokens":2,"service_tier":"standard","inference_geo":"not_available"},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_01P3Zman4Ks3D3yHsHe7b5uM":{"file_path":"C:\\Users\\User\\mcp-servers\\cuore\\tests\\check_jobs_page.py"}},"serverClassifierRequest":"952ec27c-23fa-4383-9cf1-47b6361a0c95","apiBlockIndex":1,"requestId":"req_011CfqHSLXsEZZsTRqDnpCc5","attributionAgent":"general-purpose","type":"assistant","uuid":"6360fe30-6492-4726-89ba-71b0662895a7","timestamp":"2026-10-08T18:59:32.038Z","effort":"high","perTurnEffort":null,"userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
{"parentUuid":"6360fe30-6492-4726-89ba-71b0662895a7","isSidechain":true,"promptId":"6b90abf8-385c-44a5-9c34-eeb6aba8bde3","agentId":"aae06db009bbe4b77","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01P3Zman4Ks3D3yHsHe7b5uM","type":"tool_result","content":"1\t\"\"\"Checks for the Job (case) workflow: ``mes.jobs``, ``cuore.services.jobs_bridge``,\n2\t``cuore/api/jobs.py`` and the ``/v/{vin}/job`` page.\n3\t\n4\tSame posture as ``cuore/tests/check_dossier_page.py``: ``CUORE_STATE_DIR`` is\n5\tpointed at a throwaway directory BEFORE cuore is imported, and the real MES\n6\tcorpus on this machine (the Stelvio, VIN below -- chronic EVAP codes,\n7\tP0455/P0440/P0456) is the fixture for the suggested-hypothesis evidence.\n8\t\n9\tFive checks:\n10\t  1. Opening a case via the HTML form lands a job on the page.\n11\t  2. The suggested hypotheses include an EVAP one with >=1 real evidence_for ref.\n12\t  3. Add action + set hypothesis status round trip (both via the HTML forms).\n13\t  4. Closing with an outcome is required and sticks; closing is blocked\n14\t     without a tools-used review or a stated skip reason (see\n15\t     ``mes.tools_kb``/``mes.tool_usage`` and\n16\t     ``cuore.services.jobs_bridge.close_job``), and allowed once one is given.\n17\t  5. The job page renders 200 at 400px with no page-level horizontal overflow.\n18\t\n19\tRun:\n20\t    .venv/Scripts/python.exe cuore/tests/check_jobs_page.py\n21\t\"\"\"\n22\t\n23\tfrom __future__ import annotations\n24\t\n25\timport base64\n26\timport itertools\n27\timport json\n28\timport os\n29\timport socket\n30\timport subprocess\n31\timport sys\n32\timport tempfile\n33\timport time\n34\timport urllib.parse\n35\timport urllib.request\n36\tfrom pathlib import Path\n37\t\n38\tos.environ[\"CUORE_STATE_DIR\"] = tempfile.mkdtemp(prefix=\"cuore-check-jobs-\")\n39\tos.environ.pop(\"CUORE_AUDIT_PATH\", None)\n40\t\n41\tROOT = Path(__file__).resolve().parents[2]\n42\tsys.path.insert(0, str(ROOT))\n43\t\n44\tfrom fastapi.testclient import TestClient  # noqa: E402\n45\t\n46\tfrom cuore.app import create_app  # noqa: E402\n47\t\n48\tVIN = \"ZASFAKPN5J7B88115\"  # the Stelvio -- real corpus, chronic P0455/P0440/P0456\n49\t\n50\tfailures: list[str] = []\n51\tchecks = 0\n52\t\n53\t\n54\tdef check(label: str, cond: bool, detail: str = \"\") -> None:\n55\t    global checks\n56\t    checks += 1\n57\t    if not cond:\n58\t        failures.append(f\"{label}{(' -- ' + detail) if detail else ''}\")\n59\t\n60\t\n61\tclient = TestClient(create_app())\n62\t\n63\t\n64\t# --- 1. open a case via the HTML form ---------------------------------------\n65\t\n66\topen_resp = client.post(f\"/v/{VIN}/job/open\",\n67\t                        data={\"technician\": \"tester\", \"complaint\": \"CEL, smells like gas\"},\n68\t                        follow_redirects=True)\n69\tcheck(\"opening a case via the HTML form responds 200\", open_resp.status_code == 200,\n70\t      str(open_resp.status_code))\n71\tcheck(\"the job page shows the complaint back\", \"smells like gas\" in open_resp.text)\n72\t\n73\tview = client.get(f\"/api/vehicles/{VIN}/job\").json()\n74\tjob = view.get(\"job\")\n75\tcheck(\"a job landed for this VIN\", job is not None, str(view))\n76\tjob_id = job[\"id\"] if job else None\n77\tcheck(\"the new job starts open with no outcome\",\n78\t      bool(job) and job[\"status\"] == \"open\" and job[\"outcome\"] is None, str(job))\n79\t\n80\t\n81\t# --- 2. suggested hypotheses include a real-evidenced EVAP one -------------\n82\t\n83\tsuggestions = view.get(\"suggested_hypotheses\", [])\n84\tcheck(\"at least one suggested hypothesis was offered\", len(suggestions) > 0, str(suggestions))\n85\t\n86\tevap_suggestion = next((s for s in suggestions if s.get(\"system\") == \"EVAP\"\n87\t                        and s[\"evidence_for\"]), None)\n88\tcheck(\"an EVAP suggested hypothesis carries >=1 real evidence_for ref\",\n89\t      evap_suggestion is not None, str(suggestions))\n90\tif evap_suggestion is not None:\n91\t    ref = evap_suggestion[\"evidence_for\"][0]\n92\t    check(\"that evidence ref has kind/id/label (a real record, not invented)\",\n93\t          {\"kind\", \"id\", \"label\"} <= set(ref), str(ref))\n94\t\n95\t\n96\t# --- 3. add action + set hypothesis status round trip ----------------------\n97\t\n98\tif job_id and evap_suggestion is not None:\n99\t    add_resp = client.post(f\"/v/{VIN}/job/{job_id}/hypotheses/suggested\", data={\n100\t        \"text\": evap_suggestion[\"text\"], \"system\": evap_suggestion[\"system\"],\n101\t        \"next_test\": evap_suggestion[\"next_test\"],\n102\t        \"evidence_for\": json.dumps(evap_suggestion[\"evidence_for\"]),\n103\t        \"evidence_against\": json.dumps(evap_suggestion[\"evidence_against\"]),\n104\t    }, follow_redirects=True)\n105\t    check(\"promoting a suggested hypothesis via its form responds 200\",\n106\t          add_resp.status_code == 200, str(add_resp.status_code))\n107\t\n108\t    view2 = client.get(f\"/api/vehicles/{VIN}/job\").json()\n109\t    hyps = view2[\"job\"][\"hypotheses\"]\n110\t    check(\"the promoted hypothesis is now on the job's ledger\",\n111\t          any(h[\"text\"] == evap_suggestion[\"text\"] for h in hyps), str(hyps))\n112\t    hyp = next(h for h in hyps if h[\"text\"] == evap_suggestion[\"text\"])\n113\t    check(\"its real evidence_for ref(s) carried over, not re-invented\",\n114\t          len(hyp[\"evidence_for\"]) == len(evap_suggestion[\"evidence_for\"]), str(hyp))\n115\t\n116\t    status_resp = client.post(\n117\t        f\"/v/{VIN}/job/{job_id}/hypotheses/{hyp['id']}/status\",\n118\t        data={\"status\": \"supported\"}, follow_redirects=True)\n119\t    check(\"setting a hypothesis's status via its form responds 200\",\n120\t          status_resp.status_code == 200, str(status_resp.status_code))\n121\t\n122\t    action_resp = client.post(f\"/v/{VIN}/job/{job_id}/actions\",\n123\t                              data={\"kind\": \"test\", \"text\": \"smoke tested recirc line, clean\"},\n124\t                              follow_redirects=True)\n125\t    check(\"recording an action via its form responds 200\",\n126\t          action_resp.status_code == 200, str(action_resp.status_code))\n127\t\n128\t    view3 = client.get(f\"/api/vehicles/{VIN}/job\").json()\n129\t    hyp3 = next(h for h in view3[\"job\"][\"hypotheses\"] if h[\"id\"] == hyp[\"id\"])\n130\t    check(\"the hypothesis status round-tripped to 'supported'\",\n131\t          hyp3[\"status\"] == \"supported\", str(hyp3))\n132\t    check(\"the action round-tripped onto the job's action list\",\n133\t          any(a[\"text\"] == \"smoke tested recirc line, clean\" for a in view3[\"job\"][\"actions\"]),\n134\t          str(view3[\"job\"][\"actions\"]))\n135\telse:\n136\t    check(\"step 3 skipped: no job/suggestion to work with\", False, \"see checks above\")\n137\t\n138\t\n139\t# --- 4. close requires an outcome, and it sticks ----------------------------\n140\t\n141\tif job_id:\n142\t    bad_close = client.post(f\"/v/{VIN}/job/{job_id}/close\", data={\"outcome\": \"\"})\n143\t    check(\"closing with no outcome is refused, not silently accepted\",\n144\t          bad_close.status_code == 422, str(bad_close.status_code))\n145\t\n146\t    # The tools-used review is mandatory before a close is accepted (see\n147\t    # cuore.services.jobs_bridge.close_job) -- closing with no review and no\n148\t    # stated skip reason must be refused, not silently accepted.\n149\t    unreviewed_close = client.post(f\"/v/{VIN}/job/{job_id}/close\",\n150\t                                   data={\"outcome\": \"fixed\"}, follow_redirects=True)\n151\t    view_unreviewed = client.get(f\"/api/vehicles/{VIN}/job/{job_id}\").json()\n152\t    check(\"closing with no tools review and no skip reason is refused\",\n153\t          view_unreviewed[\"job\"][\"status\"] != \"closed\", str(view_unreviewed[\"job\"]))\n154\t    check(\"the refusal is explained on the re-rendered page\",\n155\t          \"tools used review\" in unreviewed_close.text.lower(), unreviewed_close.text[:2000])\n156\t\n157\t    close_resp = client.post(f\"/v/{VIN}/job/{job_id}/close\",\n158\t                             data={\"outcome\": \"fixed\", \"verdict\": \"ECM recalibrated per TSB\",\n159\t                                   \"tools_review_skip_reason\": \"no usage review captured on this run\"},\n160\t                             follow_redirects=True)\n161\t    check(\"closing with a real outcome and a stated skip reason responds 200\",\n162\t          close_resp.status_code == 200, str(close_resp.status_code))\n163\t\n164\t    view4 = client.get(f\"/api/vehicles/{VIN}/job/{job_id}\").json()\n165\t    check(\"the job is now closed with outcome 'fixed'\",\n166\t          view4[\"job\"][\"status\"] == \"closed\" and view4[\"job\"][\"outcome\"] == \"fixed\",\n167\t          str(view4[\"job\"]))\n168\t    check(\"the skip reason was recorded as a job action, not silently dropped\",\n169\t          any(\"Tools-used review skipped\" in a[\"text\"] for a in view4[\"job\"][\"actions\"]),\n170\t          str(view4[\"job\"][\"actions\"]))\n171\telse:\n172\t    check(\"step 4 skipped: no job to close\", False, \"see checks above\")\n173\t\n174\t\n175\t# --- 5. the page renders at 400px with no horizontal overflow --------------\n176\t\n177\tprint(\"=== screenshot + overflow at 400px ===\")\n178\tEDGE_CANDIDATES = [\n179\t    r\"C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe\",\n180\t    r\"C:\\Program Files\\Microsoft\\Edge\\Application\\msedge.exe\",\n181\t]\n182\tSCRATCHPAD = Path(r\"C:\\Users\\User\\AppData\\Local\\Temp\\claude\\C--Users-User\"\n183\t                  r\"\\7cb02eb5-e299-4baf-b34b-9eb82aebbf17\\scratchpad\")\n184\t\n185\t\n186\tdef find_edge() -> str:\n187\t    for candidate in EDGE_CANDIDATES:\n188\t        if Path(candidate).exists():\n189\t            return candidate\n190\t    return \"\"\n191\t\n192\t\n193\tdef free_port() -> int:\n194\t    s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)\n195\t    s.bind((\"127.0.0.1\", 0))\n196\t    port = s.getsockname()[1]\n197\t    s.close()\n198\t    return port\n199\t\n200\t\n201\tclass CDP:\n202\t    def __init__(self, ws_url: str) -> None:\n203\t        from websockets.sync.client import connect\n204\t        self.ws = connect(ws_url, max_size=None, open_timeout=20)\n205\t        self._ids = itertools.count(1)\n206\t\n207\t    def send(self, method: str, params: dict | None = None, timeout: float = 20):\n208\t        msg_id = next(self._ids)\n209\t        self.ws.send(json.dumps({\"id\": msg_id, \"method\": method, \"params\": params or {}}))\n210\t        deadline = time.time() + timeout\n211\t        while time.time() < deadline:\n212\t            raw = self.ws.recv(timeout=max(0.1, deadline - time.time()))\n213\t            msg = json.loads(raw)\n214\t            if msg.get(\"id\") == msg_id:\n215\t                if \"error\" in msg:\n216\t                    raise RuntimeError(f\"CDP {method} failed: {msg['error']}\")\n217\t                return msg.get(\"result\", {})\n218\t        raise TimeoutError(f\"CDP {method} timed out waiting for response\")\n219\t\n220\t    def close(self) -> None:\n221\t        try:\n222\t            self.ws.close()\n223\t        except Exception:\n224\t            pass\n225\t\n226\t\n227\tdef wait_for_devtools(port: int, timeout: float = 20) -> None:\n228\t    deadline = time.time() + timeout\n229\t    last_err: Exception | None = None\n230\t    while time.time() < deadline:\n231\t        try:\n232\t            with urllib.request.urlopen(f\"http://127.0.0.1:{port}/json/version\", timeout=2) as r:\n233\t                json.loads(r.read().decode(\"utf-8\"))\n234\t                return\n235\t        except Exception as exc:  # noqa: BLE001\n236\t            last_err = exc\n237\t            time.sleep(0.2)\n238\t    raise RuntimeError(f\"headless Edge devtools endpoint never came up: {last_err}\")\n239\t\n240\t\n241\tdef open_target(port: int, url: str) -> dict:\n242\t    req = urllib.request.Request(f\"http://127.0.0.1:{port}/json/new?{url}\", method=\"PUT\")\n243\t    with urllib.request.urlopen(req, timeout=10) as r:\n244\t        return json.loads(r.read().decode(\"utf-8\"))\n245\t\n246\t\n247\tdef wait_for_port(port: int, timeout: float = 15.0) -> bool:\n248\t    deadline = time.monotonic() + timeout\n249\t    while time.monotonic() < deadline:\n250\t        try:\n251\t            with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:\n252\t                s.settimeout(0.3)\n253\t                s.connect((\"127.0.0.1\", port))\n254\t                return True\n255\t        except OSError:\n256\t            time.sleep(0.2)\n257\t    return False\n258\t\n259\t\n260\tedge = find_edge()\n261\tserver_dir = tempfile.mkdtemp(prefix=\"cuore-check-jobs-server-\")\n262\tport = free_port()\n263\tenv = dict(os.environ)\n264\tenv[\"CUORE_STATE_DIR\"] = server_dir\n265\t\n266\t_SERVER_SNIPPET = f\"\"\"\n267\timport sys\n268\tsys.path.insert(0, {str(ROOT)!r})\n269\tfrom cuore.app import create_app\n270\timport uvicorn\n271\t\n272\tapp = create_app()\n273\tuvicorn.run(app, host=\"127.0.0.1\", port={port}, log_level=\"warning\")\n274\t\"\"\"\n275\t\n276\tif not edge:\n277\t    check(\"headless Edge is available for screenshots\", False, str(EDGE_CANDIDATES))\n278\telse:\n279\t    server_proc = subprocess.Popen(\n280\t        [sys.executable, \"-c\", _SERVER_SNIPPET],\n281\t        cwd=str(ROOT), env=env,\n282\t        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,\n283\t    )\n284\t    try:\n285\t        up = wait_for_port(port)\n286\t        check(\"uvicorn came up on the free port\", up, f\"port {port}\")\n287\t        if up:\n288\t            # Seed a real open job on the server's own state dir, so the\n289\t            # page under screenshot renders the full stepper, not the empty\n290\t            # \"open a case\" form.\n291\t            data = urllib.parse.urlencode(\n292\t                {\"technician\": \"tester\", \"complaint\": \"CEL, smells like gas\"}).encode()\n293\t            try:\n294\t                urllib.request.urlopen(\n295\t                    urllib.request.Request(f\"http://127.0.0.1:{port}/v/{VIN}/job/open\",\n296\t                                           data=data, method=\"POST\"), timeout=30)\n297\t            except Exception as exc:  # noqa: BLE001\n298\t                check(\"seeding a job on the screenshot server\", False, str(exc))\n299\t\n300\t            time.sleep(0.3)\n301\t            devtools_port = free_port()\n302\t            profile_dir = Path(tempfile.mkdtemp(prefix=\"cuore-edge-jobs-\"))\n303\t            edge_proc = subprocess.Popen(\n304\t                [edge, \"--headless=new\", f\"--remote-debugging-port={devtools_port}\",\n305\t                 f\"--user-data-dir={profile_dir}\", \"--no-first-run\", \"--window-size=400,1400\",\n306\t                 \"about:blank\"],\n307\t                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,\n308\t            )\n309\t            try:\n310\t                wait_for_devtools(devtools_port)\n311\t                url = f\"http://127.0.0.1:{port}/v/{VIN}/job\"\n312\t                target = open_target(devtools_port, url)\n313\t                cdp = CDP(target[\"webSocketDebuggerUrl\"])\n314\t                try:\n315\t                    cdp.send(\"Page.enable\")\n316\t                    cdp.send(\"Runtime.enable\")\n317\t                    time.sleep(1.5)\n318\t                    cdp.send(\"Emulation.setDeviceMetricsOverride\", {\n319\t                        \"width\": 400, \"height\": 1400, \"deviceScaleFactor\": 1, \"mobile\": True,\n320\t                    })\n321\t                    time.sleep(0.6)\n322\t\n323\t                    nav = cdp.send(\"Runtime.evaluate\", {\n324\t                        \"expression\": \"document.readyState\", \"returnByValue\": True})\n325\t                    check(\"job page loaded in the headless browser\",\n326\t                          nav.get(\"result\", {}).get(\"value\") in (\"complete\", \"interactive\"),\n327\t                          str(nav))\n328\t\n329\t                    overflow = cdp.send(\"Runtime.evaluate\", {\n330\t                        \"expression\": (\n331\t                            \"JSON.stringify({sw: document.documentElement.scrollWidth, \"\n332\t                            \"cw: document.documentElement.clientWidth})\"),\n333\t                        \"returnByValue\": True,\n334\t                    })\n335\t                    dims = json.loads(overflow.get(\"result\", {}).get(\"value\", \"{}\"))\n336\t                    sw, cw = dims.get(\"sw\", 0), dims.get(\"cw\", 0)\n337\t                    check(\"no page-level horizontal overflow at 400px\",\n338\t                         sw <= cw + 1, f\"scrollWidth={sw} clientWidth={cw}\")\n339\t\n340\t                    SCRATCHPAD.mkdir(parents=True, exist_ok=True)\n341\t                    out_path = SCRATCHPAD / \"job_phone.png\"\n342\t                    shot = cdp.send(\"Page.captureScreenshot\",\n343\t                                   {\"format\": \"png\", \"captureBeyondViewport\": False})\n344\t                    out_path.write_bytes(base64.b64decode(shot[\"data\"]))\n345\t                    check(\"screenshot job_phone.png captured\",\n346\t                         out_path.exists() and out_path.stat().st_size > 0, str(out_path))\n347\t                    if out_path.exists():\n348\t                        print(f\"  wrote {out_path} ({out_path.stat().st_size} bytes)\")\n349\t                finally:\n350\t                    cdp.close()\n351\t            except Exception as exc:  # noqa: BLE001\n352\t                check(\"headless Edge captured the job page screenshot over CDP\", False,\n353\t                     f\"{type(exc).__name__}: {exc}\")\n354\t            finally:\n355\t                edge_proc.terminate()\n356\t                try:\n357\t                    edge_proc.wait(timeout=5)\n358\t                except Exception:\n359\t                    edge_proc.kill()\n360\t                from _edge_cleanup import kill_edge_profile\n361\t                kill_edge_profile(profile_dir)\n362\t    finally:\n363\t        server_proc.terminate()\n364\t        try:\n365\t            server_proc.wait(timeout=5)\n366\t        except Exception:\n367\t            server_proc.kill()\n368\t\n369\t\n370\t# --- report ------------------------------------------------------------------\n371\t\n372\tprint()\n373\tif failures:\n374\t    print(f\"{len(failures)}/{checks} check(s) failed:\")\n375\t    for f in failures:\n376\t        print(f\"  - {f}\")\n377\t    sys.exit(1)\n378\tprint(f\"all {checks} checks passed\")\n379\t"}]},"uuid":"d90c3a58-f986-4466-a912-19aa47025ed5","timestamp":"2026-10-08T18:59:32.056Z","toolUseResult":{"type":"text","file":{"filePath":"C:\\Users\\User\\mcp-servers\\cuore\\tests\\check_jobs_page.py","content":"\"\"\"Checks for the Job (case) workflow: ``mes.jobs``, ``cuore.services.jobs_bridge``,\n``cuore/api/jobs.py`` and the ``/v/{vin}/job`` page.\n\nSame posture as ``cuore/tests/check_dossier_page.py``: ``CUORE_STATE_DIR`` is\npointed at a throwaway directory BEFORE cuore is imported, and the real MES\ncorpus on this machine (the Stelvio, VIN below -- chronic EVAP codes,\nP0455/P0440/P0456) is the fixture for the suggested-hypothesis evidence.\n\nFive checks:\n  1. Opening a case via the HTML form lands a job on the page.\n  2. The suggested hypotheses include an EVAP one with >=1 real evidence_for ref.\n  3. Add action + set hypothesis status round trip (both via the HTML forms).\n  4. Closing with an outcome is required and sticks; closing is blocked\n     without a tools-used review or a stated skip reason (see\n     ``mes.tools_kb``/``mes.tool_usage`` and\n     ``cuore.services.jobs_bridge.close_job``), and allowed once one is given.\n  5. The job page renders 200 at 400px with no page-level horizontal overflow.\n\nRun:\n    .venv/Scripts/python.exe cuore/tests/check_jobs_page.py\n\"\"\"\n\nfrom __future__ import annotations\n\nimport base64\nimport itertools\nimport json\nimport os\nimport socket\nimport subprocess\nimport sys\nimport tempfile\nimport time\nimport urllib.parse\nimport urllib.request\nfrom pathlib import Path\n\nos.environ[\"CUORE_STATE_DIR\"] = tempfile.mkdtemp(prefix=\"cuore-check-jobs-\")\nos.environ.pop(\"CUORE_AUDIT_PATH\", None)\n\nROOT = Path(__file__).resolve().parents[2]\nsys.path.insert(0, str(ROOT))\n\nfrom fastapi.testclient import TestClient  # noqa: E402\n\nfrom cuore.app import create_app  # noqa: E402\n\nVIN = \"ZASFAKPN5J7B88115\"  # the Stelvio -- real corpus, chronic P0455/P0440/P0456\n\nfailures: list[str] = []\nchecks = 0\n\n\ndef check(label: str, cond: bool, detail: str = \"\") -> None:\n    global checks\n    checks += 1\n    if not cond:\n        failures.append(f\"{label}{(' -- ' + detail) if detail else ''}\")\n\n\nclient = TestClient(create_app())\n\n\n# --- 1. open a case via the HTML form ---------------------------------------\n\nopen_resp = client.post(f\"/v/{VIN}/job/open\",\n                        data={\"technician\": \"tester\", \"complaint\": \"CEL, smells like gas\"},\n                        follow_redirects=True)\ncheck(\"opening a case via the HTML form responds 200\", open_resp.status_code == 200,\n      str(open_resp.status_code))\ncheck(\"the job page shows the complaint back\", \"smells like gas\" in open_resp.text)\n\nview = client.get(f\"/api/vehicles/{VIN}/job\").json()\njob = view.get(\"job\")\ncheck(\"a job landed for this VIN\", job is not None, str(view))\njob_id = job[\"id\"] if job else None\ncheck(\"the new job starts open with no outcome\",\n      bool(job) and job[\"status\"] == \"open\" and job[\"outcome\"] is None, str(job))\n\n\n# --- 2. suggested hypotheses include a real-evidenced EVAP one -------------\n\nsuggestions = view.get(\"suggested_hypotheses\", [])\ncheck(\"at least one suggested hypothesis was offered\", len(suggestions) > 0, str(suggestions))\n\nevap_suggestion = next((s for s in suggestions if s.get(\"system\") == \"EVAP\"\n                        and s[\"evidence_for\"]), None)\ncheck(\"an EVAP suggested hypothesis carries >=1 real evidence_for ref\",\n      evap_suggestion is not None, str(suggestions))\nif evap_suggestion is not None:\n    ref = evap_suggestion[\"evidence_for\"][0]\n    check(\"that evidence ref has kind/id/label (a real record, not invented)\",\n          {\"kind\", \"id\", \"label\"} <= set(ref), str(ref))\n\n\n# --- 3. add action + set hypothesis status round trip ----------------------\n\nif job_id and evap_suggestion is not None:\n    add_resp = client.post(f\"/v/{VIN}/job/{job_id}/hypotheses/suggested\", data={\n        \"text\": evap_suggestion[\"text\"], \"system\": evap_suggestion[\"system\"],\n        \"next_test\": evap_suggestion[\"next_test\"],\n        \"evidence_for\": json.dumps(evap_suggestion[\"evidence_for\"]),\n        \"evidence_against\": json.dumps(evap_suggestion[\"evidence_against\"]),\n    }, follow_redirects=True)\n    check(\"promoting a suggested hypothesis via its form responds 200\",\n          add_resp.status_code == 200, str(add_resp.status_code))\n\n    view2 = client.get(f\"/api/vehicles/{VIN}/job\").json()\n    hyps = view2[\"job\"][\"hypotheses\"]\n    check(\"the promoted hypothesis is now on the job's ledger\",\n          any(h[\"text\"] == evap_suggestion[\"text\"] for h in hyps), str(hyps))\n    hyp = next(h for h in hyps if h[\"text\"] == evap_suggestion[\"text\"])\n    check(\"its real evidence_for ref(s) carried over, not re-invented\",\n          len(hyp[\"evidence_for\"]) == len(evap_suggestion[\"evidence_for\"]), str(hyp))\n\n    status_resp = client.post(\n        f\"/v/{VIN}/job/{job_id}/hypotheses/{hyp['id']}/status\",\n        data={\"status\": \"supported\"}, follow_redirects=True)\n    check(\"setting a hypothesis's status via its form responds 200\",\n          status_resp.status_code == 200, str(status_resp.status_code))\n\n    action_resp = client.post(f\"/v/{VIN}/job/{job_id}/actions\",\n                              data={\"kind\": \"test\", \"text\": \"smoke tested recirc line, clean\"},\n                              follow_redirects=True)\n    check(\"recording an action via its form responds 200\",\n          action_resp.status_code == 200, str(action_resp.status_code))\n\n    view3 = client.get(f\"/api/vehicles/{VIN}/job\").json()\n    hyp3 = next(h for h in view3[\"job\"][\"hypotheses\"] if h[\"id\"] == hyp[\"id\"])\n    check(\"the hypothesis status round-tripped to 'supported'\",\n          hyp3[\"status\"] == \"supported\", str(hyp3))\n    check(\"the action round-tripped onto the job's action list\",\n          any(a[\"text\"] == \"smoke tested recirc line, clean\" for a in view3[\"job\"][\"actions\"]),\n          str(view3[\"job\"][\"actions\"]))\nelse:\n    check(\"step 3 skipped: no job/suggestion to work with\", False, \"see checks above\")\n\n\n# --- 4. close requires an outcome, and it sticks ----------------------------\n\nif job_id:\n    bad_close = client.post(f\"/v/{VIN}/job/{job_id}/close\", data={\"outcome\": \"\"})\n    check(\"closing with no outcome is refused, not silently accepted\",\n          bad_close.status_code == 422, str(bad_close.status_code))\n\n    # The tools-used review is mandatory before a close is accepted (see\n    # cuore.services.jobs_bridge.close_job) -- closing with no review and no\n    # stated skip reason must be refused, not silently accepted.\n    unreviewed_close = client.post(f\"/v/{VIN}/job/{job_id}/close\",\n                                   data={\"outcome\": \"fixed\"}, follow_redirects=True)\n    view_unreviewed = client.get(f\"/api/vehicles/{VIN}/job/{job_id}\").json()\n    check(\"closing with no tools review and no skip reason is refused\",\n          view_unreviewed[\"job\"][\"status\"] != \"closed\", str(view_unreviewed[\"job\"]))\n    check(\"the refusal is explained on the re-rendered page\",\n          \"tools used review\" in unreviewed_close.text.lower(), unreviewed_close.text[:2000])\n\n    close_resp = client.post(f\"/v/{VIN}/job/{job_id}/close\",\n                             data={\"outcome\": \"fixed\", \"verdict\": \"ECM recalibrated per TSB\",\n                                   \"tools_review_skip_reason\": \"no usage review captured on this run\"},\n                             follow_redirects=True)\n    check(\"closing with a real outcome and a stated skip reason responds 200\",\n          close_resp.status_code == 200, str(close_resp.status_code))\n\n    view4 = client.get(f\"/api/vehicles/{VIN}/job/{job_id}\").json()\n    check(\"the job is now closed with outcome 'fixed'\",\n          view4[\"job\"][\"status\"] == \"closed\" and view4[\"job\"][\"outcome\"] == \"fixed\",\n          str(view4[\"job\"]))\n    check(\"the skip reason was recorded as a job action, not silently dropped\",\n          any(\"Tools-used review skipped\" in a[\"text\"] for a in view4[\"job\"][\"actions\"]),\n          str(view4[\"job\"][\"actions\"]))\nelse:\n    check(\"step 4 skipped: no job to close\", False, \"see checks above\")\n\n\n# --- 5. the page renders at 400px with no horizontal overflow --------------\n\nprint(\"=== screenshot + overflow at 400px ===\")\nEDGE_CANDIDATES = [\n    r\"C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe\",\n    r\"C:\\Program Files\\Microsoft\\Edge\\Application\\msedge.exe\",\n]\nSCRATCHPAD = Path(r\"C:\\Users\\User\\AppData\\Local\\Temp\\claude\\C--Users-User\"\n                  r\"\\7cb02eb5-e299-4baf-b34b-9eb82aebbf17\\scratchpad\")\n\n\ndef find_edge() -> str:\n    for candidate in EDGE_CANDIDATES:\n        if Path(candidate).exists():\n            return candidate\n    return \"\"\n\n\ndef free_port() -> int:\n    s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)\n    s.bind((\"127.0.0.1\", 0))\n    port = s.getsockname()[1]\n    s.close()\n    return port\n\n\nclass CDP:\n    def __init__(self, ws_url: str) -> None:\n        from websockets.sync.client import connect\n        self.ws = connect(ws_url, max_size=None, open_timeout=20)\n        self._ids = itertools.count(1)\n\n    def send(self, method: str, params: dict | None = None, timeout: float = 20):\n        msg_id = next(self._ids)\n        self.ws.send(json.dumps({\"id\": msg_id, \"method\": method, \"params\": params or {}}))\n        deadline = time.time() + timeout\n        while time.time() < deadline:\n            raw = self.ws.recv(timeout=max(0.1, deadline - time.time()))\n            msg = json.loads(raw)\n            if msg.get(\"id\") == msg_id:\n                if \"error\" in msg:\n                    raise RuntimeError(f\"CDP {method} failed: {msg['error']}\")\n                return msg.get(\"result\", {})\n        raise TimeoutError(f\"CDP {method} timed out waiting for response\")\n\n    def close(self) -> None:\n        try:\n            self.ws.close()\n        except Exception:\n            pass\n\n\ndef wait_for_devtools(port: int, timeout: float = 20) -> None:\n    deadline = time.time() + timeout\n    last_err: Exception | None = None\n    while time.time() < deadline:\n        try:\n            with urllib.request.urlopen(f\"http://127.0.0.1:{port}/json/version\", timeout=2) as r:\n                json.loads(r.read().decode(\"utf-8\"))\n                return\n        except Exception as exc:  # noqa: BLE001\n            last_err = exc\n            time.sleep(0.2)\n    raise RuntimeError(f\"headless Edge devtools endpoint never came up: {last_err}\")\n\n\ndef open_target(port: int, url: str) -> dict:\n    req = urllib.request.Request(f\"http://127.0.0.1:{port}/json/new?{url}\", method=\"PUT\")\n    with urllib.request.urlopen(req, timeout=10) as r:\n        return json.loads(r.read().decode(\"utf-8\"))\n\n\ndef wait_for_port(port: int, timeout: float = 15.0) -> bool:\n    deadline = time.monotonic() + timeout\n    while time.monotonic() < deadline:\n        try:\n            with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:\n                s.settimeout(0.3)\n                s.connect((\"127.0.0.1\", port))\n                return True\n        except OSError:\n            time.sleep(0.2)\n    return False\n\n\nedge = find_edge()\nserver_dir = tempfile.mkdtemp(prefix=\"cuore-check-jobs-server-\")\nport = free_port()\nenv = dict(os.environ)\nenv[\"CUORE_STATE_DIR\"] = server_dir\n\n_SERVER_SNIPPET = f\"\"\"\nimport sys\nsys.path.insert(0, {str(ROOT)!r})\nfrom cuore.app import create_app\nimport uvicorn\n\napp = create_app()\nuvicorn.run(app, host=\"127.0.0.1\", port={port}, log_level=\"warning\")\n\"\"\"\n\nif not edge:\n    check(\"headless Edge is available for screenshots\", False, str(EDGE_CANDIDATES))\nelse:\n    server_proc = subprocess.Popen(\n        [sys.executable, \"-c\", _SERVER_SNIPPET],\n        cwd=str(ROOT), env=env,\n        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,\n    )\n    try:\n        up = wait_for_port(port)\n        check(\"uvicorn came up on the free port\", up, f\"port {port}\")\n        if up:\n            # Seed a real open job on the server's own state dir, so the\n            # page under screenshot renders the full stepper, not the empty\n            # \"open a case\" form.\n            data = urllib.parse.urlencode(\n                {\"technician\": \"tester\", \"complaint\": \"CEL, smells like gas\"}).encode()\n            try:\n                urllib.request.urlopen(\n                    urllib.request.Request(f\"http://127.0.0.1:{port}/v/{VIN}/job/open\",\n                                           data=data, method=\"POST\"), timeout=30)\n            except Exception as exc:  # noqa: BLE001\n                check(\"seeding a job on the screenshot server\", False, str(exc))\n\n            time.sleep(0.3)\n            devtools_port = free_port()\n            profile_dir = Path(tempfile.mkdtemp(prefix=\"cuore-edge-jobs-\"))\n            edge_proc = subprocess.Popen(\n                [edge, \"--headless=new\", f\"--remote-debugging-port={devtools_port}\",\n                 f\"--user-data-dir={profile_dir}\", \"--no-first-run\", \"--window-size=400,1400\",\n                 \"about:blank\"],\n                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,\n            )\n            try:\n                wait_for_devtools(devtools_port)\n                url = f\"http://127.0.0.1:{port}/v/{VIN}/job\"\n                target = open_target(devtools_port, url)\n                cdp = CDP(target[\"webSocketDebuggerUrl\"])\n                try:\n                    cdp.send(\"Page.enable\")\n                    cdp.send(\"Runtime.enable\")\n                    time.sleep(1.5)\n                    cdp.send(\"Emulation.setDeviceMetricsOverride\", {\n                        \"width\": 400, \"height\": 1400, \"deviceScaleFactor\": 1, \"mobile\": True,\n                    })\n                    time.sleep(0.6)\n\n                    nav = cdp.send(\"Runtime.evaluate\", {\n                        \"expression\": \"document.readyState\", \"returnByValue\": True})\n                    check(\"job page loaded in the headless browser\",\n                          nav.get(\"result\", {}).get(\"value\") in (\"complete\", \"interactive\"),\n                          str(nav))\n\n                    overflow = cdp.send(\"Runtime.evaluate\", {\n                        \"expression\": (\n                            \"JSON.stringify({sw: document.documentElement.scrollWidth, \"\n                            \"cw: document.documentElement.clientWidth})\"),\n                        \"returnByValue\": True,\n                    })\n                    dims = json.loads(overflow.get(\"result\", {}).get(\"value\", \"{}\"))\n                    sw, cw = dims.get(\"sw\", 0), dims.get(\"cw\", 0)\n                    check(\"no page-level horizontal overflow at 400px\",\n                         sw <= cw + 1, f\"scrollWidth={sw} clientWidth={cw}\")\n\n                    SCRATCHPAD.mkdir(parents=True, exist_ok=True)\n                    out_path = SCRATCHPAD / \"job_phone.png\"\n                    shot = cdp.send(\"Page.captureScreenshot\",\n                                   {\"format\": \"png\", \"captureBeyondViewport\": False})\n                    out_path.write_bytes(base64.b64decode(shot[\"data\"]))\n                    check(\"screenshot job_phone.png captured\",\n                         out_path.exists() and out_path.stat().st_size > 0, str(out_path))\n                    if out_path.exists():\n                        print(f\"  wrote {out_path} ({out_path.stat().st_size} bytes)\")\n                finally:\n                    cdp.close()\n            except Exception as exc:  # noqa: BLE001\n                check(\"headless Edge captured the job page screenshot over CDP\", False,\n                     f\"{type(exc).__name__}: {exc}\")\n            finally:\n                edge_proc.terminate()\n                try:\n                    edge_proc.wait(timeout=5)\n                except Exception:\n                    edge_proc.kill()\n                from _edge_cleanup import kill_edge_profile\n                kill_edge_profile(profile_dir)\n    finally:\n        server_proc.terminate()\n        try:\n            server_proc.wait(timeout=5)\n        except Exception:\n            server_proc.kill()\n\n\n# --- report ------------------------------------------------------------------\n\nprint()\nif failures:\n    print(f\"{len(failures)}/{checks} check(s) failed:\")\n    for f in failures:\n        print(f\"  - {f}\")\n    sys.exit(1)\nprint(f\"all {checks} checks passed\")\n","numLines":379,"startLine":1,"totalLines":379}},"sourceToolAssistantUUID":"6360fe30-6492-4726-89ba-71b0662895a7","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
