ode:hover { border-color: var(--accent); color: var(--accent); }\n624:.card-details {\n628:.card-details > summary {\n633:.card-details > summary::-webkit-details-marker { display: none; }\n634:.card-details > summary::before {\n637:.card-details[open] > summary::before { transform: rotate(90deg); }\n642:.count-badge .chip.sm { font-size: 9px; padding: 1px 5px; }\n644:.card-details > summary { border-bottom: 1px solid transparent; }\n645:.card-details[open] > summary { border-bottom: 1px solid var(--rule); }\n658:table.codes-table .chip { font-size: 9px; padding: 1px 4px; letter-spacing: .03em; }\n675:.chip.status-active { color: var(--sev-returned); background: var(--sev-returned-bg); border-color: var(--sev-returned); }\n676:.chip.status-cleared_unverified { color: var(--sev-chronic); background: var(--sev-chronic-bg); border-color: var(--sev-chronic); }\n677:.chip.status-stale { color: var(--ink-3); background: var(--surface-2); }\n719:.chip-code.sm { min-height: 44px; font-size: 11px; padding: 2px 9px; }\n752:.small { font-size: 13px; }\n760:.btn { min-height: 44px; }\n844: * (.chip.chronic amber, .chip.plain grey-neutral) rather than new colours --\n850: * target per the mechanic-UX baseline already set for .btn/.jump-chip. */\n879:.feel-card .feel-tags .chip.expect { color: var(--ok); background: var(--ok-bg); }\n880:.feel-card .feel-tags .chip.not-expect { color: var(--ink-3); background: var(--surface-2);\n1029:.tools-review-panel .chip.chronic { margin-left: 6px; }\n1113: * .btn.primary/.btn-verdict.primary uses, which read as \"a\" primary\n1115: * drops back to the same quiet outline as a plain .btn. */\n1116:.btn, .btn.primary, .btn-verdict.primary { background: transparent; border-color: var(--rule); color: var(--ink); }\n1117:.btn:hover, .btn.primary:hover, .btn-verdict.primary:hover { border-color: var(--ink-3); filter: none; }\n1118:.flow-next.btn { background: var(--accent); border-color: var(--accent); color: #fff; }\n1119:.flow-next.btn:hover { fi