{"parentUuid":"6b01db5b-e2d5-487a-96cd-2283ed18d047","isSidechain":true,"agentId":"acbfb63ee5bb37cdd","message":{"model":"claude-sonnet-5","id":"msg_011CfpiDCRzYKXmkR1j84u99","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01K69F3vXxV3wuffqiuLGmd9","name":"Read","input":{"file_path":"C:\\Users\\User\\mcp-servers\\cuore\\web\\templates\\_experience.html"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":6982,"cache_read_input_tokens":56635,"cache_creation":{"ephemeral_5m_input_tokens":6982,"ephemeral_1h_input_tokens":0},"output_tokens":2,"service_tier":"standard","inference_geo":"not_available"},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_01K69F3vXxV3wuffqiuLGmd9":{"file_path":"C:\\Users\\User\\mcp-servers\\cuore\\web\\templates\\_experience.html"}},"serverClassifierRequest":"63b2fcf6-38e8-4b29-a1b5-09a1db9cca0a","apiBlockIndex":1,"requestId":"req_011CfpiDCANKAdnrdB9ShaWT","attributionAgent":"general-purpose","type":"assistant","uuid":"4b5cb062-41f5-4ded-807f-c5d07dbbad2d","timestamp":"2026-10-08T11:43:48.124Z","effort":"high","perTurnEffort":null,"userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
{"parentUuid":"4b5cb062-41f5-4ded-807f-c5d07dbbad2d","isSidechain":true,"promptId":"dc915aa5-562a-4d40-ab12-39bf546dd9ee","agentId":"acbfb63ee5bb37cdd","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01K69F3vXxV3wuffqiuLGmd9","type":"tool_result","content":"1\t{# Reusable \"Others' experience\" card: links other owners/forums/videos have\n2\t   published about a code, family or job. Fed by the `experience_links`\n3\t   Jinja global (registered as an import-time side effect by\n4\t   cuore/web/experience_globals.py -- see that module's docstring) via a\n5\t   page-local `exp = experience_links(...)` set before this include.\n6\t   Guarded so a page still renders -- with the empty state below -- before\n7\t   that global lands, and before mes.experience itself lands. #}\n8\t{% set exp = exp if exp is defined else {\"links\": [], \"count\": 0} %}\n9\t\n10\t{% macro exp_row(l) %}\n11\t  <div class=\"exp-row\">\n12\t    <span class=\"exp-icon\" aria-hidden=\"true\" title=\"{{ l.kind or '' }}\">{{ \"▶\" if l.kind == \"how_to_video\" else \"✎\" }}</span>\n13\t    <div class=\"exp-main\">\n14\t      <a href=\"{{ l.url }}\" target=\"_blank\" rel=\"noopener\">{{ l.title }}</a>\n15\t      <div class=\"small muted\">{{ l.source }}{% if l.date %} &middot; {{ l.date }}{% endif %}</div>\n16\t      {% if l.covers %}<div class=\"small muted\">covers: {{ l.covers }}</div>{% endif %}\n17\t    </div>\n18\t    <div class=\"exp-chips\">\n19\t      {% if l.reputation %}<span class=\"chip {{ 'ok' if l.reputation == 'high' else 'plain' }}\">{{ l.reputation }}</span>{% endif %}\n20\t      {% if l.vehicle_fit %}<span class=\"chip plain\">{{ l.vehicle_fit }}</span>{% endif %}\n21\t    </div>\n22\t  </div>\n23\t{% endmacro %}\n24\t\n25\t<div class=\"panel experience-card\">\n26\t  <h3>Others' experience{% if exp.count %} <span class=\"count-badge\">{{ exp.count }}</span>{% endif %}</h3>\n27\t  {% if exp.links %}\n28\t    {% for l in exp.links[:3] %}{{ exp_row(l) }}{% endfor %}\n29\t    {% if exp.links|length > 3 %}\n30\t    <details class=\"exp-more\">\n31\t      <summary>+{{ exp.links|length - 3 }} more</summary>\n32\t      {% for l in exp.links[3:] %}{{ exp_row(l) }}{% endfor %}\n33\t    </details>\n34\t    {% endif %}\n35\t    {% set verified_dates = exp.links|map(attribute=\"verified_at\")|select|list %}\n36\t    {% if verified_dates %}\n37\t      <p class=\"small muted exp-verified\">verified {{ verified_dates|max }}</p>\n38\t    {% endif %}\n39\t  {% else %}\n40\t    <p class=\"muted small\">No experience links yet for this item.</p>\n41\t  {% endif %}\n42\t</div>\n43\t"}]},"uuid":"99ab0552-f37d-43d0-8c80-30c0681af74e","timestamp":"2026-10-08T11:43:48.150Z","toolUseResult":{"type":"text","file":{"filePath":"C:\\Users\\User\\mcp-servers\\cuore\\web\\templates\\_experience.html","content":"{# Reusable \"Others' experience\" card: links other owners/forums/videos have\n   published about a code, family or job. Fed by the `experience_links`\n   Jinja global (registered as an import-time side effect by\n   cuore/web/experience_globals.py -- see that module's docstring) via a\n   page-local `exp = experience_links(...)` set before this include.\n   Guarded so a page still renders -- with the empty state below -- before\n   that global lands, and before mes.experience itself lands. #}\n{% set exp = exp if exp is defined else {\"links\": [], \"count\": 0} %}\n\n{% macro exp_row(l) %}\n  <div class=\"exp-row\">\n    <span class=\"exp-icon\" aria-hidden=\"true\" title=\"{{ l.kind or '' }}\">{{ \"▶\" if l.kind == \"how_to_video\" else \"✎\" }}</span>\n    <div class=\"exp-main\">\n      <a href=\"{{ l.url }}\" target=\"_blank\" rel=\"noopener\">{{ l.title }}</a>\n      <div class=\"small muted\">{{ l.source }}{% if l.date %} &middot; {{ l.date }}{% endif %}</div>\n      {% if l.covers %}<div class=\"small muted\">covers: {{ l.covers }}</div>{% endif %}\n    </div>\n    <div class=\"exp-chips\">\n      {% if l.reputation %}<span class=\"chip {{ 'ok' if l.reputation == 'high' else 'plain' }}\">{{ l.reputation }}</span>{% endif %}\n      {% if l.vehicle_fit %}<span class=\"chip plain\">{{ l.vehicle_fit }}</span>{% endif %}\n    </div>\n  </div>\n{% endmacro %}\n\n<div class=\"panel experience-card\">\n  <h3>Others' experience{% if exp.count %} <span class=\"count-badge\">{{ exp.count }}</span>{% endif %}</h3>\n  {% if exp.links %}\n    {% for l in exp.links[:3] %}{{ exp_row(l) }}{% endfor %}\n    {% if exp.links|length > 3 %}\n    <details class=\"exp-more\">\n      <summary>+{{ exp.links|length - 3 }} more</summary>\n      {% for l in exp.links[3:] %}{{ exp_row(l) }}{% endfor %}\n    </details>\n    {% endif %}\n    {% set verified_dates = exp.links|map(attribute=\"verified_at\")|select|list %}\n    {% if verified_dates %}\n      <p class=\"small muted exp-verified\">verified {{ verified_dates|max }}</p>\n    {% endif %}\n  {% else %}\n    <p class=\"muted small\">No experience links yet for this item.</p>\n  {% endif %}\n</div>\n","numLines":43,"startLine":1,"totalLines":43}},"sourceToolAssistantUUID":"4b5cb062-41f5-4ded-807f-c5d07dbbad2d","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
{"parentUuid":"99ab0552-f37d-43d0-8c80-30c0681af74e","isSidechain":true,"agentId":"acbfb63ee5bb37cdd","message":{"model":"claude-sonnet-5","id":"msg_011CfpiDCRzYKXmkR1j84u99","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_0164RGFUSXoaJsfrvFxwoQTC","name":"Read","input":{"file_path":"C:\\Users\\User\\mcp-servers\\cuore\\tests\\check_experience_page.py"},"caller":{"type":"direct"}}],"container":null,"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":6982,"cache_read_input_tokens":56635,"output_tokens":163,"output_tokens_details":{"thinking_tokens":12},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":0,"ephemeral_5m_input_tokens":6982},"inference_geo":"not_available","iterations":[{"input_tokens":2,"output_tokens":163,"cache_read_input_tokens":56635,"cache_creation_input_tokens":6982,"cache_creation":{"ephemeral_5m_input_tokens":6982,"ephemeral_1h_input_tokens":0},"type":"message"}],"speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_0164RGFUSXoaJsfrvFxwoQTC":{"file_path":"C:\\Users\\User\\mcp-servers\\cuore\\tests\\check_experience_page.py"}},"serverClassifierRequest":"63b2fcf6-38e8-4b29-a1b5-09a1db9cca0a","apiBlockIndex":2,"requestId":"req_011CfpiDCANKAdnrdB9ShaWT","attributionAgent":"general-purpose","type":"assistant","uuid":"c09921be-82d7-4633-9049-837b95b22b5f","timestamp":"2026-10-08T11:43:48.509Z","effort":"high","perTurnEffort":null,"userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
{"parentUuid":"c09921be-82d7-4633-9049-837b95b22b5f","isSidechain":true,"promptId":"dc915aa5-562a-4d40-ab12-39bf546dd9ee","agentId":"acbfb63ee5bb37cdd","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0164RGFUSXoaJsfrvFxwoQTC","type":"tool_result","content":"1\t\"\"\"Checks for the \"Others' experience\" feature: cuore/services/experience_bridge.py,\n2\tcuore/api/experience.py, and the _experience.html card included on code.html,\n3\tvehicle.html (dossier open-work), maintenance.html, service_hub.html and\n4\ttimeline.html.\n5\t\n6\tmes.experience (for_code/for_family/for_job/all) is built in parallel by\n7\tanother agent and may not exist yet -- experience_bridge degrades to an\n8\tempty result in that case (checked directly, no monkeypatch). The\n9\tmerge/de-dup/ordering contract and every page's rendering of a non-empty\n10\tresult are checked by monkeypatching ``experience_bridge._experience_module``\n11\twith a small fixture class -- the same function\n12\t``cuore.web.experience_globals``'s registered Jinja global calls through to,\n13\tso one patch point covers the API and every page.\n14\t\n15\tRun:\n16\t    .venv/Scripts/python.exe cuore/tests/check_experience_page.py\n17\t\"\"\"\n18\t\n19\tfrom __future__ import annotations\n20\t\n21\timport os\n22\timport subprocess\n23\timport sys\n24\timport tempfile\n25\tfrom pathlib import Path\n26\t\n27\tos.environ[\"CUORE_STATE_DIR\"] = tempfile.mkdtemp(prefix=\"cuore-check-experience-\")\n28\tos.environ.pop(\"CUORE_AUDIT_PATH\", None)\n29\t\n30\tROOT = Path(__file__).resolve().parents[2]\n31\tsys.path.insert(0, str(ROOT))\n32\t\n33\tfrom fastapi.testclient import TestClient  # noqa: E402\n34\t\n35\tfrom cuore.app import create_app  # noqa: E402\n36\tfrom cuore.services import experience_bridge  # noqa: E402\n37\tfrom cuore.web import experience_globals  # noqa: E402, F401 -- side-effect import, registers the global\n38\tfrom cuore.api import experience as experience_api  # noqa: E402\n39\t\n40\tVIN = \"ZASFAKPN5J7B88115\"\n41\t\n42\tfailures: list[str] = []\n43\tchecks = 0\n44\t\n45\t\n46\tdef check(label: str, cond: bool, detail: str = \"\") -> None:\n47\t    global checks\n48\t    checks += 1\n49\t    mark = \"ok\" if cond else \"FAIL\"\n50\t    print(f\"  [{mark}] {label}\" + (f\" -- {detail}\" if detail and not cond else \"\"))\n51\t    if not cond:\n52\t        failures.append(label)\n53\t\n54\t\n55\tdef _app():\n56\t    app = create_app()\n57\t    if not any(getattr(r, \"path\", \"\") == \"/experience\" for r in app.routes):\n58\t        app.include_router(experience_api.router, prefix=\"/api\")\n59\t    return app\n60\t\n61\t\n62\tclient = TestClient(_app())\n63\t\n64\t\n65\tclass _FakeExperience:\n66\t    \"\"\"Stands in for mes.experience: for_code/for_family/for_job/all().\"\"\"\n67\t\n68\t    VIDEO = {\"id\": \"v1\", \"keys\": [\"P0456\"], \"title\": \"EVAP smoke test walkthrough\",\n69\t             \"url\": \"https://youtube.example/v1\", \"source\": \"youtube\",\n70\t             \"kind\": \"how_to_video\", \"covers\": \"smoke testing the EVAP system\",\n71\t             \"vehicle_fit\": \"Giulia 2.0T\", \"date\": \"2026-01-15\",\n72\t             \"reputation\": \"high\", \"verified_at\": \"2026-09-01\", \"verified_how\": \"manual\"}\n73\t    THREAD = {\"id\": \"t1\", \"keys\": [\"P0456\"], \"title\": \"P0456 after battery disconnect\",\n74\t              \"url\": \"https://stelvioforum.example/t1\", \"source\": \"stelvioforum\",\n75\t              \"kind\": \"forum_thread\", \"covers\": \"P0456 recurrence\", \"vehicle_fit\": \"Stelvio\",\n76\t              \"date\": \"2025-11-01\", \"reputation\": \"medium\", \"verified_at\": \"2026-08-01\",\n77\t              \"verified_how\": \"manual\"}\n78\t    OLD_HIGH = {\"id\": \"o1\", \"keys\": [\"EVAP\"], \"title\": \"Old but trusted EVAP writeup\",\n79\t                \"url\": \"https://alfabb.example/o1\", \"source\": \"alfabb\", \"kind\": \"owner_report\",\n80\t                \"covers\": \"EVAP family\", \"vehicle_fit\": \"Stelvio\", \"date\": \"2020-01-01\",\n81\t                \"reputation\": \"high\", \"verified_at\": \"2026-01-01\", \"verified_how\": \"manual\"}\n82\t\n83\t    def for_code(self, code, include_siblings=False):\n84\t        return [dict(self.VIDEO), dict(self.THREAD)] if code == \"P0456\" else []\n85\t\n86\t    def for_family(self, family, include_siblings=False):\n87\t        # VIDEO deliberately duplicated here -- same id as the code lookup's\n88\t        # VIDEO -- to exercise de-dup across two different lookups.\n89\t        return [dict(self.OLD_HIGH), dict(self.VIDEO)] if family == \"EVAP\" else []\n90\t\n91\t    def for_job(self, job, include_siblings=False):\n92\t        return [dict(self.VIDEO)] if job == \"oil_change\" else []\n93\t\n94\t    def all(self):\n95\t        return [dict(self.VIDEO), dict(self.THREAD), dict(self.OLD_HIGH)]\n96\t\n97\t\n98\t_fake = _FakeExperience()\n99\t_real_module_lookup = experience_bridge._experience_module\n100\t\n101\t\n102\tdef _patched():\n103\t    experience_bridge._experience_module = lambda: _fake\n104\t\n105\t\n106\tdef _unpatched():\n107\t    experience_bridge._experience_module = _real_module_lookup\n108\t\n109\t\n110\t# ===========================================================================\n111\t# 1. bridge: merge, de-dup, order; and the no-module / no-args degrade path\n112\t# ===========================================================================\n113\t\n114\tprint(\"=== experience_bridge: merge / de-dup / order ===\")\n115\t_patched()\n116\ttry:\n117\t    result = experience_bridge.links_for(code=\"P0456\", family=\"EVAP\")\n118\t    ids = [l[\"id\"] for l in result[\"links\"]]\n119\t    check(\"merge: 3 unique links from overlapping code+family lookups\",\n120\t          result[\"count\"] == 3, str(ids))\n121\t    check(\"de-dup: the link present in both lookups appears once\", ids.count(\"v1\") == 1, str(ids))\n122\t    check(\"order: high reputation before medium\", ids.index(\"t1\") > ids.index(\"v1\"), str(ids))\n123\t    check(\"order: how_to_video ranks ahead of an equally-high-reputation non-video\",\n124\t          ids.index(\"v1\") < ids.index(\"o1\"), str(ids))\n125\t    empty = experience_bridge.links_for()\n126\t    check(\"no code/family/job given -> empty result, no error\",\n127\t          empty == {\"links\": [], \"count\": 0}, str(empty))\n128\tfinally:\n129\t    _unpatched()\n130\t\n131\tno_module = experience_bridge.links_for(code=\"P0456\")\n132\tcheck(\"mes.experience genuinely absent degrades to empty, no exception\",\n133\t      no_module == {\"links\": [], \"count\": 0} or isinstance(no_module.get(\"links\"), list), str(no_module))\n134\t\n135\t\n136\t# ===========================================================================\n137\t# 2. API: GET /api/experience\n138\t# ===========================================================================\n139\t\n140\tprint(\"=== /api/experience ===\")\n141\t_patched()\n142\ttry:\n143\t    api_resp = client.get(\"/api/experience\", params={\"code\": \"P0456\", \"family\": \"EVAP\"})\n144\t    check(\"API responds 200\", api_resp.status_code == 200, str(api_resp.status_code))\n145\t    check(\"API returns merged de-duplicated links\", api_resp.json().get(\"count\") == 3, api_resp.text)\n146\t    api_empty = client.get(\"/api/experience\")\n147\t    check(\"API with no params returns empty, not an error\",\n148\t          api_empty.status_code == 200 and api_empty.json() == {\"links\": [], \"count\": 0})\n149\tfinally:\n150\t    _unpatched()\n151\t\n152\t\n153\t# ===========================================================================\n154\t# 3. pages: card renders (video + thread row, rel=noopener), dossier,\n155\t#    maintenance, service hub, timeline, and the empty state\n156\t# ===========================================================================\n157\t\n158\tprint(\"=== code page card ===\")\n159\t_patched()\n160\ttry:\n161\t    code_resp = client.get(f\"/v/{VIN}/code/P0456\")\n162\t    check(\"code page responds 200\", code_resp.status_code == 200, str(code_resp.status_code))\n163\t    check(\"Others' experience card present\", \"Others&#39; experience\" in code_resp.text\n164\t          or \"Others' experience\" in code_resp.text)\n165\t    check(\"a video row and a thread row both appear\",\n166\t          \"EVAP smoke test walkthrough\" in code_resp.text\n167\t          and \"P0456 after battery disconnect\" in code_resp.text)\n168\t    check(\"external links carry rel=noopener\", 'rel=\"noopener\"' in code_resp.text)\n169\tfinally:\n170\t    _unpatched()\n171\t\n172\tprint(\"=== dossier open-work card, maintenance, service hub, timeline ===\")\n173\t_patched()\n174\ttry:\n175\t    dossier_resp = client.get(f\"/v/{VIN}\")\n176\t    check(\"dossier responds 200\", dossier_resp.status_code == 200, str(dossier_resp.status_code))\n177\t\n178\t    maint_resp = client.get(f\"/v/{VIN}/maintenance\")\n179\t    check(\"maintenance page responds 200 with the card or the empty state\",\n180\t          maint_resp.status_code == 200 and (\"Others&#39; experience\" in maint_resp.text\n181\t          or \"Others' experience\" in maint_resp.text))\n182\t\n183\t    hub_resp = client.get(f\"/v/{VIN}/service-hub\")\n184\t    check(\"service hub page responds 200 with the card or the empty state\",\n185\t          hub_resp.status_code == 200 and (\"Others&#39; experience\" in hub_resp.text\n186\t          or \"Others' experience\" in hub_resp.text))\n187\t\n188\t    timeline_resp = client.get(f\"/v/{VIN}/timeline\")\n189\t    check(\"timeline page responds 200\", timeline_resp.status_code == 200, str(timeline_resp.status_code))\n190\tfinally:\n191\t    _unpatched()\n192\t\n193\tprint(\"=== empty state (no fixture patched) ===\")\n194\t# P0456 now has real curated entries in mes.experience (landed 2026-10-07),\n195\t# so it no longer exercises the empty path. P0098 is a code that genuinely\n196\t# appeared in this VIN's own logs (so the page itself resolves, not a 404)\n197\t# but has no mes.experience entry and no EVAP/misfire family match\n198\t# (code.html only maps P03*/P04* to a family), so it still exercises the\n199\t# real \"nothing found\" render rather than a fixture gap.\n200\tempty_resp = client.get(f\"/v/{VIN}/code/P0098\")\n201\tcheck(\"empty state renders without error when mes.experience/fixture is absent\",\n202\t      empty_resp.status_code == 200 and \"No experience links yet for this item\" in empty_resp.text,\n203\t      str(empty_resp.status_code))\n204\t\n205\t\n206\t# ===========================================================================\n207\t# 4. companion checks (lightweight only -- the screenshot-based\n208\t#    check_timeline_page.py is intentionally left for a full CI run)\n209\t# ===========================================================================\n210\t\n211\tprint(\"=== companion checks ===\")\n212\tfor script in (\"check_dossier_page.py\", \"check_maintenance_page.py\",\n213\t              \"check_service_page.py\", \"check_api.py\"):\n214\t    proc = subprocess.run([sys.executable, str(Path(__file__).parent / script)],\n215\t                          cwd=str(ROOT), capture_output=True, text=True)\n216\t    ok = proc.returncode == 0\n217\t    check(f\"{script} exits 0\", ok, (proc.stdout[-1200:] + proc.stderr[-1200:]) if not ok else \"\")\n218\t\n219\t\n220\tprint()\n221\tif failures:\n222\t    print(f\"{len(failures)}/{checks} check(s) failed:\")\n223\t    for f in failures:\n224\t        print(f\"  - {f}\")\n225\t    sys.exit(1)\n226\tprint(f\"{checks}/{checks} checks passed\")\n227\t"}]},"uuid":"4238edb3-8631-45bb-818e-78ad817a1693","timestamp":"2026-10-08T11:43:48.538Z","toolUseResult":{"type":"text","file":{"filePath":"C:\\Users\\User\\mcp-servers\\cuore\\tests\\check_experience_page.py","content":"\"\"\"Checks for the \"Others' experience\" feature: cuore/services/experience_bridge.py,\ncuore/api/experience.py, and the _experience.html card included on code.html,\nvehicle.html (dossier open-work), maintenance.html, service_hub.html and\ntimeline.html.\n\nmes.experience (for_code/for_family/for_job/all) is built in parallel by\nanother agent and may not exist yet -- experience_bridge degrades to an\nempty result in that case (checked directly, no monkeypatch). The\nmerge/de-dup/ordering contract and every page's rendering of a non-empty\nresult are checked by monkeypatching ``experience_bridge._experience_module``\nwith a small fixture class -- the same function\n``cuore.web.experience_globals``'s registered Jinja global calls through to,\nso one patch point covers the API and every page.\n\nRun:\n    .venv/Scripts/python.exe cuore/tests/check_experience_page.py\n\"\"\"\n\nfrom __future__ import annotations\n\nimport os\nimport subprocess\nimport sys\nimport tempfile\nfrom pathlib import Path\n\nos.environ[\"CUORE_STATE_DIR\"] = tempfile.mkdtemp(prefix=\"cuore-check-experience-\")\nos.environ.pop(\"CUORE_AUDIT_PATH\", None)\n\nROOT = Path(__file__).resolve().parents[2]\nsys.path.insert(0, str(ROOT))\n\nfrom fastapi.testclient import TestClient  # noqa: E402\n\nfrom cuore.app import create_app  # noqa: E402\nfrom cuore.services import experience_bridge  # noqa: E402\nfrom cuore.web import experience_globals  # noqa: E402, F401 -- side-effect import, registers the global\nfrom cuore.api import experience as experience_api  # noqa: E402\n\nVIN = \"ZASFAKPN5J7B88115\"\n\nfailures: list[str] = []\nchecks = 0\n\n\ndef check(label: str, cond: bool, detail: str = \"\") -> None:\n    global checks\n    checks += 1\n    mark = \"ok\" if cond else \"FAIL\"\n    print(f\"  [{mark}] {label}\" + (f\" -- {detail}\" if detail and not cond else \"\"))\n    if not cond:\n        failures.append(label)\n\n\ndef _app():\n    app = create_app()\n    if not any(getattr(r, \"path\", \"\") == \"/experience\" for r in app.routes):\n        app.include_router(experience_api.router, prefix=\"/api\")\n    return app\n\n\nclient = TestClient(_app())\n\n\nclass _FakeExperience:\n    \"\"\"Stands in for mes.experience: for_code/for_family/for_job/all().\"\"\"\n\n    VIDEO = {\"id\": \"v1\", \"keys\": [\"P0456\"], \"title\": \"EVAP smoke test walkthrough\",\n             \"url\": \"https://youtube.example/v1\", \"source\": \"youtube\",\n             \"kind\": \"how_to_video\", \"covers\": \"smoke testing the EVAP system\",\n             \"vehicle_fit\": \"Giulia 2.0T\", \"date\": \"2026-01-15\",\n             \"reputation\": \"high\", \"verified_at\": \"2026-09-01\", \"verified_how\": \"manual\"}\n    THREAD = {\"id\": \"t1\", \"keys\": [\"P0456\"], \"title\": \"P0456 after battery disconnect\",\n              \"url\": \"https://stelvioforum.example/t1\", \"source\": \"stelvioforum\",\n              \"kind\": \"forum_thread\", \"covers\": \"P0456 recurrence\", \"vehicle_fit\": \"Stelvio\",\n              \"date\": \"2025-11-01\", \"reputation\": \"medium\", \"verified_at\": \"2026-08-01\",\n              \"verified_how\": \"manual\"}\n    OLD_HIGH = {\"id\": \"o1\", \"keys\": [\"EVAP\"], \"title\": \"Old but trusted EVAP writeup\",\n                \"url\": \"https://alfabb.example/o1\", \"source\": \"alfabb\", \"kind\": \"owner_report\",\n                \"covers\": \"EVAP family\", \"vehicle_fit\": \"Stelvio\", \"date\": \"2020-01-01\",\n                \"reputation\": \"high\", \"verified_at\": \"2026-01-01\", \"verified_how\": \"manual\"}\n\n    def for_code(self, code, include_siblings=False):\n        return [dict(self.VIDEO), dict(self.THREAD)] if code == \"P0456\" else []\n\n    def for_family(self, family, include_siblings=False):\n        # VIDEO deliberately duplicated here -- same id as the code lookup's\n        # VIDEO -- to exercise de-dup across two different lookups.\n        return [dict(self.OLD_HIGH), dict(self.VIDEO)] if family == \"EVAP\" else []\n\n    def for_job(self, job, include_siblings=False):\n        return [dict(self.VIDEO)] if job == \"oil_change\" else []\n\n    def all(self):\n        return [dict(self.VIDEO), dict(self.THREAD), dict(self.OLD_HIGH)]\n\n\n_fake = _FakeExperience()\n_real_module_lookup = experience_bridge._experience_module\n\n\ndef _patched():\n    experience_bridge._experience_module = lambda: _fake\n\n\ndef _unpatched():\n    experience_bridge._experience_module = _real_module_lookup\n\n\n# ===========================================================================\n# 1. bridge: merge, de-dup, order; and the no-module / no-args degrade path\n# ===========================================================================\n\nprint(\"=== experience_bridge: merge / de-dup / order ===\")\n_patched()\ntry:\n    result = experience_bridge.links_for(code=\"P0456\", family=\"EVAP\")\n    ids = [l[\"id\"] for l in result[\"links\"]]\n    check(\"merge: 3 unique links from overlapping code+family lookups\",\n          result[\"count\"] == 3, str(ids))\n    check(\"de-dup: the link present in both lookups appears once\", ids.count(\"v1\") == 1, str(ids))\n    check(\"order: high reputation before medium\", ids.index(\"t1\") > ids.index(\"v1\"), str(ids))\n    check(\"order: how_to_video ranks ahead of an equally-high-reputation non-video\",\n          ids.index(\"v1\") < ids.index(\"o1\"), str(ids))\n    empty = experience_bridge.links_for()\n    check(\"no code/family/job given -> empty result, no error\",\n          empty == {\"links\": [], \"count\": 0}, str(empty))\nfinally:\n    _unpatched()\n\nno_module = experience_bridge.links_for(code=\"P0456\")\ncheck(\"mes.experience genuinely absent degrades to empty, no exception\",\n      no_module == {\"links\": [], \"count\": 0} or isinstance(no_module.get(\"links\"), list), str(no_module))\n\n\n# ===========================================================================\n# 2. API: GET /api/experience\n# ===========================================================================\n\nprint(\"=== /api/experience ===\")\n_patched()\ntry:\n    api_resp = client.get(\"/api/experience\", params={\"code\": \"P0456\", \"family\": \"EVAP\"})\n    check(\"API responds 200\", api_resp.status_code == 200, str(api_resp.status_code))\n    check(\"API returns merged de-duplicated links\", api_resp.json().get(\"count\") == 3, api_resp.text)\n    api_empty = client.get(\"/api/experience\")\n    check(\"API with no params returns empty, not an error\",\n          api_empty.status_code == 200 and api_empty.json() == {\"links\": [], \"count\": 0})\nfinally:\n    _unpatched()\n\n\n# ===========================================================================\n# 3. pages: card renders (video + thread row, rel=noopener), dossier,\n#    maintenance, service hub, timeline, and the empty state\n# ===========================================================================\n\nprint(\"=== code page card ===\")\n_patched()\ntry:\n    code_resp = client.get(f\"/v/{VIN}/code/P0456\")\n    check(\"code page responds 200\", code_resp.status_code == 200, str(code_resp.status_code))\n    check(\"Others' experience card present\", \"Others&#39; experience\" in code_resp.text\n          or \"Others' experience\" in code_resp.text)\n    check(\"a video row and a thread row both appear\",\n          \"EVAP smoke test walkthrough\" in code_resp.text\n          and \"P0456 after battery disconnect\" in code_resp.text)\n    check(\"external links carry rel=noopener\", 'rel=\"noopener\"' in code_resp.text)\nfinally:\n    _unpatched()\n\nprint(\"=== dossier open-work card, maintenance, service hub, timeline ===\")\n_patched()\ntry:\n    dossier_resp = client.get(f\"/v/{VIN}\")\n    check(\"dossier responds 200\", dossier_resp.status_code == 200, str(dossier_resp.status_code))\n\n    maint_resp = client.get(f\"/v/{VIN}/maintenance\")\n    check(\"maintenance page responds 200 with the card or the empty state\",\n          maint_resp.status_code == 200 and (\"Others&#39; experience\" in maint_resp.text\n          or \"Others' experience\" in maint_resp.text))\n\n    hub_resp = client.get(f\"/v/{VIN}/service-hub\")\n    check(\"service hub page responds 200 with the card or the empty state\",\n          hub_resp.status_code == 200 and (\"Others&#39; experience\" in hub_resp.text\n          or \"Others' experience\" in hub_resp.text))\n\n    timeline_resp = client.get(f\"/v/{VIN}/timeline\")\n    check(\"timeline page responds 200\", timeline_resp.status_code == 200, str(timeline_resp.status_code))\nfinally:\n    _unpatched()\n\nprint(\"=== empty state (no fixture patched) ===\")\n# P0456 now has real curated entries in mes.experience (landed 2026-10-07),\n# so it no longer exercises the empty path. P0098 is a code that genuinely\n# appeared in this VIN's own logs (so the page itself resolves, not a 404)\n# but has no mes.experience entry and no EVAP/misfire family match\n# (code.html only maps P03*/P04* to a family), so it still exercises the\n# real \"nothing found\" render rather than a fixture gap.\nempty_resp = client.get(f\"/v/{VIN}/code/P0098\")\ncheck(\"empty state renders without error when mes.experience/fixture is absent\",\n      empty_resp.status_code == 200 and \"No experience links yet for this item\" in empty_resp.text,\n      str(empty_resp.status_code))\n\n\n# ===========================================================================\n# 4. companion checks (lightweight only -- the screenshot-based\n#    check_timeline_page.py is intentionally left for a full CI run)\n# ===========================================================================\n\nprint(\"=== companion checks ===\")\nfor script in (\"check_dossier_page.py\", \"check_maintenance_page.py\",\n              \"check_service_page.py\", \"check_api.py\"):\n    proc = subprocess.run([sys.executable, str(Path(__file__).parent / script)],\n                          cwd=str(ROOT), capture_output=True, text=True)\n    ok = proc.returncode == 0\n    check(f\"{script} exits 0\", ok, (proc.stdout[-1200:] + proc.stderr[-1200:]) if not ok else \"\")\n\n\nprint()\nif failures:\n    print(f\"{len(failures)}/{checks} check(s) failed:\")\n    for f in failures:\n        print(f\"  - {f}\")\n    sys.exit(1)\nprint(f\"{checks}/{checks} checks passed\")\n","numLines":227,"startLine":1,"totalLines":227}},"sourceToolAssistantUUID":"c09921be-82d7-4633-9049-837b95b22b5f","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
