>\n\n    {% if spec.type == \"choice\" %}\n    <div class=\"m-chips\" role=\"group\">\n      {% for choice in spec.choices %}\n      <label class=\"m-chip\">\n        <input type=\"radio\" name=\"{{ key }}\" value=\"{{ choice }}\"{% if spec.required %} required{% endif %}>\n        <span>{{ choice }}</span>\n      </label>\n      {% endfor %}\n    </div>\n\n    {% elif spec.type == \"bool\" %}\n    <div class=\"m-chips\" role=\"group\">\n      <label class=\"m-chip\">\n        <input type=\"radio\" name=\"{{ key }}\" value=\"on\">\n        <span>Yes</span>\n      </label>\n      <label class=\"m-chip\">\n        <input type=\"radio\" name=\"{{ key }}\" value=\"off\">\n        <span>No</span>\n      </label>\n    </div>\n\n    {% elif spec.type == \"number\" %}\n    <input class=\"m-input\" type=\"number\" step=\"any\" name=\"{{ key }}\" inputmode=\"decimal\"\n          {% if spec.required %} required{% endif %}>\n\n    {% elif spec.type == \"date\" %}\n    <input class=\"m-input\" type=\"date\" name=\"{{ key }}\">\n\n    {% elif spec.type == \"datetime\" %}\n    <input class=\"m-input\" type=\"datetime-local\" name=\"{{ key }}\">\n\n    {% elif spec.remember %}\n    {# Free text stays open; the values last used are one tap away (datalist\n       works without JS on iOS; the chips fill the box with one line of JS). #}\n    {% set _rv = (recents or {}).get(key) or [] %}\n    <input class=\"m-input\" type=\"text\" name=\"{{ key }}\" id=\"f-{{ key }}\" list=\"dl-{{ key }}\" autocomplete=\"off\"{% if spec.required %} required{% endif %}>\n    {% if _rv %}\n    <datalist id=\"dl-{{ key }}\">{% for v in _rv %}<option value=\"{{ v }}\">{% endfor %}</datalist>\n    <div class=\"m-chips m-recent\" aria-label=\"Last used\">\n      {% for v in _rv %}<button type=\"button\" class=\"m-chip\" onclick=\"document.getElementById('f-{{ key }}').value=this.textContent\">{{ v }}</button>{% endfor %}\n    </div>\n    {% endif %}\n    {% else %}\n    <input class=\"m-input\" type=\"text\" name=\"{{ key }}\"{% if spec.required %} required{% endif %}>\n    {% endif %}\n  </div>\n  {% endfor %}\n\n  <div class=\"m-field\">\n    <label class=\"m-label\">When</label>\n    <input class=\"m-input\" type=\"datetime-local\" name=\"at\">\n    <p class=\"m-hint\">Leave blank for right now. A date alone is fine too.</p>\n  </div>\n\n  <div class=\"m-field\">\n    <label class=\"m-label\">Who's reporting this</label>\n    <div class=\"m-chips\" role=\"group\">\n      <label class=\"m-chip\"><input type=\"radio\" name=\"by_role\" value=\"owner\" checked><span>Owner</span></label>\n      <label class=\"m-chip\"><input type=\"radio\" name=\"by_role\" value=\"driver\"><span>Driver</span></label>\n      <label class=\"m-chip\"><input type=\"radio\" name=\"by_role\" value=\"mechanic\"><span>Mechanic</span></label>\n    </div>\n    <input class=\"m-input\" type=\"text\" name=\"by_name\" placeholder=\"Name (optional)\">\n  </div>\n\n  <div class=\"m-field\">\n    <label class=\"m-label\">Odometer (optional)</label>\n    <input class=\"m-input\" type=\"number\" step=\"any\" inputmode=\"decimal\" name=\"odometer_km\">\n  </div>\n\n  <div class=\"m-field\">\n    <label class=\"m-label\">Anything else</label>\n    <textarea class=\"m-input m-textarea\" name=\"note\" rows=\"3\"></textarea>\n  </div>\n\n  <p class=\"m-hint\">\n    Have a photo of this (a receipt, a part, a warning light)? Save this\n    report first, then add it from the vehicle's\n    <a href=\"/v/{{ vin }}/media\">Media</a> page -- it already handles photo\n    uploads for every record on this car.\n  </p>\n\n  <button type=\"submit\" class=\"m-submit\">Save</button>\n</form>\n{% endblock %}\n","userModified":false},"serverClassifierContext":{"request":"38e07197-532c-478d-a312-779b0f0167b7","context":{"git_state":{"cwd":"/c/Users/User/mcp-servers","root":null,"branch":null,"default_branch":null,"status":null,"visibility":null,"error":"pending"},"live_cwd":"/c/Users/User/mcp-servers","platform":"windows"}},"