/footer>\n\n<nav class=\"m-bottomnav\" aria-label=\"Tell CUORE\">\n  <a href=\"/m/{{ vin }}\" class=\"{{ 'on' if active == 'add' }}\">Add</a>\n  <a href=\"/m/{{ vin }}/messages\" class=\"{{ 'on' if active == 'messages' }}\">Messages</a>\n  <a href=\"/m/{{ vin }}/history\" class=\"{{ 'on' if active == 'history' }}\">History</a>\n</nav>\n\n</body>\n</html>","newString":"<!doctype html>\n<html lang=\"en\" data-marque=\"{{ marque|default('alfa') }}\" data-theme=\"dark\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\">\n{# Dark only on mobile, the owner's own instruction -- \"dark-theme\" (point\n   6) means this page never flips to the light palette cuore.css offers\n   desktop pages, regardless of the phone's own system setting. The\n   meta + data-theme=\"dark\" together do that: the meta drops the \"light\"\n   half of the UA hint, and data-theme=\"dark\" on <html> is what actually\n   defeats cuore.css's own `@media (prefers-color-scheme: light)` block\n   (it's guarded `:root:not([data-theme=\"dark\"])`, so this one attribute\n   is what keeps a phone set to light mode on the true-black ground). #}\n<meta name=\"color-scheme\" content=\"dark\">\n<title>{% block title %}Tell CUORE{% endblock %}</title>\n{# Minimal layout on purpose: no desktop tabs, no hero, no _vbar.html --\n   this is a phone-first page, not a shrunk-down desktop one. Reuses only\n   cuore.css's colour/spacing tokens (marque accent, true-black ground),\n   not its desktop component styles. #}\n<link rel=\"stylesheet\" href=\"{{ static_url('cuore.css') }}\">\n<link rel=\"stylesheet\" href=\"{{ static_url('m.css') }}\">\n</head>\n<body class=\"m-body\">\n\n{# Opening reveal (owner's own request, 2026-10-13 rejection note): plays\n   on every open of /m/{vin} -- the home route is the only caller that\n   passes show_intro=True. _intro.html itself (CSS + markup, unmodified)\n   is the exact partial the main app uses, same timing, same tap-to-\n   dismiss; the one addition here is the line right after it that clears\n   the sessionStorage flag _intro.html's own script just set, so THIS\n   page never remembers having shown it -- \"every open\", not \"once per\n   session\", while every other page under /m/{vin}/* (which never passes\n   show_intro) renders no overlay at all and never touches the flag. #}\n{% if show_intro|default(false) %}\n{% include \"_intro.html\" %}\n<script>\n(function(){try{sessionStorage.removeItem(\"cuoreIntroSeen\");}catch(e){}})();\n</script>\n{% endif %}\n\n<header class=\"m-top\">\n  <a class=\"m-brand\" href=\"/m/{{ vin }}\">CUORE</a>\n</header>\n\n<main class=\"m-main\">\n{% if error is defined and error %}\n  <p class=\"m-flash m-flash-error\">{{ error }}</p>\n{% endif %}\n{% if saved is defined and saved %}\n  <p class=\"m-flash m-flash-ok\" id=\"saved\">Saved.</p>\n{% endif %}\n{% block content %}{% endblock %}\n</main>\n\n<footer class=\"m-footer\">\n  Everything recorded here is an ATTESTED report -- who said it, when -- at\n  confidence &quot;reported&quot;. It is never a car measurement and never\n  counts as evidence on its own.\n</footer>\n\n<nav class=\"m-bottomnav\" aria-label=\"Tell CUORE\">\n  <a href=\"/m/{{ vin }}\" class=\"{{ 'on' if active == 'add' }}\">\n    <svg class=\"m-navicon\" aria-hidden=\"true\"><use href=\"/static/icons.svg#i-step_start\"></use></svg>\n    <span>Add</span>\n  </a>\n  <a href=\"/m/{{ vin }}/messages\" class=\"{{ 'on' if active == 'messages' }}\">\n    <svg class=\"m-navicon\" aria-hidden=\"true\"><use href=\"/static/icons.svg#i-symptom_warning_message\"></use></svg>\n    <span>Messages</span>\n  </a>\n  <a href=\"/m/{{ vin }}/history\" class=\"{{ 'on' if active == 'history' }}\">\n    <svg class=\"m-navicon\" aria-hidden=\"true\"><use href=\"/static/icons.svg#i-step_document\"></use></svg>\n    <span>History</span>\n  </a>\n</nav>\n\n<script src=\"{{ static_url('m.js') }}\" defer></script>\n</body>\n</html>","or