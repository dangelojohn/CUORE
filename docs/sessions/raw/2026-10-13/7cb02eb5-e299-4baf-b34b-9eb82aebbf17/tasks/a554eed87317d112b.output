\": rec.get(\"created_at\"),\n   143\t        \"by\": {\"role\": rec.get(\"reporter\") or \"driver\", \"name\": \"\"},\n   144\t        \"category\": \"incidents\", \"kind\": \"noise_smell_vibration\",\n   145\t        \"fields\": {\"description\": rec.get(\"text\") or \"\", \"tags\": rec.get(\"tags\") or []},\n   146\t        \"note\": rec.get(\"text\") or \"\", \"media_ids\": [], \"odometer_km\": rec.get(\"odometer_km\"),\n   147\t        \"confidence\": \"reported\", \"deleted\": bool(rec.get(\"hidden\")),\n   148\t        \"delegated_to\": \"mes.symptoms\",\n   149\t    }\n   150\t\n   151\t\n   152\tdef list_events(vin: str, *, include_deleted: bool = False) -> dict[str, Any]:\n   153\t    \"\"\"Every owner event for this VIN, oldest first -- the owner_events\n   154\t    store plus that one symptoms-delegated kind, merged into one timeline.\"\"\"\n   155\t    if not vin.strip():\n   156\t        raise BadRequest(\"a VIN is required\")\n   157\t    events = store.load(vin, include_deleted=include_deleted)\n   158\t    try:\n   159\t        symptom_recs = symptoms_mod.load(vin, include_hidden=include_deleted)\n   160\t    except Exception:  # noqa: BLE001 -- a missing corpus must not break the page\n   161\t        symptom_recs = []\n   162\t    events += [_symptom_as_event(vin, r) for r in symptom_recs]\n   163\t    events.sort(key=lambda e: e.get(\"at\") or \"\")\n   164\t    return {\"vin\": vin, \"events\": events}\n   165\t\n   166\t\n   167\tdef delete(id: str) -> dict[str, Any]:\n   168\t    try:\n   169\t        return store.delete(id)\n   170\t    except ValueError as exc:\n   171\t        raise BadRequest(str(exc)) from exc\n   172\t\n   173\t\n   174\tdef events_for_system(vin: str, key: str) -> dict[str, Any]:\n   175\t    \"\"\"Owner events whose kind touches systems-graph key ``key``.\"\"\"\n   176\t    if not vin.strip():\n   177\t        raise BadRequest(\"a VIN is required\")\n   178\t    key = (key or \"\").strip()\n   179\t    out = []\n   180\t    for e in list_events(vin)[\"events\"]:\n   181\t        try:\n   182\t            kd = store.kind_def(e[\"category\"], e[\"kind\"])\n   183\t        except (ValueError, KeyError):\n   184\t            continue\n   185\t        if key in kd.get(\"systems\", []):\n   186\t            out.append(e)\n   187\t    return {\"vin\": vin, \"system\": key, \"events\": out}\n   188\t\n   189\t\n   190\t# --- correlation against this car's own DTC history --------------------------\n   191\t\n   192\t\n   193\tdef _code_occurrences(vin: str) -> list[dict[str, Any]]:\n   194\t    \"\"\"Every (code, timestamp, kind) worth correlating against: the first\n   195\t    occurrence of each code this car has ever logged, plus every\n   196\t    \"returned after clear\" occurrence -- the two moments a mechanic actually\n   197\t    cares whether something changed beforehand.\"\"\"\n   198\t    try:\n   199\t        dossier = mes_bridge.workup(vin=vin)\n   200\t    except Exception:  # noqa: BLE001 -- no corpus yet must not break the page\n   201\t        return []\n   202\t    history = dossier.get(\"history\") or {}\n   203\t    out: list[dict[str, Any]] = []\n   204\t    for bucket in (\"chronic\", \"returned_after_clear\", \"seen_once\"):\n   205\t        for rec in history.get(bucket, []):\n   206\t            code = _base_code(rec.get(\"dtc\") or \"\")\n   207\t            occs = sorted(rec.get(\"occurrences\", []), key=lambda o: o.get(\"timestamp\") or \"\")\n   208\t            if not occs:\n   209\t                continue\n   210\t            out.append({\"code\": code, \"at\": occs[0].get(\"timestamp\"), \"event_kind\": \"first_occurrence\"})\n   211\t            for occ in occs:\n   212\t                if occ.get(\"status\") == \"returned\":\n   213\t                    out.append({\"code\": code, \"at\": occ.get(\"timestamp\"), \"event_kind\": \"return\"})\n   214\t    return out\n   215\t\n   216\t\n   217\tdef correlate(vin: str) -> dict[str, Any]:\n   218\t    \"\"\