{"parentUuid":"45f6c58a-4550-403a-9263-50dd802661b1","isSidechain":true,"promptId":"1153797c-0a49-49a7-8dce-d1a3c6b99772","agentId":"a554eed87317d112b","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Tnnkho9oazGA76AyTFym9m","type":"tool_result","content":"1\t\"\"\"Mechanic evidence media library: upload, browse, and recover photos,\n2\tscans, and borescope clips.\n3\t\n4\tThin HTTP face over ``cuore.live.media`` -- the same split as every other\n5\trouter here: this module turns requests into calls against the service\n6\tlayer and turns its results (or its ``BadMedia``/``UnknownMedia``) into HTTP.\n7\t\"\"\"\n8\t\n9\tfrom __future__ import annotations\n10\t\n11\tfrom typing import Any\n12\t\n13\tfrom fastapi import APIRouter, Depends, File, Form, HTTPException, Query, UploadFile\n14\tfrom fastapi.responses import FileResponse\n15\t\n16\tfrom ..live import media as media_store\n17\tfrom .deps import require_token\n18\t\n19\trouter = APIRouter(tags=[\"media\"], dependencies=[Depends(require_token)])\n20\t\n21\t#: HTTP-layer cap for this endpoint -- deliberately tighter than\n22\t#: ``media_store.MAX_SIZE`` (500 MB, still enforced as a defensive\n23\t#: fallback). iPhone photos/HEIC/Live Photos are the case this is sized\n24\t#: for; a fast, clear 413 beats reading a huge body only to 400 later.\n25\tMAX_UPLOAD_BYTES = 25 * 1024 * 1024  # 25 MB\n26\t\n27\t\n28\tdef _row_or_404(id_: str) -> dict[str, Any]:\n29\t    try:\n30\t        return media_store.get(id_)\n31\t    except media_store.UnknownMedia:\n32\t        raise HTTPException(status_code=404, detail=f\"no media with id {id_!r}\")\n33\t\n34\t\n35\tdef _enrich(row: dict[str, Any]) -> dict[str, Any]:\n36\t    \"\"\"Add HTTP-layer fields (``url``, ``thumb_url``) on top of the storage\n37\t    row -- ``cuore.live.media`` knows nothing about where it's mounted, so\n38\t    those are built here, not there.\"\"\"\n39\t    row = dict(row)\n40\t    id_ = row.get(\"id\", \"\")\n41\t    row[\"url\"] = f\"/api/media/{id_}/file\"\n42\t    row[\"thumb_url\"] = f\"/api/media/{id_}/thumb\" if media_store.thumb_path(id_) else None\n43\t    return row\n44\t\n45\t\n46\t@router.post(\"/vehicles/{vin}/media\", summary=\"Upload one or more media files\")\n47\tasync def upload(\n48\t    vin: str,\n49\t    file: list[UploadFile] = File(...),\n50\t    caption: str = Form(default=\"\"),\n51\t    tags: str = Form(default=\"\", description=\"Comma-separated.\"),\n52\t    target_kind: str = Form(default=\"vehicle\"),\n53\t    target_id: str = Form(default=\"\"),\n54\t    odometer_km: float | None = Form(default=None),\n55\t    author: str = Form(default=\"\"),\n56\t    symptom_tags: str = Form(default=\"\", description=\"Comma-separated.\"),\n57\t    feels_like: str = Form(default=\"\"),\n58\t    note: str = Form(default=\"\", description=\"Alias for caption, used when caption is blank.\"),\n59\t    event_id: str = Form(default=\"\", description=\"Shorthand for target_kind=timeline, target_id=event_id.\"),\n60\t    keep_location: bool = Form(default=False, description=\"Keep decoded GPS lat/lon on the record. Default off (owner privacy) -- has_gps is reported either way.\"),\n61\t) -> dict[str, Any]:\n62\t    tag_list = [t.strip() for t in tags.split(\",\") if t.strip()]\n63\t    symptom_tag_list = [t.strip() for t in symptom_tags.split(\",\") if t.strip()]\n64\t    effective_caption = caption or note\n65\t    effective_target_kind, effective_target_id = target_kind, target_id\n66\t    if event_id and target_kind == \"vehicle\" and not target_id:\n67\t        effective_target_kind, effective_target_id = \"timeline\", event_id\n68\t    rows = []\n69\t    for up in file:\n70\t        body = await up.read()\n71\t        if len(body) > MAX_UPLOAD_BYTES:\n72\t            raise HTTPException(\n73\t                status_code=413,\n74\t                detail=(f\"{up.filename or 'file'} is {len(body)} bytes, over the \"\n75\t                        f\"{MAX_UPLOAD_BYTES} byte (25 MB) upload limit\"),\n76\t            )\n77\t        mime = up.content_type or \"application/octet-stream\"\n78\t        try:\n79\t            row = media_store.add(\n80\t                vin, body, up.filename or \"upload\", mime,\n81\t                caption=effective_caption, tags=tag_list, target_kind=effective_target_kind,\n82\t                target_id=effective_target_id, odometer_km=odometer_km, author=author,\n83\t                symptom_tags=symptom_tag_list, feels_like=feels_like,\n84\t                keep_location=keep_location,\n85\t            )\n86\t        except media_store.BadMedia as e:\n87\t            raise HTTPException(status_code=400, detail=str(e))\n88\t        rows.append(_enrich(row))\n89\t    return {\"count\": len(rows), \"media\": rows}\n90\t\n91\t\n92\t@router.get(\"/vehicles/{vin}/media\", summary=\"Search this vehicle's media\")\n93\tdef list_media(\n94\t    vin: str,\n95\t    q: str = Query(default=\"\"),"}]},"uuid":"92bfadc7-0667-441d-8115-00286698ac91","timestamp":"2026-10-13T22:53:18.291Z","toolUseResult":{"type":"text","file":{"filePath":"C:\\Users\\User\\mcp-servers\\cuore\\api\\media.py","content":"\"\"\"Mechanic evidence media library: upload, browse, and recover photos,\nscans, and borescope clips.\n\nThin HTTP face over ``cuore.live.media`` -- the same split as every other\nrouter here: this module turns requests into calls against the service\nlayer and turns its results (or its ``BadMedia``/``UnknownMedia``) into HTTP.\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom typing import Any\n\nfrom fastapi import APIRouter, Depends, File, Form, HTTPException, Query, UploadFile\nfrom fastapi.responses import FileResponse\n\nfrom ..live import media as media_store\nfrom .deps import require_token\n\nrouter = APIRouter(tags=[\"media\"], dependencies=[Depends(require_token)])\n\n#: HTTP-layer cap for this endpoint -- deliberately tighter than\n#: ``media_store.MAX_SIZE`` (500 MB, still enforced as a defensive\n#: fallback). iPhone photos/HEIC/Live Photos are the case this is sized\n#: for; a fast, clear 413 beats reading a huge body only to 400 later.\nMAX_UPLOAD_BYTES = 25 * 1024 * 1024  # 25 MB\n\n\ndef _row_or_404(id_: str) -> dict[str, Any]:\n    try:\n        return media_store.get(id_)\n    except media_store.UnknownMedia:\n        raise HTTPException(status_code=404, detail=f\"no media with id {id_!r}\")\n\n\ndef _enrich(row: dict[str, Any]) -> dict[str, Any]:\n    \"\"\"Add HTTP-layer fields (``url``, ``thumb_url``) on top of the storage\n    row -- ``cuore.live.media`` knows nothing about where it's mounted, so\n    those are built here, not there.\"\"\"\n    row = dict(row)\n    id_ = row.get(\"id\", \"\")\n    row[\"url\"] = f\"/api/media/{id_}/file\"\n    row[\"thumb_url\"] = f\"/api/media/{id_}/thumb\" if media_store.thumb_path(id_) else None\n    return row\n\n\n@router.post(\"/vehicles/{vin}/media\", summary=\"Upload one or more media files\")\nasync def upload(\n    vin: str,\n    file: list[UploadFile] = File(...),\n    caption: str = Form(default=\"\"),\n    tags: str = Form(default=\"\", description=\"Comma-separated.\"),\n    target_kind: str = Form(default=\"vehicle\"),\n    target_id: str = Form(default=\"\"),\n    odometer_km: float | None = Form(default=None),\n    author: str = Form(default=\"\"),\n    symptom_tags: str = Form(default=\"\", description=\"Comma-separated.\"),\n    feels_like: str = Form(default=\"\"),\n    note: str = Form(default=\"\", description=\"Alias for caption, used when caption is blank.\"),\n    event_id: str = Form(default=\"\", description=\"Shorthand for target_kind=timeline, target_id=event_id.\"),\n    keep_location: bool = Form(default=False, description=\"Keep decoded GPS lat/lon on the record. Default off (owner privacy) -- has_gps is reported either way.\"),\n) -> dict[str, Any]:\n    tag_list = [t.strip() for t in tags.split(\",\") if t.strip()]\n    symptom_tag_list = [t.strip() for t in symptom_tags.split(\",\") if t.strip()]\n    effective_caption = caption or note\n    effective_target_kind, effective_target_id = target_kind, target_id\n    if event_id and target_kind == \"vehicle\" and not target_id:\n        effective_target_kind, effective_target_id = \"timeline\", event_id\n    rows = []\n    for up in file:\n        body = await up.read()\n        if len(body) > MAX_UPLOAD_BYTES:\n            raise HTTPException(\n                status_code=413,\n                detail=(f\"{up.filename or 'file'} is {len(body)} bytes, over the \"\n                        f\"{MAX_UPLOAD_BYTES} byte (25 MB) upload limit\"),\n            )\n        mime = up.content_type or \"application/octet-stream\"\n        try:\n            row = media_store.add(\n                vin, body, up.filename or \"upload\", mime,\n                caption=effective_caption, tags=tag_list, target_kind=effective_target_kind,\n                target_id=effective_target_id, odometer_km=odometer_km, author=author,\n                symptom_tags=symptom_tag_list, feels_like=feels_like,\n                keep_location=keep_location,\n            )\n        except media_store.BadMedia as e:\n            raise HTTPException(status_code=400, detail=str(e))\n        rows.append(_enrich(row))\n    return {\"count\": len(rows), \"media\": rows}\n\n\n@router.get(\"/vehicles/{vin}/media\", summary=\"Search this vehicle's media\")\ndef list_media(\n    vin: str,\n    q: str = Query(default=\"\"),","numLines":95,"startLine":1,"totalLines":155}},"sourceToolAssistantUUID":"45f6c58a-4550-403a-9263-50dd802661b1","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
