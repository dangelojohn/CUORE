er.status())\nshow(\"vehicles\", server.vehicles(), 900)\nshow(\"get_freeze_frame P0456\", server.get_freeze_frame(code=\"P0456\"), 1400)\nshow(\"failure_type 2F\", server.failure_type(\"2F\"))\nshow(\"failure_type AB (unknown)\", server.failure_type(\"AB\"))\nshow(\"parameter_series Canister fill\", server.parameter_series(\"Canister fill\"), 900)","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"serverClassifierContext":{"request":"10a45cf4-00ad-409b-ad84-6cb767181dc1","context":{"git_state":{"cwd":"/c/Users/User/mcp-servers","root":null,"branch":null,"default_branch":null,"status":null,"visibility":null,"error":"pending"},"live_cwd":"/c/Users/User/mcp-servers","platform":"windows"}},"sourceToolAssistantUUID":"b7d7bde8-b950-457a-b1e5-828c8f4f2c5a","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
