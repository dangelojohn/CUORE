{"parentUuid":"54494760-baf9-4893-adbb-d4c75bcbed60","isSidechain":true,"promptId":"8b9c6287-d7e2-4fd6-8dbd-dc6c5dce5337","agentId":"a8b24ce63139aab44","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01MLL2n3KtMcryhNEdweH2Y6","type":"tool_result","content":"60\t        return None\n61\t\n62\t\n63\tdef _drivetrain_specs():\n64\t    try:\n65\t        from mes import drivetrain_specs\n66\t        return drivetrain_specs\n67\t    except Exception:  # noqa: BLE001\n68\t        return None\n69\t\n70\t\n71\tdef _model_for_vin(vin: Optional[str]) -> Optional[str]:\n72\t    \"\"\"Best-effort model name for ``vin`` via ``mes.platform``, or ``None``\n73\t    on any failure or an unrecognised VIN -- never raises.\"\"\"\n74\t    if not vin:\n75\t        return None\n76\t    try:\n77\t        from mes import platform as platform_mod\n78\t        model = platform_mod.model_for_vin(vin)\n79\t    except Exception:  # noqa: BLE001\n80\t        return None\n81\t    return None if model == \"UNKNOWN\" else model\n82\t\n83\t\n84\t# --- fixture: the exact shape mes.parts.get()/for_code()/for_job()/all()\n85\t# will return, used until that module lands (or for any key it does not yet\n86\t# cover). Keyed to things this corpus already knows about -- the Stelvio's\n87\t# chronic P0455/P0456 EVAP family (see project_stelvio_evap.md) and the jobs\n88\t# oil_change.html/maintenance.html/brakes_tires.html already render -- so a\n89\t# developer working on those pages sees real-looking cards immediately. ----\n90\t\n91\t_FIXTURE: dict[str, dict[str, Any]] = {\n92\t    \"esim\": {\n93\t        \"key\": \"esim\",\n94\t        \"name\": \"EVAP Service/Integrity Monitor (ESIM)\",\n95\t        \"what_it_does\": \"Pressurizes the fuel-vapor system and watches the \"\n96\t                        \"decay rate to detect small and large EVAP leaks. A \"\n97\t                        \"failed self-test or a failed component sets \"\n98\t                        \"P0455/P0456/P0457, not necessarily a leak itself.\",\n99\t        \"oem\": [{\"number\": \"68245527AA\", \"brand\": \"Mopar\",\n100\t                 \"note\": \"ESIM / natural-vacuum leak-detection pump assembly\",\n101\t                 \"confidence\": \"SINGLE-SOURCE\",\n102\t                 \"source\": \"https://www.stelvioforum.com/threads/evap-esim-replacement.21004/\"}],\n103\t        \"supersedes\": [],\n104\t        \"aftermarket\": [{\"brand\": \"Standard Motor Products\", \"number\": \"EVAP1234\",\n105\t                         \"confidence\": \"UNKNOWN\", \"source\": None}],\n106\t        \"fits\": \"Alfa Romeo Giulia/Stelvio 2.0T (2017-2022)\",\n107\t        \"location\": \"Rear of the fuel tank, inline on the vapor line, ahead of the canister.\",\n108\t        \"related_codes\": [\"P0455\", \"P0456\", \"P0457\"],\n109\t        \"related_jobs\": [\"evap_leak\"],\n110\t        \"torque_keys\": [\"evap_esim_mount\"],\n111\t        \"price\": {\"low\": 180.0, \"high\": 260.0, \"currency\": \"CAD\",\n112\t                  \"as_of\": \"2026-09-20\", \"source\": \"rockauto.com listing\"},\n113\t        \"buy\": [{\"label\": \"RockAuto\", \"url\": \"https://www.rockauto.com\"},\n114\t                {\"label\": \"Mopar eStore\", \"url\": \"https://www.moparonlineparts.com\"}],\n115\t        \"images\": [{\"url\": \"https://www.stelvioforum.com/data/esim-photo.jpg\",\n116\t                    \"source_page\": \"https://www.stelvioforum.com/threads/evap-esim-replacement.21004/\",\n117\t                    \"source_name\": \"stelvioforum.com\", \"kind\": \"product_photo\",\n118\t                    \"licence_note\": \"forum upload, fair-use reference only\",\n119\t                    \"verified_at\": \"2026-09-20\"}],\n120\t        \"notes\": \"Verified against TSB 18-030-17 before replacing -- that TSB's ECM \"\n121\t                 \"calibration read fixes a false P0456 on some build dates without \"\n122\t                 \"any part being replaced.\",\n123\t    },\n124\t    \"p