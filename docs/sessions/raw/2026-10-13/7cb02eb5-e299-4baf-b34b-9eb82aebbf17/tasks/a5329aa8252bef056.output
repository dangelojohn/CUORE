s=\"chip status-active\" style=\"display:inline-flex\">blocked</p>\n      <p class=\"small muted\">{{ m.actuators.reason }}</p>\n    {% endif %}\n    <p class=\"small muted\">Actuator tests run only through the <code>obd2</code> MCP server's\n      <code>run_actuator</code> tool, never from this page — there is no HTTP route for it.</p>\n    <div class=\"tw\">\n    <table>\n      <thead><tr><th>Name</th><th>Consent phrase</th><th>Source</th><th>Replayable</th></tr></thead>\n      <tbody>\n      {% for a in m.actuators_detail %}\n        <tr>\n          <td>{{ a.name }}</td>\n          <td class=\"mono small\">{{ a.consent_phrase }}</td>\n          <td class=\"small muted\">{{ a.tool or a.source }}</td>\n          <td>{% if a.blocked %}<span class=\"chip status-active\">blocked</span>\n              {% elif a.replayable %}<span class=\"chip ok\">yes</span>\n              {% else %}<span class=\"chip plain\" title=\"{{ a.reasons }}\">no</span>{% endif %}</td>\n        </tr>\n      {% else %}\n        <tr><td colspan=\"4\" class=\"muted\">No actuator tests learned for this module on this VIN yet.</td></tr>\n      {% endfor %}\n      </tbody>\n    </table>\n    </div>\n  </div>\n</details>\n\n<details class=\"card-details\" id=\"sec-adjustments\" data-persist=\"adjustments\">\n  <summary>Adjustments <span class=\"count-badge\">{{ m.adjustments_detail|length }}</span></summary>\n  <div class=\"card-body\">\n    {% for a in m.adjustments_detail %}\n      <div class=\"attempt-row\">\n        <div class=\"attempt-main\">\n          <b>{{ a.operation }}</b>\n          {% if a.kind %}<span class=\"muted\">{{ a.kind }}</span>{% endif %}\n          {% if a.outcome %}<span class=\"chip {{ 'status-active' if 'FAIL' in (a.outcome|upper) else 'ok' }}\">{{ a.outcome }}</span>{% endif %}\n          <span class=\"small muted\">{{ a.timestamp }}</span>\n        </div>\n        {% if a.note %}<div class=\"small muted\">{{ a.note }}</div>{% endif %}\n      </div>\n    {% else %}\n      <p class=\"muted small\">Nothing on record for this module.</p>\n    {% endfor %}\n  </div>\n</details>\n\n{% endblock %}\n","structuredPatch":[],"originalFile":null,"userModified":false},"serverClassifierContext":{"request":"9ed42b1b-3bbe-45b1-bd74-b7e2eebcbfe7","context":{"git_state":{"cwd":"/c/Users/User/mcp-servers","root":"/c/Users/User/mcp-servers","branch":"main","default_branch":null,"status":{"clean":false,"counts":{"staged":0,"modified":11,"untracked":null,"untracked_normal":35},"porcelain":null,"truncated":false},"visibility":{"origin":null,"push_remote":"origin","remotes":[{"name":"github","host":"github.com","remote":"dangelojohn/CUORE","visibility":"unknown"}],"visibility_cache":[]}},"live_cwd":"/c/Users/User/mcp-servers","platform":"windows"}},"sourceToolAssistantUUID":"d032b169-7d25-44ef-bfed-cf393554e1ef","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
