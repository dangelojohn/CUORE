:\n542:def live_clear_vehicle() -> RedirectResponse:\n550:def live_set_cable(cable: str = Form(...)) -> RedirectResponse:\n561:def live_verify(request: Request, bus: str = Form(...),\n576:def live_probe(request: Request) -> HTMLResponse:\n596:def live_obd(request: Request, kind: str) -> HTMLResponse:\n617:def live_module(request: Request, code: str, confirm: bool = False,\n668:def _coverage_page(request: Request, error: str = \"\", refused: bool = False,\n682:def _coverage_do(request: Request, fn: Any) -> HTMLResponse:\n694:def coverage_page(request: Request, vin: str = \"\") -> HTMLResponse:\n700:def coverage_start(request: Request, vin: str = Form(...),\n707:def coverage_cable(request: Request, cable: str = Form(...)) -> HTMLResponse:\n712:def coverage_run(request: Request, key: str = Form(...),\n718:def coverage_skip(request: Request, key: str = Form(...),\n724:def coverage_reset(request: Request) -> HTMLResponse:\n729:def live_vs_log(request: Request, vin: str, module: str = \"\") -> HTMLResponse:\n749:def dealer_form(request: Request, vin: str) -> HTMLResponse:\n760:async def dealer_submit(request: Request, vin: str) -> HTMLResponse:\n819:def _safe_redirect(url: str, fallback: str) -> str:\n828:def notes_page(request: Request, vin: str, target_kind: str = \"\",\n844:async def notes_add(request: Request, vin: str) -> RedirectResponse:\n860:async def notes_edit(request: Request, vin: str, id: str) -> RedirectResponse:\n869:async def notes_hide(request: Request, vin: str, id: str) -> RedirectResponse:","is_error":false}]},"uuid":"d22e4f71-e56a-46bd-957f-7fe90d58179a","timestamp":"2026-10-08T03:04:04.926Z","toolUseResult":{"stdout":"57:def _status_strip() -> dict[str, Any]:\n82:def _page(request: Request, name: str, **ctx: Any) -> HTMLResponse:\n92:def error_page(request: Request, body: Any) -> HTMLResponse:\n108:def _dossier(vin: str) -> dict[str, Any]:\n116:def _vehicle_bar(vin: str, dossier: dict[str, Any]) -> dict[str, Any]:\n154:def _set_active_vehicle(respons