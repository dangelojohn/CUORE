; }\n.sysd-h { display: inline; margin: 0; font-size: 16px; }\n\n.subhead {\n  color: var(--ink-3); font-size: 12px; text-transform: uppercase;\n  letter-spacing: .08em; margin: 14px 0 6px;\n}\n\n.sysd-list { list-style: none; margin: 0; padding: 0; }\n.sysd-row {\n  display: flex; flex-wrap: wrap; align-items: center; gap: 8px;\n  min-height: 48px; padding: 8px 0; border-bottom: 1px solid var(--rule-soft);\n}\n.sysd-row:last-child { border-bottom: none; }\n.sysd-row a, .sysd-row > span:first-child { min-height: 48px; display: inline-flex; align-items: center; }\n\n@media (max-width: 400px) {\n  .sysd-page { font-size: 16px; }\n  .sysd-row { gap: 6px; }\n}\n\n/* --- phase 3: attested-input affordance on every UNKNOWN marker --------- */\n.sysd-attest { display: inline-flex; align-items: center; gap: 6px; flex-wrap: wrap; }\n.sysd-unknown-mark {\n  min-width: 32px; min-height: 32px; display: inline-flex; align-items: center;\n  justify-content: center; border: 1px solid var(--rule); background: var(--surface);\n  border-radius: 4px; cursor: pointer; font-size: 16px; line-height: 1; color: var(--ink-3);\n}\n.sysd-attest-prompt { cursor: default; }\n.sysd-attest-form {\n  display: flex; flex-direction: column; gap: 6px; width: 100%;\n  margin-top: 6px; padding: 10px; border: 1px solid var(--rule-soft); border-radius: 6px;\n}\n.sysd-attest-form label { display: flex; flex-direction: column; gap: 2px; }\n.sysd-attest-form input, .sysd-attest-form select {\n  min-height: 32px; padding: 4px 6px; font-size: 14px;\n}\n.sysd-mechanic-input { width: 100%; }\n\n/* --- phase 3: part image / missing-image marker -------------------------- */\n.sysd-part-img { max-width: 64px; max-height: 64px; border-radius: 4px; object-fit: cover; }\n\n/* --- phase 4 slice: freeze frame with this system's channels highlighted - */\n.sysd-freeze .sysd-ff-hot { font-weight: 600; }\n.sysd-freeze .sysd-ff-dim { opacity: .55; }\n","structuredPatch":[{"oldStart":55,"oldLines":3,"newStart":55,"newLines":9,"lines":[" /* --- phase 4 slice: freeze frame with this system's channels highlighted - */"," .sysd-freeze .sysd-ff-hot { font-weight: 600; }"," .sysd-freeze .sysd-ff-dim { opacity: .55; }","+","+/* --- network event / BCM check-first / EVAP<->network crossref ---------- */","+.sysd-crossref { padding: 8px 0; border-bottom: 1px solid var(--rule-soft); }","+.sysd-row input[type=\"checkbox\"] {","+  min-width: 24px; min-height: 24px; width: 24px; height: 24px; flex: 0 0 auto;","+}"]}],"userModified":false,"replaceAll":false},"serverClassifierContext":{"request":"fd17ba31-b6ce-4296-b8a4-d646e6994386","context":{"git_state":{"cwd":"/c/Users/User/mcp-servers","root":null,"branch":null,"default_branch":null,"status":null,"visibility":null,"error":"pending"},"live_cwd":"/c/Users/User/mcp-servers","platform":"windows"}},"sourceToolAssistantUUID":"8cc0d107-553c-4c55-a6aa-c9aa7c86671f","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
