{"parentUuid":"0fec3216-dd68-41a5-a5bf-2c4c509c8a55","isSidechain":true,"agentId":"a0c5cf5696591fb76","message":{"model":"claude-sonnet-5","id":"msg_011Cg1z5r75e2t1pHPYXdJeg","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01Mumd8ajF4THVBYvQPVgBji","name":"Read","input":{"file_path":"C:\\Users\\User\\mcp-servers\\cuore\\services\\system_detail_bridge.py"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":242,"cache_read_input_tokens":63772,"cache_creation":{"ephemeral_5m_input_tokens":242,"ephemeral_1h_input_tokens":0},"output_tokens":9,"service_tier":"standard","inference_geo":"global"},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_01Mumd8ajF4THVBYvQPVgBji":{"file_path":"C:\\Users\\User\\mcp-servers\\cuore\\services\\system_detail_bridge.py"}},"serverClassifierRequest":"f1cd57c8-4cf6-4e36-ac4d-c6402fce05ea","apiBlockIndex":1,"requestId":"req_011Cg1z5qUdUXgupfZwkaPnn","attributionAgent":"general-purpose","type":"assistant","uuid":"49f2e580-928c-46b1-812d-a83eec2bac36","timestamp":"2026-10-14T10:38:29.933Z","effort":"high","perTurnEffort":null,"userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
{"parentUuid":"49f2e580-928c-46b1-812d-a83eec2bac36","isSidechain":true,"promptId":"50058817-5b8d-4005-85b7-b0699d0c6b2b","agentId":"a0c5cf5696591fb76","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Mumd8ajF4THVBYvQPVgBji","type":"tool_result","content":"1\t\"\"\"``build_system_view(vin, key)`` -- the per-system dive-in page's whole\n2\tview model (``GET /v/{vin}/systems/{key}``, phase 1 of the Systems\n3\tdive-in; the existing one-page map stays ``cuore/web/templates/\n4\tsystems.html`` + ``cuore/services/systems_bridge.py``).\n5\t\n6\tThis module invents nothing. Every field is a pass-through (or a thin\n7\tmerge) of other bridges that already carry their own sourcing:\n8\t\n9\t* ``systems_bridge`` -- the system record and this VIN's correlation\n10\t  (codes-by-system, co-occurrence, chains).\n11\t* ``dossier_bridge`` -- per-code ACTIVE/CLEARED_UNVERIFIED/STALE state\n12\t  (``build_view``'s ``codes`` rows -- see that module's ``_code_status``,\n13\t  the only place in ``cuore.services`` that computes this vocabulary) and\n14\t  readiness-monitor state.\n15\t* ``bench_bridge`` -- the car's one active blocker, if any.\n16\t* ``known_good_bridge`` / ``liveboard_bridge`` -- sourced bands and the\n17\t  live-board grading helper for this system's channels.\n18\t* ``electrical_bridge`` -- layout elements, per-code wiring paths and\n19\t  inspection records (the electrical layout's own system vocabulary does\n20\t  not match the 25-key systems graph 1:1 -- see ``ELEMENT_TAGS_FOR``).\n21\t* ``parts_bridge`` -- catalogue entries for this system's part keys.\n22\t* ``jobs_bridge`` -- suggested and job-attached hypotheses, filtered to\n23\t  this system.\n24\t* ``cases_bridge`` -- case-memory matches for this system's open codes.\n25\t* ``experience_bridge`` -- others' experience links for this family.\n26\t\n27\tNothing here raises for a data gap -- a missing bridge, a code with no\n28\tsystems mapping, an element with no sourced location all degrade to the\n29\tpage's own UNKNOWN marker (see ``UNKNOWN_MARKER``) rather than a 500 or an\n30\tinvented value. ``build_system_view`` returns ``None`` for a key that is\n31\tnot in ``systems_bridge.systems()`` -- the route turns that into a 404.\n32\t\"\"\"\n33\t\n34\tfrom __future__ import annotations\n35\t\n36\tfrom typing import Any, Optional\n37\t\n38\tfrom .. import bootstrap  # noqa: F401 -- side effect: puts `mes` on sys.path\n39\tfrom ..live import attested as attested_store\n40\tfrom ..live import learned as learned_store\n41\t\n42\tfrom mes.systems import ELEMENT_TAGS_FOR, normalize_system  # noqa: E402\n43\t\n44\tfrom . import (\n45\t    bench_bridge,\n46\t    cases_bridge,\n47\t    dossier_bridge,\n48\t    electrical_bridge,\n49\t    experience_bridge,\n50\t    jobs_bridge,\n51\t    known_good_bridge,\n52\t    layout_bridge,\n53\t    liveboard_bridge,\n54\t    mes_bridge,\n55\t    parts_bridge,\n56\t    systems_bridge,\n57\t    systems_map_bridge,\n58\t)\n59\t\n60\t#: Fault trees whose ranked causes lead with the BCM supply feed (fuse F82,\n61\t#: TSB S1808000005) then the inline connector/frame grounds (TSB\n62\t#: S2008000032) -- see ``mes.faulttree.NETWORK_CASCADE`` steps N5/N6. Only\n63\t#: this one tree exists today; keyed by its own ``key`` rather than hunting\n64\t#: its steps at render time.\n65\t_NETWORK_CASCADE_TEST = \"check BCM supply and grounds first\"\n66\t\n67\t#: The one marker every sourcing gap renders as -- never a guess, never a\n68\t#: blank. Matches the wording already used across maintenance.html /\n69\t#: torque.html / drivetrain_section.html / _code_brief.html.\n70\tUNKNOWN_MARKER = \"Unknown — use the service manual (TechAuthority)\"\n71\t\n72\t#: dependency confidence -> a 0..1 weight, used only for ranking \"what\n73\t#: else should I look at\" (section 8) -- never shown as a number on its\n74\t#: own, always alongside the sourced confidence word.\n75\t_CONFIDENCE_WEIGHT = {\"CONFIRMED\": 1.0, \"CORROBORATED\": 0.8,\n76\t                     \"SINGLE-SOURCE\": 0.5, \"UNKNOWN\": 0.2}\n77\t\n78\t#: cuore.services.electrical_bridge's elements carry their own\n79\t#: ``part_of_systems`` vocabulary (``mes.electrical.CANONICAL_SYSTEMS``),\n80\t#: built independently of the 25-key systems graph and not a 1:1 match.\n81\t#: This is the documented overlap -- a systems-graph key with no entry\n82\t#: here simply has no electrical-layout elements merged in (its\n83\t#: ``components`` list, from the systems record itself, still shows).\n84\t#: ``mes.systems.ELEMENT_TAGS_FOR`` is the single source for this map --\n85\t#: see that module for why (previously duplicated here under the same\n86\t#: name, now just imported so the two vocabularies can never drift apart).\n87\t\n88\t#: Standard OBD-II monitor categories (SAE J1979 continuous/non-continuous\n89\t#: monitor taxonomy -- factual, not vehicle-specific) a systems-graph key\n90\t#: can plausibly carry. A key not listed here has no OBD monitor at all,\n91\t#: which is itself a fact worth stating plainly rather than as a gap.\n92\t_MONITOR_KEYWORDS: dict[str, list[str]] = {\n93\t    \"evap\": [\"evap\"],\n94\t    \"exhaust_emissions\": [\"catalyst\", \"secondary air\", \"heated catalyst\"],\n95\t    \"engine_management\": [\"misfire\", \"comprehensive component\"],\n96\t    \"fuel\": [\"fuel system\"],\n97\t    \"air_intake_boost\": [\"secondary air\"],\n98\t}\n99\t\n100\t\n101\t# --- small helpers -----------------------------------------------------------\n102\t\n103\tdef _all_systems() -> dict[str, dict[str, Any]]:\n104\t    try:\n105\t        raw = systems_bridge.systems()\n106\t    except Exception:  # noqa: BLE001 -- a knowledge-table miss must never 500\n107\t        raw = {}\n108\t    if isinstance(raw, dict):\n109\t        return raw\n110\t    return {s.get(\"key\"): s for s in (raw or []) if s.get(\"key\")}\n111\t\n112\t\n113\tdef _correlate(vin: str) -> dict[str, Any]:\n114\t    try:\n115\t        return systems_bridge.correlate(vin) or {}\n116\t    except Exception:  # noqa: BLE001\n117\t        return {}\n118\t\n119\t\n120\tdef _base_code(full: str) -> str:\n121\t    return (full or \"\").split(\"-\")[0].strip().upper()\n122\t\n123\t\n124\tdef _edge_kind(dep: dict[str, Any]) -> str:\n125\t    \"\"\"\"electrical supply\" vs \"functional\" vs \"UNKNOWN\", from whatever the\n126\t    edge's own ``technical.carries`` note says -- never a guess beyond\n127\t    that note's own words.\"\"\"\n128\t    if dep.get(\"system\") == \"electrical_supply\":\n129\t        return \"electrical supply\"\n130\t    carries = ((dep.get(\"technical\") or {}).get(\"carries\") or \"\").lower()\n131\t    if any(w in carries for w in (\"volt\", \"supply\", \"ground\", \"current\", \"12 v\", \"amp\")):\n132\t        return \"electrical supply\"\n133\t    if carries or dep.get(\"why\"):\n134\t        return \"functional\"\n135\t    return \"UNKNOWN\"\n136\t\n137\t\n138\tdef _dossier_codes_map(vin: str) -> dict[str, dict[str, Any]]:\n139\t    try:\n140\t        dossier = mes_bridge.workup(vin=vin)\n141\t        view = dossier_bridge.build_view(vin, dossier, None)\n142\t    except Exception:  # noqa: BLE001\n143\t        return {}\n144\t    return {r.get(\"code\"): r for r in (view.get(\"codes\") or [])}\n145\t\n146\t\n147\tdef _live_value_for(channel_id: str, dview_freeze: list[dict[str, Any]]\n148\t                    ) -> Optional[dict[str, Any]]:\n149\t    \"\"\"The most recent sourced value CUORE has for ``channel_id`` -- a\n150\t    freeze-frame snapshot carried from a real DTC event on this VIN (no\n151\t    live-session store of \"latest reading per channel\" exists yet, so a\n152\t    freeze frame is the closest sourced value there is), graded through\n153\t    ``liveboard_bridge.evaluate`` exactly as the Live board grades it.\"\"\"\n154\t    try:\n155\t        name = known_good_bridge.known_good_for(channel_id) or {}\n156\t        chan_name = name.get(\"name\") or channel_id.replace(\"_\", \" \")\n157\t    except Exception:  # noqa: BLE001\n158\t        chan_name = channel_id.replace(\"_\", \" \")\n159\t    for ff in dview_freeze or []:\n160\t        for row in (ff.get(\"key\") or []) + (ff.get(\"all\") or []):\n161\t            if (row.get(\"name\") or \"\").strip().lower() != chan_name.strip().lower():\n162\t                continue\n163\t            raw = str(row.get(\"value\") or \"\")\n164\t            num = \"\"\n165\t            for ch in raw:\n166\t                if ch.isdigit() or ch in \".-\":\n167\t                    num += ch\n168\t                elif num:\n169\t                    break\n170\t            try:\n171\t                value = float(num)\n172\t            except ValueError:\n173\t                continue\n174\t            try:\n175\t                grade = liveboard_bridge.evaluate(channel_id, value)\n176\t            except Exception:  # noqa: BLE001\n177\t                grade = {\"level\": \"unknown\", \"text\": UNKNOWN_MARKER}\n178\t            return {\"value\": raw, \"level\": grade.get(\"level\"), \"text\": grade.get(\"text\"),\n179\t                    \"source\": f\"freeze frame, {ff.get('code')}\"}\n180\t    return None\n181\t\n182\t\n183\tdef _fact(attested_map: dict[str, dict[str, Any]], fact_key: str, raw_value: Optional[str]\n184\t          ) -> dict[str, Any]:\n185\t    \"\"\"One open-square UNKNOWN marker's full state: the sourced text (or\n186\t    the marker itself), the key a mechanic's input against it is filed\n187\t    under, and the most recent attested input on file for it (``None`` if\n188\t    none). Never upgrades ``raw_value`` -- an attested row is shown\n189\t    *alongside* the marker, never in place of it (see ``cuore.live.\n190\t    attested``'s module docstring for why).\"\"\"\n191\t    text = raw_value or UNKNOWN_MARKER\n192\t    return {\n193\t        \"text\": text, \"fact_key\": fact_key, \"is_unknown\": text == UNKNOWN_MARKER,\n194\t        \"attested\": attested_map.get(fact_key),\n195\t    }\n196\t\n197\t\n198\tdef _channel_display_names(rec: dict[str, Any]) -> set[str]:\n199\t    names: set[str] = set()\n200\t    for ch in rec.get(\"live_channels\") or []:\n201\t        try:\n202\t            cg = known_good_bridge.known_good_for(ch) or {}\n203\t        except Exception:  # noqa: BLE001\n204\t            cg = {}\n205\t        names.add((cg.get(\"name\") or ch.replace(\"_\", \" \")).strip().lower())\n206\t    return names\n207\t\n208\t\n209\t# --- the view model -----------------------------------------------------------\n210\t\n211\tdef build_system_view(vin: str, key: str) -> Optional[dict[str, Any]]:\n212\t    \"\"\"Everything ``/v/{vin}/systems/{key}`` needs, or ``None`` if ``key``\n213\t    is not one of ``systems_bridge.systems()``'s keys (the route 404s).\"\"\"\n214\t    all_systems = _all_systems()\n215\t    rec = all_systems.get(key)\n216\t    if rec is None:\n217\t        return None\n218\t    labels = {k: (s.get(\"label\") or k) for k, s in all_systems.items()}\n219\t    label = labels.get(key, key)\n220\t\n221\t    corr = _correlate(vin)\n222\t    by_system = {r.get(\"system\"): r for r in (corr.get(\"by_system\") or [])}\n223\t    this_row = by_system.get(key) or {}\n224\t    dossier_codes = _dossier_codes_map(vin)\n225\t\n226\t    try:\n227\t        attested_map = attested_store.latest_by_fact(vin, key)\n228\t    except Exception:  # noqa: BLE001 -- a bad/missing store must never 500 the page\n229\t        attested_map = {}\n230\t\n231\t    # --- 1. status strip -----------------------------------------------------\n232\t    codes_status: list[dict[str, Any]] = []\n233\t    for full in this_row.get(\"codes\") or []:\n234\t        base = _base_code(full)\n235\t        drow = dossier_codes.get(base)\n236\t        codes_status.append({\n237\t            \"code\": base, \"dtc\": full,\n238\t            \"status\": (drow or {}).get(\"status\") or \"STALE\",\n239\t            \"status_label\": (drow or {}).get(\"status_label\") or \"Stale\",\n240\t            \"description\": (drow or {}).get(\"description\") or \"\",\n241\t            \"href\": f\"/v/{vin}/code/{base}\",\n242\t        })\n243\t\n244\t    # tonight's (or newest) live module sweep -- a direct from-car UDS read,\n245\t    # independent of the MES-log corpus the loop above reads. A code already\n246\t    # listed above (from the corpus) gets this merged on as \"live\"; a code\n247\t    # the module sweep saw that the corpus has no row for yet (common for a\n248\t    # network/body U- or B-code) becomes its own row, so it still shows up in\n249\t    # \"This car's codes\" and still feeds \"how it fails here\" below.\n250\t    live_chips = systems_map_bridge.module_dtc_overlay(vin)[\"by_system\"].get(key, [])\n251\t    live_by_base: dict[str, list[dict[str, Any]]] = {}\n252\t    for chip in live_chips:\n253\t        live_by_base.setdefault(chip[\"code\"], []).append(chip)\n254\t    for row in codes_status:\n255\t        hits = live_by_base.get(row[\"code\"])\n256\t        if not hits:\n257\t            continue\n258\t        newest = max(hits, key=lambda c: c.get(\"at\") or \"\")\n259\t        row[\"live\"] = {\"state\": newest[\"state\"], \"at\": newest[\"at\"], \"ecu\": newest[\"ecu\"],\n260\t                       \"chip_text\": newest[\"chip_text\"], \"failure_type\": newest[\"failure_type\"]}\n261\t    matched_bases = {row[\"code\"] for row in codes_status}\n262\t    for base, hits in live_by_base.items():\n263\t        if base in matched_bases:\n264\t            continue\n265\t        newest = max(hits, key=lambda c: c.get(\"at\") or \"\")\n266\t        is_active = newest[\"state\"] == \"ACTIVE\"\n267\t        codes_status.append({\n268\t            \"code\": base, \"dtc\": newest[\"full\"],\n269\t            \"status\": \"ACTIVE\" if is_active else \"CLEARED_UNVERIFIED\",\n270\t            \"status_label\": \"Active (live)\" if is_active else \"History since clear (live)\",\n271\t            \"description\": \"\", \"href\": f\"/v/{vin}/code/{base}\",\n272\t            \"live\": {\"state\": newest[\"state\"], \"at\": newest[\"at\"], \"ecu\": newest[\"ecu\"],\n273\t                     \"chip_text\": newest[\"chip_text\"], \"failure_type\": newest[\"failure_type\"]},\n274\t        })\n275\t\n276\t    monitor_keywords = _MONITOR_KEYWORDS.get(key)\n277\t    if not monitor_keywords:\n278\t        monitor = {\"has_monitor\": False}\n279\t    else:\n280\t        try:\n281\t            dossier = mes_bridge.workup(vin=vin)\n282\t            rp = dossier_bridge.readiness_panel(vin, dossier)\n283\t        except Exception:  # noqa: BLE001\n284\t            rp = {\"monitors\": [], \"at\": None, \"note\": None}\n285\t        match = next((m for m in (rp.get(\"monitors\") or [])\n286\t                     if any(kw in (m.get(\"name\") or \"\").lower() for kw in monitor_keywords)),\n287\t                    None)\n288\t        note_raw = None if match else (rp.get(\"note\") or \"no readiness read on file yet\")\n289\t        monitor = {\"has_monitor\": True, \"at\": rp.get(\"at\"),\n290\t                  \"name\": (match or {}).get(\"name\") or monitor_keywords[0].title(),\n291\t                  \"status\": (match or {}).get(\"status\") if match else None,\n292\t                  \"note\": note_raw,\n293\t                  \"note_fact\": _fact(attested_map, f\"monitor:{key}\", note_raw) if note_raw is not None else None}\n294\t\n295\t    try:\n296\t        dossier = mes_bridge.workup(vin=vin)\n297\t        _dview = dossier_bridge.build_view(vin, dossier, None)\n298\t        dview_freeze = _dview.get(\"freeze_frames\") or []\n299\t    except Exception:  # noqa: BLE001\n300\t        _dview = {}\n301\t        dview_freeze = []\n302\t    # EVAP only: this car's own from-car Mode $06 read and live freeze-frame\n303\t    # sweep, read tonight -- see dossier_bridge.build_view's own \"mode06\"/\n304\t    # \"live_freeze_frames\" keys. Other systems have neither today.\n305\t    live_mode06 = _dview.get(\"mode06\") if key == \"evap\" else None\n306\t    live_freeze = _dview.get(\"live_freeze_frames\") if key == \"evap\" else None\n307\t    live_values = []\n308\t    for ch in rec.get(\"live_channels\") or []:\n309\t        try:\n310\t            cg = known_good_bridge.known_good_for(ch) or {}\n311\t            band = known_good_bridge.sourced_band(ch) or {}\n312\t        except Exception:  # noqa: BLE001\n313\t            cg, band = {}, {}\n314\t        band_note_raw = band.get(\"note\") or None\n315\t        live_values.append({\n316\t            \"id\": ch, \"name\": cg.get(\"name\") or ch.replace(\"_\", \" \").title(),\n317\t            \"band_note\": band_note_raw or UNKNOWN_MARKER,\n318\t            \"band_fact\": _fact(attested_map, f\"live:{ch}\", band_note_raw),\n319\t            \"band_confidence\": band.get(\"confidence\") or \"UNKNOWN\",\n320\t            \"latest\": _live_value_for(ch, dview_freeze),\n321\t        })\n322\t\n323\t    try:\n324\t        bench = bench_bridge.build_bench(vin)\n325\t        banner = bench.get(\"blocker_banner\") or {}\n326\t    except Exception:  # noqa: BLE001\n327\t        banner = {}\n328\t    # bench_bridge._blocker_banner carries {icon, is_blocker, action, why,\n329\t    # basis} -- only the car's own *active* blocker (is_blocker true)\n330\t    # counts as a blocker here; a clean/no-data banner is not one.\n331\t    blocker = {\"text\": banner.get(\"action\"), \"why\": banner.get(\"why\")} if banner.get(\"is_blocker\") else None\n332\t\n333\t    last_evidence = this_row.get(\"last\")\n334\t\n335\t    status_strip = {\n336\t        \"codes\": codes_status, \"monitor\": monitor, \"live_values\": live_values,\n337\t        \"blocker\": blocker, \"last_evidence\": last_evidence,\n338\t        \"system_status\": this_row.get(\"status\") or \"stale\",\n339\t    }\n340\t\n341\t    # --- 2. relationship ring --------------------------------------------------\n342\t    co_occ = {}\n343\t    for row in corr.get(\"co_occurrence\") or []:\n344\t        a, b = row.get(\"a\"), row.get(\"b\")\n345\t        other = b if a == key else (a if b == key else None)\n346\t        if other and (row.get(\"sessions_together\") or 0) > 0:\n347\t            co_occ[other] = row\n348\t\n349\t    def _dep_entry(dep: dict[str, Any], other_key: str) -> dict[str, Any]:\n350\t        hot = co_occ.get(other_key)\n351\t        why_raw = dep.get(\"why\") or None\n352\t        source_raw = dep.get(\"source\") or None\n353\t        return {\n354\t            \"system\": other_key, \"label\": labels.get(other_key, other_key),\n355\t            \"why\": why_raw or UNKNOWN_MARKER,\n356\t            \"why_fact\": _fact(attested_map, f\"rel:{other_key}:why\", why_raw),\n357\t            \"confidence\": (dep.get(\"confidence\") or \"UNKNOWN\").upper(),\n358\t            \"source\": source_raw or UNKNOWN_MARKER,\n359\t            \"source_fact\": _fact(attested_map, f\"rel:{other_key}:source\", source_raw),\n360\t            \"kind\": _edge_kind(dep),\n361\t            \"hot\": bool(hot),\n362\t            \"lift\": hot.get(\"lift\") if hot else None,\n363\t            \"href\": f\"/v/{vin}/systems/{other_key}\",\n364\t        }\n365\t\n366\t    upstream = [_dep_entry(dep, dep.get(\"system\")) for dep in (rec.get(\"depends_on\") or [])\n367\t               if dep.get(\"system\")]\n368\t    downstream = []\n369\t    for other_key, other_rec in all_systems.items():\n370\t        if other_key == key:\n371\t            continue\n372\t        for dep in other_rec.get(\"depends_on\") or []:\n373\t            if dep.get(\"system\") == key:\n374\t                downstream.append(_dep_entry(dep, other_key))\n375\t\n376\t    related_keys = {e[\"system\"] for e in upstream} | {e[\"system\"] for e in downstream}\n377\t    hot_only = [{\n378\t        \"system\": other, \"label\": labels.get(other, other),\n379\t        \"lift\": row.get(\"lift\"), \"sessions_together\": row.get(\"sessions_together\"),\n380\t        \"reading\": row.get(\"reading\") or \"\",\n381\t        \"href\": f\"/v/{vin}/systems/{other}\",\n382\t    } for other, row in co_occ.items() if other not in related_keys]\n383\t\n384\t    relationship = {\"upstream\": upstream, \"downstream\": downstream, \"hot_only\": hot_only}\n385\t\n386\t    # --- 3. components, placed ---------------------------------------------\n387\t    parts = []\n388\t    for pkey in rec.get(\"parts\") or []:\n389\t        try:\n390\t            p = parts_bridge.part(pkey)\n391\t        except Exception:  # noqa: BLE001\n392\t            p = None\n393\t        images = (p or {}).get(\"images\") or []\n394\t        image_url = images[0].get(\"url\") if images and isinstance(images[0], dict) else None\n395\t        image_fact = None if image_url else _fact(attested_map, f\"part:{pkey}:image\", None)\n396\t        if p:\n397\t            parts.append({\"key\": pkey, \"name\": p.get(\"name\") or pkey,\n398\t                         \"href\": f\"/v/{vin}/parts#{pkey}\",\n399\t                         \"image_url\": image_url, \"image_fact\": image_fact})\n400\t        else:\n401\t            parts.append({\"key\": pkey, \"name\": pkey.replace(\"_\", \" \"), \"href\": None,\n402\t                         \"image_url\": None, \"image_fact\": image_fact})\n403\t\n404\t    try:\n405\t        all_elements = electrical_bridge.list_elements()\n406\t    except Exception:  # noqa: BLE001\n407\t        all_elements = []\n408\t    tags = set(ELEMENT_TAGS_FOR.get(key, []))\n409\t    elements = [e for e in all_elements if tags & set(e.get(\"part_of_systems\") or [])]\n410\t\n411\t    try:\n412\t        all_inspections = electrical_bridge.list_inspections(vin)\n413\t    except Exception:  # noqa: BLE001\n414\t        all_inspections = []\n415\t    latest_inspection: dict[str, dict[str, Any]] = {}\n416\t    for row in all_inspections:\n417\t        eid = row.get(\"element\")\n418\t        if eid in {e.get(\"id\") for e in elements}:\n419\t            if eid not in latest_inspection or (row.get(\"at\") or \"\") > (latest_inspection[eid].get(\"at\") or \"\"):\n420\t                latest_inspection[eid] = row\n421\t\n422\t    placed_components = []\n423\t    for e in elements:\n424\t        eid = e.get(\"id\")\n425\t        loc = e.get(\"location\") or {}\n426\t        location_note_raw = loc.get(\"description\") or None\n427\t        latest_insp = latest_inspection.get(eid)\n428\t        placed_components.append({\n429\t            \"id\": eid, \"label\": e.get(\"label\") or eid,\n430\t            \"zone\": loc.get(\"zone\") or UNKNOWN_MARKER,\n431\t            \"location_note\": location_note_raw or UNKNOWN_MARKER,\n432\t            \"location_fact\": _fact(attested_map, f\"element:{eid}:location\", location_note_raw),\n433\t            \"location_confidence\": loc.get(\"confidence\") or \"UNKNOWN\",\n434\t            \"inspection_hint\": e.get(\"inspection_hint\") or UNKNOWN_MARKER,\n435\t            \"latest_inspection\": ({\n436\t                \"condition\": latest_insp.get(\"condition\"), \"at\": latest_insp.get(\"at\"),\n437\t                \"by\": latest_insp.get(\"by\"), \"note\": latest_insp.get(\"note\") or \"\",\n438\t                \"photo_count\": len(latest_insp.get(\"media_ids\") or []),\n439\t            } if latest_insp else None),\n440\t            # pre-filled with element id (anchor) and system (query param) --\n441\t            # electrical.html's own per-element \"Record inspection\" details/\n442\t            # form (electrical_routes.py) already hides the element id, so\n443\t            # jumping to its anchor is the whole pre-fill this page owes it.\n444\t            #\n445\t            # F1 (MECHANIC_REVIEW_3): the viewed system's own tag (e.g.\n446\t            # \"evap\") is not necessarily this *element's* canonical system --\n447\t            # a shared/gateway component like the BCM is pulled onto this\n448\t            # page because one of its several part_of_systems tags matches,\n449\t            # but electrical_routes.py's own ?system= filter keys on\n450\t            # layout_bridge.canonical_system(e) (one tag per element, picked\n451\t            # from the full part_of_systems list, not just this system's).\n452\t            # Calling that same resolver here -- rather than guessing from\n453\t            # the viewed system's tags -- guarantees the query param always\n454\t            # matches what the electrical page will actually render, so\n455\t            # id=\"el-{eid}\" is always present on the page the link lands on.\n456\t            \"inspect_href\": (\n457\t                f\"/v/{vin}/electrical?system={layout_bridge.canonical_system(e)}#el-{eid}\"\n458\t            ),\n459\t        })\n460\t\n461\t    wiring_paths = []\n462\t    for row in codes_status:\n463\t        if row[\"status\"] not in (\"ACTIVE\", \"CLEARED_UNVERIFIED\"):\n464\t            continue\n465\t        try:\n466\t            path = electrical_bridge.path_for_code(row[\"code\"])\n467\t        except Exception:  # noqa: BLE001\n468\t            path = None\n469\t        if path and path.get(\"path\"):\n470\t            wiring_paths.append({\"code\": row[\"code\"], \"path\": path.get(\"path\"),\n471\t                                 \"note\": path.get(\"note\")})\n472\t\n473\t    components = {\"parts\": parts, \"elements\": placed_components, \"wiring_paths\": wiring_paths}\n474\t\n475\t    # --- 4. how it fails here ------------------------------------------------\n476\t    open_codes = [r[\"code\"] for r in codes_status if r[\"status\"] in (\"ACTIVE\", \"CLEARED_UNVERIFIED\")]\n477\t    fault_tree = None\n478\t    if open_codes:\n479\t        try:\n480\t            fault_tree = mes_bridge.fault_tree(\",\".join(open_codes), vin=vin)\n481\t        except Exception:  # noqa: BLE001\n482\t            fault_tree = None\n483\t\n484\t    do_it_now_href = f\"/v/{vin}/job?step=6\"\n485\t    next_test_label = None\n486\t    try:\n487\t        from mes import mechanic_tests as _mech  # noqa: PLC0415 -- being built in parallel\n488\t    except Exception:  # noqa: BLE001\n489\t        _mech = None\n490\t    if _mech is not None and open_codes:\n491\t        try:\n492\t            finder = getattr(_mech, \"tests_for_code\", None) or getattr(_mech, \"find_test\", None)\n493\t            match = finder(open_codes[0]) if finder else None\n494\t            test_id = None\n495\t            if isinstance(match, dict):\n496\t                test_id = match.get(\"id\") or match.get(\"test_id\")\n497\t                next_test_label = match.get(\"label\") or match.get(\"name\")\n498\t            elif isinstance(match, (list, tuple)) and match:\n499\t                first = match[0]\n500\t                test_id = first.get(\"id\") if isinstance(first, dict) else None\n501\t                next_test_label = first.get(\"label\") if isinstance(first, dict) else None\n502\t            if test_id:\n503\t                do_it_now_href = f\"/v/{vin}/tests#test-{test_id}\"\n504\t        except Exception:  # noqa: BLE001\n505\t            pass\n506\t\n507\t    # A matched network-cascade tree (BCM/RFHUB/DTCM lost-communication\n508\t    # U-codes, or B1040) always offers its own ranked first real test --\n509\t    # fuse F82/BCM supply (N5), then the connector/grounds (N6) -- ahead of\n510\t    # whatever mechanic_tests found, since a generic per-code test would\n511\t    # send the mechanic chasing one of the U-codes as its own component\n512\t    # fault rather than the one real network event behind all of them.\n513\t    if fault_tree and any(t.get(\"tree\") == \"network-cascade\" for t in (fault_tree.get(\"trees\") or [])):\n514\t        next_test_label = _NETWORK_CASCADE_TEST\n515\t\n516\t    how_it_fails = {\"fault_tree\": fault_tree, \"open_codes\": open_codes,\n517\t                    \"next_test_label\": next_test_label, \"do_it_now_href\": do_it_now_href}\n518\t\n519\t    # --- 5. hypotheses touching this system -----------------------------------\n520\t    # Both sides are resolved through the one shared alias table\n521\t    # (mes.systems.normalize_system) instead of a local label/substring\n522\t    # match -- suggested_hypotheses' \"system\" is still free text (\"EVAP\",\n523\t    # a dossier family key, ...); job hypotheses' \"system\" is already a\n524\t    # normalized key (mes.jobs resolves it on write/read), and\n525\t    # normalize_system is a no-op for an already-normalized key.\n526\t    hyps = []\n527\t    try:\n528\t        jv = jobs_bridge.build_job_view(vin)\n529\t    except Exception:  # noqa: BLE001\n530\t        jv = {}\n531\t    for sugg in jv.get(\"suggested_hypotheses\") or []:\n532\t        if normalize_system(sugg.get(\"system\")) == key:\n533\t            hyps.append({\"text\": sugg.get(\"text\"), \"status\": \"suggested\",\n534\t                        \"evidence_count\": len(sugg.get(\"evidence_for\") or []) +\n535\t                                          len(sugg.get(\"evidence_against\") or []),\n536\t                        \"next_test\": sugg.get(\"next_test\")})\n537\t    job = jv.get(\"job\") or {}\n538\t    for h in job.get(\"hypotheses\") or []:\n539\t        if normalize_system(h.get(\"system\")) == key:\n540\t            hyps.append({\"text\": h.get(\"text\"), \"status\": h.get(\"status\") or \"open\",\n541\t                        \"evidence_count\": len(h.get(\"evidence_for\") or []) +\n542\t                                          len(h.get(\"evidence_against\") or []),\n543\t                        \"next_test\": None})\n544\t\n545\t    add_hyp_href = f\"/v/{vin}/job?step=7&system={key}&codes={','.join(open_codes)}\"\n546\t    hypotheses = {\"rows\": hyps, \"add_href\": add_hyp_href}\n547\t\n548\t    # --- 6. what this car has taught -----------------------------------------\n549\t    try:\n550\t        case_match = cases_bridge.match(vin, open_codes) if open_codes else {\"matches\": [], \"count\": 0}\n551\t    except Exception:  # noqa: BLE001\n552\t        case_match = {\"matches\": [], \"count\": 0}\n553\t    taught = {\n554\t        \"codes\": codes_status,\n555\t        \"sessions\": this_row.get(\"sessions\"), \"first\": this_row.get(\"first\"),\n556\t        \"last\": this_row.get(\"last\"), \"case_matches\": case_match.get(\"matches\") or [],\n557\t    }\n558\t\n559\t    # --- 7. others' experience ------------------------------------------------\n560\t    try:\n561\t        experience = experience_bridge.links_for(family=key)\n562\t    except Exception:  # noqa: BLE001\n563\t        experience = {\"links\": [], \"count\": 0}\n564\t\n565\t    # --- 8. what else should I look at ----------------------------------------\n566\t    candidates: dict[str, dict[str, Any]] = {}\n567\t    for e in upstream + downstream:\n568\t        candidates.setdefault(e[\"system\"], e)\n569\t    for o, row in co_occ.items():\n570\t        candidates.setdefault(o, {\"system\": o, \"label\": labels.get(o, o),\n571\t                                  \"confidence\": \"UNKNOWN\", \"why\": row.get(\"reading\") or \"\",\n572\t                                  \"href\": f\"/v/{vin}/systems/{o}\"})\n573\t\n574\t    ranked = []\n575\t    for other_key, e in candidates.items():\n576\t        conf_w = _CONFIDENCE_WEIGHT.get(e.get(\"confidence\", \"UNKNOWN\"), 0.3)\n577\t        lift = (co_occ.get(other_key) or {}).get(\"lift\") or 1.0\n578\t        other_status = (by_system.get(other_key) or {}).get(\"status\") or \"clean\"\n579\t        unverified_mult = 1.5 if other_status in (\"cleared_unverified\", \"stale\") else 1.0\n580\t        score = conf_w * float(lift) * unverified_mult\n581\t        why_bits = [e.get(\"why\") or \"\"]\n582\t        if e.get(\"hot\"):\n583\t            why_bits.append(f\"seen together on this car ({e.get('lift'):.2f}x lift)\" if e.get(\"lift\") else\n584\t                            \"seen together on this car\")\n585\t        ranked.append({\"system\": other_key, \"label\": labels.get(other_key, other_key),\n586\t                       \"href\": f\"/v/{vin}/systems/{other_key}\", \"score\": score,\n587\t                       \"why\": \" -- \".join(b for b in why_bits if b)})\n588\t    ranked.sort(key=lambda r: r[\"score\"], reverse=True)\n589\t    look_at_next = ranked[:3]\n590\t\n591\t    # --- 9. learned DIDs correlated with this system's channels --------------\n592\t    chan_names = _channel_display_names(rec)\n593\t    learned_dids: list[dict[str, Any]] = []\n594\t    learned_available = True\n595\t    try:\n596\t        learned_data = learned_store.learned(vin) or {}\n597\t    except Exception:  # noqa: BLE001 -- an unreadable store is an honest empty state, not a 500\n598\t        learned_data = {}\n599\t        learned_available = False\n600\t    learned_entries = (learned_data.get(vin) or []) if isinstance(learned_data, dict) else []\n601\t    learned_broadcasts: list[dict[str, Any]] = []\n602\t    for entry in learned_entries:\n603\t        if entry.get(\"status\") != \"accepted\":\n604\t            continue\n605\t        if entry.get(\"kind\") == \"broadcast\":\n606\t            continue  # a different shape (bus/id, no module/did) -- handled below\n607\t        name = (entry.get(\"name\") or \"\").strip().lower()\n608\t        if name and name in chan_names:\n609\t            learned_dids.append({\n610\t                \"module\": entry.get(\"module\"), \"did\": entry.get(\"did\"),\n611\t                \"name\": entry.get(\"name\"), \"unit\": entry.get(\"unit\"),\n612\t                \"confidence\": entry.get(\"confidence\"), \"at\": entry.get(\"at\"),\n613\t                \"watch_href\": f\"/v/{vin}/liveboard?watch={entry.get('did')}\",\n614\t            })\n615\t    # broadcast signals -- learned from watching a bus, never from a UDS\n616\t    # request, so there is no scale: cuore.live.learned stamps every one\n617\t    # \"unknown\" and the page must say so plainly, same wording the Live\n618\t    # board itself uses for these (\"learned, unscaled\").\n619\t    for entry in learned_entries:\n620\t        if entry.get(\"status\") != \"accepted\" or entry.get(\"kind\") != \"broadcast\":\n621\t            continue\n622\t        name = (entry.get(\"name\") or \"\").strip().lower()\n623\t        if name and name in chan_names:\n624\t            learned_broadcasts.append({\n625\t                \"bus\": entry.get(\"bus\"), \"id\": entry.get(\"id\"), \"name\": entry.get(\"name\"),\n626\t                \"confidence\": entry.get(\"confidence\"), \"at\": entry.get(\"at\"),\n627\t                \"text\": \"learned, unscaled, raw\",\n628\t            })\n629\t    learned = {\"available\": learned_available, \"dids\": learned_dids, \"broadcasts\": learned_broadcasts}\n630\t\n631\t    # --- 10. freeze frame, this system's channels highlighted ----------------\n632\t    mapped_codes = {r[\"code\"] for r in codes_status}\n633\t    freeze_frames_view = []\n634\t    for ff in dview_freeze:\n635\t        base = _base_code(ff.get(\"code\") or \"\")\n636\t        if base not in mapped_codes:\n637\t            continue\n638\t        rows = [{\"name\": row.get(\"name\"), \"value\": row.get(\"value\"),\n639\t                \"highlighted\": (row.get(\"name\") or \"\").strip().lower() in chan_names}\n640\t               for row in ff.get(\"all\") or []]\n641\t        freeze_frames_view.append({\"code\": ff.get(\"code\"), \"rows\": rows,\n642\t                                   \"href\": f\"/v/{vin}/code/{base}\"})\n643\t\n644\t    return {\n645\t        \"key\": key, \"label\": label,\n646\t        \"status_strip\": status_strip,\n647\t        \"relationship\": relationship,\n648\t        \"components\": components,\n649\t        \"how_it_fails\": how_it_fails,\n650\t        \"hypotheses\": hypotheses,\n651\t        \"taught\": taught,\n652\t        \"experience\": experience,\n653\t        \"look_at_next\": look_at_next,\n654\t        \"learned\": learned,\n655\t        \"freeze_frames\": freeze_frames_view,\n656\t        \"live_mode06\": live_mode06,\n657\t        \"live_freeze_frames\": live_freeze,\n658\t        \"unknown_marker\": UNKNOWN_MARKER,\n659\t        \"attested_footnote\": (\"Mechanic inputs are attested claims, not car measurements: \"\n660\t                              \"they never replace the knowledge-table value shown beside them \"\n661\t                              \"and never enter the evidence gate as something the car itself \"\n662\t                              \"measured.\"),\n663\t    }\n664\t\n665\t\n666\t__all__ = [\"build_system_view\", \"UNKNOWN_MARKER\"]\n667\t"}]},"uuid":"be78dd1f-c9d5-48ee-8d94-a0f203ee8a58","timestamp":"2026-10-14T10:38:30.083Z","toolUseResult":{"type":"text","file":{"filePath":"C:\\Users\\User\\mcp-servers\\cuore\\services\\system_detail_bridge.py","content":"\"\"\"``build_system_view(vin, key)`` -- the per-system dive-in page's whole\nview model (``GET /v/{vin}/systems/{key}``, phase 1 of the Systems\ndive-in; the existing one-page map stays ``cuore/web/templates/\nsystems.html`` + ``cuore/services/systems_bridge.py``).\n\nThis module invents nothing. Every field is a pass-through (or a thin\nmerge) of other bridges that already carry their own sourcing:\n\n* ``systems_bridge`` -- the system record and this VIN's correlation\n  (codes-by-system, co-occurrence, chains).\n* ``dossier_bridge`` -- per-code ACTIVE/CLEARED_UNVERIFIED/STALE state\n  (``build_view``'s ``codes`` rows -- see that module's ``_code_status``,\n  the only place in ``cuore.services`` that computes this vocabulary) and\n  readiness-monitor state.\n* ``bench_bridge`` -- the car's one active blocker, if any.\n* ``known_good_bridge`` / ``liveboard_bridge`` -- sourced bands and the\n  live-board grading helper for this system's channels.\n* ``electrical_bridge`` -- layout elements, per-code wiring paths and\n  inspection records (the electrical layout's own system vocabulary does\n  not match the 25-key systems graph 1:1 -- see ``ELEMENT_TAGS_FOR``).\n* ``parts_bridge`` -- catalogue entries for this system's part keys.\n* ``jobs_bridge`` -- suggested and job-attached hypotheses, filtered to\n  this system.\n* ``cases_bridge`` -- case-memory matches for this system's open codes.\n* ``experience_bridge`` -- others' experience links for this family.\n\nNothing here raises for a data gap -- a missing bridge, a code with no\nsystems mapping, an element with no sourced location all degrade to the\npage's own UNKNOWN marker (see ``UNKNOWN_MARKER``) rather than a 500 or an\ninvented value. ``build_system_view`` returns ``None`` for a key that is\nnot in ``systems_bridge.systems()`` -- the route turns that into a 404.\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom typing import Any, Optional\n\nfrom .. import bootstrap  # noqa: F401 -- side effect: puts `mes` on sys.path\nfrom ..live import attested as attested_store\nfrom ..live import learned as learned_store\n\nfrom mes.systems import ELEMENT_TAGS_FOR, normalize_system  # noqa: E402\n\nfrom . import (\n    bench_bridge,\n    cases_bridge,\n    dossier_bridge,\n    electrical_bridge,\n    experience_bridge,\n    jobs_bridge,\n    known_good_bridge,\n    layout_bridge,\n    liveboard_bridge,\n    mes_bridge,\n    parts_bridge,\n    systems_bridge,\n    systems_map_bridge,\n)\n\n#: Fault trees whose ranked causes lead with the BCM supply feed (fuse F82,\n#: TSB S1808000005) then the inline connector/frame grounds (TSB\n#: S2008000032) -- see ``mes.faulttree.NETWORK_CASCADE`` steps N5/N6. Only\n#: this one tree exists today; keyed by its own ``key`` rather than hunting\n#: its steps at render time.\n_NETWORK_CASCADE_TEST = \"check BCM supply and grounds first\"\n\n#: The one marker every sourcing gap renders as -- never a guess, never a\n#: blank. Matches the wording already used across maintenance.html /\n#: torque.html / drivetrain_section.html / _code_brief.html.\nUNKNOWN_MARKER = \"Unknown — use the service manual (TechAuthority)\"\n\n#: dependency confidence -> a 0..1 weight, used only for ranking \"what\n#: else should I look at\" (section 8) -- never shown as a number on its\n#: own, always alongside the sourced confidence word.\n_CONFIDENCE_WEIGHT = {\"CONFIRMED\": 1.0, \"CORROBORATED\": 0.8,\n                     \"SINGLE-SOURCE\": 0.5, \"UNKNOWN\": 0.2}\n\n#: cuore.services.electrical_bridge's elements carry their own\n#: ``part_of_systems`` vocabulary (``mes.electrical.CANONICAL_SYSTEMS``),\n#: built independently of the 25-key systems graph and not a 1:1 match.\n#: This is the documented overlap -- a systems-graph key with no entry\n#: here simply has no electrical-layout elements merged in (its\n#: ``components`` list, from the systems record itself, still shows).\n#: ``mes.systems.ELEMENT_TAGS_FOR`` is the single source for this map --\n#: see that module for why (previously duplicated here under the same\n#: name, now just imported so the two vocabularies can never drift apart).\n\n#: Standard OBD-II monitor categories (SAE J1979 continuous/non-continuous\n#: monitor taxonomy -- factual, not vehicle-specific) a systems-graph key\n#: can plausibly carry. A key not listed here has no OBD monitor at all,\n#: which is itself a fact worth stating plainly rather than as a gap.\n_MONITOR_KEYWORDS: dict[str, list[str]] = {\n    \"evap\": [\"evap\"],\n    \"exhaust_emissions\": [\"catalyst\", \"secondary air\", \"heated catalyst\"],\n    \"engine_management\": [\"misfire\", \"comprehensive component\"],\n    \"fuel\": [\"fuel system\"],\n    \"air_intake_boost\": [\"secondary air\"],\n}\n\n\n# --- small helpers -----------------------------------------------------------\n\ndef _all_systems() -> dict[str, dict[str, Any]]:\n    try:\n        raw = systems_bridge.systems()\n    except Exception:  # noqa: BLE001 -- a knowledge-table miss must never 500\n        raw = {}\n    if isinstance(raw, dict):\n        return raw\n    return {s.get(\"key\"): s for s in (raw or []) if s.get(\"key\")}\n\n\ndef _correlate(vin: str) -> dict[str, Any]:\n    try:\n        return systems_bridge.correlate(vin) or {}\n    except Exception:  # noqa: BLE001\n        return {}\n\n\ndef _base_code(full: str) -> str:\n    return (full or \"\").split(\"-\")[0].strip().upper()\n\n\ndef _edge_kind(dep: dict[str, Any]) -> str:\n    \"\"\"\"electrical supply\" vs \"functional\" vs \"UNKNOWN\", from whatever the\n    edge's own ``technical.carries`` note says -- never a guess beyond\n    that note's own words.\"\"\"\n    if dep.get(\"system\") == \"electrical_supply\":\n        return \"electrical supply\"\n    carries = ((dep.get(\"technical\") or {}).get(\"carries\") or \"\").lower()\n    if any(w in carries for w in (\"volt\", \"supply\", \"ground\", \"current\", \"12 v\", \"amp\")):\n        return \"electrical supply\"\n    if carries or dep.get(\"why\"):\n        return \"functional\"\n    return \"UNKNOWN\"\n\n\ndef _dossier_codes_map(vin: str) -> dict[str, dict[str, Any]]:\n    try:\n        dossier = mes_bridge.workup(vin=vin)\n        view = dossier_bridge.build_view(vin, dossier, None)\n    except Exception:  # noqa: BLE001\n        return {}\n    return {r.get(\"code\"): r for r in (view.get(\"codes\") or [])}\n\n\ndef _live_value_for(channel_id: str, dview_freeze: list[dict[str, Any]]\n                    ) -> Optional[dict[str, Any]]:\n    \"\"\"The most recent sourced value CUORE has for ``channel_id`` -- a\n    freeze-frame snapshot carried from a real DTC event on this VIN (no\n    live-session store of \"latest reading per channel\" exists yet, so a\n    freeze frame is the closest sourced value there is), graded through\n    ``liveboard_bridge.evaluate`` exactly as the Live board grades it.\"\"\"\n    try:\n        name = known_good_bridge.known_good_for(channel_id) or {}\n        chan_name = name.get(\"name\") or channel_id.replace(\"_\", \" \")\n    except Exception:  # noqa: BLE001\n        chan_name = channel_id.replace(\"_\", \" \")\n    for ff in dview_freeze or []:\n        for row in (ff.get(\"key\") or []) + (ff.get(\"all\") or []):\n            if (row.get(\"name\") or \"\").strip().lower() != chan_name.strip().lower():\n                continue\n            raw = str(row.get(\"value\") or \"\")\n            num = \"\"\n            for ch in raw:\n                if ch.isdigit() or ch in \".-\":\n                    num += ch\n                elif num:\n                    break\n            try:\n                value = float(num)\n            except ValueError:\n                continue\n            try:\n                grade = liveboard_bridge.evaluate(channel_id, value)\n            except Exception:  # noqa: BLE001\n                grade = {\"level\": \"unknown\", \"text\": UNKNOWN_MARKER}\n            return {\"value\": raw, \"level\": grade.get(\"level\"), \"text\": grade.get(\"text\"),\n                    \"source\": f\"freeze frame, {ff.get('code')}\"}\n    return None\n\n\ndef _fact(attested_map: dict[str, dict[str, Any]], fact_key: str, raw_value: Optional[str]\n          ) -> dict[str, Any]:\n    \"\"\"One open-square UNKNOWN marker's full state: the sourced text (or\n    the marker itself), the key a mechanic's input against it is filed\n    under, and the most recent attested input on file for it (``None`` if\n    none). Never upgrades ``raw_value`` -- an attested row is shown\n    *alongside* the marker, never in place of it (see ``cuore.live.\n    attested``'s module docstring for why).\"\"\"\n    text = raw_value or UNKNOWN_MARKER\n    return {\n        \"text\": text, \"fact_key\": fact_key, \"is_unknown\": text == UNKNOWN_MARKER,\n        \"attested\": attested_map.get(fact_key),\n    }\n\n\ndef _channel_display_names(rec: dict[str, Any]) -> set[str]:\n    names: set[str] = set()\n    for ch in rec.get(\"live_channels\") or []:\n        try:\n            cg = known_good_bridge.known_good_for(ch) or {}\n        except Exception:  # noqa: BLE001\n            cg = {}\n        names.add((cg.get(\"name\") or ch.replace(\"_\", \" \")).strip().lower())\n    return names\n\n\n# --- the view model -----------------------------------------------------------\n\ndef build_system_view(vin: str, key: str) -> Optional[dict[str, Any]]:\n    \"\"\"Everything ``/v/{vin}/systems/{key}`` needs, or ``None`` if ``key``\n    is not one of ``systems_bridge.systems()``'s keys (the route 404s).\"\"\"\n    all_systems = _all_systems()\n    rec = all_systems.get(key)\n    if rec is None:\n        return None\n    labels = {k: (s.get(\"label\") or k) for k, s in all_systems.items()}\n    label = labels.get(key, key)\n\n    corr = _correlate(vin)\n    by_system = {r.get(\"system\"): r for r in (corr.get(\"by_system\") or [])}\n    this_row = by_system.get(key) or {}\n    dossier_codes = _dossier_codes_map(vin)\n\n    try:\n        attested_map = attested_store.latest_by_fact(vin, key)\n    except Exception:  # noqa: BLE001 -- a bad/missing store must never 500 the page\n        attested_map = {}\n\n    # --- 1. status strip -----------------------------------------------------\n    codes_status: list[dict[str, Any]] = []\n    for full in this_row.get(\"codes\") or []:\n        base = _base_code(full)\n        drow = dossier_codes.get(base)\n        codes_status.append({\n            \"code\": base, \"dtc\": full,\n            \"status\": (drow or {}).get(\"status\") or \"STALE\",\n            \"status_label\": (drow or {}).get(\"status_label\") or \"Stale\",\n            \"description\": (drow or {}).get(\"description\") or \"\",\n            \"href\": f\"/v/{vin}/code/{base}\",\n        })\n\n    # tonight's (or newest) live module sweep -- a direct from-car UDS read,\n    # independent of the MES-log corpus the loop above reads. A code already\n    # listed above (from the corpus) gets this merged on as \"live\"; a code\n    # the module sweep saw that the corpus has no row for yet (common for a\n    # network/body U- or B-code) becomes its own row, so it still shows up in\n    # \"This car's codes\" and still feeds \"how it fails here\" below.\n    live_chips = systems_map_bridge.module_dtc_overlay(vin)[\"by_system\"].get(key, [])\n    live_by_base: dict[str, list[dict[str, Any]]] = {}\n    for chip in live_chips:\n        live_by_base.setdefault(chip[\"code\"], []).append(chip)\n    for row in codes_status:\n        hits = live_by_base.get(row[\"code\"])\n        if not hits:\n            continue\n        newest = max(hits, key=lambda c: c.get(\"at\") or \"\")\n        row[\"live\"] = {\"state\": newest[\"state\"], \"at\": newest[\"at\"], \"ecu\": newest[\"ecu\"],\n                       \"chip_text\": newest[\"chip_text\"], \"failure_type\": newest[\"failure_type\"]}\n    matched_bases = {row[\"code\"] for row in codes_status}\n    for base, hits in live_by_base.items():\n        if base in matched_bases:\n            continue\n        newest = max(hits, key=lambda c: c.get(\"at\") or \"\")\n        is_active = newest[\"state\"] == \"ACTIVE\"\n        codes_status.append({\n            \"code\": base, \"dtc\": newest[\"full\"],\n            \"status\": \"ACTIVE\" if is_active else \"CLEARED_UNVERIFIED\",\n            \"status_label\": \"Active (live)\" if is_active else \"History since clear (live)\",\n            \"description\": \"\", \"href\": f\"/v/{vin}/code/{base}\",\n            \"live\": {\"state\": newest[\"state\"], \"at\": newest[\"at\"], \"ecu\": newest[\"ecu\"],\n                     \"chip_text\": newest[\"chip_text\"], \"failure_type\": newest[\"failure_type\"]},\n        })\n\n    monitor_keywords = _MONITOR_KEYWORDS.get(key)\n    if not monitor_keywords:\n        monitor = {\"has_monitor\": False}\n    else:\n        try:\n            dossier = mes_bridge.workup(vin=vin)\n            rp = dossier_bridge.readiness_panel(vin, dossier)\n        except Exception:  # noqa: BLE001\n            rp = {\"monitors\": [], \"at\": None, \"note\": None}\n        match = next((m for m in (rp.get(\"monitors\") or [])\n                     if any(kw in (m.get(\"name\") or \"\").lower() for kw in monitor_keywords)),\n                    None)\n        note_raw = None if match else (rp.get(\"note\") or \"no readiness read on file yet\")\n        monitor = {\"has_monitor\": True, \"at\": rp.get(\"at\"),\n                  \"name\": (match or {}).get(\"name\") or monitor_keywords[0].title(),\n                  \"status\": (match or {}).get(\"status\") if match else None,\n                  \"note\": note_raw,\n                  \"note_fact\": _fact(attested_map, f\"monitor:{key}\", note_raw) if note_raw is not None else None}\n\n    try:\n        dossier = mes_bridge.workup(vin=vin)\n        _dview = dossier_bridge.build_view(vin, dossier, None)\n        dview_freeze = _dview.get(\"freeze_frames\") or []\n    except Exception:  # noqa: BLE001\n        _dview = {}\n        dview_freeze = []\n    # EVAP only: this car's own from-car Mode $06 read and live freeze-frame\n    # sweep, read tonight -- see dossier_bridge.build_view's own \"mode06\"/\n    # \"live_freeze_frames\" keys. Other systems have neither today.\n    live_mode06 = _dview.get(\"mode06\") if key == \"evap\" else None\n    live_freeze = _dview.get(\"live_freeze_frames\") if key == \"evap\" else None\n    live_values = []\n    for ch in rec.get(\"live_channels\") or []:\n        try:\n            cg = known_good_bridge.known_good_for(ch) or {}\n            band = known_good_bridge.sourced_band(ch) or {}\n        except Exception:  # noqa: BLE001\n            cg, band = {}, {}\n        band_note_raw = band.get(\"note\") or None\n        live_values.append({\n            \"id\": ch, \"name\": cg.get(\"name\") or ch.replace(\"_\", \" \").title(),\n            \"band_note\": band_note_raw or UNKNOWN_MARKER,\n            \"band_fact\": _fact(attested_map, f\"live:{ch}\", band_note_raw),\n            \"band_confidence\": band.get(\"confidence\") or \"UNKNOWN\",\n            \"latest\": _live_value_for(ch, dview_freeze),\n        })\n\n    try:\n        bench = bench_bridge.build_bench(vin)\n        banner = bench.get(\"blocker_banner\") or {}\n    except Exception:  # noqa: BLE001\n        banner = {}\n    # bench_bridge._blocker_banner carries {icon, is_blocker, action, why,\n    # basis} -- only the car's own *active* blocker (is_blocker true)\n    # counts as a blocker here; a clean/no-data banner is not one.\n    blocker = {\"text\": banner.get(\"action\"), \"why\": banner.get(\"why\")} if banner.get(\"is_blocker\") else None\n\n    last_evidence = this_row.get(\"last\")\n\n    status_strip = {\n        \"codes\": codes_status, \"monitor\": monitor, \"live_values\": live_values,\n        \"blocker\": blocker, \"last_evidence\": last_evidence,\n        \"system_status\": this_row.get(\"status\") or \"stale\",\n    }\n\n    # --- 2. relationship ring --------------------------------------------------\n    co_occ = {}\n    for row in corr.get(\"co_occurrence\") or []:\n        a, b = row.get(\"a\"), row.get(\"b\")\n        other = b if a == key else (a if b == key else None)\n        if other and (row.get(\"sessions_together\") or 0) > 0:\n            co_occ[other] = row\n\n    def _dep_entry(dep: dict[str, Any], other_key: str) -> dict[str, Any]:\n        hot = co_occ.get(other_key)\n        why_raw = dep.get(\"why\") or None\n        source_raw = dep.get(\"source\") or None\n        return {\n            \"system\": other_key, \"label\": labels.get(other_key, other_key),\n            \"why\": why_raw or UNKNOWN_MARKER,\n            \"why_fact\": _fact(attested_map, f\"rel:{other_key}:why\", why_raw),\n            \"confidence\": (dep.get(\"confidence\") or \"UNKNOWN\").upper(),\n            \"source\": source_raw or UNKNOWN_MARKER,\n            \"source_fact\": _fact(attested_map, f\"rel:{other_key}:source\", source_raw),\n            \"kind\": _edge_kind(dep),\n            \"hot\": bool(hot),\n            \"lift\": hot.get(\"lift\") if hot else None,\n            \"href\": f\"/v/{vin}/systems/{other_key}\",\n        }\n\n    upstream = [_dep_entry(dep, dep.get(\"system\")) for dep in (rec.get(\"depends_on\") or [])\n               if dep.get(\"system\")]\n    downstream = []\n    for other_key, other_rec in all_systems.items():\n        if other_key == key:\n            continue\n        for dep in other_rec.get(\"depends_on\") or []:\n            if dep.get(\"system\") == key:\n                downstream.append(_dep_entry(dep, other_key))\n\n    related_keys = {e[\"system\"] for e in upstream} | {e[\"system\"] for e in downstream}\n    hot_only = [{\n        \"system\": other, \"label\": labels.get(other, other),\n        \"lift\": row.get(\"lift\"), \"sessions_together\": row.get(\"sessions_together\"),\n        \"reading\": row.get(\"reading\") or \"\",\n        \"href\": f\"/v/{vin}/systems/{other}\",\n    } for other, row in co_occ.items() if other not in related_keys]\n\n    relationship = {\"upstream\": upstream, \"downstream\": downstream, \"hot_only\": hot_only}\n\n    # --- 3. components, placed ---------------------------------------------\n    parts = []\n    for pkey in rec.get(\"parts\") or []:\n        try:\n            p = parts_bridge.part(pkey)\n        except Exception:  # noqa: BLE001\n            p = None\n        images = (p or {}).get(\"images\") or []\n        image_url = images[0].get(\"url\") if images and isinstance(images[0], dict) else None\n        image_fact = None if image_url else _fact(attested_map, f\"part:{pkey}:image\", None)\n        if p:\n            parts.append({\"key\": pkey, \"name\": p.get(\"name\") or pkey,\n                         \"href\": f\"/v/{vin}/parts#{pkey}\",\n                         \"image_url\": image_url, \"image_fact\": image_fact})\n        else:\n            parts.append({\"key\": pkey, \"name\": pkey.replace(\"_\", \" \"), \"href\": None,\n                         \"image_url\": None, \"image_fact\": image_fact})\n\n    try:\n        all_elements = electrical_bridge.list_elements()\n    except Exception:  # noqa: BLE001\n        all_elements = []\n    tags = set(ELEMENT_TAGS_FOR.get(key, []))\n    elements = [e for e in all_elements if tags & set(e.get(\"part_of_systems\") or [])]\n\n    try:\n        all_inspections = electrical_bridge.list_inspections(vin)\n    except Exception:  # noqa: BLE001\n        all_inspections = []\n    latest_inspection: dict[str, dict[str, Any]] = {}\n    for row in all_inspections:\n        eid = row.get(\"element\")\n        if eid in {e.get(\"id\") for e in elements}:\n            if eid not in latest_inspection or (row.get(\"at\") or \"\") > (latest_inspection[eid].get(\"at\") or \"\"):\n                latest_inspection[eid] = row\n\n    placed_components = []\n    for e in elements:\n        eid = e.get(\"id\")\n        loc = e.get(\"location\") or {}\n        location_note_raw = loc.get(\"description\") or None\n        latest_insp = latest_inspection.get(eid)\n        placed_components.append({\n            \"id\": eid, \"label\": e.get(\"label\") or eid,\n            \"zone\": loc.get(\"zone\") or UNKNOWN_MARKER,\n            \"location_note\": location_note_raw or UNKNOWN_MARKER,\n            \"location_fact\": _fact(attested_map, f\"element:{eid}:location\", location_note_raw),\n            \"location_confidence\": loc.get(\"confidence\") or \"UNKNOWN\",\n            \"inspection_hint\": e.get(\"inspection_hint\") or UNKNOWN_MARKER,\n            \"latest_inspection\": ({\n                \"condition\": latest_insp.get(\"condition\"), \"at\": latest_insp.get(\"at\"),\n                \"by\": latest_insp.get(\"by\"), \"note\": latest_insp.get(\"note\") or \"\",\n                \"photo_count\": len(latest_insp.get(\"media_ids\") or []),\n            } if latest_insp else None),\n            # pre-filled with element id (anchor) and system (query param) --\n            # electrical.html's own per-element \"Record inspection\" details/\n            # form (electrical_routes.py) already hides the element id, so\n            # jumping to its anchor is the whole pre-fill this page owes it.\n            #\n            # F1 (MECHANIC_REVIEW_3): the viewed system's own tag (e.g.\n            # \"evap\") is not necessarily this *element's* canonical system --\n            # a shared/gateway component like the BCM is pulled onto this\n            # page because one of its several part_of_systems tags matches,\n            # but electrical_routes.py's own ?system= filter keys on\n            # layout_bridge.canonical_system(e) (one tag per element, picked\n            # from the full part_of_systems list, not just this system's).\n            # Calling that same resolver here -- rather than guessing from\n            # the viewed system's tags -- guarantees the query param always\n            # matches what the electrical page will actually render, so\n            # id=\"el-{eid}\" is always present on the page the link lands on.\n            \"inspect_href\": (\n                f\"/v/{vin}/electrical?system={layout_bridge.canonical_system(e)}#el-{eid}\"\n            ),\n        })\n\n    wiring_paths = []\n    for row in codes_status:\n        if row[\"status\"] not in (\"ACTIVE\", \"CLEARED_UNVERIFIED\"):\n            continue\n        try:\n            path = electrical_bridge.path_for_code(row[\"code\"])\n        except Exception:  # noqa: BLE001\n            path = None\n        if path and path.get(\"path\"):\n            wiring_paths.append({\"code\": row[\"code\"], \"path\": path.get(\"path\"),\n                                 \"note\": path.get(\"note\")})\n\n    components = {\"parts\": parts, \"elements\": placed_components, \"wiring_paths\": wiring_paths}\n\n    # --- 4. how it fails here ------------------------------------------------\n    open_codes = [r[\"code\"] for r in codes_status if r[\"status\"] in (\"ACTIVE\", \"CLEARED_UNVERIFIED\")]\n    fault_tree = None\n    if open_codes:\n        try:\n            fault_tree = mes_bridge.fault_tree(\",\".join(open_codes), vin=vin)\n        except Exception:  # noqa: BLE001\n            fault_tree = None\n\n    do_it_now_href = f\"/v/{vin}/job?step=6\"\n    next_test_label = None\n    try:\n        from mes import mechanic_tests as _mech  # noqa: PLC0415 -- being built in parallel\n    except Exception:  # noqa: BLE001\n        _mech = None\n    if _mech is not None and open_codes:\n        try:\n            finder = getattr(_mech, \"tests_for_code\", None) or getattr(_mech, \"find_test\", None)\n            match = finder(open_codes[0]) if finder else None\n            test_id = None\n            if isinstance(match, dict):\n                test_id = match.get(\"id\") or match.get(\"test_id\")\n                next_test_label = match.get(\"label\") or match.get(\"name\")\n            elif isinstance(match, (list, tuple)) and match:\n                first = match[0]\n                test_id = first.get(\"id\") if isinstance(first, dict) else None\n                next_test_label = first.get(\"label\") if isinstance(first, dict) else None\n            if test_id:\n                do_it_now_href = f\"/v/{vin}/tests#test-{test_id}\"\n        except Exception:  # noqa: BLE001\n            pass\n\n    # A matched network-cascade tree (BCM/RFHUB/DTCM lost-communication\n    # U-codes, or B1040) always offers its own ranked first real test --\n    # fuse F82/BCM supply (N5), then the connector/grounds (N6) -- ahead of\n    # whatever mechanic_tests found, since a generic per-code test would\n    # send the mechanic chasing one of the U-codes as its own component\n    # fault rather than the one real network event behind all of them.\n    if fault_tree and any(t.get(\"tree\") == \"network-cascade\" for t in (fault_tree.get(\"trees\") or [])):\n        next_test_label = _NETWORK_CASCADE_TEST\n\n    how_it_fails = {\"fault_tree\": fault_tree, \"open_codes\": open_codes,\n                    \"next_test_label\": next_test_label, \"do_it_now_href\": do_it_now_href}\n\n    # --- 5. hypotheses touching this system -----------------------------------\n    # Both sides are resolved through the one shared alias table\n    # (mes.systems.normalize_system) instead of a local label/substring\n    # match -- suggested_hypotheses' \"system\" is still free text (\"EVAP\",\n    # a dossier family key, ...); job hypotheses' \"system\" is already a\n    # normalized key (mes.jobs resolves it on write/read), and\n    # normalize_system is a no-op for an already-normalized key.\n    hyps = []\n    try:\n        jv = jobs_bridge.build_job_view(vin)\n    except Exception:  # noqa: BLE001\n        jv = {}\n    for sugg in jv.get(\"suggested_hypotheses\") or []:\n        if normalize_system(sugg.get(\"system\")) == key:\n            hyps.append({\"text\": sugg.get(\"text\"), \"status\": \"suggested\",\n                        \"evidence_count\": len(sugg.get(\"evidence_for\") or []) +\n                                          len(sugg.get(\"evidence_against\") or []),\n                        \"next_test\": sugg.get(\"next_test\")})\n    job = jv.get(\"job\") or {}\n    for h in job.get(\"hypotheses\") or []:\n        if normalize_system(h.get(\"system\")) == key:\n            hyps.append({\"text\": h.get(\"text\"), \"status\": h.get(\"status\") or \"open\",\n                        \"evidence_count\": len(h.get(\"evidence_for\") or []) +\n                                          len(h.get(\"evidence_against\") or []),\n                        \"next_test\": None})\n\n    add_hyp_href = f\"/v/{vin}/job?step=7&system={key}&codes={','.join(open_codes)}\"\n    hypotheses = {\"rows\": hyps, \"add_href\": add_hyp_href}\n\n    # --- 6. what this car has taught -----------------------------------------\n    try:\n        case_match = cases_bridge.match(vin, open_codes) if open_codes else {\"matches\": [], \"count\": 0}\n    except Exception:  # noqa: BLE001\n        case_match = {\"matches\": [], \"count\": 0}\n    taught = {\n        \"codes\": codes_status,\n        \"sessions\": this_row.get(\"sessions\"), \"first\": this_row.get(\"first\"),\n        \"last\": this_row.get(\"last\"), \"case_matches\": case_match.get(\"matches\") or [],\n    }\n\n    # --- 7. others' experience ------------------------------------------------\n    try:\n        experience = experience_bridge.links_for(family=key)\n    except Exception:  # noqa: BLE001\n        experience = {\"links\": [], \"count\": 0}\n\n    # --- 8. what else should I look at ----------------------------------------\n    candidates: dict[str, dict[str, Any]] = {}\n    for e in upstream + downstream:\n        candidates.setdefault(e[\"system\"], e)\n    for o, row in co_occ.items():\n        candidates.setdefault(o, {\"system\": o, \"label\": labels.get(o, o),\n                                  \"confidence\": \"UNKNOWN\", \"why\": row.get(\"reading\") or \"\",\n                                  \"href\": f\"/v/{vin}/systems/{o}\"})\n\n    ranked = []\n    for other_key, e in candidates.items():\n        conf_w = _CONFIDENCE_WEIGHT.get(e.get(\"confidence\", \"UNKNOWN\"), 0.3)\n        lift = (co_occ.get(other_key) or {}).get(\"lift\") or 1.0\n        other_status = (by_system.get(other_key) or {}).get(\"status\") or \"clean\"\n        unverified_mult = 1.5 if other_status in (\"cleared_unverified\", \"stale\") else 1.0\n        score = conf_w * float(lift) * unverified_mult\n        why_bits = [e.get(\"why\") or \"\"]\n        if e.get(\"hot\"):\n            why_bits.append(f\"seen together on this car ({e.get('lift'):.2f}x lift)\" if e.get(\"lift\") else\n                            \"seen together on this car\")\n        ranked.append({\"system\": other_key, \"label\": labels.get(other_key, other_key),\n                       \"href\": f\"/v/{vin}/systems/{other_key}\", \"score\": score,\n                       \"why\": \" -- \".join(b for b in why_bits if b)})\n    ranked.sort(key=lambda r: r[\"score\"], reverse=True)\n    look_at_next = ranked[:3]\n\n    # --- 9. learned DIDs correlated with this system's channels --------------\n    chan_names = _channel_display_names(rec)\n    learned_dids: list[dict[str, Any]] = []\n    learned_available = True\n    try:\n        learned_data = learned_store.learned(vin) or {}\n    except Exception:  # noqa: BLE001 -- an unreadable store is an honest empty state, not a 500\n        learned_data = {}\n        learned_available = False\n    learned_entries = (learned_data.get(vin) or []) if isinstance(learned_data, dict) else []\n    learned_broadcasts: list[dict[str, Any]] = []\n    for entry in learned_entries:\n        if entry.get(\"status\") != \"accepted\":\n            continue\n        if entry.get(\"kind\") == \"broadcast\":\n            continue  # a different shape (bus/id, no module/did) -- handled below\n        name = (entry.get(\"name\") or \"\").strip().lower()\n        if name and name in chan_names:\n            learned_dids.append({\n                \"module\": entry.get(\"module\"), \"did\": entry.get(\"did\"),\n                \"name\": entry.get(\"name\"), \"unit\": entry.get(\"unit\"),\n                \"confidence\": entry.get(\"confidence\"), \"at\": entry.get(\"at\"),\n                \"watch_href\": f\"/v/{vin}/liveboard?watch={entry.get('did')}\",\n            })\n    # broadcast signals -- learned from watching a bus, never from a UDS\n    # request, so there is no scale: cuore.live.learned stamps every one\n    # \"unknown\" and the page must say so plainly, same wording the Live\n    # board itself uses for these (\"learned, unscaled\").\n    for entry in learned_entries:\n        if entry.get(\"status\") != \"accepted\" or entry.get(\"kind\") != \"broadcast\":\n            continue\n        name = (entry.get(\"name\") or \"\").strip().lower()\n        if name and name in chan_names:\n            learned_broadcasts.append({\n                \"bus\": entry.get(\"bus\"), \"id\": entry.get(\"id\"), \"name\": entry.get(\"name\"),\n                \"confidence\": entry.get(\"confidence\"), \"at\": entry.get(\"at\"),\n                \"text\": \"learned, unscaled, raw\",\n            })\n    learned = {\"available\": learned_available, \"dids\": learned_dids, \"broadcasts\": learned_broadcasts}\n\n    # --- 10. freeze frame, this system's channels highlighted ----------------\n    mapped_codes = {r[\"code\"] for r in codes_status}\n    freeze_frames_view = []\n    for ff in dview_freeze:\n        base = _base_code(ff.get(\"code\") or \"\")\n        if base not in mapped_codes:\n            continue\n        rows = [{\"name\": row.get(\"name\"), \"value\": row.get(\"value\"),\n                \"highlighted\": (row.get(\"name\") or \"\").strip().lower() in chan_names}\n               for row in ff.get(\"all\") or []]\n        freeze_frames_view.append({\"code\": ff.get(\"code\"), \"rows\": rows,\n                                   \"href\": f\"/v/{vin}/code/{base}\"})\n\n    return {\n        \"key\": key, \"label\": label,\n        \"status_strip\": status_strip,\n        \"relationship\": relationship,\n        \"components\": components,\n        \"how_it_fails\": how_it_fails,\n        \"hypotheses\": hypotheses,\n        \"taught\": taught,\n        \"experience\": experience,\n        \"look_at_next\": look_at_next,\n        \"learned\": learned,\n        \"freeze_frames\": freeze_frames_view,\n        \"live_mode06\": live_mode06,\n        \"live_freeze_frames\": live_freeze,\n        \"unknown_marker\": UNKNOWN_MARKER,\n        \"attested_footnote\": (\"Mechanic inputs are attested claims, not car measurements: \"\n                              \"they never replace the knowledge-table value shown beside them \"\n                              \"and never enter the evidence gate as something the car itself \"\n                              \"measured.\"),\n    }\n\n\n__all__ = [\"build_system_view\", \"UNKNOWN_MARKER\"]\n","numLines":667,"startLine":1,"totalLines":667}},"sourceToolAssistantUUID":"49f2e580-928c-46b1-812d-a83eec2bac36","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
{"parentUuid":"be78dd1f-c9d5-48ee-8d94-a0f203ee8a58","isSidechain":true,"agentId":"a0c5cf5696591fb76","message":{"model":"claude-sonnet-5","id":"msg_011Cg1z5r75e2t1pHPYXdJeg","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01QjYBW44JRKVEtt8jm6QtJE","name":"Read","input":{"file_path":"C:\\Users\\User\\mcp-servers\\mes-log-mcp\\mes\\electrical.py"},"caller":{"type":"direct"}}],"container":null,"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":242,"cache_read_input_tokens":63772,"output_tokens":180,"output_tokens_details":{"thinking_tokens":25},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":0,"ephemeral_5m_input_tokens":242},"inference_geo":"global","iterations":[{"input_tokens":2,"output_tokens":180,"cache_read_input_tokens":63772,"cache_creation_input_tokens":242,"cache_creation":{"ephemeral_5m_input_tokens":242,"ephemeral_1h_input_tokens":0},"type":"message"}],"speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_01QjYBW44JRKVEtt8jm6QtJE":{"file_path":"C:\\Users\\User\\mcp-servers\\mes-log-mcp\\mes\\electrical.py"}},"serverClassifierRequest":"f1cd57c8-4cf6-4e36-ac4d-c6402fce05ea","apiBlockIndex":2,"requestId":"req_011Cg1z5qUdUXgupfZwkaPnn","attributionAgent":"general-purpose","type":"assistant","uuid":"f11088b5-1e30-472d-b5c3-7db65089fb96","timestamp":"2026-10-14T10:38:30.122Z","effort":"high","perTurnEffort":null,"userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
{"parentUuid":"f11088b5-1e30-472d-b5c3-7db65089fb96","isSidechain":true,"promptId":"50058817-5b8d-4005-85b7-b0699d0c6b2b","agentId":"a0c5cf5696591fb76","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01QjYBW44JRKVEtt8jm6QtJE","type":"tool_result","content":"1\t\"\"\"Electrical architecture: elements, circuits and inspection records for the\n2\t2018 Alfa Romeo Stelvio 2.0T (GU).\n3\t\n4\tCompanion to :mod:`mes.parts` and :mod:`mes.knowledge`: this module answers\n5\t\"where is it, what feeds it, what should I look at\" at a plain-words level,\n6\tfor the technician standing at the car with a multimeter, not a pinout\n7\tdiagram. It is deliberately conservative about what it claims to know.\n8\t\n9\tConfidence levels (same posture as :mod:`mes.parts` -- never invented):\n10\t\n11\t* ``CONFIRMED``     -- a manufacturer document (TSB, module map built from\n12\t                       this car's own scans) states it directly.\n13\t* ``SINGLE_SOURCE`` -- one source (usually a TSB) names the element but not\n14\t                       every detail about it (e.g. a TSB names a connector\n15\t                       but not its panel location).\n16\t* ``INFERRED``       -- reasoned from sourced facts, with the reasoning\n17\t                       stated (e.g. \"the ESIM is co-located with the\n18\t                       canister per TSB 9100469's framing\").\n19\t* ``UNKNOWN``        -- nothing credible sourced. ``location.description``\n20\t                       is literally the word \"UNKNOWN\" plus the\n21\t                       TechAuthority pointer; never a guessed zone, never a\n22\t                       guessed pin or connector number.\n23\t\n24\tHouse rule, non-negotiable: no connector id, pin number or panel location\n25\tis ever invented. Where a TSB or the module map does not say it, this module\n26\tsays ``UNKNOWN`` and points at the service manual.\n27\t\n28\tSources used here:\n29\t\n30\t* ``mes.knowledge`` (TSB_CATALOGUE transcription) -- S1808000005 (BCM power\n31\t  feeds / fuse F82), S2008000032 (connector XY201, grounds G003A/G003B),\n32\t  S1708000262 (spread/pushed-out terminals), S2308000004 (B+/ground\n33\t  verification), 9100471/9100469/9100325 (EVAP canister/ESIM/purge hardware).\n34\t* ``docs/research/EVAP_STELVIO.md`` -- canister/ESIM physical siting\n35\t  (\"behind the driver's-side rear wheel liner\"), purge-path architecture.\n36\t* ``docs/reference/GIORGIO_MODULE_MAP.md`` -- which modules exist on this\n37\t  car and which bus they answer on. This file is a *network* map, not a\n38\t  *physical* one: it confirms a module is real and reachable, but says\n39\t  nothing about where it is bolted in the car, so module physical location\n40\t  is UNKNOWN throughout unless some other source (a TSB) says otherwise.\n41\t\"\"\"\n42\t\n43\tfrom __future__ import annotations\n44\t\n45\tfrom typing import Any, Optional\n46\t\n47\tCONFIRMED = \"CONFIRMED\"\n48\tSINGLE_SOURCE = \"SINGLE-SOURCE\"\n49\tINFERRED = \"INFERRED\"\n50\tUNKNOWN = \"UNKNOWN\"\n51\t\n52\tCONFIDENCE_LEVELS = (CONFIRMED, SINGLE_SOURCE, INFERRED, UNKNOWN)\n53\t\n54\tTECHAUTHORITY = \"use the service manual (TechAuthority) wiring diagrams\"\n55\t\n56\tZONES = (\n57\t    \"engine_bay\", \"cabin_driver\", \"cabin_passenger\", \"dash\", \"trunk\",\n58\t    \"underbody\", \"rear_left_wheel_well\", \"rear_right_wheel_well\",\n59\t    \"front_left_wheel_well\", \"front_right_wheel_well\", \"unknown\",\n60\t)\n61\t\n62\tKINDS = (\n63\t    \"fuse_box\", \"fuse\", \"relay\", \"ground\", \"connector\", \"splice\",\n64\t    \"harness_section\", \"module\", \"battery\", \"alternator\",\n65\t)\n66\t\n67\t_MODULE_MAP = \"docs/reference/GIORGIO_MODULE_MAP.md\"\n68\t_EVAP_DOC = \"docs/research/EVAP_STELVIO.md\"\n69\t_KNOWLEDGE = \"mes-log-mcp/mes/knowledge.py (TSB_CATALOGUE transcription)\"\n70\t\n71\t\n72\tdef _loc(zone: str, description: str, source: str,\n73\t         confidence: str = UNKNOWN) -> dict[str, Any]:\n74\t    if zone not in ZONES:\n75\t        raise ValueError(f\"unknown zone {zone!r}\")\n76\t    if confidence not in CONFIDENCE_LEVELS:\n77\t        raise ValueError(f\"unknown confidence {confidence!r}\")\n78\t    if confidence == UNKNOWN and TECHAUTHORITY not in description:\n79\t        description = description.rstrip(\". \") + f\". {TECHAUTHORITY}.\"\n80\t    return {\"zone\": zone, \"description\": description, \"source\": source,\n81\t            \"confidence\": confidence}\n82\t\n83\t\n84\tdef _unknown_loc(note: str = \"\") -> dict[str, Any]:\n85\t    desc = \"UNKNOWN -- not sourced in this repo's TSBs or docs.\"\n86\t    if note:\n87\t        desc += \" \" + note\n88\t    return _loc(\"unknown\", desc, source=\"none\", confidence=UNKNOWN)\n89\t\n90\t\n91\tdef _el(kind: str, label: str, location: dict[str, Any],\n92\t        feeds: Optional[list[str]] = None,\n93\t        part_of_systems: Optional[list[str]] = None,\n94\t        tsb_refs: Optional[list[str]] = None,\n95\t        inspection_hint: str = \"\", notes: str = \"\") -> dict[str, Any]:\n96\t    if kind not in KINDS:\n97\t        raise ValueError(f\"unknown kind {kind!r}\")\n98\t    return {\n99\t        \"kind\": kind, \"label\": label, \"location\": location,\n100\t        \"feeds\": list(feeds or []),\n101\t        \"part_of_systems\": list(part_of_systems or []),\n102\t        \"tsb_refs\": list(tsb_refs or []),\n103\t        \"inspection_hint\": inspection_hint or \"not specified -- visual \"\n104\t                           \"inspection for corrosion, chafe, water ingress\",\n105\t        \"notes\": notes,\n106\t    }\n107\t\n108\t\n109\t# ---------------------------------------------------------------------------\n110\t# ELEMENTS\n111\t# ---------------------------------------------------------------------------\n112\t\n113\tELEMENTS: dict[str, dict[str, Any]] = {\n114\t\n115\t    \"battery\": _el(\n116\t        \"battery\", \"12V battery\",\n117\t        _unknown_loc(\"Giorgio-platform cars (Giulia/Stelvio) are commonly \"\n118\t                     \"reported to carry the 12V battery in the cargo \"\n119\t                     \"area, but this has not been confirmed against a \"\n120\t                     \"TechAuthority diagram or this car's own service \"\n121\t                     \"history, so it is not asserted here.\"),\n122\t        feeds=[\"f82\", \"bcm_feed_20a\", \"ecm\"],\n123\t        part_of_systems=[\"charging\", \"network\", \"cranking\"],\n124\t        tsb_refs=[\"S2308000004\", \"S1408000384\"],\n125\t        inspection_hint=\"terminal corrosion, loose clamp/strap, parasitic \"\n126\t                         \"draw (BCM DID 1005 current field on this car's \"\n127\t                         \"own module map)\",\n128\t        notes=\"S2308000004 ('cranks, no start'): verify ALL ECM/PCM B+ \"\n129\t              \"feeds and grounds -- the battery and its cabling are the \"\n130\t              \"first hop on any no-start or multi-module-dark complaint.\",\n131\t    ),\n132\t\n133\t    \"ecm\": _el(\n134\t        \"module\", \"ECM/PCM -- Magneti Marelli IAW 10JA\",\n135\t        _unknown_loc(\"GIORGIO_MODULE_MAP.md confirms this module's network \"\n136\t                      \"address (CAN-C, TA 0x10) from this car's own scans, \"\n137\t                      \"but is a bus map, not a physical-location document; \"\n138\t                      \"it says nothing about where the ECM is bolted.\"),\n139\t        feeds=[],\n140\t        part_of_systems=[\"evap\", \"network\", \"misfire\", \"cranking\"],\n141\t        tsb_refs=[\"18-030-17 REV. B\", \"S2308000004\"],\n142\t        inspection_hint=\"B+ and ground feeds per S2308000004 before any \"\n143\t                         \"sensor/actuator circuit is condemned\",\n144\t        notes=\"Network identity (header 18DA10F1, TA 0x10) is CONFIRMED \"\n145\t              \"per \" + _MODULE_MAP + \"; physical mounting is UNKNOWN here.\",\n146\t    ),\n147\t\n148\t    \"bcm\": _el(\n149\t        \"module\", \"BCM -- Body Computer Marelli 949 (gateway)\",\n150\t        _unknown_loc(\"GIORGIO_MODULE_MAP.md confirms this module's network \"\n151\t                      \"address and that it gateways CAN-C to CAN-IHS, but \"\n152\t                      \"is a bus map, not a physical-location document.\"),\n153\t        feeds=[],\n154\t        part_of_systems=[\"network\", \"evap\", \"lighting\"],\n155\t        tsb_refs=[\"S1808000005\", \"S2008000032\", \"S1708000262\"],\n156\t        inspection_hint=\"power feeds first (F82, standalone 20A fuse), \"\n157\t                         \"then the XY201 connector and frame grounds \"\n158\t                         \"G003A/G003B, then terminal condition\",\n159\t        notes=\"S1808000005: 'A BCM losing its feed drops off the bus and \"\n160\t              \"everything gatewaying through it throws U-codes.' Network \"\n161\t              \"identity (header 18DA40F1, TA 0x40, gateway role) is \"\n162\t              \"CONFIRMED per \" + _MODULE_MAP + \".\",\n163\t    ),\n164\t\n165\t    \"f82\": _el(\n166\t        \"fuse\", \"Fuse F82 (A901 circuit)\",\n167\t        _loc(\"trunk\",\n168\t             \"Named by TSB as being in the 'rear PDC' (rear power \"\n169\t             \"distribution center); the TSB does not specify which panel \"\n170\t             \"or cavity within the rear PDC, so only the general area \"\n171\t             \"(rear of car, consistent with a trunk-area fuse box on this \"\n172\t             \"platform) is recorded -- not a specific physical spot.\",\n173\t             source=\"TSB S1808000005\", confidence=SINGLE_SOURCE),\n174\t        feeds=[\"bcm\"],\n175\t        part_of_systems=[\"network\"],\n176\t        tsb_refs=[\"S1808000005\"],\n177\t        inspection_hint=\"check fuse condition and seating; this is the \"\n178\t                         \"named BCM supply fuse on GU/Stelvio per the TSB\",\n179\t        notes=\"S1808000005: 'on GU/Stelvio inspect fuse F82 in the rear \"\n180\t              \"PDC (A901 circuit)'.\",\n181\t    ),\n182\t\n183\t    \"bcm_feed_20a\": _el(\n184\t        \"fuse\", \"Standalone 20A fuse (BCM power feed)\",\n185\t        _unknown_loc(\"TSB names this fuse's rating and role but not its \"\n186\t                      \"panel location.\"),\n187\t        feeds=[\"bcm\"],\n188\t        part_of_systems=[\"network\"],\n189\t        tsb_refs=[\"S1808000005\"],\n190\t        inspection_hint=\"inspect for a blown or loose fuse alongside F82\",\n191\t        notes=\"S1808000005: 'Inspect all BCM power feeds including the \"\n192\t              \"standalone 20A fuse.'\",\n193\t    ),\n194\t\n195\t    \"xy201\": _el(\n196\t        \"connector\", \"Inline connector XY201\",\n197\t        _unknown_loc(\"TSB names this connector by id but gives no panel \"\n198\t                      \"location and no pin numbers -- none are invented \"\n199\t                      \"here.\"),\n200\t        feeds=[],\n201\t        part_of_systems=[\"network\"],\n202\t        tsb_refs=[\"S2008000032\"],\n203\t        inspection_hint=\"securing/seating -- TSB's fix was 'securing inline \"\n204\t                         \"connector XY201', no parts replaced\",\n205\t        notes=\"S2008000032: multi-module warning cascade resolved by \"\n206\t              \"securing XY201 and cleaning G003A/G003B; NHTSA scope is \"\n207\t              \"2020 Stelvio, GU circuitry shared but verify applicability \"\n208\t              \"to this VIN/model year before treating as a known fix.\",\n209\t    ),\n210\t\n211\t    \"g003a\": _el(\n212\t        \"ground\", \"Frame ground G003A\",\n213\t        _loc(\"underbody\",\n214\t             \"TSB calls these 'frame grounds', which on this platform \"\n215\t             \"family means a body/chassis ground point, not an \"\n216\t             \"under-hood or in-cabin ground; exact body location is not \"\n217\t             \"given by the TSB.\",\n218\t             source=\"TSB S2008000032\", confidence=SINGLE_SOURCE),\n219\t        feeds=[],\n220\t        part_of_systems=[\"network\"],\n221\t        tsb_refs=[\"S2008000032\"],\n222\t        inspection_hint=\"clean to bare metal, check torque/tightness\",\n223\t        notes=\"Paired with G003B; TSB fix was cleaning both, no parts.\",\n224\t    ),\n225\t\n226\t    \"g003b\": _el(\n227\t        \"ground\", \"Frame ground G003B\",\n228\t        _loc(\"underbody\",\n229\t             \"Same sourcing and caveats as G003A -- see that entry.\",\n230\t             source=\"TSB S2008000032\", confidence=SINGLE_SOURCE),\n231\t        feeds=[],\n232\t        part_of_systems=[\"network\"],\n233\t        tsb_refs=[\"S2008000032\"],\n234\t        inspection_hint=\"clean to bare metal, check torque/tightness\",\n235\t        notes=\"Paired with G003A.\",\n236\t    ),\n237\t\n238\t    \"esim_connector\": _el(\n239\t        \"connector\", \"ESIM connector / harness run\",\n240\t        _loc(\"rear_left_wheel_well\",\n241\t             \"The vapor canister assembly (Mopar 68528496AA) is reported \"\n242\t             \"'behind the driver's-side rear wheel liner' (US LHD = left \"\n243\t             \"side); TSB 9100469 establishes the ESIM (Evaporative System \"\n244\t             \"Integrity Module detector) as a separately serviceable part \"\n245\t             \"from the canister but does not itself restate the canister's \"\n246\t             \"siting. INFERRED: the ESIM and its connector/harness run are \"\n247\t             \"co-located with the canister because they are described and \"\n248\t             \"serviced as a unit in 9100471 ('replace BOTH canister and \"\n249\t             \"ESIM'). The exact connector id/pin-out is not sourced -- \"\n250\t             \"none is invented.\",\n251\t             source=_EVAP_DOC + \" + TSB 9100469/9100471\", confidence=INFERRED),\n252\t        feeds=[],\n253\t        part_of_systems=[\"evap\"],\n254\t        tsb_refs=[\"9100469\", \"9100471\", \"9100325 Rev 1\"],\n255\t        inspection_hint=\"connector seating/corrosion, and -- per 9100471 -- \"\n256\t                         \"whether the canister/ESIM housing is wet with \"\n257\t                         \"liquid fuel (flooding mode, not a simple \"\n258\t                         \"electrical fault)\",\n259\t        notes=\"9100471: fuel flooding traced to a disconnected internal \"\n260\t              \"vapor line at the FDM port, not a water-ingress TSB (none \"\n261\t              \"found in a full-text sweep per EVAP_STELVIO.md).\",\n262\t    ),\n263\t\n264\t    \"esim_ground\": _el(\n265\t        \"ground\", \"ESIM ground point\",\n266\t        _unknown_loc(\"No TSB or doc in this repo identifies the ESIM's \"\n267\t                      \"own ground point; it is placed in the same zone as \"\n268\t                      \"the ESIM connector only because that is the nearest \"\n269\t                      \"sourced landmark, not because the ground point \"\n270\t                      \"itself has been confirmed there.\"),\n271\t        feeds=[],\n272\t        part_of_systems=[\"evap\"],\n273\t        tsb_refs=[],\n274\t        inspection_hint=\"voltage-drop test ESIM ground circuit before \"\n275\t                         \"condemning the sensor itself\",\n276\t        notes=\"\",\n277\t    ),\n278\t\n279\t    \"purge_valve_connector\": _el(\n280\t        \"connector\", \"Purge control valve connector\",\n281\t        _loc(\"engine_bay\",\n282\t             \"9100325 Rev 1 covers purge hose routing at the ejector \"\n283\t             \"tees, purge solenoid and intake -- all engine-bay items, \"\n284\t             \"which places the purge solenoid/valve in the engine bay. \"\n285\t             \"The connector's own pin-out/id is not given by the TSB.\",\n286\t             source=\"TSB 9100325 Rev 1\", confidence=INFERRED),\n287\t        feeds=[],\n288\t        part_of_systems=[\"evap\"],\n289\t        tsb_refs=[\"9100325 Rev 1\"],\n290\t        inspection_hint=\"hose routing at ejector tees per 9100325; \"\n291\t                         \"actuator test (Evaporation control valve) via \"\n292\t                         \"MES/wiTECH before condemning the valve\",\n293\t        notes=\"Shop log evidence (EVAP_STELVIO.md): 6/6 purge actuator \"\n294\t              \"tests COMPLETED while P0456 was active -- the valve \"\n295\t              \"actuated correctly, so a connector/wiring fault is not \"\n296\t              \"supported by that evidence either; this is a hardware \"\n297\t              \"leak-path problem more often than an electrical one.\",\n298\t    ),\n299\t\n300\t    \"abs_module\": _el(\n301\t        \"module\", \"ABS/ESC module -- Continental MK C1\",\n302\t        _unknown_loc(\"GIORGIO_MODULE_MAP.md confirms this module answers \"\n303\t                      \"on CAN-CH via the grey A6 cable, which is network \"\n304\t                      \"topology, not physical mounting.\"),\n305\t        feeds=[], part_of_systems=[\"network\", \"chassis\"],\n306\t        tsb_refs=[], inspection_hint=\"\",\n307\t        notes=\"CAN-CH/grey-A6 address CONFIRMED per \" + _MODULE_MAP + \"; \"\n308\t              \"physical location UNKNOWN here.\",\n309\t    ),\n310\t\n311\t    \"half_module\": _el(\n312\t        \"module\", \"HALF -- haptic lane-feedback camera (Bosch MFK2)\",\n313\t        _unknown_loc(\"GIORGIO_MODULE_MAP.md confirms this module answers \"\n314\t                      \"on CAN-CH via the grey A6 cable; no physical \"\n315\t                      \"location is given.\"),\n316\t        feeds=[], part_of_systems=[\"network\", \"adas\"],\n317\t        tsb_refs=[], inspection_hint=\"\",\n318\t        notes=\"CAN-CH/grey-A6 address CONFIRMED per \" + _MODULE_MAP + \".\",\n319\t    ),\n320\t\n321\t    \"dasm_module\": _el(\n322\t        \"module\", \"DASM -- driver assistance radar (Bosch)\",\n323\t        _unknown_loc(\"GIORGIO_MODULE_MAP.md confirms this module answers \"\n324\t                      \"on CAN-C with no cable (7/7 scans); no physical \"\n325\t                      \"location is given.\"),\n326\t        feeds=[], part_of_systems=[\"network\", \"adas\"],\n327\t        tsb_refs=[], inspection_hint=\"\",\n328\t        notes=\"CAN-C address CONFIRMED per \" + _MODULE_MAP + \".\",\n329\t    ),\n330\t\n331\t    \"rfhub_module\": _el(\n332\t        \"module\", \"RFHUB -- radio frequency hub (Continental)\",\n333\t        _unknown_loc(\"GIORGIO_MODULE_MAP.md confirms this module's \"\n334\t                      \"network address (and that it carries TPMS data); \"\n335\t                      \"no physical location is given.\"),\n336\t        feeds=[], part_of_systems=[\"network\", \"tpms\"],\n337\t        tsb_refs=[], inspection_hint=\"\",\n338\t        notes=\"Address CONFIRMED, identity as RFHUB is INFERRED, per \"\n339\t              + _MODULE_MAP + \".\",\n340\t    ),\n341\t\n342\t    \"window_riser_circuit\": _el(\n343\t        \"harness_section\", \"Window-riser motor circuit (B1176 family)\",\n344\t        _unknown_loc(\"No TSB in this repo's knowledge base (mes.knowledge) \"\n345\t                      \"covers B1176. Recorded only at a plain-words level: \"\n346\t                      \"door module -> window-motor circuit -> door harness \"\n347\t                      \"connector -> ground. No connector id or pin number \"\n348\t                      \"is sourced, so none is given.\"),\n349\t        feeds=[], part_of_systems=[\"body\"],\n350\t        tsb_refs=[], inspection_hint=\"wiggle test the door harness boot/\"\n351\t                         \"grommet for chafe where it flexes with the door\",\n352\t        notes=\"Door-harness flex points are a generic chafe risk on any \"\n353\t              \"platform; this is general automotive-electrical knowledge, \"\n354\t              \"not a model-specific sourced fact.\",\n355\t    ),\n356\t\n357\t    \"ignition_coil_connector\": _el(\n358\t        \"connector\", \"Ignition coil connector (per cylinder)\",\n359\t        _unknown_loc(\"No misfire-specific TSB is present in \"\n360\t                      \"mes.knowledge for this platform; plain-words only.\"),\n361\t        feeds=[], part_of_systems=[\"misfire\"],\n362\t        tsb_refs=[], inspection_hint=\"connector seating, coil boot \"\n363\t                         \"condition, swap-test between cylinders\",\n364\t        notes=\"\",\n365\t    ),\n366\t\n367\t    \"chassis_sensor_connector\": _el(\n368\t        \"connector\", \"Chassis sensor connector (C141B/C141C family)\",\n369\t        _unknown_loc(\"No TSB in mes.knowledge covers C141B/C141C; nothing \"\n370\t                      \"specific is sourced about which sensor or \"\n371\t                      \"connector these codes implicate on this car.\"),\n372\t        feeds=[], part_of_systems=[\"chassis\"],\n373\t        tsb_refs=[], inspection_hint=\"\",\n374\t        notes=\"\",\n375\t    ),\n376\t}\n377\t\n378\t\n379\tdef element(elem_id: str) -> Optional[dict[str, Any]]:\n380\t    \"\"\"One element by id, with its own id folded in, or ``None``.\"\"\"\n381\t    e = ELEMENTS.get(elem_id)\n382\t    if e is None:\n383\t        return None\n384\t    out = dict(e)\n385\t    out[\"id\"] = elem_id\n386\t    return out\n387\t\n388\t\n389\tdef elements_for_system(system_key: str) -> list[dict[str, Any]]:\n390\t    return [element(eid) for eid, e in ELEMENTS.items()\n391\t            if system_key in e.get(\"part_of_systems\", [])]\n392\t\n393\t\n394\t# ---------------------------------------------------------------------------\n395\t# CIRCUITS\n396\t# ---------------------------------------------------------------------------\n397\t\n398\tdef _hop(elem_id: str, role: str) -> dict[str, str]:\n399\t    return {\"element\": elem_id, \"role\": role}\n400\t\n401\t\n402\t_EVAP_PATH = [\n403\t    _hop(\"ecm\", \"controller\"),\n404\t    _hop(\"purge_valve_connector\", \"connector\"),\n405\t    _hop(\"esim_connector\", \"connector\"),\n406\t    _hop(\"esim_ground\", \"ground\"),\n407\t]\n408\t\n409\t_EVAP_SYSTEMS_INTERACTION = [\n410\t    {\"system\": \"fuel\",\n411\t     \"how\": \"Tank, filler neck and cap integrity are the leak-path half of \"\n412\t            \"every EVAP code; electrical diagnosis alone cannot clear a \"\n413\t            \"leak-path fault.\",\n414\t     \"confidence\": SINGLE_SOURCE, \"source\": \"knowledge.py EVAP family\"},\n415\t    {\"system\": \"evap\",\n416\t     \"how\": \"Canister/ESIM hardware condition (flooding, filter \"\n417\t            \"restriction) per 9100471/9100468.\",\n418\t     \"confidence\": CONFIRMED, \"source\": \"TSB 9100471, 9100468\"},\n419\t    {\"system\": \"network\",\n420\t     \"how\": \"ESIM supply/ground is a BCM/ECM-fed circuit; a chronic EVAP \"\n421\t            \"code does not by itself implicate the vehicle network, but a \"\n422\t            \"coincident U-code cascade would point there instead.\",\n423\t     \"confidence\": INFERRED, \"source\": \"reasoned from module feed map\"},\n424\t    {\"system\": \"ecm_calibration\",\n425\t     \"how\": \"The PCM flash family (18-030-17 REV. B) lists P0440/P0441/\"\n426\t            \"P0455/P0456 among fixed DTCs -- check calibration level \"\n427\t            \"before condemning any hardware or wiring.\",\n428\t     \"confidence\": CONFIRMED, \"source\": \"TSB 18-030-17 REV. B\"},\n429\t]\n430\t\n431\t_EVAP_INSPECT_STEPS = [\n432\t    {\"element\": \"purge_valve_connector\",\n433\t     \"what\": \"hose routing and connector seating at the ejector tees\",\n434\t     \"how\": \"visual + wiggle test\", \"source\": \"TSB 9100325 Rev 1\"},\n435\t    {\"element\": \"esim_connector\",\n436\t     \"what\": \"connector corrosion/seating; housing wet with fuel\",\n437\t     \"how\": \"visual\", \"source\": \"TSB 9100471\"},\n438\t    {\"element\": \"esim_ground\",\n439\t     \"what\": \"ground integrity\",\n440\t     \"how\": \"voltage-drop test\", \"source\": \"none -- TechAuthority\"},\n441\t]\n442\t\n443\t_NETWORK_PATH = [\n444\t    _hop(\"f82\", \"supply\"),\n445\t    _hop(\"bcm_feed_20a\", \"protection\"),\n446\t    _hop(\"bcm\", \"controller\"),\n447\t    _hop(\"xy201\", \"connector\"),\n448\t    _hop(\"g003a\", \"ground\"),\n449\t    _hop(\"g003b\", \"ground\"),\n450\t]\n451\t\n452\t_NETWORK_SYSTEMS_INTERACTION = [\n453\t    {\"system\": \"network\",\n454\t     \"how\": \"Every module gatewaying through the BCM drops off the bus \"\n455\t            \"when its supply or ground is compromised, producing a \"\n456\t            \"multi-code cascade that looks like many module faults but is \"\n457\t            \"one electrical event.\",\n458\t     \"confidence\": CONFIRMED, \"source\": \"TSB S1808000005\"},\n459\t]\n460\t\n461\t_NETWORK_INSPECT_STEPS = [\n462\t    {\"element\": \"f82\", \"what\": \"fuse condition/seating\",\n463\t     \"how\": \"visual + continuity\", \"source\": \"TSB S1808000005\"},\n464\t    {\"element\": \"bcm_feed_20a\", \"what\": \"fuse condition/seating\",\n465\t     \"how\": \"visual + continuity\", \"source\": \"TSB S1808000005\"},\n466\t    {\"element\": \"xy201\", \"what\": \"connector seating\",\n467\t     \"how\": \"visual + wiggle test\", \"source\": \"TSB S2008000032\"},\n468\t    {\"element\": \"g003a\", \"what\": \"ground cleanliness/torque\",\n469\t     \"how\": \"visual + voltage-drop test\", \"source\": \"TSB S2008000032\"},\n470\t    {\"element\": \"g003b\", \"what\": \"ground cleanliness/torque\",\n471\t     \"how\": \"visual + voltage-drop test\", \"source\": \"TSB S2008000032\"},\n472\t]\n473\t\n474\t_B1176_PATH = [_hop(\"bcm\", \"controller\"), _hop(\"window_riser_circuit\", \"component\")]\n475\t_B1176_SYSTEMS_INTERACTION = [\n476\t    {\"system\": \"body\",\n477\t     \"how\": \"Door-module/window-motor circuit at a plain-words level \"\n478\t            \"only -- no TSB sourced for this code.\",\n479\t     \"confidence\": UNKNOWN, \"source\": \"none\"},\n480\t]\n481\t_B1176_INSPECT_STEPS = [\n482\t    {\"element\": \"window_riser_circuit\",\n483\t     \"what\": \"door harness boot/grommet for chafe\",\n484\t     \"how\": \"wiggle test\", \"source\": \"none -- TechAuthority\"},\n485\t]\n486\t\n487\t_CHASSIS_PATH = [_hop(\"bcm\", \"controller\"),\n488\t                 _hop(\"chassis_sensor_connector\", \"connector\")]\n489\t_CHASSIS_SYSTEMS_INTERACTION = [\n490\t    {\"system\": \"chassis\",\n491\t     \"how\": \"No TSB sourced for C141B/C141C; electrical path is a \"\n492\t            \"generic supply/controller/connector guess at the family \"\n493\t            \"level, not a specific diagnosis.\",\n494\t     \"confidence\": UNKNOWN, \"source\": \"none\"},\n495\t]\n496\t_CHASSIS_INSPECT_STEPS = [\n497\t    {\"element\": \"chassis_sensor_connector\",\n498\t     \"what\": \"connector seating/corrosion\",\n499\t     \"how\": \"visual\", \"source\": \"none -- TechAuthority\"},\n500\t]\n501\t\n502\t_MISFIRE_PATH = [_hop(\"battery\", \"supply\"), _hop(\"ecm\", \"controller\"),\n503\t                 _hop(\"ignition_coil_connector\", \"connector\")]\n504\t_MISFIRE_SYSTEMS_INTERACTION = [\n505\t    {\"system\": \"misfire\",\n506\t     \"how\": \"Coil/injector circuit condition is the electrical half of a \"\n507\t            \"misfire; mechanical causes (compression, fuel delivery) are \"\n508\t            \"outside this module's scope.\",\n509\t     \"confidence\": UNKNOWN, \"source\": \"none\"},\n510\t]\n511\t_MISFIRE_INSPECT_STEPS = [\n512\t    {\"element\": \"ignition_coil_connector\",\n513\t     \"what\": \"connector seating, swap-test between cylinders\",\n514\t     \"how\": \"visual + swap test\", \"source\": \"none -- TechAuthority\"},\n515\t]\n516\t\n517\tEVAP_CODES = frozenset({\"P0440\", \"P0441\", \"P0455\", \"P0456\", \"P1CEA\"})\n518\t_NETWORK_EXPLICIT = frozenset({\"U0100\", \"U1765\", \"U1960\", \"U2054\", \"B1040\"})\n519\tCHASSIS_CODES = frozenset({\"C141B\", \"C141C\"})\n520\tMISFIRE_CODES = frozenset({\"P0300\", \"P0301\", \"P0302\", \"P0303\", \"P0304\"})\n521\t\n522\t\n523\tdef _is_network_code(base: str) -> bool:\n524\t    if base in _NETWORK_EXPLICIT:\n525\t        return True\n526\t    if base.startswith(\"U17\") and len(base) == 5:\n527\t        try:\n528\t            n = int(base[1:], 16)\n529\t        except ValueError:\n530\t            return False\n531\t        return 0x1700 <= n <= 0x1716\n532\t    return False\n533\t\n534\t\n535\tdef _family_for(base: str) -> Optional[str]:\n536\t    if base in EVAP_CODES:\n537\t        return \"evap\"\n538\t    if _is_network_code(base):\n539\t        return \"network\"\n540\t    if base == \"B1176\":\n541\t        return \"b1176\"\n542\t    if base in CHASSIS_CODES:\n543\t        return \"chassis\"\n544\t    if base in MISFIRE_CODES:\n545\t        return \"misfire\"\n546\t    return None\n547\t\n548\t\n549\t_FAMILY_DATA = {\n550\t    \"evap\": (_EVAP_PATH, _EVAP_SYSTEMS_INTERACTION, _EVAP_INSPECT_STEPS),\n551\t    \"network\": (_NETWORK_PATH, _NETWORK_SYSTEMS_INTERACTION,\n552\t                _NETWORK_INSPECT_STEPS),\n553\t    \"b1176\": (_B1176_PATH, _B1176_SYSTEMS_INTERACTION, _B1176_INSPECT_STEPS),\n554\t    \"chassis\": (_CHASSIS_PATH, _CHASSIS_SYSTEMS_INTERACTION,\n555\t                _CHASSIS_INSPECT_STEPS),\n556\t    \"misfire\": (_MISFIRE_PATH, _MISFIRE_SYSTEMS_INTERACTION,\n557\t                _MISFIRE_INSPECT_STEPS),\n558\t}\n559\t\n560\t#: Kept for API symmetry with mes.knowledge.base_code -- accepts a failure\n561\t#: byte suffix (\"P0456-00\") and strips it.\n562\tdef _base(code: str) -> str:\n563\t    c = code.strip().upper()\n564\t    if \"-\" in c:\n565\t        c = c.split(\"-\", 1)[0]\n566\t    return c\n567\t\n568\t\n569\tdef code_electrical_path(code: str) -> dict[str, Any]:\n570\t    \"\"\"The electrical path for one DTC, with element details inlined.\n571\t\n572\t    Returns ``{code, family, path, systems_interaction, inspect_steps}``.\n573\t    ``family`` is ``None`` and ``path``/``systems_interaction``/\n574\t    ``inspect_steps`` are empty when the code is not one this module has\n575\t    curated data for -- callers should treat that as \"no electrical path\n576\t    known\", not as an error.\n577\t    \"\"\"\n578\t    base = _base(code)\n579\t    family = _family_for(base)\n580\t    if family is None:\n581\t        return {\"code\": base, \"family\": None, \"path\": [],\n582\t                \"systems_interaction\": [], \"inspect_steps\": [],\n583\t                \"note\": \"no curated electrical path for this code -- \"\n584\t                        + TECHAUTHORITY}\n585\t    path_hops, interactions, steps = _FAMILY_DATA[family]\n586\t    path: list[dict[str, Any]] = []\n587\t    for hop in path_hops:\n588\t        el = element(hop[\"element\"])\n589\t        path.append({\"element\": hop[\"element\"], \"role\": hop[\"role\"],\n590\t                     \"details\": el,\n591\t                     \"source\": (el or {}).get(\"location\", {}).get(\"source\"),\n592\t                     \"confidence\": (el or {}).get(\"location\", {}).get(\n593\t                         \"confidence\")})\n594\t    return {\"code\": base, \"family\": family, \"path\": path,\n595\t            \"systems_interaction\": interactions,\n596\t            \"inspect_steps\": steps}\n597\t\n598\t\n599\t__all__ = [\n600\t    \"CONFIRMED\", \"SINGLE_SOURCE\", \"INFERRED\", \"UNKNOWN\", \"CONFIDENCE_LEVELS\",\n601\t    \"TECHAUTHORITY\", \"ZONES\", \"KINDS\", \"ELEMENTS\",\n602\t    \"element\", \"elements_for_system\", \"code_electrical_path\",\n603\t    \"EVAP_CODES\", \"CHASSIS_CODES\", \"MISFIRE_CODES\",\n604\t]\n605\t"}]},"uuid":"23df543e-0a4c-4282-869d-5b6d1a69dac2","timestamp":"2026-10-14T10:38:30.304Z","toolUseResult":{"type":"text","file":{"filePath":"C:\\Users\\User\\mcp-servers\\mes-log-mcp\\mes\\electrical.py","content":"\"\"\"Electrical architecture: elements, circuits and inspection records for the\n2018 Alfa Romeo Stelvio 2.0T (GU).\n\nCompanion to :mod:`mes.parts` and :mod:`mes.knowledge`: this module answers\n\"where is it, what feeds it, what should I look at\" at a plain-words level,\nfor the technician standing at the car with a multimeter, not a pinout\ndiagram. It is deliberately conservative about what it claims to know.\n\nConfidence levels (same posture as :mod:`mes.parts` -- never invented):\n\n* ``CONFIRMED``     -- a manufacturer document (TSB, module map built from\n                       this car's own scans) states it directly.\n* ``SINGLE_SOURCE`` -- one source (usually a TSB) names the element but not\n                       every detail about it (e.g. a TSB names a connector\n                       but not its panel location).\n* ``INFERRED``       -- reasoned from sourced facts, with the reasoning\n                       stated (e.g. \"the ESIM is co-located with the\n                       canister per TSB 9100469's framing\").\n* ``UNKNOWN``        -- nothing credible sourced. ``location.description``\n                       is literally the word \"UNKNOWN\" plus the\n                       TechAuthority pointer; never a guessed zone, never a\n                       guessed pin or connector number.\n\nHouse rule, non-negotiable: no connector id, pin number or panel location\nis ever invented. Where a TSB or the module map does not say it, this module\nsays ``UNKNOWN`` and points at the service manual.\n\nSources used here:\n\n* ``mes.knowledge`` (TSB_CATALOGUE transcription) -- S1808000005 (BCM power\n  feeds / fuse F82), S2008000032 (connector XY201, grounds G003A/G003B),\n  S1708000262 (spread/pushed-out terminals), S2308000004 (B+/ground\n  verification), 9100471/9100469/9100325 (EVAP canister/ESIM/purge hardware).\n* ``docs/research/EVAP_STELVIO.md`` -- canister/ESIM physical siting\n  (\"behind the driver's-side rear wheel liner\"), purge-path architecture.\n* ``docs/reference/GIORGIO_MODULE_MAP.md`` -- which modules exist on this\n  car and which bus they answer on. This file is a *network* map, not a\n  *physical* one: it confirms a module is real and reachable, but says\n  nothing about where it is bolted in the car, so module physical location\n  is UNKNOWN throughout unless some other source (a TSB) says otherwise.\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom typing import Any, Optional\n\nCONFIRMED = \"CONFIRMED\"\nSINGLE_SOURCE = \"SINGLE-SOURCE\"\nINFERRED = \"INFERRED\"\nUNKNOWN = \"UNKNOWN\"\n\nCONFIDENCE_LEVELS = (CONFIRMED, SINGLE_SOURCE, INFERRED, UNKNOWN)\n\nTECHAUTHORITY = \"use the service manual (TechAuthority) wiring diagrams\"\n\nZONES = (\n    \"engine_bay\", \"cabin_driver\", \"cabin_passenger\", \"dash\", \"trunk\",\n    \"underbody\", \"rear_left_wheel_well\", \"rear_right_wheel_well\",\n    \"front_left_wheel_well\", \"front_right_wheel_well\", \"unknown\",\n)\n\nKINDS = (\n    \"fuse_box\", \"fuse\", \"relay\", \"ground\", \"connector\", \"splice\",\n    \"harness_section\", \"module\", \"battery\", \"alternator\",\n)\n\n_MODULE_MAP = \"docs/reference/GIORGIO_MODULE_MAP.md\"\n_EVAP_DOC = \"docs/research/EVAP_STELVIO.md\"\n_KNOWLEDGE = \"mes-log-mcp/mes/knowledge.py (TSB_CATALOGUE transcription)\"\n\n\ndef _loc(zone: str, description: str, source: str,\n         confidence: str = UNKNOWN) -> dict[str, Any]:\n    if zone not in ZONES:\n        raise ValueError(f\"unknown zone {zone!r}\")\n    if confidence not in CONFIDENCE_LEVELS:\n        raise ValueError(f\"unknown confidence {confidence!r}\")\n    if confidence == UNKNOWN and TECHAUTHORITY not in description:\n        description = description.rstrip(\". \") + f\". {TECHAUTHORITY}.\"\n    return {\"zone\": zone, \"description\": description, \"source\": source,\n            \"confidence\": confidence}\n\n\ndef _unknown_loc(note: str = \"\") -> dict[str, Any]:\n    desc = \"UNKNOWN -- not sourced in this repo's TSBs or docs.\"\n    if note:\n        desc += \" \" + note\n    return _loc(\"unknown\", desc, source=\"none\", confidence=UNKNOWN)\n\n\ndef _el(kind: str, label: str, location: dict[str, Any],\n        feeds: Optional[list[str]] = None,\n        part_of_systems: Optional[list[str]] = None,\n        tsb_refs: Optional[list[str]] = None,\n        inspection_hint: str = \"\", notes: str = \"\") -> dict[str, Any]:\n    if kind not in KINDS:\n        raise ValueError(f\"unknown kind {kind!r}\")\n    return {\n        \"kind\": kind, \"label\": label, \"location\": location,\n        \"feeds\": list(feeds or []),\n        \"part_of_systems\": list(part_of_systems or []),\n        \"tsb_refs\": list(tsb_refs or []),\n        \"inspection_hint\": inspection_hint or \"not specified -- visual \"\n                           \"inspection for corrosion, chafe, water ingress\",\n        \"notes\": notes,\n    }\n\n\n# ---------------------------------------------------------------------------\n# ELEMENTS\n# ---------------------------------------------------------------------------\n\nELEMENTS: dict[str, dict[str, Any]] = {\n\n    \"battery\": _el(\n        \"battery\", \"12V battery\",\n        _unknown_loc(\"Giorgio-platform cars (Giulia/Stelvio) are commonly \"\n                     \"reported to carry the 12V battery in the cargo \"\n                     \"area, but this has not been confirmed against a \"\n                     \"TechAuthority diagram or this car's own service \"\n                     \"history, so it is not asserted here.\"),\n        feeds=[\"f82\", \"bcm_feed_20a\", \"ecm\"],\n        part_of_systems=[\"charging\", \"network\", \"cranking\"],\n        tsb_refs=[\"S2308000004\", \"S1408000384\"],\n        inspection_hint=\"terminal corrosion, loose clamp/strap, parasitic \"\n                         \"draw (BCM DID 1005 current field on this car's \"\n                         \"own module map)\",\n        notes=\"S2308000004 ('cranks, no start'): verify ALL ECM/PCM B+ \"\n              \"feeds and grounds -- the battery and its cabling are the \"\n              \"first hop on any no-start or multi-module-dark complaint.\",\n    ),\n\n    \"ecm\": _el(\n        \"module\", \"ECM/PCM -- Magneti Marelli IAW 10JA\",\n        _unknown_loc(\"GIORGIO_MODULE_MAP.md confirms this module's network \"\n                      \"address (CAN-C, TA 0x10) from this car's own scans, \"\n                      \"but is a bus map, not a physical-location document; \"\n                      \"it says nothing about where the ECM is bolted.\"),\n        feeds=[],\n        part_of_systems=[\"evap\", \"network\", \"misfire\", \"cranking\"],\n        tsb_refs=[\"18-030-17 REV. B\", \"S2308000004\"],\n        inspection_hint=\"B+ and ground feeds per S2308000004 before any \"\n                         \"sensor/actuator circuit is condemned\",\n        notes=\"Network identity (header 18DA10F1, TA 0x10) is CONFIRMED \"\n              \"per \" + _MODULE_MAP + \"; physical mounting is UNKNOWN here.\",\n    ),\n\n    \"bcm\": _el(\n        \"module\", \"BCM -- Body Computer Marelli 949 (gateway)\",\n        _unknown_loc(\"GIORGIO_MODULE_MAP.md confirms this module's network \"\n                      \"address and that it gateways CAN-C to CAN-IHS, but \"\n                      \"is a bus map, not a physical-location document.\"),\n        feeds=[],\n        part_of_systems=[\"network\", \"evap\", \"lighting\"],\n        tsb_refs=[\"S1808000005\", \"S2008000032\", \"S1708000262\"],\n        inspection_hint=\"power feeds first (F82, standalone 20A fuse), \"\n                         \"then the XY201 connector and frame grounds \"\n                         \"G003A/G003B, then terminal condition\",\n        notes=\"S1808000005: 'A BCM losing its feed drops off the bus and \"\n              \"everything gatewaying through it throws U-codes.' Network \"\n              \"identity (header 18DA40F1, TA 0x40, gateway role) is \"\n              \"CONFIRMED per \" + _MODULE_MAP + \".\",\n    ),\n\n    \"f82\": _el(\n        \"fuse\", \"Fuse F82 (A901 circuit)\",\n        _loc(\"trunk\",\n             \"Named by TSB as being in the 'rear PDC' (rear power \"\n             \"distribution center); the TSB does not specify which panel \"\n             \"or cavity within the rear PDC, so only the general area \"\n             \"(rear of car, consistent with a trunk-area fuse box on this \"\n             \"platform) is recorded -- not a specific physical spot.\",\n             source=\"TSB S1808000005\", confidence=SINGLE_SOURCE),\n        feeds=[\"bcm\"],\n        part_of_systems=[\"network\"],\n        tsb_refs=[\"S1808000005\"],\n        inspection_hint=\"check fuse condition and seating; this is the \"\n                         \"named BCM supply fuse on GU/Stelvio per the TSB\",\n        notes=\"S1808000005: 'on GU/Stelvio inspect fuse F82 in the rear \"\n              \"PDC (A901 circuit)'.\",\n    ),\n\n    \"bcm_feed_20a\": _el(\n        \"fuse\", \"Standalone 20A fuse (BCM power feed)\",\n        _unknown_loc(\"TSB names this fuse's rating and role but not its \"\n                      \"panel location.\"),\n        feeds=[\"bcm\"],\n        part_of_systems=[\"network\"],\n        tsb_refs=[\"S1808000005\"],\n        inspection_hint=\"inspect for a blown or loose fuse alongside F82\",\n        notes=\"S1808000005: 'Inspect all BCM power feeds including the \"\n              \"standalone 20A fuse.'\",\n    ),\n\n    \"xy201\": _el(\n        \"connector\", \"Inline connector XY201\",\n        _unknown_loc(\"TSB names this connector by id but gives no panel \"\n                      \"location and no pin numbers -- none are invented \"\n                      \"here.\"),\n        feeds=[],\n        part_of_systems=[\"network\"],\n        tsb_refs=[\"S2008000032\"],\n        inspection_hint=\"securing/seating -- TSB's fix was 'securing inline \"\n                         \"connector XY201', no parts replaced\",\n        notes=\"S2008000032: multi-module warning cascade resolved by \"\n              \"securing XY201 and cleaning G003A/G003B; NHTSA scope is \"\n              \"2020 Stelvio, GU circuitry shared but verify applicability \"\n              \"to this VIN/model year before treating as a known fix.\",\n    ),\n\n    \"g003a\": _el(\n        \"ground\", \"Frame ground G003A\",\n        _loc(\"underbody\",\n             \"TSB calls these 'frame grounds', which on this platform \"\n             \"family means a body/chassis ground point, not an \"\n             \"under-hood or in-cabin ground; exact body location is not \"\n             \"given by the TSB.\",\n             source=\"TSB S2008000032\", confidence=SINGLE_SOURCE),\n        feeds=[],\n        part_of_systems=[\"network\"],\n        tsb_refs=[\"S2008000032\"],\n        inspection_hint=\"clean to bare metal, check torque/tightness\",\n        notes=\"Paired with G003B; TSB fix was cleaning both, no parts.\",\n    ),\n\n    \"g003b\": _el(\n        \"ground\", \"Frame ground G003B\",\n        _loc(\"underbody\",\n             \"Same sourcing and caveats as G003A -- see that entry.\",\n             source=\"TSB S2008000032\", confidence=SINGLE_SOURCE),\n        feeds=[],\n        part_of_systems=[\"network\"],\n        tsb_refs=[\"S2008000032\"],\n        inspection_hint=\"clean to bare metal, check torque/tightness\",\n        notes=\"Paired with G003A.\",\n    ),\n\n    \"esim_connector\": _el(\n        \"connector\", \"ESIM connector / harness run\",\n        _loc(\"rear_left_wheel_well\",\n             \"The vapor canister assembly (Mopar 68528496AA) is reported \"\n             \"'behind the driver's-side rear wheel liner' (US LHD = left \"\n             \"side); TSB 9100469 establishes the ESIM (Evaporative System \"\n             \"Integrity Module detector) as a separately serviceable part \"\n             \"from the canister but does not itself restate the canister's \"\n             \"siting. INFERRED: the ESIM and its connector/harness run are \"\n             \"co-located with the canister because they are described and \"\n             \"serviced as a unit in 9100471 ('replace BOTH canister and \"\n             \"ESIM'). The exact connector id/pin-out is not sourced -- \"\n             \"none is invented.\",\n             source=_EVAP_DOC + \" + TSB 9100469/9100471\", confidence=INFERRED),\n        feeds=[],\n        part_of_systems=[\"evap\"],\n        tsb_refs=[\"9100469\", \"9100471\", \"9100325 Rev 1\"],\n        inspection_hint=\"connector seating/corrosion, and -- per 9100471 -- \"\n                         \"whether the canister/ESIM housing is wet with \"\n                         \"liquid fuel (flooding mode, not a simple \"\n                         \"electrical fault)\",\n        notes=\"9100471: fuel flooding traced to a disconnected internal \"\n              \"vapor line at the FDM port, not a water-ingress TSB (none \"\n              \"found in a full-text sweep per EVAP_STELVIO.md).\",\n    ),\n\n    \"esim_ground\": _el(\n        \"ground\", \"ESIM ground point\",\n        _unknown_loc(\"No TSB or doc in this repo identifies the ESIM's \"\n                      \"own ground point; it is placed in the same zone as \"\n                      \"the ESIM connector only because that is the nearest \"\n                      \"sourced landmark, not because the ground point \"\n                      \"itself has been confirmed there.\"),\n        feeds=[],\n        part_of_systems=[\"evap\"],\n        tsb_refs=[],\n        inspection_hint=\"voltage-drop test ESIM ground circuit before \"\n                         \"condemning the sensor itself\",\n        notes=\"\",\n    ),\n\n    \"purge_valve_connector\": _el(\n        \"connector\", \"Purge control valve connector\",\n        _loc(\"engine_bay\",\n             \"9100325 Rev 1 covers purge hose routing at the ejector \"\n             \"tees, purge solenoid and intake -- all engine-bay items, \"\n             \"which places the purge solenoid/valve in the engine bay. \"\n             \"The connector's own pin-out/id is not given by the TSB.\",\n             source=\"TSB 9100325 Rev 1\", confidence=INFERRED),\n        feeds=[],\n        part_of_systems=[\"evap\"],\n        tsb_refs=[\"9100325 Rev 1\"],\n        inspection_hint=\"hose routing at ejector tees per 9100325; \"\n                         \"actuator test (Evaporation control valve) via \"\n                         \"MES/wiTECH before condemning the valve\",\n        notes=\"Shop log evidence (EVAP_STELVIO.md): 6/6 purge actuator \"\n              \"tests COMPLETED while P0456 was active -- the valve \"\n              \"actuated correctly, so a connector/wiring fault is not \"\n              \"supported by that evidence either; this is a hardware \"\n              \"leak-path problem more often than an electrical one.\",\n    ),\n\n    \"abs_module\": _el(\n        \"module\", \"ABS/ESC module -- Continental MK C1\",\n        _unknown_loc(\"GIORGIO_MODULE_MAP.md confirms this module answers \"\n                      \"on CAN-CH via the grey A6 cable, which is network \"\n                      \"topology, not physical mounting.\"),\n        feeds=[], part_of_systems=[\"network\", \"chassis\"],\n        tsb_refs=[], inspection_hint=\"\",\n        notes=\"CAN-CH/grey-A6 address CONFIRMED per \" + _MODULE_MAP + \"; \"\n              \"physical location UNKNOWN here.\",\n    ),\n\n    \"half_module\": _el(\n        \"module\", \"HALF -- haptic lane-feedback camera (Bosch MFK2)\",\n        _unknown_loc(\"GIORGIO_MODULE_MAP.md confirms this module answers \"\n                      \"on CAN-CH via the grey A6 cable; no physical \"\n                      \"location is given.\"),\n        feeds=[], part_of_systems=[\"network\", \"adas\"],\n        tsb_refs=[], inspection_hint=\"\",\n        notes=\"CAN-CH/grey-A6 address CONFIRMED per \" + _MODULE_MAP + \".\",\n    ),\n\n    \"dasm_module\": _el(\n        \"module\", \"DASM -- driver assistance radar (Bosch)\",\n        _unknown_loc(\"GIORGIO_MODULE_MAP.md confirms this module answers \"\n                      \"on CAN-C with no cable (7/7 scans); no physical \"\n                      \"location is given.\"),\n        feeds=[], part_of_systems=[\"network\", \"adas\"],\n        tsb_refs=[], inspection_hint=\"\",\n        notes=\"CAN-C address CONFIRMED per \" + _MODULE_MAP + \".\",\n    ),\n\n    \"rfhub_module\": _el(\n        \"module\", \"RFHUB -- radio frequency hub (Continental)\",\n        _unknown_loc(\"GIORGIO_MODULE_MAP.md confirms this module's \"\n                      \"network address (and that it carries TPMS data); \"\n                      \"no physical location is given.\"),\n        feeds=[], part_of_systems=[\"network\", \"tpms\"],\n        tsb_refs=[], inspection_hint=\"\",\n        notes=\"Address CONFIRMED, identity as RFHUB is INFERRED, per \"\n              + _MODULE_MAP + \".\",\n    ),\n\n    \"window_riser_circuit\": _el(\n        \"harness_section\", \"Window-riser motor circuit (B1176 family)\",\n        _unknown_loc(\"No TSB in this repo's knowledge base (mes.knowledge) \"\n                      \"covers B1176. Recorded only at a plain-words level: \"\n                      \"door module -> window-motor circuit -> door harness \"\n                      \"connector -> ground. No connector id or pin number \"\n                      \"is sourced, so none is given.\"),\n        feeds=[], part_of_systems=[\"body\"],\n        tsb_refs=[], inspection_hint=\"wiggle test the door harness boot/\"\n                         \"grommet for chafe where it flexes with the door\",\n        notes=\"Door-harness flex points are a generic chafe risk on any \"\n              \"platform; this is general automotive-electrical knowledge, \"\n              \"not a model-specific sourced fact.\",\n    ),\n\n    \"ignition_coil_connector\": _el(\n        \"connector\", \"Ignition coil connector (per cylinder)\",\n        _unknown_loc(\"No misfire-specific TSB is present in \"\n                      \"mes.knowledge for this platform; plain-words only.\"),\n        feeds=[], part_of_systems=[\"misfire\"],\n        tsb_refs=[], inspection_hint=\"connector seating, coil boot \"\n                         \"condition, swap-test between cylinders\",\n        notes=\"\",\n    ),\n\n    \"chassis_sensor_connector\": _el(\n        \"connector\", \"Chassis sensor connector (C141B/C141C family)\",\n        _unknown_loc(\"No TSB in mes.knowledge covers C141B/C141C; nothing \"\n                      \"specific is sourced about which sensor or \"\n                      \"connector these codes implicate on this car.\"),\n        feeds=[], part_of_systems=[\"chassis\"],\n        tsb_refs=[], inspection_hint=\"\",\n        notes=\"\",\n    ),\n}\n\n\ndef element(elem_id: str) -> Optional[dict[str, Any]]:\n    \"\"\"One element by id, with its own id folded in, or ``None``.\"\"\"\n    e = ELEMENTS.get(elem_id)\n    if e is None:\n        return None\n    out = dict(e)\n    out[\"id\"] = elem_id\n    return out\n\n\ndef elements_for_system(system_key: str) -> list[dict[str, Any]]:\n    return [element(eid) for eid, e in ELEMENTS.items()\n            if system_key in e.get(\"part_of_systems\", [])]\n\n\n# ---------------------------------------------------------------------------\n# CIRCUITS\n# ---------------------------------------------------------------------------\n\ndef _hop(elem_id: str, role: str) -> dict[str, str]:\n    return {\"element\": elem_id, \"role\": role}\n\n\n_EVAP_PATH = [\n    _hop(\"ecm\", \"controller\"),\n    _hop(\"purge_valve_connector\", \"connector\"),\n    _hop(\"esim_connector\", \"connector\"),\n    _hop(\"esim_ground\", \"ground\"),\n]\n\n_EVAP_SYSTEMS_INTERACTION = [\n    {\"system\": \"fuel\",\n     \"how\": \"Tank, filler neck and cap integrity are the leak-path half of \"\n            \"every EVAP code; electrical diagnosis alone cannot clear a \"\n            \"leak-path fault.\",\n     \"confidence\": SINGLE_SOURCE, \"source\": \"knowledge.py EVAP family\"},\n    {\"system\": \"evap\",\n     \"how\": \"Canister/ESIM hardware condition (flooding, filter \"\n            \"restriction) per 9100471/9100468.\",\n     \"confidence\": CONFIRMED, \"source\": \"TSB 9100471, 9100468\"},\n    {\"system\": \"network\",\n     \"how\": \"ESIM supply/ground is a BCM/ECM-fed circuit; a chronic EVAP \"\n            \"code does not by itself implicate the vehicle network, but a \"\n            \"coincident U-code cascade would point there instead.\",\n     \"confidence\": INFERRED, \"source\": \"reasoned from module feed map\"},\n    {\"system\": \"ecm_calibration\",\n     \"how\": \"The PCM flash family (18-030-17 REV. B) lists P0440/P0441/\"\n            \"P0455/P0456 among fixed DTCs -- check calibration level \"\n            \"before condemning any hardware or wiring.\",\n     \"confidence\": CONFIRMED, \"source\": \"TSB 18-030-17 REV. B\"},\n]\n\n_EVAP_INSPECT_STEPS = [\n    {\"element\": \"purge_valve_connector\",\n     \"what\": \"hose routing and connector seating at the ejector tees\",\n     \"how\": \"visual + wiggle test\", \"source\": \"TSB 9100325 Rev 1\"},\n    {\"element\": \"esim_connector\",\n     \"what\": \"connector corrosion/seating; housing wet with fuel\",\n     \"how\": \"visual\", \"source\": \"TSB 9100471\"},\n    {\"element\": \"esim_ground\",\n     \"what\": \"ground integrity\",\n     \"how\": \"voltage-drop test\", \"source\": \"none -- TechAuthority\"},\n]\n\n_NETWORK_PATH = [\n    _hop(\"f82\", \"supply\"),\n    _hop(\"bcm_feed_20a\", \"protection\"),\n    _hop(\"bcm\", \"controller\"),\n    _hop(\"xy201\", \"connector\"),\n    _hop(\"g003a\", \"ground\"),\n    _hop(\"g003b\", \"ground\"),\n]\n\n_NETWORK_SYSTEMS_INTERACTION = [\n    {\"system\": \"network\",\n     \"how\": \"Every module gatewaying through the BCM drops off the bus \"\n            \"when its supply or ground is compromised, producing a \"\n            \"multi-code cascade that looks like many module faults but is \"\n            \"one electrical event.\",\n     \"confidence\": CONFIRMED, \"source\": \"TSB S1808000005\"},\n]\n\n_NETWORK_INSPECT_STEPS = [\n    {\"element\": \"f82\", \"what\": \"fuse condition/seating\",\n     \"how\": \"visual + continuity\", \"source\": \"TSB S1808000005\"},\n    {\"element\": \"bcm_feed_20a\", \"what\": \"fuse condition/seating\",\n     \"how\": \"visual + continuity\", \"source\": \"TSB S1808000005\"},\n    {\"element\": \"xy201\", \"what\": \"connector seating\",\n     \"how\": \"visual + wiggle test\", \"source\": \"TSB S2008000032\"},\n    {\"element\": \"g003a\", \"what\": \"ground cleanliness/torque\",\n     \"how\": \"visual + voltage-drop test\", \"source\": \"TSB S2008000032\"},\n    {\"element\": \"g003b\", \"what\": \"ground cleanliness/torque\",\n     \"how\": \"visual + voltage-drop test\", \"source\": \"TSB S2008000032\"},\n]\n\n_B1176_PATH = [_hop(\"bcm\", \"controller\"), _hop(\"window_riser_circuit\", \"component\")]\n_B1176_SYSTEMS_INTERACTION = [\n    {\"system\": \"body\",\n     \"how\": \"Door-module/window-motor circuit at a plain-words level \"\n            \"only -- no TSB sourced for this code.\",\n     \"confidence\": UNKNOWN, \"source\": \"none\"},\n]\n_B1176_INSPECT_STEPS = [\n    {\"element\": \"window_riser_circuit\",\n     \"what\": \"door harness boot/grommet for chafe\",\n     \"how\": \"wiggle test\", \"source\": \"none -- TechAuthority\"},\n]\n\n_CHASSIS_PATH = [_hop(\"bcm\", \"controller\"),\n                 _hop(\"chassis_sensor_connector\", \"connector\")]\n_CHASSIS_SYSTEMS_INTERACTION = [\n    {\"system\": \"chassis\",\n     \"how\": \"No TSB sourced for C141B/C141C; electrical path is a \"\n            \"generic supply/controller/connector guess at the family \"\n            \"level, not a specific diagnosis.\",\n     \"confidence\": UNKNOWN, \"source\": \"none\"},\n]\n_CHASSIS_INSPECT_STEPS = [\n    {\"element\": \"chassis_sensor_connector\",\n     \"what\": \"connector seating/corrosion\",\n     \"how\": \"visual\", \"source\": \"none -- TechAuthority\"},\n]\n\n_MISFIRE_PATH = [_hop(\"battery\", \"supply\"), _hop(\"ecm\", \"controller\"),\n                 _hop(\"ignition_coil_connector\", \"connector\")]\n_MISFIRE_SYSTEMS_INTERACTION = [\n    {\"system\": \"misfire\",\n     \"how\": \"Coil/injector circuit condition is the electrical half of a \"\n            \"misfire; mechanical causes (compression, fuel delivery) are \"\n            \"outside this module's scope.\",\n     \"confidence\": UNKNOWN, \"source\": \"none\"},\n]\n_MISFIRE_INSPECT_STEPS = [\n    {\"element\": \"ignition_coil_connector\",\n     \"what\": \"connector seating, swap-test between cylinders\",\n     \"how\": \"visual + swap test\", \"source\": \"none -- TechAuthority\"},\n]\n\nEVAP_CODES = frozenset({\"P0440\", \"P0441\", \"P0455\", \"P0456\", \"P1CEA\"})\n_NETWORK_EXPLICIT = frozenset({\"U0100\", \"U1765\", \"U1960\", \"U2054\", \"B1040\"})\nCHASSIS_CODES = frozenset({\"C141B\", \"C141C\"})\nMISFIRE_CODES = frozenset({\"P0300\", \"P0301\", \"P0302\", \"P0303\", \"P0304\"})\n\n\ndef _is_network_code(base: str) -> bool:\n    if base in _NETWORK_EXPLICIT:\n        return True\n    if base.startswith(\"U17\") and len(base) == 5:\n        try:\n            n = int(base[1:], 16)\n        except ValueError:\n            return False\n        return 0x1700 <= n <= 0x1716\n    return False\n\n\ndef _family_for(base: str) -> Optional[str]:\n    if base in EVAP_CODES:\n        return \"evap\"\n    if _is_network_code(base):\n        return \"network\"\n    if base == \"B1176\":\n        return \"b1176\"\n    if base in CHASSIS_CODES:\n        return \"chassis\"\n    if base in MISFIRE_CODES:\n        return \"misfire\"\n    return None\n\n\n_FAMILY_DATA = {\n    \"evap\": (_EVAP_PATH, _EVAP_SYSTEMS_INTERACTION, _EVAP_INSPECT_STEPS),\n    \"network\": (_NETWORK_PATH, _NETWORK_SYSTEMS_INTERACTION,\n                _NETWORK_INSPECT_STEPS),\n    \"b1176\": (_B1176_PATH, _B1176_SYSTEMS_INTERACTION, _B1176_INSPECT_STEPS),\n    \"chassis\": (_CHASSIS_PATH, _CHASSIS_SYSTEMS_INTERACTION,\n                _CHASSIS_INSPECT_STEPS),\n    \"misfire\": (_MISFIRE_PATH, _MISFIRE_SYSTEMS_INTERACTION,\n                _MISFIRE_INSPECT_STEPS),\n}\n\n#: Kept for API symmetry with mes.knowledge.base_code -- accepts a failure\n#: byte suffix (\"P0456-00\") and strips it.\ndef _base(code: str) -> str:\n    c = code.strip().upper()\n    if \"-\" in c:\n        c = c.split(\"-\", 1)[0]\n    return c\n\n\ndef code_electrical_path(code: str) -> dict[str, Any]:\n    \"\"\"The electrical path for one DTC, with element details inlined.\n\n    Returns ``{code, family, path, systems_interaction, inspect_steps}``.\n    ``family`` is ``None`` and ``path``/``systems_interaction``/\n    ``inspect_steps`` are empty when the code is not one this module has\n    curated data for -- callers should treat that as \"no electrical path\n    known\", not as an error.\n    \"\"\"\n    base = _base(code)\n    family = _family_for(base)\n    if family is None:\n        return {\"code\": base, \"family\": None, \"path\": [],\n                \"systems_interaction\": [], \"inspect_steps\": [],\n                \"note\": \"no curated electrical path for this code -- \"\n                        + TECHAUTHORITY}\n    path_hops, interactions, steps = _FAMILY_DATA[family]\n    path: list[dict[str, Any]] = []\n    for hop in path_hops:\n        el = element(hop[\"element\"])\n        path.append({\"element\": hop[\"element\"], \"role\": hop[\"role\"],\n                     \"details\": el,\n                     \"source\": (el or {}).get(\"location\", {}).get(\"source\"),\n                     \"confidence\": (el or {}).get(\"location\", {}).get(\n                         \"confidence\")})\n    return {\"code\": base, \"family\": family, \"path\": path,\n            \"systems_interaction\": interactions,\n            \"inspect_steps\": steps}\n\n\n__all__ = [\n    \"CONFIRMED\", \"SINGLE_SOURCE\", \"INFERRED\", \"UNKNOWN\", \"CONFIDENCE_LEVELS\",\n    \"TECHAUTHORITY\", \"ZONES\", \"KINDS\", \"ELEMENTS\",\n    \"element\", \"elements_for_system\", \"code_electrical_path\",\n    \"EVAP_CODES\", \"CHASSIS_CODES\", \"MISFIRE_CODES\",\n]\n","numLines":605,"startLine":1,"totalLines":605}},"sourceToolAssistantUUID":"f11088b5-1e30-472d-b5c3-7db65089fb96","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
