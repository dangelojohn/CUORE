p://127.0.0.1:{devtools_port}/json/version\", timeout=1); break\n    except Exception:\n        time.sleep(0.3)\n\nreq = ur.Request(f\"http://127.0.0.1:{devtools_port}/json/new?about:blank\", method=\"PUT\")\ntarget = json.loads(ur.urlopen(req, timeout=10).read().decode())\nfrom websockets.sync.client import connect\nws = connect(target[\"webSocketDebuggerUrl\"], max_size=None, open_timeout=20)\nids = itertools.count(1)\ndef send(method, params=None):\n    mid = next(ids)\n    ws.send(json.dumps({\"id\": mid, \"method\": method, \"params\": params or {}}))\n    while True:\n        raw = ws.recv(timeout=20)\n        msg = json.loads(raw)\n        if msg.get(\"id\") == mid:\n            return msg.get(\"result\", {})\n\nsend(\"Page.enable\")\nsend(\"Runtime.enable\")\nsend(\"Emulation.setEmulatedMedia\", {\"features\":[{\"name\":\"prefers-color-scheme\",\"value\":\"dark\"}]})\nsend(\"Page.navigate\", {\"url\": f\"http://127.0.0.1:{port}/v/ZASFAKPN5J7B88115/job\"})\ntime.sleep(1.5)\n\ndef ev(expr):\n    out = send(\"Runtime.evaluate\", {\"expression\": expr, \"returnByValue\": True})\n    return out.get(\"result\", {}).get(\"value\")\n\nprint(\"data-theme attr:\", ev(\"document.documentElement.getAttribute('data-theme')\"))\nprint(\"computed --bg:\", ev(\"getComputedStyle(document.documentElement).getPropertyValue('--bg').trim()\"))\nprint(\"body bg color:\", ev(\"getComputedStyle(document.body).backgroundColor\"))\nprint(\"stylesheet hrefs:\", ev(\"JSON.stringify(Array.from(document.styleSheets).map(s=>s.href))\"))\nprint(\"cuore.css text tail (Emphasis present?):\", ev(\"\"\"\n(function(){\n  for (const s of document.styleSheets) {\n    if (s.href && s.href.includes('cuore.css')) {\n      try {\n        const rules = s.cssRules;\n        return rules.length + ' rules; last rule: ' + rules[rules.length-1].cssText.slice(0,120);\n      } catch(e) { return 'err:'+e; }\n    }\n  }\n  return 'not found';\n})()\n\"\"\"))\n\nedge_proc.terminate()\nproc.terminate()\nPY\n\".v