sier-section\">\n  <h2 id=\"step-1\" class=\"section-h step-title\">1. {{ t(\"start\") }}</h2>\n  {{ step_oneliner(1) }}\n  {% if job %}\n    <div class=\"panel tight\">\n      <p>&ldquo;{{ job.complaint or t('no_complaint_recorded') }}&rdquo;</p>\n      <div class=\"small muted\">{{ t('opened_label') }} {{ job.opened_at }}{% if job.technician %} {{ t('by_label') }} {{ job.technician }}{% endif %}\n        {% if job.closed_at %} &middot; {{ t('closed_label') }} {{ job.closed_at }}{% endif %}</div>\n    </div>\n  {% else %}\n    <p class=\"muted small\">{{ t('no_visit_open') }}\n      <a href=\"/start\">{{ t('start_intake') }} &rarr;</a></p>\n  {% endif %}\n</section>\n{% else %}\n  {{ step_headline(1) }}\n{% endif %}\n\n{% if job %}\n\n{% if _current_n == 2 %}\n<section class=\"dossier-section\">\n  <h2 id=\"step-2\" class=\"section-h step-title\">2. {{ t(\"complaint_symptoms\") }}</h2>\n  {{ step_oneliner(2) }}\n  {% set note_redirect = \"/v/\" + vin + \"/job#step-2\" %}\n  {% include \"_symptom_form.html\" %}\n  {% if job_view.symptoms %}\n    <div class=\"panel tight\"><ul class=\"checklist\">\n      {% for s in job_view.symptoms %}\n        <li class=\"checklist-step\"><span class=\"step-text mono small\">{{ s.at }}</span>\n          <span class=\"step-text\">{{ (s.tags or [])|join(\", \") or t('symptom_reported') }}{% if s.text %} — {{ s.text }}{% endif %}</span></li>\n      {% endfor %}\n    </ul></div>\n  {% else %}\n    <p class=\"muted small\">{{ t('no_symptom_reports') }}</p>\n  {% endif %}\n</section>\n{% else %}\n  {{ step_headline(2) }}\n{% endif %}\n\n{% if _current_n == 3 %}\n<section class=\"dossier-section\">\n  <h2 id=\"step-3\" class=\"section-h step-title\">3. {{ t(\"verdict\") }}</h2>\n  {{ step_oneliner(3) }}\n  {% include \"_verdict_card.html\" %}\n</section>\n{% else %}\n  {{ step_headline(3) }}\n{% endif %}\n\n{% if _current_n == 4 %}\n<section class=\"dossier-section\">\n  <h2 id=\"step-4\" class=\"section-h step-title\">4. {{ t(\"scan_codes\") }}</h2>\n  {{ step_oneliner(4) }}\n  {% if view.codes %}\n    <ul class=\"checklist priority-codes-list\">\n      {% for c in view.codes %}\n        <li class=\"checklist-step\"><span class=\"step-text\">{{ priority_icon(c.status) }}","numLines":70,"startLine":95,"totalLines":505}},"sourceToolAssistantUUID":"48680f62-996e-48b8-86bf-6deefe191288","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
