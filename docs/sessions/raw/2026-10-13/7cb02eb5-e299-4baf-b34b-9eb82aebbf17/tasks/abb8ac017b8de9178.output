{"parentUuid":"88012cf3-3725-4b62-bb43-5157c0a36040","isSidechain":true,"agentId":"abb8ac017b8de9178","message":{"model":"claude-sonnet-5","id":"msg_011CfqBAQjUSamhRqe6n2Wef","type":"message","role":"assistant","content":[{"type":"thinking","thinking":"","signature":""}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":38297,"cache_read_input_tokens":81402,"cache_creation":{"ephemeral_5m_input_tokens":38297,"ephemeral_1h_input_tokens":0},"output_tokens":4,"service_tier":"standard","inference_geo":"not_available"},"input_transformations":[],"diagnostics":null,"context_management":null},"serverClassifierRequest":"b40041f6-d8a1-4aa8-85e9-ce5eae5f9470","apiBlockIndex":0,"requestId":"req_011CfqBAQP9G1FWwHx4v5ZkL","attributionAgent":"general-purpose","type":"assistant","uuid":"86d4e244-d832-440d-b748-8adc37c1cbda","timestamp":"2026-10-08T17:37:21.524Z","effort":"high","perTurnEffort":null,"userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
{"parentUuid":"86d4e244-d832-440d-b748-8adc37c1cbda","isSidechain":true,"agentId":"abb8ac017b8de9178","message":{"model":"claude-sonnet-5","id":"msg_011CfqBAQjUSamhRqe6n2Wef","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_018FjfSbLweezXCbTQUgUWBB","name":"Read","input":{"file_path":"C:\\Users\\User\\mcp-servers\\cuore\\web\\static\\cuore.css"},"caller":{"type":"direct"}}],"container":null,"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":38297,"cache_read_input_tokens":81402,"output_tokens":618,"output_tokens_details":{"thinking_tokens":542},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":0,"ephemeral_5m_input_tokens":38297},"inference_geo":"not_available","iterations":[{"input_tokens":2,"output_tokens":618,"cache_read_input_tokens":81402,"cache_creation_input_tokens":38297,"cache_creation":{"ephemeral_5m_input_tokens":38297,"ephemeral_1h_input_tokens":0},"type":"message"}],"speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_018FjfSbLweezXCbTQUgUWBB":{"file_path":"C:\\Users\\User\\mcp-servers\\cuore\\web\\static\\cuore.css"}},"serverClassifierRequest":"b40041f6-d8a1-4aa8-85e9-ce5eae5f9470","apiBlockIndex":1,"requestId":"req_011CfqBAQP9G1FWwHx4v5ZkL","attributionAgent":"general-purpose","type":"assistant","uuid":"2704d5af-97e2-47fa-b145-472e356038ae","timestamp":"2026-10-08T17:37:22.118Z","effort":"high","perTurnEffort":null,"userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
{"parentUuid":"2704d5af-97e2-47fa-b145-472e356038ae","isSidechain":true,"promptId":"14b8b90f-0c4b-47b6-b2bf-3803814525db","agentId":"abb8ac017b8de9178","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018FjfSbLweezXCbTQUgUWBB","type":"tool_result","content":"1\t/* CUORE bench UI.\n2\t *\n3\t * Dark-first: this gets read on a tablet in a garage, where a white page is a\n4\t * flashlight. A light theme follows from the same tokens for anyone who wants\n5\t * it, and both are defined at token level so no component knows which is live.\n6\t *\n7\t * No webfont, by choice. The plan called for a vendored mono; on reflection a\n8\t * system stack is better here -- it ships nothing, cannot fall back silently on\n9\t * an offline node, and the platform monospace faces are already good. The only\n10\t * thing a downloaded face would buy is brand consistency, which is not worth a\n11\t * binary in the repo and a load path that can fail in the car.\n12\t */\n13\t\n14\t:root {\n15\t  color-scheme: dark;\n16\t\n17\t  --bg:        #101315;\n18\t  --surface:   #171b1e;\n19\t  --surface-2: #1e2429;\n20\t  --raised:    #262d33;\n21\t  --rule:      #2b3338;\n22\t  --rule-soft: #222a2f;\n23\t\n24\t  --ink:       #e3e7ea;\n25\t  --ink-2:     #aeb8bf;\n26\t  --ink-3:     #79848c;\n27\t\n28\t  --accent:    #e8565c;   /* used for identity and destructive emphasis only */\n29\t  --accent-dim:#3a1e20;\n30\t\n31\t  /* Semantic severity. Deliberately not the accent: a code's state must not\n32\t   * read as \"the brand colour\", and these four have to be distinguishable\n33\t   * from each other at a glance across a workshop. */\n34\t  --sev-returned: #e8565c;   --sev-returned-bg: #33191b;\n35\t  --sev-chronic:  #d9a63c;   --sev-chronic-bg:  #2e2513;\n36\t  --sev-cleared:  #6aa6d8;   --sev-cleared-bg:  #16242e;\n37\t  --sev-once:     #7d888f;   --sev-once-bg:     #21282c;\n38\t  /* True green, not the teal this token used to carry -- it now sits at the\n39\t   * same lightness/saturation the other four severities use, but reads as\n40\t   * unambiguously \"good\" the way it does on this app's subject rather than\n41\t   * being mistaken for --sev-cleared's blue. */\n42\t  --ok:           #52b579;   --ok-bg:           #12291d;\n43\t\n44\t  --mono: ui-monospace, \"SFMono-Regular\", \"Cascadia Mono\", Menlo, Consolas,\n45\t          \"Liberation Mono\", monospace;\n46\t  --sans: system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\",\n47\t          Arial, sans-serif;\n48\t\n49\t  --pad: 14px;\n50\t  --radius: 3px;\n51\t}\n52\t\n53\t@media (prefers-color-scheme: light) {\n54\t  :root:not([data-theme=\"dark\"]) {\n55\t    color-scheme: light;\n56\t    --bg:        #eef0f2;\n57\t    --surface:   #f7f8f9;\n58\t    --surface-2: #e8ebee;\n59\t    --raised:    #dde2e6;\n60\t    --rule:      #ccd3d8;\n61\t    --rule-soft: #dee3e7;\n62\t    --ink:       #14181b;\n63\t    --ink-2:     #3d464c;\n64\t    --ink-3:     #68737a;\n65\t    --accent:    #9e1b21;\n66\t    --accent-dim:#f0dcdc;\n67\t    --sev-returned: #9e1b21;  --sev-returned-bg: #f4dedf;\n68\t    --sev-chronic:  #8a5d06;  --sev-chronic-bg:  #f5e8cd;\n69\t    --sev-cleared:  #1e5b86;  --sev-cleared-bg:  #dce9f2;\n70\t    --sev-once:     #5c666d;  --sev-once-bg:     #e2e6e9;\n71\t    --ok:           #1e6b3f;  --ok-bg:           #dcefe1;\n72\t  }\n73\t}\n74\t\n75\t:root[data-theme=\"light\"] {\n76\t  color-scheme: light;\n77\t  --bg:        #eef0f2;\n78\t  --surface:   #f7f8f9;\n79\t  --surface-2: #e8ebee;\n80\t  --raised:    #dde2e6;\n81\t  --rule:      #ccd3d8;\n82\t  --rule-soft: #dee3e7;\n83\t  --ink:       #14181b;\n84\t  --ink-2:     #3d464c;\n85\t  --ink-3:     #68737a;\n86\t  --accent:    #9e1b21;\n87\t  --accent-dim:#f0dcdc;\n88\t  --sev-returned: #9e1b21;  --sev-returned-bg: #f4dedf;\n89\t  --sev-chronic:  #8a5d06;  --sev-chronic-bg:  #f5e8cd;\n90\t  --sev-cleared:  #1e5b86;  --sev-cleared-bg:  #dce9f2;\n91\t  --sev-once:     #5c666d;  --sev-once-bg:     #e2e6e9;\n92\t  --ok:           #1e6b3f;  --ok-bg:           #dcefe1;\n93\t}\n94\t\n95\t* { box-sizing: border-box; }\n96\t\n97\tbody {\n98\t  margin: 0;\n99\t  background: var(--bg);\n100\t  color: var(--ink);\n101\t  font-family: var(--sans);\n102\t  font-size: 15px;\n103\t  line-height: 1.5;\n104\t  -webkit-text-size-adjust: 100%;\n105\t}\n106\t\n107\ta { color: var(--ink); text-decoration-color: var(--ink-3); }\n108\ta:hover { color: var(--accent); }\n109\ta:focus-visible,\n110\tbutton:focus-visible,\n111\tinput:focus-visible,\n112\tselect:focus-visible,\n113\ttextarea:focus-visible {\n114\t  outline: 2px solid var(--accent);\n115\t  outline-offset: 1px;\n116\t}\n117\t\n118\t/* ---------- chrome ---------- */\n119\t\n120\t.top {\n121\t  /* Not sticky: on a /v/ page the vehicle strip below is the one thing\n122\t   * that stays pinned (R2) -- stacking this on top of it too is exactly\n123\t   * the \"287px of chrome eating a 490px phone screen\" problem the\n124\t   * mechanic-UX review measured. It scrolls away with the rest of the\n125\t   * page; the menu button and theme toggle live here but are reachable\n126\t   * by scrolling up, same as any other site's header. */\n127\t  position: static; z-index: 20;\n128\t  display: flex; align-items: center; gap: 18px;\n129\t  padding: 8px var(--pad);\n130\t  background: var(--surface);\n131\t  border-bottom: 1px solid var(--rule);\n132\t}\n133\t.top .brand {\n134\t  display: flex; align-items: center; gap: 8px; min-height: 44px;\n135\t  font-weight: 700; letter-spacing: .06em; text-decoration: none;\n136\t  font-size: 13px; text-transform: uppercase;\n137\t}\n138\t.top .brand span { color: var(--accent); }\n139\t\n140\t/* Header tagline echo: hidden across the whole 400-900px band so it can\n141\t * never collide with the wordmark next to it (mechanic-UX review item 2)\n142\t * -- the hero band is the one place the tagline always shows, at every\n143\t * width (see .hero-tagline). Only re-appears on a wide enough desktop\n144\t * header that there's real room beside the brand mark. */\n145\t.top-tagline {\n146\t  display: none; margin-left: 2px; font-size: 11px; color: var(--ink-3);\n147\t  text-transform: uppercase; letter-spacing: .1em; white-space: nowrap;\n148\t  overflow: hidden; text-overflow: ellipsis;\n149\t}\n150\t@media (min-width: 901px) {\n151\t  .top-tagline { display: inline-block; max-width: 240px; }\n152\t}\n153\t\n154\t/* Logo placeholder: a real mark is being designed separately. This is a\n155\t * square slot in the same spot the old inline SVG badge occupied, sized to\n156\t * fit the <=56px header strip. Drop the file at\n157\t * cuore/web/static/brand/logo.svg (see that folder's README) and it shows\n158\t * automatically via the background-image; until then the dashed border +\n159\t * \"LOGO\" text make it obvious this is a stand-in, not a broken image. */\n160\t.logo-slot {\n161\t  flex: none; display: block; width: 36px; height: 36px;\n162\t  border: 1.5px dashed var(--ink-3); border-radius: var(--radius);\n163\t  background: url(/static/brand/logo.svg) center/contain no-repeat;\n164\t  position: relative;\n165\t}\n166\t.logo-slot::after {\n167\t  content: \"LOGO\"; position: absolute; inset: 0; display: flex;\n168\t  align-items: center; justify-content: center;\n169\t  font-size: 8px; letter-spacing: .04em; color: var(--ink-3);\n170\t  font-family: var(--mono); text-transform: uppercase; pointer-events: none;\n171\t}\n172\t@media (max-width: 759px) { .logo-slot { width: 32px; height: 32px; } }\n173\t.top nav { display: flex; align-items: center; gap: 14px; margin-left: auto; }\n174\t.top nav a {\n175\t  font-size: 12.5px; color: var(--ink-3); text-decoration: none;\n176\t  text-transform: uppercase; letter-spacing: .06em;\n177\t}\n178\t.top nav a:hover, .top nav a.on { color: var(--ink); }\n179\t\n180\t/* Two clusters, not six flat links: history (the corpus, read-only, always\n181\t * there) and live (the adapter, right now, needs hardware). The seam\n182\t * between cuore's two halves shown in the nav itself, not just implied by\n183\t * which page you happen to be on. */\n184\t.navgroup { display: flex; gap: 14px; }\n185\t.navgroup.live {\n186\t  padding-left: 14px; border-left: 1px solid var(--rule);\n187\t}\n188\t.navgroup.live a { color: var(--ok); }\n189\t.navgroup.live a:hover, .navgroup.live a.on { color: var(--ink); }\n190\t.navutil {\n191\t  padding-left: 14px; border-left: 1px solid var(--rule);\n192\t  color: var(--ink-3) !important; opacity: .8;\n193\t}\n194\t.top .profile {\n195\t  font-family: var(--mono); font-size: 10.5px; color: var(--ink-3);\n196\t  border: 1px solid var(--rule); border-radius: var(--radius);\n197\t  padding: 1px 6px; text-transform: uppercase; letter-spacing: .08em;\n198\t}\n199\t\n200\t/* Live link status, one line, every page. Not the /live page itself, which\n201\t   already shows this in full -- just enough here that a bus sitting\n202\t   unverified or MES holding the port is never invisible outside it. */\n203\t.livestrip {\n204\t  border-bottom: 1px solid var(--rule);\n205\t  background: var(--surface-2);\n206\t}\n207\t.livestrip a {\n208\t  display: flex; align-items: center; gap: 10px; flex-wrap: wrap;\n209\t  padding: 5px var(--pad);\n210\t  text-decoration: none; color: var(--ink-2); font-size: 12px;\n211\t}\n212\t.livestrip a:hover { color: var(--ink); }\n213\t.livestrip .mono { font-size: 11.5px; }\n214\t\n215\t/* Vehicle context. Sticky under the top bar so which car you are looking at\n216\t * never scrolls away -- the single most common way to misread a dossier. */\n217\t.vbar {\n218\t  position: sticky; top: 0; z-index: 15;\n219\t  background: var(--surface-2);\n220\t  border-bottom: 1px solid var(--rule);\n221\t  padding: 9px var(--pad);\n222\t}\n223\t.vbar .line1 { display: flex; align-items: baseline; gap: 12px; flex-wrap: wrap; }\n224\t.vbar .vname { font-weight: 650; font-size: 16px; }\n225\t.vbar .vin {\n226\t  font-family: var(--mono); font-size: 12px; color: var(--ink-3);\n227\t  letter-spacing: .02em;\n228\t}\n229\t.vbar .facts {\n230\t  display: flex; gap: 16px; flex-wrap: wrap; margin-top: 3px;\n231\t  font-family: var(--mono); font-size: 11.5px; color: var(--ink-3);\n232\t  font-variant-numeric: tabular-nums;\n233\t}\n234\t.vbar .facts b { color: var(--ink-2); font-weight: 500; }\n235\t.vtabs { display: flex; gap: 2px; margin-top: 8px; flex-wrap: wrap; }\n236\t.vtabs a {\n237\t  font-size: 12px; text-transform: uppercase; letter-spacing: .07em;\n238\t  padding: 4px 10px; text-decoration: none; color: var(--ink-3);\n239\t  border: 1px solid transparent; border-radius: var(--radius);\n240\t}\n241\t.vtabs a:hover { color: var(--ink); background: var(--raised); }\n242\t.vtabs a.on {\n243\t  color: var(--ink); background: var(--bg); border-color: var(--rule);\n244\t}\n245\t\n246\tmain { padding: var(--pad); max-width: 1240px; margin: 0 auto; }\n247\t\n248\t/* ---------- type ---------- */\n249\t\n250\th1 { font-size: 19px; margin: 0 0 4px; letter-spacing: -.01em; }\n251\th2 {\n252\t  font-size: 11.5px; text-transform: uppercase; letter-spacing: .12em;\n253\t  color: var(--ink-3); margin: 26px 0 8px; font-weight: 600;\n254\t}\n255\th2:first-child { margin-top: 0; }\n256\th3 { font-size: 14px; margin: 16px 0 6px; font-weight: 650; }\n257\tp { margin: 0 0 10px; max-width: 76ch; }\n258\t.muted { color: var(--ink-3); }\n259\t.small { font-size: 12.5px; }\n260\t.mono { font-family: var(--mono); font-variant-numeric: tabular-nums; }\n261\t.lede { color: var(--ink-2); font-size: 14px; max-width: 80ch; }\n262\t\n263\t/* ---------- panels ---------- */\n264\t\n265\t.panel {\n266\t  background: var(--surface);\n267\t  border: 1px solid var(--rule);\n268\t  border-radius: var(--radius);\n269\t  padding: var(--pad);\n270\t  margin-bottom: 12px;\n271\t}\n272\t.panel > :last-child { margin-bottom: 0; }\n273\t.panel.tight { padding: 0; }\n274\t\n275\t/* minmax(0, 1fr), not a bare auto column: a grid track's automatic minimum\n276\t * is its items' min-content, and that reaches straight through a nested\n277\t * .tw scroll wrapper (the overflow-reset only protects a box that is\n278\t * itself the grid item, not one nested inside it) -- a single unbreakable\n279\t * table cell anywhere in a .cols column was enough to stretch the whole\n280\t * column, and every sibling panel with it, off the right edge of a phone\n281\t * screen. Pinning the track minimum to 0 makes the column fill its\n282\t * container instead, so a wide table goes back to scrolling inside its\n283\t * own .tw the way it does everywhere else in this app. */\n284\t.cols { display: grid; gap: 12px; grid-template-columns: minmax(0, 1fr); }\n285\t@media (min-width: 900px) { .cols.two { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); } }\n286\t@media (min-width: 900px) { .cols.wide-left { grid-template-columns: minmax(0, 3fr) minmax(0, 2fr); } }\n287\t\n288\t/* ---------- tables ---------- */\n289\t\n290\t.tw { overflow-x: auto; }\n291\ttable { border-collapse: collapse; width: 100%; font-size: 13.5px; }\n292\tth {\n293\t  position: sticky; top: 0;\n294\t  text-align: left; font-size: 10.5px; font-weight: 600;\n295\t  text-transform: uppercase; letter-spacing: .1em; color: var(--ink-3);\n296\t  background: var(--surface-2);\n297\t  padding: 8px 10px; border-bottom: 1px solid var(--rule); white-space: nowrap;\n298\t}\n299\ttd {\n300\t  padding: 7px 10px; border-bottom: 1px solid var(--rule-soft);\n301\t  vertical-align: top; color: var(--ink-2);\n302\t}\n303\ttr:last-child td { border-bottom: none; }\n304\ttbody tr:hover td { background: var(--surface-2); }\n305\ttd.k { color: var(--ink-3); white-space: nowrap; width: 1%; }\n306\ttd.n, th.n { text-align: right; font-family: var(--mono);\n307\t             font-variant-numeric: tabular-nums; white-space: nowrap; }\n308\ttd .mono, td.mono { font-family: var(--mono); font-size: 12.5px;\n309\t                    font-variant-numeric: tabular-nums; }\n310\ttr.row-link { cursor: pointer; }\n311\ttr.row-link:focus-within td { background: var(--surface-2); }\n312\ttable a { text-decoration: none; }\n313\ttable a:hover { text-decoration: underline; }\n314\t\n315\t/* ---------- chips ----------\n316\t * Severity is encoded by label *and* colour. A chip that only differs by hue\n317\t * is unreadable to a colour-blind tech under bad light, which is most techs\n318\t * under most light. */\n319\t\n320\t.chip {\n321\t  display: inline-block; font-family: var(--mono);\n322\t  font-size: 10px; letter-spacing: .09em; text-transform: uppercase;\n323\t  padding: 1px 6px; border-radius: var(--radius); white-space: nowrap;\n324\t  border: 1px solid transparent;\n325\t}\n326\t.chip.returned { color: var(--sev-returned); background: var(--sev-returned-bg);\n327\t                 border-color: var(--sev-returned); }\n328\t.chip.chronic  { color: var(--sev-chronic);  background: var(--sev-chronic-bg);\n329\t                 border-color: var(--sev-chronic); }\n330\t.chip.cleared  { color: var(--sev-cleared);  background: var(--sev-cleared-bg); }\n331\t.chip.seen-once, .chip.recurring {\n332\t                 color: var(--sev-once); background: var(--sev-once-bg); }\n333\t.chip.ok       { color: var(--ok); background: var(--ok-bg); }\n334\t.chip.real     { color: var(--ok); background: var(--ok-bg); }\n335\t.chip.simulated{ color: var(--sev-returned); background: var(--sev-returned-bg);\n336\t                 border-color: var(--sev-returned); }\n337\t.chip.unverifiable { color: var(--sev-chronic); background: var(--sev-chronic-bg); }\n338\t.chip.plain    { color: var(--ink-3); background: var(--surface-2); }\n339\t\n340\t/* ---------- callouts ---------- */\n341\t\n342\t.note {\n343\t  border-left: 3px solid var(--ink-3);\n344\t  background: var(--surface-2);\n345\t  padding: 10px 14px; margin: 0 0 12px; border-radius: 0 var(--radius) var(--radius) 0;\n346\t  font-size: 13.5px; color: var(--ink-2);\n347\t}\n348\t.note.warn  { border-left-color: var(--sev-chronic); background: var(--sev-chronic-bg); }\n349\t.note.alert { border-left-color: var(--sev-returned); background: var(--sev-returned-bg); }\n350\t.note.good  { border-left-color: var(--ok); background: var(--ok-bg); }\n351\t.note b { color: var(--ink); }\n352\t.note .lab {\n353\t  display: block; font-family: var(--mono); font-size: 10px;\n354\t  letter-spacing: .11em; text-transform: uppercase; margin-bottom: 4px;\n355\t  color: var(--ink-3);\n356\t}\n357\t\n358\t/* Blind spots get their own treatment. They are the part that stops \"the file\n359\t * says no faults\" being read as \"there are no faults\". */\n360\t.blind { display: grid; gap: 1px; background: var(--rule-soft); }\n361\t.blind .item { background: var(--surface); padding: 11px var(--pad); }\n362\t.blind .q { font-weight: 600; color: var(--ink); margin-bottom: 3px; }\n363\t.blind .why { font-size: 13px; color: var(--ink-3); }\n364\t.blind .fix {\n365\t  font-family: var(--mono); font-size: 11.5px; color: var(--ok); margin-top: 4px;\n366\t}\n367\t\n368\t/* ---------- forms ---------- */\n369\t\n370\tlabel { display: block; font-size: 11px; text-transform: uppercase;\n371\t        letter-spacing: .09em; color: var(--ink-3); margin-bottom: 4px; }\n372\tinput[type=text], input[type=search], textarea, select {\n373\t  width: 100%; background: var(--bg); color: var(--ink);\n374\t  border: 1px solid var(--rule); border-radius: var(--radius);\n375\t  padding: 7px 9px; font-family: inherit; font-size: 14px;\n376\t}\n377\ttextarea { min-height: 68px; resize: vertical; }\n378\t.field { margin-bottom: 12px; }\n379\t.btn {\n380\t  display: inline-flex; align-items: center; justify-content: center;\n381\t  background: var(--raised); color: var(--ink);\n382\t  border: 1px solid var(--rule); border-radius: var(--radius);\n383\t  padding: 7px 14px; font-size: 13px; font-family: inherit; cursor: pointer;\n384\t  text-decoration: none;\n385\t}\n386\t.btn:hover { border-color: var(--ink-3); }\n387\t.btn.primary { background: var(--accent); border-color: var(--accent); color: #fff; }\n388\t.btn.primary:hover { filter: brightness(1.08); }\n389\t.mrow {\n390\t  display: grid; gap: 8px; grid-template-columns: 160px 1fr;\n391\t  padding: 10px 0; border-top: 1px solid var(--rule-soft);\n392\t}\n393\t.mrow:first-of-type { border-top: none; }\n394\t\n395\t/* ---------- steps ---------- */\n396\t\n397\t.step { border-top: 1px solid var(--rule-soft); padding: 12px 0; }\n398\t.step:first-child { border-top: none; }\n399\t.step .head { display: flex; gap: 10px; align-items: baseline; }\n400\t.step .id {\n401\t  font-family: var(--mono); font-size: 11px; color: var(--accent);\n402\t  min-width: 2.4em;\n403\t}\n404\t.step .title { font-weight: 650; }\n405\t.step .cost {\n406\t  margin-left: auto; font-family: var(--mono); font-size: 11px;\n407\t  color: var(--ink-3);\n408\t}\n409\t.step .body { margin-left: calc(2.4em + 10px); }\n410\t.step .src { font-size: 11.5px; color: var(--ink-3); font-family: var(--mono); }\n411\t\n412\tkbd {\n413\t  font-family: var(--mono); font-size: 11px; background: var(--raised);\n414\t  border: 1px solid var(--rule); border-bottom-width: 2px;\n415\t  border-radius: var(--radius); padding: 0 4px;\n416\t}\n417\t\n418\t.foot {\n419\t  margin-top: 32px; padding-top: 12px; border-top: 1px solid var(--rule-soft);\n420\t  font-family: var(--mono); font-size: 11px; color: var(--ink-3);\n421\t  display: flex; gap: 16px; flex-wrap: wrap;\n422\t}\n423\t\n424\t@media (prefers-reduced-motion: reduce) {\n425\t  * { animation: none !important; transition: none !important; }\n426\t}\n427\t\n428\t/* Phones: the header nav (two link groups + API) is ~660px wide on one line,\n429\t * which made every page overflow a 400px screen and the browser zoom the\n430\t * whole page out. Let it wrap under the brand instead. */\n431\t@media (max-width: 760px) {\n432\t  .top { flex-wrap: nowrap; }\n433\t}\n434\t\n435\t/* ======================================================================\n436\t   Mechanic UX rebuild (MECHANIC_UX_REVIEW.md R1-R10): compact chrome, a\n437\t   computed verdict, always-open job cards, collapsed counted sections,\n438\t   fixed-grammar tables, glove-ready targets. Everything below is additive\n439\t   to the rules above; nothing above was removed, only the header/vbar\n440\t   layout rules were adjusted in place (search \".top\" / \".vbar\" above).\n441\t   ====================================================================== */\n442\t\n443\t/* ---------- header: icon buttons + collapsing nav (R2, R10) ---------- */\n444\t\n445\t.icon-btn {\n446\t  display: inline-flex; align-items: center; justify-content: center;\n447\t  min-width: 44px; min-height: 44px; margin: 2px 0;\n448\t  background: transparent; border: 1px solid var(--rule); border-radius: var(--radius);\n449\t  color: var(--ink-2); font-size: 15px; cursor: pointer; line-height: 1;\n450\t}\n451\t.icon-btn:hover { color: var(--ink); border-color: var(--ink-3); }\n452\t#theme-toggle { margin-left: auto; }\n453\t\n454\t.navmenu { list-style: none; }\n455\t.navmenu summary.menu-btn { list-style: none; }\n456\t.navmenu summary.menu-btn::-webkit-details-marker { display: none; }\n457\t.navmenu summary.menu-btn::marker { content: \"\"; }\n458\t.navmenu nav { display: flex; align-items: center; gap: 14px; }\n459\t\n460\t@media (min-width: 760px) {\n461\t  .top { flex-wrap: nowrap; }\n462\t  #theme-toggle { margin-left: 10px; }\n463\t  .navmenu { margin-left: auto; }\n464\t  .navmenu summary.menu-btn { display: none; }\n465\t  .navmenu nav { display: flex !important; }\n466\t}\n467\t@media (max-width: 759px) {\n468\t  .top { gap: 8px; padding: 6px 10px; }\n469\t  .top .profile { display: none; }\n470\t  .navmenu { position: relative; margin-left: auto; }\n471\t  .navmenu nav { display: none; flex-direction: column; align-items: flex-start; gap: 10px; }\n472\t  .navmenu[open] nav {\n473\t    display: flex !important; position: absolute; right: 0; top: 46px;\n474\t    background: var(--surface); border: 1px solid var(--rule); border-radius: var(--radius);\n475\t    padding: 10px 14px; z-index: 30; min-width: 200px; box-shadow: 0 6px 18px rgba(0,0,0,.35);\n476\t  }\n477\t  .navmenu nav .navgroup { flex-direction: column; align-items: flex-start; gap: 8px; }\n478\t  .navmenu nav .navgroup.live, .navmenu nav .navutil { padding-left: 0; border-left: none; }\n479\t}\n480\t\n481\t/* ---------- vbar: one merged strip (R2) ---------- */\n482\t\n483\t.vbar { padding: 6px var(--pad) 7px; }\n484\t.vline {\n485\t  display: flex; align-items: center; gap: 8px; flex-wrap: nowrap;\n486\t  min-height: 26px; overflow: hidden;\n487\t}\n488\t.vline .vname {\n489\t  font-weight: 650; font-size: 14px; white-space: nowrap; overflow: hidden;\n490\t  text-overflow: ellipsis; max-width: 38%; flex: 0 1 auto;\n491\t}\n492\t.vline .vin-tail { font-size: 11.5px; color: var(--ink-3); flex: none; }\n493\t.vline .vkm { font-size: 11.5px; color: var(--ink-2); flex: none; white-space: nowrap; }\n494\t.vline .chip { flex: none; }\n495\t\n496\t/* Compact status strip (mechanic-UX review item 4): shown in .vline only\n497\t * on pages that don't also carry the full hero -- verdict chip, blocker\n498\t * count, and the \"Next: ...\" link to the Bench. All three truncate hard\n499\t * rather than wrap, same posture as .vname/.vin-tail/.vkm right above --\n500\t * a 400px strip has no room to grow taller. */\n501\t.vline .status-verdict, .vline .status-blocker { flex: none; }\n502\t.vline .status-next {\n503\t  flex: 1 1 auto; min-width: 0; display: inline-flex; align-items: center;\n504\t  font-family: var(--mono); font-size: 10px; letter-spacing: .04em;\n505\t  text-decoration: none; color: var(--ink-2); white-space: nowrap;\n506\t  overflow: hidden; text-overflow: ellipsis;\n507\t}\n508\t.vline .status-next:hover { color: var(--ink); }\n509\t@media (max-width: 400px) {\n510\t  .vline .status-blocker .status-blocker-label { display: none; }\n511\t}\n512\t.vmore { margin-left: auto; flex: none; position: relative; }\n513\t.vmore summary {\n514\t  display: inline-flex; align-items: center; justify-content: center;\n515\t  width: 40px; height: 44px; cursor: pointer; color: var(--ink-3);\n516\t  border: 1px solid var(--rule); border-radius: var(--radius); list-style: none;\n517\t}\n518\t.vmore summary::-webkit-details-marker { display: none; }\n519\t.vmore[open] summary { color: var(--ink); }\n520\t.vmore-panel {\n521\t  position: absolute; right: 0; top: 46px; z-index: 25;\n522\t  background: var(--surface); border: 1px solid var(--rule); border-radius: var(--radius);\n523\t  padding: 10px 14px; min-width: 240px; box-shadow: 0 6px 18px rgba(0,0,0,.35);\n524\t}\n525\t.vmore-panel .small { margin-bottom: 4px; }\n526\t.vtabs { margin-top: 4px; overflow-x: auto; flex-wrap: nowrap; padding-bottom: 2px; }\n527\t.vtabs a {\n528\t  flex: none; min-height: 30px; display: inline-flex; align-items: center;\n529\t  padding: 6px 10px;\n530\t}\n531\t\n532\t/* A sticky strip's own min-height target is explicitly relaxed to 40px by\n533\t * the review (the jump-row/table-row exception); .vtabs reads as the same\n534\t * kind of dense navigational row, so it gets the same allowance -- a 44px\n535\t * tab row here would blow the <=110px sticky-chrome budget on its own. */\n536\t\n537\t/* ---------- dossier: verdict card (R1) ---------- */\n538\t\n539\t.dossier { display: block; }\n540\t\n541\t.verdict-card {\n542\t  border: 1px solid var(--rule); border-left: 4px solid var(--ink-3);\n543\t  border-radius: var(--radius); background: var(--surface);\n544\t  padding: var(--pad); margin-bottom: 14px;\n545\t}\n546\t.verdict-card.v-active-faults { border-left-color: var(--sev-returned); }\n547\t.verdict-card.v-unverified-repair { border-left-color: var(--sev-chronic); }\n548\t.verdict-card.v-verified-clean { border-left-color: var(--ok); }\n549\t.verdict-card.v-no-data { border-left-color: var(--ink-3); }\n550\t\n551\t.chip-verdict {\n552\t  display: inline-flex; align-items: center; gap: 6px;\n553\t  font-family: var(--mono); font-size: 12px; letter-spacing: .08em; text-transform: uppercase;\n554\t  padding: 5px 10px; border-radius: var(--radius); font-weight: 650;\n555\t}\n556\t.chip-verdict.v-active-faults { color: var(--sev-returned); background: var(--sev-returned-bg); }\n557\t.chip-verdict.v-unverified-repair { color: var(--sev-chronic); background: var(--sev-chronic-bg); }\n558\t.chip-verdict.v-verified-clean { color: var(--ok); background: var(--ok-bg); }\n559\t.chip-verdict.v-no-data { color: var(--ink-3); background: var(--surface-2); }\n560\t\n561\t.verdict-sentence { font-size: 16px; color: var(--ink); margin: 10px 0 12px; max-width: 70ch; }\n562\t\n563\t.verdict-actions { display: flex; gap: 10px; flex-wrap: wrap; margin-bottom: 8px; }\n564\t.btn-verdict {\n565\t  display: inline-flex; align-items: center; justify-content: center;\n566\t  min-height: 48px; padding: 8px 18px; font-size: 14px; font-weight: 600;\n567\t  border: 1px solid var(--rule); border-radius: var(--radius);\n568\t  background: var(--raised); color: var(--ink); text-decoration: none; text-align: center;\n569\t  flex: 1 1 auto;\n570\t}\n571\t.btn-verdict.primary { background: var(--accent); border-color: var(--accent); color: #fff; }\n572\t.btn-verdict.is-disabled {\n573\t  opacity: .5; cursor: not-allowed; background: var(--surface-2); color: var(--ink-3);\n574\t  border-color: var(--rule); pointer-events: none;\n575\t}\n576\t@media (max-width: 480px) { .btn-verdict { flex: 1 1 100%; } }\n577\t\n578\t.why-expander { margin-top: 6px; }\n579\t.why-expander summary {\n580\t  cursor: pointer; font-size: 12.5px; color: var(--ink-3); min-height: 44px; display: inline-flex; align-items: center;\n581\t}\n582\t.why-expander ul { margin: 6px 0 4px 18px; padding: 0; font-size: 13px; color: var(--ink-2); }\n583\t.why-expander li { margin-bottom: 4px; }\n584\t\n585\t/* ---------- jump row (R3) ---------- */\n586\t\n587\t.jumprow {\n588\t  /* Not sticky -- the vbar strip above is the one sticky element on a /v/\n589\t   * page (R2's <=110px budget has no room for a third stacked bar). It\n590\t   * sits right under the verdict card instead, which keeps every section\n591\t   * two taps away without adding to the sticky chrome. */\n592\t  display: flex; gap: 6px; overflow-x: auto; padding: 6px 0 10px; margin-bottom: 4px;\n593\t  background: var(--bg);\n594\t}\n595\t.jump-chip {\n596\t  flex: none; display: inline-flex; align-items: center; min-height: 32px;\n597\t  padding: 5px 12px; font-size: 12px; text-transform: uppercase; letter-spacing: .06em;\n598\t  background: var(--raised); color: var(--ink-2); border: 1px solid var(--rule);\n599\t  border-radius: 999px; text-decoration: none; cursor: pointer; font-family: inherit;\n600\t  white-space: nowrap;\n601\t}\n602\t.jump-chip:hover { color: var(--ink); border-color: var(--ink-3); }\n603\t.jump-chip b { color: var(--accent); margin-left: 3px; }\n604\t.jump-action { border-style: dashed; }\n605\t\n606\t/* ---------- open-work job cards (R4) ---------- */\n607\t\n608\t.section-h {\n609\t  font-size: 11.5px; text-transform: uppercase; letter-spacing: .12em;\n610\t  color: var(--ink-3); margin: 18px 0 8px; font-weight: 600;\n611\t}\n612\t.job-card {\n613\t  background: var(--surface); border: 1px solid var(--rule); border-radius: var(--radius);\n614\t  padding: var(--pad); margin-bottom: 12px;\n615\t}\n616\t.job-head { display: flex; flex-wrap: wrap; align-items: baseline; gap: 10px; margin-bottom: 8px; }\n617\t.job-head h3 { margin: 0; font-size: 15px; }\n618\t.job-codes { display: flex; gap: 6px; flex-wrap: wrap; }\n619\t.chip-code, .chip-code.sm {\n620\t  display: inline-flex; align-items: center; min-height: 44px; padding: 3px 11px;\n621\t  font-family: var(--mono); font-size: 12px; background: var(--surface-2); color: var(--ink);\n622\t  border: 1px solid var(--rule); border-radius: var(--radius); text-decoration: none;\n623\t}\n624\t.chip-code:hover { border-color: var(--accent); color: var(--accent); }\n625\t\n626\t.checklist { list-style: none; margin: 0; padding: 0; }\n627\t.checklist-step {\n628\t  display: flex; align-items: flex-start; gap: 10px; padding: 9px 0;\n629\t  border-top: 1px solid var(--rule-soft);\n630\t}\n631\t.checklist-step:first-child { border-top: none; }\n632\t.checklist-step.is-done .step-text { color: var(--ink-3); text-decoration: line-through; }\n633\t.step-form { flex: none; }\n634\t.step-check {\n635\t  width: 44px; height: 44px; display: flex; align-items: center; justify-content: center;\n636\t  background: var(--surface-2); border: 1px solid var(--rule); border-radius: var(--radius);\n637\t  color: var(--ok); font-size: 18px; cursor: pointer;\n638\t}\n639\t.checklist-step.is-done .step-check { background: var(--ok-bg); border-color: var(--ok); }\n640\t.step-text { flex: 1 1 auto; padding-top: 10px; font-size: 14px; }\n641\t.step-ref { margin-left: 6px; font-size: 12px; }\n642\t.step-meta { display: block; margin-top: 2px; }\n643\t\n644\t.job-foot { display: flex; align-items: center; gap: 12px; margin-top: 10px; flex-wrap: wrap; }\n645\t.progress-pill {\n646\t  font-family: var(--mono); font-size: 12px; font-weight: 650; color: var(--ink);\n647\t  background: var(--surface-2); border: 1px solid var(--rule); border-radius: 999px;\n648\t  padding: 3px 10px;\n649\t}\n650\t.job-refs { font-size: 12px; color: var(--ink-3); }\n651\t.job-refs a { color: var(--ink-3); }\n652\t\n653\t/* ---------- collapsed counted cards (R3) ---------- */\n654\t\n655\t.card-details {\n656\t  background: var(--surface); border: 1px solid var(--rule); border-radius: var(--radius);\n657\t  margin-bottom: 10px;\n658\t}\n659\t.card-details > summary {\n660\t  display: flex; align-items: center; gap: 10px; flex-wrap: wrap;\n661\t  padding: 12px var(--pad); min-height: 44px; cursor: pointer;\n662\t  font-size: 13px; font-weight: 650; color: var(--ink); list-style: none;\n663\t}\n664\t.card-details > summary::-webkit-details-marker { display: none; }\n665\t.card-details > summary::before {\n666\t  content: \"\\25B8\"; color: var(--ink-3); transition: transform .15s ease; flex: none;\n667\t}\n668\t.card-details[open] > summary::before { transform: rotate(90deg); }\n669\t.count-badge {\n670\t  font-family: var(--mono); font-size: 11.5px; color: var(--ink-3); font-weight: 500;\n671\t  display: inline-flex; gap: 6px; align-items: center; flex-wrap: wrap;\n672\t}\n673\t.count-badge .chip.sm { font-size: 9px; padding: 1px 5px; }\n674\t.card-body { padding: 0 var(--pad) var(--pad); }\n675\t.card-details > summary { border-bottom: 1px solid transparent; }\n676\t.card-details[open] > summary { border-bottom: 1px solid var(--rule); }\n677\t.subhead { font-size: 12.5px; color: var(--ink-3); margin: 14px 0 6px; }\n678\t.subhead:first-child { margin-top: 2px; }\n679\t\n680\t/* ---------- fixed-grammar code tables (R5) ---------- */\n681\t\n682\ttable.codes-table { table-layout: fixed; }\n683\ttable.codes-table td, table.codes-table th { overflow: hidden; padding: 6px 5px; }\n684\ttable.codes-table th:first-child, table.codes-table td:first-child { padding-left: 8px; }\n685\t/* The status chip's own font/padding is a hair too wide for \"STALE\"/\n686\t * \"ACTIVE\" to clear a <=15% column at 360px without this; status stays\n687\t * fully readable, which matters more here than matching the chip size\n688\t * everywhere else in the app. */\n689\ttable.codes-table .chip { font-size: 9px; padding: 1px 4px; letter-spacing: .03em; }\n690\ttable.codes-table .desc-cell { white-space: normal; word-break: break-word; }\n691\ttable.codes-table .code-cell, table.codes-table td:not(.desc-cell) {\n692\t  white-space: nowrap; text-overflow: ellipsis;\n693\t}\n694\t/* The code-cell holds the DTC (link) and a system-grouping badge. The\n695\t * badge is deliberately neutral/grey, never colour-coded -- R10 reserves\n696\t * colour for status (red/amber/green/grey) only, and system is a\n697\t * different dimension from status. min-width:0 is required for a flex\n698\t * child's own text-overflow:ellipsis to ever take effect. */\n699\t.code-cell { display: flex; align-items: baseline; gap: 4px; min-width: 0; }\n700\t.code-cell a { overflow: hidden; text-overflow: ellipsis; min-width: 0; }\n701\t.sys-badge {\n702\t  flex: none; font-family: var(--mono); font-size: 8.5px; letter-spacing: .02em;\n703\t  color: var(--ink-3); border: 1px solid var(--rule); border-radius: 2px; padding: 0 3px;\n704\t}\n705\t\n706\t.chip.status-active { color: var(--sev-returned); background: var(--sev-returned-bg); border-color: var(--sev-returned); }\n707\t.chip.status-cleared_unverified { color: var(--sev-chronic); background: var(--sev-chronic-bg); border-color: var(--sev-chronic); }\n708\t.chip.status-stale { color: var(--ink-3); background: var(--surface-2); }\n709\t\n710\t/* ---------- already attempted (R6) ---------- */\n711\t\n712\t.attempt-row { padding: 9px 0; border-top: 1px solid var(--rule-soft); }\n713\t.attempt-row:first-child { border-top: none; }\n714\t.attempt-row.is-fail { background: var(--sev-returned-bg); margin: 0 calc(-1 * var(--pad)); padding: 9px var(--pad); border-radius: var(--radius); }\n715\t.attempt-main { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; font-size: 13px; }\n716\t.attempt-footnote { margin-top: 4px; }\n717\t.raw-rows { margin-top: 6px; }\n718\t.raw-rows summary { cursor: pointer; font-size: 12px; color: var(--ink-3); min-height: 32px; display: inline-flex; align-items: center; }\n719\t.raw-rows td { white-space: nowrap; }\n720\t\n721\t/* ---------- freeze frames (R7) ---------- */\n722\t\n723\t.ff-card { border-top: 1px solid var(--rule-soft); padding: 12px 0; }\n724\t.ff-card:first-child { border-top: none; }\n725\t.ff-key-grid {\n726\t  display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 8px;\n727\t  margin-top: 8px;\n728\t}\n729\t.ff-pid {\n730\t  background: var(--surface-2); border: 1px solid var(--rule); border-radius: var(--radius);\n731\t  padding: 8px 10px;\n732\t}\n733\t.ff-pid.is-flag { border-color: var(--sev-chronic); background: var(--sev-chronic-bg); }\n734\t.ff-name { font-size: 11px; color: var(--ink-3); text-transform: uppercase; letter-spacing: .05em; }\n735\t.ff-value { font-size: 14px; margin-top: 2px; }\n736\t.ff-flag { font-size: 12px; color: var(--sev-chronic); margin-top: 3px; font-weight: 650; }\n737\t.all-pids { margin-top: 10px; }\n738\t.all-pids summary { cursor: pointer; font-size: 12px; color: var(--ink-3); min-height: 32px; display: inline-flex; align-items: center; }\n739\t.ff-all-grid { margin-top: 6px; display: grid; grid-template-columns: 1fr; gap: 2px; }\n740\t@media (min-width: 640px) { .ff-all-grid { grid-template-columns: 1fr 1fr; } }\n741\t.ff-all-row { display: flex; justify-content: space-between; gap: 10px; padding: 3px 0; font-size: 12.5px; border-bottom: 1px solid var(--rule-soft); }\n742\t.ff-all-row .k { color: var(--ink-3); }\n743\t\n744\t/* ---------- bulletins (R9) ---------- */\n745\t\n746\t.bulletin-card { border-top: 1px solid var(--rule-soft); padding: 12px 0; }\n747\t.bulletin-card:first-child { border-top: none; }\n748\t.bulletin-card h4 { margin: 0 0 4px; font-size: 13.5px; }\n749\t.bulletin-codes { display: flex; gap: 6px; flex-wrap: wrap; margin: 6px 0; }\n750\t.chip-code.sm { min-height: 44px; font-size: 11px; padding: 2px 9px; }\n751\t\n752\t/* ---------- blind spots (R8) ---------- */\n753\t\n754\t.blindspot-row { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; }\n755\t.blindspot-row .q { flex: 1 1 260px; }\n756\t.blindspot-row .why { flex: 2 1 320px; }\n757\t.dealer-tag { min-height: 28px; display: inline-flex; align-items: center; }\n758\t.epistemic-line { margin-top: 10px; }\n759\t\n760\t/* ---------- notes quick-add FAB (R10) ---------- */\n761\t\n762\t.fab-note {\n763\t  position: fixed; right: 18px; bottom: 18px; z-index: 40;\n764\t  width: 56px; height: 56px; border-radius: 50%;\n765\t  background: var(--accent); color: #fff; border: none; font-size: 22px;\n766\t  box-shadow: 0 4px 14px rgba(0,0,0,.4); cursor: pointer;\n767\t}\n768\t.fab-note:hover { filter: brightness(1.08); }\n769\t\n770\t/* ---------- verify page ---------- */\n771\t\n772\t.verify-page { max-width: 640px; }\n773\t.readiness-panel .readiness-row { display: flex; justify-content: space-between; align-items: center; padding: 6px 0; border-top: 1px solid var(--rule-soft); }\n774\t.readiness-panel .readiness-row:first-of-type { border-top: none; }\n775\t.back-to-dossier {\n776\t  display: flex; align-items: center; justify-content: center;\n777\t  min-height: 48px; margin-top: 16px; font-weight: 650; font-size: 14px;\n778\t}\n779\t\n780\t/* ---------- ergonomics baseline (R10) ---------- */\n781\t\n782\tbody { font-size: 16px; }\n783\t.small { font-size: 13px; }\n784\ttable.codes-table td.n.mono, table.codes-table td.mono { font-size: 14px; }\n785\t/* ...except the short last-seen date and the compact km figure, which are\n786\t * labels rather than precision measurements and need the width back more\n787\t * than they need the bump (title=\"\" carries the exact value on tap). */\n788\ttable.codes-table td.lastseen-cell { font-size: 12px; }\n789\ttable.codes-table td.kmcell { font-size: 12.5px; }\n790\t.jump-chip, .vtabs a { min-height: 40px; }\n791\t.btn { min-height: 44px; }\n792\tinput[type=checkbox] + label, label.checkbox-label { min-height: 44px; display: inline-flex; align-items: center; }\n793\t\n794\t/* ---------- theme toggle persistence hook ---------- */\n795\t/* data-theme is set/read by cuore.js; the actual palettes are the\n796\t * :root[data-theme=\"light\"] / @media blocks already defined above. */\n797\t\n798\t@media (max-width: 400px) {\n799\t  .vline .vname { max-width: 32%; }\n800\t  .verdict-actions { flex-direction: column; }\n801\t}\n802\t\n803\t\n804\t/* Swipeable rows (tabs, section chips): no desktop-style scrollbar; they\n805\t * still scroll by touch, trackpad and shift+wheel. */\n806\t.vtabs, .jumprow { scrollbar-width: none; }\n807\t.vtabs::-webkit-scrollbar, .jumprow::-webkit-scrollbar { display: none; }\n808\t/* The strip's \"...\" details button must never be pushed off-screen. */\n809\t.vbar .vmore { flex: none; margin-left: auto; }\n810\t\n811\t\n812\t/* =========================================================================\n813\t * TIMELINE -- \"Codes vs. what the driver notices\" (/v/{vin}/timeline)\n814\t * Appended section; everything above this line predates the timeline page.\n815\t * ========================================================================= */\n816\t\n817\t/* Per-code-family colours for cuore/web/timeline_svg.py. Same convention as\n818\t * the --sev-* / --ok ramp above: dark-first in :root, mirrored in the light\n819\t * media query and the explicit [data-theme=\"light\"] override, so the SVG's\n820\t * var(--fam-*) references resolve correctly in both themes without the\n821\t * Python module knowing which is active. Chosen to stay visually distinct\n822\t * from --accent and from each other, and from --sev-cleared's blue (chassis\n823\t * uses a steeper, darker blue than evap's teal or network's violet). */\n824\t:root {\n825\t  --fam-mil:          #e8565c;\n826\t  --fam-evap:          #3fb0ae;\n827\t  --fam-network:       #a986ef;\n828\t  --fam-body:           #d98a3c;\n829\t  --fam-chassis:        #5b8fd9;\n830\t  --fam-engine:  #8fae4a;\n831\t}\n832\t\n833\t@media (prefers-color-scheme: light) {\n834\t  :root:not([data-theme=\"dark\"]) {\n835\t    --fam-mil:          #9e1b21;\n836\t    --fam-evap:          #1f7a78;\n837\t    --fam-network:       #6b4fb0;\n838\t    --fam-body:           #a85a10;\n839\t    --fam-chassis:        #2a5ea8;\n840\t    --fam-engine:  #5c7a1e;\n841\t  }\n842\t}\n843\t\n844\t:root[data-theme=\"light\"] {\n845\t  --fam-mil:          #9e1b21;\n846\t  --fam-evap:          #1f7a78;\n847\t  --fam-network:       #6b4fb0;\n848\t  --fam-body:           #a85a10;\n849\t  --fam-chassis:        #2a5ea8;\n850\t  --fam-engine:  #5c7a1e;\n851\t}\n852\t\n853\t/* The swimlane chart: a fixed, non-scrolling label column (so a lane's name\n854\t * is always on screen) beside a horizontally-scrolling SVG. This is what\n855\t * keeps the page itself from scrolling sideways at 400px -- only the chart's\n856\t * own box does, via its own scrollbar. */\n857\t.tl-chart { display: flex; align-items: flex-start; border: 1px solid var(--rule);\n858\t            border-radius: var(--radius); background: var(--surface); overflow: hidden; }\n859\t.tl-labels { flex: none; display: flex; flex-direction: column; min-width: 86px;\n860\t             max-width: 120px; border-right: 1px solid var(--rule); background: var(--surface-2); }\n861\t.tl-label { display: flex; align-items: center; padding: 0 8px; font-size: 11.5px;\n862\t            color: var(--ink-2); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;\n863\t            border-bottom: 1px solid var(--rule-soft); }\n864\t.tl-scroll { flex: 1 1 auto; overflow-x: auto; overflow-y: hidden; max-width: 100%; min-width: 0; }\n865\t.tl-scroll svg { display: block; }\n866\t.tl-toolbar { display: flex; flex-wrap: wrap; gap: 6px 14px; align-items: baseline;\n867\t              margin: 8px 0 10px; font-size: 12.5px; }\n868\t.tl-toolbar .grp { display: inline-flex; gap: 4px; align-items: center; }\n869\t.tl-toolbar a { padding: 3px 8px; border: 1px solid var(--rule); border-radius: var(--radius);\n870\t                color: var(--ink-2); text-decoration: none; min-height: 28px; display: inline-flex;\n871\t                align-items: center; }\n872\t.tl-toolbar a.on { color: var(--ink); border-color: var(--accent); font-weight: 650; }\n873\t\n874\t/* Correlation table: verdict chips reuse the existing severity chip classes\n875\t * (.chip.chronic amber, .chip.plain grey-neutral) rather than new colours --\n876\t * R10's rule (\"colour means status, nothing else\") already covers this. */\n877\t.tl-corr td.codes-cell { display: flex; flex-wrap: wrap; gap: 4px; }\n878\t.tl-corr .spark { vertical-align: middle; }\n879\t\n880\t/* Symptom entry form: big tap-to-toggle chips, checkbox-styled, 44px min\n881\t * target per the mechanic-UX baseline already set for .btn/.jump-chip. */\n882\t.tag-grid { display: flex; flex-wrap: wrap; gap: 8px; margin: 8px 0 14px; }\n883\t.tag-chip { position: relative; }\n884\t.tag-chip input[type=\"checkbox\"], .tag-chip input[type=\"radio\"] {\n885\t  position: absolute; opacity: 0; width: 100%; height: 100%; margin: 0; cursor: pointer;\n886\t}\n887\t.tag-chip label {\n888\t  display: inline-flex; align-items: center; justify-content: center; gap: 6px;\n889\t  min-height: 44px; padding: 6px 14px; border: 1.5px solid var(--rule); border-radius: 999px;\n890\t  background: var(--surface-2); color: var(--ink-2); font-size: 13.5px; cursor: pointer;\n891\t  user-select: none; transition: background .1s ease, border-color .1s ease, color .1s ease;\n892\t}\n893\t.tag-chip input:checked + label {\n894\t  background: var(--accent-dim); border-color: var(--accent); color: var(--ink); font-weight: 650;\n895\t}\n896\t.tag-chip.normally label { border-color: var(--ok); color: var(--ok); font-weight: 650; }\n897\t.tag-chip.normally input:checked + label { background: var(--ok-bg); border-color: var(--ok); color: var(--ok); }\n898\t.tag-hint { font-size: 12px; color: var(--ink-3); margin: -6px 0 10px; }\n899\t\n900\t/* \"What did the driver feel?\" dropdown (replaces the old tag chips above,\n901\t * which stay defined for any other template still using .tag-grid/.tag-chip).\n902\t * size=\"12\" (mechanic-UX review item 1) shows the whole fixed vocabulary at\n903\t * once with no inner scrollbar -- the option padding/line-height below is\n904\t * what gets each of those 12 rows close to a glove-friendly 44px, on every\n905\t * width, not just under the old 760px-only rule. */\n906\t.tag-select { width: 100%; font-size: 15px; }\n907\t.tag-select option { min-height: 44px; padding: 13px 8px; line-height: 1.2; }\n908\t\n909\t/* \"What would the driver feel?\" card on code.html. */\n910\t.feel-card .feel-sentence { font-size: 15px; margin: 4px 0 10px; }\n911\t.feel-card .feel-tags { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 8px; }\n912\t.feel-card .feel-tags .chip.expect { color: var(--ok); background: var(--ok-bg); }\n913\t.feel-card .feel-tags .chip.not-expect { color: var(--ink-3); background: var(--surface-2);\n914\t  text-decoration: line-through; text-decoration-color: var(--ink-3); }\n915\t\n916\t@media print {\n917\t  .tl-scroll { overflow: visible !important; }\n918\t  .tl-chart { border: none; }\n919\t}\n920\t\n921\t@media (max-width: 400px) {\n922\t  .tl-labels { min-width: 70px; max-width: 92px; }\n923\t  .tl-label { font-size: 10.5px; padding: 0 5px; }\n924\t}\n925\t\n926\t/* =========================================================================\n927\t * Others' experience card (cuore/web/templates/_experience.html).\n928\t * Appended section -- added for the experience-links feature, kept\n929\t * separate from the rest of the sheet above rather than interleaved.\n930\t * ========================================================================= */\n931\t\n932\t.experience-card h3 { display: flex; align-items: center; gap: 8px; }\n933\t.exp-row {\n934\t  display: flex; align-items: center; gap: 10px; min-height: 44px;\n935\t  padding: 6px 2px; border-bottom: 1px solid var(--rule-soft);\n936\t}\n937\t.exp-row:last-child { border-bottom: none; }\n938\t.exp-icon {\n939\t  flex: none; display: inline-flex; align-items: center; justify-content: center;\n940\t  width: 28px; height: 28px; border-radius: 999px; background: var(--surface-2);\n941\t  color: var(--ink-2); font-size: 13px;\n942\t}\n943\t.exp-main { flex: 1 1 auto; min-width: 0; }\n944\t.exp-main a { font-weight: 600; word-break: break-word; }\n945\t.exp-chips { flex: none; display: flex; flex-direction: column; align-items: flex-end; gap: 4px; }\n946\t.exp-more summary { cursor: pointer; padding: 6px 0; color: var(--ink-2); }\n947\t.exp-verified { margin: 8px 0 0; }\n948\t\n949\t@media (max-width: 400px) {\n950\t  .exp-row { flex-wrap: wrap; }\n951\t  .exp-chips { flex-direction: row; align-items: center; }\n952\t}\n953\t\n954\t/* =========================================================================\n955\t * Parts (cuore/web/templates/parts.html, _part_card.html).\n956\t * Appended section -- added for the parts-catalog feature, kept separate\n957\t * rather than interleaved with the sheet above.\n958\t * ========================================================================= */\n959\t\n960\t.part-search { display: flex; flex-wrap: wrap; gap: 8px; margin: 10px 0 6px; }\n961\t.part-search input[type=\"search\"] {\n962\t  flex: 1 1 220px; min-height: 44px; padding: 6px 10px; border: 1px solid var(--rule);\n963\t  border-radius: var(--radius); background: var(--surface); color: var(--ink);\n964\t}\n965\t\n966\t.part-card h4 { margin: 14px 0 6px; font-size: 13.5px; color: var(--ink-2); }\n967\t\n968\t/* Compact card: a tap target (anchor, not div) for inline use on code.html/\n969\t * maintenance.html/oil_change.html/brakes_tires.html -- name + first OEM\n970\t * number + thumbnail, linking through to the full card on /v/{vin}/parts. */\n971\ta.part-compact {\n972\t  display: flex; align-items: center; gap: 10px; min-height: 44px;\n973\t  padding: 8px; border: 1px solid var(--rule); border-radius: var(--radius);\n974\t  background: var(--surface); text-decoration: none; color: var(--ink);\n975\t  margin-bottom: 8px;\n976\t}\n977\ta.part-compact:hover { border-color: var(--accent); }\n978\t.part-thumb {\n979\t  flex: none; width: 40px; height: 40px; border-radius: var(--radius);\n980\t  object-fit: cover; background: var(--surface-2);\n981\t}\n982\t.part-thumb-fallback {\n983\t  display: inline-flex; align-items: center; justify-content: center;\n984\t  font-size: 9px; color: var(--ink-3); text-align: center; line-height: 1.1;\n985\t}\n986\t.part-compact-text { min-width: 0; display: flex; flex-direction: column; gap: 2px; }\n987\t.part-compact-name { font-weight: 600; word-break: break-word; }\n988\t\n989\t/* Photos grid on the full card. */\n990\t.part-image-grid {\n991\t  display: flex; flex-wrap: wrap; gap: 10px; margin: 6px 0 10px;\n992\t}\n993\t.part-image { margin: 0; width: 140px; }\n994\t.part-image img {\n995\t  display: block; width: 140px; height: 100px; object-fit: cover;\n996\t  border-radius: var(--radius); background: var(--surface-2); border: 1px solid var(--rule);\n997\t}\n998\t.part-image figcaption { margin-top: 4px; display: flex; flex-direction: column; gap: 2px; }\n999\t\n1000\t@media (max-width: 400px) {\n1001\t  .part-image { width: 48%; }\n1002\t  .part-image img { width: 100%; height: 90px; }\n1003\t}\n1004\t\n1005\t/* =========================================================================\n1006\t * Job (case) page (cuore/web/templates/job.html).\n1007\t * Appended section -- added for the Job workflow feature, kept separate\n1008\t * rather than interleaved with the sheet above.\n1009\t * ========================================================================= */\n1010\t\n1011\t.job-head-panel { margin-bottom: 10px; }\n1012\t.job-stepper { margin-bottom: 14px; }\n1013\t\n1014\t.hyp-card { margin-bottom: 12px; }\n1015\t.hyp-card.suggested-hyp { border-style: dashed; }\n1016\t.evidence-row { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; margin: 6px 0; }\n1017\t.evidence-chip { max-width: 100%; white-space: normal; text-align: left; }\n1018\t\n1019\t.hyp-status-row { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 10px; }\n1020\t.hyp-status-btn {\n1021\t  min-height: 44px; padding: 6px 14px; border: 1.5px solid var(--rule);\n1022\t  border-radius: var(--radius); background: var(--surface-2); color: var(--ink-2);\n1023\t  font-size: 13px; font-family: inherit; cursor: pointer;\n1024\t}\n1025\t.hyp-status-btn.on {\n1026\t  background: var(--accent-dim); border-color: var(--accent); color: var(--ink);\n1027\t  font-weight: 650;\n1028\t}\n1029\t\n1030\t@media (max-width: 400px) {\n1031\t  .hyp-status-btn { flex: 1 1 auto; }\n1032\t}\n1033\t\n1034\t/* =========================================================================\n1035\t * Tools for this step (cuore/web/templates/_tools_panel.html), used on\n1036\t * job.html (steps 3 & 5) and maintenance.html (per item), plus the\n1037\t * mandatory tools-used review on job.html (step 7).\n1038\t * Appended section -- added for the tools-kb feature, kept separate\n1039\t * rather than interleaved with the sheet above.\n1040\t * ========================================================================= */\n1041\t\n1042\t.tools-step-picker {\n1043\t  display: flex; align-items: center; gap: 8px; margin: 6px 0 12px; flex-wrap: wrap;\n1044\t}\n1045\t.tools-step-picker select {\n1046\t  min-height: 44px; padding: 4px 10px; border: 1px solid var(--rule);\n1047\t  border-radius: var(--radius); background: var(--surface); color: var(--ink);\n1048\t}\n1049\t\n1050\t.tools-panel h3 { display: flex; align-items: center; gap: 8px; }\n1051\t.tool-rows { display: flex; flex-direction: column; gap: 10px; }\n1052\t.tool-row {\n1053\t  padding: 8px 2px; border-bottom: 1px solid var(--rule-soft);\n1054\t}\n1055\t.tool-row:last-child { border-bottom: none; }\n1056\t.tool-row-main { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }\n1057\t.tool-kind { text-transform: uppercase; letter-spacing: .03em; }\n1058\t.tool-required { font-weight: 650; color: var(--accent); }\n1059\t.tool-spec { margin: 2px 0; }\n1060\t.tool-note { color: var(--ink-2); }\n1061\t\n1062\t.tools-review-panel .chip.chronic { margin-left: 6px; }\n1063\t\n1064\t.tool-review-row {\n1065\t  display: flex; align-items: center; gap: 10px; flex-wrap: wrap;\n1066\t  min-height: 44px; padding: 6px 0; border-bottom: 1px solid var(--rule-soft);\n1067\t}\n1068\t.tool-review-row:last-of-type { border-bottom: none; }\n1069\t.tool-review-used { display: flex; align-items: center; gap: 6px; min-width: 180px; flex: 1 1 200px; }\n1070\t.tool-review-used input[type=\"checkbox\"] { width: 20px; height: 20px; }\n1071\t.tool-review-right { display: flex; gap: 10px; flex: none; }\n1072\t.tool-review-right label { display: flex; align-items: center; gap: 4px; min-height: 44px; }\n1073\t.tool-review-right input[type=\"radio\"] { width: 18px; height: 18px; }\n1074\t.tool-review-note {\n1075\t  flex: 1 1 160px; min-height: 36px; padding: 4px 8px; border: 1px solid var(--rule);\n1076\t  border-radius: var(--radius); background: var(--surface); color: var(--ink);\n1077\t}\n1078\t\n1079\t@media (max-width: 400px) {\n1080\t  .tool-review-row { flex-direction: column; align-items: stretch; }\n1081\t  .tool-review-right { justify-content: space-between; }\n1082\t}\n1083\t"}]},"uuid":"9e3536d5-a188-4b55-b6fc-78a923450820","timestamp":"2026-10-08T17:37:24.243Z","toolUseResult":{"type":"text","file":{"filePath":"C:\\Users\\User\\mcp-servers\\cuore\\web\\static\\cuore.css","content":"/* CUORE bench UI.\n *\n * Dark-first: this gets read on a tablet in a garage, where a white page is a\n * flashlight. A light theme follows from the same tokens for anyone who wants\n * it, and both are defined at token level so no component knows which is live.\n *\n * No webfont, by choice. The plan called for a vendored mono; on reflection a\n * system stack is better here -- it ships nothing, cannot fall back silently on\n * an offline node, and the platform monospace faces are already good. The only\n * thing a downloaded face would buy is brand consistency, which is not worth a\n * binary in the repo and a load path that can fail in the car.\n */\n\n:root {\n  color-scheme: dark;\n\n  --bg:        #101315;\n  --surface:   #171b1e;\n  --surface-2: #1e2429;\n  --raised:    #262d33;\n  --rule:      #2b3338;\n  --rule-soft: #222a2f;\n\n  --ink:       #e3e7ea;\n  --ink-2:     #aeb8bf;\n  --ink-3:     #79848c;\n\n  --accent:    #e8565c;   /* used for identity and destructive emphasis only */\n  --accent-dim:#3a1e20;\n\n  /* Semantic severity. Deliberately not the accent: a code's state must not\n   * read as \"the brand colour\", and these four have to be distinguishable\n   * from each other at a glance across a workshop. */\n  --sev-returned: #e8565c;   --sev-returned-bg: #33191b;\n  --sev-chronic:  #d9a63c;   --sev-chronic-bg:  #2e2513;\n  --sev-cleared:  #6aa6d8;   --sev-cleared-bg:  #16242e;\n  --sev-once:     #7d888f;   --sev-once-bg:     #21282c;\n  /* True green, not the teal this token used to carry -- it now sits at the\n   * same lightness/saturation the other four severities use, but reads as\n   * unambiguously \"good\" the way it does on this app's subject rather than\n   * being mistaken for --sev-cleared's blue. */\n  --ok:           #52b579;   --ok-bg:           #12291d;\n\n  --mono: ui-monospace, \"SFMono-Regular\", \"Cascadia Mono\", Menlo, Consolas,\n          \"Liberation Mono\", monospace;\n  --sans: system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\",\n          Arial, sans-serif;\n\n  --pad: 14px;\n  --radius: 3px;\n}\n\n@media (prefers-color-scheme: light) {\n  :root:not([data-theme=\"dark\"]) {\n    color-scheme: light;\n    --bg:        #eef0f2;\n    --surface:   #f7f8f9;\n    --surface-2: #e8ebee;\n    --raised:    #dde2e6;\n    --rule:      #ccd3d8;\n    --rule-soft: #dee3e7;\n    --ink:       #14181b;\n    --ink-2:     #3d464c;\n    --ink-3:     #68737a;\n    --accent:    #9e1b21;\n    --accent-dim:#f0dcdc;\n    --sev-returned: #9e1b21;  --sev-returned-bg: #f4dedf;\n    --sev-chronic:  #8a5d06;  --sev-chronic-bg:  #f5e8cd;\n    --sev-cleared:  #1e5b86;  --sev-cleared-bg:  #dce9f2;\n    --sev-once:     #5c666d;  --sev-once-bg:     #e2e6e9;\n    --ok:           #1e6b3f;  --ok-bg:           #dcefe1;\n  }\n}\n\n:root[data-theme=\"light\"] {\n  color-scheme: light;\n  --bg:        #eef0f2;\n  --surface:   #f7f8f9;\n  --surface-2: #e8ebee;\n  --raised:    #dde2e6;\n  --rule:      #ccd3d8;\n  --rule-soft: #dee3e7;\n  --ink:       #14181b;\n  --ink-2:     #3d464c;\n  --ink-3:     #68737a;\n  --accent:    #9e1b21;\n  --accent-dim:#f0dcdc;\n  --sev-returned: #9e1b21;  --sev-returned-bg: #f4dedf;\n  --sev-chronic:  #8a5d06;  --sev-chronic-bg:  #f5e8cd;\n  --sev-cleared:  #1e5b86;  --sev-cleared-bg:  #dce9f2;\n  --sev-once:     #5c666d;  --sev-once-bg:     #e2e6e9;\n  --ok:           #1e6b3f;  --ok-bg:           #dcefe1;\n}\n\n* { box-sizing: border-box; }\n\nbody {\n  margin: 0;\n  background: var(--bg);\n  color: var(--ink);\n  font-family: var(--sans);\n  font-size: 15px;\n  line-height: 1.5;\n  -webkit-text-size-adjust: 100%;\n}\n\na { color: var(--ink); text-decoration-color: var(--ink-3); }\na:hover { color: var(--accent); }\na:focus-visible,\nbutton:focus-visible,\ninput:focus-visible,\nselect:focus-visible,\ntextarea:focus-visible {\n  outline: 2px solid var(--accent);\n  outline-offset: 1px;\n}\n\n/* ---------- chrome ---------- */\n\n.top {\n  /* Not sticky: on a /v/ page the vehicle strip below is the one thing\n   * that stays pinned (R2) -- stacking this on top of it too is exactly\n   * the \"287px of chrome eating a 490px phone screen\" problem the\n   * mechanic-UX review measured. It scrolls away with the rest of the\n   * page; the menu button and theme toggle live here but are reachable\n   * by scrolling up, same as any other site's header. */\n  position: static; z-index: 20;\n  display: flex; align-items: center; gap: 18px;\n  padding: 8px var(--pad);\n  background: var(--surface);\n  border-bottom: 1px solid var(--rule);\n}\n.top .brand {\n  display: flex; align-items: center; gap: 8px; min-height: 44px;\n  font-weight: 700; letter-spacing: .06em; text-decoration: none;\n  font-size: 13px; text-transform: uppercase;\n}\n.top .brand span { color: var(--accent); }\n\n/* Header tagline echo: hidden across the whole 400-900px band so it can\n * never collide with the wordmark next to it (mechanic-UX review item 2)\n * -- the hero band is the one place the tagline always shows, at every\n * width (see .hero-tagline). Only re-appears on a wide enough desktop\n * header that there's real room beside the brand mark. */\n.top-tagline {\n  display: none; margin-left: 2px; font-size: 11px; color: var(--ink-3);\n  text-transform: uppercase; letter-spacing: .1em; white-space: nowrap;\n  overflow: hidden; text-overflow: ellipsis;\n}\n@media (min-width: 901px) {\n  .top-tagline { display: inline-block; max-width: 240px; }\n}\n\n/* Logo placeholder: a real mark is being designed separately. This is a\n * square slot in the same spot the old inline SVG badge occupied, sized to\n * fit the <=56px header strip. Drop the file at\n * cuore/web/static/brand/logo.svg (see that folder's README) and it shows\n * automatically via the background-image; until then the dashed border +\n * \"LOGO\" text make it obvious this is a stand-in, not a broken image. */\n.logo-slot {\n  flex: none; display: block; width: 36px; height: 36px;\n  border: 1.5px dashed var(--ink-3); border-radius: var(--radius);\n  background: url(/static/brand/logo.svg) center/contain no-repeat;\n  position: relative;\n}\n.logo-slot::after {\n  content: \"LOGO\"; position: absolute; inset: 0; display: flex;\n  align-items: center; justify-content: center;\n  font-size: 8px; letter-spacing: .04em; color: var(--ink-3);\n  font-family: var(--mono); text-transform: uppercase; pointer-events: none;\n}\n@media (max-width: 759px) { .logo-slot { width: 32px; height: 32px; } }\n.top nav { display: flex; align-items: center; gap: 14px; margin-left: auto; }\n.top nav a {\n  font-size: 12.5px; color: var(--ink-3); text-decoration: none;\n  text-transform: uppercase; letter-spacing: .06em;\n}\n.top nav a:hover, .top nav a.on { color: var(--ink); }\n\n/* Two clusters, not six flat links: history (the corpus, read-only, always\n * there) and live (the adapter, right now, needs hardware). The seam\n * between cuore's two halves shown in the nav itself, not just implied by\n * which page you happen to be on. */\n.navgroup { display: flex; gap: 14px; }\n.navgroup.live {\n  padding-left: 14px; border-left: 1px solid var(--rule);\n}\n.navgroup.live a { color: var(--ok); }\n.navgroup.live a:hover, .navgroup.live a.on { color: var(--ink); }\n.navutil {\n  padding-left: 14px; border-left: 1px solid var(--rule);\n  color: var(--ink-3) !important; opacity: .8;\n}\n.top .profile {\n  font-family: var(--mono); font-size: 10.5px; color: var(--ink-3);\n  border: 1px solid var(--rule); border-radius: var(--radius);\n  padding: 1px 6px; text-transform: uppercase; letter-spacing: .08em;\n}\n\n/* Live link status, one line, every page. Not the /live page itself, which\n   already shows this in full -- just enough here that a bus sitting\n   unverified or MES holding the port is never invisible outside it. */\n.livestrip {\n  border-bottom: 1px solid var(--rule);\n  background: var(--surface-2);\n}\n.livestrip a {\n  display: flex; align-items: center; gap: 10px; flex-wrap: wrap;\n  padding: 5px var(--pad);\n  text-decoration: none; color: var(--ink-2); font-size: 12px;\n}\n.livestrip a:hover { color: var(--ink); }\n.livestrip .mono { font-size: 11.5px; }\n\n/* Vehicle context. Sticky under the top bar so which car you are looking at\n * never scrolls away -- the single most common way to misread a dossier. */\n.vbar {\n  position: sticky; top: 0; z-index: 15;\n  background: var(--surface-2);\n  border-bottom: 1px solid var(--rule);\n  padding: 9px var(--pad);\n}\n.vbar .line1 { display: flex; align-items: baseline; gap: 12px; flex-wrap: wrap; }\n.vbar .vname { font-weight: 650; font-size: 16px; }\n.vbar .vin {\n  font-family: var(--mono); font-size: 12px; color: var(--ink-3);\n  letter-spacing: .02em;\n}\n.vbar .facts {\n  display: flex; gap: 16px; flex-wrap: wrap; margin-top: 3px;\n  font-family: var(--mono); font-size: 11.5px; color: var(--ink-3);\n  font-variant-numeric: tabular-nums;\n}\n.vbar .facts b { color: var(--ink-2); font-weight: 500; }\n.vtabs { display: flex; gap: 2px; margin-top: 8px; flex-wrap: wrap; }\n.vtabs a {\n  font-size: 12px; text-transform: uppercase; letter-spacing: .07em;\n  padding: 4px 10px; text-decoration: none; color: var(--ink-3);\n  border: 1px solid transparent; border-radius: var(--radius);\n}\n.vtabs a:hover { color: var(--ink); background: var(--raised); }\n.vtabs a.on {\n  color: var(--ink); background: var(--bg); border-color: var(--rule);\n}\n\nmain { padding: var(--pad); max-width: 1240px; margin: 0 auto; }\n\n/* ---------- type ---------- */\n\nh1 { font-size: 19px; margin: 0 0 4px; letter-spacing: -.01em; }\nh2 {\n  font-size: 11.5px; text-transform: uppercase; letter-spacing: .12em;\n  color: var(--ink-3); margin: 26px 0 8px; font-weight: 600;\n}\nh2:first-child { margin-top: 0; }\nh3 { font-size: 14px; margin: 16px 0 6px; font-weight: 650; }\np { margin: 0 0 10px; max-width: 76ch; }\n.muted { color: var(--ink-3); }\n.small { font-size: 12.5px; }\n.mono { font-family: var(--mono); font-variant-numeric: tabular-nums; }\n.lede { color: var(--ink-2); font-size: 14px; max-width: 80ch; }\n\n/* ---------- panels ---------- */\n\n.panel {\n  background: var(--surface);\n  border: 1px solid var(--rule);\n  border-radius: var(--radius);\n  padding: var(--pad);\n  margin-bottom: 12px;\n}\n.panel > :last-child { margin-bottom: 0; }\n.panel.tight { padding: 0; }\n\n/* minmax(0, 1fr), not a bare auto column: a grid track's automatic minimum\n * is its items' min-content, and that reaches straight through a nested\n * .tw scroll wrapper (the overflow-reset only protects a box that is\n * itself the grid item, not one nested inside it) -- a single unbreakable\n * table cell anywhere in a .cols column was enough to stretch the whole\n * column, and every sibling panel with it, off the right edge of a phone\n * screen. Pinning the track minimum to 0 makes the column fill its\n * container instead, so a wide table goes back to scrolling inside its\n * own .tw the way it does everywhere else in this app. */\n.cols { display: grid; gap: 12px; grid-template-columns: minmax(0, 1fr); }\n@media (min-width: 900px) { .cols.two { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); } }\n@media (min-width: 900px) { .cols.wide-left { grid-template-columns: minmax(0, 3fr) minmax(0, 2fr); } }\n\n/* ---------- tables ---------- */\n\n.tw { overflow-x: auto; }\ntable { border-collapse: collapse; width: 100%; font-size: 13.5px; }\nth {\n  position: sticky; top: 0;\n  text-align: left; font-size: 10.5px; font-weight: 600;\n  text-transform: uppercase; letter-spacing: .1em; color: var(--ink-3);\n  background: var(--surface-2);\n  padding: 8px 10px; border-bottom: 1px solid var(--rule); white-space: nowrap;\n}\ntd {\n  padding: 7px 10px; border-bottom: 1px solid var(--rule-soft);\n  vertical-align: top; color: var(--ink-2);\n}\ntr:last-child td { border-bottom: none; }\ntbody tr:hover td { background: var(--surface-2); }\ntd.k { color: var(--ink-3); white-space: nowrap; width: 1%; }\ntd.n, th.n { text-align: right; font-family: var(--mono);\n             font-variant-numeric: tabular-nums; white-space: nowrap; }\ntd .mono, td.mono { font-family: var(--mono); font-size: 12.5px;\n                    font-variant-numeric: tabular-nums; }\ntr.row-link { cursor: pointer; }\ntr.row-link:focus-within td { background: var(--surface-2); }\ntable a { text-decoration: none; }\ntable a:hover { text-decoration: underline; }\n\n/* ---------- chips ----------\n * Severity is encoded by label *and* colour. A chip that only differs by hue\n * is unreadable to a colour-blind tech under bad light, which is most techs\n * under most light. */\n\n.chip {\n  display: inline-block; font-family: var(--mono);\n  font-size: 10px; letter-spacing: .09em; text-transform: uppercase;\n  padding: 1px 6px; border-radius: var(--radius); white-space: nowrap;\n  border: 1px solid transparent;\n}\n.chip.returned { color: var(--sev-returned); background: var(--sev-returned-bg);\n                 border-color: var(--sev-returned); }\n.chip.chronic  { color: var(--sev-chronic);  background: var(--sev-chronic-bg);\n                 border-color: var(--sev-chronic); }\n.chip.cleared  { color: var(--sev-cleared);  background: var(--sev-cleared-bg); }\n.chip.seen-once, .chip.recurring {\n                 color: var(--sev-once); background: var(--sev-once-bg); }\n.chip.ok       { color: var(--ok); background: var(--ok-bg); }\n.chip.real     { color: var(--ok); background: var(--ok-bg); }\n.chip.simulated{ color: var(--sev-returned); background: var(--sev-returned-bg);\n                 border-color: var(--sev-returned); }\n.chip.unverifiable { color: var(--sev-chronic); background: var(--sev-chronic-bg); }\n.chip.plain    { color: var(--ink-3); background: var(--surface-2); }\n\n/* ---------- callouts ---------- */\n\n.note {\n  border-left: 3px solid var(--ink-3);\n  background: var(--surface-2);\n  padding: 10px 14px; margin: 0 0 12px; border-radius: 0 var(--radius) var(--radius) 0;\n  font-size: 13.5px; color: var(--ink-2);\n}\n.note.warn  { border-left-color: var(--sev-chronic); background: var(--sev-chronic-bg); }\n.note.alert { border-left-color: var(--sev-returned); background: var(--sev-returned-bg); }\n.note.good  { border-left-color: var(--ok); background: var(--ok-bg); }\n.note b { color: var(--ink); }\n.note .lab {\n  display: block; font-family: var(--mono); font-size: 10px;\n  letter-spacing: .11em; text-transform: uppercase; margin-bottom: 4px;\n  color: var(--ink-3);\n}\n\n/* Blind spots get their own treatment. They are the part that stops \"the file\n * says no faults\" being read as \"there are no faults\". */\n.blind { display: grid; gap: 1px; background: var(--rule-soft); }\n.blind .item { background: var(--surface); padding: 11px var(--pad); }\n.blind .q { font-weight: 600; color: var(--ink); margin-bottom: 3px; }\n.blind .why { font-size: 13px; color: var(--ink-3); }\n.blind .fix {\n  font-family: var(--mono); font-size: 11.5px; color: var(--ok); margin-top: 4px;\n}\n\n/* ---------- forms ---------- */\n\nlabel { display: block; font-size: 11px; text-transform: uppercase;\n        letter-spacing: .09em; color: var(--ink-3); margin-bottom: 4px; }\ninput[type=text], input[type=search], textarea, select {\n  width: 100%; background: var(--bg); color: var(--ink);\n  border: 1px solid var(--rule); border-radius: var(--radius);\n  padding: 7px 9px; font-family: inherit; font-size: 14px;\n}\ntextarea { min-height: 68px; resize: vertical; }\n.field { margin-bottom: 12px; }\n.btn {\n  display: inline-flex; align-items: center; justify-content: center;\n  background: var(--raised); color: var(--ink);\n  border: 1px solid var(--rule); border-radius: var(--radius);\n  padding: 7px 14px; font-size: 13px; font-family: inherit; cursor: pointer;\n  text-decoration: none;\n}\n.btn:hover { border-color: var(--ink-3); }\n.btn.primary { background: var(--accent); border-color: var(--accent); color: #fff; }\n.btn.primary:hover { filter: brightness(1.08); }\n.mrow {\n  display: grid; gap: 8px; grid-template-columns: 160px 1fr;\n  padding: 10px 0; border-top: 1px solid var(--rule-soft);\n}\n.mrow:first-of-type { border-top: none; }\n\n/* ---------- steps ---------- */\n\n.step { border-top: 1px solid var(--rule-soft); padding: 12px 0; }\n.step:first-child { border-top: none; }\n.step .head { display: flex; gap: 10px; align-items: baseline; }\n.step .id {\n  font-family: var(--mono); font-size: 11px; color: var(--accent);\n  min-width: 2.4em;\n}\n.step .title { font-weight: 650; }\n.step .cost {\n  margin-left: auto; font-family: var(--mono); font-size: 11px;\n  color: var(--ink-3);\n}\n.step .body { margin-left: calc(2.4em + 10px); }\n.step .src { font-size: 11.5px; color: var(--ink-3); font-family: var(--mono); }\n\nkbd {\n  font-family: var(--mono); font-size: 11px; background: var(--raised);\n  border: 1px solid var(--rule); border-bottom-width: 2px;\n  border-radius: var(--radius); padding: 0 4px;\n}\n\n.foot {\n  margin-top: 32px; padding-top: 12px; border-top: 1px solid var(--rule-soft);\n  font-family: var(--mono); font-size: 11px; color: var(--ink-3);\n  display: flex; gap: 16px; flex-wrap: wrap;\n}\n\n@media (prefers-reduced-motion: reduce) {\n  * { animation: none !important; transition: none !important; }\n}\n\n/* Phones: the header nav (two link groups + API) is ~660px wide on one line,\n * which made every page overflow a 400px screen and the browser zoom the\n * whole page out. Let it wrap under the brand instead. */\n@media (max-width: 760px) {\n  .top { flex-wrap: nowrap; }\n}\n\n/* ======================================================================\n   Mechanic UX rebuild (MECHANIC_UX_REVIEW.md R1-R10): compact chrome, a\n   computed verdict, always-open job cards, collapsed counted sections,\n   fixed-grammar tables, glove-ready targets. Everything below is additive\n   to the rules above; nothing above was removed, only the header/vbar\n   layout rules were adjusted in place (search \".top\" / \".vbar\" above).\n   ====================================================================== */\n\n/* ---------- header: icon buttons + collapsing nav (R2, R10) ---------- */\n\n.icon-btn {\n  display: inline-flex; align-items: center; justify-content: center;\n  min-width: 44px; min-height: 44px; margin: 2px 0;\n  background: transparent; border: 1px solid var(--rule); border-radius: var(--radius);\n  color: var(--ink-2); font-size: 15px; cursor: pointer; line-height: 1;\n}\n.icon-btn:hover { color: var(--ink); border-color: var(--ink-3); }\n#theme-toggle { margin-left: auto; }\n\n.navmenu { list-style: none; }\n.navmenu summary.menu-btn { list-style: none; }\n.navmenu summary.menu-btn::-webkit-details-marker { display: none; }\n.navmenu summary.menu-btn::marker { content: \"\"; }\n.navmenu nav { display: flex; align-items: center; gap: 14px; }\n\n@media (min-width: 760px) {\n  .top { flex-wrap: nowrap; }\n  #theme-toggle { margin-left: 10px; }\n  .navmenu { margin-left: auto; }\n  .navmenu summary.menu-btn { display: none; }\n  .navmenu nav { display: flex !important; }\n}\n@media (max-width: 759px) {\n  .top { gap: 8px; padding: 6px 10px; }\n  .top .profile { display: none; }\n  .navmenu { position: relative; margin-left: auto; }\n  .navmenu nav { display: none; flex-direction: column; align-items: flex-start; gap: 10px; }\n  .navmenu[open] nav {\n    display: flex !important; position: absolute; right: 0; top: 46px;\n    background: var(--surface); border: 1px solid var(--rule); border-radius: var(--radius);\n    padding: 10px 14px; z-index: 30; min-width: 200px; box-shadow: 0 6px 18px rgba(0,0,0,.35);\n  }\n  .navmenu nav .navgroup { flex-direction: column; align-items: flex-start; gap: 8px; }\n  .navmenu nav .navgroup.live, .navmenu nav .navutil { padding-left: 0; border-left: none; }\n}\n\n/* ---------- vbar: one merged strip (R2) ---------- */\n\n.vbar { padding: 6px var(--pad) 7px; }\n.vline {\n  display: flex; align-items: center; gap: 8px; flex-wrap: nowrap;\n  min-height: 26px; overflow: hidden;\n}\n.vline .vname {\n  font-weight: 650; font-size: 14px; white-space: nowrap; overflow: hidden;\n  text-overflow: ellipsis; max-width: 38%; flex: 0 1 auto;\n}\n.vline .vin-tail { font-size: 11.5px; color: var(--ink-3); flex: none; }\n.vline .vkm { font-size: 11.5px; color: var(--ink-2); flex: none; white-space: nowrap; }\n.vline .chip { flex: none; }\n\n/* Compact status strip (mechanic-UX review item 4): shown in .vline only\n * on pages that don't also carry the full hero -- verdict chip, blocker\n * count, and the \"Next: ...\" link to the Bench. All three truncate hard\n * rather than wrap, same posture as .vname/.vin-tail/.vkm right above --\n * a 400px strip has no room to grow taller. */\n.vline .status-verdict, .vline .status-blocker { flex: none; }\n.vline .status-next {\n  flex: 1 1 auto; min-width: 0; display: inline-flex; align-items: center;\n  font-family: var(--mono); font-size: 10px; letter-spacing: .04em;\n  text-decoration: none; color: var(--ink-2); white-space: nowrap;\n  overflow: hidden; text-overflow: ellipsis;\n}\n.vline .status-next:hover { color: var(--ink); }\n@media (max-width: 400px) {\n  .vline .status-blocker .status-blocker-label { display: none; }\n}\n.vmore { margin-left: auto; flex: none; position: relative; }\n.vmore summary {\n  display: inline-flex; align-items: center; justify-content: center;\n  width: 40px; height: 44px; cursor: pointer; color: var(--ink-3);\n  border: 1px solid var(--rule); border-radius: var(--radius); list-style: none;\n}\n.vmore summary::-webkit-details-marker { display: none; }\n.vmore[open] summary { color: var(--ink); }\n.vmore-panel {\n  position: absolute; right: 0; top: 46px; z-index: 25;\n  background: var(--surface); border: 1px solid var(--rule); border-radius: var(--radius);\n  padding: 10px 14px; min-width: 240px; box-shadow: 0 6px 18px rgba(0,0,0,.35);\n}\n.vmore-panel .small { margin-bottom: 4px; }\n.vtabs { margin-top: 4px; overflow-x: auto; flex-wrap: nowrap; padding-bottom: 2px; }\n.vtabs a {\n  flex: none; min-height: 30px; display: inline-flex; align-items: center;\n  padding: 6px 10px;\n}\n\n/* A sticky strip's own min-height target is explicitly relaxed to 40px by\n * the review (the jump-row/table-row exception); .vtabs reads as the same\n * kind of dense navigational row, so it gets the same allowance -- a 44px\n * tab row here would blow the <=110px sticky-chrome budget on its own. */\n\n/* ---------- dossier: verdict card (R1) ---------- */\n\n.dossier { display: block; }\n\n.verdict-card {\n  border: 1px solid var(--rule); border-left: 4px solid var(--ink-3);\n  border-radius: var(--radius); background: var(--surface);\n  padding: var(--pad); margin-bottom: 14px;\n}\n.verdict-card.v-active-faults { border-left-color: var(--sev-returned); }\n.verdict-card.v-unverified-repair { border-left-color: var(--sev-chronic); }\n.verdict-card.v-verified-clean { border-left-color: var(--ok); }\n.verdict-card.v-no-data { border-left-color: var(--ink-3); }\n\n.chip-verdict {\n  display: inline-flex; align-items: center; gap: 6px;\n  font-family: var(--mono); font-size: 12px; letter-spacing: .08em; text-transform: uppercase;\n  padding: 5px 10px; border-radius: var(--radius); font-weight: 650;\n}\n.chip-verdict.v-active-faults { color: var(--sev-returned); background: var(--sev-returned-bg); }\n.chip-verdict.v-unverified-repair { color: var(--sev-chronic); background: var(--sev-chronic-bg); }\n.chip-verdict.v-verified-clean { color: var(--ok); background: var(--ok-bg); }\n.chip-verdict.v-no-data { color: var(--ink-3); background: var(--surface-2); }\n\n.verdict-sentence { font-size: 16px; color: var(--ink); margin: 10px 0 12px; max-width: 70ch; }\n\n.verdict-actions { display: flex; gap: 10px; flex-wrap: wrap; margin-bottom: 8px; }\n.btn-verdict {\n  display: inline-flex; align-items: center; justify-content: center;\n  min-height: 48px; padding: 8px 18px; font-size: 14px; font-weight: 600;\n  border: 1px solid var(--rule); border-radius: var(--radius);\n  background: var(--raised); color: var(--ink); text-decoration: none; text-align: center;\n  flex: 1 1 auto;\n}\n.btn-verdict.primary { background: var(--accent); border-color: var(--accent); color: #fff; }\n.btn-verdict.is-disabled {\n  opacity: .5; cursor: not-allowed; background: var(--surface-2); color: var(--ink-3);\n  border-color: var(--rule); pointer-events: none;\n}\n@media (max-width: 480px) { .btn-verdict { flex: 1 1 100%; } }\n\n.why-expander { margin-top: 6px; }\n.why-expander summary {\n  cursor: pointer; font-size: 12.5px; color: var(--ink-3); min-height: 44px; display: inline-flex; align-items: center;\n}\n.why-expander ul { margin: 6px 0 4px 18px; padding: 0; font-size: 13px; color: var(--ink-2); }\n.why-expander li { margin-bottom: 4px; }\n\n/* ---------- jump row (R3) ---------- */\n\n.jumprow {\n  /* Not sticky -- the vbar strip above is the one sticky element on a /v/\n   * page (R2's <=110px budget has no room for a third stacked bar). It\n   * sits right under the verdict card instead, which keeps every section\n   * two taps away without adding to the sticky chrome. */\n  display: flex; gap: 6px; overflow-x: auto; padding: 6px 0 10px; margin-bottom: 4px;\n  background: var(--bg);\n}\n.jump-chip {\n  flex: none; display: inline-flex; align-items: center; min-height: 32px;\n  padding: 5px 12px; font-size: 12px; text-transform: uppercase; letter-spacing: .06em;\n  background: var(--raised); color: var(--ink-2); border: 1px solid var(--rule);\n  border-radius: 999px; text-decoration: none; cursor: pointer; font-family: inherit;\n  white-space: nowrap;\n}\n.jump-chip:hover { color: var(--ink); border-color: var(--ink-3); }\n.jump-chip b { color: var(--accent); margin-left: 3px; }\n.jump-action { border-style: dashed; }\n\n/* ---------- open-work job cards (R4) ---------- */\n\n.section-h {\n  font-size: 11.5px; text-transform: uppercase; letter-spacing: .12em;\n  color: var(--ink-3); margin: 18px 0 8px; font-weight: 600;\n}\n.job-card {\n  background: var(--surface); border: 1px solid var(--rule); border-radius: var(--radius);\n  padding: var(--pad); margin-bottom: 12px;\n}\n.job-head { display: flex; flex-wrap: wrap; align-items: baseline; gap: 10px; margin-bottom: 8px; }\n.job-head h3 { margin: 0; font-size: 15px; }\n.job-codes { display: flex; gap: 6px; flex-wrap: wrap; }\n.chip-code, .chip-code.sm {\n  display: inline-flex; align-items: center; min-height: 44px; padding: 3px 11px;\n  font-family: var(--mono); font-size: 12px; background: var(--surface-2); color: var(--ink);\n  border: 1px solid var(--rule); border-radius: var(--radius); text-decoration: none;\n}\n.chip-code:hover { border-color: var(--accent); color: var(--accent); }\n\n.checklist { list-style: none; margin: 0; padding: 0; }\n.checklist-step {\n  display: flex; align-items: flex-start; gap: 10px; padding: 9px 0;\n  border-top: 1px solid var(--rule-soft);\n}\n.checklist-step:first-child { border-top: none; }\n.checklist-step.is-done .step-text { color: var(--ink-3); text-decoration: line-through; }\n.step-form { flex: none; }\n.step-check {\n  width: 44px; height: 44px; display: flex; align-items: center; justify-content: center;\n  background: var(--surface-2); border: 1px solid var(--rule); border-radius: var(--radius);\n  color: var(--ok); font-size: 18px; cursor: pointer;\n}\n.checklist-step.is-done .step-check { background: var(--ok-bg); border-color: var(--ok); }\n.step-text { flex: 1 1 auto; padding-top: 10px; font-size: 14px; }\n.step-ref { margin-left: 6px; font-size: 12px; }\n.step-meta { display: block; margin-top: 2px; }\n\n.job-foot { display: flex; align-items: center; gap: 12px; margin-top: 10px; flex-wrap: wrap; }\n.progress-pill {\n  font-family: var(--mono); font-size: 12px; font-weight: 650; color: var(--ink);\n  background: var(--surface-2); border: 1px solid var(--rule); border-radius: 999px;\n  padding: 3px 10px;\n}\n.job-refs { font-size: 12px; color: var(--ink-3); }\n.job-refs a { color: var(--ink-3); }\n\n/* ---------- collapsed counted cards (R3) ---------- */\n\n.card-details {\n  background: var(--surface); border: 1px solid var(--rule); border-radius: var(--radius);\n  margin-bottom: 10px;\n}\n.card-details > summary {\n  display: flex; align-items: center; gap: 10px; flex-wrap: wrap;\n  padding: 12px var(--pad); min-height: 44px; cursor: pointer;\n  font-size: 13px; font-weight: 650; color: var(--ink); list-style: none;\n}\n.card-details > summary::-webkit-details-marker { display: none; }\n.card-details > summary::before {\n  content: \"\\25B8\"; color: var(--ink-3); transition: transform .15s ease; flex: none;\n}\n.card-details[open] > summary::before { transform: rotate(90deg); }\n.count-badge {\n  font-family: var(--mono); font-size: 11.5px; color: var(--ink-3); font-weight: 500;\n  display: inline-flex; gap: 6px; align-items: center; flex-wrap: wrap;\n}\n.count-badge .chip.sm { font-size: 9px; padding: 1px 5px; }\n.card-body { padding: 0 var(--pad) var(--pad); }\n.card-details > summary { border-bottom: 1px solid transparent; }\n.card-details[open] > summary { border-bottom: 1px solid var(--rule); }\n.subhead { font-size: 12.5px; color: var(--ink-3); margin: 14px 0 6px; }\n.subhead:first-child { margin-top: 2px; }\n\n/* ---------- fixed-grammar code tables (R5) ---------- */\n\ntable.codes-table { table-layout: fixed; }\ntable.codes-table td, table.codes-table th { overflow: hidden; padding: 6px 5px; }\ntable.codes-table th:first-child, table.codes-table td:first-child { padding-left: 8px; }\n/* The status chip's own font/padding is a hair too wide for \"STALE\"/\n * \"ACTIVE\" to clear a <=15% column at 360px without this; status stays\n * fully readable, which matters more here than matching the chip size\n * everywhere else in the app. */\ntable.codes-table .chip { font-size: 9px; padding: 1px 4px; letter-spacing: .03em; }\ntable.codes-table .desc-cell { white-space: normal; word-break: break-word; }\ntable.codes-table .code-cell, table.codes-table td:not(.desc-cell) {\n  white-space: nowrap; text-overflow: ellipsis;\n}\n/* The code-cell holds the DTC (link) and a system-grouping badge. The\n * badge is deliberately neutral/grey, never colour-coded -- R10 reserves\n * colour for status (red/amber/green/grey) only, and system is a\n * different dimension from status. min-width:0 is required for a flex\n * child's own text-overflow:ellipsis to ever take effect. */\n.code-cell { display: flex; align-items: baseline; gap: 4px; min-width: 0; }\n.code-cell a { overflow: hidden; text-overflow: ellipsis; min-width: 0; }\n.sys-badge {\n  flex: none; font-family: var(--mono); font-size: 8.5px; letter-spacing: .02em;\n  color: var(--ink-3); border: 1px solid var(--rule); border-radius: 2px; padding: 0 3px;\n}\n\n.chip.status-active { color: var(--sev-returned); background: var(--sev-returned-bg); border-color: var(--sev-returned); }\n.chip.status-cleared_unverified { color: var(--sev-chronic); background: var(--sev-chronic-bg); border-color: var(--sev-chronic); }\n.chip.status-stale { color: var(--ink-3); background: var(--surface-2); }\n\n/* ---------- already attempted (R6) ---------- */\n\n.attempt-row { padding: 9px 0; border-top: 1px solid var(--rule-soft); }\n.attempt-row:first-child { border-top: none; }\n.attempt-row.is-fail { background: var(--sev-returned-bg); margin: 0 calc(-1 * var(--pad)); padding: 9px var(--pad); border-radius: var(--radius); }\n.attempt-main { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; font-size: 13px; }\n.attempt-footnote { margin-top: 4px; }\n.raw-rows { margin-top: 6px; }\n.raw-rows summary { cursor: pointer; font-size: 12px; color: var(--ink-3); min-height: 32px; display: inline-flex; align-items: center; }\n.raw-rows td { white-space: nowrap; }\n\n/* ---------- freeze frames (R7) ---------- */\n\n.ff-card { border-top: 1px solid var(--rule-soft); padding: 12px 0; }\n.ff-card:first-child { border-top: none; }\n.ff-key-grid {\n  display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 8px;\n  margin-top: 8px;\n}\n.ff-pid {\n  background: var(--surface-2); border: 1px solid var(--rule); border-radius: var(--radius);\n  padding: 8px 10px;\n}\n.ff-pid.is-flag { border-color: var(--sev-chronic); background: var(--sev-chronic-bg); }\n.ff-name { font-size: 11px; color: var(--ink-3); text-transform: uppercase; letter-spacing: .05em; }\n.ff-value { font-size: 14px; margin-top: 2px; }\n.ff-flag { font-size: 12px; color: var(--sev-chronic); margin-top: 3px; font-weight: 650; }\n.all-pids { margin-top: 10px; }\n.all-pids summary { cursor: pointer; font-size: 12px; color: var(--ink-3); min-height: 32px; display: inline-flex; align-items: center; }\n.ff-all-grid { margin-top: 6px; display: grid; grid-template-columns: 1fr; gap: 2px; }\n@media (min-width: 640px) { .ff-all-grid { grid-template-columns: 1fr 1fr; } }\n.ff-all-row { display: flex; justify-content: space-between; gap: 10px; padding: 3px 0; font-size: 12.5px; border-bottom: 1px solid var(--rule-soft); }\n.ff-all-row .k { color: var(--ink-3); }\n\n/* ---------- bulletins (R9) ---------- */\n\n.bulletin-card { border-top: 1px solid var(--rule-soft); padding: 12px 0; }\n.bulletin-card:first-child { border-top: none; }\n.bulletin-card h4 { margin: 0 0 4px; font-size: 13.5px; }\n.bulletin-codes { display: flex; gap: 6px; flex-wrap: wrap; margin: 6px 0; }\n.chip-code.sm { min-height: 44px; font-size: 11px; padding: 2px 9px; }\n\n/* ---------- blind spots (R8) ---------- */\n\n.blindspot-row { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; }\n.blindspot-row .q { flex: 1 1 260px; }\n.blindspot-row .why { flex: 2 1 320px; }\n.dealer-tag { min-height: 28px; display: inline-flex; align-items: center; }\n.epistemic-line { margin-top: 10px; }\n\n/* ---------- notes quick-add FAB (R10) ---------- */\n\n.fab-note {\n  position: fixed; right: 18px; bottom: 18px; z-index: 40;\n  width: 56px; height: 56px; border-radius: 50%;\n  background: var(--accent); color: #fff; border: none; font-size: 22px;\n  box-shadow: 0 4px 14px rgba(0,0,0,.4); cursor: pointer;\n}\n.fab-note:hover { filter: brightness(1.08); }\n\n/* ---------- verify page ---------- */\n\n.verify-page { max-width: 640px; }\n.readiness-panel .readiness-row { display: flex; justify-content: space-between; align-items: center; padding: 6px 0; border-top: 1px solid var(--rule-soft); }\n.readiness-panel .readiness-row:first-of-type { border-top: none; }\n.back-to-dossier {\n  display: flex; align-items: center; justify-content: center;\n  min-height: 48px; margin-top: 16px; font-weight: 650; font-size: 14px;\n}\n\n/* ---------- ergonomics baseline (R10) ---------- */\n\nbody { font-size: 16px; }\n.small { font-size: 13px; }\ntable.codes-table td.n.mono, table.codes-table td.mono { font-size: 14px; }\n/* ...except the short last-seen date and the compact km figure, which are\n * labels rather than precision measurements and need the width back more\n * than they need the bump (title=\"\" carries the exact value on tap). */\ntable.codes-table td.lastseen-cell { font-size: 12px; }\ntable.codes-table td.kmcell { font-size: 12.5px; }\n.jump-chip, .vtabs a { min-height: 40px; }\n.btn { min-height: 44px; }\ninput[type=checkbox] + label, label.checkbox-label { min-height: 44px; display: inline-flex; align-items: center; }\n\n/* ---------- theme toggle persistence hook ---------- */\n/* data-theme is set/read by cuore.js; the actual palettes are the\n * :root[data-theme=\"light\"] / @media blocks already defined above. */\n\n@media (max-width: 400px) {\n  .vline .vname { max-width: 32%; }\n  .verdict-actions { flex-direction: column; }\n}\n\n\n/* Swipeable rows (tabs, section chips): no desktop-style scrollbar; they\n * still scroll by touch, trackpad and shift+wheel. */\n.vtabs, .jumprow { scrollbar-width: none; }\n.vtabs::-webkit-scrollbar, .jumprow::-webkit-scrollbar { display: none; }\n/* The strip's \"...\" details button must never be pushed off-screen. */\n.vbar .vmore { flex: none; margin-left: auto; }\n\n\n/* =========================================================================\n * TIMELINE -- \"Codes vs. what the driver notices\" (/v/{vin}/timeline)\n * Appended section; everything above this line predates the timeline page.\n * ========================================================================= */\n\n/* Per-code-family colours for cuore/web/timeline_svg.py. Same convention as\n * the --sev-* / --ok ramp above: dark-first in :root, mirrored in the light\n * media query and the explicit [data-theme=\"light\"] override, so the SVG's\n * var(--fam-*) references resolve correctly in both themes without the\n * Python module knowing which is active. Chosen to stay visually distinct\n * from --accent and from each other, and from --sev-cleared's blue (chassis\n * uses a steeper, darker blue than evap's teal or network's violet). */\n:root {\n  --fam-mil:          #e8565c;\n  --fam-evap:          #3fb0ae;\n  --fam-network:       #a986ef;\n  --fam-body:           #d98a3c;\n  --fam-chassis:        #5b8fd9;\n  --fam-engine:  #8fae4a;\n}\n\n@media (prefers-color-scheme: light) {\n  :root:not([data-theme=\"dark\"]) {\n    --fam-mil:          #9e1b21;\n    --fam-evap:          #1f7a78;\n    --fam-network:       #6b4fb0;\n    --fam-body:           #a85a10;\n    --fam-chassis:        #2a5ea8;\n    --fam-engine:  #5c7a1e;\n  }\n}\n\n:root[data-theme=\"light\"] {\n  --fam-mil:          #9e1b21;\n  --fam-evap:          #1f7a78;\n  --fam-network:       #6b4fb0;\n  --fam-body:           #a85a10;\n  --fam-chassis:        #2a5ea8;\n  --fam-engine:  #5c7a1e;\n}\n\n/* The swimlane chart: a fixed, non-scrolling label column (so a lane's name\n * is always on screen) beside a horizontally-scrolling SVG. This is what\n * keeps the page itself from scrolling sideways at 400px -- only the chart's\n * own box does, via its own scrollbar. */\n.tl-chart { display: flex; align-items: flex-start; border: 1px solid var(--rule);\n            border-radius: var(--radius); background: var(--surface); overflow: hidden; }\n.tl-labels { flex: none; display: flex; flex-direction: column; min-width: 86px;\n             max-width: 120px; border-right: 1px solid var(--rule); background: var(--surface-2); }\n.tl-label { display: flex; align-items: center; padding: 0 8px; font-size: 11.5px;\n            color: var(--ink-2); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;\n            border-bottom: 1px solid var(--rule-soft); }\n.tl-scroll { flex: 1 1 auto; overflow-x: auto; overflow-y: hidden; max-width: 100%; min-width: 0; }\n.tl-scroll svg { display: block; }\n.tl-toolbar { display: flex; flex-wrap: wrap; gap: 6px 14px; align-items: baseline;\n              margin: 8px 0 10px; font-size: 12.5px; }\n.tl-toolbar .grp { display: inline-flex; gap: 4px; align-items: center; }\n.tl-toolbar a { padding: 3px 8px; border: 1px solid var(--rule); border-radius: var(--radius);\n                color: var(--ink-2); text-decoration: none; min-height: 28px; display: inline-flex;\n                align-items: center; }\n.tl-toolbar a.on { color: var(--ink); border-color: var(--accent); font-weight: 650; }\n\n/* Correlation table: verdict chips reuse the existing severity chip classes\n * (.chip.chronic amber, .chip.plain grey-neutral) rather than new colours --\n * R10's rule (\"colour means status, nothing else\") already covers this. */\n.tl-corr td.codes-cell { display: flex; flex-wrap: wrap; gap: 4px; }\n.tl-corr .spark { vertical-align: middle; }\n\n/* Symptom entry form: big tap-to-toggle chips, checkbox-styled, 44px min\n * target per the mechanic-UX baseline already set for .btn/.jump-chip. */\n.tag-grid { display: flex; flex-wrap: wrap; gap: 8px; margin: 8px 0 14px; }\n.tag-chip { position: relative; }\n.tag-chip input[type=\"checkbox\"], .tag-chip input[type=\"radio\"] {\n  position: absolute; opacity: 0; width: 100%; height: 100%; margin: 0; cursor: pointer;\n}\n.tag-chip label {\n  display: inline-flex; align-items: center; justify-content: center; gap: 6px;\n  min-height: 44px; padding: 6px 14px; border: 1.5px solid var(--rule); border-radius: 999px;\n  background: var(--surface-2); color: var(--ink-2); font-size: 13.5px; cursor: pointer;\n  user-select: none; transition: background .1s ease, border-color .1s ease, color .1s ease;\n}\n.tag-chip input:checked + label {\n  background: var(--accent-dim); border-color: var(--accent); color: var(--ink); font-weight: 650;\n}\n.tag-chip.normally label { border-color: var(--ok); color: var(--ok); font-weight: 650; }\n.tag-chip.normally input:checked + label { background: var(--ok-bg); border-color: var(--ok); color: var(--ok); }\n.tag-hint { font-size: 12px; color: var(--ink-3); margin: -6px 0 10px; }\n\n/* \"What did the driver feel?\" dropdown (replaces the old tag chips above,\n * which stay defined for any other template still using .tag-grid/.tag-chip).\n * size=\"12\" (mechanic-UX review item 1) shows the whole fixed vocabulary at\n * once with no inner scrollbar -- the option padding/line-height below is\n * what gets each of those 12 rows close to a glove-friendly 44px, on every\n * width, not just under the old 760px-only rule. */\n.tag-select { width: 100%; font-size: 15px; }\n.tag-select option { min-height: 44px; padding: 13px 8px; line-height: 1.2; }\n\n/* \"What would the driver feel?\" card on code.html. */\n.feel-card .feel-sentence { font-size: 15px; margin: 4px 0 10px; }\n.feel-card .feel-tags { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 8px; }\n.feel-card .feel-tags .chip.expect { color: var(--ok); background: var(--ok-bg); }\n.feel-card .feel-tags .chip.not-expect { color: var(--ink-3); background: var(--surface-2);\n  text-decoration: line-through; text-decoration-color: var(--ink-3); }\n\n@media print {\n  .tl-scroll { overflow: visible !important; }\n  .tl-chart { border: none; }\n}\n\n@media (max-width: 400px) {\n  .tl-labels { min-width: 70px; max-width: 92px; }\n  .tl-label { font-size: 10.5px; padding: 0 5px; }\n}\n\n/* =========================================================================\n * Others' experience card (cuore/web/templates/_experience.html).\n * Appended section -- added for the experience-links feature, kept\n * separate from the rest of the sheet above rather than interleaved.\n * ========================================================================= */\n\n.experience-card h3 { display: flex; align-items: center; gap: 8px; }\n.exp-row {\n  display: flex; align-items: center; gap: 10px; min-height: 44px;\n  padding: 6px 2px; border-bottom: 1px solid var(--rule-soft);\n}\n.exp-row:last-child { border-bottom: none; }\n.exp-icon {\n  flex: none; display: inline-flex; align-items: center; justify-content: center;\n  width: 28px; height: 28px; border-radius: 999px; background: var(--surface-2);\n  color: var(--ink-2); font-size: 13px;\n}\n.exp-main { flex: 1 1 auto; min-width: 0; }\n.exp-main a { font-weight: 600; word-break: break-word; }\n.exp-chips { flex: none; display: flex; flex-direction: column; align-items: flex-end; gap: 4px; }\n.exp-more summary { cursor: pointer; padding: 6px 0; color: var(--ink-2); }\n.exp-verified { margin: 8px 0 0; }\n\n@media (max-width: 400px) {\n  .exp-row { flex-wrap: wrap; }\n  .exp-chips { flex-direction: row; align-items: center; }\n}\n\n/* =========================================================================\n * Parts (cuore/web/templates/parts.html, _part_card.html).\n * Appended section -- added for the parts-catalog feature, kept separate\n * rather than interleaved with the sheet above.\n * ========================================================================= */\n\n.part-search { display: flex; flex-wrap: wrap; gap: 8px; margin: 10px 0 6px; }\n.part-search input[type=\"search\"] {\n  flex: 1 1 220px; min-height: 44px; padding: 6px 10px; border: 1px solid var(--rule);\n  border-radius: var(--radius); background: var(--surface); color: var(--ink);\n}\n\n.part-card h4 { margin: 14px 0 6px; font-size: 13.5px; color: var(--ink-2); }\n\n/* Compact card: a tap target (anchor, not div) for inline use on code.html/\n * maintenance.html/oil_change.html/brakes_tires.html -- name + first OEM\n * number + thumbnail, linking through to the full card on /v/{vin}/parts. */\na.part-compact {\n  display: flex; align-items: center; gap: 10px; min-height: 44px;\n  padding: 8px; border: 1px solid var(--rule); border-radius: var(--radius);\n  background: var(--surface); text-decoration: none; color: var(--ink);\n  margin-bottom: 8px;\n}\na.part-compact:hover { border-color: var(--accent); }\n.part-thumb {\n  flex: none; width: 40px; height: 40px; border-radius: var(--radius);\n  object-fit: cover; background: var(--surface-2);\n}\n.part-thumb-fallback {\n  display: inline-flex; align-items: center; justify-content: center;\n  font-size: 9px; color: var(--ink-3); text-align: center; line-height: 1.1;\n}\n.part-compact-text { min-width: 0; display: flex; flex-direction: column; gap: 2px; }\n.part-compact-name { font-weight: 600; word-break: break-word; }\n\n/* Photos grid on the full card. */\n.part-image-grid {\n  display: flex; flex-wrap: wrap; gap: 10px; margin: 6px 0 10px;\n}\n.part-image { margin: 0; width: 140px; }\n.part-image img {\n  display: block; width: 140px; height: 100px; object-fit: cover;\n  border-radius: var(--radius); background: var(--surface-2); border: 1px solid var(--rule);\n}\n.part-image figcaption { margin-top: 4px; display: flex; flex-direction: column; gap: 2px; }\n\n@media (max-width: 400px) {\n  .part-image { width: 48%; }\n  .part-image img { width: 100%; height: 90px; }\n}\n\n/* =========================================================================\n * Job (case) page (cuore/web/templates/job.html).\n * Appended section -- added for the Job workflow feature, kept separate\n * rather than interleaved with the sheet above.\n * ========================================================================= */\n\n.job-head-panel { margin-bottom: 10px; }\n.job-stepper { margin-bottom: 14px; }\n\n.hyp-card { margin-bottom: 12px; }\n.hyp-card.suggested-hyp { border-style: dashed; }\n.evidence-row { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; margin: 6px 0; }\n.evidence-chip { max-width: 100%; white-space: normal; text-align: left; }\n\n.hyp-status-row { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 10px; }\n.hyp-status-btn {\n  min-height: 44px; padding: 6px 14px; border: 1.5px solid var(--rule);\n  border-radius: var(--radius); background: var(--surface-2); color: var(--ink-2);\n  font-size: 13px; font-family: inherit; cursor: pointer;\n}\n.hyp-status-btn.on {\n  background: var(--accent-dim); border-color: var(--accent); color: var(--ink);\n  font-weight: 650;\n}\n\n@media (max-width: 400px) {\n  .hyp-status-btn { flex: 1 1 auto; }\n}\n\n/* =========================================================================\n * Tools for this step (cuore/web/templates/_tools_panel.html), used on\n * job.html (steps 3 & 5) and maintenance.html (per item), plus the\n * mandatory tools-used review on job.html (step 7).\n * Appended section -- added for the tools-kb feature, kept separate\n * rather than interleaved with the sheet above.\n * ========================================================================= */\n\n.tools-step-picker {\n  display: flex; align-items: center; gap: 8px; margin: 6px 0 12px; flex-wrap: wrap;\n}\n.tools-step-picker select {\n  min-height: 44px; padding: 4px 10px; border: 1px solid var(--rule);\n  border-radius: var(--radius); background: var(--surface); color: var(--ink);\n}\n\n.tools-panel h3 { display: flex; align-items: center; gap: 8px; }\n.tool-rows { display: flex; flex-direction: column; gap: 10px; }\n.tool-row {\n  padding: 8px 2px; border-bottom: 1px solid var(--rule-soft);\n}\n.tool-row:last-child { border-bottom: none; }\n.tool-row-main { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }\n.tool-kind { text-transform: uppercase; letter-spacing: .03em; }\n.tool-required { font-weight: 650; color: var(--accent); }\n.tool-spec { margin: 2px 0; }\n.tool-note { color: var(--ink-2); }\n\n.tools-review-panel .chip.chronic { margin-left: 6px; }\n\n.tool-review-row {\n  display: flex; align-items: center; gap: 10px; flex-wrap: wrap;\n  min-height: 44px; padding: 6px 0; border-bottom: 1px solid var(--rule-soft);\n}\n.tool-review-row:last-of-type { border-bottom: none; }\n.tool-review-used { display: flex; align-items: center; gap: 6px; min-width: 180px; flex: 1 1 200px; }\n.tool-review-used input[type=\"checkbox\"] { width: 20px; height: 20px; }\n.tool-review-right { display: flex; gap: 10px; flex: none; }\n.tool-review-right label { display: flex; align-items: center; gap: 4px; min-height: 44px; }\n.tool-review-right input[type=\"radio\"] { width: 18px; height: 18px; }\n.tool-review-note {\n  flex: 1 1 160px; min-height: 36px; padding: 4px 8px; border: 1px solid var(--rule);\n  border-radius: var(--radius); background: var(--surface); color: var(--ink);\n}\n\n@media (max-width: 400px) {\n  .tool-review-row { flex-direction: column; align-items: stretch; }\n  .tool-review-right { justify-content: space-between; }\n}\n","numLines":1083,"startLine":1,"totalLines":1415,"truncatedByTokenCap":true}},"sourceToolAssistantUUID":"2704d5af-97e2-47fa-b145-472e356038ae","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
