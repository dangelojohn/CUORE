{"parentUuid":"4921c25a-ba8d-48fb-a7d6-f52836d6dede","isSidechain":true,"agentId":"afd5fd0b447a75fb9","message":{"model":"claude-sonnet-5","id":"msg_011CfqPoGDgyFPv8gReHL6tT","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01VigV8V8B6rZJ52Ubgymapk","name":"Read","input":{"file_path":"C:\\Users\\User\\mcp-servers\\mes-log-mcp\\mes\\systems.py"},"caller":{"type":"direct"}}],"container":null,"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":4968,"cache_read_input_tokens":73225,"output_tokens":252,"output_tokens_details":{"thinking_tokens":173},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":0,"ephemeral_5m_input_tokens":4968},"inference_geo":"not_available","iterations":[{"input_tokens":2,"output_tokens":252,"cache_read_input_tokens":73225,"cache_creation_input_tokens":4968,"cache_creation":{"ephemeral_5m_input_tokens":4968,"ephemeral_1h_input_tokens":0},"type":"message"}],"speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_01VigV8V8B6rZJ52Ubgymapk":{"file_path":"C:\\Users\\User\\mcp-servers\\mes-log-mcp\\mes\\systems.py"}},"serverClassifierRequest":"dc608c0d-2f45-4708-a0cc-553cb5211d2a","apiBlockIndex":1,"requestId":"req_011CfqPoFwaSSLroKoLnfkdC","attributionAgent":"general-purpose","type":"assistant","uuid":"f885c9ea-762d-4244-a71e-5f40cdafc6fe","timestamp":"2026-10-08T20:22:58.298Z","effort":"high","perTurnEffort":null,"userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
{"parentUuid":"f885c9ea-762d-4244-a71e-5f40cdafc6fe","isSidechain":true,"promptId":"fec640df-85aa-489c-b61a-597c991f7812","agentId":"afd5fd0b447a75fb9","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01VigV8V8B6rZJ52Ubgymapk","type":"tool_result","content":"1\t\"\"\"Vehicle SYSTEMS as a correlational dimension, cutting across every DTC.\n2\t\n3\tA code lookup answers \"what fault is this\"; it does not answer \"what else on\n4\tthis car shares a cause with it\". This module adds that second axis: every\n5\tDTC is assigned to one or more ordered vehicle systems (``SYSTEMS``), with a\n6\t``depends_on`` graph recording which systems are documented as upstream of\n7\twhich others (a BCM supply fault cascading into network U-codes, an EVAP\n8\tleak code that can trace back to the fuel tank/cap it shares with the fuel\n9\tsystem). ``mes.workup``/``mes.analysis`` already answer \"what DTCs happened,\n10\twhen, together\" per vehicle; :func:`correlate` reuses that corpus data and\n11\tprojects it onto the system graph.\n12\t\n13\tNothing here is invented. Every ``depends_on`` edge and every exact-code\n14\tsystem assignment carries a ``source`` -- either a citation (this project's\n15\town ``mes.knowledge`` TSB table, ``mes.code_feel``, ``mes.parts``, or the\n16\tgeneric SAE J2012 DTC-prefix convention, named as generic every time it is\n17\tused) or, for a relationship nobody has sourced, ``confidence=\"UNKNOWN\"``\n18\twith a note pointing at the service manual -- never a silently guessed\n19\tdependency. :func:`correlate` is equally careful with its own output: it\n20\tnever asserts a dependency is *proven*, only that the corpus shows two\n21\tsystems' codes appearing together, worded as \"could be upstream\", with the\n22\tsession counts that back (or don't back) that reading.\n23\t\n24\tEvery ``depends_on`` edge also carries a ``technical`` dict (``carries``,\n25\t``path``, ``bus``, ``measure``, ``propagates``, ``tsb_refs``) -- the\n26\telectrical/physical mechanism behind the edge, not just the prose ``why``.\n27\t``carries``/``propagates`` are mandatory on every edge (what actually flows,\n28\tand what the failure looks like downstream); ``path`` (element ids from\n29\t``mes.electrical``/``mes.layout_systems``), ``bus`` (name/speed from\n30\t``cuore.live.buses``) and ``measure`` (a concrete test point, with a\n31\tnumeric ``limit`` only when a TSB actually states one -- otherwise\n32\t``\"UNKNOWN (TechAuthority)\"``) are included only where this repo's own\n33\tsourced data supports them. Each SYSTEM also carries a ``technical`` dict\n34\t(``modules``, ``dids``, ``live_channels_with_bands``, ``components``,\n35\t``codes_owned``) -- same house rule: every value cites a source and\n36\tconfidence, or says ``UNKNOWN`` and points at the service manual.\n37\t\n38\tConfidence levels (same scale as the rest of this package):\n39\t\n40\t* ``CONFIRMED``     -- stated in this repo's own sourced table (an FCA/Alfa\n41\t                       TSB in ``mes.knowledge``, or a documented part/DTC\n42\t                       definition) or the DTC's own SAE-defined meaning\n43\t                       (e.g. a P0300-04 misfire code by definition implicates\n44\t                       ignition and fuel delivery).\n45\t* ``CORROBORATED``  -- two independent sourced findings agree (e.g. the\n46\t                       U-code -> network assignment: SAE's communication-DTC\n47\t                       range, corroborated by ``mes.knowledge.match_codes``'\n48\t                       own network-cascade family rule).\n49\t* ``SINGLE-SOURCE``  -- one source, or a generic SAE range convention used as\n50\t                       a last-resort, explicitly generic fallback.\n51\t* ``UNKNOWN``       -- no sourced relationship found; recorded as such\n52\t                       rather than guessed.\n53\t\"\"\"\n54\t\n55\tfrom __future__ import annotations\n56\t\n57\timport re\n58\tfrom datetime import date\n59\tfrom typing import Any, Optional\n60\t\n61\tCONFIRMED = \"CONFIRMED\"\n62\tCORROBORATED = \"CORROBORATED\"\n63\tSINGLE_SOURCE = \"SINGLE-SOURCE\"\n64\tUNKNOWN = \"UNKNOWN\"\n65\t\n66\tCONFIDENCE_LEVELS = (CONFIRMED, CORROBORATED, SINGLE_SOURCE, UNKNOWN)\n67\t\n68\t#: Same wording as ``mes.code_feel``/``mes.parts``/``mes.maintenance_specs``,\n69\t#: so an UNKNOWN confidence always reads the same way across this package.\n70\t_UNKNOWN_NOTE = \"not established in any source checked -- use the service manual (TechAuthority)\"\n71\t\n72\t#: Same note, for a ``technical.measure.limit`` with no TSB-stated number.\n73\t_UNKNOWN_LIMIT = \"UNKNOWN (TechAuthority)\"\n74\t\n75\t#: Strip the failure-type byte: \"P0456-00\" -> \"P0456\". Mirrors\n76\t#: ``mes.knowledge.base_code`` / ``mes.code_feel.base_code``, reimplemented\n77\t#: here rather than imported so this module stays a standalone lookup table.\n78\t_BASE_RE = re.compile(r\"^([PBCU][0-9A-F]{4})\", re.IGNORECASE)\n79\t\n80\t\n81\tdef base_code(code: str) -> str:\n82\t    m = _BASE_RE.match((code or \"\").strip().upper())\n83\t    return m.group(1) if m else (code or \"\").strip().upper()\n84\t\n85\t\n86\t# --- the system graph -------------------------------------------------------\n87\t\n88\tdef _tech(carries: str, propagates: str, *,\n89\t          path: Optional[list[str]] = None,\n90\t          bus: Optional[dict[str, Any]] = None,\n91\t          measure: Optional[dict[str, Any]] = None,\n92\t          tsb_refs: Optional[list[str]] = None) -> dict[str, Any]:\n93\t    \"\"\"One ``depends_on`` edge's technical detail. ``carries`` (what flows:\n94\t    \"12 V supply\", \"ground\", \"CAN data\", \"vacuum\", \"oil pressure\", ...) and\n95\t    ``propagates`` (a plain sentence of the failure mode) are mandatory on\n96\t    every edge. ``path`` (element ids from :mod:`mes.electrical`/\n97\t    :mod:`mes.layout_systems`), ``bus`` ({\"name\", \"speed\", ...}, from\n98\t    :mod:`cuore.live.buses`) and ``measure`` ({\"what\", \"where\", \"limit\",\n99\t    \"source\", \"confidence\"}) are included only where this repo's own\n100\t    sourced data supports them -- never invented to fill the shape.\"\"\"\n101\t    out: dict[str, Any] = {\"carries\": carries, \"propagates\": propagates}\n102\t    if path:\n103\t        out[\"path\"] = list(path)\n104\t    if bus:\n105\t        out[\"bus\"] = dict(bus)\n106\t    if measure:\n107\t        out[\"measure\"] = dict(measure)\n108\t    if tsb_refs:\n109\t        out[\"tsb_refs\"] = list(tsb_refs)\n110\t    return out\n111\t\n112\t\n113\tdef _dep(system: str, why: str, confidence: str, source: Optional[str] = None,\n114\t         technical: Optional[dict[str, Any]] = None) -> dict[str, Any]:\n115\t    \"\"\"One ``depends_on`` edge. Enforces the house rule at definition time:\n116\t    a non-UNKNOWN confidence must carry a real citation; an UNKNOWN one gets\n117\t    the standard note if the caller didn't supply one. ``technical`` (built\n118\t    with :func:`_tech`) is required -- every edge must say what it carries\n119\t    and how it propagates, even when that is all that's known.\"\"\"\n120\t    if confidence not in CONFIDENCE_LEVELS:\n121\t        raise ValueError(f\"bad confidence {confidence!r}\")\n122\t    if confidence == UNKNOWN and not source:\n123\t        source = _UNKNOWN_NOTE\n124\t    if not source:\n125\t        raise ValueError(f\"dependency on {system!r} has no source -- \"\n126\t                          \"mark confidence UNKNOWN or cite one\")\n127\t    if not technical or \"carries\" not in technical or \"propagates\" not in technical:\n128\t        raise ValueError(f\"dependency on {system!r} has no technical \"\n129\t                          \"dict with carries/propagates\")\n130\t    return {\"system\": system, \"why\": why, \"confidence\": confidence,\n131\t            \"source\": source, \"technical\": technical}\n132\t\n133\t\n134\tdef _system(key: str, label: str, components: list[str], *,\n135\t            live_channels: Optional[list[str]] = None,\n136\t            maintenance_items: Optional[list[str]] = None,\n137\t            parts: Optional[list[str]] = None,\n138\t            depends_on: Optional[list[dict[str, Any]]] = None) -> dict[str, Any]:\n139\t    return {\n140\t        \"key\": key,\n141\t        \"label\": label,\n142\t        \"components\": list(components),\n143\t        \"live_channels\": list(live_channels or []),\n144\t        \"maintenance_items\": list(maintenance_items or []),\n145\t        \"parts\": list(parts or []),\n146\t        \"depends_on\": list(depends_on or []),\n147\t    }\n148\t\n149\t\n150\t#: Sources reused by several edges below, named once.\n151\t_S1808000005 = \"mes.knowledge Bulletin S1808000005 (BCM power-feed/fuse F82 cascade into U-codes)\"\n152\t_S2008000032 = \"mes.knowledge Bulletin S2008000032 (connector XY201 / grounds G003A-B multi-module cascade)\"\n153\t_S1708000262 = \"mes.knowledge Bulletin S1708000262 REV. A (intermittent CAN-private/LIN codes -- spread terminals)\"\n154\t_S2308000004 = \"mes.knowledge Bulletin S2308000004 (cranks/no-start -- verify ECM/PCM B+ feeds and grounds)\"\n155\t_S2008000078 = \"mes.knowledge Bulletin S2008000078 REV. A (U0102 on RWD is a software/config fault, not a bus fault)\"\n156\t_S1821000001 = \"mes.knowledge Bulletin S1821000001 REV. A (AWD tyre-circumference mismatch causes driveline shudder)\"\n157\t_EVAP_SOURCES = (\"mes.parts esim/purge_valve (ECM-commanded solenoid/pump) + \"\n158\t                 \"mes.code_feel EVAP section + mes.knowledge EVAP bulletins \"\n159\t                 \"(S2125000002, 9100469/9100471, 18-030-17)\")\n160\t_EVAP_FUEL_SOURCES = (\"mes.code_feel EVAP section + carparts.com/fs1inc.com P0455/P0456 \"\n161\t                      \"writeups (EVAP shares the tank, fuel cap and fuel-level/pressure \"\n162\t                      \"signal path with the fuel system)\")\n163\t_RFHUB_SOURCE = (\"mes.electrical 'rfhub_module' entry (network address CONFIRMED \"\n164\t                 \"and documented to carry TPMS data, per GIORGIO_MODULE_MAP.md; \"\n165\t                 \"module identity as RFHUB itself is INFERRED, per that same entry)\")\n166\t\n167\t#: Electrical-path element ids, as named in mes.electrical.ELEMENTS, reused\n168\t#: here only as plain string references (never re-derived) for depends_on\n169\t#: edges whose path a sourced TSB actually spells out.\n170\t_BCM_SUPPLY_PATH = [\"bcm\", \"f82\", \"bcm_feed_20a\"]\n171\t_BCM_CONNECTOR_GROUND_PATH = [\"xy201\", \"g003a\", \"g003b\"]\n172\t_BCM_FULL_PATH = _BCM_SUPPLY_PATH + _BCM_CONNECTOR_GROUND_PATH\n173\t\n174\t#: cuore.live.buses facts, restated as plain data (never imported -- this\n175\t#: module stays standalone) so a depends_on edge's ``bus`` field can cite\n176\t#: the actual pins/bitrate/confidence cuore.live.buses.py sources.\n177\t_BUS_CAN_C = {\"name\": \"CAN-C\", \"speed\": \"500 kbit/s\", \"pins\": \"6/14\",\n178\t              \"confidence\": \"confirmed\", \"source\": \"cuore.live.buses CAN_C\"}\n179\t_BUS_CAN_IHS = {\"name\": \"CAN-IHS\", \"speed\": \"125 kbit/s\", \"pins\": \"3/11\",\n180\t                \"confidence\": \"confirmed\", \"source\": \"cuore.live.buses CAN_IHS\"}\n181\t_BUS_CAN_CH = {\"name\": \"CAN-CH\", \"speed\": \"500 kbit/s (inferred)\", \"pins\": \"12/13\",\n182\t               \"confidence\": \"inferred\", \"source\": \"cuore.live.buses CAN_CH\"}\n183\t\n184\t#: Ordered as given: the \"natural\" reading order for a dossier, roughly\n185\t#: supply -> network -> the engine's own systems -> driveline -> chassis ->\n186\t#: comfort/sensor/HVAC extras.\n187\tSYSTEMS: dict[str, dict[str, Any]] = {\n188\t    \"electrical_supply\": _system(\n189\t        \"electrical_supply\", \"Electrical supply\",\n190\t        [\"12V battery\", \"alternator\", \"chassis/engine grounds\", \"fuses\",\n191\t         \"BCM power feeds\"],\n192\t        live_channels=[\"battery_voltage\"],\n193\t        maintenance_items=[\"battery_12v\"],\n194\t        parts=[\"battery_12v\"],\n195\t        depends_on=[],\n196\t    ),\n197\t    \"network\": _system(\n198\t        \"network\", \"Network / CAN buses\",\n199\t        [\"CAN-C\", \"CAN-IHS\", \"CAN-CH\", \"gateway modules\", \"BCM\"],\n200\t        live_channels=[],\n201\t        maintenance_items=[],\n202\t        parts=[],\n203\t        depends_on=[\n204\t            _dep(\"electrical_supply\",\n205\t                 \"BCM power feeds and chassis grounds are a documented root \"\n206\t                 \"cause of multi-module U-code cascades, not per-module bus \"\n207\t                 \"faults.\",\n208\t                 CONFIRMED, f\"{_S1808000005}; {_S2008000032}; {_S1708000262}\",\n209\t                 technical=_tech(\n210\t                     \"12 V supply\",\n211\t                     \"Low supply voltage at the BCM makes several modules \"\n212\t                     \"drop off CAN at once: U-codes on many modules \"\n213\t                     \"simultaneously, not one module's own bus fault.\",\n214\t                     path=_BCM_FULL_PATH,\n215\t                     measure={\"what\": \"voltage drop\", \"where\": \"G003A to battery negative\",\n216\t                              \"limit\": _UNKNOWN_LIMIT, \"source\": \"S2008000032\",\n217\t                              \"confidence\": SINGLE_SOURCE},\n218\t                     tsb_refs=[\"S1808000005\", \"S2008000032\", \"S1708000262\"],\n219\t                 )),\n220\t        ],\n221\t    ),\n222\t    \"ignition\": _system(\n223\t        \"ignition\", \"Ignition\",\n224\t        [\"spark plugs\", \"ignition coils\", \"crank/cam position sensors\"],\n225\t        live_channels=[\"engine_rpm\"],\n226\t        maintenance_items=[\"spark_plugs\", \"ignition_coils_inspect\"],\n227\t        parts=[\"spark_plug\", \"ignition_coil\"],\n228\t        depends_on=[\n229\t            _dep(\"electrical_supply\",\n230\t                 \"Coils and the igniter driver need a stable B+ supply; a \"\n231\t                 \"no-start/cranks-only complaint is diagnosed by verifying \"\n232\t                 \"ECM/PCM B+ feeds and grounds before suspecting ignition \"\n233\t                 \"parts.\",\n234\t                 CONFIRMED, _S2308000004,\n235\t                 technical=_tech(\n236\t                     \"12 V supply\",\n237\t                     \"A weak ECM/PCM B+ feed or ground starves the coil \"\n238\t                     \"driver circuit: cranks-but-no-start, or random \"\n239\t                     \"misfire codes, rather than a single bad coil.\",\n240\t                     measure={\"what\": \"voltage drop\", \"where\": \"ECM/PCM B+ feed to battery positive\",\n241\t                              \"limit\": _UNKNOWN_LIMIT, \"source\": \"S2308000004\",\n242\t                              \"confidence\": SINGLE_SOURCE},\n243\t                     tsb_refs=[\"S2308000004\"],\n244\t                 )),\n245\t        ],\n246\t    ),\n247\t    \"fuel\": _system(\n248\t        \"fuel\", \"Fuel\",\n249\t        [\"fuel tank\", \"fuel pump\", \"fuel pressure sensor\", \"fuel filter\",\n250\t         \"injectors\", \"fuel cap\"],\n251\t        live_channels=[\"fuel_level\"],\n252\t        maintenance_items=[\"fuel_filter\"],\n253\t        parts=[],\n254\t        depends_on=[\n255\t            _dep(\"electrical_supply\",\n256\t                 \"The fuel pump and injectors are electrically driven, so a \"\n257\t                 \"weak supply/ground can present as a fuel-delivery fault.\",\n258\t                 UNKNOWN,\n259\t                 technical=_tech(\n260\t                     \"12 V supply\",\n261\t                     \"A weak supply/ground to the fuel pump driver can look \"\n262\t                     \"like a fuel-delivery fault (lean/rich trim codes) \"\n263\t                     \"rather than a pump or injector failure.\",\n264\t                 )),\n265\t        ],\n266\t    ),\n267\t    \"evap\": _system(\n268\t        \"evap\", \"EVAP (evaporative emissions)\",\n269\t        [\"ESIM\", \"purge valve\", \"canister\", \"vent valve\", \"fuel cap\",\n270\t         \"vapor lines\", \"recirculation-line quick-connect\"],\n271\t        live_channels=[\"commanded_evap_purge\", \"evap_vapor_pressure\",\n272\t                      \"evap_vapor_pressure_abs\", \"fuel_level\"],\n273\t        maintenance_items=[],\n274\t        parts=[\"esim\", \"purge_valve\", \"evap_canister\", \"evap_quick_connect\"],\n275\t        depends_on=[\n276\t            _dep(\"electrical_supply\",\n277\t                 \"The ESIM and purge valve are ECM-commanded electrical \"\n278\t                 \"components (a leak-detection pump and a solenoid); a weak \"\n279\t                 \"supply/ground can disrupt the self-test they rely on.\",\n280\t                 SINGLE_SOURCE, _EVAP_SOURCES,\n281\t                 technical=_tech(\n282\t                     \"12 V supply\",\n283\t                     \"A weak supply/ground to the ESIM or purge-valve \"\n284\t                     \"solenoid disrupts the EVAP self-test, setting a leak \"\n285\t                     \"code (P0440/P0455/P0456) even with no actual leak.\",\n286\t                     path=[\"esim_connector\", \"esim_ground\"],\n287\t                 )),\n288\t            _dep(\"fuel\",\n289\t                 \"EVAP shares the tank, fuel cap and fuel-level/pressure \"\n290\t                 \"signal path with the fuel system; a fuel-cap or tank-side \"\n291\t                 \"fault can present as an EVAP leak code.\",\n292\t                 CORROBORATED, _EVAP_FUEL_SOURCES,\n293\t                 technical=_tech(\n294\t                     \"fuel vapor pressure\",\n295\t                     \"A loose fuel cap or tank-side fault changes vapor \"\n296\t                     \"pressure the ESIM reads, setting an EVAP leak code \"\n297\t                     \"that is really a fuel-side mechanical issue.\",\n298\t                 )),\n299\t        ],\n300\t    ),\n301\t    \"air_intake_boost\": _system(\n302\t        \"air_intake_boost\", \"Air intake / boost\",\n303\t        [\"intake tract\", \"MAP sensor\", \"turbocharger\", \"intercooler\",\n304\t         \"boost hoses\", \"throttle body\"],\n305\t        live_channels=[\"intake_map\", \"barometric_pressure\", \"boost\",\n306\t                      \"ecm_195a\", \"intake_air_temp\", \"absolute_load\",\n307\t                      \"throttle_position\"],\n308\t        maintenance_items=[\"engine_air_filter\", \"throttle_body_clean\",\n309\t                           \"intake_boost_hoses_inspect\"],\n310\t        parts=[\"engine_air_filter\", \"turbo_intercooler_hose\"],\n311\t        depends_on=[\n312\t            _dep(\"exhaust_emissions\",\n313\t                 \"The turbocharger is driven by exhaust gas, so an \"\n314\t                 \"exhaust-side restriction or a failing turbo housing can \"\n315\t                 \"present as a boost/MAP-sensor fault.\",\n316\t                 SINGLE_SOURCE,\n317\t                 \"general turbocharger architecture (exhaust-driven turbine) \"\n318\t                 \"-- no GU/Stelvio-specific TSB citation found\",\n319\t                 technical=_tech(\n320\t                     \"exhaust gas\",\n321\t                     \"An exhaust-side restriction or failing turbo housing \"\n322\t                     \"shows up as low boost / a MAP-sensor plausibility \"\n323\t                     \"code, not a boost-circuit electrical fault.\",\n324\t                 )),\n325\t        ],\n326\t    ),\n327\t    \"cooling\": _system(\n328\t        \"cooling\", \"Cooling\",\n329\t        [\"radiator\", \"coolant\", \"water pump\", \"thermostat\", \"cooling fan\"],\n330\t        live_channels=[\"engine_coolant_temp\"],\n331\t        maintenance_items=[\"coolant\"],\n332\t        parts=[\"coolant\"],\n333\t        depends_on=[],\n334\t    ),\n335\t    \"lubrication\": _system(\n336\t        \"lubrication\", \"Lubrication (oil)\",\n337\t        [\"oil pump\", \"oil filter\", \"oil pressure/level sensors\"],\n338\t        live_channels=[\"engine_oil_temp\"],\n339\t        maintenance_items=[],\n340\t        parts=[\"engine_oil\", \"oil_filter\", \"drain_plug_gasket\"],\n341\t        depends_on=[],\n342\t    ),\n343\t    \"exhaust_emissions\": _system(\n344\t        \"exhaust_emissions\", \"Exhaust / emissions\",\n345\t        [\"catalytic converter\", \"O2 sensors\", \"exhaust manifold\",\n346\t         \"turbo exhaust housing\"],\n347\t        live_channels=[],\n348\t        maintenance_items=[],\n349\t        parts=[],\n350\t        depends_on=[\n351\t            _dep(\"ignition\",\n352\t                 \"A misfire dumps unburned fuel into the exhaust and can \"\n353\t                 \"set secondary catalyst/O2 codes.\",\n354\t                 SINGLE_SOURCE,\n355\t                 \"general emissions-system architecture -- no GU/Stelvio-\"\n356\t                 \"specific TSB citation found\",\n357\t                 technical=_tech(\n358\t                     \"unburned fuel / combustion gas\",\n359\t                     \"A misfire dumps unburned fuel into the exhaust, \"\n360\t                     \"overheating and fouling the catalyst/O2 sensors: a \"\n361\t                     \"secondary catalyst-efficiency code that traces back \"\n362\t                     \"to the ignition-side misfire, not the catalyst.\",\n363\t                 )),\n364\t        ],\n365\t    ),\n366\t    \"transmission_driveline\": _system(\n367\t        \"transmission_driveline\", \"Transmission / driveline\",\n368\t        [\"ZF 8HP transmission\", \"Q4 transfer case\", \"differentials\",\n369\t         \"driveshafts\", \"valve body\"],\n370\t        live_channels=[\"tcm_04fe\", \"tcm_0518\"],\n371\t        maintenance_items=[],\n372\t        parts=[\"transmission_fluid\", \"transfer_case_fluid\"],\n373\t        depends_on=[\n374\t            _dep(\"network\",\n375\t                 \"U0102 'lost communication with transfer case' can be an \"\n376\t                 \"ECM software/configuration fault (AWD software on a RWD \"\n377\t                 \"build) rather than a transfer-case hardware or bus fault.\",\n378\t                 CONFIRMED, _S2008000078,\n379\t                 technical=_tech(\n380\t                     \"CAN data\",\n381\t                     \"An ECM software/configuration mismatch (AWD cal on a \"\n382\t                     \"RWD build) presents as a transfer-case 'lost \"\n383\t                     \"communication' code with no actual bus or hardware \"\n384\t                     \"fault.\",\n385\t                     bus=_BUS_CAN_C,\n386\t                     tsb_refs=[\"S2008000078\"],\n387\t                 )),\n388\t            _dep(\"suspension\",\n389\t                 \"Tyre circumference mismatch on AWD causes shudder/bind and \"\n390\t                 \"can damage the transfer case; this is ruled out before any \"\n391\t                 \"driveline hardware is condemned.\",\n392\t                 CONFIRMED, _S1821000001,\n393\t                 technical=_tech(\n394\t                     \"driveline mechanical coupling\",\n395\t                     \"A tyre-circumference mismatch on AWD binds the \"\n396\t                     \"driveline, presenting as a transfer-case shudder/\"\n397\t                     \"damage complaint that is actually a tire/suspension \"\n398\t                     \"issue.\",\n399\t                     tsb_refs=[\"S1821000001\"],\n400\t                 )),\n401\t        ],\n402\t    ),\n403\t    \"brakes_abs\": _system(\n404\t        \"brakes_abs\", \"Brakes / ABS\",\n405\t        [\"brake pads\", \"rotors\", \"calipers\", \"ABS/ESC modulator\",\n406\t         \"wheel speed sensors\", \"EPB\"],\n407\t        live_channels=[],\n408\t        maintenance_items=[\"brake_fluid\"],\n409\t        parts=[\"brake_pads_front\", \"brake_pads_rear\", \"brake_rotor_front\",\n410\t              \"brake_rotor_rear\", \"brake_fluid\"],\n411\t        depends_on=[\n412\t            _dep(\"electrical_supply\",\n413\t                 \"The ABS/ESC modulator and wheel-speed sensors are \"\n414\t                 \"electrically supplied module hardware, like the other \"\n415\t                 \"modules that cascade from a BCM supply fault.\",\n416\t                 UNKNOWN,\n417\t                 technical=_tech(\n418\t                     \"12 V supply\",\n419\t                     \"A weak supply/ground to the ABS/ESC modulator could \"\n420\t                     \"present as a brake-system module fault, like other \"\n421\t                     \"modules that cascade from a BCM supply fault -- not \"\n422\t                     \"corroborated for this module specifically.\",\n423\t                 )),\n424\t        ],\n425\t    ),\n426\t    \"steering\": _system(\n427\t        \"steering\", \"Steering\",\n428\t        [\"EPS motor/rack\", \"steering angle sensor\", \"steering column\"],\n429\t        live_channels=[],\n430\t        maintenance_items=[\"power_steering\"],\n431\t        parts=[],\n432\t        depends_on=[\n433\t            _dep(\"electrical_supply\",\n434\t                 \"EPS is an electrically driven power-steering system; a \"\n435\t                 \"weak supply affects assist.\",\n436\t                 UNKNOWN,\n437\t                 technical=_tech(\n438\t                     \"12 V supply\",\n439\t                     \"A weak supply to the EPS motor/rack reduces or drops \"\n440\t                     \"power-assist, presenting as a steering-effort \"\n441\t                     \"complaint rather than a rack/motor failure.\",\n442\t                 )),\n443\t        ],\n444\t    ),\n445\t    \"suspension\": _system(\n446\t        \"suspension\", \"Suspension\",\n447\t        [\"shocks/struts\", \"springs\", \"control arms\", \"bushings\",\n448\t         \"tires/wheels\"],\n449\t        live_channels=[],\n450\t        maintenance_items=[],\n451\t        parts=[\"tpms_sensor\"],\n452\t        depends_on=[],\n453\t    ),\n454\t    \"body_comfort\": _system(\n455\t        \"body_comfort\", \"Body / comfort\",\n456\t        [\"BCM\", \"door/window modules\", \"central locking\",\n457\t         \"interior lighting\", \"wipers\"],\n458\t        live_channels=[],\n459\t        maintenance_items=[\"wipers\", \"hood_and_door_lubrication\"],\n460\t        parts=[\"wiper_blades\"],\n461\t        depends_on=[\n462\t            _dep(\"network\",\n463\t                 \"Most body-module codes gateway through the BCM onto the \"\n464\t                 \"vehicle's CAN/LIN buses; an intermittent bus/terminal \"\n465\t                 \"fault can present as a body-module fault.\",\n466\t                 SINGLE_SOURCE, _S1708000262,\n467\t                 technical=_tech(\n468\t                     \"CAN data\",\n469\t                     \"An intermittent bus/terminal fault on the gatewayed \"\n470\t                     \"buses presents as a body-module (door/window/\"\n471\t                     \"locking) fault rather than a bus fault.\",\n472\t                     bus=_BUS_CAN_IHS,\n473\t                     tsb_refs=[\"S1708000262\"],\n474\t                 )),\n475\t            _dep(\"electrical_supply\",\n476\t                 \"BCM supply-side faults (e.g. fuse F82) are documented to \"\n477\t                 \"cascade into multiple module/body symptoms.\",\n478\t                 CONFIRMED, _S1808000005,\n479\t                 technical=_tech(\n480\t                     \"12 V supply\",\n481\t                     \"A BCM supply-side fault (fuse F82) cascades into \"\n482\t                     \"multiple body-module symptoms at once (locks, \"\n483\t                     \"windows, lighting) rather than one module failing.\",\n484\t                     path=_BCM_SUPPLY_PATH,\n485\t                     measure={\"what\": \"voltage drop\", \"where\": \"fuse F82 to BCM power feed\",\n486\t                              \"limit\": _UNKNOWN_LIMIT, \"source\": \"S1808000005\",\n487\t                              \"confidence\": SINGLE_SOURCE},\n488\t                     tsb_refs=[\"S1808000005\"],\n489\t                 )),\n490\t        ],\n491\t    ),\n492\t    \"adas_sensors\": _system(\n493\t        \"adas_sensors\", \"ADAS / sensors\",\n494\t        [\"forward camera\", \"radar\", \"park-assist sensors\",\n495\t         \"driver-assist ECU\"],\n496\t        live_channels=[],\n497\t        maintenance_items=[],\n498\t        parts=[],\n499\t        depends_on=[\n500\t            _dep(\"network\",\n501\t                 \"ADAS/chassis-module codes often ride the same gatewayed \"\n502\t                 \"CAN buses as other modules affected by bus/supply events.\",\n503\t                 UNKNOWN,\n504\t                 technical=_tech(\n505\t                     \"CAN data\",\n506\t                     \"A bus/supply event affecting other gatewayed modules \"\n507\t                     \"could present as an ADAS-sensor communication fault \"\n508\t                     \"-- not corroborated for this system specifically.\",\n509\t                     bus=_BUS_CAN_CH,\n510\t                 )),\n511\t        ],\n512\t    ),\n513\t    \"hvac\": _system(\n514\t        \"hvac\", \"HVAC\",\n515\t        [\"A/C compressor\", \"blower motor\", \"cabin air filter\",\n516\t         \"climate control module\", \"refrigerant circuit\"],\n517\t        live_channels=[],\n518\t        maintenance_items=[\"cabin_air_filter\", \"a_c_cabin_service\"],\n519\t        parts=[\"cabin_air_filter\"],\n520\t        depends_on=[],\n521\t    ),\n522\t    \"pcv\": _system(\n523\t        \"pcv\", \"PCV (crankcase ventilation)\",\n524\t        [\"crankcase breather\", \"PCV valve/housing\", \"breather hoses\",\n525\t         \"intake connection\"],\n526\t        live_channels=[],\n527\t        maintenance_items=[\"pcv_system\"],\n528\t        parts=[],\n529\t        depends_on=[\n530\t            _dep(\"lubrication\",\n531\t                 \"The PCV system vents the crankcase that the lubrication \"\n532\t                 \"system pressurizes with combustion blow-by; a \"\n533\t                 \"lubrication-side fault (excess blow-by, overfill) can \"\n534\t                 \"overwhelm the PCV valve/hoses.\",\n535\t                 SINGLE_SOURCE,\n536\t                 \"general PCV system architecture (crankcase ventilation \"\n537\t                 \"draws from the lubrication system's crankcase) -- no \"\n538\t                 \"GU/Stelvio-specific TSB citation found\",\n539\t                 technical=_tech(\n540\t                     \"crankcase blow-by gas\",\n541\t                     \"Excess blow-by or an oil overfill overwhelms the PCV \"\n542\t                     \"valve/hoses, presenting as a PCV-side fault that \"\n543\t                     \"actually originates in the lubrication system.\",\n544\t                 )),\n545\t            _dep(\"air_intake_boost\",\n546\t                 \"The PCV valve/hoses route crankcase vapor into the \"\n547\t                 \"intake tract under vacuum; a stuck-open valve or split \"\n548\t                 \"hose is a documented source of unmetered air (a vacuum \"\n549\t                 \"leak) that can present as a lean or boost-side fault.\",\n550\t                 SINGLE_SOURCE,\n551\t                 \"general PCV system architecture (crankcase-to-intake \"\n552\t                 \"vacuum connection) -- no GU/Stelvio-specific TSB \"\n553\t                 \"citation found\",\n554\t                 technical=_tech(\n555\t                     \"vacuum\",\n556\t                     \"A stuck-open PCV valve or split hose is an unmetered-\"\n557\t                     \"air (vacuum) leak into the intake tract: a lean or \"\n558\t                     \"boost-side fault that traces back to the PCV system.\",\n559\t                 )),\n560\t        ],\n561\t    ),\n562\t    \"engine_management\": _system(\n563\t        \"engine_management\", \"Engine management (ECM / sensors)\",\n564\t        [\"ECM\", \"crank/cam position sensors\", \"ECM-internal diagnostics\"],\n565\t        live_channels=[],\n566\t        maintenance_items=[],\n567\t        parts=[],\n568\t        depends_on=[\n569\t            _dep(\"electrical_supply\",\n570\t                 \"The ECM/PCM itself needs a stable B+ feed and ground; a \"\n571\t                 \"cranks/no-start complaint is diagnosed by verifying \"\n572\t                 \"ECM/PCM B+ feeds and grounds before suspecting an \"\n573\t                 \"ECM-internal fault.\",\n574\t                 CONFIRMED, _S2308000004,\n575\t                 technical=_tech(\n576\t                     \"ground\",\n577\t                     \"A poor ECM/PCM ground presents as a cranks/no-start \"\n578\t                     \"or an erratic ECM-internal code, not an ECM hardware \"\n579\t                     \"failure.\",\n580\t                     measure={\"what\": \"voltage drop\", \"where\": \"ECM/PCM ground to battery negative\",\n581\t                              \"limit\": _UNKNOWN_LIMIT, \"source\": \"S2308000004\",\n582\t                              \"confidence\": SINGLE_SOURCE},\n583\t                     tsb_refs=[\"S2308000004\"],\n584\t                 )),\n585\t        ],\n586\t    ),\n587\t    \"valve_control\": _system(\n588\t        \"valve_control\", \"Valve control (MultiAir / cam phasing)\",\n589\t        [\"MultiAir solenoid/actuator\", \"camshaft position actuator\",\n590\t         \"cam phaser\", \"camshaft position sensors\"],\n591\t        live_channels=[],\n592\t        maintenance_items=[],\n593\t        parts=[],\n594\t        depends_on=[\n595\t            _dep(\"lubrication\",\n596\t                 \"MultiAir/cam-phasing actuators are oil-pressure-\"\n597\t                 \"actuated; low oil pressure or dirty oil is a documented \"\n598\t                 \"cause of camshaft-actuator timing faults on \"\n599\t                 \"oil-pressure-actuated valve systems in general.\",\n600\t                 SINGLE_SOURCE,\n601\t                 \"general MultiAir/cam-phaser architecture (oil-pressure-\"\n602\t                 \"actuated) -- no GU/Stelvio-specific TSB citation found\",\n603\t                 technical=_tech(\n604\t                     \"oil pressure\",\n605\t                     \"Low oil pressure or dirty oil starves the MultiAir/\"\n606\t                     \"cam-phaser actuator, setting a camshaft timing/\"\n607\t                     \"actuator code that traces back to lubrication, not \"\n608\t                     \"the actuator itself.\",\n609\t                 )),\n610\t        ],\n611\t    ),\n612\t    \"starting_charging\": _system(\n613\t        \"starting_charging\", \"Starting / charging\",\n614\t        [\"starter motor\", \"DBSM (dual battery switch module)\",\n615\t         \"stop-start system\", \"alternator/charging circuit\"],\n616\t        live_channels=[],\n617\t        maintenance_items=[\"battery_12v\"],\n618\t        parts=[\"battery_12v\"],\n619\t        depends_on=[\n620\t            _dep(\"electrical_supply\",\n621\t                 \"A cranks/no-start or stop-start-disabled complaint is \"\n622\t                 \"diagnosed by verifying ECM/PCM B+ feeds and grounds \"\n623\t                 \"before suspecting the starter or DBSM hardware.\",\n624\t                 CONFIRMED, _S2308000004,\n625\t                 technical=_tech(\n626\t                     \"12 V supply\",\n627\t                     \"A weak B+ feed or ground presents as a cranks/no-\"\n628\t                     \"start or stop-start-disabled complaint rather than a \"\n629\t                     \"starter or DBSM hardware failure.\",\n630\t                     tsb_refs=[\"S2308000004\"],\n631\t                 )),\n632\t        ],\n633\t    ),\n634\t    \"security_immobiliser\": _system(\n635\t        \"security_immobiliser\", \"Security / immobiliser\",\n636\t        [\"immobiliser (BCM-hosted)\", \"WIN (wireless ignition node)\",\n637\t         \"RFHUB (passive entry / keyfob)\", \"PROXI master\"],\n638\t        live_channels=[],\n639\t        maintenance_items=[],\n640\t        parts=[],\n641\t        depends_on=[\n642\t            _dep(\"network\",\n643\t                 \"Immobiliser functions are hosted on the BCM, which is \"\n644\t                 \"also the documented B-CAN/C-CAN gateway; an intermittent \"\n645\t                 \"bus/terminal fault can present as a security-module \"\n646\t                 \"fault.\",\n647\t                 SINGLE_SOURCE, _S1708000262,\n648\t                 technical=_tech(\n649\t                     \"CAN data\",\n650\t                     \"An intermittent bus/terminal fault on the BCM's \"\n651\t                     \"gatewayed buses can present as a security/\"\n652\t                     \"immobiliser fault, since the immobiliser is hosted \"\n653\t                     \"on the BCM.\",\n654\t                     bus=_BUS_CAN_C,\n655\t                     tsb_refs=[\"S1708000262\"],\n656\t                 )),\n657\t            _dep(\"electrical_supply\",\n658\t                 \"BCM supply-side faults (e.g. fuse F82) are documented to \"\n659\t                 \"cascade into multiple module/body symptoms, and the \"\n660\t                 \"immobiliser is hosted on the BCM.\",\n661\t                 CONFIRMED, _S1808000005,\n662\t                 technical=_tech(\n663\t                     \"12 V supply\",\n664\t                     \"A BCM supply-side fault (fuse F82) can disable the \"\n665\t                     \"BCM-hosted immobiliser along with other BCM-hosted \"\n666\t                     \"functions, not just one security component.\",\n667\t                     path=_BCM_SUPPLY_PATH,\n668\t                     tsb_refs=[\"S1808000005\"],\n669\t                 )),\n670\t        ],\n671\t    ),\n672\t    \"infotainment_cluster\": _system(\n673\t        \"infotainment_cluster\", \"Infotainment / cluster\",\n674\t        [\"IPC (instrument panel cluster)\", \"Uconnect head unit\",\n675\t         \"radio/navigation/media modules\"],\n676\t        live_channels=[],\n677\t        maintenance_items=[],\n678\t        parts=[],\n679\t        depends_on=[\n680\t            _dep(\"network\",\n681\t                 \"Infotainment/cluster modules gateway through the BCM \"\n682\t                 \"onto the vehicle's CAN/LIN buses; an intermittent bus/\"\n683\t                 \"terminal fault can present as an infotainment/cluster \"\n684\t                 \"fault.\",\n685\t                 SINGLE_SOURCE, _S1708000262,\n686\t                 technical=_tech(\n687\t                     \"CAN data\",\n688\t                     \"An intermittent bus/terminal fault presents as an \"\n689\t                     \"infotainment/cluster fault (blank screen, dropped \"\n690\t                     \"gauges) rather than a bus fault.\",\n691\t                     bus=_BUS_CAN_C,\n692\t                     tsb_refs=[\"S1708000262\"],\n693\t                 )),\n694\t            _dep(\"electrical_supply\",\n695\t                 \"BCM supply-side faults (e.g. fuse F82) are documented to \"\n696\t                 \"cascade into multiple module symptoms, infotainment/\"\n697\t                 \"cluster included.\",\n698\t                 CONFIRMED, _S1808000005,\n699\t                 technical=_tech(\n700\t                     \"12 V supply\",\n701\t                     \"A BCM supply-side fault cascades into infotainment/\"\n702\t                     \"cluster symptoms along with other module symptoms, \"\n703\t                     \"not an IPC/head-unit hardware failure.\",\n704\t                     path=_BCM_SUPPLY_PATH,\n705\t                     tsb_refs=[\"S1808000005\"],\n706\t                 )),\n707\t        ],\n708\t    ),\n709\t    \"lighting\": _system(\n710\t        \"lighting\", \"Lighting\",\n711\t        [\"headlamps\", \"taillamps\", \"turn signal/marker lamps\",\n712\t         \"AFLS/AHLM/AHBM lighting modules\"],\n713\t        live_channels=[],\n714\t        maintenance_items=[],\n715\t        parts=[],\n716\t        depends_on=[\n717\t            _dep(\"electrical_supply\",\n718\t                 \"Lamps and lighting-control modules are electrical \"\n719\t                 \"loads; a weak supply/ground can present as a lighting \"\n720\t                 \"fault.\",\n721\t                 UNKNOWN,\n722\t                 technical=_tech(\n723\t                     \"12 V supply\",\n724\t                     \"A weak supply/ground to a lamp or lighting-control \"\n725\t                     \"module presents as a lighting fault -- not \"\n726\t                     \"corroborated for this car specifically.\",\n727\t                 )),\n728\t        ],\n729\t    ),\n730\t    \"wheels_tpms\": _system(\n731\t        \"wheels_tpms\", \"Wheels / TPMS\",\n732\t        [\"TPMS sensors\", \"RFHUB (TPMS RF receive)\"],\n733\t        live_channels=[],\n734\t        maintenance_items=[],\n735\t        parts=[\"tpms_sensor\"],\n736\t        depends_on=[\n737\t            _dep(\"network\",\n738\t                 \"TPMS data is received over the network by the RFHUB, \"\n739\t                 \"whose network address is confirmed in this project's \"\n740\t                 \"own module map (module identity as RFHUB itself is \"\n741\t                 \"inferred).\",\n742\t                 SINGLE_SOURCE, _RFHUB_SOURCE,\n743\t                 technical=_tech(\n744\t                     \"CAN data\",\n745\t                     \"A bus/supply fault reaching the RFHUB drops TPMS \"\n746\t                     \"data from the network, presenting as a TPMS fault \"\n747\t                     \"that is really a network-side issue.\",\n748\t                     bus=_BUS_CAN_C,\n749\t                 )),\n750\t        ],\n751\t    ),\n752\t    \"restraints\": _system(\n753\t        \"restraints\", \"Restraints (airbags / ORC)\",\n754\t        [\"ORC (occupant restraint controller)\", \"airbags\",\n755\t         \"pretensioners\", \"OCM (occupant classification)\",\n756\t         \"SIS (side-impact satellite sensors)\"],\n757\t        live_channels=[],\n758\t        maintenance_items=[],\n759\t        parts=[],\n760\t        depends_on=[\n761\t            _dep(\"electrical_supply\",\n762\t                 \"The ORC and its satellite sensors are electrically \"\n763\t                 \"supplied safety modules; a weak supply/ground could \"\n764\t                 \"affect them like other modules, but no sourced \"\n765\t                 \"restraints-specific cascade was found.\",\n766\t                 UNKNOWN,\n767\t                 technical=_tech(\n768\t                     \"12 V supply\",\n769\t                     \"A weak supply/ground to the ORC or its satellite \"\n770\t                     \"sensors could present as a restraints fault, like \"\n771\t                     \"other modules affected by a supply fault -- not \"\n772\t                     \"corroborated for restraints specifically.\",\n773\t                 )),\n774\t        ],\n775\t    ),\n776\t}\n777\t\n778\t\n779\t# --- per-SYSTEM technical enrichment ----------------------------------------\n780\t#\n781\t# modules/dids/components below cite only what this repo's own modules have\n782\t# actually sourced (cuore.live.buses' modules_seen tuples, cuore.live.\n783\t# did_catalog's EXTRA_DIDS, mes.electrical/mes.layout_systems element\n784\t# locations); every system not named gets an empty list rather than a\n785\t# guessed entry. live_channels_with_bands is filled from mes.known_good,\n786\t# imported lazily (same lazy-import posture correlate() already uses) so a\n787\t# knowledge-table miss can never break module import.\n788\t\n789\t#: Bus module codes this project has actually observed/placed per the\n790\t#: sourced ``modules_seen`` tuples in cuore.live.buses -- not every module\n791\t#: on the car, only the ones with a system this file already models.\n792\t_MODULES_BY_SYSTEM: dict[str, list[dict[str, str]]] = {\n793\t    \"network\": [\n794\t        {\"code\": \"BCM\", \"bus\": \"CAN-C\", \"confidence\": \"confirmed\"},\n795\t        {\"code\": \"RFHUB\", \"bus\": \"CAN-C\", \"confidence\": \"confirmed\"},\n796\t        {\"code\": \"IPC\", \"bus\": \"CAN-C\", \"confidence\": \"confirmed\"},\n797\t        {\"code\": \"TCM\", \"bus\": \"CAN-C\", \"confidence\": \"confirmed\"},\n798\t        {\"code\": \"ABS\", \"bus\": \"CAN-CH\", \"confidence\": \"inferred\"},\n799\t        {\"code\": \"EPS\", \"bus\": \"CAN-CH\", \"confidence\": \"inferred\"},\n800\t        {\"code\": \"ORC\", \"bus\": \"CAN-CH\", \"confidence\": \"inferred\"},\n801\t    ],\n802\t    \"engine_management\": [{\"code\": \"ECM\", \"bus\": \"CAN-C\", \"confidence\": \"confirmed\"}],\n803\t    \"transmission_driveline\": [{\"code\": \"TCM\", \"bus\": \"CAN-C\", \"confidence\": \"confirmed\"}],\n804\t    \"body_comfort\": [{\"code\": \"BCM\", \"bus\": \"CAN-C\", \"confidence\": \"confirmed\"}],\n805\t    \"infotainment_cluster\": [{\"code\": \"IPC\", \"bus\": \"CAN-C\", \"confidence\": \"confirmed\"}],\n806\t    \"security_immobiliser\": [{\"code\": \"BCM\", \"bus\": \"CAN-C\", \"confidence\": \"confirmed\"}],\n807\t    \"wheels_tpms\": [{\"code\": \"RFHUB\", \"bus\": \"CAN-C\", \"confidence\": \"confirmed\"}],\n808\t    \"brakes_abs\": [{\"code\": \"ABS\", \"bus\": \"CAN-CH\", \"confidence\": \"inferred\"}],\n809\t    \"steering\": [{\"code\": \"EPS\", \"bus\": \"CAN-CH\", \"confidence\": \"inferred\"}],\n810\t    \"restraints\": [{\"code\": \"ORC\", \"bus\": \"CAN-CH\", \"confidence\": \"inferred\"}],\n811\t    \"adas_sensors\": [{\"code\": \"PAM\", \"bus\": \"CAN-CH\", \"confidence\": \"inferred\"}],\n812\t    \"lighting\": [{\"code\": \"AFLS\", \"bus\": \"CAN-CH\", \"confidence\": \"inferred\"}],\n813\t}\n814\t_MODULES_SOURCE = \"cuore.live.buses CAN_C/CAN_CH.modules_seen (sourced observations, not a full module list)\"\n815\t\n816\t#: First 8 catalogued DID names, module=ECM, from cuore.live.did_catalog\n817\t#: EXTRA_DIDS (the only module that catalog adds beyond addressing.DIDS).\n818\t#: Confidence matches that source exactly -- danardi78, diesel-tested,\n819\t#: UNVERIFIED on this car's petrol 2.0T.\n820\t_ECM_DID_NAMES = [\n821\t    \"Fuel tank level\", \"Time since start (engine-on timer)\", \"Engine oil level\",\n822\t    \"Intake manifold temperature (pre-intercooler)\", \"Throttle position, sensor 1\",\n823\t    \"Throttle position, sensor 2\", \"Throttle position, sensor 3\",\n824\t    \"Wastegate / overboost valve position\",\n825\t]\n826\t_DIDS_SOURCE = (\"cuore.live.did_catalog EXTRA_DIDS, module=ECM (danardi78, \"\n827\t               \"tested on diesel Giulia -- confidence=unverified on this \"\n828\t               \"car's petrol 2.0T)\")\n829\t_DIDS_BY_SYSTEM: dict[str, list[dict[str, str]]] = {\n830\t    \"engine_management\": [{\"name\": n, \"confidence\": \"unverified\", \"source\": _DIDS_SOURCE}\n831\t                          for n in _ECM_DID_NAMES],\n832\t}\n833\t\n834\t#: Zone/confidence for the handful of components this repo's own\n835\t#: mes.electrical / mes.layout_systems elements actually place; every other\n836\t#: component label below falls back to zone=\"unknown\" -- never guessed.\n837\t_COMPONENT_ZONES: dict[str, tuple[str, str, str]] = {\n838\t    \"fuses\": (\"trunk\", SINGLE_SOURCE,\n839\t              \"mes.electrical 'f82' element (TSB S1808000005, rear PDC)\"),\n840\t    \"esim\": (\"rear_left_wheel_well\", SINGLE_SOURCE,\n841\t             \"mes.electrical 'esim_connector' element (TSB 9100469/9100471 \"\n842\t             \"+ EVAP_STELVIO.md; co-location with the canister is INFERRED \"\n843\t             \"there, restated here as SINGLE-SOURCE in this module's own \"\n844\t             \"4-value scale)\"),\n845\t    \"fuel tank\": (\"underbody\", SINGLE_SOURCE,\n846\t                  \"mes.layout_systems 'fuel_tank' element (TSB 9100471 \"\n847\t                  \"'drop the Fuel Tank' to access the FDM lock ring)\"),\n848\t}\n849\t\n850\t\n851\tdef _slug(label: str) -> str:\n852\t    return re.sub(r\"[^a-z0-9]+\", \"_\", label.lower()).strip(\"_\")\n853\t\n854\t\n855\tdef _component_entry(label: str) -> dict[str, Any]:\n856\t    zone, confidence, source = _COMPONENT_ZONES.get(\n857\t        label.lower(), (\"unknown\", UNKNOWN, _UNKNOWN_NOTE))\n858\t    return {\"id\": _slug(label), \"label\": label, \"zone\": zone,\n859\t            \"confidence\": confidence, \"source\": source}\n860\t\n861\t\n862\tdef _live_channel_band(channel_id: str) -> dict[str, Any]:\n863\t    \"\"\"One system's ``live_channels`` entry resolved to its known-good band\n864\t    via :mod:`mes.known_good`, imported lazily (never at module scope) so a\n865\t    knowledge-table miss can never break this module's own import.\"\"\"\n866\t    try:\n867\t        from . import known_good as _known_good\n868\t        row = _known_good.known_good(channel_id)\n869\t    except Exception:  # noqa: BLE001 -- enrichment is a nice-to-have, never fatal\n870\t        row = None\n871\t    if not row:\n872\t        return {\"channel\": channel_id, \"normal\": None, \"warn\": None,\n873\t                \"confidence\": UNKNOWN, \"source\": _UNKNOWN_NOTE}\n874\t    return {\"channel\": channel_id, \"normal\": row.get(\"normal\"), \"warn\": row.get(\"warn\"),\n875\t            \"confidence\": row.get(\"confidence\", UNKNOWN),\n876\t            \"source\": row.get(\"source\") or \"mes.known_good\"}\n877\t\n878\t\n879\tfor _sys_key, _row in SYSTEMS.items():\n880\t    _row[\"technical\"] = {\n881\t        \"modules\": [dict(m, source=_MODULES_SOURCE) for m in _MODULES_BY_SYSTEM.get(_sys_key, [])],\n882\t        \"dids\": list(_DIDS_BY_SYSTEM.get(_sys_key, [])),\n883\t        \"live_channels_with_bands\": [_live_channel_band(ch) for ch in _row[\"live_channels\"]],\n884\t        \"components\": [_component_entry(c) for c in _row[\"components\"]],\n885\t        \"codes_owned\": [],  # filled below, once _EXACT_RULES exists\n886\t    }\n887\t\n888\t\n889\tdef systems() -> dict[str, dict[str, Any]]:\n890\t    \"\"\"Every system in the graph, in reading order.\"\"\"\n891\t    return SYSTEMS\n892\t\n893\t\n894\t# --- code -> system(s) -------------------------------------------------------\n895\t\n896\t#: Generic (not vehicle-specific) SAE J2012 range-convention sources, named\n897\t#: as generic every time they are the only thing backing an assignment.\n898\t_SAE_SOURCE = (\"SAE J2012 DTC prefix/range convention (generic category, \"\n899\t              \"not vehicle-specific -- informational fallback only)\")\n900\t_SAE_SOURCE_P06 = (\"SAE J2012 P06xx range (Computer & Auxiliary Outputs -- \"\n901\t                   \"ECM/PCM internal); mapped to 'engine_management' \"\n902\t                   \"(a documented approximation, not a sourced fact)\")\n903\t_SAE_SOURCE_CHASSIS = (\"SAE J2012 C-prefix range (chassis: brakes/steering/\"\n904\t                       \"suspension); mapped to 'brakes_abs' as the default \"\n905\t                       \"chassis bucket (a documented approximation -- a \"\n906\t                       \"specific C-code may actually be steering or \"\n907\t                       \"suspension)\")\n908\t_SAE_SOURCE_BODY = \"SAE J2012 B-prefix range (body)\"\n909\t_U_CODE_SOURCE = (\"SAE J2012 U-prefix range (network/communication), \"\n910\t                  \"corroborated by mes.knowledge.match_codes' own network-\"\n911\t                  \"cascade family rule (3+ lost-communication U-codes)\")\n912\t\n913\t#: Exact-code rules, checked before any family/range fallback. Each entry's\n914\t#: ``systems`` are the PRIMARY systems for every code it lists. This is the\n915\t#: \"CODE_RULES\" table a SYSTEM's own ``technical.codes_owned`` is derived\n916\t#: from below -- never hand-duplicated, so the two can never drift apart.\n917\t_EXACT_RULES: tuple[dict[str, Any], ...] = (\n918\t    {\"codes\": (\"P0440\", \"P0441\", \"P0455\", \"P0456\", \"P0457\", \"P1CEA\"),\n919\t     \"systems\": (\"evap\",), \"confidence\": CONFIRMED,\n920\t     \"source\": (\"mes.knowledge BULLETINS (S2125000002, 9100469/9100471, \"\n921\t               \"9100468, 9100325, 18-048-23, 18-030-17) + mes.code_feel \"\n922\t               \"EVAP section\")},\n923\t    {\"codes\": (\"P0300\", \"P0301\", \"P0302\", \"P0303\", \"P0304\"),\n924\t     \"systems\": (\"ignition\", \"fuel\"), \"confidence\": CONFIRMED,\n925\t     \"source\": (\"SAE J2012 misfire-code definition (a cylinder misfire by \"\n926\t               \"definition implicates spark and fuel delivery) + \"\n927\t               \"mes.code_feel misfire fallback entry\")},\n928\t    {\"codes\": (\"P0171\", \"P0172\"),\n929\t     \"systems\": (\"fuel\", \"air_intake_boost\"), \"confidence\": CONFIRMED,\n930\t     \"source\": (\"SAE J2012 fuel-trim code definition (System Too Lean/Rich \"\n931\t               \"implicates fuel delivery and air-metering/intake leaks)\")},\n932\t    {\"codes\": (\"B1040\", \"U1700\"),\n933\t     \"systems\": (\"network\",), \"confidence\": CONFIRMED,\n934\t     \"source\": (\"mes.knowledge Bulletin S1808000005 (BCM power/comms \"\n935\t               \"cascade) -- B1040/U1700 are BCM communications codes\")},\n936\t    {\"codes\": (\"B1176\",),\n937\t     \"systems\": (\"body_comfort\",), \"confidence\": SINGLE_SOURCE,\n938\t     \"source\": \"generic body-module DTC definition (B1176); no GU/Stelvio-specific TSB found\"},\n939\t    {\"codes\": (\"C141B\", \"C141C\"),\n940\t     \"systems\": (\"adas_sensors\",), \"confidence\": SINGLE_SOURCE,\n941\t     \"source\": \"generic chassis/ADAS DTC definition (C141B/C141C); no GU/Stelvio-specific TSB found\"},\n942\t    {\"codes\": (\"C104B\",),\n943\t     \"systems\": (\"brakes_abs\",), \"confidence\": SINGLE_SOURCE,\n944\t     \"source\": \"generic chassis DTC definition (C104B, ABS/ESC range); no GU/Stelvio-specific TSB found\"},\n945\t    {\"codes\": (\"P0098\", \"P00F5\", \"P105E\", \"P1189\"),\n946\t     \"systems\": (\"air_intake_boost\",), \"confidence\": CONFIRMED,\n947\t     \"source\": (\"SAE J2012 IAT2/boost-pressure sensor circuit code \"\n948\t               \"definitions (P0098/P00F5/P105E/P1189)\")},\n949\t    {\"codes\": (\"P0010\", \"P0011\", \"P0012\", \"P0013\", \"P0014\"),\n950\t     \"systems\": (\"valve_control\",), \"confidence\": CONFIRMED,\n951\t     \"source\": (\"SAE J2012 camshaft position actuator/timing code \"\n952\t               \"definitions ('A'/'B' camshaft actuator circuit and timing \"\n953\t               \"over-advanced/over-retarded) -- generic SAE definition, \"\n954\t               \"not vehicle-specific\")},\n955\t)\n956\t\n957\t#: Filled now that _EXACT_RULES exists: every system's technical.codes_owned\n958\t#: is exactly the codes _EXACT_RULES names it primary for -- derived, not\n959\t#: hand-maintained, so the two tables can never disagree.\n960\tfor _sys_key, _rule in ((s, r) for r in _EXACT_RULES for s in r[\"systems\"]):\n961\t    SYSTEMS[_sys_key][\"technical\"][\"codes_owned\"].extend(\n962\t        c for c in _rule[\"codes\"] if c not in SYSTEMS[_sys_key][\"technical\"][\"codes_owned\"])\n963\t\n964\t#: Keyword fallback for P1xxx (manufacturer-defined) codes, and for B-codes\n965\t#: (body) that need routing to a more specific body-adjacent system before\n966\t#: falling back to the generic body bucket, with no exact entry above:\n967\t#: matched against the code's own description text, never guessed from the\n968\t#: code number alone. First match wins.\n969\t_KEYWORDS: tuple[tuple[tuple[str, ...], str], ...] = (\n970\t    ((\"evap\", \"purge\", \"canister\", \"vent valve\", \"esim\"), \"evap\"),\n971\t    ((\"crankcase\",), \"pcv\"),\n972\t    ((\"multiair\", \"vvt\", \"variable valve\", \"cam phase\"), \"valve_control\"),\n973\t    ((\"turbo\", \"boost\", \"charge air\", \"supercharg\", \"map sensor\"), \"air_intake_boost\"),\n974\t    ((\"misfire\", \"ignition coil\", \"spark\"), \"ignition\"),\n975\t    ((\"airbag\", \"air bag\", \"restraint\", \"occupant restraint\"), \"restraints\"),\n976\t    ((\"headlamp\", \"headlight\", \"taillamp\", \"tail lamp\", \"turn signal\",\n977\t      \"lamp\", \"bulb\"), \"lighting\"),\n978\t    ((\"injector\", \"fuel pump\", \"fuel pressure\", \"fuel rail\", \"fuel trim\"), \"fuel\"),\n979\t    ((\"transmission\", \"shift\", \"gear ratio\", \"clutch\", \"valve body\", \"tcm\"), \"transmission_driveline\"),\n980\t    ((\"communication\", \"network\", \"can bus\", \" bus \"), \"network\"),\n981\t    ((\"battery\", \"charging system\", \"alternator\", \"voltage\"), \"electrical_supply\"),\n982\t    ((\"coolant\", \"thermostat\", \"radiator\", \"overheat\"), \"cooling\"),\n983\t    ((\"oil pressure\", \"oil level\", \"lubrication\"), \"lubrication\"),\n984\t    ((\"catalyst\", \"oxygen sensor\", \"o2 sensor\", \"exhaust\"), \"exhaust_emissions\"),\n985\t    ((\"brake\", \"abs\", \"stability\"), \"brakes_abs\"),\n986\t    ((\"steering\",), \"steering\"),\n987\t    ((\"suspension\", \"shock\", \"strut\"), \"suspension\"),\n988\t    ((\"hvac\", \"air condition\", \"blower\", \"climate\"), \"hvac\"),\n989\t    ((\"body control\", \"door module\", \"window\", \"central lock\"), \"body_comfort\"),\n990\t    ((\"camera\", \"radar\", \"lane\", \"park assist\"), \"adas_sensors\"),\n991\t)\n992\t\n993\t_KEYWORD_SOURCE = (\"description keyword match (manufacturer P1xxx code, or \"\n994\t                   \"a B-code, with no exact entry); the keyword list itself \"\n995\t                   \"is this module's own best-effort mapping, not an \"\n996\t                   \"external citation -- treat as a lead\")\n997\t\n998\t\n999\tdef _keyword_system(description: str) -> Optional[str]:\n1000\t    d = (description or \"\").lower()\n1001\t    if not d:\n1002\t        return None\n1003\t    for keywords, sys_key in _KEYWORDS:\n1004\t        if any(k in d for k in keywords):\n1005\t            return sys_key\n1006\t    return None\n1007\t\n1008\t\n1009\tdef _sae_fallback(base: str) -> Optional[dict[str, Any]]:\n1010\t    \"\"\"The SAE J2012 prefix/range convention, as a generic last resort.\"\"\"\n1011\t    if len(base) < 3:\n1012\t        return None\n1013\t    letter, rest = base[0], base[1:]\n1014\t    if letter == \"P\":\n1015\t        prefix2 = rest[:2]\n1016\t        if prefix2 == \"01\":\n1017\t            return {\"systems\": (\"fuel\", \"air_intake_boost\"),\n1018\t                    \"confidence\": SINGLE_SOURCE, \"source\": _SAE_SOURCE}\n1019\t        if prefix2 == \"03\":\n1020\t            return {\"systems\": (\"ignition\",),\n1021\t                    \"confidence\": SINGLE_SOURCE, \"source\": _SAE_SOURCE}\n1022\t        if prefix2 == \"04\":\n1023\t            return {\"systems\": (\"evap\",),\n1024\t                    \"confidence\": SINGLE_SOURCE, \"source\": _SAE_SOURCE}\n1025\t        if prefix2 == \"05\":\n1026\t            return {\"systems\": (\"air_intake_boost\", \"electrical_supply\"),\n1027\t                    \"confidence\": SINGLE_SOURCE, \"source\": _SAE_SOURCE}\n1028\t        if prefix2 == \"06\":\n1029\t            return {\"systems\": (\"engine_management\",),\n1030\t                    \"confidence\": SINGLE_SOURCE, \"source\": _SAE_SOURCE_P06}\n1031\t        if prefix2 in (\"07\", \"08\", \"09\"):\n1032\t            return {\"systems\": (\"transmission_driveline\",),\n1033\t                    \"confidence\": SINGLE_SOURCE, \"source\": _SAE_SOURCE}\n1034\t        return None\n1035\t    if letter == \"C\":\n1036\t        return {\"systems\": (\"brakes_abs\",),\n1037\t                \"confidence\": SINGLE_SOURCE, \"source\": _SAE_SOURCE_CHASSIS}\n1038\t    if letter == \"B\":\n1039\t        return {\"systems\": (\"body_comfort\",),\n1040\t                \"confidence\": SINGLE_SOURCE, \"source\": _SAE_SOURCE_BODY}\n1041\t    if letter == \"U\":\n1042\t        return {\"systems\": (\"network\",),\n1043\t                \"confidence\": CORROBORATED, \"source\": _U_CODE_SOURCE}\n1044\t    return None\n1045\t\n1046\t\n1047\tdef systems_for_code(code: str, description: str = \"\") -> list[dict[str, Any]]:\n1048\t    \"\"\"Every system this code implicates: primaries first, then whatever\n1049\t    systems the primaries' own ``depends_on`` names as upstream.\n1050\t\n1051\t    Resolution order: exact-code table, then \"any U-code is network\" (a\n1052\t    family rule, not a guess -- see ``_U_CODE_SOURCE``), then a P1xxx or\n1053\t    B-code description-keyword match, then the generic SAE range fallback,\n1054\t    then give up honestly (one ``UNKNOWN`` row naming no system).\n1055\t\n1056\t    A code's primary system(s) automatically pull in their declared\n1057\t    ``depends_on`` edges as ``role=\"upstream\"`` rows, so (for example) every\n1058\t    EVAP code always carries electrical_supply and fuel upstream without\n1059\t    that having to be hand-maintained per code here too.\n1060\t    \"\"\"\n1061\t    base = base_code(code)\n1062\t    primaries: list[tuple[Optional[str], str, str]] = []  # (system, confidence, source)\n1063\t\n1064\t    matched = False\n1065\t    for rule in _EXACT_RULES:\n1066\t        if base in rule[\"codes\"]:\n1067\t            for sys_key in rule[\"systems\"]:\n1068\t                primaries.append((sys_key, rule[\"confidence\"], rule[\"source\"]))\n1069\t            matched = True\n1070\t            break\n1071\t\n1072\t    if not matched and base.startswith(\"U\"):\n1073\t        primaries.append((\"network\", CORROBORATED, _U_CODE_SOURCE))\n1074\t        matched = True\n1075\t\n1076\t    if not matched and (base.startswith(\"P1\") or base.startswith(\"B\")):\n1077\t        sys_key = _keyword_system(description)\n1078\t        if sys_key:\n1079\t            primaries.append((sys_key, SINGLE_SOURCE, _KEYWORD_SOURCE))\n1080\t            matched = True\n1081\t\n1082\t    if not matched:\n1083\t        fb = _sae_fallback(base)\n1084\t        if fb:\n1085\t            for sys_key in fb[\"systems\"]:\n1086\t                primaries.append((sys_key, fb[\"confidence\"], fb[\"source\"]))\n1087\t            matched = True\n1088\t\n1089\t    out: list[dict[str, Any]] = []\n1090\t    seen: set[str] = set()\n1091\t    if not matched:\n1092\t        out.append({\"system\": \"UNKNOWN\", \"role\": \"primary\",\n1093\t                   \"confidence\": UNKNOWN, \"source\": _UNKNOWN_NOTE})\n1094\t        return out\n1095\t\n1096\t    for sys_key, confidence, source in primaries:\n1097\t        if sys_key in seen:\n1098\t            continue\n1099\t        seen.add(sys_key)\n1100\t        out.append({\"system\": sys_key, \"role\": \"primary\",\n1101\t                   \"confidence\": confidence, \"source\": source})\n1102\t\n1103\t    for sys_key, _conf, _src in primaries:\n1104\t        sys_def = SYSTEMS.get(sys_key)\n1105\t        if sys_def is None:\n1106\t            continue\n1107\t        for dep in sys_def[\"depends_on\"]:\n1108\t            if dep[\"system\"] in seen:\n1109\t                continue\n1110\t            seen.add(dep[\"system\"])\n1111\t            out.append({\"system\": dep[\"system\"], \"role\": \"upstream\",\n1112\t                       \"confidence\": dep[\"confidence\"], \"source\": dep[\"source\"]})\n1113\t    return out\n1114\t\n1115\t\n1116\tdef _primary_systems(code: str, description: str = \"\") -> list[str]:\n1117\t    return [e[\"system\"] for e in systems_for_code(code, description)\n1118\t            if e[\"role\"] == \"primary\" and e[\"system\"] != \"UNKNOWN\"]\n1119\t\n1120\t\n1121\t# --- corpus correlation -----------------------------------------------------\n1122\t\n1123\tdef correlate(vin: str) -> dict[str, Any]:\n1124\t    \"\"\"Project one vehicle's whole DTC corpus onto the system graph.\n1125\t\n1126\t    Built from :func:`mes.analysis.dtc_history` (the same per-occurrence\n1127\t    file/timestamp data :func:`mes.workup.build` uses) plus\n1128\t    ``mes.workup.build`` itself for the current-picture open codes and the\n1129\t    latest clear assessment, used only to classify each system's\n1130\t    ``status``. Simulation logs are excluded (``dtc_history``'s default).\n1131\t\n1132\t    Returns ``{\"error\": ...}`` if no logs match this VIN -- never a\n1133\t    half-empty dossier.\n1134\t    \"\"\"\n1135\t    from . import analysis, workup as workup_mod\n1136\t\n1137\t    history = analysis.dtc_history(vin=vin)\n1138\t    if not history:\n1139\t        return {\"error\": \"no logs match\", \"vin\": vin}\n1140\t\n1141\t    primary_map: dict[str, list[str]] = {}\n1142\t    for code, rec in history.items():\n1143\t        descr = rec.descriptions[0] if rec.descriptions else \"\"\n1144\t        primary_map[code] = _primary_systems(code, descr)\n1145\t\n1146\t    # --- per-session (per-file) system sets ---------------------------------\n1147\t    session_codes: dict[str, set[str]] = {}\n1148\t    for code, rec in history.items():\n1149\t        for occ in rec.occurrences:\n1150\t            fname = occ.get(\"file\")\n1151\t            if not fname:\n1152\t                continue\n1153\t            session_codes.setdefault(fname, set()).add(code)\n1154\t    session_systems: dict[str, set[str]] = {\n1155\t        fname: {s for c in codes for s in primary_map.get(c, [])}\n1156\t        for fname, codes in session_codes.items()\n1157\t    }\n1158\t    total_sessions = len(session_systems)\n1159\t\n1160\t    # --- current picture, for status classification only -------------------\n1161\t    try:\n1162\t        dossier = workup_mod.build(vin=vin)\n1163\t    except Exception:  # noqa: BLE001 -- status is a nice-to-have, never fatal\n1164\t        dossier = {}\n1165\t    cp = dossier.get(\"current_picture\", {}) if isinstance(dossier, dict) else {}\n1166\t    latest = cp.get(\"latest_session\") or {}\n1167\t    open_codes = {d.get(\"dtc\") for d in latest.get(\"dtcs\", []) if d.get(\"dtc\")}\n1168\t    clear = cp.get(\"clear_assessment\") or {}\n1169\t    cleared_codes = set(clear.get(\"codes_cleared\") or [])\n1170\t\n1171\t    # --- by_system -----------------------------------------------------------\n1172\t    by_system: list[dict[str, Any]] = []\n1173\t    for sys_key in SYSTEMS:\n1174\t        codes_here = sorted(c for c, syss in primary_map.items() if sys_key in syss)\n1175\t        if not codes_here:\n1176\t            by_system.append({\"system\": sys_key, \"codes\": [], \"sessions\": 0,\n1177\t                              \"first\": None, \"last\": None, \"status\": \"clean\"})\n1178\t            continue\n1179\t        sessions_here = sum(1 for syss in session_systems.values() if sys_key in syss)\n1180\t        firsts = [history[c].first_seen for c in codes_here if history[c].first_seen]\n1181\t        lasts = [history[c].last_seen for c in codes_here if history[c].last_seen]\n1182\t        if open_codes & set(codes_here):\n1183\t            status = \"active\"\n1184\t        elif cleared_codes & set(codes_here):\n1185\t            status = \"cleared_unverified\"\n1186\t        else:\n1187\t            status = \"stale\"\n1188\t        by_system.append({\n1189\t            \"system\": sys_key, \"codes\": codes_here, \"sessions\": sessions_here,\n1190\t            \"first\": min(firsts) if firsts else None,\n1191\t            \"last\": max(lasts) if lasts else None,\n1192\t            \"status\": status,\n1193\t        })\n1194\t\n1195\t    # --- co-occurrence, pairs with >= 2 shared sessions only ----------------\n1196\t    active = [row[\"system\"] for row in by_system if row[\"sessions\"] > 0]\n1197\t    co_occurrence: list[dict[str, Any]] = []\n1198\t    for i, a in enumerate(active):\n1199\t        for b in active[i + 1:]:\n1200\t            sessions_a = sum(1 for syss in session_systems.values() if a in syss)\n1201\t            sessions_b = sum(1 for syss in session_systems.values() if b in syss)\n1202\t            together = sum(1 for syss in session_systems.values()\n1203\t                           if a in syss and b in syss)\n1204\t            if together < 2:\n1205\t                continue\n1206\t            expected = (sessions_a * sessions_b) / total_sessions if total_sessions else 0\n1207\t            lift = round(together / expected, 2) if expected else None\n1208\t            label_a, label_b = SYSTEMS[a][\"label\"], SYSTEMS[b][\"label\"]\n1209\t            reading = (\n1210\t                f\"{label_a} and {label_b} codes appeared together in \"\n1211\t                f\"{together} of {total_sessions} session(s) ({sessions_a} had \"\n1212\t                f\"{label_a} codes, {sessions_b} had {label_b} codes); lift \"\n1213\t                f\"{lift if lift is not None else 'n/a'} -- correlation only, \"\n1214\t                \"could point at a shared cause or be coincidental overlap.\"\n1215\t            )\n1216\t            co_occurrence.append({\"a\": a, \"b\": b, \"sessions_together\": together,\n1217\t                                   \"sessions_a\": sessions_a, \"sessions_b\": sessions_b,\n1218\t                                   \"lift\": lift, \"reading\": reading})\n1219\t\n1220\t    # --- chains: depends_on edges, with corpus evidence where it exists ------\n1221\t    chains: list[dict[str, Any]] = []\n1222\t    for row in by_system:\n1223\t        sys_key = row[\"system\"]\n1224\t        if row[\"sessions\"] == 0:\n1225\t            continue\n1226\t        deps = SYSTEMS[sys_key][\"depends_on\"]\n1227\t        if not deps:\n1228\t            continue\n1229\t        possible_upstream = []\n1230\t        for dep in deps:\n1231\t            evidence = None\n1232\t            for co in co_occurrence:\n1233\t                if {co[\"a\"], co[\"b\"]} == {sys_key, dep[\"system\"]}:\n1234\t                    evidence = (f\"{co['sessions_together']} of {total_sessions} \"\n1235\t                               f\"session(s) with {SYSTEMS[sys_key]['label']} codes \"\n1236\t                               f\"also carried {SYSTEMS[dep['system']]['label']} \"\n1237\t                               f\"codes (lift {co['lift']}) -- could be upstream, \"\n1238\t                               \"not proven.\")\n1239\t                    break\n1240\t            possible_upstream.append({\"system\": dep[\"system\"], \"why\": dep[\"why\"],\n1241\t                                      \"evidence\": evidence})\n1242\t        chains.append({\"issue\": f\"{SYSTEMS[sys_key]['label']} codes\",\n1243\t                       \"possible_upstream\": possible_upstream})\n1244\t\n1245\t    # --- findings, plain dated sentences -------------------------------------\n1246\t    today = date.today().isoformat()\n1247\t    findings: list[str] = []\n1248\t    for row in by_system:\n1249\t        if row[\"sessions\"] == 0:\n1250\t            continue\n1251\t        findings.append(\n1252\t            f\"{today}: {SYSTEMS[row['system']]['label']} shows \"\n1253\t            f\"{len(row['codes'])} code(s) across {row['sessions']} \"\n1254\t            f\"session(s) ({row['first']} to {row['last']}), status={row['status']}.\"\n1255\t        )\n1256\t    for co in co_occurrence:\n1257\t        findings.append(f\"{today}: {co['reading']}\")\n1258\t    if not findings:\n1259\t        findings.append(f\"{today}: no DTCs found for {vin} across the corpus.\")\n1260\t\n1261\t    return {\n1262\t        \"vin\": vin,\n1263\t        \"by_system\": by_system,\n1264\t        \"co_occurrence\": co_occurrence,\n1265\t        \"chains\": chains,\n1266\t        \"findings\": findings,\n1267\t    }\n1268\t\n1269\t\n1270\t__all__ = [\"SYSTEMS\", \"systems\", \"systems_for_code\", \"correlate\", \"base_code\",\n1271\t           \"CONFIRMED\", \"CORROBORATED\", \"SINGLE_SOURCE\", \"UNKNOWN\"]\n1272\t"}]},"uuid":"7edbdc27-a686-41f7-814e-3d7c4b0de1a3","timestamp":"2026-10-08T20:22:58.692Z","toolUseResult":{"type":"text","file":{"filePath":"C:\\Users\\User\\mcp-servers\\mes-log-mcp\\mes\\systems.py","content":"\"\"\"Vehicle SYSTEMS as a correlational dimension, cutting across every DTC.\n\nA code lookup answers \"what fault is this\"; it does not answer \"what else on\nthis car shares a cause with it\". This module adds that second axis: every\nDTC is assigned to one or more ordered vehicle systems (``SYSTEMS``), with a\n``depends_on`` graph recording which systems are documented as upstream of\nwhich others (a BCM supply fault cascading into network U-codes, an EVAP\nleak code that can trace back to the fuel tank/cap it shares with the fuel\nsystem). ``mes.workup``/``mes.analysis`` already answer \"what DTCs happened,\nwhen, together\" per vehicle; :func:`correlate` reuses that corpus data and\nprojects it onto the system graph.\n\nNothing here is invented. Every ``depends_on`` edge and every exact-code\nsystem assignment carries a ``source`` -- either a citation (this project's\nown ``mes.knowledge`` TSB table, ``mes.code_feel``, ``mes.parts``, or the\ngeneric SAE J2012 DTC-prefix convention, named as generic every time it is\nused) or, for a relationship nobody has sourced, ``confidence=\"UNKNOWN\"``\nwith a note pointing at the service manual -- never a silently guessed\ndependency. :func:`correlate` is equally careful with its own output: it\nnever asserts a dependency is *proven*, only that the corpus shows two\nsystems' codes appearing together, worded as \"could be upstream\", with the\nsession counts that back (or don't back) that reading.\n\nEvery ``depends_on`` edge also carries a ``technical`` dict (``carries``,\n``path``, ``bus``, ``measure``, ``propagates``, ``tsb_refs``) -- the\nelectrical/physical mechanism behind the edge, not just the prose ``why``.\n``carries``/``propagates`` are mandatory on every edge (what actually flows,\nand what the failure looks like downstream); ``path`` (element ids from\n``mes.electrical``/``mes.layout_systems``), ``bus`` (name/speed from\n``cuore.live.buses``) and ``measure`` (a concrete test point, with a\nnumeric ``limit`` only when a TSB actually states one -- otherwise\n``\"UNKNOWN (TechAuthority)\"``) are included only where this repo's own\nsourced data supports them. Each SYSTEM also carries a ``technical`` dict\n(``modules``, ``dids``, ``live_channels_with_bands``, ``components``,\n``codes_owned``) -- same house rule: every value cites a source and\nconfidence, or says ``UNKNOWN`` and points at the service manual.\n\nConfidence levels (same scale as the rest of this package):\n\n* ``CONFIRMED``     -- stated in this repo's own sourced table (an FCA/Alfa\n                       TSB in ``mes.knowledge``, or a documented part/DTC\n                       definition) or the DTC's own SAE-defined meaning\n                       (e.g. a P0300-04 misfire code by definition implicates\n                       ignition and fuel delivery).\n* ``CORROBORATED``  -- two independent sourced findings agree (e.g. the\n                       U-code -> network assignment: SAE's communication-DTC\n                       range, corroborated by ``mes.knowledge.match_codes``'\n                       own network-cascade family rule).\n* ``SINGLE-SOURCE``  -- one source, or a generic SAE range convention used as\n                       a last-resort, explicitly generic fallback.\n* ``UNKNOWN``       -- no sourced relationship found; recorded as such\n                       rather than guessed.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport re\nfrom datetime import date\nfrom typing import Any, Optional\n\nCONFIRMED = \"CONFIRMED\"\nCORROBORATED = \"CORROBORATED\"\nSINGLE_SOURCE = \"SINGLE-SOURCE\"\nUNKNOWN = \"UNKNOWN\"\n\nCONFIDENCE_LEVELS = (CONFIRMED, CORROBORATED, SINGLE_SOURCE, UNKNOWN)\n\n#: Same wording as ``mes.code_feel``/``mes.parts``/``mes.maintenance_specs``,\n#: so an UNKNOWN confidence always reads the same way across this package.\n_UNKNOWN_NOTE = \"not established in any source checked -- use the service manual (TechAuthority)\"\n\n#: Same note, for a ``technical.measure.limit`` with no TSB-stated number.\n_UNKNOWN_LIMIT = \"UNKNOWN (TechAuthority)\"\n\n#: Strip the failure-type byte: \"P0456-00\" -> \"P0456\". Mirrors\n#: ``mes.knowledge.base_code`` / ``mes.code_feel.base_code``, reimplemented\n#: here rather than imported so this module stays a standalone lookup table.\n_BASE_RE = re.compile(r\"^([PBCU][0-9A-F]{4})\", re.IGNORECASE)\n\n\ndef base_code(code: str) -> str:\n    m = _BASE_RE.match((code or \"\").strip().upper())\n    return m.group(1) if m else (code or \"\").strip().upper()\n\n\n# --- the system graph -------------------------------------------------------\n\ndef _tech(carries: str, propagates: str, *,\n          path: Optional[list[str]] = None,\n          bus: Optional[dict[str, Any]] = None,\n          measure: Optional[dict[str, Any]] = None,\n          tsb_refs: Optional[list[str]] = None) -> dict[str, Any]:\n    \"\"\"One ``depends_on`` edge's technical detail. ``carries`` (what flows:\n    \"12 V supply\", \"ground\", \"CAN data\", \"vacuum\", \"oil pressure\", ...) and\n    ``propagates`` (a plain sentence of the failure mode) are mandatory on\n    every edge. ``path`` (element ids from :mod:`mes.electrical`/\n    :mod:`mes.layout_systems`), ``bus`` ({\"name\", \"speed\", ...}, from\n    :mod:`cuore.live.buses`) and ``measure`` ({\"what\", \"where\", \"limit\",\n    \"source\", \"confidence\"}) are included only where this repo's own\n    sourced data supports them -- never invented to fill the shape.\"\"\"\n    out: dict[str, Any] = {\"carries\": carries, \"propagates\": propagates}\n    if path:\n        out[\"path\"] = list(path)\n    if bus:\n        out[\"bus\"] = dict(bus)\n    if measure:\n        out[\"measure\"] = dict(measure)\n    if tsb_refs:\n        out[\"tsb_refs\"] = list(tsb_refs)\n    return out\n\n\ndef _dep(system: str, why: str, confidence: str, source: Optional[str] = None,\n         technical: Optional[dict[str, Any]] = None) -> dict[str, Any]:\n    \"\"\"One ``depends_on`` edge. Enforces the house rule at definition time:\n    a non-UNKNOWN confidence must carry a real citation; an UNKNOWN one gets\n    the standard note if the caller didn't supply one. ``technical`` (built\n    with :func:`_tech`) is required -- every edge must say what it carries\n    and how it propagates, even when that is all that's known.\"\"\"\n    if confidence not in CONFIDENCE_LEVELS:\n        raise ValueError(f\"bad confidence {confidence!r}\")\n    if confidence == UNKNOWN and not source:\n        source = _UNKNOWN_NOTE\n    if not source:\n        raise ValueError(f\"dependency on {system!r} has no source -- \"\n                          \"mark confidence UNKNOWN or cite one\")\n    if not technical or \"carries\" not in technical or \"propagates\" not in technical:\n        raise ValueError(f\"dependency on {system!r} has no technical \"\n                          \"dict with carries/propagates\")\n    return {\"system\": system, \"why\": why, \"confidence\": confidence,\n            \"source\": source, \"technical\": technical}\n\n\ndef _system(key: str, label: str, components: list[str], *,\n            live_channels: Optional[list[str]] = None,\n            maintenance_items: Optional[list[str]] = None,\n            parts: Optional[list[str]] = None,\n            depends_on: Optional[list[dict[str, Any]]] = None) -> dict[str, Any]:\n    return {\n        \"key\": key,\n        \"label\": label,\n        \"components\": list(components),\n        \"live_channels\": list(live_channels or []),\n        \"maintenance_items\": list(maintenance_items or []),\n        \"parts\": list(parts or []),\n        \"depends_on\": list(depends_on or []),\n    }\n\n\n#: Sources reused by several edges below, named once.\n_S1808000005 = \"mes.knowledge Bulletin S1808000005 (BCM power-feed/fuse F82 cascade into U-codes)\"\n_S2008000032 = \"mes.knowledge Bulletin S2008000032 (connector XY201 / grounds G003A-B multi-module cascade)\"\n_S1708000262 = \"mes.knowledge Bulletin S1708000262 REV. A (intermittent CAN-private/LIN codes -- spread terminals)\"\n_S2308000004 = \"mes.knowledge Bulletin S2308000004 (cranks/no-start -- verify ECM/PCM B+ feeds and grounds)\"\n_S2008000078 = \"mes.knowledge Bulletin S2008000078 REV. A (U0102 on RWD is a software/config fault, not a bus fault)\"\n_S1821000001 = \"mes.knowledge Bulletin S1821000001 REV. A (AWD tyre-circumference mismatch causes driveline shudder)\"\n_EVAP_SOURCES = (\"mes.parts esim/purge_valve (ECM-commanded solenoid/pump) + \"\n                 \"mes.code_feel EVAP section + mes.knowledge EVAP bulletins \"\n                 \"(S2125000002, 9100469/9100471, 18-030-17)\")\n_EVAP_FUEL_SOURCES = (\"mes.code_feel EVAP section + carparts.com/fs1inc.com P0455/P0456 \"\n                      \"writeups (EVAP shares the tank, fuel cap and fuel-level/pressure \"\n                      \"signal path with the fuel system)\")\n_RFHUB_SOURCE = (\"mes.electrical 'rfhub_module' entry (network address CONFIRMED \"\n                 \"and documented to carry TPMS data, per GIORGIO_MODULE_MAP.md; \"\n                 \"module identity as RFHUB itself is INFERRED, per that same entry)\")\n\n#: Electrical-path element ids, as named in mes.electrical.ELEMENTS, reused\n#: here only as plain string references (never re-derived) for depends_on\n#: edges whose path a sourced TSB actually spells out.\n_BCM_SUPPLY_PATH = [\"bcm\", \"f82\", \"bcm_feed_20a\"]\n_BCM_CONNECTOR_GROUND_PATH = [\"xy201\", \"g003a\", \"g003b\"]\n_BCM_FULL_PATH = _BCM_SUPPLY_PATH + _BCM_CONNECTOR_GROUND_PATH\n\n#: cuore.live.buses facts, restated as plain data (never imported -- this\n#: module stays standalone) so a depends_on edge's ``bus`` field can cite\n#: the actual pins/bitrate/confidence cuore.live.buses.py sources.\n_BUS_CAN_C = {\"name\": \"CAN-C\", \"speed\": \"500 kbit/s\", \"pins\": \"6/14\",\n              \"confidence\": \"confirmed\", \"source\": \"cuore.live.buses CAN_C\"}\n_BUS_CAN_IHS = {\"name\": \"CAN-IHS\", \"speed\": \"125 kbit/s\", \"pins\": \"3/11\",\n                \"confidence\": \"confirmed\", \"source\": \"cuore.live.buses CAN_IHS\"}\n_BUS_CAN_CH = {\"name\": \"CAN-CH\", \"speed\": \"500 kbit/s (inferred)\", \"pins\": \"12/13\",\n               \"confidence\": \"inferred\", \"source\": \"cuore.live.buses CAN_CH\"}\n\n#: Ordered as given: the \"natural\" reading order for a dossier, roughly\n#: supply -> network -> the engine's own systems -> driveline -> chassis ->\n#: comfort/sensor/HVAC extras.\nSYSTEMS: dict[str, dict[str, Any]] = {\n    \"electrical_supply\": _system(\n        \"electrical_supply\", \"Electrical supply\",\n        [\"12V battery\", \"alternator\", \"chassis/engine grounds\", \"fuses\",\n         \"BCM power feeds\"],\n        live_channels=[\"battery_voltage\"],\n        maintenance_items=[\"battery_12v\"],\n        parts=[\"battery_12v\"],\n        depends_on=[],\n    ),\n    \"network\": _system(\n        \"network\", \"Network / CAN buses\",\n        [\"CAN-C\", \"CAN-IHS\", \"CAN-CH\", \"gateway modules\", \"BCM\"],\n        live_channels=[],\n        maintenance_items=[],\n        parts=[],\n        depends_on=[\n            _dep(\"electrical_supply\",\n                 \"BCM power feeds and chassis grounds are a documented root \"\n                 \"cause of multi-module U-code cascades, not per-module bus \"\n                 \"faults.\",\n                 CONFIRMED, f\"{_S1808000005}; {_S2008000032}; {_S1708000262}\",\n                 technical=_tech(\n                     \"12 V supply\",\n                     \"Low supply voltage at the BCM makes several modules \"\n                     \"drop off CAN at once: U-codes on many modules \"\n                     \"simultaneously, not one module's own bus fault.\",\n                     path=_BCM_FULL_PATH,\n                     measure={\"what\": \"voltage drop\", \"where\": \"G003A to battery negative\",\n                              \"limit\": _UNKNOWN_LIMIT, \"source\": \"S2008000032\",\n                              \"confidence\": SINGLE_SOURCE},\n                     tsb_refs=[\"S1808000005\", \"S2008000032\", \"S1708000262\"],\n                 )),\n        ],\n    ),\n    \"ignition\": _system(\n        \"ignition\", \"Ignition\",\n        [\"spark plugs\", \"ignition coils\", \"crank/cam position sensors\"],\n        live_channels=[\"engine_rpm\"],\n        maintenance_items=[\"spark_plugs\", \"ignition_coils_inspect\"],\n        parts=[\"spark_plug\", \"ignition_coil\"],\n        depends_on=[\n            _dep(\"electrical_supply\",\n                 \"Coils and the igniter driver need a stable B+ supply; a \"\n                 \"no-start/cranks-only complaint is diagnosed by verifying \"\n                 \"ECM/PCM B+ feeds and grounds before suspecting ignition \"\n                 \"parts.\",\n                 CONFIRMED, _S2308000004,\n                 technical=_tech(\n                     \"12 V supply\",\n                     \"A weak ECM/PCM B+ feed or ground starves the coil \"\n                     \"driver circuit: cranks-but-no-start, or random \"\n                     \"misfire codes, rather than a single bad coil.\",\n                     measure={\"what\": \"voltage drop\", \"where\": \"ECM/PCM B+ feed to battery positive\",\n                              \"limit\": _UNKNOWN_LIMIT, \"source\": \"S2308000004\",\n                              \"confidence\": SINGLE_SOURCE},\n                     tsb_refs=[\"S2308000004\"],\n                 )),\n        ],\n    ),\n    \"fuel\": _system(\n        \"fuel\", \"Fuel\",\n        [\"fuel tank\", \"fuel pump\", \"fuel pressure sensor\", \"fuel filter\",\n         \"injectors\", \"fuel cap\"],\n        live_channels=[\"fuel_level\"],\n        maintenance_items=[\"fuel_filter\"],\n        parts=[],\n        depends_on=[\n            _dep(\"electrical_supply\",\n                 \"The fuel pump and injectors are electrically driven, so a \"\n                 \"weak supply/ground can present as a fuel-delivery fault.\",\n                 UNKNOWN,\n                 technical=_tech(\n                     \"12 V supply\",\n                     \"A weak supply/ground to the fuel pump driver can look \"\n                     \"like a fuel-delivery fault (lean/rich trim codes) \"\n                     \"rather than a pump or injector failure.\",\n                 )),\n        ],\n    ),\n    \"evap\": _system(\n        \"evap\", \"EVAP (evaporative emissions)\",\n        [\"ESIM\", \"purge valve\", \"canister\", \"vent valve\", \"fuel cap\",\n         \"vapor lines\", \"recirculation-line quick-connect\"],\n        live_channels=[\"commanded_evap_purge\", \"evap_vapor_pressure\",\n                      \"evap_vapor_pressure_abs\", \"fuel_level\"],\n        maintenance_items=[],\n        parts=[\"esim\", \"purge_valve\", \"evap_canister\", \"evap_quick_connect\"],\n        depends_on=[\n            _dep(\"electrical_supply\",\n                 \"The ESIM and purge valve are ECM-commanded electrical \"\n                 \"components (a leak-detection pump and a solenoid); a weak \"\n                 \"supply/ground can disrupt the self-test they rely on.\",\n                 SINGLE_SOURCE, _EVAP_SOURCES,\n                 technical=_tech(\n                     \"12 V supply\",\n                     \"A weak supply/ground to the ESIM or purge-valve \"\n                     \"solenoid disrupts the EVAP self-test, setting a leak \"\n                     \"code (P0440/P0455/P0456) even with no actual leak.\",\n                     path=[\"esim_connector\", \"esim_ground\"],\n                 )),\n            _dep(\"fuel\",\n                 \"EVAP shares the tank, fuel cap and fuel-level/pressure \"\n                 \"signal path with the fuel system; a fuel-cap or tank-side \"\n                 \"fault can present as an EVAP leak code.\",\n                 CORROBORATED, _EVAP_FUEL_SOURCES,\n                 technical=_tech(\n                     \"fuel vapor pressure\",\n                     \"A loose fuel cap or tank-side fault changes vapor \"\n                     \"pressure the ESIM reads, setting an EVAP leak code \"\n                     \"that is really a fuel-side mechanical issue.\",\n                 )),\n        ],\n    ),\n    \"air_intake_boost\": _system(\n        \"air_intake_boost\", \"Air intake / boost\",\n        [\"intake tract\", \"MAP sensor\", \"turbocharger\", \"intercooler\",\n         \"boost hoses\", \"throttle body\"],\n        live_channels=[\"intake_map\", \"barometric_pressure\", \"boost\",\n                      \"ecm_195a\", \"intake_air_temp\", \"absolute_load\",\n                      \"throttle_position\"],\n        maintenance_items=[\"engine_air_filter\", \"throttle_body_clean\",\n                           \"intake_boost_hoses_inspect\"],\n        parts=[\"engine_air_filter\", \"turbo_intercooler_hose\"],\n        depends_on=[\n            _dep(\"exhaust_emissions\",\n                 \"The turbocharger is driven by exhaust gas, so an \"\n                 \"exhaust-side restriction or a failing turbo housing can \"\n                 \"present as a boost/MAP-sensor fault.\",\n                 SINGLE_SOURCE,\n                 \"general turbocharger architecture (exhaust-driven turbine) \"\n                 \"-- no GU/Stelvio-specific TSB citation found\",\n                 technical=_tech(\n                     \"exhaust gas\",\n                     \"An exhaust-side restriction or failing turbo housing \"\n                     \"shows up as low boost / a MAP-sensor plausibility \"\n                     \"code, not a boost-circuit electrical fault.\",\n                 )),\n        ],\n    ),\n    \"cooling\": _system(\n        \"cooling\", \"Cooling\",\n        [\"radiator\", \"coolant\", \"water pump\", \"thermostat\", \"cooling fan\"],\n        live_channels=[\"engine_coolant_temp\"],\n        maintenance_items=[\"coolant\"],\n        parts=[\"coolant\"],\n        depends_on=[],\n    ),\n    \"lubrication\": _system(\n        \"lubrication\", \"Lubrication (oil)\",\n        [\"oil pump\", \"oil filter\", \"oil pressure/level sensors\"],\n        live_channels=[\"engine_oil_temp\"],\n        maintenance_items=[],\n        parts=[\"engine_oil\", \"oil_filter\", \"drain_plug_gasket\"],\n        depends_on=[],\n    ),\n    \"exhaust_emissions\": _system(\n        \"exhaust_emissions\", \"Exhaust / emissions\",\n        [\"catalytic converter\", \"O2 sensors\", \"exhaust manifold\",\n         \"turbo exhaust housing\"],\n        live_channels=[],\n        maintenance_items=[],\n        parts=[],\n        depends_on=[\n            _dep(\"ignition\",\n                 \"A misfire dumps unburned fuel into the exhaust and can \"\n                 \"set secondary catalyst/O2 codes.\",\n                 SINGLE_SOURCE,\n                 \"general emissions-system architecture -- no GU/Stelvio-\"\n                 \"specific TSB citation found\",\n                 technical=_tech(\n                     \"unburned fuel / combustion gas\",\n                     \"A misfire dumps unburned fuel into the exhaust, \"\n                     \"overheating and fouling the catalyst/O2 sensors: a \"\n                     \"secondary catalyst-efficiency code that traces back \"\n                     \"to the ignition-side misfire, not the catalyst.\",\n                 )),\n        ],\n    ),\n    \"transmission_driveline\": _system(\n        \"transmission_driveline\", \"Transmission / driveline\",\n        [\"ZF 8HP transmission\", \"Q4 transfer case\", \"differentials\",\n         \"driveshafts\", \"valve body\"],\n        live_channels=[\"tcm_04fe\", \"tcm_0518\"],\n        maintenance_items=[],\n        parts=[\"transmission_fluid\", \"transfer_case_fluid\"],\n        depends_on=[\n            _dep(\"network\",\n                 \"U0102 'lost communication with transfer case' can be an \"\n                 \"ECM software/configuration fault (AWD software on a RWD \"\n                 \"build) rather than a transfer-case hardware or bus fault.\",\n                 CONFIRMED, _S2008000078,\n                 technical=_tech(\n                     \"CAN data\",\n                     \"An ECM software/configuration mismatch (AWD cal on a \"\n                     \"RWD build) presents as a transfer-case 'lost \"\n                     \"communication' code with no actual bus or hardware \"\n                     \"fault.\",\n                     bus=_BUS_CAN_C,\n                     tsb_refs=[\"S2008000078\"],\n                 )),\n            _dep(\"suspension\",\n                 \"Tyre circumference mismatch on AWD causes shudder/bind and \"\n                 \"can damage the transfer case; this is ruled out before any \"\n                 \"driveline hardware is condemned.\",\n                 CONFIRMED, _S1821000001,\n                 technical=_tech(\n                     \"driveline mechanical coupling\",\n                     \"A tyre-circumference mismatch on AWD binds the \"\n                     \"driveline, presenting as a transfer-case shudder/\"\n                     \"damage complaint that is actually a tire/suspension \"\n                     \"issue.\",\n                     tsb_refs=[\"S1821000001\"],\n                 )),\n        ],\n    ),\n    \"brakes_abs\": _system(\n        \"brakes_abs\", \"Brakes / ABS\",\n        [\"brake pads\", \"rotors\", \"calipers\", \"ABS/ESC modulator\",\n         \"wheel speed sensors\", \"EPB\"],\n        live_channels=[],\n        maintenance_items=[\"brake_fluid\"],\n        parts=[\"brake_pads_front\", \"brake_pads_rear\", \"brake_rotor_front\",\n              \"brake_rotor_rear\", \"brake_fluid\"],\n        depends_on=[\n            _dep(\"electrical_supply\",\n                 \"The ABS/ESC modulator and wheel-speed sensors are \"\n                 \"electrically supplied module hardware, like the other \"\n                 \"modules that cascade from a BCM supply fault.\",\n                 UNKNOWN,\n                 technical=_tech(\n                     \"12 V supply\",\n                     \"A weak supply/ground to the ABS/ESC modulator could \"\n                     \"present as a brake-system module fault, like other \"\n                     \"modules that cascade from a BCM supply fault -- not \"\n                     \"corroborated for this module specifically.\",\n                 )),\n        ],\n    ),\n    \"steering\": _system(\n        \"steering\", \"Steering\",\n        [\"EPS motor/rack\", \"steering angle sensor\", \"steering column\"],\n        live_channels=[],\n        maintenance_items=[\"power_steering\"],\n        parts=[],\n        depends_on=[\n            _dep(\"electrical_supply\",\n                 \"EPS is an electrically driven power-steering system; a \"\n                 \"weak supply affects assist.\",\n                 UNKNOWN,\n                 technical=_tech(\n                     \"12 V supply\",\n                     \"A weak supply to the EPS motor/rack reduces or drops \"\n                     \"power-assist, presenting as a steering-effort \"\n                     \"complaint rather than a rack/motor failure.\",\n                 )),\n        ],\n    ),\n    \"suspension\": _system(\n        \"suspension\", \"Suspension\",\n        [\"shocks/struts\", \"springs\", \"control arms\", \"bushings\",\n         \"tires/wheels\"],\n        live_channels=[],\n        maintenance_items=[],\n        parts=[\"tpms_sensor\"],\n        depends_on=[],\n    ),\n    \"body_comfort\": _system(\n        \"body_comfort\", \"Body / comfort\",\n        [\"BCM\", \"door/window modules\", \"central locking\",\n         \"interior lighting\", \"wipers\"],\n        live_channels=[],\n        maintenance_items=[\"wipers\", \"hood_and_door_lubrication\"],\n        parts=[\"wiper_blades\"],\n        depends_on=[\n            _dep(\"network\",\n                 \"Most body-module codes gateway through the BCM onto the \"\n                 \"vehicle's CAN/LIN buses; an intermittent bus/terminal \"\n                 \"fault can present as a body-module fault.\",\n                 SINGLE_SOURCE, _S1708000262,\n                 technical=_tech(\n                     \"CAN data\",\n                     \"An intermittent bus/terminal fault on the gatewayed \"\n                     \"buses presents as a body-module (door/window/\"\n                     \"locking) fault rather than a bus fault.\",\n                     bus=_BUS_CAN_IHS,\n                     tsb_refs=[\"S1708000262\"],\n                 )),\n            _dep(\"electrical_supply\",\n                 \"BCM supply-side faults (e.g. fuse F82) are documented to \"\n                 \"cascade into multiple module/body symptoms.\",\n                 CONFIRMED, _S1808000005,\n                 technical=_tech(\n                     \"12 V supply\",\n                     \"A BCM supply-side fault (fuse F82) cascades into \"\n                     \"multiple body-module symptoms at once (locks, \"\n                     \"windows, lighting) rather than one module failing.\",\n                     path=_BCM_SUPPLY_PATH,\n                     measure={\"what\": \"voltage drop\", \"where\": \"fuse F82 to BCM power feed\",\n                              \"limit\": _UNKNOWN_LIMIT, \"source\": \"S1808000005\",\n                              \"confidence\": SINGLE_SOURCE},\n                     tsb_refs=[\"S1808000005\"],\n                 )),\n        ],\n    ),\n    \"adas_sensors\": _system(\n        \"adas_sensors\", \"ADAS / sensors\",\n        [\"forward camera\", \"radar\", \"park-assist sensors\",\n         \"driver-assist ECU\"],\n        live_channels=[],\n        maintenance_items=[],\n        parts=[],\n        depends_on=[\n            _dep(\"network\",\n                 \"ADAS/chassis-module codes often ride the same gatewayed \"\n                 \"CAN buses as other modules affected by bus/supply events.\",\n                 UNKNOWN,\n                 technical=_tech(\n                     \"CAN data\",\n                     \"A bus/supply event affecting other gatewayed modules \"\n                     \"could present as an ADAS-sensor communication fault \"\n                     \"-- not corroborated for this system specifically.\",\n                     bus=_BUS_CAN_CH,\n                 )),\n        ],\n    ),\n    \"hvac\": _system(\n        \"hvac\", \"HVAC\",\n        [\"A/C compressor\", \"blower motor\", \"cabin air filter\",\n         \"climate control module\", \"refrigerant circuit\"],\n        live_channels=[],\n        maintenance_items=[\"cabin_air_filter\", \"a_c_cabin_service\"],\n        parts=[\"cabin_air_filter\"],\n        depends_on=[],\n    ),\n    \"pcv\": _system(\n        \"pcv\", \"PCV (crankcase ventilation)\",\n        [\"crankcase breather\", \"PCV valve/housing\", \"breather hoses\",\n         \"intake connection\"],\n        live_channels=[],\n        maintenance_items=[\"pcv_system\"],\n        parts=[],\n        depends_on=[\n            _dep(\"lubrication\",\n                 \"The PCV system vents the crankcase that the lubrication \"\n                 \"system pressurizes with combustion blow-by; a \"\n                 \"lubrication-side fault (excess blow-by, overfill) can \"\n                 \"overwhelm the PCV valve/hoses.\",\n                 SINGLE_SOURCE,\n                 \"general PCV system architecture (crankcase ventilation \"\n                 \"draws from the lubrication system's crankcase) -- no \"\n                 \"GU/Stelvio-specific TSB citation found\",\n                 technical=_tech(\n                     \"crankcase blow-by gas\",\n                     \"Excess blow-by or an oil overfill overwhelms the PCV \"\n                     \"valve/hoses, presenting as a PCV-side fault that \"\n                     \"actually originates in the lubrication system.\",\n                 )),\n            _dep(\"air_intake_boost\",\n                 \"The PCV valve/hoses route crankcase vapor into the \"\n                 \"intake tract under vacuum; a stuck-open valve or split \"\n                 \"hose is a documented source of unmetered air (a vacuum \"\n                 \"leak) that can present as a lean or boost-side fault.\",\n                 SINGLE_SOURCE,\n                 \"general PCV system architecture (crankcase-to-intake \"\n                 \"vacuum connection) -- no GU/Stelvio-specific TSB \"\n                 \"citation found\",\n                 technical=_tech(\n                     \"vacuum\",\n                     \"A stuck-open PCV valve or split hose is an unmetered-\"\n                     \"air (vacuum) leak into the intake tract: a lean or \"\n                     \"boost-side fault that traces back to the PCV system.\",\n                 )),\n        ],\n    ),\n    \"engine_management\": _system(\n        \"engine_management\", \"Engine management (ECM / sensors)\",\n        [\"ECM\", \"crank/cam position sensors\", \"ECM-internal diagnostics\"],\n        live_channels=[],\n        maintenance_items=[],\n        parts=[],\n        depends_on=[\n            _dep(\"electrical_supply\",\n                 \"The ECM/PCM itself needs a stable B+ feed and ground; a \"\n                 \"cranks/no-start complaint is diagnosed by verifying \"\n                 \"ECM/PCM B+ feeds and grounds before suspecting an \"\n                 \"ECM-internal fault.\",\n                 CONFIRMED, _S2308000004,\n                 technical=_tech(\n                     \"ground\",\n                     \"A poor ECM/PCM ground presents as a cranks/no-start \"\n                     \"or an erratic ECM-internal code, not an ECM hardware \"\n                     \"failure.\",\n                     measure={\"what\": \"voltage drop\", \"where\": \"ECM/PCM ground to battery negative\",\n                              \"limit\": _UNKNOWN_LIMIT, \"source\": \"S2308000004\",\n                              \"confidence\": SINGLE_SOURCE},\n                     tsb_refs=[\"S2308000004\"],\n                 )),\n        ],\n    ),\n    \"valve_control\": _system(\n        \"valve_control\", \"Valve control (MultiAir / cam phasing)\",\n        [\"MultiAir solenoid/actuator\", \"camshaft position actuator\",\n         \"cam phaser\", \"camshaft position sensors\"],\n        live_channels=[],\n        maintenance_items=[],\n        parts=[],\n        depends_on=[\n            _dep(\"lubrication\",\n                 \"MultiAir/cam-phasing actuators are oil-pressure-\"\n                 \"actuated; low oil pressure or dirty oil is a documented \"\n                 \"cause of camshaft-actuator timing faults on \"\n                 \"oil-pressure-actuated valve systems in general.\",\n                 SINGLE_SOURCE,\n                 \"general MultiAir/cam-phaser architecture (oil-pressure-\"\n                 \"actuated) -- no GU/Stelvio-specific TSB citation found\",\n                 technical=_tech(\n                     \"oil pressure\",\n                     \"Low oil pressure or dirty oil starves the MultiAir/\"\n                     \"cam-phaser actuator, setting a camshaft timing/\"\n                     \"actuator code that traces back to lubrication, not \"\n                     \"the actuator itself.\",\n                 )),\n        ],\n    ),\n    \"starting_charging\": _system(\n        \"starting_charging\", \"Starting / charging\",\n        [\"starter motor\", \"DBSM (dual battery switch module)\",\n         \"stop-start system\", \"alternator/charging circuit\"],\n        live_channels=[],\n        maintenance_items=[\"battery_12v\"],\n        parts=[\"battery_12v\"],\n        depends_on=[\n            _dep(\"electrical_supply\",\n                 \"A cranks/no-start or stop-start-disabled complaint is \"\n                 \"diagnosed by verifying ECM/PCM B+ feeds and grounds \"\n                 \"before suspecting the starter or DBSM hardware.\",\n                 CONFIRMED, _S2308000004,\n                 technical=_tech(\n                     \"12 V supply\",\n                     \"A weak B+ feed or ground presents as a cranks/no-\"\n                     \"start or stop-start-disabled complaint rather than a \"\n                     \"starter or DBSM hardware failure.\",\n                     tsb_refs=[\"S2308000004\"],\n                 )),\n        ],\n    ),\n    \"security_immobiliser\": _system(\n        \"security_immobiliser\", \"Security / immobiliser\",\n        [\"immobiliser (BCM-hosted)\", \"WIN (wireless ignition node)\",\n         \"RFHUB (passive entry / keyfob)\", \"PROXI master\"],\n        live_channels=[],\n        maintenance_items=[],\n        parts=[],\n        depends_on=[\n            _dep(\"network\",\n                 \"Immobiliser functions are hosted on the BCM, which is \"\n                 \"also the documented B-CAN/C-CAN gateway; an intermittent \"\n                 \"bus/terminal fault can present as a security-module \"\n                 \"fault.\",\n                 SINGLE_SOURCE, _S1708000262,\n                 technical=_tech(\n                     \"CAN data\",\n                     \"An intermittent bus/terminal fault on the BCM's \"\n                     \"gatewayed buses can present as a security/\"\n                     \"immobiliser fault, since the immobiliser is hosted \"\n                     \"on the BCM.\",\n                     bus=_BUS_CAN_C,\n                     tsb_refs=[\"S1708000262\"],\n                 )),\n            _dep(\"electrical_supply\",\n                 \"BCM supply-side faults (e.g. fuse F82) are documented to \"\n                 \"cascade into multiple module/body symptoms, and the \"\n                 \"immobiliser is hosted on the BCM.\",\n                 CONFIRMED, _S1808000005,\n                 technical=_tech(\n                     \"12 V supply\",\n                     \"A BCM supply-side fault (fuse F82) can disable the \"\n                     \"BCM-hosted immobiliser along with other BCM-hosted \"\n                     \"functions, not just one security component.\",\n                     path=_BCM_SUPPLY_PATH,\n                     tsb_refs=[\"S1808000005\"],\n                 )),\n        ],\n    ),\n    \"infotainment_cluster\": _system(\n        \"infotainment_cluster\", \"Infotainment / cluster\",\n        [\"IPC (instrument panel cluster)\", \"Uconnect head unit\",\n         \"radio/navigation/media modules\"],\n        live_channels=[],\n        maintenance_items=[],\n        parts=[],\n        depends_on=[\n            _dep(\"network\",\n                 \"Infotainment/cluster modules gateway through the BCM \"\n                 \"onto the vehicle's CAN/LIN buses; an intermittent bus/\"\n                 \"terminal fault can present as an infotainment/cluster \"\n                 \"fault.\",\n                 SINGLE_SOURCE, _S1708000262,\n                 technical=_tech(\n                     \"CAN data\",\n                     \"An intermittent bus/terminal fault presents as an \"\n                     \"infotainment/cluster fault (blank screen, dropped \"\n                     \"gauges) rather than a bus fault.\",\n                     bus=_BUS_CAN_C,\n                     tsb_refs=[\"S1708000262\"],\n                 )),\n            _dep(\"electrical_supply\",\n                 \"BCM supply-side faults (e.g. fuse F82) are documented to \"\n                 \"cascade into multiple module symptoms, infotainment/\"\n                 \"cluster included.\",\n                 CONFIRMED, _S1808000005,\n                 technical=_tech(\n                     \"12 V supply\",\n                     \"A BCM supply-side fault cascades into infotainment/\"\n                     \"cluster symptoms along with other module symptoms, \"\n                     \"not an IPC/head-unit hardware failure.\",\n                     path=_BCM_SUPPLY_PATH,\n                     tsb_refs=[\"S1808000005\"],\n                 )),\n        ],\n    ),\n    \"lighting\": _system(\n        \"lighting\", \"Lighting\",\n        [\"headlamps\", \"taillamps\", \"turn signal/marker lamps\",\n         \"AFLS/AHLM/AHBM lighting modules\"],\n        live_channels=[],\n        maintenance_items=[],\n        parts=[],\n        depends_on=[\n            _dep(\"electrical_supply\",\n                 \"Lamps and lighting-control modules are electrical \"\n                 \"loads; a weak supply/ground can present as a lighting \"\n                 \"fault.\",\n                 UNKNOWN,\n                 technical=_tech(\n                     \"12 V supply\",\n                     \"A weak supply/ground to a lamp or lighting-control \"\n                     \"module presents as a lighting fault -- not \"\n                     \"corroborated for this car specifically.\",\n                 )),\n        ],\n    ),\n    \"wheels_tpms\": _system(\n        \"wheels_tpms\", \"Wheels / TPMS\",\n        [\"TPMS sensors\", \"RFHUB (TPMS RF receive)\"],\n        live_channels=[],\n        maintenance_items=[],\n        parts=[\"tpms_sensor\"],\n        depends_on=[\n            _dep(\"network\",\n                 \"TPMS data is received over the network by the RFHUB, \"\n                 \"whose network address is confirmed in this project's \"\n                 \"own module map (module identity as RFHUB itself is \"\n                 \"inferred).\",\n                 SINGLE_SOURCE, _RFHUB_SOURCE,\n                 technical=_tech(\n                     \"CAN data\",\n                     \"A bus/supply fault reaching the RFHUB drops TPMS \"\n                     \"data from the network, presenting as a TPMS fault \"\n                     \"that is really a network-side issue.\",\n                     bus=_BUS_CAN_C,\n                 )),\n        ],\n    ),\n    \"restraints\": _system(\n        \"restraints\", \"Restraints (airbags / ORC)\",\n        [\"ORC (occupant restraint controller)\", \"airbags\",\n         \"pretensioners\", \"OCM (occupant classification)\",\n         \"SIS (side-impact satellite sensors)\"],\n        live_channels=[],\n        maintenance_items=[],\n        parts=[],\n        depends_on=[\n            _dep(\"electrical_supply\",\n                 \"The ORC and its satellite sensors are electrically \"\n                 \"supplied safety modules; a weak supply/ground could \"\n                 \"affect them like other modules, but no sourced \"\n                 \"restraints-specific cascade was found.\",\n                 UNKNOWN,\n                 technical=_tech(\n                     \"12 V supply\",\n                     \"A weak supply/ground to the ORC or its satellite \"\n                     \"sensors could present as a restraints fault, like \"\n                     \"other modules affected by a supply fault -- not \"\n                     \"corroborated for restraints specifically.\",\n                 )),\n        ],\n    ),\n}\n\n\n# --- per-SYSTEM technical enrichment ----------------------------------------\n#\n# modules/dids/components below cite only what this repo's own modules have\n# actually sourced (cuore.live.buses' modules_seen tuples, cuore.live.\n# did_catalog's EXTRA_DIDS, mes.electrical/mes.layout_systems element\n# locations); every system not named gets an empty list rather than a\n# guessed entry. live_channels_with_bands is filled from mes.known_good,\n# imported lazily (same lazy-import posture correlate() already uses) so a\n# knowledge-table miss can never break module import.\n\n#: Bus module codes this project has actually observed/placed per the\n#: sourced ``modules_seen`` tuples in cuore.live.buses -- not every module\n#: on the car, only the ones with a system this file already models.\n_MODULES_BY_SYSTEM: dict[str, list[dict[str, str]]] = {\n    \"network\": [\n        {\"code\": \"BCM\", \"bus\": \"CAN-C\", \"confidence\": \"confirmed\"},\n        {\"code\": \"RFHUB\", \"bus\": \"CAN-C\", \"confidence\": \"confirmed\"},\n        {\"code\": \"IPC\", \"bus\": \"CAN-C\", \"confidence\": \"confirmed\"},\n        {\"code\": \"TCM\", \"bus\": \"CAN-C\", \"confidence\": \"confirmed\"},\n        {\"code\": \"ABS\", \"bus\": \"CAN-CH\", \"confidence\": \"inferred\"},\n        {\"code\": \"EPS\", \"bus\": \"CAN-CH\", \"confidence\": \"inferred\"},\n        {\"code\": \"ORC\", \"bus\": \"CAN-CH\", \"confidence\": \"inferred\"},\n    ],\n    \"engine_management\": [{\"code\": \"ECM\", \"bus\": \"CAN-C\", \"confidence\": \"confirmed\"}],\n    \"transmission_driveline\": [{\"code\": \"TCM\", \"bus\": \"CAN-C\", \"confidence\": \"confirmed\"}],\n    \"body_comfort\": [{\"code\": \"BCM\", \"bus\": \"CAN-C\", \"confidence\": \"confirmed\"}],\n    \"infotainment_cluster\": [{\"code\": \"IPC\", \"bus\": \"CAN-C\", \"confidence\": \"confirmed\"}],\n    \"security_immobiliser\": [{\"code\": \"BCM\", \"bus\": \"CAN-C\", \"confidence\": \"confirmed\"}],\n    \"wheels_tpms\": [{\"code\": \"RFHUB\", \"bus\": \"CAN-C\", \"confidence\": \"confirmed\"}],\n    \"brakes_abs\": [{\"code\": \"ABS\", \"bus\": \"CAN-CH\", \"confidence\": \"inferred\"}],\n    \"steering\": [{\"code\": \"EPS\", \"bus\": \"CAN-CH\", \"confidence\": \"inferred\"}],\n    \"restraints\": [{\"code\": \"ORC\", \"bus\": \"CAN-CH\", \"confidence\": \"inferred\"}],\n    \"adas_sensors\": [{\"code\": \"PAM\", \"bus\": \"CAN-CH\", \"confidence\": \"inferred\"}],\n    \"lighting\": [{\"code\": \"AFLS\", \"bus\": \"CAN-CH\", \"confidence\": \"inferred\"}],\n}\n_MODULES_SOURCE = \"cuore.live.buses CAN_C/CAN_CH.modules_seen (sourced observations, not a full module list)\"\n\n#: First 8 catalogued DID names, module=ECM, from cuore.live.did_catalog\n#: EXTRA_DIDS (the only module that catalog adds beyond addressing.DIDS).\n#: Confidence matches that source exactly -- danardi78, diesel-tested,\n#: UNVERIFIED on this car's petrol 2.0T.\n_ECM_DID_NAMES = [\n    \"Fuel tank level\", \"Time since start (engine-on timer)\", \"Engine oil level\",\n    \"Intake manifold temperature (pre-intercooler)\", \"Throttle position, sensor 1\",\n    \"Throttle position, sensor 2\", \"Throttle position, sensor 3\",\n    \"Wastegate / overboost valve position\",\n]\n_DIDS_SOURCE = (\"cuore.live.did_catalog EXTRA_DIDS, module=ECM (danardi78, \"\n               \"tested on diesel Giulia -- confidence=unverified on this \"\n               \"car's petrol 2.0T)\")\n_DIDS_BY_SYSTEM: dict[str, list[dict[str, str]]] = {\n    \"engine_management\": [{\"name\": n, \"confidence\": \"unverified\", \"source\": _DIDS_SOURCE}\n                          for n in _ECM_DID_NAMES],\n}\n\n#: Zone/confidence for the handful of components this repo's own\n#: mes.electrical / mes.layout_systems elements actually place; every other\n#: component label below falls back to zone=\"unknown\" -- never guessed.\n_COMPONENT_ZONES: dict[str, tuple[str, str, str]] = {\n    \"fuses\": (\"trunk\", SINGLE_SOURCE,\n              \"mes.electrical 'f82' element (TSB S1808000005, rear PDC)\"),\n    \"esim\": (\"rear_left_wheel_well\", SINGLE_SOURCE,\n             \"mes.electrical 'esim_connector' element (TSB 9100469/9100471 \"\n             \"+ EVAP_STELVIO.md; co-location with the canister is INFERRED \"\n             \"there, restated here as SINGLE-SOURCE in this module's own \"\n             \"4-value scale)\"),\n    \"fuel tank\": (\"underbody\", SINGLE_SOURCE,\n                  \"mes.layout_systems 'fuel_tank' element (TSB 9100471 \"\n                  \"'drop the Fuel Tank' to access the FDM lock ring)\"),\n}\n\n\ndef _slug(label: str) -> str:\n    return re.sub(r\"[^a-z0-9]+\", \"_\", label.lower()).strip(\"_\")\n\n\ndef _component_entry(label: str) -> dict[str, Any]:\n    zone, confidence, source = _COMPONENT_ZONES.get(\n        label.lower(), (\"unknown\", UNKNOWN, _UNKNOWN_NOTE))\n    return {\"id\": _slug(label), \"label\": label, \"zone\": zone,\n            \"confidence\": confidence, \"source\": source}\n\n\ndef _live_channel_band(channel_id: str) -> dict[str, Any]:\n    \"\"\"One system's ``live_channels`` entry resolved to its known-good band\n    via :mod:`mes.known_good`, imported lazily (never at module scope) so a\n    knowledge-table miss can never break this module's own import.\"\"\"\n    try:\n        from . import known_good as _known_good\n        row = _known_good.known_good(channel_id)\n    except Exception:  # noqa: BLE001 -- enrichment is a nice-to-have, never fatal\n        row = None\n    if not row:\n        return {\"channel\": channel_id, \"normal\": None, \"warn\": None,\n                \"confidence\": UNKNOWN, \"source\": _UNKNOWN_NOTE}\n    return {\"channel\": channel_id, \"normal\": row.get(\"normal\"), \"warn\": row.get(\"warn\"),\n            \"confidence\": row.get(\"confidence\", UNKNOWN),\n            \"source\": row.get(\"source\") or \"mes.known_good\"}\n\n\nfor _sys_key, _row in SYSTEMS.items():\n    _row[\"technical\"] = {\n        \"modules\": [dict(m, source=_MODULES_SOURCE) for m in _MODULES_BY_SYSTEM.get(_sys_key, [])],\n        \"dids\": list(_DIDS_BY_SYSTEM.get(_sys_key, [])),\n        \"live_channels_with_bands\": [_live_channel_band(ch) for ch in _row[\"live_channels\"]],\n        \"components\": [_component_entry(c) for c in _row[\"components\"]],\n        \"codes_owned\": [],  # filled below, once _EXACT_RULES exists\n    }\n\n\ndef systems() -> dict[str, dict[str, Any]]:\n    \"\"\"Every system in the graph, in reading order.\"\"\"\n    return SYSTEMS\n\n\n# --- code -> system(s) -------------------------------------------------------\n\n#: Generic (not vehicle-specific) SAE J2012 range-convention sources, named\n#: as generic every time they are the only thing backing an assignment.\n_SAE_SOURCE = (\"SAE J2012 DTC prefix/range convention (generic category, \"\n              \"not vehicle-specific -- informational fallback only)\")\n_SAE_SOURCE_P06 = (\"SAE J2012 P06xx range (Computer & Auxiliary Outputs -- \"\n                   \"ECM/PCM internal); mapped to 'engine_management' \"\n                   \"(a documented approximation, not a sourced fact)\")\n_SAE_SOURCE_CHASSIS = (\"SAE J2012 C-prefix range (chassis: brakes/steering/\"\n                       \"suspension); mapped to 'brakes_abs' as the default \"\n                       \"chassis bucket (a documented approximation -- a \"\n                       \"specific C-code may actually be steering or \"\n                       \"suspension)\")\n_SAE_SOURCE_BODY = \"SAE J2012 B-prefix range (body)\"\n_U_CODE_SOURCE = (\"SAE J2012 U-prefix range (network/communication), \"\n                  \"corroborated by mes.knowledge.match_codes' own network-\"\n                  \"cascade family rule (3+ lost-communication U-codes)\")\n\n#: Exact-code rules, checked before any family/range fallback. Each entry's\n#: ``systems`` are the PRIMARY systems for every code it lists. This is the\n#: \"CODE_RULES\" table a SYSTEM's own ``technical.codes_owned`` is derived\n#: from below -- never hand-duplicated, so the two can never drift apart.\n_EXACT_RULES: tuple[dict[str, Any], ...] = (\n    {\"codes\": (\"P0440\", \"P0441\", \"P0455\", \"P0456\", \"P0457\", \"P1CEA\"),\n     \"systems\": (\"evap\",), \"confidence\": CONFIRMED,\n     \"source\": (\"mes.knowledge BULLETINS (S2125000002, 9100469/9100471, \"\n               \"9100468, 9100325, 18-048-23, 18-030-17) + mes.code_feel \"\n               \"EVAP section\")},\n    {\"codes\": (\"P0300\", \"P0301\", \"P0302\", \"P0303\", \"P0304\"),\n     \"systems\": (\"ignition\", \"fuel\"), \"confidence\": CONFIRMED,\n     \"source\": (\"SAE J2012 misfire-code definition (a cylinder misfire by \"\n               \"definition implicates spark and fuel delivery) + \"\n               \"mes.code_feel misfire fallback entry\")},\n    {\"codes\": (\"P0171\", \"P0172\"),\n     \"systems\": (\"fuel\", \"air_intake_boost\"), \"confidence\": CONFIRMED,\n     \"source\": (\"SAE J2012 fuel-trim code definition (System Too Lean/Rich \"\n               \"implicates fuel delivery and air-metering/intake leaks)\")},\n    {\"codes\": (\"B1040\", \"U1700\"),\n     \"systems\": (\"network\",), \"confidence\": CONFIRMED,\n     \"source\": (\"mes.knowledge Bulletin S1808000005 (BCM power/comms \"\n               \"cascade) -- B1040/U1700 are BCM communications codes\")},\n    {\"codes\": (\"B1176\",),\n     \"systems\": (\"body_comfort\",), \"confidence\": SINGLE_SOURCE,\n     \"source\": \"generic body-module DTC definition (B1176); no GU/Stelvio-specific TSB found\"},\n    {\"codes\": (\"C141B\", \"C141C\"),\n     \"systems\": (\"adas_sensors\",), \"confidence\": SINGLE_SOURCE,\n     \"source\": \"generic chassis/ADAS DTC definition (C141B/C141C); no GU/Stelvio-specific TSB found\"},\n    {\"codes\": (\"C104B\",),\n     \"systems\": (\"brakes_abs\",), \"confidence\": SINGLE_SOURCE,\n     \"source\": \"generic chassis DTC definition (C104B, ABS/ESC range); no GU/Stelvio-specific TSB found\"},\n    {\"codes\": (\"P0098\", \"P00F5\", \"P105E\", \"P1189\"),\n     \"systems\": (\"air_intake_boost\",), \"confidence\": CONFIRMED,\n     \"source\": (\"SAE J2012 IAT2/boost-pressure sensor circuit code \"\n               \"definitions (P0098/P00F5/P105E/P1189)\")},\n    {\"codes\": (\"P0010\", \"P0011\", \"P0012\", \"P0013\", \"P0014\"),\n     \"systems\": (\"valve_control\",), \"confidence\": CONFIRMED,\n     \"source\": (\"SAE J2012 camshaft position actuator/timing code \"\n               \"definitions ('A'/'B' camshaft actuator circuit and timing \"\n               \"over-advanced/over-retarded) -- generic SAE definition, \"\n               \"not vehicle-specific\")},\n)\n\n#: Filled now that _EXACT_RULES exists: every system's technical.codes_owned\n#: is exactly the codes _EXACT_RULES names it primary for -- derived, not\n#: hand-maintained, so the two tables can never disagree.\nfor _sys_key, _rule in ((s, r) for r in _EXACT_RULES for s in r[\"systems\"]):\n    SYSTEMS[_sys_key][\"technical\"][\"codes_owned\"].extend(\n        c for c in _rule[\"codes\"] if c not in SYSTEMS[_sys_key][\"technical\"][\"codes_owned\"])\n\n#: Keyword fallback for P1xxx (manufacturer-defined) codes, and for B-codes\n#: (body) that need routing to a more specific body-adjacent system before\n#: falling back to the generic body bucket, with no exact entry above:\n#: matched against the code's own description text, never guessed from the\n#: code number alone. First match wins.\n_KEYWORDS: tuple[tuple[tuple[str, ...], str], ...] = (\n    ((\"evap\", \"purge\", \"canister\", \"vent valve\", \"esim\"), \"evap\"),\n    ((\"crankcase\",), \"pcv\"),\n    ((\"multiair\", \"vvt\", \"variable valve\", \"cam phase\"), \"valve_control\"),\n    ((\"turbo\", \"boost\", \"charge air\", \"supercharg\", \"map sensor\"), \"air_intake_boost\"),\n    ((\"misfire\", \"ignition coil\", \"spark\"), \"ignition\"),\n    ((\"airbag\", \"air bag\", \"restraint\", \"occupant restraint\"), \"restraints\"),\n    ((\"headlamp\", \"headlight\", \"taillamp\", \"tail lamp\", \"turn signal\",\n      \"lamp\", \"bulb\"), \"lighting\"),\n    ((\"injector\", \"fuel pump\", \"fuel pressure\", \"fuel rail\", \"fuel trim\"), \"fuel\"),\n    ((\"transmission\", \"shift\", \"gear ratio\", \"clutch\", \"valve body\", \"tcm\"), \"transmission_driveline\"),\n    ((\"communication\", \"network\", \"can bus\", \" bus \"), \"network\"),\n    ((\"battery\", \"charging system\", \"alternator\", \"voltage\"), \"electrical_supply\"),\n    ((\"coolant\", \"thermostat\", \"radiator\", \"overheat\"), \"cooling\"),\n    ((\"oil pressure\", \"oil level\", \"lubrication\"), \"lubrication\"),\n    ((\"catalyst\", \"oxygen sensor\", \"o2 sensor\", \"exhaust\"), \"exhaust_emissions\"),\n    ((\"brake\", \"abs\", \"stability\"), \"brakes_abs\"),\n    ((\"steering\",), \"steering\"),\n    ((\"suspension\", \"shock\", \"strut\"), \"suspension\"),\n    ((\"hvac\", \"air condition\", \"blower\", \"climate\"), \"hvac\"),\n    ((\"body control\", \"door module\", \"window\", \"central lock\"), \"body_comfort\"),\n    ((\"camera\", \"radar\", \"lane\", \"park assist\"), \"adas_sensors\"),\n)\n\n_KEYWORD_SOURCE = (\"description keyword match (manufacturer P1xxx code, or \"\n                   \"a B-code, with no exact entry); the keyword list itself \"\n                   \"is this module's own best-effort mapping, not an \"\n                   \"external citation -- treat as a lead\")\n\n\ndef _keyword_system(description: str) -> Optional[str]:\n    d = (description or \"\").lower()\n    if not d:\n        return None\n    for keywords, sys_key in _KEYWORDS:\n        if any(k in d for k in keywords):\n            return sys_key\n    return None\n\n\ndef _sae_fallback(base: str) -> Optional[dict[str, Any]]:\n    \"\"\"The SAE J2012 prefix/range convention, as a generic last resort.\"\"\"\n    if len(base) < 3:\n        return None\n    letter, rest = base[0], base[1:]\n    if letter == \"P\":\n        prefix2 = rest[:2]\n        if prefix2 == \"01\":\n            return {\"systems\": (\"fuel\", \"air_intake_boost\"),\n                    \"confidence\": SINGLE_SOURCE, \"source\": _SAE_SOURCE}\n        if prefix2 == \"03\":\n            return {\"systems\": (\"ignition\",),\n                    \"confidence\": SINGLE_SOURCE, \"source\": _SAE_SOURCE}\n        if prefix2 == \"04\":\n            return {\"systems\": (\"evap\",),\n                    \"confidence\": SINGLE_SOURCE, \"source\": _SAE_SOURCE}\n        if prefix2 == \"05\":\n            return {\"systems\": (\"air_intake_boost\", \"electrical_supply\"),\n                    \"confidence\": SINGLE_SOURCE, \"source\": _SAE_SOURCE}\n        if prefix2 == \"06\":\n            return {\"systems\": (\"engine_management\",),\n                    \"confidence\": SINGLE_SOURCE, \"source\": _SAE_SOURCE_P06}\n        if prefix2 in (\"07\", \"08\", \"09\"):\n            return {\"systems\": (\"transmission_driveline\",),\n                    \"confidence\": SINGLE_SOURCE, \"source\": _SAE_SOURCE}\n        return None\n    if letter == \"C\":\n        return {\"systems\": (\"brakes_abs\",),\n                \"confidence\": SINGLE_SOURCE, \"source\": _SAE_SOURCE_CHASSIS}\n    if letter == \"B\":\n        return {\"systems\": (\"body_comfort\",),\n                \"confidence\": SINGLE_SOURCE, \"source\": _SAE_SOURCE_BODY}\n    if letter == \"U\":\n        return {\"systems\": (\"network\",),\n                \"confidence\": CORROBORATED, \"source\": _U_CODE_SOURCE}\n    return None\n\n\ndef systems_for_code(code: str, description: str = \"\") -> list[dict[str, Any]]:\n    \"\"\"Every system this code implicates: primaries first, then whatever\n    systems the primaries' own ``depends_on`` names as upstream.\n\n    Resolution order: exact-code table, then \"any U-code is network\" (a\n    family rule, not a guess -- see ``_U_CODE_SOURCE``), then a P1xxx or\n    B-code description-keyword match, then the generic SAE range fallback,\n    then give up honestly (one ``UNKNOWN`` row naming no system).\n\n    A code's primary system(s) automatically pull in their declared\n    ``depends_on`` edges as ``role=\"upstream\"`` rows, so (for example) every\n    EVAP code always carries electrical_supply and fuel upstream without\n    that having to be hand-maintained per code here too.\n    \"\"\"\n    base = base_code(code)\n    primaries: list[tuple[Optional[str], str, str]] = []  # (system, confidence, source)\n\n    matched = False\n    for rule in _EXACT_RULES:\n        if base in rule[\"codes\"]:\n            for sys_key in rule[\"systems\"]:\n                primaries.append((sys_key, rule[\"confidence\"], rule[\"source\"]))\n            matched = True\n            break\n\n    if not matched and base.startswith(\"U\"):\n        primaries.append((\"network\", CORROBORATED, _U_CODE_SOURCE))\n        matched = True\n\n    if not matched and (base.startswith(\"P1\") or base.startswith(\"B\")):\n        sys_key = _keyword_system(description)\n        if sys_key:\n            primaries.append((sys_key, SINGLE_SOURCE, _KEYWORD_SOURCE))\n            matched = True\n\n    if not matched:\n        fb = _sae_fallback(base)\n        if fb:\n            for sys_key in fb[\"systems\"]:\n                primaries.append((sys_key, fb[\"confidence\"], fb[\"source\"]))\n            matched = True\n\n    out: list[dict[str, Any]] = []\n    seen: set[str] = set()\n    if not matched:\n        out.append({\"system\": \"UNKNOWN\", \"role\": \"primary\",\n                   \"confidence\": UNKNOWN, \"source\": _UNKNOWN_NOTE})\n        return out\n\n    for sys_key, confidence, source in primaries:\n        if sys_key in seen:\n            continue\n        seen.add(sys_key)\n        out.append({\"system\": sys_key, \"role\": \"primary\",\n                   \"confidence\": confidence, \"source\": source})\n\n    for sys_key, _conf, _src in primaries:\n        sys_def = SYSTEMS.get(sys_key)\n        if sys_def is None:\n            continue\n        for dep in sys_def[\"depends_on\"]:\n            if dep[\"system\"] in seen:\n                continue\n            seen.add(dep[\"system\"])\n            out.append({\"system\": dep[\"system\"], \"role\": \"upstream\",\n                       \"confidence\": dep[\"confidence\"], \"source\": dep[\"source\"]})\n    return out\n\n\ndef _primary_systems(code: str, description: str = \"\") -> list[str]:\n    return [e[\"system\"] for e in systems_for_code(code, description)\n            if e[\"role\"] == \"primary\" and e[\"system\"] != \"UNKNOWN\"]\n\n\n# --- corpus correlation -----------------------------------------------------\n\ndef correlate(vin: str) -> dict[str, Any]:\n    \"\"\"Project one vehicle's whole DTC corpus onto the system graph.\n\n    Built from :func:`mes.analysis.dtc_history` (the same per-occurrence\n    file/timestamp data :func:`mes.workup.build` uses) plus\n    ``mes.workup.build`` itself for the current-picture open codes and the\n    latest clear assessment, used only to classify each system's\n    ``status``. Simulation logs are excluded (``dtc_history``'s default).\n\n    Returns ``{\"error\": ...}`` if no logs match this VIN -- never a\n    half-empty dossier.\n    \"\"\"\n    from . import analysis, workup as workup_mod\n\n    history = analysis.dtc_history(vin=vin)\n    if not history:\n        return {\"error\": \"no logs match\", \"vin\": vin}\n\n    primary_map: dict[str, list[str]] = {}\n    for code, rec in history.items():\n        descr = rec.descriptions[0] if rec.descriptions else \"\"\n        primary_map[code] = _primary_systems(code, descr)\n\n    # --- per-session (per-file) system sets ---------------------------------\n    session_codes: dict[str, set[str]] = {}\n    for code, rec in history.items():\n        for occ in rec.occurrences:\n            fname = occ.get(\"file\")\n            if not fname:\n                continue\n            session_codes.setdefault(fname, set()).add(code)\n    session_systems: dict[str, set[str]] = {\n        fname: {s for c in codes for s in primary_map.get(c, [])}\n        for fname, codes in session_codes.items()\n    }\n    total_sessions = len(session_systems)\n\n    # --- current picture, for status classification only -------------------\n    try:\n        dossier = workup_mod.build(vin=vin)\n    except Exception:  # noqa: BLE001 -- status is a nice-to-have, never fatal\n        dossier = {}\n    cp = dossier.get(\"current_picture\", {}) if isinstance(dossier, dict) else {}\n    latest = cp.get(\"latest_session\") or {}\n    open_codes = {d.get(\"dtc\") for d in latest.get(\"dtcs\", []) if d.get(\"dtc\")}\n    clear = cp.get(\"clear_assessment\") or {}\n    cleared_codes = set(clear.get(\"codes_cleared\") or [])\n\n    # --- by_system -----------------------------------------------------------\n    by_system: list[dict[str, Any]] = []\n    for sys_key in SYSTEMS:\n        codes_here = sorted(c for c, syss in primary_map.items() if sys_key in syss)\n        if not codes_here:\n            by_system.append({\"system\": sys_key, \"codes\": [], \"sessions\": 0,\n                              \"first\": None, \"last\": None, \"status\": \"clean\"})\n            continue\n        sessions_here = sum(1 for syss in session_systems.values() if sys_key in syss)\n        firsts = [history[c].first_seen for c in codes_here if history[c].first_seen]\n        lasts = [history[c].last_seen for c in codes_here if history[c].last_seen]\n        if open_codes & set(codes_here):\n            status = \"active\"\n        elif cleared_codes & set(codes_here):\n            status = \"cleared_unverified\"\n        else:\n            status = \"stale\"\n        by_system.append({\n            \"system\": sys_key, \"codes\": codes_here, \"sessions\": sessions_here,\n            \"first\": min(firsts) if firsts else None,\n            \"last\": max(lasts) if lasts else None,\n            \"status\": status,\n        })\n\n    # --- co-occurrence, pairs with >= 2 shared sessions only ----------------\n    active = [row[\"system\"] for row in by_system if row[\"sessions\"] > 0]\n    co_occurrence: list[dict[str, Any]] = []\n    for i, a in enumerate(active):\n        for b in active[i + 1:]:\n            sessions_a = sum(1 for syss in session_systems.values() if a in syss)\n            sessions_b = sum(1 for syss in session_systems.values() if b in syss)\n            together = sum(1 for syss in session_systems.values()\n                           if a in syss and b in syss)\n            if together < 2:\n                continue\n            expected = (sessions_a * sessions_b) / total_sessions if total_sessions else 0\n            lift = round(together / expected, 2) if expected else None\n            label_a, label_b = SYSTEMS[a][\"label\"], SYSTEMS[b][\"label\"]\n            reading = (\n                f\"{label_a} and {label_b} codes appeared together in \"\n                f\"{together} of {total_sessions} session(s) ({sessions_a} had \"\n                f\"{label_a} codes, {sessions_b} had {label_b} codes); lift \"\n                f\"{lift if lift is not None else 'n/a'} -- correlation only, \"\n                \"could point at a shared cause or be coincidental overlap.\"\n            )\n            co_occurrence.append({\"a\": a, \"b\": b, \"sessions_together\": together,\n                                   \"sessions_a\": sessions_a, \"sessions_b\": sessions_b,\n                                   \"lift\": lift, \"reading\": reading})\n\n    # --- chains: depends_on edges, with corpus evidence where it exists ------\n    chains: list[dict[str, Any]] = []\n    for row in by_system:\n        sys_key = row[\"system\"]\n        if row[\"sessions\"] == 0:\n            continue\n        deps = SYSTEMS[sys_key][\"depends_on\"]\n        if not deps:\n            continue\n        possible_upstream = []\n        for dep in deps:\n            evidence = None\n            for co in co_occurrence:\n                if {co[\"a\"], co[\"b\"]} == {sys_key, dep[\"system\"]}:\n                    evidence = (f\"{co['sessions_together']} of {total_sessions} \"\n                               f\"session(s) with {SYSTEMS[sys_key]['label']} codes \"\n                               f\"also carried {SYSTEMS[dep['system']]['label']} \"\n                               f\"codes (lift {co['lift']}) -- could be upstream, \"\n                               \"not proven.\")\n                    break\n            possible_upstream.append({\"system\": dep[\"system\"], \"why\": dep[\"why\"],\n                                      \"evidence\": evidence})\n        chains.append({\"issue\": f\"{SYSTEMS[sys_key]['label']} codes\",\n                       \"possible_upstream\": possible_upstream})\n\n    # --- findings, plain dated sentences -------------------------------------\n    today = date.today().isoformat()\n    findings: list[str] = []\n    for row in by_system:\n        if row[\"sessions\"] == 0:\n            continue\n        findings.append(\n            f\"{today}: {SYSTEMS[row['system']]['label']} shows \"\n            f\"{len(row['codes'])} code(s) across {row['sessions']} \"\n            f\"session(s) ({row['first']} to {row['last']}), status={row['status']}.\"\n        )\n    for co in co_occurrence:\n        findings.append(f\"{today}: {co['reading']}\")\n    if not findings:\n        findings.append(f\"{today}: no DTCs found for {vin} across the corpus.\")\n\n    return {\n        \"vin\": vin,\n        \"by_system\": by_system,\n        \"co_occurrence\": co_occurrence,\n        \"chains\": chains,\n        \"findings\": findings,\n    }\n\n\n__all__ = [\"SYSTEMS\", \"systems\", \"systems_for_code\", \"correlate\", \"base_code\",\n           \"CONFIRMED\", \"CORROBORATED\", \"SINGLE_SOURCE\", \"UNKNOWN\"]\n","numLines":1272,"startLine":1,"totalLines":1272}},"sourceToolAssistantUUID":"f885c9ea-762d-4244-a71e-5f40cdafc6fe","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
