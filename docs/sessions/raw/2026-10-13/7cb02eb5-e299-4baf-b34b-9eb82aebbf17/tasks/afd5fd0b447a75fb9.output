ces,\n313:def dtc_history(entries: Sequence[LogEntry] | None = None, *,\n356:            if not any(o[\"file\"] == entry.name for o in rec.occurrences):\n357:                rec.occurrences.append({\n365:        rec.occurrences.sort(key=lambda o: o.get(\"timestamp\") or \"\")\n472:                     key=lambda r: r.first_seen)","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"serverClassifierContext":{"request":"05bd3abc-5833-4265-aa14-bfe873c6a94f","context":{"git_state":{"cwd":"/c/Users/User/mcp-servers","root":null,"branch":null,"default_branch":null,"status":null,"visibility":null,"error":"pending"},"live_cwd":"/c/Users/User/mcp-servers","platform":"windows"}},"sourceToolAssistantUUID":"6b3fd2ee-8135-4423-adf8-60dc4ca722cd","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
