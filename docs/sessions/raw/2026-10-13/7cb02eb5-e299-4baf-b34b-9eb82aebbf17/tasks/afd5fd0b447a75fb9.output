{"parentUuid":"91c02ae5-5d65-4eac-94ac-dd8a499b8976","isSidechain":true,"promptId":"fec640df-85aa-489c-b61a-597c991f7812","agentId":"afd5fd0b447a75fb9","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_013WniS4ZeZqNPZn613Kjjn3","type":"tool_result","content":"100\t        f'fill=\"var(--ink-3)\" font-size=\"13\" font-family=\"var(--sans), sans-serif\">'\n101\t        f'{_esc(message)}</text></svg>'\n102\t    )\n103\t\n104\t\n105\tdef _positions(keys: list[str]) -> dict[str, tuple[float, float]]:\n106\t    pos: dict[str, tuple[float, float]] = {}\n107\t    max_row = max((r for _, r in _GRID.values()), default=-1)\n108\t    overflow_i = 0\n109\t    for key in keys:\n110\t        if key in _GRID:\n111\t            col, row = _GRID[key]\n112\t        else:\n113\t            col = overflow_i % _OVERFLOW_COLS\n114\t            row = max_row + 1 + overflow_i // _OVERFLOW_COLS\n115\t            overflow_i += 1\n116\t        pos[key] = (_MARGIN + col * _COL_W + NODE_W / 2, _MARGIN + row * _ROW_H + NODE_H / 2)\n117\t    return pos\n118\t\n119\t\n120\tdef render(nodes: list[dict[str, Any]], edges: list[dict[str, Any]], vin: str = \"\") -> str:\n121\t    \"\"\"``nodes``: ``[{key, label, status, code_count}]``.\n122\t    ``edges``: ``[{a, b, confidence, why}]`` meaning *a depends_on b*.\n123\t\n124\t    ``vin``, when given, makes each node a link to its own dive-in page\n125\t    (``/v/{vin}/systems/{key}``, :mod:`cuore.web.system_routes`) instead of\n126\t    the in-page ``#node-{key}`` jump -- the per-card ``id=\"sys-{key}\"``/\n127\t    ``id=\"node-{key}\"`` anchors below stay in place either way (still\n128\t    reached from ``_system_badge.html``'s ``#sys-{key}`` links and from\n129\t    each edge's own ``#edge-{a}-{b}`` jump), so nothing that already\n130\t    points at those anchors breaks.\"\"\"\n131\t    if not nodes:\n132\t        return _no_data_svg()\n133\t    keys = [n[\"key\"] for n in nodes if n.get(\"key\")]\n134\t    pos = _positions(keys)\n135\t    if not pos:\n136\t        return _no_data_svg()\n137\t    xs, ys = [p[0] for p in pos.values()], [p[1] for p in pos.values()]\n138\t    width = int(max(xs) + NODE_W / 2 + _MARGIN)\n139\t    height = int(max(ys) + NODE_H / 2 + _MARGIN)\n140\t    by_key = {n[\"key\"]: n for n in nodes}\n141\t\n142\t    parts: list[str] = [\n143\t        f'<svg {_SVG_NS} viewBox=\"0 0 {width} {height}\" width=\"{width}\" height=\"{height}\" '\n144\t        f'role=\"img\" aria-label=\"System dependency graph, {len(nodes)} systems\">',\n145\t        '<title>System dependency graph</title>',\n146\t        '<defs><marker id=\"sys-arrow\" markerWidth=\"8\" markerHeight=\"8\" refX=\"7\" refY=\"4\" '\n147\t        'orient=\"auto\"><path d=\"M0,0 L8,4 L0,8 z\" fill=\"var(--ink-3)\"/></marker></defs>',\n148\t    ]\n149\t\n150\t    for e in edges:\n151\t        a, b = e.get(\"a\"), e.get(\"b\")\n152\t        if a not in pos or b not in pos:\n153\t            continue\n154\t        x1, y1 = pos[a]\n155\t        x2, y2 = pos[b]\n156\t        conf = (e.get(\"confidence\") or \"UNKNOWN\").upper()\n157\t        dash = _DASH.get(conf)\n158\t        dash_attr = f' stroke-dasharray=\"{dash}\"' if dash else \"\"\n159\t        a_label = by_key.get(a, {}).get(\"label\", a)\n160\t        b_label = by_key.get(b, {}).get(\"label\", b)\n161\t        title = f\"{a_label} depends on {b_label} ({CONFIDENCE_TEXT.get(conf, conf.lower())})\"\n162\t        if e.get(\"why\"):\n163\t            title += f\": {e['why']}\"\n164\t        # Trim the line endpoints back off the node rectangles a little so\n165\t        # the arrowhead does not sit buried under the next node's fill.\n166\t        dx, dy = x2 - x1, y2 - y1\n167\t        dist = max(1.0, (dx * dx + dy * dy) ** 0.5)\n168\t        trim = NODE_W / 2 + 4\n169\t        x1t, y1t = x1 + dx / dist * trim, y1 + dy / dist * trim\n170\t        x2t, y2t = x2 - dx / dist * trim, y2 - dy / dist * trim\n171\t        parts.append(\n172\t            f'<a href=\"#edge-{_esc(a)}-{_esc(b)}\">'\n173\t            f'<g><line x1=\"{x1t:.1f}\" y1=\"{y1t:.1f}\" x2=\"{x2t:.1f}\" y2=\"{y2t:.1f}\" '\n174\t            f'stroke=\"var(--ink-3)\" stroke-width=\"1.6\"{dash_attr} marker-end=\"url(#sys-arrow)\"/>'\n175\t            f'<title>{_esc(title)}</title></g></a>')\n176\t\n177\t    for n in nodes:\n178\t        key = n.get(\"key\")\n179\t        if key not in pos:\n180\t            continue\n181\t        x, y = pos[key]\n182\t        status = n.get(\"status\") or \"stale\"\n183\t        fill = _STATUS_BG.get(status, \"var(--surface-2)\")\n184\t        stroke = STATUS_COLOR.get(status, \"var(--ink-3)\")\n185\t        count = n.get(\"code_count\") or 0\n186\t        label = n.get(\"label\") or key\n187\t        title = f\"{label} -- {STATUS_TEXT.get(status, status)}, {count} code(s)\"\n188\t        inner = (\n189\t            f'<rect x=\"{x - NODE_W/2:.1f}\" y=\"{y - NODE_H/2:.1f}\" width=\"{NODE_W}\" height=\"{NODE_H}\" '\n190\t            f'rx=\"10\" fill=\"{fill}\" stroke=\"{stroke}\" stroke-width=\"2\"/>'\n191\t            f'<text x=\"{x:.1f}\" y=\"{y + 4:.1f}\" text-anchor=\"middle\" font-size=\"11.5\" '\n192\t            f'fill=\"var(--ink)\" font-family=\"var(--sans), sans-serif\">{_esc(label)}</text>')\n193\t        if count:\n194\t            bx, by = x + NODE_W / 2 - 10, y - NODE_H / 2 + 10\n195\t            inner += (f'<circle cx=\"{bx:.1f}\" cy=\"{by:.1f}\" r=\"9\" fill=\"{stroke}\"/>'\n196\t                      f'<text x=\"{bx:.1f}\" y=\"{by + 3.2:.1f}\" text-anchor=\"middle\" '\n197\t                      f'font-size=\"10\" fill=\"var(--surface)\" font-family=\"var(--mono), monospace\">{count}</text>')\n198\t        href = f\"/v/{_esc(vin)}/systems/{_esc(key)}\" if vin else f\"#node-{_esc(key)}\"\n199\t        parts.append(f'<a href=\"{href}\"><g>{inner}<title>{_esc(title)}</title></g></a>')\n200\t\n201\t    parts.append(\"</svg>\")\n202\t    return \"\".join(parts)\n203\t\n204\t"}]},"uuid":"b1a0f1d4-3550-4867-8f31-32c0f6f6e50d","timestamp":"2026-10-08T20:25:15.821Z","toolUseResult":{"type":"text","file":{"filePath":"C:\\Users\\User\\mcp-servers\\cuore\\web\\systems_svg.py","content":"        f'fill=\"var(--ink-3)\" font-size=\"13\" font-family=\"var(--sans), sans-serif\">'\n        f'{_esc(message)}</text></svg>'\n    )\n\n\ndef _positions(keys: list[str]) -> dict[str, tuple[float, float]]:\n    pos: dict[str, tuple[float, float]] = {}\n    max_row = max((r for _, r in _GRID.values()), default=-1)\n    overflow_i = 0\n    for key in keys:\n        if key in _GRID:\n            col, row = _GRID[key]\n        else:\n            col = overflow_i % _OVERFLOW_COLS\n            row = max_row + 1 + overflow_i // _OVERFLOW_COLS\n            overflow_i += 1\n        pos[key] = (_MARGIN + col * _COL_W + NODE_W / 2, _MARGIN + row * _ROW_H + NODE_H / 2)\n    return pos\n\n\ndef render(nodes: list[dict[str, Any]], edges: list[dict[str, Any]], vin: str = \"\") -> str:\n    \"\"\"``nodes``: ``[{key, label, status, code_count}]``.\n    ``edges``: ``[{a, b, confidence, why}]`` meaning *a depends_on b*.\n\n    ``vin``, when given, makes each node a link to its own dive-in page\n    (``/v/{vin}/systems/{key}``, :mod:`cuore.web.system_routes`) instead of\n    the in-page ``#node-{key}`` jump -- the per-card ``id=\"sys-{key}\"``/\n    ``id=\"node-{key}\"`` anchors below stay in place either way (still\n    reached from ``_system_badge.html``'s ``#sys-{key}`` links and from\n    each edge's own ``#edge-{a}-{b}`` jump), so nothing that already\n    points at those anchors breaks.\"\"\"\n    if not nodes:\n        return _no_data_svg()\n    keys = [n[\"key\"] for n in nodes if n.get(\"key\")]\n    pos = _positions(keys)\n    if not pos:\n        return _no_data_svg()\n    xs, ys = [p[0] for p in pos.values()], [p[1] for p in pos.values()]\n    width = int(max(xs) + NODE_W / 2 + _MARGIN)\n    height = int(max(ys) + NODE_H / 2 + _MARGIN)\n    by_key = {n[\"key\"]: n for n in nodes}\n\n    parts: list[str] = [\n        f'<svg {_SVG_NS} viewBox=\"0 0 {width} {height}\" width=\"{width}\" height=\"{height}\" '\n        f'role=\"img\" aria-label=\"System dependency graph, {len(nodes)} systems\">',\n        '<title>System dependency graph</title>',\n        '<defs><marker id=\"sys-arrow\" markerWidth=\"8\" markerHeight=\"8\" refX=\"7\" refY=\"4\" '\n        'orient=\"auto\"><path d=\"M0,0 L8,4 L0,8 z\" fill=\"var(--ink-3)\"/></marker></defs>',\n    ]\n\n    for e in edges:\n        a, b = e.get(\"a\"), e.get(\"b\")\n        if a not in pos or b not in pos:\n            continue\n        x1, y1 = pos[a]\n        x2, y2 = pos[b]\n        conf = (e.get(\"confidence\") or \"UNKNOWN\").upper()\n        dash = _DASH.get(conf)\n        dash_attr = f' stroke-dasharray=\"{dash}\"' if dash else \"\"\n        a_label = by_key.get(a, {}).get(\"label\", a)\n        b_label = by_key.get(b, {}).get(\"label\", b)\n        title = f\"{a_label} depends on {b_label} ({CONFIDENCE_TEXT.get(conf, conf.lower())})\"\n        if e.get(\"why\"):\n            title += f\": {e['why']}\"\n        # Trim the line endpoints back off the node rectangles a little so\n        # the arrowhead does not sit buried under the next node's fill.\n        dx, dy = x2 - x1, y2 - y1\n        dist = max(1.0, (dx * dx + dy * dy) ** 0.5)\n        trim = NODE_W / 2 + 4\n        x1t, y1t = x1 + dx / dist * trim, y1 + dy / dist * trim\n        x2t, y2t = x2 - dx / dist * trim, y2 - dy / dist * trim\n        parts.append(\n            f'<a href=\"#edge-{_esc(a)}-{_esc(b)}\">'\n            f'<g><line x1=\"{x1t:.1f}\" y1=\"{y1t:.1f}\" x2=\"{x2t:.1f}\" y2=\"{y2t:.1f}\" '\n            f'stroke=\"var(--ink-3)\" stroke-width=\"1.6\"{dash_attr} marker-end=\"url(#sys-arrow)\"/>'\n            f'<title>{_esc(title)}</title></g></a>')\n\n    for n in nodes:\n        key = n.get(\"key\")\n        if key not in pos:\n            continue\n        x, y = pos[key]\n        status = n.get(\"status\") or \"stale\"\n        fill = _STATUS_BG.get(status, \"var(--surface-2)\")\n        stroke = STATUS_COLOR.get(status, \"var(--ink-3)\")\n        count = n.get(\"code_count\") or 0\n        label = n.get(\"label\") or key\n        title = f\"{label} -- {STATUS_TEXT.get(status, status)}, {count} code(s)\"\n        inner = (\n            f'<rect x=\"{x - NODE_W/2:.1f}\" y=\"{y - NODE_H/2:.1f}\" width=\"{NODE_W}\" height=\"{NODE_H}\" '\n            f'rx=\"10\" fill=\"{fill}\" stroke=\"{stroke}\" stroke-width=\"2\"/>'\n            f'<text x=\"{x:.1f}\" y=\"{y + 4:.1f}\" text-anchor=\"middle\" font-size=\"11.5\" '\n            f'fill=\"var(--ink)\" font-family=\"var(--sans), sans-serif\">{_esc(label)}</text>')\n        if count:\n            bx, by = x + NODE_W / 2 - 10, y - NODE_H / 2 + 10\n            inner += (f'<circle cx=\"{bx:.1f}\" cy=\"{by:.1f}\" r=\"9\" fill=\"{stroke}\"/>'\n                      f'<text x=\"{bx:.1f}\" y=\"{by + 3.2:.1f}\" text-anchor=\"middle\" '\n                      f'font-size=\"10\" fill=\"var(--surface)\" font-family=\"var(--mono), monospace\">{count}</text>')\n        href = f\"/v/{_esc(vin)}/systems/{_esc(key)}\" if vin else f\"#node-{_esc(key)}\"\n        parts.append(f'<a href=\"{href}\"><g>{inner}<title>{_esc(title)}</title></g></a>')\n\n    parts.append(\"</svg>\")\n    return \"\".join(parts)\n\n","numLines":105,"startLine":100,"totalLines":206}},"sourceToolAssistantUUID":"91c02ae5-5d65-4eac-94ac-dd8a499b8976","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
