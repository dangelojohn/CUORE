n purge solenoid\",\n303-             \"Check fuel-tank-pressure sensor 5V supply/signal/return \"\n--\n313-    verification=(\n314:        Step(\"V1\", \"Confirm under the running condition\",\n315-             \"P1CEA sets under boost -- verify with a recorded road test: \"\n--\n367-    steps=(\n368:        Step(\"N1\", \"Engine-running rescan before chasing any of this as real\",\n369-             \"Rescan with the engine RUNNING (not just key-on-engine-off) \"\n--\n379-             \"rescan.'\"),\n380:        Step(\"N2\", \"Pull DTC EX on every code BEFORE clearing anything\",\n381-             \"In MES, read extended DTC data (DTC EX) on every code in \"\n--\n393-             \"EX before clearing').\"),\n394:        Step(\"N3\", \"Read ABS directly on CAN-CH (grey A6) -- does the \"\n395-                   \"brake side agree?\",\n--\n412-                     \"assist live here.\"),\n413:        Step(\"N4\", \"Clear once, then rescan without re-plugging anything\",\n414-             \"After N2's DTC EX read, clear the codes, then rescan \"\n--\n427-             \"modules, with no re-plug in between.\"),\n428:        Step(\"N5\", \"BCM power feed -- fuse F82 in the rear PDC, BCM A901 \"\n429-                   \"circuit\",\n--\n441-             \"BULLETINS.\"),\n442:        Step(\"N6\", \"Inline connector XY201 + frame grounds G003A/G003B\",\n443-             \"Inspect inline connector XY201 for security; clean and \"\n--\n455-                     \"applicability.\"),\n456:        Step(\"N7\", \"Spread or backed-out connector terminals\",\n457-             \"Inspect the involved connector terminals for pushed-out or \"\n--\n465-             \"mes/knowledge.py BULLETINS.\"),\n466:        Step(\"N8\", \"BCM water-intrusion recall check (18V205000/U36, \"\n467-                   \"18V203000/U34)\",\n--\n485-             \"entire MY2018 US Stelvio population.\"),\n486:        Step(\"N9\", \"Ground strap voltage-drop test (owner-reported \"\n487-                   \"pattern, NO FCA bulletin)\",\n--\n507-                     \"N5-N8, not above them.\"),\n508:        Step(\"N10\", \"Battery / IBS check\",\n509-             \"Battery load test; check the IBS harness connection by \"\n--\n527-    verification=(\n528:        Step(\"V1\", \"Confirm across more than one session, not one clean \"\n529-                   \"scan\",\n--\n590-    steps=(\n591:        Step(\"D1\", \"Read HALF directly on CAN-CH (grey A6)\",\n592-             \"Fit the grey A6 adapter cable and scan the HALF forward \"\n--\n606-                     \"confirmation.\"),\n607:        Step(\"D2\", \"Windscreen / camera field-of-view obstruction check\",\n608-             \"Check the windscreen area ahead of the HALF camera for \"\n--\n630-    verification=(\n631:        Step(\"V1\", \"Recheck across a session, not one immediate clean \"\n632-                   \"read\",\n--\n841-            \"label\", dep[\"system\"])\n842:        steps.append(Step(\n843-            sid(), f\"Upstream check: {label}\",\n--\n852-    for s in phys.get(\"inspect_steps\", []):\n853:        steps.append(Step(\n854-            sid(), f\"Inspect: {s.get('element', '?')}\",\n--\n862-        bd = b.to_dict()\n863:        steps.append(Step(\n864-            sid(), f\"Bulletin {b.number}: {b.title}\",\n--\n871-    for p in parts_mod.for_code(base):\n872:        steps.append(Step(\n873-            sid(), f\"Part: {p.get('name') or p.get('key')}\",\n--\n893-                continue\n\n[Showing results with pagination = limit: 150]"}]},"uuid":"facf7af6-e4a4-4b3b-9a48-6c25aac7a308","timestamp":"2026-10-08T17:39:21.141Z","toolUseResult":{"mode":"content","numFiles":0,"filenames":[],"content":"102-    steps=(\n103:        Step(\"E1\", \"Recirculation-line mid-point quick-connect\",\n104:             \"Check the recirculation-line mid-point quick-connect for a \"\n105-             \"loose connection.\",\n--\n112-             \"diagnosis for P0456/P0455/P0441/P1CEA\"),\n113:        Step(\"E2\", \"C