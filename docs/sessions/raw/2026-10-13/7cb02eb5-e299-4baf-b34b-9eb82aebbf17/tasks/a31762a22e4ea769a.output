{"parentUuid":"4ee9d63e-4560-44e4-98c2-9ad187e1f4b1","isSidechain":true,"agentId":"a31762a22e4ea769a","message":{"model":"claude-sonnet-5","id":"msg_011CfqB8ZV2K2udwMJoZvMq1","type":"message","role":"assistant","content":[{"type":"thinking","thinking":"","signature":""}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":7925,"cache_read_input_tokens":57441,"cache_creation":{"ephemeral_5m_input_tokens":7925,"ephemeral_1h_input_tokens":0},"output_tokens":2,"service_tier":"standard","inference_geo":"not_available"},"input_transformations":[],"diagnostics":null,"context_management":null},"serverClassifierRequest":"f77d7f4e-237a-4563-96c8-0606b164aed5","apiBlockIndex":0,"requestId":"req_011CfqB8ZDAUVrUJjBkAdk4W","attributionAgent":"general-purpose","type":"assistant","uuid":"defdc2dc-79bf-4130-9583-156fc7692181","timestamp":"2026-10-08T17:36:50.431Z","effort":"high","perTurnEffort":null,"userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
{"parentUuid":"defdc2dc-79bf-4130-9583-156fc7692181","isSidechain":true,"agentId":"a31762a22e4ea769a","message":{"model":"claude-sonnet-5","id":"msg_011CfqB8ZV2K2udwMJoZvMq1","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_0183eavLmvsZ7xS7M6Z8tbpK","name":"Read","input":{"file_path":"C:\\Users\\User\\mcp-servers\\cuore\\services\\bench_bridge.py"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":7925,"cache_read_input_tokens":57441,"cache_creation":{"ephemeral_5m_input_tokens":7925,"ephemeral_1h_input_tokens":0},"output_tokens":2,"service_tier":"standard","inference_geo":"not_available"},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_0183eavLmvsZ7xS7M6Z8tbpK":{"file_path":"C:\\Users\\User\\mcp-servers\\cuore\\services\\bench_bridge.py"}},"serverClassifierRequest":"f77d7f4e-237a-4563-96c8-0606b164aed5","apiBlockIndex":1,"requestId":"req_011CfqB8ZDAUVrUJjBkAdk4W","attributionAgent":"general-purpose","type":"assistant","uuid":"863bac1d-5833-4726-b723-1dafe80955f9","timestamp":"2026-10-08T17:36:51.087Z","effort":"high","perTurnEffort":null,"userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
{"parentUuid":"863bac1d-5833-4726-b723-1dafe80955f9","isSidechain":true,"promptId":"14b8b90f-0c4b-47b6-b2bf-3803814525db","agentId":"a31762a22e4ea769a","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0183eavLmvsZ7xS7M6Z8tbpK","type":"tool_result","content":"1\t\"\"\"Data for the bench page: \"what am I doing to this car, right now\".\n2\t\n3\t``cuore/web/routes.py``'s old ``/v/{vin}`` was the full dossier -- verdict,\n4\tevery code, every bulletin, every freeze frame, all at once. That page still\n5\texists (moved to ``/v/{vin}/dossier``); this module backs the thing a\n6\tmechanic actually wants the instant the car is on the lift: the verdict's\n7\town next-action sentence, the three things to go do about it (with the\n8\tparts and tools each one needs already resolved), and a couple of jump-off\n9\tpoints (codes, the job, the full dossier) -- nothing that needs scrolling to\n10\treach on a 400x800 screen.\n11\t\n12\t``build_bench`` is the only entry point. It composes bridges that already\n13\texist -- ``dossier_bridge.build_view`` for the verdict/open-work/codes,\n14\t``parts_bridge``/``tools_kb_bridge`` for what a step needs,\n15\t``shop_bridge.resolve_vehicle_name``/``current_visit_for_vin`` for the\n16\theader line and the complaint, ``cases_bridge.prefill`` for the one-line\n17\tcase hint -- and invents no new diagnosis of its own.\n18\t\"\"\"\n19\t\n20\tfrom __future__ import annotations\n21\t\n22\tfrom typing import Any\n23\t\n24\tfrom . import cache, dossier_bridge, mes_bridge, parts_bridge, tools_kb_bridge\n25\tfrom .errors import BadRequest\n26\t\n27\ttry:\n28\t    from . import cases_bridge\n29\texcept Exception:  # noqa: BLE001 -- the bench must still render without it\n30\t    cases_bridge = None\n31\t\n32\ttry:\n33\t    from . import shop_bridge\n34\texcept Exception:  # noqa: BLE001\n35\t    shop_bridge = None\n36\t\n37\t\n38\t#: Capped the same way the spec caps each bench card: 3 next actions, each\n39\t#: with at most 3 parts and 4 tools.\n40\t_MAX_ACTIONS = 3\n41\t_MAX_PARTS = 3\n42\t_MAX_TOOLS = 4\n43\t_MAX_SHORTCUTS = 6\n44\t\n45\t#: Family key (lowercased, as ``dossier_bridge.FAMILY_STEPS``/the generic\n46\t#: SAE-range rules spell it) -> icon registry key, for the bench card's own\n47\t#: pictogram. Anything not listed here falls back to a generic glyph --\n48\t#: never a 500 for a family this table doesn't know about yet.\n49\tFAMILY_ICON: dict[str, str] = {\n50\t    \"evap\": \"sys_evap\", \"network\": \"sys_network\", \"misfire\": \"sys_ignition\",\n51\t    \"fuel_trim\": \"sys_fuel\", \"cooling\": \"sys_cooling\",\n52\t    \"engine_management\": \"sys_engine_management\",\n53\t    \"transmission_driveline\": \"sys_transmission_driveline\", \"adas\": \"sys_adas_sensors\",\n54\t    \"chassis\": \"sys_suspension\", \"body\": \"sys_body_comfort\",\n55\t    \"powertrain_other\": \"sys_engine_management\",\n56\t}\n57\t\n58\t\n59\tdef _vehicle_name(vin: str, dossier: dict[str, Any]) -> str:\n60\t    \"\"\"Never \"(unnamed vehicle)\" -- ``shop_bridge.resolve_vehicle_name``\n61\t    already guarantees that (corpus name, then dossier identity, then a WMI\n62\t    decode, then the VIN itself); if that bridge is unavailable for any\n63\t    reason, fall back to the dossier's own identity field, then the VIN.\"\"\"\n64\t    if shop_bridge is not None:\n65\t        try:\n66\t            name = shop_bridge.resolve_vehicle_name(vin)\n67\t            if name:\n68\t                return name\n69\t        except Exception:  # noqa: BLE001\n70\t            pass\n71\t    return (dossier.get(\"identity\") or {}).get(\"vehicle\") or vin\n72\t\n73\t\n74\tdef _complaint(vin: str) -> str | None:\n75\t    if shop_bridge is None:\n76\t        return None\n77\t    try:\n78\t        visit = shop_bridge.current_visit_for_vin(vin)\n79\t    except Exception:  # noqa: BLE001\n80\t        return None\n81\t    return (visit or {}).get(\"complaint\") or None\n82\t\n83\t\n84\tdef _case_hint(vin: str, open_codes: list[str]) -> str | None:\n85\t    \"\"\"One line from ``cases_bridge.prefill`` -- only when a prior case\n86\t    actually matched; the honest \"no prior case on file\" summary\n87\t    ``mes.cases.prefill`` returns otherwise is not a hint worth a mechanic's\n88\t    attention.\"\"\"\n89\t    if cases_bridge is None:\n90\t        return None\n91\t    try:\n92\t        prefill = cases_bridge.prefill(vin, open_codes)\n93\t    except Exception:  # noqa: BLE001\n94\t        return None\n95\t    if not prefill.get(\"matched_case\"):\n96\t        return None\n97\t    return prefill.get(\"summary\")\n98\t\n99\t\n100\tdef _family_parts(vin: str, codes: list[str]) -> list[dict[str, Any]]:\n101\t    \"\"\"Up to :data:`_MAX_PARTS` parts for a family's codes, deduplicated by\n102\t    part key, each shaped ``{name, number, confidence}``. ``number`` and\n103\t    ``confidence`` come off the first OEM row a part carries, falling back\n104\t    to the first aftermarket row -- never invented when neither exists.\"\"\"\n105\t    seen: dict[str, dict[str, Any]] = {}\n106\t    for code in codes:\n107\t        if len(seen) >= _MAX_PARTS:\n108\t            break\n109\t        try:\n110\t            rows = parts_bridge.parts_for_code(code, vin=vin)\n111\t        except Exception:  # noqa: BLE001\n112\t            rows = []\n113\t        for p in rows:\n114\t            key = p.get(\"key\")\n115\t            if not key or key in seen:\n116\t                continue\n117\t            oem = p.get(\"oem\") or []\n118\t            aftermarket = p.get(\"aftermarket\") or []\n119\t            src = oem[0] if oem else (aftermarket[0] if aftermarket else {})\n120\t            seen[key] = {\"name\": p.get(\"name\"), \"number\": src.get(\"number\"),\n121\t                        \"confidence\": src.get(\"confidence\", \"UNKNOWN\")}\n122\t            if len(seen) >= _MAX_PARTS:\n123\t                break\n124\t    return list(seen.values())\n125\t\n126\t\n127\tdef _family_tools(family: str) -> list[dict[str, Any]]:\n128\t    \"\"\"Up to :data:`_MAX_TOOLS` tools for this family, shaped\n129\t    ``{name, have}`` -- ``tools_kb_bridge.recommend`` already resolves\n130\t    ``have`` against the shop's own inventory. ``[]`` for a family\n131\t    ``mes.tools_kb`` has no job-tools table for yet (most of the generic\n132\t    families) -- never a guess at what tool a car needs.\"\"\"\n133\t    try:\n134\t        rows = tools_kb_bridge.recommend((family or \"\").lower())\n135\t    except Exception:  # noqa: BLE001\n136\t        return []\n137\t    out = []\n138\t    for r in rows[:_MAX_TOOLS]:\n139\t        info = r.get(\"tool_info\") or {}\n140\t        out.append({\"name\": info.get(\"name\") or info.get(\"key\"), \"have\": r.get(\"have\")})\n141\t    return out\n142\t\n143\t\n144\tdef _next_actions(vin: str, open_work: list[dict[str, Any]],\n145\t                  codes_by_base: dict[str, str]) -> list[dict[str, Any]]:\n146\t    \"\"\"The top :data:`_MAX_ACTIONS` unchecked open-work steps across every\n147\t    family, ACTIVE families first (any of that family's codes currently\n148\t    ACTIVE in the code table), then in the same order\n149\t    ``dossier_bridge._build_open_work`` already put the cards in (curated\n150\t    families, then the generic ones) -- a stable sort preserves that\n151\t    ordering within each of the two groups.\"\"\"\n152\t    def is_active(card: dict[str, Any]) -> bool:\n153\t        return any(codes_by_base.get(c) == \"ACTIVE\" for c in card.get(\"codes\") or [])\n154\t\n155\t    ordered = sorted(open_work, key=lambda c: 0 if is_active(c) else 1)\n156\t\n157\t    actions: list[dict[str, Any]] = []\n158\t    for card in ordered:\n159\t        family = card.get(\"family\") or \"\"\n160\t        for step in card.get(\"steps\") or []:\n161\t            if step.get(\"done\"):\n162\t                continue\n163\t            ref = step.get(\"ref\")\n164\t            actions.append({\n165\t                \"step_id\": step[\"id\"], \"family\": family, \"text\": step[\"text\"],\n166\t                \"bulletin\": ({\"id\": ref, \"href\": step.get(\"ref_href\")} if ref else None),\n167\t                \"parts\": _family_parts(vin, card.get(\"codes\") or []),\n168\t                \"tools\": _family_tools(family),\n169\t                \"done\": False,\n170\t                \"href_tick\": f\"/v/{vin}/checklist\",\n171\t                \"icon\": FAMILY_ICON.get(family.lower(), \"tools\"),\n172\t            })\n173\t            if len(actions) >= _MAX_ACTIONS:\n174\t                return actions\n175\t    return actions\n176\t\n177\t\n178\tdef _shortcuts(vin: str, codes: list[dict[str, Any]]) -> list[dict[str, Any]]:\n179\t    \"\"\"Up to :data:`_MAX_SHORTCUTS` code-page links, active codes and\n180\t    cleared-but-unverified codes only -- a stale code is not worth a tap\n181\t    target on a screen this small.\"\"\"\n182\t    out = []\n183\t    for row in codes:\n184\t        if row.get(\"status\") not in (\"ACTIVE\", \"CLEARED_UNVERIFIED\"):\n185\t            continue\n186\t        out.append({\"code\": row[\"code\"], \"href\": row[\"href\"], \"status\": row[\"status\"]})\n187\t        if len(out) >= _MAX_SHORTCUTS:\n188\t            break\n189\t    return out\n190\t\n191\t\n192\tdef build_bench(vin: str) -> dict[str, Any]:\n193\t    \"\"\"Everything ``bench.html`` needs, computed once.\n194\t\n195\t    ``live_status`` is passed as ``None`` into ``dossier_bridge.build_view``\n196\t    -- the same choice ``flow_bridge.flow_state`` and\n197\t    ``shop_bridge._dossier_verdict`` already make from the service layer:\n198\t    it only affects whether the verdict's own action buttons render as\n199\t    enabled, never the verdict state itself (that comes from recorded\n200\t    observations), and the bench page does not render those buttons anyway.\n201\t    \"\"\"\n202\t    vin = (vin or \"\").strip()\n203\t    if not vin:\n204\t        raise BadRequest(\"a VIN is required\")\n205\t\n206\t    dossier = cache.get_or_build(\n207\t        (\"workup\", vin, mes_bridge.newest_mtime(vin)),\n208\t        lambda: mes_bridge.workup(vin=vin),\n209\t    )\n210\t    view = dossier_bridge.build_view(vin, dossier, None)\n211\t    identity = dossier.get(\"identity\") or {}\n212\t\n213\t    verdict_raw = view.get(\"verdict\") or {}\n214\t    verdict = {\n215\t        \"state\": verdict_raw.get(\"state\"),\n216\t        \"label\": verdict_raw.get(\"label\"),\n217\t        \"sentence\": verdict_raw.get(\"summary\"),\n218\t        \"next_action\": verdict_raw.get(\"next_action\"),\n219\t        \"blocker\": verdict_raw.get(\"blocker\"),\n220\t    }\n221\t\n222\t    codes = view.get(\"codes\") or []\n223\t    codes_by_base = {row[\"code\"]: row[\"status\"] for row in codes}\n224\t    next_actions = _next_actions(vin, view.get(\"open_work\") or [], codes_by_base)\n225\t\n226\t    latest = view.get(\"latest\") or {}\n227\t    last_read = latest.get(\"session_short\") or latest.get(\"scan_short\")\n228\t\n229\t    try:\n230\t        open_codes = mes_bridge.open_codes_for(dossier)\n231\t    except Exception:  # noqa: BLE001\n232\t        open_codes = []\n233\t\n234\t    return {\n235\t        \"vin\": vin,\n236\t        \"vehicle\": _vehicle_name(vin, dossier),\n237\t        \"vin_tail\": vin[-6:] if len(vin) >= 6 else vin,\n238\t        \"km\": identity.get(\"odometer_last_km\"),\n239\t        \"complaint\": _complaint(vin),\n240\t        \"verdict\": verdict,\n241\t        \"next_actions\": next_actions,\n242\t        \"open_codes_count\": (view.get(\"code_counts\") or {}).get(\"active\", 0),\n243\t        \"last_read\": last_read,\n244\t        \"shortcuts\": _shortcuts(vin, codes),\n245\t        \"case_hint\": _case_hint(vin, open_codes),\n246\t    }\n247\t\n248\t\n249\t__all__ = [\"build_bench\", \"FAMILY_ICON\"]\n250\t"}]},"uuid":"865427cc-edc8-44cf-a71d-bed4cfe2a9c7","timestamp":"2026-10-08T17:36:51.121Z","toolUseResult":{"type":"text","file":{"filePath":"C:\\Users\\User\\mcp-servers\\cuore\\services\\bench_bridge.py","content":"\"\"\"Data for the bench page: \"what am I doing to this car, right now\".\n\n``cuore/web/routes.py``'s old ``/v/{vin}`` was the full dossier -- verdict,\nevery code, every bulletin, every freeze frame, all at once. That page still\nexists (moved to ``/v/{vin}/dossier``); this module backs the thing a\nmechanic actually wants the instant the car is on the lift: the verdict's\nown next-action sentence, the three things to go do about it (with the\nparts and tools each one needs already resolved), and a couple of jump-off\npoints (codes, the job, the full dossier) -- nothing that needs scrolling to\nreach on a 400x800 screen.\n\n``build_bench`` is the only entry point. It composes bridges that already\nexist -- ``dossier_bridge.build_view`` for the verdict/open-work/codes,\n``parts_bridge``/``tools_kb_bridge`` for what a step needs,\n``shop_bridge.resolve_vehicle_name``/``current_visit_for_vin`` for the\nheader line and the complaint, ``cases_bridge.prefill`` for the one-line\ncase hint -- and invents no new diagnosis of its own.\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom typing import Any\n\nfrom . import cache, dossier_bridge, mes_bridge, parts_bridge, tools_kb_bridge\nfrom .errors import BadRequest\n\ntry:\n    from . import cases_bridge\nexcept Exception:  # noqa: BLE001 -- the bench must still render without it\n    cases_bridge = None\n\ntry:\n    from . import shop_bridge\nexcept Exception:  # noqa: BLE001\n    shop_bridge = None\n\n\n#: Capped the same way the spec caps each bench card: 3 next actions, each\n#: with at most 3 parts and 4 tools.\n_MAX_ACTIONS = 3\n_MAX_PARTS = 3\n_MAX_TOOLS = 4\n_MAX_SHORTCUTS = 6\n\n#: Family key (lowercased, as ``dossier_bridge.FAMILY_STEPS``/the generic\n#: SAE-range rules spell it) -> icon registry key, for the bench card's own\n#: pictogram. Anything not listed here falls back to a generic glyph --\n#: never a 500 for a family this table doesn't know about yet.\nFAMILY_ICON: dict[str, str] = {\n    \"evap\": \"sys_evap\", \"network\": \"sys_network\", \"misfire\": \"sys_ignition\",\n    \"fuel_trim\": \"sys_fuel\", \"cooling\": \"sys_cooling\",\n    \"engine_management\": \"sys_engine_management\",\n    \"transmission_driveline\": \"sys_transmission_driveline\", \"adas\": \"sys_adas_sensors\",\n    \"chassis\": \"sys_suspension\", \"body\": \"sys_body_comfort\",\n    \"powertrain_other\": \"sys_engine_management\",\n}\n\n\ndef _vehicle_name(vin: str, dossier: dict[str, Any]) -> str:\n    \"\"\"Never \"(unnamed vehicle)\" -- ``shop_bridge.resolve_vehicle_name``\n    already guarantees that (corpus name, then dossier identity, then a WMI\n    decode, then the VIN itself); if that bridge is unavailable for any\n    reason, fall back to the dossier's own identity field, then the VIN.\"\"\"\n    if shop_bridge is not None:\n        try:\n            name = shop_bridge.resolve_vehicle_name(vin)\n            if name:\n                return name\n        except Exception:  # noqa: BLE001\n            pass\n    return (dossier.get(\"identity\") or {}).get(\"vehicle\") or vin\n\n\ndef _complaint(vin: str) -> str | None:\n    if shop_bridge is None:\n        return None\n    try:\n        visit = shop_bridge.current_visit_for_vin(vin)\n    except Exception:  # noqa: BLE001\n        return None\n    return (visit or {}).get(\"complaint\") or None\n\n\ndef _case_hint(vin: str, open_codes: list[str]) -> str | None:\n    \"\"\"One line from ``cases_bridge.prefill`` -- only when a prior case\n    actually matched; the honest \"no prior case on file\" summary\n    ``mes.cases.prefill`` returns otherwise is not a hint worth a mechanic's\n    attention.\"\"\"\n    if cases_bridge is None:\n        return None\n    try:\n        prefill = cases_bridge.prefill(vin, open_codes)\n    except Exception:  # noqa: BLE001\n        return None\n    if not prefill.get(\"matched_case\"):\n        return None\n    return prefill.get(\"summary\")\n\n\ndef _family_parts(vin: str, codes: list[str]) -> list[dict[str, Any]]:\n    \"\"\"Up to :data:`_MAX_PARTS` parts for a family's codes, deduplicated by\n    part key, each shaped ``{name, number, confidence}``. ``number`` and\n    ``confidence`` come off the first OEM row a part carries, falling back\n    to the first aftermarket row -- never invented when neither exists.\"\"\"\n    seen: dict[str, dict[str, Any]] = {}\n    for code in codes:\n        if len(seen) >= _MAX_PARTS:\n            break\n        try:\n            rows = parts_bridge.parts_for_code(code, vin=vin)\n        except Exception:  # noqa: BLE001\n            rows = []\n        for p in rows:\n            key = p.get(\"key\")\n            if not key or key in seen:\n                continue\n            oem = p.get(\"oem\") or []\n            aftermarket = p.get(\"aftermarket\") or []\n            src = oem[0] if oem else (aftermarket[0] if aftermarket else {})\n            seen[key] = {\"name\": p.get(\"name\"), \"number\": src.get(\"number\"),\n                        \"confidence\": src.get(\"confidence\", \"UNKNOWN\")}\n            if len(seen) >= _MAX_PARTS:\n                break\n    return list(seen.values())\n\n\ndef _family_tools(family: str) -> list[dict[str, Any]]:\n    \"\"\"Up to :data:`_MAX_TOOLS` tools for this family, shaped\n    ``{name, have}`` -- ``tools_kb_bridge.recommend`` already resolves\n    ``have`` against the shop's own inventory. ``[]`` for a family\n    ``mes.tools_kb`` has no job-tools table for yet (most of the generic\n    families) -- never a guess at what tool a car needs.\"\"\"\n    try:\n        rows = tools_kb_bridge.recommend((family or \"\").lower())\n    except Exception:  # noqa: BLE001\n        return []\n    out = []\n    for r in rows[:_MAX_TOOLS]:\n        info = r.get(\"tool_info\") or {}\n        out.append({\"name\": info.get(\"name\") or info.get(\"key\"), \"have\": r.get(\"have\")})\n    return out\n\n\ndef _next_actions(vin: str, open_work: list[dict[str, Any]],\n                  codes_by_base: dict[str, str]) -> list[dict[str, Any]]:\n    \"\"\"The top :data:`_MAX_ACTIONS` unchecked open-work steps across every\n    family, ACTIVE families first (any of that family's codes currently\n    ACTIVE in the code table), then in the same order\n    ``dossier_bridge._build_open_work`` already put the cards in (curated\n    families, then the generic ones) -- a stable sort preserves that\n    ordering within each of the two groups.\"\"\"\n    def is_active(card: dict[str, Any]) -> bool:\n        return any(codes_by_base.get(c) == \"ACTIVE\" for c in card.get(\"codes\") or [])\n\n    ordered = sorted(open_work, key=lambda c: 0 if is_active(c) else 1)\n\n    actions: list[dict[str, Any]] = []\n    for card in ordered:\n        family = card.get(\"family\") or \"\"\n        for step in card.get(\"steps\") or []:\n            if step.get(\"done\"):\n                continue\n            ref = step.get(\"ref\")\n            actions.append({\n                \"step_id\": step[\"id\"], \"family\": family, \"text\": step[\"text\"],\n                \"bulletin\": ({\"id\": ref, \"href\": step.get(\"ref_href\")} if ref else None),\n                \"parts\": _family_parts(vin, card.get(\"codes\") or []),\n                \"tools\": _family_tools(family),\n                \"done\": False,\n                \"href_tick\": f\"/v/{vin}/checklist\",\n                \"icon\": FAMILY_ICON.get(family.lower(), \"tools\"),\n            })\n            if len(actions) >= _MAX_ACTIONS:\n                return actions\n    return actions\n\n\ndef _shortcuts(vin: str, codes: list[dict[str, Any]]) -> list[dict[str, Any]]:\n    \"\"\"Up to :data:`_MAX_SHORTCUTS` code-page links, active codes and\n    cleared-but-unverified codes only -- a stale code is not worth a tap\n    target on a screen this small.\"\"\"\n    out = []\n    for row in codes:\n        if row.get(\"status\") not in (\"ACTIVE\", \"CLEARED_UNVERIFIED\"):\n            continue\n        out.append({\"code\": row[\"code\"], \"href\": row[\"href\"], \"status\": row[\"status\"]})\n        if len(out) >= _MAX_SHORTCUTS:\n            break\n    return out\n\n\ndef build_bench(vin: str) -> dict[str, Any]:\n    \"\"\"Everything ``bench.html`` needs, computed once.\n\n    ``live_status`` is passed as ``None`` into ``dossier_bridge.build_view``\n    -- the same choice ``flow_bridge.flow_state`` and\n    ``shop_bridge._dossier_verdict`` already make from the service layer:\n    it only affects whether the verdict's own action buttons render as\n    enabled, never the verdict state itself (that comes from recorded\n    observations), and the bench page does not render those buttons anyway.\n    \"\"\"\n    vin = (vin or \"\").strip()\n    if not vin:\n        raise BadRequest(\"a VIN is required\")\n\n    dossier = cache.get_or_build(\n        (\"workup\", vin, mes_bridge.newest_mtime(vin)),\n        lambda: mes_bridge.workup(vin=vin),\n    )\n    view = dossier_bridge.build_view(vin, dossier, None)\n    identity = dossier.get(\"identity\") or {}\n\n    verdict_raw = view.get(\"verdict\") or {}\n    verdict = {\n        \"state\": verdict_raw.get(\"state\"),\n        \"label\": verdict_raw.get(\"label\"),\n        \"sentence\": verdict_raw.get(\"summary\"),\n        \"next_action\": verdict_raw.get(\"next_action\"),\n        \"blocker\": verdict_raw.get(\"blocker\"),\n    }\n\n    codes = view.get(\"codes\") or []\n    codes_by_base = {row[\"code\"]: row[\"status\"] for row in codes}\n    next_actions = _next_actions(vin, view.get(\"open_work\") or [], codes_by_base)\n\n    latest = view.get(\"latest\") or {}\n    last_read = latest.get(\"session_short\") or latest.get(\"scan_short\")\n\n    try:\n        open_codes = mes_bridge.open_codes_for(dossier)\n    except Exception:  # noqa: BLE001\n        open_codes = []\n\n    return {\n        \"vin\": vin,\n        \"vehicle\": _vehicle_name(vin, dossier),\n        \"vin_tail\": vin[-6:] if len(vin) >= 6 else vin,\n        \"km\": identity.get(\"odometer_last_km\"),\n        \"complaint\": _complaint(vin),\n        \"verdict\": verdict,\n        \"next_actions\": next_actions,\n        \"open_codes_count\": (view.get(\"code_counts\") or {}).get(\"active\", 0),\n        \"last_read\": last_read,\n        \"shortcuts\": _shortcuts(vin, codes),\n        \"case_hint\": _case_hint(vin, open_codes),\n    }\n\n\n__all__ = [\"build_bench\", \"FAMILY_ICON\"]\n","numLines":250,"startLine":1,"totalLines":250}},"sourceToolAssistantUUID":"863bac1d-5833-4726-b723-1dafe80955f9","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
{"parentUuid":"865427cc-edc8-44cf-a71d-bed4cfe2a9c7","isSidechain":true,"agentId":"a31762a22e4ea769a","message":{"model":"claude-sonnet-5","id":"msg_011CfqB8ZV2K2udwMJoZvMq1","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_015mMWeYmN8Es3WSjqsYicji","name":"Read","input":{"file_path":"C:\\Users\\User\\mcp-servers\\cuore\\web\\bench_routes.py"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":7925,"cache_read_input_tokens":57441,"cache_creation":{"ephemeral_5m_input_tokens":7925,"ephemeral_1h_input_tokens":0},"output_tokens":2,"service_tier":"standard","inference_geo":"not_available"},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_015mMWeYmN8Es3WSjqsYicji":{"file_path":"C:\\Users\\User\\mcp-servers\\cuore\\web\\bench_routes.py"}},"serverClassifierRequest":"f77d7f4e-237a-4563-96c8-0606b164aed5","apiBlockIndex":2,"requestId":"req_011CfqB8ZDAUVrUJjBkAdk4W","attributionAgent":"general-purpose","type":"assistant","uuid":"1e1454ed-ad34-467c-861c-cc7af13156c1","timestamp":"2026-10-08T17:36:51.535Z","effort":"high","perTurnEffort":null,"userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
{"parentUuid":"1e1454ed-ad34-467c-861c-cc7af13156c1","isSidechain":true,"promptId":"14b8b90f-0c4b-47b6-b2bf-3803814525db","agentId":"a31762a22e4ea769a","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_015mMWeYmN8Es3WSjqsYicji","type":"tool_result","content":"1\t\"\"\"The bench: ``GET /v/{vin}``, the screen a mechanic sees the instant a car\n2\tlands on the lift.\n3\t\n4\tKept as its own router, same posture as ``cuore/web/dossier_routes.py``\n5\t(see that file's own docstring): the old dossier owned ``/v/{vin}`` until\n6\tthis landed, and still owns everything else under ``/v/{vin}/*`` --\n7\t``cuore/web/routes.py``'s own ``/v/{vin}`` handler was moved to\n8\t``/v/{vin}/dossier`` to make room for this one, rather than this file\n9\treaching into that module's handler.\n10\t\n11\tThis page writes nothing new of its own -- its only form is the same\n12\t``POST /v/{vin}/checklist`` the dossier's open-work cards already post to\n13\t(``cuore/web/dossier_routes.py``), reused as-is so ticking a step from the\n14\tbench and ticking it from the full dossier land in the exact same store.\n15\t\"\"\"\n16\t\n17\tfrom __future__ import annotations\n18\t\n19\tfrom fastapi import Depends, Request\n20\tfrom fastapi.responses import HTMLResponse\n21\tfrom fastapi import APIRouter\n22\t\n23\tfrom ..api.deps import require_token\n24\tfrom ..services import bench_bridge\n25\tfrom . import routes as web_routes\n26\t\n27\trouter = APIRouter(include_in_schema=False, dependencies=[Depends(require_token)])\n28\t\n29\t\n30\t@router.get(\"/v/{vin}\", response_class=HTMLResponse)\n31\tdef bench_page(request: Request, vin: str) -> HTMLResponse:\n32\t    \"\"\"What to do right now: the verdict's next action, the top three open\n33\t    steps (each with its parts and tools already resolved), and jump-off\n34\t    points to the codes, the job and the full dossier.\"\"\"\n35\t    bench = bench_bridge.build_bench(vin)\n36\t    response = web_routes._page(request, \"bench.html\", vin=vin, bench=bench,\n37\t                                tab=\"bench\")\n38\t    web_routes._set_active_vehicle(response, vin)\n39\t    return response\n40\t\n41\t\n42\t__all__ = [\"router\"]\n43\t"}]},"uuid":"b9a2160a-5d32-4ece-ae53-689ccf057460","timestamp":"2026-10-08T17:36:51.556Z","toolUseResult":{"type":"text","file":{"filePath":"C:\\Users\\User\\mcp-servers\\cuore\\web\\bench_routes.py","content":"\"\"\"The bench: ``GET /v/{vin}``, the screen a mechanic sees the instant a car\nlands on the lift.\n\nKept as its own router, same posture as ``cuore/web/dossier_routes.py``\n(see that file's own docstring): the old dossier owned ``/v/{vin}`` until\nthis landed, and still owns everything else under ``/v/{vin}/*`` --\n``cuore/web/routes.py``'s own ``/v/{vin}`` handler was moved to\n``/v/{vin}/dossier`` to make room for this one, rather than this file\nreaching into that module's handler.\n\nThis page writes nothing new of its own -- its only form is the same\n``POST /v/{vin}/checklist`` the dossier's open-work cards already post to\n(``cuore/web/dossier_routes.py``), reused as-is so ticking a step from the\nbench and ticking it from the full dossier land in the exact same store.\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom fastapi import Depends, Request\nfrom fastapi.responses import HTMLResponse\nfrom fastapi import APIRouter\n\nfrom ..api.deps import require_token\nfrom ..services import bench_bridge\nfrom . import routes as web_routes\n\nrouter = APIRouter(include_in_schema=False, dependencies=[Depends(require_token)])\n\n\n@router.get(\"/v/{vin}\", response_class=HTMLResponse)\ndef bench_page(request: Request, vin: str) -> HTMLResponse:\n    \"\"\"What to do right now: the verdict's next action, the top three open\n    steps (each with its parts and tools already resolved), and jump-off\n    points to the codes, the job and the full dossier.\"\"\"\n    bench = bench_bridge.build_bench(vin)\n    response = web_routes._page(request, \"bench.html\", vin=vin, bench=bench,\n                                tab=\"bench\")\n    web_routes._set_active_vehicle(response, vin)\n    return response\n\n\n__all__ = [\"router\"]\n","numLines":43,"startLine":1,"totalLines":43}},"sourceToolAssistantUUID":"1e1454ed-ad34-467c-861c-cc7af13156c1","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
{"parentUuid":"b9a2160a-5d32-4ece-ae53-689ccf057460","isSidechain":true,"agentId":"a31762a22e4ea769a","message":{"model":"claude-sonnet-5","id":"msg_011CfqB8ZV2K2udwMJoZvMq1","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_019VEjLQXzVQ5B4Q736V7zfw","name":"Read","input":{"file_path":"C:\\Users\\User\\mcp-servers\\cuore\\web\\templates\\bench.html"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":7925,"cache_read_input_tokens":57441,"cache_creation":{"ephemeral_5m_input_tokens":7925,"ephemeral_1h_input_tokens":0},"output_tokens":2,"service_tier":"standard","inference_geo":"not_available"},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_019VEjLQXzVQ5B4Q736V7zfw":{"file_path":"C:\\Users\\User\\mcp-servers\\cuore\\web\\templates\\bench.html"}},"serverClassifierRequest":"f77d7f4e-237a-4563-96c8-0606b164aed5","apiBlockIndex":3,"requestId":"req_011CfqB8ZDAUVrUJjBkAdk4W","attributionAgent":"general-purpose","type":"assistant","uuid":"c3171a52-d6e0-4e36-9549-f63a7f82e456","timestamp":"2026-10-08T17:36:51.987Z","effort":"high","perTurnEffort":null,"userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
{"parentUuid":"c3171a52-d6e0-4e36-9549-f63a7f82e456","isSidechain":true,"promptId":"14b8b90f-0c4b-47b6-b2bf-3803814525db","agentId":"a31762a22e4ea769a","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_019VEjLQXzVQ5B4Q736V7zfw","type":"tool_result","content":"1\t{# The bench: what to do to this car right now. No hero, no 12-step flow\n2\t   bar -- cuore/services/bench_bridge.py already boiled the dossier down to\n3\t   one verdict sentence and three cards, so this template's only job is to\n4\t   lay those out small enough that the first card is on-screen on a\n5\t   400x800 phone with no scrolling. See that module's own docstring for\n6\t   where each field comes from; nothing here recomputes a verdict, a part\n7\t   number or a tool's have/not-have status. #}\n8\t{% extends \"base.html\" %}\n9\t{% block title %}{{ bench.vehicle }} &mdash; Bench{% endblock %}\n10\t\n11\t{% block vehiclebar %}\n12\t{% set _status_icon = {\"ACTIVE_FAULTS\": \"status_active\",\n13\t                        \"UNVERIFIED_REPAIR\": \"status_cleared_unverified\",\n14\t                        \"VERIFIED_CLEAN\": \"status_verified\",\n15\t                        \"NO_DATA\": \"status_unknown\"} %}\n16\t{% set _vstate = (bench.verdict.state or \"NO_DATA\")|lower|replace(\"_\", \"-\") %}\n17\t<div class=\"bench-status\">\n18\t  <span class=\"bench-status-name\">{{ bench.vehicle }}</span>\n19\t  <span class=\"bench-status-vin mono\">&hellip;{{ bench.vin_tail }}</span>\n20\t  {% if bench.km is not none %}\n21\t    <span class=\"bench-status-km mono\">{{ \"{:,}\".format(bench.km|int) }} km</span>\n22\t  {% endif %}\n23\t  <span class=\"chip-verdict v-{{ _vstate }} bench-status-chip\">\n24\t    {% if icon is defined %}{{ icon(_status_icon.get(bench.verdict.state, \"status_unknown\"), size=\"s\") }}{% endif %}\n25\t    {{ bench.verdict.label }}</span>\n26\t</div>\n27\t{% endblock %}\n28\t\n29\t{% block content %}\n30\t<style>\n31\t/* Scoped to .bench -- no shared rule touched, so this page can be tuned\n32\t   without risking any other page's layout. Uses the same custom\n33\t   properties cuore.css already defines (colours/radius/mono/sans), so\n34\t   light/dark/marque theming is inherited for free. */\n35\t.bench-status {\n36\t  display: flex; flex-wrap: wrap; align-items: center; gap: 8px;\n37\t  min-height: 40px; padding: 6px var(--pad);\n38\t  background: var(--surface); border-bottom: 1px solid var(--rule);\n39\t}\n40\t.bench-status-name { font-weight: 650; font-size: 14px; }\n41\t.bench-status-vin, .bench-status-km { font-size: 12px; color: var(--ink-3); }\n42\t.bench-status-chip { margin-left: auto; display: inline-flex; align-items: center; gap: 4px; }\n43\t\n44\t.bench { display: flex; flex-direction: column; gap: 10px; max-width: 100%; }\n45\t.bench-complaint {\n46\t  margin: 4px 0 0; font-size: 14px; font-style: italic; color: var(--ink-2);\n47\t  overflow-wrap: anywhere;\n48\t}\n49\t.bench-next-action {\n50\t  margin: 0; font-size: 20px; line-height: 1.3; font-weight: 600;\n51\t  color: var(--ink); overflow-wrap: anywhere;\n52\t}\n53\t.bench-case-hint { margin: 0; }\n54\t\n55\t.bench-actions { display: flex; flex-direction: column; gap: 10px; }\n56\t.bench-card {\n57\t  display: flex; gap: 10px; align-items: flex-start;\n58\t  background: var(--raised); border: 1px solid var(--rule);\n59\t  border-radius: var(--radius); padding: 10px; max-width: 100%;\n60\t}\n61\t.bench-check { flex: none; }\n62\t.bench-checkbox {\n63\t  width: 44px; height: 44px; display: flex; align-items: center; justify-content: center;\n64\t  font-size: 22px; line-height: 1; background: var(--surface-2); color: var(--ink);\n65\t  border: 1px solid var(--rule); border-radius: var(--radius); cursor: pointer;\n66\t}\n67\t.bench-checkbox:hover { border-color: var(--ink-3); }\n68\t.bench-card-body { flex: 1 1 auto; min-width: 0; display: flex; flex-direction: column; gap: 6px; }\n69\t.bench-card-text { font-size: 15px; display: flex; align-items: center; gap: 6px; overflow-wrap: anywhere; }\n70\t.bench-bulletin { align-self: flex-start; white-space: normal; max-width: 100%; }\n71\t.bench-parts, .bench-tools { font-size: 12px; overflow-wrap: anywhere; }\n72\t.bench-part { margin-right: 6px; }\n73\t.bench-tool {\n74\t  margin-right: 4px; margin-bottom: 4px; display: inline-block;\n75\t  white-space: normal; max-width: 100%; overflow-wrap: anywhere;\n76\t}\n77\t.bench-tool.ok { color: var(--ok); background: var(--ok-bg); }\n78\t.bench-tool.not-ok { color: var(--sev-returned); background: var(--sev-returned-bg); }\n79\t\n80\t.bench-shortcuts { display: flex; flex-wrap: wrap; gap: 6px; }\n81\t.bench-shortcut { white-space: normal; }\n82\t.bench-shortcut { text-decoration: none; }\n83\t.bench-shortcut.v-active { color: var(--sev-returned); background: var(--sev-returned-bg); }\n84\t.bench-shortcut.v-cleared-unverified { color: var(--sev-chronic); background: var(--sev-chronic-bg); }\n85\t\n86\t.bench-links { display: flex; gap: 8px; flex-wrap: wrap; padding-top: 4px; }\n87\t</style>\n88\t\n89\t<div class=\"bench\" data-vin=\"{{ vin }}\">\n90\t  {% if bench.complaint %}\n91\t    <p class=\"bench-complaint\">&ldquo;{{ bench.complaint }}&rdquo;</p>\n92\t  {% endif %}\n93\t\n94\t  {% if bench.verdict.next_action %}\n95\t    <p class=\"bench-next-action\">{{ bench.verdict.next_action }}</p>\n96\t  {% endif %}\n97\t\n98\t  {% if bench.case_hint %}\n99\t    <p class=\"bench-case-hint small muted\">{{ bench.case_hint }}</p>\n100\t  {% endif %}\n101\t\n102\t  <div class=\"bench-actions\">\n103\t    {% for a in bench.next_actions %}\n104\t      <div class=\"bench-card\" data-step-id=\"{{ a.step_id }}\">\n105\t        <form method=\"post\" action=\"{{ a.href_tick }}\" class=\"bench-check\">\n106\t          <input type=\"hidden\" name=\"step_id\" value=\"{{ a.step_id }}\">\n107\t          <input type=\"hidden\" name=\"done\" value=\"1\">\n108\t          <button type=\"submit\" class=\"bench-checkbox\"\n109\t                  aria-label=\"{{ t('mark_done') if t is defined else 'Mark done' }}\"\n110\t                  title=\"{{ t('mark_done') if t is defined else 'Mark done' }}\">&#9744;</button>\n111\t        </form>\n112\t        <div class=\"bench-card-body\">\n113\t          <div class=\"bench-card-text\">\n114\t            {% if icon is defined %}{{ icon(a.icon, size=\"s\") }}{% endif %}\n115\t            <span>{{ a.text }}</span>\n116\t          </div>\n117\t          {% if a.bulletin %}\n118\t            <span class=\"chip plain bench-bulletin\">{{ a.bulletin.id }}</span>\n119\t          {% endif %}\n120\t          {% if a.parts %}\n121\t            <div class=\"bench-parts muted\">\n122\t              {% for p in a.parts %}\n123\t                <span class=\"bench-part\">{{ p.name }}{% if p.number %} &middot;\n124\t                  <span class=\"mono\">{{ p.number }}</span>{% endif %}</span>\n125\t              {% endfor %}\n126\t            </div>\n127\t          {% endif %}\n128\t          {% if a.tools %}\n129\t            <div class=\"bench-tools\">\n130\t              {% for tl in a.tools %}\n131\t                <span class=\"chip plain bench-tool {{ 'ok' if tl.have == 'owned' else ('not-ok' if tl.have == 'not_owned' else '') }}\">\n132\t                  {{ tl.name }} &mdash;\n133\t                  {{ (t('have_it') if t is defined else 'have') if tl.have == 'owned'\n134\t                     else ((t('need_it') if t is defined else 'need') if tl.have == 'not_owned' else '?') }}\n135\t                </span>\n136\t              {% endfor %}\n137\t            </div>\n138\t          {% endif %}\n139\t        </div>\n140\t      </div>\n141\t    {% else %}\n142\t      <p class=\"muted small\">{{ t('nothing_open') if t is defined else 'Nothing open on the checklist.' }}</p>\n143\t    {% endfor %}\n144\t  </div>\n145\t\n146\t  {% if bench.shortcuts %}\n147\t    <div class=\"bench-shortcuts\">\n148\t      {% for s in bench.shortcuts %}\n149\t        <a class=\"chip plain bench-shortcut v-{{ s.status|lower|replace('_', '-') }}\"\n150\t           href=\"{{ s.href }}\">{{ s.code }}</a>\n151\t      {% endfor %}\n152\t    </div>\n153\t  {% endif %}\n154\t\n155\t  <div class=\"bench-links\">\n156\t    <a class=\"btn\" href=\"/v/{{ vin }}/job\">{{ t('job') if t is defined else 'Job' }}</a>\n157\t    <a class=\"btn\" href=\"/v/{{ vin }}/dossier\">{{ t('full_dossier') if t is defined else 'Full dossier' }}</a>\n158\t  </div>\n159\t</div>\n160\t{% endblock %}\n161\t"}]},"uuid":"eb4048b7-035e-4668-b758-1cf157b9e27b","timestamp":"2026-10-08T17:36:52.007Z","toolUseResult":{"type":"text","file":{"filePath":"C:\\Users\\User\\mcp-servers\\cuore\\web\\templates\\bench.html","content":"{# The bench: what to do to this car right now. No hero, no 12-step flow\n   bar -- cuore/services/bench_bridge.py already boiled the dossier down to\n   one verdict sentence and three cards, so this template's only job is to\n   lay those out small enough that the first card is on-screen on a\n   400x800 phone with no scrolling. See that module's own docstring for\n   where each field comes from; nothing here recomputes a verdict, a part\n   number or a tool's have/not-have status. #}\n{% extends \"base.html\" %}\n{% block title %}{{ bench.vehicle }} &mdash; Bench{% endblock %}\n\n{% block vehiclebar %}\n{% set _status_icon = {\"ACTIVE_FAULTS\": \"status_active\",\n                        \"UNVERIFIED_REPAIR\": \"status_cleared_unverified\",\n                        \"VERIFIED_CLEAN\": \"status_verified\",\n                        \"NO_DATA\": \"status_unknown\"} %}\n{% set _vstate = (bench.verdict.state or \"NO_DATA\")|lower|replace(\"_\", \"-\") %}\n<div class=\"bench-status\">\n  <span class=\"bench-status-name\">{{ bench.vehicle }}</span>\n  <span class=\"bench-status-vin mono\">&hellip;{{ bench.vin_tail }}</span>\n  {% if bench.km is not none %}\n    <span class=\"bench-status-km mono\">{{ \"{:,}\".format(bench.km|int) }} km</span>\n  {% endif %}\n  <span class=\"chip-verdict v-{{ _vstate }} bench-status-chip\">\n    {% if icon is defined %}{{ icon(_status_icon.get(bench.verdict.state, \"status_unknown\"), size=\"s\") }}{% endif %}\n    {{ bench.verdict.label }}</span>\n</div>\n{% endblock %}\n\n{% block content %}\n<style>\n/* Scoped to .bench -- no shared rule touched, so this page can be tuned\n   without risking any other page's layout. Uses the same custom\n   properties cuore.css already defines (colours/radius/mono/sans), so\n   light/dark/marque theming is inherited for free. */\n.bench-status {\n  display: flex; flex-wrap: wrap; align-items: center; gap: 8px;\n  min-height: 40px; padding: 6px var(--pad);\n  background: var(--surface); border-bottom: 1px solid var(--rule);\n}\n.bench-status-name { font-weight: 650; font-size: 14px; }\n.bench-status-vin, .bench-status-km { font-size: 12px; color: var(--ink-3); }\n.bench-status-chip { margin-left: auto; display: inline-flex; align-items: center; gap: 4px; }\n\n.bench { display: flex; flex-direction: column; gap: 10px; max-width: 100%; }\n.bench-complaint {\n  margin: 4px 0 0; font-size: 14px; font-style: italic; color: var(--ink-2);\n  overflow-wrap: anywhere;\n}\n.bench-next-action {\n  margin: 0; font-size: 20px; line-height: 1.3; font-weight: 600;\n  color: var(--ink); overflow-wrap: anywhere;\n}\n.bench-case-hint { margin: 0; }\n\n.bench-actions { display: flex; flex-direction: column; gap: 10px; }\n.bench-card {\n  display: flex; gap: 10px; align-items: flex-start;\n  background: var(--raised); border: 1px solid var(--rule);\n  border-radius: var(--radius); padding: 10px; max-width: 100%;\n}\n.bench-check { flex: none; }\n.bench-checkbox {\n  width: 44px; height: 44px; display: flex; align-items: center; justify-content: center;\n  font-size: 22px; line-height: 1; background: var(--surface-2); color: var(--ink);\n  border: 1px solid var(--rule); border-radius: var(--radius); cursor: pointer;\n}\n.bench-checkbox:hover { border-color: var(--ink-3); }\n.bench-card-body { flex: 1 1 auto; min-width: 0; display: flex; flex-direction: column; gap: 6px; }\n.bench-card-text { font-size: 15px; display: flex; align-items: center; gap: 6px; overflow-wrap: anywhere; }\n.bench-bulletin { align-self: flex-start; white-space: normal; max-width: 100%; }\n.bench-parts, .bench-tools { font-size: 12px; overflow-wrap: anywhere; }\n.bench-part { margin-right: 6px; }\n.bench-tool {\n  margin-right: 4px; margin-bottom: 4px; display: inline-block;\n  white-space: normal; max-width: 100%; overflow-wrap: anywhere;\n}\n.bench-tool.ok { color: var(--ok); background: var(--ok-bg); }\n.bench-tool.not-ok { color: var(--sev-returned); background: var(--sev-returned-bg); }\n\n.bench-shortcuts { display: flex; flex-wrap: wrap; gap: 6px; }\n.bench-shortcut { white-space: normal; }\n.bench-shortcut { text-decoration: none; }\n.bench-shortcut.v-active { color: var(--sev-returned); background: var(--sev-returned-bg); }\n.bench-shortcut.v-cleared-unverified { color: var(--sev-chronic); background: var(--sev-chronic-bg); }\n\n.bench-links { display: flex; gap: 8px; flex-wrap: wrap; padding-top: 4px; }\n</style>\n\n<div class=\"bench\" data-vin=\"{{ vin }}\">\n  {% if bench.complaint %}\n    <p class=\"bench-complaint\">&ldquo;{{ bench.complaint }}&rdquo;</p>\n  {% endif %}\n\n  {% if bench.verdict.next_action %}\n    <p class=\"bench-next-action\">{{ bench.verdict.next_action }}</p>\n  {% endif %}\n\n  {% if bench.case_hint %}\n    <p class=\"bench-case-hint small muted\">{{ bench.case_hint }}</p>\n  {% endif %}\n\n  <div class=\"bench-actions\">\n    {% for a in bench.next_actions %}\n      <div class=\"bench-card\" data-step-id=\"{{ a.step_id }}\">\n        <form method=\"post\" action=\"{{ a.href_tick }}\" class=\"bench-check\">\n          <input type=\"hidden\" name=\"step_id\" value=\"{{ a.step_id }}\">\n          <input type=\"hidden\" name=\"done\" value=\"1\">\n          <button type=\"submit\" class=\"bench-checkbox\"\n                  aria-label=\"{{ t('mark_done') if t is defined else 'Mark done' }}\"\n                  title=\"{{ t('mark_done') if t is defined else 'Mark done' }}\">&#9744;</button>\n        </form>\n        <div class=\"bench-card-body\">\n          <div class=\"bench-card-text\">\n            {% if icon is defined %}{{ icon(a.icon, size=\"s\") }}{% endif %}\n            <span>{{ a.text }}</span>\n          </div>\n          {% if a.bulletin %}\n            <span class=\"chip plain bench-bulletin\">{{ a.bulletin.id }}</span>\n          {% endif %}\n          {% if a.parts %}\n            <div class=\"bench-parts muted\">\n              {% for p in a.parts %}\n                <span class=\"bench-part\">{{ p.name }}{% if p.number %} &middot;\n                  <span class=\"mono\">{{ p.number }}</span>{% endif %}</span>\n              {% endfor %}\n            </div>\n          {% endif %}\n          {% if a.tools %}\n            <div class=\"bench-tools\">\n              {% for tl in a.tools %}\n                <span class=\"chip plain bench-tool {{ 'ok' if tl.have == 'owned' else ('not-ok' if tl.have == 'not_owned' else '') }}\">\n                  {{ tl.name }} &mdash;\n                  {{ (t('have_it') if t is defined else 'have') if tl.have == 'owned'\n                     else ((t('need_it') if t is defined else 'need') if tl.have == 'not_owned' else '?') }}\n                </span>\n              {% endfor %}\n            </div>\n          {% endif %}\n        </div>\n      </div>\n    {% else %}\n      <p class=\"muted small\">{{ t('nothing_open') if t is defined else 'Nothing open on the checklist.' }}</p>\n    {% endfor %}\n  </div>\n\n  {% if bench.shortcuts %}\n    <div class=\"bench-shortcuts\">\n      {% for s in bench.shortcuts %}\n        <a class=\"chip plain bench-shortcut v-{{ s.status|lower|replace('_', '-') }}\"\n           href=\"{{ s.href }}\">{{ s.code }}</a>\n      {% endfor %}\n    </div>\n  {% endif %}\n\n  <div class=\"bench-links\">\n    <a class=\"btn\" href=\"/v/{{ vin }}/job\">{{ t('job') if t is defined else 'Job' }}</a>\n    <a class=\"btn\" href=\"/v/{{ vin }}/dossier\">{{ t('full_dossier') if t is defined else 'Full dossier' }}</a>\n  </div>\n</div>\n{% endblock %}\n","numLines":161,"startLine":1,"totalLines":161}},"sourceToolAssistantUUID":"c3171a52-d6e0-4e36-9549-f63a7f82e456","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
{"parentUuid":"eb4048b7-035e-4668-b758-1cf157b9e27b","isSidechain":true,"agentId":"a31762a22e4ea769a","message":{"model":"claude-sonnet-5","id":"msg_011CfqB8ZV2K2udwMJoZvMq1","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01Q9JkSgETFj9oVgEogevjQD","name":"Read","input":{"file_path":"C:\\Users\\User\\mcp-servers\\cuore\\live\\checklists.py"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":7925,"cache_read_input_tokens":57441,"cache_creation":{"ephemeral_5m_input_tokens":7925,"ephemeral_1h_input_tokens":0},"output_tokens":2,"service_tier":"standard","inference_geo":"not_available"},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_01Q9JkSgETFj9oVgEogevjQD":{"file_path":"C:\\Users\\User\\mcp-servers\\cuore\\live\\checklists.py"}},"serverClassifierRequest":"f77d7f4e-237a-4563-96c8-0606b164aed5","apiBlockIndex":4,"requestId":"req_011CfqB8ZDAUVrUJjBkAdk4W","attributionAgent":"general-purpose","type":"assistant","uuid":"6b7bbfeb-5037-4dcf-a294-3d41552acfd0","timestamp":"2026-10-08T17:36:52.440Z","effort":"high","perTurnEffort":null,"userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
{"parentUuid":"6b7bbfeb-5037-4dcf-a294-3d41552acfd0","isSidechain":true,"promptId":"14b8b90f-0c4b-47b6-b2bf-3803814525db","agentId":"a31762a22e4ea769a","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Q9JkSgETFj9oVgEogevjQD","type":"tool_result","content":"1\t\"\"\"Shop-visible checklist state: has a family-finding step been ticked off.\n2\t\n3\tSame shape of small store as ``cuore.live.store`` (one JSON file, guarded by\n4\ta lock, read-modify-write) but kept in its own module rather than added to\n5\tthat one: this is dossier state (what has a technician done about an open\n6\tfinding), not live-link state (what the car itself has said).\n7\t\n8\t``vin -> step_id -> {done, done_at, done_by}``. Shared across whoever reads\n9\tthis state dir, not per-browser -- ticking a step off on the shop tablet must\n10\tshow up on the office terminal too, which is why this is a file beside\n11\t``addresses.json`` and not ``localStorage``.\n12\t\"\"\"\n13\t\n14\tfrom __future__ import annotations\n15\t\n16\timport json\n17\timport threading\n18\tfrom datetime import datetime\n19\tfrom pathlib import Path\n20\tfrom typing import Any\n21\t\n22\tfrom .config import state_dir\n23\t\n24\t_LOCK = threading.Lock()\n25\t\n26\t\n27\tdef path() -> Path:\n28\t    return state_dir() / \"checklists.json\"\n29\t\n30\t\n31\tdef _load() -> dict[str, Any]:\n32\t    try:\n33\t        return json.loads(path().read_text(encoding=\"utf-8\"))\n34\t    except (OSError, ValueError):\n35\t        return {}\n36\t\n37\t\n38\tdef _save(data: dict[str, Any]) -> None:\n39\t    try:\n40\t        path().write_text(json.dumps(data, indent=2), encoding=\"utf-8\")\n41\t    except OSError:\n42\t        pass\n43\t\n44\t\n45\tdef get(vin: str) -> dict[str, Any]:\n46\t    \"\"\"``{step_id: {done, done_at, done_by}}`` recorded for this VIN.\"\"\"\n47\t    with _LOCK:\n48\t        return dict(_load().get(vin, {}))\n49\t\n50\t\n51\tdef set_step(vin: str, step_id: str, done: bool, by: str = \"\") -> dict[str, Any]:\n52\t    \"\"\"Record one step's state. Returns the stored entry for that step.\"\"\"\n53\t    with _LOCK:\n54\t        data = _load()\n55\t        entry = data.setdefault(vin, {})\n56\t        entry[step_id] = {\n57\t            \"done\": bool(done),\n58\t            \"done_at\": datetime.now().isoformat(timespec=\"seconds\") if done else None,\n59\t            \"done_by\": (by.strip() or None) if (done and by.strip()) else None,\n60\t        }\n61\t        _save(data)\n62\t        return dict(entry[step_id])\n63\t\n64\t\n65\t__all__ = [\"path\", \"get\", \"set_step\"]\n66\t"}]},"uuid":"3485366e-f25b-4214-b4ab-346cd3a89d99","timestamp":"2026-10-08T17:36:52.473Z","toolUseResult":{"type":"text","file":{"filePath":"C:\\Users\\User\\mcp-servers\\cuore\\live\\checklists.py","content":"\"\"\"Shop-visible checklist state: has a family-finding step been ticked off.\n\nSame shape of small store as ``cuore.live.store`` (one JSON file, guarded by\na lock, read-modify-write) but kept in its own module rather than added to\nthat one: this is dossier state (what has a technician done about an open\nfinding), not live-link state (what the car itself has said).\n\n``vin -> step_id -> {done, done_at, done_by}``. Shared across whoever reads\nthis state dir, not per-browser -- ticking a step off on the shop tablet must\nshow up on the office terminal too, which is why this is a file beside\n``addresses.json`` and not ``localStorage``.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport json\nimport threading\nfrom datetime import datetime\nfrom pathlib import Path\nfrom typing import Any\n\nfrom .config import state_dir\n\n_LOCK = threading.Lock()\n\n\ndef path() -> Path:\n    return state_dir() / \"checklists.json\"\n\n\ndef _load() -> dict[str, Any]:\n    try:\n        return json.loads(path().read_text(encoding=\"utf-8\"))\n    except (OSError, ValueError):\n        return {}\n\n\ndef _save(data: dict[str, Any]) -> None:\n    try:\n        path().write_text(json.dumps(data, indent=2), encoding=\"utf-8\")\n    except OSError:\n        pass\n\n\ndef get(vin: str) -> dict[str, Any]:\n    \"\"\"``{step_id: {done, done_at, done_by}}`` recorded for this VIN.\"\"\"\n    with _LOCK:\n        return dict(_load().get(vin, {}))\n\n\ndef set_step(vin: str, step_id: str, done: bool, by: str = \"\") -> dict[str, Any]:\n    \"\"\"Record one step's state. Returns the stored entry for that step.\"\"\"\n    with _LOCK:\n        data = _load()\n        entry = data.setdefault(vin, {})\n        entry[step_id] = {\n            \"done\": bool(done),\n            \"done_at\": datetime.now().isoformat(timespec=\"seconds\") if done else None,\n            \"done_by\": (by.strip() or None) if (done and by.strip()) else None,\n        }\n        _save(data)\n        return dict(entry[step_id])\n\n\n__all__ = [\"path\", \"get\", \"set_step\"]\n","numLines":66,"startLine":1,"totalLines":66}},"sourceToolAssistantUUID":"6b7bbfeb-5037-4dcf-a294-3d41552acfd0","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
{"parentUuid":"3485366e-f25b-4214-b4ab-346cd3a89d99","isSidechain":true,"agentId":"a31762a22e4ea769a","message":{"model":"claude-sonnet-5","id":"msg_011CfqB8ZV2K2udwMJoZvMq1","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_015r51rh9QynCuoicARrLzzS","name":"Read","input":{"file_path":"C:\\Users\\User\\mcp-servers\\cuore\\api\\checklists.py"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":7925,"cache_read_input_tokens":57441,"cache_creation":{"ephemeral_5m_input_tokens":7925,"ephemeral_1h_input_tokens":0},"output_tokens":2,"service_tier":"standard","inference_geo":"not_available"},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_015r51rh9QynCuoicARrLzzS":{"file_path":"C:\\Users\\User\\mcp-servers\\cuore\\api\\checklists.py"}},"serverClassifierRequest":"f77d7f4e-237a-4563-96c8-0606b164aed5","apiBlockIndex":5,"requestId":"req_011CfqB8ZDAUVrUJjBkAdk4W","attributionAgent":"general-purpose","type":"assistant","uuid":"90daeea0-6ae4-4d5e-b1f5-d51d9648a55f","timestamp":"2026-10-08T17:36:52.847Z","effort":"high","perTurnEffort":null,"userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
{"parentUuid":"90daeea0-6ae4-4d5e-b1f5-d51d9648a55f","isSidechain":true,"promptId":"14b8b90f-0c4b-47b6-b2bf-3803814525db","agentId":"a31762a22e4ea769a","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_015r51rh9QynCuoicARrLzzS","type":"tool_result","content":"1\t\"\"\"Shop-visible checklist state over HTTP: GET/POST one step at a time.\n2\t\n3\tA step id is only meaningful in the context of the vehicle whose open-work\n4\tcards named it (``dossier_bridge.checklist_step_ids``), so a POST for a step\n5\tid this VIN's dossier does not expose is rejected -- a 400, not a silent\n6\tno-op and not a 500.\n7\t\"\"\"\n8\t\n9\tfrom __future__ import annotations\n10\t\n11\tfrom typing import Any\n12\t\n13\tfrom fastapi import APIRouter, Depends\n14\tfrom pydantic import BaseModel, Field\n15\t\n16\tfrom ..live import checklists as checklist_store\n17\tfrom ..services import cache, dossier_bridge, mes_bridge\n18\tfrom ..services.errors import BadRequest\n19\tfrom .deps import require_token\n20\t\n21\trouter = APIRouter(tags=[\"vehicles\"], dependencies=[Depends(require_token)])\n22\t\n23\t\n24\tclass ChecklistUpdate(BaseModel):\n25\t    step_id: str = Field(..., description=\"e.g. evap-1, network-2 -- see \"\n26\t                                          \"GET /api/vehicles/{vin}/view -> \"\n27\t                                          \"open_work[].steps[].id\")\n28\t    done: bool\n29\t    by: str = Field(default=\"\", description=\"technician name/initials, optional\")\n30\t\n31\t\n32\tdef _dossier(vin: str) -> dict[str, Any]:\n33\t    return cache.get_or_build(\n34\t        (\"workup\", vin, mes_bridge.newest_mtime(vin)),\n35\t        lambda: mes_bridge.workup(vin=vin))\n36\t\n37\t\n38\t@router.get(\"/vehicles/{vin}/checklist\", summary=\"Checklist state for this vehicle\")\n39\tdef get_checklist(vin: str) -> dict[str, Any]:\n40\t    return {\"vin\": vin, \"checklist\": checklist_store.get(vin)}\n41\t\n42\t\n43\t@router.post(\"/vehicles/{vin}/checklist\", summary=\"Tick (or untick) one checklist step\")\n44\tdef set_checklist_step(vin: str, body: ChecklistUpdate) -> dict[str, Any]:\n45\t    valid = dossier_bridge.checklist_step_ids(vin, _dossier(vin))\n46\t    if body.step_id not in valid:\n47\t        raise BadRequest(f\"unknown checklist step id {body.step_id!r} for this vehicle\")\n48\t    entry = checklist_store.set_step(vin, body.step_id, body.done, by=body.by)\n49\t    return {\"vin\": vin, \"step_id\": body.step_id, **entry}\n50\t\n51\t\n52\t__all__ = [\"router\"]\n53\t"}]},"uuid":"c7b35334-b37e-40f1-b255-cef2b3a7e7b4","timestamp":"2026-10-08T17:36:52.866Z","toolUseResult":{"type":"text","file":{"filePath":"C:\\Users\\User\\mcp-servers\\cuore\\api\\checklists.py","content":"\"\"\"Shop-visible checklist state over HTTP: GET/POST one step at a time.\n\nA step id is only meaningful in the context of the vehicle whose open-work\ncards named it (``dossier_bridge.checklist_step_ids``), so a POST for a step\nid this VIN's dossier does not expose is rejected -- a 400, not a silent\nno-op and not a 500.\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom typing import Any\n\nfrom fastapi import APIRouter, Depends\nfrom pydantic import BaseModel, Field\n\nfrom ..live import checklists as checklist_store\nfrom ..services import cache, dossier_bridge, mes_bridge\nfrom ..services.errors import BadRequest\nfrom .deps import require_token\n\nrouter = APIRouter(tags=[\"vehicles\"], dependencies=[Depends(require_token)])\n\n\nclass ChecklistUpdate(BaseModel):\n    step_id: str = Field(..., description=\"e.g. evap-1, network-2 -- see \"\n                                          \"GET /api/vehicles/{vin}/view -> \"\n                                          \"open_work[].steps[].id\")\n    done: bool\n    by: str = Field(default=\"\", description=\"technician name/initials, optional\")\n\n\ndef _dossier(vin: str) -> dict[str, Any]:\n    return cache.get_or_build(\n        (\"workup\", vin, mes_bridge.newest_mtime(vin)),\n        lambda: mes_bridge.workup(vin=vin))\n\n\n@router.get(\"/vehicles/{vin}/checklist\", summary=\"Checklist state for this vehicle\")\ndef get_checklist(vin: str) -> dict[str, Any]:\n    return {\"vin\": vin, \"checklist\": checklist_store.get(vin)}\n\n\n@router.post(\"/vehicles/{vin}/checklist\", summary=\"Tick (or untick) one checklist step\")\ndef set_checklist_step(vin: str, body: ChecklistUpdate) -> dict[str, Any]:\n    valid = dossier_bridge.checklist_step_ids(vin, _dossier(vin))\n    if body.step_id not in valid:\n        raise BadRequest(f\"unknown checklist step id {body.step_id!r} for this vehicle\")\n    entry = checklist_store.set_step(vin, body.step_id, body.done, by=body.by)\n    return {\"vin\": vin, \"step_id\": body.step_id, **entry}\n\n\n__all__ = [\"router\"]\n","numLines":53,"startLine":1,"totalLines":53}},"sourceToolAssistantUUID":"90daeea0-6ae4-4d5e-b1f5-d51d9648a55f","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
{"parentUuid":"c7b35334-b37e-40f1-b255-cef2b3a7e7b4","isSidechain":true,"agentId":"a31762a22e4ea769a","message":{"model":"claude-sonnet-5","id":"msg_011CfqB8ZV2K2udwMJoZvMq1","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01Mz38A67UQteJ9WFnAK8Cm6","name":"Read","input":{"file_path":"C:\\Users\\User\\mcp-servers\\cuore\\services\\dossier_bridge.py"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":7925,"cache_read_input_tokens":57441,"cache_creation":{"ephemeral_5m_input_tokens":7925,"ephemeral_1h_input_tokens":0},"output_tokens":2,"service_tier":"standard","inference_geo":"not_available"},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_01Mz38A67UQteJ9WFnAK8Cm6":{"file_path":"C:\\Users\\User\\mcp-servers\\cuore\\services\\dossier_bridge.py"}},"serverClassifierRequest":"f77d7f4e-237a-4563-96c8-0606b164aed5","apiBlockIndex":6,"requestId":"req_011CfqB8ZDAUVrUJjBkAdk4W","attributionAgent":"general-purpose","type":"assistant","uuid":"7b563b5c-9a9a-4042-bddf-ac3d1e22da0f","timestamp":"2026-10-08T17:36:53.381Z","effort":"high","perTurnEffort":null,"userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
{"parentUuid":"7b563b5c-9a9a-4042-bddf-ac3d1e22da0f","isSidechain":true,"promptId":"14b8b90f-0c4b-47b6-b2bf-3803814525db","agentId":"a31762a22e4ea769a","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Mz38A67UQteJ9WFnAK8Cm6","type":"tool_result","content":"1\t\"\"\"Turns the raw workup dossier into the redesigned dossier page's contract.\n2\t\n3\tMECHANIC_UX_REVIEW.md's R1/R4/R5/R6/R7/R8/R9 all boil down to the same\n4\tcomplaint: the knowledge in ``mes.workup`` is already senior-technician-grade\n5\t(family findings, chronic/returned classification, TSB cross-reference) but\n6\tthe page made the mechanic excavate it from prose and raw dicts. Nothing here\n7\tre-derives that knowledge -- it only reshapes what ``mes_bridge.workup``\n8\talready returns (plus what the live link has observed) into the verdict,\n9\tchecklists, code table, freeze-frame flags, deduplicated bulletins and\n10\trunnable blind-spot actions the template needs, so there is exactly one\n11\tplace that decides what a status chip or a checklist step means.\n12\t\n13\t``build_view`` is the only entry point. Everything else is a private helper.\n14\t\n15\tLike every other file under ``cuore/services``, this is a *_bridge.py module,\n16\tso it is allowed to import ``mes_bridge`` (never the ``mes`` package itself --\n17\tnothing here needs to; the workup dict already carries what ``mes`` computed)\n18\tand the small read-only ``cuore.live`` surfaces (``store`` for live\n19\tobservations, ``checklists`` for shop-ticked steps).\n20\t\"\"\"\n21\t\n22\tfrom __future__ import annotations\n23\t\n24\timport re\n25\tfrom datetime import datetime\n26\tfrom typing import Any\n27\t\n28\tfrom . import cache, mes_bridge\n29\tfrom .errors import BridgeError\n30\tfrom ..live import checklists as checklist_store\n31\tfrom ..live import config as live_config\n32\tfrom ..live import store as live_store\n33\t\n34\t#: EVAP monitor runs at 15-85% fuel; cited wherever a freeze frame needs\n35\t#: flagging. Matches the window ``mes`` itself states in verdict/fault-tree\n36\t#: text -- not re-derived, just applied to one more surface.\n37\t_EVAP_FUEL_WINDOW = (15.0, 85.0)\n38\t_EVAP_CODES = {\"P0440\", \"P0441\", \"P0455\", \"P0456\", \"P1CEA\"}\n39\t\n40\t_SYSTEM_BY_LETTER = {\"P\": \"engine\", \"C\": \"chassis\", \"B\": \"body\", \"U\": \"network\"}\n41\t\n42\t_STATUS_LABEL = {\"ACTIVE\": \"Active\", \"CLEARED_UNVERIFIED\": \"Cleared, unverified\",\n43\t                \"STALE\": \"Stale\"}\n44\t\n45\t#: Freeze-frame parameters worth a mechanic's first glance, in the order\n46\t#: they should appear. Everything else still rides along in ``all``.\n47\t_KEY_FRAME_PARAMS = [\"Fuel level\", \"Engine temperature\", \"Odometer\",\n48\t                     \"Vehicle speed\", \"Engine speed\", \"Air temperature\"]\n49\t\n50\t#: One checklist per family this corpus's fault trees and TSBs recognise\n51\t#: today. Transcribed once, here, from the family finding's own \"reading\"\n52\t#: text and the EVAP/network fault trees -- see MECHANIC_UX_REVIEW.md R4.\n53\t#: Keeping this as a table (not free-text parsing of ``reading``) is what\n54\t#: makes checklist step ids stable across a wording change in ``mes``.\n55\tFAMILY_STEPS: dict[str, list[dict[str, Any]]] = {\n56\t    \"EVAP\": [\n57\t        {\"id\": \"evap-1\", \"text\": \"Inspect the recirculation-line quick-connect\",\n58\t         \"ref\": \"S2125000002\"},\n59\t        {\"id\": \"evap-2\", \"text\": \"Run the purge/vent valve KOEO actuator test\",\n60\t         \"ref\": None},\n61\t        {\"id\": \"evap-3\", \"text\": \"Check hose routing\", \"ref\": \"9100325\"},\n62\t        {\"id\": \"evap-4\", \"text\": \"Inspect the canister/ESIM\", \"ref\": \"9100471\"},\n63\t        {\"id\": \"evap-5\", \"text\": \"Run a smoke test to localise the leak\",\n64\t         \"ref\": None},\n65\t        {\"id\": \"evap-6\", \"text\": \"Verify with SLVT or Mode $06\",\n66\t         \"ref\": \"18-048-23\"},\n67\t    ],\n68\t    \"network\": [\n69\t        {\"id\": \"network-1\", \"text\": \"Check the supply: F82 fuse and BCM feeds\",\n70\t         \"ref\": \"S1808000005\"},\n71\t        {\"id\": \"network-2\",\n72\t         \"text\": \"Inspect connectors/grounds: XY201, G003A/B\",\n73\t         \"ref\": \"S2008000032\"},\n74\t        {\"id\": \"network-3\",\n75\t         \"text\": \"Inspect connector terminals for spread/backed-out pins\",\n76\t         \"ref\": \"S1708000262\"},\n77\t    ],\n78\t}\n79\t\n80\t_FAMILY_TITLES = {\n81\t    \"EVAP\": \"EVAP: one system fault\",\n82\t    \"network\": \"Network: one power/bus event, not {n} separate faults\",\n83\t}\n84\t\n85\t#: EVAP was the first job this cuore app diagnosed, so it (and the network\n86\t#: cascade) got a hand-curated ``FAMILY_STEPS`` table above. Every other\n87\t#: family this car's history can throw -- misfire, fuel trim, cooling, body,\n88\t#: chassis, ADAS, or anything else SAE's DTC-prefix convention covers --\n89\t#: still needs an open-work card; :func:`_build_open_work` builds those\n90\t#: generically, grouping codes by the family below and pulling steps live\n91\t#: from ``mes_bridge.fault_tree`` (``mes.faulttree.tree_for`` -- the\n92\t#: hand-written tree when one exists, else a sourced generated one) instead\n93\t#: of a second hand-maintained step table. Patterns are checked in order;\n94\t#: the first match wins. Generalised from the same SAE J2012 prefix-range\n95\t#: convention ``mes.systems._sae_fallback`` already uses.\n96\t_GENERIC_FAMILY_RULES: tuple[tuple[re.Pattern, str, str], ...] = (\n97\t    (re.compile(r\"^P030[0-9]$\"), \"misfire\", \"Misfire\"),\n98\t    (re.compile(r\"^P017[0-5]$\"), \"fuel_trim\", \"Fuel trim\"),\n99\t    (re.compile(r\"^P01(0[0-9]|1[0-9]|2[0-9])$\"), \"cooling\",\n100\t     \"Cooling / intake sensors\"),\n101\t    (re.compile(r\"^P0[67][0-9]{2}$\"), \"engine_management\", \"Engine management\"),\n102\t    (re.compile(r\"^P0[89][0-9]{2}$\"), \"transmission_driveline\",\n103\t     \"Transmission / driveline\"),\n104\t    (re.compile(r\"^C(141B|141C)$\"), \"adas\", \"ADAS (camera/radar)\"),\n105\t    (re.compile(r\"^C[0-9A-F]{4}$\"), \"chassis\", \"Chassis (brakes/steering/suspension)\"),\n106\t    (re.compile(r\"^B[0-9A-F]{4}$\"), \"body\", \"Body / comfort\"),\n107\t    (re.compile(r\"^U[0-9A-F]{4}$\"), \"network\", \"Network / communication\"),\n108\t    (re.compile(r\"^P[0-9A-F]{4}$\"), \"powertrain_other\", \"Powertrain (other)\"),\n109\t)\n110\t\n111\t\n112\tdef _generic_family_for(base: str) -> tuple[str, str] | None:\n113\t    \"\"\"``(family_key, family_label)`` for a code with no hand-curated\n114\t    ``FAMILY_STEPS`` entry, or ``None`` for something that isn't a\n115\t    recognisable P/B/C/U code at all.\"\"\"\n116\t    for pattern, key, label in _GENERIC_FAMILY_RULES:\n117\t        if pattern.match(base):\n118\t            return key, label\n119\t    return None\n120\t\n121\t\n122\tdef _history_codes(dossier: dict[str, Any]) -> set[str]:\n123\t    \"\"\"Every base code present anywhere in this car's own history -- the\n124\t    same ``chronic``/``returned_after_clear``/``seen_once`` buckets the code\n125\t    table reads -- so a generic open-work card can be offered for a family\n126\t    the TSB family-finding rule above doesn't recognise.\"\"\"\n127\t    history = dossier.get(\"history\") or {}\n128\t    out: set[str] = set()\n129\t    for bucket in (\"chronic\", \"returned_after_clear\", \"seen_once\"):\n130\t        for rec in history.get(bucket, []):\n131\t            b = _base(rec.get(\"dtc\", \"\"))\n132\t            if b:\n133\t                out.add(b)\n134\t    return out\n135\t\n136\t\n137\tdef _generic_tree_steps(code: str, vin: str) -> list[dict[str, Any]]:\n138\t    \"\"\"The first tree's steps for one code, via ``mes_bridge.fault_tree`` --\n139\t    the hand-written tree when ``mes.faulttree.tree_for`` has one, else its\n140\t    sourced generated tree. Never raises: a lookup failure just means no\n141\t    generic card gets built for that code.\"\"\"\n142\t    try:\n143\t        result = mes_bridge.fault_tree(code, vin=vin)\n144\t    except Exception:\n145\t        return []\n146\t    trees = result.get(\"trees\") or []\n147\t    return trees[0].get(\"steps\") or [] if trees else []\n148\t\n149\t\n150\t# --- small shared helpers --------------------------------------------------\n151\t\n152\t\n153\tdef _base(code: str) -> str:\n154\t    \"\"\"\"P0440-00\" -> \"P0440\". Same rule as ``mes.knowledge.base_code``,\n155\t    reimplemented here rather than imported so this module never touches the\n156\t    ``mes`` package directly.\"\"\"\n157\t    code = (code or \"\").strip().upper()\n158\t    return code.split(\"-\", 1)[0] if \"-\" in code else code\n159\t\n160\t\n161\tdef _slug(text: str) -> str:\n162\t    return re.sub(r\"[^A-Za-z0-9]+\", \"-\", (text or \"\").strip()).strip(\"-\")\n163\t\n164\t\n165\tdef _parse_ts(ts: str | None) -> datetime | None:\n166\t    if not ts:\n167\t        return None\n168\t    try:\n169\t        return datetime.strptime(str(ts)[:19], \"%Y-%m-%d %H:%M:%S\")\n170\t    except ValueError:\n171\t        return None\n172\t\n173\t\n174\tdef _short_date(ts: str | None, with_time: bool = False) -> str | None:\n175\t    dt = _parse_ts(ts)\n176\t    if dt is None:\n177\t        return None\n178\t    fmt = \"%d %b %H:%M\" if with_time else \"%d %b\"\n179\t    if dt.year != datetime.now().year:\n180\t        fmt += \" '%y\"\n181\t    return dt.strftime(fmt)\n182\t\n183\t\n184\tdef _num(display: Any) -> float | None:\n185\t    \"\"\"Pull the leading number out of a display string like \"93.73 %\".\"\"\"\n186\t    if display is None:\n187\t        return None\n188\t    m = re.match(r\"\\s*(-?\\d+(?:\\.\\d+)?)\", str(display))\n189\t    return float(m.group(1)) if m else None\n190\t\n191\t\n192\tdef _state_fingerprint() -> float:\n193\t    \"\"\"Newest mtime across this app's mutable state files.\n194\t\n195\t    Checklists, jobs, shop visits, symptoms, notes, dealer results, tool\n196\t    usage, live observations and the rest are all flat files sitting\n197\t    directly under one shared directory -- every ``mes.*``/``cuore.live``\n198\t    state module mirrors ``cuore.live.config.state_dir()`` (see each\n199\t    module's own ``state_dir()`` docstring). Folded into\n200\t    :func:`build_view`'s cache key so a ticked checklist step or a freshly\n201\t    logged symptom invalidates the cached open-work/freeze-frame/attempted\n202\t    build the same way a new MES log invalidates ``mes_bridge.newest_mtime``\n203\t    -- no separate invalidation hook, same reasoning as ``cuore.services.cache``\n204\t    itself.\n205\t    \"\"\"\n206\t    try:\n207\t        d = live_config.state_dir()\n208\t        return max((p.stat().st_mtime for p in d.iterdir() if p.is_file()), default=0.0)\n209\t    except OSError:\n210\t        return 0.0\n211\t\n212\t\n213\tdef live_available(live_status: dict[str, Any] | None) -> bool:\n214\t    \"\"\"Is the adapter reachable right now -- a port configured, and neither\n215\t    MultiEcuScan nor another process holding it.\n216\t\n217\t    Same read ``base.html``'s live strip and ``/live`` already make of\n218\t    ``live_ops.status()``: ``mes_state == \"connected\"`` means MES has the\n219\t    port, and a ``lock_holder`` other than this process means something else\n220\t    does. Used both to grey out the dossier's own action buttons and by\n221\t    ``/v/{vin}/verify`` to decide whether it is safe to actually read.\n222\t    \"\"\"\n223\t    if not live_status or live_status.get(\"error\"):\n224\t        return False\n225\t    if not live_status.get(\"port\"):\n226\t        return False\n227\t    if live_status.get(\"mes_state\") == \"connected\":\n228\t        return False\n229\t    holder = live_status.get(\"lock_holder\")\n230\t    if holder and holder != \"cuore\":\n231\t        return False\n232\t    return True\n233\t\n234\t\n235\t# --- the last clear ---------------------------------------------------------\n236\t\n237\t\n238\tdef _clear_info(dossier: dict[str, Any]\n239\t                ) -> tuple[str | None, str | None, dict[str, Any] | None]:\n240\t    \"\"\"(cleared_at full timestamp, cleared_by file, the clear_assessment dict).\n241\t\n242\t    ``current_picture.clear_assessment`` comes from two different shapes in\n243\t    ``mes.workup``: a scan-based clear carries its own ``cleared_at``/\n244\t    ``source``; a clear inside the anchored FES session itself carries\n245\t    neither, because *that session* is the clear -- so its timestamp/file are\n246\t    read off ``latest_session`` instead.\n247\t    \"\"\"\n248\t    cp = dossier.get(\"current_picture\") or {}\n249\t    ca = cp.get(\"clear_assessment\")\n250\t    if not ca:\n251\t        return None, None, None\n252\t    cleared_at = ca.get(\"cleared_at\")\n253\t    cleared_by = ca.get(\"source\")\n254\t    if not cleared_at:\n255\t        latest = cp.get(\"latest_session\") or {}\n256\t        cleared_at = latest.get(\"timestamp\")\n257\t        cleared_by = latest.get(\"file\")\n258\t    return cleared_at, cleared_by, ca\n259\t\n260\t\n261\t# --- readiness, read from the car -------------------------------------------\n262\t\n263\t\n264\tdef _latest_readiness(vin: str, after: str | None) -> dict[str, Any] | None:\n265\t    \"\"\"The newest readiness observation from the car itself, after ``after``.\n266\t\n267\t    A read taken before the clear says nothing about the car now -- the same\n268\t    reasoning ``mes.verdict._last_clear`` already applies to live DTC reads.\n269\t    \"\"\"\n270\t    try:\n271\t        obs = live_store.recent_observations(200, vin=vin, kind=\"readiness\")\n272\t    except Exception:  # noqa: BLE001 -- a broken store must never break the verdict\n273\t        return None\n274\t    best = None\n275\t    for o in obs:\n276\t        if not live_store.is_from_car(o):\n277\t            continue\n278\t        at = o.get(\"at\") or \"\"\n279\t        if after and at <= after:\n280\t            continue\n281\t        if best is None or at > (best.get(\"at\") or \"\"):\n282\t            best = o\n283\t    return best\n284\t\n285\t\n286\tdef readiness_result(raw: dict[str, Any]) -> dict[str, Any]:\n287\t    \"\"\"Shape a live ``ops.obd_readiness()`` read for ``/v/{vin}/verify``.\n288\t\n289\t    ``verify.html`` destructures ``result.at`` / ``result.evap_monitor`` /\n290\t    ``result.all_complete`` / ``result.monitors`` explicitly (never the raw\n291\t    dict) -- this is the one place that produces that flat shape from the\n292\t    nested ``since_clear``/``monitors`` payload ``ops.obd_readiness``\n293\t    returns, so the page and the verdict's own ``readiness`` sub-object\n294\t    agree on what \"the EVAP monitor is complete\" means.\n295\t    \"\"\"\n296\t    since = raw.get(\"since_clear\") or {}\n297\t    monitors = since.get(\"monitors\") or []\n298\t    evap = next((m for m in monitors if m.get(\"monitor\") == \"Evaporative system\"), None)\n299\t    return {\n300\t        \"at\": datetime.now().isoformat(timespec=\"seconds\"),\n301\t        \"evap_monitor\": bool(evap and evap.get(\"complete\")),\n302\t        \"all_complete\": bool(since.get(\"all_complete\")),\n303\t        \"monitors\": [{\"name\": m.get(\"monitor\"), \"complete\": bool(m.get(\"complete\"))}\n304\t                     for m in monitors],\n305\t    }\n306\t\n307\t\n308\tdef _evap_from_readiness(obs: dict[str, Any] | None) -> dict[str, Any] | None:\n309\t    if obs is None:\n310\t        return None\n311\t    data = obs.get(\"data\") or {}\n312\t    since = data.get(\"since_clear\") or {}\n313\t    monitors = since.get(\"monitors\") or []\n314\t    evap = next((m for m in monitors if m.get(\"monitor\") == \"Evaporative system\"), None)\n315\t    if not monitors:\n316\t        state = None\n317\t    elif evap is None:\n318\t        state = \"not_supported\"\n319\t    else:\n320\t        state = \"complete\" if evap.get(\"complete\") else \"incomplete\"\n321\t    return {\"at\": obs.get(\"at\"), \"evap_monitor\": state,\n322\t            \"all_complete\": bool(since.get(\"all_complete\"))}\n323\t\n324\t\n325\t# --- verdict -----------------------------------------------------------------\n326\t\n327\t\n328\tdef _verdict_actions(vin: str, enabled: bool) -> list[dict[str, Any]]:\n329\t    hint = \"\" if enabled else \"connect the car (ELM327 on COM3)\"\n330\t    return [\n331\t        {\"label\": \"Verify repair\", \"kind\": \"readiness\", \"href\": f\"/v/{vin}/verify\",\n332\t         \"enabled\": enabled, \"hint\": hint},\n333\t        {\"label\": \"EVAP fault tree\", \"kind\": \"link\", \"href\": f\"/v/{vin}/tree\",\n334\t         \"enabled\": True, \"hint\": \"\"},\n335\t        {\"label\": \"Evidence gate\", \"kind\": \"link\", \"href\": f\"/v/{vin}/gate\",\n336\t         \"enabled\": True, \"hint\": \"\"},\n337\t    ]\n338\t\n339\t\n340\tdef _verdict_summary(state: str, open_work: list[dict[str, Any]],\n341\t                     cleared_at: str | None, dossier: dict[str, Any]) -> str:\n342\t    if open_work:\n343\t        codes = open_work[0][\"codes\"][:3]\n344\t    else:\n345\t        chronic = (dossier.get(\"history\") or {}).get(\"chronic\") or []\n346\t        codes = sorted({_base(r.get(\"dtc\", \"\")) for r in chronic})[:3]\n347\t    code_str = \"/\".join(codes) if codes else \"the logged codes\"\n348\t    cleared_short = _short_date(cleared_at) if cleared_at else None\n349\t\n350\t    if state == \"NO_DATA\":\n351\t        return \"No MES logs on file for this vehicle.\"\n352\t    if state == \"ACTIVE_FAULTS\":\n353\t        return f\"{code_str} active now -- not cleared, not resolved.\"\n354\t    if state == \"VERIFIED_CLEAN\":\n355\t        return f\"{code_str} cleared {cleared_short}; EVAP monitor ran clean. Repair verified.\"\n356\t    return f\"{code_str} cleared {cleared_short}; monitors have not re-run. Not proof of repair.\"\n357\t\n358\t\n359\tdef _build_verdict(vin: str, dossier: dict[str, Any], live_status: dict[str, Any] | None,\n360\t                   open_work: list[dict[str, Any]]) -> dict[str, Any]:\n361\t    identity = dossier.get(\"identity\") or {}\n362\t    enabled = live_available(live_status)\n363\t\n364\t    if not identity.get(\"log_count\"):\n365\t        return {\"state\": \"NO_DATA\", \"label\": \"No data\",\n366\t                \"summary\": \"No MES logs on file for this vehicle.\",\n367\t                \"basis\": [\"no logs matched this VIN\"],\n368\t                \"cleared_at\": None, \"cleared_by\": None, \"readiness\": None,\n369\t                \"actions\": _verdict_actions(vin, enabled)}\n370\t\n371\t    cp = dossier.get(\"current_picture\") or {}\n372\t    history = dossier.get(\"history\") or {}\n373\t    cleared_at, cleared_by, clear_assessment = _clear_info(dossier)\n374\t\n375\t    basis: list[str] = []\n376\t    active = False\n377\t\n378\t    latest_session = cp.get(\"latest_session\") or {}\n379\t    if (cleared_at and latest_session.get(\"timestamp\")\n380\t            and latest_session.get(\"timestamp\") > cleared_at\n381\t            and latest_session.get(\"dtcs\")):\n382\t        active = True\n383\t        basis.append(f\"newest session ({latest_session['timestamp']}) holds DTCs \"\n384\t                     f\"after the {cleared_at} clear\")\n385\t\n386\t    latest_scan = cp.get(\"latest_scan\") or {}\n387\t    if (cleared_at and latest_scan.get(\"timestamp\")\n388\t            and latest_scan.get(\"timestamp\") > cleared_at\n389\t            and latest_scan.get(\"modules_with_faults\")):\n390\t        active = True\n391\t        basis.append(f\"newest scan ({latest_scan['timestamp']}) holds DTCs \"\n392\t                     f\"after the {cleared_at} clear\")\n393\t\n394\t    returned_in_session = (clear_assessment or {}).get(\"codes_returned_in_session\") or []\n395\t    if returned_in_session:\n396\t        active = True\n397\t        basis.append(\"codes returned in the clearing session: \"\n398\t                     + \", \".join(returned_in_session))\n399\t\n400\t    uncleared = (clear_assessment or {}).get(\"codes_that_would_not_clear\") or []\n401\t    if uncleared:\n402\t        active = True\n403\t        basis.append(\"codes would not clear: \" + \", \".join(uncleared))\n404\t\n405\t    if history.get(\"returned_after_clear\"):\n406\t        active = True\n407\t        basis.append(\"returned after a clear: \" + \", \".join(\n408\t            sorted(_base(r.get(\"dtc\", \"\")) for r in history[\"returned_after_clear\"])))\n409\t\n410\t    readiness = None\n411\t    if cleared_at:\n412\t        readiness = _evap_from_readiness(_latest_readiness(vin, cleared_at))\n413\t\n414\t    if active:\n415\t        state, label = \"ACTIVE_FAULTS\", \"Active faults\"\n416\t    elif cleared_at is None:\n417\t        if history.get(\"chronic\"):\n418\t            state, label = \"ACTIVE_FAULTS\", \"Active faults\"\n419\t            basis.append(\"chronic codes on file and no clear recorded\")\n420\t        else:\n421\t            state, label = \"NO_DATA\", \"No data\"\n422\t            basis.append(\"no open codes and no clear on file\")\n423\t    elif readiness and readiness.get(\"evap_monitor\") == \"complete\":\n424\t        state, label = \"VERIFIED_CLEAN\", \"Verified clean\"\n425\t        basis.append(f\"EVAP monitor complete on a live read at {readiness['at']}, \"\n426\t                     f\"no code has returned since the {cleared_at} clear\")\n427\t    else:\n428\t        state, label = \"UNVERIFIED_REPAIR\", \"Unverified repair\"\n429\t        basis.append(f\"last clear {cleared_at} ({cleared_by or 'unknown source'}); \"\n430\t                     f\"no code has returned\")\n431\t        if readiness is None:\n432\t            basis.append(\"no readiness read from the car since the clear\")\n433\t        else:\n434\t            basis.append(f\"readiness read at {readiness['at']} -- EVAP monitor \"\n435\t                         f\"{readiness.get('evap_monitor') or 'unknown'}\")\n436\t\n437\t    return {\n438\t        \"state\": state, \"label\": label,\n439\t        \"summary\": _verdict_summary(state, open_work, cleared_at, dossier),\n440\t        \"basis\": basis,\n441\t        \"cleared_at\": cleared_at.split(\" \")[0] if cleared_at else None,\n442\t        \"cleared_by\": cleared_by,\n443\t        \"readiness\": readiness,\n444\t        \"actions\": _verdict_actions(vin, enabled),\n445\t    }\n446\t\n447\t\n448\t# --- verdict.next_action -- the one-sentence \"what do I do right now\" -------\n449\t#\n450\t# Added for the bench page (cuore/services/bench_bridge.py): a mechanic\n451\t# landing on a car should not have to read the verdict's basis list and the\n452\t# open-work cards to work out what to actually do next. Nothing here is a\n453\t# new judgement -- it just combines the verdict state already computed above\n454\t# with the same fuel-out-of-window flag :func:`_build_freeze_frames` already\n455\t# derives and the same open-work steps :func:`_build_open_work` already\n456\t# orders, into the one sentence (plus a short ``blocker`` label and the\n457\t# ``next_step_id`` it points at) the bench page's headline needs.\n458\t\n459\t\n460\tdef _first_unchecked_step(open_work: list[dict[str, Any]]\n461\t                          ) -> tuple[dict[str, Any] | None, dict[str, Any] | None]:\n462\t    \"\"\"The first not-yet-done step across every open-work card, in the same\n463\t    order the cards themselves are already in (curated families first, then\n464\t    the generic ones) -- ``(card, step)``, or ``(None, None)`` if every step\n465\t    on file is ticked.\"\"\"\n466\t    for card in open_work:\n467\t        for step in card.get(\"steps\") or []:\n468\t            if not step.get(\"done\"):\n469\t                return card, step\n470\t    return None, None\n471\t\n472\t\n473\tdef _step_bit(step: dict[str, Any] | None) -> str | None:\n474\t    \"\"\"\"<step text> (<bulletin>)\" -- the fragment both the ACTIVE_FAULTS and\n475\t    fuel-blocked UNVERIFIED_REPAIR sentences below quote verbatim.\"\"\"\n476\t    if step is None:\n477\t        return None\n478\t    bulletin = step.get(\"ref\") or \"no bulletin on file\"\n479\t    return f\"{step['text']} ({bulletin})\"\n480\t\n481\t\n482\tdef _fuel_out_of_window(freeze_frames: list[dict[str, Any]]\n483\t                        ) -> tuple[float, str, float] | None:\n484\t    \"\"\"``(level, \"above\"/\"below\", threshold)`` for the first EVAP freeze-frame\n485\t    fuel reading outside :data:`_EVAP_FUEL_WINDOW` -- the same flag\n486\t    :func:`_build_freeze_frames` already set on that reading -- or ``None``\n487\t    when no freeze frame carries that flag.\"\"\"\n488\t    lo, hi = _EVAP_FUEL_WINDOW\n489\t    for ff in freeze_frames:\n490\t        for p in ff.get(\"key\") or []:\n491\t            if p.get(\"name\") != \"Fuel level\" or not p.get(\"flag\"):\n492\t                continue\n493\t            level = _num(p.get(\"value\"))\n494\t            if level is None:\n495\t                continue\n496\t            return level, (\"below\" if level < lo else \"above\"), (lo if level < lo else hi)\n497\t    return None\n498\t\n499\t\n500\tdef _verdict_next_action(verdict: dict[str, Any], open_work: list[dict[str, Any]],\n501\t                         freeze_frames: list[dict[str, Any]]\n502\t                         ) -> tuple[str, str, str | None]:\n503\t    \"\"\"``(next_action sentence, blocker label, next_step_id)`` for one\n504\t    verdict. Never raises -- a missing open-work step or freeze frame just\n505\t    means a shorter sentence, not a broken one.\"\"\"\n506\t    state = verdict.get(\"state\")\n507\t    _card, step = _first_unchecked_step(open_work)\n508\t    step_id = step.get(\"id\") if step else None\n509\t    bit = _step_bit(step)\n510\t\n511\t    if state == \"UNVERIFIED_REPAIR\":\n512\t        fuel = _fuel_out_of_window(freeze_frames)\n513\t        if fuel is not None:\n514\t            level, direction, threshold = fuel\n515\t            sentence = (f\"Cannot verify yet: the EVAP monitor will not run {direction} \"\n516\t                       f\"{threshold:g} % fuel (set at {level:g} %). Burn fuel into the \"\n517\t                       f\"{_EVAP_FUEL_WINDOW[0]:g}-{_EVAP_FUEL_WINDOW[1]:g} % window, then \"\n518\t                       f\"complete a drive cycle.\")\n519\t            if bit:\n520\t                sentence += f\" Meanwhile: {bit}.\"\n521\t            return sentence, \"fuel out of window\", step_id\n522\t        sentence = (\"Cannot verify yet: no readiness read since the clear. Read \"\n523\t                    \"readiness once the drive cycle completes.\")\n524\t        if bit:\n525\t            sentence += f\" Meanwhile: {bit}.\"\n526\t        return sentence, \"awaiting drive cycle\", step_id\n527\t\n528\t    if state == \"ACTIVE_FAULTS\":\n529\t        if bit:\n530\t            return f\"Start with {bit}.\", \"active faults\", step_id\n531\t        return \"Active faults on file -- open the codes to begin.\", \"active faults\", None\n532\t\n533\t    if state == \"VERIFIED_CLEAN\":\n534\t        readiness = verdict.get(\"readiness\") or {}\n535\t        date = _short_date(readiness.get(\"at\")) or verdict.get(\"cleared_at\") or \"the last read\"\n536\t        return f\"Verified by readiness read on {date}: release.\", \"none\", None\n537\t\n538\t    return \"Read the car.\", \"no data\", None\n539\t\n540\t\n541\t# --- open work (family findings as a checklist) -----------------------------\n542\t\n543\t\n544\tdef _family_refs(codes: list[str], per_code: dict[str, Any],\n545\t                 reading: str) -> list[dict[str, Any]]:\n546\t    seen: dict[str, dict[str, Any]] = {}\n547\t    for code in codes:\n548\t        for b in per_code.get(code, []):\n549\t            num = b.get(\"bulletin\")\n550\t            if num and num not in seen:\n551\t                seen[num] = {\"label\": num, \"href\": f\"#tsb-{_slug(num)}\"}\n552\t    for doc in re.findall(r\"docs/\\S+?\\.md\", reading or \"\"):\n553\t        if doc not in seen:\n554\t            seen[doc] = {\"label\": doc, \"href\": None}\n555\t    return list(seen.values())\n556\t\n557\t\n558\tdef _build_open_work(vin: str, dossier: dict[str, Any],\n559\t                     checklist: dict[str, Any]) -> list[dict[str, Any]]:\n560\t    tsb = dossier.get(\"tsb_matches\") or {}\n561\t    findings = tsb.get(\"family_findings\") or []\n562\t    per_code = tsb.get(\"per_code\") or {}\n563\t    cards = []\n564\t    covered_codes: set[str] = set()\n565\t    for f in findings:\n566\t        family = f.get(\"family\") or \"\"\n567\t        steps_def = FAMILY_STEPS.get(family)\n568\t        if not steps_def:\n569\t            continue  # no checklist table for this family yet\n570\t        codes = [c.upper() for c in (f.get(\"codes\") or [])]\n571\t        covered_codes.update(codes)\n572\t        steps = []\n573\t        done = 0\n574\t        for s in steps_def:\n575\t            st = checklist.get(s[\"id\"]) or {}\n576\t            is_done = bool(st.get(\"done\"))\n577\t            done += int(is_done)\n578\t            steps.append({\n579\t                \"id\": s[\"id\"], \"text\": s[\"text\"], \"ref\": s[\"ref\"],\n580\t                \"ref_href\": f\"#tsb-{_slug(s['ref'])}\" if s[\"ref\"] else None,\n581\t                \"done\": is_done, \"done_at\": st.get(\"done_at\"),\n582\t                \"done_by\": st.get(\"done_by\"),\n583\t            })\n584\t        title = _FAMILY_TITLES.get(family, f\"{family}: one system fault\")\n585\t        if \"{n}\" in title:\n586\t            title = title.format(n=len(codes))\n587\t        cards.append({\n588\t            \"family\": family, \"title\": title, \"codes\": codes, \"steps\": steps,\n589\t            \"refs\": _family_refs(codes, per_code, f.get(\"reading\", \"\")),\n590\t            \"progress\": {\"done\": done, \"total\": len(steps_def)},\n591\t        })\n592\t\n593\t    # Every other family this car's own history shows, grouped by the\n594\t    # generic SAE-range classification above, with steps pulled live from\n595\t    # mes.faulttree via mes_bridge.fault_tree -- so EVAP keeps being the\n596\t    # richest, hand-curated example, but a misfire, fuel-trim, cooling,\n597\t    # body, chassis or ADAS code (or any other family) still gets a\n598\t    # sourced, actionable card instead of nothing.\n599\t    remaining = sorted(_history_codes(dossier) - covered_codes)\n600\t    groups: dict[str, list[str]] = {}\n601\t    labels: dict[str, str] = {}\n602\t    for code in remaining:\n603\t        fam = _generic_family_for(code)\n604\t        if fam is None:\n605\t            continue\n606\t        key, label = fam\n607\t        groups.setdefault(key, []).append(code)\n608\t        labels[key] = label\n609\t    for family_key in sorted(groups):\n610\t        codes = sorted(set(groups[family_key]))\n611\t        tree_steps = _generic_tree_steps(codes[0], vin)[:6]\n612\t        if not tree_steps:\n613\t            continue\n614\t        steps = []\n615\t        done = 0\n616\t        for i, s in enumerate(tree_steps):\n617\t            step_id = f\"{family_key}-{i + 1}\"\n618\t            st = checklist.get(step_id) or {}\n619\t            is_done = bool(st.get(\"done\"))\n620\t            done += int(is_done)\n621\t            text = s.get(\"title\") or s.get(\"test\") or \"Step\"\n622\t            if s.get(\"test\") and s.get(\"test\") != text:\n623\t                text = f\"{text}: {s['test']}\"\n624\t            steps.append({\n625\t                \"id\": step_id, \"text\": text, \"ref\": s.get(\"source\"),\n626\t                \"ref_href\": None,\n627\t                \"done\": is_done, \"done_at\": st.get(\"done_at\"),\n628\t                \"done_by\": st.get(\"done_by\"),\n629\t            })\n630\t        label = labels.get(family_key, family_key)\n631\t        title = (f\"{label}: one open issue\" if len(codes) == 1\n632\t                 else f\"{label}: {len(codes)} codes, one system\")\n633\t        cards.append({\n634\t            \"family\": family_key, \"title\": title, \"codes\": codes,\n635\t            \"steps\": steps, \"refs\": [],\n636\t            \"progress\": {\"done\": done, \"total\": len(steps)},\n637\t            \"generic\": True,\n638\t        })\n639\t    return cards\n640\t\n641\t\n642\tdef _family_map(dossier: dict[str, Any]) -> dict[str, str]:\n643\t    out: dict[str, str] = {}\n644\t    for f in (dossier.get(\"tsb_matches\") or {}).get(\"family_findings\", []):\n645\t        for c in f.get(\"codes\", []):\n646\t            out[c.upper()] = f.get(\"family\")\n647\t    return out\n648\t\n649\t\n650\t# --- the code table -----------------------------------------------------------\n651\t\n652\t\n653\tdef _code_status(base: str, last_seen: str | None, cleared_at: str | None,\n654\t                 codes_cleared: set[str], codes_returned: set[str],\n655\t                 codes_uncleared: set[str], last_findings: set[str],\n656\t                 last_findings_ts: str | None, recent_ts: list[str]) -> str:\n657\t    if base in codes_returned or base in codes_uncleared:\n658\t        return \"ACTIVE\"\n659\t    if cleared_at and last_seen and last_seen > cleared_at:\n660\t        return \"ACTIVE\"\n661\t    if base in last_findings and not (cleared_at and last_findings_ts\n662\t                                      and cleared_at >= last_findings_ts):\n663\t        return \"ACTIVE\"\n664\t    if cleared_at and base in codes_cleared and (not last_seen or last_seen <= cleared_at):\n665\t        return \"CLEARED_UNVERIFIED\"\n666\t    if cleared_at is None and last_seen and last_seen in recent_ts[:3]:\n667\t        return \"ACTIVE\"\n668\t    return \"STALE\"\n669\t\n670\t\n671\tdef _code_rows(vin: str, dossier: dict[str, Any], cleared_at: str | None,\n672\t              clear_assessment: dict[str, Any] | None, recent_ts: list[str],\n673\t              family_map: dict[str, str]\n674\t              ) -> tuple[list[dict[str, Any]], dict[str, int]]:\n675\t    history = dossier.get(\"history\") or {}\n676\t    cp = dossier.get(\"current_picture\") or {}\n677\t    last_findings_session = cp.get(\"last_session_with_findings\") or {}\n678\t    last_findings = {_base(d.get(\"code\") or d.get(\"dtc\") or \"\")\n679\t                     for d in last_findings_session.get(\"dtcs\", [])}\n680\t    last_findings_ts = last_findings_session.get(\"timestamp\")\n681\t\n682\t    codes_cleared = {_base(c) for c in (clear_assessment or {}).get(\"codes_cleared\", [])}\n683\t    codes_returned = {_base(c) for c in\n684\t                      (clear_assessment or {}).get(\"codes_returned_in_session\", [])}\n685\t    codes_uncleared = {_base(c) for c in\n686\t                       (clear_assessment or {}).get(\"codes_that_would_not_clear\", [])}\n687\t\n688\t    rows: list[dict[str, Any]] = []\n689\t    for bucket in (\"chronic\", \"returned_after_clear\", \"seen_once\"):\n690\t        for rec in history.get(bucket, []):\n691\t            full = rec.get(\"dtc\", \"\")\n692\t            base = _base(full)\n693\t            last_seen = rec.get(\"last_seen\")\n694\t            status = _code_status(base, last_seen, cleared_at, codes_cleared,\n695\t                                  codes_returned, codes_uncleared, last_findings,\n696\t                                  last_findings_ts, recent_ts)\n697\t            distance = rec.get(\"distance_span_km\")\n698\t            rows.append({\n699\t                \"code\": base, \"dtc\": full,\n700\t                \"description\": (rec.get(\"descriptions\") or [\"\"])[0],\n701\t                \"system\": _SYSTEM_BY_LETTER.get(base[:1], base[:1] if base else None),\n702\t                \"bucket\": bucket,\n703\t                \"status\": status, \"status_label\": _STATUS_LABEL[status],\n704\t                \"sessions\": rec.get(\"sessions\"),\n705\t                \"last_seen_short\": _short_date(last_seen),\n706\t                \"last_seen\": last_seen, \"first_seen\": rec.get(\"first_seen\"),\n707\t                \"distance_km\": round(distance) if distance is not None else None,\n708\t                \"href\": f\"/v/{vin}/code/{base}\",\n709\t                \"family\": family_map.get(base),\n710\t            })\n711\t\n712\t    counts = {\"chronic\": 0, \"seen_once\": 0, \"returned_after_clear\": 0,\n713\t             \"active\": 0, \"stale\": 0}\n714\t    for r in rows:\n715\t        counts[r[\"bucket\"]] = counts.get(r[\"bucket\"], 0) + 1\n716\t        if r[\"status\"] == \"ACTIVE\":\n717\t            counts[\"active\"] += 1\n718\t        elif r[\"status\"] == \"STALE\":\n719\t            counts[\"stale\"] += 1\n720\t    return rows, counts\n721\t\n722\t\n723\t# --- already attempted -------------------------------------------------------\n724\t\n725\t\n726\tdef _build_attempted(vin: str) -> list[dict[str, Any]]:\n727\t    try:\n728\t        data = mes_bridge.actuator_history(vin=vin)\n729\t    except BridgeError:\n730\t        return []\n731\t    note = data.get(\"note\")\n732\t    groups: dict[tuple[str, str], dict[str, Any]] = {}\n733\t    for r in data.get(\"runs\", []):\n734\t        key = (r.get(\"operation\"), r.get(\"outcome\"))\n735\t        g = groups.setdefault(key, {\"operation\": r.get(\"operation\"),\n736\t                                    \"kind\": r.get(\"kind\"), \"outcome\": r.get(\"outcome\"),\n737\t                                    \"reason\": None, \"rows\": []})\n738\t        g[\"rows\"].append(r)\n739\t        if r.get(\"reason\") and not g[\"reason\"]:\n740\t            g[\"reason\"] = r.get(\"reason\")\n741\t\n742\t    out = []\n743\t    for g in groups.values():\n744\t        times = sorted(r.get(\"timestamp\") for r in g[\"rows\"] if r.get(\"timestamp\"))\n745\t        reason = g[\"reason\"]\n746\t        footnote = note if (reason and note and \"engine running\" in reason.lower()) else None\n747\t        out.append({\n748\t            \"operation\": g[\"operation\"], \"kind\": g[\"kind\"], \"outcome\": g[\"outcome\"],\n749\t            \"count\": len(g[\"rows\"]),\n750\t            \"first_short\": _short_date(times[0]) if times else None,\n751\t            \"last_short\": _short_date(times[-1]) if times else None,\n752\t            \"reason\": reason, \"reason_chip\": reason, \"footnote\": footnote,\n753\t            \"rows\": g[\"rows\"],\n754\t        })\n755\t    out.sort(key=lambda g: (g[\"outcome\"] != \"FAILED TO EXECUTE\", g[\"operation\"] or \"\"))\n756\t    return out\n757\t\n758\t\n759\t# --- freeze frames -------------------------------------------------------------\n760\t\n761\t\n762\tdef _build_freeze_frames(vin: str, dossier: dict[str, Any]) -> list[dict[str, Any]]:\n763\t    cp = dossier.get(\"current_picture\") or {}\n764\t    target_ts = ((cp.get(\"last_session_with_findings\") or {}).get(\"timestamp\")\n765\t                or (cp.get(\"latest_session\") or {}).get(\"timestamp\"))\n766\t    if not target_ts:\n767\t        return []\n768\t    try:\n769\t        data = mes_bridge.freeze_frames(vin=vin)\n770\t    except BridgeError:\n771\t        return []\n772\t\n773\t    odo_last = (dossier.get(\"identity\") or {}).get(\"odometer_last_km\")\n774\t    out = []\n775\t    for f in data.get(\"frames\", []):\n776\t        if f.get(\"timestamp\") != target_ts:\n777\t            continue\n778\t        ff = f.get(\"freeze_frame\") or {}\n779\t        base = _base(f.get(\"dtc\", \"\"))\n780\t        key = []\n781\t        for name in _KEY_FRAME_PARAMS:\n782\t            if name not in ff:\n783\t                continue\n784\t            value = ff[name]\n785\t            flag = None\n786\t            if name == \"Fuel level\" and base in _EVAP_CODES:\n787\t                level = _num(value)\n788\t                lo, hi = _EVAP_FUEL_WINDOW\n789\t                if level is not None and (level < lo or level > hi):\n790\t                    bound = f\"below {lo:g} %\" if level < lo else f\"above {hi:g} %\"\n791\t                    flag = f\"{bound}: EVAP monitor could not run\"\n792\t            key.append({\"name\": name, \"value\": value, \"flag\": flag})\n793\t        odo_frame = _num(ff.get(\"Odometer\"))\n794\t        set_km_ago = (round(odo_last - odo_frame)\n795\t                     if odo_last is not None and odo_frame is not None else None)\n796\t        out.append({\n797\t            \"code\": f.get(\"dtc\"), \"key\": key, \"set_km_ago\": set_km_ago,\n798\t            \"all\": [{\"name\": n, \"value\": v} for n, v in ff.items()],\n799\t        })\n800\t    return out\n801\t\n802\t\n803\t# --- blind spots as actions ----------------------------------------------------\n804\t\n805\t\n806\tdef _blind_spot_action(vin: str, closes_it: str, enabled: bool) -> dict[str, Any]:\n807\t    low = (closes_it or \"\").lower()\n808\t    hint = \"\" if enabled else \"connect the car (ELM327 on COM3)\"\n809\t    if \"read_readiness\" in low:\n810\t        return {\"label\": \"Read readiness\", \"kind\": \"readiness\",\n811\t                \"href\": f\"/v/{vin}/verify\", \"enabled\": enabled, \"hint\": hint}\n812\t    if \"read_permanent_dtcs\" in low:\n813\t        return {\"label\": \"Read permanent DTCs\", \"kind\": \"permanent\", \"href\": None,\n814\t                \"enabled\": enabled, \"hint\": hint}\n815\t    if \"mode06\" in low or \"send_raw\" in low:\n816\t        return {\"label\": \"Read Mode $06\", \"kind\": \"mode06\", \"href\": None,\n817\t                \"enabled\": enabled, \"hint\": hint}\n818\t    if \"already closed\" in low:\n819\t        return {\"label\": \"Answered\", \"kind\": \"link\", \"href\": f\"/v/{vin}/dealer\",\n820\t                \"enabled\": True, \"hint\": \"\"}\n821\t    if \"witech\" in low or \"dealer\" in low:\n822\t        return {\"label\": \"Dealer / wiTECH\", \"kind\": \"dealer\", \"href\": f\"/v/{vin}/dealer\",\n823\t                \"enabled\": True, \"hint\": \"\"}\n824\t    return {\"label\": \"Manual check\", \"kind\": \"manual\", \"href\": None,\n825\t            \"enabled\": True, \"hint\": \"\"}\n826\t\n827\t\n828\tdef _build_blind_spots(vin: str, dossier: dict[str, Any],\n829\t                       live_status: dict[str, Any] | None) -> list[dict[str, Any]]:\n830\t    enabled = live_available(live_status)\n831\t    out = []\n832\t    for bs in dossier.get(\"blind_spots\", []):\n833\t        out.append({\n834\t            \"question\": bs.get(\"question\", \"\"),\n835\t            \"why\": bs.get(\"why_unknown\", \"\"),\n836\t            \"action\": _blind_spot_action(vin, bs.get(\"closes_it\", \"\"), enabled),\n837\t        })\n838\t    return out\n839\t\n840\t\n841\t# --- bulletins, deduplicated ---------------------------------------------------\n842\t\n843\t\n844\tdef _supersedes(action: str) -> str | None:\n845\t    m = re.search(r\"[Ss]upersed(?:es|ed)\\s+([A-Za-z0-9.\\-]+)\", action or \"\")\n846\t    return m.group(1).rstrip(\".\") if m else None\n847\t\n848\t\n849\tdef _build_bulletins(dossier: dict[str, Any],\n850\t                     open_work: list[dict[str, Any]]) -> list[dict[str, Any]]:\n851\t    tsb = dossier.get(\"tsb_matches\") or {}\n852\t    per_code = tsb.get(\"per_code\") or {}\n853\t    relevant = {c for card in open_work for c in card[\"codes\"]}\n854\t\n855\t    by_num: dict[str, dict[str, Any]] = {}\n856\t    for code, matches in per_code.items():\n857\t        for b in matches:\n858\t            num = b.get(\"bulletin\")\n859\t            if not num:\n860\t                continue\n861\t            entry = by_num.setdefault(num, {\n862\t                \"id\": num, \"anchor\": f\"tsb-{_slug(num)}\", \"title\": b.get(\"title\"),\n863\t                \"action\": b.get(\"action\"), \"caution\": b.get(\"caution\"),\n864\t                \"codes\": set(), \"superseded\": _supersedes(b.get(\"action\", \"\")),\n865\t                \"source\": b.get(\"source\"), \"relevance\": 0,\n866\t            })\n867\t            entry[\"codes\"].update(b.get(\"dtcs\") or [code])\n868\t            if code.upper() in relevant:\n869\t                entry[\"relevance\"] += 1\n870\t\n871\t    out = []\n872\t    for entry in by_num.values():\n873\t        entry[\"codes\"] = sorted(entry[\"codes\"])\n874\t        out.append(entry)\n875\t    out.sort(key=lambda e: (-e[\"relevance\"], e[\"id\"]))\n876\t    return out\n877\t\n878\t\n879\t# --- latest session/scan -------------------------------------------------------\n880\t\n881\t\n882\tdef _build_latest(dossier: dict[str, Any]) -> dict[str, Any]:\n883\t    cp = dossier.get(\"current_picture\") or {}\n884\t    ls = cp.get(\"latest_session\") or {}\n885\t    sc = cp.get(\"latest_scan\") or {}\n886\t    return {\n887\t        \"session_short\": _short_date(ls.get(\"timestamp\"), with_time=True),\n888\t        \"session_file\": ls.get(\"file\"), \"ecu\": ls.get(\"ecu\"),\n889\t        \"scan_short\": (_short_date(sc.get(\"timestamp\"), with_time=True)\n890\t                       if sc.get(\"timestamp\") else None),\n891\t        \"scan_file\": sc.get(\"file\"),\n892\t    }\n893\t\n894\t\n895\t# --- checklist step ids, for the API's validation ----------------------------\n896\t\n897\t\n898\tdef checklist_step_ids(vin: str, dossier: dict[str, Any]) -> set[str]:\n899\t    \"\"\"Every checklist step id this vehicle's open-work cards expose.\n900\t\n901\t    Used by the checklist API to reject a step id that is not actually on\n902\t    this car's dossier -- a step id is only meaningful in the context of the\n903\t    family finding it belongs to.\n904\t    \"\"\"\n905\t    open_work = _build_open_work(vin, dossier, {})\n906\t    return {s[\"id\"] for card in open_work for s in card[\"steps\"]}\n907\t\n908\t\n909\t# --- the one entry point -----------------------------------------------------\n910\t\n911\t\n912\tdef _build_view_core(vin: str, dossier: dict[str, Any]) -> dict[str, Any]:\n913\t    \"\"\"Everything :func:`build_view` needs except the verdict and blind\n914\t    spots, which also read ``live_status`` and are cheap enough (no file\n915\t    I/O beyond what ``dossier`` already carries) to compute fresh on every\n916\t    call. Split out purely so it can be memoised -- see ``build_view``.\n917\t    \"\"\"\n918\t    checklist = checklist_store.get(vin)\n919\t    open_work = _build_open_work(vin, dossier, checklist)\n920\t\n921\t    family_map = _family_map(dossier)\n922\t    try:\n923\t        recent_ts = [e.get(\"timestamp\") for e in\n924\t                    mes_bridge.list_logs(vin=vin, limit=3)[\"logs\"]]\n925\t    except BridgeError:\n926\t        recent_ts = []\n927\t    cleared_at, _cleared_by, clear_assessment = _clear_info(dossier)\n928\t    codes, code_counts = _code_rows(vin, dossier, cleared_at, clear_assessment,\n929\t                                    recent_ts, family_map)\n930\t\n931\t    return {\n932\t        \"open_work\": open_work,\n933\t        \"codes\": codes,\n934\t        \"code_counts\": code_counts,\n935\t        \"attempted\": _build_attempted(vin),\n936\t        \"freeze_frames\": _build_freeze_frames(vin, dossier),\n937\t        \"bulletins\": _build_bulletins(dossier, open_work),\n938\t        \"latest\": _build_latest(dossier),\n939\t        \"provenance_note\": dossier.get(\"provenance_note\", \"\"),\n940\t    }\n941\t\n942\t\n943\tdef build_view(vin: str, dossier: dict[str, Any],\n944\t              live_status: dict[str, Any] | None) -> dict[str, Any]:\n945\t    \"\"\"Everything the redesigned dossier page needs, computed once.\n946\t\n947\t    ``dossier`` is the workup dict (``mes_bridge.workup(vin=vin)``);\n948\t    ``live_status`` is the same shape ``base.html``'s live strip already\n949\t    renders (``port``, ``mes_state``, ``lock_holder``, ...), or ``None`` when\n950\t    the caller has not computed it. Nothing here mutates either argument or\n951\t    touches the car -- nothing here writes anything at all.\n952\t\n953\t    The dossier, job and flow pages between them call this several times\n954\t    per render (the Job page alone calls it twice: once for its own\n955\t    suggested-hypothesis evidence, once for the page body) and the open-work\n956\t    cards alone re-evaluate a fault tree per code, parsing FES logs directly\n957\t    -- seconds of work on a real corpus. Everything but the verdict and\n958\t    blind spots is pulled from :func:`_build_view_core`, memoised on (vin,\n959\t    newest MES-log mtime, newest state-file mtime) exactly like\n960\t    ``cuore.web.routes._dossier`` already memoises the workup itself, so a\n961\t    second call in the same request (or the next request, until a log or a\n962\t    state file changes) costs a dict lookup instead of a re-evaluation. The\n963\t    verdict and blind spots stay outside that cache because they depend on\n964\t    ``live_status``, which varies request to request and is not part of the\n965\t    key.\n966\t    \"\"\"\n967\t    core = cache.get_or_build(\n968\t        (\"dossier_view_core\", vin, mes_bridge.newest_mtime(vin), _state_fingerprint()),\n969\t        lambda: _build_view_core(vin, dossier),\n970\t    )\n971\t    verdict = _build_verdict(vin, dossier, live_status, core[\"open_work\"])\n972\t    next_action, blocker, next_step_id = _verdict_next_action(\n973\t        verdict, core[\"open_work\"], core[\"freeze_frames\"])\n974\t    verdict[\"next_action\"] = next_action\n975\t    verdict[\"blocker\"] = blocker\n976\t    verdict[\"next_step_id\"] = next_step_id\n977\t    blind_spots = _build_blind_spots(vin, dossier, live_status)\n978\t    return {\"verdict\": verdict, \"blind_spots\": blind_spots, **core}\n979\t\n980\t\n981\t__all__ = [\"build_view\", \"checklist_step_ids\", \"live_available\", \"readiness_result\",\n982\t           \"FAMILY_STEPS\"]\n983\t"}]},"uuid":"187dd8a4-bca1-4879-9716-62cb151542a3","timestamp":"2026-10-08T17:36:53.720Z","toolUseResult":{"type":"text","file":{"filePath":"C:\\Users\\User\\mcp-servers\\cuore\\services\\dossier_bridge.py","content":"\"\"\"Turns the raw workup dossier into the redesigned dossier page's contract.\n\nMECHANIC_UX_REVIEW.md's R1/R4/R5/R6/R7/R8/R9 all boil down to the same\ncomplaint: the knowledge in ``mes.workup`` is already senior-technician-grade\n(family findings, chronic/returned classification, TSB cross-reference) but\nthe page made the mechanic excavate it from prose and raw dicts. Nothing here\nre-derives that knowledge -- it only reshapes what ``mes_bridge.workup``\nalready returns (plus what the live link has observed) into the verdict,\nchecklists, code table, freeze-frame flags, deduplicated bulletins and\nrunnable blind-spot actions the template needs, so there is exactly one\nplace that decides what a status chip or a checklist step means.\n\n``build_view`` is the only entry point. Everything else is a private helper.\n\nLike every other file under ``cuore/services``, this is a *_bridge.py module,\nso it is allowed to import ``mes_bridge`` (never the ``mes`` package itself --\nnothing here needs to; the workup dict already carries what ``mes`` computed)\nand the small read-only ``cuore.live`` surfaces (``store`` for live\nobservations, ``checklists`` for shop-ticked steps).\n\"\"\"\n\nfrom __future__ import annotations\n\nimport re\nfrom datetime import datetime\nfrom typing import Any\n\nfrom . import cache, mes_bridge\nfrom .errors import BridgeError\nfrom ..live import checklists as checklist_store\nfrom ..live import config as live_config\nfrom ..live import store as live_store\n\n#: EVAP monitor runs at 15-85% fuel; cited wherever a freeze frame needs\n#: flagging. Matches the window ``mes`` itself states in verdict/fault-tree\n#: text -- not re-derived, just applied to one more surface.\n_EVAP_FUEL_WINDOW = (15.0, 85.0)\n_EVAP_CODES = {\"P0440\", \"P0441\", \"P0455\", \"P0456\", \"P1CEA\"}\n\n_SYSTEM_BY_LETTER = {\"P\": \"engine\", \"C\": \"chassis\", \"B\": \"body\", \"U\": \"network\"}\n\n_STATUS_LABEL = {\"ACTIVE\": \"Active\", \"CLEARED_UNVERIFIED\": \"Cleared, unverified\",\n                \"STALE\": \"Stale\"}\n\n#: Freeze-frame parameters worth a mechanic's first glance, in the order\n#: they should appear. Everything else still rides along in ``all``.\n_KEY_FRAME_PARAMS = [\"Fuel level\", \"Engine temperature\", \"Odometer\",\n                     \"Vehicle speed\", \"Engine speed\", \"Air temperature\"]\n\n#: One checklist per family this corpus's fault trees and TSBs recognise\n#: today. Transcribed once, here, from the family finding's own \"reading\"\n#: text and the EVAP/network fault trees -- see MECHANIC_UX_REVIEW.md R4.\n#: Keeping this as a table (not free-text parsing of ``reading``) is what\n#: makes checklist step ids stable across a wording change in ``mes``.\nFAMILY_STEPS: dict[str, list[dict[str, Any]]] = {\n    \"EVAP\": [\n        {\"id\": \"evap-1\", \"text\": \"Inspect the recirculation-line quick-connect\",\n         \"ref\": \"S2125000002\"},\n        {\"id\": \"evap-2\", \"text\": \"Run the purge/vent valve KOEO actuator test\",\n         \"ref\": None},\n        {\"id\": \"evap-3\", \"text\": \"Check hose routing\", \"ref\": \"9100325\"},\n        {\"id\": \"evap-4\", \"text\": \"Inspect the canister/ESIM\", \"ref\": \"9100471\"},\n        {\"id\": \"evap-5\", \"text\": \"Run a smoke test to localise the leak\",\n         \"ref\": None},\n        {\"id\": \"evap-6\", \"text\": \"Verify with SLVT or Mode $06\",\n         \"ref\": \"18-048-23\"},\n    ],\n    \"network\": [\n        {\"id\": \"network-1\", \"text\": \"Check the supply: F82 fuse and BCM feeds\",\n         \"ref\": \"S1808000005\"},\n        {\"id\": \"network-2\",\n         \"text\": \"Inspect connectors/grounds: XY201, G003A/B\",\n         \"ref\": \"S2008000032\"},\n        {\"id\": \"network-3\",\n         \"text\": \"Inspect connector terminals for spread/backed-out pins\",\n         \"ref\": \"S1708000262\"},\n    ],\n}\n\n_FAMILY_TITLES = {\n    \"EVAP\": \"EVAP: one system fault\",\n    \"network\": \"Network: one power/bus event, not {n} separate faults\",\n}\n\n#: EVAP was the first job this cuore app diagnosed, so it (and the network\n#: cascade) got a hand-curated ``FAMILY_STEPS`` table above. Every other\n#: family this car's history can throw -- misfire, fuel trim, cooling, body,\n#: chassis, ADAS, or anything else SAE's DTC-prefix convention covers --\n#: still needs an open-work card; :func:`_build_open_work` builds those\n#: generically, grouping codes by the family below and pulling steps live\n#: from ``mes_bridge.fault_tree`` (``mes.faulttree.tree_for`` -- the\n#: hand-written tree when one exists, else a sourced generated one) instead\n#: of a second hand-maintained step table. Patterns are checked in order;\n#: the first match wins. Generalised from the same SAE J2012 prefix-range\n#: convention ``mes.systems._sae_fallback`` already uses.\n_GENERIC_FAMILY_RULES: tuple[tuple[re.Pattern, str, str], ...] = (\n    (re.compile(r\"^P030[0-9]$\"), \"misfire\", \"Misfire\"),\n    (re.compile(r\"^P017[0-5]$\"), \"fuel_trim\", \"Fuel trim\"),\n    (re.compile(r\"^P01(0[0-9]|1[0-9]|2[0-9])$\"), \"cooling\",\n     \"Cooling / intake sensors\"),\n    (re.compile(r\"^P0[67][0-9]{2}$\"), \"engine_management\", \"Engine management\"),\n    (re.compile(r\"^P0[89][0-9]{2}$\"), \"transmission_driveline\",\n     \"Transmission / driveline\"),\n    (re.compile(r\"^C(141B|141C)$\"), \"adas\", \"ADAS (camera/radar)\"),\n    (re.compile(r\"^C[0-9A-F]{4}$\"), \"chassis\", \"Chassis (brakes/steering/suspension)\"),\n    (re.compile(r\"^B[0-9A-F]{4}$\"), \"body\", \"Body / comfort\"),\n    (re.compile(r\"^U[0-9A-F]{4}$\"), \"network\", \"Network / communication\"),\n    (re.compile(r\"^P[0-9A-F]{4}$\"), \"powertrain_other\", \"Powertrain (other)\"),\n)\n\n\ndef _generic_family_for(base: str) -> tuple[str, str] | None:\n    \"\"\"``(family_key, family_label)`` for a code with no hand-curated\n    ``FAMILY_STEPS`` entry, or ``None`` for something that isn't a\n    recognisable P/B/C/U code at all.\"\"\"\n    for pattern, key, label in _GENERIC_FAMILY_RULES:\n        if pattern.match(base):\n            return key, label\n    return None\n\n\ndef _history_codes(dossier: dict[str, Any]) -> set[str]:\n    \"\"\"Every base code present anywhere in this car's own history -- the\n    same ``chronic``/``returned_after_clear``/``seen_once`` buckets the code\n    table reads -- so a generic open-work card can be offered for a family\n    the TSB family-finding rule above doesn't recognise.\"\"\"\n    history = dossier.get(\"history\") or {}\n    out: set[str] = set()\n    for bucket in (\"chronic\", \"returned_after_clear\", \"seen_once\"):\n        for rec in history.get(bucket, []):\n            b = _base(rec.get(\"dtc\", \"\"))\n            if b:\n                out.add(b)\n    return out\n\n\ndef _generic_tree_steps(code: str, vin: str) -> list[dict[str, Any]]:\n    \"\"\"The first tree's steps for one code, via ``mes_bridge.fault_tree`` --\n    the hand-written tree when ``mes.faulttree.tree_for`` has one, else its\n    sourced generated tree. Never raises: a lookup failure just means no\n    generic card gets built for that code.\"\"\"\n    try:\n        result = mes_bridge.fault_tree(code, vin=vin)\n    except Exception:\n        return []\n    trees = result.get(\"trees\") or []\n    return trees[0].get(\"steps\") or [] if trees else []\n\n\n# --- small shared helpers --------------------------------------------------\n\n\ndef _base(code: str) -> str:\n    \"\"\"\"P0440-00\" -> \"P0440\". Same rule as ``mes.knowledge.base_code``,\n    reimplemented here rather than imported so this module never touches the\n    ``mes`` package directly.\"\"\"\n    code = (code or \"\").strip().upper()\n    return code.split(\"-\", 1)[0] if \"-\" in code else code\n\n\ndef _slug(text: str) -> str:\n    return re.sub(r\"[^A-Za-z0-9]+\", \"-\", (text or \"\").strip()).strip(\"-\")\n\n\ndef _parse_ts(ts: str | None) -> datetime | None:\n    if not ts:\n        return None\n    try:\n        return datetime.strptime(str(ts)[:19], \"%Y-%m-%d %H:%M:%S\")\n    except ValueError:\n        return None\n\n\ndef _short_date(ts: str | None, with_time: bool = False) -> str | None:\n    dt = _parse_ts(ts)\n    if dt is None:\n        return None\n    fmt = \"%d %b %H:%M\" if with_time else \"%d %b\"\n    if dt.year != datetime.now().year:\n        fmt += \" '%y\"\n    return dt.strftime(fmt)\n\n\ndef _num(display: Any) -> float | None:\n    \"\"\"Pull the leading number out of a display string like \"93.73 %\".\"\"\"\n    if display is None:\n        return None\n    m = re.match(r\"\\s*(-?\\d+(?:\\.\\d+)?)\", str(display))\n    return float(m.group(1)) if m else None\n\n\ndef _state_fingerprint() -> float:\n    \"\"\"Newest mtime across this app's mutable state files.\n\n    Checklists, jobs, shop visits, symptoms, notes, dealer results, tool\n    usage, live observations and the rest are all flat files sitting\n    directly under one shared directory -- every ``mes.*``/``cuore.live``\n    state module mirrors ``cuore.live.config.state_dir()`` (see each\n    module's own ``state_dir()`` docstring). Folded into\n    :func:`build_view`'s cache key so a ticked checklist step or a freshly\n    logged symptom invalidates the cached open-work/freeze-frame/attempted\n    build the same way a new MES log invalidates ``mes_bridge.newest_mtime``\n    -- no separate invalidation hook, same reasoning as ``cuore.services.cache``\n    itself.\n    \"\"\"\n    try:\n        d = live_config.state_dir()\n        return max((p.stat().st_mtime for p in d.iterdir() if p.is_file()), default=0.0)\n    except OSError:\n        return 0.0\n\n\ndef live_available(live_status: dict[str, Any] | None) -> bool:\n    \"\"\"Is the adapter reachable right now -- a port configured, and neither\n    MultiEcuScan nor another process holding it.\n\n    Same read ``base.html``'s live strip and ``/live`` already make of\n    ``live_ops.status()``: ``mes_state == \"connected\"`` means MES has the\n    port, and a ``lock_holder`` other than this process means something else\n    does. Used both to grey out the dossier's own action buttons and by\n    ``/v/{vin}/verify`` to decide whether it is safe to actually read.\n    \"\"\"\n    if not live_status or live_status.get(\"error\"):\n        return False\n    if not live_status.get(\"port\"):\n        return False\n    if live_status.get(\"mes_state\") == \"connected\":\n        return False\n    holder = live_status.get(\"lock_holder\")\n    if holder and holder != \"cuore\":\n        return False\n    return True\n\n\n# --- the last clear ---------------------------------------------------------\n\n\ndef _clear_info(dossier: dict[str, Any]\n                ) -> tuple[str | None, str | None, dict[str, Any] | None]:\n    \"\"\"(cleared_at full timestamp, cleared_by file, the clear_assessment dict).\n\n    ``current_picture.clear_assessment`` comes from two different shapes in\n    ``mes.workup``: a scan-based clear carries its own ``cleared_at``/\n    ``source``; a clear inside the anchored FES session itself carries\n    neither, because *that session* is the clear -- so its timestamp/file are\n    read off ``latest_session`` instead.\n    \"\"\"\n    cp = dossier.get(\"current_picture\") or {}\n    ca = cp.get(\"clear_assessment\")\n    if not ca:\n        return None, None, None\n    cleared_at = ca.get(\"cleared_at\")\n    cleared_by = ca.get(\"source\")\n    if not cleared_at:\n        latest = cp.get(\"latest_session\") or {}\n        cleared_at = latest.get(\"timestamp\")\n        cleared_by = latest.get(\"file\")\n    return cleared_at, cleared_by, ca\n\n\n# --- readiness, read from the car -------------------------------------------\n\n\ndef _latest_readiness(vin: str, after: str | None) -> dict[str, Any] | None:\n    \"\"\"The newest readiness observation from the car itself, after ``after``.\n\n    A read taken before the clear says nothing about the car now -- the same\n    reasoning ``mes.verdict._last_clear`` already applies to live DTC reads.\n    \"\"\"\n    try:\n        obs = live_store.recent_observations(200, vin=vin, kind=\"readiness\")\n    except Exception:  # noqa: BLE001 -- a broken store must never break the verdict\n        return None\n    best = None\n    for o in obs:\n        if not live_store.is_from_car(o):\n            continue\n        at = o.get(\"at\") or \"\"\n        if after and at <= after:\n            continue\n        if best is None or at > (best.get(\"at\") or \"\"):\n            best = o\n    return best\n\n\ndef readiness_result(raw: dict[str, Any]) -> dict[str, Any]:\n    \"\"\"Shape a live ``ops.obd_readiness()`` read for ``/v/{vin}/verify``.\n\n    ``verify.html`` destructures ``result.at`` / ``result.evap_monitor`` /\n    ``result.all_complete`` / ``result.monitors`` explicitly (never the raw\n    dict) -- this is the one place that produces that flat shape from the\n    nested ``since_clear``/``monitors`` payload ``ops.obd_readiness``\n    returns, so the page and the verdict's own ``readiness`` sub-object\n    agree on what \"the EVAP monitor is complete\" means.\n    \"\"\"\n    since = raw.get(\"since_clear\") or {}\n    monitors = since.get(\"monitors\") or []\n    evap = next((m for m in monitors if m.get(\"monitor\") == \"Evaporative system\"), None)\n    return {\n        \"at\": datetime.now().isoformat(timespec=\"seconds\"),\n        \"evap_monitor\": bool(evap and evap.get(\"complete\")),\n        \"all_complete\": bool(since.get(\"all_complete\")),\n        \"monitors\": [{\"name\": m.get(\"monitor\"), \"complete\": bool(m.get(\"complete\"))}\n                     for m in monitors],\n    }\n\n\ndef _evap_from_readiness(obs: dict[str, Any] | None) -> dict[str, Any] | None:\n    if obs is None:\n        return None\n    data = obs.get(\"data\") or {}\n    since = data.get(\"since_clear\") or {}\n    monitors = since.get(\"monitors\") or []\n    evap = next((m for m in monitors if m.get(\"monitor\") == \"Evaporative system\"), None)\n    if not monitors:\n        state = None\n    elif evap is None:\n        state = \"not_supported\"\n    else:\n        state = \"complete\" if evap.get(\"complete\") else \"incomplete\"\n    return {\"at\": obs.get(\"at\"), \"evap_monitor\": state,\n            \"all_complete\": bool(since.get(\"all_complete\"))}\n\n\n# --- verdict -----------------------------------------------------------------\n\n\ndef _verdict_actions(vin: str, enabled: bool) -> list[dict[str, Any]]:\n    hint = \"\" if enabled else \"connect the car (ELM327 on COM3)\"\n    return [\n        {\"label\": \"Verify repair\", \"kind\": \"readiness\", \"href\": f\"/v/{vin}/verify\",\n         \"enabled\": enabled, \"hint\": hint},\n        {\"label\": \"EVAP fault tree\", \"kind\": \"link\", \"href\": f\"/v/{vin}/tree\",\n         \"enabled\": True, \"hint\": \"\"},\n        {\"label\": \"Evidence gate\", \"kind\": \"link\", \"href\": f\"/v/{vin}/gate\",\n         \"enabled\": True, \"hint\": \"\"},\n    ]\n\n\ndef _verdict_summary(state: str, open_work: list[dict[str, Any]],\n                     cleared_at: str | None, dossier: dict[str, Any]) -> str:\n    if open_work:\n        codes = open_work[0][\"codes\"][:3]\n    else:\n        chronic = (dossier.get(\"history\") or {}).get(\"chronic\") or []\n        codes = sorted({_base(r.get(\"dtc\", \"\")) for r in chronic})[:3]\n    code_str = \"/\".join(codes) if codes else \"the logged codes\"\n    cleared_short = _short_date(cleared_at) if cleared_at else None\n\n    if state == \"NO_DATA\":\n        return \"No MES logs on file for this vehicle.\"\n    if state == \"ACTIVE_FAULTS\":\n        return f\"{code_str} active now -- not cleared, not resolved.\"\n    if state == \"VERIFIED_CLEAN\":\n        return f\"{code_str} cleared {cleared_short}; EVAP monitor ran clean. Repair verified.\"\n    return f\"{code_str} cleared {cleared_short}; monitors have not re-run. Not proof of repair.\"\n\n\ndef _build_verdict(vin: str, dossier: dict[str, Any], live_status: dict[str, Any] | None,\n                   open_work: list[dict[str, Any]]) -> dict[str, Any]:\n    identity = dossier.get(\"identity\") or {}\n    enabled = live_available(live_status)\n\n    if not identity.get(\"log_count\"):\n        return {\"state\": \"NO_DATA\", \"label\": \"No data\",\n                \"summary\": \"No MES logs on file for this vehicle.\",\n                \"basis\": [\"no logs matched this VIN\"],\n                \"cleared_at\": None, \"cleared_by\": None, \"readiness\": None,\n                \"actions\": _verdict_actions(vin, enabled)}\n\n    cp = dossier.get(\"current_picture\") or {}\n    history = dossier.get(\"history\") or {}\n    cleared_at, cleared_by, clear_assessment = _clear_info(dossier)\n\n    basis: list[str] = []\n    active = False\n\n    latest_session = cp.get(\"latest_session\") or {}\n    if (cleared_at and latest_session.get(\"timestamp\")\n            and latest_session.get(\"timestamp\") > cleared_at\n            and latest_session.get(\"dtcs\")):\n        active = True\n        basis.append(f\"newest session ({latest_session['timestamp']}) holds DTCs \"\n                     f\"after the {cleared_at} clear\")\n\n    latest_scan = cp.get(\"latest_scan\") or {}\n    if (cleared_at and latest_scan.get(\"timestamp\")\n            and latest_scan.get(\"timestamp\") > cleared_at\n            and latest_scan.get(\"modules_with_faults\")):\n        active = True\n        basis.append(f\"newest scan ({latest_scan['timestamp']}) holds DTCs \"\n                     f\"after the {cleared_at} clear\")\n\n    returned_in_session = (clear_assessment or {}).get(\"codes_returned_in_session\") or []\n    if returned_in_session:\n        active = True\n        basis.append(\"codes returned in the clearing session: \"\n                     + \", \".join(returned_in_session))\n\n    uncleared = (clear_assessment or {}).get(\"codes_that_would_not_clear\") or []\n    if uncleared:\n        active = True\n        basis.append(\"codes would not clear: \" + \", \".join(uncleared))\n\n    if history.get(\"returned_after_clear\"):\n        active = True\n        basis.append(\"returned after a clear: \" + \", \".join(\n            sorted(_base(r.get(\"dtc\", \"\")) for r in history[\"returned_after_clear\"])))\n\n    readiness = None\n    if cleared_at:\n        readiness = _evap_from_readiness(_latest_readiness(vin, cleared_at))\n\n    if active:\n        state, label = \"ACTIVE_FAULTS\", \"Active faults\"\n    elif cleared_at is None:\n        if history.get(\"chronic\"):\n            state, label = \"ACTIVE_FAULTS\", \"Active faults\"\n            basis.append(\"chronic codes on file and no clear recorded\")\n        else:\n            state, label = \"NO_DATA\", \"No data\"\n            basis.append(\"no open codes and no clear on file\")\n    elif readiness and readiness.get(\"evap_monitor\") == \"complete\":\n        state, label = \"VERIFIED_CLEAN\", \"Verified clean\"\n        basis.append(f\"EVAP monitor complete on a live read at {readiness['at']}, \"\n                     f\"no code has returned since the {cleared_at} clear\")\n    else:\n        state, label = \"UNVERIFIED_REPAIR\", \"Unverified repair\"\n        basis.append(f\"last clear {cleared_at} ({cleared_by or 'unknown source'}); \"\n                     f\"no code has returned\")\n        if readiness is None:\n            basis.append(\"no readiness read from the car since the clear\")\n        else:\n            basis.append(f\"readiness read at {readiness['at']} -- EVAP monitor \"\n                         f\"{readiness.get('evap_monitor') or 'unknown'}\")\n\n    return {\n        \"state\": state, \"label\": label,\n        \"summary\": _verdict_summary(state, open_work, cleared_at, dossier),\n        \"basis\": basis,\n        \"cleared_at\": cleared_at.split(\" \")[0] if cleared_at else None,\n        \"cleared_by\": cleared_by,\n        \"readiness\": readiness,\n        \"actions\": _verdict_actions(vin, enabled),\n    }\n\n\n# --- verdict.next_action -- the one-sentence \"what do I do right now\" -------\n#\n# Added for the bench page (cuore/services/bench_bridge.py): a mechanic\n# landing on a car should not have to read the verdict's basis list and the\n# open-work cards to work out what to actually do next. Nothing here is a\n# new judgement -- it just combines the verdict state already computed above\n# with the same fuel-out-of-window flag :func:`_build_freeze_frames` already\n# derives and the same open-work steps :func:`_build_open_work` already\n# orders, into the one sentence (plus a short ``blocker`` label and the\n# ``next_step_id`` it points at) the bench page's headline needs.\n\n\ndef _first_unchecked_step(open_work: list[dict[str, Any]]\n                          ) -> tuple[dict[str, Any] | None, dict[str, Any] | None]:\n    \"\"\"The first not-yet-done step across every open-work card, in the same\n    order the cards themselves are already in (curated families first, then\n    the generic ones) -- ``(card, step)``, or ``(None, None)`` if every step\n    on file is ticked.\"\"\"\n    for card in open_work:\n        for step in card.get(\"steps\") or []:\n            if not step.get(\"done\"):\n                return card, step\n    return None, None\n\n\ndef _step_bit(step: dict[str, Any] | None) -> str | None:\n    \"\"\"\"<step text> (<bulletin>)\" -- the fragment both the ACTIVE_FAULTS and\n    fuel-blocked UNVERIFIED_REPAIR sentences below quote verbatim.\"\"\"\n    if step is None:\n        return None\n    bulletin = step.get(\"ref\") or \"no bulletin on file\"\n    return f\"{step['text']} ({bulletin})\"\n\n\ndef _fuel_out_of_window(freeze_frames: list[dict[str, Any]]\n                        ) -> tuple[float, str, float] | None:\n    \"\"\"``(level, \"above\"/\"below\", threshold)`` for the first EVAP freeze-frame\n    fuel reading outside :data:`_EVAP_FUEL_WINDOW` -- the same flag\n    :func:`_build_freeze_frames` already set on that reading -- or ``None``\n    when no freeze frame carries that flag.\"\"\"\n    lo, hi = _EVAP_FUEL_WINDOW\n    for ff in freeze_frames:\n        for p in ff.get(\"key\") or []:\n            if p.get(\"name\") != \"Fuel level\" or not p.get(\"flag\"):\n                continue\n            level = _num(p.get(\"value\"))\n            if level is None:\n                continue\n            return level, (\"below\" if level < lo else \"above\"), (lo if level < lo else hi)\n    return None\n\n\ndef _verdict_next_action(verdict: dict[str, Any], open_work: list[dict[str, Any]],\n                         freeze_frames: list[dict[str, Any]]\n                         ) -> tuple[str, str, str | None]:\n    \"\"\"``(next_action sentence, blocker label, next_step_id)`` for one\n    verdict. Never raises -- a missing open-work step or freeze frame just\n    means a shorter sentence, not a broken one.\"\"\"\n    state = verdict.get(\"state\")\n    _card, step = _first_unchecked_step(open_work)\n    step_id = step.get(\"id\") if step else None\n    bit = _step_bit(step)\n\n    if state == \"UNVERIFIED_REPAIR\":\n        fuel = _fuel_out_of_window(freeze_frames)\n        if fuel is not None:\n            level, direction, threshold = fuel\n            sentence = (f\"Cannot verify yet: the EVAP monitor will not run {direction} \"\n                       f\"{threshold:g} % fuel (set at {level:g} %). Burn fuel into the \"\n                       f\"{_EVAP_FUEL_WINDOW[0]:g}-{_EVAP_FUEL_WINDOW[1]:g} % window, then \"\n                       f\"complete a drive cycle.\")\n            if bit:\n                sentence += f\" Meanwhile: {bit}.\"\n            return sentence, \"fuel out of window\", step_id\n        sentence = (\"Cannot verify yet: no readiness read since the clear. Read \"\n                    \"readiness once the drive cycle completes.\")\n        if bit:\n            sentence += f\" Meanwhile: {bit}.\"\n        return sentence, \"awaiting drive cycle\", step_id\n\n    if state == \"ACTIVE_FAULTS\":\n        if bit:\n            return f\"Start with {bit}.\", \"active faults\", step_id\n        return \"Active faults on file -- open the codes to begin.\", \"active faults\", None\n\n    if state == \"VERIFIED_CLEAN\":\n        readiness = verdict.get(\"readiness\") or {}\n        date = _short_date(readiness.get(\"at\")) or verdict.get(\"cleared_at\") or \"the last read\"\n        return f\"Verified by readiness read on {date}: release.\", \"none\", None\n\n    return \"Read the car.\", \"no data\", None\n\n\n# --- open work (family findings as a checklist) -----------------------------\n\n\ndef _family_refs(codes: list[str], per_code: dict[str, Any],\n                 reading: str) -> list[dict[str, Any]]:\n    seen: dict[str, dict[str, Any]] = {}\n    for code in codes:\n        for b in per_code.get(code, []):\n            num = b.get(\"bulletin\")\n            if num and num not in seen:\n                seen[num] = {\"label\": num, \"href\": f\"#tsb-{_slug(num)}\"}\n    for doc in re.findall(r\"docs/\\S+?\\.md\", reading or \"\"):\n        if doc not in seen:\n            seen[doc] = {\"label\": doc, \"href\": None}\n    return list(seen.values())\n\n\ndef _build_open_work(vin: str, dossier: dict[str, Any],\n                     checklist: dict[str, Any]) -> list[dict[str, Any]]:\n    tsb = dossier.get(\"tsb_matches\") or {}\n    findings = tsb.get(\"family_findings\") or []\n    per_code = tsb.get(\"per_code\") or {}\n    cards = []\n    covered_codes: set[str] = set()\n    for f in findings:\n        family = f.get(\"family\") or \"\"\n        steps_def = FAMILY_STEPS.get(family)\n        if not steps_def:\n            continue  # no checklist table for this family yet\n        codes = [c.upper() for c in (f.get(\"codes\") or [])]\n        covered_codes.update(codes)\n        steps = []\n        done = 0\n        for s in steps_def:\n            st = checklist.get(s[\"id\"]) or {}\n            is_done = bool(st.get(\"done\"))\n            done += int(is_done)\n            steps.append({\n                \"id\": s[\"id\"], \"text\": s[\"text\"], \"ref\": s[\"ref\"],\n                \"ref_href\": f\"#tsb-{_slug(s['ref'])}\" if s[\"ref\"] else None,\n                \"done\": is_done, \"done_at\": st.get(\"done_at\"),\n                \"done_by\": st.get(\"done_by\"),\n            })\n        title = _FAMILY_TITLES.get(family, f\"{family}: one system fault\")\n        if \"{n}\" in title:\n            title = title.format(n=len(codes))\n        cards.append({\n            \"family\": family, \"title\": title, \"codes\": codes, \"steps\": steps,\n            \"refs\": _family_refs(codes, per_code, f.get(\"reading\", \"\")),\n            \"progress\": {\"done\": done, \"total\": len(steps_def)},\n        })\n\n    # Every other family this car's own history shows, grouped by the\n    # generic SAE-range classification above, with steps pulled live from\n    # mes.faulttree via mes_bridge.fault_tree -- so EVAP keeps being the\n    # richest, hand-curated example, but a misfire, fuel-trim, cooling,\n    # body, chassis or ADAS code (or any other family) still gets a\n    # sourced, actionable card instead of nothing.\n    remaining = sorted(_history_codes(dossier) - covered_codes)\n    groups: dict[str, list[str]] = {}\n    labels: dict[str, str] = {}\n    for code in remaining:\n        fam = _generic_family_for(code)\n        if fam is None:\n            continue\n        key, label = fam\n        groups.setdefault(key, []).append(code)\n        labels[key] = label\n    for family_key in sorted(groups):\n        codes = sorted(set(groups[family_key]))\n        tree_steps = _generic_tree_steps(codes[0], vin)[:6]\n        if not tree_steps:\n            continue\n        steps = []\n        done = 0\n        for i, s in enumerate(tree_steps):\n            step_id = f\"{family_key}-{i + 1}\"\n            st = checklist.get(step_id) or {}\n            is_done = bool(st.get(\"done\"))\n            done += int(is_done)\n            text = s.get(\"title\") or s.get(\"test\") or \"Step\"\n            if s.get(\"test\") and s.get(\"test\") != text:\n                text = f\"{text}: {s['test']}\"\n            steps.append({\n                \"id\": step_id, \"text\": text, \"ref\": s.get(\"source\"),\n                \"ref_href\": None,\n                \"done\": is_done, \"done_at\": st.get(\"done_at\"),\n                \"done_by\": st.get(\"done_by\"),\n            })\n        label = labels.get(family_key, family_key)\n        title = (f\"{label}: one open issue\" if len(codes) == 1\n                 else f\"{label}: {len(codes)} codes, one system\")\n        cards.append({\n            \"family\": family_key, \"title\": title, \"codes\": codes,\n            \"steps\": steps, \"refs\": [],\n            \"progress\": {\"done\": done, \"total\": len(steps)},\n            \"generic\": True,\n        })\n    return cards\n\n\ndef _family_map(dossier: dict[str, Any]) -> dict[str, str]:\n    out: dict[str, str] = {}\n    for f in (dossier.get(\"tsb_matches\") or {}).get(\"family_findings\", []):\n        for c in f.get(\"codes\", []):\n            out[c.upper()] = f.get(\"family\")\n    return out\n\n\n# --- the code table -----------------------------------------------------------\n\n\ndef _code_status(base: str, last_seen: str | None, cleared_at: str | None,\n                 codes_cleared: set[str], codes_returned: set[str],\n                 codes_uncleared: set[str], last_findings: set[str],\n                 last_findings_ts: str | None, recent_ts: list[str]) -> str:\n    if base in codes_returned or base in codes_uncleared:\n        return \"ACTIVE\"\n    if cleared_at and last_seen and last_seen > cleared_at:\n        return \"ACTIVE\"\n    if base in last_findings and not (cleared_at and last_findings_ts\n                                      and cleared_at >= last_findings_ts):\n        return \"ACTIVE\"\n    if cleared_at and base in codes_cleared and (not last_seen or last_seen <= cleared_at):\n        return \"CLEARED_UNVERIFIED\"\n    if cleared_at is None and last_seen and last_seen in recent_ts[:3]:\n        return \"ACTIVE\"\n    return \"STALE\"\n\n\ndef _code_rows(vin: str, dossier: dict[str, Any], cleared_at: str | None,\n              clear_assessment: dict[str, Any] | None, recent_ts: list[str],\n              family_map: dict[str, str]\n              ) -> tuple[list[dict[str, Any]], dict[str, int]]:\n    history = dossier.get(\"history\") or {}\n    cp = dossier.get(\"current_picture\") or {}\n    last_findings_session = cp.get(\"last_session_with_findings\") or {}\n    last_findings = {_base(d.get(\"code\") or d.get(\"dtc\") or \"\")\n                     for d in last_findings_session.get(\"dtcs\", [])}\n    last_findings_ts = last_findings_session.get(\"timestamp\")\n\n    codes_cleared = {_base(c) for c in (clear_assessment or {}).get(\"codes_cleared\", [])}\n    codes_returned = {_base(c) for c in\n                      (clear_assessment or {}).get(\"codes_returned_in_session\", [])}\n    codes_uncleared = {_base(c) for c in\n                       (clear_assessment or {}).get(\"codes_that_would_not_clear\", [])}\n\n    rows: list[dict[str, Any]] = []\n    for bucket in (\"chronic\", \"returned_after_clear\", \"seen_once\"):\n        for rec in history.get(bucket, []):\n            full = rec.get(\"dtc\", \"\")\n            base = _base(full)\n            last_seen = rec.get(\"last_seen\")\n            status = _code_status(base, last_seen, cleared_at, codes_cleared,\n                                  codes_returned, codes_uncleared, last_findings,\n                                  last_findings_ts, recent_ts)\n            distance = rec.get(\"distance_span_km\")\n            rows.append({\n                \"code\": base, \"dtc\": full,\n                \"description\": (rec.get(\"descriptions\") or [\"\"])[0],\n                \"system\": _SYSTEM_BY_LETTER.get(base[:1], base[:1] if base else None),\n                \"bucket\": bucket,\n                \"status\": status, \"status_label\": _STATUS_LABEL[status],\n                \"sessions\": rec.get(\"sessions\"),\n                \"last_seen_short\": _short_date(last_seen),\n                \"last_seen\": last_seen, \"first_seen\": rec.get(\"first_seen\"),\n                \"distance_km\": round(distance) if distance is not None else None,\n                \"href\": f\"/v/{vin}/code/{base}\",\n                \"family\": family_map.get(base),\n            })\n\n    counts = {\"chronic\": 0, \"seen_once\": 0, \"returned_after_clear\": 0,\n             \"active\": 0, \"stale\": 0}\n    for r in rows:\n        counts[r[\"bucket\"]] = counts.get(r[\"bucket\"], 0) + 1\n        if r[\"status\"] == \"ACTIVE\":\n            counts[\"active\"] += 1\n        elif r[\"status\"] == \"STALE\":\n            counts[\"stale\"] += 1\n    return rows, counts\n\n\n# --- already attempted -------------------------------------------------------\n\n\ndef _build_attempted(vin: str) -> list[dict[str, Any]]:\n    try:\n        data = mes_bridge.actuator_history(vin=vin)\n    except BridgeError:\n        return []\n    note = data.get(\"note\")\n    groups: dict[tuple[str, str], dict[str, Any]] = {}\n    for r in data.get(\"runs\", []):\n        key = (r.get(\"operation\"), r.get(\"outcome\"))\n        g = groups.setdefault(key, {\"operation\": r.get(\"operation\"),\n                                    \"kind\": r.get(\"kind\"), \"outcome\": r.get(\"outcome\"),\n                                    \"reason\": None, \"rows\": []})\n        g[\"rows\"].append(r)\n        if r.get(\"reason\") and not g[\"reason\"]:\n            g[\"reason\"] = r.get(\"reason\")\n\n    out = []\n    for g in groups.values():\n        times = sorted(r.get(\"timestamp\") for r in g[\"rows\"] if r.get(\"timestamp\"))\n        reason = g[\"reason\"]\n        footnote = note if (reason and note and \"engine running\" in reason.lower()) else None\n        out.append({\n            \"operation\": g[\"operation\"], \"kind\": g[\"kind\"], \"outcome\": g[\"outcome\"],\n            \"count\": len(g[\"rows\"]),\n            \"first_short\": _short_date(times[0]) if times else None,\n            \"last_short\": _short_date(times[-1]) if times else None,\n            \"reason\": reason, \"reason_chip\": reason, \"footnote\": footnote,\n            \"rows\": g[\"rows\"],\n        })\n    out.sort(key=lambda g: (g[\"outcome\"] != \"FAILED TO EXECUTE\", g[\"operation\"] or \"\"))\n    return out\n\n\n# --- freeze frames -------------------------------------------------------------\n\n\ndef _build_freeze_frames(vin: str, dossier: dict[str, Any]) -> list[dict[str, Any]]:\n    cp = dossier.get(\"current_picture\") or {}\n    target_ts = ((cp.get(\"last_session_with_findings\") or {}).get(\"timestamp\")\n                or (cp.get(\"latest_session\") or {}).get(\"timestamp\"))\n    if not target_ts:\n        return []\n    try:\n        data = mes_bridge.freeze_frames(vin=vin)\n    except BridgeError:\n        return []\n\n    odo_last = (dossier.get(\"identity\") or {}).get(\"odometer_last_km\")\n    out = []\n    for f in data.get(\"frames\", []):\n        if f.get(\"timestamp\") != target_ts:\n            continue\n        ff = f.get(\"freeze_frame\") or {}\n        base = _base(f.get(\"dtc\", \"\"))\n        key = []\n        for name in _KEY_FRAME_PARAMS:\n            if name not in ff:\n                continue\n            value = ff[name]\n            flag = None\n            if name == \"Fuel level\" and base in _EVAP_CODES:\n                level = _num(value)\n                lo, hi = _EVAP_FUEL_WINDOW\n                if level is not None and (level < lo or level > hi):\n                    bound = f\"below {lo:g} %\" if level < lo else f\"above {hi:g} %\"\n                    flag = f\"{bound}: EVAP monitor could not run\"\n            key.append({\"name\": name, \"value\": value, \"flag\": flag})\n        odo_frame = _num(ff.get(\"Odometer\"))\n        set_km_ago = (round(odo_last - odo_frame)\n                     if odo_last is not None and odo_frame is not None else None)\n        out.append({\n            \"code\": f.get(\"dtc\"), \"key\": key, \"set_km_ago\": set_km_ago,\n            \"all\": [{\"name\": n, \"value\": v} for n, v in ff.items()],\n        })\n    return out\n\n\n# --- blind spots as actions ----------------------------------------------------\n\n\ndef _blind_spot_action(vin: str, closes_it: str, enabled: bool) -> dict[str, Any]:\n    low = (closes_it or \"\").lower()\n    hint = \"\" if enabled else \"connect the car (ELM327 on COM3)\"\n    if \"read_readiness\" in low:\n        return {\"label\": \"Read readiness\", \"kind\": \"readiness\",\n                \"href\": f\"/v/{vin}/verify\", \"enabled\": enabled, \"hint\": hint}\n    if \"read_permanent_dtcs\" in low:\n        return {\"label\": \"Read permanent DTCs\", \"kind\": \"permanent\", \"href\": None,\n                \"enabled\": enabled, \"hint\": hint}\n    if \"mode06\" in low or \"send_raw\" in low:\n        return {\"label\": \"Read Mode $06\", \"kind\": \"mode06\", \"href\": None,\n                \"enabled\": enabled, \"hint\": hint}\n    if \"already closed\" in low:\n        return {\"label\": \"Answered\", \"kind\": \"link\", \"href\": f\"/v/{vin}/dealer\",\n                \"enabled\": True, \"hint\": \"\"}\n    if \"witech\" in low or \"dealer\" in low:\n        return {\"label\": \"Dealer / wiTECH\", \"kind\": \"dealer\", \"href\": f\"/v/{vin}/dealer\",\n                \"enabled\": True, \"hint\": \"\"}\n    return {\"label\": \"Manual check\", \"kind\": \"manual\", \"href\": None,\n            \"enabled\": True, \"hint\": \"\"}\n\n\ndef _build_blind_spots(vin: str, dossier: dict[str, Any],\n                       live_status: dict[str, Any] | None) -> list[dict[str, Any]]:\n    enabled = live_available(live_status)\n    out = []\n    for bs in dossier.get(\"blind_spots\", []):\n        out.append({\n            \"question\": bs.get(\"question\", \"\"),\n            \"why\": bs.get(\"why_unknown\", \"\"),\n            \"action\": _blind_spot_action(vin, bs.get(\"closes_it\", \"\"), enabled),\n        })\n    return out\n\n\n# --- bulletins, deduplicated ---------------------------------------------------\n\n\ndef _supersedes(action: str) -> str | None:\n    m = re.search(r\"[Ss]upersed(?:es|ed)\\s+([A-Za-z0-9.\\-]+)\", action or \"\")\n    return m.group(1).rstrip(\".\") if m else None\n\n\ndef _build_bulletins(dossier: dict[str, Any],\n                     open_work: list[dict[str, Any]]) -> list[dict[str, Any]]:\n    tsb = dossier.get(\"tsb_matches\") or {}\n    per_code = tsb.get(\"per_code\") or {}\n    relevant = {c for card in open_work for c in card[\"codes\"]}\n\n    by_num: dict[str, dict[str, Any]] = {}\n    for code, matches in per_code.items():\n        for b in matches:\n            num = b.get(\"bulletin\")\n            if not num:\n                continue\n            entry = by_num.setdefault(num, {\n                \"id\": num, \"anchor\": f\"tsb-{_slug(num)}\", \"title\": b.get(\"title\"),\n                \"action\": b.get(\"action\"), \"caution\": b.get(\"caution\"),\n                \"codes\": set(), \"superseded\": _supersedes(b.get(\"action\", \"\")),\n                \"source\": b.get(\"source\"), \"relevance\": 0,\n            })\n            entry[\"codes\"].update(b.get(\"dtcs\") or [code])\n            if code.upper() in relevant:\n                entry[\"relevance\"] += 1\n\n    out = []\n    for entry in by_num.values():\n        entry[\"codes\"] = sorted(entry[\"codes\"])\n        out.append(entry)\n    out.sort(key=lambda e: (-e[\"relevance\"], e[\"id\"]))\n    return out\n\n\n# --- latest session/scan -------------------------------------------------------\n\n\ndef _build_latest(dossier: dict[str, Any]) -> dict[str, Any]:\n    cp = dossier.get(\"current_picture\") or {}\n    ls = cp.get(\"latest_session\") or {}\n    sc = cp.get(\"latest_scan\") or {}\n    return {\n        \"session_short\": _short_date(ls.get(\"timestamp\"), with_time=True),\n        \"session_file\": ls.get(\"file\"), \"ecu\": ls.get(\"ecu\"),\n        \"scan_short\": (_short_date(sc.get(\"timestamp\"), with_time=True)\n                       if sc.get(\"timestamp\") else None),\n        \"scan_file\": sc.get(\"file\"),\n    }\n\n\n# --- checklist step ids, for the API's validation ----------------------------\n\n\ndef checklist_step_ids(vin: str, dossier: dict[str, Any]) -> set[str]:\n    \"\"\"Every checklist step id this vehicle's open-work cards expose.\n\n    Used by the checklist API to reject a step id that is not actually on\n    this car's dossier -- a step id is only meaningful in the context of the\n    family finding it belongs to.\n    \"\"\"\n    open_work = _build_open_work(vin, dossier, {})\n    return {s[\"id\"] for card in open_work for s in card[\"steps\"]}\n\n\n# --- the one entry point -----------------------------------------------------\n\n\ndef _build_view_core(vin: str, dossier: dict[str, Any]) -> dict[str, Any]:\n    \"\"\"Everything :func:`build_view` needs except the verdict and blind\n    spots, which also read ``live_status`` and are cheap enough (no file\n    I/O beyond what ``dossier`` already carries) to compute fresh on every\n    call. Split out purely so it can be memoised -- see ``build_view``.\n    \"\"\"\n    checklist = checklist_store.get(vin)\n    open_work = _build_open_work(vin, dossier, checklist)\n\n    family_map = _family_map(dossier)\n    try:\n        recent_ts = [e.get(\"timestamp\") for e in\n                    mes_bridge.list_logs(vin=vin, limit=3)[\"logs\"]]\n    except BridgeError:\n        recent_ts = []\n    cleared_at, _cleared_by, clear_assessment = _clear_info(dossier)\n    codes, code_counts = _code_rows(vin, dossier, cleared_at, clear_assessment,\n                                    recent_ts, family_map)\n\n    return {\n        \"open_work\": open_work,\n        \"codes\": codes,\n        \"code_counts\": code_counts,\n        \"attempted\": _build_attempted(vin),\n        \"freeze_frames\": _build_freeze_frames(vin, dossier),\n        \"bulletins\": _build_bulletins(dossier, open_work),\n        \"latest\": _build_latest(dossier),\n        \"provenance_note\": dossier.get(\"provenance_note\", \"\"),\n    }\n\n\ndef build_view(vin: str, dossier: dict[str, Any],\n              live_status: dict[str, Any] | None) -> dict[str, Any]:\n    \"\"\"Everything the redesigned dossier page needs, computed once.\n\n    ``dossier`` is the workup dict (``mes_bridge.workup(vin=vin)``);\n    ``live_status`` is the same shape ``base.html``'s live strip already\n    renders (``port``, ``mes_state``, ``lock_holder``, ...), or ``None`` when\n    the caller has not computed it. Nothing here mutates either argument or\n    touches the car -- nothing here writes anything at all.\n\n    The dossier, job and flow pages between them call this several times\n    per render (the Job page alone calls it twice: once for its own\n    suggested-hypothesis evidence, once for the page body) and the open-work\n    cards alone re-evaluate a fault tree per code, parsing FES logs directly\n    -- seconds of work on a real corpus. Everything but the verdict and\n    blind spots is pulled from :func:`_build_view_core`, memoised on (vin,\n    newest MES-log mtime, newest state-file mtime) exactly like\n    ``cuore.web.routes._dossier`` already memoises the workup itself, so a\n    second call in the same request (or the next request, until a log or a\n    state file changes) costs a dict lookup instead of a re-evaluation. The\n    verdict and blind spots stay outside that cache because they depend on\n    ``live_status``, which varies request to request and is not part of the\n    key.\n    \"\"\"\n    core = cache.get_or_build(\n        (\"dossier_view_core\", vin, mes_bridge.newest_mtime(vin), _state_fingerprint()),\n        lambda: _build_view_core(vin, dossier),\n    )\n    verdict = _build_verdict(vin, dossier, live_status, core[\"open_work\"])\n    next_action, blocker, next_step_id = _verdict_next_action(\n        verdict, core[\"open_work\"], core[\"freeze_frames\"])\n    verdict[\"next_action\"] = next_action\n    verdict[\"blocker\"] = blocker\n    verdict[\"next_step_id\"] = next_step_id\n    blind_spots = _build_blind_spots(vin, dossier, live_status)\n    return {\"verdict\": verdict, \"blind_spots\": blind_spots, **core}\n\n\n__all__ = [\"build_view\", \"checklist_step_ids\", \"live_available\", \"readiness_result\",\n           \"FAMILY_STEPS\"]\n","numLines":983,"startLine":1,"totalLines":983}},"sourceToolAssistantUUID":"7b563b5c-9a9a-4042-bddf-ac3d1e22da0f","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
{"parentUuid":"187dd8a4-bca1-4879-9716-62cb151542a3","isSidechain":true,"agentId":"a31762a22e4ea769a","message":{"model":"claude-sonnet-5","id":"msg_011CfqB8ZV2K2udwMJoZvMq1","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_018L442bVg4fpdyyt1cxFG5e","name":"Read","input":{"file_path":"C:\\Users\\User\\mcp-servers\\cuore\\web\\templates\\_tools_panel.html"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":7925,"cache_read_input_tokens":57441,"cache_creation":{"ephemeral_5m_input_tokens":7925,"ephemeral_1h_input_tokens":0},"output_tokens":2,"service_tier":"standard","inference_geo":"not_available"},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_018L442bVg4fpdyyt1cxFG5e":{"file_path":"C:\\Users\\User\\mcp-servers\\cuore\\web\\templates\\_tools_panel.html"}},"serverClassifierRequest":"f77d7f4e-237a-4563-96c8-0606b164aed5","apiBlockIndex":7,"requestId":"req_011CfqB8ZDAUVrUJjBkAdk4W","attributionAgent":"general-purpose","type":"assistant","uuid":"9fe3d9a7-2c7e-48c7-8500-9a46eec4d0a8","timestamp":"2026-10-08T17:36:53.790Z","effort":"high","perTurnEffort":null,"userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
{"parentUuid":"9fe3d9a7-2c7e-48c7-8500-9a46eec4d0a8","isSidechain":true,"promptId":"14b8b90f-0c4b-47b6-b2bf-3803814525db","agentId":"a31762a22e4ea769a","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018L442bVg4fpdyyt1cxFG5e","type":"tool_result","content":"1\t{# Reusable \"Tools for this step\" panel. Fed by the `tools_recommend` Jinja\n2\t   global (registered as an import-time side effect by\n3\t   cuore/web/tools_kb_globals.py -- see that module's docstring) via a\n4\t   page-local `panel = tools_recommend(step=..., vin=...)` set before this\n5\t   include. Guarded so a page still renders -- with the empty state below\n6\t   -- before that global lands, and before mes.tools_kb itself lands.\n7\t\n8\t   Context expected:\n9\t     panel    -- {step, tools: [row...], learned: {...}} shaped per\n10\t                 cuore.services.tools_kb_bridge.recommend_with_learning.\n11\t     compact  -- optional; truthy renders a shorter form for inline use\n12\t                 (maintenance.html per-item), no learned-detail expansion. #}\n13\t{% set panel = panel if panel is defined else {\"step\": \"\", \"tools\": [], \"learned\": {}} %}\n14\t{% set compact = compact if compact is defined else False %}\n15\t\n16\t{% macro tk_conf_chip(c) -%}\n17\t<span class=\"chip {{ 'ok' if c in ('CONFIRMED','CORROBORATED') else ('chronic' if c == 'SINGLE-SOURCE' else 'plain') }}\">{{ c }}</span>\n18\t{%- endmacro %}\n19\t\n20\t<div class=\"panel tight tools-panel\">\n21\t  <h3>Tools for this step{% if panel.tools %} <span class=\"count-badge\">{{ panel.tools|length }}</span>{% endif %}</h3>\n22\t  {% if panel.tools %}\n23\t    <div class=\"tool-rows\">\n24\t    {% for row in panel.tools %}\n25\t      {% set ti = row.tool_info %}\n26\t      {% set have = row.have if row.have is defined else \"unknown\" %}\n27\t      <div class=\"tool-row\">\n28\t        <div class=\"tool-row-main\">\n29\t          <b>{{ ti.name }}</b>\n30\t          <span class=\"small muted tool-kind\">{{ ti.kind }}</span>\n31\t          <span class=\"small {{ 'tool-required' if row.required else 'muted' }}\">{{ \"required\" if row.required else \"optional\" }}</span>\n32\t          <span class=\"chip {{ 'ok' if have == 'owned' else ('returned' if have == 'not_owned' else 'plain') }} have-chip\">have it: {{ {\"owned\": \"yes\", \"not_owned\": \"no\", \"unknown\": \"not recorded\"}[have] }}</span>\n33\t        </div>\n34\t        <p class=\"small mono tool-spec\">{{ ti.spec or \"UNKNOWN -- confirm on the car / service manual (TechAuthority)\" }}\n35\t          {{ tk_conf_chip(ti.confidence) }}\n36\t          {% if ti.source %}<a href=\"{{ ti.source }}\" target=\"_blank\" rel=\"noopener\">source</a>{% endif %}</p>\n37\t        {% if ti.why %}<p class=\"small muted\">{{ ti.why }}</p>{% endif %}\n38\t        {% if row.note %}<p class=\"small tool-note\">{{ row.note }}</p>{% endif %}\n39\t        {% if row.torques %}\n40\t          <p class=\"small\">\n41\t          {% for t in row.torques %}\n42\t            <span class=\"chip plain evidence-chip\">{{ t.component or t.key }}: {{ t.display }}</span>\n43\t            {{ tk_conf_chip(t.confidence) }}\n44\t          {% endfor %}\n45\t          </p>\n46\t        {% endif %}\n47\t        {% if row.alternatives_info %}\n48\t          <p class=\"small muted\">Alternatives: {% for a in row.alternatives_info %}{{ a.name }}{% if not loop.last %}, {% endif %}{% endfor %}</p>\n49\t        {% endif %}\n50\t\n51\t        {% if not compact %}\n52\t        <form method=\"post\" action=\"/tools-kb/inventory-form\" class=\"tool-have-form\">\n53\t          <input type=\"hidden\" name=\"tool\" value=\"{{ ti.key }}\">\n54\t          <input type=\"hidden\" name=\"return_to\" value=\"{{ request.url.path }}\">\n55\t          <button type=\"submit\" name=\"status\" value=\"owned\" class=\"tool-have-btn {{ 'on' if have == 'owned' }}\">I have this</button>\n56\t          <button type=\"submit\" name=\"status\" value=\"not_owned\" class=\"tool-have-btn {{ 'on' if have == 'not_owned' }}\">I don't</button>\n57\t        </form>\n58\t        {% endif %}\n59\t\n60\t        {% if row.decision %}\n61\t          {% set d = row.decision %}\n62\t          <div class=\"tool-decision-card\">\n63\t            <p class=\"small\"><b>Don't have it -- decision needed.</b> {{ d.used_when }}\n64\t              <span class=\"muted\">({{ d.used_when_source }})</span></p>\n65\t            <p class=\"small muted\">How often needed: {{ d.frequency }}\n66\t              {{ tk_conf_chip(d.frequency_confidence) }} <span class=\"muted\">({{ d.frequency_source }})</span></p>\n67\t            <p class=\"small\"><b>Alternatives:</b></p>\n68\t            <ul class=\"small\">\n69\t              {% for a in d.alternatives %}\n70\t                <li>{{ a.option }} &mdash; {{ a.note }}\n71\t                  {% if a.cost %}(<span class=\"mono\">{{ a.cost.range }} {{ a.cost.unit }}</span> {{ tk_conf_chip(a.cost.confidence) }}\n72\t                    <a href=\"{{ a.cost.source }}\" target=\"_blank\" rel=\"noopener\">source</a>){% endif %}</li>\n73\t              {% endfor %}\n74\t            </ul>\n75\t            <p class=\"small\"><b>Cost options (sourced, never guessed):</b></p>\n76\t            <ul class=\"small\">\n77\t              {% for c in d.cost_options %}\n78\t                <li>{{ c.tier }}: <span class=\"mono\">{{ c.range }} {{ c.unit }}</span> {{ tk_conf_chip(c.confidence) }}\n79\t                  &mdash; {{ c.what }} &mdash; <a href=\"{{ c.source.split(' (')[0] }}\" target=\"_blank\" rel=\"noopener\">source</a></li>\n80\t              {% endfor %}\n81\t            </ul>\n82\t            {% if d.practical_difference %}<p class=\"small muted\">{{ d.practical_difference }}</p>{% endif %}\n83\t            <p class=\"small muted\">Record your decision (buy / borrow / rent / skip + why) in the step 7\n84\t              \"Would buy next time\" review.</p>\n85\t          </div>\n86\t        {% endif %}\n87\t      </div>\n88\t    {% endfor %}\n89\t    </div>\n90\t  {% else %}\n91\t    <p class=\"muted small\">No tool recommendations tabulated yet for this step.</p>\n92\t  {% endif %}\n93\t\n94\t  {% set learned = panel.learned or {} %}\n95\t  {% if learned.review_count %}\n96\t    <h4 class=\"small muted\">What mechanics used last time ({{ learned.review_count }} review{{ \"s\" if learned.review_count != 1 }}{% if learned.scope == \"vin\" %}, this car{% else %}, all cars{% endif %})</h4>\n97\t    {% if learned.top_tools %}\n98\t      <p class=\"small\"><b>Most used:</b>\n99\t        {% for t in learned.top_tools[:5] %}{{ t.tool }} ({{ t.used_count }}){% if not loop.last %}, {% endif %}{% endfor %}</p>\n100\t    {% endif %}\n101\t    {% if learned.flagged_wrong %}\n102\t      <p class=\"small\"><span class=\"chip returned\">flagged wrong</span>\n103\t        {% for f in learned.flagged_wrong %}{{ f.tool }} ({{ f.count }}){% if f.notes %} &mdash; {{ f.notes[0] }}{% endif %}{% if not loop.last %}; {% endif %}{% endfor %}</p>\n104\t    {% endif %}\n105\t    {% if learned.buy_suggestions and not compact %}\n106\t      <p class=\"small\"><b>Would buy next time:</b>\n107\t        {% for b in learned.buy_suggestions %}{{ b.name }} ({{ b.count }}){% if b.why %} &mdash; {{ b.why[0] }}{% endif %}{% if not loop.last %}; {% endif %}{% endfor %}</p>\n108\t    {% endif %}\n109\t    {% if learned.missing_tools and not compact %}\n110\t      <p class=\"small muted\">Reported missing: {% for m in learned.missing_tools %}{{ m.text }} ({{ m.count }}){% if not loop.last %}, {% endif %}{% endfor %}</p>\n111\t    {% endif %}\n112\t  {% elif not compact %}\n113\t    <p class=\"muted small\">No usage reviews recorded yet for this step.</p>\n114\t  {% endif %}\n115\t</div>\n116\t"}]},"uuid":"64c12e38-7e42-4653-82c4-541f790a4205","timestamp":"2026-10-08T17:36:53.825Z","toolUseResult":{"type":"text","file":{"filePath":"C:\\Users\\User\\mcp-servers\\cuore\\web\\templates\\_tools_panel.html","content":"{# Reusable \"Tools for this step\" panel. Fed by the `tools_recommend` Jinja\n   global (registered as an import-time side effect by\n   cuore/web/tools_kb_globals.py -- see that module's docstring) via a\n   page-local `panel = tools_recommend(step=..., vin=...)` set before this\n   include. Guarded so a page still renders -- with the empty state below\n   -- before that global lands, and before mes.tools_kb itself lands.\n\n   Context expected:\n     panel    -- {step, tools: [row...], learned: {...}} shaped per\n                 cuore.services.tools_kb_bridge.recommend_with_learning.\n     compact  -- optional; truthy renders a shorter form for inline use\n                 (maintenance.html per-item), no learned-detail expansion. #}\n{% set panel = panel if panel is defined else {\"step\": \"\", \"tools\": [], \"learned\": {}} %}\n{% set compact = compact if compact is defined else False %}\n\n{% macro tk_conf_chip(c) -%}\n<span class=\"chip {{ 'ok' if c in ('CONFIRMED','CORROBORATED') else ('chronic' if c == 'SINGLE-SOURCE' else 'plain') }}\">{{ c }}</span>\n{%- endmacro %}\n\n<div class=\"panel tight tools-panel\">\n  <h3>Tools for this step{% if panel.tools %} <span class=\"count-badge\">{{ panel.tools|length }}</span>{% endif %}</h3>\n  {% if panel.tools %}\n    <div class=\"tool-rows\">\n    {% for row in panel.tools %}\n      {% set ti = row.tool_info %}\n      {% set have = row.have if row.have is defined else \"unknown\" %}\n      <div class=\"tool-row\">\n        <div class=\"tool-row-main\">\n          <b>{{ ti.name }}</b>\n          <span class=\"small muted tool-kind\">{{ ti.kind }}</span>\n          <span class=\"small {{ 'tool-required' if row.required else 'muted' }}\">{{ \"required\" if row.required else \"optional\" }}</span>\n          <span class=\"chip {{ 'ok' if have == 'owned' else ('returned' if have == 'not_owned' else 'plain') }} have-chip\">have it: {{ {\"owned\": \"yes\", \"not_owned\": \"no\", \"unknown\": \"not recorded\"}[have] }}</span>\n        </div>\n        <p class=\"small mono tool-spec\">{{ ti.spec or \"UNKNOWN -- confirm on the car / service manual (TechAuthority)\" }}\n          {{ tk_conf_chip(ti.confidence) }}\n          {% if ti.source %}<a href=\"{{ ti.source }}\" target=\"_blank\" rel=\"noopener\">source</a>{% endif %}</p>\n        {% if ti.why %}<p class=\"small muted\">{{ ti.why }}</p>{% endif %}\n        {% if row.note %}<p class=\"small tool-note\">{{ row.note }}</p>{% endif %}\n        {% if row.torques %}\n          <p class=\"small\">\n          {% for t in row.torques %}\n            <span class=\"chip plain evidence-chip\">{{ t.component or t.key }}: {{ t.display }}</span>\n            {{ tk_conf_chip(t.confidence) }}\n          {% endfor %}\n          </p>\n        {% endif %}\n        {% if row.alternatives_info %}\n          <p class=\"small muted\">Alternatives: {% for a in row.alternatives_info %}{{ a.name }}{% if not loop.last %}, {% endif %}{% endfor %}</p>\n        {% endif %}\n\n        {% if not compact %}\n        <form method=\"post\" action=\"/tools-kb/inventory-form\" class=\"tool-have-form\">\n          <input type=\"hidden\" name=\"tool\" value=\"{{ ti.key }}\">\n          <input type=\"hidden\" name=\"return_to\" value=\"{{ request.url.path }}\">\n          <button type=\"submit\" name=\"status\" value=\"owned\" class=\"tool-have-btn {{ 'on' if have == 'owned' }}\">I have this</button>\n          <button type=\"submit\" name=\"status\" value=\"not_owned\" class=\"tool-have-btn {{ 'on' if have == 'not_owned' }}\">I don't</button>\n        </form>\n        {% endif %}\n\n        {% if row.decision %}\n          {% set d = row.decision %}\n          <div class=\"tool-decision-card\">\n            <p class=\"small\"><b>Don't have it -- decision needed.</b> {{ d.used_when }}\n              <span class=\"muted\">({{ d.used_when_source }})</span></p>\n            <p class=\"small muted\">How often needed: {{ d.frequency }}\n              {{ tk_conf_chip(d.frequency_confidence) }} <span class=\"muted\">({{ d.frequency_source }})</span></p>\n            <p class=\"small\"><b>Alternatives:</b></p>\n            <ul class=\"small\">\n              {% for a in d.alternatives %}\n                <li>{{ a.option }} &mdash; {{ a.note }}\n                  {% if a.cost %}(<span class=\"mono\">{{ a.cost.range }} {{ a.cost.unit }}</span> {{ tk_conf_chip(a.cost.confidence) }}\n                    <a href=\"{{ a.cost.source }}\" target=\"_blank\" rel=\"noopener\">source</a>){% endif %}</li>\n              {% endfor %}\n            </ul>\n            <p class=\"small\"><b>Cost options (sourced, never guessed):</b></p>\n            <ul class=\"small\">\n              {% for c in d.cost_options %}\n                <li>{{ c.tier }}: <span class=\"mono\">{{ c.range }} {{ c.unit }}</span> {{ tk_conf_chip(c.confidence) }}\n                  &mdash; {{ c.what }} &mdash; <a href=\"{{ c.source.split(' (')[0] }}\" target=\"_blank\" rel=\"noopener\">source</a></li>\n              {% endfor %}\n            </ul>\n            {% if d.practical_difference %}<p class=\"small muted\">{{ d.practical_difference }}</p>{% endif %}\n            <p class=\"small muted\">Record your decision (buy / borrow / rent / skip + why) in the step 7\n              \"Would buy next time\" review.</p>\n          </div>\n        {% endif %}\n      </div>\n    {% endfor %}\n    </div>\n  {% else %}\n    <p class=\"muted small\">No tool recommendations tabulated yet for this step.</p>\n  {% endif %}\n\n  {% set learned = panel.learned or {} %}\n  {% if learned.review_count %}\n    <h4 class=\"small muted\">What mechanics used last time ({{ learned.review_count }} review{{ \"s\" if learned.review_count != 1 }}{% if learned.scope == \"vin\" %}, this car{% else %}, all cars{% endif %})</h4>\n    {% if learned.top_tools %}\n      <p class=\"small\"><b>Most used:</b>\n        {% for t in learned.top_tools[:5] %}{{ t.tool }} ({{ t.used_count }}){% if not loop.last %}, {% endif %}{% endfor %}</p>\n    {% endif %}\n    {% if learned.flagged_wrong %}\n      <p class=\"small\"><span class=\"chip returned\">flagged wrong</span>\n        {% for f in learned.flagged_wrong %}{{ f.tool }} ({{ f.count }}){% if f.notes %} &mdash; {{ f.notes[0] }}{% endif %}{% if not loop.last %}; {% endif %}{% endfor %}</p>\n    {% endif %}\n    {% if learned.buy_suggestions and not compact %}\n      <p class=\"small\"><b>Would buy next time:</b>\n        {% for b in learned.buy_suggestions %}{{ b.name }} ({{ b.count }}){% if b.why %} &mdash; {{ b.why[0] }}{% endif %}{% if not loop.last %}; {% endif %}{% endfor %}</p>\n    {% endif %}\n    {% if learned.missing_tools and not compact %}\n      <p class=\"small muted\">Reported missing: {% for m in learned.missing_tools %}{{ m.text }} ({{ m.count }}){% if not loop.last %}, {% endif %}{% endfor %}</p>\n    {% endif %}\n  {% elif not compact %}\n    <p class=\"muted small\">No usage reviews recorded yet for this step.</p>\n  {% endif %}\n</div>\n","numLines":116,"startLine":1,"totalLines":116}},"sourceToolAssistantUUID":"9fe3d9a7-2c7e-48c7-8500-9a46eec4d0a8","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
{"parentUuid":"64c12e38-7e42-4653-82c4-541f790a4205","isSidechain":true,"agentId":"a31762a22e4ea769a","message":{"model":"claude-sonnet-5","id":"msg_011CfqB8ZV2K2udwMJoZvMq1","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_013C5C9iRqydmcySZddbXxdr","name":"Read","input":{"file_path":"C:\\Users\\User\\mcp-servers\\cuore\\tests\\check_bench.py"},"caller":{"type":"direct"}}],"container":null,"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":7925,"cache_read_input_tokens":57441,"output_tokens":687,"output_tokens_details":{"thinking_tokens":104},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":0,"ephemeral_5m_input_tokens":7925},"inference_geo":"not_available","iterations":[{"input_tokens":2,"output_tokens":687,"cache_read_input_tokens":57441,"cache_creation_input_tokens":7925,"cache_creation":{"ephemeral_5m_input_tokens":7925,"ephemeral_1h_input_tokens":0},"type":"message"}],"speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_013C5C9iRqydmcySZddbXxdr":{"file_path":"C:\\Users\\User\\mcp-servers\\cuore\\tests\\check_bench.py"}},"serverClassifierRequest":"f77d7f4e-237a-4563-96c8-0606b164aed5","apiBlockIndex":8,"requestId":"req_011CfqB8ZDAUVrUJjBkAdk4W","attributionAgent":"general-purpose","type":"assistant","uuid":"ff12b5ea-0a40-461d-801c-c9243d51c04e","timestamp":"2026-10-08T17:36:54.228Z","effort":"high","perTurnEffort":null,"userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
{"parentUuid":"ff12b5ea-0a40-461d-801c-c9243d51c04e","isSidechain":true,"promptId":"14b8b90f-0c4b-47b6-b2bf-3803814525db","agentId":"a31762a22e4ea769a","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_013C5C9iRqydmcySZddbXxdr","type":"tool_result","content":"1\t\"\"\"Smoke checks for the bench page (``GET /v/{vin}``, cuore/services/bench_bridge.py,\n2\tcuore/web/bench_routes.py, cuore/web/templates/bench.html).\n3\t\n4\tSame posture as ``cuore/tests/check_dossier_page.py``: ``CUORE_STATE_DIR``\n5\tpointed at a throwaway directory before cuore is imported, the Stelvio's\n6\treal corpus as the fixture (chronic P0455/P0440/P0456, cleared 2026-09-29,\n7\tnever re-verified -- see project_stelvio_evap.md). No mocks: the five checks\n8\tbelow all run against the real app and the real corpus.\n9\t\n10\tFive checks:\n11\t  1. ``GET /v/{vin}`` responds 200, the status line names the Stelvio (and\n12\t     never \"(unnamed vehicle)\"), and the old dossier still answers at\n13\t     ``/v/{vin}/dossier``.\n14\t  2. The verdict's ``next_action`` sentence mentions the 85% EVAP fuel\n15\t     ceiling and cites a real bulletin for this VIN.\n16\t  3. Exactly up to 3 next-action cards render, and at least one carries a\n17\t     real part number.\n18\t  4. ``/v/{vin}/dossier`` still responds 200 (the route this file's own\n19\t     sibling, check_dossier_page.py, now hits instead of the bare path).\n20\t  5. A 400px CDP screenshot: the first next-action card's bounding box top\n21\t     is inside the viewport (< 800px) and the page has no horizontal\n22\t     overflow at that width.\n23\t\n24\tRun:\n25\t    .venv/Scripts/python.exe cuore/tests/check_bench.py\n26\t\"\"\"\n27\t\n28\tfrom __future__ import annotations\n29\t\n30\timport itertools\n31\timport json\n32\timport os\n33\timport socket\n34\timport subprocess\n35\timport sys\n36\timport tempfile\n37\timport time\n38\timport urllib.request\n39\tfrom pathlib import Path\n40\t\n41\tos.environ[\"CUORE_STATE_DIR\"] = tempfile.mkdtemp(prefix=\"cuore-check-bench-\")\n42\tos.environ.pop(\"CUORE_AUDIT_PATH\", None)\n43\t\n44\tROOT = Path(__file__).resolve().parents[2]\n45\tsys.path.insert(0, str(ROOT))\n46\t\n47\tfrom fastapi.testclient import TestClient  # noqa: E402\n48\t\n49\tfrom cuore.app import create_app  # noqa: E402\n50\tfrom cuore.services import bench_bridge  # noqa: E402\n51\t\n52\tVIN = \"ZASFAKPN5J7B88115\"  # the Stelvio -- real corpus, chronic P0455/P0440/P0456\n53\t\n54\tfailures: list[str] = []\n55\tchecks = 0\n56\t\n57\t\n58\tdef check(label: str, cond: bool, detail: str = \"\") -> None:\n59\t    global checks\n60\t    checks += 1\n61\t    if not cond:\n62\t        failures.append(f\"{label}{(' -- ' + detail) if detail else ''}\")\n63\t\n64\t\n65\tclient = TestClient(create_app())\n66\t\n67\t\n68\t# --- build_bench() directly ------------------------------------------------\n69\t\n70\tbench = bench_bridge.build_bench(VIN)\n71\tcheck(\"vehicle name is never the unnamed placeholder\",\n72\t      bench[\"vehicle\"] != \"(unnamed vehicle)\" and bool(bench[\"vehicle\"]), str(bench[\"vehicle\"]))\n73\tcheck(\"vehicle name names the Stelvio\", \"Stelvio\" in bench[\"vehicle\"], str(bench[\"vehicle\"]))\n74\tcheck(\"vin_tail is the VIN's last 6 characters\", bench[\"vin_tail\"] == VIN[-6:],\n75\t      str(bench[\"vin_tail\"]))\n76\tcheck(\"at most 3 next actions\", len(bench[\"next_actions\"]) <= 3,\n77\t      str(len(bench[\"next_actions\"])))\n78\tcheck(\"at most 6 shortcuts\", len(bench[\"shortcuts\"]) <= 6, str(len(bench[\"shortcuts\"])))\n79\t\n80\t\n81\t# --- 1. the real route: GET /v/{vin} is the bench, GET /v/{vin}/dossier is\n82\t#    still the full dossier -----------------------------------------------\n83\t\n84\tpage = client.get(f\"/v/{VIN}\")\n85\tcheck(\"bench page responds 200\", page.status_code == 200, str(page.status_code))\n86\tcheck(\"bench status line names the Stelvio\", \"Stelvio\" in page.text)\n87\tcheck(\"bench status line never shows the unnamed placeholder\",\n88\t      \"(unnamed vehicle)\" not in page.text)\n89\tcheck(\"bench status line carries the VIN tail\",\n90\t      VIN[-6:] in page.text, VIN[-6:])\n91\t\n92\tdossier_page = client.get(f\"/v/{VIN}/dossier\")\n93\tcheck(\"the old dossier still responds 200 at /v/{vin}/dossier\",\n94\t      dossier_page.status_code == 200, str(dossier_page.status_code))\n95\tcheck(\"the old dossier page still shows its own verdict card\",\n96\t      'class=\"chip-verdict' in dossier_page.text)\n97\tcheck(\"the bench page is not the same page as the dossier\",\n98\t      'id=\"verdict\"' not in page.text)\n99\t\n100\t\n101\t# --- 2. verdict.next_action mentions 85% and a real bulletin --------------\n102\t\n103\tnext_action = bench[\"verdict\"][\"next_action\"] or \"\"\n104\tcheck(\"next_action is a non-empty sentence\", bool(next_action.strip()), next_action)\n105\tcheck(\"next_action mentions the 85% EVAP fuel ceiling\", \"85\" in next_action, next_action)\n106\t\n107\tall_bulletins = {\n108\t    b for card in (bench_bridge.dossier_bridge.build_view(\n109\t        VIN, bench_bridge.mes_bridge.workup(vin=VIN), None)[\"open_work\"])\n110\t    for step in card.get(\"steps\", []) for b in [step.get(\"ref\")] if b\n111\t}\n112\tcheck(\"next_action cites one of this VIN's real bulletins\",\n113\t      any(b in next_action for b in all_bulletins), f\"{next_action!r} vs {all_bulletins}\")\n114\tcheck(\"next_action also appears on the rendered bench page\", next_action in page.text)\n115\t\n116\t\n117\t# --- 3. next-action cards carry at least one real part number -------------\n118\t\n119\tcheck(\"at least one next action is offered\", len(bench[\"next_actions\"]) > 0,\n120\t      str(bench[\"next_actions\"]))\n121\tany_part_number = any(p.get(\"number\") for a in bench[\"next_actions\"] for p in a.get(\"parts\", []))\n122\tcheck(\"at least one next action carries a real part number\", any_part_number,\n123\t      str([a.get(\"parts\") for a in bench[\"next_actions\"]]))\n124\tcheck(\"every rendered next-action card posts to the checklist route\",\n125\t      page.text.count(f'action=\"/v/{VIN}/checklist\"') == len(bench[\"next_actions\"]),\n126\t      str(page.text.count(f'action=\"/v/{VIN}/checklist\"')))\n127\t\n128\tfor a in bench[\"next_actions\"]:\n129\t    check(f\"step {a['step_id']} text is on the page\", a[\"text\"] in page.text)\n130\t    for p in a.get(\"parts\", []):\n131\t        if p.get(\"number\"):\n132\t            check(f\"part number {p['number']} is on the page\", p[\"number\"] in page.text)\n133\t\n134\t\n135\t# --- ticking a real checklist step from the bench's own form works -------\n136\t\n137\tif bench[\"next_actions\"]:\n138\t    step_id = bench[\"next_actions\"][0][\"step_id\"]\n139\t    toggled = client.post(f\"/v/{VIN}/checklist\", data={\"step_id\": step_id, \"done\": \"1\"},\n140\t                          follow_redirects=False)\n141\t    check(\"ticking a step from the bench's own form is accepted\",\n142\t          toggled.status_code == 303, str(toggled.status_code))\n143\t    # leave it as we found it\n144\t    client.post(f\"/v/{VIN}/checklist\", data={\"step_id\": step_id, \"done\": \"0\"})\n145\t\n146\t\n147\t# --- 5. 400px CDP screenshot: first card's top < 800px, no overflow -------\n148\t\n149\tprint(\"=== 400px screenshot (cleanup via _edge_cleanup.kill_edge_profile) ===\")\n150\tEDGE_CANDIDATES = [\n151\t    r\"C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe\",\n152\t    r\"C:\\Program Files\\Microsoft\\Edge\\Application\\msedge.exe\",\n153\t]\n154\t\n155\t\n156\tdef find_edge() -> str:\n157\t    for candidate in EDGE_CANDIDATES:\n158\t        if Path(candidate).exists():\n159\t            return candidate\n160\t    return \"\"\n161\t\n162\t\n163\tdef free_port() -> int:\n164\t    s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)\n165\t    s.bind((\"127.0.0.1\", 0))\n166\t    port = s.getsockname()[1]\n167\t    s.close()\n168\t    return port\n169\t\n170\t\n171\tclass CDP:\n172\t    def __init__(self, ws_url: str) -> None:\n173\t        from websockets.sync.client import connect\n174\t        self.ws = connect(ws_url, max_size=None, open_timeout=20)\n175\t        self._ids = itertools.count(1)\n176\t\n177\t    def send(self, method: str, params: dict | None = None, timeout: float = 20):\n178\t        msg_id = next(self._ids)\n179\t        self.ws.send(json.dumps({\"id\": msg_id, \"method\": method, \"params\": params or {}}))\n180\t        deadline = time.time() + timeout\n181\t        while time.time() < deadline:\n182\t            raw = self.ws.recv(timeout=max(0.1, deadline - time.time()))\n183\t            msg = json.loads(raw)\n184\t            if msg.get(\"id\") == msg_id:\n185\t                if \"error\" in msg:\n186\t                    raise RuntimeError(f\"CDP {method} failed: {msg['error']}\")\n187\t                return msg.get(\"result\", {})\n188\t        raise TimeoutError(f\"CDP {method} timed out waiting for response\")\n189\t\n190\t    def close(self) -> None:\n191\t        try:\n192\t            self.ws.close()\n193\t        except Exception:\n194\t            pass\n195\t\n196\t\n197\tdef wait_for_devtools(port: int, timeout: float = 20) -> None:\n198\t    deadline = time.time() + timeout\n199\t    last_err: Exception | None = None\n200\t    while time.time() < deadline:\n201\t        try:\n202\t            with urllib.request.urlopen(f\"http://127.0.0.1:{port}/json/version\", timeout=2) as r:\n203\t                json.loads(r.read().decode(\"utf-8\"))\n204\t                return\n205\t        except Exception as exc:  # noqa: BLE001\n206\t            last_err = exc\n207\t            time.sleep(0.2)\n208\t    raise RuntimeError(f\"headless Edge devtools endpoint never came up: {last_err}\")\n209\t\n210\t\n211\tdef open_target(port: int, url: str) -> dict:\n212\t    req = urllib.request.Request(f\"http://127.0.0.1:{port}/json/new?{url}\", method=\"PUT\")\n213\t    with urllib.request.urlopen(req, timeout=10) as r:\n214\t        return json.loads(r.read().decode(\"utf-8\"))\n215\t\n216\t\n217\tdef wait_for_port(port: int, timeout: float = 15.0) -> bool:\n218\t    deadline = time.monotonic() + timeout\n219\t    while time.monotonic() < deadline:\n220\t        try:\n221\t            with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:\n222\t                s.settimeout(0.3)\n223\t                s.connect((\"127.0.0.1\", port))\n224\t                return True\n225\t        except OSError:\n226\t            time.sleep(0.2)\n227\t    return False\n228\t\n229\t\n230\tedge = find_edge()\n231\tserver_dir = tempfile.mkdtemp(prefix=\"cuore-check-bench-server-\")\n232\tport = free_port()\n233\tenv = dict(os.environ)\n234\tenv[\"CUORE_STATE_DIR\"] = server_dir\n235\t\n236\t_SERVER_SNIPPET = f\"\"\"\n237\timport sys\n238\tsys.path.insert(0, {str(ROOT)!r})\n239\tfrom cuore.app import create_app\n240\timport uvicorn\n241\t\n242\tapp = create_app()\n243\tuvicorn.run(app, host=\"127.0.0.1\", port={port}, log_level=\"warning\")\n244\t\"\"\"\n245\t\n246\tif not edge:\n247\t    check(\"headless Edge is available for the screenshot check\", False, str(EDGE_CANDIDATES))\n248\telse:\n249\t    server_proc = subprocess.Popen(\n250\t        [sys.executable, \"-c\", _SERVER_SNIPPET],\n251\t        cwd=str(ROOT), env=env,\n252\t        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,\n253\t    )\n254\t    try:\n255\t        up = wait_for_port(port)\n256\t        check(\"uvicorn came up on the free port\", up, f\"port {port}\")\n257\t        if up:\n258\t            # Warm the bench's own caches (mes_bridge.workup + dossier_bridge's\n259\t            # memoised core) in this freshly spawned, cold process BEFORE\n260\t            # Edge ever navigates -- building the Stelvio's 17-log workup and\n261\t            # resolving parts/tools for 3 next actions easily outruns the\n262\t            # 1.7s this check waits before reading document.readyState below,\n263\t            # which otherwise reads the pre-navigation about:blank document\n264\t            # (readyState \"complete\" trivially, body empty) rather than the\n265\t            # real page. check_screens.py hits the same thing and warms the\n266\t            # same way (its own seed POST, then a sleep) before measuring.\n267\t            try:\n268\t                urllib.request.urlopen(f\"http://127.0.0.1:{port}/v/{VIN}\", timeout=25)\n269\t            except Exception as exc:  # noqa: BLE001\n270\t                check(\"warming the bench page on the screenshot server\", False, str(exc))\n271\t            time.sleep(0.5)\n272\t            devtools_port = free_port()\n273\t            profile_dir = Path(tempfile.mkdtemp(prefix=\"cuore-edge-bench-\"))\n274\t            edge_proc = subprocess.Popen(\n275\t                [edge, \"--headless=new\", f\"--remote-debugging-port={devtools_port}\",\n276\t                 f\"--user-data-dir={profile_dir}\", \"--no-first-run\", \"--window-size=400,800\",\n277\t                 \"about:blank\"],\n278\t                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,\n279\t            )\n280\t            try:\n281\t                wait_for_devtools(devtools_port)\n282\t                url = f\"http://127.0.0.1:{port}/v/{VIN}\"\n283\t                target = open_target(devtools_port, url)\n284\t                cdp = CDP(target[\"webSocketDebuggerUrl\"])\n285\t                try:\n286\t                    cdp.send(\"Page.enable\")\n287\t                    cdp.send(\"Runtime.enable\")\n288\t                    time.sleep(1.2)\n289\t                    cdp.send(\"Emulation.setDeviceMetricsOverride\", {\n290\t                        \"width\": 400, \"height\": 800, \"deviceScaleFactor\": 1, \"mobile\": True,\n291\t                    })\n292\t                    time.sleep(0.5)\n293\t\n294\t                    nav = cdp.send(\"Runtime.evaluate\", {\n295\t                        \"expression\": \"document.readyState\", \"returnByValue\": True})\n296\t                    check(\"bench page loaded in the headless browser\",\n297\t                          nav.get(\"result\", {}).get(\"value\") in (\"complete\", \"interactive\"),\n298\t                          str(nav))\n299\t\n300\t                    overflow = cdp.send(\"Runtime.evaluate\", {\n301\t                        \"expression\": (\n302\t                            \"JSON.stringify({sw: document.documentElement.scrollWidth, \"\n303\t                            \"cw: document.documentElement.clientWidth})\"),\n304\t                        \"returnByValue\": True,\n305\t                    })\n306\t                    dims = json.loads(overflow.get(\"result\", {}).get(\"value\", \"{}\"))\n307\t                    sw, cw = dims.get(\"sw\", 0), dims.get(\"cw\", 0)\n308\t                    check(\"no page-level horizontal overflow at 400px\",\n309\t                         sw <= cw + 1, f\"scrollWidth={sw} clientWidth={cw}\")\n310\t\n311\t                    rect = cdp.send(\"Runtime.evaluate\", {\n312\t                        \"expression\": (\n313\t                            \"(() => { const el = document.querySelector('.bench-card'); \"\n314\t                            \"if (!el) return JSON.stringify(null); \"\n315\t                            \"const r = el.getBoundingClientRect(); \"\n316\t                            \"return JSON.stringify({top: r.top, left: r.left, right: r.right}); \"\n317\t                            \"})()\"),\n318\t                        \"returnByValue\": True,\n319\t                    })\n320\t                    card_rect = json.loads(rect.get(\"result\", {}).get(\"value\", \"null\"))\n321\t                    check(\"the first next-action card is present on the page\",\n322\t                          card_rect is not None, str(card_rect))\n323\t                    if card_rect is not None:\n324\t                        check(\"the first next-action card's top is within the 800px viewport\",\n325\t                             card_rect[\"top\"] < 800, str(card_rect))\n326\t                        check(\"the first next-action card does not overflow horizontally\",\n327\t                             card_rect[\"right\"] <= 400 + 1, str(card_rect))\n328\t\n329\t                    shot = cdp.send(\"Page.captureScreenshot\", {\"format\": \"png\"})\n330\t                    data_b64 = shot.get(\"data\", \"\")\n331\t                    check(\"a 400px screenshot of the bench was captured\",\n332\t                         bool(data_b64), f\"{len(data_b64)} bytes of base64\")\n333\t                finally:\n334\t                    cdp.close()\n335\t            except Exception as exc:  # noqa: BLE001\n336\t                check(\"headless Edge measured the bench page over CDP\", False,\n337\t                     f\"{type(exc).__name__}: {exc}\")\n338\t            finally:\n339\t                edge_proc.terminate()\n340\t                try:\n341\t                    edge_proc.wait(timeout=5)\n342\t                except Exception:\n343\t                    edge_proc.kill()\n344\t                from _edge_cleanup import kill_edge_profile\n345\t                kill_edge_profile(profile_dir)\n346\t    finally:\n347\t        server_proc.terminate()\n348\t        try:\n349\t            server_proc.wait(timeout=5)\n350\t        except Exception:\n351\t            server_proc.kill()\n352\t\n353\t\n354\t# --- report ------------------------------------------------------------------\n355\t\n356\tprint()\n357\tif failures:\n358\t    print(f\"{len(failures)}/{checks} check(s) failed:\")\n359\t    for f in failures:\n360\t        print(f\"  - {f}\")\n361\t    sys.exit(1)\n362\tprint(f\"all {checks} checks passed\")\n363\t"}]},"uuid":"ab2400cb-d01d-4303-b9aa-e17fc35ad747","timestamp":"2026-10-08T17:36:54.263Z","toolUseResult":{"type":"text","file":{"filePath":"C:\\Users\\User\\mcp-servers\\cuore\\tests\\check_bench.py","content":"\"\"\"Smoke checks for the bench page (``GET /v/{vin}``, cuore/services/bench_bridge.py,\ncuore/web/bench_routes.py, cuore/web/templates/bench.html).\n\nSame posture as ``cuore/tests/check_dossier_page.py``: ``CUORE_STATE_DIR``\npointed at a throwaway directory before cuore is imported, the Stelvio's\nreal corpus as the fixture (chronic P0455/P0440/P0456, cleared 2026-09-29,\nnever re-verified -- see project_stelvio_evap.md). No mocks: the five checks\nbelow all run against the real app and the real corpus.\n\nFive checks:\n  1. ``GET /v/{vin}`` responds 200, the status line names the Stelvio (and\n     never \"(unnamed vehicle)\"), and the old dossier still answers at\n     ``/v/{vin}/dossier``.\n  2. The verdict's ``next_action`` sentence mentions the 85% EVAP fuel\n     ceiling and cites a real bulletin for this VIN.\n  3. Exactly up to 3 next-action cards render, and at least one carries a\n     real part number.\n  4. ``/v/{vin}/dossier`` still responds 200 (the route this file's own\n     sibling, check_dossier_page.py, now hits instead of the bare path).\n  5. A 400px CDP screenshot: the first next-action card's bounding box top\n     is inside the viewport (< 800px) and the page has no horizontal\n     overflow at that width.\n\nRun:\n    .venv/Scripts/python.exe cuore/tests/check_bench.py\n\"\"\"\n\nfrom __future__ import annotations\n\nimport itertools\nimport json\nimport os\nimport socket\nimport subprocess\nimport sys\nimport tempfile\nimport time\nimport urllib.request\nfrom pathlib import Path\n\nos.environ[\"CUORE_STATE_DIR\"] = tempfile.mkdtemp(prefix=\"cuore-check-bench-\")\nos.environ.pop(\"CUORE_AUDIT_PATH\", None)\n\nROOT = Path(__file__).resolve().parents[2]\nsys.path.insert(0, str(ROOT))\n\nfrom fastapi.testclient import TestClient  # noqa: E402\n\nfrom cuore.app import create_app  # noqa: E402\nfrom cuore.services import bench_bridge  # noqa: E402\n\nVIN = \"ZASFAKPN5J7B88115\"  # the Stelvio -- real corpus, chronic P0455/P0440/P0456\n\nfailures: list[str] = []\nchecks = 0\n\n\ndef check(label: str, cond: bool, detail: str = \"\") -> None:\n    global checks\n    checks += 1\n    if not cond:\n        failures.append(f\"{label}{(' -- ' + detail) if detail else ''}\")\n\n\nclient = TestClient(create_app())\n\n\n# --- build_bench() directly ------------------------------------------------\n\nbench = bench_bridge.build_bench(VIN)\ncheck(\"vehicle name is never the unnamed placeholder\",\n      bench[\"vehicle\"] != \"(unnamed vehicle)\" and bool(bench[\"vehicle\"]), str(bench[\"vehicle\"]))\ncheck(\"vehicle name names the Stelvio\", \"Stelvio\" in bench[\"vehicle\"], str(bench[\"vehicle\"]))\ncheck(\"vin_tail is the VIN's last 6 characters\", bench[\"vin_tail\"] == VIN[-6:],\n      str(bench[\"vin_tail\"]))\ncheck(\"at most 3 next actions\", len(bench[\"next_actions\"]) <= 3,\n      str(len(bench[\"next_actions\"])))\ncheck(\"at most 6 shortcuts\", len(bench[\"shortcuts\"]) <= 6, str(len(bench[\"shortcuts\"])))\n\n\n# --- 1. the real route: GET /v/{vin} is the bench, GET /v/{vin}/dossier is\n#    still the full dossier -----------------------------------------------\n\npage = client.get(f\"/v/{VIN}\")\ncheck(\"bench page responds 200\", page.status_code == 200, str(page.status_code))\ncheck(\"bench status line names the Stelvio\", \"Stelvio\" in page.text)\ncheck(\"bench status line never shows the unnamed placeholder\",\n      \"(unnamed vehicle)\" not in page.text)\ncheck(\"bench status line carries the VIN tail\",\n      VIN[-6:] in page.text, VIN[-6:])\n\ndossier_page = client.get(f\"/v/{VIN}/dossier\")\ncheck(\"the old dossier still responds 200 at /v/{vin}/dossier\",\n      dossier_page.status_code == 200, str(dossier_page.status_code))\ncheck(\"the old dossier page still shows its own verdict card\",\n      'class=\"chip-verdict' in dossier_page.text)\ncheck(\"the bench page is not the same page as the dossier\",\n      'id=\"verdict\"' not in page.text)\n\n\n# --- 2. verdict.next_action mentions 85% and a real bulletin --------------\n\nnext_action = bench[\"verdict\"][\"next_action\"] or \"\"\ncheck(\"next_action is a non-empty sentence\", bool(next_action.strip()), next_action)\ncheck(\"next_action mentions the 85% EVAP fuel ceiling\", \"85\" in next_action, next_action)\n\nall_bulletins = {\n    b for card in (bench_bridge.dossier_bridge.build_view(\n        VIN, bench_bridge.mes_bridge.workup(vin=VIN), None)[\"open_work\"])\n    for step in card.get(\"steps\", []) for b in [step.get(\"ref\")] if b\n}\ncheck(\"next_action cites one of this VIN's real bulletins\",\n      any(b in next_action for b in all_bulletins), f\"{next_action!r} vs {all_bulletins}\")\ncheck(\"next_action also appears on the rendered bench page\", next_action in page.text)\n\n\n# --- 3. next-action cards carry at least one real part number -------------\n\ncheck(\"at least one next action is offered\", len(bench[\"next_actions\"]) > 0,\n      str(bench[\"next_actions\"]))\nany_part_number = any(p.get(\"number\") for a in bench[\"next_actions\"] for p in a.get(\"parts\", []))\ncheck(\"at least one next action carries a real part number\", any_part_number,\n      str([a.get(\"parts\") for a in bench[\"next_actions\"]]))\ncheck(\"every rendered next-action card posts to the checklist route\",\n      page.text.count(f'action=\"/v/{VIN}/checklist\"') == len(bench[\"next_actions\"]),\n      str(page.text.count(f'action=\"/v/{VIN}/checklist\"')))\n\nfor a in bench[\"next_actions\"]:\n    check(f\"step {a['step_id']} text is on the page\", a[\"text\"] in page.text)\n    for p in a.get(\"parts\", []):\n        if p.get(\"number\"):\n            check(f\"part number {p['number']} is on the page\", p[\"number\"] in page.text)\n\n\n# --- ticking a real checklist step from the bench's own form works -------\n\nif bench[\"next_actions\"]:\n    step_id = bench[\"next_actions\"][0][\"step_id\"]\n    toggled = client.post(f\"/v/{VIN}/checklist\", data={\"step_id\": step_id, \"done\": \"1\"},\n                          follow_redirects=False)\n    check(\"ticking a step from the bench's own form is accepted\",\n          toggled.status_code == 303, str(toggled.status_code))\n    # leave it as we found it\n    client.post(f\"/v/{VIN}/checklist\", data={\"step_id\": step_id, \"done\": \"0\"})\n\n\n# --- 5. 400px CDP screenshot: first card's top < 800px, no overflow -------\n\nprint(\"=== 400px screenshot (cleanup via _edge_cleanup.kill_edge_profile) ===\")\nEDGE_CANDIDATES = [\n    r\"C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe\",\n    r\"C:\\Program Files\\Microsoft\\Edge\\Application\\msedge.exe\",\n]\n\n\ndef find_edge() -> str:\n    for candidate in EDGE_CANDIDATES:\n        if Path(candidate).exists():\n            return candidate\n    return \"\"\n\n\ndef free_port() -> int:\n    s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)\n    s.bind((\"127.0.0.1\", 0))\n    port = s.getsockname()[1]\n    s.close()\n    return port\n\n\nclass CDP:\n    def __init__(self, ws_url: str) -> None:\n        from websockets.sync.client import connect\n        self.ws = connect(ws_url, max_size=None, open_timeout=20)\n        self._ids = itertools.count(1)\n\n    def send(self, method: str, params: dict | None = None, timeout: float = 20):\n        msg_id = next(self._ids)\n        self.ws.send(json.dumps({\"id\": msg_id, \"method\": method, \"params\": params or {}}))\n        deadline = time.time() + timeout\n        while time.time() < deadline:\n            raw = self.ws.recv(timeout=max(0.1, deadline - time.time()))\n            msg = json.loads(raw)\n            if msg.get(\"id\") == msg_id:\n                if \"error\" in msg:\n                    raise RuntimeError(f\"CDP {method} failed: {msg['error']}\")\n                return msg.get(\"result\", {})\n        raise TimeoutError(f\"CDP {method} timed out waiting for response\")\n\n    def close(self) -> None:\n        try:\n            self.ws.close()\n        except Exception:\n            pass\n\n\ndef wait_for_devtools(port: int, timeout: float = 20) -> None:\n    deadline = time.time() + timeout\n    last_err: Exception | None = None\n    while time.time() < deadline:\n        try:\n            with urllib.request.urlopen(f\"http://127.0.0.1:{port}/json/version\", timeout=2) as r:\n                json.loads(r.read().decode(\"utf-8\"))\n                return\n        except Exception as exc:  # noqa: BLE001\n            last_err = exc\n            time.sleep(0.2)\n    raise RuntimeError(f\"headless Edge devtools endpoint never came up: {last_err}\")\n\n\ndef open_target(port: int, url: str) -> dict:\n    req = urllib.request.Request(f\"http://127.0.0.1:{port}/json/new?{url}\", method=\"PUT\")\n    with urllib.request.urlopen(req, timeout=10) as r:\n        return json.loads(r.read().decode(\"utf-8\"))\n\n\ndef wait_for_port(port: int, timeout: float = 15.0) -> bool:\n    deadline = time.monotonic() + timeout\n    while time.monotonic() < deadline:\n        try:\n            with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:\n                s.settimeout(0.3)\n                s.connect((\"127.0.0.1\", port))\n                return True\n        except OSError:\n            time.sleep(0.2)\n    return False\n\n\nedge = find_edge()\nserver_dir = tempfile.mkdtemp(prefix=\"cuore-check-bench-server-\")\nport = free_port()\nenv = dict(os.environ)\nenv[\"CUORE_STATE_DIR\"] = server_dir\n\n_SERVER_SNIPPET = f\"\"\"\nimport sys\nsys.path.insert(0, {str(ROOT)!r})\nfrom cuore.app import create_app\nimport uvicorn\n\napp = create_app()\nuvicorn.run(app, host=\"127.0.0.1\", port={port}, log_level=\"warning\")\n\"\"\"\n\nif not edge:\n    check(\"headless Edge is available for the screenshot check\", False, str(EDGE_CANDIDATES))\nelse:\n    server_proc = subprocess.Popen(\n        [sys.executable, \"-c\", _SERVER_SNIPPET],\n        cwd=str(ROOT), env=env,\n        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,\n    )\n    try:\n        up = wait_for_port(port)\n        check(\"uvicorn came up on the free port\", up, f\"port {port}\")\n        if up:\n            # Warm the bench's own caches (mes_bridge.workup + dossier_bridge's\n            # memoised core) in this freshly spawned, cold process BEFORE\n            # Edge ever navigates -- building the Stelvio's 17-log workup and\n            # resolving parts/tools for 3 next actions easily outruns the\n            # 1.7s this check waits before reading document.readyState below,\n            # which otherwise reads the pre-navigation about:blank document\n            # (readyState \"complete\" trivially, body empty) rather than the\n            # real page. check_screens.py hits the same thing and warms the\n            # same way (its own seed POST, then a sleep) before measuring.\n            try:\n                urllib.request.urlopen(f\"http://127.0.0.1:{port}/v/{VIN}\", timeout=25)\n            except Exception as exc:  # noqa: BLE001\n                check(\"warming the bench page on the screenshot server\", False, str(exc))\n            time.sleep(0.5)\n            devtools_port = free_port()\n            profile_dir = Path(tempfile.mkdtemp(prefix=\"cuore-edge-bench-\"))\n            edge_proc = subprocess.Popen(\n                [edge, \"--headless=new\", f\"--remote-debugging-port={devtools_port}\",\n                 f\"--user-data-dir={profile_dir}\", \"--no-first-run\", \"--window-size=400,800\",\n                 \"about:blank\"],\n                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,\n            )\n            try:\n                wait_for_devtools(devtools_port)\n                url = f\"http://127.0.0.1:{port}/v/{VIN}\"\n                target = open_target(devtools_port, url)\n                cdp = CDP(target[\"webSocketDebuggerUrl\"])\n                try:\n                    cdp.send(\"Page.enable\")\n                    cdp.send(\"Runtime.enable\")\n                    time.sleep(1.2)\n                    cdp.send(\"Emulation.setDeviceMetricsOverride\", {\n                        \"width\": 400, \"height\": 800, \"deviceScaleFactor\": 1, \"mobile\": True,\n                    })\n                    time.sleep(0.5)\n\n                    nav = cdp.send(\"Runtime.evaluate\", {\n                        \"expression\": \"document.readyState\", \"returnByValue\": True})\n                    check(\"bench page loaded in the headless browser\",\n                          nav.get(\"result\", {}).get(\"value\") in (\"complete\", \"interactive\"),\n                          str(nav))\n\n                    overflow = cdp.send(\"Runtime.evaluate\", {\n                        \"expression\": (\n                            \"JSON.stringify({sw: document.documentElement.scrollWidth, \"\n                            \"cw: document.documentElement.clientWidth})\"),\n                        \"returnByValue\": True,\n                    })\n                    dims = json.loads(overflow.get(\"result\", {}).get(\"value\", \"{}\"))\n                    sw, cw = dims.get(\"sw\", 0), dims.get(\"cw\", 0)\n                    check(\"no page-level horizontal overflow at 400px\",\n                         sw <= cw + 1, f\"scrollWidth={sw} clientWidth={cw}\")\n\n                    rect = cdp.send(\"Runtime.evaluate\", {\n                        \"expression\": (\n                            \"(() => { const el = document.querySelector('.bench-card'); \"\n                            \"if (!el) return JSON.stringify(null); \"\n                            \"const r = el.getBoundingClientRect(); \"\n                            \"return JSON.stringify({top: r.top, left: r.left, right: r.right}); \"\n                            \"})()\"),\n                        \"returnByValue\": True,\n                    })\n                    card_rect = json.loads(rect.get(\"result\", {}).get(\"value\", \"null\"))\n                    check(\"the first next-action card is present on the page\",\n                          card_rect is not None, str(card_rect))\n                    if card_rect is not None:\n                        check(\"the first next-action card's top is within the 800px viewport\",\n                             card_rect[\"top\"] < 800, str(card_rect))\n                        check(\"the first next-action card does not overflow horizontally\",\n                             card_rect[\"right\"] <= 400 + 1, str(card_rect))\n\n                    shot = cdp.send(\"Page.captureScreenshot\", {\"format\": \"png\"})\n                    data_b64 = shot.get(\"data\", \"\")\n                    check(\"a 400px screenshot of the bench was captured\",\n                         bool(data_b64), f\"{len(data_b64)} bytes of base64\")\n                finally:\n                    cdp.close()\n            except Exception as exc:  # noqa: BLE001\n                check(\"headless Edge measured the bench page over CDP\", False,\n                     f\"{type(exc).__name__}: {exc}\")\n            finally:\n                edge_proc.terminate()\n                try:\n                    edge_proc.wait(timeout=5)\n                except Exception:\n                    edge_proc.kill()\n                from _edge_cleanup import kill_edge_profile\n                kill_edge_profile(profile_dir)\n    finally:\n        server_proc.terminate()\n        try:\n            server_proc.wait(timeout=5)\n        except Exception:\n            server_proc.kill()\n\n\n# --- report ------------------------------------------------------------------\n\nprint()\nif failures:\n    print(f\"{len(failures)}/{checks} check(s) failed:\")\n    for f in failures:\n        print(f\"  - {f}\")\n    sys.exit(1)\nprint(f\"all {checks} checks passed\")\n","numLines":363,"startLine":1,"totalLines":363}},"sourceToolAssistantUUID":"ff12b5ea-0a40-461d-801c-c9243d51c04e","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
