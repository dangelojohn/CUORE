{"parentUuid":"c8c4ef67-a765-4de9-a7e7-bdc3d393c36f","isSidechain":true,"agentId":"a31762a22e4ea769a","message":{"model":"claude-sonnet-5","id":"msg_011CfqB9939Mzsv7GBy6pBP7","type":"message","role":"assistant","content":[{"type":"thinking","thinking":"","signature":""}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":39543,"cache_read_input_tokens":65366,"cache_creation":{"ephemeral_5m_input_tokens":39543,"ephemeral_1h_input_tokens":0},"output_tokens":3,"service_tier":"standard","inference_geo":"not_available"},"input_transformations":[],"diagnostics":null,"context_management":null},"serverClassifierRequest":"6d79a8bb-c819-4fb8-9b70-a7cc5d262e7f","apiBlockIndex":0,"requestId":"req_011CfqB98o1X443p25DsCYbB","attributionAgent":"general-purpose","type":"assistant","uuid":"fae3f95b-2622-4ff2-98ae-568d5d6ffbaa","timestamp":"2026-10-08T17:37:03.732Z","effort":"high","perTurnEffort":null,"userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
{"parentUuid":"fae3f95b-2622-4ff2-98ae-568d5d6ffbaa","isSidechain":true,"agentId":"a31762a22e4ea769a","message":{"model":"claude-sonnet-5","id":"msg_011CfqB9939Mzsv7GBy6pBP7","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01Y4K558Yr4RvxPAE51p2xRw","name":"Read","input":{"file_path":"C:\\Users\\User\\mcp-servers\\cuore\\services\\mes_bridge.py"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":39543,"cache_read_input_tokens":65366,"cache_creation":{"ephemeral_5m_input_tokens":39543,"ephemeral_1h_input_tokens":0},"output_tokens":3,"service_tier":"standard","inference_geo":"not_available"},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_01Y4K558Yr4RvxPAE51p2xRw":{"file_path":"C:\\Users\\User\\mcp-servers\\cuore\\services\\mes_bridge.py"}},"serverClassifierRequest":"6d79a8bb-c819-4fb8-9b70-a7cc5d262e7f","apiBlockIndex":1,"requestId":"req_011CfqB98o1X443p25DsCYbB","attributionAgent":"general-purpose","type":"assistant","uuid":"0433a030-0e22-49bd-8769-bc43bcb90dbb","timestamp":"2026-10-08T17:37:04.536Z","effort":"high","perTurnEffort":null,"userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
{"parentUuid":"0433a030-0e22-49bd-8769-bc43bcb90dbb","isSidechain":true,"promptId":"14b8b90f-0c4b-47b6-b2bf-3803814525db","agentId":"a31762a22e4ea769a","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Y4K558Yr4RvxPAE51p2xRw","type":"tool_result","content":"1\t\"\"\"The only module in CUORE that imports :mod:`mes`.\n2\t\n3\tEvery route reaches the analysis library through here. That is deliberate:\n4\t``mes-log-mcp/server.py`` already exposes this library as MCP tools, and the\n5\ttwo surfaces must not drift. Each function below mirrors its MCP counterpart\n6\tcall-for-call, so a change in the library shows up identically in both.\n7\t\n8\tNothing here re-implements analysis. Chronic classification, TSB matching,\n9\tfault-tree content and the evidence gate's criteria live in ``mes`` and are\n10\tunit-tested there against the real corpus; this file only calls them and\n11\ttranslates \"no result\" into an exception the HTTP layer can turn into a\n12\tstatus code.\n13\t\"\"\"\n14\t\n15\tfrom __future__ import annotations\n16\t\n17\timport re\n18\tfrom typing import Any, Optional\n19\t\n20\tfrom .. import bootstrap  # noqa: F401  -- side effect: puts `mes` on sys.path\n21\tfrom .errors import BadRequest, NotFound\n22\t\n23\tfrom mes import (  # noqa: E402  -- must follow the bootstrap import\n24\t    analysis,\n25\t    catalog,\n26\t    compare,\n27\t    csvlog,\n28\t    dealer as dealer_mod,\n29\t    dtc as dtc_mod,\n30\t    dtc_text,\n31\t    encoding,\n32\t    faulttree,\n33\t    fes,\n34\t    knowledge,\n35\t    modules,\n36\t    notes as notes_mod,\n37\t    paths,\n38\t    scan,\n39\t    verdict,\n40\t)\n41\tfrom mes import workup as workup_mod  # noqa: E402\n42\tfrom mes.errors import MesError  # noqa: E402\n43\t\n44\tCATALOG = catalog.CATALOG\n45\t\n46\t\n47\t# --- corpus ---------------------------------------------------------------\n48\t\n49\t\n50\tdef corpus_status() -> dict[str, Any]:\n51\t    \"\"\"Health and inventory: roots, real vs simulated counts, parse errors.\"\"\"\n52\t    return CATALOG.stats()\n53\t\n54\t\n55\tdef log_roots() -> dict[str, Any]:\n56\t    \"\"\"The MES log directories being watched, and whether they exist.\"\"\"\n57\t    return {\n58\t        \"configured\": [str(r) for r in paths.configured_roots()],\n59\t        \"existing\": [str(r) for r in paths.existing_roots()],\n60\t        \"csv_configured\": [str(r) for r in paths.csv_roots()],\n61\t        \"csv_existing\": [str(r) for r in paths.existing_csv_roots()],\n62\t        \"env_overrides\": [\"MES_LOG_DIRS\", \"MES_LOG_DIR\",\n63\t                          \"MES_CSV_DIRS\", \"MES_CSV_DIR\"],\n64\t    }\n65\t\n66\t\n67\tdef vehicles(*, real_only: bool = False) -> list[dict[str, Any]]:\n68\t    \"\"\"Every distinct vehicle in the corpus, keyed by VIN where recoverable.\n69\t\n70\t    ``real_only`` keeps the two cars that actually exist -- a resolvable VIN\n71\t    and at least one non-simulated log -- and drops the simulation pseudo\n72\t    vehicles, whose \"VIN\" is MES's practice-data placeholder.\n73\t    \"\"\"\n74\t    found = CATALOG.vehicles()\n75\t    if not real_only:\n76\t        return found\n77\t    return [v for v in found\n78\t            if v.get(\"real_logs\", 0) > 0 and len(v.get(\"vin\", \"\")) >= 11]\n79\t\n80\t\n81\tdef newest_mtime(vin: str = \"\") -> float:\n82\t    \"\"\"Newest file mtime across a vehicle's logs -- the cache key for workup.\"\"\"\n83\t    entries = CATALOG.select(vin=vin) if vin else CATALOG.entries()\n84\t    return max((e.mtime for e in entries), default=0.0)\n85\t\n86\t\n87\t# --- logs -----------------------------------------------------------------\n88\t\n89\t\n90\tdef list_logs(*, kind: str = \"\", vehicle: str = \"\", vin: str = \"\",\n91\t              since: str = \"\", until: str = \"\", limit: int = 30,\n92\t              include_simulation: bool = False) -> dict[str, Any]:\n93\t    \"\"\"Filtered log index, newest first by session timestamp.\"\"\"\n94\t    entries = CATALOG.select(kind=kind, vehicle=vehicle, vin=vin, since=since,\n95\t                             until=until, limit=limit,\n96\t                             include_simulation=include_simulation)\n97\t    return {\n98\t        \"count\": len(entries),\n99\t        \"filters\": {\"kind\": kind, \"vehicle\": vehicle, \"vin\": vin,\n100\t                    \"since\": since, \"until\": until,\n101\t                    \"include_simulation\": include_simulation},\n102\t        \"logs\": [e.to_dict() for e in entries],\n103\t    }\n104\t\n105\t\n106\tdef read_log(name: str, *, max_bytes: int = 200_000) -> dict[str, Any]:\n107\t    \"\"\"Read one MES log verbatim.\n108\t\n109\t    Resolution goes through :func:`mes.paths.resolve_log`, which requires a\n110\t    bare filename matching a MES log pattern and verifies the fully resolved\n111\t    real path is inside a configured root. That check is the whole security\n112\t    boundary of this endpoint: an earlier version of the MCP server built the\n113\t    path by concatenation, which on Windows let both ``..`` and an absolute\n114\t    path escape it. Do not replace this with ``Path(root) / name``.\n115\t    \"\"\"\n116\t    try:\n117\t        path = paths.resolve_log(name)\n118\t    except MesError as exc:\n119\t        raise BadRequest(str(exc)) from exc\n120\t\n121\t    decoded = encoding.read_log_text(path, max_bytes=max_bytes)\n122\t    kind, raw_stamp, vehicle = paths.classify_name(path.name)\n123\t    stamp = catalog.parse_stamp(raw_stamp)\n124\t    out: dict[str, Any] = {\n125\t        \"file\": path.name,\n126\t        \"kind\": kind,\n127\t        \"timestamp\": stamp.isoformat(sep=\" \") if stamp else raw_stamp,\n128\t        \"vehicle\": vehicle,\n129\t        \"encoding\": decoded.encoding,\n130\t        \"size_bytes\": decoded.size_bytes,\n131\t        \"truncated\": decoded.truncated,\n132\t        \"text\": decoded.text,\n133\t    }\n134\t    if decoded.control_chars:\n135\t        out[\"stray_control_bytes_removed\"] = decoded.control_chars\n136\t    if \"SIMULATION MODE\" in decoded.text:\n137\t        out[\"simulation\"] = True\n138\t        out[\"warning\"] = \"SIMULATION MODE - this data is not from a vehicle\"\n139\t    elif kind == \"scan\":\n140\t        out[\"provenance\"] = (\"unverifiable - SCAN logs carry no simulation \"\n141\t                             \"marker\")\n142\t    return out\n143\t\n144\t\n145\tdef search_logs(pattern: str, *, kind: str = \"\", vehicle: str = \"\",\n146\t                vin: str = \"\", context_lines: int = 2, max_matches: int = 40,\n147\t                include_simulation: bool = False) -> dict[str, Any]:\n148\t    \"\"\"Case-insensitive regex search across logs, newest first.\"\"\"\n149\t    if not pattern.strip():\n150\t        raise BadRequest(\"a search pattern is required\")\n151\t    try:\n152\t        rx = re.compile(pattern, re.IGNORECASE)\n153\t    except re.error as exc:\n154\t        raise BadRequest(f\"invalid regular expression: {exc}\") from exc\n155\t\n156\t    entries = CATALOG.select(kind=kind, vehicle=vehicle, vin=vin,\n157\t                             include_simulation=include_simulation)\n158\t    hits: list[dict[str, Any]] = []\n159\t    for entry in entries:\n160\t        try:\n161\t            lines = encoding.read_log_text(entry.path).splitlines()\n162\t        except Exception as exc:  # one unreadable file must not sink a search\n163\t            hits.append({\"file\": entry.name, \"error\": str(exc)})\n164\t            continue\n165\t        for i, line in enumerate(lines):\n166\t            if not rx.search(line):\n167\t                continue\n168\t            lo = max(0, i - context_lines)\n169\t            hi = min(len(lines), i + context_lines + 1)\n170\t            hits.append({\n171\t                \"file\": entry.name,\n172\t                \"timestamp\": entry.timestamp,\n173\t                \"simulation\": entry.simulation,\n174\t                \"line\": i + 1,\n175\t                \"match\": line.strip(),\n176\t                \"context\": [f\"{j + 1}: {lines[j]}\" for j in range(lo, hi)],\n177\t            })\n178\t            if len(hits) >= max_matches:\n179\t                return {\"count\": len(hits), \"truncated\": True,\n180\t                        \"matches\": hits}\n181\t    return {\"count\": len(hits), \"truncated\": False, \"matches\": hits}\n182\t\n183\t\n184\t# --- per-vehicle analysis -------------------------------------------------\n185\t\n186\t\n187\tdef workup(vin: str = \"\", vehicle: str = \"\") -> dict[str, Any]:\n188\t    \"\"\"The pre-work dossier. Raises :class:`NotFound` when no logs match.\"\"\"\n189\t    dossier = workup_mod.build(vin=vin, vehicle=vehicle)\n190\t    if \"error\" in dossier:\n191\t        raise NotFound(dossier[\"error\"])\n192\t    return dossier\n193\t\n194\t\n195\tdef vehicle_report(vin: str = \"\", vehicle: str = \"\") -> dict[str, Any]:\n196\t    \"\"\"Identity, odometer span and chronic faults for one vehicle.\"\"\"\n197\t    report = analysis.vehicle_summary(vin=vin, vehicle=vehicle)\n198\t    if \"error\" in report:\n199\t        raise NotFound(report[\"error\"])\n200\t    return report\n201\t\n202\t\n203\tdef live_vs_log(vin: str, module: str = \"\") -> dict[str, Any]:\n204\t    \"\"\"Newest log read vs newest live read, one row per code, per module.\n205\t\n206\t    Passthrough to :func:`mes.compare.live_vs_log`; see that module for the\n207\t    join and classification rules.\n208\t    \"\"\"\n209\t    if not vin.strip():\n210\t        raise BadRequest(\"a VIN is required\")\n211\t    result = compare.live_vs_log(vin, module=module)\n212\t    if \"error\" in result:\n213\t        raise BadRequest(result[\"error\"])\n214\t    return result\n215\t\n216\t\n217\tdef _classified(record: Any) -> dict[str, Any]:\n218\t    \"\"\"A DTC record as a dict, with its classification made explicit.\n219\t\n220\t    ``DtcRecord.to_dict`` reports the classification only as a prose\n221\t    ``assessment`` string; ``chronic`` and ``returned_after_clear`` are\n222\t    properties that do not survive serialisation. Clients need the booleans to\n223\t    colour a row, and re-deriving \"chronic\" from the odometer span in a\n224\t    template would fork the rule -- so read the library's own properties here\n225\t    and publish them. One definition, in ``mes.analysis.DtcRecord``.\n226\t\n227\t    ``severity`` collapses the same facts onto the four states the UI shows,\n228\t    ordered by what changes a decision: a code that came back after a clear is\n229\t    live and reproducing; a chronic one has persisted over distance; a cleared\n230\t    one proves nothing until a monitor re-runs.\n231\t    \"\"\"\n232\t    out = record.to_dict()\n233\t    out[\"chronic\"] = record.chronic\n234\t    out[\"returned_after_clear\"] = record.returned_after_clear\n235\t\n236\t    if record.returned_after_clear:\n237\t        severity = \"returned\"\n238\t    elif record.chronic:\n239\t        severity = \"chronic\"\n240\t    elif \"cleared\" in record.statuses and record.session_count <= 1:\n241\t        severity = \"cleared\"\n242\t    elif record.session_count <= 1:\n243\t        severity = \"seen-once\"\n244\t    else:\n245\t        severity = \"recurring\"\n246\t    out[\"severity\"] = severity\n247\t    return out\n248\t\n249\t\n250\tdef extract_dtcs(*, vin: str = \"\", vehicle: str = \"\", since: str = \"\",\n251\t                 include_simulation: bool = False) -> dict[str, Any]:\n252\t    \"\"\"Every DTC with first-seen, last-seen, session count and odometer span.\n253\t\n254\t    Ordered so the codes that decide a diagnosis come first: returned-after-\n255\t    clear, then chronic, then the rest.\n256\t    \"\"\"\n257\t    entries = CATALOG.select(vin=vin, vehicle=vehicle, since=since,\n258\t                             include_simulation=include_simulation)\n259\t    history = analysis.dtc_history(entries)\n260\t    records = sorted(history.values(),\n261\t                     key=lambda r: (not r.returned_after_clear,\n262\t                                    not r.chronic, r.dtc))\n263\t    return {\n264\t        \"count\": len(records),\n265\t        \"logs_considered\": len(entries),\n266\t        \"simulation_included\": include_simulation,\n267\t        \"dtcs\": [_classified(r) for r in records],\n268\t    }\n269\t\n270\t\n271\tdef dtc_history(code: str, *, vin: str = \"\") -> dict[str, Any]:\n272\t    \"\"\"One code's complete life across sessions.\"\"\"\n273\t    wanted = code.strip().upper()\n274\t    if not wanted:\n275\t        raise BadRequest(\"a DTC is required\")\n276\t    history = analysis.dtc_history(vin=vin)\n277\t    matches = {k: v for k, v in history.items()\n278\t               if wanted in (k, k.split(\"-\")[0])}\n279\t    if not matches:\n280\t        raise NotFound(\n281\t            f\"{wanted} appears in no real log for this vehicle \"\n282\t            \"(simulation logs are excluded by default)\")\n283\t    return {\"code\": wanted,\n284\t            \"matches\": [_classified(r) for r in matches.values()]}\n285\t\n286\t\n287\tdef freeze_frames(*, code: str = \"\", name: str = \"\",\n288\t                  vin: str = \"\") -> dict[str, Any]:\n289\t    \"\"\"The ~25 parameters captured when a code set.\n290\t\n291\t    This is the evidence that separates a cold-start fault from a highway one,\n292\t    and it is destroyed by a clear -- which is why the UI reads it before\n293\t    offering one.\n294\t    \"\"\"\n295\t    wanted = code.strip().upper()\n296\t    if name.strip():\n297\t        try:\n298\t            entries = [CATALOG.by_name(name)]\n299\t        except MesError as exc:\n300\t            raise NotFound(str(exc)) from exc\n301\t    else:\n302\t        entries = CATALOG.select(kind=\"fes\", vin=vin)\n303\t\n304\t    found: list[dict[str, Any]] = []\n305\t    for entry in entries:\n306\t        if entry.kind != \"fes\" or entry.parse_error:\n307\t            continue\n308\t        log = fes.load_fes(entry.path, timestamp=entry.timestamp)\n309\t        for d in log.dtcs:\n310\t            if wanted and wanted not in (d.full, d.code):\n311\t                continue\n312\t            if not d.freeze_frame:\n313\t                continue\n314\t            found.append({\n315\t                \"dtc\": d.full,\n316\t                \"description\": d.description,\n317\t                \"status\": d.status.value,\n318\t                \"status_meaning\": d.status.explanation,\n319\t                \"file\": entry.name,\n320\t                \"timestamp\": entry.timestamp,\n321\t                \"ecu\": log.ecu_description,\n322\t                \"vin\": log.vin,\n323\t                \"freeze_frame\": {k: v.display\n324\t                                 for k, v in d.freeze_frame.items()},\n325\t            })\n326\t    if not found:\n327\t        raise NotFound(f\"no freeze frame for {code or '(any code)'}\")\n328\t    return {\"count\": len(found), \"frames\": found}\n329\t\n330\t\n331\tdef actuator_history(*, vin: str = \"\", operation: str = \"\") -> dict[str, Any]:\n332\t    \"\"\"Every actuator test and adjustment ever run, and why any failed.\"\"\"\n333\t    entries = CATALOG.select(kind=\"fes\", vin=vin)\n334\t    runs: list[dict[str, Any]] = []\n335\t    for entry in entries:\n336\t        if entry.parse_error:\n337\t            continue\n338\t        log = fes.load_fes(entry.path, timestamp=entry.timestamp)\n339\t        for a in log.actuators:\n340\t            if operation.strip() and operation.lower() not in a.operation.lower():\n341\t                continue\n342\t            row = a.to_dict()\n343\t            row.update({\"file\": entry.name, \"timestamp\": entry.timestamp,\n344\t                        \"ecu\": log.ecu_description})\n345\t            runs.append(row)\n346\t    runs.sort(key=lambda r: r.get(\"timestamp\") or \"\", reverse=True)\n347\t    failed = [r for r in runs if r.get(\"outcome\") == \"FAILED TO EXECUTE\"]\n348\t    return {\n349\t        \"count\": len(runs),\n350\t        \"failed\": len(failed),\n351\t        \"runs\": runs,\n352\t        \"note\": (\"MES actuator tests on the IAW 10JA require key-on \"\n353\t                 \"engine-off; 'Engine running' is an interlock, not a fault.\"),\n354\t    }\n355\t\n356\t\n357\t# --- sessions and scans ---------------------------------------------------\n358\t\n359\t\n360\tdef analyze_session(*, name: str = \"\", vin: str = \"\") -> dict[str, Any]:\n361\t    \"\"\"One FES engineering session: identity, DTCs, clears, actuators.\"\"\"\n362\t    try:\n363\t        entry = catalog.resolve_or_latest(name, kind=\"fes\", vin=vin)\n364\t    except MesError as exc:\n365\t        raise NotFound(str(exc)) from exc\n366\t    log = fes.load_fes(entry.path, timestamp=entry.timestamp)\n367\t    out = log.to_dict()\n368\t    out[\"file\"] = entry.name\n369\t    out[\"timestamp\"] = entry.timestamp\n370\t    cleared = analysis.post_clear_assessment(log)\n371\t    if cleared:\n372\t        out[\"clear_assessment\"] = cleared.to_dict()\n373\t    return out\n374\t\n375\t\n376\tdef analyze_scan(*, name: str = \"\", vin: str = \"\") -> dict[str, Any]:\n377\t    \"\"\"One all-systems SCAN: per-module status, with network-cascade detection.\"\"\"\n378\t    try:\n379\t        entry = catalog.resolve_or_latest(name, kind=\"scan\", vin=vin)\n380\t    except MesError as exc:\n381\t        raise NotFound(str(exc)) from exc\n382\t    log = scan.load_scan(entry.path, timestamp=entry.timestamp)\n383\t    out = log.to_dict()\n384\t    out[\"file\"] = entry.name\n385\t    out[\"timestamp\"] = entry.timestamp\n386\t    by_module = {m.name: m.dtcs for m in log.modules if m.dtcs}\n387\t    event = analysis.detect_network_event(by_module)\n388\t    if event:\n389\t        out[\"network_event\"] = event.to_dict()\n390\t    out[\"provenance\"] = (\"unverifiable - SCAN logs carry no simulation marker\")\n391\t    return out\n392\t\n393\t\n394\tdef list_parameters(*, name: str = \"\", vin: str = \"\") -> dict[str, Any]:\n395\t    \"\"\"Live parameters a FES session recorded, unioned across samples.\"\"\"\n396\t    try:\n397\t        entry = catalog.resolve_or_latest(name, kind=\"fes\", vin=vin)\n398\t    except MesError as exc:\n399\t        raise NotFound(str(exc)) from exc\n400\t    log = fes.load_fes(entry.path, timestamp=entry.timestamp)\n401\t    if not log.samples:\n402\t        return {\"file\": entry.name, \"samples\": 0,\n403\t                \"note\": \"this session logged no live parameters\"}\n404\t    return {\n405\t        \"file\": entry.name,\n406\t        \"timestamp\": entry.timestamp,\n407\t        \"ecu\": log.ecu_description,\n408\t        \"samples\": len(log.samples),\n409\t        \"parameter_count\": len(log.param_names()),\n410\t        \"parameters\": log.param_names(),\n411\t    }\n412\t\n413\t\n414\tdef parameter_series(parameter: str, *, name: str = \"\",\n415\t                     vin: str = \"\") -> dict[str, Any]:\n416\t    \"\"\"One session parameter as an ordered series with statistics.\"\"\"\n417\t    try:\n418\t        entry = catalog.resolve_or_latest(name, kind=\"fes\", vin=vin)\n419\t    except MesError as exc:\n420\t        raise NotFound(str(exc)) from exc\n421\t    log = fes.load_fes(entry.path, timestamp=entry.timestamp)\n422\t    series = log.series(parameter)\n423\t    if not series.samples:\n424\t        raise NotFound(f\"'{parameter}' was not logged in {entry.name}\")\n425\t    out = series.stats()\n426\t    out[\"file\"] = entry.name\n427\t    out[\"values\"] = [s.display for s in series.samples]\n428\t    out[\"timing_note\"] = (\"MES records no per-sample timestamp; order is file \"\n429\t                          \"order and the sample rate is unknown\")\n430\t    if out.get(\"static\"):\n431\t        out[\"interpretation\"] = (\n432\t            \"This value never changed across the whole session -- consistent \"\n433\t            \"with a substituted default or a modelled value rather than a \"\n434\t            \"live measurement. Confirm before treating it as a reading.\")\n435\t    return out\n436\t\n437\t\n438\t# --- decision support -----------------------------------------------------\n439\t\n440\t\n441\tdef fault_tree(codes: str = \"\", *, vin: str = \"\") -> dict[str, Any]:\n442\t    \"\"\"Applicable isolation sequences, annotated with this car's evidence.\n443\t\n444\t    Returns successfully even when nothing matches: the payload then carries\n445\t    the trees that *do* exist, which is the useful answer to \"is there a tree\n446\t    for this?\".\n447\t    \"\"\"\n448\t    code_list = [c for c in re.split(r\"[,\\s;]+\", codes) if c.strip()]\n449\t    if not code_list:\n450\t        return {\n451\t            \"error\": \"no codes given\",\n452\t            \"available\": [{\"tree\": t.key, \"title\": t.title,\n453\t                           \"applies_to\": sorted(t.codes)}\n454\t                          for t in faulttree.TREES],\n455\t        }\n456\t    return faulttree.evaluate(code_list, vin=vin)\n457\t\n458\t\n459\tdef assess_verdict(*, vin: str, codes: str, component: str, mechanism: str,\n460\t                   measurements: str,\n461\t                   disconfirming_test: str) -> dict[str, Any]:\n462\t    \"\"\"The evidence gate.\n463\t\n464\t    The only non-read operation in the P1 surface, and it writes nothing to\n465\t    the car -- it evaluates a proposed diagnosis against four criteria and\n466\t    refuses CONFIRMED unless all of them hold.\n467\t    \"\"\"\n468\t    result = verdict.assess(vin=vin, codes=codes, component=component,\n469\t                            mechanism=mechanism, measurements=measurements,\n470\t                            disconfirming_test=disconfirming_test)\n471\t    if \"error\" in result and \"verdict\" not in result:\n472\t        raise BadRequest(result[\"error\"])\n473\t    return result\n474\t\n475\t\n476\tdef open_codes_for(dossier: dict[str, Any]) -> list[str]:\n477\t    \"\"\"The codes a dossier should route to a fault tree.\n478\t\n479\t    Two sources, unioned:\n480\t\n481\t    * the newest session that held findings -- preferred over the newest\n482\t      session outright, because the latter is often the empty post-clear\n483\t      re-read and routing off it produces \"no codes\" on a car that plainly\n484\t      has some;\n485\t    * every chronic or returned-after-clear code in the car's history.\n486\t\n487\t    The second source matters more than it looks. On this Stelvio the newest\n488\t    session shows a cleared ``P0440`` while the code that actually decides the\n489\t    diagnosis is a chronic ``P0456`` spanning 26,500 km. Routing on the latest\n490\t    session alone would send the tree after the wrong fault.\n491\t    \"\"\"\n492\t    codes: set[str] = set()\n493\t\n494\t    current = dossier.get(\"current_picture\", {})\n495\t    for key in (\"last_session_with_findings\", \"latest_session\"):\n496\t        session = current.get(key) or {}\n497\t        found = [d.get(\"code\") or d.get(\"dtc\") or \"\"\n498\t                 for d in session.get(\"dtcs\", [])]\n499\t        found = [knowledge.base_code(c) for c in found if c]\n500\t        if found:\n501\t            codes.update(found)\n502\t            break\n503\t\n504\t    history = dossier.get(\"history\", {})\n505\t    for bucket in (\"chronic\", \"returned_after_clear\"):\n506\t        for record in history.get(bucket, []):\n507\t            raw = record.get(\"dtc\") or record.get(\"code\") or \"\"\n508\t            if raw:\n509\t                codes.add(knowledge.base_code(raw))\n510\t\n511\t    return sorted(codes)\n512\t\n513\t\n514\t# --- dealer (wiTECH) results -----------------------------------------------\n515\t\n516\t\n517\tdef dealer_record(vin: str, kind: str, data: dict[str, Any],\n518\t                  note: str = \"\") -> dict[str, Any]:\n519\t    \"\"\"Record one technician-entered wiTECH result. Raises BadRequest on\n520\t    anything the store's per-kind validation rejects.\"\"\"\n521\t    if not vin.strip():\n522\t        raise BadRequest(\"a VIN is required\")\n523\t    try:\n524\t        return dealer_mod.record(vin, kind, data, note=note)\n525\t    except ValueError as exc:\n526\t        raise BadRequest(str(exc)) from exc\n527\t\n528\t\n529\tdef dealer_results(vin: str) -> dict[str, Any]:\n530\t    \"\"\"Every dealer result recorded for this VIN, oldest first.\"\"\"\n531\t    if not vin.strip():\n532\t        raise BadRequest(\"a VIN is required\")\n533\t    return {\"vin\": vin, \"results\": dealer_mod.load(vin)}\n534\t\n535\t\n536\t# --- technician notes -------------------------------------------------------\n537\t\n538\t\n539\tdef add_note(vin: str, text: str, target_kind: str = \"vehicle\", target_id: str = \"\",\n540\t            author: str = \"technician\", tags: Optional[list[str]] = None) -> dict[str, Any]:\n541\t    \"\"\"Record one technician note. Raises BadRequest on invalid input.\"\"\"\n542\t    if not vin.strip():\n543\t        raise BadRequest(\"a VIN is required\")\n544\t    try:\n545\t        return notes_mod.add(vin, text, target_kind, target_id=target_id,\n546\t                             author=author, tags=tags)\n547\t    except ValueError as exc:\n548\t        raise BadRequest(str(exc)) from exc\n549\t\n550\t\n551\tdef notes(vin: str, target_kind: str = \"\", target_id: str = \"\") -> dict[str, Any]:\n552\t    \"\"\"Notes for this VIN, oldest first, filtered by target when given.\"\"\"\n553\t    if not vin.strip():\n554\t        raise BadRequest(\"a VIN is required\")\n555\t    return {\"vin\": vin,\n556\t            \"notes\": notes_mod.load(vin, target_kind=target_kind or None,\n557\t                                    target_id=target_id)}\n558\t\n559\t\n560\tdef edit_note(id: str, text: str) -> dict[str, Any]:\n561\t    \"\"\"Amend a note's text. Never rewrites history.\"\"\"\n562\t    try:\n563\t        return notes_mod.edit(id, text)\n564\t    except ValueError as exc:\n565\t        raise BadRequest(str(exc)) from exc\n566\t\n567\t\n568\tdef hide_note(id: str) -> dict[str, Any]:\n569\t    \"\"\"Hide a note (soft delete). Never rewrites history.\"\"\"\n570\t    try:\n571\t        return notes_mod.hide(id)\n572\t    except ValueError as exc:\n573\t        raise BadRequest(str(exc)) from exc\n574\t\n575\t\n576\t# --- reference ------------------------------------------------------------\n577\t\n578\t\n579\tdef module_registry(*, abbrev: str = \"\", domain: str = \"\") -> dict[str, Any]:\n580\t    \"\"\"The 126-module registry: one module, one domain, or the whole map.\"\"\"\n581\t    if abbrev.strip():\n582\t        info = modules.describe(abbrev)\n583\t        if \"error\" in info:\n584\t            raise NotFound(info[\"error\"])\n585\t        return info\n586\t    grouped = modules.by_domain()\n587\t    if domain.strip():\n588\t        key = domain.strip().lower()\n589\t        if key not in grouped:\n590\t            raise NotFound(f\"unknown domain '{domain}'\")\n591\t        return {\"domain\": key,\n592\t                \"modules\": [m.to_dict() for m in grouped[key]]}\n593\t    return {\n594\t        \"stats\": modules.registry_stats(),\n595\t        \"by_domain\": {d: [m.to_dict() for m in v]\n596\t                      for d, v in sorted(grouped.items())},\n597\t    }\n598\t\n599\t\n600\tdef failure_type(byte: str) -> dict[str, Any]:\n601\t    \"\"\"Decode the two hex digits after the dash in a UDS DTC.\"\"\"\n602\t    ft = dtc_mod.failure_type(byte.strip())\n603\t    if ft is None:\n604\t        raise NotFound(f\"no failure type for '{byte}'\")\n605\t    return ft.to_dict()\n606\t\n607\t\n608\tdef describe_dtc(code: str, module: str = \"\") -> dict[str, Any]:\n609\t    \"\"\"Look up a DTC's description in MES's own shipped language files.\n610\t\n611\t    Mirrors the ``dtc_description`` MCP tool call-for-call. This is a\n612\t    fallback for a code no log gave text for, not a general database: MES's\n613\t    ``English.dat``/``English.txt`` carry no DTC-code key at all (see\n614\t    ``docs/format/MES_LANGUAGE_FILES.md``), so against the currently\n615\t    installed files this raises :class:`NotFound` for virtually every real\n616\t    code. The lookup itself is genuine and forward-compatible.\n617\t    \"\"\"\n618\t    if not code.strip():\n619\t        raise BadRequest(\"a DTC code is required\")\n620\t    result = dtc_text.describe(code, module.strip() or None)\n621\t    if result is None:\n622\t        raise NotFound(\n623\t            f\"'{code}' has no entry in MES's shipped language files -- no \"\n624\t            \"DTC-code key exists in the currently installed \"\n625\t            \"English.dat/English.txt (docs/format/MES_LANGUAGE_FILES.md)\")\n626\t    return result\n627\t\n628\t\n629\t# --- CSV recordings -------------------------------------------------------\n630\t\n631\t\n632\tdef list_recordings() -> dict[str, Any]:\n633\t    \"\"\"CSV recordings from MES's graph subsystem, newest first.\"\"\"\n634\t    recs = csvlog.list_recordings()\n635\t    out: dict[str, Any] = {\n636\t        \"count\": len(recs),\n637\t        \"recordings\": recs,\n638\t        \"roots\": [str(r) for r in paths.csv_roots()],\n639\t    }\n640\t    if not recs:\n641\t        out[\"note\"] = (\n642\t            \"No CSV recordings found. In MES: Graph tab, add parameters, then \"\n643\t            \"CSV Start / Stop. The export lands in the Settings 'Export \"\n644\t            \"Folder'. Point MES_CSV_DIR at it if it differs from the log \"\n645\t            \"folder.\")\n646\t    return out\n647\t\n648\t\n649\tdef _recording(name: str):\n650\t    try:\n651\t        return csvlog.load_named(name)\n652\t    except MesError as exc:\n653\t        raise NotFound(str(exc)) from exc\n654\t\n655\t\n656\tdef read_recording(name: str, *, preview_rows: int = 10) -> dict[str, Any]:\n657\t    \"\"\"One recording: columns, measured timing, dropouts, TAG/DTC events.\"\"\"\n658\t    return _recording(name).to_dict(preview_rows=preview_rows)\n659\t\n660\t\n661\tdef recording_series(name: str, parameter: str) -> dict[str, Any]:\n662\t    \"\"\"One recorded parameter as a *timed* series -- real timestamps, unlike\n663\t    a .txt session, so the statistics are physically meaningful.\"\"\"\n664\t    rec = _recording(name)\n665\t    series = rec.series(parameter)\n666\t    if not series.samples:\n667\t        raise NotFound(f\"'{parameter}' is not a column in {rec.name}\")\n668\t    out = series.stats()\n669\t    out[\"file\"] = rec.name\n670\t    out[\"values\"] = [{\"t\": stamp, \"value\": s.display}\n671\t                     for stamp, s in zip(series.stamps, series.samples)]\n672\t    if out.get(\"static\"):\n673\t        out[\"interpretation\"] = (\n674\t            \"This value never changed across the recording -- consistent with \"\n675\t            \"a substituted default rather than a live measurement.\")\n676\t    return out\n677\t\n678\t\n679\tdef recording_events(name: str, *, condition: str = \"\") -> dict[str, Any]:\n680\t    \"\"\"TAG/DTC events and dropouts; with a condition, excursion intervals.\"\"\"\n681\t    rec = _recording(name)\n682\t    out: dict[str, Any] = {\n683\t        \"file\": rec.name,\n684\t        \"timing\": rec.timing(),\n685\t        \"tag_events\": [t.to_dict() for t in rec.tags],\n686\t        \"dtcs_in_tags\": sorted({d for t in rec.tags for d in t.dtcs}),\n687\t    }\n688\t    if condition.strip():\n689\t        try:\n690\t            out[\"threshold\"] = rec.crossings(condition)\n691\t        except MesError as exc:\n692\t            raise BadRequest(str(exc)) from exc\n693\t    return out\n694\t\n695\t\n696\tdef recording_snapshot(name: str, at_seconds: float) -> dict[str, Any]:\n697\t    \"\"\"The post-hoc freeze frame: every value at the sample nearest a time.\"\"\"\n698\t    rec = _recording(name)\n699\t    return {\"file\": rec.name, **rec.snapshot(at_seconds)}\n700\t"}]},"uuid":"ab17c205-8808-40e5-83c9-2c9561609f95","timestamp":"2026-10-08T17:37:04.830Z","toolUseResult":{"type":"text","file":{"filePath":"C:\\Users\\User\\mcp-servers\\cuore\\services\\mes_bridge.py","content":"\"\"\"The only module in CUORE that imports :mod:`mes`.\n\nEvery route reaches the analysis library through here. That is deliberate:\n``mes-log-mcp/server.py`` already exposes this library as MCP tools, and the\ntwo surfaces must not drift. Each function below mirrors its MCP counterpart\ncall-for-call, so a change in the library shows up identically in both.\n\nNothing here re-implements analysis. Chronic classification, TSB matching,\nfault-tree content and the evidence gate's criteria live in ``mes`` and are\nunit-tested there against the real corpus; this file only calls them and\ntranslates \"no result\" into an exception the HTTP layer can turn into a\nstatus code.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport re\nfrom typing import Any, Optional\n\nfrom .. import bootstrap  # noqa: F401  -- side effect: puts `mes` on sys.path\nfrom .errors import BadRequest, NotFound\n\nfrom mes import (  # noqa: E402  -- must follow the bootstrap import\n    analysis,\n    catalog,\n    compare,\n    csvlog,\n    dealer as dealer_mod,\n    dtc as dtc_mod,\n    dtc_text,\n    encoding,\n    faulttree,\n    fes,\n    knowledge,\n    modules,\n    notes as notes_mod,\n    paths,\n    scan,\n    verdict,\n)\nfrom mes import workup as workup_mod  # noqa: E402\nfrom mes.errors import MesError  # noqa: E402\n\nCATALOG = catalog.CATALOG\n\n\n# --- corpus ---------------------------------------------------------------\n\n\ndef corpus_status() -> dict[str, Any]:\n    \"\"\"Health and inventory: roots, real vs simulated counts, parse errors.\"\"\"\n    return CATALOG.stats()\n\n\ndef log_roots() -> dict[str, Any]:\n    \"\"\"The MES log directories being watched, and whether they exist.\"\"\"\n    return {\n        \"configured\": [str(r) for r in paths.configured_roots()],\n        \"existing\": [str(r) for r in paths.existing_roots()],\n        \"csv_configured\": [str(r) for r in paths.csv_roots()],\n        \"csv_existing\": [str(r) for r in paths.existing_csv_roots()],\n        \"env_overrides\": [\"MES_LOG_DIRS\", \"MES_LOG_DIR\",\n                          \"MES_CSV_DIRS\", \"MES_CSV_DIR\"],\n    }\n\n\ndef vehicles(*, real_only: bool = False) -> list[dict[str, Any]]:\n    \"\"\"Every distinct vehicle in the corpus, keyed by VIN where recoverable.\n\n    ``real_only`` keeps the two cars that actually exist -- a resolvable VIN\n    and at least one non-simulated log -- and drops the simulation pseudo\n    vehicles, whose \"VIN\" is MES's practice-data placeholder.\n    \"\"\"\n    found = CATALOG.vehicles()\n    if not real_only:\n        return found\n    return [v for v in found\n            if v.get(\"real_logs\", 0) > 0 and len(v.get(\"vin\", \"\")) >= 11]\n\n\ndef newest_mtime(vin: str = \"\") -> float:\n    \"\"\"Newest file mtime across a vehicle's logs -- the cache key for workup.\"\"\"\n    entries = CATALOG.select(vin=vin) if vin else CATALOG.entries()\n    return max((e.mtime for e in entries), default=0.0)\n\n\n# --- logs -----------------------------------------------------------------\n\n\ndef list_logs(*, kind: str = \"\", vehicle: str = \"\", vin: str = \"\",\n              since: str = \"\", until: str = \"\", limit: int = 30,\n              include_simulation: bool = False) -> dict[str, Any]:\n    \"\"\"Filtered log index, newest first by session timestamp.\"\"\"\n    entries = CATALOG.select(kind=kind, vehicle=vehicle, vin=vin, since=since,\n                             until=until, limit=limit,\n                             include_simulation=include_simulation)\n    return {\n        \"count\": len(entries),\n        \"filters\": {\"kind\": kind, \"vehicle\": vehicle, \"vin\": vin,\n                    \"since\": since, \"until\": until,\n                    \"include_simulation\": include_simulation},\n        \"logs\": [e.to_dict() for e in entries],\n    }\n\n\ndef read_log(name: str, *, max_bytes: int = 200_000) -> dict[str, Any]:\n    \"\"\"Read one MES log verbatim.\n\n    Resolution goes through :func:`mes.paths.resolve_log`, which requires a\n    bare filename matching a MES log pattern and verifies the fully resolved\n    real path is inside a configured root. That check is the whole security\n    boundary of this endpoint: an earlier version of the MCP server built the\n    path by concatenation, which on Windows let both ``..`` and an absolute\n    path escape it. Do not replace this with ``Path(root) / name``.\n    \"\"\"\n    try:\n        path = paths.resolve_log(name)\n    except MesError as exc:\n        raise BadRequest(str(exc)) from exc\n\n    decoded = encoding.read_log_text(path, max_bytes=max_bytes)\n    kind, raw_stamp, vehicle = paths.classify_name(path.name)\n    stamp = catalog.parse_stamp(raw_stamp)\n    out: dict[str, Any] = {\n        \"file\": path.name,\n        \"kind\": kind,\n        \"timestamp\": stamp.isoformat(sep=\" \") if stamp else raw_stamp,\n        \"vehicle\": vehicle,\n        \"encoding\": decoded.encoding,\n        \"size_bytes\": decoded.size_bytes,\n        \"truncated\": decoded.truncated,\n        \"text\": decoded.text,\n    }\n    if decoded.control_chars:\n        out[\"stray_control_bytes_removed\"] = decoded.control_chars\n    if \"SIMULATION MODE\" in decoded.text:\n        out[\"simulation\"] = True\n        out[\"warning\"] = \"SIMULATION MODE - this data is not from a vehicle\"\n    elif kind == \"scan\":\n        out[\"provenance\"] = (\"unverifiable - SCAN logs carry no simulation \"\n                             \"marker\")\n    return out\n\n\ndef search_logs(pattern: str, *, kind: str = \"\", vehicle: str = \"\",\n                vin: str = \"\", context_lines: int = 2, max_matches: int = 40,\n                include_simulation: bool = False) -> dict[str, Any]:\n    \"\"\"Case-insensitive regex search across logs, newest first.\"\"\"\n    if not pattern.strip():\n        raise BadRequest(\"a search pattern is required\")\n    try:\n        rx = re.compile(pattern, re.IGNORECASE)\n    except re.error as exc:\n        raise BadRequest(f\"invalid regular expression: {exc}\") from exc\n\n    entries = CATALOG.select(kind=kind, vehicle=vehicle, vin=vin,\n                             include_simulation=include_simulation)\n    hits: list[dict[str, Any]] = []\n    for entry in entries:\n        try:\n            lines = encoding.read_log_text(entry.path).splitlines()\n        except Exception as exc:  # one unreadable file must not sink a search\n            hits.append({\"file\": entry.name, \"error\": str(exc)})\n            continue\n        for i, line in enumerate(lines):\n            if not rx.search(line):\n                continue\n            lo = max(0, i - context_lines)\n            hi = min(len(lines), i + context_lines + 1)\n            hits.append({\n                \"file\": entry.name,\n                \"timestamp\": entry.timestamp,\n                \"simulation\": entry.simulation,\n                \"line\": i + 1,\n                \"match\": line.strip(),\n                \"context\": [f\"{j + 1}: {lines[j]}\" for j in range(lo, hi)],\n            })\n            if len(hits) >= max_matches:\n                return {\"count\": len(hits), \"truncated\": True,\n                        \"matches\": hits}\n    return {\"count\": len(hits), \"truncated\": False, \"matches\": hits}\n\n\n# --- per-vehicle analysis -------------------------------------------------\n\n\ndef workup(vin: str = \"\", vehicle: str = \"\") -> dict[str, Any]:\n    \"\"\"The pre-work dossier. Raises :class:`NotFound` when no logs match.\"\"\"\n    dossier = workup_mod.build(vin=vin, vehicle=vehicle)\n    if \"error\" in dossier:\n        raise NotFound(dossier[\"error\"])\n    return dossier\n\n\ndef vehicle_report(vin: str = \"\", vehicle: str = \"\") -> dict[str, Any]:\n    \"\"\"Identity, odometer span and chronic faults for one vehicle.\"\"\"\n    report = analysis.vehicle_summary(vin=vin, vehicle=vehicle)\n    if \"error\" in report:\n        raise NotFound(report[\"error\"])\n    return report\n\n\ndef live_vs_log(vin: str, module: str = \"\") -> dict[str, Any]:\n    \"\"\"Newest log read vs newest live read, one row per code, per module.\n\n    Passthrough to :func:`mes.compare.live_vs_log`; see that module for the\n    join and classification rules.\n    \"\"\"\n    if not vin.strip():\n        raise BadRequest(\"a VIN is required\")\n    result = compare.live_vs_log(vin, module=module)\n    if \"error\" in result:\n        raise BadRequest(result[\"error\"])\n    return result\n\n\ndef _classified(record: Any) -> dict[str, Any]:\n    \"\"\"A DTC record as a dict, with its classification made explicit.\n\n    ``DtcRecord.to_dict`` reports the classification only as a prose\n    ``assessment`` string; ``chronic`` and ``returned_after_clear`` are\n    properties that do not survive serialisation. Clients need the booleans to\n    colour a row, and re-deriving \"chronic\" from the odometer span in a\n    template would fork the rule -- so read the library's own properties here\n    and publish them. One definition, in ``mes.analysis.DtcRecord``.\n\n    ``severity`` collapses the same facts onto the four states the UI shows,\n    ordered by what changes a decision: a code that came back after a clear is\n    live and reproducing; a chronic one has persisted over distance; a cleared\n    one proves nothing until a monitor re-runs.\n    \"\"\"\n    out = record.to_dict()\n    out[\"chronic\"] = record.chronic\n    out[\"returned_after_clear\"] = record.returned_after_clear\n\n    if record.returned_after_clear:\n        severity = \"returned\"\n    elif record.chronic:\n        severity = \"chronic\"\n    elif \"cleared\" in record.statuses and record.session_count <= 1:\n        severity = \"cleared\"\n    elif record.session_count <= 1:\n        severity = \"seen-once\"\n    else:\n        severity = \"recurring\"\n    out[\"severity\"] = severity\n    return out\n\n\ndef extract_dtcs(*, vin: str = \"\", vehicle: str = \"\", since: str = \"\",\n                 include_simulation: bool = False) -> dict[str, Any]:\n    \"\"\"Every DTC with first-seen, last-seen, session count and odometer span.\n\n    Ordered so the codes that decide a diagnosis come first: returned-after-\n    clear, then chronic, then the rest.\n    \"\"\"\n    entries = CATALOG.select(vin=vin, vehicle=vehicle, since=since,\n                             include_simulation=include_simulation)\n    history = analysis.dtc_history(entries)\n    records = sorted(history.values(),\n                     key=lambda r: (not r.returned_after_clear,\n                                    not r.chronic, r.dtc))\n    return {\n        \"count\": len(records),\n        \"logs_considered\": len(entries),\n        \"simulation_included\": include_simulation,\n        \"dtcs\": [_classified(r) for r in records],\n    }\n\n\ndef dtc_history(code: str, *, vin: str = \"\") -> dict[str, Any]:\n    \"\"\"One code's complete life across sessions.\"\"\"\n    wanted = code.strip().upper()\n    if not wanted:\n        raise BadRequest(\"a DTC is required\")\n    history = analysis.dtc_history(vin=vin)\n    matches = {k: v for k, v in history.items()\n               if wanted in (k, k.split(\"-\")[0])}\n    if not matches:\n        raise NotFound(\n            f\"{wanted} appears in no real log for this vehicle \"\n            \"(simulation logs are excluded by default)\")\n    return {\"code\": wanted,\n            \"matches\": [_classified(r) for r in matches.values()]}\n\n\ndef freeze_frames(*, code: str = \"\", name: str = \"\",\n                  vin: str = \"\") -> dict[str, Any]:\n    \"\"\"The ~25 parameters captured when a code set.\n\n    This is the evidence that separates a cold-start fault from a highway one,\n    and it is destroyed by a clear -- which is why the UI reads it before\n    offering one.\n    \"\"\"\n    wanted = code.strip().upper()\n    if name.strip():\n        try:\n            entries = [CATALOG.by_name(name)]\n        except MesError as exc:\n            raise NotFound(str(exc)) from exc\n    else:\n        entries = CATALOG.select(kind=\"fes\", vin=vin)\n\n    found: list[dict[str, Any]] = []\n    for entry in entries:\n        if entry.kind != \"fes\" or entry.parse_error:\n            continue\n        log = fes.load_fes(entry.path, timestamp=entry.timestamp)\n        for d in log.dtcs:\n            if wanted and wanted not in (d.full, d.code):\n                continue\n            if not d.freeze_frame:\n                continue\n            found.append({\n                \"dtc\": d.full,\n                \"description\": d.description,\n                \"status\": d.status.value,\n                \"status_meaning\": d.status.explanation,\n                \"file\": entry.name,\n                \"timestamp\": entry.timestamp,\n                \"ecu\": log.ecu_description,\n                \"vin\": log.vin,\n                \"freeze_frame\": {k: v.display\n                                 for k, v in d.freeze_frame.items()},\n            })\n    if not found:\n        raise NotFound(f\"no freeze frame for {code or '(any code)'}\")\n    return {\"count\": len(found), \"frames\": found}\n\n\ndef actuator_history(*, vin: str = \"\", operation: str = \"\") -> dict[str, Any]:\n    \"\"\"Every actuator test and adjustment ever run, and why any failed.\"\"\"\n    entries = CATALOG.select(kind=\"fes\", vin=vin)\n    runs: list[dict[str, Any]] = []\n    for entry in entries:\n        if entry.parse_error:\n            continue\n        log = fes.load_fes(entry.path, timestamp=entry.timestamp)\n        for a in log.actuators:\n            if operation.strip() and operation.lower() not in a.operation.lower():\n                continue\n            row = a.to_dict()\n            row.update({\"file\": entry.name, \"timestamp\": entry.timestamp,\n                        \"ecu\": log.ecu_description})\n            runs.append(row)\n    runs.sort(key=lambda r: r.get(\"timestamp\") or \"\", reverse=True)\n    failed = [r for r in runs if r.get(\"outcome\") == \"FAILED TO EXECUTE\"]\n    return {\n        \"count\": len(runs),\n        \"failed\": len(failed),\n        \"runs\": runs,\n        \"note\": (\"MES actuator tests on the IAW 10JA require key-on \"\n                 \"engine-off; 'Engine running' is an interlock, not a fault.\"),\n    }\n\n\n# --- sessions and scans ---------------------------------------------------\n\n\ndef analyze_session(*, name: str = \"\", vin: str = \"\") -> dict[str, Any]:\n    \"\"\"One FES engineering session: identity, DTCs, clears, actuators.\"\"\"\n    try:\n        entry = catalog.resolve_or_latest(name, kind=\"fes\", vin=vin)\n    except MesError as exc:\n        raise NotFound(str(exc)) from exc\n    log = fes.load_fes(entry.path, timestamp=entry.timestamp)\n    out = log.to_dict()\n    out[\"file\"] = entry.name\n    out[\"timestamp\"] = entry.timestamp\n    cleared = analysis.post_clear_assessment(log)\n    if cleared:\n        out[\"clear_assessment\"] = cleared.to_dict()\n    return out\n\n\ndef analyze_scan(*, name: str = \"\", vin: str = \"\") -> dict[str, Any]:\n    \"\"\"One all-systems SCAN: per-module status, with network-cascade detection.\"\"\"\n    try:\n        entry = catalog.resolve_or_latest(name, kind=\"scan\", vin=vin)\n    except MesError as exc:\n        raise NotFound(str(exc)) from exc\n    log = scan.load_scan(entry.path, timestamp=entry.timestamp)\n    out = log.to_dict()\n    out[\"file\"] = entry.name\n    out[\"timestamp\"] = entry.timestamp\n    by_module = {m.name: m.dtcs for m in log.modules if m.dtcs}\n    event = analysis.detect_network_event(by_module)\n    if event:\n        out[\"network_event\"] = event.to_dict()\n    out[\"provenance\"] = (\"unverifiable - SCAN logs carry no simulation marker\")\n    return out\n\n\ndef list_parameters(*, name: str = \"\", vin: str = \"\") -> dict[str, Any]:\n    \"\"\"Live parameters a FES session recorded, unioned across samples.\"\"\"\n    try:\n        entry = catalog.resolve_or_latest(name, kind=\"fes\", vin=vin)\n    except MesError as exc:\n        raise NotFound(str(exc)) from exc\n    log = fes.load_fes(entry.path, timestamp=entry.timestamp)\n    if not log.samples:\n        return {\"file\": entry.name, \"samples\": 0,\n                \"note\": \"this session logged no live parameters\"}\n    return {\n        \"file\": entry.name,\n        \"timestamp\": entry.timestamp,\n        \"ecu\": log.ecu_description,\n        \"samples\": len(log.samples),\n        \"parameter_count\": len(log.param_names()),\n        \"parameters\": log.param_names(),\n    }\n\n\ndef parameter_series(parameter: str, *, name: str = \"\",\n                     vin: str = \"\") -> dict[str, Any]:\n    \"\"\"One session parameter as an ordered series with statistics.\"\"\"\n    try:\n        entry = catalog.resolve_or_latest(name, kind=\"fes\", vin=vin)\n    except MesError as exc:\n        raise NotFound(str(exc)) from exc\n    log = fes.load_fes(entry.path, timestamp=entry.timestamp)\n    series = log.series(parameter)\n    if not series.samples:\n        raise NotFound(f\"'{parameter}' was not logged in {entry.name}\")\n    out = series.stats()\n    out[\"file\"] = entry.name\n    out[\"values\"] = [s.display for s in series.samples]\n    out[\"timing_note\"] = (\"MES records no per-sample timestamp; order is file \"\n                          \"order and the sample rate is unknown\")\n    if out.get(\"static\"):\n        out[\"interpretation\"] = (\n            \"This value never changed across the whole session -- consistent \"\n            \"with a substituted default or a modelled value rather than a \"\n            \"live measurement. Confirm before treating it as a reading.\")\n    return out\n\n\n# --- decision support -----------------------------------------------------\n\n\ndef fault_tree(codes: str = \"\", *, vin: str = \"\") -> dict[str, Any]:\n    \"\"\"Applicable isolation sequences, annotated with this car's evidence.\n\n    Returns successfully even when nothing matches: the payload then carries\n    the trees that *do* exist, which is the useful answer to \"is there a tree\n    for this?\".\n    \"\"\"\n    code_list = [c for c in re.split(r\"[,\\s;]+\", codes) if c.strip()]\n    if not code_list:\n        return {\n            \"error\": \"no codes given\",\n            \"available\": [{\"tree\": t.key, \"title\": t.title,\n                           \"applies_to\": sorted(t.codes)}\n                          for t in faulttree.TREES],\n        }\n    return faulttree.evaluate(code_list, vin=vin)\n\n\ndef assess_verdict(*, vin: str, codes: str, component: str, mechanism: str,\n                   measurements: str,\n                   disconfirming_test: str) -> dict[str, Any]:\n    \"\"\"The evidence gate.\n\n    The only non-read operation in the P1 surface, and it writes nothing to\n    the car -- it evaluates a proposed diagnosis against four criteria and\n    refuses CONFIRMED unless all of them hold.\n    \"\"\"\n    result = verdict.assess(vin=vin, codes=codes, component=component,\n                            mechanism=mechanism, measurements=measurements,\n                            disconfirming_test=disconfirming_test)\n    if \"error\" in result and \"verdict\" not in result:\n        raise BadRequest(result[\"error\"])\n    return result\n\n\ndef open_codes_for(dossier: dict[str, Any]) -> list[str]:\n    \"\"\"The codes a dossier should route to a fault tree.\n\n    Two sources, unioned:\n\n    * the newest session that held findings -- preferred over the newest\n      session outright, because the latter is often the empty post-clear\n      re-read and routing off it produces \"no codes\" on a car that plainly\n      has some;\n    * every chronic or returned-after-clear code in the car's history.\n\n    The second source matters more than it looks. On this Stelvio the newest\n    session shows a cleared ``P0440`` while the code that actually decides the\n    diagnosis is a chronic ``P0456`` spanning 26,500 km. Routing on the latest\n    session alone would send the tree after the wrong fault.\n    \"\"\"\n    codes: set[str] = set()\n\n    current = dossier.get(\"current_picture\", {})\n    for key in (\"last_session_with_findings\", \"latest_session\"):\n        session = current.get(key) or {}\n        found = [d.get(\"code\") or d.get(\"dtc\") or \"\"\n                 for d in session.get(\"dtcs\", [])]\n        found = [knowledge.base_code(c) for c in found if c]\n        if found:\n            codes.update(found)\n            break\n\n    history = dossier.get(\"history\", {})\n    for bucket in (\"chronic\", \"returned_after_clear\"):\n        for record in history.get(bucket, []):\n            raw = record.get(\"dtc\") or record.get(\"code\") or \"\"\n            if raw:\n                codes.add(knowledge.base_code(raw))\n\n    return sorted(codes)\n\n\n# --- dealer (wiTECH) results -----------------------------------------------\n\n\ndef dealer_record(vin: str, kind: str, data: dict[str, Any],\n                  note: str = \"\") -> dict[str, Any]:\n    \"\"\"Record one technician-entered wiTECH result. Raises BadRequest on\n    anything the store's per-kind validation rejects.\"\"\"\n    if not vin.strip():\n        raise BadRequest(\"a VIN is required\")\n    try:\n        return dealer_mod.record(vin, kind, data, note=note)\n    except ValueError as exc:\n        raise BadRequest(str(exc)) from exc\n\n\ndef dealer_results(vin: str) -> dict[str, Any]:\n    \"\"\"Every dealer result recorded for this VIN, oldest first.\"\"\"\n    if not vin.strip():\n        raise BadRequest(\"a VIN is required\")\n    return {\"vin\": vin, \"results\": dealer_mod.load(vin)}\n\n\n# --- technician notes -------------------------------------------------------\n\n\ndef add_note(vin: str, text: str, target_kind: str = \"vehicle\", target_id: str = \"\",\n            author: str = \"technician\", tags: Optional[list[str]] = None) -> dict[str, Any]:\n    \"\"\"Record one technician note. Raises BadRequest on invalid input.\"\"\"\n    if not vin.strip():\n        raise BadRequest(\"a VIN is required\")\n    try:\n        return notes_mod.add(vin, text, target_kind, target_id=target_id,\n                             author=author, tags=tags)\n    except ValueError as exc:\n        raise BadRequest(str(exc)) from exc\n\n\ndef notes(vin: str, target_kind: str = \"\", target_id: str = \"\") -> dict[str, Any]:\n    \"\"\"Notes for this VIN, oldest first, filtered by target when given.\"\"\"\n    if not vin.strip():\n        raise BadRequest(\"a VIN is required\")\n    return {\"vin\": vin,\n            \"notes\": notes_mod.load(vin, target_kind=target_kind or None,\n                                    target_id=target_id)}\n\n\ndef edit_note(id: str, text: str) -> dict[str, Any]:\n    \"\"\"Amend a note's text. Never rewrites history.\"\"\"\n    try:\n        return notes_mod.edit(id, text)\n    except ValueError as exc:\n        raise BadRequest(str(exc)) from exc\n\n\ndef hide_note(id: str) -> dict[str, Any]:\n    \"\"\"Hide a note (soft delete). Never rewrites history.\"\"\"\n    try:\n        return notes_mod.hide(id)\n    except ValueError as exc:\n        raise BadRequest(str(exc)) from exc\n\n\n# --- reference ------------------------------------------------------------\n\n\ndef module_registry(*, abbrev: str = \"\", domain: str = \"\") -> dict[str, Any]:\n    \"\"\"The 126-module registry: one module, one domain, or the whole map.\"\"\"\n    if abbrev.strip():\n        info = modules.describe(abbrev)\n        if \"error\" in info:\n            raise NotFound(info[\"error\"])\n        return info\n    grouped = modules.by_domain()\n    if domain.strip():\n        key = domain.strip().lower()\n        if key not in grouped:\n            raise NotFound(f\"unknown domain '{domain}'\")\n        return {\"domain\": key,\n                \"modules\": [m.to_dict() for m in grouped[key]]}\n    return {\n        \"stats\": modules.registry_stats(),\n        \"by_domain\": {d: [m.to_dict() for m in v]\n                      for d, v in sorted(grouped.items())},\n    }\n\n\ndef failure_type(byte: str) -> dict[str, Any]:\n    \"\"\"Decode the two hex digits after the dash in a UDS DTC.\"\"\"\n    ft = dtc_mod.failure_type(byte.strip())\n    if ft is None:\n        raise NotFound(f\"no failure type for '{byte}'\")\n    return ft.to_dict()\n\n\ndef describe_dtc(code: str, module: str = \"\") -> dict[str, Any]:\n    \"\"\"Look up a DTC's description in MES's own shipped language files.\n\n    Mirrors the ``dtc_description`` MCP tool call-for-call. This is a\n    fallback for a code no log gave text for, not a general database: MES's\n    ``English.dat``/``English.txt`` carry no DTC-code key at all (see\n    ``docs/format/MES_LANGUAGE_FILES.md``), so against the currently\n    installed files this raises :class:`NotFound` for virtually every real\n    code. The lookup itself is genuine and forward-compatible.\n    \"\"\"\n    if not code.strip():\n        raise BadRequest(\"a DTC code is required\")\n    result = dtc_text.describe(code, module.strip() or None)\n    if result is None:\n        raise NotFound(\n            f\"'{code}' has no entry in MES's shipped language files -- no \"\n            \"DTC-code key exists in the currently installed \"\n            \"English.dat/English.txt (docs/format/MES_LANGUAGE_FILES.md)\")\n    return result\n\n\n# --- CSV recordings -------------------------------------------------------\n\n\ndef list_recordings() -> dict[str, Any]:\n    \"\"\"CSV recordings from MES's graph subsystem, newest first.\"\"\"\n    recs = csvlog.list_recordings()\n    out: dict[str, Any] = {\n        \"count\": len(recs),\n        \"recordings\": recs,\n        \"roots\": [str(r) for r in paths.csv_roots()],\n    }\n    if not recs:\n        out[\"note\"] = (\n            \"No CSV recordings found. In MES: Graph tab, add parameters, then \"\n            \"CSV Start / Stop. The export lands in the Settings 'Export \"\n            \"Folder'. Point MES_CSV_DIR at it if it differs from the log \"\n            \"folder.\")\n    return out\n\n\ndef _recording(name: str):\n    try:\n        return csvlog.load_named(name)\n    except MesError as exc:\n        raise NotFound(str(exc)) from exc\n\n\ndef read_recording(name: str, *, preview_rows: int = 10) -> dict[str, Any]:\n    \"\"\"One recording: columns, measured timing, dropouts, TAG/DTC events.\"\"\"\n    return _recording(name).to_dict(preview_rows=preview_rows)\n\n\ndef recording_series(name: str, parameter: str) -> dict[str, Any]:\n    \"\"\"One recorded parameter as a *timed* series -- real timestamps, unlike\n    a .txt session, so the statistics are physically meaningful.\"\"\"\n    rec = _recording(name)\n    series = rec.series(parameter)\n    if not series.samples:\n        raise NotFound(f\"'{parameter}' is not a column in {rec.name}\")\n    out = series.stats()\n    out[\"file\"] = rec.name\n    out[\"values\"] = [{\"t\": stamp, \"value\": s.display}\n                     for stamp, s in zip(series.stamps, series.samples)]\n    if out.get(\"static\"):\n        out[\"interpretation\"] = (\n            \"This value never changed across the recording -- consistent with \"\n            \"a substituted default rather than a live measurement.\")\n    return out\n\n\ndef recording_events(name: str, *, condition: str = \"\") -> dict[str, Any]:\n    \"\"\"TAG/DTC events and dropouts; with a condition, excursion intervals.\"\"\"\n    rec = _recording(name)\n    out: dict[str, Any] = {\n        \"file\": rec.name,\n        \"timing\": rec.timing(),\n        \"tag_events\": [t.to_dict() for t in rec.tags],\n        \"dtcs_in_tags\": sorted({d for t in rec.tags for d in t.dtcs}),\n    }\n    if condition.strip():\n        try:\n            out[\"threshold\"] = rec.crossings(condition)\n        except MesError as exc:\n            raise BadRequest(str(exc)) from exc\n    return out\n\n\ndef recording_snapshot(name: str, at_seconds: float) -> dict[str, Any]:\n    \"\"\"The post-hoc freeze frame: every value at the sample nearest a time.\"\"\"\n    rec = _recording(name)\n    return {\"file\": rec.name, **rec.snapshot(at_seconds)}\n","numLines":700,"startLine":1,"totalLines":700}},"sourceToolAssistantUUID":"0433a030-0e22-49bd-8769-bc43bcb90dbb","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
