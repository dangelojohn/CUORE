n56:def _error(exc: Exception) -> str:\n60:def _guard(fn, *args, serialize=_json, **kwargs) -> str:\n72:@mcp.tool()\n73:def status() -> str:\n82:@mcp.tool()\n83:def list_logs(kind: str = \"\", vehicle: str = \"\", vin: str = \"\",\n114:@mcp.tool()\n115:def latest_log(kind: str = \"\", vehicle: str = \"\", vin: str = \"\") -> str:\n125:@mcp.tool()\n126:def vehicles() -> str:\n140:@mcp.tool()\n141:def read_log(name: str, max_bytes: int = 200_000) -> str:\n176:@mcp.tool()\n177:def search_logs(pattern: str, kind: str = \"\", vehicle: str = \"\", vin: str = \"\",\n222:@mcp.tool()\n223:def analyze_scan(name: str = \"\", vin: str = \"\", detail: bool = False) -> str:\n255:@mcp.tool()\n256:def analyze_session(name: str = \"\", vin: str = \"\",\n284:@mcp.tool()\n285:def get_freeze_frame(code: str = \"\", name: str = \"\", vin: str = \"\") -> str:\n331:@mcp.tool()\n332:def extract_dtcs(vin: str = \"\", vehicle: str = \"\", since: str = \"\",\n358:@mcp.tool()\n359:def dtc_history(code: str, vin: str = \"\") -> str:\n376:@mcp.tool()\n377:def list_parameters(name: str = \"\", vin: str = \"\") -> str:\n401:@mcp.tool()\n402:def parameter_series(parameter: str, name: str = \"\", vin: str = \"\") -> str:\n439:@mcp.tool()\n440:def module_info(abbrev: str = \"\", domain: str = \"\") -> str:\n466:@mcp.tool()\n467:def failure_type(byte: str) -> str:\n482:@mcp.tool()\n483:def dtc_description(code: str, module: str = \"\") -> str:\n515:@mcp.tool()\n516:def experience_links(code: str = \"\", family: str = \"\", job: str = \"\") -> str:\n548:@mcp.tool()\n549:def actuator_history(vin: str = \"\", operation: str = \"\") -> str:\n582:@mcp.tool()\n583:def vehicle_report(vin: str = \"\", vehicle: str = \"\") -> str:\n593:@mcp.tool()\n594:def workup(vin: str = \"\", vehicle: str = \"\", name: str = \"\", detail: bool = False) -> str:\n625:@mcp.tool()\n626:def fault_tree(codes: str = \"\", vin: str = \"\") -> str:\n652:@mcp.tool()\n653:def diagnosis_verdict(vin: str, codes: str, component: str = \"\",\n685:@mcp.tool()\n686:def record_dealer_result(vin: str, kind: str, data_json: str, note: str = \"\") -> str:\n712:@mcp.tool()\n713:def dealer_results(vin: str) -> str:\n721:@mcp.tool()\n722:def add_note(vin: str, text: str, target_kind: str = \"vehicle\", target_id: str = \"\",\n746:@mcp.tool()\n747:def notes(vin: str, target_kind: str = \"\", target_id: str = \"\") -> str:\n755:@mcp.tool()\n756:def edit_note(id: str, text: str) -> str:\n761:@mcp.tool()\n762:def hide_note(id: str) -> str:\n770:@mcp.tool()\n771:def feedback_list(vin: str, status: str = \"\") -> str:\n778:@mcp.tool()\n779:def feedback_add(vin: str, kind: str, page: str, label: str, section: str = \"\",\n800:@mcp.tool()\n801:def feedback_answer(id: str, text: str, by: str = \"claude\") -> str:\n806:@mcp.tool()\n807:def feedback_status(id: str, status: str, note: str = \"\") -> str:\n816:@mcp.tool()\n817:def add_symptom(vin: str, at: str, reporter: str = \"driver\", tags: str = \"\",\n844:@mcp.tool()\n845:def symptoms(vin: str = \"\", include_hidden: bool = False) -> str:\n851:@mcp.tool()\n852:def hide_symptom(id: str) -> str:\n857:@mcp.tool()\n858:def dtc_feel(code: str) -> str:\n866:@mcp.tool()\n867:def systems_for_code(code: str, description: str = \"\") -> str:\n879:@mcp.tool()\n880:def system_correlation(vin: str) -> str:\n894:@mcp.tool()\n895:def list_recordings() -> str:\n919:@mcp.tool()\n920:def read_recording(name: str, preview_rows: int = 10) -> str:\n931:@mcp.tool()\n932:def recording_series(name: str, parameter: str) -> str:\n959:@mcp.tool()\n960:def recording_events(name: str, condition: str = \"\") -> str:\n983:@mcp.tool()\n984:def recording_snapshot(name: str, at_seconds: float) -> str:\n997:@mcp.tool()\n998:def log_dir() -> str:\n1010:@mcp.tool()\n1011:def part_info(key: str = \"\", code: str = \"\", job: str = \"\") -> str:\n1035:@mcp.tool()\n1036:def electrical_path(code: str) -> str:\n1052:@mcp.tool()\n1053:def physical_path(code: str) -> str:\n1070:@mcp.tool()\n1071:def electrical_inspection_add(vin: str, element: str, condition: str,\n1090:@mcp.tool()\n1091:def electrical_inspections(vin: str, element: str = \"\") -> str:\n1109:def vehicle_index() -> str:\n1119:def vehicle_dossier(vin: str) -> str:","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"serverClassifierContext":{"request":"9a011fec-019e-44bc-ada9-8019648964f2","context":{"git_state":{"cwd":"/c/Users/User/mcp-servers","root":null,"branch":null,"default_branch":null,"status":null,"visibility":null,"error":"pending"},"live_cwd":"/c/Users/User/mcp-servers","platform":"windows"}},"sourceToolAssistantUUID":"064e8186-9ba4-49ce-b712-c1d97e4753a5","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
