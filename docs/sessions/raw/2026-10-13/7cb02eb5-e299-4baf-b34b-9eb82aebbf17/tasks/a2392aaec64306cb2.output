{"parentUuid":"ec1750d0-674d-4722-af38-e48416ed37b7","isSidechain":true,"agentId":"a2392aaec64306cb2","message":{"model":"claude-sonnet-5","id":"msg_011Cfp2YcjcXU1jejSSh3Wmi","type":"message","role":"assistant","content":[{"type":"thinking","thinking":"","signature":""}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":5303,"cache_read_input_tokens":57422,"cache_creation":{"ephemeral_5m_input_tokens":5303,"ephemeral_1h_input_tokens":0},"output_tokens":4,"service_tier":"standard","inference_geo":"not_available"},"input_transformations":[],"diagnostics":null,"context_management":null},"serverClassifierRequest":"9b304114-d192-463f-acbb-5e3a0377cdef","apiBlockIndex":0,"requestId":"req_011Cfp2YcUyNmgnowe684qs5","attributionAgent":"general-purpose","type":"assistant","uuid":"e2bd7e98-9068-4bdb-9ab8-d7e4ef8ebbb0","timestamp":"2026-10-08T03:03:38.945Z","effort":"high","perTurnEffort":null,"userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
{"parentUuid":"e2bd7e98-9068-4bdb-9ab8-d7e4ef8ebbb0","isSidechain":true,"agentId":"a2392aaec64306cb2","message":{"model":"claude-sonnet-5","id":"msg_011Cfp2YcjcXU1jejSSh3Wmi","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01MJP7X1u2WiSAJq9yWcJqCv","name":"Read","input":{"file_path":"C:\\Users\\User\\mcp-servers\\cuore\\services\\dossier_bridge.py"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":5303,"cache_read_input_tokens":57422,"cache_creation":{"ephemeral_5m_input_tokens":5303,"ephemeral_1h_input_tokens":0},"output_tokens":4,"service_tier":"standard","inference_geo":"not_available"},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_01MJP7X1u2WiSAJq9yWcJqCv":{"file_path":"C:\\Users\\User\\mcp-servers\\cuore\\services\\dossier_bridge.py"}},"serverClassifierRequest":"9b304114-d192-463f-acbb-5e3a0377cdef","apiBlockIndex":1,"requestId":"req_011Cfp2YcUyNmgnowe684qs5","attributionAgent":"general-purpose","type":"assistant","uuid":"94edba1e-361a-49f0-9ab8-289fda71245a","timestamp":"2026-10-08T03:03:39.610Z","effort":"high","perTurnEffort":null,"userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
{"parentUuid":"94edba1e-361a-49f0-9ab8-289fda71245a","isSidechain":true,"promptId":"1c9ea3c5-87b7-461e-9caf-e82d18dc2677","agentId":"a2392aaec64306cb2","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01MJP7X1u2WiSAJq9yWcJqCv","type":"tool_result","content":"1\t\"\"\"Turns the raw workup dossier into the redesigned dossier page's contract.\n2\t\n3\tMECHANIC_UX_REVIEW.md's R1/R4/R5/R6/R7/R8/R9 all boil down to the same\n4\tcomplaint: the knowledge in ``mes.workup`` is already senior-technician-grade\n5\t(family findings, chronic/returned classification, TSB cross-reference) but\n6\tthe page made the mechanic excavate it from prose and raw dicts. Nothing here\n7\tre-derives that knowledge -- it only reshapes what ``mes_bridge.workup``\n8\talready returns (plus what the live link has observed) into the verdict,\n9\tchecklists, code table, freeze-frame flags, deduplicated bulletins and\n10\trunnable blind-spot actions the template needs, so there is exactly one\n11\tplace that decides what a status chip or a checklist step means.\n12\t\n13\t``build_view`` is the only entry point. Everything else is a private helper.\n14\t\n15\tLike every other file under ``cuore/services``, this is a *_bridge.py module,\n16\tso it is allowed to import ``mes_bridge`` (never the ``mes`` package itself --\n17\tnothing here needs to; the workup dict already carries what ``mes`` computed)\n18\tand the small read-only ``cuore.live`` surfaces (``store`` for live\n19\tobservations, ``checklists`` for shop-ticked steps).\n20\t\"\"\"\n21\t\n22\tfrom __future__ import annotations\n23\t\n24\timport re\n25\tfrom datetime import datetime\n26\tfrom typing import Any\n27\t\n28\tfrom . import mes_bridge\n29\tfrom .errors import BridgeError\n30\tfrom ..live import checklists as checklist_store\n31\tfrom ..live import store as live_store\n32\t\n33\t#: EVAP monitor runs at 15-85% fuel; cited wherever a freeze frame needs\n34\t#: flagging. Matches the window ``mes`` itself states in verdict/fault-tree\n35\t#: text -- not re-derived, just applied to one more surface.\n36\t_EVAP_FUEL_WINDOW = (15.0, 85.0)\n37\t_EVAP_CODES = {\"P0440\", \"P0441\", \"P0455\", \"P0456\", \"P1CEA\"}\n38\t\n39\t_SYSTEM_BY_LETTER = {\"P\": \"engine\", \"C\": \"chassis\", \"B\": \"body\", \"U\": \"network\"}\n40\t\n41\t_STATUS_LABEL = {\"ACTIVE\": \"Active\", \"CLEARED_UNVERIFIED\": \"Cleared, unverified\",\n42\t                \"STALE\": \"Stale\"}\n43\t\n44\t#: Freeze-frame parameters worth a mechanic's first glance, in the order\n45\t#: they should appear. Everything else still rides along in ``all``.\n46\t_KEY_FRAME_PARAMS = [\"Fuel level\", \"Engine temperature\", \"Odometer\",\n47\t                     \"Vehicle speed\", \"Engine speed\", \"Air temperature\"]\n48\t\n49\t#: One checklist per family this corpus's fault trees and TSBs recognise\n50\t#: today. Transcribed once, here, from the family finding's own \"reading\"\n51\t#: text and the EVAP/network fault trees -- see MECHANIC_UX_REVIEW.md R4.\n52\t#: Keeping this as a table (not free-text parsing of ``reading``) is what\n53\t#: makes checklist step ids stable across a wording change in ``mes``.\n54\tFAMILY_STEPS: dict[str, list[dict[str, Any]]] = {\n55\t    \"EVAP\": [\n56\t        {\"id\": \"evap-1\", \"text\": \"Inspect the recirculation-line quick-connect\",\n57\t         \"ref\": \"S2125000002\"},\n58\t        {\"id\": \"evap-2\", \"text\": \"Run the purge/vent valve KOEO actuator test\",\n59\t         \"ref\": None},\n60\t        {\"id\": \"evap-3\", \"text\": \"Check hose routing\", \"ref\": \"9100325\"},\n61\t        {\"id\": \"evap-4\", \"text\": \"Inspect the canister/ESIM\", \"ref\": \"9100471\"},\n62\t        {\"id\": \"evap-5\", \"text\": \"Run a smoke test to localise the leak\",\n63\t         \"ref\": None},\n64\t        {\"id\": \"evap-6\", \"text\": \"Verify with SLVT or Mode $06\",\n65\t         \"ref\": \"18-048-23\"},\n66\t    ],\n67\t    \"network\": [\n68\t        {\"id\": \"network-1\", \"text\": \"Check the supply: F82 fuse and BCM feeds\",\n69\t         \"ref\": \"S1808000005\"},\n70\t        {\"id\": \"network-2\",\n71\t         \"text\": \"Inspect connectors/grounds: XY201, G003A/B\",\n72\t         \"ref\": \"S2008000032\"},\n73\t        {\"id\": \"network-3\",\n74\t         \"text\": \"Inspect connector terminals for spread/backed-out pins\",\n75\t         \"ref\": \"S1708000262\"},\n76\t    ],\n77\t}\n78\t\n79\t_FAMILY_TITLES = {\n80\t    \"EVAP\": \"EVAP: one system fault\",\n81\t    \"network\": \"Network: one power/bus event, not {n} separate faults\",\n82\t}\n83\t\n84\t\n85\t# --- small shared helpers --------------------------------------------------\n86\t\n87\t\n88\tdef _base(code: str) -> str:\n89\t    \"\"\"\"P0440-00\" -> \"P0440\". Same rule as ``mes.knowledge.base_code``,\n90\t    reimplemented here rather than imported so this module never touches the\n91\t    ``mes`` package directly.\"\"\"\n92\t    code = (code or \"\").strip().upper()\n93\t    return code.split(\"-\", 1)[0] if \"-\" in code else code\n94\t\n95\t\n96\tdef _slug(text: str) -> str:\n97\t    return re.sub(r\"[^A-Za-z0-9]+\", \"-\", (text or \"\").strip()).strip(\"-\")\n98\t\n99\t\n100\tdef _parse_ts(ts: str | None) -> datetime | None:\n101\t    if not ts:\n102\t        return None\n103\t    try:\n104\t        return datetime.strptime(str(ts)[:19], \"%Y-%m-%d %H:%M:%S\")\n105\t    except ValueError:\n106\t        return None\n107\t\n108\t\n109\tdef _short_date(ts: str | None, with_time: bool = False) -> str | None:\n110\t    dt = _parse_ts(ts)\n111\t    if dt is None:\n112\t        return None\n113\t    fmt = \"%d %b %H:%M\" if with_time else \"%d %b\"\n114\t    if dt.year != datetime.now().year:\n115\t        fmt += \" '%y\"\n116\t    return dt.strftime(fmt)\n117\t\n118\t\n119\tdef _num(display: Any) -> float | None:\n120\t    \"\"\"Pull the leading number out of a display string like \"93.73 %\".\"\"\"\n121\t    if display is None:\n122\t        return None\n123\t    m = re.match(r\"\\s*(-?\\d+(?:\\.\\d+)?)\", str(display))\n124\t    return float(m.group(1)) if m else None\n125\t\n126\t\n127\tdef live_available(live_status: dict[str, Any] | None) -> bool:\n128\t    \"\"\"Is the adapter reachable right now -- a port configured, and neither\n129\t    MultiEcuScan nor another process holding it.\n130\t\n131\t    Same read ``base.html``'s live strip and ``/live`` already make of\n132\t    ``live_ops.status()``: ``mes_state == \"connected\"`` means MES has the\n133\t    port, and a ``lock_holder`` other than this process means something else\n134\t    does. Used both to grey out the dossier's own action buttons and by\n135\t    ``/v/{vin}/verify`` to decide whether it is safe to actually read.\n136\t    \"\"\"\n137\t    if not live_status or live_status.get(\"error\"):\n138\t        return False\n139\t    if not live_status.get(\"port\"):\n140\t        return False\n141\t    if live_status.get(\"mes_state\") == \"connected\":\n142\t        return False\n143\t    holder = live_status.get(\"lock_holder\")\n144\t    if holder and holder != \"cuore\":\n145\t        return False\n146\t    return True\n147\t\n148\t\n149\t# --- the last clear ---------------------------------------------------------\n150\t\n151\t\n152\tdef _clear_info(dossier: dict[str, Any]\n153\t                ) -> tuple[str | None, str | None, dict[str, Any] | None]:\n154\t    \"\"\"(cleared_at full timestamp, cleared_by file, the clear_assessment dict).\n155\t\n156\t    ``current_picture.clear_assessment`` comes from two different shapes in\n157\t    ``mes.workup``: a scan-based clear carries its own ``cleared_at``/\n158\t    ``source``; a clear inside the anchored FES session itself carries\n159\t    neither, because *that session* is the clear -- so its timestamp/file are\n160\t    read off ``latest_session`` instead.\n161\t    \"\"\"\n162\t    cp = dossier.get(\"current_picture\") or {}\n163\t    ca = cp.get(\"clear_assessment\")\n164\t    if not ca:\n165\t        return None, None, None\n166\t    cleared_at = ca.get(\"cleared_at\")\n167\t    cleared_by = ca.get(\"source\")\n168\t    if not cleared_at:\n169\t        latest = cp.get(\"latest_session\") or {}\n170\t        cleared_at = latest.get(\"timestamp\")\n171\t        cleared_by = latest.get(\"file\")\n172\t    return cleared_at, cleared_by, ca\n173\t\n174\t\n175\t# --- readiness, read from the car -------------------------------------------\n176\t\n177\t\n178\tdef _latest_readiness(vin: str, after: str | None) -> dict[str, Any] | None:\n179\t    \"\"\"The newest readiness observation from the car itself, after ``after``.\n180\t\n181\t    A read taken before the clear says nothing about the car now -- the same\n182\t    reasoning ``mes.verdict._last_clear`` already applies to live DTC reads.\n183\t    \"\"\"\n184\t    try:\n185\t        obs = live_store.recent_observations(200, vin=vin, kind=\"readiness\")\n186\t    except Exception:  # noqa: BLE001 -- a broken store must never break the verdict\n187\t        return None\n188\t    best = None\n189\t    for o in obs:\n190\t        if not live_store.is_from_car(o):\n191\t            continue\n192\t        at = o.get(\"at\") or \"\"\n193\t        if after and at <= after:\n194\t            continue\n195\t        if best is None or at > (best.get(\"at\") or \"\"):\n196\t            best = o\n197\t    return best\n198\t\n199\t\n200\tdef readiness_result(raw: dict[str, Any]) -> dict[str, Any]:\n201\t    \"\"\"Shape a live ``ops.obd_readiness()`` read for ``/v/{vin}/verify``.\n202\t\n203\t    ``verify.html`` destructures ``result.at`` / ``result.evap_monitor`` /\n204\t    ``result.all_complete`` / ``result.monitors`` explicitly (never the raw\n205\t    dict) -- this is the one place that produces that flat shape from the\n206\t    nested ``since_clear``/``monitors`` payload ``ops.obd_readiness``\n207\t    returns, so the page and the verdict's own ``readiness`` sub-object\n208\t    agree on what \"the EVAP monitor is complete\" means.\n209\t    \"\"\"\n210\t    since = raw.get(\"since_clear\") or {}\n211\t    monitors = since.get(\"monitors\") or []\n212\t    evap = next((m for m in monitors if m.get(\"monitor\") == \"Evaporative system\"), None)\n213\t    return {\n214\t        \"at\": datetime.now().isoformat(timespec=\"seconds\"),\n215\t        \"evap_monitor\": bool(evap and evap.get(\"complete\")),\n216\t        \"all_complete\": bool(since.get(\"all_complete\")),\n217\t        \"monitors\": [{\"name\": m.get(\"monitor\"), \"complete\": bool(m.get(\"complete\"))}\n218\t                     for m in monitors],\n219\t    }\n220\t\n221\t\n222\tdef _evap_from_readiness(obs: dict[str, Any] | None) -> dict[str, Any] | None:\n223\t    if obs is None:\n224\t        return None\n225\t    data = obs.get(\"data\") or {}\n226\t    since = data.get(\"since_clear\") or {}\n227\t    monitors = since.get(\"monitors\") or []\n228\t    evap = next((m for m in monitors if m.get(\"monitor\") == \"Evaporative system\"), None)\n229\t    if not monitors:\n230\t        state = None\n231\t    elif evap is None:\n232\t        state = \"not_supported\"\n233\t    else:\n234\t        state = \"complete\" if evap.get(\"complete\") else \"incomplete\"\n235\t    return {\"at\": obs.get(\"at\"), \"evap_monitor\": state,\n236\t            \"all_complete\": bool(since.get(\"all_complete\"))}\n237\t\n238\t\n239\t# --- verdict -----------------------------------------------------------------\n240\t\n241\t\n242\tdef _verdict_actions(vin: str, enabled: bool) -> list[dict[str, Any]]:\n243\t    hint = \"\" if enabled else \"connect the car (ELM327 on COM3)\"\n244\t    return [\n245\t        {\"label\": \"Verify repair\", \"kind\": \"readiness\", \"href\": f\"/v/{vin}/verify\",\n246\t         \"enabled\": enabled, \"hint\": hint},\n247\t        {\"label\": \"EVAP fault tree\", \"kind\": \"link\", \"href\": f\"/v/{vin}/tree\",\n248\t         \"enabled\": True, \"hint\": \"\"},\n249\t        {\"label\": \"Evidence gate\", \"kind\": \"link\", \"href\": f\"/v/{vin}/gate\",\n250\t         \"enabled\": True, \"hint\": \"\"},\n251\t    ]\n252\t\n253\t\n254\tdef _verdict_summary(state: str, open_work: list[dict[str, Any]],\n255\t                     cleared_at: str | None, dossier: dict[str, Any]) -> str:\n256\t    if open_work:\n257\t        codes = open_work[0][\"codes\"][:3]\n258\t    else:\n259\t        chronic = (dossier.get(\"history\") or {}).get(\"chronic\") or []\n260\t        codes = sorted({_base(r.get(\"dtc\", \"\")) for r in chronic})[:3]\n261\t    code_str = \"/\".join(codes) if codes else \"the logged codes\"\n262\t    cleared_short = _short_date(cleared_at) if cleared_at else None\n263\t\n264\t    if state == \"NO_DATA\":\n265\t        return \"No MES logs on file for this vehicle.\"\n266\t    if state == \"ACTIVE_FAULTS\":\n267\t        return f\"{code_str} active now -- not cleared, not resolved.\"\n268\t    if state == \"VERIFIED_CLEAN\":\n269\t        return f\"{code_str} cleared {cleared_short}; EVAP monitor ran clean. Repair verified.\"\n270\t    return f\"{code_str} cleared {cleared_short}; monitors have not re-run. Not proof of repair.\"\n271\t\n272\t\n273\tdef _build_verdict(vin: str, dossier: dict[str, Any], live_status: dict[str, Any] | None,\n274\t                   open_work: list[dict[str, Any]]) -> dict[str, Any]:\n275\t    identity = dossier.get(\"identity\") or {}\n276\t    enabled = live_available(live_status)\n277\t\n278\t    if not identity.get(\"log_count\"):\n279\t        return {\"state\": \"NO_DATA\", \"label\": \"No data\",\n280\t                \"summary\": \"No MES logs on file for this vehicle.\",\n281\t                \"basis\": [\"no logs matched this VIN\"],\n282\t                \"cleared_at\": None, \"cleared_by\": None, \"readiness\": None,\n283\t                \"actions\": _verdict_actions(vin, enabled)}\n284\t\n285\t    cp = dossier.get(\"current_picture\") or {}\n286\t    history = dossier.get(\"history\") or {}\n287\t    cleared_at, cleared_by, clear_assessment = _clear_info(dossier)\n288\t\n289\t    basis: list[str] = []\n290\t    active = False\n291\t\n292\t    latest_session = cp.get(\"latest_session\") or {}\n293\t    if (cleared_at and latest_session.get(\"timestamp\")\n294\t            and latest_session.get(\"timestamp\") > cleared_at\n295\t            and latest_session.get(\"dtcs\")):\n296\t        active = True\n297\t        basis.append(f\"newest session ({latest_session['timestamp']}) holds DTCs \"\n298\t                     f\"after the {cleared_at} clear\")\n299\t\n300\t    latest_scan = cp.get(\"latest_scan\") or {}\n301\t    if (cleared_at and latest_scan.get(\"timestamp\")\n302\t            and latest_scan.get(\"timestamp\") > cleared_at\n303\t            and latest_scan.get(\"modules_with_faults\")):\n304\t        active = True\n305\t        basis.append(f\"newest scan ({latest_scan['timestamp']}) holds DTCs \"\n306\t                     f\"after the {cleared_at} clear\")\n307\t\n308\t    returned_in_session = (clear_assessment or {}).get(\"codes_returned_in_session\") or []\n309\t    if returned_in_session:\n310\t        active = True\n311\t        basis.append(\"codes returned in the clearing session: \"\n312\t                     + \", \".join(returned_in_session))\n313\t\n314\t    uncleared = (clear_assessment or {}).get(\"codes_that_would_not_clear\") or []\n315\t    if uncleared:\n316\t        active = True\n317\t        basis.append(\"codes would not clear: \" + \", \".join(uncleared))\n318\t\n319\t    if history.get(\"returned_after_clear\"):\n320\t        active = True\n321\t        basis.append(\"returned after a clear: \" + \", \".join(\n322\t            sorted(_base(r.get(\"dtc\", \"\")) for r in history[\"returned_after_clear\"])))\n323\t\n324\t    readiness = None\n325\t    if cleared_at:\n326\t        readiness = _evap_from_readiness(_latest_readiness(vin, cleared_at))\n327\t\n328\t    if active:\n329\t        state, label = \"ACTIVE_FAULTS\", \"Active faults\"\n330\t    elif cleared_at is None:\n331\t        if history.get(\"chronic\"):\n332\t            state, label = \"ACTIVE_FAULTS\", \"Active faults\"\n333\t            basis.append(\"chronic codes on file and no clear recorded\")\n334\t        else:\n335\t            state, label = \"NO_DATA\", \"No data\"\n336\t            basis.append(\"no open codes and no clear on file\")\n337\t    elif readiness and readiness.get(\"evap_monitor\") == \"complete\":\n338\t        state, label = \"VERIFIED_CLEAN\", \"Verified clean\"\n339\t        basis.append(f\"EVAP monitor complete on a live read at {readiness['at']}, \"\n340\t                     f\"no code has returned since the {cleared_at} clear\")\n341\t    else:\n342\t        state, label = \"UNVERIFIED_REPAIR\", \"Unverified repair\"\n343\t        basis.append(f\"last clear {cleared_at} ({cleared_by or 'unknown source'}); \"\n344\t                     f\"no code has returned\")\n345\t        if readiness is None:\n346\t            basis.append(\"no readiness read from the car since the clear\")\n347\t        else:\n348\t            basis.append(f\"readiness read at {readiness['at']} -- EVAP monitor \"\n349\t                         f\"{readiness.get('evap_monitor') or 'unknown'}\")\n350\t\n351\t    return {\n352\t        \"state\": state, \"label\": label,\n353\t        \"summary\": _verdict_summary(state, open_work, cleared_at, dossier),\n354\t        \"basis\": basis,\n355\t        \"cleared_at\": cleared_at.split(\" \")[0] if cleared_at else None,\n356\t        \"cleared_by\": cleared_by,\n357\t        \"readiness\": readiness,\n358\t        \"actions\": _verdict_actions(vin, enabled),\n359\t    }\n360\t\n361\t\n362\t# --- open work (family findings as a checklist) -----------------------------\n363\t\n364\t\n365\tdef _family_refs(codes: list[str], per_code: dict[str, Any],\n366\t                 reading: str) -> list[dict[str, Any]]:\n367\t    seen: dict[str, dict[str, Any]] = {}\n368\t    for code in codes:\n369\t        for b in per_code.get(code, []):\n370\t            num = b.get(\"bulletin\")\n371\t            if num and num not in seen:\n372\t                seen[num] = {\"label\": num, \"href\": f\"#tsb-{_slug(num)}\"}\n373\t    for doc in re.findall(r\"docs/\\S+?\\.md\", reading or \"\"):\n374\t        if doc not in seen:\n375\t            seen[doc] = {\"label\": doc, \"href\": None}\n376\t    return list(seen.values())\n377\t\n378\t\n379\tdef _build_open_work(vin: str, dossier: dict[str, Any],\n380\t                     checklist: dict[str, Any]) -> list[dict[str, Any]]:\n381\t    tsb = dossier.get(\"tsb_matches\") or {}\n382\t    findings = tsb.get(\"family_findings\") or []\n383\t    per_code = tsb.get(\"per_code\") or {}\n384\t    cards = []\n385\t    for f in findings:\n386\t        family = f.get(\"family\") or \"\"\n387\t        steps_def = FAMILY_STEPS.get(family)\n388\t        if not steps_def:\n389\t            continue  # no checklist table for this family yet\n390\t        codes = [c.upper() for c in (f.get(\"codes\") or [])]\n391\t        steps = []\n392\t        done = 0\n393\t        for s in steps_def:\n394\t            st = checklist.get(s[\"id\"]) or {}\n395\t            is_done = bool(st.get(\"done\"))\n396\t            done += int(is_done)\n397\t            steps.append({\n398\t                \"id\": s[\"id\"], \"text\": s[\"text\"], \"ref\": s[\"ref\"],\n399\t                \"ref_href\": f\"#tsb-{_slug(s['ref'])}\" if s[\"ref\"] else None,\n400\t                \"done\": is_done, \"done_at\": st.get(\"done_at\"),\n401\t                \"done_by\": st.get(\"done_by\"),\n402\t            })\n403\t        title = _FAMILY_TITLES.get(family, f\"{family}: one system fault\")\n404\t        if \"{n}\" in title:\n405\t            title = title.format(n=len(codes))\n406\t        cards.append({\n407\t            \"family\": family, \"title\": title, \"codes\": codes, \"steps\": steps,\n408\t            \"refs\": _family_refs(codes, per_code, f.get(\"reading\", \"\")),\n409\t            \"progress\": {\"done\": done, \"total\": len(steps_def)},\n410\t        })\n411\t    return cards\n412\t\n413\t\n414\tdef _family_map(dossier: dict[str, Any]) -> dict[str, str]:\n415\t    out: dict[str, str] = {}\n416\t    for f in (dossier.get(\"tsb_matches\") or {}).get(\"family_findings\", []):\n417\t        for c in f.get(\"codes\", []):\n418\t            out[c.upper()] = f.get(\"family\")\n419\t    return out\n420\t\n421\t\n422\t# --- the code table -----------------------------------------------------------\n423\t\n424\t\n425\tdef _code_status(base: str, last_seen: str | None, cleared_at: str | None,\n426\t                 codes_cleared: set[str], codes_returned: set[str],\n427\t                 codes_uncleared: set[str], last_findings: set[str],\n428\t                 last_findings_ts: str | None, recent_ts: list[str]) -> str:\n429\t    if base in codes_returned or base in codes_uncleared:\n430\t        return \"ACTIVE\"\n431\t    if cleared_at and last_seen and last_seen > cleared_at:\n432\t        return \"ACTIVE\"\n433\t    if base in last_findings and not (cleared_at and last_findings_ts\n434\t                                      and cleared_at >= last_findings_ts):\n435\t        return \"ACTIVE\"\n436\t    if cleared_at and base in codes_cleared and (not last_seen or last_seen <= cleared_at):\n437\t        return \"CLEARED_UNVERIFIED\"\n438\t    if cleared_at is None and last_seen and last_seen in recent_ts[:3]:\n439\t        return \"ACTIVE\"\n440\t    return \"STALE\"\n441\t\n442\t\n443\tdef _code_rows(vin: str, dossier: dict[str, Any], cleared_at: str | None,\n444\t              clear_assessment: dict[str, Any] | None, recent_ts: list[str],\n445\t              family_map: dict[str, str]\n446\t              ) -> tuple[list[dict[str, Any]], dict[str, int]]:\n447\t    history = dossier.get(\"history\") or {}\n448\t    cp = dossier.get(\"current_picture\") or {}\n449\t    last_findings_session = cp.get(\"last_session_with_findings\") or {}\n450\t    last_findings = {_base(d.get(\"code\") or d.get(\"dtc\") or \"\")\n451\t                     for d in last_findings_session.get(\"dtcs\", [])}\n452\t    last_findings_ts = last_findings_session.get(\"timestamp\")\n453\t\n454\t    codes_cleared = {_base(c) for c in (clear_assessment or {}).get(\"codes_cleared\", [])}\n455\t    codes_returned = {_base(c) for c in\n456\t                      (clear_assessment or {}).get(\"codes_returned_in_session\", [])}\n457\t    codes_uncleared = {_base(c) for c in\n458\t                       (clear_assessment or {}).get(\"codes_that_would_not_clear\", [])}\n459\t\n460\t    rows: list[dict[str, Any]] = []\n461\t    for bucket in (\"chronic\", \"returned_after_clear\", \"seen_once\"):\n462\t        for rec in history.get(bucket, []):\n463\t            full = rec.get(\"dtc\", \"\")\n464\t            base = _base(full)\n465\t            last_seen = rec.get(\"last_seen\")\n466\t            status = _code_status(base, last_seen, cleared_at, codes_cleared,\n467\t                                  codes_returned, codes_uncleared, last_findings,\n468\t                                  last_findings_ts, recent_ts)\n469\t            distance = rec.get(\"distance_span_km\")\n470\t            rows.append({\n471\t                \"code\": base, \"dtc\": full,\n472\t                \"description\": (rec.get(\"descriptions\") or [\"\"])[0],\n473\t                \"system\": _SYSTEM_BY_LETTER.get(base[:1], base[:1] if base else None),\n474\t                \"bucket\": bucket,\n475\t                \"status\": status, \"status_label\": _STATUS_LABEL[status],\n476\t                \"sessions\": rec.get(\"sessions\"),\n477\t                \"last_seen_short\": _short_date(last_seen),\n478\t                \"last_seen\": last_seen, \"first_seen\": rec.get(\"first_seen\"),\n479\t                \"distance_km\": round(distance) if distance is not None else None,\n480\t                \"href\": f\"/v/{vin}/code/{base}\",\n481\t                \"family\": family_map.get(base),\n482\t            })\n483\t\n484\t    counts = {\"chronic\": 0, \"seen_once\": 0, \"returned_after_clear\": 0,\n485\t             \"active\": 0, \"stale\": 0}\n486\t    for r in rows:\n487\t        counts[r[\"bucket\"]] = counts.get(r[\"bucket\"], 0) + 1\n488\t        if r[\"status\"] == \"ACTIVE\":\n489\t            counts[\"active\"] += 1\n490\t        elif r[\"status\"] == \"STALE\":\n491\t            counts[\"stale\"] += 1\n492\t    return rows, counts\n493\t\n494\t\n495\t# --- already attempted -------------------------------------------------------\n496\t\n497\t\n498\tdef _build_attempted(vin: str) -> list[dict[str, Any]]:\n499\t    try:\n500\t        data = mes_bridge.actuator_history(vin=vin)\n501\t    except BridgeError:\n502\t        return []\n503\t    note = data.get(\"note\")\n504\t    groups: dict[tuple[str, str], dict[str, Any]] = {}\n505\t    for r in data.get(\"runs\", []):\n506\t        key = (r.get(\"operation\"), r.get(\"outcome\"))\n507\t        g = groups.setdefault(key, {\"operation\": r.get(\"operation\"),\n508\t                                    \"kind\": r.get(\"kind\"), \"outcome\": r.get(\"outcome\"),\n509\t                                    \"reason\": None, \"rows\": []})\n510\t        g[\"rows\"].append(r)\n511\t        if r.get(\"reason\") and not g[\"reason\"]:\n512\t            g[\"reason\"] = r.get(\"reason\")\n513\t\n514\t    out = []\n515\t    for g in groups.values():\n516\t        times = sorted(r.get(\"timestamp\") for r in g[\"rows\"] if r.get(\"timestamp\"))\n517\t        reason = g[\"reason\"]\n518\t        footnote = note if (reason and note and \"engine running\" in reason.lower()) else None\n519\t        out.append({\n520\t            \"operation\": g[\"operation\"], \"kind\": g[\"kind\"], \"outcome\": g[\"outcome\"],\n521\t            \"count\": len(g[\"rows\"]),\n522\t            \"first_short\": _short_date(times[0]) if times else None,\n523\t            \"last_short\": _short_date(times[-1]) if times else None,\n524\t            \"reason\": reason, \"reason_chip\": reason, \"footnote\": footnote,\n525\t            \"rows\": g[\"rows\"],\n526\t        })\n527\t    out.sort(key=lambda g: (g[\"outcome\"] != \"FAILED TO EXECUTE\", g[\"operation\"] or \"\"))\n528\t    return out\n529\t\n530\t\n531\t# --- freeze frames -------------------------------------------------------------\n532\t\n533\t\n534\tdef _build_freeze_frames(vin: str, dossier: dict[str, Any]) -> list[dict[str, Any]]:\n535\t    cp = dossier.get(\"current_picture\") or {}\n536\t    target_ts = ((cp.get(\"last_session_with_findings\") or {}).get(\"timestamp\")\n537\t                or (cp.get(\"latest_session\") or {}).get(\"timestamp\"))\n538\t    if not target_ts:\n539\t        return []\n540\t    try:\n541\t        data = mes_bridge.freeze_frames(vin=vin)\n542\t    except BridgeError:\n543\t        return []\n544\t\n545\t    odo_last = (dossier.get(\"identity\") or {}).get(\"odometer_last_km\")\n546\t    out = []\n547\t    for f in data.get(\"frames\", []):\n548\t        if f.get(\"timestamp\") != target_ts:\n549\t            continue\n550\t        ff = f.get(\"freeze_frame\") or {}\n551\t        base = _base(f.get(\"dtc\", \"\"))\n552\t        key = []\n553\t        for name in _KEY_FRAME_PARAMS:\n554\t            if name not in ff:\n555\t                continue\n556\t            value = ff[name]\n557\t            flag = None\n558\t            if name == \"Fuel level\" and base in _EVAP_CODES:\n559\t                level = _num(value)\n560\t                lo, hi = _EVAP_FUEL_WINDOW\n561\t                if level is not None and (level < lo or level > hi):\n562\t                    bound = f\"below {lo:g} %\" if level < lo else f\"above {hi:g} %\"\n563\t                    flag = f\"{bound}: EVAP monitor could not run\"\n564\t            key.append({\"name\": name, \"value\": value, \"flag\": flag})\n565\t        odo_frame = _num(ff.get(\"Odometer\"))\n566\t        set_km_ago = (round(odo_last - odo_frame)\n567\t                     if odo_last is not None and odo_frame is not None else None)\n568\t        out.append({\n569\t            \"code\": f.get(\"dtc\"), \"key\": key, \"set_km_ago\": set_km_ago,\n570\t            \"all\": [{\"name\": n, \"value\": v} for n, v in ff.items()],\n571\t        })\n572\t    return out\n573\t\n574\t\n575\t# --- blind spots as actions ----------------------------------------------------\n576\t\n577\t\n578\tdef _blind_spot_action(vin: str, closes_it: str, enabled: bool) -> dict[str, Any]:\n579\t    low = (closes_it or \"\").lower()\n580\t    hint = \"\" if enabled else \"connect the car (ELM327 on COM3)\"\n581\t    if \"read_readiness\" in low:\n582\t        return {\"label\": \"Read readiness\", \"kind\": \"readiness\",\n583\t                \"href\": f\"/v/{vin}/verify\", \"enabled\": enabled, \"hint\": hint}\n584\t    if \"read_permanent_dtcs\" in low:\n585\t        return {\"label\": \"Read permanent DTCs\", \"kind\": \"permanent\", \"href\": None,\n586\t                \"enabled\": enabled, \"hint\": hint}\n587\t    if \"mode06\" in low or \"send_raw\" in low:\n588\t        return {\"label\": \"Read Mode $06\", \"kind\": \"mode06\", \"href\": None,\n589\t                \"enabled\": enabled, \"hint\": hint}\n590\t    if \"already closed\" in low:\n591\t        return {\"label\": \"Answered\", \"kind\": \"link\", \"href\": f\"/v/{vin}/dealer\",\n592\t                \"enabled\": True, \"hint\": \"\"}\n593\t    if \"witech\" in low or \"dealer\" in low:\n594\t        return {\"label\": \"Dealer / wiTECH\", \"kind\": \"dealer\", \"href\": f\"/v/{vin}/dealer\",\n595\t                \"enabled\": True, \"hint\": \"\"}\n596\t    return {\"label\": \"Manual check\", \"kind\": \"manual\", \"href\": None,\n597\t            \"enabled\": True, \"hint\": \"\"}\n598\t\n599\t\n600\tdef _build_blind_spots(vin: str, dossier: dict[str, Any],\n601\t                       live_status: dict[str, Any] | None) -> list[dict[str, Any]]:\n602\t    enabled = live_available(live_status)\n603\t    out = []\n604\t    for bs in dossier.get(\"blind_spots\", []):\n605\t        out.append({\n606\t            \"question\": bs.get(\"question\", \"\"),\n607\t            \"why\": bs.get(\"why_unknown\", \"\"),\n608\t            \"action\": _blind_spot_action(vin, bs.get(\"closes_it\", \"\"), enabled),\n609\t        })\n610\t    return out\n611\t\n612\t\n613\t# --- bulletins, deduplicated ---------------------------------------------------\n614\t\n615\t\n616\tdef _supersedes(action: str) -> str | None:\n617\t    m = re.search(r\"[Ss]upersed(?:es|ed)\\s+([A-Za-z0-9.\\-]+)\", action or \"\")\n618\t    return m.group(1).rstrip(\".\") if m else None\n619\t\n620\t\n621\tdef _build_bulletins(dossier: dict[str, Any],\n622\t                     open_work: list[dict[str, Any]]) -> list[dict[str, Any]]:\n623\t    tsb = dossier.get(\"tsb_matches\") or {}\n624\t    per_code = tsb.get(\"per_code\") or {}\n625\t    relevant = {c for card in open_work for c in card[\"codes\"]}\n626\t\n627\t    by_num: dict[str, dict[str, Any]] = {}\n628\t    for code, matches in per_code.items():\n629\t        for b in matches:\n630\t            num = b.get(\"bulletin\")\n631\t            if not num:\n632\t                continue\n633\t            entry = by_num.setdefault(num, {\n634\t                \"id\": num, \"anchor\": f\"tsb-{_slug(num)}\", \"title\": b.get(\"title\"),\n635\t                \"action\": b.get(\"action\"), \"caution\": b.get(\"caution\"),\n636\t                \"codes\": set(), \"superseded\": _supersedes(b.get(\"action\", \"\")),\n637\t                \"source\": b.get(\"source\"), \"relevance\": 0,\n638\t            })\n639\t            entry[\"codes\"].update(b.get(\"dtcs\") or [code])\n640\t            if code.upper() in relevant:\n641\t                entry[\"relevance\"] += 1\n642\t\n643\t    out = []\n644\t    for entry in by_num.values():\n645\t        entry[\"codes\"] = sorted(entry[\"codes\"])\n646\t        out.append(entry)\n647\t    out.sort(key=lambda e: (-e[\"relevance\"], e[\"id\"]))\n648\t    return out\n649\t\n650\t\n651\t# --- latest session/scan -------------------------------------------------------\n652\t\n653\t\n654\tdef _build_latest(dossier: dict[str, Any]) -> dict[str, Any]:\n655\t    cp = dossier.get(\"current_picture\") or {}\n656\t    ls = cp.get(\"latest_session\") or {}\n657\t    sc = cp.get(\"latest_scan\") or {}\n658\t    return {\n659\t        \"session_short\": _short_date(ls.get(\"timestamp\"), with_time=True),\n660\t        \"session_file\": ls.get(\"file\"), \"ecu\": ls.get(\"ecu\"),\n661\t        \"scan_short\": (_short_date(sc.get(\"timestamp\"), with_time=True)\n662\t                       if sc.get(\"timestamp\") else None),\n663\t        \"scan_file\": sc.get(\"file\"),\n664\t    }\n665\t\n666\t\n667\t# --- checklist step ids, for the API's validation ----------------------------\n668\t\n669\t\n670\tdef checklist_step_ids(vin: str, dossier: dict[str, Any]) -> set[str]:\n671\t    \"\"\"Every checklist step id this vehicle's open-work cards expose.\n672\t\n673\t    Used by the checklist API to reject a step id that is not actually on\n674\t    this car's dossier -- a step id is only meaningful in the context of the\n675\t    family finding it belongs to.\n676\t    \"\"\"\n677\t    open_work = _build_open_work(vin, dossier, {})\n678\t    return {s[\"id\"] for card in open_work for s in card[\"steps\"]}\n679\t\n680\t\n681\t# --- the one entry point -----------------------------------------------------\n682\t\n683\t\n684\tdef build_view(vin: str, dossier: dict[str, Any],\n685\t              live_status: dict[str, Any] | None) -> dict[str, Any]:\n686\t    \"\"\"Everything the redesigned dossier page needs, computed once.\n687\t\n688\t    ``dossier`` is the workup dict (``mes_bridge.workup(vin=vin)``);\n689\t    ``live_status`` is the same shape ``base.html``'s live strip already\n690\t    renders (``port``, ``mes_state``, ``lock_holder``, ...), or ``None`` when\n691\t    the caller has not computed it. Nothing here mutates either argument or\n692\t    touches the car -- nothing here writes anything at all.\n693\t    \"\"\"\n694\t    checklist = checklist_store.get(vin)\n695\t    open_work = _build_open_work(vin, dossier, checklist)\n696\t    verdict = _build_verdict(vin, dossier, live_status, open_work)\n697\t\n698\t    family_map = _family_map(dossier)\n699\t    try:\n700\t        recent_ts = [e.get(\"timestamp\") for e in\n701\t                    mes_bridge.list_logs(vin=vin, limit=3)[\"logs\"]]\n702\t    except BridgeError:\n703\t        recent_ts = []\n704\t    cleared_at, _cleared_by, clear_assessment = _clear_info(dossier)\n705\t    codes, code_counts = _code_rows(vin, dossier, cleared_at, clear_assessment,\n706\t                                    recent_ts, family_map)\n707\t\n708\t    return {\n709\t        \"verdict\": verdict,\n710\t        \"open_work\": open_work,\n711\t        \"codes\": codes,\n712\t        \"code_counts\": code_counts,\n713\t        \"attempted\": _build_attempted(vin),\n714\t        \"freeze_frames\": _build_freeze_frames(vin, dossier),\n715\t        \"blind_spots\": _build_blind_spots(vin, dossier, live_status),\n716\t        \"bulletins\": _build_bulletins(dossier, open_work),\n717\t        \"latest\": _build_latest(dossier),\n718\t        \"provenance_note\": dossier.get(\"provenance_note\", \"\"),\n719\t    }\n720\t\n721\t\n722\t__all__ = [\"build_view\", \"checklist_step_ids\", \"live_available\", \"readiness_result\",\n723\t           \"FAMILY_STEPS\"]\n724\t"}]},"uuid":"5595e5be-6bb5-4284-ab16-c3e59db850fd","timestamp":"2026-10-08T03:03:39.985Z","toolUseResult":{"type":"text","file":{"filePath":"C:\\Users\\User\\mcp-servers\\cuore\\services\\dossier_bridge.py","content":"\"\"\"Turns the raw workup dossier into the redesigned dossier page's contract.\n\nMECHANIC_UX_REVIEW.md's R1/R4/R5/R6/R7/R8/R9 all boil down to the same\ncomplaint: the knowledge in ``mes.workup`` is already senior-technician-grade\n(family findings, chronic/returned classification, TSB cross-reference) but\nthe page made the mechanic excavate it from prose and raw dicts. Nothing here\nre-derives that knowledge -- it only reshapes what ``mes_bridge.workup``\nalready returns (plus what the live link has observed) into the verdict,\nchecklists, code table, freeze-frame flags, deduplicated bulletins and\nrunnable blind-spot actions the template needs, so there is exactly one\nplace that decides what a status chip or a checklist step means.\n\n``build_view`` is the only entry point. Everything else is a private helper.\n\nLike every other file under ``cuore/services``, this is a *_bridge.py module,\nso it is allowed to import ``mes_bridge`` (never the ``mes`` package itself --\nnothing here needs to; the workup dict already carries what ``mes`` computed)\nand the small read-only ``cuore.live`` surfaces (``store`` for live\nobservations, ``checklists`` for shop-ticked steps).\n\"\"\"\n\nfrom __future__ import annotations\n\nimport re\nfrom datetime import datetime\nfrom typing import Any\n\nfrom . import mes_bridge\nfrom .errors import BridgeError\nfrom ..live import checklists as checklist_store\nfrom ..live import store as live_store\n\n#: EVAP monitor runs at 15-85% fuel; cited wherever a freeze frame needs\n#: flagging. Matches the window ``mes`` itself states in verdict/fault-tree\n#: text -- not re-derived, just applied to one more surface.\n_EVAP_FUEL_WINDOW = (15.0, 85.0)\n_EVAP_CODES = {\"P0440\", \"P0441\", \"P0455\", \"P0456\", \"P1CEA\"}\n\n_SYSTEM_BY_LETTER = {\"P\": \"engine\", \"C\": \"chassis\", \"B\": \"body\", \"U\": \"network\"}\n\n_STATUS_LABEL = {\"ACTIVE\": \"Active\", \"CLEARED_UNVERIFIED\": \"Cleared, unverified\",\n                \"STALE\": \"Stale\"}\n\n#: Freeze-frame parameters worth a mechanic's first glance, in the order\n#: they should appear. Everything else still rides along in ``all``.\n_KEY_FRAME_PARAMS = [\"Fuel level\", \"Engine temperature\", \"Odometer\",\n                     \"Vehicle speed\", \"Engine speed\", \"Air temperature\"]\n\n#: One checklist per family this corpus's fault trees and TSBs recognise\n#: today. Transcribed once, here, from the family finding's own \"reading\"\n#: text and the EVAP/network fault trees -- see MECHANIC_UX_REVIEW.md R4.\n#: Keeping this as a table (not free-text parsing of ``reading``) is what\n#: makes checklist step ids stable across a wording change in ``mes``.\nFAMILY_STEPS: dict[str, list[dict[str, Any]]] = {\n    \"EVAP\": [\n        {\"id\": \"evap-1\", \"text\": \"Inspect the recirculation-line quick-connect\",\n         \"ref\": \"S2125000002\"},\n        {\"id\": \"evap-2\", \"text\": \"Run the purge/vent valve KOEO actuator test\",\n         \"ref\": None},\n        {\"id\": \"evap-3\", \"text\": \"Check hose routing\", \"ref\": \"9100325\"},\n        {\"id\": \"evap-4\", \"text\": \"Inspect the canister/ESIM\", \"ref\": \"9100471\"},\n        {\"id\": \"evap-5\", \"text\": \"Run a smoke test to localise the leak\",\n         \"ref\": None},\n        {\"id\": \"evap-6\", \"text\": \"Verify with SLVT or Mode $06\",\n         \"ref\": \"18-048-23\"},\n    ],\n    \"network\": [\n        {\"id\": \"network-1\", \"text\": \"Check the supply: F82 fuse and BCM feeds\",\n         \"ref\": \"S1808000005\"},\n        {\"id\": \"network-2\",\n         \"text\": \"Inspect connectors/grounds: XY201, G003A/B\",\n         \"ref\": \"S2008000032\"},\n        {\"id\": \"network-3\",\n         \"text\": \"Inspect connector terminals for spread/backed-out pins\",\n         \"ref\": \"S1708000262\"},\n    ],\n}\n\n_FAMILY_TITLES = {\n    \"EVAP\": \"EVAP: one system fault\",\n    \"network\": \"Network: one power/bus event, not {n} separate faults\",\n}\n\n\n# --- small shared helpers --------------------------------------------------\n\n\ndef _base(code: str) -> str:\n    \"\"\"\"P0440-00\" -> \"P0440\". Same rule as ``mes.knowledge.base_code``,\n    reimplemented here rather than imported so this module never touches the\n    ``mes`` package directly.\"\"\"\n    code = (code or \"\").strip().upper()\n    return code.split(\"-\", 1)[0] if \"-\" in code else code\n\n\ndef _slug(text: str) -> str:\n    return re.sub(r\"[^A-Za-z0-9]+\", \"-\", (text or \"\").strip()).strip(\"-\")\n\n\ndef _parse_ts(ts: str | None) -> datetime | None:\n    if not ts:\n        return None\n    try:\n        return datetime.strptime(str(ts)[:19], \"%Y-%m-%d %H:%M:%S\")\n    except ValueError:\n        return None\n\n\ndef _short_date(ts: str | None, with_time: bool = False) -> str | None:\n    dt = _parse_ts(ts)\n    if dt is None:\n        return None\n    fmt = \"%d %b %H:%M\" if with_time else \"%d %b\"\n    if dt.year != datetime.now().year:\n        fmt += \" '%y\"\n    return dt.strftime(fmt)\n\n\ndef _num(display: Any) -> float | None:\n    \"\"\"Pull the leading number out of a display string like \"93.73 %\".\"\"\"\n    if display is None:\n        return None\n    m = re.match(r\"\\s*(-?\\d+(?:\\.\\d+)?)\", str(display))\n    return float(m.group(1)) if m else None\n\n\ndef live_available(live_status: dict[str, Any] | None) -> bool:\n    \"\"\"Is the adapter reachable right now -- a port configured, and neither\n    MultiEcuScan nor another process holding it.\n\n    Same read ``base.html``'s live strip and ``/live`` already make of\n    ``live_ops.status()``: ``mes_state == \"connected\"`` means MES has the\n    port, and a ``lock_holder`` other than this process means something else\n    does. Used both to grey out the dossier's own action buttons and by\n    ``/v/{vin}/verify`` to decide whether it is safe to actually read.\n    \"\"\"\n    if not live_status or live_status.get(\"error\"):\n        return False\n    if not live_status.get(\"port\"):\n        return False\n    if live_status.get(\"mes_state\") == \"connected\":\n        return False\n    holder = live_status.get(\"lock_holder\")\n    if holder and holder != \"cuore\":\n        return False\n    return True\n\n\n# --- the last clear ---------------------------------------------------------\n\n\ndef _clear_info(dossier: dict[str, Any]\n                ) -> tuple[str | None, str | None, dict[str, Any] | None]:\n    \"\"\"(cleared_at full timestamp, cleared_by file, the clear_assessment dict).\n\n    ``current_picture.clear_assessment`` comes from two different shapes in\n    ``mes.workup``: a scan-based clear carries its own ``cleared_at``/\n    ``source``; a clear inside the anchored FES session itself carries\n    neither, because *that session* is the clear -- so its timestamp/file are\n    read off ``latest_session`` instead.\n    \"\"\"\n    cp = dossier.get(\"current_picture\") or {}\n    ca = cp.get(\"clear_assessment\")\n    if not ca:\n        return None, None, None\n    cleared_at = ca.get(\"cleared_at\")\n    cleared_by = ca.get(\"source\")\n    if not cleared_at:\n        latest = cp.get(\"latest_session\") or {}\n        cleared_at = latest.get(\"timestamp\")\n        cleared_by = latest.get(\"file\")\n    return cleared_at, cleared_by, ca\n\n\n# --- readiness, read from the car -------------------------------------------\n\n\ndef _latest_readiness(vin: str, after: str | None) -> dict[str, Any] | None:\n    \"\"\"The newest readiness observation from the car itself, after ``after``.\n\n    A read taken before the clear says nothing about the car now -- the same\n    reasoning ``mes.verdict._last_clear`` already applies to live DTC reads.\n    \"\"\"\n    try:\n        obs = live_store.recent_observations(200, vin=vin, kind=\"readiness\")\n    except Exception:  # noqa: BLE001 -- a broken store must never break the verdict\n        return None\n    best = None\n    for o in obs:\n        if not live_store.is_from_car(o):\n            continue\n        at = o.get(\"at\") or \"\"\n        if after and at <= after:\n            continue\n        if best is None or at > (best.get(\"at\") or \"\"):\n            best = o\n    return best\n\n\ndef readiness_result(raw: dict[str, Any]) -> dict[str, Any]:\n    \"\"\"Shape a live ``ops.obd_readiness()`` read for ``/v/{vin}/verify``.\n\n    ``verify.html`` destructures ``result.at`` / ``result.evap_monitor`` /\n    ``result.all_complete`` / ``result.monitors`` explicitly (never the raw\n    dict) -- this is the one place that produces that flat shape from the\n    nested ``since_clear``/``monitors`` payload ``ops.obd_readiness``\n    returns, so the page and the verdict's own ``readiness`` sub-object\n    agree on what \"the EVAP monitor is complete\" means.\n    \"\"\"\n    since = raw.get(\"since_clear\") or {}\n    monitors = since.get(\"monitors\") or []\n    evap = next((m for m in monitors if m.get(\"monitor\") == \"Evaporative system\"), None)\n    return {\n        \"at\": datetime.now().isoformat(timespec=\"seconds\"),\n        \"evap_monitor\": bool(evap and evap.get(\"complete\")),\n        \"all_complete\": bool(since.get(\"all_complete\")),\n        \"monitors\": [{\"name\": m.get(\"monitor\"), \"complete\": bool(m.get(\"complete\"))}\n                     for m in monitors],\n    }\n\n\ndef _evap_from_readiness(obs: dict[str, Any] | None) -> dict[str, Any] | None:\n    if obs is None:\n        return None\n    data = obs.get(\"data\") or {}\n    since = data.get(\"since_clear\") or {}\n    monitors = since.get(\"monitors\") or []\n    evap = next((m for m in monitors if m.get(\"monitor\") == \"Evaporative system\"), None)\n    if not monitors:\n        state = None\n    elif evap is None:\n        state = \"not_supported\"\n    else:\n        state = \"complete\" if evap.get(\"complete\") else \"incomplete\"\n    return {\"at\": obs.get(\"at\"), \"evap_monitor\": state,\n            \"all_complete\": bool(since.get(\"all_complete\"))}\n\n\n# --- verdict -----------------------------------------------------------------\n\n\ndef _verdict_actions(vin: str, enabled: bool) -> list[dict[str, Any]]:\n    hint = \"\" if enabled else \"connect the car (ELM327 on COM3)\"\n    return [\n        {\"label\": \"Verify repair\", \"kind\": \"readiness\", \"href\": f\"/v/{vin}/verify\",\n         \"enabled\": enabled, \"hint\": hint},\n        {\"label\": \"EVAP fault tree\", \"kind\": \"link\", \"href\": f\"/v/{vin}/tree\",\n         \"enabled\": True, \"hint\": \"\"},\n        {\"label\": \"Evidence gate\", \"kind\": \"link\", \"href\": f\"/v/{vin}/gate\",\n         \"enabled\": True, \"hint\": \"\"},\n    ]\n\n\ndef _verdict_summary(state: str, open_work: list[dict[str, Any]],\n                     cleared_at: str | None, dossier: dict[str, Any]) -> str:\n    if open_work:\n        codes = open_work[0][\"codes\"][:3]\n    else:\n        chronic = (dossier.get(\"history\") or {}).get(\"chronic\") or []\n        codes = sorted({_base(r.get(\"dtc\", \"\")) for r in chronic})[:3]\n    code_str = \"/\".join(codes) if codes else \"the logged codes\"\n    cleared_short = _short_date(cleared_at) if cleared_at else None\n\n    if state == \"NO_DATA\":\n        return \"No MES logs on file for this vehicle.\"\n    if state == \"ACTIVE_FAULTS\":\n        return f\"{code_str} active now -- not cleared, not resolved.\"\n    if state == \"VERIFIED_CLEAN\":\n        return f\"{code_str} cleared {cleared_short}; EVAP monitor ran clean. Repair verified.\"\n    return f\"{code_str} cleared {cleared_short}; monitors have not re-run. Not proof of repair.\"\n\n\ndef _build_verdict(vin: str, dossier: dict[str, Any], live_status: dict[str, Any] | None,\n                   open_work: list[dict[str, Any]]) -> dict[str, Any]:\n    identity = dossier.get(\"identity\") or {}\n    enabled = live_available(live_status)\n\n    if not identity.get(\"log_count\"):\n        return {\"state\": \"NO_DATA\", \"label\": \"No data\",\n                \"summary\": \"No MES logs on file for this vehicle.\",\n                \"basis\": [\"no logs matched this VIN\"],\n                \"cleared_at\": None, \"cleared_by\": None, \"readiness\": None,\n                \"actions\": _verdict_actions(vin, enabled)}\n\n    cp = dossier.get(\"current_picture\") or {}\n    history = dossier.get(\"history\") or {}\n    cleared_at, cleared_by, clear_assessment = _clear_info(dossier)\n\n    basis: list[str] = []\n    active = False\n\n    latest_session = cp.get(\"latest_session\") or {}\n    if (cleared_at and latest_session.get(\"timestamp\")\n            and latest_session.get(\"timestamp\") > cleared_at\n            and latest_session.get(\"dtcs\")):\n        active = True\n        basis.append(f\"newest session ({latest_session['timestamp']}) holds DTCs \"\n                     f\"after the {cleared_at} clear\")\n\n    latest_scan = cp.get(\"latest_scan\") or {}\n    if (cleared_at and latest_scan.get(\"timestamp\")\n            and latest_scan.get(\"timestamp\") > cleared_at\n            and latest_scan.get(\"modules_with_faults\")):\n        active = True\n        basis.append(f\"newest scan ({latest_scan['timestamp']}) holds DTCs \"\n                     f\"after the {cleared_at} clear\")\n\n    returned_in_session = (clear_assessment or {}).get(\"codes_returned_in_session\") or []\n    if returned_in_session:\n        active = True\n        basis.append(\"codes returned in the clearing session: \"\n                     + \", \".join(returned_in_session))\n\n    uncleared = (clear_assessment or {}).get(\"codes_that_would_not_clear\") or []\n    if uncleared:\n        active = True\n        basis.append(\"codes would not clear: \" + \", \".join(uncleared))\n\n    if history.get(\"returned_after_clear\"):\n        active = True\n        basis.append(\"returned after a clear: \" + \", \".join(\n            sorted(_base(r.get(\"dtc\", \"\")) for r in history[\"returned_after_clear\"])))\n\n    readiness = None\n    if cleared_at:\n        readiness = _evap_from_readiness(_latest_readiness(vin, cleared_at))\n\n    if active:\n        state, label = \"ACTIVE_FAULTS\", \"Active faults\"\n    elif cleared_at is None:\n        if history.get(\"chronic\"):\n            state, label = \"ACTIVE_FAULTS\", \"Active faults\"\n            basis.append(\"chronic codes on file and no clear recorded\")\n        else:\n            state, label = \"NO_DATA\", \"No data\"\n            basis.append(\"no open codes and no clear on file\")\n    elif readiness and readiness.get(\"evap_monitor\") == \"complete\":\n        state, label = \"VERIFIED_CLEAN\", \"Verified clean\"\n        basis.append(f\"EVAP monitor complete on a live read at {readiness['at']}, \"\n                     f\"no code has returned since the {cleared_at} clear\")\n    else:\n        state, label = \"UNVERIFIED_REPAIR\", \"Unverified repair\"\n        basis.append(f\"last clear {cleared_at} ({cleared_by or 'unknown source'}); \"\n                     f\"no code has returned\")\n        if readiness is None:\n            basis.append(\"no readiness read from the car since the clear\")\n        else:\n            basis.append(f\"readiness read at {readiness['at']} -- EVAP monitor \"\n                         f\"{readiness.get('evap_monitor') or 'unknown'}\")\n\n    return {\n        \"state\": state, \"label\": label,\n        \"summary\": _verdict_summary(state, open_work, cleared_at, dossier),\n        \"basis\": basis,\n        \"cleared_at\": cleared_at.split(\" \")[0] if cleared_at else None,\n        \"cleared_by\": cleared_by,\n        \"readiness\": readiness,\n        \"actions\": _verdict_actions(vin, enabled),\n    }\n\n\n# --- open work (family findings as a checklist) -----------------------------\n\n\ndef _family_refs(codes: list[str], per_code: dict[str, Any],\n                 reading: str) -> list[dict[str, Any]]:\n    seen: dict[str, dict[str, Any]] = {}\n    for code in codes:\n        for b in per_code.get(code, []):\n            num = b.get(\"bulletin\")\n            if num and num not in seen:\n                seen[num] = {\"label\": num, \"href\": f\"#tsb-{_slug(num)}\"}\n    for doc in re.findall(r\"docs/\\S+?\\.md\", reading or \"\"):\n        if doc not in seen:\n            seen[doc] = {\"label\": doc, \"href\": None}\n    return list(seen.values())\n\n\ndef _build_open_work(vin: str, dossier: dict[str, Any],\n                     checklist: dict[str, Any]) -> list[dict[str, Any]]:\n    tsb = dossier.get(\"tsb_matches\") or {}\n    findings = tsb.get(\"family_findings\") or []\n    per_code = tsb.get(\"per_code\") or {}\n    cards = []\n    for f in findings:\n        family = f.get(\"family\") or \"\"\n        steps_def = FAMILY_STEPS.get(family)\n        if not steps_def:\n            continue  # no checklist table for this family yet\n        codes = [c.upper() for c in (f.get(\"codes\") or [])]\n        steps = []\n        done = 0\n        for s in steps_def:\n            st = checklist.get(s[\"id\"]) or {}\n            is_done = bool(st.get(\"done\"))\n            done += int(is_done)\n            steps.append({\n                \"id\": s[\"id\"], \"text\": s[\"text\"], \"ref\": s[\"ref\"],\n                \"ref_href\": f\"#tsb-{_slug(s['ref'])}\" if s[\"ref\"] else None,\n                \"done\": is_done, \"done_at\": st.get(\"done_at\"),\n                \"done_by\": st.get(\"done_by\"),\n            })\n        title = _FAMILY_TITLES.get(family, f\"{family}: one system fault\")\n        if \"{n}\" in title:\n            title = title.format(n=len(codes))\n        cards.append({\n            \"family\": family, \"title\": title, \"codes\": codes, \"steps\": steps,\n            \"refs\": _family_refs(codes, per_code, f.get(\"reading\", \"\")),\n            \"progress\": {\"done\": done, \"total\": len(steps_def)},\n        })\n    return cards\n\n\ndef _family_map(dossier: dict[str, Any]) -> dict[str, str]:\n    out: dict[str, str] = {}\n    for f in (dossier.get(\"tsb_matches\") or {}).get(\"family_findings\", []):\n        for c in f.get(\"codes\", []):\n            out[c.upper()] = f.get(\"family\")\n    return out\n\n\n# --- the code table -----------------------------------------------------------\n\n\ndef _code_status(base: str, last_seen: str | None, cleared_at: str | None,\n                 codes_cleared: set[str], codes_returned: set[str],\n                 codes_uncleared: set[str], last_findings: set[str],\n                 last_findings_ts: str | None, recent_ts: list[str]) -> str:\n    if base in codes_returned or base in codes_uncleared:\n        return \"ACTIVE\"\n    if cleared_at and last_seen and last_seen > cleared_at:\n        return \"ACTIVE\"\n    if base in last_findings and not (cleared_at and last_findings_ts\n                                      and cleared_at >= last_findings_ts):\n        return \"ACTIVE\"\n    if cleared_at and base in codes_cleared and (not last_seen or last_seen <= cleared_at):\n        return \"CLEARED_UNVERIFIED\"\n    if cleared_at is None and last_seen and last_seen in recent_ts[:3]:\n        return \"ACTIVE\"\n    return \"STALE\"\n\n\ndef _code_rows(vin: str, dossier: dict[str, Any], cleared_at: str | None,\n              clear_assessment: dict[str, Any] | None, recent_ts: list[str],\n              family_map: dict[str, str]\n              ) -> tuple[list[dict[str, Any]], dict[str, int]]:\n    history = dossier.get(\"history\") or {}\n    cp = dossier.get(\"current_picture\") or {}\n    last_findings_session = cp.get(\"last_session_with_findings\") or {}\n    last_findings = {_base(d.get(\"code\") or d.get(\"dtc\") or \"\")\n                     for d in last_findings_session.get(\"dtcs\", [])}\n    last_findings_ts = last_findings_session.get(\"timestamp\")\n\n    codes_cleared = {_base(c) for c in (clear_assessment or {}).get(\"codes_cleared\", [])}\n    codes_returned = {_base(c) for c in\n                      (clear_assessment or {}).get(\"codes_returned_in_session\", [])}\n    codes_uncleared = {_base(c) for c in\n                       (clear_assessment or {}).get(\"codes_that_would_not_clear\", [])}\n\n    rows: list[dict[str, Any]] = []\n    for bucket in (\"chronic\", \"returned_after_clear\", \"seen_once\"):\n        for rec in history.get(bucket, []):\n            full = rec.get(\"dtc\", \"\")\n            base = _base(full)\n            last_seen = rec.get(\"last_seen\")\n            status = _code_status(base, last_seen, cleared_at, codes_cleared,\n                                  codes_returned, codes_uncleared, last_findings,\n                                  last_findings_ts, recent_ts)\n            distance = rec.get(\"distance_span_km\")\n            rows.append({\n                \"code\": base, \"dtc\": full,\n                \"description\": (rec.get(\"descriptions\") or [\"\"])[0],\n                \"system\": _SYSTEM_BY_LETTER.get(base[:1], base[:1] if base else None),\n                \"bucket\": bucket,\n                \"status\": status, \"status_label\": _STATUS_LABEL[status],\n                \"sessions\": rec.get(\"sessions\"),\n                \"last_seen_short\": _short_date(last_seen),\n                \"last_seen\": last_seen, \"first_seen\": rec.get(\"first_seen\"),\n                \"distance_km\": round(distance) if distance is not None else None,\n                \"href\": f\"/v/{vin}/code/{base}\",\n                \"family\": family_map.get(base),\n            })\n\n    counts = {\"chronic\": 0, \"seen_once\": 0, \"returned_after_clear\": 0,\n             \"active\": 0, \"stale\": 0}\n    for r in rows:\n        counts[r[\"bucket\"]] = counts.get(r[\"bucket\"], 0) + 1\n        if r[\"status\"] == \"ACTIVE\":\n            counts[\"active\"] += 1\n        elif r[\"status\"] == \"STALE\":\n            counts[\"stale\"] += 1\n    return rows, counts\n\n\n# --- already attempted -------------------------------------------------------\n\n\ndef _build_attempted(vin: str) -> list[dict[str, Any]]:\n    try:\n        data = mes_bridge.actuator_history(vin=vin)\n    except BridgeError:\n        return []\n    note = data.get(\"note\")\n    groups: dict[tuple[str, str], dict[str, Any]] = {}\n    for r in data.get(\"runs\", []):\n        key = (r.get(\"operation\"), r.get(\"outcome\"))\n        g = groups.setdefault(key, {\"operation\": r.get(\"operation\"),\n                                    \"kind\": r.get(\"kind\"), \"outcome\": r.get(\"outcome\"),\n                                    \"reason\": None, \"rows\": []})\n        g[\"rows\"].append(r)\n        if r.get(\"reason\") and not g[\"reason\"]:\n            g[\"reason\"] = r.get(\"reason\")\n\n    out = []\n    for g in groups.values():\n        times = sorted(r.get(\"timestamp\") for r in g[\"rows\"] if r.get(\"timestamp\"))\n        reason = g[\"reason\"]\n        footnote = note if (reason and note and \"engine running\" in reason.lower()) else None\n        out.append({\n            \"operation\": g[\"operation\"], \"kind\": g[\"kind\"], \"outcome\": g[\"outcome\"],\n            \"count\": len(g[\"rows\"]),\n            \"first_short\": _short_date(times[0]) if times else None,\n            \"last_short\": _short_date(times[-1]) if times else None,\n            \"reason\": reason, \"reason_chip\": reason, \"footnote\": footnote,\n            \"rows\": g[\"rows\"],\n        })\n    out.sort(key=lambda g: (g[\"outcome\"] != \"FAILED TO EXECUTE\", g[\"operation\"] or \"\"))\n    return out\n\n\n# --- freeze frames -------------------------------------------------------------\n\n\ndef _build_freeze_frames(vin: str, dossier: dict[str, Any]) -> list[dict[str, Any]]:\n    cp = dossier.get(\"current_picture\") or {}\n    target_ts = ((cp.get(\"last_session_with_findings\") or {}).get(\"timestamp\")\n                or (cp.get(\"latest_session\") or {}).get(\"timestamp\"))\n    if not target_ts:\n        return []\n    try:\n        data = mes_bridge.freeze_frames(vin=vin)\n    except BridgeError:\n        return []\n\n    odo_last = (dossier.get(\"identity\") or {}).get(\"odometer_last_km\")\n    out = []\n    for f in data.get(\"frames\", []):\n        if f.get(\"timestamp\") != target_ts:\n            continue\n        ff = f.get(\"freeze_frame\") or {}\n        base = _base(f.get(\"dtc\", \"\"))\n        key = []\n        for name in _KEY_FRAME_PARAMS:\n            if name not in ff:\n                continue\n            value = ff[name]\n            flag = None\n            if name == \"Fuel level\" and base in _EVAP_CODES:\n                level = _num(value)\n                lo, hi = _EVAP_FUEL_WINDOW\n                if level is not None and (level < lo or level > hi):\n                    bound = f\"below {lo:g} %\" if level < lo else f\"above {hi:g} %\"\n                    flag = f\"{bound}: EVAP monitor could not run\"\n            key.append({\"name\": name, \"value\": value, \"flag\": flag})\n        odo_frame = _num(ff.get(\"Odometer\"))\n        set_km_ago = (round(odo_last - odo_frame)\n                     if odo_last is not None and odo_frame is not None else None)\n        out.append({\n            \"code\": f.get(\"dtc\"), \"key\": key, \"set_km_ago\": set_km_ago,\n            \"all\": [{\"name\": n, \"value\": v} for n, v in ff.items()],\n        })\n    return out\n\n\n# --- blind spots as actions ----------------------------------------------------\n\n\ndef _blind_spot_action(vin: str, closes_it: str, enabled: bool) -> dict[str, Any]:\n    low = (closes_it or \"\").lower()\n    hint = \"\" if enabled else \"connect the car (ELM327 on COM3)\"\n    if \"read_readiness\" in low:\n        return {\"label\": \"Read readiness\", \"kind\": \"readiness\",\n                \"href\": f\"/v/{vin}/verify\", \"enabled\": enabled, \"hint\": hint}\n    if \"read_permanent_dtcs\" in low:\n        return {\"label\": \"Read permanent DTCs\", \"kind\": \"permanent\", \"href\": None,\n                \"enabled\": enabled, \"hint\": hint}\n    if \"mode06\" in low or \"send_raw\" in low:\n        return {\"label\": \"Read Mode $06\", \"kind\": \"mode06\", \"href\": None,\n                \"enabled\": enabled, \"hint\": hint}\n    if \"already closed\" in low:\n        return {\"label\": \"Answered\", \"kind\": \"link\", \"href\": f\"/v/{vin}/dealer\",\n                \"enabled\": True, \"hint\": \"\"}\n    if \"witech\" in low or \"dealer\" in low:\n        return {\"label\": \"Dealer / wiTECH\", \"kind\": \"dealer\", \"href\": f\"/v/{vin}/dealer\",\n                \"enabled\": True, \"hint\": \"\"}\n    return {\"label\": \"Manual check\", \"kind\": \"manual\", \"href\": None,\n            \"enabled\": True, \"hint\": \"\"}\n\n\ndef _build_blind_spots(vin: str, dossier: dict[str, Any],\n                       live_status: dict[str, Any] | None) -> list[dict[str, Any]]:\n    enabled = live_available(live_status)\n    out = []\n    for bs in dossier.get(\"blind_spots\", []):\n        out.append({\n            \"question\": bs.get(\"question\", \"\"),\n            \"why\": bs.get(\"why_unknown\", \"\"),\n            \"action\": _blind_spot_action(vin, bs.get(\"closes_it\", \"\"), enabled),\n        })\n    return out\n\n\n# --- bulletins, deduplicated ---------------------------------------------------\n\n\ndef _supersedes(action: str) -> str | None:\n    m = re.search(r\"[Ss]upersed(?:es|ed)\\s+([A-Za-z0-9.\\-]+)\", action or \"\")\n    return m.group(1).rstrip(\".\") if m else None\n\n\ndef _build_bulletins(dossier: dict[str, Any],\n                     open_work: list[dict[str, Any]]) -> list[dict[str, Any]]:\n    tsb = dossier.get(\"tsb_matches\") or {}\n    per_code = tsb.get(\"per_code\") or {}\n    relevant = {c for card in open_work for c in card[\"codes\"]}\n\n    by_num: dict[str, dict[str, Any]] = {}\n    for code, matches in per_code.items():\n        for b in matches:\n            num = b.get(\"bulletin\")\n            if not num:\n                continue\n            entry = by_num.setdefault(num, {\n                \"id\": num, \"anchor\": f\"tsb-{_slug(num)}\", \"title\": b.get(\"title\"),\n                \"action\": b.get(\"action\"), \"caution\": b.get(\"caution\"),\n                \"codes\": set(), \"superseded\": _supersedes(b.get(\"action\", \"\")),\n                \"source\": b.get(\"source\"), \"relevance\": 0,\n            })\n            entry[\"codes\"].update(b.get(\"dtcs\") or [code])\n            if code.upper() in relevant:\n                entry[\"relevance\"] += 1\n\n    out = []\n    for entry in by_num.values():\n        entry[\"codes\"] = sorted(entry[\"codes\"])\n        out.append(entry)\n    out.sort(key=lambda e: (-e[\"relevance\"], e[\"id\"]))\n    return out\n\n\n# --- latest session/scan -------------------------------------------------------\n\n\ndef _build_latest(dossier: dict[str, Any]) -> dict[str, Any]:\n    cp = dossier.get(\"current_picture\") or {}\n    ls = cp.get(\"latest_session\") or {}\n    sc = cp.get(\"latest_scan\") or {}\n    return {\n        \"session_short\": _short_date(ls.get(\"timestamp\"), with_time=True),\n        \"session_file\": ls.get(\"file\"), \"ecu\": ls.get(\"ecu\"),\n        \"scan_short\": (_short_date(sc.get(\"timestamp\"), with_time=True)\n                       if sc.get(\"timestamp\") else None),\n        \"scan_file\": sc.get(\"file\"),\n    }\n\n\n# --- checklist step ids, for the API's validation ----------------------------\n\n\ndef checklist_step_ids(vin: str, dossier: dict[str, Any]) -> set[str]:\n    \"\"\"Every checklist step id this vehicle's open-work cards expose.\n\n    Used by the checklist API to reject a step id that is not actually on\n    this car's dossier -- a step id is only meaningful in the context of the\n    family finding it belongs to.\n    \"\"\"\n    open_work = _build_open_work(vin, dossier, {})\n    return {s[\"id\"] for card in open_work for s in card[\"steps\"]}\n\n\n# --- the one entry point -----------------------------------------------------\n\n\ndef build_view(vin: str, dossier: dict[str, Any],\n              live_status: dict[str, Any] | None) -> dict[str, Any]:\n    \"\"\"Everything the redesigned dossier page needs, computed once.\n\n    ``dossier`` is the workup dict (``mes_bridge.workup(vin=vin)``);\n    ``live_status`` is the same shape ``base.html``'s live strip already\n    renders (``port``, ``mes_state``, ``lock_holder``, ...), or ``None`` when\n    the caller has not computed it. Nothing here mutates either argument or\n    touches the car -- nothing here writes anything at all.\n    \"\"\"\n    checklist = checklist_store.get(vin)\n    open_work = _build_open_work(vin, dossier, checklist)\n    verdict = _build_verdict(vin, dossier, live_status, open_work)\n\n    family_map = _family_map(dossier)\n    try:\n        recent_ts = [e.get(\"timestamp\") for e in\n                    mes_bridge.list_logs(vin=vin, limit=3)[\"logs\"]]\n    except BridgeError:\n        recent_ts = []\n    cleared_at, _cleared_by, clear_assessment = _clear_info(dossier)\n    codes, code_counts = _code_rows(vin, dossier, cleared_at, clear_assessment,\n                                    recent_ts, family_map)\n\n    return {\n        \"verdict\": verdict,\n        \"open_work\": open_work,\n        \"codes\": codes,\n        \"code_counts\": code_counts,\n        \"attempted\": _build_attempted(vin),\n        \"freeze_frames\": _build_freeze_frames(vin, dossier),\n        \"blind_spots\": _build_blind_spots(vin, dossier, live_status),\n        \"bulletins\": _build_bulletins(dossier, open_work),\n        \"latest\": _build_latest(dossier),\n        \"provenance_note\": dossier.get(\"provenance_note\", \"\"),\n    }\n\n\n__all__ = [\"build_view\", \"checklist_step_ids\", \"live_available\", \"readiness_result\",\n           \"FAMILY_STEPS\"]\n","numLines":724,"startLine":1,"totalLines":724}},"sourceToolAssistantUUID":"94edba1e-361a-49f0-9ab8-289fda71245a","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
{"parentUuid":"5595e5be-6bb5-4284-ab16-c3e59db850fd","isSidechain":true,"agentId":"a2392aaec64306cb2","message":{"model":"claude-sonnet-5","id":"msg_011Cfp2YcjcXU1jejSSh3Wmi","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_018gHHbPAjxNhQ9TKyydv1gA","name":"Read","input":{"file_path":"C:\\Users\\User\\mcp-servers\\cuore\\services\\timeline_bridge.py"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":5303,"cache_read_input_tokens":57422,"cache_creation":{"ephemeral_5m_input_tokens":5303,"ephemeral_1h_input_tokens":0},"output_tokens":4,"service_tier":"standard","inference_geo":"not_available"},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_018gHHbPAjxNhQ9TKyydv1gA":{"file_path":"C:\\Users\\User\\mcp-servers\\cuore\\services\\timeline_bridge.py"}},"serverClassifierRequest":"9b304114-d192-463f-acbb-5e3a0377cdef","apiBlockIndex":2,"requestId":"req_011Cfp2YcUyNmgnowe684qs5","attributionAgent":"general-purpose","type":"assistant","uuid":"cea423bf-f009-499a-93ed-d6f25684f9e7","timestamp":"2026-10-08T03:03:40.114Z","effort":"high","perTurnEffort":null,"userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
{"parentUuid":"cea423bf-f009-499a-93ed-d6f25684f9e7","isSidechain":true,"promptId":"1c9ea3c5-87b7-461e-9caf-e82d18dc2677","agentId":"a2392aaec64306cb2","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018gHHbPAjxNhQ9TKyydv1gA","type":"tool_result","content":"1\t\"\"\"The mechanic-vs-driver timeline: codes on one axis, what was actually felt\n2\ton the other.\n3\t\n4\tThe dossier (``dossier_bridge``) answers \"what is wrong with this car right\n5\tnow\". This module answers a different question a mechanic needs before ever\n6\ttouching a wrench: across the whole history, which codes lined up with a\n7\tdriver noticing something, and which never did? For EVAP in particular the\n8\thonest answer is almost always \"nothing was ever felt\" -- the fault is real,\n9\tthe codes keep returning, and there is still no complaint to chase. Burying\n10\tthat fact inside a code table invites a mechanic to go looking for a\n11\tdrivability symptom that was never there; ``build_timeline`` makes the\n12\tabsence itself the headline finding.\n13\t\n14\tLike ``dossier_bridge``, this is a ``cuore/services/*_bridge.py`` module, so\n15\tit is allowed to import the ``mes`` package directly (``mes.symptoms`` and\n16\t``mes.code_feel`` are new, small, and have no existing bridge; ``mes.service``\n17\tis read the same way ``service_bridge.py`` already reads it) alongside the\n18\t``mes_bridge``/``service_bridge`` facades for everything that already has\n19\tone. Nothing here re-implements chronic/returned classification, TSB\n20\tmatching or freeze-frame flagging -- it only reshapes what those already\n21\tcompute, plus two new attested-report stores, into one timeline.\n22\t\n23\t``build_timeline`` is the main entry point; ``add_symptom``/``symptoms``/\n24\t``hide_symptom`` and ``code_feel`` back the router in ``cuore/api/timeline.py``.\n25\t\"\"\"\n26\t\n27\tfrom __future__ import annotations\n28\t\n29\timport re\n30\tfrom datetime import datetime, timedelta\n31\tfrom typing import Any, Optional\n32\t\n33\tfrom .. import bootstrap  # noqa: F401  -- side effect: puts `mes` on sys.path\n34\tfrom . import mes_bridge\n35\tfrom .errors import BadRequest\n36\tfrom ..live import store as live_store\n37\t\n38\tfrom mes import code_feel as code_feel_mod  # noqa: E402\n39\tfrom mes import service as service_mod  # noqa: E402\n40\tfrom mes import symptoms as symptoms_mod  # noqa: E402\n41\tfrom mes.symptoms import CONDITIONS, SYMPTOM_TAGS  # noqa: E402\n42\t\n43\t#: EVAP codes this car's corpus and TSB catalogue recognise as one system\n44\t#: fault. P0457 (fuel cap) is included here even though ``mes.knowledge``'s\n45\t#: own ``EVAP_FAMILY`` omits it -- the timeline's EVAP lane is about \"any\n46\t#: EVAP leak/purge code\", not the narrower TSB-cross-reference family.\n47\t_EVAP_CODES = frozenset({\"P0440\", \"P0441\", \"P0455\", \"P0456\", \"P0457\", \"P1CEA\"})\n48\t\n49\t#: How close a symptom report has to sit to a code occurrence to count as\n50\t#: \"near\" it, in either direction.\n51\tWINDOW_DAYS = 3\n52\t\n53\t_DRIVABILITY_TAGS = frozenset({\"rough_idle\", \"hesitation\", \"loss_of_power\", \"hard_start\"})\n54\t\n55\t_LANE_LABELS = {\n56\t    \"mil\": \"MIL (check-engine light)\",\n57\t    \"evap\": \"EVAP\",\n58\t    \"network\": \"Network / communication\",\n59\t    \"body\": \"Body\",\n60\t    \"chassis\": \"Chassis\",\n61\t    \"engine_other\": \"Engine (other)\",\n62\t    \"clears\": \"Clears\",\n63\t    \"symptoms\": \"Reported symptoms\",\n64\t    \"notes\": \"Technician notes\",\n65\t    \"work\": \"Work performed\",\n66\t    \"conditions\": \"Conditions at code-set\",\n67\t}\n68\t_LANE_KIND = {\n69\t    \"mil\": \"points\", \"evap\": \"bars\", \"network\": \"bars\", \"body\": \"bars\",\n70\t    \"chassis\": \"bars\", \"engine_other\": \"bars\", \"clears\": \"points\",\n71\t    \"symptoms\": \"points\", \"notes\": \"points\", \"work\": \"points\",\n72\t    \"conditions\": \"points\",\n73\t}\n74\t_FAMILY_DISPLAY = {\"evap\": \"EVAP\", \"network\": \"network\", \"body\": \"body\",\n75\t                  \"chassis\": \"chassis\", \"engine_other\": \"engine_other\"}\n76\t\n77\t_BASE_RE = re.compile(r\"^([PBCU][0-9A-F]{4})\", re.IGNORECASE)\n78\t\n79\t\n80\tdef _base(code: str) -> str:\n81\t    m = _BASE_RE.match((code or \"\").strip().upper())\n82\t    return m.group(1) if m else (code or \"\").strip().upper()\n83\t\n84\t\n85\tdef _num(display: Any) -> Optional[float]:\n86\t    if display is None:\n87\t        return None\n88\t    m = re.match(r\"\\s*(-?\\d+(?:\\.\\d+)?)\", str(display))\n89\t    return float(m.group(1)) if m else None\n90\t\n91\t\n92\tdef _parse_dt(s: Any) -> Optional[datetime]:\n93\t    \"\"\"Tolerant parse of the handful of timestamp shapes in play here:\n94\t    MES's ``YYYY-MM-DD HH:MM:SS``, a symptom's ISO ``...T...`` or\n95\t    ``...  ...``, or a bare date.\"\"\"\n96\t    if not s:\n97\t        return None\n98\t    text = str(s).strip().replace(\"T\", \" \")\n99\t    if len(text) == 10:\n100\t        text += \" 00:00:00\"\n101\t    try:\n102\t        return datetime.strptime(text[:19], \"%Y-%m-%d %H:%M:%S\")\n103\t    except ValueError:\n104\t        return None\n105\t\n106\t\n107\tdef _family_of(base: str) -> str:\n108\t    if base in _EVAP_CODES:\n109\t        return \"evap\"\n110\t    letter = base[:1]\n111\t    if letter == \"U\":\n112\t        return \"network\"\n113\t    if letter == \"B\":\n114\t        return \"body\"\n115\t    if letter == \"C\":\n116\t        return \"chassis\"\n117\t    return \"engine_other\"\n118\t\n119\t\n120\t# --- symptom reports (mes.symptoms) ------------------------------------------\n121\t\n122\t\n123\tdef add_symptom(vin: str, at: str, *, odometer_km: Optional[float] = None,\n124\t                reporter: str = \"driver\", tags: Optional[list[str]] = None,\n125\t                conditions: Optional[list[str]] = None,\n126\t                text: str = \"\") -> dict[str, Any]:\n127\t    \"\"\"Record what a person actually felt. Raises :class:`BadRequest` on any\n128\t    validation error -- unknown tag/condition, drives_normally combined with\n129\t    a drivability tag, missing vin/at.\"\"\"\n130\t    if not vin.strip():\n131\t        raise BadRequest(\"a VIN is required\")\n132\t    try:\n133\t        return symptoms_mod.add(vin, at, odometer_km=odometer_km, reporter=reporter,\n134\t                                tags=tags, conditions=conditions, text=text)\n135\t    except ValueError as exc:\n136\t        raise BadRequest(str(exc)) from exc\n137\t\n138\t\n139\tdef symptoms(vin: str, *, include_hidden: bool = False) -> dict[str, Any]:\n140\t    \"\"\"Symptom reports for this VIN, oldest first.\"\"\"\n141\t    if not vin.strip():\n142\t        raise BadRequest(\"a VIN is required\")\n143\t    return {\"vin\": vin, \"symptoms\": symptoms_mod.load(vin, include_hidden=include_hidden)}\n144\t\n145\t\n146\tdef hide_symptom(id: str) -> dict[str, Any]:\n147\t    \"\"\"Hide a symptom report (soft delete). Never rewrites history.\"\"\"\n148\t    try:\n149\t        return symptoms_mod.hide(id)\n150\t    except ValueError as exc:\n151\t        raise BadRequest(str(exc)) from exc\n152\t\n153\t\n154\t# --- \"what would the driver feel\" + this car's own pattern ------------------\n155\t\n156\t\n157\tdef _pattern_for(occurrences: int, occurrence_dts: list[Optional[datetime]],\n158\t                 all_symptoms: list[dict[str, Any]],\n159\t                 *, window_days: int = WINDOW_DAYS) -> dict[str, Any]:\n160\t    \"\"\"How this car's own symptom reports sit against one set of code\n161\t    occurrences -- shared by the per-code ``code_feel`` endpoint and the\n162\t    per-family ``correlation`` entries in :func:`build_timeline`.\n163\t\n164\t    ``occurrences`` is the caller's own count of distinct sessions (a\n165\t    session can hold several of a family's codes at once, so it is not\n166\t    simply ``len(occurrence_dts)``); ``occurrence_dts`` is only used here to\n167\t    find symptom reports that fall within ``window_days`` of any of them.\n168\t    \"\"\"\n169\t    window = timedelta(days=window_days)\n170\t    near: list[dict[str, Any]] = []\n171\t    for s in all_symptoms:\n172\t        sdt = _parse_dt(s.get(\"at\"))\n173\t        if sdt is None:\n174\t            continue\n175\t        if any(odt is not None and abs(sdt - odt) <= window for odt in occurrence_dts):\n176\t            near.append(s)\n177\t\n178\t    by_tag: dict[str, int] = {}\n179\t    drives_normally_near = 0\n180\t    for s in near:\n181\t        tags = s.get(\"tags\") or []\n182\t        if \"drives_normally\" in tags:\n183\t            drives_normally_near += 1\n184\t        for t in tags:\n185\t            by_tag[t] = by_tag.get(t, 0) + 1\n186\t\n187\t    return {\n188\t        \"occurrences\": occurrences,\n189\t        \"symptom_reports_near\": len(near),\n190\t        \"by_tag\": by_tag,\n191\t        \"drives_normally_near\": drives_normally_near,\n192\t    }\n193\t\n194\t\n195\tdef _verdict_for(pattern: dict[str, Any]) -> str:\n196\t    if pattern[\"symptom_reports_near\"] == 0:\n197\t        return \"no symptom reports yet\"\n198\t    other_tags = {t: c for t, c in pattern[\"by_tag\"].items()\n199\t                  if t != \"drives_normally\" and c > 0}\n200\t    if not other_tags:\n201\t        return \"no reported symptom\"\n202\t    top = sorted(other_tags, key=lambda t: (-other_tags[t], t))\n203\t    return \"co-occurs with \" + \", \".join(top[:3])\n204\t\n205\t\n206\tdef code_feel(vin: str, code: str) -> dict[str, Any]:\n207\t    \"\"\"\"What would the driver feel?\" for one code, next to what this car's\n208\t    own symptom reports actually say near its occurrences.\n209\t\n210\t    Passes ``include_siblings=True`` into ``mes.code_feel.lookup`` so a\n211\t    sourced sibling-platform (Grecale/Levante) finding would be returned\n212\t    under ``feel[\"siblings\"]``, each labeled \"from <Model> code_feel:\n213\t    verify fit\" via this VIN's own model (``mes.platform.model_for_vin``).\n214\t    ``mes.code_feel`` currently tags nothing to a sibling model (every\n215\t    entry there is a physical/engineering finding, not vehicle-specific --\n216\t    see its module docstring), so ``siblings`` is always ``[]`` today.\n217\t    \"\"\"\n218\t    if not vin.strip():\n219\t        raise BadRequest(\"a VIN is required\")\n220\t    base = _base(code)\n221\t    feel = code_feel_mod.lookup(base, include_siblings=True)\n222\t    if feel is not None:\n223\t        try:\n224\t            from mes import platform as platform_mod\n225\t            model = platform_mod.model_for_vin(vin)\n226\t        except Exception:  # noqa: BLE001\n227\t            model = None\n228\t        if model and model != platform_mod.UNKNOWN:\n229\t            for sib in feel.get(\"siblings\", []):\n230\t                sib_of = sib.get(\"sibling_of\")\n231\t                if sib_of:\n232\t                    sib[\"label\"] = f\"from {str(sib_of).title()} code_feel: verify fit\"\n233\t\n234\t    occ_dts: list[Optional[datetime]] = []\n235\t    occ_files: set[str] = set()\n236\t    try:\n237\t        dossier = mes_bridge.workup(vin=vin)\n238\t    except Exception:  # noqa: BLE001 -- a code page must still render with no corpus\n239\t        dossier = {}\n240\t    history = dossier.get(\"history\") or {}\n241\t    for bucket in (\"chronic\", \"returned_after_clear\", \"seen_once\"):\n242\t        for rec in history.get(bucket, []):\n243\t            if _base(rec.get(\"dtc\", \"\")) != base:\n244\t                continue\n245\t            for occ in rec.get(\"occurrences\", []):\n246\t                occ_dts.append(_parse_dt(occ.get(\"timestamp\")))\n247\t                if occ.get(\"file\"):\n248\t                    occ_files.add(occ[\"file\"])\n249\t\n250\t    all_symptoms = symptoms_mod.load(vin)\n251\t    occurrences = len(occ_files) if occ_files else len([d for d in occ_dts if d is not None])\n252\t    pattern = _pattern_for(occurrences, occ_dts, all_symptoms)\n253\t    return {\"code\": base, \"feel\": feel, \"pattern\": pattern}\n254\t\n255\t\n256\t# --- lane builders ------------------------------------------------------------\n257\t\n258\t\n259\tdef _family_occurrences(dossier: dict[str, Any]) -> dict[str, list[dict[str, Any]]]:\n260\t    \"\"\"Every DTC occurrence in this car's real-log history, grouped by the\n261\t    timeline's code-family lanes. One entry per (code, session).\"\"\"\n262\t    by_family: dict[str, list[dict[str, Any]]] = {\n263\t        \"evap\": [], \"network\": [], \"body\": [], \"chassis\": [], \"engine_other\": [],\n264\t    }\n265\t    history = dossier.get(\"history\") or {}\n266\t    for bucket in (\"chronic\", \"returned_after_clear\", \"seen_once\"):\n267\t        for rec in history.get(bucket, []):\n268\t            base = _base(rec.get(\"dtc\", \"\"))\n269\t            if not base:\n270\t                continue\n271\t            family = _family_of(base)\n272\t            for occ in rec.get(\"occurrences\", []):\n273\t                by_family[family].append({\n274\t                    \"ts\": occ.get(\"timestamp\"), \"code\": base,\n275\t                    \"status\": occ.get(\"status\"), \"odo\": occ.get(\"odometer_km\"),\n276\t                    \"file\": occ.get(\"file\"),\n277\t                })\n278\t    for fam in by_family:\n279\t        by_family[fam].sort(key=lambda o: o[\"ts\"] or \"\")\n280\t    return by_family\n281\t\n282\t\n283\tdef _split_runs(occs: list[dict[str, Any]]) -> list[list[dict[str, Any]]]:\n284\t    \"\"\"Contiguous sightings, split wherever a session ended with the code\n285\t    cleared and not immediately returning -- a clear closes the run; a\n286\t    ``returned`` status continues it (the fault reproduced).\"\"\"\n287\t    runs: list[list[dict[str, Any]]] = []\n288\t    current: list[dict[str, Any]] = []\n289\t    for occ in occs:\n290\t        current.append(occ)\n291\t        if occ.get(\"status\") == \"cleared\":\n292\t            runs.append(current)\n293\t            current = []\n294\t    if current:\n295\t        runs.append(current)\n296\t    return runs\n297\t\n298\t\n299\tdef _run_event(run: list[dict[str, Any]]) -> dict[str, Any]:\n300\t    codes = sorted({o[\"code\"] for o in run})\n301\t    files = sorted({o[\"file\"] for o in run if o.get(\"file\")})\n302\t    t = run[0][\"ts\"]\n303\t    t_end = run[-1][\"ts\"] if run[-1][\"ts\"] != t else None\n304\t    last_status = run[-1].get(\"status\")\n305\t    if last_status == \"cleared\":\n306\t        severity = \"cleared\"\n307\t    elif last_status in (\"returned\", \"stored\", \"uncleared\"):\n308\t        severity = \"active\"\n309\t    else:\n310\t        severity = \"info\"\n311\t    odo_vals = [o[\"odo\"] for o in run if o.get(\"odo\") is not None]\n312\t    return {\n313\t        \"t\": t, \"t_end\": t_end, \"odo\": (odo_vals[0] if odo_vals else None),\n314\t        \"label\": \"/\".join(codes),\n315\t        \"detail\": f\"{len(files) or len(run)} session(s): \" + \", \".join(codes),\n316\t        \"severity\": severity, \"href\": None,\n317\t    }\n318\t\n319\t\n320\tdef _family_lane(family: str, occs: list[dict[str, Any]]) -> dict[str, Any]:\n321\t    events = [_run_event(run) for run in _split_runs(occs)]\n322\t    return {\"id\": family, \"label\": _LANE_LABELS[family], \"kind\": _LANE_KIND[family],\n323\t           \"events\": events}\n324\t\n325\t\n326\tdef _mil_lane(vin: str) -> dict[str, Any]:\n327\t    events: list[dict[str, Any]] = []\n328\t    try:\n329\t        obs = live_store.recent_observations(200, vin=vin, kind=\"readiness\")\n330\t    except Exception:  # noqa: BLE001 -- the timeline must render without a live link\n331\t        obs = []\n332\t    for o in obs:\n333\t        if not live_store.is_from_car(o):\n334\t            continue\n335\t        since = (o.get(\"data\") or {}).get(\"since_clear\") or {}\n336\t        mil_on = since.get(\"mil_on\")\n337\t        if mil_on is None:\n338\t            continue\n339\t        events.append({\n340\t            \"t\": o.get(\"at\"), \"t_end\": None, \"odo\": None,\n341\t            \"label\": \"MIL ON\" if mil_on else \"MIL OFF\",\n342\t            \"detail\": \"live readiness read\" + (f\" ({o['at']})\" if o.get(\"at\") else \"\"),\n343\t            \"severity\": \"active\" if mil_on else \"info\", \"href\": None,\n344\t        })\n345\t    if not events:\n346\t        return {\"id\": \"mil\", \"label\": _LANE_LABELS[\"mil\"], \"kind\": _LANE_KIND[\"mil\"],\n347\t               \"events\": [], \"detail\": \"MIL state not in the logs\"}\n348\t    return {\"id\": \"mil\", \"label\": _LANE_LABELS[\"mil\"], \"kind\": _LANE_KIND[\"mil\"],\n349\t           \"events\": events}\n350\t\n351\t\n352\tdef _clears_lane(by_family: dict[str, list[dict[str, Any]]]) -> dict[str, Any]:\n353\t    by_ts: dict[str, set[str]] = {}\n354\t    for occs in by_family.values():\n355\t        for o in occs:\n356\t            if o.get(\"status\") == \"cleared\" and o.get(\"ts\"):\n357\t                by_ts.setdefault(o[\"ts\"], set()).add(o[\"code\"])\n358\t    events = [\n359\t        {\"t\": ts, \"t_end\": None, \"odo\": None,\n360\t         \"label\": \"cleared: \" + \", \".join(sorted(codes)),\n361\t         \"detail\": \", \".join(sorted(codes)) + \" cleared\", \"severity\": \"cleared\",\n362\t         \"href\": None}\n363\t        for ts, codes in sorted(by_ts.items())\n364\t    ]\n365\t    return {\"id\": \"clears\", \"label\": _LANE_LABELS[\"clears\"], \"kind\": _LANE_KIND[\"clears\"],\n366\t           \"events\": events}\n367\t\n368\t\n369\tdef _symptoms_lane(all_symptoms: list[dict[str, Any]]) -> dict[str, Any]:\n370\t    events = []\n371\t    for s in all_symptoms:\n372\t        tags = s.get(\"tags\") or []\n373\t        normal = \"drives_normally\" in tags\n374\t        label = \"drives normally\" if normal else (\", \".join(tags) or \"symptom reported\")\n375\t        events.append({\n376\t            \"t\": s.get(\"at\"), \"t_end\": None, \"odo\": s.get(\"odometer_km\"),\n377\t            \"label\": label, \"detail\": s.get(\"text\") or label,\n378\t            \"severity\": \"no_symptom\" if normal else \"symptom\", \"href\": None,\n379\t        })\n380\t    return {\"id\": \"symptoms\", \"label\": _LANE_LABELS[\"symptoms\"],\n381\t           \"kind\": _LANE_KIND[\"symptoms\"], \"events\": events}\n382\t\n383\t\n384\tdef _notes_lane(vin: str) -> dict[str, Any]:\n385\t    events = []\n386\t    try:\n387\t        for n in mes_bridge.notes(vin).get(\"notes\", []):\n388\t            text = n.get(\"text\") or \"\"\n389\t            events.append({\n390\t                \"t\": n.get(\"at\"), \"t_end\": None, \"odo\": None,\n391\t                \"label\": (text[:60] + \"...\") if len(text) > 60 else text,\n392\t                \"detail\": text, \"severity\": \"info\", \"href\": None,\n393\t            })\n394\t    except Exception:  # noqa: BLE001\n395\t        pass\n396\t    return {\"id\": \"notes\", \"label\": _LANE_LABELS[\"notes\"], \"kind\": _LANE_KIND[\"notes\"],\n397\t           \"events\": events}\n398\t\n399\t\n400\tdef _work_lane(vin: str) -> dict[str, Any]:\n401\t    events = []\n402\t    for rec in service_mod.load(vin):\n403\t        data = rec.get(\"data\") or {}\n404\t        label = f\"service: {rec.get('kind')}\"\n405\t        detail = data.get(\"work_done\") or data.get(\"category\") or rec.get(\"kind\") or \"\"\n406\t        events.append({\n407\t            \"t\": rec.get(\"at\") or data.get(\"date\"), \"t_end\": None,\n408\t            \"odo\": data.get(\"odometer_km\"), \"label\": label, \"detail\": detail,\n409\t            \"severity\": \"work\", \"href\": None,\n410\t        })\n411\t\n412\t    try:\n413\t        runs = mes_bridge.actuator_history(vin=vin).get(\"runs\", [])\n414\t    except Exception:  # noqa: BLE001\n415\t        runs = []\n416\t    by_day: dict[str, list[dict[str, Any]]] = {}\n417\t    for r in runs:\n418\t        ts = r.get(\"timestamp\") or \"\"\n419\t        day = ts[:10]\n420\t        if not day:\n421\t            continue\n422\t        by_day.setdefault(day, []).append(r)\n423\t    for day, day_runs in by_day.items():\n424\t        ops = sorted({r.get(\"operation\") or \"\" for r in day_runs if r.get(\"operation\")})\n425\t        events.append({\n426\t            \"t\": min(r.get(\"timestamp\") or (day + \" 00:00:00\") for r in day_runs),\n427\t            \"t_end\": None, \"odo\": None,\n428\t            \"label\": f\"{len(day_runs)} actuator test(s)/adjustment(s)\",\n429\t            \"detail\": \", \".join(ops) or \"actuator tests/adjustments\",\n430\t            \"severity\": \"work\", \"href\": None,\n431\t        })\n432\t\n433\t    try:\n434\t        dealer_results = mes_bridge.dealer_results(vin).get(\"results\", [])\n435\t    except Exception:  # noqa: BLE001\n436\t        dealer_results = []\n437\t    for rec in dealer_results:\n438\t        events.append({\n439\t            \"t\": rec.get(\"at\"), \"t_end\": None, \"odo\": None,\n440\t            \"label\": f\"dealer: {rec.get('kind')}\",\n441\t            \"detail\": rec.get(\"note\") or str(rec.get(\"data\") or \"\"),\n442\t            \"severity\": \"work\", \"href\": None,\n443\t        })\n444\t\n445\t    events.sort(key=lambda e: e.get(\"t\") or \"\")\n446\t    return {\"id\": \"work\", \"label\": _LANE_LABELS[\"work\"], \"kind\": _LANE_KIND[\"work\"],\n447\t           \"events\": events}\n448\t\n449\t\n450\tdef _conditions_lane(vin: str) -> tuple[dict[str, Any], list[dict[str, Any]]]:\n451\t    \"\"\"The conditions lane, plus the raw warn-flagged rows (for ``findings``).\"\"\"\n452\t    events = []\n453\t    warnings: list[dict[str, Any]] = []\n454\t    try:\n455\t        frames = mes_bridge.freeze_frames(vin=vin).get(\"frames\", [])\n456\t    except Exception:  # noqa: BLE001 -- NotFound when nothing has a freeze frame\n457\t        frames = []\n458\t    for f in frames:\n459\t        ff = f.get(\"freeze_frame\") or {}\n460\t        fuel = _num(ff.get(\"Fuel level\"))\n461\t        temp = _num(ff.get(\"Engine temperature\"))\n462\t        cold = bool(temp is not None and temp < 40)\n463\t        parts = []\n464\t        flag = None\n465\t        if fuel is not None:\n466\t            parts.append(f\"fuel {fuel:.0f}%\")\n467\t            if not (15 <= fuel <= 85):\n468\t                bound = \"below 15%\" if fuel < 15 else \"above 85%\"\n469\t                flag = f\"fuel {fuel:.0f}% is {bound} -- EVAP monitor cannot run\"\n470\t                warnings.append({\"code\": _base(f.get(\"dtc\") or \"\"), \"fuel\": fuel})\n471\t        if temp is not None:\n472\t            parts.append(f\"engine temp {temp:.0f} C\" + (\" (cold start)\" if cold else \"\"))\n473\t        detail = flag or (\", \".join(parts) or \"no fuel/engine-temperature fields captured\")\n474\t        events.append({\n475\t            \"t\": f.get(\"timestamp\"), \"t_end\": None, \"odo\": None,\n476\t            \"label\": f\"{f.get('dtc')} freeze frame\", \"detail\": detail,\n477\t            \"severity\": \"warn\" if flag else \"info\", \"href\": None,\n478\t        })\n479\t    lane = {\"id\": \"conditions\", \"label\": _LANE_LABELS[\"conditions\"],\n480\t           \"kind\": _LANE_KIND[\"conditions\"], \"events\": events}\n481\t    return lane, warnings\n482\t\n483\t\n484\t# --- the one entry point ------------------------------------------------------\n485\t\n486\t\n487\tdef build_timeline(vin: str) -> dict[str, Any]:\n488\t    \"\"\"Everything the mechanic-vs-driver timeline page needs, in one call.\n489\t\n490\t    Only real data: every lane is built from the real-log corpus (simulation\n491\t    excluded by ``mes.catalog``'s own default), the live link's own\n492\t    observations, and the technician-entered stores -- nothing here\n493\t    synthesises a code occurrence or a symptom that was not actually\n494\t    recorded.\n495\t    \"\"\"\n496\t    if not vin.strip():\n497\t        raise BadRequest(\"a VIN is required\")\n498\t\n499\t    dossier = mes_bridge.workup(vin=vin)\n500\t    identity = dossier.get(\"identity\") or {}\n501\t    all_symptoms = symptoms_mod.load(vin)\n502\t\n503\t    by_family = _family_occurrences(dossier)\n504\t\n505\t    lanes = [\n506\t        _mil_lane(vin),\n507\t        _family_lane(\"evap\", by_family[\"evap\"]),\n508\t        _family_lane(\"network\", by_family[\"network\"]),\n509\t        _family_lane(\"body\", by_family[\"body\"]),\n510\t        _family_lane(\"chassis\", by_family[\"chassis\"]),\n511\t        _family_lane(\"engine_other\", by_family[\"engine_other\"]),\n512\t        _clears_lane(by_family),\n513\t        _symptoms_lane(all_symptoms),\n514\t        _notes_lane(vin),\n515\t        _work_lane(vin),\n516\t    ]\n517\t    conditions_lane, fuel_warnings = _conditions_lane(vin)\n518\t    lanes.append(conditions_lane)\n519\t\n520\t    correlation: list[dict[str, Any]] = []\n521\t    findings: list[str] = []\n522\t    for family, occs in by_family.items():\n523\t        if not occs:\n524\t            continue\n525\t        occ_dts = [_parse_dt(o[\"ts\"]) for o in occs]\n526\t        occurrences = len({o[\"file\"] for o in occs if o.get(\"file\")}) or len(occs)\n527\t        pattern = _pattern_for(occurrences, occ_dts, all_symptoms)\n528\t        if pattern[\"occurrences\"] == 0:\n529\t            continue\n530\t        verdict = _verdict_for(pattern)\n531\t        codes = sorted({o[\"code\"] for o in occs})\n532\t        display = _FAMILY_DISPLAY[family]\n533\t        correlation.append({\n534\t            \"family\": display, \"codes\": codes, \"occurrences\": pattern[\"occurrences\"],\n535\t            \"symptom_reports_near\": pattern[\"symptom_reports_near\"],\n536\t            \"by_tag\": pattern[\"by_tag\"], \"drives_normally_near\": pattern[\"drives_normally_near\"],\n537\t            \"window_days\": WINDOW_DAYS, \"verdict\": verdict,\n538\t        })\n539\t        if verdict == \"no symptom reports yet\":\n540\t            findings.append(\n541\t                f\"{display} codes appeared in {pattern['occurrences']} session(s); \"\n542\t                f\"no driver symptom has been reported yet.\")\n543\t        elif verdict == \"no reported symptom\":\n544\t            findings.append(\n545\t                f\"{display} codes appeared in {pattern['occurrences']} session(s); \"\n546\t                f\"no driver symptom was reported within {WINDOW_DAYS} days of any of them.\")\n547\t        elif verdict.startswith(\"co-occurs\"):\n548\t            findings.append(f\"{display} codes {verdict} within {WINDOW_DAYS} days.\")\n549\t\n550\t    if fuel_warnings:\n551\t        codes = []\n552\t        for w in fuel_warnings:\n553\t            if w[\"code\"] not in codes:\n554\t                codes.append(w[\"code\"])\n555\t        fuels = sorted(w[\"fuel\"] for w in fuel_warnings)\n556\t        findings.append(\n557\t            f\"{' and '.join(codes)} were set with the tank \"\n558\t            f\"{fuels[0]:.0f}-{fuels[-1]:.0f} % full.\")\n559\t\n560\t    return {\n561\t        \"vin\": vin,\n562\t        \"range\": {\n563\t            \"start\": identity.get(\"first_log\"), \"end\": identity.get(\"last_log\"),\n564\t            \"odo_start\": identity.get(\"odometer_first_km\"),\n565\t            \"odo_end\": identity.get(\"odometer_last_km\"),\n566\t        },\n567\t        \"lanes\": lanes,\n568\t        \"correlation\": correlation,\n569\t        \"findings\": findings,\n570\t        \"symptom_tags\": list(SYMPTOM_TAGS),\n571\t        \"conditions\": list(CONDITIONS),\n572\t    }\n573\t\n574\t\n575\t__all__ = [\"WINDOW_DAYS\", \"add_symptom\", \"symptoms\", \"hide_symptom\", \"code_feel\",\n576\t          \"build_timeline\"]\n577\t"}]},"uuid":"b959f705-51ee-46ad-98ee-975d35e55384","timestamp":"2026-10-08T03:03:40.137Z","toolUseResult":{"type":"text","file":{"filePath":"C:\\Users\\User\\mcp-servers\\cuore\\services\\timeline_bridge.py","content":"\"\"\"The mechanic-vs-driver timeline: codes on one axis, what was actually felt\non the other.\n\nThe dossier (``dossier_bridge``) answers \"what is wrong with this car right\nnow\". This module answers a different question a mechanic needs before ever\ntouching a wrench: across the whole history, which codes lined up with a\ndriver noticing something, and which never did? For EVAP in particular the\nhonest answer is almost always \"nothing was ever felt\" -- the fault is real,\nthe codes keep returning, and there is still no complaint to chase. Burying\nthat fact inside a code table invites a mechanic to go looking for a\ndrivability symptom that was never there; ``build_timeline`` makes the\nabsence itself the headline finding.\n\nLike ``dossier_bridge``, this is a ``cuore/services/*_bridge.py`` module, so\nit is allowed to import the ``mes`` package directly (``mes.symptoms`` and\n``mes.code_feel`` are new, small, and have no existing bridge; ``mes.service``\nis read the same way ``service_bridge.py`` already reads it) alongside the\n``mes_bridge``/``service_bridge`` facades for everything that already has\none. Nothing here re-implements chronic/returned classification, TSB\nmatching or freeze-frame flagging -- it only reshapes what those already\ncompute, plus two new attested-report stores, into one timeline.\n\n``build_timeline`` is the main entry point; ``add_symptom``/``symptoms``/\n``hide_symptom`` and ``code_feel`` back the router in ``cuore/api/timeline.py``.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport re\nfrom datetime import datetime, timedelta\nfrom typing import Any, Optional\n\nfrom .. import bootstrap  # noqa: F401  -- side effect: puts `mes` on sys.path\nfrom . import mes_bridge\nfrom .errors import BadRequest\nfrom ..live import store as live_store\n\nfrom mes import code_feel as code_feel_mod  # noqa: E402\nfrom mes import service as service_mod  # noqa: E402\nfrom mes import symptoms as symptoms_mod  # noqa: E402\nfrom mes.symptoms import CONDITIONS, SYMPTOM_TAGS  # noqa: E402\n\n#: EVAP codes this car's corpus and TSB catalogue recognise as one system\n#: fault. P0457 (fuel cap) is included here even though ``mes.knowledge``'s\n#: own ``EVAP_FAMILY`` omits it -- the timeline's EVAP lane is about \"any\n#: EVAP leak/purge code\", not the narrower TSB-cross-reference family.\n_EVAP_CODES = frozenset({\"P0440\", \"P0441\", \"P0455\", \"P0456\", \"P0457\", \"P1CEA\"})\n\n#: How close a symptom report has to sit to a code occurrence to count as\n#: \"near\" it, in either direction.\nWINDOW_DAYS = 3\n\n_DRIVABILITY_TAGS = frozenset({\"rough_idle\", \"hesitation\", \"loss_of_power\", \"hard_start\"})\n\n_LANE_LABELS = {\n    \"mil\": \"MIL (check-engine light)\",\n    \"evap\": \"EVAP\",\n    \"network\": \"Network / communication\",\n    \"body\": \"Body\",\n    \"chassis\": \"Chassis\",\n    \"engine_other\": \"Engine (other)\",\n    \"clears\": \"Clears\",\n    \"symptoms\": \"Reported symptoms\",\n    \"notes\": \"Technician notes\",\n    \"work\": \"Work performed\",\n    \"conditions\": \"Conditions at code-set\",\n}\n_LANE_KIND = {\n    \"mil\": \"points\", \"evap\": \"bars\", \"network\": \"bars\", \"body\": \"bars\",\n    \"chassis\": \"bars\", \"engine_other\": \"bars\", \"clears\": \"points\",\n    \"symptoms\": \"points\", \"notes\": \"points\", \"work\": \"points\",\n    \"conditions\": \"points\",\n}\n_FAMILY_DISPLAY = {\"evap\": \"EVAP\", \"network\": \"network\", \"body\": \"body\",\n                  \"chassis\": \"chassis\", \"engine_other\": \"engine_other\"}\n\n_BASE_RE = re.compile(r\"^([PBCU][0-9A-F]{4})\", re.IGNORECASE)\n\n\ndef _base(code: str) -> str:\n    m = _BASE_RE.match((code or \"\").strip().upper())\n    return m.group(1) if m else (code or \"\").strip().upper()\n\n\ndef _num(display: Any) -> Optional[float]:\n    if display is None:\n        return None\n    m = re.match(r\"\\s*(-?\\d+(?:\\.\\d+)?)\", str(display))\n    return float(m.group(1)) if m else None\n\n\ndef _parse_dt(s: Any) -> Optional[datetime]:\n    \"\"\"Tolerant parse of the handful of timestamp shapes in play here:\n    MES's ``YYYY-MM-DD HH:MM:SS``, a symptom's ISO ``...T...`` or\n    ``...  ...``, or a bare date.\"\"\"\n    if not s:\n        return None\n    text = str(s).strip().replace(\"T\", \" \")\n    if len(text) == 10:\n        text += \" 00:00:00\"\n    try:\n        return datetime.strptime(text[:19], \"%Y-%m-%d %H:%M:%S\")\n    except ValueError:\n        return None\n\n\ndef _family_of(base: str) -> str:\n    if base in _EVAP_CODES:\n        return \"evap\"\n    letter = base[:1]\n    if letter == \"U\":\n        return \"network\"\n    if letter == \"B\":\n        return \"body\"\n    if letter == \"C\":\n        return \"chassis\"\n    return \"engine_other\"\n\n\n# --- symptom reports (mes.symptoms) ------------------------------------------\n\n\ndef add_symptom(vin: str, at: str, *, odometer_km: Optional[float] = None,\n                reporter: str = \"driver\", tags: Optional[list[str]] = None,\n                conditions: Optional[list[str]] = None,\n                text: str = \"\") -> dict[str, Any]:\n    \"\"\"Record what a person actually felt. Raises :class:`BadRequest` on any\n    validation error -- unknown tag/condition, drives_normally combined with\n    a drivability tag, missing vin/at.\"\"\"\n    if not vin.strip():\n        raise BadRequest(\"a VIN is required\")\n    try:\n        return symptoms_mod.add(vin, at, odometer_km=odometer_km, reporter=reporter,\n                                tags=tags, conditions=conditions, text=text)\n    except ValueError as exc:\n        raise BadRequest(str(exc)) from exc\n\n\ndef symptoms(vin: str, *, include_hidden: bool = False) -> dict[str, Any]:\n    \"\"\"Symptom reports for this VIN, oldest first.\"\"\"\n    if not vin.strip():\n        raise BadRequest(\"a VIN is required\")\n    return {\"vin\": vin, \"symptoms\": symptoms_mod.load(vin, include_hidden=include_hidden)}\n\n\ndef hide_symptom(id: str) -> dict[str, Any]:\n    \"\"\"Hide a symptom report (soft delete). Never rewrites history.\"\"\"\n    try:\n        return symptoms_mod.hide(id)\n    except ValueError as exc:\n        raise BadRequest(str(exc)) from exc\n\n\n# --- \"what would the driver feel\" + this car's own pattern ------------------\n\n\ndef _pattern_for(occurrences: int, occurrence_dts: list[Optional[datetime]],\n                 all_symptoms: list[dict[str, Any]],\n                 *, window_days: int = WINDOW_DAYS) -> dict[str, Any]:\n    \"\"\"How this car's own symptom reports sit against one set of code\n    occurrences -- shared by the per-code ``code_feel`` endpoint and the\n    per-family ``correlation`` entries in :func:`build_timeline`.\n\n    ``occurrences`` is the caller's own count of distinct sessions (a\n    session can hold several of a family's codes at once, so it is not\n    simply ``len(occurrence_dts)``); ``occurrence_dts`` is only used here to\n    find symptom reports that fall within ``window_days`` of any of them.\n    \"\"\"\n    window = timedelta(days=window_days)\n    near: list[dict[str, Any]] = []\n    for s in all_symptoms:\n        sdt = _parse_dt(s.get(\"at\"))\n        if sdt is None:\n            continue\n        if any(odt is not None and abs(sdt - odt) <= window for odt in occurrence_dts):\n            near.append(s)\n\n    by_tag: dict[str, int] = {}\n    drives_normally_near = 0\n    for s in near:\n        tags = s.get(\"tags\") or []\n        if \"drives_normally\" in tags:\n            drives_normally_near += 1\n        for t in tags:\n            by_tag[t] = by_tag.get(t, 0) + 1\n\n    return {\n        \"occurrences\": occurrences,\n        \"symptom_reports_near\": len(near),\n        \"by_tag\": by_tag,\n        \"drives_normally_near\": drives_normally_near,\n    }\n\n\ndef _verdict_for(pattern: dict[str, Any]) -> str:\n    if pattern[\"symptom_reports_near\"] == 0:\n        return \"no symptom reports yet\"\n    other_tags = {t: c for t, c in pattern[\"by_tag\"].items()\n                  if t != \"drives_normally\" and c > 0}\n    if not other_tags:\n        return \"no reported symptom\"\n    top = sorted(other_tags, key=lambda t: (-other_tags[t], t))\n    return \"co-occurs with \" + \", \".join(top[:3])\n\n\ndef code_feel(vin: str, code: str) -> dict[str, Any]:\n    \"\"\"\"What would the driver feel?\" for one code, next to what this car's\n    own symptom reports actually say near its occurrences.\n\n    Passes ``include_siblings=True`` into ``mes.code_feel.lookup`` so a\n    sourced sibling-platform (Grecale/Levante) finding would be returned\n    under ``feel[\"siblings\"]``, each labeled \"from <Model> code_feel:\n    verify fit\" via this VIN's own model (``mes.platform.model_for_vin``).\n    ``mes.code_feel`` currently tags nothing to a sibling model (every\n    entry there is a physical/engineering finding, not vehicle-specific --\n    see its module docstring), so ``siblings`` is always ``[]`` today.\n    \"\"\"\n    if not vin.strip():\n        raise BadRequest(\"a VIN is required\")\n    base = _base(code)\n    feel = code_feel_mod.lookup(base, include_siblings=True)\n    if feel is not None:\n        try:\n            from mes import platform as platform_mod\n            model = platform_mod.model_for_vin(vin)\n        except Exception:  # noqa: BLE001\n            model = None\n        if model and model != platform_mod.UNKNOWN:\n            for sib in feel.get(\"siblings\", []):\n                sib_of = sib.get(\"sibling_of\")\n                if sib_of:\n                    sib[\"label\"] = f\"from {str(sib_of).title()} code_feel: verify fit\"\n\n    occ_dts: list[Optional[datetime]] = []\n    occ_files: set[str] = set()\n    try:\n        dossier = mes_bridge.workup(vin=vin)\n    except Exception:  # noqa: BLE001 -- a code page must still render with no corpus\n        dossier = {}\n    history = dossier.get(\"history\") or {}\n    for bucket in (\"chronic\", \"returned_after_clear\", \"seen_once\"):\n        for rec in history.get(bucket, []):\n            if _base(rec.get(\"dtc\", \"\")) != base:\n                continue\n            for occ in rec.get(\"occurrences\", []):\n                occ_dts.append(_parse_dt(occ.get(\"timestamp\")))\n                if occ.get(\"file\"):\n                    occ_files.add(occ[\"file\"])\n\n    all_symptoms = symptoms_mod.load(vin)\n    occurrences = len(occ_files) if occ_files else len([d for d in occ_dts if d is not None])\n    pattern = _pattern_for(occurrences, occ_dts, all_symptoms)\n    return {\"code\": base, \"feel\": feel, \"pattern\": pattern}\n\n\n# --- lane builders ------------------------------------------------------------\n\n\ndef _family_occurrences(dossier: dict[str, Any]) -> dict[str, list[dict[str, Any]]]:\n    \"\"\"Every DTC occurrence in this car's real-log history, grouped by the\n    timeline's code-family lanes. One entry per (code, session).\"\"\"\n    by_family: dict[str, list[dict[str, Any]]] = {\n        \"evap\": [], \"network\": [], \"body\": [], \"chassis\": [], \"engine_other\": [],\n    }\n    history = dossier.get(\"history\") or {}\n    for bucket in (\"chronic\", \"returned_after_clear\", \"seen_once\"):\n        for rec in history.get(bucket, []):\n            base = _base(rec.get(\"dtc\", \"\"))\n            if not base:\n                continue\n            family = _family_of(base)\n            for occ in rec.get(\"occurrences\", []):\n                by_family[family].append({\n                    \"ts\": occ.get(\"timestamp\"), \"code\": base,\n                    \"status\": occ.get(\"status\"), \"odo\": occ.get(\"odometer_km\"),\n                    \"file\": occ.get(\"file\"),\n                })\n    for fam in by_family:\n        by_family[fam].sort(key=lambda o: o[\"ts\"] or \"\")\n    return by_family\n\n\ndef _split_runs(occs: list[dict[str, Any]]) -> list[list[dict[str, Any]]]:\n    \"\"\"Contiguous sightings, split wherever a session ended with the code\n    cleared and not immediately returning -- a clear closes the run; a\n    ``returned`` status continues it (the fault reproduced).\"\"\"\n    runs: list[list[dict[str, Any]]] = []\n    current: list[dict[str, Any]] = []\n    for occ in occs:\n        current.append(occ)\n        if occ.get(\"status\") == \"cleared\":\n            runs.append(current)\n            current = []\n    if current:\n        runs.append(current)\n    return runs\n\n\ndef _run_event(run: list[dict[str, Any]]) -> dict[str, Any]:\n    codes = sorted({o[\"code\"] for o in run})\n    files = sorted({o[\"file\"] for o in run if o.get(\"file\")})\n    t = run[0][\"ts\"]\n    t_end = run[-1][\"ts\"] if run[-1][\"ts\"] != t else None\n    last_status = run[-1].get(\"status\")\n    if last_status == \"cleared\":\n        severity = \"cleared\"\n    elif last_status in (\"returned\", \"stored\", \"uncleared\"):\n        severity = \"active\"\n    else:\n        severity = \"info\"\n    odo_vals = [o[\"odo\"] for o in run if o.get(\"odo\") is not None]\n    return {\n        \"t\": t, \"t_end\": t_end, \"odo\": (odo_vals[0] if odo_vals else None),\n        \"label\": \"/\".join(codes),\n        \"detail\": f\"{len(files) or len(run)} session(s): \" + \", \".join(codes),\n        \"severity\": severity, \"href\": None,\n    }\n\n\ndef _family_lane(family: str, occs: list[dict[str, Any]]) -> dict[str, Any]:\n    events = [_run_event(run) for run in _split_runs(occs)]\n    return {\"id\": family, \"label\": _LANE_LABELS[family], \"kind\": _LANE_KIND[family],\n           \"events\": events}\n\n\ndef _mil_lane(vin: str) -> dict[str, Any]:\n    events: list[dict[str, Any]] = []\n    try:\n        obs = live_store.recent_observations(200, vin=vin, kind=\"readiness\")\n    except Exception:  # noqa: BLE001 -- the timeline must render without a live link\n        obs = []\n    for o in obs:\n        if not live_store.is_from_car(o):\n            continue\n        since = (o.get(\"data\") or {}).get(\"since_clear\") or {}\n        mil_on = since.get(\"mil_on\")\n        if mil_on is None:\n            continue\n        events.append({\n            \"t\": o.get(\"at\"), \"t_end\": None, \"odo\": None,\n            \"label\": \"MIL ON\" if mil_on else \"MIL OFF\",\n            \"detail\": \"live readiness read\" + (f\" ({o['at']})\" if o.get(\"at\") else \"\"),\n            \"severity\": \"active\" if mil_on else \"info\", \"href\": None,\n        })\n    if not events:\n        return {\"id\": \"mil\", \"label\": _LANE_LABELS[\"mil\"], \"kind\": _LANE_KIND[\"mil\"],\n               \"events\": [], \"detail\": \"MIL state not in the logs\"}\n    return {\"id\": \"mil\", \"label\": _LANE_LABELS[\"mil\"], \"kind\": _LANE_KIND[\"mil\"],\n           \"events\": events}\n\n\ndef _clears_lane(by_family: dict[str, list[dict[str, Any]]]) -> dict[str, Any]:\n    by_ts: dict[str, set[str]] = {}\n    for occs in by_family.values():\n        for o in occs:\n            if o.get(\"status\") == \"cleared\" and o.get(\"ts\"):\n                by_ts.setdefault(o[\"ts\"], set()).add(o[\"code\"])\n    events = [\n        {\"t\": ts, \"t_end\": None, \"odo\": None,\n         \"label\": \"cleared: \" + \", \".join(sorted(codes)),\n         \"detail\": \", \".join(sorted(codes)) + \" cleared\", \"severity\": \"cleared\",\n         \"href\": None}\n        for ts, codes in sorted(by_ts.items())\n    ]\n    return {\"id\": \"clears\", \"label\": _LANE_LABELS[\"clears\"], \"kind\": _LANE_KIND[\"clears\"],\n           \"events\": events}\n\n\ndef _symptoms_lane(all_symptoms: list[dict[str, Any]]) -> dict[str, Any]:\n    events = []\n    for s in all_symptoms:\n        tags = s.get(\"tags\") or []\n        normal = \"drives_normally\" in tags\n        label = \"drives normally\" if normal else (\", \".join(tags) or \"symptom reported\")\n        events.append({\n            \"t\": s.get(\"at\"), \"t_end\": None, \"odo\": s.get(\"odometer_km\"),\n            \"label\": label, \"detail\": s.get(\"text\") or label,\n            \"severity\": \"no_symptom\" if normal else \"symptom\", \"href\": None,\n        })\n    return {\"id\": \"symptoms\", \"label\": _LANE_LABELS[\"symptoms\"],\n           \"kind\": _LANE_KIND[\"symptoms\"], \"events\": events}\n\n\ndef _notes_lane(vin: str) -> dict[str, Any]:\n    events = []\n    try:\n        for n in mes_bridge.notes(vin).get(\"notes\", []):\n            text = n.get(\"text\") or \"\"\n            events.append({\n                \"t\": n.get(\"at\"), \"t_end\": None, \"odo\": None,\n                \"label\": (text[:60] + \"...\") if len(text) > 60 else text,\n                \"detail\": text, \"severity\": \"info\", \"href\": None,\n            })\n    except Exception:  # noqa: BLE001\n        pass\n    return {\"id\": \"notes\", \"label\": _LANE_LABELS[\"notes\"], \"kind\": _LANE_KIND[\"notes\"],\n           \"events\": events}\n\n\ndef _work_lane(vin: str) -> dict[str, Any]:\n    events = []\n    for rec in service_mod.load(vin):\n        data = rec.get(\"data\") or {}\n        label = f\"service: {rec.get('kind')}\"\n        detail = data.get(\"work_done\") or data.get(\"category\") or rec.get(\"kind\") or \"\"\n        events.append({\n            \"t\": rec.get(\"at\") or data.get(\"date\"), \"t_end\": None,\n            \"odo\": data.get(\"odometer_km\"), \"label\": label, \"detail\": detail,\n            \"severity\": \"work\", \"href\": None,\n        })\n\n    try:\n        runs = mes_bridge.actuator_history(vin=vin).get(\"runs\", [])\n    except Exception:  # noqa: BLE001\n        runs = []\n    by_day: dict[str, list[dict[str, Any]]] = {}\n    for r in runs:\n        ts = r.get(\"timestamp\") or \"\"\n        day = ts[:10]\n        if not day:\n            continue\n        by_day.setdefault(day, []).append(r)\n    for day, day_runs in by_day.items():\n        ops = sorted({r.get(\"operation\") or \"\" for r in day_runs if r.get(\"operation\")})\n        events.append({\n            \"t\": min(r.get(\"timestamp\") or (day + \" 00:00:00\") for r in day_runs),\n            \"t_end\": None, \"odo\": None,\n            \"label\": f\"{len(day_runs)} actuator test(s)/adjustment(s)\",\n            \"detail\": \", \".join(ops) or \"actuator tests/adjustments\",\n            \"severity\": \"work\", \"href\": None,\n        })\n\n    try:\n        dealer_results = mes_bridge.dealer_results(vin).get(\"results\", [])\n    except Exception:  # noqa: BLE001\n        dealer_results = []\n    for rec in dealer_results:\n        events.append({\n            \"t\": rec.get(\"at\"), \"t_end\": None, \"odo\": None,\n            \"label\": f\"dealer: {rec.get('kind')}\",\n            \"detail\": rec.get(\"note\") or str(rec.get(\"data\") or \"\"),\n            \"severity\": \"work\", \"href\": None,\n        })\n\n    events.sort(key=lambda e: e.get(\"t\") or \"\")\n    return {\"id\": \"work\", \"label\": _LANE_LABELS[\"work\"], \"kind\": _LANE_KIND[\"work\"],\n           \"events\": events}\n\n\ndef _conditions_lane(vin: str) -> tuple[dict[str, Any], list[dict[str, Any]]]:\n    \"\"\"The conditions lane, plus the raw warn-flagged rows (for ``findings``).\"\"\"\n    events = []\n    warnings: list[dict[str, Any]] = []\n    try:\n        frames = mes_bridge.freeze_frames(vin=vin).get(\"frames\", [])\n    except Exception:  # noqa: BLE001 -- NotFound when nothing has a freeze frame\n        frames = []\n    for f in frames:\n        ff = f.get(\"freeze_frame\") or {}\n        fuel = _num(ff.get(\"Fuel level\"))\n        temp = _num(ff.get(\"Engine temperature\"))\n        cold = bool(temp is not None and temp < 40)\n        parts = []\n        flag = None\n        if fuel is not None:\n            parts.append(f\"fuel {fuel:.0f}%\")\n            if not (15 <= fuel <= 85):\n                bound = \"below 15%\" if fuel < 15 else \"above 85%\"\n                flag = f\"fuel {fuel:.0f}% is {bound} -- EVAP monitor cannot run\"\n                warnings.append({\"code\": _base(f.get(\"dtc\") or \"\"), \"fuel\": fuel})\n        if temp is not None:\n            parts.append(f\"engine temp {temp:.0f} C\" + (\" (cold start)\" if cold else \"\"))\n        detail = flag or (\", \".join(parts) or \"no fuel/engine-temperature fields captured\")\n        events.append({\n            \"t\": f.get(\"timestamp\"), \"t_end\": None, \"odo\": None,\n            \"label\": f\"{f.get('dtc')} freeze frame\", \"detail\": detail,\n            \"severity\": \"warn\" if flag else \"info\", \"href\": None,\n        })\n    lane = {\"id\": \"conditions\", \"label\": _LANE_LABELS[\"conditions\"],\n           \"kind\": _LANE_KIND[\"conditions\"], \"events\": events}\n    return lane, warnings\n\n\n# --- the one entry point ------------------------------------------------------\n\n\ndef build_timeline(vin: str) -> dict[str, Any]:\n    \"\"\"Everything the mechanic-vs-driver timeline page needs, in one call.\n\n    Only real data: every lane is built from the real-log corpus (simulation\n    excluded by ``mes.catalog``'s own default), the live link's own\n    observations, and the technician-entered stores -- nothing here\n    synthesises a code occurrence or a symptom that was not actually\n    recorded.\n    \"\"\"\n    if not vin.strip():\n        raise BadRequest(\"a VIN is required\")\n\n    dossier = mes_bridge.workup(vin=vin)\n    identity = dossier.get(\"identity\") or {}\n    all_symptoms = symptoms_mod.load(vin)\n\n    by_family = _family_occurrences(dossier)\n\n    lanes = [\n        _mil_lane(vin),\n        _family_lane(\"evap\", by_family[\"evap\"]),\n        _family_lane(\"network\", by_family[\"network\"]),\n        _family_lane(\"body\", by_family[\"body\"]),\n        _family_lane(\"chassis\", by_family[\"chassis\"]),\n        _family_lane(\"engine_other\", by_family[\"engine_other\"]),\n        _clears_lane(by_family),\n        _symptoms_lane(all_symptoms),\n        _notes_lane(vin),\n        _work_lane(vin),\n    ]\n    conditions_lane, fuel_warnings = _conditions_lane(vin)\n    lanes.append(conditions_lane)\n\n    correlation: list[dict[str, Any]] = []\n    findings: list[str] = []\n    for family, occs in by_family.items():\n        if not occs:\n            continue\n        occ_dts = [_parse_dt(o[\"ts\"]) for o in occs]\n        occurrences = len({o[\"file\"] for o in occs if o.get(\"file\")}) or len(occs)\n        pattern = _pattern_for(occurrences, occ_dts, all_symptoms)\n        if pattern[\"occurrences\"] == 0:\n            continue\n        verdict = _verdict_for(pattern)\n        codes = sorted({o[\"code\"] for o in occs})\n        display = _FAMILY_DISPLAY[family]\n        correlation.append({\n            \"family\": display, \"codes\": codes, \"occurrences\": pattern[\"occurrences\"],\n            \"symptom_reports_near\": pattern[\"symptom_reports_near\"],\n            \"by_tag\": pattern[\"by_tag\"], \"drives_normally_near\": pattern[\"drives_normally_near\"],\n            \"window_days\": WINDOW_DAYS, \"verdict\": verdict,\n        })\n        if verdict == \"no symptom reports yet\":\n            findings.append(\n                f\"{display} codes appeared in {pattern['occurrences']} session(s); \"\n                f\"no driver symptom has been reported yet.\")\n        elif verdict == \"no reported symptom\":\n            findings.append(\n                f\"{display} codes appeared in {pattern['occurrences']} session(s); \"\n                f\"no driver symptom was reported within {WINDOW_DAYS} days of any of them.\")\n        elif verdict.startswith(\"co-occurs\"):\n            findings.append(f\"{display} codes {verdict} within {WINDOW_DAYS} days.\")\n\n    if fuel_warnings:\n        codes = []\n        for w in fuel_warnings:\n            if w[\"code\"] not in codes:\n                codes.append(w[\"code\"])\n        fuels = sorted(w[\"fuel\"] for w in fuel_warnings)\n        findings.append(\n            f\"{' and '.join(codes)} were set with the tank \"\n            f\"{fuels[0]:.0f}-{fuels[-1]:.0f} % full.\")\n\n    return {\n        \"vin\": vin,\n        \"range\": {\n            \"start\": identity.get(\"first_log\"), \"end\": identity.get(\"last_log\"),\n            \"odo_start\": identity.get(\"odometer_first_km\"),\n            \"odo_end\": identity.get(\"odometer_last_km\"),\n        },\n        \"lanes\": lanes,\n        \"correlation\": correlation,\n        \"findings\": findings,\n        \"symptom_tags\": list(SYMPTOM_TAGS),\n        \"conditions\": list(CONDITIONS),\n    }\n\n\n__all__ = [\"WINDOW_DAYS\", \"add_symptom\", \"symptoms\", \"hide_symptom\", \"code_feel\",\n          \"build_timeline\"]\n","numLines":577,"startLine":1,"totalLines":577}},"sourceToolAssistantUUID":"cea423bf-f009-499a-93ed-d6f25684f9e7","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
{"parentUuid":"b959f705-51ee-46ad-98ee-975d35e55384","isSidechain":true,"agentId":"a2392aaec64306cb2","message":{"model":"claude-sonnet-5","id":"msg_011Cfp2YcjcXU1jejSSh3Wmi","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_018UgHV4bMEF53MawfF9o8no","name":"Read","input":{"file_path":"C:\\Users\\User\\mcp-servers\\cuore\\api\\dossier.py"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":5303,"cache_read_input_tokens":57422,"cache_creation":{"ephemeral_5m_input_tokens":5303,"ephemeral_1h_input_tokens":0},"output_tokens":4,"service_tier":"standard","inference_geo":"not_available"},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_018UgHV4bMEF53MawfF9o8no":{"file_path":"C:\\Users\\User\\mcp-servers\\cuore\\api\\dossier.py"}},"serverClassifierRequest":"9b304114-d192-463f-acbb-5e3a0377cdef","apiBlockIndex":3,"requestId":"req_011Cfp2YcUyNmgnowe684qs5","attributionAgent":"general-purpose","type":"assistant","uuid":"4a257b9d-78cc-446a-91fb-22198b3c9b18","timestamp":"2026-10-08T03:03:40.571Z","effort":"high","perTurnEffort":null,"userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
{"parentUuid":"4a257b9d-78cc-446a-91fb-22198b3c9b18","isSidechain":true,"promptId":"1c9ea3c5-87b7-461e-9caf-e82d18dc2677","agentId":"a2392aaec64306cb2","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018UgHV4bMEF53MawfF9o8no","type":"tool_result","content":"1\t\"\"\"GET /api/vehicles/{vin}/view -- the redesigned dossier's data, as JSON.\n2\t\n3\tThe HTTP face of ``dossier_bridge.build_view``, so a future PWA or Claude's\n4\town tool layer can read exactly what the server-rendered dossier renders.\n5\tRead-only: nothing here writes to the car or the corpus.\n6\t\"\"\"\n7\t\n8\tfrom __future__ import annotations\n9\t\n10\tfrom typing import Any\n11\t\n12\tfrom fastapi import APIRouter, Depends\n13\t\n14\tfrom ..live import ops as live_ops\n15\tfrom ..services import cache, dossier_bridge, mes_bridge\n16\tfrom .deps import require_token\n17\t\n18\trouter = APIRouter(tags=[\"vehicles\"], dependencies=[Depends(require_token)])\n19\t\n20\t\n21\tdef _live_status() -> dict[str, Any] | None:\n22\t    \"\"\"The same cheap, I/O-free read ``base.html``'s live strip uses --\n23\t    never opens the adapter, so it is safe to call on every view request.\n24\t    A broken live link must not break the dossier view.\"\"\"\n25\t    try:\n26\t        s = live_ops.status()\n27\t        return {\"port\": s.get(\"port\"),\n28\t                \"mes_state\": (s.get(\"mes\") or {}).get(\"state\"),\n29\t                \"lock_holder\": (s.get(\"lock\") or {}).get(\"process\"),\n30\t                \"error\": None}\n31\t    except Exception as exc:  # noqa: BLE001 -- see cuore.web.routes._status_strip\n32\t        return {\"error\": str(exc)}\n33\t\n34\t\n35\t@router.get(\"/vehicles/{vin}/view\", summary=\"The redesigned dossier's computed view\")\n36\tdef view(vin: str) -> dict[str, Any]:\n37\t    dossier = cache.get_or_build(\n38\t        (\"workup\", vin, mes_bridge.newest_mtime(vin)),\n39\t        lambda: mes_bridge.workup(vin=vin))\n40\t    return dossier_bridge.build_view(vin, dossier, _live_status())\n41\t\n42\t\n43\t__all__ = [\"router\"]\n44\t"}]},"uuid":"b89c1f5d-63f1-4515-874f-3021bda0e034","timestamp":"2026-10-08T03:03:40.600Z","toolUseResult":{"type":"text","file":{"filePath":"C:\\Users\\User\\mcp-servers\\cuore\\api\\dossier.py","content":"\"\"\"GET /api/vehicles/{vin}/view -- the redesigned dossier's data, as JSON.\n\nThe HTTP face of ``dossier_bridge.build_view``, so a future PWA or Claude's\nown tool layer can read exactly what the server-rendered dossier renders.\nRead-only: nothing here writes to the car or the corpus.\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom typing import Any\n\nfrom fastapi import APIRouter, Depends\n\nfrom ..live import ops as live_ops\nfrom ..services import cache, dossier_bridge, mes_bridge\nfrom .deps import require_token\n\nrouter = APIRouter(tags=[\"vehicles\"], dependencies=[Depends(require_token)])\n\n\ndef _live_status() -> dict[str, Any] | None:\n    \"\"\"The same cheap, I/O-free read ``base.html``'s live strip uses --\n    never opens the adapter, so it is safe to call on every view request.\n    A broken live link must not break the dossier view.\"\"\"\n    try:\n        s = live_ops.status()\n        return {\"port\": s.get(\"port\"),\n                \"mes_state\": (s.get(\"mes\") or {}).get(\"state\"),\n                \"lock_holder\": (s.get(\"lock\") or {}).get(\"process\"),\n                \"error\": None}\n    except Exception as exc:  # noqa: BLE001 -- see cuore.web.routes._status_strip\n        return {\"error\": str(exc)}\n\n\n@router.get(\"/vehicles/{vin}/view\", summary=\"The redesigned dossier's computed view\")\ndef view(vin: str) -> dict[str, Any]:\n    dossier = cache.get_or_build(\n        (\"workup\", vin, mes_bridge.newest_mtime(vin)),\n        lambda: mes_bridge.workup(vin=vin))\n    return dossier_bridge.build_view(vin, dossier, _live_status())\n\n\n__all__ = [\"router\"]\n","numLines":44,"startLine":1,"totalLines":44}},"sourceToolAssistantUUID":"4a257b9d-78cc-446a-91fb-22198b3c9b18","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
{"parentUuid":"b89c1f5d-63f1-4515-874f-3021bda0e034","isSidechain":true,"agentId":"a2392aaec64306cb2","message":{"model":"claude-sonnet-5","id":"msg_011Cfp2YcjcXU1jejSSh3Wmi","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_019zrP1zeLC8hyyYGcHKwrtf","name":"Read","input":{"file_path":"C:\\Users\\User\\mcp-servers\\cuore\\web\\dossier_routes.py"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":5303,"cache_read_input_tokens":57422,"cache_creation":{"ephemeral_5m_input_tokens":5303,"ephemeral_1h_input_tokens":0},"output_tokens":4,"service_tier":"standard","inference_geo":"not_available"},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_019zrP1zeLC8hyyYGcHKwrtf":{"file_path":"C:\\Users\\User\\mcp-servers\\cuore\\web\\dossier_routes.py"}},"serverClassifierRequest":"9b304114-d192-463f-acbb-5e3a0377cdef","apiBlockIndex":4,"requestId":"req_011Cfp2YcUyNmgnowe684qs5","attributionAgent":"general-purpose","type":"assistant","uuid":"c23fde70-cbc4-46b2-86ce-ede9296531dc","timestamp":"2026-10-08T03:03:41.119Z","effort":"high","perTurnEffort":null,"userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
{"parentUuid":"c23fde70-cbc4-46b2-86ce-ede9296531dc","isSidechain":true,"promptId":"1c9ea3c5-87b7-461e-9caf-e82d18dc2677","agentId":"a2392aaec64306cb2","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_019zrP1zeLC8hyyYGcHKwrtf","type":"tool_result","content":"1\t\"\"\"Web-form face of the checklist store, and the \"Verify repair\" page.\n2\t\n3\tKept as a second router rather than added to ``cuore.web.routes`` so the\n4\ttemplate agent's work on that module's templates and this file's own routes\n5\tdo not collide while both are being built at once. It reuses ``routes``'s\n6\town page/dossier helpers (``_page``, ``_dossier``, ``_vehicle_bar``,\n7\t``_status_strip``, ``_set_active_vehicle``) so rendering stays identical --\n8\tthis is a second router on the same app, not a second implementation of the\n9\tdossier.\n10\t\"\"\"\n11\t\n12\tfrom __future__ import annotations\n13\t\n14\tfrom fastapi import APIRouter, Depends, Form, Request\n15\tfrom fastapi.responses import HTMLResponse, RedirectResponse\n16\t\n17\tfrom ..live import checklists as checklist_store\n18\tfrom ..live import ops as live_ops\n19\tfrom ..live.errors import LiveError\n20\tfrom ..api.deps import require_token\n21\tfrom ..services import dossier_bridge\n22\tfrom ..services.errors import BadRequest\n23\tfrom . import routes as web_routes\n24\t\n25\trouter = APIRouter(include_in_schema=False, dependencies=[Depends(require_token)])\n26\t\n27\t_TRUE = (\"1\", \"true\", \"on\", \"yes\")\n28\t\n29\t\n30\t@router.post(\"/v/{vin}/checklist\", response_class=HTMLResponse)\n31\tasync def checklist_submit(request: Request, vin: str,\n32\t                           step_id: str = Form(...),\n33\t                           done: str = Form(default=\"\"),\n34\t                           by: str = Form(default=\"\")) -> RedirectResponse:\n35\t    \"\"\"Tick (or untick) one checklist step from the dossier page's own form.\n36\t    No JavaScript required -- same posture as ``/v/{vin}/dealer`` and\n37\t    ``/v/{vin}/notes``. Validated the same way the JSON API validates it: a\n38\t    step id this car's open-work cards do not expose is a 400.\"\"\"\n39\t    dossier = web_routes._dossier(vin)\n40\t    valid = dossier_bridge.checklist_step_ids(vin, dossier)\n41\t    if step_id not in valid:\n42\t        raise BadRequest(f\"unknown checklist step id {step_id!r} for this vehicle\")\n43\t    checklist_store.set_step(vin, step_id, done.strip().lower() in _TRUE, by=by)\n44\t    return RedirectResponse(url=f\"/v/{vin}#open-work\", status_code=303)\n45\t\n46\t\n47\t@router.get(\"/v/{vin}/verify\", response_class=HTMLResponse)\n48\tdef verify_form(request: Request, vin: str) -> HTMLResponse:\n49\t    \"\"\"Read live readiness, if the adapter is reachable, and show the\n50\t    recomputed verdict. A read, never a write: ``ops.obd_readiness`` is\n51\t    Mode 01 PID 01/41 plus the drive-cycle counters, nothing more -- and it\n52\t    records its own observation, which is what lets the verdict change.\"\"\"\n53\t    dossier = web_routes._dossier(vin)\n54\t    bar = web_routes._vehicle_bar(vin, dossier)\n55\t    live_status = web_routes._status_strip()\n56\t\n57\t    result = None\n58\t    if dossier_bridge.live_available(live_status):\n59\t        try:\n60\t            result = dossier_bridge.readiness_result(live_ops.obd_readiness())\n61\t        except LiveError:\n62\t            result = None\n63\t\n64\t    view = dossier_bridge.build_view(vin, dossier, live_status)\n65\t    response = web_routes._page(request, \"verify.html\", vin=vin, result=result,\n66\t                                verdict=view[\"verdict\"], bar=bar, tab=\"dossier\")\n67\t    web_routes._set_active_vehicle(response, vin)\n68\t    return response\n69\t\n70\t\n71\t__all__ = [\"router\"]\n72\t"}]},"uuid":"ab7ee4e6-a180-47ce-8311-b3c1967e1c70","timestamp":"2026-10-08T03:03:41.138Z","toolUseResult":{"type":"text","file":{"filePath":"C:\\Users\\User\\mcp-servers\\cuore\\web\\dossier_routes.py","content":"\"\"\"Web-form face of the checklist store, and the \"Verify repair\" page.\n\nKept as a second router rather than added to ``cuore.web.routes`` so the\ntemplate agent's work on that module's templates and this file's own routes\ndo not collide while both are being built at once. It reuses ``routes``'s\nown page/dossier helpers (``_page``, ``_dossier``, ``_vehicle_bar``,\n``_status_strip``, ``_set_active_vehicle``) so rendering stays identical --\nthis is a second router on the same app, not a second implementation of the\ndossier.\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom fastapi import APIRouter, Depends, Form, Request\nfrom fastapi.responses import HTMLResponse, RedirectResponse\n\nfrom ..live import checklists as checklist_store\nfrom ..live import ops as live_ops\nfrom ..live.errors import LiveError\nfrom ..api.deps import require_token\nfrom ..services import dossier_bridge\nfrom ..services.errors import BadRequest\nfrom . import routes as web_routes\n\nrouter = APIRouter(include_in_schema=False, dependencies=[Depends(require_token)])\n\n_TRUE = (\"1\", \"true\", \"on\", \"yes\")\n\n\n@router.post(\"/v/{vin}/checklist\", response_class=HTMLResponse)\nasync def checklist_submit(request: Request, vin: str,\n                           step_id: str = Form(...),\n                           done: str = Form(default=\"\"),\n                           by: str = Form(default=\"\")) -> RedirectResponse:\n    \"\"\"Tick (or untick) one checklist step from the dossier page's own form.\n    No JavaScript required -- same posture as ``/v/{vin}/dealer`` and\n    ``/v/{vin}/notes``. Validated the same way the JSON API validates it: a\n    step id this car's open-work cards do not expose is a 400.\"\"\"\n    dossier = web_routes._dossier(vin)\n    valid = dossier_bridge.checklist_step_ids(vin, dossier)\n    if step_id not in valid:\n        raise BadRequest(f\"unknown checklist step id {step_id!r} for this vehicle\")\n    checklist_store.set_step(vin, step_id, done.strip().lower() in _TRUE, by=by)\n    return RedirectResponse(url=f\"/v/{vin}#open-work\", status_code=303)\n\n\n@router.get(\"/v/{vin}/verify\", response_class=HTMLResponse)\ndef verify_form(request: Request, vin: str) -> HTMLResponse:\n    \"\"\"Read live readiness, if the adapter is reachable, and show the\n    recomputed verdict. A read, never a write: ``ops.obd_readiness`` is\n    Mode 01 PID 01/41 plus the drive-cycle counters, nothing more -- and it\n    records its own observation, which is what lets the verdict change.\"\"\"\n    dossier = web_routes._dossier(vin)\n    bar = web_routes._vehicle_bar(vin, dossier)\n    live_status = web_routes._status_strip()\n\n    result = None\n    if dossier_bridge.live_available(live_status):\n        try:\n            result = dossier_bridge.readiness_result(live_ops.obd_readiness())\n        except LiveError:\n            result = None\n\n    view = dossier_bridge.build_view(vin, dossier, live_status)\n    response = web_routes._page(request, \"verify.html\", vin=vin, result=result,\n                                verdict=view[\"verdict\"], bar=bar, tab=\"dossier\")\n    web_routes._set_active_vehicle(response, vin)\n    return response\n\n\n__all__ = [\"router\"]\n","numLines":72,"startLine":1,"totalLines":72}},"sourceToolAssistantUUID":"c23fde70-cbc4-46b2-86ce-ede9296531dc","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
