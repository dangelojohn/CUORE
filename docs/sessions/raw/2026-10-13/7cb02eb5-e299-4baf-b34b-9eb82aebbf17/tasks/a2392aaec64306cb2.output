t":"__init__.py\n__pycache__\nanalysis.py\ncatalog.py\ncode_feel.py\ncompact.py\ncompare.py\ncsvlog.py\ndashboard.py\ndealer.py\ndrivetrain_specs.py\ndtc.py\ndtc_text.py\necm.py\nelectrical.py\nelectrical_inspections.py\nencoding.py\nerrors.py\nexperience.py\nfaulttree.py\nfeedback.py\nfes.py\nknowledge.py\nknown_good.py\nlayout_systems.py\nlive_obs.py\nmaintenance_specs.py\nmodules.py\nnotes.py\nparams.py\nparts.py\npaths.py\nplatform.py\nscan.py\nservice.py\nservice_specs.py\nsymptoms.py\nsystems.py\nverdict.py\nworkup.py\n---\n__init__.py\n__pycache__\ncache.py\ndashboard_bridge.py\ndossier_bridge.py\nelectrical_bridge.py\nerrors.py\nexperience_bridge.py\nfeedback_bridge.py\nknown_good_bridge.py\nlabels_bridge.py\nlayout_bridge.py\nmedia_bridge.py\nmes_bridge.py\nparts_bridge.py\nreplay_bridge.py\nservice_bridge.py\nsystems_bridge.py\ntimeline_bridge.py\ntools_bridge.py\n---\n__init__.py\n__pycache__\nchecklists.py\ndeps.py\ndossier.py\nelectrical.py\nexperience.py\nfeedback.py\nknown_good.py\nlive.py\nlive_ui.py\nlogs.py\nmedia.py\nparts.py\nrecordings.py\nreference.py\nsystem.py\nsystems.py\ntimeline.py\ntools.py\nvehicles.py\n---\n__init__.py\n__pycache__\ndashboard_charts.py\ndashboard_routes.py\ndossier_routes.py\ndrivetrain_routes.py\nelectrical_routes.py\nelectrical_svg.py\nexperience_globals.py\ninbox_routes.py\nlabels_routes.py\nlive_dashboard_routes.py\nmedia_routes.py\nparts_routes.py\nreport_pdf.py\nreport_routes.py\nroutes.py\nservice_routes.py\nstatic\nsystems_routes.py\nsystems_svg.py\ntemplates\ntimeline_routes.py\ntimeline_svg.py\ntools_routes.py","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"serverClassifierContext":{"request":"46126a34-b2b8-4554-a2d3-1ab772da2659","context":{"git_state":{"cwd":"/c/Users/User/mcp-servers","root":null,"branch":null,"default_branch":null,"status":null,"visibility":null,"error":"pending"},"live_cwd":"/c/Users/User/mcp-servers","platform":"windows"}},"sourceToolAssistantUUID":"e9bb9fc3-d