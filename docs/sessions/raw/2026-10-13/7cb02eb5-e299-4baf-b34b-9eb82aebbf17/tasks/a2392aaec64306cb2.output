ure, for status classification only -------------------\n778-    try:\n779-        dossier = workup_mod.build(vin=vin)\n780-    except Exception:  # noqa: BLE001 -- status is a nice-to-have, never fatal\n781-        dossier = {}\n782-    cp = dossier.get(\"current_picture\", {}) if isinstance(dossier, dict) else {}\n783-    latest = cp.get(\"latest_session\") or {}\n784-    open_codes = {d.get(\"dtc\") for d in latest.get(\"dtcs\", []) if d.get(\"dtc\")}\n785-    clear = cp.get(\"clear_assessment\") or {}\n786-    cleared_codes = set(clear.get(\"codes_cleared\") or [])\n787-\n788-    # --- by_system -----------------------------------------------------------\n789-    by_system: list[dict[str, Any]] = []\n790-    for sys_key in SYSTEMS:\n791-        codes_here = sorted(c for c, syss in primary_map.items() if sys_key in syss)\n792-        if not codes_here:\n793-            by_system.append({\"system\": sys_key, \"codes\": [], \"sessions\": 0,\n794-                              \"first\": None, \"last\": None, \"status\": \"clean\"})\n795-            continue\n796-        sessions_here = sum(1 for syss in session_systems.values() if sys_key in syss)\n797-        firsts = [history[c].first_seen for c in codes_here if history[c].first_seen]\n798-        lasts = [history[c].last_seen for c in codes_here if history[c].last_seen]\n799-        if open_codes & set(codes_here):\n800-            status = \"active\"","is_error":false}]},"uuid":"007db573-8bab-430f-9233-dbb13f3b3154","timestamp":"2026-10-08T03:06:45.715Z","toolUseResult":{"stdout":"740:def correlate(vin: str) -> dict[str, Any]:\n741-    \"\"\"Project one vehicle's whole DTC corpus onto the system graph.\n742-\n743-    Built from :func:`mes.analysis.dtc_history` (the same per-occurrence\n744-    file/timestamp data :func:`mes.workup.build` uses) plus\n745-    ``mes.workup.build`` itself for the current-picture open codes and the\n746-    latest clear assessment, used only to classify each system's\n747-    ``status``. Simulation logs are excluded (``dtc_history``'s default).\n748-\n749-    Returns ``{\"error\": ...}`` if no logs match this VIN -- never a\n750-    half-empty dossier.\n751-    \"\"\"\n752-    from . import analysis, workup as workup_mod\n753-\n754-    history = analysis.dtc_history(vin=vin)\n755-    if not history:\n756-        return {\"error\": \"no logs match\", \"vin\": vin}\n757-\n758-    primary_map: dict[str, list[str]] = {}\n759-    for code, rec in history.items():\n760-        descr = rec.descriptions[0] if rec.descriptions else \"\"\n761-        primary_map[code] = _primary_systems(code, descr)\n762-\n763-    # --- per-session (per-file) system sets ---------------------------------\n764-    session_codes: dict[str, set[str]] = {}\n765-    for code, rec in history.items():\n766-        for occ in rec.occurrences:\n767-            fname = occ.get(\"file\")\n768-            if not fname:\n769-                continue\n770-            session_codes.setdefault(fname, set()).add(code)\n771-    session_systems: dict[str, set[str]] = {\n772-        fname: {s for c in codes for s in primary_map.get(c, [])}\n773-        for fname, codes in session_codes.items()\n774-    }\n775-    total_sessions = len(session_systems)\n776-\n777-    # --- current picture, for status classification only -------------------\n778-    try:\n779-        dossier = workup_mod.build(vin=vin)\n780-    except Exception:  # noqa: BLE001 -- status is a nice-to-have, never fatal\n781-        dossier = {}\n782-    cp = dossier.get(\"current_picture\", {}) if isinstance(dossier, dict) else {}\n783-    latest = cp.get(\"latest_session\") or {}\n784-    open_codes = {d.get(\"dtc\") for d in latest.get(\"dtcs\", []) if d.get(\"dtc\")}\n785-    clear = cp.get(\"clear_assessment\") or {}\n786-    cleared_codes = set(clear.get(\"codes_cleared\") or [])\n787-\n788-    # --- by_system -----------------------------------------------------------\n789-    by_system: list[dict[str, Any]] = []\n790-    for sys_key in SYSTEMS:\n791-        codes_here = sorted(c for c, syss in primary_map.items() if sys_key in syss)\n792-        if not codes_here:\n793-            by_system.append({\"system\": sys_key, \"codes\": [], \"sessions\": 0,\n794-                              \"first\": None, \"last\": None, \"status\": \"clean\"})\n795-            continue\n796-        sessions_here = sum(1 for syss in session_systems.values() if sys_key in syss)\n797-        firsts = [history[c].first_seen for c in codes_here if history[c].first_seen]\n798-        lasts = [history[c].last_seen for c in codes_here if history[c].last_seen]\n799-        if open_codes & set(codes_here):\n800-            status = \"active\"","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"serverClassifierContext":{"request":"15ed83d4-d99d-4dc8-abb5-7339d194bbee","context":{"git_state":{"cwd":"/c/Users/User/mcp-servers","root":null,"branch":null,"default_branch":null,"status":null,"visibility":null,"error":"pending"},"live_cwd":"/c/Users/User/mcp-servers","platform":"windows"}},"sourceToolAssistantUUID":"0f2429e7-8d8c-4d8e-b2a9-5a5f48bb873b","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
