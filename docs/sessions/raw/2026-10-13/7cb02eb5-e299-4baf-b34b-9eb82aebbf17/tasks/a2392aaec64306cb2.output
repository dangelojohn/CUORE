{"parentUuid":"5d038354-32a3-4087-aca3-cb6eff6117b5","isSidechain":true,"agentId":"a2392aaec64306cb2","message":{"model":"claude-sonnet-5","id":"msg_011Cfp2ZiVQXRwSY3h7wiG5u","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01UFW1xeEwZVUzxaatPDbLZL","name":"Read","input":{"file_path":"C:\\Users\\User\\mcp-servers\\cuore\\app.py"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":12407,"cache_read_input_tokens":89099,"cache_creation":{"ephemeral_5m_input_tokens":12407,"ephemeral_1h_input_tokens":0},"output_tokens":2,"service_tier":"standard","inference_geo":"not_available"},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_01UFW1xeEwZVUzxaatPDbLZL":{"file_path":"C:\\Users\\User\\mcp-servers\\cuore\\app.py"}},"serverClassifierRequest":"fedc421f-0e7b-4d45-a7e1-f74b7c4452bf","apiBlockIndex":1,"requestId":"req_011Cfp2ZiGm8MPdSA13YXQnu","attributionAgent":"general-purpose","type":"assistant","uuid":"59db885f-19b8-4b8f-85ca-f95f880d4833","timestamp":"2026-10-08T03:04:07.357Z","effort":"high","perTurnEffort":null,"userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
{"parentUuid":"59db885f-19b8-4b8f-85ca-f95f880d4833","isSidechain":true,"promptId":"661b565b-f132-46d8-b96b-a7f4dab0f376","agentId":"a2392aaec64306cb2","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01UFW1xeEwZVUzxaatPDbLZL","type":"tool_result","content":"1\t\"\"\"FastAPI application factory.\n2\t\n3\tTwo surfaces over one service layer:\n4\t\n5\t* ``/api/*`` -- JSON, mirroring the MCP tool surface call-for-call. This is\n6\t  what a future PWA, the in-car node, and Claude's tool layer all talk to.\n7\t* ``/`` -- server-rendered pages for bench use. They are a *client* of the same\n8\t  bridge, not a parallel implementation, so the two cannot disagree.\n9\t\n10\tServer-rendered rather than a single-page app on purpose: no build step, no\n11\tbundle to keep in sync, and it has to run on a Raspberry Pi.\n12\t\"\"\"\n13\t\n14\tfrom __future__ import annotations\n15\t\n16\timport logging\n17\tfrom contextlib import asynccontextmanager\n18\t\n19\tfrom . import __version__, bootstrap  # noqa: F401  -- bootstrap has a side effect\n20\t\n21\tfrom fastapi import FastAPI, Request  # noqa: E402\n22\tfrom fastapi.responses import JSONResponse  # noqa: E402\n23\tfrom fastapi.staticfiles import StaticFiles  # noqa: E402\n24\t\n25\tfrom mes.errors import MesError  # noqa: E402  -- needs bootstrap to have run\n26\t\n27\tfrom .api import checklists as checklists_api, dossier as dossier_api, feedback as feedback_api, known_good, live, live_ui, logs, media as media_api, parts as parts_api, recordings, reference, system, timeline as timeline_api, tools as tools_api, experience as experience_api, vehicles  # noqa: E402\n28\tfrom .config import Settings, load  # noqa: E402\n29\tfrom .models import ErrorBody  # noqa: E402\n30\tfrom .services.errors import BridgeError  # noqa: E402\n31\tfrom .web import dashboard_routes  # noqa: E402\n32\tfrom .web import drivetrain_routes  # noqa: E402\n33\tfrom .web import dossier_routes  # noqa: E402\n34\tfrom .web import labels_routes  # noqa: E402\n35\tfrom .web import live_dashboard_routes  # noqa: E402\n36\tfrom .web import media_routes  # noqa: E402\n37\tfrom .web import parts_routes  # noqa: E402\n38\tfrom .web import report_routes  # noqa: E402\n39\tfrom .web import routes as web_routes  # noqa: E402\n40\tfrom .web import service_routes  # noqa: E402\n41\tfrom .web import timeline_routes  # noqa: E402\n42\tfrom .web import tools_routes  # noqa: E402\n43\tfrom .web import inbox_routes  # noqa: E402\n44\t\n45\tlog = logging.getLogger(\"cuore\")\n46\t\n47\tDESCRIPTION = \"\"\"\n48\tCompanion service over the MultiEcuScan diagnostic toolchain.\n49\t\n50\tEvery analysis here comes from the `mes` library and is unit-tested against the\n51\treal log corpus. Two conventions run through the whole API and are worth knowing\n52\tbefore reading any payload:\n53\t\n54\t* **Simulation logs are excluded by default.** Most of the FES corpus is MES\n55\t  practice data. Pass `include_simulation=true` deliberately, or not at all.\n56\t* **SCAN provenance is `unverifiable`, never clean.** That format carries no\n57\t  simulation marker, so claiming a SCAN is real would be a claim the file\n58\t  cannot support.\n59\t\"\"\"\n60\t\n61\t\n62\tdef create_app(settings: Settings | None = None) -> FastAPI:\n63\t    \"\"\"Build the ASGI app. Safe to call repeatedly (tests do).\"\"\"\n64\t    settings = settings or load()\n65\t\n66\t    @asynccontextmanager\n67\t    async def lifespan(app: FastAPI):\n68\t        log.info(\"CUORE %s starting: profile=%s bind=%s:%s\",\n69\t                 __version__, settings.profile.value, settings.host,\n70\t                 settings.port)\n71\t        if settings.unguarded_lan:\n72\t            log.warning(\n73\t                \"Bound to %s with no token set. The log corpus contains \"\n74\t                \"customer VINs and is now readable by every device on this \"\n75\t                \"network. Set CUORE_TOKEN.\", settings.host)\n76\t        yield\n77\t\n78\t    app = FastAPI(\n79\t        title=\"CUORE\",\n80\t        version=__version__,\n81\t        description=DESCRIPTION,\n82\t        lifespan=lifespan,\n83\t        docs_url=\"/api/docs\",\n84\t        redoc_url=None,\n85\t        openapi_url=\"/api/openapi.json\",\n86\t    )\n87\t    app.state.settings = settings\n88\t\n89\t    # --- error handling ---------------------------------------------------\n90\t    # The bridge raises transport-neutral errors. API callers get one uniform\n91\t    # JSON body so failure parses exactly one way; browsers get a page, because\n92\t    # a tech who mistypes a VIN should not be handed raw JSON.\n93\t\n94\t    def _render_failure(request: Request, exc: Exception, status: int):\n95\t        body = ErrorBody(error=type(exc).__name__, detail=str(exc),\n96\t                         status=status)\n97\t        if request.url.path.startswith(\"/api\"):\n98\t            return JSONResponse(status_code=status, content=body.model_dump())\n99\t        return web_routes.error_page(request, body)\n100\t\n101\t    @app.exception_handler(BridgeError)\n102\t    async def _bridge_error(request: Request, exc: BridgeError):\n103\t        return _render_failure(request, exc, exc.status)\n104\t\n105\t    # Anything the library raises that the bridge did not classify is a bad\n106\t    # request, not a server fault: these are parse and lookup failures driven\n107\t    # by caller input, and a 500 would misreport whose problem it is.\n108\t    @app.exception_handler(MesError)\n109\t    async def _mes_error(request: Request, exc: MesError):\n110\t        return _render_failure(request, exc, 400)\n111\t\n112\t    # --- routes -----------------------------------------------------------\n113\t    app.include_router(system.router, prefix=\"/api\")\n114\t    app.include_router(vehicles.router, prefix=\"/api\")\n115\t    app.include_router(reference.router, prefix=\"/api\")\n116\t    app.include_router(recordings.router, prefix=\"/api\")\n117\t    app.include_router(logs.router, prefix=\"/api\")\n118\t    app.include_router(live.router, prefix=\"/api\")\n119\t    app.include_router(live_ui.router, prefix=\"/api\")\n120\t    app.include_router(known_good.router, prefix=\"/api\")\n121\t    app.include_router(checklists_api.router, prefix=\"/api\")\n122\t    app.include_router(dossier_api.router, prefix=\"/api\")\n123\t    app.include_router(timeline_api.router, prefix=\"/api\")\n124\t    app.include_router(tools_api.router, prefix=\"/api\")\n125\t    app.include_router(experience_api.router, prefix=\"/api\")\n126\t    app.include_router(media_api.router, prefix=\"/api\")\n127\t    app.include_router(parts_api.router, prefix=\"/api\")\n128\t    app.include_router(feedback_api.router, prefix=\"/api\")\n129\t    app.include_router(dashboard_routes.api_router, prefix=\"/api\")\n130\t    app.include_router(service_routes.api_router, prefix=\"/api\")\n131\t    app.include_router(drivetrain_routes.api_router, prefix=\"/api\")\n132\t    app.include_router(labels_routes.api_router, prefix=\"/api\")\n133\t    app.include_router(web_routes.router)\n134\t    app.include_router(dashboard_routes.router)\n135\t    app.include_router(service_routes.router)\n136\t    app.include_router(drivetrain_routes.router)\n137\t    app.include_router(labels_routes.router)\n138\t    app.include_router(dossier_routes.router)\n139\t    app.include_router(timeline_routes.router)\n140\t    app.include_router(tools_routes.router)\n141\t    app.include_router(inbox_routes.router)\n142\t    app.include_router(live_dashboard_routes.router)\n143\t    app.include_router(media_routes.router)\n144\t    app.include_router(parts_routes.router)\n145\t    app.include_router(report_routes.router)\n146\t\n147\t    app.mount(\"/static\",\n148\t              StaticFiles(directory=str(web_routes.STATIC_DIR)),\n149\t              name=\"static\")\n150\t\n151\t    return app\n152\t"}]},"uuid":"86bd386b-797f-4a5f-aac4-d83ef2f7d93d","timestamp":"2026-10-08T03:04:07.380Z","toolUseResult":{"type":"text","file":{"filePath":"C:\\Users\\User\\mcp-servers\\cuore\\app.py","content":"\"\"\"FastAPI application factory.\n\nTwo surfaces over one service layer:\n\n* ``/api/*`` -- JSON, mirroring the MCP tool surface call-for-call. This is\n  what a future PWA, the in-car node, and Claude's tool layer all talk to.\n* ``/`` -- server-rendered pages for bench use. They are a *client* of the same\n  bridge, not a parallel implementation, so the two cannot disagree.\n\nServer-rendered rather than a single-page app on purpose: no build step, no\nbundle to keep in sync, and it has to run on a Raspberry Pi.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport logging\nfrom contextlib import asynccontextmanager\n\nfrom . import __version__, bootstrap  # noqa: F401  -- bootstrap has a side effect\n\nfrom fastapi import FastAPI, Request  # noqa: E402\nfrom fastapi.responses import JSONResponse  # noqa: E402\nfrom fastapi.staticfiles import StaticFiles  # noqa: E402\n\nfrom mes.errors import MesError  # noqa: E402  -- needs bootstrap to have run\n\nfrom .api import checklists as checklists_api, dossier as dossier_api, feedback as feedback_api, known_good, live, live_ui, logs, media as media_api, parts as parts_api, recordings, reference, system, timeline as timeline_api, tools as tools_api, experience as experience_api, vehicles  # noqa: E402\nfrom .config import Settings, load  # noqa: E402\nfrom .models import ErrorBody  # noqa: E402\nfrom .services.errors import BridgeError  # noqa: E402\nfrom .web import dashboard_routes  # noqa: E402\nfrom .web import drivetrain_routes  # noqa: E402\nfrom .web import dossier_routes  # noqa: E402\nfrom .web import labels_routes  # noqa: E402\nfrom .web import live_dashboard_routes  # noqa: E402\nfrom .web import media_routes  # noqa: E402\nfrom .web import parts_routes  # noqa: E402\nfrom .web import report_routes  # noqa: E402\nfrom .web import routes as web_routes  # noqa: E402\nfrom .web import service_routes  # noqa: E402\nfrom .web import timeline_routes  # noqa: E402\nfrom .web import tools_routes  # noqa: E402\nfrom .web import inbox_routes  # noqa: E402\n\nlog = logging.getLogger(\"cuore\")\n\nDESCRIPTION = \"\"\"\nCompanion service over the MultiEcuScan diagnostic toolchain.\n\nEvery analysis here comes from the `mes` library and is unit-tested against the\nreal log corpus. Two conventions run through the whole API and are worth knowing\nbefore reading any payload:\n\n* **Simulation logs are excluded by default.** Most of the FES corpus is MES\n  practice data. Pass `include_simulation=true` deliberately, or not at all.\n* **SCAN provenance is `unverifiable`, never clean.** That format carries no\n  simulation marker, so claiming a SCAN is real would be a claim the file\n  cannot support.\n\"\"\"\n\n\ndef create_app(settings: Settings | None = None) -> FastAPI:\n    \"\"\"Build the ASGI app. Safe to call repeatedly (tests do).\"\"\"\n    settings = settings or load()\n\n    @asynccontextmanager\n    async def lifespan(app: FastAPI):\n        log.info(\"CUORE %s starting: profile=%s bind=%s:%s\",\n                 __version__, settings.profile.value, settings.host,\n                 settings.port)\n        if settings.unguarded_lan:\n            log.warning(\n                \"Bound to %s with no token set. The log corpus contains \"\n                \"customer VINs and is now readable by every device on this \"\n                \"network. Set CUORE_TOKEN.\", settings.host)\n        yield\n\n    app = FastAPI(\n        title=\"CUORE\",\n        version=__version__,\n        description=DESCRIPTION,\n        lifespan=lifespan,\n        docs_url=\"/api/docs\",\n        redoc_url=None,\n        openapi_url=\"/api/openapi.json\",\n    )\n    app.state.settings = settings\n\n    # --- error handling ---------------------------------------------------\n    # The bridge raises transport-neutral errors. API callers get one uniform\n    # JSON body so failure parses exactly one way; browsers get a page, because\n    # a tech who mistypes a VIN should not be handed raw JSON.\n\n    def _render_failure(request: Request, exc: Exception, status: int):\n        body = ErrorBody(error=type(exc).__name__, detail=str(exc),\n                         status=status)\n        if request.url.path.startswith(\"/api\"):\n            return JSONResponse(status_code=status, content=body.model_dump())\n        return web_routes.error_page(request, body)\n\n    @app.exception_handler(BridgeError)\n    async def _bridge_error(request: Request, exc: BridgeError):\n        return _render_failure(request, exc, exc.status)\n\n    # Anything the library raises that the bridge did not classify is a bad\n    # request, not a server fault: these are parse and lookup failures driven\n    # by caller input, and a 500 would misreport whose problem it is.\n    @app.exception_handler(MesError)\n    async def _mes_error(request: Request, exc: MesError):\n        return _render_failure(request, exc, 400)\n\n    # --- routes -----------------------------------------------------------\n    app.include_router(system.router, prefix=\"/api\")\n    app.include_router(vehicles.router, prefix=\"/api\")\n    app.include_router(reference.router, prefix=\"/api\")\n    app.include_router(recordings.router, prefix=\"/api\")\n    app.include_router(logs.router, prefix=\"/api\")\n    app.include_router(live.router, prefix=\"/api\")\n    app.include_router(live_ui.router, prefix=\"/api\")\n    app.include_router(known_good.router, prefix=\"/api\")\n    app.include_router(checklists_api.router, prefix=\"/api\")\n    app.include_router(dossier_api.router, prefix=\"/api\")\n    app.include_router(timeline_api.router, prefix=\"/api\")\n    app.include_router(tools_api.router, prefix=\"/api\")\n    app.include_router(experience_api.router, prefix=\"/api\")\n    app.include_router(media_api.router, prefix=\"/api\")\n    app.include_router(parts_api.router, prefix=\"/api\")\n    app.include_router(feedback_api.router, prefix=\"/api\")\n    app.include_router(dashboard_routes.api_router, prefix=\"/api\")\n    app.include_router(service_routes.api_router, prefix=\"/api\")\n    app.include_router(drivetrain_routes.api_router, prefix=\"/api\")\n    app.include_router(labels_routes.api_router, prefix=\"/api\")\n    app.include_router(web_routes.router)\n    app.include_router(dashboard_routes.router)\n    app.include_router(service_routes.router)\n    app.include_router(drivetrain_routes.router)\n    app.include_router(labels_routes.router)\n    app.include_router(dossier_routes.router)\n    app.include_router(timeline_routes.router)\n    app.include_router(tools_routes.router)\n    app.include_router(inbox_routes.router)\n    app.include_router(live_dashboard_routes.router)\n    app.include_router(media_routes.router)\n    app.include_router(parts_routes.router)\n    app.include_router(report_routes.router)\n\n    app.mount(\"/static\",\n              StaticFiles(directory=str(web_routes.STATIC_DIR)),\n              name=\"static\")\n\n    return app\n","numLines":152,"startLine":1,"totalLines":152}},"sourceToolAssistantUUID":"59db885f-19b8-4b8f-85ca-f95f880d4833","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
{"parentUuid":"86bd386b-797f-4a5f-aac4-d83ef2f7d93d","isSidechain":true,"agentId":"a2392aaec64306cb2","message":{"model":"claude-sonnet-5","id":"msg_011Cfp2ZiVQXRwSY3h7wiG5u","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01VWPv5GN3m4p2eeMuUzpasS","name":"Read","input":{"file_path":"C:\\Users\\User\\mcp-servers\\cuore\\tests\\check_dossier_page.py"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":12407,"cache_read_input_tokens":89099,"cache_creation":{"ephemeral_5m_input_tokens":12407,"ephemeral_1h_input_tokens":0},"output_tokens":2,"service_tier":"standard","inference_geo":"not_available"},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_01VWPv5GN3m4p2eeMuUzpasS":{"file_path":"C:\\Users\\User\\mcp-servers\\cuore\\tests\\check_dossier_page.py"}},"serverClassifierRequest":"fedc421f-0e7b-4d45-a7e1-f74b7c4452bf","apiBlockIndex":2,"requestId":"req_011Cfp2ZiGm8MPdSA13YXQnu","attributionAgent":"general-purpose","type":"assistant","uuid":"6e028702-f242-4325-b58d-9ecda8fd0465","timestamp":"2026-10-08T03:04:07.908Z","effort":"high","perTurnEffort":null,"userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
{"parentUuid":"6e028702-f242-4325-b58d-9ecda8fd0465","isSidechain":true,"promptId":"661b565b-f132-46d8-b96b-a7f4dab0f376","agentId":"a2392aaec64306cb2","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01VWPv5GN3m4p2eeMuUzpasS","type":"tool_result","content":"1\t\"\"\"Smoke checks for the rebuilt vehicle dossier page (MECHANIC_UX_REVIEW.md).\n2\t\n3\tSame posture as ``cuore/tests/check_notes_page.py``: ``CUORE_STATE_DIR`` is\n4\tpointed at a throwaway directory BEFORE cuore is imported.\n5\t\n6\tThis exercises both sides:\n7\t\n8\t  * The template-content checks (verdict chip, no raw dicts, bulletin\n9\t    anchors, checklist forms) render ``vehicle.html``/``verify.html``\n10\t    directly through the same Jinja environment ``cuore.web.routes`` uses,\n11\t    with a fixture ``view``/``result``/``verdict`` built to the agreed\n12\t    shape. This is deterministic regardless of the real route/corpus.\n13\t  * The real-route checks go through the real app (TestClient) against\n14\t    the Stelvio's real corpus (``view`` now lands on ``/v/{vin}`` from\n15\t    ``cuore.services.dossier_bridge.build_view``, and ``/v/{vin}/verify``\n16\t    plus the checklist routes are wired in ``cuore/web/dossier_routes.py``\n17\t    and ``cuore/api/checklists.py``) -- both landed while this file was\n18\t    being written, so these assert the real rendered content, not just a\n19\t    fallback.\n20\t\n21\tRun:\n22\t    .venv/Scripts/python.exe cuore/tests/check_dossier_page.py\n23\t\"\"\"\n24\t\n25\tfrom __future__ import annotations\n26\t\n27\timport os\n28\timport sys\n29\timport tempfile\n30\tfrom pathlib import Path\n31\t\n32\t# Before any cuore import: state goes to a throwaway directory.\n33\tos.environ[\"CUORE_STATE_DIR\"] = tempfile.mkdtemp(prefix=\"cuore-check-dossier-\")\n34\tos.environ.pop(\"CUORE_AUDIT_PATH\", None)\n35\t\n36\tsys.path.insert(0, str(Path(__file__).resolve().parents[2]))\n37\t\n38\tfrom fastapi.testclient import TestClient  # noqa: E402\n39\t\n40\tfrom cuore.app import create_app  # noqa: E402\n41\tfrom cuore.web.routes import templates  # noqa: E402\n42\t\n43\tVIN = \"ZASFAKPN5J7B88115\"  # the Stelvio -- real corpus, chronic P0456/P0440/P0456\n44\t\n45\tfailures: list[str] = []\n46\tchecks = 0\n47\t\n48\t\n49\tdef check(label: str, cond: bool, detail: str = \"\") -> None:\n50\t    global checks\n51\t    checks += 1\n52\t    if not cond:\n53\t        failures.append(f\"{label}{(' -- ' + detail) if detail else ''}\")\n54\t\n55\t\n56\t# --- the view fixture, built to the shape the backend route will supply ----\n57\t# (view.verdict / view.open_work / view.codes / view.code_counts /\n58\t# view.attempted / view.freeze_frames / view.blind_spots / view.bulletins /\n59\t# view.latest / view.provenance_note).\n60\t\n61\tVIEW_FIXTURE = {\n62\t    \"verdict\": {\n63\t        \"state\": \"UNVERIFIED_REPAIR\",\n64\t        \"label\": \"UNVERIFIED REPAIR\",\n65\t        \"summary\": \"EVAP leak (P0455/P0440/P0456) cleared 29 Sep -- monitors \"\n66\t                    \"have not re-run. Not proof of repair.\",\n67\t        \"basis\": [\n68\t            \"P0455/P0440/P0456 cleared 29 Sep 2026\",\n69\t            \"No session since the clear has re-run the EVAP monitor\",\n70\t        ],\n71\t        \"cleared_at\": \"2026-09-29\", \"cleared_by\": \"MultiEcuScan\",\n72\t        # evap_monitor here is the string form (\"complete\"/\"incomplete\"/\n73\t        # \"not_supported\"/None) dossier_bridge._evap_from_readiness returns --\n74\t        # NOT a bool. verify.html's own `result.evap_monitor` (a separate,\n75\t        # boolean field from dossier_bridge.readiness_result) is covered\n76\t        # below under VERIFY_RESULT_FIXTURE.\n77\t        \"readiness\": {\"at\": \"2026-09-29 18:02\", \"evap_monitor\": \"incomplete\", \"all_complete\": False},\n78\t        \"actions\": [\n79\t            {\"label\": \"Verify repair\", \"kind\": \"readiness\", \"href\": f\"/v/{VIN}/verify\",\n80\t             \"enabled\": True, \"hint\": None},\n81\t            {\"label\": \"EVAP fault tree\", \"kind\": \"link\", \"href\": f\"/v/{VIN}/tree?codes=P0455\",\n82\t             \"enabled\": True, \"hint\": None},\n83\t            {\"label\": \"Evidence gate\", \"kind\": \"link\", \"href\": f\"/v/{VIN}/gate\",\n84\t             \"enabled\": False, \"hint\": \"connect car first\"},\n85\t        ],\n86\t    },\n87\t    \"open_work\": [\n88\t        {\n89\t            \"family\": \"EVAP\", \"title\": \"EVAP -- one system fault\",\n90\t            \"codes\": [\"P0440\", \"P0455\", \"P0456\"],\n91\t            \"steps\": [\n92\t                {\"id\": \"evap-1\", \"text\": \"Inspect recirculation-line quick-connect\",\n93\t                 \"ref\": \"S2125000002\", \"ref_href\": \"#S2125000002\", \"done\": True,\n94\t                 \"done_at\": \"2026-10-01\", \"done_by\": \"me\"},\n95\t                {\"id\": \"evap-2\", \"text\": \"Actuate purge/vent solenoid KOEO\",\n96\t                 \"ref\": None, \"ref_href\": None, \"done\": False,\n97\t                 \"done_at\": None, \"done_by\": None},\n98\t            ],\n99\t            \"refs\": [{\"label\": \"S2125000002\", \"href\": \"#S2125000002\"},\n100\t                     {\"label\": \"docs/research/EVAP_STELVIO.md\", \"href\": None}],\n101\t            \"progress\": {\"done\": 1, \"total\": 2},\n102\t        },\n103\t        {\n104\t            \"family\": \"NETWORK\", \"title\": \"Network -- one power/bus event\",\n105\t            \"codes\": [\"U0100\", \"U0101\"],\n106\t            \"steps\": [\n107\t                {\"id\": \"net-1\", \"text\": \"Check F82/BCM supply\", \"ref\": None,\n108\t                 \"ref_href\": None, \"done\": False, \"done_at\": None, \"done_by\": None},\n109\t            ],\n110\t            \"refs\": [],\n111\t            \"progress\": {\"done\": 0, \"total\": 1},\n112\t        },\n113\t    ],\n114\t    \"codes\": [\n115\t        {\"code\": \"P0456\", \"dtc\": \"P0456-00\", \"description\": \"EVAP system small leak\",\n116\t         \"system\": \"engine\", \"bucket\": \"chronic\", \"status\": \"ACTIVE\",\n117\t         \"status_label\": \"ACTIVE\", \"sessions\": 11, \"last_seen_short\": \"25 Sep\",\n118\t         \"last_seen\": \"2026-09-25 20:27:00\", \"first_seen\": \"2025-09-24\",\n119\t         \"distance_km\": 26500, \"href\": f\"/v/{VIN}/code/P0456\", \"family\": \"EVAP\"},\n120\t        {\"code\": \"P0300\", \"dtc\": \"P0300-00\", \"description\": \"Random/multiple cylinder misfire\",\n121\t         \"system\": \"engine\", \"bucket\": \"seen_once\", \"status\": \"STALE\",\n122\t         \"status_label\": \"STALE\", \"sessions\": 1, \"last_seen_short\": \"3 Aug\",\n123\t         \"last_seen\": \"2026-08-03 09:00:00\", \"first_seen\": \"2026-08-03\",\n124\t         \"distance_km\": None, \"href\": f\"/v/{VIN}/code/P0300\", \"family\": None},\n125\t    ],\n126\t    \"code_counts\": {\"chronic\": 11, \"seen_once\": 17, \"returned_after_clear\": 0,\n127\t                     \"active\": 1, \"stale\": 1},\n128\t    \"attempted\": [\n129\t        {\"operation\": \"Evaporation control valve\", \"kind\": \"actuator\",\n130\t         \"outcome\": \"FAILED TO EXECUTE\", \"count\": 2, \"first_short\": \"15 Sep\",\n131\t         \"last_short\": \"15 Sep\", \"reason\": \"Engine running\", \"reason_chip\": \"interlock\",\n132\t         \"footnote\": \"key-on engine-off; “Engine running” is an interlock, not a fault.\",\n133\t         \"rows\": [{\"timestamp\": \"2026-09-15 21:18:00\", \"outcome\": \"FAILED TO EXECUTE\"}]},\n134\t        {\"operation\": \"Evaporation control valve\", \"kind\": \"actuator\",\n135\t         \"outcome\": \"COMPLETED\", \"count\": 8, \"first_short\": \"15 Sep\",\n136\t         \"last_short\": \"15 Sep\", \"reason\": None, \"reason_chip\": None,\n137\t         \"footnote\": None, \"rows\": []},\n138\t    ],\n139\t    \"freeze_frames\": [\n140\t        {\"code\": \"P0455\", \"set_km_ago\": 360,\n141\t         \"key\": [{\"name\": \"Fuel level\", \"value\": \"93.7 %\", \"flag\": \"above 85%: EVAP monitor could not run\"},\n142\t                  {\"name\": \"Engine temp\", \"value\": \"89 C\", \"flag\": None}],\n143\t         \"all\": [{\"name\": \"Fuel level\", \"value\": \"93.7 %\"}, {\"name\": \"Engine temp\", \"value\": \"89 C\"}]},\n144\t    ],\n145\t    \"blind_spots\": [\n146\t        {\"question\": \"Has the EVAP monitor actually re-run since the clear?\",\n147\t         \"why\": \"A log corpus cannot see a monitor that has not completed a session yet.\",\n148\t         \"action\": {\"label\": \"Read readiness\", \"kind\": \"readiness\", \"href\": f\"/v/{VIN}/verify\",\n149\t                     \"enabled\": True, \"hint\": None}},\n150\t        {\"question\": \"Is the calibration level current?\",\n151\t         \"why\": \"Only a dealer tool can read the PCM calibration ID.\",\n152\t         \"action\": {\"label\": \"wiTECH required\", \"kind\": \"dealer\", \"href\": None,\n153\t                     \"enabled\": False, \"hint\": \"needs wiTECH\"}},\n154\t    ],\n155\t    \"bulletins\": [\n156\t        {\"id\": \"S2125000002\", \"anchor\": \"S2125000002\", \"title\": \"Check recirc-line quick-connect\",\n157\t         \"action\": \"Check the quick-connect O-ring before replacing parts.\",\n158\t         \"caution\": None, \"codes\": [\"P0440\", \"P0455\", \"P0456\"], \"superseded\": None,\n159\t         \"source\": \"MOPAR S2125000002\", \"relevance\": 1},\n160\t        {\"id\": \"18-030-17\", \"anchor\": \"tsb-18-030-17\", \"title\": \"EVAP PCM calibration\",\n161\t         \"action\": \"Check PCM calibration before condemning hardware.\",\n162\t         \"caution\": \"Rev B supersedes Rev A.\", \"codes\": [\"P0455\"], \"superseded\": \"Rev A\",\n163\t         \"source\": \"TSB 18-030-17 REV. B\", \"relevance\": 2},\n164\t    ],\n165\t    \"latest\": {\"session_short\": \"04 Oct 11:16\", \"session_file\": \"FESLog_2610041116.txt\",\n166\t               \"ecu\": \"IAW 10JA\", \"scan_short\": None, \"scan_file\": None},\n167\t    \"provenance_note\": \"These are what a log corpus structurally cannot answer.\",\n168\t}\n169\t\n170\tBASE_CTX = {\n171\t    \"version\": \"test\", \"profile\": \"bench\",\n172\t    \"live_strip\": {\"error\": None, \"mes_state\": \"idle\", \"port\": \"COM3\", \"baud\": 500000,\n173\t                    \"cable\": \"OBD\", \"buses_verified\": 1, \"buses_total\": 3, \"lock_holder\": None},\n174\t    \"live_panel\": {\"error\": None, \"buses\": [{\"bus\": \"CAN-C\", \"reachable_with_cable\": True, \"verified\": True}],\n175\t                    \"modules\": []},\n176\t    \"notes_list\": [], \"note_target_kind\": \"vehicle\", \"note_target_id\": \"\",\n177\t    \"note_redirect\": f\"/v/{VIN}\", \"note_kind_locked\": True,\n178\t    \"tab\": \"dossier\",\n179\t    \"bar\": {\"vin\": VIN, \"name\": \"Alfa Romeo Stelvio 2.0 Turbo 16V MultiAir\",\n180\t            \"logs\": 17, \"first_log\": \"2025-09-24\", \"last_log\": \"2026-10-04\",\n181\t            \"odo_first\": 115790, \"odo_last\": 142290, \"odo_span\": 26500,\n182\t            \"ecus\": [\"IAW 10JA\"]},\n183\t    \"vin\": VIN,\n184\t    \"open_codes\": [\"P0456\"],\n185\t}\n186\t\n187\t\n188\tdef render(name: str, **extra) -> str:\n189\t    ctx = dict(BASE_CTX)\n190\t    ctx.update(extra)\n191\t    return templates.env.get_template(name).render(**ctx)\n192\t\n193\t\n194\t# --- vehicle.html rendered directly with the view fixture -------------------\n195\t\n196\thtml = render(\"vehicle.html\", view=VIEW_FIXTURE, d={})\n197\t\n198\tcheck(\"verdict chip text present\", \"UNVERIFIED REPAIR\" in html)\n199\tcheck(\"verdict sentence present\", \"Not proof of repair\" in html)\n200\tcheck(\"no raw python-dict repr anywhere ({'family')\", \"{'family'\" not in html)\n201\tcheck(\"no raw python-dict repr anywhere ({\\\"family\\\")\", '{\"family\"' not in html)\n202\tcheck(\"no raw dict repr of a code row ({'code')\", \"{'code'\" not in html)\n203\tcheck(\"no raw dict repr of a step row ({'id')\", \"{'id'\" not in html)\n204\t\n205\tfor b in VIEW_FIXTURE[\"bulletins\"]:\n206\t    anchor_html = f'id=\"{b[\"anchor\"]}\"'\n207\t    check(f\"bulletin anchor {b['id']} appears exactly once\", html.count(anchor_html) == 1,\n208\t          str(html.count(anchor_html)))\n209\t    check(f\"bulletin {b['id']} title present\", b[\"title\"] in html)\n210\t\n211\tfor job in VIEW_FIXTURE[\"open_work\"]:\n212\t    for step in job[\"steps\"]:\n213\t        needle = f'name=\"step_id\" value=\"{step[\"id\"]}\"'\n214\t        check(f\"checklist form present for step {step['id']}\", needle in html, html.count(needle))\n215\t    check(f\"job card title present for {job['family']}\", job[\"title\"] in html)\n216\t\n217\tcheck(\"job progress shown as N/total, not a raw dict\", \"1/2\" in html and \"0/1\" in html)\n218\tcheck(\"checklist steps post to /v/{vin}/checklist\",\n219\t      f'action=\"/v/{VIN}/checklist\"' in html)\n220\tcheck(\"freeze-frame flag rendered as text, not a dict\",\n221\t      \"above 85%: EVAP monitor could not run\" in html)\n222\tcheck(\"blind spot dealer tag rendered, not a button, when no tool can run it\",\n223\t      \"wiTECH required\" in html)\n224\tcheck(\"open-work section renders before the collapsed cards\",\n225\t      html.index('id=\"open-work\"') < html.index('id=\"sec-history\"'))\n226\tcheck(\"history section is a <details> (collapsed by default pattern)\",\n227\t      '<details class=\"card-details\" id=\"sec-history\"' in html)\n228\tcheck(\"quick-add note FAB present\", 'id=\"quick-add-note\"' in html)\n229\t\n230\t\n231\t# --- the real route, against the real Stelvio corpus ------------------------\n232\t# `view` now lands here from dossier_bridge.build_view(); verdict.label is\n233\t# sentence case (\"Unverified repair\"/\"Active faults\"/\"Verified clean\"/\n234\t# \"No data\") -- CSS uppercases it for display, the DOM text itself is not\n235\t# uppercase, so assert against the real casing rather than SHOUTING text.\n236\t\n237\tclient = TestClient(create_app())\n238\t\n239\tpage = client.get(f\"/v/{VIN}\")\n240\tcheck(\"dossier page responds 200\", page.status_code == 200, str(page.status_code))\n241\tcheck(\"dossier page is HTML\", \"<html\" in page.text.lower())\n242\t\n243\tVERDICT_LABELS = (\"Unverified repair\", \"Active faults\", \"Verified clean\", \"No data\")\n244\tview_has_landed = any(lbl in page.text for lbl in VERDICT_LABELS)\n245\tcheck(\"live /v/{vin} route's view has landed (verdict card present)\", view_has_landed,\n246\t      \"none of \" + str(VERDICT_LABELS) + \" found in the real page\")\n247\tcheck(\"live route's verdict card is a real chip, not a raw dict\",\n248\t      'class=\"chip-verdict' in page.text)\n249\tcheck(\"live route's open-work / history cards present, no raw dict anywhere\",\n250\t      \"{'family'\" not in page.text and '{\"family\"' not in page.text\n251\t      and \"{'code'\" not in page.text and '{\"code\"' not in page.text)\n252\tcheck(\"live route shows the EVAP family as one job card\",\n253\t      \"EVAP\" in page.text and 'class=\"job-card\"' in page.text)\n254\tcheck(\"live route shows the network family's real title\",\n255\t      \"Network\" in page.text and \"power/bus event\" in page.text)\n256\tcheck(\"live route's history card summary carries real chronic/stale counts\",\n257\t      'id=\"sec-history\"' in page.text)\n258\t\n259\t\n260\t# --- verify.html: direct-render with a fixture, plus the live route --------\n261\t\n262\tverify_ctx = dict(BASE_CTX)\n263\tverify_ctx.update({\n264\t    # the real shape (dossier_bridge.readiness_result): evap_monitor is a\n265\t    # plain bool here, unlike view.verdict.readiness.evap_monitor above.\n266\t    \"result\": {\"at\": \"2026-09-29 18:02\", \"evap_monitor\": False, \"all_complete\": False,\n267\t               \"monitors\": [{\"name\": \"Evaporative system\", \"complete\": False}]},\n268\t    \"verdict\": VIEW_FIXTURE[\"verdict\"],\n269\t})\n270\tverify_html = templates.env.get_template(\"verify.html\").render(**verify_ctx)\n271\tcheck(\"verify page (direct render) shows the verdict\", \"UNVERIFIED REPAIR\" in verify_html)\n272\tcheck(\"verify page (direct render) shows readiness state\", \"not yet run\" in verify_html)\n273\tcheck(\"verify page (direct render) has a big back-to-dossier button\",\n274\t      \"Back to dossier\" in verify_html and f'href=\"/v/{VIN}\"' in verify_html)\n275\tcheck(\"verify page (direct render) carries no raw dict\",\n276\t      \"{'at'\" not in verify_html and '{\"at\"' not in verify_html)\n277\t\n278\tverify_resp = client.get(f\"/v/{VIN}/verify\")\n279\tcheck(\"live /v/{vin}/verify route responds 200\", verify_resp.status_code == 200,\n280\t      str(verify_resp.status_code))\n281\tcheck(\"live verify page has the back-to-dossier button\",\n282\t      \"Back to dossier\" in verify_resp.text)\n283\tcheck(\"live verify page shows a verdict (sentence case label)\",\n284\t      any(lbl in verify_resp.text for lbl in VERDICT_LABELS))\n285\t\n286\t\n287\t# --- checklist round-trip: real step id, real route, real redirect ---------\n288\t\n289\tview_json = client.get(f\"/api/vehicles/{VIN}/view\").json()\n290\tfirst_step = None\n291\tfor job in view_json.get(\"open_work\", []):\n292\t    if job.get(\"steps\"):\n293\t        first_step = job[\"steps\"][0]\n294\t        break\n295\tcheck(\"the real view exposes at least one checklist step to tick\", first_step is not None,\n296\t      str(view_json.get(\"open_work\")))\n297\t\n298\tif first_step is not None:\n299\t    step_id = first_step[\"id\"]\n300\t    was_done = bool(first_step[\"done\"])\n301\t    toggled = client.post(f\"/v/{VIN}/checklist\",\n302\t                          data={\"step_id\": step_id, \"done\": \"0\" if was_done else \"1\"},\n303\t                          follow_redirects=True)\n304\t    check(\"ticking a real checklist step via the dossier form responds 200\",\n305\t          toggled.status_code == 200, str(toggled.status_code))\n306\t    check(\"the dossier form POST redirected back to #open-work\",\n307\t          str(toggled.url).endswith(f\"/v/{VIN}#open-work\")\n308\t          or str(toggled.url).endswith(f\"/v/{VIN}\"), str(toggled.url))\n309\t\n310\t    api_state = client.get(f\"/api/vehicles/{VIN}/checklist\").json()\n311\t    entry = (api_state.get(\"checklist\") or {}).get(step_id)\n312\t    check(\"the JSON checklist store reflects the tick made through the HTML form\",\n313\t          entry is not None and bool(entry.get(\"done\")) != was_done, str(entry))\n314\t\n315\t    # leave it as we found it\n316\t    client.post(f\"/v/{VIN}/checklist\", data={\"step_id\": step_id, \"done\": \"1\" if was_done else \"0\"})\n317\t\n318\tbad_step = client.post(f\"/v/{VIN}/checklist\", data={\"step_id\": \"not-a-real-step\", \"done\": \"1\"})\n319\tcheck(\"an unknown checklist step id is rejected (400), not silently accepted\",\n320\t      bad_step.status_code == 400, str(bad_step.status_code))\n321\t\n322\t\n323\tprint()\n324\tif failures:\n325\t    print(f\"{len(failures)}/{checks} check(s) failed:\")\n326\t    for f in failures:\n327\t        print(f\"  - {f}\")\n328\t    sys.exit(1)\n329\tprint(f\"all {checks} checks passed\")\n330\t"}]},"uuid":"9601af3e-c6b4-4438-aab5-c7cc7e4ca853","timestamp":"2026-10-08T03:04:07.931Z","toolUseResult":{"type":"text","file":{"filePath":"C:\\Users\\User\\mcp-servers\\cuore\\tests\\check_dossier_page.py","content":"\"\"\"Smoke checks for the rebuilt vehicle dossier page (MECHANIC_UX_REVIEW.md).\n\nSame posture as ``cuore/tests/check_notes_page.py``: ``CUORE_STATE_DIR`` is\npointed at a throwaway directory BEFORE cuore is imported.\n\nThis exercises both sides:\n\n  * The template-content checks (verdict chip, no raw dicts, bulletin\n    anchors, checklist forms) render ``vehicle.html``/``verify.html``\n    directly through the same Jinja environment ``cuore.web.routes`` uses,\n    with a fixture ``view``/``result``/``verdict`` built to the agreed\n    shape. This is deterministic regardless of the real route/corpus.\n  * The real-route checks go through the real app (TestClient) against\n    the Stelvio's real corpus (``view`` now lands on ``/v/{vin}`` from\n    ``cuore.services.dossier_bridge.build_view``, and ``/v/{vin}/verify``\n    plus the checklist routes are wired in ``cuore/web/dossier_routes.py``\n    and ``cuore/api/checklists.py``) -- both landed while this file was\n    being written, so these assert the real rendered content, not just a\n    fallback.\n\nRun:\n    .venv/Scripts/python.exe cuore/tests/check_dossier_page.py\n\"\"\"\n\nfrom __future__ import annotations\n\nimport os\nimport sys\nimport tempfile\nfrom pathlib import Path\n\n# Before any cuore import: state goes to a throwaway directory.\nos.environ[\"CUORE_STATE_DIR\"] = tempfile.mkdtemp(prefix=\"cuore-check-dossier-\")\nos.environ.pop(\"CUORE_AUDIT_PATH\", None)\n\nsys.path.insert(0, str(Path(__file__).resolve().parents[2]))\n\nfrom fastapi.testclient import TestClient  # noqa: E402\n\nfrom cuore.app import create_app  # noqa: E402\nfrom cuore.web.routes import templates  # noqa: E402\n\nVIN = \"ZASFAKPN5J7B88115\"  # the Stelvio -- real corpus, chronic P0456/P0440/P0456\n\nfailures: list[str] = []\nchecks = 0\n\n\ndef check(label: str, cond: bool, detail: str = \"\") -> None:\n    global checks\n    checks += 1\n    if not cond:\n        failures.append(f\"{label}{(' -- ' + detail) if detail else ''}\")\n\n\n# --- the view fixture, built to the shape the backend route will supply ----\n# (view.verdict / view.open_work / view.codes / view.code_counts /\n# view.attempted / view.freeze_frames / view.blind_spots / view.bulletins /\n# view.latest / view.provenance_note).\n\nVIEW_FIXTURE = {\n    \"verdict\": {\n        \"state\": \"UNVERIFIED_REPAIR\",\n        \"label\": \"UNVERIFIED REPAIR\",\n        \"summary\": \"EVAP leak (P0455/P0440/P0456) cleared 29 Sep -- monitors \"\n                    \"have not re-run. Not proof of repair.\",\n        \"basis\": [\n            \"P0455/P0440/P0456 cleared 29 Sep 2026\",\n            \"No session since the clear has re-run the EVAP monitor\",\n        ],\n        \"cleared_at\": \"2026-09-29\", \"cleared_by\": \"MultiEcuScan\",\n        # evap_monitor here is the string form (\"complete\"/\"incomplete\"/\n        # \"not_supported\"/None) dossier_bridge._evap_from_readiness returns --\n        # NOT a bool. verify.html's own `result.evap_monitor` (a separate,\n        # boolean field from dossier_bridge.readiness_result) is covered\n        # below under VERIFY_RESULT_FIXTURE.\n        \"readiness\": {\"at\": \"2026-09-29 18:02\", \"evap_monitor\": \"incomplete\", \"all_complete\": False},\n        \"actions\": [\n            {\"label\": \"Verify repair\", \"kind\": \"readiness\", \"href\": f\"/v/{VIN}/verify\",\n             \"enabled\": True, \"hint\": None},\n            {\"label\": \"EVAP fault tree\", \"kind\": \"link\", \"href\": f\"/v/{VIN}/tree?codes=P0455\",\n             \"enabled\": True, \"hint\": None},\n            {\"label\": \"Evidence gate\", \"kind\": \"link\", \"href\": f\"/v/{VIN}/gate\",\n             \"enabled\": False, \"hint\": \"connect car first\"},\n        ],\n    },\n    \"open_work\": [\n        {\n            \"family\": \"EVAP\", \"title\": \"EVAP -- one system fault\",\n            \"codes\": [\"P0440\", \"P0455\", \"P0456\"],\n            \"steps\": [\n                {\"id\": \"evap-1\", \"text\": \"Inspect recirculation-line quick-connect\",\n                 \"ref\": \"S2125000002\", \"ref_href\": \"#S2125000002\", \"done\": True,\n                 \"done_at\": \"2026-10-01\", \"done_by\": \"me\"},\n                {\"id\": \"evap-2\", \"text\": \"Actuate purge/vent solenoid KOEO\",\n                 \"ref\": None, \"ref_href\": None, \"done\": False,\n                 \"done_at\": None, \"done_by\": None},\n            ],\n            \"refs\": [{\"label\": \"S2125000002\", \"href\": \"#S2125000002\"},\n                     {\"label\": \"docs/research/EVAP_STELVIO.md\", \"href\": None}],\n            \"progress\": {\"done\": 1, \"total\": 2},\n        },\n        {\n            \"family\": \"NETWORK\", \"title\": \"Network -- one power/bus event\",\n            \"codes\": [\"U0100\", \"U0101\"],\n            \"steps\": [\n                {\"id\": \"net-1\", \"text\": \"Check F82/BCM supply\", \"ref\": None,\n                 \"ref_href\": None, \"done\": False, \"done_at\": None, \"done_by\": None},\n            ],\n            \"refs\": [],\n            \"progress\": {\"done\": 0, \"total\": 1},\n        },\n    ],\n    \"codes\": [\n        {\"code\": \"P0456\", \"dtc\": \"P0456-00\", \"description\": \"EVAP system small leak\",\n         \"system\": \"engine\", \"bucket\": \"chronic\", \"status\": \"ACTIVE\",\n         \"status_label\": \"ACTIVE\", \"sessions\": 11, \"last_seen_short\": \"25 Sep\",\n         \"last_seen\": \"2026-09-25 20:27:00\", \"first_seen\": \"2025-09-24\",\n         \"distance_km\": 26500, \"href\": f\"/v/{VIN}/code/P0456\", \"family\": \"EVAP\"},\n        {\"code\": \"P0300\", \"dtc\": \"P0300-00\", \"description\": \"Random/multiple cylinder misfire\",\n         \"system\": \"engine\", \"bucket\": \"seen_once\", \"status\": \"STALE\",\n         \"status_label\": \"STALE\", \"sessions\": 1, \"last_seen_short\": \"3 Aug\",\n         \"last_seen\": \"2026-08-03 09:00:00\", \"first_seen\": \"2026-08-03\",\n         \"distance_km\": None, \"href\": f\"/v/{VIN}/code/P0300\", \"family\": None},\n    ],\n    \"code_counts\": {\"chronic\": 11, \"seen_once\": 17, \"returned_after_clear\": 0,\n                     \"active\": 1, \"stale\": 1},\n    \"attempted\": [\n        {\"operation\": \"Evaporation control valve\", \"kind\": \"actuator\",\n         \"outcome\": \"FAILED TO EXECUTE\", \"count\": 2, \"first_short\": \"15 Sep\",\n         \"last_short\": \"15 Sep\", \"reason\": \"Engine running\", \"reason_chip\": \"interlock\",\n         \"footnote\": \"key-on engine-off; “Engine running” is an interlock, not a fault.\",\n         \"rows\": [{\"timestamp\": \"2026-09-15 21:18:00\", \"outcome\": \"FAILED TO EXECUTE\"}]},\n        {\"operation\": \"Evaporation control valve\", \"kind\": \"actuator\",\n         \"outcome\": \"COMPLETED\", \"count\": 8, \"first_short\": \"15 Sep\",\n         \"last_short\": \"15 Sep\", \"reason\": None, \"reason_chip\": None,\n         \"footnote\": None, \"rows\": []},\n    ],\n    \"freeze_frames\": [\n        {\"code\": \"P0455\", \"set_km_ago\": 360,\n         \"key\": [{\"name\": \"Fuel level\", \"value\": \"93.7 %\", \"flag\": \"above 85%: EVAP monitor could not run\"},\n                  {\"name\": \"Engine temp\", \"value\": \"89 C\", \"flag\": None}],\n         \"all\": [{\"name\": \"Fuel level\", \"value\": \"93.7 %\"}, {\"name\": \"Engine temp\", \"value\": \"89 C\"}]},\n    ],\n    \"blind_spots\": [\n        {\"question\": \"Has the EVAP monitor actually re-run since the clear?\",\n         \"why\": \"A log corpus cannot see a monitor that has not completed a session yet.\",\n         \"action\": {\"label\": \"Read readiness\", \"kind\": \"readiness\", \"href\": f\"/v/{VIN}/verify\",\n                     \"enabled\": True, \"hint\": None}},\n        {\"question\": \"Is the calibration level current?\",\n         \"why\": \"Only a dealer tool can read the PCM calibration ID.\",\n         \"action\": {\"label\": \"wiTECH required\", \"kind\": \"dealer\", \"href\": None,\n                     \"enabled\": False, \"hint\": \"needs wiTECH\"}},\n    ],\n    \"bulletins\": [\n        {\"id\": \"S2125000002\", \"anchor\": \"S2125000002\", \"title\": \"Check recirc-line quick-connect\",\n         \"action\": \"Check the quick-connect O-ring before replacing parts.\",\n         \"caution\": None, \"codes\": [\"P0440\", \"P0455\", \"P0456\"], \"superseded\": None,\n         \"source\": \"MOPAR S2125000002\", \"relevance\": 1},\n        {\"id\": \"18-030-17\", \"anchor\": \"tsb-18-030-17\", \"title\": \"EVAP PCM calibration\",\n         \"action\": \"Check PCM calibration before condemning hardware.\",\n         \"caution\": \"Rev B supersedes Rev A.\", \"codes\": [\"P0455\"], \"superseded\": \"Rev A\",\n         \"source\": \"TSB 18-030-17 REV. B\", \"relevance\": 2},\n    ],\n    \"latest\": {\"session_short\": \"04 Oct 11:16\", \"session_file\": \"FESLog_2610041116.txt\",\n               \"ecu\": \"IAW 10JA\", \"scan_short\": None, \"scan_file\": None},\n    \"provenance_note\": \"These are what a log corpus structurally cannot answer.\",\n}\n\nBASE_CTX = {\n    \"version\": \"test\", \"profile\": \"bench\",\n    \"live_strip\": {\"error\": None, \"mes_state\": \"idle\", \"port\": \"COM3\", \"baud\": 500000,\n                    \"cable\": \"OBD\", \"buses_verified\": 1, \"buses_total\": 3, \"lock_holder\": None},\n    \"live_panel\": {\"error\": None, \"buses\": [{\"bus\": \"CAN-C\", \"reachable_with_cable\": True, \"verified\": True}],\n                    \"modules\": []},\n    \"notes_list\": [], \"note_target_kind\": \"vehicle\", \"note_target_id\": \"\",\n    \"note_redirect\": f\"/v/{VIN}\", \"note_kind_locked\": True,\n    \"tab\": \"dossier\",\n    \"bar\": {\"vin\": VIN, \"name\": \"Alfa Romeo Stelvio 2.0 Turbo 16V MultiAir\",\n            \"logs\": 17, \"first_log\": \"2025-09-24\", \"last_log\": \"2026-10-04\",\n            \"odo_first\": 115790, \"odo_last\": 142290, \"odo_span\": 26500,\n            \"ecus\": [\"IAW 10JA\"]},\n    \"vin\": VIN,\n    \"open_codes\": [\"P0456\"],\n}\n\n\ndef render(name: str, **extra) -> str:\n    ctx = dict(BASE_CTX)\n    ctx.update(extra)\n    return templates.env.get_template(name).render(**ctx)\n\n\n# --- vehicle.html rendered directly with the view fixture -------------------\n\nhtml = render(\"vehicle.html\", view=VIEW_FIXTURE, d={})\n\ncheck(\"verdict chip text present\", \"UNVERIFIED REPAIR\" in html)\ncheck(\"verdict sentence present\", \"Not proof of repair\" in html)\ncheck(\"no raw python-dict repr anywhere ({'family')\", \"{'family'\" not in html)\ncheck(\"no raw python-dict repr anywhere ({\\\"family\\\")\", '{\"family\"' not in html)\ncheck(\"no raw dict repr of a code row ({'code')\", \"{'code'\" not in html)\ncheck(\"no raw dict repr of a step row ({'id')\", \"{'id'\" not in html)\n\nfor b in VIEW_FIXTURE[\"bulletins\"]:\n    anchor_html = f'id=\"{b[\"anchor\"]}\"'\n    check(f\"bulletin anchor {b['id']} appears exactly once\", html.count(anchor_html) == 1,\n          str(html.count(anchor_html)))\n    check(f\"bulletin {b['id']} title present\", b[\"title\"] in html)\n\nfor job in VIEW_FIXTURE[\"open_work\"]:\n    for step in job[\"steps\"]:\n        needle = f'name=\"step_id\" value=\"{step[\"id\"]}\"'\n        check(f\"checklist form present for step {step['id']}\", needle in html, html.count(needle))\n    check(f\"job card title present for {job['family']}\", job[\"title\"] in html)\n\ncheck(\"job progress shown as N/total, not a raw dict\", \"1/2\" in html and \"0/1\" in html)\ncheck(\"checklist steps post to /v/{vin}/checklist\",\n      f'action=\"/v/{VIN}/checklist\"' in html)\ncheck(\"freeze-frame flag rendered as text, not a dict\",\n      \"above 85%: EVAP monitor could not run\" in html)\ncheck(\"blind spot dealer tag rendered, not a button, when no tool can run it\",\n      \"wiTECH required\" in html)\ncheck(\"open-work section renders before the collapsed cards\",\n      html.index('id=\"open-work\"') < html.index('id=\"sec-history\"'))\ncheck(\"history section is a <details> (collapsed by default pattern)\",\n      '<details class=\"card-details\" id=\"sec-history\"' in html)\ncheck(\"quick-add note FAB present\", 'id=\"quick-add-note\"' in html)\n\n\n# --- the real route, against the real Stelvio corpus ------------------------\n# `view` now lands here from dossier_bridge.build_view(); verdict.label is\n# sentence case (\"Unverified repair\"/\"Active faults\"/\"Verified clean\"/\n# \"No data\") -- CSS uppercases it for display, the DOM text itself is not\n# uppercase, so assert against the real casing rather than SHOUTING text.\n\nclient = TestClient(create_app())\n\npage = client.get(f\"/v/{VIN}\")\ncheck(\"dossier page responds 200\", page.status_code == 200, str(page.status_code))\ncheck(\"dossier page is HTML\", \"<html\" in page.text.lower())\n\nVERDICT_LABELS = (\"Unverified repair\", \"Active faults\", \"Verified clean\", \"No data\")\nview_has_landed = any(lbl in page.text for lbl in VERDICT_LABELS)\ncheck(\"live /v/{vin} route's view has landed (verdict card present)\", view_has_landed,\n      \"none of \" + str(VERDICT_LABELS) + \" found in the real page\")\ncheck(\"live route's verdict card is a real chip, not a raw dict\",\n      'class=\"chip-verdict' in page.text)\ncheck(\"live route's open-work / history cards present, no raw dict anywhere\",\n      \"{'family'\" not in page.text and '{\"family\"' not in page.text\n      and \"{'code'\" not in page.text and '{\"code\"' not in page.text)\ncheck(\"live route shows the EVAP family as one job card\",\n      \"EVAP\" in page.text and 'class=\"job-card\"' in page.text)\ncheck(\"live route shows the network family's real title\",\n      \"Network\" in page.text and \"power/bus event\" in page.text)\ncheck(\"live route's history card summary carries real chronic/stale counts\",\n      'id=\"sec-history\"' in page.text)\n\n\n# --- verify.html: direct-render with a fixture, plus the live route --------\n\nverify_ctx = dict(BASE_CTX)\nverify_ctx.update({\n    # the real shape (dossier_bridge.readiness_result): evap_monitor is a\n    # plain bool here, unlike view.verdict.readiness.evap_monitor above.\n    \"result\": {\"at\": \"2026-09-29 18:02\", \"evap_monitor\": False, \"all_complete\": False,\n               \"monitors\": [{\"name\": \"Evaporative system\", \"complete\": False}]},\n    \"verdict\": VIEW_FIXTURE[\"verdict\"],\n})\nverify_html = templates.env.get_template(\"verify.html\").render(**verify_ctx)\ncheck(\"verify page (direct render) shows the verdict\", \"UNVERIFIED REPAIR\" in verify_html)\ncheck(\"verify page (direct render) shows readiness state\", \"not yet run\" in verify_html)\ncheck(\"verify page (direct render) has a big back-to-dossier button\",\n      \"Back to dossier\" in verify_html and f'href=\"/v/{VIN}\"' in verify_html)\ncheck(\"verify page (direct render) carries no raw dict\",\n      \"{'at'\" not in verify_html and '{\"at\"' not in verify_html)\n\nverify_resp = client.get(f\"/v/{VIN}/verify\")\ncheck(\"live /v/{vin}/verify route responds 200\", verify_resp.status_code == 200,\n      str(verify_resp.status_code))\ncheck(\"live verify page has the back-to-dossier button\",\n      \"Back to dossier\" in verify_resp.text)\ncheck(\"live verify page shows a verdict (sentence case label)\",\n      any(lbl in verify_resp.text for lbl in VERDICT_LABELS))\n\n\n# --- checklist round-trip: real step id, real route, real redirect ---------\n\nview_json = client.get(f\"/api/vehicles/{VIN}/view\").json()\nfirst_step = None\nfor job in view_json.get(\"open_work\", []):\n    if job.get(\"steps\"):\n        first_step = job[\"steps\"][0]\n        break\ncheck(\"the real view exposes at least one checklist step to tick\", first_step is not None,\n      str(view_json.get(\"open_work\")))\n\nif first_step is not None:\n    step_id = first_step[\"id\"]\n    was_done = bool(first_step[\"done\"])\n    toggled = client.post(f\"/v/{VIN}/checklist\",\n                          data={\"step_id\": step_id, \"done\": \"0\" if was_done else \"1\"},\n                          follow_redirects=True)\n    check(\"ticking a real checklist step via the dossier form responds 200\",\n          toggled.status_code == 200, str(toggled.status_code))\n    check(\"the dossier form POST redirected back to #open-work\",\n          str(toggled.url).endswith(f\"/v/{VIN}#open-work\")\n          or str(toggled.url).endswith(f\"/v/{VIN}\"), str(toggled.url))\n\n    api_state = client.get(f\"/api/vehicles/{VIN}/checklist\").json()\n    entry = (api_state.get(\"checklist\") or {}).get(step_id)\n    check(\"the JSON checklist store reflects the tick made through the HTML form\",\n          entry is not None and bool(entry.get(\"done\")) != was_done, str(entry))\n\n    # leave it as we found it\n    client.post(f\"/v/{VIN}/checklist\", data={\"step_id\": step_id, \"done\": \"1\" if was_done else \"0\"})\n\nbad_step = client.post(f\"/v/{VIN}/checklist\", data={\"step_id\": \"not-a-real-step\", \"done\": \"1\"})\ncheck(\"an unknown checklist step id is rejected (400), not silently accepted\",\n      bad_step.status_code == 400, str(bad_step.status_code))\n\n\nprint()\nif failures:\n    print(f\"{len(failures)}/{checks} check(s) failed:\")\n    for f in failures:\n        print(f\"  - {f}\")\n    sys.exit(1)\nprint(f\"all {checks} checks passed\")\n","numLines":330,"startLine":1,"totalLines":330}},"sourceToolAssistantUUID":"6e028702-f242-4325-b58d-9ecda8fd0465","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
{"parentUuid":"9601af3e-c6b4-4438-aab5-c7cc7e4ca853","isSidechain":true,"agentId":"a2392aaec64306cb2","message":{"model":"claude-sonnet-5","id":"msg_011Cfp2ZiVQXRwSY3h7wiG5u","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01SoHDT3aYWMT9AtKP9bf8tU","name":"Read","input":{"file_path":"C:\\Users\\User\\mcp-servers\\cuore\\tests\\_edge_cleanup.py"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":12407,"cache_read_input_tokens":89099,"cache_creation":{"ephemeral_5m_input_tokens":12407,"ephemeral_1h_input_tokens":0},"output_tokens":2,"service_tier":"standard","inference_geo":"not_available"},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_01SoHDT3aYWMT9AtKP9bf8tU":{"file_path":"C:\\Users\\User\\mcp-servers\\cuore\\tests\\_edge_cleanup.py"}},"serverClassifierRequest":"fedc421f-0e7b-4d45-a7e1-f74b7c4452bf","apiBlockIndex":3,"requestId":"req_011Cfp2ZiGm8MPdSA13YXQnu","attributionAgent":"general-purpose","type":"assistant","uuid":"5763379b-bc08-4900-8997-6bc07b450cba","timestamp":"2026-10-08T03:04:08.455Z","effort":"high","perTurnEffort":null,"userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
{"parentUuid":"5763379b-bc08-4900-8997-6bc07b450cba","isSidechain":true,"promptId":"661b565b-f132-46d8-b96b-a7f4dab0f376","agentId":"a2392aaec64306cb2","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01SoHDT3aYWMT9AtKP9bf8tU","type":"tool_result","content":"1\t\"\"\"Stop every headless Edge process a test started.\n2\t\n3\tEdge detaches from the process the test launches (the launcher exits and the\n4\treal browser, GPU and renderer processes live on), so Popen.terminate() alone\n5\tleaked the whole browser: 43 test runs left 266 msedge.exe processes running\n6\t(found 2026-09-26). Each test uses its own throwaway --user-data-dir, so\n7\tevery process whose command line names that directory is ours to stop.\n8\t\"\"\"\n9\tfrom __future__ import annotations\n10\t\n11\timport subprocess\n12\tfrom pathlib import Path\n13\t\n14\t\n15\tdef kill_edge_profile(profile_dir: str | Path) -> int:\n16\t    \"\"\"Kill every msedge.exe whose command line contains ``profile_dir``.\n17\t    Returns how many were stopped. Never touches the user's own Edge, whose\n18\t    command line does not name a temp test profile.\"\"\"\n19\t    needle = str(profile_dir).replace(\"'\", \"''\")\n20\t    ps = (\"$n = '\" + needle + \"'; $k = 0; \"\n21\t          \"Get-CimInstance Win32_Process -Filter \\\"Name='msedge.exe'\\\" | \"\n22\t          \"Where-Object { $_.CommandLine -and $_.CommandLine.Contains($n) } | \"\n23\t          \"ForEach-Object { Stop-Process -Id $_.ProcessId -Force -ErrorAction SilentlyContinue; $k++ }; $k\")\n24\t    try:\n25\t        out = subprocess.run([\"powershell\", \"-NoProfile\", \"-Command\", ps],\n26\t                             capture_output=True, text=True, timeout=30).stdout.strip()\n27\t        return int(out or 0)\n28\t    except Exception:  # noqa: BLE001 -- cleanup must never fail a test run\n29\t        return 0\n30\t"}]},"uuid":"db9f6048-b3c9-4f09-926a-08b20ee13d63","timestamp":"2026-10-08T03:04:08.473Z","toolUseResult":{"type":"text","file":{"filePath":"C:\\Users\\User\\mcp-servers\\cuore\\tests\\_edge_cleanup.py","content":"\"\"\"Stop every headless Edge process a test started.\n\nEdge detaches from the process the test launches (the launcher exits and the\nreal browser, GPU and renderer processes live on), so Popen.terminate() alone\nleaked the whole browser: 43 test runs left 266 msedge.exe processes running\n(found 2026-09-26). Each test uses its own throwaway --user-data-dir, so\nevery process whose command line names that directory is ours to stop.\n\"\"\"\nfrom __future__ import annotations\n\nimport subprocess\nfrom pathlib import Path\n\n\ndef kill_edge_profile(profile_dir: str | Path) -> int:\n    \"\"\"Kill every msedge.exe whose command line contains ``profile_dir``.\n    Returns how many were stopped. Never touches the user's own Edge, whose\n    command line does not name a temp test profile.\"\"\"\n    needle = str(profile_dir).replace(\"'\", \"''\")\n    ps = (\"$n = '\" + needle + \"'; $k = 0; \"\n          \"Get-CimInstance Win32_Process -Filter \\\"Name='msedge.exe'\\\" | \"\n          \"Where-Object { $_.CommandLine -and $_.CommandLine.Contains($n) } | \"\n          \"ForEach-Object { Stop-Process -Id $_.ProcessId -Force -ErrorAction SilentlyContinue; $k++ }; $k\")\n    try:\n        out = subprocess.run([\"powershell\", \"-NoProfile\", \"-Command\", ps],\n                             capture_output=True, text=True, timeout=30).stdout.strip()\n        return int(out or 0)\n    except Exception:  # noqa: BLE001 -- cleanup must never fail a test run\n        return 0\n","numLines":30,"startLine":1,"totalLines":30}},"sourceToolAssistantUUID":"5763379b-bc08-4900-8997-6bc07b450cba","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
{"parentUuid":"db9f6048-b3c9-4f09-926a-08b20ee13d63","isSidechain":true,"agentId":"a2392aaec64306cb2","message":{"model":"claude-sonnet-5","id":"msg_011Cfp2ZiVQXRwSY3h7wiG5u","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01BUVSZYUSeTu818z67NpGE8","name":"Read","input":{"file_path":"C:\\Users\\User\\mcp-servers\\cuore\\tests\\check_api.py"},"caller":{"type":"direct"}}],"container":null,"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":12407,"cache_read_input_tokens":89099,"output_tokens":1344,"output_tokens_details":{"thinking_tokens":1052},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":0,"ephemeral_5m_input_tokens":12407},"inference_geo":"not_available","iterations":[{"input_tokens":2,"output_tokens":1344,"cache_read_input_tokens":89099,"cache_creation_input_tokens":12407,"cache_creation":{"ephemeral_5m_input_tokens":12407,"ephemeral_1h_input_tokens":0},"type":"message"}],"speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_01BUVSZYUSeTu818z67NpGE8":{"file_path":"C:\\Users\\User\\mcp-servers\\cuore\\tests\\check_api.py"}},"serverClassifierRequest":"fedc421f-0e7b-4d45-a7e1-f74b7c4452bf","apiBlockIndex":4,"requestId":"req_011Cfp2ZiGm8MPdSA13YXQnu","attributionAgent":"general-purpose","type":"assistant","uuid":"a169fe88-4347-4f8b-a0d0-310301c84452","timestamp":"2026-10-08T03:04:08.852Z","effort":"high","perTurnEffort":null,"userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
{"parentUuid":"a169fe88-4347-4f8b-a0d0-310301c84452","isSidechain":true,"promptId":"661b565b-f132-46d8-b96b-a7f4dab0f376","agentId":"a2392aaec64306cb2","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01BUVSZYUSeTu818z67NpGE8","type":"tool_result","content":"1\t\"\"\"Corpus-backed smoke checks for the CUORE service.\n2\t\n3\tSame posture as ``mes-log-mcp/tests/*``: no mocks, no fixtures. The real MES\n4\tcorpus on this machine *is* the fixture, and the assertions pin facts that are\n5\talready established in it -- the chronic P0456 and its 26,500 km span, the\n6\t2026-08-27 clear that must not read as a healthy car, the two vehicles with\n7\treal logs.\n8\t\n9\tRun:\n10\t    .venv/Scripts/python.exe cuore/tests/check_api.py\n11\t\"\"\"\n12\t\n13\tfrom __future__ import annotations\n14\t\n15\timport sys\n16\tfrom pathlib import Path\n17\t\n18\tsys.path.insert(0, str(Path(__file__).resolve().parents[2]))\n19\t\n20\tfrom fastapi.testclient import TestClient  # noqa: E402\n21\t\n22\tfrom cuore.app import create_app  # noqa: E402\n23\tfrom cuore.services import mes_bridge  # noqa: E402\n24\tfrom cuore.services.errors import BridgeError  # noqa: E402\n25\t\n26\tVIN = \"ZASFAKPN5J7B88115\"          # the Stelvio -- 17 logs, all real\n27\tVIN_500L = \"ZFBCFABH1EZ020882\"     # the Fiat 500L -- 4 real logs\n28\t\n29\tfailures: list[str] = []\n30\tchecks = 0\n31\t\n32\t\n33\tdef check(label: str, condition: bool, detail: str = \"\") -> None:\n34\t    global checks\n35\t    checks += 1\n36\t    if not condition:\n37\t        failures.append(f\"{label}{(' -- ' + detail) if detail else ''}\")\n38\t\n39\t\n40\tclient = TestClient(create_app())\n41\t\n42\t\n43\t# --- the capability contract ---------------------------------------------\n44\t\n45\tcaps = client.get(\"/api/capabilities\")\n46\tcheck(\"capabilities responds\", caps.status_code == 200)\n47\tbody = caps.json()\n48\tcheck(\"profile is bench\", body[\"profile\"] == \"bench\", str(body.get(\"profile\")))\n49\tcheck(\"corpus advertised\", body[\"features\"][\"corpus\"] is True)\n50\tcheck(\"live_obd is a bool\", isinstance(body[\"features\"][\"live_obd\"], bool))\n51\tcheck(\"live_obd tracks adapter presence\",\n52\t      body[\"adapter\"][\"present\"] == body[\"features\"][\"live_obd\"],\n53\t      f\"adapter.present={body['adapter']['present']} live_obd={body['features']['live_obd']}\")\n54\tcheck(\"drive_recorder is False at P1\", body[\"features\"][\"drive_recorder\"] is False)\n55\tcheck(\"actuators is False at P1\", body[\"features\"][\"actuators\"] is False)\n56\tcheck(\"every declared feature is present in the payload\",\n57\t      set(body[\"features\"]) >= {\"corpus\", \"workup\", \"fault_tree\", \"verdict\",\n58\t                                \"live_obd\", \"live_can\", \"drive_recorder\"})\n59\tcheck(\"corpus counts are real\", body[\"corpus\"][\"total_logs\"] > 0,\n60\t      str(body[\"corpus\"][\"total_logs\"]))\n61\t\n62\t\n63\t# --- vehicles -------------------------------------------------------------\n64\t\n65\treal = client.get(\"/api/vehicles?real_only=true\").json()\n66\tvins = {v[\"vin\"] for v in real[\"vehicles\"]}\n67\tcheck(\"Stelvio present among real vehicles\", VIN in vins, str(vins))\n68\tcheck(\"500L present among real vehicles\", VIN_500L in vins, str(vins))\n69\tcheck(\"simulation pseudo-vehicles excluded\", \"5188214\" not in vins)\n70\t\n71\teverything = client.get(\"/api/vehicles\").json()\n72\tcheck(\"unfiltered list is larger than the real one\",\n73\t      everything[\"count\"] > real[\"count\"],\n74\t      f\"{everything['count']} vs {real['count']}\")\n75\t\n76\t\n77\t# --- the dossier ----------------------------------------------------------\n78\t\n79\td = client.get(f\"/api/vehicle/{VIN}\")\n80\tcheck(\"dossier responds\", d.status_code == 200)\n81\tdossier = d.json()\n82\tcheck(\"dossier names its blind spots\", len(dossier[\"blind_spots\"]) >= 3)\n83\tcheck(\"blind spots name the tool that closes each\",\n84\t      all(b.get(\"closes_it\") for b in dossier[\"blind_spots\"]))\n85\tcheck(\"provenance note present\", bool(dossier.get(\"provenance_note\")))\n86\t\n87\tchronic = {r[\"dtc\"] for r in dossier[\"history\"][\"chronic\"]}\n88\tcheck(\"P0456 classified chronic\", \"P0456-00\" in chronic, str(chronic))\n89\t\n90\tp0456 = next((r for r in dossier[\"history\"][\"chronic\"]\n91\t              if r[\"dtc\"] == \"P0456-00\"), None)\n92\tcheck(\"P0456 record found\", p0456 is not None)\n93\tif p0456:\n94\t    check(\"P0456 spans real distance, not one visit\",\n95\t          p0456.get(\"distance_span_km\", 0) > 20000,\n96\t          str(p0456.get(\"distance_span_km\")))\n97\t    check(\"P0456 first seen 2025-09-24\",\n98\t          p0456[\"first_seen\"].startswith(\"2025-09-24\"), p0456[\"first_seen\"])\n99\t    check(\"P0456 last seen no earlier than the 2026-08-27 clear\",\n100\t          p0456[\"last_seen\"] >= \"2026-08-27\", p0456[\"last_seen\"])\n101\t\n102\t# The whole point of the clear assessment: silence after an erase is not a\n103\t# repair. If this ever starts reading as a clean bill of health, the tool has\n104\t# become dangerous rather than merely wrong.\n105\tclear = dossier[\"current_picture\"].get(\"clear_assessment\")\n106\tcheck(\"clear assessment present\", clear is not None)\n107\tif clear:\n108\t    verdict_text = clear[\"verdict\"].lower()\n109\t    check(\"a clear is not reported as proof of repair\",\n110\t          \"not proof\" in verdict_text or \"carries no information\" in verdict_text,\n111\t          clear[\"verdict\"][:90])\n112\t    check(\"clear assessment says what to do next\", bool(clear.get(\"next_step\")))\n113\t\n114\tscan = dossier[\"current_picture\"].get(\"latest_scan\")\n115\tcheck(\"SCAN provenance is unverifiable, never clean\",\n116\t      scan is None or \"unverifiable\" in scan.get(\"provenance\", \"\"),\n117\t      str(scan.get(\"provenance\") if scan else None))\n118\t\n119\t\n120\t# --- codes ----------------------------------------------------------------\n121\t\n122\tdtcs = client.get(f\"/api/vehicle/{VIN}/dtcs\").json()\n123\tcheck(\"codes listed\", dtcs[\"count\"] > 0)\n124\tcheck(\"simulation excluded by default\", dtcs[\"simulation_included\"] is False)\n125\tcheck(\"every code carries an explicit severity\",\n126\t      all(\"severity\" in r for r in dtcs[\"dtcs\"]))\n127\tcheck(\"severity uses the known vocabulary\",\n128\t      {r[\"severity\"] for r in dtcs[\"dtcs\"]} <=\n129\t      {\"returned\", \"chronic\", \"cleared\", \"seen-once\", \"recurring\"},\n130\t      str({r[\"severity\"] for r in dtcs[\"dtcs\"]}))\n131\tcheck(\"chronic booleans survive serialisation\",\n132\t      any(r.get(\"chronic\") for r in dtcs[\"dtcs\"]))\n133\tcheck(\"returned-after-clear sorts before the rest\",\n134\t      not dtcs[\"dtcs\"] or dtcs[\"dtcs\"][0][\"severity\"] in (\"returned\", \"chronic\"),\n135\t      dtcs[\"dtcs\"][0][\"severity\"] if dtcs[\"dtcs\"] else \"\")\n136\t\n137\thist = client.get(f\"/api/vehicle/{VIN}/dtc/P0456\")\n138\tcheck(\"single code history responds\", hist.status_code == 200)\n139\tcheck(\"history matched P0456\",\n140\t      hist.json()[\"matches\"][0][\"dtc\"].startswith(\"P0456\"))\n141\t\n142\tcheck(\"unknown code is 404, not an empty 200\",\n143\t      client.get(f\"/api/vehicle/{VIN}/dtc/P9999\").status_code == 404)\n144\tcheck(\"unknown vehicle is 404\",\n145\t      client.get(\"/api/vehicle/NOSUCHVIN00000\").status_code == 404)\n146\t\n147\t\n148\t# --- fault tree and the gate ---------------------------------------------\n149\t\n150\ttree = client.get(f\"/api/vehicle/{VIN}/tree\").json()\n151\tcheck(\"a tree routes from the car's own codes\", bool(tree.get(\"trees\")),\n152\t      str(tree.get(\"error\")))\n153\tcheck(\"the tree is annotated with this car's evidence\",\n154\t      \"vehicle_evidence\" in tree)\n155\t\n156\tweak = client.post(f\"/api/vehicle/{VIN}/verdict\", json={\n157\t    \"codes\": \"P0456\", \"component\": \"purge valve\", \"mechanism\": \"\",\n158\t    \"measurements\": [], \"disconfirming_test\": \"\"})\n159\tcheck(\"gate accepts a submission\", weak.status_code == 200, weak.text[:120])\n160\twbody = weak.json()\n161\tcheck(\"a bare part name is NOT confirmed\", wbody[\"verdict\"] != \"CONFIRMED\",\n162\t      wbody.get(\"verdict\"))\n163\tcheck(\"gate names what is missing\", len(wbody[\"missing\"]) >= 3,\n164\t      str(wbody.get(\"missing\")))\n165\tcheck(\"gate gives a next test for each unmet criterion\",\n166\t      all(c.get(\"next_test\") for c in wbody[\"criteria\"].values()\n167\t          if not c[\"met\"]))\n168\tcheck(\"gate warns about the low-yield purge solenoid\",\n169\t      any(\"purge\" in w.lower() for w in wbody.get(\"component_warnings\", [])))\n170\t\n171\tcheck(\"gate refuses a submission with no codes\",\n172\t      client.post(f\"/api/vehicle/{VIN}/verdict\",\n173\t                  json={\"codes\": \"\"}).status_code == 400)\n174\t\n175\t# The HTML form is the surface with real user input and hand-rolled parsing of\n176\t# the parallel m_* fields, so it gets exercised separately from the JSON body.\n177\tform_weak = client.post(f\"/v/{VIN}/gate\", data={\n178\t    \"codes\": \"P0456\", \"component\": \"purge valve\", \"mechanism\": \"\",\n179\t    \"disconfirming_test\": \"\", \"m_type\": [\"actuator\"]})\n180\tcheck(\"gate form accepts a post\", form_weak.status_code == 200)\n181\tcheck(\"gate form refuses a bare part name\",\n182\t      \"NOT CONFIRMED\" in form_weak.text)\n183\t\n184\t# A case that should pass: a stated mechanism, an actuator citation the corpus\n185\t# can actually verify on this VIN, and a disconfirming test.\n186\tform_strong = client.post(f\"/v/{VIN}/gate\", data={\n187\t    \"codes\": \"P0456\",\n188\t    \"component\": \"EVAP canister\",\n189\t    \"mechanism\": (\"Saturated canister restricts the vent path so the \"\n190\t                  \"natural-vacuum test cannot pull the required depression \"\n191\t                  \"and the ECM logs a small leak.\"),\n192\t    \"disconfirming_test\": (\"Actuated the purge valve KOEO: it responds and \"\n193\t                           \"holds, so the valve is not the restriction.\"),\n194\t    \"m_type\": [\"actuator\"],\n195\t    \"m_operation_0\": \"Evaporation control valve\"})\n196\tcheck(\"gate form confirms a properly evidenced case\",\n197\t      \"CONFIRMED\" in form_strong.text\n198\t      and \"NOT CONFIRMED\" not in form_strong.text,\n199\t      \"the gate should pass a case with mechanism, a corpus-verified \"\n200\t      \"measurement and disconfirmation\")\n201\tcheck(\"measurement rows survive the m_* parsing\",\n202\t      \"Evaporation control valve\" in form_strong.text)\n203\t\n204\t\n205\t# --- path containment -----------------------------------------------------\n206\t# The security boundary. An earlier MCP version built paths by concatenation,\n207\t# which on Windows let both `..` and an absolute path escape the log root --\n208\t# every file the process could read was reachable. These must never pass.\n209\t\n210\tTRAVERSALS = [\n211\t    \"../../Windows/win.ini\",\n212\t    \"..\\\\..\\\\Windows\\\\win.ini\",      # backslash: a real separator on Windows\n213\t    \"C:\\\\Windows\\\\win.ini\",\n214\t    \"C:/Windows/win.ini\",\n215\t    \"/etc/passwd\",\n216\t    \"....//....//Windows/win.ini\",\n217\t    \"FESLog_..\\\\..\\\\..\\\\win.ini\",\n218\t    \"\",\n219\t]\n220\tfor candidate in TRAVERSALS:\n221\t    try:\n222\t        mes_bridge.read_log(candidate)\n223\t        failures.append(f\"CONTAINMENT BREACH: read_log accepted {candidate!r}\")\n224\t        checks += 1\n225\t    except BridgeError:\n226\t        checks += 1\n227\t    except Exception as exc:  # any refusal is acceptable; silence is not\n228\t        checks += 1\n229\t        if \"Traceback\" in str(exc):\n230\t            failures.append(f\"read_log({candidate!r}) failed oddly: {exc}\")\n231\t\n232\t# And over HTTP, where the router gets a say first.\n233\tfor candidate in [\"../../Windows/win.ini\", \"..%2F..%2FWindows%2Fwin.ini\",\n234\t                  \"..%5C..%5CWindows%5Cwin.ini\", \"C:/Windows/win.ini\"]:\n235\t    status = client.get(f\"/api/log/{candidate}\").status_code\n236\t    check(f\"HTTP rejects {candidate}\", status in (400, 404), str(status))\n237\t\n238\t# A legitimate read still works -- containment that blocks everything is easy\n239\t# and useless.\n240\tnewest = client.get(f\"/api/logs?vin={VIN}&limit=1\").json()[\"logs\"][0][\"file\"]\n241\tgood = client.get(f\"/api/log/{newest}\")\n242\tcheck(\"a real log still reads\", good.status_code == 200, good.text[:120])\n243\tcheck(\"the log carries its decoded text\", bool(good.json().get(\"text\")))\n244\t\n245\t\n246\t# --- pages render ---------------------------------------------------------\n247\t\n248\tPAGES = [\n249\t    \"/\", f\"/v/{VIN}\", f\"/v/{VIN}/codes\", f\"/v/{VIN}/code/P0456\",\n250\t    f\"/v/{VIN}/tree\", f\"/v/{VIN}/gate\", f\"/v/{VIN}/codes?include_simulation=true\",\n251\t    f\"/v/{VIN_500L}\", f\"/v/{VIN_500L}/codes\", f\"/v/{VIN_500L}/tree\",\n252\t    \"/modules\", \"/recordings\", \"/logs\", f\"/logs?vin={VIN}\",\n253\t]\n254\tfor page in PAGES:\n255\t    resp = client.get(page)\n256\t    check(f\"page {page} renders\", resp.status_code == 200, str(resp.status_code))\n257\t    if resp.status_code == 200:\n258\t        check(f\"page {page} is HTML\", \"<html\" in resp.text.lower())\n259\t\n260\tbad_page = client.get(\"/v/NOSUCHVIN00000\")\n261\tcheck(\"a bad VIN gets a page, not raw JSON\", bad_page.status_code == 404)\n262\tcheck(\"the error page is HTML\", \"<html\" in bad_page.text.lower())\n263\t\n264\t\n265\t# --- auth -----------------------------------------------------------------\n266\t\n267\tfrom cuore.config import Settings  # noqa: E402\n268\t\n269\tguarded = TestClient(create_app(Settings(token=\"s3cret\")))\n270\tcheck(\"token enforced when configured\",\n271\t      guarded.get(\"/api/capabilities\").status_code == 401)\n272\tcheck(\"correct token in header accepted\",\n273\t      guarded.get(\"/api/capabilities\",\n274\t                  headers={\"X-Cuore-Token\": \"s3cret\"}).status_code == 200)\n275\tcheck(\"correct token in query accepted\",\n276\t      guarded.get(\"/api/capabilities?token=s3cret\").status_code == 200)\n277\tcheck(\"wrong token rejected\",\n278\t      guarded.get(\"/api/capabilities?token=nope\").status_code == 401)\n279\t\n280\t\n281\t# --- report ---------------------------------------------------------------\n282\t\n283\tprint(f\"checks run: {checks}\")\n284\tif failures:\n285\t    print(f\"FAILURES: {len(failures)}\")\n286\t    for f in failures:\n287\t        print(\"  -\", f)\n288\t    sys.exit(1)\n289\tprint(\"all green\")\n290\t"}]},"uuid":"b43a821f-964e-4dd3-a24b-21d720326daa","timestamp":"2026-10-08T03:04:08.882Z","toolUseResult":{"type":"text","file":{"filePath":"C:\\Users\\User\\mcp-servers\\cuore\\tests\\check_api.py","content":"\"\"\"Corpus-backed smoke checks for the CUORE service.\n\nSame posture as ``mes-log-mcp/tests/*``: no mocks, no fixtures. The real MES\ncorpus on this machine *is* the fixture, and the assertions pin facts that are\nalready established in it -- the chronic P0456 and its 26,500 km span, the\n2026-08-27 clear that must not read as a healthy car, the two vehicles with\nreal logs.\n\nRun:\n    .venv/Scripts/python.exe cuore/tests/check_api.py\n\"\"\"\n\nfrom __future__ import annotations\n\nimport sys\nfrom pathlib import Path\n\nsys.path.insert(0, str(Path(__file__).resolve().parents[2]))\n\nfrom fastapi.testclient import TestClient  # noqa: E402\n\nfrom cuore.app import create_app  # noqa: E402\nfrom cuore.services import mes_bridge  # noqa: E402\nfrom cuore.services.errors import BridgeError  # noqa: E402\n\nVIN = \"ZASFAKPN5J7B88115\"          # the Stelvio -- 17 logs, all real\nVIN_500L = \"ZFBCFABH1EZ020882\"     # the Fiat 500L -- 4 real logs\n\nfailures: list[str] = []\nchecks = 0\n\n\ndef check(label: str, condition: bool, detail: str = \"\") -> None:\n    global checks\n    checks += 1\n    if not condition:\n        failures.append(f\"{label}{(' -- ' + detail) if detail else ''}\")\n\n\nclient = TestClient(create_app())\n\n\n# --- the capability contract ---------------------------------------------\n\ncaps = client.get(\"/api/capabilities\")\ncheck(\"capabilities responds\", caps.status_code == 200)\nbody = caps.json()\ncheck(\"profile is bench\", body[\"profile\"] == \"bench\", str(body.get(\"profile\")))\ncheck(\"corpus advertised\", body[\"features\"][\"corpus\"] is True)\ncheck(\"live_obd is a bool\", isinstance(body[\"features\"][\"live_obd\"], bool))\ncheck(\"live_obd tracks adapter presence\",\n      body[\"adapter\"][\"present\"] == body[\"features\"][\"live_obd\"],\n      f\"adapter.present={body['adapter']['present']} live_obd={body['features']['live_obd']}\")\ncheck(\"drive_recorder is False at P1\", body[\"features\"][\"drive_recorder\"] is False)\ncheck(\"actuators is False at P1\", body[\"features\"][\"actuators\"] is False)\ncheck(\"every declared feature is present in the payload\",\n      set(body[\"features\"]) >= {\"corpus\", \"workup\", \"fault_tree\", \"verdict\",\n                                \"live_obd\", \"live_can\", \"drive_recorder\"})\ncheck(\"corpus counts are real\", body[\"corpus\"][\"total_logs\"] > 0,\n      str(body[\"corpus\"][\"total_logs\"]))\n\n\n# --- vehicles -------------------------------------------------------------\n\nreal = client.get(\"/api/vehicles?real_only=true\").json()\nvins = {v[\"vin\"] for v in real[\"vehicles\"]}\ncheck(\"Stelvio present among real vehicles\", VIN in vins, str(vins))\ncheck(\"500L present among real vehicles\", VIN_500L in vins, str(vins))\ncheck(\"simulation pseudo-vehicles excluded\", \"5188214\" not in vins)\n\neverything = client.get(\"/api/vehicles\").json()\ncheck(\"unfiltered list is larger than the real one\",\n      everything[\"count\"] > real[\"count\"],\n      f\"{everything['count']} vs {real['count']}\")\n\n\n# --- the dossier ----------------------------------------------------------\n\nd = client.get(f\"/api/vehicle/{VIN}\")\ncheck(\"dossier responds\", d.status_code == 200)\ndossier = d.json()\ncheck(\"dossier names its blind spots\", len(dossier[\"blind_spots\"]) >= 3)\ncheck(\"blind spots name the tool that closes each\",\n      all(b.get(\"closes_it\") for b in dossier[\"blind_spots\"]))\ncheck(\"provenance note present\", bool(dossier.get(\"provenance_note\")))\n\nchronic = {r[\"dtc\"] for r in dossier[\"history\"][\"chronic\"]}\ncheck(\"P0456 classified chronic\", \"P0456-00\" in chronic, str(chronic))\n\np0456 = next((r for r in dossier[\"history\"][\"chronic\"]\n              if r[\"dtc\"] == \"P0456-00\"), None)\ncheck(\"P0456 record found\", p0456 is not None)\nif p0456:\n    check(\"P0456 spans real distance, not one visit\",\n          p0456.get(\"distance_span_km\", 0) > 20000,\n          str(p0456.get(\"distance_span_km\")))\n    check(\"P0456 first seen 2025-09-24\",\n          p0456[\"first_seen\"].startswith(\"2025-09-24\"), p0456[\"first_seen\"])\n    check(\"P0456 last seen no earlier than the 2026-08-27 clear\",\n          p0456[\"last_seen\"] >= \"2026-08-27\", p0456[\"last_seen\"])\n\n# The whole point of the clear assessment: silence after an erase is not a\n# repair. If this ever starts reading as a clean bill of health, the tool has\n# become dangerous rather than merely wrong.\nclear = dossier[\"current_picture\"].get(\"clear_assessment\")\ncheck(\"clear assessment present\", clear is not None)\nif clear:\n    verdict_text = clear[\"verdict\"].lower()\n    check(\"a clear is not reported as proof of repair\",\n          \"not proof\" in verdict_text or \"carries no information\" in verdict_text,\n          clear[\"verdict\"][:90])\n    check(\"clear assessment says what to do next\", bool(clear.get(\"next_step\")))\n\nscan = dossier[\"current_picture\"].get(\"latest_scan\")\ncheck(\"SCAN provenance is unverifiable, never clean\",\n      scan is None or \"unverifiable\" in scan.get(\"provenance\", \"\"),\n      str(scan.get(\"provenance\") if scan else None))\n\n\n# --- codes ----------------------------------------------------------------\n\ndtcs = client.get(f\"/api/vehicle/{VIN}/dtcs\").json()\ncheck(\"codes listed\", dtcs[\"count\"] > 0)\ncheck(\"simulation excluded by default\", dtcs[\"simulation_included\"] is False)\ncheck(\"every code carries an explicit severity\",\n      all(\"severity\" in r for r in dtcs[\"dtcs\"]))\ncheck(\"severity uses the known vocabulary\",\n      {r[\"severity\"] for r in dtcs[\"dtcs\"]} <=\n      {\"returned\", \"chronic\", \"cleared\", \"seen-once\", \"recurring\"},\n      str({r[\"severity\"] for r in dtcs[\"dtcs\"]}))\ncheck(\"chronic booleans survive serialisation\",\n      any(r.get(\"chronic\") for r in dtcs[\"dtcs\"]))\ncheck(\"returned-after-clear sorts before the rest\",\n      not dtcs[\"dtcs\"] or dtcs[\"dtcs\"][0][\"severity\"] in (\"returned\", \"chronic\"),\n      dtcs[\"dtcs\"][0][\"severity\"] if dtcs[\"dtcs\"] else \"\")\n\nhist = client.get(f\"/api/vehicle/{VIN}/dtc/P0456\")\ncheck(\"single code history responds\", hist.status_code == 200)\ncheck(\"history matched P0456\",\n      hist.json()[\"matches\"][0][\"dtc\"].startswith(\"P0456\"))\n\ncheck(\"unknown code is 404, not an empty 200\",\n      client.get(f\"/api/vehicle/{VIN}/dtc/P9999\").status_code == 404)\ncheck(\"unknown vehicle is 404\",\n      client.get(\"/api/vehicle/NOSUCHVIN00000\").status_code == 404)\n\n\n# --- fault tree and the gate ---------------------------------------------\n\ntree = client.get(f\"/api/vehicle/{VIN}/tree\").json()\ncheck(\"a tree routes from the car's own codes\", bool(tree.get(\"trees\")),\n      str(tree.get(\"error\")))\ncheck(\"the tree is annotated with this car's evidence\",\n      \"vehicle_evidence\" in tree)\n\nweak = client.post(f\"/api/vehicle/{VIN}/verdict\", json={\n    \"codes\": \"P0456\", \"component\": \"purge valve\", \"mechanism\": \"\",\n    \"measurements\": [], \"disconfirming_test\": \"\"})\ncheck(\"gate accepts a submission\", weak.status_code == 200, weak.text[:120])\nwbody = weak.json()\ncheck(\"a bare part name is NOT confirmed\", wbody[\"verdict\"] != \"CONFIRMED\",\n      wbody.get(\"verdict\"))\ncheck(\"gate names what is missing\", len(wbody[\"missing\"]) >= 3,\n      str(wbody.get(\"missing\")))\ncheck(\"gate gives a next test for each unmet criterion\",\n      all(c.get(\"next_test\") for c in wbody[\"criteria\"].values()\n          if not c[\"met\"]))\ncheck(\"gate warns about the low-yield purge solenoid\",\n      any(\"purge\" in w.lower() for w in wbody.get(\"component_warnings\", [])))\n\ncheck(\"gate refuses a submission with no codes\",\n      client.post(f\"/api/vehicle/{VIN}/verdict\",\n                  json={\"codes\": \"\"}).status_code == 400)\n\n# The HTML form is the surface with real user input and hand-rolled parsing of\n# the parallel m_* fields, so it gets exercised separately from the JSON body.\nform_weak = client.post(f\"/v/{VIN}/gate\", data={\n    \"codes\": \"P0456\", \"component\": \"purge valve\", \"mechanism\": \"\",\n    \"disconfirming_test\": \"\", \"m_type\": [\"actuator\"]})\ncheck(\"gate form accepts a post\", form_weak.status_code == 200)\ncheck(\"gate form refuses a bare part name\",\n      \"NOT CONFIRMED\" in form_weak.text)\n\n# A case that should pass: a stated mechanism, an actuator citation the corpus\n# can actually verify on this VIN, and a disconfirming test.\nform_strong = client.post(f\"/v/{VIN}/gate\", data={\n    \"codes\": \"P0456\",\n    \"component\": \"EVAP canister\",\n    \"mechanism\": (\"Saturated canister restricts the vent path so the \"\n                  \"natural-vacuum test cannot pull the required depression \"\n                  \"and the ECM logs a small leak.\"),\n    \"disconfirming_test\": (\"Actuated the purge valve KOEO: it responds and \"\n                           \"holds, so the valve is not the restriction.\"),\n    \"m_type\": [\"actuator\"],\n    \"m_operation_0\": \"Evaporation control valve\"})\ncheck(\"gate form confirms a properly evidenced case\",\n      \"CONFIRMED\" in form_strong.text\n      and \"NOT CONFIRMED\" not in form_strong.text,\n      \"the gate should pass a case with mechanism, a corpus-verified \"\n      \"measurement and disconfirmation\")\ncheck(\"measurement rows survive the m_* parsing\",\n      \"Evaporation control valve\" in form_strong.text)\n\n\n# --- path containment -----------------------------------------------------\n# The security boundary. An earlier MCP version built paths by concatenation,\n# which on Windows let both `..` and an absolute path escape the log root --\n# every file the process could read was reachable. These must never pass.\n\nTRAVERSALS = [\n    \"../../Windows/win.ini\",\n    \"..\\\\..\\\\Windows\\\\win.ini\",      # backslash: a real separator on Windows\n    \"C:\\\\Windows\\\\win.ini\",\n    \"C:/Windows/win.ini\",\n    \"/etc/passwd\",\n    \"....//....//Windows/win.ini\",\n    \"FESLog_..\\\\..\\\\..\\\\win.ini\",\n    \"\",\n]\nfor candidate in TRAVERSALS:\n    try:\n        mes_bridge.read_log(candidate)\n        failures.append(f\"CONTAINMENT BREACH: read_log accepted {candidate!r}\")\n        checks += 1\n    except BridgeError:\n        checks += 1\n    except Exception as exc:  # any refusal is acceptable; silence is not\n        checks += 1\n        if \"Traceback\" in str(exc):\n            failures.append(f\"read_log({candidate!r}) failed oddly: {exc}\")\n\n# And over HTTP, where the router gets a say first.\nfor candidate in [\"../../Windows/win.ini\", \"..%2F..%2FWindows%2Fwin.ini\",\n                  \"..%5C..%5CWindows%5Cwin.ini\", \"C:/Windows/win.ini\"]:\n    status = client.get(f\"/api/log/{candidate}\").status_code\n    check(f\"HTTP rejects {candidate}\", status in (400, 404), str(status))\n\n# A legitimate read still works -- containment that blocks everything is easy\n# and useless.\nnewest = client.get(f\"/api/logs?vin={VIN}&limit=1\").json()[\"logs\"][0][\"file\"]\ngood = client.get(f\"/api/log/{newest}\")\ncheck(\"a real log still reads\", good.status_code == 200, good.text[:120])\ncheck(\"the log carries its decoded text\", bool(good.json().get(\"text\")))\n\n\n# --- pages render ---------------------------------------------------------\n\nPAGES = [\n    \"/\", f\"/v/{VIN}\", f\"/v/{VIN}/codes\", f\"/v/{VIN}/code/P0456\",\n    f\"/v/{VIN}/tree\", f\"/v/{VIN}/gate\", f\"/v/{VIN}/codes?include_simulation=true\",\n    f\"/v/{VIN_500L}\", f\"/v/{VIN_500L}/codes\", f\"/v/{VIN_500L}/tree\",\n    \"/modules\", \"/recordings\", \"/logs\", f\"/logs?vin={VIN}\",\n]\nfor page in PAGES:\n    resp = client.get(page)\n    check(f\"page {page} renders\", resp.status_code == 200, str(resp.status_code))\n    if resp.status_code == 200:\n        check(f\"page {page} is HTML\", \"<html\" in resp.text.lower())\n\nbad_page = client.get(\"/v/NOSUCHVIN00000\")\ncheck(\"a bad VIN gets a page, not raw JSON\", bad_page.status_code == 404)\ncheck(\"the error page is HTML\", \"<html\" in bad_page.text.lower())\n\n\n# --- auth -----------------------------------------------------------------\n\nfrom cuore.config import Settings  # noqa: E402\n\nguarded = TestClient(create_app(Settings(token=\"s3cret\")))\ncheck(\"token enforced when configured\",\n      guarded.get(\"/api/capabilities\").status_code == 401)\ncheck(\"correct token in header accepted\",\n      guarded.get(\"/api/capabilities\",\n                  headers={\"X-Cuore-Token\": \"s3cret\"}).status_code == 200)\ncheck(\"correct token in query accepted\",\n      guarded.get(\"/api/capabilities?token=s3cret\").status_code == 200)\ncheck(\"wrong token rejected\",\n      guarded.get(\"/api/capabilities?token=nope\").status_code == 401)\n\n\n# --- report ---------------------------------------------------------------\n\nprint(f\"checks run: {checks}\")\nif failures:\n    print(f\"FAILURES: {len(failures)}\")\n    for f in failures:\n        print(\"  -\", f)\n    sys.exit(1)\nprint(\"all green\")\n","numLines":290,"startLine":1,"totalLines":290}},"sourceToolAssistantUUID":"a169fe88-4347-4f8b-a0d0-310301c84452","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
{"parentUuid":"b43a821f-964e-4dd3-a24b-21d720326daa","isSidechain":true,"agentId":"a2392aaec64306cb2","attachment":{"type":"total_tokens_reminder","text":"<total_tokens>14897148 tokens left</total_tokens>"},"type":"attachment","uuid":"ddb2dec4-bb17-4b12-ac77-4a0f25723ee0","timestamp":"2026-10-08T03:04:08.927Z","rendered":[{"content":"<system-reminder>\n<total_tokens>14897148 tokens left</total_tokens>\n</system-reminder>"}],"userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
{"parentUuid":"ddb2dec4-bb17-4b12-ac77-4a0f25723ee0","isSidechain":true,"agentId":"a2392aaec64306cb2","message":{"model":"claude-sonnet-5","id":"msg_011Cfp2b3TD39R4J95qGxinL","type":"message","role":"assistant","content":[{"type":"thinking","thinking":"","signature":""}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":17840,"cache_read_input_tokens":101506,"cache_creation":{"ephemeral_5m_input_tokens":17840,"ephemeral_1h_input_tokens":0},"output_tokens":5,"service_tier":"standard","inference_geo":"not_available"},"input_transformations":[],"diagnostics":null,"context_management":null},"serverClassifierRequest":"952e3d86-1046-4ca1-8620-8a8deca4c223","apiBlockIndex":0,"requestId":"req_011Cfp2b3DZo44h6sR5eg68G","attributionAgent":"general-purpose","type":"assistant","uuid":"f5d677c2-ab4d-4767-8b1b-c71b14d58cd2","timestamp":"2026-10-08T03:04:17.301Z","effort":"high","perTurnEffort":null,"userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
{"parentUuid":"f5d677c2-ab4d-4767-8b1b-c71b14d58cd2","isSidechain":true,"agentId":"a2392aaec64306cb2","message":{"model":"claude-sonnet-5","id":"msg_011Cfp2b3TD39R4J95qGxinL","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_012zhrYB1Uz5z9cPfgbeDJwc","name":"Read","input":{"file_path":"C:\\Users\\User\\mcp-servers\\cuore\\web\\routes.py"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":17840,"cache_read_input_tokens":101506,"cache_creation":{"ephemeral_5m_input_tokens":17840,"ephemeral_1h_input_tokens":0},"output_tokens":5,"service_tier":"standard","inference_geo":"not_available"},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_012zhrYB1Uz5z9cPfgbeDJwc":{"file_path":"C:\\Users\\User\\mcp-servers\\cuore\\web\\routes.py"}},"serverClassifierRequest":"952e3d86-1046-4ca1-8620-8a8deca4c223","apiBlockIndex":1,"requestId":"req_011Cfp2b3DZo44h6sR5eg68G","attributionAgent":"general-purpose","type":"assistant","uuid":"3d55b6d1-30db-4476-add7-08feb01618a2","timestamp":"2026-10-08T03:04:18.153Z","effort":"high","perTurnEffort":null,"userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
{"parentUuid":"3d55b6d1-30db-4476-add7-08feb01618a2","isSidechain":true,"promptId":"4ef28fda-79b7-4088-8e43-8bbf2aa52d78","agentId":"a2392aaec64306cb2","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012zhrYB1Uz5z9cPfgbeDJwc","type":"tool_result","content":"1\t\"\"\"The bench UI.\n2\t\n3\tEvery page calls the same :mod:`cuore.services.mes_bridge` functions the JSON\n4\tAPI does, so the two surfaces cannot disagree about what a car's history says.\n5\tTemplates render; they do not decide. Chronic classification, TSB matching,\n6\tfault-tree content and the gate's criteria all live in ``mes``.\n7\t\n8\tPage set:\n9\t\n10\t===========================  ==================================================\n11\t``/``                        vehicle picker and corpus health\n12\t``/v/{vin}``                 the dossier\n13\t``/v/{vin}/codes``           every code with severity and provenance\n14\t``/v/{vin}/code/{code}``     one code's life across sessions\n15\t``/v/{vin}/tree``            fault-tree walkthrough\n16\t``/v/{vin}/gate``            the evidence gate\n17\t``/modules``                 module registry and bus map\n18\t``/recordings``              CSV recordings\n19\t``/logs``                    the raw log index\n20\t``/live``                    the live link: adapter, cable, buses, OBD\n21\t``/live/module/{code}``      one module's UDS DTCs and identity, live\n22\t===========================  ==================================================\n23\t\"\"\"\n24\t\n25\tfrom __future__ import annotations\n26\t\n27\timport json\n28\tfrom pathlib import Path\n29\tfrom typing import Any\n30\tfrom urllib.parse import quote\n31\t\n32\tfrom fastapi import APIRouter, Depends, Form, Request, Response\n33\tfrom fastapi.responses import HTMLResponse, RedirectResponse\n34\tfrom fastapi.templating import Jinja2Templates\n35\t\n36\tfrom .. import __version__\n37\tfrom ..services import cache, dossier_bridge, mes_bridge\n38\tfrom ..services.errors import BridgeError\n39\tfrom ..api.deps import require_token, settings_of\n40\tfrom ..live import ops as live_ops\n41\tfrom ..live.buses import BUSES, PIN_1_9_WARNING\n42\tfrom ..live.errors import LiveError\n43\t\n44\tHERE = Path(__file__).resolve().parent\n45\tTEMPLATE_DIR = HERE / \"templates\"\n46\tSTATIC_DIR = HERE / \"static\"\n47\t\n48\ttemplates = Jinja2Templates(directory=str(TEMPLATE_DIR))\n49\t\n50\trouter = APIRouter(include_in_schema=False,\n51\t                   dependencies=[Depends(require_token)])\n52\t\n53\t\n54\t# --- helpers --------------------------------------------------------------\n55\t\n56\t\n57\tdef _status_strip() -> dict[str, Any]:\n58\t    \"\"\"The live link's headline state, cheap enough for every page load.\n59\t\n60\t    No adapter I/O happens here -- ``live_ops.status()`` only reads the\n61\t    registry, the lock file and the MES process/window state. This is what\n62\t    makes it safe to compute unconditionally rather than opt-in per page,\n63\t    which is the point: MES holding the port, or a bus sitting unverified,\n64\t    used to be invisible outside ``/live``.\n65\t    \"\"\"\n66\t    try:\n67\t        s = live_ops.status()\n68\t        return {\n69\t            \"port\": s.get(\"port\"), \"baud\": s.get(\"baud\"),\n70\t            \"mes_state\": (s.get(\"mes\") or {}).get(\"state\"),\n71\t            \"cable\": (s.get(\"cable\") or {}).get(\"cable\"),\n72\t            \"buses_verified\": sum(1 for b in (s.get(\"cable\") or {}).get(\"buses\", [])\n73\t                                  if b.get(\"verified\")),\n74\t            \"buses_total\": len((s.get(\"cable\") or {}).get(\"buses\", [])),\n75\t            \"lock_holder\": (s.get(\"lock\") or {}).get(\"process\"),\n76\t            \"error\": None,\n77\t        }\n78\t    except Exception as exc:  # noqa: BLE001 - a broken strip must never 500 a page\n79\t        return {\"error\": str(exc)}\n80\t\n81\t\n82\tdef _page(request: Request, name: str, **ctx: Any) -> HTMLResponse:\n83\t    \"\"\"Render a template with the context every page needs.\"\"\"\n84\t    settings = settings_of(request)\n85\t    ctx.setdefault(\"version\", __version__)\n86\t    ctx.setdefault(\"profile\", settings.profile.value)\n87\t    if \"live_strip\" not in ctx:  # not setdefault: the strip is not free to compute\n88\t        ctx[\"live_strip\"] = _status_strip()\n89\t    return templates.TemplateResponse(request, name, ctx)\n90\t\n91\t\n92\tdef error_page(request: Request, body: Any) -> HTMLResponse:\n93\t    \"\"\"Render a failure as a page. Used by the app's exception handlers.\n94\t\n95\t    Lives here rather than in ``app.py`` so the template lookup stays with the\n96\t    other templates, and takes the same :class:`~cuore.models.ErrorBody` the\n97\t    API returns so the two never describe a failure differently.\n98\t    \"\"\"\n99\t    settings = settings_of(request)\n100\t    return templates.TemplateResponse(\n101\t        request, \"error.html\",\n102\t        {\"status\": body.status, \"error\": body.error, \"detail\": body.detail,\n103\t         \"version\": __version__, \"profile\": settings.profile.value},\n104\t        status_code=body.status,\n105\t    )\n106\t\n107\t\n108\tdef _dossier(vin: str) -> dict[str, Any]:\n109\t    \"\"\"The cached workup for a VIN. See ``api/vehicles.py`` for why cached.\"\"\"\n110\t    return cache.get_or_build(\n111\t        (\"workup\", vin, mes_bridge.newest_mtime(vin)),\n112\t        lambda: mes_bridge.workup(vin=vin),\n113\t    )\n114\t\n115\t\n116\tdef _vehicle_bar(vin: str, dossier: dict[str, Any]) -> dict[str, Any]:\n117\t    \"\"\"Data for the sticky context bar.\n118\t\n119\t    It carries provenance and odometer span because those are the two facts\n120\t    most easily lost while scrolling, and both change how a page should be\n121\t    read: a simulated log is not evidence, and a code spanning 26,500 km is\n122\t    not a fresh fault.\n123\t    \"\"\"\n124\t    ident = dossier.get(\"identity\", {})\n125\t    first, last = ident.get(\"odometer_first_km\"), ident.get(\"odometer_last_km\")\n126\t    span = None\n127\t    if isinstance(first, (int, float)) and isinstance(last, (int, float)):\n128\t        span = int(last) - int(first)\n129\t    return {\n130\t        \"vin\": vin,\n131\t        \"name\": ident.get(\"vehicle\") or \"(unnamed vehicle)\",\n132\t        \"logs\": ident.get(\"log_count\"),\n133\t        \"first_log\": ident.get(\"first_log\"),\n134\t        \"last_log\": ident.get(\"last_log\"),\n135\t        \"odo_first\": first,\n136\t        \"odo_last\": last,\n137\t        \"odo_span\": span,\n138\t        \"ecus\": ident.get(\"ecu_seen\") or [],\n139\t    }\n140\t\n141\t\n142\t# --- the active vehicle -----------------------------------------------------\n143\t#\n144\t# The seam between the corpus side of this app and the live side used to be\n145\t# total: /v/{vin} knows a VIN, /live never did. A cookie is the whole fix --\n146\t# visiting a vehicle's dossier makes it the vehicle any live read tags itself\n147\t# against, until you visit a different one or clear it. Query-string ?vin=\n148\t# always wins over the cookie, so a link from the dossier is self-contained\n149\t# even if the cookie is stale or scripting is off.\n150\t\n151\t_VIN_COOKIE = \"cuore_vin\"\n152\t\n153\t\n154\tdef _set_active_vehicle(response: Response, vin: str) -> None:\n155\t    response.set_cookie(_VIN_COOKIE, vin, max_age=60 * 60 * 24 * 30, samesite=\"lax\")\n156\t\n157\t\n158\tdef _active_vehicle(request: Request, vin_param: str = \"\") -> str:\n159\t    \"\"\"The VIN a live read should tag itself with: query param, then cookie.\"\"\"\n160\t    return vin_param.strip() or request.cookies.get(_VIN_COOKIE, \"\").strip()\n161\t\n162\t\n163\tdef _active_vehicle_bar(vin: str) -> dict[str, Any] | None:\n164\t    \"\"\"The small \"you are working on\" fact, shown on the live pages. None if\n165\t    the active VIN does not resolve to anything in the corpus -- a stale\n166\t    cookie after a corpus root changes should not error, just stop showing.\"\"\"\n167\t    if not vin:\n168\t        return None\n169\t    try:\n170\t        dossier = _dossier(vin)\n171\t    except BridgeError:\n172\t        return None\n173\t    ident = dossier.get(\"identity\", {})\n174\t    return {\"vin\": vin, \"name\": ident.get(\"vehicle\") or vin}\n175\t\n176\t\n177\tdef _match_live_modules(ecu_seen: list[str]) -> list[dict[str, Any]]:\n178\t    \"\"\"Which of this car's own logged ECUs the live link can also reach.\n179\t\n180\t    ``ecu_seen`` carries MES's full hardware description (\"Magneti Marelli\n181\t    IAW 10JA CF6/EOBD Injection (2.0)\"); the live table's module names are\n182\t    drawn from the same source material and match by equality or containment\n183\t    -- checked both directions, since the live table sometimes carries a\n184\t    trailing qualifier the corpus string does not (\"Body Computer Marelli\n185\t    (949)\" vs \"Body Computer Marelli (949), gateway\").\n186\t    \"\"\"\n187\t    try:\n188\t        live_rows = live_ops.modules()[\"modules\"]\n189\t    except LiveError:\n190\t        return []\n191\t    seen_lower = [s.lower() for s in ecu_seen]\n192\t    out = []\n193\t    for m in live_rows:\n194\t        name_lower = (m.get(\"name\") or \"\").lower()\n195\t        if any(name_lower == s or name_lower.startswith(s) or s in name_lower\n196\t               for s in seen_lower):\n197\t            out.append(m)\n198\t    return out\n199\t\n200\t\n201\t# --- pages ----------------------------------------------------------------\n202\t\n203\t\n204\t@router.get(\"/\", response_class=HTMLResponse)\n205\tdef index(request: Request) -> HTMLResponse:\n206\t    \"\"\"Vehicle picker, with the corpus's own health beside it.\"\"\"\n207\t    status = mes_bridge.corpus_status()\n208\t    return _page(request, \"index.html\",\n209\t                 vehicles=mes_bridge.vehicles(real_only=True),\n210\t                 all_vehicles=mes_bridge.vehicles(),\n211\t                 stats=status)\n212\t\n213\t\n214\tdef _live_panel_for(vin: str, ecu_seen: list[str]) -> dict[str, Any]:\n215\t    \"\"\"The dossier's embedded live section: bus state plus this car's own\n216\t    reachable modules, not the full 126-entry registry or the full 25-entry\n217\t    live table -- just the intersection with what this VIN has actually\n218\t    logged. Each matched module still carries ``usable``: being on this car\n219\t    is not the same as having a confirmed address, and a link that will\n220\t    only refuse is worse than no link.\n221\t    \"\"\"\n222\t    out: dict[str, Any] = {\"buses\": [], \"modules\": [], \"error\": None}\n223\t    try:\n224\t        out[\"buses\"] = live_ops.buses()[\"buses\"]\n225\t    except LiveError as exc:\n226\t        out[\"error\"] = str(exc)\n227\t        return out\n228\t    out[\"modules\"] = _match_live_modules(ecu_seen)\n229\t    return out\n230\t\n231\t\n232\t@router.get(\"/v/{vin}\", response_class=HTMLResponse)\n233\tdef vehicle(request: Request, vin: str) -> HTMLResponse:\n234\t    \"\"\"The dossier: what am I looking at, before the hood opens.\"\"\"\n235\t    dossier = _dossier(vin)\n236\t    codes = mes_bridge.open_codes_for(dossier)\n237\t    bar = _vehicle_bar(vin, dossier)\n238\t    vehicle_notes = mes_bridge.notes(vin, target_kind=\"vehicle\")[\"notes\"]\n239\t    live_status = _status_strip()\n240\t    view = dossier_bridge.build_view(vin, dossier, live_status)\n241\t    response = _page(request, \"vehicle.html\", vin=vin, d=dossier, bar=bar,\n242\t                     open_codes=codes, live_panel=_live_panel_for(vin, bar[\"ecus\"]),\n243\t                     notes_list=vehicle_notes, note_target_kind=\"vehicle\",\n244\t                     note_target_id=\"\", note_redirect=f\"/v/{vin}\", note_kind_locked=True,\n245\t                     tab=\"dossier\", view=view, live_strip=live_status)\n246\t    _set_active_vehicle(response, vin)\n247\t    return response\n248\t\n249\t\n250\t@router.get(\"/v/{vin}/codes\", response_class=HTMLResponse)\n251\tdef codes(request: Request, vin: str,\n252\t          include_simulation: bool = False) -> HTMLResponse:\n253\t    \"\"\"Every code this car has ever set, ordered by what decides a diagnosis.\"\"\"\n254\t    dossier = _dossier(vin)\n255\t    data = mes_bridge.extract_dtcs(vin=vin,\n256\t                                   include_simulation=include_simulation)\n257\t    response = _page(request, \"codes.html\", vin=vin, rows=data[\"dtcs\"], data=data,\n258\t                     bar=_vehicle_bar(vin, dossier),\n259\t                     include_simulation=include_simulation, tab=\"codes\")\n260\t    _set_active_vehicle(response, vin)\n261\t    return response\n262\t\n263\t\n264\t@router.get(\"/v/{vin}/code/{code}\", response_class=HTMLResponse)\n265\tdef code_detail(request: Request, vin: str, code: str) -> HTMLResponse:\n266\t    \"\"\"One code's complete life, with its freeze frames beside it.\"\"\"\n267\t    dossier = _dossier(vin)\n268\t    history = mes_bridge.dtc_history(code, vin=vin)\n269\t    try:\n270\t        frames = mes_bridge.freeze_frames(code=code, vin=vin)\n271\t    except BridgeError:\n272\t        frames = {\"count\": 0, \"frames\": []}\n273\t    code_upper = code.upper()\n274\t    code_notes = mes_bridge.notes(vin, target_kind=\"code\", target_id=code_upper)[\"notes\"]\n275\t    response = _page(request, \"code.html\", vin=vin, code=code_upper,\n276\t                     records=history[\"matches\"], frames=frames,\n277\t                     notes_list=code_notes, note_target_kind=\"code\",\n278\t                     note_target_id=code_upper, note_redirect=f\"/v/{vin}/code/{code_upper}\",\n279\t                     note_kind_locked=True,\n280\t                     bar=_vehicle_bar(vin, dossier), tab=\"codes\")\n281\t    _set_active_vehicle(response, vin)\n282\t    return response\n283\t\n284\t\n285\t@router.get(\"/v/{vin}/tree\", response_class=HTMLResponse)\n286\tdef tree(request: Request, vin: str, codes: str = \"\") -> HTMLResponse:\n287\t    \"\"\"Cheapest-first isolation, annotated with this car's own evidence.\"\"\"\n288\t    dossier = _dossier(vin)\n289\t    if not codes.strip():\n290\t        codes = \" \".join(mes_bridge.open_codes_for(dossier))\n291\t    result = mes_bridge.fault_tree(codes, vin=vin)\n292\t    tree_step_notes = mes_bridge.notes(vin, target_kind=\"tree_step\")[\"notes\"]\n293\t    response = _page(request, \"tree.html\", vin=vin, codes=codes, result=result,\n294\t                     notes_list=tree_step_notes, note_target_kind=\"tree_step\",\n295\t                     note_target_id=\"\",\n296\t                     note_redirect=f\"/v/{vin}/tree?codes={quote(codes)}\",\n297\t                     note_kind_locked=False,\n298\t                     bar=_vehicle_bar(vin, dossier), tab=\"tree\")\n299\t    _set_active_vehicle(response, vin)\n300\t    return response\n301\t\n302\t\n303\tdef _live_observations_for(vin: str) -> tuple[list[dict[str, Any]], str | None]:\n304\t    \"\"\"What the live link has recorded for this VIN, newest first.\n305\t\n306\t    Read-only against the observation store cuore.live already writes to on\n307\t    every live read -- nothing here opens the adapter. A gate form with\n308\t    nothing to show just means no live session has run for this car yet.\n309\t    \"\"\"\n310\t    try:\n311\t        obs = live_ops.observations(n=20, vin=vin)[\"entries\"]\n312\t        return list(reversed(obs)), None\n313\t    except LiveError as exc:\n314\t        return [], str(exc)\n315\t\n316\t\n317\t@router.get(\"/v/{vin}/gate\", response_class=HTMLResponse)\n318\tdef gate_form(request: Request, vin: str, codes: str = \"\") -> HTMLResponse:\n319\t    \"\"\"The evidence gate, empty.\"\"\"\n320\t    dossier = _dossier(vin)\n321\t    if not codes.strip():\n322\t        codes = \" \".join(mes_bridge.open_codes_for(dossier))\n323\t    live_obs, live_obs_error = _live_observations_for(vin)\n324\t    response = _page(request, \"gate.html\", vin=vin, result=None,\n325\t                     form={\"codes\": codes, \"component\": \"\", \"mechanism\": \"\",\n326\t                           \"disconfirming_test\": \"\"},\n327\t                     rows=[{\"type\": \"actuator\"}],\n328\t                     live_observations=live_obs, live_observations_error=live_obs_error,\n329\t                     bar=_vehicle_bar(vin, dossier), tab=\"gate\")\n330\t    _set_active_vehicle(response, vin)\n331\t    return response\n332\t\n333\t\n334\t@router.post(\"/v/{vin}/gate\", response_class=HTMLResponse)\n335\tasync def gate_submit(request: Request, vin: str,\n336\t                      codes: str = Form(default=\"\"),\n337\t                      component: str = Form(default=\"\"),\n338\t                      mechanism: str = Form(default=\"\"),\n339\t                      disconfirming_test: str = Form(default=\"\")\n340\t                      ) -> HTMLResponse:\n341\t    \"\"\"Gate a proposed diagnosis. Writes nothing, to the car or the corpus.\n342\t\n343\t    Measurement rows arrive as parallel ``m_*`` fields rather than a JSON blob\n344\t    so the form degrades without JavaScript -- this gets used on a tablet with\n345\t    oily hands, and a page that needs a working script to submit is a page that\n346\t    fails at the worst moment.\n347\t    \"\"\"\n348\t    form = await request.form()\n349\t    rows: list[dict[str, Any]] = []\n350\t    for i, mtype in enumerate(form.getlist(\"m_type\")):\n351\t        def field(key: str) -> str:\n352\t            return str(form.get(f\"m_{key}_{i}\", \"\")).strip()\n353\t\n354\t        row: dict[str, Any] = {\"type\": mtype}\n355\t        if mtype == \"actuator\" and field(\"operation\"):\n356\t            row[\"operation\"] = field(\"operation\")\n357\t        elif mtype == \"freeze_frame\" and field(\"code\"):\n358\t            row[\"code\"] = field(\"code\")\n359\t        elif mtype == \"parameter\" and field(\"name\"):\n360\t            row[\"name\"] = field(\"name\")\n361\t            if field(\"file\"):\n362\t                row[\"file\"] = field(\"file\")\n363\t        elif mtype == \"recording_event\" and field(\"file\") and field(\"condition\"):\n364\t            row[\"file\"] = field(\"file\")\n365\t            row[\"condition\"] = field(\"condition\")\n366\t        elif mtype == \"manual\" and field(\"description\"):\n367\t            row[\"description\"] = field(\"description\")\n368\t        elif mtype == \"live\" and field(\"kind\"):\n369\t            # Verified against cuore.live's own observation record, not typed\n370\t            # in -- the fields differ by kind, so only the ones that kind\n371\t            # actually uses get carried into the citation.\n372\t            row[\"kind\"] = field(\"kind\")\n373\t            if row[\"kind\"] in (\"dtc\", \"permanent\", \"module_dtc\") and field(\"code\"):\n374\t                row[\"code\"] = field(\"code\")\n375\t            if row[\"kind\"] == \"readiness\" and field(\"monitor\"):\n376\t                row[\"monitor\"] = field(\"monitor\")\n377\t            if row[\"kind\"] in (\"module_dtc\", \"did\") and field(\"ecu\"):\n378\t                row[\"ecu\"] = field(\"ecu\")\n379\t            if row[\"kind\"] == \"did\" and field(\"did\"):\n380\t                row[\"did\"] = field(\"did\")\n381\t            if len(row) <= 2:   # kind + type only -- nothing to verify against\n382\t                continue\n383\t        else:\n384\t            continue\n385\t        rows.append(row)\n386\t\n387\t    result = mes_bridge.assess_verdict(\n388\t        vin=vin, codes=codes, component=component, mechanism=mechanism,\n389\t        measurements=json.dumps(rows) if rows else \"\",\n390\t        disconfirming_test=disconfirming_test)\n391\t\n392\t    dossier = _dossier(vin)\n393\t    live_obs, live_obs_error = _live_observations_for(vin)\n394\t    response = _page(request, \"gate.html\", vin=vin, result=result,\n395\t                     form={\"codes\": codes, \"component\": component,\n396\t                           \"mechanism\": mechanism,\n397\t                           \"disconfirming_test\": disconfirming_test},\n398\t                     rows=rows or [{\"type\": \"actuator\"}],\n399\t                     live_observations=live_obs, live_observations_error=live_obs_error,\n400\t                     bar=_vehicle_bar(vin, dossier), tab=\"gate\")\n401\t    _set_active_vehicle(response, vin)\n402\t    return response\n403\t\n404\t\n405\t@router.get(\"/modules\", response_class=HTMLResponse)\n406\tdef modules(request: Request, domain: str = \"\", view: str = \"\") -> HTMLResponse:\n407\t    \"\"\"The module registry, and which OBD bus each module lives on.\n408\t\n409\t    One page, two facets over the same overlap rather than two separately\n410\t    designed tables that happened to describe the same parts. The default\n411\t    view is the full 126-entry reference registry; the 5 rows with a\n412\t    confirmed live address link straight to a read, the other 20 the live\n413\t    link knows about but cannot yet address stay plain text. ``?view=live``\n414\t    flips to the live link's own facet -- bus, 29-bit address, confidence,\n415\t    whether this car has actually shown up carrying it -- over its full\n416\t    25-entry table, each enriched with its registry domain and tier rather\n417\t    than the live table needing to duplicate them.\n418\t    \"\"\"\n419\t    try:\n420\t        live_rows = live_ops.modules()[\"modules\"]\n421\t    except LiveError:\n422\t        live_rows = []\n423\t    # \"In the live table\" (25) is not \"can actually be read right now\" (5) --\n424\t    # only the confirmed-address rows get a link that won't just refuse.\n425\t    live_usable = {m[\"code\"].upper() for m in live_rows if m[\"usable\"]}\n426\t    live_present = {m[\"code\"].upper() for m in live_rows if m.get(\"present\") == \"confirmed\"}\n427\t\n428\t    if view == \"live\":\n429\t        enriched = []\n430\t        for m in live_rows:\n431\t            try:\n432\t                info = mes_bridge.module_registry(abbrev=m[\"code\"])\n433\t            except BridgeError:\n434\t                info = {}\n435\t            enriched.append({**m, \"domain\": info.get(\"domain\"), \"tier\": info.get(\"tier\"),\n436\t                             \"aliases\": info.get(\"aliases\")})\n437\t        data = {\"view_rows\": sorted(enriched, key=lambda r: r[\"code\"])}\n438\t    else:\n439\t        data = mes_bridge.module_registry(domain=domain)\n440\t\n441\t    return _page(request, \"modules.html\", data=data, domain=domain, view=view,\n442\t                 live_usable=live_usable, live_present=live_present)\n443\t\n444\t\n445\t@router.get(\"/recordings\", response_class=HTMLResponse)\n446\tdef recordings(request: Request) -> HTMLResponse:\n447\t    return _page(request, \"recordings.html\",\n448\t                 data=mes_bridge.list_recordings())\n449\t\n450\t\n451\t@router.get(\"/recording/{name}\", response_class=HTMLResponse)\n452\tdef recording(request: Request, name: str, condition: str = \"\") -> HTMLResponse:\n453\t    \"\"\"One recording, with optional threshold analysis over it.\"\"\"\n454\t    data = mes_bridge.read_recording(name, preview_rows=15)\n455\t    events = None\n456\t    events_error = None\n457\t    try:\n458\t        events = mes_bridge.recording_events(name, condition=condition)\n459\t    except BridgeError as exc:\n460\t        events_error = str(exc)\n461\t    return _page(request, \"recording.html\", name=name, data=data,\n462\t                 events=events, events_error=events_error,\n463\t                 condition=condition)\n464\t\n465\t\n466\t@router.get(\"/logs\", response_class=HTMLResponse)\n467\tdef logs(request: Request, vin: str = \"\", kind: str = \"\",\n468\t         include_simulation: bool = False) -> HTMLResponse:\n469\t    \"\"\"The raw index. Provenance is a column, not a footnote.\"\"\"\n470\t    data = mes_bridge.list_logs(vin=vin, kind=kind, limit=200,\n471\t                                include_simulation=include_simulation)\n472\t    return _page(request, \"logs.html\", data=data, vin=vin, kind=kind,\n473\t                 include_simulation=include_simulation)\n474\t\n475\t\n476\t# --- live link --------------------------------------------------------------\n477\t#\n478\t# Every value below comes from cuore.live.ops, the same functions the MCP\n479\t# tools call. This module never opens the adapter itself and never bypasses\n480\t# the ops-layer safety gates (cable declaration, bus verification, the\n481\t# transmit-confirmation flag) -- it only decides how to *render* what those\n482\t# gates say, including turning a refusal into guidance instead of a 500.\n483\t#\n484\t# The UI adds one gate of its own, stricter than the live layer's: reading a\n485\t# module on CAN-CH or CAN-IHS always shows a confirm checkbox here, even\n486\t# though only CAN-CH is flagged transmit_needs_confirmation in cuore.live.buses\n487\t# -- both carry chassis/body modules this bench UI treats as sensitive.\n488\t\n489\t\n490\tdef _live_snapshot() -> dict[str, Any]:\n491\t    \"\"\"The always-shown facts: adapter status, cable/bus state, module table.\n492\t\n493\t    Each call is independently wrapped -- one failing (say, no port\n494\t    configured) must not blank the other two panels.\n495\t    \"\"\"\n496\t    out: dict[str, Any] = {}\n497\t    try:\n498\t        out[\"status\"] = live_ops.status()\n499\t        out[\"status_error\"] = None\n500\t    except LiveError as exc:\n501\t        out[\"status\"] = None\n502\t        out[\"status_error\"] = str(exc)\n503\t    try:\n504\t        out[\"cable_data\"] = live_ops.buses()\n505\t        out[\"cable_error\"] = None\n506\t    except LiveError as exc:\n507\t        out[\"cable_data\"] = None\n508\t        out[\"cable_error\"] = str(exc)\n509\t    try:\n510\t        out[\"module_rows\"] = live_ops.modules()[\"modules\"]\n511\t        out[\"module_error\"] = None\n512\t    except LiveError as exc:\n513\t        out[\"module_rows\"] = []\n514\t        out[\"module_error\"] = str(exc)\n515\t    return out\n516\t\n517\t\n518\tdef _live_page(request: Request, vin: str = \"\", **extra: Any) -> HTMLResponse:\n519\t    active = _active_vehicle(request, vin)\n520\t    ctx = _live_snapshot()\n521\t    ctx[\"pin_1_9_warning\"] = PIN_1_9_WARNING\n522\t    ctx[\"can_ch_note\"] = BUSES[\"can_ch\"].notes\n523\t    ctx[\"can_ihs_note\"] = BUSES[\"can_ihs\"].notes\n524\t    ctx[\"active_vehicle\"] = _active_vehicle_bar(active)\n525\t    # This page already shows the live state in full below the fold; the\n526\t    # header strip would only repeat it.\n527\t    ctx[\"live_strip\"] = None\n528\t    ctx.update(extra)\n529\t    return _page(request, \"live.html\", **ctx)\n530\t\n531\t\n532\t@router.get(\"/live\", response_class=HTMLResponse)\n533\tdef live_page(request: Request, cable_error: str = \"\", vin: str = \"\") -> HTMLResponse:\n534\t    \"\"\"Adapter status, cable declaration, bus map, module table and OBD.\"\"\"\n535\t    # Only override the snapshot's cable_error when the redirect carried one;\n536\t    # passing None here would erase a real bus-state failure.\n537\t    extra = {\"cable_error\": cable_error} if cable_error else {}\n538\t    return _live_page(request, vin=vin, **extra)\n539\t\n540\t\n541\t@router.post(\"/live/vehicle/clear\", response_class=HTMLResponse)\n542\tdef live_clear_vehicle() -> RedirectResponse:\n543\t    \"\"\"Stop tagging live reads against a vehicle. Just the one cookie.\"\"\"\n544\t    resp = RedirectResponse(url=\"/live\", status_code=303)\n545\t    resp.delete_cookie(_VIN_COOKIE)\n546\t    return resp\n547\t\n548\t\n549\t@router.post(\"/live/cable\", response_class=HTMLResponse)\n550\tdef live_set_cable(cable: str = Form(...)) -> RedirectResponse:\n551\t    \"\"\"Declare the fitted cable, then redirect back (GET/POST/redirect, no JS needed).\"\"\"\n552\t    try:\n553\t        live_ops.set_cable(cable)\n554\t    except LiveError as exc:\n555\t        return RedirectResponse(url=f\"/live?cable_error={quote(str(exc))}\",\n556\t                                status_code=303)\n557\t    return RedirectResponse(url=\"/live\", status_code=303)\n558\t\n559\t\n560\t@router.post(\"/live/verify\", response_class=HTMLResponse)\n561\tdef live_verify(request: Request, bus: str = Form(...),\n562\t                seconds: float = Form(default=2.0)) -> HTMLResponse:\n563\t    \"\"\"Passive listen on one bus; rendered inline rather than a redirect so\n564\t    the frame count and IDs seen are not lost.\"\"\"\n565\t    try:\n566\t        result = live_ops.verify_bus(bus, seconds=seconds)\n567\t        error = None\n568\t    except LiveError as exc:\n569\t        result = None\n570\t        error = str(exc)\n571\t    return _live_page(request, verify_bus_key=bus, verify_result=result,\n572\t                      verify_error=error)\n573\t\n574\t\n575\t@router.post(\"/live/probe\", response_class=HTMLResponse)\n576\tdef live_probe(request: Request) -> HTMLResponse:\n577\t    \"\"\"Reset the adapter and read its identity. Holds nothing afterwards.\"\"\"\n578\t    try:\n579\t        result = live_ops.probe()\n580\t        error = None\n581\t    except LiveError as exc:\n582\t        result = None\n583\t        error = str(exc)\n584\t    return _live_page(request, probe_result=result, probe_error=error)\n585\t\n586\t\n587\t_OBD_ACTIONS: dict[str, Any] = {\n588\t    \"dtcs\": live_ops.obd_all_dtcs,\n589\t    \"readiness\": live_ops.obd_readiness,\n590\t    \"vin\": live_ops.obd_vin,\n591\t    \"voltage\": live_ops.obd_voltage,\n592\t}\n593\t\n594\t\n595\t@router.post(\"/live/obd/{kind}\", response_class=HTMLResponse)\n596\tdef live_obd(request: Request, kind: str) -> HTMLResponse:\n597\t    \"\"\"Legislated OBD on CAN-C: DTCs, readiness, VIN or battery voltage.\n598\t\n599\t    These are Mode 01/02/03/07/09/0A reads, need no cable/verification gate\n600\t    and no confirm checkbox -- CAN-C carries no chassis-safety module and the\n601\t    live layer itself never lets a write reach the wire from here.\n602\t    \"\"\"\n603\t    fn = _OBD_ACTIONS.get(kind)\n604\t    if fn is None:\n605\t        return _live_page(request, obd_kind=kind, obd_result=None,\n606\t                          obd_error=f\"unknown legislated-OBD action {kind!r}\")\n607\t    try:\n608\t        result = fn()\n609\t        error = None\n610\t    except LiveError as exc:\n611\t        result = None\n612\t        error = str(exc)\n613\t    return _live_page(request, obd_kind=kind, obd_result=result, obd_error=error)\n614\t\n615\t\n616\t@router.get(\"/live/module/{code}\", response_class=HTMLResponse)\n617\tdef live_module(request: Request, code: str, confirm: bool = False,\n618\t                vin: str = \"\") -> HTMLResponse:\n619\t    \"\"\"One module's UDS DTCs and Annex C identity.\n620\t\n621\t    A refusal from the live layer (unverified bus, unknown module, MES\n622\t    holding the adapter) is guidance here, not an error page -- this is the\n623\t    single most likely outcome on a bench that has not yet declared a cable\n624\t    or run a passive listen.\n625\t\n626\t    Tags both reads with the active vehicle (``?vin=``, else the dossier's\n627\t    cookie) so they land as observations the evidence gate can find and so\n628\t    address confirmations persist per VIN, instead of every live read being\n629\t    anonymous until a VIN happens to be read back from the wire.\n630\t    \"\"\"\n631\t    code = code.strip()\n632\t    active_vin = _active_vehicle(request, vin)\n633\t    try:\n634\t        rows = live_ops.modules()[\"modules\"]\n635\t    except LiveError:\n636\t        rows = []\n637\t    row = next((m for m in rows if m[\"code\"].upper() == code.upper()), None)\n638\t    bus_key = row[\"bus\"] if row else None\n639\t    needs_confirm = bus_key in (\"can_ch\", \"can_ihs\")\n640\t\n641\t    dtcs = identity = None\n642\t    dtcs_error = identity_error = None\n643\t    if needs_confirm and not confirm:\n644\t        dtcs_error = identity_error = (\n645\t            f\"module {code.upper()} lives on {bus_key}, which this bench UI treats as \"\n646\t            f\"sensitive (chassis/body). Tick 'confirm' and read again. This is in addition \"\n647\t            f\"to whatever cuore.live itself enforces for that bus.\")\n648\t    else:\n649\t        try:\n650\t            dtcs = live_ops.module_dtcs(code, vin=active_vin, confirm=confirm)\n651\t        except LiveError as exc:\n652\t            dtcs_error = str(exc)\n653\t        try:\n654\t            identity = live_ops.module_identity(code, vin=active_vin, confirm=confirm)\n655\t        except LiveError as exc:\n656\t            identity_error = str(exc)\n657\t\n658\t    return _page(request, \"live_module.html\", code=code.upper(), confirm=confirm,\n659\t                 row=row, bus_key=bus_key, needs_confirm=needs_confirm,\n660\t                 dtcs=dtcs, dtcs_error=dtcs_error,\n661\t                 identity=identity, identity_error=identity_error,\n662\t                 pin_1_9_warning=PIN_1_9_WARNING, live_strip=None,\n663\t                 active_vehicle=_active_vehicle_bar(active_vin))\n664\t\n665\t\n666\t# --- whole-car coverage --------------------------------------------------------\n667\t\n668\tdef _coverage_page(request: Request, error: str = \"\", refused: bool = False,\n669\t                   vin: str = \"\") -> HTMLResponse:\n670\t    from ..live import coverage as cov\n671\t    from ..live.buses import CABLES\n672\t    try:\n673\t        st = live_ops.coverage_status()\n674\t        cable = live_ops.cable_state()[\"cable\"]\n675\t    except LiveError as exc:\n676\t        st, cable, error = {\"active\": False, \"passes\": []}, \"unknown\", str(exc)\n677\t    return _page(request, \"coverage.html\", st=st, cable=cable, cables=CABLES,\n678\t                 pass_by_key=cov.PASS_BY_KEY, error=error, refused=refused,\n679\t                 vin=vin or _active_vehicle(request))\n680\t\n681\t\n682\tdef _coverage_do(request: Request, fn: Any) -> HTMLResponse:\n683\t    from ..live.errors import Refused\n684\t    try:\n685\t        fn()\n686\t    except Refused as exc:\n687\t        return _coverage_page(request, error=str(exc), refused=True)\n688\t    except LiveError as exc:\n689\t        return _coverage_page(request, error=str(exc))\n690\t    return RedirectResponse(url=\"/coverage\", status_code=303)\n691\t\n692\t\n693\t@router.get(\"/coverage\", response_class=HTMLResponse)\n694\tdef coverage_page(request: Request, vin: str = \"\") -> HTMLResponse:\n695\t    \"\"\"Guided three-pass, three-bus scan with the bystander diff.\"\"\"\n696\t    return _coverage_page(request, vin=vin)\n697\t\n698\t\n699\t@router.post(\"/coverage/start\", response_class=HTMLResponse)\n700\tdef coverage_start(request: Request, vin: str = Form(...),\n701\t                   engine_running: bool = Form(default=False)) -> HTMLResponse:\n702\t    return _coverage_do(request, lambda: live_ops.coverage_start(vin.strip(),\n703\t                                                                 engine_running=engine_running))\n704\t\n705\t\n706\t@router.post(\"/coverage/cable\", response_class=HTMLResponse)\n707\tdef coverage_cable(request: Request, cable: str = Form(...)) -> HTMLResponse:\n708\t    return _coverage_do(request, lambda: live_ops.set_cable(cable))\n709\t\n710\t\n711\t@router.post(\"/coverage/run\", response_class=HTMLResponse)\n712\tdef coverage_run(request: Request, key: str = Form(...),\n713\t                 confirm: bool = Form(default=False)) -> HTMLResponse:\n714\t    return _coverage_do(request, lambda: live_ops.coverage_run(key, confirm=confirm))\n715\t\n716\t\n717\t@router.post(\"/coverage/skip\", response_class=HTMLResponse)\n718\tdef coverage_skip(request: Request, key: str = Form(...),\n719\t                  reason: str = Form(default=\"\")) -> HTMLResponse:\n720\t    return _coverage_do(request, lambda: live_ops.coverage_skip(key, reason))\n721\t\n722\t\n723\t@router.post(\"/coverage/reset\", response_class=HTMLResponse)\n724\tdef coverage_reset(request: Request) -> HTMLResponse:\n725\t    return _coverage_do(request, live_ops.coverage_reset)\n726\t\n727\t\n728\t@router.get(\"/v/{vin}/live-vs-log\", response_class=HTMLResponse)\n729\tdef live_vs_log(request: Request, vin: str, module: str = \"\") -> HTMLResponse:\n730\t    \"\"\"Newest MES log vs newest live UDS read, one row per code, per module.\"\"\"\n731\t    dossier = _dossier(vin)\n732\t    result = mes_bridge.live_vs_log(vin, module=module)\n733\t    response = _page(request, \"live_vs_log.html\", vin=vin, result=result,\n734\t                     module=module, bar=_vehicle_bar(vin, dossier),\n735\t                     tab=\"live_vs_log\")\n736\t    _set_active_vehicle(response, vin)\n737\t    return response\n738\t\n739\t\n740\t# --- dealer (wiTECH) results -------------------------------------------------\n741\t#\n742\t# wiTECH has no API; the owner's dealer account is read by a technician on\n743\t# wiTECH's own screens, and the result is typed in here to become evidence\n744\t# the gate, the fault tree and the dossier can all cite. This page writes only\n745\t# to the dealer results store -- never to the car, never to the MES corpus.\n746\t\n747\t\n748\t@router.get(\"/v/{vin}/dealer\", response_class=HTMLResponse)\n749\tdef dealer_form(request: Request, vin: str) -> HTMLResponse:\n750\t    \"\"\"The dealer results page, with whatever has been recorded so far.\"\"\"\n751\t    dossier = _dossier(vin)\n752\t    results = mes_bridge.dealer_results(vin)[\"results\"]\n753\t    response = _page(request, \"dealer.html\", vin=vin, results=results, error=None,\n754\t                     bar=_vehicle_bar(vin, dossier), tab=\"dealer\")\n755\t    _set_active_vehicle(response, vin)\n756\t    return response\n757\t\n758\t\n759\t@router.post(\"/v/{vin}/dealer\", response_class=HTMLResponse)\n760\tasync def dealer_submit(request: Request, vin: str) -> HTMLResponse:\n761\t    \"\"\"Record one technician-entered wiTECH result.\n762\t\n763\t    One shared endpoint for all five kinds, distinguished by a ``kind`` hidden\n764\t    field on each of the page's small per-kind forms -- this keeps the page\n765\t    working with no JavaScript, and matches how ``/gate`` handles measurement\n766\t    rows.\n767\t    \"\"\"\n768\t    form = await request.form()\n769\t    kind = str(form.get(\"kind\", \"\")).strip()\n770\t    note = str(form.get(\"note\", \"\")).strip()\n771\t\n772\t    def field(name: str) -> str:\n773\t        return str(form.get(name, \"\")).strip()\n774\t\n775\t    data: dict[str, Any] = {}\n776\t    if kind == \"flash_check\":\n777\t        data = {\"module\": field(\"module\") or \"ECM\",\n778\t                \"current_part\": field(\"current_part\"),\n779\t                \"new_part\": field(\"new_part\"),\n780\t                \"flashed\": form.get(\"flashed\") == \"on\"}\n781\t        if field(\"part_after\"):\n782\t            data[\"part_after\"] = field(\"part_after\")\n783\t    elif kind == \"slvt\":\n784\t        data = {\"result\": field(\"result\"), \"detail\": field(\"detail\")}\n785\t    elif kind == \"dtc_report\":\n786\t        data = {\"module\": field(\"module\"),\n787\t                \"codes\": [c.strip() for c in field(\"codes\").split(\",\") if c.strip()],\n788\t                \"note\": field(\"dtc_note\")}\n789\t    elif kind == \"recall_status\":\n790\t        data = {\"campaign\": field(\"campaign\"), \"status\": field(\"status\"),\n791\t                \"date\": field(\"date\")}\n792\t    elif kind == \"routine\":\n793\t        data = {\"module\": field(\"module\"), \"name\": field(\"name\"),\n794\t                \"result\": field(\"result\")}\n795\t\n796\t    error = None\n797\t    try:\n798\t        mes_bridge.dealer_record(vin, kind, data, note=note)\n799\t    except BridgeError as exc:\n800\t        error = str(exc)\n801\t\n802\t    dossier = _dossier(vin)\n803\t    results = mes_bridge.dealer_results(vin)[\"results\"]\n804\t    response = _page(request, \"dealer.html\", vin=vin, results=results, error=error,\n805\t                     bar=_vehicle_bar(vin, dossier), tab=\"dealer\")\n806\t    _set_active_vehicle(response, vin)\n807\t    return response\n808\t\n809\t\n810\t# --- technician notes -------------------------------------------------------\n811\t#\n812\t# Context on anything cuore found that lives nowhere else -- \"purge valve\n813\t# replaced by me 2026-09-10\", \"this scan was taken right after a battery\n814\t# disconnect\", \"smoke test done at 0.5 psi, no leak\" -- and that a diagnosis\n815\t# (and the LLM reading it) must be able to see. Same posture as the dealer\n816\t# results store above: append-only, never touches the car or the MES corpus.\n817\t\n818\t\n819\tdef _safe_redirect(url: str, fallback: str) -> str:\n820\t    \"\"\"Only ever redirect somewhere inside this app -- ``redirect_to`` is a\n821\t    hidden form field a client controls, not a trusted URL.\"\"\"\n822\t    if url.startswith(\"/\") and not url.startswith(\"//\"):\n823\t        return url\n824\t    return fallback\n825\t\n826\t\n827\t@router.get(\"/v/{vin}/notes\", response_class=HTMLResponse)\n828\tdef notes_page(request: Request, vin: str, target_kind: str = \"\",\n829\t              target_id: str = \"\") -> HTMLResponse:\n830\t    \"\"\"Every technician note for this vehicle, with edit/hide and a filter.\"\"\"\n831\t    dossier = _dossier(vin)\n832\t    rows = mes_bridge.notes(vin, target_kind=target_kind, target_id=target_id)[\"notes\"]\n833\t    response = _page(request, \"notes.html\", vin=vin, notes_list=rows,\n834\t                     filter_target_kind=target_kind, filter_target_id=target_id,\n835\t                     note_target_kind=target_kind or \"vehicle\",\n836\t                     note_target_id=target_id, note_redirect=f\"/v/{vin}/notes\",\n837\t                     note_kind_locked=False,\n838\t                     bar=_vehicle_bar(vin, dossier), tab=\"notes\")\n839\t    _set_active_vehicle(response, vin)\n840\t    return response\n841\t\n842\t\n843\t@router.post(\"/v/{vin}/notes\", response_class=HTMLResponse)\n844\tasync def notes_add(request: Request, vin: str) -> RedirectResponse:\n845\t    \"\"\"Record one technician note, then redirect back to wherever the add\n846\t    form was posted from -- the dossier, a code page, the tree, or this\n847\t    vehicle's own notes listing.\"\"\"\n848\t    form = await request.form()\n849\t    redirect_to = _safe_redirect(str(form.get(\"redirect_to\", \"\")), f\"/v/{vin}/notes\")\n850\t    tags = [t.strip() for t in str(form.get(\"tags\", \"\")).split(\",\") if t.strip()]\n851\t    mes_bridge.add_note(vin, str(form.get(\"text\", \"\")),\n852\t                        target_kind=str(form.get(\"target_kind\", \"vehicle\")),\n853\t                        target_id=str(form.get(\"target_id\", \"\")),\n854\t                        author=str(form.get(\"author\", \"\")).strip() or \"technician\",\n855\t                        tags=tags)\n856\t    return RedirectResponse(url=redirect_to, status_code=303)\n857\t\n858\t\n859\t@router.post(\"/v/{vin}/notes/{id}/edit\", response_class=HTMLResponse)\n860\tasync def notes_edit(request: Request, vin: str, id: str) -> RedirectResponse:\n861\t    \"\"\"Amend a note's text. Writes an amendment record -- never rewrites history.\"\"\"\n862\t    form = await request.form()\n863\t    redirect_to = _safe_redirect(str(form.get(\"redirect_to\", \"\")), f\"/v/{vin}/notes\")\n864\t    mes_bridge.edit_note(id, str(form.get(\"text\", \"\")))\n865\t    return RedirectResponse(url=redirect_to, status_code=303)\n866\t\n867\t\n868\t@router.post(\"/v/{vin}/notes/{id}/hide\", response_class=HTMLResponse)\n869\tasync def notes_hide(request: Request, vin: str, id: str) -> RedirectResponse:\n870\t    \"\"\"Hide a note (soft delete). Writes a hide record -- never rewrites history.\"\"\"\n871\t    form = await request.form()\n872\t    redirect_to = _safe_redirect(str(form.get(\"redirect_to\", \"\")), f\"/v/{vin}/notes\")\n873\t    mes_bridge.hide_note(id)\n874\t    return RedirectResponse(url=redirect_to, status_code=303)\n875\t"}]},"uuid":"aff8687f-49b0-455d-8dc7-c524ac73b3df","timestamp":"2026-10-08T03:04:18.819Z","toolUseResult":{"type":"text","file":{"filePath":"C:\\Users\\User\\mcp-servers\\cuore\\web\\routes.py","content":"\"\"\"The bench UI.\n\nEvery page calls the same :mod:`cuore.services.mes_bridge` functions the JSON\nAPI does, so the two surfaces cannot disagree about what a car's history says.\nTemplates render; they do not decide. Chronic classification, TSB matching,\nfault-tree content and the gate's criteria all live in ``mes``.\n\nPage set:\n\n===========================  ==================================================\n``/``                        vehicle picker and corpus health\n``/v/{vin}``                 the dossier\n``/v/{vin}/codes``           every code with severity and provenance\n``/v/{vin}/code/{code}``     one code's life across sessions\n``/v/{vin}/tree``            fault-tree walkthrough\n``/v/{vin}/gate``            the evidence gate\n``/modules``                 module registry and bus map\n``/recordings``              CSV recordings\n``/logs``                    the raw log index\n``/live``                    the live link: adapter, cable, buses, OBD\n``/live/module/{code}``      one module's UDS DTCs and identity, live\n===========================  ==================================================\n\"\"\"\n\nfrom __future__ import annotations\n\nimport json\nfrom pathlib import Path\nfrom typing import Any\nfrom urllib.parse import quote\n\nfrom fastapi import APIRouter, Depends, Form, Request, Response\nfrom fastapi.responses import HTMLResponse, RedirectResponse\nfrom fastapi.templating import Jinja2Templates\n\nfrom .. import __version__\nfrom ..services import cache, dossier_bridge, mes_bridge\nfrom ..services.errors import BridgeError\nfrom ..api.deps import require_token, settings_of\nfrom ..live import ops as live_ops\nfrom ..live.buses import BUSES, PIN_1_9_WARNING\nfrom ..live.errors import LiveError\n\nHERE = Path(__file__).resolve().parent\nTEMPLATE_DIR = HERE / \"templates\"\nSTATIC_DIR = HERE / \"static\"\n\ntemplates = Jinja2Templates(directory=str(TEMPLATE_DIR))\n\nrouter = APIRouter(include_in_schema=False,\n                   dependencies=[Depends(require_token)])\n\n\n# --- helpers --------------------------------------------------------------\n\n\ndef _status_strip() -> dict[str, Any]:\n    \"\"\"The live link's headline state, cheap enough for every page load.\n\n    No adapter I/O happens here -- ``live_ops.status()`` only reads the\n    registry, the lock file and the MES process/window state. This is what\n    makes it safe to compute unconditionally rather than opt-in per page,\n    which is the point: MES holding the port, or a bus sitting unverified,\n    used to be invisible outside ``/live``.\n    \"\"\"\n    try:\n        s = live_ops.status()\n        return {\n            \"port\": s.get(\"port\"), \"baud\": s.get(\"baud\"),\n            \"mes_state\": (s.get(\"mes\") or {}).get(\"state\"),\n            \"cable\": (s.get(\"cable\") or {}).get(\"cable\"),\n            \"buses_verified\": sum(1 for b in (s.get(\"cable\") or {}).get(\"buses\", [])\n                                  if b.get(\"verified\")),\n            \"buses_total\": len((s.get(\"cable\") or {}).get(\"buses\", [])),\n            \"lock_holder\": (s.get(\"lock\") or {}).get(\"process\"),\n            \"error\": None,\n        }\n    except Exception as exc:  # noqa: BLE001 - a broken strip must never 500 a page\n        return {\"error\": str(exc)}\n\n\ndef _page(request: Request, name: str, **ctx: Any) -> HTMLResponse:\n    \"\"\"Render a template with the context every page needs.\"\"\"\n    settings = settings_of(request)\n    ctx.setdefault(\"version\", __version__)\n    ctx.setdefault(\"profile\", settings.profile.value)\n    if \"live_strip\" not in ctx:  # not setdefault: the strip is not free to compute\n        ctx[\"live_strip\"] = _status_strip()\n    return templates.TemplateResponse(request, name, ctx)\n\n\ndef error_page(request: Request, body: Any) -> HTMLResponse:\n    \"\"\"Render a failure as a page. Used by the app's exception handlers.\n\n    Lives here rather than in ``app.py`` so the template lookup stays with the\n    other templates, and takes the same :class:`~cuore.models.ErrorBody` the\n    API returns so the two never describe a failure differently.\n    \"\"\"\n    settings = settings_of(request)\n    return templates.TemplateResponse(\n        request, \"error.html\",\n        {\"status\": body.status, \"error\": body.error, \"detail\": body.detail,\n         \"version\": __version__, \"profile\": settings.profile.value},\n        status_code=body.status,\n    )\n\n\ndef _dossier(vin: str) -> dict[str, Any]:\n    \"\"\"The cached workup for a VIN. See ``api/vehicles.py`` for why cached.\"\"\"\n    return cache.get_or_build(\n        (\"workup\", vin, mes_bridge.newest_mtime(vin)),\n        lambda: mes_bridge.workup(vin=vin),\n    )\n\n\ndef _vehicle_bar(vin: str, dossier: dict[str, Any]) -> dict[str, Any]:\n    \"\"\"Data for the sticky context bar.\n\n    It carries provenance and odometer span because those are the two facts\n    most easily lost while scrolling, and both change how a page should be\n    read: a simulated log is not evidence, and a code spanning 26,500 km is\n    not a fresh fault.\n    \"\"\"\n    ident = dossier.get(\"identity\", {})\n    first, last = ident.get(\"odometer_first_km\"), ident.get(\"odometer_last_km\")\n    span = None\n    if isinstance(first, (int, float)) and isinstance(last, (int, float)):\n        span = int(last) - int(first)\n    return {\n        \"vin\": vin,\n        \"name\": ident.get(\"vehicle\") or \"(unnamed vehicle)\",\n        \"logs\": ident.get(\"log_count\"),\n        \"first_log\": ident.get(\"first_log\"),\n        \"last_log\": ident.get(\"last_log\"),\n        \"odo_first\": first,\n        \"odo_last\": last,\n        \"odo_span\": span,\n        \"ecus\": ident.get(\"ecu_seen\") or [],\n    }\n\n\n# --- the active vehicle -----------------------------------------------------\n#\n# The seam between the corpus side of this app and the live side used to be\n# total: /v/{vin} knows a VIN, /live never did. A cookie is the whole fix --\n# visiting a vehicle's dossier makes it the vehicle any live read tags itself\n# against, until you visit a different one or clear it. Query-string ?vin=\n# always wins over the cookie, so a link from the dossier is self-contained\n# even if the cookie is stale or scripting is off.\n\n_VIN_COOKIE = \"cuore_vin\"\n\n\ndef _set_active_vehicle(response: Response, vin: str) -> None:\n    response.set_cookie(_VIN_COOKIE, vin, max_age=60 * 60 * 24 * 30, samesite=\"lax\")\n\n\ndef _active_vehicle(request: Request, vin_param: str = \"\") -> str:\n    \"\"\"The VIN a live read should tag itself with: query param, then cookie.\"\"\"\n    return vin_param.strip() or request.cookies.get(_VIN_COOKIE, \"\").strip()\n\n\ndef _active_vehicle_bar(vin: str) -> dict[str, Any] | None:\n    \"\"\"The small \"you are working on\" fact, shown on the live pages. None if\n    the active VIN does not resolve to anything in the corpus -- a stale\n    cookie after a corpus root changes should not error, just stop showing.\"\"\"\n    if not vin:\n        return None\n    try:\n        dossier = _dossier(vin)\n    except BridgeError:\n        return None\n    ident = dossier.get(\"identity\", {})\n    return {\"vin\": vin, \"name\": ident.get(\"vehicle\") or vin}\n\n\ndef _match_live_modules(ecu_seen: list[str]) -> list[dict[str, Any]]:\n    \"\"\"Which of this car's own logged ECUs the live link can also reach.\n\n    ``ecu_seen`` carries MES's full hardware description (\"Magneti Marelli\n    IAW 10JA CF6/EOBD Injection (2.0)\"); the live table's module names are\n    drawn from the same source material and match by equality or containment\n    -- checked both directions, since the live table sometimes carries a\n    trailing qualifier the corpus string does not (\"Body Computer Marelli\n    (949)\" vs \"Body Computer Marelli (949), gateway\").\n    \"\"\"\n    try:\n        live_rows = live_ops.modules()[\"modules\"]\n    except LiveError:\n        return []\n    seen_lower = [s.lower() for s in ecu_seen]\n    out = []\n    for m in live_rows:\n        name_lower = (m.get(\"name\") or \"\").lower()\n        if any(name_lower == s or name_lower.startswith(s) or s in name_lower\n               for s in seen_lower):\n            out.append(m)\n    return out\n\n\n# --- pages ----------------------------------------------------------------\n\n\n@router.get(\"/\", response_class=HTMLResponse)\ndef index(request: Request) -> HTMLResponse:\n    \"\"\"Vehicle picker, with the corpus's own health beside it.\"\"\"\n    status = mes_bridge.corpus_status()\n    return _page(request, \"index.html\",\n                 vehicles=mes_bridge.vehicles(real_only=True),\n                 all_vehicles=mes_bridge.vehicles(),\n                 stats=status)\n\n\ndef _live_panel_for(vin: str, ecu_seen: list[str]) -> dict[str, Any]:\n    \"\"\"The dossier's embedded live section: bus state plus this car's own\n    reachable modules, not the full 126-entry registry or the full 25-entry\n    live table -- just the intersection with what this VIN has actually\n    logged. Each matched module still carries ``usable``: being on this car\n    is not the same as having a confirmed address, and a link that will\n    only refuse is worse than no link.\n    \"\"\"\n    out: dict[str, Any] = {\"buses\": [], \"modules\": [], \"error\": None}\n    try:\n        out[\"buses\"] = live_ops.buses()[\"buses\"]\n    except LiveError as exc:\n        out[\"error\"] = str(exc)\n        return out\n    out[\"modules\"] = _match_live_modules(ecu_seen)\n    return out\n\n\n@router.get(\"/v/{vin}\", response_class=HTMLResponse)\ndef vehicle(request: Request, vin: str) -> HTMLResponse:\n    \"\"\"The dossier: what am I looking at, before the hood opens.\"\"\"\n    dossier = _dossier(vin)\n    codes = mes_bridge.open_codes_for(dossier)\n    bar = _vehicle_bar(vin, dossier)\n    vehicle_notes = mes_bridge.notes(vin, target_kind=\"vehicle\")[\"notes\"]\n    live_status = _status_strip()\n    view = dossier_bridge.build_view(vin, dossier, live_status)\n    response = _page(request, \"vehicle.html\", vin=vin, d=dossier, bar=bar,\n                     open_codes=codes, live_panel=_live_panel_for(vin, bar[\"ecus\"]),\n                     notes_list=vehicle_notes, note_target_kind=\"vehicle\",\n                     note_target_id=\"\", note_redirect=f\"/v/{vin}\", note_kind_locked=True,\n                     tab=\"dossier\", view=view, live_strip=live_status)\n    _set_active_vehicle(response, vin)\n    return response\n\n\n@router.get(\"/v/{vin}/codes\", response_class=HTMLResponse)\ndef codes(request: Request, vin: str,\n          include_simulation: bool = False) -> HTMLResponse:\n    \"\"\"Every code this car has ever set, ordered by what decides a diagnosis.\"\"\"\n    dossier = _dossier(vin)\n    data = mes_bridge.extract_dtcs(vin=vin,\n                                   include_simulation=include_simulation)\n    response = _page(request, \"codes.html\", vin=vin, rows=data[\"dtcs\"], data=data,\n                     bar=_vehicle_bar(vin, dossier),\n                     include_simulation=include_simulation, tab=\"codes\")\n    _set_active_vehicle(response, vin)\n    return response\n\n\n@router.get(\"/v/{vin}/code/{code}\", response_class=HTMLResponse)\ndef code_detail(request: Request, vin: str, code: str) -> HTMLResponse:\n    \"\"\"One code's complete life, with its freeze frames beside it.\"\"\"\n    dossier = _dossier(vin)\n    history = mes_bridge.dtc_history(code, vin=vin)\n    try:\n        frames = mes_bridge.freeze_frames(code=code, vin=vin)\n    except BridgeError:\n        frames = {\"count\": 0, \"frames\": []}\n    code_upper = code.upper()\n    code_notes = mes_bridge.notes(vin, target_kind=\"code\", target_id=code_upper)[\"notes\"]\n    response = _page(request, \"code.html\", vin=vin, code=code_upper,\n                     records=history[\"matches\"], frames=frames,\n                     notes_list=code_notes, note_target_kind=\"code\",\n                     note_target_id=code_upper, note_redirect=f\"/v/{vin}/code/{code_upper}\",\n                     note_kind_locked=True,\n                     bar=_vehicle_bar(vin, dossier), tab=\"codes\")\n    _set_active_vehicle(response, vin)\n    return response\n\n\n@router.get(\"/v/{vin}/tree\", response_class=HTMLResponse)\ndef tree(request: Request, vin: str, codes: str = \"\") -> HTMLResponse:\n    \"\"\"Cheapest-first isolation, annotated with this car's own evidence.\"\"\"\n    dossier = _dossier(vin)\n    if not codes.strip():\n        codes = \" \".join(mes_bridge.open_codes_for(dossier))\n    result = mes_bridge.fault_tree(codes, vin=vin)\n    tree_step_notes = mes_bridge.notes(vin, target_kind=\"tree_step\")[\"notes\"]\n    response = _page(request, \"tree.html\", vin=vin, codes=codes, result=result,\n                     notes_list=tree_step_notes, note_target_kind=\"tree_step\",\n                     note_target_id=\"\",\n                     note_redirect=f\"/v/{vin}/tree?codes={quote(codes)}\",\n                     note_kind_locked=False,\n                     bar=_vehicle_bar(vin, dossier), tab=\"tree\")\n    _set_active_vehicle(response, vin)\n    return response\n\n\ndef _live_observations_for(vin: str) -> tuple[list[dict[str, Any]], str | None]:\n    \"\"\"What the live link has recorded for this VIN, newest first.\n\n    Read-only against the observation store cuore.live already writes to on\n    every live read -- nothing here opens the adapter. A gate form with\n    nothing to show just means no live session has run for this car yet.\n    \"\"\"\n    try:\n        obs = live_ops.observations(n=20, vin=vin)[\"entries\"]\n        return list(reversed(obs)), None\n    except LiveError as exc:\n        return [], str(exc)\n\n\n@router.get(\"/v/{vin}/gate\", response_class=HTMLResponse)\ndef gate_form(request: Request, vin: str, codes: str = \"\") -> HTMLResponse:\n    \"\"\"The evidence gate, empty.\"\"\"\n    dossier = _dossier(vin)\n    if not codes.strip():\n        codes = \" \".join(mes_bridge.open_codes_for(dossier))\n    live_obs, live_obs_error = _live_observations_for(vin)\n    response = _page(request, \"gate.html\", vin=vin, result=None,\n                     form={\"codes\": codes, \"component\": \"\", \"mechanism\": \"\",\n                           \"disconfirming_test\": \"\"},\n                     rows=[{\"type\": \"actuator\"}],\n                     live_observations=live_obs, live_observations_error=live_obs_error,\n                     bar=_vehicle_bar(vin, dossier), tab=\"gate\")\n    _set_active_vehicle(response, vin)\n    return response\n\n\n@router.post(\"/v/{vin}/gate\", response_class=HTMLResponse)\nasync def gate_submit(request: Request, vin: str,\n                      codes: str = Form(default=\"\"),\n                      component: str = Form(default=\"\"),\n                      mechanism: str = Form(default=\"\"),\n                      disconfirming_test: str = Form(default=\"\")\n                      ) -> HTMLResponse:\n    \"\"\"Gate a proposed diagnosis. Writes nothing, to the car or the corpus.\n\n    Measurement rows arrive as parallel ``m_*`` fields rather than a JSON blob\n    so the form degrades without JavaScript -- this gets used on a tablet with\n    oily hands, and a page that needs a working script to submit is a page that\n    fails at the worst moment.\n    \"\"\"\n    form = await request.form()\n    rows: list[dict[str, Any]] = []\n    for i, mtype in enumerate(form.getlist(\"m_type\")):\n        def field(key: str) -> str:\n            return str(form.get(f\"m_{key}_{i}\", \"\")).strip()\n\n        row: dict[str, Any] = {\"type\": mtype}\n        if mtype == \"actuator\" and field(\"operation\"):\n            row[\"operation\"] = field(\"operation\")\n        elif mtype == \"freeze_frame\" and field(\"code\"):\n            row[\"code\"] = field(\"code\")\n        elif mtype == \"parameter\" and field(\"name\"):\n            row[\"name\"] = field(\"name\")\n            if field(\"file\"):\n                row[\"file\"] = field(\"file\")\n        elif mtype == \"recording_event\" and field(\"file\") and field(\"condition\"):\n            row[\"file\"] = field(\"file\")\n            row[\"condition\"] = field(\"condition\")\n        elif mtype == \"manual\" and field(\"description\"):\n            row[\"description\"] = field(\"description\")\n        elif mtype == \"live\" and field(\"kind\"):\n            # Verified against cuore.live's own observation record, not typed\n            # in -- the fields differ by kind, so only the ones that kind\n            # actually uses get carried into the citation.\n            row[\"kind\"] = field(\"kind\")\n            if row[\"kind\"] in (\"dtc\", \"permanent\", \"module_dtc\") and field(\"code\"):\n                row[\"code\"] = field(\"code\")\n            if row[\"kind\"] == \"readiness\" and field(\"monitor\"):\n                row[\"monitor\"] = field(\"monitor\")\n            if row[\"kind\"] in (\"module_dtc\", \"did\") and field(\"ecu\"):\n                row[\"ecu\"] = field(\"ecu\")\n            if row[\"kind\"] == \"did\" and field(\"did\"):\n                row[\"did\"] = field(\"did\")\n            if len(row) <= 2:   # kind + type only -- nothing to verify against\n                continue\n        else:\n            continue\n        rows.append(row)\n\n    result = mes_bridge.assess_verdict(\n        vin=vin, codes=codes, component=component, mechanism=mechanism,\n        measurements=json.dumps(rows) if rows else \"\",\n        disconfirming_test=disconfirming_test)\n\n    dossier = _dossier(vin)\n    live_obs, live_obs_error = _live_observations_for(vin)\n    response = _page(request, \"gate.html\", vin=vin, result=result,\n                     form={\"codes\": codes, \"component\": component,\n                           \"mechanism\": mechanism,\n                           \"disconfirming_test\": disconfirming_test},\n                     rows=rows or [{\"type\": \"actuator\"}],\n                     live_observations=live_obs, live_observations_error=live_obs_error,\n                     bar=_vehicle_bar(vin, dossier), tab=\"gate\")\n    _set_active_vehicle(response, vin)\n    return response\n\n\n@router.get(\"/modules\", response_class=HTMLResponse)\ndef modules(request: Request, domain: str = \"\", view: str = \"\") -> HTMLResponse:\n    \"\"\"The module registry, and which OBD bus each module lives on.\n\n    One page, two facets over the same overlap rather than two separately\n    designed tables that happened to describe the same parts. The default\n    view is the full 126-entry reference registry; the 5 rows with a\n    confirmed live address link straight to a read, the other 20 the live\n    link knows about but cannot yet address stay plain text. ``?view=live``\n    flips to the live link's own facet -- bus, 29-bit address, confidence,\n    whether this car has actually shown up carrying it -- over its full\n    25-entry table, each enriched with its registry domain and tier rather\n    than the live table needing to duplicate them.\n    \"\"\"\n    try:\n        live_rows = live_ops.modules()[\"modules\"]\n    except LiveError:\n        live_rows = []\n    # \"In the live table\" (25) is not \"can actually be read right now\" (5) --\n    # only the confirmed-address rows get a link that won't just refuse.\n    live_usable = {m[\"code\"].upper() for m in live_rows if m[\"usable\"]}\n    live_present = {m[\"code\"].upper() for m in live_rows if m.get(\"present\") == \"confirmed\"}\n\n    if view == \"live\":\n        enriched = []\n        for m in live_rows:\n            try:\n                info = mes_bridge.module_registry(abbrev=m[\"code\"])\n            except BridgeError:\n                info = {}\n            enriched.append({**m, \"domain\": info.get(\"domain\"), \"tier\": info.get(\"tier\"),\n                             \"aliases\": info.get(\"aliases\")})\n        data = {\"view_rows\": sorted(enriched, key=lambda r: r[\"code\"])}\n    else:\n        data = mes_bridge.module_registry(domain=domain)\n\n    return _page(request, \"modules.html\", data=data, domain=domain, view=view,\n                 live_usable=live_usable, live_present=live_present)\n\n\n@router.get(\"/recordings\", response_class=HTMLResponse)\ndef recordings(request: Request) -> HTMLResponse:\n    return _page(request, \"recordings.html\",\n                 data=mes_bridge.list_recordings())\n\n\n@router.get(\"/recording/{name}\", response_class=HTMLResponse)\ndef recording(request: Request, name: str, condition: str = \"\") -> HTMLResponse:\n    \"\"\"One recording, with optional threshold analysis over it.\"\"\"\n    data = mes_bridge.read_recording(name, preview_rows=15)\n    events = None\n    events_error = None\n    try:\n        events = mes_bridge.recording_events(name, condition=condition)\n    except BridgeError as exc:\n        events_error = str(exc)\n    return _page(request, \"recording.html\", name=name, data=data,\n                 events=events, events_error=events_error,\n                 condition=condition)\n\n\n@router.get(\"/logs\", response_class=HTMLResponse)\ndef logs(request: Request, vin: str = \"\", kind: str = \"\",\n         include_simulation: bool = False) -> HTMLResponse:\n    \"\"\"The raw index. Provenance is a column, not a footnote.\"\"\"\n    data = mes_bridge.list_logs(vin=vin, kind=kind, limit=200,\n                                include_simulation=include_simulation)\n    return _page(request, \"logs.html\", data=data, vin=vin, kind=kind,\n                 include_simulation=include_simulation)\n\n\n# --- live link --------------------------------------------------------------\n#\n# Every value below comes from cuore.live.ops, the same functions the MCP\n# tools call. This module never opens the adapter itself and never bypasses\n# the ops-layer safety gates (cable declaration, bus verification, the\n# transmit-confirmation flag) -- it only decides how to *render* what those\n# gates say, including turning a refusal into guidance instead of a 500.\n#\n# The UI adds one gate of its own, stricter than the live layer's: reading a\n# module on CAN-CH or CAN-IHS always shows a confirm checkbox here, even\n# though only CAN-CH is flagged transmit_needs_confirmation in cuore.live.buses\n# -- both carry chassis/body modules this bench UI treats as sensitive.\n\n\ndef _live_snapshot() -> dict[str, Any]:\n    \"\"\"The always-shown facts: adapter status, cable/bus state, module table.\n\n    Each call is independently wrapped -- one failing (say, no port\n    configured) must not blank the other two panels.\n    \"\"\"\n    out: dict[str, Any] = {}\n    try:\n        out[\"status\"] = live_ops.status()\n        out[\"status_error\"] = None\n    except LiveError as exc:\n        out[\"status\"] = None\n        out[\"status_error\"] = str(exc)\n    try:\n        out[\"cable_data\"] = live_ops.buses()\n        out[\"cable_error\"] = None\n    except LiveError as exc:\n        out[\"cable_data\"] = None\n        out[\"cable_error\"] = str(exc)\n    try:\n        out[\"module_rows\"] = live_ops.modules()[\"modules\"]\n        out[\"module_error\"] = None\n    except LiveError as exc:\n        out[\"module_rows\"] = []\n        out[\"module_error\"] = str(exc)\n    return out\n\n\ndef _live_page(request: Request, vin: str = \"\", **extra: Any) -> HTMLResponse:\n    active = _active_vehicle(request, vin)\n    ctx = _live_snapshot()\n    ctx[\"pin_1_9_warning\"] = PIN_1_9_WARNING\n    ctx[\"can_ch_note\"] = BUSES[\"can_ch\"].notes\n    ctx[\"can_ihs_note\"] = BUSES[\"can_ihs\"].notes\n    ctx[\"active_vehicle\"] = _active_vehicle_bar(active)\n    # This page already shows the live state in full below the fold; the\n    # header strip would only repeat it.\n    ctx[\"live_strip\"] = None\n    ctx.update(extra)\n    return _page(request, \"live.html\", **ctx)\n\n\n@router.get(\"/live\", response_class=HTMLResponse)\ndef live_page(request: Request, cable_error: str = \"\", vin: str = \"\") -> HTMLResponse:\n    \"\"\"Adapter status, cable declaration, bus map, module table and OBD.\"\"\"\n    # Only override the snapshot's cable_error when the redirect carried one;\n    # passing None here would erase a real bus-state failure.\n    extra = {\"cable_error\": cable_error} if cable_error else {}\n    return _live_page(request, vin=vin, **extra)\n\n\n@router.post(\"/live/vehicle/clear\", response_class=HTMLResponse)\ndef live_clear_vehicle() -> RedirectResponse:\n    \"\"\"Stop tagging live reads against a vehicle. Just the one cookie.\"\"\"\n    resp = RedirectResponse(url=\"/live\", status_code=303)\n    resp.delete_cookie(_VIN_COOKIE)\n    return resp\n\n\n@router.post(\"/live/cable\", response_class=HTMLResponse)\ndef live_set_cable(cable: str = Form(...)) -> RedirectResponse:\n    \"\"\"Declare the fitted cable, then redirect back (GET/POST/redirect, no JS needed).\"\"\"\n    try:\n        live_ops.set_cable(cable)\n    except LiveError as exc:\n        return RedirectResponse(url=f\"/live?cable_error={quote(str(exc))}\",\n                                status_code=303)\n    return RedirectResponse(url=\"/live\", status_code=303)\n\n\n@router.post(\"/live/verify\", response_class=HTMLResponse)\ndef live_verify(request: Request, bus: str = Form(...),\n                seconds: float = Form(default=2.0)) -> HTMLResponse:\n    \"\"\"Passive listen on one bus; rendered inline rather than a redirect so\n    the frame count and IDs seen are not lost.\"\"\"\n    try:\n        result = live_ops.verify_bus(bus, seconds=seconds)\n        error = None\n    except LiveError as exc:\n        result = None\n        error = str(exc)\n    return _live_page(request, verify_bus_key=bus, verify_result=result,\n                      verify_error=error)\n\n\n@router.post(\"/live/probe\", response_class=HTMLResponse)\ndef live_probe(request: Request) -> HTMLResponse:\n    \"\"\"Reset the adapter and read its identity. Holds nothing afterwards.\"\"\"\n    try:\n        result = live_ops.probe()\n        error = None\n    except LiveError as exc:\n        result = None\n        error = str(exc)\n    return _live_page(request, probe_result=result, probe_error=error)\n\n\n_OBD_ACTIONS: dict[str, Any] = {\n    \"dtcs\": live_ops.obd_all_dtcs,\n    \"readiness\": live_ops.obd_readiness,\n    \"vin\": live_ops.obd_vin,\n    \"voltage\": live_ops.obd_voltage,\n}\n\n\n@router.post(\"/live/obd/{kind}\", response_class=HTMLResponse)\ndef live_obd(request: Request, kind: str) -> HTMLResponse:\n    \"\"\"Legislated OBD on CAN-C: DTCs, readiness, VIN or battery voltage.\n\n    These are Mode 01/02/03/07/09/0A reads, need no cable/verification gate\n    and no confirm checkbox -- CAN-C carries no chassis-safety module and the\n    live layer itself never lets a write reach the wire from here.\n    \"\"\"\n    fn = _OBD_ACTIONS.get(kind)\n    if fn is None:\n        return _live_page(request, obd_kind=kind, obd_result=None,\n                          obd_error=f\"unknown legislated-OBD action {kind!r}\")\n    try:\n        result = fn()\n        error = None\n    except LiveError as exc:\n        result = None\n        error = str(exc)\n    return _live_page(request, obd_kind=kind, obd_result=result, obd_error=error)\n\n\n@router.get(\"/live/module/{code}\", response_class=HTMLResponse)\ndef live_module(request: Request, code: str, confirm: bool = False,\n                vin: str = \"\") -> HTMLResponse:\n    \"\"\"One module's UDS DTCs and Annex C identity.\n\n    A refusal from the live layer (unverified bus, unknown module, MES\n    holding the adapter) is guidance here, not an error page -- this is the\n    single most likely outcome on a bench that has not yet declared a cable\n    or run a passive listen.\n\n    Tags both reads with the active vehicle (``?vin=``, else the dossier's\n    cookie) so they land as observations the evidence gate can find and so\n    address confirmations persist per VIN, instead of every live read being\n    anonymous until a VIN happens to be read back from the wire.\n    \"\"\"\n    code = code.strip()\n    active_vin = _active_vehicle(request, vin)\n    try:\n        rows = live_ops.modules()[\"modules\"]\n    except LiveError:\n        rows = []\n    row = next((m for m in rows if m[\"code\"].upper() == code.upper()), None)\n    bus_key = row[\"bus\"] if row else None\n    needs_confirm = bus_key in (\"can_ch\", \"can_ihs\")\n\n    dtcs = identity = None\n    dtcs_error = identity_error = None\n    if needs_confirm and not confirm:\n        dtcs_error = identity_error = (\n            f\"module {code.upper()} lives on {bus_key}, which this bench UI treats as \"\n            f\"sensitive (chassis/body). Tick 'confirm' and read again. This is in addition \"\n            f\"to whatever cuore.live itself enforces for that bus.\")\n    else:\n        try:\n            dtcs = live_ops.module_dtcs(code, vin=active_vin, confirm=confirm)\n        except LiveError as exc:\n            dtcs_error = str(exc)\n        try:\n            identity = live_ops.module_identity(code, vin=active_vin, confirm=confirm)\n        except LiveError as exc:\n            identity_error = str(exc)\n\n    return _page(request, \"live_module.html\", code=code.upper(), confirm=confirm,\n                 row=row, bus_key=bus_key, needs_confirm=needs_confirm,\n                 dtcs=dtcs, dtcs_error=dtcs_error,\n                 identity=identity, identity_error=identity_error,\n                 pin_1_9_warning=PIN_1_9_WARNING, live_strip=None,\n                 active_vehicle=_active_vehicle_bar(active_vin))\n\n\n# --- whole-car coverage --------------------------------------------------------\n\ndef _coverage_page(request: Request, error: str = \"\", refused: bool = False,\n                   vin: str = \"\") -> HTMLResponse:\n    from ..live import coverage as cov\n    from ..live.buses import CABLES\n    try:\n        st = live_ops.coverage_status()\n        cable = live_ops.cable_state()[\"cable\"]\n    except LiveError as exc:\n        st, cable, error = {\"active\": False, \"passes\": []}, \"unknown\", str(exc)\n    return _page(request, \"coverage.html\", st=st, cable=cable, cables=CABLES,\n                 pass_by_key=cov.PASS_BY_KEY, error=error, refused=refused,\n                 vin=vin or _active_vehicle(request))\n\n\ndef _coverage_do(request: Request, fn: Any) -> HTMLResponse:\n    from ..live.errors import Refused\n    try:\n        fn()\n    except Refused as exc:\n        return _coverage_page(request, error=str(exc), refused=True)\n    except LiveError as exc:\n        return _coverage_page(request, error=str(exc))\n    return RedirectResponse(url=\"/coverage\", status_code=303)\n\n\n@router.get(\"/coverage\", response_class=HTMLResponse)\ndef coverage_page(request: Request, vin: str = \"\") -> HTMLResponse:\n    \"\"\"Guided three-pass, three-bus scan with the bystander diff.\"\"\"\n    return _coverage_page(request, vin=vin)\n\n\n@router.post(\"/coverage/start\", response_class=HTMLResponse)\ndef coverage_start(request: Request, vin: str = Form(...),\n                   engine_running: bool = Form(default=False)) -> HTMLResponse:\n    return _coverage_do(request, lambda: live_ops.coverage_start(vin.strip(),\n                                                                 engine_running=engine_running))\n\n\n@router.post(\"/coverage/cable\", response_class=HTMLResponse)\ndef coverage_cable(request: Request, cable: str = Form(...)) -> HTMLResponse:\n    return _coverage_do(request, lambda: live_ops.set_cable(cable))\n\n\n@router.post(\"/coverage/run\", response_class=HTMLResponse)\ndef coverage_run(request: Request, key: str = Form(...),\n                 confirm: bool = Form(default=False)) -> HTMLResponse:\n    return _coverage_do(request, lambda: live_ops.coverage_run(key, confirm=confirm))\n\n\n@router.post(\"/coverage/skip\", response_class=HTMLResponse)\ndef coverage_skip(request: Request, key: str = Form(...),\n                  reason: str = Form(default=\"\")) -> HTMLResponse:\n    return _coverage_do(request, lambda: live_ops.coverage_skip(key, reason))\n\n\n@router.post(\"/coverage/reset\", response_class=HTMLResponse)\ndef coverage_reset(request: Request) -> HTMLResponse:\n    return _coverage_do(request, live_ops.coverage_reset)\n\n\n@router.get(\"/v/{vin}/live-vs-log\", response_class=HTMLResponse)\ndef live_vs_log(request: Request, vin: str, module: str = \"\") -> HTMLResponse:\n    \"\"\"Newest MES log vs newest live UDS read, one row per code, per module.\"\"\"\n    dossier = _dossier(vin)\n    result = mes_bridge.live_vs_log(vin, module=module)\n    response = _page(request, \"live_vs_log.html\", vin=vin, result=result,\n                     module=module, bar=_vehicle_bar(vin, dossier),\n                     tab=\"live_vs_log\")\n    _set_active_vehicle(response, vin)\n    return response\n\n\n# --- dealer (wiTECH) results -------------------------------------------------\n#\n# wiTECH has no API; the owner's dealer account is read by a technician on\n# wiTECH's own screens, and the result is typed in here to become evidence\n# the gate, the fault tree and the dossier can all cite. This page writes only\n# to the dealer results store -- never to the car, never to the MES corpus.\n\n\n@router.get(\"/v/{vin}/dealer\", response_class=HTMLResponse)\ndef dealer_form(request: Request, vin: str) -> HTMLResponse:\n    \"\"\"The dealer results page, with whatever has been recorded so far.\"\"\"\n    dossier = _dossier(vin)\n    results = mes_bridge.dealer_results(vin)[\"results\"]\n    response = _page(request, \"dealer.html\", vin=vin, results=results, error=None,\n                     bar=_vehicle_bar(vin, dossier), tab=\"dealer\")\n    _set_active_vehicle(response, vin)\n    return response\n\n\n@router.post(\"/v/{vin}/dealer\", response_class=HTMLResponse)\nasync def dealer_submit(request: Request, vin: str) -> HTMLResponse:\n    \"\"\"Record one technician-entered wiTECH result.\n\n    One shared endpoint for all five kinds, distinguished by a ``kind`` hidden\n    field on each of the page's small per-kind forms -- this keeps the page\n    working with no JavaScript, and matches how ``/gate`` handles measurement\n    rows.\n    \"\"\"\n    form = await request.form()\n    kind = str(form.get(\"kind\", \"\")).strip()\n    note = str(form.get(\"note\", \"\")).strip()\n\n    def field(name: str) -> str:\n        return str(form.get(name, \"\")).strip()\n\n    data: dict[str, Any] = {}\n    if kind == \"flash_check\":\n        data = {\"module\": field(\"module\") or \"ECM\",\n                \"current_part\": field(\"current_part\"),\n                \"new_part\": field(\"new_part\"),\n                \"flashed\": form.get(\"flashed\") == \"on\"}\n        if field(\"part_after\"):\n            data[\"part_after\"] = field(\"part_after\")\n    elif kind == \"slvt\":\n        data = {\"result\": field(\"result\"), \"detail\": field(\"detail\")}\n    elif kind == \"dtc_report\":\n        data = {\"module\": field(\"module\"),\n                \"codes\": [c.strip() for c in field(\"codes\").split(\",\") if c.strip()],\n                \"note\": field(\"dtc_note\")}\n    elif kind == \"recall_status\":\n        data = {\"campaign\": field(\"campaign\"), \"status\": field(\"status\"),\n                \"date\": field(\"date\")}\n    elif kind == \"routine\":\n        data = {\"module\": field(\"module\"), \"name\": field(\"name\"),\n                \"result\": field(\"result\")}\n\n    error = None\n    try:\n        mes_bridge.dealer_record(vin, kind, data, note=note)\n    except BridgeError as exc:\n        error = str(exc)\n\n    dossier = _dossier(vin)\n    results = mes_bridge.dealer_results(vin)[\"results\"]\n    response = _page(request, \"dealer.html\", vin=vin, results=results, error=error,\n                     bar=_vehicle_bar(vin, dossier), tab=\"dealer\")\n    _set_active_vehicle(response, vin)\n    return response\n\n\n# --- technician notes -------------------------------------------------------\n#\n# Context on anything cuore found that lives nowhere else -- \"purge valve\n# replaced by me 2026-09-10\", \"this scan was taken right after a battery\n# disconnect\", \"smoke test done at 0.5 psi, no leak\" -- and that a diagnosis\n# (and the LLM reading it) must be able to see. Same posture as the dealer\n# results store above: append-only, never touches the car or the MES corpus.\n\n\ndef _safe_redirect(url: str, fallback: str) -> str:\n    \"\"\"Only ever redirect somewhere inside this app -- ``redirect_to`` is a\n    hidden form field a client controls, not a trusted URL.\"\"\"\n    if url.startswith(\"/\") and not url.startswith(\"//\"):\n        return url\n    return fallback\n\n\n@router.get(\"/v/{vin}/notes\", response_class=HTMLResponse)\ndef notes_page(request: Request, vin: str, target_kind: str = \"\",\n              target_id: str = \"\") -> HTMLResponse:\n    \"\"\"Every technician note for this vehicle, with edit/hide and a filter.\"\"\"\n    dossier = _dossier(vin)\n    rows = mes_bridge.notes(vin, target_kind=target_kind, target_id=target_id)[\"notes\"]\n    response = _page(request, \"notes.html\", vin=vin, notes_list=rows,\n                     filter_target_kind=target_kind, filter_target_id=target_id,\n                     note_target_kind=target_kind or \"vehicle\",\n                     note_target_id=target_id, note_redirect=f\"/v/{vin}/notes\",\n                     note_kind_locked=False,\n                     bar=_vehicle_bar(vin, dossier), tab=\"notes\")\n    _set_active_vehicle(response, vin)\n    return response\n\n\n@router.post(\"/v/{vin}/notes\", response_class=HTMLResponse)\nasync def notes_add(request: Request, vin: str) -> RedirectResponse:\n    \"\"\"Record one technician note, then redirect back to wherever the add\n    form was posted from -- the dossier, a code page, the tree, or this\n    vehicle's own notes listing.\"\"\"\n    form = await request.form()\n    redirect_to = _safe_redirect(str(form.get(\"redirect_to\", \"\")), f\"/v/{vin}/notes\")\n    tags = [t.strip() for t in str(form.get(\"tags\", \"\")).split(\",\") if t.strip()]\n    mes_bridge.add_note(vin, str(form.get(\"text\", \"\")),\n                        target_kind=str(form.get(\"target_kind\", \"vehicle\")),\n                        target_id=str(form.get(\"target_id\", \"\")),\n                        author=str(form.get(\"author\", \"\")).strip() or \"technician\",\n                        tags=tags)\n    return RedirectResponse(url=redirect_to, status_code=303)\n\n\n@router.post(\"/v/{vin}/notes/{id}/edit\", response_class=HTMLResponse)\nasync def notes_edit(request: Request, vin: str, id: str) -> RedirectResponse:\n    \"\"\"Amend a note's text. Writes an amendment record -- never rewrites history.\"\"\"\n    form = await request.form()\n    redirect_to = _safe_redirect(str(form.get(\"redirect_to\", \"\")), f\"/v/{vin}/notes\")\n    mes_bridge.edit_note(id, str(form.get(\"text\", \"\")))\n    return RedirectResponse(url=redirect_to, status_code=303)\n\n\n@router.post(\"/v/{vin}/notes/{id}/hide\", response_class=HTMLResponse)\nasync def notes_hide(request: Request, vin: str, id: str) -> RedirectResponse:\n    \"\"\"Hide a note (soft delete). Writes a hide record -- never rewrites history.\"\"\"\n    form = await request.form()\n    redirect_to = _safe_redirect(str(form.get(\"redirect_to\", \"\")), f\"/v/{vin}/notes\")\n    mes_bridge.hide_note(id)\n    return RedirectResponse(url=redirect_to, status_code=303)\n","numLines":875,"startLine":1,"totalLines":875}},"sourceToolAssistantUUID":"3d55b6d1-30db-4476-add7-08feb01618a2","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
