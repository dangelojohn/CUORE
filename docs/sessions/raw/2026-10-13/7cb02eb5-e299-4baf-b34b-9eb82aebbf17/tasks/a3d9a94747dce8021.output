{"parentUuid":"685ba4a7-f280-478f-b4a1-022cde33251e","isSidechain":true,"promptId":"1812edd3-f8bc-4768-a948-8fb9b39ae280","agentId":"a3d9a94747dce8021","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01C9RYXr8Gsf8UyACm1jXHes","type":"tool_result","content":"400\t            elm = _ELM_EQUIVALENT.get(route.stn_protocol)\n401\t            if elm is None or route.bitrate_override:\n402\t                raise LinkUnavailable(\n403\t                    f\"bus {sess.bus.key} via route {route.stn_protocol} needs an STN adapter; \"\n404\t                    f\"this adapter identifies as {self.identity.get('ATI', 'unknown')}\")\n405\t            sess.cmd(f\"ATSP{elm}\", 2)\n406\t        sess.headers_on = True\n407\t\n408\t    def _probe_identity(self, sess: Session) -> None:\n409\t        ident: dict[str, str] = {}\n410\t        for c in (\"ATI\", \"AT@1\", \"STI\", \"STDI\", \"STMFR\", \"STSN\"):\n411\t            r = sess.cmd(c, 2)\n412\t            if r and r != \"?\" and not adapter_error(r):\n413\t                ident[c] = r\n414\t        self.identity = ident\n415\t        self.is_stn = \"STI\" in ident\n416\t\n417\t    # --- reporting ------------------------------------------------------\n418\t\n419\t    def adapter_info(self) -> dict[str, Any]:\n420\t        \"\"\"The ``AdapterInfo`` fields for ``/api/capabilities``, never raising.\"\"\"\n421\t        try:\n422\t            port, _ = resolve_port()\n423\t            blocked = interlock.blocked_by()\n424\t            return {\"present\": bool(port) and blocked is None, \"port\": port,\n425\t                    \"blocked_by\": blocked,\n426\t                    \"note\": (\"port opened per operation; \" +\n427\t                             (f\"adapter {self.identity.get('STDI') or self.identity.get('ATI')}\"\n428\t                              if self.identity else \"adapter not probed yet\"))}\n429\t        except Exception as e:  # pragma: no cover - defensive\n430\t            return {\"present\": False, \"port\": None, \"blocked_by\": None, \"note\": str(e)}\n431\t\n432\t    def status(self) -> dict[str, Any]:\n433\t        port, psrc = resolve_port()\n434\t        baud, bsrc = resolve_baud()\n435\t        return {\n436\t            \"port\": port, \"port_source\": psrc, \"baud\": baud, \"baud_source\": bsrc,\n437\t            \"adapter_identity\": self.identity or None, \"is_stn\": self.is_stn,\n438\t            \"last_open\": self.last_open, \"last_error\": self.last_error,\n439\t            \"mes\": interlock.mes_status(), \"lock\": interlock.read_lock(),\n440\t            \"lock_path\": str(interlock.lock_path()),\n441\t            \"cable\": self.cable_state(), \"vin\": self.vin or None,\n442\t            \"note\": \"the port is opened per operation and released after each call\",\n443\t        }\n444\t\n445\t\n446\t_LINK: Optional[AdapterLink] = None\n447\t_LINK_LOCK = threading.Lock()\n448\t\n449\t\n450\tdef link() -> AdapterLink:\n451\t    \"\"\"The process-wide link, created on first use.\"\"\"\n452\t    global _LINK\n453\t    with _LINK_LOCK:\n454\t        if _LINK is None:\n455\t            _LINK = AdapterLink()\n456\t        return _LINK\n457\t\n458\t\n459\tdef set_link(new: AdapterLink) -> None:\n460\t    \"\"\"Replace the process-wide link (tests inject a playback-backed one).\"\"\"\n461\t    global _LINK\n462\t    with _LINK_LOCK:\n463\t        _LINK = new\n464\t\n465\t\n466\t__all__ = [\"DEFAULT_TIMEOUT\", \"clamp_timeout\", \"Session\", \"AdapterLink\", \"link\", \"set_link\"]\n467\t"}]},"uuid":"42f3e43f-c12c-4c6c-9897-3f8b55bc69a4","timestamp":"2026-10-08T01:23:26.192Z","toolUseResult":{"type":"text","file":{"filePath":"C:\\Users\\User\\mcp-servers\\cuore\\live\\transport.py","content":"            elm = _ELM_EQUIVALENT.get(route.stn_protocol)\n            if elm is None or route.bitrate_override:\n                raise LinkUnavailable(\n                    f\"bus {sess.bus.key} via route {route.stn_protocol} needs an STN adapter; \"\n                    f\"this adapter identifies as {self.identity.get('ATI', 'unknown')}\")\n            sess.cmd(f\"ATSP{elm}\", 2)\n        sess.headers_on = True\n\n    def _probe_identity(self, sess: Session) -> None:\n        ident: dict[str, str] = {}\n        for c in (\"ATI\", \"AT@1\", \"STI\", \"STDI\", \"STMFR\", \"STSN\"):\n            r = sess.cmd(c, 2)\n            if r and r != \"?\" and not adapter_error(r):\n                ident[c] = r\n        self.identity = ident\n        self.is_stn = \"STI\" in ident\n\n    # --- reporting ------------------------------------------------------\n\n    def adapter_info(self) -> dict[str, Any]:\n        \"\"\"The ``AdapterInfo`` fields for ``/api/capabilities``, never raising.\"\"\"\n        try:\n            port, _ = resolve_port()\n            blocked = interlock.blocked_by()\n            return {\"present\": bool(port) and blocked is None, \"port\": port,\n                    \"blocked_by\": blocked,\n                    \"note\": (\"port opened per operation; \" +\n                             (f\"adapter {self.identity.get('STDI') or self.identity.get('ATI')}\"\n                              if self.identity else \"adapter not probed yet\"))}\n        except Exception as e:  # pragma: no cover - defensive\n            return {\"present\": False, \"port\": None, \"blocked_by\": None, \"note\": str(e)}\n\n    def status(self) -> dict[str, Any]:\n        port, psrc = resolve_port()\n        baud, bsrc = resolve_baud()\n        return {\n            \"port\": port, \"port_source\": psrc, \"baud\": baud, \"baud_source\": bsrc,\n            \"adapter_identity\": self.identity or None, \"is_stn\": self.is_stn,\n            \"last_open\": self.last_open, \"last_error\": self.last_error,\n            \"mes\": interlock.mes_status(), \"lock\": interlock.read_lock(),\n            \"lock_path\": str(interlock.lock_path()),\n            \"cable\": self.cable_state(), \"vin\": self.vin or None,\n            \"note\": \"the port is opened per operation and released after each call\",\n        }\n\n\n_LINK: Optional[AdapterLink] = None\n_LINK_LOCK = threading.Lock()\n\n\ndef link() -> AdapterLink:\n    \"\"\"The process-wide link, created on first use.\"\"\"\n    global _LINK\n    with _LINK_LOCK:\n        if _LINK is None:\n            _LINK = AdapterLink()\n        return _LINK\n\n\ndef set_link(new: AdapterLink) -> None:\n    \"\"\"Replace the process-wide link (tests inject a playback-backed one).\"\"\"\n    global _LINK\n    with _LINK_LOCK:\n        _LINK = new\n\n\n__all__ = [\"DEFAULT_TIMEOUT\", \"clamp_timeout\", \"Session\", \"AdapterLink\", \"link\", \"set_link\"]\n","numLines":68,"startLine":400,"totalLines":467}},"sourceToolAssistantUUID":"685ba4a7-f280-478f-b4a1-022cde33251e","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
