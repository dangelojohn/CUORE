{"parentUuid":"9d230204-56db-4496-9142-0ccb77c2d7c9","isSidechain":true,"agentId":"a3d9a94747dce8021","message":{"model":"claude-sonnet-5","id":"msg_011CfotfwHLgv54iJti4peXN","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01MZcjyXA3RoJehQwtR989Te","name":"Read","input":{"file_path":"C:\\Users\\User\\mcp-servers\\cuore\\api\\deps.py"},"caller":{"type":"direct"}}],"container":null,"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":6002,"cache_read_input_tokens":58188,"output_tokens":351,"output_tokens_details":{"thinking_tokens":140},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":0,"ephemeral_5m_input_tokens":6002},"inference_geo":"not_available","iterations":[{"input_tokens":2,"output_tokens":351,"cache_read_input_tokens":58188,"cache_creation_input_tokens":6002,"cache_creation":{"ephemeral_5m_input_tokens":6002,"ephemeral_1h_input_tokens":0},"type":"message"}],"speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_01MZcjyXA3RoJehQwtR989Te":{"file_path":"C:\\Users\\User\\mcp-servers\\cuore\\api\\deps.py"}},"serverClassifierRequest":"efc63701-8194-4295-aa70-a3d921fc4d91","apiBlockIndex":3,"requestId":"req_011Cfotfw2xfzQi1ort8MHMt","attributionAgent":"general-purpose","type":"assistant","uuid":"ef61b899-e84c-4d6f-aefe-be2d5d888397","timestamp":"2026-10-08T01:20:26.401Z","effort":"high","perTurnEffort":null,"userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
{"parentUuid":"ef61b899-e84c-4d6f-aefe-be2d5d888397","isSidechain":true,"promptId":"b723ad4b-041a-4b34-81b4-19c48a5dd259","agentId":"a3d9a94747dce8021","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01MZcjyXA3RoJehQwtR989Te","type":"tool_result","content":"1\t\"\"\"Shared route dependencies.\n2\t\n3\tAuth here is a single shared token, and that is the right amount for T1 and T2:\n4\tone shop, one LAN, devices the owner controls. It exists because the moment\n5\t``host`` is widened past loopback every device on the network can read a corpus\n6\tcontaining customer VINs -- so there has to be *something*, and something\n7\tsimple that gets used beats something proper that gets disabled.\n8\t\n9\tWhen the token is unset, auth is off. That is safe paired with the loopback\n10\tdefault and is checked at startup, which warns if the two disagree.\n11\t\"\"\"\n12\t\n13\tfrom __future__ import annotations\n14\t\n15\timport hmac\n16\t\n17\tfrom fastapi import Header, HTTPException, Query, Request\n18\t\n19\tfrom ..config import Settings\n20\t\n21\t\n22\tdef settings_of(request: Request) -> Settings:\n23\t    \"\"\"The live settings object, stashed on app state at startup.\"\"\"\n24\t    return request.app.state.settings\n25\t\n26\t\n27\tasync def require_token(\n28\t    request: Request,\n29\t    x_cuore_token: str | None = Header(default=None),\n30\t    token: str | None = Query(default=None,\n31\t                              description=\"Alternative to the header, for \"\n32\t                                          \"links opened on a tablet.\"),\n33\t) -> None:\n34\t    \"\"\"Reject the request unless it carries the configured token.\n35\t\n36\t    A no-op when no token is configured. Compared with\n37\t    :func:`hmac.compare_digest` so a wrong guess takes the same time as a\n38\t    right one.\n39\t    \"\"\"\n40\t    expected = settings_of(request).token.strip()\n41\t    if not expected:\n42\t        return\n43\t    offered = (x_cuore_token or token or \"\").strip()\n44\t    if not offered or not hmac.compare_digest(offered, expected):\n45\t        raise HTTPException(\n46\t            status_code=401,\n47\t            detail=\"missing or incorrect token\",\n48\t            headers={\"WWW-Authenticate\": \"Token\"},\n49\t        )\n50\t"}]},"uuid":"42f9d80d-a508-40e3-946e-71c7821d3330","timestamp":"2026-10-08T01:20:26.425Z","toolUseResult":{"type":"text","file":{"filePath":"C:\\Users\\User\\mcp-servers\\cuore\\api\\deps.py","content":"\"\"\"Shared route dependencies.\n\nAuth here is a single shared token, and that is the right amount for T1 and T2:\none shop, one LAN, devices the owner controls. It exists because the moment\n``host`` is widened past loopback every device on the network can read a corpus\ncontaining customer VINs -- so there has to be *something*, and something\nsimple that gets used beats something proper that gets disabled.\n\nWhen the token is unset, auth is off. That is safe paired with the loopback\ndefault and is checked at startup, which warns if the two disagree.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport hmac\n\nfrom fastapi import Header, HTTPException, Query, Request\n\nfrom ..config import Settings\n\n\ndef settings_of(request: Request) -> Settings:\n    \"\"\"The live settings object, stashed on app state at startup.\"\"\"\n    return request.app.state.settings\n\n\nasync def require_token(\n    request: Request,\n    x_cuore_token: str | None = Header(default=None),\n    token: str | None = Query(default=None,\n                              description=\"Alternative to the header, for \"\n                                          \"links opened on a tablet.\"),\n) -> None:\n    \"\"\"Reject the request unless it carries the configured token.\n\n    A no-op when no token is configured. Compared with\n    :func:`hmac.compare_digest` so a wrong guess takes the same time as a\n    right one.\n    \"\"\"\n    expected = settings_of(request).token.strip()\n    if not expected:\n        return\n    offered = (x_cuore_token or token or \"\").strip()\n    if not offered or not hmac.compare_digest(offered, expected):\n        raise HTTPException(\n            status_code=401,\n            detail=\"missing or incorrect token\",\n            headers={\"WWW-Authenticate\": \"Token\"},\n        )\n","numLines":50,"startLine":1,"totalLines":50}},"sourceToolAssistantUUID":"ef61b899-e84c-4d6f-aefe-be2d5d888397","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
{"parentUuid":"9d230204-56db-4496-9142-0ccb77c2d7c9","isSidechain":true,"promptId":"b723ad4b-041a-4b34-81b4-19c48a5dd259","agentId":"a3d9a94747dce8021","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01PgCSYaxcpdkbPLKAt1sXxM","type":"tool_result","content":"1\t\"\"\"The operations both surfaces call: HTTP routes and MCP tools are wrappers over these.\n2\t\n3\tEvery function returns a plain dict, opens the adapter for exactly its own\n4\toperation through :func:`link`, and names the bus and cable it used. Errors\n5\tare :class:`LiveError` subclasses; the surfaces decide how to render them.\n6\t\"\"\"\n7\t\n8\tfrom __future__ import annotations\n9\t\n10\timport re\n11\tfrom datetime import datetime\n12\tfrom pathlib import Path\n13\tfrom typing import Any, Optional\n14\t\n15\timport serial.tools.list_ports\n16\t\n17\tfrom . import capture as capture_mod\n18\tfrom . import store\n19\tfrom . import uds as uds_mod\n20\tfrom .addressing import MODULES, by_code, on_bus\n21\tfrom .buses import BUSES, CAN_C, Bus, routes_for\n22\tfrom .config import mes_folders, mes_interfaces, mes_registry, resolve_port\n23\tfrom .errors import BadCommand, LiveError, Refused\n24\tfrom .framing import adapter_error, no_data\n25\tfrom .obd import (decode_obd_dtcs, decode_pid, decode_readiness, decode_supported_pids,\n26\t                  dtc_from_two_bytes, evap_verdict, resolve_pid, PIDS_BY_HEX)\n27\tfrom .transport import DEFAULT_TIMEOUT, AdapterLink, Session, link\n28\t\n29\t_MODE03_NOTE = (\"Mode 03 returns emissions-related powertrain codes only. Body, chassis and \"\n30\t                \"network faults are UDS 3-byte codes; use module DTC reads for those.\")\n31\t\n32\t\n33\tdef _bus(key: str) -> Bus:\n34\t    bus = BUSES.get((key or \"can_c\").lower())\n35\t    if bus is None:\n36\t        raise BadCommand(f\"unknown bus {key!r}; one of {list(BUSES)}\")\n37\t    return bus\n38\t\n39\t\n40\tdef _stamp(sess: Session, out: dict[str, Any]) -> dict[str, Any]:\n41\t    out.setdefault(\"bus\", sess.bus.key)\n42\t    out.setdefault(\"cable\", sess.link.cable)\n43\t    auto = getattr(sess, \"auto_verified\", None)\n44\t    if auto:\n45\t        out.setdefault(\"auto_verified\", auto)\n46\t    return out\n47\t\n48\t\n49\tdef _observe(sess: Session, kind: str, out: dict[str, Any], vin: str = \"\") -> dict[str, Any]:\n50\t    \"\"\"Stamp and persist a result as an observation the evidence gate can cite.\"\"\"\n51\t    _stamp(sess, out)\n52\t    v = vin or getattr(sess.link, \"vin\", \"\") or \"\"\n53\t    store.record_observation(kind, out, vin=v, bus=sess.bus.key, cable=sess.link.cable,\n54\t                             stream=sess.stream.describe)\n55\t    return out\n56\t\n57\t\n58\t# --- status and configuration -------------------------------------------------\n59\t\n60\tdef status() -> dict[str, Any]:\n61\t    return link().status()\n62\t\n63\t\n64\tdef ports() -> dict[str, Any]:\n65\t    mes_port = (mes_registry().get(\"Interface 0 Port\") or \"\").upper()\n66\t    found = [{\"device\": p.device, \"description\": p.description, \"hwid\": p.hwid,\n67\t              \"mes_interface_0\": p.device.upper() == mes_port}\n68\t             for p in serial.tools.list_ports.comports()]\n69\t    return {\"ports\": found, \"mes_port\": mes_port or None}\n70\t\n71\t\n72\tdef mes_settings() -> dict[str, Any]:\n73\t    reg = mes_registry()\n74\t    if not reg:\n75\t        return {\"error\": \"HKLM\\\\SOFTWARE\\\\Multiecuscan not found\"}\n76\t    return {\"interfaces\": mes_interfaces(reg), \"folders\": mes_folders(reg),\n77\t            \"last_selection\": reg.get(\"Last Selection\"),\n78\t            \"recent_vehicles\": reg.get(\"Recent Vehicles\"),\n79\t            \"ui_language\": reg.get(\"UI Language\"), \"data_language\": reg.get(\"Data Language\"),\n80\t            \"all_keys\": sorted(reg.keys())}\n81\t\n82\t\n83\tdef set_cable(cable: str) -> dict[str, Any]:\n84\t    return link().set_cable(cable)\n85\t\n86\t\n87\tdef cable_state() -> dict[str, Any]:\n88\t    return link().cable_state()\n89\t\n90\t\n91\tdef buses() -> dict[str, Any]:\n92\t    st = link().cable_state()\n93\t    return {\"cable\": st[\"cable\"], \"buses\": st[\"buses\"]}\n94\t\n95\t\n96\tdef modules(bus: Optional[str] = None) -> dict[str, Any]:\n97\t    rows = on_bus(_bus(bus).key) if bus else list(MODULES)\n98\t    return {\"modules\": [{\n99\t        \"code\": m.code, \"name\": m.name, \"bus\": m.bus_key, \"bus_confidence\": m.bus_confidence,\n100\t        \"target\": None if m.target is None else f\"{m.target:02X}\",\n101\t        \"request\": m.request_hex, \"response\": m.response_hex,\n102\t        \"confidence\": m.confidence.value, \"usable\": m.usable, \"present\": m.present,\n103\t        \"source\": m.source, \"hazard\": m.hazard, \"note\": m.note,\n104\t    } for m in rows]}\n105\t\n106\t\n107\t# --- probe and verification --------------------------------------------------\n108\t\n109\tdef probe(port: str = \"\", baud: int = 0, allow_while_mes_connected: bool = False) -> dict[str, Any]:\n110\t    \"\"\"Reset the adapter, read its identity, report vehicle power. Holds nothing.\"\"\"\n111\t    lk = link()\n112\t    lk.identity = {}\n113\t    with lk.session(\"probe\", bus=CAN_C, port=port, baud=baud, passive=True,\n114\t                    allow_while_mes_connected=allow_while_mes_connected) as sess:\n115\t        out: dict[str, Any] = {\"port\": lk.port, \"port_source\": lk.port_source,\n116\t                               \"baud\": lk.baud, \"baud_source\": lk.baud_source,\n117\t                               \"identity\": lk.identity, \"stn_chip\": lk.is_stn}\n118\t        volts = sess.cmd(\"ATRV\", 2)\n119\t        m = re.search(r\"(\\d+\\.\\d+)V\", volts)\n120\t        out[\"battery_voltage\"] = float(m.group(1)) if m else None\n121\t        out[\"vehicle_power_detected\"] = bool(m)\n122\t        if lk.is_stn:\n123\t            out[\"protocol\"] = sess.cmd(\"STPRS\", 2)\n124\t        if not m:\n125\t            out[\"note\"] = (\"no vehicle voltage at the adapter: not plugged into the car or \"\n126\t                           \"ignition off\")\n127\t        out[\"port_held\"] = False\n128\t        return _stamp(sess, out)\n129\t\n130\t\n131\tdef verify_bus(bus: str, seconds: float = 2.0, port: str = \"\", baud: int = 0,\n132\t               allow_while_mes_connected: bool = False) -> dict[str, Any]:\n133\t    \"\"\"Passive listen; marks the bus verified under the current cable if traffic is seen.\n134\t\n135\t    A bus can be reachable under more than one adapter protocol -- CAN-C\n136\t    carries both 29-bit UDS and the 11-bit legislated pair, and a monitor\n137\t    opened for one ID width hears nothing of the other. Every route the\n138\t    declared cable allows is tried before reporting silence, because a healthy\n139\t    bus reported as dead is the worst answer this tool can give.\n140\t    \"\"\"\n141\t    b = _bus(bus)\n142\t    lk = link()\n143\t    candidates: list[Any] = list(routes_for(b, lk.cable)) or [None]\n144\t    attempts: list[dict[str, Any]] = []\n145\t    sess = None\n146\t    for route in candidates:\n147\t        with lk.session(\"verify_bus\", bus=b, port=port, baud=baud, passive=True,\n148\t                        allow_while_mes_connected=allow_while_mes_connected,\n149\t                        route=route) as sess:\n150\t            cap = capture_mod.listen(sess, seconds=seconds, max_frames=200)\n151\t            # \"DATA ERROR\" is the adapter's per-frame annotation for one frame\n152\t            # whose payload did not validate; with parsed frames beside it the\n153\t            # bus is demonstrably alive, so it is reported but does not veto.\n154\t            fatal = cap[\"error\"] and not (cap[\"error\"] == \"DATA ERROR\" and cap[\"count\"] > 0)\n155\t            ok = cap[\"count\"] > 0 and not fatal\n156\t            attempts.append({\"stn_protocol\": sess.route.stn_protocol,\n157\t                             \"header_bits\": sess.header_bits,\n158\t                             \"frames\": cap[\"count\"], \"error\": cap[\"error\"],\n159\t                             \"ids\": cap[\"ids\"]})\n160\t            if ok:\n161\t                lk.mark_verified(b, cap[\"count\"])\n162\t                return _stamp(sess, {\"verified\": True, \"frames\": cap[\"count\"],\n163\t                                     \"rate_hz\": cap[\"rate_hz\"], \"ids\": cap[\"ids\"],\n164\t                                     \"error\": cap[\"error\"],\n165\t                                     \"stn_protocol\": sess.route.stn_protocol,\n166\t                                     \"header_bits\": sess.header_bits,\n167\t                                     \"attempts\": attempts, \"note\": None})\n168\t    tried = \", \".join(f\"STP {a['stn_protocol']} ({a['header_bits']}-bit)\" for a in attempts)\n169\t    return _stamp(sess, {\"verified\": False, \"frames\": 0, \"rate_hz\": 0.0, \"ids\": {},\n170\t                         \"error\": attempts[-1][\"error\"] if attempts else None,\n171\t                         \"attempts\": attempts,\n172\t                         \"note\": (f\"no traffic on {b.key} with cable {lk.cable!r} on any route \"\n173\t                                  f\"tried ({tried}); check the cable, ignition, and the route \"\n174\t                                  f\"note: {sess.route.note}\")})\n175\t\n176\t\n177\tdef capture(bus: str, seconds: float = 2.0, max_frames: int = 500,\n178\t            filters: Optional[list[str]] = None, include_frames: bool = True,\n179\t            allow_while_mes_connected: bool = False) -> dict[str, Any]:\n180\t    b = _bus(bus)\n181\t    with link().session(\"capture\", bus=b, passive=True,\n182\t                        allow_while_mes_connected=allow_while_mes_connected) as sess:\n183\t        cap = capture_mod.listen(sess, seconds=seconds, max_frames=max_frames, filters=filters)\n184\t        if not include_frames:\n185\t            cap[\"frames\"] = cap[\"frames\"][:20]\n186\t            cap[\"frames_truncated\"] = True\n187\t        return _stamp(sess, cap)\n188\t\n189\t\n190\t# --- legislated OBD on CAN-C -------------------------------------------------\n191\t\n192\tdef _obd_route() -> Any:\n193\t    \"\"\"The 11-bit legislated route on CAN-C, when the cable allows one.\n194\t\n195\t    Giorgio ECMs serve Modes 01/03/07/0A only on the 11-bit 7DF/7E8 pair; the\n196\t    29-bit UDS address answers every legislated request with NRC 0x11\n197\t    (serviceNotSupported), which read as silence until 2026-09-25.\n198\t    \"\"\"\n199\t    for route in routes_for(CAN_C, link().cable):\n200\t        if route.stn_protocol == \"33\":\n201\t            return route\n202\t    return None\n203\t\n204\t\n205\tdef _obd_session(purpose: str, **kw: Any):\n206\t    kw.setdefault(\"route\", _obd_route())\n207\t    return link().session(purpose, bus=CAN_C, **kw)\n208\t\n209\t\n210\tdef _negative_responses(q: dict[str, Any]) -> list[str]:\n211\t    \"\"\"Human-readable NRC lines for every ECU that answered 7F.\"\"\"\n212\t    from .uds import NRC_TEXT as NRC  # local: keep the OBD path free of the UDS client\n213\t    lines: list[str] = []\n214\t    for hdr, data in (q.get(\"all_ecus\") or {}).items():\n215\t        if len(data) >= 3 and data[0].upper() == \"7F\":\n216\t            nrc = int(data[2], 16)\n217\t            lines.append(f\"ECU {hdr} answered NRC 0x{nrc:02X} \"\n218\t                         f\"({NRC.get(nrc, 'unknown')}) to service {data[1]}\")\n219\t    return lines\n220\t\n221\t\n222\tdef _silence_reason(sess: Session) -> str:\n223\t    \"\"\"Why no ECU answered, judged from the voltage at the OBD port.\n224\t\n225\t    \"With the ignition off this is expected\" was printed on 2026-09-25 while\n226\t    the port read 14.1 V with the engine running; the real cause was the\n227\t    adapter's bus access. Charging voltage rules the ignition out.\n228\t    \"\"\"\n229\t    try:\n230\t        raw = sess.cmd(\"ATRV\", 2)\n231\t    except Exception:  # noqa: BLE001 -- the explanation must never fail the read\n232\t        raw = \"\"\n233\t    m = re.search(r\"(\\d+\\.\\d+)V\", raw or \"\")\n234\t    if not m:\n235\t        return (\"no vehicle voltage at the adapter: it is not plugged into the car, or the \"\n236\t                \"car is fully off\")\n237\t    v = float(m.group(1))\n238\t    if v >= 13.3:\n239\t        return (f\"the port reads {v:.1f} V, so the engine is running: the ignition does NOT \"\n240\t                f\"explain the silence. Check the adapter's bus access: HS/MS switch on HS, \"\n241\t                f\"plug fully seated, no coloured cable fitted for CAN-C\")\n242\t    if v < 11.0:\n243\t        return f\"the port reads {v:.1f} V: the battery is low enough for modules to drop out\"\n244\t    return (f\"the port reads {v:.1f} V: the ignition may be off. Turn it ON and retry; if it \"\n245\t            f\"is already on, check the HS/MS switch and that the plug is fully seated\")\n246\t\n247\t\n248\tdef _dtc_read(sess: Session, mode: str, response_byte: str, label: str) -> dict[str, Any]:\n249\t    sess.untarget()\n250\t    q = sess.query(mode, response_byte)\n251\t    out: dict[str, Any] = {\"kind\": label, \"raw\": q[\"raw\"]}\n252\t    if q[\"error\"]:\n253\t        out[\"error\"] = (f\"ADAPTER/BUS ERROR: {q['error']}. This is NOT 'no codes'; the read did \"\n254\t                        f\"not complete.\")\n255\t        return _stamp(sess, out)\n256\t    per_ecu = {hdr: decode_obd_dtcs(data) for hdr, data in q[\"ecus\"].items()}\n257\t    out[\"dtcs\"] = sorted({c for codes in per_ecu.values() for c in codes})\n258\t    out[\"by_ecu\"] = per_ecu\n259\t    if not q[\"ecus\"]:\n260\t        neg = _negative_responses(q)\n261\t        if neg:\n262\t            out[\"warning\"] = (\"negative response, not silence: \" + \"; \".join(neg) +\n263\t                              \". The service is refused on this route/session, so the \"\n264\t                              \"read did NOT complete.\")\n265\t        else:\n266\t            out[\"warning\"] = (\"no ECU answered\" + (\" (NO DATA)\" if no_data(q[\"raw\"]) else \"\") +\n267\t                              \"; \" + _silence_reason(sess))\n268\t    if label == \"stored\" and not out[\"dtcs\"]:\n269\t        out[\"note\"] = _MODE03_NOTE\n270\t    return _observe(sess, \"obd_dtcs\", out)\n271\t\n272\t\n273\t_KINDS = {\"stored\": (\"03\", \"43\"), \"pending\": (\"07\", \"47\"), \"permanent\": (\"0A\", \"4A\")}\n274\t\n275\t\n276\tdef obd_dtcs(kind: str = \"stored\", **kw: Any) -> dict[str, Any]:\n277\t    if kind not in _KINDS:\n278\t        raise BadCommand(f\"kind must be one of {list(_KINDS)}\")\n279\t    mode, resp = _KINDS[kind]\n280\t    with _obd_session(f\"read_{kind}_dtcs\", **kw) as sess:\n281\t        return _dtc_read(sess, mode, resp, kind)\n282\t\n283\t\n284\tdef obd_all_dtcs(**kw: Any) -> dict[str, Any]:\n285\t    with _obd_session(\"read_all_dtcs\", **kw) as sess:\n286\t        return _stamp(sess, {k: _dtc_read(sess, m, r, k) for k, (m, r) in _KINDS.items()})\n287\t\n288\t\n289\tdef obd_pid(pid: str, **kw: Any) -> dict[str, Any]:\n290\t    hex_pid, spec = resolve_pid(pid)\n291\t    with _obd_session(\"read_pid\", **kw) as sess:\n292\t        sess.untarget()\n293\t        q = sess.query(f\"01{hex_pid}\", \"41\")\n294\t        out: dict[str, Any] = {\"pid\": hex_pid, \"name\": spec.name if spec else None, \"raw\": q[\"raw\"]}\n295\t        if q[\"error\"]:\n296\t            out[\"error\"] = f\"ADAPTER/BUS ERROR: {q['error']}; the read did not complete\"\n297\t            return _stamp(sess, out)\n298\t        readings = {hdr: decode_pid(hex_pid, spec, data[2:])\n299\t                    for hdr, data in q[\"ecus\"].items() if len(data) >= 2 and data[1] == hex_pid}\n300\t        out[\"by_ecu\"] = readings\n301\t        first = next(iter(readings.values()), None)\n302\t        if first is not None:\n303\t            out[\"value\"], out[\"unit\"] = first.get(\"value\"), first.get(\"unit\")\n304\t        else:\n305\t            out[\"warning\"] = \"no ECU answered this PID; \" + _silence_reason(sess)\n306\t        return _stamp(sess, out)\n307\t\n308\t\n309\tdef obd_voltage(**kw: Any) -> dict[str, Any]:\n310\t    with link().session(\"read_voltage\", bus=CAN_C, passive=True, **kw) as sess:\n311\t        r = sess.cmd(\"ATRV\", 2)\n312\t        m = re.search(r\"(\\d+\\.\\d+)V\", r)\n313\t        return _stamp(sess, {\"raw\": r, \"volts\": float(m.group(1)) if m else None,\n314\t                             \"vehicle_power_detected\": bool(m)})\n315\t\n316\t\n317\tdef obd_supported_pids(**kw: Any) -> dict[str, Any]:\n318\t    with _obd_session(\"read_supported_pids\", **kw) as sess:\n319\t        sess.untarget()\n320\t        out: dict[str, Any] = {\"by_ecu\": {}, \"raw\": {}}\n321\t        for base in (\"00\", \"20\", \"40\", \"60\", \"80\", \"A0\", \"C0\"):\n322\t            q = sess.query(f\"01{base}\", \"41\")\n323\t            out[\"raw\"][base] = q[\"raw\"]\n324\t            if q[\"error\"]:\n325\t                out.setdefault(\"errors\", {})[base] = q[\"error\"]\n326\t                break\n327\t            any_next = False\n328\t            for hdr, data in q[\"ecus\"].items():\n329\t                if len(data) < 6 or data[1] != base:\n330\t                    continue\n331\t                supported, more = decode_supported_pids(base, data[2:6])\n332\t                out[\"by_ecu\"].setdefault(hdr, []).extend(supported)\n333\t                any_next = any_next or more\n334\t            if not any_next:\n335\t                break\n336\t        for hdr, lst in out[\"by_ecu\"].items():\n337\t            out[\"by_ecu\"][hdr] = {\"count\": len(lst), \"pids\": lst,\n338\t                                  \"known_names\": [PIDS_BY_HEX[p].name for p in lst if p in PIDS_BY_HEX]}\n339\t        return _stamp(sess, out)\n340\t\n341\t\n342\tdef obd_freeze_frame(pid: str = \"\", **kw: Any) -> dict[str, Any]:\n343\t    hex_pid, spec = resolve_pid(pid) if pid.strip() else (\"02\", None)\n344\t    with _obd_session(\"read_freeze_frame\", **kw) as sess:\n345\t        sess.untarget()\n346\t        q = sess.query(f\"02{hex_pid}00\", \"42\")\n347\t        out: dict[str, Any] = {\"pid\": hex_pid, \"name\": spec.name if spec else None, \"raw\": q[\"raw\"]}\n348\t        if q[\"error\"]:\n349\t            out[\"error\"] = f\"ADAPTER/BUS ERROR: {q['error']}; the read did not complete\"\n350\t            return _stamp(sess, out)\n351\t        by_ecu: dict[str, Any] = {}\n352\t        for hdr, data in q[\"ecus\"].items():\n353\t            if len(data) < 3 or data[1] != hex_pid:\n354\t                continue\n355\t            payload = data[3:]\n356\t            if hex_pid == \"02\":\n357\t                code = dtc_from_two_bytes(payload[0], payload[1]) if len(payload) >= 2 else None\n358\t                by_ecu[hdr] = {\"dtc\": code, \"bytes\": payload}\n359\t            else:\n360\t                by_ecu[hdr] = decode_pid(hex_pid, spec, payload)\n361\t        out[\"by_ecu\"] = by_ecu\n362\t        if not by_ecu:\n363\t            out[\"warning\"] = \"no ECU returned a freeze frame (none stored, or ignition off)\"\n364\t        return _stamp(sess, out)\n365\t\n366\t\n367\tdef obd_vin(**kw: Any) -> dict[str, Any]:\n368\t    with _obd_session(\"read_vin\", **kw) as sess:\n369\t        sess.untarget()\n370\t        q = sess.query(\"0902\", \"49\", 6)\n371\t        out: dict[str, Any] = {\"raw\": q[\"raw\"]}\n372\t        if q[\"error\"]:\n373\t            out[\"error\"] = f\"ADAPTER/BUS ERROR: {q['error']}; the read did not complete\"\n374\t            return _stamp(sess, out)\n375\t        for hdr, data in q[\"ecus\"].items():\n376\t            if len(data) >= 3 and data[1] == \"02\":\n377\t                vin = \"\".join(chr(int(b, 16)) for b in data[3:] if 32 <= int(b, 16) < 127)\n378\t                out.update({\"vin\": vin, \"ecu\": hdr, \"length_ok\": len(vin) == 17})\n379\t                if len(vin) == 17:\n380\t                    sess.link.vin = vin\n381\t                break\n382\t        if \"vin\" not in out:\n383\t            out[\"warning\"] = \"no ECU answered Mode 09 PID 02; \" + _silence_reason(sess)\n384\t        return _stamp(sess, out)\n385\t\n386\t\n387\tdef readiness_in(sess: Session) -> dict[str, Any]:\n388\t    sess.untarget()\n389\t    out: dict[str, Any] = {}\n390\t    for pid, label in ((\"01\", \"since_clear\"), (\"41\", \"this_drive_cycle\")):\n391\t        q = sess.query(f\"01{pid}\", \"41\")\n392\t        if q[\"error\"]:\n393\t            out[label] = {\"error\": q[\"error\"], \"raw\": q[\"raw\"]}\n394\t            continue\n395\t        decoded = None\n396\t        for hdr, data in q[\"ecus\"].items():\n397\t            decoded = decode_readiness(data, \"41\")\n398\t            if decoded:\n399\t                decoded[\"ecu\"] = hdr\n400\t                break\n401\t        neg = _negative_responses(q) if not decoded else []\n402\t        out[label] = decoded or {\"error\": (\"negative response: \" + \"; \".join(neg)) if neg\n403\t                                 else \"could not decode readiness response\", \"raw\": q[\"raw\"]}\n404\t        if not decoded and not neg and no_data(q[\"raw\"]):\n405\t            out[label][\"why\"] = _silence_reason(sess)\n406\t    verdict = evap_verdict(out.get(\"since_clear\") or {})\n407\t    if verdict:\n408\t        out[\"evap_verdict\"] = verdict\n409\t    counters: dict[str, Any] = {}\n410\t    for name, hex_pid in ((\"warmups_since_clear\", \"30\"), (\"distance_since_clear\", \"31\")):\n411\t        q = sess.query(f\"01{hex_pid}\", \"41\")\n412\t        if q[\"error\"]:\n413\t            continue\n414\t        for _hdr, data in q[\"ecus\"].items():\n415\t            if len(data) >= 3 and data[1] == hex_pid:\n416\t                dec = decode_pid(hex_pid, PIDS_BY_HEX[hex_pid], data[2:])\n417\t                if \"value\" in dec:\n418\t                    counters[name] = dec[\"value\"]\n419\t                break\n420\t    if counters:\n421\t        out[\"drive_cycle_counters\"] = counters\n422\t    return _observe(sess, \"readiness\", out)\n423\t\n424\t\n425\tdef obd_readiness(**kw: Any) -> dict[str, Any]:\n426\t    with _obd_session(\"read_readiness\", **kw) as sess:\n427\t        return readiness_in(sess)\n428\t\n429\t\n430\t# --- UDS on any bus ----------------------------------------------------------\n431\t\n432\tdef _compact_dtc_result(mod: dict[str, Any]) -> dict[str, Any]:\n433\t    \"\"\"Summarise one module's UDS DTC read for ``detail=False`` callers.\n434\t\n435\t    A UDS 0x19 02 reply lists every code the module TRACKS, not every code\n436\t    that is failing -- the ECM alone tracks 278 and reports all of them. Most\n437\t    callers only need what is wrong now, so this keeps the status/metadata\n438\t    fields and collapses the ``dtcs`` list to active/history counts plus the\n439\t    full records for the active codes only. :func:`coverage.classify_records`\n440\t    already does the status-byte classification for the coverage sweep; it is\n441\t    reused here rather than re-implemented so the two summaries never drift\n442\t    out of sync with what the status bits mean.\n443\t    \"\"\"\n444\t    from . import coverage\n445\t    out = {k: mod[k] for k in\n446\t           (\"ecu\", \"bus\", \"mask\", \"error\", \"nrc\", \"warning\", \"note\", \"skipped\")\n447\t           if k in mod}\n448\t    if \"dtcs\" not in mod:\n449\t        return out\n450\t    records = mod.get(\"dtcs\") or []\n451\t    cls = coverage.classify_records(records)\n452\t    active_set = set(cls[\"active\"])\n453\t    out[\"active\"] = cls[\"active\"]\n454\t    out[\"history\"] = cls[\"history\"]\n455\t    out[\"tracked\"] = cls[\"tracked\"]\n456\t    out[\"not_run_since_clear\"] = cls[\"not_run_since_clear\"]\n457\t    out[\"active_records\"] = [r for r in records if r.get(\"code\") in active_set]\n458\t    return out\n459\t\n460\t\n461\tdef module_dtcs(code: str, vin: str = \"\", mask: int = 0xFF, confirm: bool = False,\n462\t                detail: bool = True, **kw: Any) -> dict[str, Any]:\n463\t    \"\"\"UDS 0x19 02 on one module. ``detail=False`` summarises the DTC list --\n464\t    see :func:`_compact_dtc_result`. The FULL result is always what gets\n465\t    recorded as the observation; only the returned value is ever summarised.\n466\t    \"\"\"\n467\t    ecu = uds_mod.resolve_module(code, vin or None)\n468\t    with link().session(f\"module_dtcs {ecu.code}\", bus=_bus(ecu.bus_key), confirm=confirm,\n469\t                        **kw) as sess:\n470\t        full = _observe(sess, \"module_dtcs\", uds_mod.read_dtcs(sess, ecu, mask), vin)\n471\t        return full if detail else _compact_dtc_result(full)\n472\t\n473\t\n474\tdef module_identity(code: str, vin: str = \"\", confirm: bool = False, **kw: Any) -> dict[str, Any]:\n475\t    ecu = uds_mod.resolve_module(code, vin or None)\n476\t    with link().session(f\"module_identity {ecu.code}\", bus=_bus(ecu.bus_key), confirm=confirm,\n477\t                        **kw) as sess:\n478\t        out = uds_mod.identity(sess, ecu)\n479\t        f190 = (out.get(\"fields\") or {}).get(\"F190\") or {}\n480\t        if f190.get(\"ascii\") and len(f190[\"ascii\"]) == 17:\n481\t            sess.link.vin = f190[\"ascii\"]\n482\t        return _observe(sess, \"identity\", out, vin)\n483\t\n484\t\n485\tdef module_did(code: str, did: str, vin: str = \"\", confirm: bool = False, **kw: Any\n486\t               ) -> dict[str, Any]:\n487\t    ecu = uds_mod.resolve_module(code, vin or None)\n488\t    try:\n489\t        did_int = int(did, 16)\n490\t    except ValueError:\n491\t        raise BadCommand(f\"did must be hex, got {did!r}\")\n492\t    if not 0 <= did_int <= 0xFFFF:\n493\t        raise BadCommand(\"did must be 0000..FFFF\")\n494\t    with link().session(f\"module_did {ecu.code} {did_int:04X}\", bus=_bus(ecu.bus_key),\n495\t                        confirm=confirm, **kw) as sess:\n496\t        return _observe(sess, \"did\", uds_mod.read_did(sess, ecu, did_int), vin)\n497\t\n498\t\n499\tdef scan_modules(bus: str = \"can_c\", vin: str = \"\", mask: int = 0xFF, confirm: bool = False,\n500\t                 detail: bool = True, **kw: Any) -> dict[str, Any]:\n501\t    \"\"\"UDS DTC sweep over every confirmed module on a bus. ``detail=False``\n502\t    summarises each module's DTC list -- see :func:`_compact_dtc_result`. The\n503\t    FULL scan, and the FULL per-module result, are what get recorded as\n504\t    observations; only the returned value is ever summarised.\n505\t    \"\"\"\n506\t    b = _bus(bus)\n507\t    with link().session(f\"scan_modules {b.key}\", bus=b, confirm=confirm, **kw) as sess:\n508\t        out = _observe(sess, \"scan\", uds_mod.scan_bus(sess, b, vin or None, mask), vin)\n509\t        for mod in out.get(\"modules\", []):\n510\t            if \"codes\" in mod:\n511\t                store.record_observation(\"module_dtcs\", mod,\n512\t                                         vin=vin or getattr(sess.link, \"vin\", \"\"),\n513\t                                         bus=b.key, cable=sess.link.cable,\n514\t                                         stream=sess.stream.describe)\n515\t        if not detail:\n516\t            out = {**out, \"modules\": [_compact_dtc_result(m) for m in out.get(\"modules\", [])]}\n517\t        return out\n518\t\n519\t\n520\tdef discover(bus: str = \"can_c\", vin: str = \"\", confirm: bool = False,\n521\t             candidates: Optional[list[str]] = None, per_target_timeout: float = 0.25,\n522\t             stop_after: Optional[int] = None, **kw: Any) -> dict[str, Any]:\n523\t    b = _bus(bus)\n524\t    cands = None\n525\t    if candidates:\n526\t        try:\n527\t            cands = [int(c, 16) for c in candidates]\n528\t        except ValueError:\n529\t            raise BadCommand(\"candidates must be hex target bytes\")\n530\t    with link().session(f\"discover {b.key}\", bus=b, confirm=confirm, **kw) as sess:\n531\t        return _stamp(sess, uds_mod.discover(sess, b, vin_expected=vin or None,\n532\t                                             candidates=cands,\n533\t                                             per_target_timeout=per_target_timeout,\n534\t                                             stop_after=stop_after))\n535\t\n536\t\n537\tdef observations(n: int = 50, vin: str = \"\", kind: str = \"\") -> dict[str, Any]:\n538\t    return {\"path\": str(store.observations_path()),\n539\t            \"entries\": store.recent_observations(n, vin=vin, kind=kind)}\n540\t\n541\t\n542\t# --- repair verification --------------------------------------------------------\n543\t\n544\tdef repair_status(codes: list[str], module: str = \"ECM\", vin: str = \"\",\n545\t                  read: bool = True, confirm: bool = False) -> dict[str, Any]:\n546\t    \"\"\"Has each named test re-run since the clear, and did it pass?\n547\t\n548\t    ``read=True`` reads the module now (0x19 02 FF); either way the answer\n549\t    carries a timeline from every earlier real read of this module for this\n550\t    VIN, so progress is visible drive by drive.\n551\t    \"\"\"\n552\t    from datetime import datetime\n553\t    from . import repair\n554\t    if not [c for c in codes if c.strip()]:\n555\t        raise BadCommand(\"name at least one code, e.g. P0455,P0456,P0440\")\n556\t    out: dict[str, Any] = {\"module\": module.upper(), \"vin\": vin or None}\n557\t    if read:\n558\t        now = module_dtcs(module, vin=vin, confirm=confirm)\n559\t        answered = not now.get(\"error\") and now.get(\"codes\") is not None\n560\t        out[\"read_at\"] = datetime.now().isoformat(timespec=\"seconds\")\n561\t        out[\"read_problem\"] = now.get(\"error\") or now.get(\"warning\") or None\n562\t        out.update(repair.assess(codes, now.get(\"dtcs\") or [], answered))\n563\t    history = ([o for o in store.recent_observations(1000, vin=vin, kind=\"module_dtcs\")\n564\t                if store.is_from_car(o)] if vin else [])\n565\t    out[\"timeline\"] = repair.timeline(codes, history, module)\n566\t    if not vin:\n567\t        out[\"timeline_note\"] = \"pass vin to see earlier reads of this car\"\n568\t    return out\n569\t\n570\t\n571\t# --- deeper reads: Mode $06, DTC detail -----------------------------------------\n572\t\n573\tdef obd_mode06(mids: Optional[list[str]] = None, **kw: Any) -> dict[str, Any]:\n574\t    \"\"\"OBD Mode $06 on-board test results, with the EVAP tests summarised.\"\"\"\n575\t    from . import mode06\n576\t    with _obd_session(\"read_mode06\", **kw) as sess:\n577\t        out = mode06.read_mode06(sess, mids=[m.upper() for m in mids] if mids else None)\n578\t        out[\"evap_summary\"] = mode06.evap_summary(out)\n579\t        return _observe(sess, \"mode06\", out)\n580\t\n581\t\n582\tdef module_dtc_detail(code: str, dtc: str, vin: str = \"\", confirm: bool = False,\n583\t                      **kw: Any) -> dict[str, Any]:\n584\t    \"\"\"Status, snapshot records and extended data (counters) for one code on one module.\"\"\"\n585\t    from . import dtc_detail\n586\t    ecu = uds_mod.resolve_module(code, vin or None)\n587\t    with link().session(f\"dtc_detail {ecu.code} {dtc}\", bus=_bus(ecu.bus_key), confirm=confirm,\n588\t                        **kw) as sess:\n589\t        return _observe(sess, \"dtc_detail\", dtc_detail.dtc_detail(sess, ecu, dtc), vin)\n590\t\n591\t\n592\tdef module_dtc_count(code: str, vin: str = \"\", mask: int = 0xFF, confirm: bool = False,\n593\t                     **kw: Any) -> dict[str, Any]:\n594\t    from . import dtc_detail\n595\t    ecu = uds_mod.resolve_module(code, vin or None)\n596\t    with link().session(f\"dtc_count {ecu.code}\", bus=_bus(ecu.bus_key), confirm=confirm,\n597\t                        **kw) as sess:\n598\t        return _stamp(sess, dtc_detail.dtc_count(sess, ecu, mask))\n599\t\n600\t\n601\tdef module_read_all(code: str, vin: str = \"\", include_unverified: bool = True,\n602\t                    confirm: bool = False, **kw: Any) -> dict[str, Any]:\n603\t    \"\"\"Identity plus every catalogued identifier for one module, decoded where known.\"\"\"\n604\t    from . import readall\n605\t    ecu = uds_mod.resolve_module(code, vin or None)\n606\t    with link().session(f\"read_all {ecu.code}\", bus=_bus(ecu.bus_key), confirm=confirm,\n607\t                        **kw) as sess:\n608\t        return _observe(sess, \"read_all\", readall.read_all(sess, ecu, include_unverified), vin)\n609\t\n610\t\n611\tdef module_discover_dids(code: str, vin: str = \"\", ranges: Optional[list[str]] = None,\n612\t                         max_dids: int = 2000, confirm: bool = False, **kw: Any\n613\t                         ) -> dict[str, Any]:\n614\t    \"\"\"Read-only 0x22 sweep for identifiers the catalogue does not know.\n615\t\n616\t    ``ranges`` like [\"F180-F1FF\", \"1000-10FF\"]; default is the module's conservative set.\n617\t    \"\"\"\n618\t    from . import readall\n619\t    ecu = uds_mod.resolve_module(code, vin or None)\n620\t    rng = None\n621\t    if ranges:\n622\t        rng = []\n623\t        for r in ranges:\n624\t            a, _, b = r.partition(\"-\")\n625\t            rng.append((int(a, 16), int(b or a, 16)))\n626\t    with link().session(f\"discover_dids {ecu.code}\", bus=_bus(ecu.bus_key), confirm=confirm,\n627\t                        **kw) as sess:\n628\t        args = {\"max_dids\": max_dids}\n629\t        if rng is not None:\n630\t            args[\"ranges\"] = rng\n631\t        return _observe(sess, \"did_discovery\", readall.discover_dids(sess, ecu, **args), vin)\n632\t\n633\t\n634\t# --- clearing (the one write): per module, evidence first --------------------------\n635\t\n636\tdef clear_module_dtcs(code: str, consent: str, vin: str = \"\", confirm: bool = False,\n637\t                      group: str = \"FFFFFF\", override_speed_check: bool = False,\n638\t                      **kw: Any) -> dict[str, Any]:\n639\t    \"\"\"Clear one module's DTCs after capturing evidence. Not exposed over HTTP.\n640\t\n641\t    Refuses unless ``consent`` is exactly ``CLEAR <MODULE>``, the vehicle reads\n642\t    stationary (or ``override_speed_check`` is set because speed cannot be read),\n643\t    and, on CAN-CH, ``confirm`` is given.\n644\t    \"\"\"\n645\t    from . import clear as clear_mod\n646\t    ecu = uds_mod.resolve_module(code, vin or None)\n647\t    clear_mod.assert_clear_allowed(ecu.code, consent, group)   # fail fast, before any traffic\n648\t    speed = None\n649\t    try:\n650\t        sp = obd_pid(\"0D\", **kw)\n651\t        if sp.get(\"value\") is not None:\n652\t            speed = float(sp[\"value\"])\n653\t    except LiveError:\n654\t        speed = None\n655\t    if speed is None and not override_speed_check:\n656\t        raise Refused(\"could not read vehicle speed; refusing to clear. Pass \"\n657\t                      \"override_speed_check=True only if the car is stationary.\")\n658\t    if speed:\n659\t        raise Refused(f\"vehicle speed reads {speed:g} km/h; refusing to clear while moving\")\n660\t    with link().session(f\"clear {ecu.code}\", bus=_bus(ecu.bus_key), confirm=confirm,\n661\t                        **kw) as sess:\n662\t        out = clear_mod.clear_module(sess, ecu, consent=consent, vin=vin, group=group,\n663\t                                     evidence_extra={\"vehicle_speed_kmh\": speed})\n664\t        return _stamp(sess, out)\n665\t\n666\t\n667\t# --- passive learning from a dealer tool ---------------------------------------------\n668\t\n669\tdef learn_capture(bus: str = \"can_c\", seconds: float = 20.0, max_frames: int = 20000\n670\t                  ) -> dict[str, Any]:\n671\t    \"\"\"Passive capture while wiTECH reads; saves frames and the UDS transactions found.\"\"\"\n672\t    import json as _json\n673\t    from . import learn\n674\t    from .config import state_dir\n675\t    cap = capture(bus, seconds=seconds, max_frames=max_frames, include_frames=True)\n676\t    frames = cap.get(\"frames\") or []\n677\t    trans = learn.uds_transactions(frames)\n678\t    d = state_dir() / \"captures\"\n679\t    d.mkdir(parents=True, exist_ok=True)\n680\t    name = f\"{datetime.now().strftime('%Y%m%d-%H%M%S')}_{bus}.json\"\n681\t    (d / name).write_text(_json.dumps({\"bus\": bus, \"frames\": frames, \"transactions\": trans},\n682\t                                      default=str), encoding=\"utf-8\")\n683\t    dids = sorted({(t.get(\"target\"), t.get(\"did\")) for t in trans if t.get(\"did\")})\n684\t    return {\"capture\": name, \"frames\": len(frames), \"transactions\": len(trans),\n685\t            \"dids_seen\": [{\"target\": a, \"did\": b} for a, b in dids],\n686\t            \"error\": cap.get(\"error\")}\n687\t\n688\t\n689\tdef learn_correlate(capture_name: str, marks: list[dict[str, Any]]) -> dict[str, Any]:\n690\t    \"\"\"Rank identifiers whose values track what the technician saw in wiTECH.\"\"\"\n691\t    import json as _json\n692\t    from . import learn\n693\t    from .config import state_dir\n694\t    p = state_dir() / \"captures\" / Path(capture_name).name\n695\t    if not p.exists():\n696\t        raise BadCommand(f\"no capture named {capture_name!r}\")\n697\t    data = _json.loads(p.read_text(encoding=\"utf-8\"))\n698\t    series = learn.did_series(data.get(\"transactions\") or [])\n699\t    ranked = learn.correlate(series, marks)\n700\t    return {\"capture\": p.name, \"candidates\": ranked[:15]}\n701\t\n702\t\n703\tdef learn_accept(vin: str, module_code: str, did: str, name: str, field: dict[str, Any],\n704\t                 scale: Optional[float] = None, offset: Optional[float] = None,\n705\t                 unit: Optional[str] = None, evidence: Optional[Any] = None) -> dict[str, Any]:\n706\t    from . import learned\n707\t    return learned.accept(vin, module_code, did, name, field, scale=scale, offset=offset,\n708\t                          unit=unit, evidence=evidence)\n709\t\n710\t\n711\tdef learned_dids(vin: str = \"\") -> dict[str, Any]:\n712\t    from . import learned\n713\t    return {\"learned\": learned.learned(vin or None)}\n714\t\n715\t\n716\t# --- whole-vehicle coverage ---------------------------------------------------\n717\t\n718\tdef coverage_status() -> dict[str, Any]:\n719\t    from . import coverage\n720\t    return coverage.status()\n721\t\n722\t\n723\tdef coverage_start(vin: str, engine_running: Optional[bool] = None) -> dict[str, Any]:\n724\t    from . import coverage\n725\t    return coverage.start(vin, engine_running=engine_running)\n726\t\n727\t\n728\tdef coverage_run(key: str, confirm: bool = False, seconds: float = 3.0,\n729\t                 discover: Optional[bool] = None) -> dict[str, Any]:\n730\t    import sys\n731\t    from . import coverage\n732\t    return coverage.run_pass(key, ops=sys.modules[__name__], confirm=confirm,\n733\t                             seconds=seconds, discover=discover)\n734\t\n735\t\n736\tdef coverage_skip(key: str, reason: str = \"\") -> dict[str, Any]:\n737\t    from . import coverage\n738\t    return coverage.skip_pass(key, reason)\n739\t\n740\t\n741\tdef coverage_report() -> dict[str, Any]:\n742\t    from . import coverage\n743\t    return coverage.report()\n744\t\n745\t\n746\tdef coverage_reset() -> dict[str, Any]:\n747\t    from . import coverage\n748\t    return coverage.reset()\n749\t\n750\t\n751\t# --- actuator tests: learned from a dealer tool, replayed under strict guards -----\n752\t\n753\tdef learn_actuator(capture_name: str, module: str, name: str, tool: str = \"MES\") -> dict[str, Any]:\n754\t    \"\"\"Extract a replayable procedure for one module's actuator test from a saved capture.\n755\t\n756\t    ``capture_name`` is a file :func:`learn_capture` wrote, under\n757\t    ``state_dir()/captures``. Pure offline parsing -- the adapter is never\n758\t    opened. The module's target byte is taken from this VIN's confirmed\n759\t    address if one is on record (``link().vin``), else the registry target.\n760\t    \"\"\"\n761\t    import json as _json\n762\t    from . import actuate\n763\t    p = state_dir() / \"captures\" / Path(capture_name).name\n764\t    if not p.exists():\n765\t        raise BadCommand(f\"no capture named {capture_name!r}\")\n766\t    data = _json.loads(p.read_text(encoding=\"utf-8\"))\n767\t    ecu = by_code(module.upper())\n768\t    if ecu is None:\n769\t        raise BadCommand(f\"unknown module code {module!r}\")\n770\t    vin = link().vin or \"\"\n771\t    target = store.confirmed_targets(vin).get(ecu.code) if vin else None\n772\t    if target is None:\n773\t        target = ecu.target\n774\t    if target is None:\n775\t        raise BadCommand(f\"module {ecu.code} has no known address; run discovery first\")\n776\t    procedure = actuate.extract_procedure(data.get(\"transactions\") or [], f\"{target:02X}\")\n777\t    return actuate.save_actuator(vin, ecu.code, name, procedure, source=p.name, tool=tool)\n778\t\n779\t\n780\tdef actuators(vin: str = \"\") -> dict[str, Any]:\n781\t    from . import actuate\n782\t    return {\"actuators\": actuate.list_actuators(vin or None)}\n783\t\n784\t\n785\tdef run_actuator(vin: str, module: str, name: str, consent: str, max_seconds: float = 10.0,\n786\t                 confirm: bool = False, **kw: Any) -> dict[str, Any]:\n787\t    \"\"\"Replay a learned actuator test (UDS 0x2F/0x31) on one module. Not exposed over HTTP.\n788\t\n789\t    Refuses unless ``consent`` is exactly ``ACTUATE <MODULE> <NAME>``, the module is not\n790\t    safety-critical (:data:`safety.ACTUATION_BLOCKED_MODULES`, or anything on CAN-CH --\n791\t    use MultiEcuScan or wiTECH for those), the learned procedure is replayable (no\n792\t    SecurityAccess, no configuration/reflash/reset service), and the vehicle reads\n793\t    engine-off and stationary (PID 0C then 0D on the legislated route; unreadable refuses\n794\t    too). Bounded to ``max_seconds`` (hard cap 30 s); control is ALWAYS returned to the\n795\t    ECU afterwards, even if a step fails.\n796\t    \"\"\"\n797\t    from . import actuate\n798\t    ecu = uds_mod.resolve_module(module, vin or None)\n799\t    procedure = actuate.get_actuator(vin, ecu.code, name)\n800\t    actuate.assert_actuate_allowed(ecu, procedure, consent, name)   # fail fast, before any traffic\n801\t\n802\t    def _reading(pid: str) -> Optional[float]:\n803\t        try:\n804\t            r = obd_pid(pid, **kw)\n805\t        except LiveError:\n806\t            return None\n807\t        return float(r[\"value\"]) if r.get(\"value\") is not None else None\n808\t\n809\t    rpm = _reading(\"0C\")\n810\t    speed = _reading(\"0D\")\n811\t    if rpm is None or speed is None:\n812\t        raise Refused(\"could not read engine RPM and vehicle speed; refusing to actuate\")\n813\t    if rpm > 0:\n814\t        raise Refused(f\"engine is running ({rpm:g} rpm); refusing to actuate\")\n815\t    if speed > 0:\n816\t        raise Refused(f\"vehicle speed reads {speed:g} km/h; refusing to actuate\")\n817\t\n818\t    with link().session(f\"actuate {ecu.code} {name}\", bus=_bus(ecu.bus_key), confirm=confirm,\n819\t                        **kw) as sess:\n820\t        out = actuate.run_actuator(sess, ecu, procedure, consent=consent, max_seconds=max_seconds)\n821\t        return _stamp(sess, out)\n822\t\n823\t\n824\t__all__ = [\"observations\", \"status\", \"ports\", \"mes_settings\", \"set_cable\", \"cable_state\", \"buses\", \"modules\",\n825\t           \"probe\", \"verify_bus\", \"capture\", \"obd_dtcs\", \"obd_all_dtcs\", \"obd_pid\",\n826\t           \"obd_voltage\", \"obd_supported_pids\", \"obd_freeze_frame\", \"obd_vin\",\n827\t           \"readiness_in\", \"obd_readiness\", \"module_dtcs\", \"module_identity\", \"module_did\",\n828\t           \"scan_modules\", \"discover\", \"coverage_status\", \"coverage_start\", \"coverage_run\",\n829\t           \"coverage_skip\", \"coverage_report\", \"coverage_reset\", \"repair_status\",\n830\t           \"obd_mode06\", \"module_dtc_detail\", \"module_dtc_count\", \"clear_module_dtcs\",\n831\t           \"module_read_all\", \"module_discover_dids\",\n832\t           \"learn_capture\", \"learn_correlate\", \"learn_accept\", \"learned_dids\",\n833\t           \"learn_actuator\", \"actuators\", \"run_actuator\",\n834\t           \"AdapterLink\", \"link\", \"DEFAULT_TIMEOUT\"]\n835\t\n836\t\n837\t# --- live-data engine: channel registry, poll sessions, alarms, recording -------\n838\t#\n839\t# Backend for a future dashboard UI. The poller (cuore.live.poller) owns one\n840\t# adapter session for the whole run; everything here is a thin wrapper so the\n841\t# HTTP routes and MCP tools share the same entry points as every other\n842\t# operation in this file.\n843\t\n844\tdef live_channels() -> dict[str, Any]:\n845\t    \"\"\"The channel registry (every PID/DID/computed/battery channel) and presets.\"\"\"\n846\t    from . import channels as channels_mod\n847\t    return {\"channels\": [c.to_dict() for c in channels_mod.available_channels()],\n848\t            \"presets\": channels_mod.presets()}\n849\t\n850\t\n851\tdef live_session_start(channels: Optional[list[str]] = None, preset: str = \"\",\n852\t                       rates: Optional[dict[str, float]] = None, monitor_dtcs: bool = False,\n853\t                       dtc_interval_s: float = 10.0) -> dict[str, Any]:\n854\t    \"\"\"Start the live-data poll session on the given channels and/or preset.\n855\t\n856\t    Read-only (Mode 01, UDS 0x22, ATRV only) but holds the adapter for the\n857\t    whole session: other live operations refuse while this runs (see the\n858\t    guard below), and this itself refuses while MultiEcuScan is connected.\n859\t\n860\t    ``monitor_dtcs`` (MES's \"Monitor DTCs\" convention): every\n861\t    ``dtc_interval_s`` seconds (minimum 5), the poller also reads Mode 03/07\n862\t    between channel reads and reports any change -- see\n863\t    :meth:`cuore.live.poller.LivePoller._poll_dtcs`.\n864\t    \"\"\"\n865\t    from . import channels as channels_mod\n866\t    from . import poller as poller_mod\n867\t    chans = channels_mod.resolve_channels(channels, preset)\n868\t    return poller_mod.poller().start(chans, rates=rates, monitor_dtcs=monitor_dtcs,\n869\t                                     dtc_interval_s=dtc_interval_s)\n870\t\n871\t\n872\tdef live_session_stop() -> dict[str, Any]:\n873\t    \"\"\"Stop the live-data poll session and release the adapter.\"\"\"\n874\t    from . import poller as poller_mod\n875\t    return poller_mod.poller().stop()\n876\t\n877\t\n878\tdef live_session_status() -> dict[str, Any]:\n879\t    \"\"\"Live-data session status: channels, configured and achieved rates, alarms.\"\"\"\n880\t    from . import poller as poller_mod\n881\t    return poller_mod.poller().status()\n882\t\n883\t\n884\tdef live_snapshot() -> dict[str, Any]:\n885\t    \"\"\"Latest value (and alarm state) of every channel in the running session.\"\"\"\n886\t    from . import poller as poller_mod\n887\t    return poller_mod.poller().snapshot()\n888\t\n889\t\n890\tdef live_record_start() -> dict[str, Any]:\n891\t    \"\"\"Start mirroring the running live session to an MES-format CSV recording.\"\"\"\n892\t    from . import poller as poller_mod\n893\t    return poller_mod.poller().start_recording()\n894\t\n895\t\n896\tdef live_record_stop() -> dict[str, Any]:\n897\t    \"\"\"Stop the live-session CSV recording.\"\"\"\n898\t    from . import poller as poller_mod\n899\t    return poller_mod.poller().stop_recording()\n900\t\n901\t\n902\tdef live_set_alarm(channel: str, warn: Optional[float] = None, alarm: Optional[float] = None,\n903\t                   direction: str = \"above\", hysteresis: float = 0.0) -> dict[str, Any]:\n904\t    \"\"\"Set (or replace) a warn/alarm threshold on one channel of the live session.\"\"\"\n905\t    from . import poller as poller_mod\n906\t    return poller_mod.poller().set_alarm(channel, warn=warn, alarm=alarm, direction=direction,\n907\t                                         hysteresis=hysteresis)\n908\t\n909\t\n910\tdef live_stream_subscribe() -> Any:\n911\t    \"\"\"A queue of ``{t, channel, value, unit, alarm}`` messages for the SSE route.\"\"\"\n912\t    from . import poller as poller_mod\n913\t    return poller_mod.poller().subscribe()\n914\t\n915\t\n916\tdef live_stream_unsubscribe(q: Any) -> None:\n917\t    from . import poller as poller_mod\n918\t    poller_mod.poller().unsubscribe(q)\n919\t\n920\t\n921\tdef live_stream_events(max_messages: Optional[int] = None):\n922\t    \"\"\"Generator of live-session messages, or ``None`` as a keepalive placeholder.\n923\t\n924\t    A plain Python generator -- deliberately independent of FastAPI/ASGI --\n925\t    so it is directly testable without an HTTP layer. The SSE route wraps\n926\t    each yielded item into one ``data: ...`` (or ``: keepalive``) line.\n927\t    ``max_messages`` bounds it for callers that want a finite read (tests);\n928\t    the HTTP route leaves it unbounded and relies on the client disconnecting\n929\t    to end iteration (handled by the ``finally`` unsubscribe below).\n930\t    \"\"\"\n931\t    import queue as _queue\n932\t    from . import poller as poller_mod\n933\t    q = poller_mod.poller().subscribe()\n934\t    n = 0\n935\t    try:\n936\t        while max_messages is None or n < max_messages:\n937\t            try:\n938\t                yield q.get(timeout=15.0)\n939\t                n += 1\n940\t            except _queue.Empty:\n941\t                yield None\n942\t    finally:\n943\t        poller_mod.poller().unsubscribe(q)\n944\t\n945\t\n946\tdef _poller_active_guard() -> None:\n947\t    \"\"\"Refuse with a clear message if the live-data poller holds the adapter.\n948\t\n949\t    A poll session holds one :class:`~cuore.live.transport.Session` open for\n950\t    its whole run, so any of the ordinary per-call operations below would\n951\t    otherwise just block waiting for the adapter lock instead of failing\n952\t    fast. Checked before the operation opens its own session.\n953\t    \"\"\"\n954\t    from . import poller as poller_mod\n955\t    if poller_mod.poller().holds_adapter():\n956\t        raise Refused(\"a live-data poll session is running and holds the adapter; stop it \"\n957\t                      \"first (live_session_stop / POST /api/live/session/stop)\")\n958\t\n959\t\n960\t#: Every operation here that opens its own adapter session, guarded against\n961\t#: running while the live-data poller holds the port. Wrapping is applied\n962\t#: below by name rather than editing each function in place.\n963\t_POLLER_GUARDED = (\n964\t    \"probe\", \"verify_bus\", \"capture\", \"obd_dtcs\", \"obd_all_dtcs\", \"obd_pid\", \"obd_voltage\",\n965\t    \"obd_supported_pids\", \"obd_freeze_frame\", \"obd_vin\", \"obd_readiness\", \"module_dtcs\",\n966\t    \"module_identity\", \"module_did\", \"scan_modules\", \"discover\", \"obd_mode06\",\n967\t    \"module_dtc_detail\", \"module_dtc_count\", \"module_read_all\", \"module_discover_dids\",\n968\t    \"clear_module_dtcs\", \"run_actuator\",\n969\t)\n970\t\n971\t\n972\tdef _guard_against_poller(fn):\n973\t    def _wrapped(*args, **kwargs):\n974\t        _poller_active_guard()\n975\t        return fn(*args, **kwargs)\n976\t    _wrapped.__name__ = getattr(fn, \"__name__\", \"wrapped\")\n977\t    _wrapped.__doc__ = getattr(fn, \"__doc__\", None)\n978\t    _wrapped.__wrapped__ = fn\n979\t    return _wrapped\n980\t\n981\t\n982\tfor _name in _POLLER_GUARDED:\n983\t    globals()[_name] = _guard_against_poller(globals()[_name])\n984\tdel _name\n985\t\n986\t\n987\t__all__ += [\"live_channels\", \"live_session_start\", \"live_session_stop\", \"live_session_status\",\n988\t           \"live_snapshot\", \"live_record_start\", \"live_record_stop\", \"live_set_alarm\",\n989\t           \"live_stream_subscribe\", \"live_stream_unsubscribe\", \"live_stream_events\"]\n990\t"}]},"uuid":"61d32f47-732c-4c9c-8414-12f553e8e2e4","timestamp":"2026-10-08T01:20:28.358Z","toolUseResult":{"type":"text","file":{"filePath":"C:\\Users\\User\\mcp-servers\\cuore\\live\\ops.py","content":"\"\"\"The operations both surfaces call: HTTP routes and MCP tools are wrappers over these.\n\nEvery function returns a plain dict, opens the adapter for exactly its own\noperation through :func:`link`, and names the bus and cable it used. Errors\nare :class:`LiveError` subclasses; the surfaces decide how to render them.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport re\nfrom datetime import datetime\nfrom pathlib import Path\nfrom typing import Any, Optional\n\nimport serial.tools.list_ports\n\nfrom . import capture as capture_mod\nfrom . import store\nfrom . import uds as uds_mod\nfrom .addressing import MODULES, by_code, on_bus\nfrom .buses import BUSES, CAN_C, Bus, routes_for\nfrom .config import mes_folders, mes_interfaces, mes_registry, resolve_port\nfrom .errors import BadCommand, LiveError, Refused\nfrom .framing import adapter_error, no_data\nfrom .obd import (decode_obd_dtcs, decode_pid, decode_readiness, decode_supported_pids,\n                  dtc_from_two_bytes, evap_verdict, resolve_pid, PIDS_BY_HEX)\nfrom .transport import DEFAULT_TIMEOUT, AdapterLink, Session, link\n\n_MODE03_NOTE = (\"Mode 03 returns emissions-related powertrain codes only. Body, chassis and \"\n                \"network faults are UDS 3-byte codes; use module DTC reads for those.\")\n\n\ndef _bus(key: str) -> Bus:\n    bus = BUSES.get((key or \"can_c\").lower())\n    if bus is None:\n        raise BadCommand(f\"unknown bus {key!r}; one of {list(BUSES)}\")\n    return bus\n\n\ndef _stamp(sess: Session, out: dict[str, Any]) -> dict[str, Any]:\n    out.setdefault(\"bus\", sess.bus.key)\n    out.setdefault(\"cable\", sess.link.cable)\n    auto = getattr(sess, \"auto_verified\", None)\n    if auto:\n        out.setdefault(\"auto_verified\", auto)\n    return out\n\n\ndef _observe(sess: Session, kind: str, out: dict[str, Any], vin: str = \"\") -> dict[str, Any]:\n    \"\"\"Stamp and persist a result as an observation the evidence gate can cite.\"\"\"\n    _stamp(sess, out)\n    v = vin or getattr(sess.link, \"vin\", \"\") or \"\"\n    store.record_observation(kind, out, vin=v, bus=sess.bus.key, cable=sess.link.cable,\n                             stream=sess.stream.describe)\n    return out\n\n\n# --- status and configuration -------------------------------------------------\n\ndef status() -> dict[str, Any]:\n    return link().status()\n\n\ndef ports() -> dict[str, Any]:\n    mes_port = (mes_registry().get(\"Interface 0 Port\") or \"\").upper()\n    found = [{\"device\": p.device, \"description\": p.description, \"hwid\": p.hwid,\n              \"mes_interface_0\": p.device.upper() == mes_port}\n             for p in serial.tools.list_ports.comports()]\n    return {\"ports\": found, \"mes_port\": mes_port or None}\n\n\ndef mes_settings() -> dict[str, Any]:\n    reg = mes_registry()\n    if not reg:\n        return {\"error\": \"HKLM\\\\SOFTWARE\\\\Multiecuscan not found\"}\n    return {\"interfaces\": mes_interfaces(reg), \"folders\": mes_folders(reg),\n            \"last_selection\": reg.get(\"Last Selection\"),\n            \"recent_vehicles\": reg.get(\"Recent Vehicles\"),\n            \"ui_language\": reg.get(\"UI Language\"), \"data_language\": reg.get(\"Data Language\"),\n            \"all_keys\": sorted(reg.keys())}\n\n\ndef set_cable(cable: str) -> dict[str, Any]:\n    return link().set_cable(cable)\n\n\ndef cable_state() -> dict[str, Any]:\n    return link().cable_state()\n\n\ndef buses() -> dict[str, Any]:\n    st = link().cable_state()\n    return {\"cable\": st[\"cable\"], \"buses\": st[\"buses\"]}\n\n\ndef modules(bus: Optional[str] = None) -> dict[str, Any]:\n    rows = on_bus(_bus(bus).key) if bus else list(MODULES)\n    return {\"modules\": [{\n        \"code\": m.code, \"name\": m.name, \"bus\": m.bus_key, \"bus_confidence\": m.bus_confidence,\n        \"target\": None if m.target is None else f\"{m.target:02X}\",\n        \"request\": m.request_hex, \"response\": m.response_hex,\n        \"confidence\": m.confidence.value, \"usable\": m.usable, \"present\": m.present,\n        \"source\": m.source, \"hazard\": m.hazard, \"note\": m.note,\n    } for m in rows]}\n\n\n# --- probe and verification --------------------------------------------------\n\ndef probe(port: str = \"\", baud: int = 0, allow_while_mes_connected: bool = False) -> dict[str, Any]:\n    \"\"\"Reset the adapter, read its identity, report vehicle power. Holds nothing.\"\"\"\n    lk = link()\n    lk.identity = {}\n    with lk.session(\"probe\", bus=CAN_C, port=port, baud=baud, passive=True,\n                    allow_while_mes_connected=allow_while_mes_connected) as sess:\n        out: dict[str, Any] = {\"port\": lk.port, \"port_source\": lk.port_source,\n                               \"baud\": lk.baud, \"baud_source\": lk.baud_source,\n                               \"identity\": lk.identity, \"stn_chip\": lk.is_stn}\n        volts = sess.cmd(\"ATRV\", 2)\n        m = re.search(r\"(\\d+\\.\\d+)V\", volts)\n        out[\"battery_voltage\"] = float(m.group(1)) if m else None\n        out[\"vehicle_power_detected\"] = bool(m)\n        if lk.is_stn:\n            out[\"protocol\"] = sess.cmd(\"STPRS\", 2)\n        if not m:\n            out[\"note\"] = (\"no vehicle voltage at the adapter: not plugged into the car or \"\n                           \"ignition off\")\n        out[\"port_held\"] = False\n        return _stamp(sess, out)\n\n\ndef verify_bus(bus: str, seconds: float = 2.0, port: str = \"\", baud: int = 0,\n               allow_while_mes_connected: bool = False) -> dict[str, Any]:\n    \"\"\"Passive listen; marks the bus verified under the current cable if traffic is seen.\n\n    A bus can be reachable under more than one adapter protocol -- CAN-C\n    carries both 29-bit UDS and the 11-bit legislated pair, and a monitor\n    opened for one ID width hears nothing of the other. Every route the\n    declared cable allows is tried before reporting silence, because a healthy\n    bus reported as dead is the worst answer this tool can give.\n    \"\"\"\n    b = _bus(bus)\n    lk = link()\n    candidates: list[Any] = list(routes_for(b, lk.cable)) or [None]\n    attempts: list[dict[str, Any]] = []\n    sess = None\n    for route in candidates:\n        with lk.session(\"verify_bus\", bus=b, port=port, baud=baud, passive=True,\n                        allow_while_mes_connected=allow_while_mes_connected,\n                        route=route) as sess:\n            cap = capture_mod.listen(sess, seconds=seconds, max_frames=200)\n            # \"DATA ERROR\" is the adapter's per-frame annotation for one frame\n            # whose payload did not validate; with parsed frames beside it the\n            # bus is demonstrably alive, so it is reported but does not veto.\n            fatal = cap[\"error\"] and not (cap[\"error\"] == \"DATA ERROR\" and cap[\"count\"] > 0)\n            ok = cap[\"count\"] > 0 and not fatal\n            attempts.append({\"stn_protocol\": sess.route.stn_protocol,\n                             \"header_bits\": sess.header_bits,\n                             \"frames\": cap[\"count\"], \"error\": cap[\"error\"],\n                             \"ids\": cap[\"ids\"]})\n            if ok:\n                lk.mark_verified(b, cap[\"count\"])\n                return _stamp(sess, {\"verified\": True, \"frames\": cap[\"count\"],\n                                     \"rate_hz\": cap[\"rate_hz\"], \"ids\": cap[\"ids\"],\n                                     \"error\": cap[\"error\"],\n                                     \"stn_protocol\": sess.route.stn_protocol,\n                                     \"header_bits\": sess.header_bits,\n                                     \"attempts\": attempts, \"note\": None})\n    tried = \", \".join(f\"STP {a['stn_protocol']} ({a['header_bits']}-bit)\" for a in attempts)\n    return _stamp(sess, {\"verified\": False, \"frames\": 0, \"rate_hz\": 0.0, \"ids\": {},\n                         \"error\": attempts[-1][\"error\"] if attempts else None,\n                         \"attempts\": attempts,\n                         \"note\": (f\"no traffic on {b.key} with cable {lk.cable!r} on any route \"\n                                  f\"tried ({tried}); check the cable, ignition, and the route \"\n                                  f\"note: {sess.route.note}\")})\n\n\ndef capture(bus: str, seconds: float = 2.0, max_frames: int = 500,\n            filters: Optional[list[str]] = None, include_frames: bool = True,\n            allow_while_mes_connected: bool = False) -> dict[str, Any]:\n    b = _bus(bus)\n    with link().session(\"capture\", bus=b, passive=True,\n                        allow_while_mes_connected=allow_while_mes_connected) as sess:\n        cap = capture_mod.listen(sess, seconds=seconds, max_frames=max_frames, filters=filters)\n        if not include_frames:\n            cap[\"frames\"] = cap[\"frames\"][:20]\n            cap[\"frames_truncated\"] = True\n        return _stamp(sess, cap)\n\n\n# --- legislated OBD on CAN-C -------------------------------------------------\n\ndef _obd_route() -> Any:\n    \"\"\"The 11-bit legislated route on CAN-C, when the cable allows one.\n\n    Giorgio ECMs serve Modes 01/03/07/0A only on the 11-bit 7DF/7E8 pair; the\n    29-bit UDS address answers every legislated request with NRC 0x11\n    (serviceNotSupported), which read as silence until 2026-09-25.\n    \"\"\"\n    for route in routes_for(CAN_C, link().cable):\n        if route.stn_protocol == \"33\":\n            return route\n    return None\n\n\ndef _obd_session(purpose: str, **kw: Any):\n    kw.setdefault(\"route\", _obd_route())\n    return link().session(purpose, bus=CAN_C, **kw)\n\n\ndef _negative_responses(q: dict[str, Any]) -> list[str]:\n    \"\"\"Human-readable NRC lines for every ECU that answered 7F.\"\"\"\n    from .uds import NRC_TEXT as NRC  # local: keep the OBD path free of the UDS client\n    lines: list[str] = []\n    for hdr, data in (q.get(\"all_ecus\") or {}).items():\n        if len(data) >= 3 and data[0].upper() == \"7F\":\n            nrc = int(data[2], 16)\n            lines.append(f\"ECU {hdr} answered NRC 0x{nrc:02X} \"\n                         f\"({NRC.get(nrc, 'unknown')}) to service {data[1]}\")\n    return lines\n\n\ndef _silence_reason(sess: Session) -> str:\n    \"\"\"Why no ECU answered, judged from the voltage at the OBD port.\n\n    \"With the ignition off this is expected\" was printed on 2026-09-25 while\n    the port read 14.1 V with the engine running; the real cause was the\n    adapter's bus access. Charging voltage rules the ignition out.\n    \"\"\"\n    try:\n        raw = sess.cmd(\"ATRV\", 2)\n    except Exception:  # noqa: BLE001 -- the explanation must never fail the read\n        raw = \"\"\n    m = re.search(r\"(\\d+\\.\\d+)V\", raw or \"\")\n    if not m:\n        return (\"no vehicle voltage at the adapter: it is not plugged into the car, or the \"\n                \"car is fully off\")\n    v = float(m.group(1))\n    if v >= 13.3:\n        return (f\"the port reads {v:.1f} V, so the engine is running: the ignition does NOT \"\n                f\"explain the silence. Check the adapter's bus access: HS/MS switch on HS, \"\n                f\"plug fully seated, no coloured cable fitted for CAN-C\")\n    if v < 11.0:\n        return f\"the port reads {v:.1f} V: the battery is low enough for modules to drop out\"\n    return (f\"the port reads {v:.1f} V: the ignition may be off. Turn it ON and retry; if it \"\n            f\"is already on, check the HS/MS switch and that the plug is fully seated\")\n\n\ndef _dtc_read(sess: Session, mode: str, response_byte: str, label: str) -> dict[str, Any]:\n    sess.untarget()\n    q = sess.query(mode, response_byte)\n    out: dict[str, Any] = {\"kind\": label, \"raw\": q[\"raw\"]}\n    if q[\"error\"]:\n        out[\"error\"] = (f\"ADAPTER/BUS ERROR: {q['error']}. This is NOT 'no codes'; the read did \"\n                        f\"not complete.\")\n        return _stamp(sess, out)\n    per_ecu = {hdr: decode_obd_dtcs(data) for hdr, data in q[\"ecus\"].items()}\n    out[\"dtcs\"] = sorted({c for codes in per_ecu.values() for c in codes})\n    out[\"by_ecu\"] = per_ecu\n    if not q[\"ecus\"]:\n        neg = _negative_responses(q)\n        if neg:\n            out[\"warning\"] = (\"negative response, not silence: \" + \"; \".join(neg) +\n                              \". The service is refused on this route/session, so the \"\n                              \"read did NOT complete.\")\n        else:\n            out[\"warning\"] = (\"no ECU answered\" + (\" (NO DATA)\" if no_data(q[\"raw\"]) else \"\") +\n                              \"; \" + _silence_reason(sess))\n    if label == \"stored\" and not out[\"dtcs\"]:\n        out[\"note\"] = _MODE03_NOTE\n    return _observe(sess, \"obd_dtcs\", out)\n\n\n_KINDS = {\"stored\": (\"03\", \"43\"), \"pending\": (\"07\", \"47\"), \"permanent\": (\"0A\", \"4A\")}\n\n\ndef obd_dtcs(kind: str = \"stored\", **kw: Any) -> dict[str, Any]:\n    if kind not in _KINDS:\n        raise BadCommand(f\"kind must be one of {list(_KINDS)}\")\n    mode, resp = _KINDS[kind]\n    with _obd_session(f\"read_{kind}_dtcs\", **kw) as sess:\n        return _dtc_read(sess, mode, resp, kind)\n\n\ndef obd_all_dtcs(**kw: Any) -> dict[str, Any]:\n    with _obd_session(\"read_all_dtcs\", **kw) as sess:\n        return _stamp(sess, {k: _dtc_read(sess, m, r, k) for k, (m, r) in _KINDS.items()})\n\n\ndef obd_pid(pid: str, **kw: Any) -> dict[str, Any]:\n    hex_pid, spec = resolve_pid(pid)\n    with _obd_session(\"read_pid\", **kw) as sess:\n        sess.untarget()\n        q = sess.query(f\"01{hex_pid}\", \"41\")\n        out: dict[str, Any] = {\"pid\": hex_pid, \"name\": spec.name if spec else None, \"raw\": q[\"raw\"]}\n        if q[\"error\"]:\n            out[\"error\"] = f\"ADAPTER/BUS ERROR: {q['error']}; the read did not complete\"\n            return _stamp(sess, out)\n        readings = {hdr: decode_pid(hex_pid, spec, data[2:])\n                    for hdr, data in q[\"ecus\"].items() if len(data) >= 2 and data[1] == hex_pid}\n        out[\"by_ecu\"] = readings\n        first = next(iter(readings.values()), None)\n        if first is not None:\n            out[\"value\"], out[\"unit\"] = first.get(\"value\"), first.get(\"unit\")\n        else:\n            out[\"warning\"] = \"no ECU answered this PID; \" + _silence_reason(sess)\n        return _stamp(sess, out)\n\n\ndef obd_voltage(**kw: Any) -> dict[str, Any]:\n    with link().session(\"read_voltage\", bus=CAN_C, passive=True, **kw) as sess:\n        r = sess.cmd(\"ATRV\", 2)\n        m = re.search(r\"(\\d+\\.\\d+)V\", r)\n        return _stamp(sess, {\"raw\": r, \"volts\": float(m.group(1)) if m else None,\n                             \"vehicle_power_detected\": bool(m)})\n\n\ndef obd_supported_pids(**kw: Any) -> dict[str, Any]:\n    with _obd_session(\"read_supported_pids\", **kw) as sess:\n        sess.untarget()\n        out: dict[str, Any] = {\"by_ecu\": {}, \"raw\": {}}\n        for base in (\"00\", \"20\", \"40\", \"60\", \"80\", \"A0\", \"C0\"):\n            q = sess.query(f\"01{base}\", \"41\")\n            out[\"raw\"][base] = q[\"raw\"]\n            if q[\"error\"]:\n                out.setdefault(\"errors\", {})[base] = q[\"error\"]\n                break\n            any_next = False\n            for hdr, data in q[\"ecus\"].items():\n                if len(data) < 6 or data[1] != base:\n                    continue\n                supported, more = decode_supported_pids(base, data[2:6])\n                out[\"by_ecu\"].setdefault(hdr, []).extend(supported)\n                any_next = any_next or more\n            if not any_next:\n                break\n        for hdr, lst in out[\"by_ecu\"].items():\n            out[\"by_ecu\"][hdr] = {\"count\": len(lst), \"pids\": lst,\n                                  \"known_names\": [PIDS_BY_HEX[p].name for p in lst if p in PIDS_BY_HEX]}\n        return _stamp(sess, out)\n\n\ndef obd_freeze_frame(pid: str = \"\", **kw: Any) -> dict[str, Any]:\n    hex_pid, spec = resolve_pid(pid) if pid.strip() else (\"02\", None)\n    with _obd_session(\"read_freeze_frame\", **kw) as sess:\n        sess.untarget()\n        q = sess.query(f\"02{hex_pid}00\", \"42\")\n        out: dict[str, Any] = {\"pid\": hex_pid, \"name\": spec.name if spec else None, \"raw\": q[\"raw\"]}\n        if q[\"error\"]:\n            out[\"error\"] = f\"ADAPTER/BUS ERROR: {q['error']}; the read did not complete\"\n            return _stamp(sess, out)\n        by_ecu: dict[str, Any] = {}\n        for hdr, data in q[\"ecus\"].items():\n            if len(data) < 3 or data[1] != hex_pid:\n                continue\n            payload = data[3:]\n            if hex_pid == \"02\":\n                code = dtc_from_two_bytes(payload[0], payload[1]) if len(payload) >= 2 else None\n                by_ecu[hdr] = {\"dtc\": code, \"bytes\": payload}\n            else:\n                by_ecu[hdr] = decode_pid(hex_pid, spec, payload)\n        out[\"by_ecu\"] = by_ecu\n        if not by_ecu:\n            out[\"warning\"] = \"no ECU returned a freeze frame (none stored, or ignition off)\"\n        return _stamp(sess, out)\n\n\ndef obd_vin(**kw: Any) -> dict[str, Any]:\n    with _obd_session(\"read_vin\", **kw) as sess:\n        sess.untarget()\n        q = sess.query(\"0902\", \"49\", 6)\n        out: dict[str, Any] = {\"raw\": q[\"raw\"]}\n        if q[\"error\"]:\n            out[\"error\"] = f\"ADAPTER/BUS ERROR: {q['error']}; the read did not complete\"\n            return _stamp(sess, out)\n        for hdr, data in q[\"ecus\"].items():\n            if len(data) >= 3 and data[1] == \"02\":\n                vin = \"\".join(chr(int(b, 16)) for b in data[3:] if 32 <= int(b, 16) < 127)\n                out.update({\"vin\": vin, \"ecu\": hdr, \"length_ok\": len(vin) == 17})\n                if len(vin) == 17:\n                    sess.link.vin = vin\n                break\n        if \"vin\" not in out:\n            out[\"warning\"] = \"no ECU answered Mode 09 PID 02; \" + _silence_reason(sess)\n        return _stamp(sess, out)\n\n\ndef readiness_in(sess: Session) -> dict[str, Any]:\n    sess.untarget()\n    out: dict[str, Any] = {}\n    for pid, label in ((\"01\", \"since_clear\"), (\"41\", \"this_drive_cycle\")):\n        q = sess.query(f\"01{pid}\", \"41\")\n        if q[\"error\"]:\n            out[label] = {\"error\": q[\"error\"], \"raw\": q[\"raw\"]}\n            continue\n        decoded = None\n        for hdr, data in q[\"ecus\"].items():\n            decoded = decode_readiness(data, \"41\")\n            if decoded:\n                decoded[\"ecu\"] = hdr\n                break\n        neg = _negative_responses(q) if not decoded else []\n        out[label] = decoded or {\"error\": (\"negative response: \" + \"; \".join(neg)) if neg\n                                 else \"could not decode readiness response\", \"raw\": q[\"raw\"]}\n        if not decoded and not neg and no_data(q[\"raw\"]):\n            out[label][\"why\"] = _silence_reason(sess)\n    verdict = evap_verdict(out.get(\"since_clear\") or {})\n    if verdict:\n        out[\"evap_verdict\"] = verdict\n    counters: dict[str, Any] = {}\n    for name, hex_pid in ((\"warmups_since_clear\", \"30\"), (\"distance_since_clear\", \"31\")):\n        q = sess.query(f\"01{hex_pid}\", \"41\")\n        if q[\"error\"]:\n            continue\n        for _hdr, data in q[\"ecus\"].items():\n            if len(data) >= 3 and data[1] == hex_pid:\n                dec = decode_pid(hex_pid, PIDS_BY_HEX[hex_pid], data[2:])\n                if \"value\" in dec:\n                    counters[name] = dec[\"value\"]\n                break\n    if counters:\n        out[\"drive_cycle_counters\"] = counters\n    return _observe(sess, \"readiness\", out)\n\n\ndef obd_readiness(**kw: Any) -> dict[str, Any]:\n    with _obd_session(\"read_readiness\", **kw) as sess:\n        return readiness_in(sess)\n\n\n# --- UDS on any bus ----------------------------------------------------------\n\ndef _compact_dtc_result(mod: dict[str, Any]) -> dict[str, Any]:\n    \"\"\"Summarise one module's UDS DTC read for ``detail=False`` callers.\n\n    A UDS 0x19 02 reply lists every code the module TRACKS, not every code\n    that is failing -- the ECM alone tracks 278 and reports all of them. Most\n    callers only need what is wrong now, so this keeps the status/metadata\n    fields and collapses the ``dtcs`` list to active/history counts plus the\n    full records for the active codes only. :func:`coverage.classify_records`\n    already does the status-byte classification for the coverage sweep; it is\n    reused here rather than re-implemented so the two summaries never drift\n    out of sync with what the status bits mean.\n    \"\"\"\n    from . import coverage\n    out = {k: mod[k] for k in\n           (\"ecu\", \"bus\", \"mask\", \"error\", \"nrc\", \"warning\", \"note\", \"skipped\")\n           if k in mod}\n    if \"dtcs\" not in mod:\n        return out\n    records = mod.get(\"dtcs\") or []\n    cls = coverage.classify_records(records)\n    active_set = set(cls[\"active\"])\n    out[\"active\"] = cls[\"active\"]\n    out[\"history\"] = cls[\"history\"]\n    out[\"tracked\"] = cls[\"tracked\"]\n    out[\"not_run_since_clear\"] = cls[\"not_run_since_clear\"]\n    out[\"active_records\"] = [r for r in records if r.get(\"code\") in active_set]\n    return out\n\n\ndef module_dtcs(code: str, vin: str = \"\", mask: int = 0xFF, confirm: bool = False,\n                detail: bool = True, **kw: Any) -> dict[str, Any]:\n    \"\"\"UDS 0x19 02 on one module. ``detail=False`` summarises the DTC list --\n    see :func:`_compact_dtc_result`. The FULL result is always what gets\n    recorded as the observation; only the returned value is ever summarised.\n    \"\"\"\n    ecu = uds_mod.resolve_module(code, vin or None)\n    with link().session(f\"module_dtcs {ecu.code}\", bus=_bus(ecu.bus_key), confirm=confirm,\n                        **kw) as sess:\n        full = _observe(sess, \"module_dtcs\", uds_mod.read_dtcs(sess, ecu, mask), vin)\n        return full if detail else _compact_dtc_result(full)\n\n\ndef module_identity(code: str, vin: str = \"\", confirm: bool = False, **kw: Any) -> dict[str, Any]:\n    ecu = uds_mod.resolve_module(code, vin or None)\n    with link().session(f\"module_identity {ecu.code}\", bus=_bus(ecu.bus_key), confirm=confirm,\n                        **kw) as sess:\n        out = uds_mod.identity(sess, ecu)\n        f190 = (out.get(\"fields\") or {}).get(\"F190\") or {}\n        if f190.get(\"ascii\") and len(f190[\"ascii\"]) == 17:\n            sess.link.vin = f190[\"ascii\"]\n        return _observe(sess, \"identity\", out, vin)\n\n\ndef module_did(code: str, did: str, vin: str = \"\", confirm: bool = False, **kw: Any\n               ) -> dict[str, Any]:\n    ecu = uds_mod.resolve_module(code, vin or None)\n    try:\n        did_int = int(did, 16)\n    except ValueError:\n        raise BadCommand(f\"did must be hex, got {did!r}\")\n    if not 0 <= did_int <= 0xFFFF:\n        raise BadCommand(\"did must be 0000..FFFF\")\n    with link().session(f\"module_did {ecu.code} {did_int:04X}\", bus=_bus(ecu.bus_key),\n                        confirm=confirm, **kw) as sess:\n        return _observe(sess, \"did\", uds_mod.read_did(sess, ecu, did_int), vin)\n\n\ndef scan_modules(bus: str = \"can_c\", vin: str = \"\", mask: int = 0xFF, confirm: bool = False,\n                 detail: bool = True, **kw: Any) -> dict[str, Any]:\n    \"\"\"UDS DTC sweep over every confirmed module on a bus. ``detail=False``\n    summarises each module's DTC list -- see :func:`_compact_dtc_result`. The\n    FULL scan, and the FULL per-module result, are what get recorded as\n    observations; only the returned value is ever summarised.\n    \"\"\"\n    b = _bus(bus)\n    with link().session(f\"scan_modules {b.key}\", bus=b, confirm=confirm, **kw) as sess:\n        out = _observe(sess, \"scan\", uds_mod.scan_bus(sess, b, vin or None, mask), vin)\n        for mod in out.get(\"modules\", []):\n            if \"codes\" in mod:\n                store.record_observation(\"module_dtcs\", mod,\n                                         vin=vin or getattr(sess.link, \"vin\", \"\"),\n                                         bus=b.key, cable=sess.link.cable,\n                                         stream=sess.stream.describe)\n        if not detail:\n            out = {**out, \"modules\": [_compact_dtc_result(m) for m in out.get(\"modules\", [])]}\n        return out\n\n\ndef discover(bus: str = \"can_c\", vin: str = \"\", confirm: bool = False,\n             candidates: Optional[list[str]] = None, per_target_timeout: float = 0.25,\n             stop_after: Optional[int] = None, **kw: Any) -> dict[str, Any]:\n    b = _bus(bus)\n    cands = None\n    if candidates:\n        try:\n            cands = [int(c, 16) for c in candidates]\n        except ValueError:\n            raise BadCommand(\"candidates must be hex target bytes\")\n    with link().session(f\"discover {b.key}\", bus=b, confirm=confirm, **kw) as sess:\n        return _stamp(sess, uds_mod.discover(sess, b, vin_expected=vin or None,\n                                             candidates=cands,\n                                             per_target_timeout=per_target_timeout,\n                                             stop_after=stop_after))\n\n\ndef observations(n: int = 50, vin: str = \"\", kind: str = \"\") -> dict[str, Any]:\n    return {\"path\": str(store.observations_path()),\n            \"entries\": store.recent_observations(n, vin=vin, kind=kind)}\n\n\n# --- repair verification --------------------------------------------------------\n\ndef repair_status(codes: list[str], module: str = \"ECM\", vin: str = \"\",\n                  read: bool = True, confirm: bool = False) -> dict[str, Any]:\n    \"\"\"Has each named test re-run since the clear, and did it pass?\n\n    ``read=True`` reads the module now (0x19 02 FF); either way the answer\n    carries a timeline from every earlier real read of this module for this\n    VIN, so progress is visible drive by drive.\n    \"\"\"\n    from datetime import datetime\n    from . import repair\n    if not [c for c in codes if c.strip()]:\n        raise BadCommand(\"name at least one code, e.g. P0455,P0456,P0440\")\n    out: dict[str, Any] = {\"module\": module.upper(), \"vin\": vin or None}\n    if read:\n        now = module_dtcs(module, vin=vin, confirm=confirm)\n        answered = not now.get(\"error\") and now.get(\"codes\") is not None\n        out[\"read_at\"] = datetime.now().isoformat(timespec=\"seconds\")\n        out[\"read_problem\"] = now.get(\"error\") or now.get(\"warning\") or None\n        out.update(repair.assess(codes, now.get(\"dtcs\") or [], answered))\n    history = ([o for o in store.recent_observations(1000, vin=vin, kind=\"module_dtcs\")\n                if store.is_from_car(o)] if vin else [])\n    out[\"timeline\"] = repair.timeline(codes, history, module)\n    if not vin:\n        out[\"timeline_note\"] = \"pass vin to see earlier reads of this car\"\n    return out\n\n\n# --- deeper reads: Mode $06, DTC detail -----------------------------------------\n\ndef obd_mode06(mids: Optional[list[str]] = None, **kw: Any) -> dict[str, Any]:\n    \"\"\"OBD Mode $06 on-board test results, with the EVAP tests summarised.\"\"\"\n    from . import mode06\n    with _obd_session(\"read_mode06\", **kw) as sess:\n        out = mode06.read_mode06(sess, mids=[m.upper() for m in mids] if mids else None)\n        out[\"evap_summary\"] = mode06.evap_summary(out)\n        return _observe(sess, \"mode06\", out)\n\n\ndef module_dtc_detail(code: str, dtc: str, vin: str = \"\", confirm: bool = False,\n                      **kw: Any) -> dict[str, Any]:\n    \"\"\"Status, snapshot records and extended data (counters) for one code on one module.\"\"\"\n    from . import dtc_detail\n    ecu = uds_mod.resolve_module(code, vin or None)\n    with link().session(f\"dtc_detail {ecu.code} {dtc}\", bus=_bus(ecu.bus_key), confirm=confirm,\n                        **kw) as sess:\n        return _observe(sess, \"dtc_detail\", dtc_detail.dtc_detail(sess, ecu, dtc), vin)\n\n\ndef module_dtc_count(code: str, vin: str = \"\", mask: int = 0xFF, confirm: bool = False,\n                     **kw: Any) -> dict[str, Any]:\n    from . import dtc_detail\n    ecu = uds_mod.resolve_module(code, vin or None)\n    with link().session(f\"dtc_count {ecu.code}\", bus=_bus(ecu.bus_key), confirm=confirm,\n                        **kw) as sess:\n        return _stamp(sess, dtc_detail.dtc_count(sess, ecu, mask))\n\n\ndef module_read_all(code: str, vin: str = \"\", include_unverified: bool = True,\n                    confirm: bool = False, **kw: Any) -> dict[str, Any]:\n    \"\"\"Identity plus every catalogued identifier for one module, decoded where known.\"\"\"\n    from . import readall\n    ecu = uds_mod.resolve_module(code, vin or None)\n    with link().session(f\"read_all {ecu.code}\", bus=_bus(ecu.bus_key), confirm=confirm,\n                        **kw) as sess:\n        return _observe(sess, \"read_all\", readall.read_all(sess, ecu, include_unverified), vin)\n\n\ndef module_discover_dids(code: str, vin: str = \"\", ranges: Optional[list[str]] = None,\n                         max_dids: int = 2000, confirm: bool = False, **kw: Any\n                         ) -> dict[str, Any]:\n    \"\"\"Read-only 0x22 sweep for identifiers the catalogue does not know.\n\n    ``ranges`` like [\"F180-F1FF\", \"1000-10FF\"]; default is the module's conservative set.\n    \"\"\"\n    from . import readall\n    ecu = uds_mod.resolve_module(code, vin or None)\n    rng = None\n    if ranges:\n        rng = []\n        for r in ranges:\n            a, _, b = r.partition(\"-\")\n            rng.append((int(a, 16), int(b or a, 16)))\n    with link().session(f\"discover_dids {ecu.code}\", bus=_bus(ecu.bus_key), confirm=confirm,\n                        **kw) as sess:\n        args = {\"max_dids\": max_dids}\n        if rng is not None:\n            args[\"ranges\"] = rng\n        return _observe(sess, \"did_discovery\", readall.discover_dids(sess, ecu, **args), vin)\n\n\n# --- clearing (the one write): per module, evidence first --------------------------\n\ndef clear_module_dtcs(code: str, consent: str, vin: str = \"\", confirm: bool = False,\n                      group: str = \"FFFFFF\", override_speed_check: bool = False,\n                      **kw: Any) -> dict[str, Any]:\n    \"\"\"Clear one module's DTCs after capturing evidence. Not exposed over HTTP.\n\n    Refuses unless ``consent`` is exactly ``CLEAR <MODULE>``, the vehicle reads\n    stationary (or ``override_speed_check`` is set because speed cannot be read),\n    and, on CAN-CH, ``confirm`` is given.\n    \"\"\"\n    from . import clear as clear_mod\n    ecu = uds_mod.resolve_module(code, vin or None)\n    clear_mod.assert_clear_allowed(ecu.code, consent, group)   # fail fast, before any traffic\n    speed = None\n    try:\n        sp = obd_pid(\"0D\", **kw)\n        if sp.get(\"value\") is not None:\n            speed = float(sp[\"value\"])\n    except LiveError:\n        speed = None\n    if speed is None and not override_speed_check:\n        raise Refused(\"could not read vehicle speed; refusing to clear. Pass \"\n                      \"override_speed_check=True only if the car is stationary.\")\n    if speed:\n        raise Refused(f\"vehicle speed reads {speed:g} km/h; refusing to clear while moving\")\n    with link().session(f\"clear {ecu.code}\", bus=_bus(ecu.bus_key), confirm=confirm,\n                        **kw) as sess:\n        out = clear_mod.clear_module(sess, ecu, consent=consent, vin=vin, group=group,\n                                     evidence_extra={\"vehicle_speed_kmh\": speed})\n        return _stamp(sess, out)\n\n\n# --- passive learning from a dealer tool ---------------------------------------------\n\ndef learn_capture(bus: str = \"can_c\", seconds: float = 20.0, max_frames: int = 20000\n                  ) -> dict[str, Any]:\n    \"\"\"Passive capture while wiTECH reads; saves frames and the UDS transactions found.\"\"\"\n    import json as _json\n    from . import learn\n    from .config import state_dir\n    cap = capture(bus, seconds=seconds, max_frames=max_frames, include_frames=True)\n    frames = cap.get(\"frames\") or []\n    trans = learn.uds_transactions(frames)\n    d = state_dir() / \"captures\"\n    d.mkdir(parents=True, exist_ok=True)\n    name = f\"{datetime.now().strftime('%Y%m%d-%H%M%S')}_{bus}.json\"\n    (d / name).write_text(_json.dumps({\"bus\": bus, \"frames\": frames, \"transactions\": trans},\n                                      default=str), encoding=\"utf-8\")\n    dids = sorted({(t.get(\"target\"), t.get(\"did\")) for t in trans if t.get(\"did\")})\n    return {\"capture\": name, \"frames\": len(frames), \"transactions\": len(trans),\n            \"dids_seen\": [{\"target\": a, \"did\": b} for a, b in dids],\n            \"error\": cap.get(\"error\")}\n\n\ndef learn_correlate(capture_name: str, marks: list[dict[str, Any]]) -> dict[str, Any]:\n    \"\"\"Rank identifiers whose values track what the technician saw in wiTECH.\"\"\"\n    import json as _json\n    from . import learn\n    from .config import state_dir\n    p = state_dir() / \"captures\" / Path(capture_name).name\n    if not p.exists():\n        raise BadCommand(f\"no capture named {capture_name!r}\")\n    data = _json.loads(p.read_text(encoding=\"utf-8\"))\n    series = learn.did_series(data.get(\"transactions\") or [])\n    ranked = learn.correlate(series, marks)\n    return {\"capture\": p.name, \"candidates\": ranked[:15]}\n\n\ndef learn_accept(vin: str, module_code: str, did: str, name: str, field: dict[str, Any],\n                 scale: Optional[float] = None, offset: Optional[float] = None,\n                 unit: Optional[str] = None, evidence: Optional[Any] = None) -> dict[str, Any]:\n    from . import learned\n    return learned.accept(vin, module_code, did, name, field, scale=scale, offset=offset,\n                          unit=unit, evidence=evidence)\n\n\ndef learned_dids(vin: str = \"\") -> dict[str, Any]:\n    from . import learned\n    return {\"learned\": learned.learned(vin or None)}\n\n\n# --- whole-vehicle coverage ---------------------------------------------------\n\ndef coverage_status() -> dict[str, Any]:\n    from . import coverage\n    return coverage.status()\n\n\ndef coverage_start(vin: str, engine_running: Optional[bool] = None) -> dict[str, Any]:\n    from . import coverage\n    return coverage.start(vin, engine_running=engine_running)\n\n\ndef coverage_run(key: str, confirm: bool = False, seconds: float = 3.0,\n                 discover: Optional[bool] = None) -> dict[str, Any]:\n    import sys\n    from . import coverage\n    return coverage.run_pass(key, ops=sys.modules[__name__], confirm=confirm,\n                             seconds=seconds, discover=discover)\n\n\ndef coverage_skip(key: str, reason: str = \"\") -> dict[str, Any]:\n    from . import coverage\n    return coverage.skip_pass(key, reason)\n\n\ndef coverage_report() -> dict[str, Any]:\n    from . import coverage\n    return coverage.report()\n\n\ndef coverage_reset() -> dict[str, Any]:\n    from . import coverage\n    return coverage.reset()\n\n\n# --- actuator tests: learned from a dealer tool, replayed under strict guards -----\n\ndef learn_actuator(capture_name: str, module: str, name: str, tool: str = \"MES\") -> dict[str, Any]:\n    \"\"\"Extract a replayable procedure for one module's actuator test from a saved capture.\n\n    ``capture_name`` is a file :func:`learn_capture` wrote, under\n    ``state_dir()/captures``. Pure offline parsing -- the adapter is never\n    opened. The module's target byte is taken from this VIN's confirmed\n    address if one is on record (``link().vin``), else the registry target.\n    \"\"\"\n    import json as _json\n    from . import actuate\n    p = state_dir() / \"captures\" / Path(capture_name).name\n    if not p.exists():\n        raise BadCommand(f\"no capture named {capture_name!r}\")\n    data = _json.loads(p.read_text(encoding=\"utf-8\"))\n    ecu = by_code(module.upper())\n    if ecu is None:\n        raise BadCommand(f\"unknown module code {module!r}\")\n    vin = link().vin or \"\"\n    target = store.confirmed_targets(vin).get(ecu.code) if vin else None\n    if target is None:\n        target = ecu.target\n    if target is None:\n        raise BadCommand(f\"module {ecu.code} has no known address; run discovery first\")\n    procedure = actuate.extract_procedure(data.get(\"transactions\") or [], f\"{target:02X}\")\n    return actuate.save_actuator(vin, ecu.code, name, procedure, source=p.name, tool=tool)\n\n\ndef actuators(vin: str = \"\") -> dict[str, Any]:\n    from . import actuate\n    return {\"actuators\": actuate.list_actuators(vin or None)}\n\n\ndef run_actuator(vin: str, module: str, name: str, consent: str, max_seconds: float = 10.0,\n                 confirm: bool = False, **kw: Any) -> dict[str, Any]:\n    \"\"\"Replay a learned actuator test (UDS 0x2F/0x31) on one module. Not exposed over HTTP.\n\n    Refuses unless ``consent`` is exactly ``ACTUATE <MODULE> <NAME>``, the module is not\n    safety-critical (:data:`safety.ACTUATION_BLOCKED_MODULES`, or anything on CAN-CH --\n    use MultiEcuScan or wiTECH for those), the learned procedure is replayable (no\n    SecurityAccess, no configuration/reflash/reset service), and the vehicle reads\n    engine-off and stationary (PID 0C then 0D on the legislated route; unreadable refuses\n    too). Bounded to ``max_seconds`` (hard cap 30 s); control is ALWAYS returned to the\n    ECU afterwards, even if a step fails.\n    \"\"\"\n    from . import actuate\n    ecu = uds_mod.resolve_module(module, vin or None)\n    procedure = actuate.get_actuator(vin, ecu.code, name)\n    actuate.assert_actuate_allowed(ecu, procedure, consent, name)   # fail fast, before any traffic\n\n    def _reading(pid: str) -> Optional[float]:\n        try:\n            r = obd_pid(pid, **kw)\n        except LiveError:\n            return None\n        return float(r[\"value\"]) if r.get(\"value\") is not None else None\n\n    rpm = _reading(\"0C\")\n    speed = _reading(\"0D\")\n    if rpm is None or speed is None:\n        raise Refused(\"could not read engine RPM and vehicle speed; refusing to actuate\")\n    if rpm > 0:\n        raise Refused(f\"engine is running ({rpm:g} rpm); refusing to actuate\")\n    if speed > 0:\n        raise Refused(f\"vehicle speed reads {speed:g} km/h; refusing to actuate\")\n\n    with link().session(f\"actuate {ecu.code} {name}\", bus=_bus(ecu.bus_key), confirm=confirm,\n                        **kw) as sess:\n        out = actuate.run_actuator(sess, ecu, procedure, consent=consent, max_seconds=max_seconds)\n        return _stamp(sess, out)\n\n\n__all__ = [\"observations\", \"status\", \"ports\", \"mes_settings\", \"set_cable\", \"cable_state\", \"buses\", \"modules\",\n           \"probe\", \"verify_bus\", \"capture\", \"obd_dtcs\", \"obd_all_dtcs\", \"obd_pid\",\n           \"obd_voltage\", \"obd_supported_pids\", \"obd_freeze_frame\", \"obd_vin\",\n           \"readiness_in\", \"obd_readiness\", \"module_dtcs\", \"module_identity\", \"module_did\",\n           \"scan_modules\", \"discover\", \"coverage_status\", \"coverage_start\", \"coverage_run\",\n           \"coverage_skip\", \"coverage_report\", \"coverage_reset\", \"repair_status\",\n           \"obd_mode06\", \"module_dtc_detail\", \"module_dtc_count\", \"clear_module_dtcs\",\n           \"module_read_all\", \"module_discover_dids\",\n           \"learn_capture\", \"learn_correlate\", \"learn_accept\", \"learned_dids\",\n           \"learn_actuator\", \"actuators\", \"run_actuator\",\n           \"AdapterLink\", \"link\", \"DEFAULT_TIMEOUT\"]\n\n\n# --- live-data engine: channel registry, poll sessions, alarms, recording -------\n#\n# Backend for a future dashboard UI. The poller (cuore.live.poller) owns one\n# adapter session for the whole run; everything here is a thin wrapper so the\n# HTTP routes and MCP tools share the same entry points as every other\n# operation in this file.\n\ndef live_channels() -> dict[str, Any]:\n    \"\"\"The channel registry (every PID/DID/computed/battery channel) and presets.\"\"\"\n    from . import channels as channels_mod\n    return {\"channels\": [c.to_dict() for c in channels_mod.available_channels()],\n            \"presets\": channels_mod.presets()}\n\n\ndef live_session_start(channels: Optional[list[str]] = None, preset: str = \"\",\n                       rates: Optional[dict[str, float]] = None, monitor_dtcs: bool = False,\n                       dtc_interval_s: float = 10.0) -> dict[str, Any]:\n    \"\"\"Start the live-data poll session on the given channels and/or preset.\n\n    Read-only (Mode 01, UDS 0x22, ATRV only) but holds the adapter for the\n    whole session: other live operations refuse while this runs (see the\n    guard below), and this itself refuses while MultiEcuScan is connected.\n\n    ``monitor_dtcs`` (MES's \"Monitor DTCs\" convention): every\n    ``dtc_interval_s`` seconds (minimum 5), the poller also reads Mode 03/07\n    between channel reads and reports any change -- see\n    :meth:`cuore.live.poller.LivePoller._poll_dtcs`.\n    \"\"\"\n    from . import channels as channels_mod\n    from . import poller as poller_mod\n    chans = channels_mod.resolve_channels(channels, preset)\n    return poller_mod.poller().start(chans, rates=rates, monitor_dtcs=monitor_dtcs,\n                                     dtc_interval_s=dtc_interval_s)\n\n\ndef live_session_stop() -> dict[str, Any]:\n    \"\"\"Stop the live-data poll session and release the adapter.\"\"\"\n    from . import poller as poller_mod\n    return poller_mod.poller().stop()\n\n\ndef live_session_status() -> dict[str, Any]:\n    \"\"\"Live-data session status: channels, configured and achieved rates, alarms.\"\"\"\n    from . import poller as poller_mod\n    return poller_mod.poller().status()\n\n\ndef live_snapshot() -> dict[str, Any]:\n    \"\"\"Latest value (and alarm state) of every channel in the running session.\"\"\"\n    from . import poller as poller_mod\n    return poller_mod.poller().snapshot()\n\n\ndef live_record_start() -> dict[str, Any]:\n    \"\"\"Start mirroring the running live session to an MES-format CSV recording.\"\"\"\n    from . import poller as poller_mod\n    return poller_mod.poller().start_recording()\n\n\ndef live_record_stop() -> dict[str, Any]:\n    \"\"\"Stop the live-session CSV recording.\"\"\"\n    from . import poller as poller_mod\n    return poller_mod.poller().stop_recording()\n\n\ndef live_set_alarm(channel: str, warn: Optional[float] = None, alarm: Optional[float] = None,\n                   direction: str = \"above\", hysteresis: float = 0.0) -> dict[str, Any]:\n    \"\"\"Set (or replace) a warn/alarm threshold on one channel of the live session.\"\"\"\n    from . import poller as poller_mod\n    return poller_mod.poller().set_alarm(channel, warn=warn, alarm=alarm, direction=direction,\n                                         hysteresis=hysteresis)\n\n\ndef live_stream_subscribe() -> Any:\n    \"\"\"A queue of ``{t, channel, value, unit, alarm}`` messages for the SSE route.\"\"\"\n    from . import poller as poller_mod\n    return poller_mod.poller().subscribe()\n\n\ndef live_stream_unsubscribe(q: Any) -> None:\n    from . import poller as poller_mod\n    poller_mod.poller().unsubscribe(q)\n\n\ndef live_stream_events(max_messages: Optional[int] = None):\n    \"\"\"Generator of live-session messages, or ``None`` as a keepalive placeholder.\n\n    A plain Python generator -- deliberately independent of FastAPI/ASGI --\n    so it is directly testable without an HTTP layer. The SSE route wraps\n    each yielded item into one ``data: ...`` (or ``: keepalive``) line.\n    ``max_messages`` bounds it for callers that want a finite read (tests);\n    the HTTP route leaves it unbounded and relies on the client disconnecting\n    to end iteration (handled by the ``finally`` unsubscribe below).\n    \"\"\"\n    import queue as _queue\n    from . import poller as poller_mod\n    q = poller_mod.poller().subscribe()\n    n = 0\n    try:\n        while max_messages is None or n < max_messages:\n            try:\n                yield q.get(timeout=15.0)\n                n += 1\n            except _queue.Empty:\n                yield None\n    finally:\n        poller_mod.poller().unsubscribe(q)\n\n\ndef _poller_active_guard() -> None:\n    \"\"\"Refuse with a clear message if the live-data poller holds the adapter.\n\n    A poll session holds one :class:`~cuore.live.transport.Session` open for\n    its whole run, so any of the ordinary per-call operations below would\n    otherwise just block waiting for the adapter lock instead of failing\n    fast. Checked before the operation opens its own session.\n    \"\"\"\n    from . import poller as poller_mod\n    if poller_mod.poller().holds_adapter():\n        raise Refused(\"a live-data poll session is running and holds the adapter; stop it \"\n                      \"first (live_session_stop / POST /api/live/session/stop)\")\n\n\n#: Every operation here that opens its own adapter session, guarded against\n#: running while the live-data poller holds the port. Wrapping is applied\n#: below by name rather than editing each function in place.\n_POLLER_GUARDED = (\n    \"probe\", \"verify_bus\", \"capture\", \"obd_dtcs\", \"obd_all_dtcs\", \"obd_pid\", \"obd_voltage\",\n    \"obd_supported_pids\", \"obd_freeze_frame\", \"obd_vin\", \"obd_readiness\", \"module_dtcs\",\n    \"module_identity\", \"module_did\", \"scan_modules\", \"discover\", \"obd_mode06\",\n    \"module_dtc_detail\", \"module_dtc_count\", \"module_read_all\", \"module_discover_dids\",\n    \"clear_module_dtcs\", \"run_actuator\",\n)\n\n\ndef _guard_against_poller(fn):\n    def _wrapped(*args, **kwargs):\n        _poller_active_guard()\n        return fn(*args, **kwargs)\n    _wrapped.__name__ = getattr(fn, \"__name__\", \"wrapped\")\n    _wrapped.__doc__ = getattr(fn, \"__doc__\", None)\n    _wrapped.__wrapped__ = fn\n    return _wrapped\n\n\nfor _name in _POLLER_GUARDED:\n    globals()[_name] = _guard_against_poller(globals()[_name])\ndel _name\n\n\n__all__ += [\"live_channels\", \"live_session_start\", \"live_session_stop\", \"live_session_status\",\n           \"live_snapshot\", \"live_record_start\", \"live_record_stop\", \"live_set_alarm\",\n           \"live_stream_subscribe\", \"live_stream_unsubscribe\", \"live_stream_events\"]\n","numLines":990,"startLine":1,"totalLines":990}},"sourceToolAssistantUUID":"9d230204-56db-4496-9142-0ccb77c2d7c9","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
