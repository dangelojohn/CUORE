{"parentUuid":"6c3a5bc3-2546-4de9-971d-017d4d4bd6ab","isSidechain":true,"agentId":"a3d9a94747dce8021","message":{"model":"claude-sonnet-5","id":"msg_011CfotiUU7osPnvedYGFupW","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_011eXDVvDifNVX8ucTJC4ZSV","name":"Read","input":{"file_path":"C:\\Users\\User\\mcp-servers\\cuore\\tests\\check_api.py"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":4040,"cache_read_input_tokens":113118,"cache_creation":{"ephemeral_5m_input_tokens":4040,"ephemeral_1h_input_tokens":0},"output_tokens":7,"service_tier":"standard","inference_geo":"not_available"},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_011eXDVvDifNVX8ucTJC4ZSV":{"file_path":"C:\\Users\\User\\mcp-servers\\cuore\\tests\\check_api.py"}},"serverClassifierRequest":"aa65bd03-b80a-446f-96ec-95ac45a32c36","apiBlockIndex":1,"requestId":"req_011CfotiUCkLuzCinmCS8tzR","attributionAgent":"general-purpose","type":"assistant","uuid":"5f31c3a0-bdf8-42d4-a405-3b215cfb7555","timestamp":"2026-10-08T01:21:01.458Z","effort":"high","perTurnEffort":null,"userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
{"parentUuid":"5f31c3a0-bdf8-42d4-a405-3b215cfb7555","isSidechain":true,"promptId":"e075d260-d560-4582-beae-4cc64a501692","agentId":"a3d9a94747dce8021","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_011eXDVvDifNVX8ucTJC4ZSV","type":"tool_result","content":"1\t\"\"\"Corpus-backed smoke checks for the CUORE service.\n2\t\n3\tSame posture as ``mes-log-mcp/tests/*``: no mocks, no fixtures. The real MES\n4\tcorpus on this machine *is* the fixture, and the assertions pin facts that are\n5\talready established in it -- the chronic P0456 and its 26,500 km span, the\n6\t2026-08-27 clear that must not read as a healthy car, the two vehicles with\n7\treal logs.\n8\t\n9\tRun:\n10\t    .venv/Scripts/python.exe cuore/tests/check_api.py\n11\t\"\"\"\n12\t\n13\tfrom __future__ import annotations\n14\t\n15\timport sys\n16\tfrom pathlib import Path\n17\t\n18\tsys.path.insert(0, str(Path(__file__).resolve().parents[2]))\n19\t\n20\tfrom fastapi.testclient import TestClient  # noqa: E402\n21\t\n22\tfrom cuore.app import create_app  # noqa: E402\n23\tfrom cuore.services import mes_bridge  # noqa: E402\n24\tfrom cuore.services.errors import BridgeError  # noqa: E402\n25\t\n26\tVIN = \"ZASFAKPN5J7B88115\"          # the Stelvio -- 17 logs, all real\n27\tVIN_500L = \"ZFBCFABH1EZ020882\"     # the Fiat 500L -- 4 real logs\n28\t\n29\tfailures: list[str] = []\n30\tchecks = 0\n31\t\n32\t\n33\tdef check(label: str, condition: bool, detail: str = \"\") -> None:\n34\t    global checks\n35\t    checks += 1\n36\t    if not condition:\n37\t        failures.append(f\"{label}{(' -- ' + detail) if detail else ''}\")\n38\t\n39\t\n40\tclient = TestClient(create_app())\n41\t\n42\t\n43\t# --- the capability contract ---------------------------------------------\n44\t\n45\tcaps = client.get(\"/api/capabilities\")\n46\tcheck(\"capabilities responds\", caps.status_code == 200)\n47\tbody = caps.json()\n48\tcheck(\"profile is bench\", body[\"profile\"] == \"bench\", str(body.get(\"profile\")))\n49\tcheck(\"corpus advertised\", body[\"features\"][\"corpus\"] is True)\n50\tcheck(\"live_obd is a bool\", isinstance(body[\"features\"][\"live_obd\"], bool))\n51\tcheck(\"live_obd tracks adapter presence\",\n52\t      body[\"adapter\"][\"present\"] == body[\"features\"][\"live_obd\"],\n53\t      f\"adapter.present={body['adapter']['present']} live_obd={body['features']['live_obd']}\")\n54\tcheck(\"drive_recorder is False at P1\", body[\"features\"][\"drive_recorder\"] is False)\n55\tcheck(\"actuators is False at P1\", body[\"features\"][\"actuators\"] is False)\n56\tcheck(\"every declared feature is present in the payload\",\n57\t      set(body[\"features\"]) >= {\"corpus\", \"workup\", \"fault_tree\", \"verdict\",\n58\t                                \"live_obd\", \"live_can\", \"drive_recorder\"})\n59\tcheck(\"corpus counts are real\", body[\"corpus\"][\"total_logs\"] > 0,\n60\t      str(body[\"corpus\"][\"total_logs\"]))\n61\t\n62\t\n63\t# --- vehicles -------------------------------------------------------------\n64\t\n65\treal = client.get(\"/api/vehicles?real_only=true\").json()\n66\tvins = {v[\"vin\"] for v in real[\"vehicles\"]}\n67\tcheck(\"Stelvio present among real vehicles\", VIN in vins, str(vins))\n68\tcheck(\"500L present among real vehicles\", VIN_500L in vins, str(vins))\n69\tcheck(\"simulation pseudo-vehicles excluded\", \"5188214\" not in vins)\n70\t\n71\teverything = client.get(\"/api/vehicles\").json()\n72\tcheck(\"unfiltered list is larger than the real one\",\n73\t      everything[\"count\"] > real[\"count\"],\n74\t      f\"{everything['count']} vs {real['count']}\")\n75\t\n76\t\n77\t# --- the dossier ----------------------------------------------------------\n78\t\n79\td = client.get(f\"/api/vehicle/{VIN}\")\n80\tcheck(\"dossier responds\", d.status_code == 200)\n81\tdossier = d.json()\n82\tcheck(\"dossier names its blind spots\", len(dossier[\"blind_spots\"]) >= 3)\n83\tcheck(\"blind spots name the tool that closes each\",\n84\t      all(b.get(\"closes_it\") for b in dossier[\"blind_spots\"]))\n85\tcheck(\"provenance note present\", bool(dossier.get(\"provenance_note\")))\n86\t\n87\tchronic = {r[\"dtc\"] for r in dossier[\"history\"][\"chronic\"]}\n88\tcheck(\"P0456 classified chronic\", \"P0456-00\" in chronic, str(chronic))\n89\t\n90\tp0456 = next((r for r in dossier[\"history\"][\"chronic\"]\n91\t              if r[\"dtc\"] == \"P0456-00\"), None)\n92\tcheck(\"P0456 record found\", p0456 is not None)\n93\tif p0456:\n94\t    check(\"P0456 spans real distance, not one visit\",\n95\t          p0456.get(\"distance_span_km\", 0) > 20000,\n96\t          str(p0456.get(\"distance_span_km\")))\n97\t    check(\"P0456 first seen 2025-09-24\",\n98\t          p0456[\"first_seen\"].startswith(\"2025-09-24\"), p0456[\"first_seen\"])\n99\t    check(\"P0456 last seen no earlier than the 2026-08-27 clear\",\n100\t          p0456[\"last_seen\"] >= \"2026-08-27\", p0456[\"last_seen\"])\n101\t\n102\t# The whole point of the clear assessment: silence after an erase is not a\n103\t# repair. If this ever starts reading as a clean bill of health, the tool has\n104\t# become dangerous rather than merely wrong.\n105\tclear = dossier[\"current_picture\"].get(\"clear_assessment\")\n106\tcheck(\"clear assessment present\", clear is not None)\n107\tif clear:\n108\t    verdict_text = clear[\"verdict\"].lower()\n109\t    check(\"a clear is not reported as proof of repair\",\n110\t          \"not proof\" in verdict_text or \"carries no information\" in verdict_text,\n111\t          clear[\"verdict\"][:90])\n112\t    check(\"clear assessment says what to do next\", bool(clear.get(\"next_step\")))\n113\t\n114\tscan = dossier[\"current_picture\"].get(\"latest_scan\")\n115\tcheck(\"SCAN provenance is unverifiable, never clean\",\n116\t      scan is None or \"unverifiable\" in scan.get(\"provenance\", \"\"),\n117\t      str(scan.get(\"provenance\") if scan else None))\n118\t\n119\t\n120\t# --- codes ----------------------------------------------------------------\n121\t\n122\tdtcs = client.get(f\"/api/vehicle/{VIN}/dtcs\").json()\n123\tcheck(\"codes listed\", dtcs[\"count\"] > 0)\n124\tcheck(\"simulation excluded by default\", dtcs[\"simulation_included\"] is False)\n125\tcheck(\"every code carries an explicit severity\",\n126\t      all(\"severity\" in r for r in dtcs[\"dtcs\"]))\n127\tcheck(\"severity uses the known vocabulary\",\n128\t      {r[\"severity\"] for r in dtcs[\"dtcs\"]} <=\n129\t      {\"returned\", \"chronic\", \"cleared\", \"seen-once\", \"recurring\"},\n130\t      str({r[\"severity\"] for r in dtcs[\"dtcs\"]}))\n131\tcheck(\"chronic booleans survive serialisation\",\n132\t      any(r.get(\"chronic\") for r in dtcs[\"dtcs\"]))\n133\tcheck(\"returned-after-clear sorts before the rest\",\n134\t      not dtcs[\"dtcs\"] or dtcs[\"dtcs\"][0][\"severity\"] in (\"returned\", \"chronic\"),\n135\t      dtcs[\"dtcs\"][0][\"severity\"] if dtcs[\"dtcs\"] else \"\")\n136\t\n137\thist = client.get(f\"/api/vehicle/{VIN}/dtc/P0456\")\n138\tcheck(\"single code history responds\", hist.status_code == 200)\n139\tcheck(\"history matched P0456\",\n140\t      hist.json()[\"matches\"][0][\"dtc\"].startswith(\"P0456\"))\n141\t\n142\tcheck(\"unknown code is 404, not an empty 200\",\n143\t      client.get(f\"/api/vehicle/{VIN}/dtc/P9999\").status_code == 404)\n144\tcheck(\"unknown vehicle is 404\",\n145\t      client.get(\"/api/vehicle/NOSUCHVIN00000\").status_code == 404)\n146\t\n147\t\n148\t# --- fault tree and the gate ---------------------------------------------\n149\t\n150\ttree = client.get(f\"/api/vehicle/{VIN}/tree\").json()\n151\tcheck(\"a tree routes from the car's own codes\", bool(tree.get(\"trees\")),\n152\t      str(tree.get(\"error\")))\n153\tcheck(\"the tree is annotated with this car's evidence\",\n154\t      \"vehicle_evidence\" in tree)\n155\t\n156\tweak = client.post(f\"/api/vehicle/{VIN}/verdict\", json={\n157\t    \"codes\": \"P0456\", \"component\": \"purge valve\", \"mechanism\": \"\",\n158\t    \"measurements\": [], \"disconfirming_test\": \"\"})\n159\tcheck(\"gate accepts a submission\", weak.status_code == 200, weak.text[:120])\n160\twbody = weak.json()\n161\tcheck(\"a bare part name is NOT confirmed\", wbody[\"verdict\"] != \"CONFIRMED\",\n162\t      wbody.get(\"verdict\"))\n163\tcheck(\"gate names what is missing\", len(wbody[\"missing\"]) >= 3,\n164\t      str(wbody.get(\"missing\")))\n165\tcheck(\"gate gives a next test for each unmet criterion\",\n166\t      all(c.get(\"next_test\") for c in wbody[\"criteria\"].values()\n167\t          if not c[\"met\"]))\n168\tcheck(\"gate warns about the low-yield purge solenoid\",\n169\t      any(\"purge\" in w.lower() for w in wbody.get(\"component_warnings\", [])))\n170\t\n171\tcheck(\"gate refuses a submission with no codes\",\n172\t      client.post(f\"/api/vehicle/{VIN}/verdict\",\n173\t                  json={\"codes\": \"\"}).status_code == 400)\n174\t\n175\t# The HTML form is the surface with real user input and hand-rolled parsing of\n176\t# the parallel m_* fields, so it gets exercised separately from the JSON body.\n177\tform_weak = client.post(f\"/v/{VIN}/gate\", data={\n178\t    \"codes\": \"P0456\", \"component\": \"purge valve\", \"mechanism\": \"\",\n179\t    \"disconfirming_test\": \"\", \"m_type\": [\"actuator\"]})\n180\tcheck(\"gate form accepts a post\", form_weak.status_code == 200)\n181\tcheck(\"gate form refuses a bare part name\",\n182\t      \"NOT CONFIRMED\" in form_weak.text)\n183\t\n184\t# A case that should pass: a stated mechanism, an actuator citation the corpus\n185\t# can actually verify on this VIN, and a disconfirming test.\n186\tform_strong = client.post(f\"/v/{VIN}/gate\", data={\n187\t    \"codes\": \"P0456\",\n188\t    \"component\": \"EVAP canister\",\n189\t    \"mechanism\": (\"Saturated canister restricts the vent path so the \"\n190\t                  \"natural-vacuum test cannot pull the required depression \"\n191\t                  \"and the ECM logs a small leak.\"),\n192\t    \"disconfirming_test\": (\"Actuated the purge valve KOEO: it responds and \"\n193\t                           \"holds, so the valve is not the restriction.\"),\n194\t    \"m_type\": [\"actuator\"],\n195\t    \"m_operation_0\": \"Evaporation control valve\"})\n196\tcheck(\"gate form confirms a properly evidenced case\",\n197\t      \"CONFIRMED\" in form_strong.text\n198\t      and \"NOT CONFIRMED\" not in form_strong.text,\n199\t      \"the gate should pass a case with mechanism, a corpus-verified \"\n200\t      \"measurement and disconfirmation\")\n201\tcheck(\"measurement rows survive the m_* parsing\",\n202\t      \"Evaporation control valve\" in form_strong.text)\n203\t\n204\t\n205\t# --- path containment -----------------------------------------------------\n206\t# The security boundary. An earlier MCP version built paths by concatenation,\n207\t# which on Windows let both `..` and an absolute path escape the log root --\n208\t# every file the process could read was reachable. These must never pass.\n209\t\n210\tTRAVERSALS = [\n211\t    \"../../Windows/win.ini\",\n212\t    \"..\\\\..\\\\Windows\\\\win.ini\",      # backslash: a real separator on Windows\n213\t    \"C:\\\\Windows\\\\win.ini\",\n214\t    \"C:/Windows/win.ini\",\n215\t    \"/etc/passwd\",\n216\t    \"....//....//Windows/win.ini\",\n217\t    \"FESLog_..\\\\..\\\\..\\\\win.ini\",\n218\t    \"\",\n219\t]\n220\tfor candidate in TRAVERSALS:\n221\t    try:\n222\t        mes_bridge.read_log(candidate)\n223\t        failures.append(f\"CONTAINMENT BREACH: read_log accepted {candidate!r}\")\n224\t        checks += 1\n225\t    except BridgeError:\n226\t        checks += 1\n227\t    except Exception as exc:  # any refusal is acceptable; silence is not\n228\t        checks += 1\n229\t        if \"Traceback\" in str(exc):\n230\t            failures.append(f\"read_log({candidate!r}) failed oddly: {exc}\")\n231\t\n232\t# And over HTTP, where the router gets a say first.\n233\tfor candidate in [\"../../Windows/win.ini\", \"..%2F..%2FWindows%2Fwin.ini\",\n234\t                  \"..%5C..%5CWindows%5Cwin.ini\", \"C:/Windows/win.ini\"]:\n235\t    status = client.get(f\"/api/log/{candidate}\").status_code\n236\t    check(f\"HTTP rejects {candidate}\", status in (400, 404), str(status))\n237\t\n238\t# A legitimate read still works -- containment that blocks everything is easy\n239\t# and useless.\n240\tnewest = client.get(f\"/api/logs?vin={VIN}&limit=1\").json()[\"logs\"][0][\"file\"]\n241\tgood = client.get(f\"/api/log/{newest}\")\n242\tcheck(\"a real log still reads\", good.status_code == 200, good.text[:120])\n243\tcheck(\"the log carries its decoded text\", bool(good.json().get(\"text\")))\n244\t\n245\t\n246\t# --- pages render ---------------------------------------------------------\n247\t\n248\tPAGES = [\n249\t    \"/\", f\"/v/{VIN}\", f\"/v/{VIN}/codes\", f\"/v/{VIN}/code/P0456\",\n250\t    f\"/v/{VIN}/tree\", f\"/v/{VIN}/gate\", f\"/v/{VIN}/codes?include_simulation=true\",\n251\t    f\"/v/{VIN_500L}\", f\"/v/{VIN_500L}/codes\", f\"/v/{VIN_500L}/tree\",\n252\t    \"/modules\", \"/recordings\", \"/logs\", f\"/logs?vin={VIN}\",\n253\t]\n254\tfor page in PAGES:\n255\t    resp = client.get(page)\n256\t    check(f\"page {page} renders\", resp.status_code == 200, str(resp.status_code))\n257\t    if resp.status_code == 200:\n258\t        check(f\"page {page} is HTML\", \"<html\" in resp.text.lower())\n259\t\n260\tbad_page = client.get(\"/v/NOSUCHVIN00000\")\n261\tcheck(\"a bad VIN gets a page, not raw JSON\", bad_page.status_code == 404)\n262\tcheck(\"the error page is HTML\", \"<html\" in bad_page.text.lower())\n263\t\n264\t\n265\t# --- auth -----------------------------------------------------------------\n266\t\n267\tfrom cuore.config import Settings  # noqa: E402\n268\t\n269\tguarded = TestClient(create_app(Settings(token=\"s3cret\")))\n270\tcheck(\"token enforced when configured\",\n271\t      guarded.get(\"/api/capabilities\").status_code == 401)\n272\tcheck(\"correct token in header accepted\",\n273\t      guarded.get(\"/api/capabilities\",\n274\t                  headers={\"X-Cuore-Token\": \"s3cret\"}).status_code == 200)\n275\tcheck(\"correct token in query accepted\",\n276\t      guarded.get(\"/api/capabilities?token=s3cret\").status_code == 200)\n277\tcheck(\"wrong token rejected\",\n278\t      guarded.get(\"/api/capabilities?token=nope\").status_code == 401)\n279\t\n280\t\n281\t# --- report ---------------------------------------------------------------\n282\t\n283\tprint(f\"checks run: {checks}\")\n284\tif failures:\n285\t    print(f\"FAILURES: {len(failures)}\")\n286\t    for f in failures:\n287\t        print(\"  -\", f)\n288\t    sys.exit(1)\n289\tprint(\"all green\")\n290\t"}]},"uuid":"f20fdb8a-968a-49b6-8abc-d605ce836683","timestamp":"2026-10-08T01:21:01.488Z","toolUseResult":{"type":"text","file":{"filePath":"C:\\Users\\User\\mcp-servers\\cuore\\tests\\check_api.py","content":"\"\"\"Corpus-backed smoke checks for the CUORE service.\n\nSame posture as ``mes-log-mcp/tests/*``: no mocks, no fixtures. The real MES\ncorpus on this machine *is* the fixture, and the assertions pin facts that are\nalready established in it -- the chronic P0456 and its 26,500 km span, the\n2026-08-27 clear that must not read as a healthy car, the two vehicles with\nreal logs.\n\nRun:\n    .venv/Scripts/python.exe cuore/tests/check_api.py\n\"\"\"\n\nfrom __future__ import annotations\n\nimport sys\nfrom pathlib import Path\n\nsys.path.insert(0, str(Path(__file__).resolve().parents[2]))\n\nfrom fastapi.testclient import TestClient  # noqa: E402\n\nfrom cuore.app import create_app  # noqa: E402\nfrom cuore.services import mes_bridge  # noqa: E402\nfrom cuore.services.errors import BridgeError  # noqa: E402\n\nVIN = \"ZASFAKPN5J7B88115\"          # the Stelvio -- 17 logs, all real\nVIN_500L = \"ZFBCFABH1EZ020882\"     # the Fiat 500L -- 4 real logs\n\nfailures: list[str] = []\nchecks = 0\n\n\ndef check(label: str, condition: bool, detail: str = \"\") -> None:\n    global checks\n    checks += 1\n    if not condition:\n        failures.append(f\"{label}{(' -- ' + detail) if detail else ''}\")\n\n\nclient = TestClient(create_app())\n\n\n# --- the capability contract ---------------------------------------------\n\ncaps = client.get(\"/api/capabilities\")\ncheck(\"capabilities responds\", caps.status_code == 200)\nbody = caps.json()\ncheck(\"profile is bench\", body[\"profile\"] == \"bench\", str(body.get(\"profile\")))\ncheck(\"corpus advertised\", body[\"features\"][\"corpus\"] is True)\ncheck(\"live_obd is a bool\", isinstance(body[\"features\"][\"live_obd\"], bool))\ncheck(\"live_obd tracks adapter presence\",\n      body[\"adapter\"][\"present\"] == body[\"features\"][\"live_obd\"],\n      f\"adapter.present={body['adapter']['present']} live_obd={body['features']['live_obd']}\")\ncheck(\"drive_recorder is False at P1\", body[\"features\"][\"drive_recorder\"] is False)\ncheck(\"actuators is False at P1\", body[\"features\"][\"actuators\"] is False)\ncheck(\"every declared feature is present in the payload\",\n      set(body[\"features\"]) >= {\"corpus\", \"workup\", \"fault_tree\", \"verdict\",\n                                \"live_obd\", \"live_can\", \"drive_recorder\"})\ncheck(\"corpus counts are real\", body[\"corpus\"][\"total_logs\"] > 0,\n      str(body[\"corpus\"][\"total_logs\"]))\n\n\n# --- vehicles -------------------------------------------------------------\n\nreal = client.get(\"/api/vehicles?real_only=true\").json()\nvins = {v[\"vin\"] for v in real[\"vehicles\"]}\ncheck(\"Stelvio present among real vehicles\", VIN in vins, str(vins))\ncheck(\"500L present among real vehicles\", VIN_500L in vins, str(vins))\ncheck(\"simulation pseudo-vehicles excluded\", \"5188214\" not in vins)\n\neverything = client.get(\"/api/vehicles\").json()\ncheck(\"unfiltered list is larger than the real one\",\n      everything[\"count\"] > real[\"count\"],\n      f\"{everything['count']} vs {real['count']}\")\n\n\n# --- the dossier ----------------------------------------------------------\n\nd = client.get(f\"/api/vehicle/{VIN}\")\ncheck(\"dossier responds\", d.status_code == 200)\ndossier = d.json()\ncheck(\"dossier names its blind spots\", len(dossier[\"blind_spots\"]) >= 3)\ncheck(\"blind spots name the tool that closes each\",\n      all(b.get(\"closes_it\") for b in dossier[\"blind_spots\"]))\ncheck(\"provenance note present\", bool(dossier.get(\"provenance_note\")))\n\nchronic = {r[\"dtc\"] for r in dossier[\"history\"][\"chronic\"]}\ncheck(\"P0456 classified chronic\", \"P0456-00\" in chronic, str(chronic))\n\np0456 = next((r for r in dossier[\"history\"][\"chronic\"]\n              if r[\"dtc\"] == \"P0456-00\"), None)\ncheck(\"P0456 record found\", p0456 is not None)\nif p0456:\n    check(\"P0456 spans real distance, not one visit\",\n          p0456.get(\"distance_span_km\", 0) > 20000,\n          str(p0456.get(\"distance_span_km\")))\n    check(\"P0456 first seen 2025-09-24\",\n          p0456[\"first_seen\"].startswith(\"2025-09-24\"), p0456[\"first_seen\"])\n    check(\"P0456 last seen no earlier than the 2026-08-27 clear\",\n          p0456[\"last_seen\"] >= \"2026-08-27\", p0456[\"last_seen\"])\n\n# The whole point of the clear assessment: silence after an erase is not a\n# repair. If this ever starts reading as a clean bill of health, the tool has\n# become dangerous rather than merely wrong.\nclear = dossier[\"current_picture\"].get(\"clear_assessment\")\ncheck(\"clear assessment present\", clear is not None)\nif clear:\n    verdict_text = clear[\"verdict\"].lower()\n    check(\"a clear is not reported as proof of repair\",\n          \"not proof\" in verdict_text or \"carries no information\" in verdict_text,\n          clear[\"verdict\"][:90])\n    check(\"clear assessment says what to do next\", bool(clear.get(\"next_step\")))\n\nscan = dossier[\"current_picture\"].get(\"latest_scan\")\ncheck(\"SCAN provenance is unverifiable, never clean\",\n      scan is None or \"unverifiable\" in scan.get(\"provenance\", \"\"),\n      str(scan.get(\"provenance\") if scan else None))\n\n\n# --- codes ----------------------------------------------------------------\n\ndtcs = client.get(f\"/api/vehicle/{VIN}/dtcs\").json()\ncheck(\"codes listed\", dtcs[\"count\"] > 0)\ncheck(\"simulation excluded by default\", dtcs[\"simulation_included\"] is False)\ncheck(\"every code carries an explicit severity\",\n      all(\"severity\" in r for r in dtcs[\"dtcs\"]))\ncheck(\"severity uses the known vocabulary\",\n      {r[\"severity\"] for r in dtcs[\"dtcs\"]} <=\n      {\"returned\", \"chronic\", \"cleared\", \"seen-once\", \"recurring\"},\n      str({r[\"severity\"] for r in dtcs[\"dtcs\"]}))\ncheck(\"chronic booleans survive serialisation\",\n      any(r.get(\"chronic\") for r in dtcs[\"dtcs\"]))\ncheck(\"returned-after-clear sorts before the rest\",\n      not dtcs[\"dtcs\"] or dtcs[\"dtcs\"][0][\"severity\"] in (\"returned\", \"chronic\"),\n      dtcs[\"dtcs\"][0][\"severity\"] if dtcs[\"dtcs\"] else \"\")\n\nhist = client.get(f\"/api/vehicle/{VIN}/dtc/P0456\")\ncheck(\"single code history responds\", hist.status_code == 200)\ncheck(\"history matched P0456\",\n      hist.json()[\"matches\"][0][\"dtc\"].startswith(\"P0456\"))\n\ncheck(\"unknown code is 404, not an empty 200\",\n      client.get(f\"/api/vehicle/{VIN}/dtc/P9999\").status_code == 404)\ncheck(\"unknown vehicle is 404\",\n      client.get(\"/api/vehicle/NOSUCHVIN00000\").status_code == 404)\n\n\n# --- fault tree and the gate ---------------------------------------------\n\ntree = client.get(f\"/api/vehicle/{VIN}/tree\").json()\ncheck(\"a tree routes from the car's own codes\", bool(tree.get(\"trees\")),\n      str(tree.get(\"error\")))\ncheck(\"the tree is annotated with this car's evidence\",\n      \"vehicle_evidence\" in tree)\n\nweak = client.post(f\"/api/vehicle/{VIN}/verdict\", json={\n    \"codes\": \"P0456\", \"component\": \"purge valve\", \"mechanism\": \"\",\n    \"measurements\": [], \"disconfirming_test\": \"\"})\ncheck(\"gate accepts a submission\", weak.status_code == 200, weak.text[:120])\nwbody = weak.json()\ncheck(\"a bare part name is NOT confirmed\", wbody[\"verdict\"] != \"CONFIRMED\",\n      wbody.get(\"verdict\"))\ncheck(\"gate names what is missing\", len(wbody[\"missing\"]) >= 3,\n      str(wbody.get(\"missing\")))\ncheck(\"gate gives a next test for each unmet criterion\",\n      all(c.get(\"next_test\") for c in wbody[\"criteria\"].values()\n          if not c[\"met\"]))\ncheck(\"gate warns about the low-yield purge solenoid\",\n      any(\"purge\" in w.lower() for w in wbody.get(\"component_warnings\", [])))\n\ncheck(\"gate refuses a submission with no codes\",\n      client.post(f\"/api/vehicle/{VIN}/verdict\",\n                  json={\"codes\": \"\"}).status_code == 400)\n\n# The HTML form is the surface with real user input and hand-rolled parsing of\n# the parallel m_* fields, so it gets exercised separately from the JSON body.\nform_weak = client.post(f\"/v/{VIN}/gate\", data={\n    \"codes\": \"P0456\", \"component\": \"purge valve\", \"mechanism\": \"\",\n    \"disconfirming_test\": \"\", \"m_type\": [\"actuator\"]})\ncheck(\"gate form accepts a post\", form_weak.status_code == 200)\ncheck(\"gate form refuses a bare part name\",\n      \"NOT CONFIRMED\" in form_weak.text)\n\n# A case that should pass: a stated mechanism, an actuator citation the corpus\n# can actually verify on this VIN, and a disconfirming test.\nform_strong = client.post(f\"/v/{VIN}/gate\", data={\n    \"codes\": \"P0456\",\n    \"component\": \"EVAP canister\",\n    \"mechanism\": (\"Saturated canister restricts the vent path so the \"\n                  \"natural-vacuum test cannot pull the required depression \"\n                  \"and the ECM logs a small leak.\"),\n    \"disconfirming_test\": (\"Actuated the purge valve KOEO: it responds and \"\n                           \"holds, so the valve is not the restriction.\"),\n    \"m_type\": [\"actuator\"],\n    \"m_operation_0\": \"Evaporation control valve\"})\ncheck(\"gate form confirms a properly evidenced case\",\n      \"CONFIRMED\" in form_strong.text\n      and \"NOT CONFIRMED\" not in form_strong.text,\n      \"the gate should pass a case with mechanism, a corpus-verified \"\n      \"measurement and disconfirmation\")\ncheck(\"measurement rows survive the m_* parsing\",\n      \"Evaporation control valve\" in form_strong.text)\n\n\n# --- path containment -----------------------------------------------------\n# The security boundary. An earlier MCP version built paths by concatenation,\n# which on Windows let both `..` and an absolute path escape the log root --\n# every file the process could read was reachable. These must never pass.\n\nTRAVERSALS = [\n    \"../../Windows/win.ini\",\n    \"..\\\\..\\\\Windows\\\\win.ini\",      # backslash: a real separator on Windows\n    \"C:\\\\Windows\\\\win.ini\",\n    \"C:/Windows/win.ini\",\n    \"/etc/passwd\",\n    \"....//....//Windows/win.ini\",\n    \"FESLog_..\\\\..\\\\..\\\\win.ini\",\n    \"\",\n]\nfor candidate in TRAVERSALS:\n    try:\n        mes_bridge.read_log(candidate)\n        failures.append(f\"CONTAINMENT BREACH: read_log accepted {candidate!r}\")\n        checks += 1\n    except BridgeError:\n        checks += 1\n    except Exception as exc:  # any refusal is acceptable; silence is not\n        checks += 1\n        if \"Traceback\" in str(exc):\n            failures.append(f\"read_log({candidate!r}) failed oddly: {exc}\")\n\n# And over HTTP, where the router gets a say first.\nfor candidate in [\"../../Windows/win.ini\", \"..%2F..%2FWindows%2Fwin.ini\",\n                  \"..%5C..%5CWindows%5Cwin.ini\", \"C:/Windows/win.ini\"]:\n    status = client.get(f\"/api/log/{candidate}\").status_code\n    check(f\"HTTP rejects {candidate}\", status in (400, 404), str(status))\n\n# A legitimate read still works -- containment that blocks everything is easy\n# and useless.\nnewest = client.get(f\"/api/logs?vin={VIN}&limit=1\").json()[\"logs\"][0][\"file\"]\ngood = client.get(f\"/api/log/{newest}\")\ncheck(\"a real log still reads\", good.status_code == 200, good.text[:120])\ncheck(\"the log carries its decoded text\", bool(good.json().get(\"text\")))\n\n\n# --- pages render ---------------------------------------------------------\n\nPAGES = [\n    \"/\", f\"/v/{VIN}\", f\"/v/{VIN}/codes\", f\"/v/{VIN}/code/P0456\",\n    f\"/v/{VIN}/tree\", f\"/v/{VIN}/gate\", f\"/v/{VIN}/codes?include_simulation=true\",\n    f\"/v/{VIN_500L}\", f\"/v/{VIN_500L}/codes\", f\"/v/{VIN_500L}/tree\",\n    \"/modules\", \"/recordings\", \"/logs\", f\"/logs?vin={VIN}\",\n]\nfor page in PAGES:\n    resp = client.get(page)\n    check(f\"page {page} renders\", resp.status_code == 200, str(resp.status_code))\n    if resp.status_code == 200:\n        check(f\"page {page} is HTML\", \"<html\" in resp.text.lower())\n\nbad_page = client.get(\"/v/NOSUCHVIN00000\")\ncheck(\"a bad VIN gets a page, not raw JSON\", bad_page.status_code == 404)\ncheck(\"the error page is HTML\", \"<html\" in bad_page.text.lower())\n\n\n# --- auth -----------------------------------------------------------------\n\nfrom cuore.config import Settings  # noqa: E402\n\nguarded = TestClient(create_app(Settings(token=\"s3cret\")))\ncheck(\"token enforced when configured\",\n      guarded.get(\"/api/capabilities\").status_code == 401)\ncheck(\"correct token in header accepted\",\n      guarded.get(\"/api/capabilities\",\n                  headers={\"X-Cuore-Token\": \"s3cret\"}).status_code == 200)\ncheck(\"correct token in query accepted\",\n      guarded.get(\"/api/capabilities?token=s3cret\").status_code == 200)\ncheck(\"wrong token rejected\",\n      guarded.get(\"/api/capabilities?token=nope\").status_code == 401)\n\n\n# --- report ---------------------------------------------------------------\n\nprint(f\"checks run: {checks}\")\nif failures:\n    print(f\"FAILURES: {len(failures)}\")\n    for f in failures:\n        print(\"  -\", f)\n    sys.exit(1)\nprint(\"all green\")\n","numLines":290,"startLine":1,"totalLines":290}},"sourceToolAssistantUUID":"5f31c3a0-bdf8-42d4-a405-3b215cfb7555","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
