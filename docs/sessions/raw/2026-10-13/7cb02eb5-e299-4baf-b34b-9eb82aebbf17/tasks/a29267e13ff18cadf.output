before this.\n\n   Two states get marked, and they can differ: `.on` is the tab the\n   browser is actually showing (the same `tab == \"...\"` check _vbar.html\n   always used); `.flow-current-tab` is whichever tab the flow service\n   thinks is the mechanic's current step, from the same `flow_state_for`\n   Jinja global _flow_bar.html reads (degrades to \"nothing highlighted\"\n   with no error if that service isn't wired up yet or has no opinion on\n   this VIN). #}\n{# Mechanic-UX review item 4: the Bench landing page (another agent's\n   build, at /v/{vin}) is now the primary tab -- Job, Codes, Live, Systems,\n   Report ride alongside it; the old dossier (same template, moved to\n   /v/{vin}/dossier) drops into More. Live board was promoted out of More\n   and into this visible row (after Codes) per the 2026-10-08 UX pass --\n   six tabs now stay visible on a phone-width strip. #}\n{% set _visible = (\"bench\", \"job\", \"codes\", \"liveboard\", \"tests\", \"systems\", \"report\", \"mobile\") %}\n{% set _more = (\"dossier\", \"modules\", \"timeline\", \"gauges\", \"electrical\", \"parts\", \"media\",\n                 \"service-hub\", \"tree\", \"gate\", \"inbox\", \"labels\", \"logs\", \"dashboard\", \"scans\") %}\n{% set flow = flow_state_for(bar.vin) if flow_state_for is defined else none %}\n{% set _flow_key = (flow.steps|selectattr(\"n\", \"equalto\", flow.current)|map(attribute=\"key\")|first)\n                    if flow and flow.steps else none %}\n{# Only treat it as a highlight if it actually names one of this strip's\n   tabs -- a flow step with no tab of its own (e.g. a \"tests\" step that\n   lives inside the Job page's own stepper) must not force the More menu\n   open for nothing. #}\n{% set flow_tab_key = _flow_key if (_flow_key in _visible or _flow_key in _more) else none %}\n{% set _fb_open = feedback_open_count(bar.vin) if feedback_open_count is defined else 0 %}\n\n{# This strip is also rendered by check_flow_bar.py against a bare\n   jinja2.Environment with no i18n globals registered -- `_lbl` falls back\n   to the plain English label (the same text that test's own\n   VISIBLE_LABELS/\">Dashboard<\"/\">Labels<\" checks expect) whenever `t`\n   isn't available, and uses the real translation whenever it is. #}\n{% macro _lbl(key, fallback) -%}\n{%- if t is defined -%}{{ t(key) }}{%- else -%}{{ fallback }}{%- endif -%}\n{%- endmacro %}\n\n{% macro vtab(key, href, label, badge=\"\") -%}\n<a href=\"{{ href }}\" class=\"{{ 'on' if tab == key }}{{ ' flow-current-tab' if flow_tab_key == key }}\">{{ label }}{{ badge|safe }}</a>\n{%- endmacro %}\n\n<div class=\"vtabs\">\n  {{ vtab(\"bench\", \"/v/\" + bar.vin, _lbl(\"bench\", \"Bench\")) }}\n  {{ vtab(\"job\", \"/v/\" + bar.vin + \"/job\", _lbl(\"job\", \"Job\")) }}\n  {{ vtab(\"codes\", \"/v/\" + bar.vin + \"/codes\", _lbl(\"codes\", \"Codes\")) }}\n  {{ vtab(\"liveboard\", \"/v/\" + bar.vin + \"/liveboard\", _lbl(\"live_board\", \"Live\")) }}\n  {{ vtab(\"tests\", \"/v/\" + bar.vin + \"/tests\", _lbl(\"tests\", \"Tests\")) }}\n  {{ vtab(\"systems\", \"/v/\" + bar.vin + \"/systems\", _lbl(\"systems\", \"Systems\")) }}\n  {{ vtab(\"report\", \"/v/\" + bar.vin + \"/report\", _lbl(\"report\", \"Report\")) }}\n  {{ vtab(\"mobile\", \"/m/\" + bar.vin, _lbl(\"mobile\", \"Mobile\")) }}\n\n  <details class=\"vmore-tab\"{% if flow_tab_key in _more %} open{% endif %}>\n    <summary aria-label=\"{{ _lbl('more_vehicle_tabs', 'More vehicle tabs') }}\" class=\"{{ 'on' if tab not in _visible }}{{ ' flow-has-current' if flow_tab_key in _more }}\">{{ _lbl(\"more\", \"More\") }}&hellip;</summary>\n    <div class=\"vmore-tab-panel\">\n      {{ vtab(\"dossier\", \"/v/\" + bar.vin + \"/dossier\", _lbl(\"dossier\", \"Dossier\")) }}\n      {{ vtab(\"modules\", \"/v/\" + bar.vin + \"/modules\", _lbl(\"modules\", \"Modules\")) }}\n      {{ vtab(\"timeline\", \"/v/\" + bar.vin + \"/timeline\", _lbl(\"timeline\", \"Timeline\")) }}\n      {{ vtab(\"gauges\", \"/v/\" + bar.vin + \"/gauges\", _lbl(\"gauges\", \"Gauges\")) }}\n      {{ vtab(\"electrical\", \"/v/\" + bar.vin + \"/electrical\", _lbl(\"electrical\", \"Electrical\")) }}\n      {{ vtab(\"parts\", \"/v/\" + bar.vin + \"/parts\", _lbl(\"parts\", \"Parts\")) }}\n      {{ vtab(\"media\", \"/v/\" + bar.vin + \"/media\", _lbl(\"media\", \"Media\")) }}\n      {{ vtab(\"service-hub\", \"/v/\" + bar.vin + \"/service-hub\", _lbl(\"service\", \"Service\")) }}\n      {{ vtab(\"tree\", \"/v/\" + bar.vin + \"/tree\", _lbl(\"fault_tree\", \"Fault tree\")) }}\n      {{ vtab(\"gate\", \"/v/\" + bar.vin + \"/gate\", _lbl(\"evidence_gate\", \"Evidence gate\")) }}\n      {{ vtab(\"inbox\", \"/v/\" + bar.vin + \"/inbox\", _lbl(\"inbox\", \"Inbox\"), (' <span class=\"chip chronic\">' + _fb_open|string + '</span>') if _fb_open else \"\") }}\n      {{ vtab(\"labels\", \"/v/\" + bar.vin + \"/labels\", _lbl(\"labels\", \"Labels\")) }}\n      {{ vtab(\"logs\", \"/logs?vin=\" + bar.vin, _lbl(\"logs\", \"Logs\")) }}\n      {{ vtab(\"dashboard\", \"/v/\" + bar.vin + \"/dashboard\", _lbl(\"dashboard\", \"Dashboard\")) }}\n      {# \"Tell CUORE\" (cuore/web/owner_routes.py) lives on its own /m/{vin}\n         phone-first layout, not under /v/{vin} -- so this is a plain link,\n         not a vtab() call (there is no \"tell-cuore\" vtab to highlight). #}\n      <a href=\"/m/{{ bar.vin }}\">Tell CUORE</a>\n    </div>\n  </details>\n</div>\n","structuredPatch":[{"oldStart":82,"oldLines":6,"newStart":82,"newLines":7,"lines":["       {{ vtab(\"inbox\", \"/v/\" + bar.vin + \"/inbox\", _lbl(\"inbox\", \"Inbox\"), (' <span class=\"chip chronic\">' + _fb_open|string + '</span>') if _fb_open else \"\") }}","       {{ vtab(\"labels\", \"/v/\" + bar.vin + \"/labels\", _lbl(\"labels\", \"Labels\")) }}","       {{ vtab(\"logs\", \"/logs?vin=\" + bar.vin, _lbl(\"logs\", \"Logs\")) }}","+      {{ vtab(\"scans\", \"/v/\" + bar.vin + \"/scans\", _lbl(\"scans\", \"Scans\")) }}","       {{ vtab(\"dashboard\", \"/v/\" + bar.vin + \"/dashboard\