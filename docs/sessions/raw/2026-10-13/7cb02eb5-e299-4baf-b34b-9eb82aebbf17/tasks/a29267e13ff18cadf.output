 mono\">{{ s.source.stream or \"unknown\" }}</td>\n        <td>\n          {% if s.mil is none %}<span class=\"chip plain\">&mdash;</span>\n          {% elif s.mil %}<span class=\"chip returned\">MIL on</span>\n          {% else %}<span class=\"chip ok\">MIL off</span>{% endif %}\n        </td>\n        <td>\n          {% for bucket in (\"stored\", \"pending\", \"permanent\") %}\n            {% for code in s.dtcs[bucket] %}\n              <span class=\"chip-code sm\" title=\"{{ bucket }}\">{{ code }}</span>\n            {% endfor %}\n          {% endfor %}\n          {% if not (s.dtcs.stored or s.dtcs.pending or s.dtcs.permanent) %}\n            <span class=\"small muted\">clean</span>\n          {% endif %}\n        </td>\n        <td class=\"n mono\">{{ s.counts.observations }}</td>\n      </tr>\n      {% endfor %}\n    </tbody>\n  </table>\n  </div>\n  {% endif %}\n</div>\n{% endblock %}\n","structuredPatch":[],"originalFile":null,"userModified":false},"serverClassifierContext":{"request":"f4fceddf-4b69-436b-ac89-c0eb5d362ce2","context":{"git_state":{"cwd":"/c/Users/User/mcp-servers","root":null,"branch":null,"default_branch":null,"status":null,"visibility":null,"error":"pending"},"live_cwd":"/c/Users/User/mcp-servers","platform":"windows"}},"sourceToolAssistantUUID":"87569cf4-9891-49e5-b99f-6c85a5ec6852","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
