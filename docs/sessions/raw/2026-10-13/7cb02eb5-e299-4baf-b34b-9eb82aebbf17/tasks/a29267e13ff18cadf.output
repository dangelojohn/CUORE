"The scan health report, as markdown\",","+           response_class=PlainTextResponse)","+def scan_health_markdown(vin: str, scan_id: str) -> str:","+    sid = None if scan_id == \"latest\" else scan_id","+    return scan_health_bridge.markdown(vin, sid)","+","+","+@router.post(\"/scans/{vin}/{scan_id}/health/save\",","+            summary=\"Write the report to disk (never over a hand-written file)\")","+def scan_health_save(vin: str, scan_id: str) -> dict[str, Any]:","+    sid = None if scan_id == \"latest\" else scan_id","+    return scan_health_bridge.save(vin, sid)","+","+","+__all__ = [\"router\"]"]}],"created":true}],"moreFiles":1,"changedFiles":["C:\\Users\\User\\mcp-servers\\cuore\\api\\scan_health.py","C:\\Users\\User\\mcp-servers\\cuore\\live\\mode06.py"],"shared":true}},"serverClassifierContext":{"request":"5f408365-7915-45ea-838d-58a68a27662b","context":{"git_state":{"cwd":"/c/Users/User/mcp-servers","root":null,"branch":null,"default_branch":null,"status":null,"visibility":null,"error":"pending"},"live_cwd":"/c/Users/User/mcp-servers","platform":"windows"}},"sourceToolAssistantUUID":"f1a61d09-b3da-46f1-bc24-f29b3b30d5a9","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
