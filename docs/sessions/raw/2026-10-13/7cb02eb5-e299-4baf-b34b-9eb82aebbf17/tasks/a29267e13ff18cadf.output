AN REPORT, then once per clear\nmes-log-mcp/mes/scan.py:28:omitted, so a SCAN log cannot distinguish \"not fitted\" from \"not responding\".\nmes-log-mcp/mes/scan.py:66:SCANNING_RE = re.compile(r\"^Scanning\\s*\\.{0,3}\\s*$\", re.I)\nmes-log-mcp/mes/scan.py:68:REPORT_TITLE = \"VEHICLE SCAN REPORT\"\nmes-log-mcp/mes/scan.py:76:PHASE_SCAN = \"scan\"\nmes-log-mcp/mes/scan.py:83:    \"\"\"One ECU as printed in one phase of a SCAN transcript.\"\"\"\nmes-log-mcp/mes/scan.py:95:    phase: str = PHASE_SCAN\nmes-log-mcp/mes/scan.py:166:        \"\"\"Why a SCAN log's authenticity can never be confirmed from content.\nmes-log-mcp/mes/scan.py:168:        FES logs announce simulation mode on line 5. SCAN logs have no header\nmes-log-mcp/mes/scan.py:173:        return \"unverifiable - SCAN logs carry no simulation marker\"\nmes-log-mcp/mes/scan.py:194:        primary = self.phase_entries(PHASE_SCAN)\nmes-log-mcp/mes/scan.py:274:    phase = PHASE_SCAN\nmes-log-mcp/mes/scan.py:285:        if SCANNING_RE.match(line) and saw_report:\nmes-log-mcp/mes/scan.py:292:def parse_scan_text(text: str, *, name: str = \"\", path: Path | None = None,\nmes-log-mcp/mes/scan.py:294:    \"\"\"Parse SCAN transcript text into a :class:`ScanLog`.\"\"\"\nmes-log-mcp/mes/scan.py:388:    log.phases_seen = phases or [PHASE_SCAN]\nmes-log-mcp/mes/scan.py:398:    \"\"\"Read and parse a SCAN log from disk.\"\"\"\nmes-log-mcp/mes/workup.py:27:    \"\"\"A clear done in an all-systems SCAN between the findings and the clean read.\nmes-log-mcp/mes/workup.py:30:    2026-09-25 the codes were read in a FES session at 20:02, erased by a SCAN\nmes-log-mcp/mes/workup.py:179:            \"provenance\": \"unverifiable (SCAN logs carry no simulation marker)\",","is_error":false}]},"uuid":"57589345-c844-4d69-b9ba-f2c274ad1f5a","timestamp":"2026-10-14T00:21:09.446Z","toolUseResult":{"stdout":"__init__.py\n__pycache__\nanalysis.py\ncases.py\ncatalog.py\ncode_feel.py\ncompact.py\ncompare.py\ncsvlog.py\ndashboard.py\ndealer.py\