 evap = next((m for m in monitors if m[\"monitor\"] == \"Evaporative system\"), None)\n236-    if evap is None:\n237-        return (\"This ECU does not report an evaporative system monitor.\"\n238-                if monitors else None)\n239-    if evap[\"complete\"]:\n240-        return (\"EVAP monitor has COMPLETED since the last clear; a clean scan is now \"\n241-                \"meaningful for EVAP.\")\n242-    return (\"EVAP monitor has NOT run since the last clear. Absence of an EVAP code right \"\n243-            \"now carries no information. Complete the drive cycle first.\")\n244-\n245-\n246-__all__ = [\"PID\", \"PIDS_BY_HEX\", \"PIDS_BY_NAME\", \"resolve_pid\", \"decode_pid\",\n247-           \"decode_supported_pids\", \"dtc_from_two_bytes\", \"decode_obd_dtcs\",","is_error":false}]},"uuid":"d8d79f2a-ceba-4d1d-b786-ae339e55160b","timestamp":"2026-10-14T00:21:35.013Z","toolUseResult":{"stdout":"197:def decode_readiness(pairs: list[str], response_byte: str = \"41\") -> Optional[dict[str, Any]]:\n198-    \"\"\"Decode a Mode 01 PID 01 / 41 payload; picks the layout from byte B bit 3.\"\"\"\n199-    idx = None\n200-    for i in range(len(pairs) - 1):\n201-        if pairs[i] == response_byte and pairs[i + 1] in (\"01\", \"41\"):\n202-            idx = i + 2\n203-            break\n204-    if idx is None:\n205-        return None\n206-    try:\n207-        data = [int(x, 16) for x in pairs[idx:idx + 4]]\n208-    except ValueError:\n209-        return None\n210-    if len(data) < 4:\n211-        return None\n212-    a, b, c, d = data\n213-    compression = bool(b & 0x08)\n214-    table = _COMPRESSION if compression else _SPARK\n215-    monitors: list[dict[str, Any]] = []\n216-    for sup_bit, inc_bit, name in _CONTINUOUS:\n217-        if b & (1 << sup_bit):\n218-            monitors.append({\"monitor\": name, \"supported\": True,\n219-                             \"complete\": not (b & (1 << inc_bit))})\n220-    for bit, name in table:\n221-        if name != \"