rial COM3@115200)\"}))\ncuore/tests/check_coverage.py:562:check(\"an untagged legacy read does not\", not store.is_from_car({}))\ncuore/tests/check_detail.py:138:store.observations_path().unlink(missing_ok=True)\ncuore/tests/check_dossier_view.py:207:live_store.record_observation(\"readiness\", readiness_payload, vin=VIN, stream=\"live-fake\")\ncuore/tests/check_dossier_view.py:212:live_store.record_observation(\"readiness\", readiness_payload, vin=VIN,\ncuore/tests/check_dossier_view.py:219:check(\"is_from_car rejects the synthetic non-serial stream\",\ncuore/tests/check_dossier_view.py:220:      not live_store.is_from_car({\"stream\": \"live-fake\"}))\ncuore/tests/check_dossier_view.py:221:check(\"is_from_car accepts a serial stream\",\ncuore/tests/check_dossier_view.py:222:      live_store.is_from_car({\"stream\": \"serial COM3@38400\"}))\ncuore/tests/check_flow.py:92:live_store.record_observation(\"scan\", {\"dtcs\": [\"P0455\"]}, vin=VIN_3,\ncuore/tests/check_flow.py:131:live_store.record_observation(\"scan\", {\"dtcs\": [\"P0455\"]}, vin=VIN_4,\ncuore/tests/check_live_data.py:527:          not store.is_from_car(latest_obs), str(latest_obs))\ncuore/tests/check_live_data.py:529:          store.is_from_car({**latest_obs, \"stream\": \"serial COM3@115200\"}))\ncuore/tests/check_live_readiness.py:255:check(\"is_from_car: real serial stream counts\",\ncuore/tests/check_live_readiness.py:256:      live_store.is_from_car({\"stream\": \"serial COM3@115200\"}))\ncuore/tests/check_live_readiness.py:257:check(\"is_from_car: a recording of a real serial session counts\",\ncuore/tests/check_live_readiness.py:258:      live_store.is_from_car({\"stream\": \"recording(serial COM3@115200)\"}))\ncuore/tests/check_live_readiness.py:259:check(\"is_from_car: demo source does not count\",\ncuore/tests/check_live_readiness.py:260:      not live_store.is_from_car({\"stream\": \"demo\"}))\ncuore/tests/check_live_readiness.py:261:check(\"is_from_car: replay source does not count\",\ncuore/tests/check_live_readiness.py:262:      not live_store.is_from_car({\"stream\": \"replay stelvio_evap_demo.csv\"}))\ncuore/tests/check_live_readiness.py:263:check(\"is_from_car: a scripted/test stream does not count\",\ncuore/tests/check_live_readiness.py:264:      not live_store.is_from_car({\"stream\": \"scripted\"}))\ncuore/tests/check_live_readiness.py:265:check(\"is_from_car: no stream at all does not count\",\ncuore/tests/check_live_readiness.py:266:      not live_store.is_from_car({}))\ncuore/tests/check_live_readiness.py:272:live_store.record_observation(","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"serverClassifierContext":{"request":"5f484c13-f437-48eb-ab8d-17255dcc5eac","context":{"git_state":{"cwd":"/c/Users/User/mcp-servers","root":null,"branch":null,"default_branch":null,"status":null,"visibility":null,"error":"pending"},"live_cwd":"/c/Users/User/mcp-servers","platform":"windows"}},"sourceToolAssistantUUID":"2d5740b7-5236-4a2f-9ed4-5c8b81c44f25","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
