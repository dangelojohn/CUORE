e.export(vin, scan_id, fmt)\n    if fmt == \"json\":\n        import json\n        body = json.dumps(result[\"content\"], default=str)\n    else:\n        body = result[\"content\"]\n    return Response(content=body, media_type=result[\"media_type\"],\n                    headers={\"Content-Disposition\": f'attachment; filename=\"{result[\"filename\"]}\"'})\n\n\n__all__ = [\"router\"]\n","structuredPatch":[],"originalFile":null,"userModified":false},"serverClassifierContext":{"request":"68736752-63c3-4051-978f-c44b8f9162b3","context":{"git_state":{"cwd":"/c/Users/User/mcp-servers","root":null,"branch":null,"default_branch":null,"status":null,"visibility":null,"error":"pending"},"live_cwd":"/c/Users/User/mcp-servers","platform":"windows"}},"sourceToolAssistantUUID":"9d6b83c2-1312-4063-a76b-f1b220fef034","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
