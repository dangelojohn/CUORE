{"parentUuid":"83557996-659d-497e-aac3-a5f506d7a7c7","isSidechain":true,"promptId":"4bcca3f7-854e-4f7c-b793-b6f8632fda0d","agentId":"a5bfbea9bff76655a","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01TXytTfvnv9csFczpqRJdHg","type":"tool_result","content":"650\t    \"\"\"Sourced tank capacity for this VIN (``mes.maintenance_specs`` /\n651\t    ``mes.service``), or ``None`` (UNKNOWN) -- this corpus carries no such\n652\t    spec today, so this always reads UNKNOWN in practice; kept as a real\n653\t    lookup (not a hardcoded None) so a future sourced spec picks it up for\n654\t    free.\"\"\"\n655\t    try:\n656\t        from mes import maintenance_specs  # local: optional, see module docstring\n657\t        getter = getattr(maintenance_specs, \"fuel_tank_capacity_l\", None)\n658\t        if callable(getter):\n659\t            return getter(vin)\n660\t    except Exception:  # noqa: BLE001\n661\t        pass\n662\t    return None\n663\t\n664\t\n665\tdef last_scan_summary(vin: str) -> dict[str, Any] | None:\n666\t    \"\"\"The Bench \"Last scan\" card (owner's guidance, 2026-10-13: \"we do not\n667\t    need many scans, just 10\" -- one guided scan per visit, about ten over\n668\t    a diagnosis): the newest scan on file for this VIN, by\n669\t    ``cuore.live.scanlog``'s own grouping (see that module's docstring for\n670\t    what a \"scan\" is and what makes one \"partial\"), shaped for the card --\n671\t    id, relative time, source adapter, codes by status, the coverage line,\n672\t    and the scan-plan chip. ``None`` when ``cuore.services.scanlog_bridge``\n673\t    is unavailable or no live scan is on file yet; the template then shows\n674\t    its own \"no scan yet\" line rather than fabricate a card.\n675\t\n676\t    Codes are grouped \"active\" (stored + permanent -- a fault the car is\n677\t    reporting right now) vs \"history\" (pending -- not yet confirmed) purely\n678\t    as a display grouping over the scan's own stored/pending/permanent\n679\t    buckets (``cuore.live.scanlog``'s OBD vocabulary); it invents no new\n680\t    DTC status of its own.\n681\t    \"\"\"\n682\t    if scanlog_bridge is None:\n683\t        return None\n684\t    try:\n685\t        scans = scanlog_bridge.list_scans(vin)[\"scans\"]  # newest first\n686\t    except Exception:  # noqa: BLE001 -- the bench must still render without it\n687\t        return None\n688\t    if not scans:\n689\t        return None\n690\t\n691\t    latest = scans[0]\n692\t    previous = scans[1] if len(scans) > 1 else None\n693\t    dtcs = latest.get(\"dtcs\") or {}\n694\t    active = sorted(set(dtcs.get(\"stored\") or []) | set(dtcs.get(\"permanent\") or []))\n695\t    history = sorted(dtcs.get(\"pending\") or [])\n696\t\n697\t    try:\n698\t        plan = scanlog_bridge.scan_plan(vin)\n699\t    except Exception:  # noqa: BLE001\n700\t        plan = {\"count\": len(scans), \"total\": 10}\n701\t\n702\t    return {\n703\t        \"id\": latest[\"id\"],\n704\t        \"relative\": _relative_time(latest.get(\"started\")) or latest.get(\"started\"),\n705\t        \"source\": (latest.get(\"source\") or {}).get(\"stream\") or \"unknown\",\n706\t        \"active_codes\": active,\n707\t        \"history_codes\": history,\n708\t        \"coverage_line\": (latest.get(\"coverage\") or {}).get(\"line\"),\n709\t        \"partial\": bool(latest.get(\"partial\")),\n710\t        \"plan\": plan,\n711\t        \"href\": f\"/v/{vin}/scans/{latest['id']}\",\n712\t        \"health_href\": f\"/v/{vin}/scans/{latest['id']}/health\",\n713\t        \"compare_href\": (f\"/v/{vin}/scans/diff?a={previous['id']}&b={latest['id']}\"\n714\t                        if previous else None),\n715\t    }\n716\t\n717\t\n718\tdef build_bench(vin: str) -> dict[str, Any]:\n719\t    \"\"\"Everything ``bench.html`` needs, computed once.\n720\t\n721\t    ``live_status`` is passed as ``None`` into ``dossier_bridge.build_view``\n722\t    -- the same choice ``flow_bridge.flow_state`` and\n723\t    ``shop_bridge._dossier_verdict`` already make from the service layer:\n724\t    it only affects whether the verdict's own action buttons render as\n725\t    enabled, never the verdict state itself (that comes from recorded\n726\t    observations), and the bench page does not render those buttons anyway.\n727\t    The bench's own precondition checks read a freshly computed live status\n728\t    instead (see :func:`_live_status`).\n729\t    \"\"\"\n730\t    vin = (vin or \"\").strip()\n731\t    if not vin:\n732\t        raise BadRequest(\"a VIN is required\")\n733\t\n734\t    mtime = mes_bridge.newest_mtime(vin)\n735\t    dossier = cache.get_or_build((\"workup\", vin, mtime), lambda: mes_bridge.workup(vin=vin))\n736\t    view = dossier_bridge.build_view(vin, dossier, None)\n737\t    identity = dossier.get(\"identity\") or {}\n738\t\n739\t    verdict_raw = view.get(\"verdict\") or {}\n740\t    verdict = {\n741\t        \"state\": verdict_raw.get(\"state\"),\n742\t        \"label\": verdict_raw.get(\"label\"),\n743\t        \"sentence\": verdict_raw.get(\"summary\"),\n744\t        \"next_action\": verdict_raw.get(\"next_action\"),\n745\t        \"blocker\": verdict_raw.get(\"blocker\"),\n746\t        \"basis\": verdict_raw.get(\"basis\") or [],\n747\t    }\n748\t\n749\t    codes = view.get(\"codes\") or []\n750\t    codes_by_base = {row[\"code\"]: row[\"status\"] for row in codes}\n751\t    open_work = view.get(\"open_work\") or []\n752\t    bulletins_by_id = {b[\"id\"]: b for b in view.get(\"bulletins\") or []}\n753\t    checklist = checklist_store.get(vin)\n754\t    live_status = _live_status()\n755\t    fuel_blocked = verdict[\"blocker\"] == \"fuel out of window\"\n756\t\n757\t    next_actions = _next_actions(vin, open_work, codes_by_base, checklist,\n758\t                                 live_status, fuel_blocked, bulletins_by_id, mtime)\n759\t    job_parts, job_tools = _hoist_shared(next_actions)\n760\t\n761\t    latest = view.get(\"latest\") or {}\n762\t    last_read = latest.get(\"session_short\") or latest.get(\"scan_short\")\n763\t\n764\t    cp = dossier.get(\"current_picture\") or {}\n765\t    scan_ts = (cp.get(\"latest_scan\") or {}).get(\"timestamp\")\n766\t    session_ts = (cp.get(\"latest_session\") or {}).get(\"timestamp\")\n767\t    newest_ts = max([t for t in (scan_ts, session_ts) if t], default=None)\n768\t    hours_since = _hours_since(newest_ts)\n769\t\n770\t    done_total = sum((c.get(\"progress\") or {}).get(\"done\", 0) for c in open_work)\n771\t    steps_total = sum((c.get(\"progress\") or {}).get(\"total\", 0) for c in open_work)\n772\t\n773\t    active_codes = sorted(r[\"code\"] for r in codes if r[\"status\"] == \"ACTIVE\")\n774\t    cleared_codes = sorted(r[\"code\"] for r in codes if r[\"status\"] == \"CLEARED_UNVERIFIED\")\n775\t    previous_visit = _record_visit(vin, {\n776\t        \"active_codes\": active_codes, \"cleared_codes\": cleared_codes,\n777\t        \"last_read\": last_read,\n778\t    })\n779\t    resume = {\n780\t        \"last_scan_relative\": _relative_time(newest_ts) or \"no scan on file\",\n781\t        \"last_scan_at\": newest_ts,\n782\t        \"changed\": _resume_changes(previous_visit, active_codes, cleared_codes, last_read),\n783\t        \"is_first_visit\": previous_visit is None,\n784\t        \"done\": done_total,\n785\t        \"total\": steps_total,\n786\t        \"next_action\": verdict[\"next_action\"],\n787\t    }\n788\t\n789\t    try:\n790\t        open_codes = mes_bridge.open_codes_for(dossier)\n791\t    except Exception:  # noqa: BLE001\n792\t        open_codes = []\n793\t\n794\t    return {\n795\t        \"vin\": vin,\n796\t        \"vehicle\": _vehicle_name(vin, dossier),\n797\t        \"vin_tail\": vin[-6:] if len(vin) >= 6 else vin,\n798\t        \"km\": identity.get(\"odometer_last_km\"),\n799\t        \"complaint\": _complaint(vin),\n800\t        \"verdict\": verdict,\n801\t        \"resume\": resume,\n802\t        \"progress\": {\"done\": done_total, \"total\": steps_total},\n803\t        \"scan_stale\": bool(hours_since is not None and hours_since > _STALE_HOURS),\n804\t        \"scan_hours_since\": hours_since,\n805\t        \"next_actions\": next_actions,\n806\t        \"job_parts\": job_parts,\n807\t        \"job_tools\": job_tools,\n808\t        \"open_codes_count\": (view.get(\"code_counts\") or {}).get(\"active\", 0),\n809\t        \"last_read\": last_read,\n810\t        \"shortcuts\": _shortcuts(vin, codes, open_work),\n811\t        \"legend\": _STATUS_LEGEND,\n812\t        \"case_hint\": _case_hint(vin, open_codes),\n813\t        \"fuel_gate\": _fuel_gate(vin, view.get(\"freeze_frames\") or []),\n814\t        \"readiness\": dossier_bridge.readiness_panel(vin, dossier),\n815\t        \"mode06\": view.get(\"mode06\"),\n816\t        \"live_status\": live_status,\n817\t        \"scanner_label\": scanner_label(live_status),\n818\t        \"blocker_banner\": _blocker_banner(verdict),\n819\t        \"last_scan\": last_scan_summary(vin),\n820\t    }\n821\t\n822\t\n823\t# --- regeneration hook: a brand-new live DTC must not be served a stale\n824\t#    cached next-action ---------------------------------------------------\n825\t\n826\t\n827\tdef regenerate_for_live_codes(vin: str) -> None:\n828\t    \"\"\"Called by ``cuore.services.systems_map_bridge`` (the Systems map's\n829\t    live overlay) the moment the live poller sees a code this VIN's own\n830\t    corpus-derived state did not carry yet, so Bench's next time it is\n831\t    asked is rebuilt rather than served the memoised ``(\"workup\", vin,\n832\t    mtime), ...`` entry from :func:`build_bench` -- the whole point is\n833\t    Bench, Job and Systems agreeing on the same new code, not three stale\n834\t    pictures of the car.\n835\t\n836\t    A brand-new live code has no backing MES log yet, so it never moves\n837\t    ``mes_bridge.newest_mtime(vin)`` -- the ordinary cache key\n838\t    :mod:`cuore.services.cache` builds on would not fall out on its own the\n839\t    way a new/edited log already does (see that module's own docstring).\n840\t    ``cache`` exposes no keyed delete, only \"drop everything\"\n841\t    (:func:`cuore.services.cache.clear`), which is exactly as cheap as the\n842\t    module's own docstring says it should be (at most 16 small entries, \"one\n843\t    or two vehicles someone is looking at\") -- so that is what this calls,\n844\t    for every vehicle, not just ``vin``. Never raises: a cache miss just\n845\t    means the next Bench/Job render costs one more rebuild, nothing\n846\t    user-visible breaks.\n847\t    \"\"\"\n848\t    try:\n849\t        cache.clear()\n850\t    except Exception:  # noqa: BLE001 -- a cache-regeneration hiccup must never surface\n851\t        pass\n852\t\n853\t\n854\t__all__ = [\"build_bench\", \"FAMILY_ICON\", \"LABELS\", \"scanner_label\",\n855\t          \"last_scan_summary\", \"regenerate_for_live_codes\"]\n856\t"}]},"uuid":"9cd18c6e-a542-47fe-aa75-a86aa0de69f8","timestamp":"2026-10-14T01:54:46.607Z","toolUseResult":{"type":"text","file":{"filePath":"C:/Users/User/mcp-servers/cuore/services/bench_bridge.py","content":"    \"\"\"Sourced tank capacity for this VIN (``mes.maintenance_specs`` /\n    ``mes.service``), or ``None`` (UNKNOWN) -- this corpus carries no such\n    spec today, so this always reads UNKNOWN in practice; kept as a real\n    lookup (not a hardcoded None) so a future sourced spec picks it up for\n    free.\"\"\"\n    try:\n        from mes import maintenance_specs  # local: optional, see module docstring\n        getter = getattr(maintenance_specs, \"fuel_tank_capacity_l\", None)\n        if callable(getter):\n            return getter(vin)\n    except Exception:  # noqa: BLE001\n        pass\n    return None\n\n\ndef last_scan_summary(vin: str) -> dict[str, Any] | None:\n    \"\"\"The Bench \"Last scan\" card (owner's guidance, 2026-10-13: \"we do not\n    need many scans, just 10\" -- one guided scan per visit, about ten over\n    a diagnosis): the newest scan on file for this VIN, by\n    ``cuore.live.scanlog``'s own grouping (see that module's docstring for\n    what a \"scan\" is and what makes one \"partial\"), shaped for the card --\n    id, relative time, source adapter, codes by status, the coverage line,\n    and the scan-plan chip. ``None`` when ``cuore.services.scanlog_bridge``\n    is unavailable or no live scan is on file yet; the template then shows\n    its own \"no scan yet\" line rather than fabricate a card.\n\n    Codes are grouped \"active\" (stored + permanent -- a fault the car is\n    reporting right now) vs \"history\" (pending -- not yet confirmed) purely\n    as a display grouping over the scan's own stored/pending/permanent\n    buckets (``cuore.live.scanlog``'s OBD vocabulary); it invents no new\n    DTC status of its own.\n    \"\"\"\n    if scanlog_bridge is None:\n        return None\n    try:\n        scans = scanlog_bridge.list_scans(vin)[\"scans\"]  # newest first\n    except Exception:  # noqa: BLE001 -- the bench must still render without it\n        return None\n    if not scans:\n        return None\n\n    latest = scans[0]\n    previous = scans[1] if len(scans) > 1 else None\n    dtcs = latest.get(\"dtcs\") or {}\n    active = sorted(set(dtcs.get(\"stored\") or []) | set(dtcs.get(\"permanent\") or []))\n    history = sorted(dtcs.get(\"pending\") or [])\n\n    try:\n        plan = scanlog_bridge.scan_plan(vin)\n    except Exception:  # noqa: BLE001\n        plan = {\"count\": len(scans), \"total\": 10}\n\n    return {\n        \"id\": latest[\"id\"],\n        \"relative\": _relative_time(latest.get(\"started\")) or latest.get(\"started\"),\n        \"source\": (latest.get(\"source\") or {}).get(\"stream\") or \"unknown\",\n        \"active_codes\": active,\n        \"history_codes\": history,\n        \"coverage_line\": (latest.get(\"coverage\") or {}).get(\"line\"),\n        \"partial\": bool(latest.get(\"partial\")),\n        \"plan\": plan,\n        \"href\": f\"/v/{vin}/scans/{latest['id']}\",\n        \"health_href\": f\"/v/{vin}/scans/{latest['id']}/health\",\n        \"compare_href\": (f\"/v/{vin}/scans/diff?a={previous['id']}&b={latest['id']}\"\n                        if previous else None),\n    }\n\n\ndef build_bench(vin: str) -> dict[str, Any]:\n    \"\"\"Everything ``bench.html`` needs, computed once.\n\n    ``live_status`` is passed as ``None`` into ``dossier_bridge.build_view``\n    -- the same choice ``flow_bridge.flow_state`` and\n    ``shop_bridge._dossier_verdict`` already make from the service layer:\n    it only affects whether the verdict's own action buttons render as\n    enabled, never the verdict state itself (that comes from recorded\n    observations), and the bench page does not render those buttons anyway.\n    The bench's own precondition checks read a freshly computed live status\n    instead (see :func:`_live_status`).\n    \"\"\"\n    vin = (vin or \"\").strip()\n    if not vin:\n        raise BadRequest(\"a VIN is required\")\n\n    mtime = mes_bridge.newest_mtime(vin)\n    dossier = cache.get_or_build((\"workup\", vin, mtime), lambda: mes_bridge.workup(vin=vin))\n    view = dossier_bridge.build_view(vin, dossier, None)\n    identity = dossier.get(\"identity\") or {}\n\n    verdict_raw = view.get(\"verdict\") or {}\n    verdict = {\n        \"state\": verdict_raw.get(\"state\"),\n        \"label\": verdict_raw.get(\"label\"),\n        \"sentence\": verdict_raw.get(\"summary\"),\n        \"next_action\": verdict_raw.get(\"next_action\"),\n        \"blocker\": verdict_raw.get(\"blocker\"),\n        \"basis\": verdict_raw.get(\"basis\") or [],\n    }\n\n    codes = view.get(\"codes\") or []\n    codes_by_base = {row[\"code\"]: row[\"status\"] for row in codes}\n    open_work = view.get(\"open_work\") or []\n    bulletins_by_id = {b[\"id\"]: b for b in view.get(\"bulletins\") or []}\n    checklist = checklist_store.get(vin)\n    live_status = _live_status()\n    fuel_blocked = verdict[\"blocker\"] == \"fuel out of window\"\n\n    next_actions = _next_actions(vin, open_work, codes_by_base, checklist,\n                                 live_status, fuel_blocked, bulletins_by_id, mtime)\n    job_parts, job_tools = _hoist_shared(next_actions)\n\n    latest = view.get(\"latest\") or {}\n    last_read = latest.get(\"session_short\") or latest.get(\"scan_short\")\n\n    cp = dossier.get(\"current_picture\") or {}\n    scan_ts = (cp.get(\"latest_scan\") or {}).get(\"timestamp\")\n    session_ts = (cp.get(\"latest_session\") or {}).get(\"timestamp\")\n    newest_ts = max([t for t in (scan_ts, session_ts) if t], default=None)\n    hours_since = _hours_since(newest_ts)\n\n    done_total = sum((c.get(\"progress\") or {}).get(\"done\", 0) for c in open_work)\n    steps_total = sum((c.get(\"progress\") or {}).get(\"total\", 0) for c in open_work)\n\n    active_codes = sorted(r[\"code\"] for r in codes if r[\"status\"] == \"ACTIVE\")\n    cleared_codes = sorted(r[\"code\"] for r in codes if r[\"status\"] == \"CLEARED_UNVERIFIED\")\n    previous_visit = _record_visit(vin, {\n        \"active_codes\": active_codes, \"cleared_codes\": cleared_codes,\n        \"last_read\": last_read,\n    })\n    resume = {\n        \"last_scan_relative\": _relative_time(newest_ts) or \"no scan on file\",\n        \"last_scan_at\": newest_ts,\n        \"changed\": _resume_changes(previous_visit, active_codes, cleared_codes, last_read),\n        \"is_first_visit\": previous_visit is None,\n        \"done\": done_total,\n        \"total\": steps_total,\n        \"next_action\": verdict[\"next_action\"],\n    }\n\n    try:\n        open_codes = mes_bridge.open_codes_for(dossier)\n    except Exception:  # noqa: BLE001\n        open_codes = []\n\n    return {\n        \"vin\": vin,\n        \"vehicle\": _vehicle_name(vin, dossier),\n        \"vin_tail\": vin[-6:] if len(vin) >= 6 else vin,\n        \"km\": identity.get(\"odometer_last_km\"),\n        \"complaint\": _complaint(vin),\n        \"verdict\": verdict,\n        \"resume\": resume,\n        \"progress\": {\"done\": done_total, \"total\": steps_total},\n        \"scan_stale\": bool(hours_since is not None and hours_since > _STALE_HOURS),\n        \"scan_hours_since\": hours_since,\n        \"next_actions\": next_actions,\n        \"job_parts\": job_parts,\n        \"job_tools\": job_tools,\n        \"open_codes_count\": (view.get(\"code_counts\") or {}).get(\"active\", 0),\n        \"last_read\": last_read,\n        \"shortcuts\": _shortcuts(vin, codes, open_work),\n        \"legend\": _STATUS_LEGEND,\n        \"case_hint\": _case_hint(vin, open_codes),\n        \"fuel_gate\": _fuel_gate(vin, view.get(\"freeze_frames\") or []),\n        \"readiness\": dossier_bridge.readiness_panel(vin, dossier),\n        \"mode06\": view.get(\"mode06\"),\n        \"live_status\": live_status,\n        \"scanner_label\": scanner_label(live_status),\n        \"blocker_banner\": _blocker_banner(verdict),\n        \"last_scan\": last_scan_summary(vin),\n    }\n\n\n# --- regeneration hook: a brand-new live DTC must not be served a stale\n#    cached next-action ---------------------------------------------------\n\n\ndef regenerate_for_live_codes(vin: str) -> None:\n    \"\"\"Called by ``cuore.services.systems_map_bridge`` (the Systems map's\n    live overlay) the moment the live poller sees a code this VIN's own\n    corpus-derived state did not carry yet, so Bench's next time it is\n    asked is rebuilt rather than served the memoised ``(\"workup\", vin,\n    mtime), ...`` entry from :func:`build_bench` -- the whole point is\n    Bench, Job and Systems agreeing on the same new code, not three stale\n    pictures of the car.\n\n    A brand-new live code has no backing MES log yet, so it never moves\n    ``mes_bridge.newest_mtime(vin)`` -- the ordinary cache key\n    :mod:`cuore.services.cache` builds on would not fall out on its own the\n    way a new/edited log already does (see that module's own docstring).\n    ``cache`` exposes no keyed delete, only \"drop everything\"\n    (:func:`cuore.services.cache.clear`), which is exactly as cheap as the\n    module's own docstring says it should be (at most 16 small entries, \"one\n    or two vehicles someone is looking at\") -- so that is what this calls,\n    for every vehicle, not just ``vin``. Never raises: a cache miss just\n    means the next Bench/Job render costs one more rebuild, nothing\n    user-visible breaks.\n    \"\"\"\n    try:\n        cache.clear()\n    except Exception:  # noqa: BLE001 -- a cache-regeneration hiccup must never surface\n        pass\n\n\n__all__ = [\"build_bench\", \"FAMILY_ICON\", \"LABELS\", \"scanner_label\",\n          \"last_scan_summary\", \"regenerate_for_live_codes\"]\n","numLines":207,"startLine":650,"totalLines":856}},"sourceToolAssistantUUID":"83557996-659d-497e-aac3-a5f506d7a7c7","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
