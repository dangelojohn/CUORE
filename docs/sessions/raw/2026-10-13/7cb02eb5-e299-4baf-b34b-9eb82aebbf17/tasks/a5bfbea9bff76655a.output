: MSYS_NO_PATHCONV=1 powershell -NoProfile -ExecutionPolicy Bypass -File C:/Users/User/mcp-servers/start-cuore.ps1 -Restart -Page / ; then confirm http://127.0.0.1:5000/api/health is ok and these return 200: /v/ZASFAKPN5J7B88115 (Bench), /v/ZASFAKPN5J7B88115/scans, /v/ZASFAKPN5J7B88115/health, /v/ZASFAKPN5J7B88115/scan, /v/ZASFAKPN5J7B88115/liveboard, /m/ZASFAKPN5J7B88115. Also report the Bench verdict text and the health page's verdict line as served."},"uuid":"1fda5dae-9bf4-4832-b0d4-16b2d5f6f5c1","timestamp":"2026-10-14T01:54:23.213Z","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
