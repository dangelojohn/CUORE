: 10px; flex-wrap: wrap;\n  min-height: 44px; padding: 6px 0; border-bottom: 1px solid var(--rule-soft);\n}\n.tool-review-row:last-of-type { border-bottom: none; }\n.tool-review-used { display: flex; align-items: center; gap: 6px; min-width: 180px; flex: 1 1 200px; }\n.tool-review-used input[type=\"checkbox\"] { width: 20px; height: 20px; }\n.tool-review-right { display: flex; gap: 10px; flex: none; }\n.tool-review-right label { display: flex; align-items: center; gap: 4px; min-height: 44px; }\n.tool-review-right input[type=\"radio\"] { width: 18px; height: 18px; }\n.tool-review-note {\n  flex: 1 1 160px; min-height: 36px; padding: 4px 8px; border: 1px solid var(--rule);\n  border-radius: var(--radius); background: var(--surface); color: var(--ink);\n}\n\n@media (max-width: 400px) {\n  .tool-review-row { flex-direction: column; align-items: stretch; }\n  .tool-review-right { justify-content: space-between; }\n}"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2931,"cache_read_input_tokens":175329,"cache_creation":{"ephemeral_5m_input_tokens":2931,"ephemeral_1h_input_tokens":0},"output_tokens":3,"service_tier":"standard","inference_geo":"not_available"},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_01NTm1NGkx9mG6QT1MuZc8p8":{"file_path":"C:\\Users\\User\\mcp-servers\\cuore\\web\\static\\cuore.css","old_string":"@media (max-width: 400px) {\n  .hyp-status-btn { flex: 1 1 auto; }\n}","new_string":"@media (max-width: 400px) {\n  .hyp-status-btn { flex: 1 1 auto; }\n}\n\n/* =========================================================================\n * Tools for this step (cuore/web/templates/_tools_panel.html), used on\n * job.html (steps 3 & 5) and maintenance.html (per item), plus the\n * mandatory tools-used review on job.html (step 7).\n * Appended section -- added for the tools-kb feature, kept separate\