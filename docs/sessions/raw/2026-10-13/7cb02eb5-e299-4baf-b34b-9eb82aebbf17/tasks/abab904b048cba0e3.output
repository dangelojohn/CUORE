stered on this app -- lets\ncuore/web/parts_routes.py:142:def _register(templates: Any) -> None:\ncuore/web/parts_routes.py:143:    templates.env.globals[\"parts_for\"] = _parts_for\ncuore/web/parts_routes.py:146:_register(_shared_templates)\ncuore/web/parts_routes.py:148:# code.html renders through cuore.web.routes's templates (registered just\ncuore/web/parts_routes.py:151:# same two-environments situation cuore.web.experience_globals documents\ncuore/web/parts_routes.py:155:    _register(_service_routes.templates)","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"serverClassifierContext":{"request":"03dea32f-54d5-484c-9780-8d47ce433355","context":{"git_state":{"cwd":"/c/Users/User/mcp-servers","root":"/c/Users/User/mcp-servers","branch":"main","default_branch":null,"status":{"clean":false,"counts":{"staged":0,"modified":0,"untracked":null,"untracked_normal":1},"porcelain":null,"truncated":false},"visibility":{"origin":null,"push_remote":"origin","remotes":[{"name":"github","host":"github.com","remote":"dangelojohn/CUORE","visibility":"unknown"}],"visibility_cache":[]}},"live_cwd":"/c/Users/User/mcp-servers","platform":"windows"}},"sourceToolAssistantUUID":"d098058f-88ba-4ac0-936a-5f748a986cbe","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
