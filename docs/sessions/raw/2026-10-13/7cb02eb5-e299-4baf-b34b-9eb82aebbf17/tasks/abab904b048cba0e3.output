ints the raw value. #}","-        {% set em = view.verdict.readiness.evap_monitor %}","-        {% if em == \"complete\" or em is sameas true %}","-          {% set em_text = \"complete\" %}","-        {% elif em == \"not_supported\" %}","-          {% set em_text = \"not supported on this vehicle\" %}","-        {% elif em == \"incomplete\" or em is sameas false %}","-          {% set em_text = \"not yet run\" %}","-        {% else %}","-          {% set em_text = \"unknown\" %}","-        {% endif %}","-        <p class=\"small muted\">Readiness read {{ view.verdict.readiness.at }} &mdash;","-          EVAP monitor {{ em_text }}{% if view.verdict.readiness.all_complete %}, all monitors complete{% endif %}.</p>","-      {% endif %}","-    </details>","-    {% endif %}","-  </div>","+  {% include \"_verdict_card.html\" %}"," ","   <div class=\"jumprow\" aria-label=\"Jump to section\">","     <a class=\"jump-chip\" href=\"#open-work\">Open work</a>"]},{"oldStart":76,"oldLines":67,"newStart":31,"newLines":7,"lines":["     <button type=\"button\" class=\"jump-chip jump-action\" data-collapse-all>Collapse all</button>","   </div>"," ","-  <section id=\"open-work\" class=\"dossier-section\">","-    <h2 class=\"section-h\">Open work</h2>","-    {% for job in view.open_work %}","-      <div class=\"job-card\">","-        <div class=\"job-head\">","-          <h3>{{ job.title }}</h3>","-          {% if job.codes %}","-          <div class=\"job-codes\">","-            {% for c in job.codes %}<a class=\"chip-code\" href=\"/v/{{ vin }}/code/{{ c }}\">{{ c }}</a>{% endfor %}","-          </div>","-          {% endif %}","-        </div>","-        {% set badges = [] %}","-        {% if job.codes and systems_for_code is defined %}","-          {% for c in job.codes %}","-            {% for b in systems_for_code(c) %}","-              {% if b not in badges %}{% set _ = badges.append(b) %}{% endif %}","-            {% endfor %}","-          {% endfor %}","-        {% endif %}","-        {% include \"_system_badge.html\" %}","-        {% if job.steps %}","-        <ol class=\"checklist\">","-          {% for s in job.steps %}","-          <li class=\"checklist-step {{ 'is-done' if s.done }}\"","-              id=\"fb-{{ s.id }}\" data-fact=\"checklist|{{ s.id }}\">","-            <form method=\"post\" action=\"/v/{{ vin }}/checklist\" class=\"step-form\" data-checklist-form>","-              <input type=\"hidden\" name=\"step_id\" value=\"{{ s.id }}\">","-              <input type=\"hidden\" name=\"done\" value=\"{{ '0' if s.done else '1' }}\">","-              <button type=\"submit\" class=\"step-check\" aria-pressed=\"{{ 'true' if s.done else 'false' }}\"","-                      title=\"{{ 'Mark not done' if s.done else 'Mark done' }}\">","-                <span aria-hidden=\"true\">{{ \"✓\" if s.done else \"\" }}</span>","-              </button>","-            </form>","-            <span class=\"step-text\">{{ s.text }}","-              {% if s.ref %}<a class=\"step-ref\" href=\"{{ s.ref_href or '#' }}\">{{ s.ref }}</a>{% endif %}","-            </span>","-            {% if s.done_at %}","-              <span class=\"small muted step-meta\">done {{ s.done_at }}{% if s.done_by %} by {{ s.done_by }}{% endif %}</span>","-            {% endif %}","-            {% set target_kind = \"step\" %}{% set target_id = s.id %}{% set compact = true %}","-            {% include \"_media_attach.html\" %}","-          </li>","-          {% endfor %}","-        </ol>","-        {% endif %}","-        {% set exp = experience_links(family=job.family) if experience_links is defined and job.family else {\"links\": [], \"count\": 0} %}","-        {% include \"_experience.html\" %}","-        <div class=\"job-foot\">","-          {% if job.progress %}<span class=\"progress-pill\">{{ job.progress.done }}/{{ job.progress.total }}</span>{% endif %}","-          {% if job.refs %}","-            <span class=\"job-refs\">","-              {% for r in job.refs %}{% 