es\", {})\ncheck(\"OwnerEventRequest still has no fields_meta property (doc's vision \"\n      \"gap note is current -- if this now fails, update \"\n      \"docs/mobile/API_CONTRACT.md's 'fields_meta provenance' section, it \"\n      \"is now stale)\",\n      not has_fields_meta)"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":755,"cache_read_input_tokens":160877,"cache_creation":{"ephemeral_5m_input_tokens":755,"ephemeral_1h_input_tokens":0},"output_tokens":5,"service_tier":"standard","inference_geo":"global"},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_01Qt7qWYv87GRaeXDodushk1":{"file_path":"C:\\Users\\User\\mcp-servers\\cuore\\tests\\check_api_contract.py","old_string":"    (\"get\", \"/api/owner/{vin}/taxonomy\"),\n    (\"post\", \"/api/owner/{vin}/events\"),\n    (\"post\", \"/api/vehicles/{vin}/media\"),\n):\n    check(f\"core mobile route {method.upper()} {must_have} exists\",\n          must_have in paths and method in paths[must_have])\n\n# /api/vision/* is documented as pending/not-yet-built -- confirm the doc's\n# own claim stays true rather than silently going stale the other direction\n# (someone ships vision and the doc still says \"pending\").\nvision_paths = [p for p in paths if \"/vision\" in p]\ncheck(\"no /api/vision route exists yet (doc says 'pending' -- update \"\n      \"docs/mobile/API_CONTRACT.md's Vision section once one ships)\",\n      len(vision_paths) == 0, f\"found: {vision_paths}\")","new_string":"    (\"get\", \"/api/owner/{vin}/taxonomy\"),\n    (\"post\", \"/api/owner/{vin}/events\"),\n    (\"post\", \"/api/vehicles/{vin}/media\"),\n    (\"get\", \"/api/vision/status\"),\n    (\"post\", \"/api/vision/{vin}/read\"),\n):\n    check(f\"core mobile route {method.upper()} {must_have} exists\",\n          must_have in paths and method in paths[must_have])\n\n# The doc's \"fields_meta provenance\" gap note is only true as long as\n# OwnerEventRequest has no such property -- flag it loudly (not a hard\n# failure list the doc can't react to) the day that changes, since the doc\n# then needs a rewrite, not just a row update.\nowner_event_schema = spec.get(\"components\", {}).get(\"schemas\", {}).get(\n    \"OwnerEventRequest\", {})\nhas_fields_meta = \"fields_meta\" in owner_event_schema.get(\"properties\", {})\ncheck(\"OwnerEventRequest still has no fields_meta property (doc's vision \"\n      \"gap note is current -- if this now fails, update \"\n      \"docs/mobile/API_CONTRACT.md's 'fields_meta provenance' section, it \"\n      \"is now stale)\",\n      not has_fields_meta)"}},"serverClassifierRequest":"da042e3f-eb9d-4dfd-b4d9-6e1b29493658","apiBlockIndex":1,"requestId":"req_011CfzuvHESA9YaC9zyEHrqj","attributionAgent":"general-purpose","type":"assistant","uuid":"8091e241-f7ac-4c5b-8d6a-c14c95301a02","timestamp":"2026-10-13T21:03:24.372Z","effort":"high","perTurnEffort":null,"userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
{"parentUuid":"8091e241-f7ac-4c5b-8d6a-c14c95301a02","isSidechain":true,"promptId":"32e1d820-4c02-417b-9eb5-eb28de0dd113","agentId":"aac4b6645059d9774","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Qt7qWYv87GRaeXDodushk1","type":"tool_result","content":"The file C:\\Users\\User\\mcp-servers\\cuore\\tests\\check_api_contract.py has been updated successfully. (file state is current in your context — no need to Read it back)"}]},"uuid":"dc1daad7-71f2-477e-a9f6-5185d06efa95","timestamp":"2026-10-13T21:03:24.818Z","toolUseResult":{"filePath":"C:\\Users\\User\\mcp-servers\\cuore\\tests\\check_api_contract.py","oldString":"    (\"get\", \"/api/owner/{vin}/taxonomy\"),\n    (\"post\", \"/api/owner/{vin}/events\"),\n    (\"post\", \"/api/vehicles/{vin}/media\"),\n):\n    check(f\"core mobile route {method.upper()} {must_have} exists\",\n          must_have in paths and method in paths[must_have])\n\n# /api/vision/* is documented as pending/not-yet-built -- confirm the doc's\n# own claim stays true rather than silently going stale the other direction\n# (someone ships vision and the doc still says \"pending\").\nvision_paths = [p for p in paths if \"/vision\" in p]\ncheck(\"no /api/vision route exists yet (doc says 'pending' -- update \"\n      \"docs/mobile/API_CONTRACT.md's Vision section once one ships)\",\n      len(vision_paths) == 0, f\"found: {vision_paths}\")","newString":"    (\"get\", \"/api/owner/{vin}/taxonomy\"),\n    (\"post\", \"/api/owner/{vin}/events\"),\n    (\"post\", \"/api/vehicles/{vin}/media\"),\n    (\"get\", \"/api/vision/status\"),\n    (\"post\", \"/api/vision/{vin}/read\"),\n):\n    check(f\"core mobile route {method.upper()} {must_have} exists\",\n          must_have in paths and method in paths[must_have])\n\n# The doc's \"fields_meta provenance\" gap note is only true as long as\n# OwnerEventRequest has no such property -- flag it loudly (not a hard\n# failure list the doc can't react to) the day that changes, since the doc\n# then needs a rewrite, not just a row update.\nowner_event_schema = spec.get(\"components\", {}).get(\"schemas\", {}).get(\n    \"OwnerEventRequest\", {})\nhas_fields_meta = \"fields_meta\" in owner_event_schema.get(\"properties\", {})\ncheck(\"OwnerEventRequest still has no fields_meta property (doc's vision \"\n      \"gap note is current -- if this now fails, update \"\n      \"docs/mobile/API_CONTRACT.md's 'fields_meta provenance' section, it \"\n      \"is now stale)\",\n      not has_fields_meta)","originalFile":"\"\"\"Guards ``docs/mobile/API_CONTRACT.md`` against drift.\n\nThat document is the contract a native iPhone app (Swift or Flutter) talks\nto in place of the phone web page ``/m/{vin}``. It was generated by reading\n``app.openapi()`` once; this check re-reads ``app.openapi()`` on every run\nand fails if any ``(method, path)`` row in the doc's own \"Path table\" is no\nlonger present in the live schema -- the one way a doc like this silently\ngoes stale is someone renaming or removing a route without knowing a mobile\nclient depends on it.\n\nThis does not attempt to fail on *additions* (a new route showing up in the\nschema that the doc does not yet mention) -- only disappearance of a\ndocumented one, which is the breaking case for a client already built\nagainst this contract.\n\nSame posture as every other ``check_*.py`` here: plain script, ``check()``,\nexit 1 on failure, no pytest. ``CUORE_STATE_DIR`` is pointed at a throwaway\ndirectory before ``cuore`` is imported, so this needs no real corpus.\n\nRun:\n    .venv/Scripts/python.exe cuore/tests/check_api_contract.py\n\"\"\"\n\nfrom __future__ import annotations\n\nimport os\nimport re\nimport sys\nimport tempfile\nfrom pathlib import Path\n\n# Before any cuore import: state goes to a throwaway directory.\nos.environ[\"CUORE_STATE_DIR\"] = tempfile.mkdtemp(prefix=\"cuore-check-apicontract-\")\n\nsys.path.insert(0, str(Path(__file__).resolve().parents[2]))\n\nfrom cuore.app import create_app  # noqa: E402\n\nDOC_PATH = Path(__file__).resolve().parents[2] / \"docs\" / \"mobile\" / \"API_CONTRACT.md\"\n\n#: Matches one row of the doc's \"| Method | Path | Summary |\" table, e.g.\n#: \"| POST | /api/owner/{vin}/events | Record one owner-reported event |\".\n#: Anchored on a leading HTTP verb so the table's own header/separator rows\n#: (``| Method | Path | Summary |``, ``|---|---|---|``) never match.\nROW_RE = re.compile(\n    r\"^\\|\\s*(GET|POST|PUT|PATCH|DELETE)\\s*\\|\\s*(/api/\\S+?)\\s*\\|\", re.MULTILINE)\n\nfailures: list[str] = []\nchecks = 0\n\n\ndef check(label: str, condition: bool, detail: str = \"\") -> None:\n    global checks\n    checks += 1\n    if not condition:\n        failures.append(f\"{label}{(' -- ' + detail) if detail else ''}\")\n\n\n# --- load the doc's own path table -----------------------------------------\n\ncheck(f\"{DOC_PATH} exists\", DOC_PATH.exists())\ntext = DOC_PATH.read_text(encoding=\"utf-8\")\n\nrows = ROW_RE.findall(text)\ncheck(\"the doc's path table has rows\", len(rows) > 0)\ncheck(\"the doc's path table has a non-trivial number of rows\",\n      len(rows) >= 10, f\"found {len(rows)}\")\n\n# --- compare against the live schema ----------------------------------------\n\napp = create_app()\nspec = app.openapi()\npaths = spec[\"paths\"]\n\nfor method, doc_path in rows:\n    entry = paths.get(doc_path)\n    check(f\"{doc_path} is still in app.openapi()\", entry is not None,\n          f\"documented in API_CONTRACT.md as {method} {doc_path}, not found \"\n          \"in the live schema -- update or remove that row, and tell \"\n          \"whoever owns the mobile client\")\n    if entry is not None:\n        check(f\"{method} {doc_path} is still a method on that path\",\n              method.lower() in entry,\n              f\"path exists but no longer supports {method}\")\n\n# A sanity floor on specific routes the doc leans on hardest, named\n# explicitly so a future refactor that breaks one of these fails loudly\n# here rather than only as a generic \"row not found\" above.\nfor method, must_have in (\n    (\"get\", \"/api/health\"),\n    (\"get\", \"/api/capabilities\"),\n    (\"get\", \"/api/vehicle/{vin}/report\"),\n    (\"get\", \"/api/owner/{vin}/taxonomy\"),\n    (\"post\", \"/api/owner/{vin}/events\"),\n    (\"post\", \"/api/vehicles/{vin}/media\"),\n):\n    check(f\"core mobile route {method.upper()} {must_have} exists\",\n          must_have in paths and method in paths[must_have])\n\n# /api/vision/* is documented as pending/not-yet-built -- confirm the doc's\n# own claim stays true rather than silently going stale the other direction\n# (someone ships vision and the doc still says \"pending\").\nvision_paths = [p for p in paths if \"/vision\" in p]\ncheck(\"no /api/vision route exists yet (doc says 'pending' -- update \"\n      \"docs/mobile/API_CONTRACT.md's Vision section once one ships)\",\n      len(vision_paths) == 0, f\"found: {vision_paths}\")\n\n\nprint(f\"checks run: {checks}\")\nif failures:\n    print(f\"FAILURES: {len(failures)}\")\n    for f in failures:\n        print(\"  -\", f)\n    sys.exit(1)\nprint(\"all green\")\n","structuredPatch":[{"oldStart":93,"oldLines":17,"newStart":93,"newLines":24,"lines":["     (\"get\", \"/api/owner/{vin}/taxonomy\"),","     (\"post\", \"/api/owner/{vin}/events\"),","     (\"post\", \"/api/vehicles/{vin}/media\"),","+    (\"get\", \"/api/vision/status\"),","+    (\"post\", \"/api/vision/{vin}/read\"),"," ):","     check(f\"core mobile route {method.upper()} {must_have} exists\",","           must_have in paths and method in paths[must_have])"," ","-# /api/vision/* is documented as pending/not-yet-built -- confirm the doc's","-# own claim stays true rather than silently going stale the other direction","-# (someone ships vision and the doc still says \"pending\").","-vision_paths = [p for p in paths if \"/vision\" in p]","-check(\"no /api/vision route exists yet (doc says 'pending' -- update \"","-      \"docs/mobile/API_CONTRACT.md's Vision section once one ships)\",","-      len(vision_paths) == 0, f\"found: {vision_paths}\")","+# The doc's \"fields_meta provenance\" gap note is only true as long as","+# OwnerEventRequest has no such property -- flag it loudly (not a hard","+# failure list the doc can't react to) the day that changes, since the doc","+# then needs a rewrite, not just a row update.","+owner_event_schema = spec.get(\"components\", {}).get(\"schemas\", {}).get(","+    \"OwnerEventRequest\", {})","+has_fields_meta = \"fields_meta\" in owner_event_schema.get(\"properties\", {})","+check(\"OwnerEventRequest still has no fields_meta property (doc's vision \"","+      \"gap note is current -- if this now fails, update \"","+      \"docs/mobile/API_CONTRACT.md's 'fields_meta provenance' section, it \"","+      \"is now stale)\",","+      not has_fields_meta)"," "," "," print(f\"checks run: {checks}\")"]}],"userModified":false,"replaceAll":false},"serverClassifierContext":{"request":"da042e3f-eb9d-4dfd-b4d9-6e1b29493658","context":{"git_state":{"cwd":"/c/Users/User/mcp-servers","root":null,"branch":null,"default_branch":null,"status":null,"visibility":null,"error":"pending"},"live_cwd":"/c/Users/User/mcp-servers","platform":"windows"}},"sourceToolAssistantUUID":"8091e241-f7ac-4c5b-8d6a-c14c95301a02","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
