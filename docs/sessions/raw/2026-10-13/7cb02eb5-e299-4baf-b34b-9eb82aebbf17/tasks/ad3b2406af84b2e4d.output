{"parentUuid":"fb0b7793-89aa-4dd6-8ae8-3e95aabe04d7","isSidechain":true,"agentId":"ad3b2406af84b2e4d","message":{"model":"claude-sonnet-5","id":"msg_011CfqertjDtq5FvUHFsAfMn","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_014EigLD2uLoqDxwy5yFY9BQ","name":"Read","input":{"file_path":"C:\\Users\\User\\mcp-servers\\cuore\\web\\jobs_routes.py"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":4621,"cache_read_input_tokens":56797,"cache_creation":{"ephemeral_5m_input_tokens":4621,"ephemeral_1h_input_tokens":0},"output_tokens":4,"service_tier":"standard","inference_geo":"not_available"},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_014EigLD2uLoqDxwy5yFY9BQ":{"file_path":"C:\\Users\\User\\mcp-servers\\cuore\\web\\jobs_routes.py"}},"apiBlockIndex":1,"requestId":"req_011CfqertUbTTc9n9sMdNA5B","attributionAgent":"general-purpose","type":"assistant","uuid":"216bb5df-3d15-42fb-a208-79b031d895f4","timestamp":"2026-10-08T23:40:27.611Z","effort":"high","perTurnEffort":null,"userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
{"parentUuid":"216bb5df-3d15-42fb-a208-79b031d895f4","isSidechain":true,"promptId":"c88cddde-d9ec-4df1-89bf-4cd0fc5db786","agentId":"ad3b2406af84b2e4d","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014EigLD2uLoqDxwy5yFY9BQ","type":"tool_result","content":"1\t\"\"\"Web-form face of the Job (case) workflow.\n2\t\n3\tSame posture as ``cuore.web.dossier_routes``: a second router on the same\n4\tapp reusing ``cuore.web.routes``'s own page/dossier helpers, so rendering\n5\tstays identical to every other ``/v/{vin}`` page. Every form here degrades\n6\twith no JavaScript -- a stepper of plain GET/POST/redirect forms, same\n7\tconvention as ``/v/{vin}/dealer`` and ``/v/{vin}/notes``.\n8\t\n9\tJob UX pass (docs/research/JOB_UX_FIXES_2026-10-08.md), 2026-10-08: every\n10\tmutating route below now redirects to ``?step=<the step it lives on>#<row\n11\tanchor>`` with a ``msg``/``mk`` (message/kind) query pair a toast reads --\n12\tnever to a different tab, never to a different step (fix #5).\n13\t\n14\t``cuore.services.jobs_bridge`` now carries the real guided-diagnostics\n15\tengine: ``edit_hypothesis``/``delete_hypothesis``/``undelete_hypothesis``/\n16\t``add_evidence``/``remove_evidence``/``resolve_evidence``/\n17\t``add_test_evidence``/``check_similar``/``step_registry``, and\n18\t``set_hypothesis`` enforces the confirm gate (open -> supported ->\n19\tconfirmed, refuted from any state; confirm needs >=1 passed/failed test\n20\tresult and 0 unresolved evidence_against -- fix #1) by raising\n21\t``jobs_bridge.RuleViolation`` *unconverted* -- this module's only job is to\n22\tcatch that (never let it 500) and redirect back to the same card with its\n23\t``reason``/``next_test`` shown inline, per the 409 {detail, next_test}\n24\tcontract. Every route below goes through ``jobs_bridge`` only -- no direct\n25\t``mes.jobs`` import here.\n26\t\"\"\"\n27\t\n28\tfrom __future__ import annotations\n29\t\n30\timport json\n31\tfrom typing import Any\n32\tfrom urllib.parse import quote\n33\t\n34\tfrom fastapi import APIRouter, Depends, Form, Request\n35\tfrom fastapi.responses import HTMLResponse, RedirectResponse\n36\t\n37\tfrom .. import bootstrap  # noqa: F401  -- side effect: puts `mes` on sys.path\n38\tfrom ..api.deps import require_token\n39\tfrom ..services import cases_bridge, dossier_bridge, jobs_bridge, tools_kb_bridge\n40\tfrom ..services.errors import BridgeError\n41\tfrom . import routes as web_routes\n42\t\n43\trouter = APIRouter(include_in_schema=False, dependencies=[Depends(require_token)])\n44\t\n45\ttry:  # fix #12: System picker is a taxonomy select, not free text\n46\t    from mes import systems as _mes_systems\n47\texcept Exception:  # noqa: BLE001 -- the manual hypothesis form must still render\n48\t    _mes_systems = None\n49\t\n50\t\n51\tdef _systems_taxonomy() -> list[str]:\n52\t    if _mes_systems is None:\n53\t        return []\n54\t    try:\n55\t        return sorted({v.get(\"label\", k) for k, v in _mes_systems.systems().items()})\n56\t    except Exception:  # noqa: BLE001\n57\t        return []\n58\t\n59\t\n60\tSYSTEMS_TAXONOMY: list[str] = _systems_taxonomy()\n61\t\n62\t\n63\tdef _rule_violation_msg(exc: \"jobs_bridge.RuleViolation\") -> str:\n64\t    \"\"\"One line out of a caught ``jobs_bridge.RuleViolation`` -- its own\n65\t    ``reason`` plus ``next_test`` when there is one, exactly what the toast\n66\t    shows (fix #1's 409 {detail, next_test} contract, rendered inline\n67\t    instead of as a raw HTTP body since this route serves an HTML form).\"\"\"\n68\t    reason = getattr(exc, \"reason\", None) or str(exc) or \"That wasn't allowed.\"\n69\t    next_test = getattr(exc, \"next_test\", \"\") or \"\"\n70\t    return f\"{reason} Next: {next_test}\" if next_test else reason\n71\t\n72\t\n73\tdef _step_redirect(vin: str, step: str = \"\", anchor: str = \"\", msg: str = \"\",\n74\t                   mk: str = \"ok\", extra: str = \"\") -> RedirectResponse:\n75\t    \"\"\"Every mutating route's one exit: back to the *same* step, never a\n76\t    different tab or step (fix #5) -- optionally with a one-line toast\n77\t    message/kind and any extra query the receiving page wants (e.g.\n78\t    ``confirm=<hyp_id>`` for the confirm-summary panel).\"\"\"\n79\t    parts = []\n80\t    if step:\n81\t        parts.append(f\"step={quote(str(step))}\")\n82\t    if msg:\n83\t        parts.append(f\"msg={quote(msg)}\")\n84\t        parts.append(f\"mk={quote(mk)}\")\n85\t    if extra:\n86\t        parts.append(extra)\n87\t    qs = (\"?\" + \"&\".join(parts)) if parts else \"\"\n88\t    frag = f\"#{anchor}\" if anchor else \"\"\n89\t    return RedirectResponse(url=f\"/v/{vin}/job{qs}{frag}\", status_code=303)\n90\t\n91\t\n92\t@router.post(\"/tools-kb/inventory-form\", response_class=HTMLResponse)\n93\tasync def tools_inventory_form(status: str = Form(...), tool: str = Form(...),\n94\t                               return_to: str = Form(default=\"/\")) -> RedirectResponse:\n95\t    \"\"\"The \"I have this / I don't\" button pair on the tools panel -- a\n96\t    garage-wide owned/not-owned list (``cuore.services.tools_kb_bridge``),\n97\t    not tied to any one vehicle, so it lives here rather than under\n98\t    ``/v/{vin}/...`` even though the tools panel itself renders on\n99\t    vehicle-scoped pages (job.html, maintenance.html).\"\"\"\n100\t    tools_kb_bridge.inventory_set(tool, status)\n101\t    return RedirectResponse(url=return_to or \"/\", status_code=303)\n102\t\n103\t\n104\tdef _job_page(request: Request, vin: str, job_id: str = \"\", tools_step: str = \"\",\n105\t             step: str = \"\", **extra: Any) -> HTMLResponse:\n106\t    dossier = web_routes._dossier(vin)\n107\t    bar = web_routes._vehicle_bar(vin, dossier)\n108\t    job_view = jobs_bridge.build_job_view(vin, job_id or None, tools_step=tools_step or None)\n109\t    # Run 2, #9: _vehicle_bar falls back to \"(unnamed vehicle)\" straight\n110\t    # off dossier.identity; job_view[\"vehicle\"] already carries\n111\t    # jobs_bridge._vehicle_name's richer resolution (shop_bridge corpus\n112\t    # name, then a WMI decode) -- the same fix bench_routes.py applies to\n113\t    # its own bar, so the Job tab's banner stops disagreeing with Bench's.\n114\t    if job_view.get(\"vehicle\"):\n115\t        bar[\"name\"] = job_view[\"vehicle\"]\n116\t    live_status = web_routes._status_strip()\n117\t    try:\n118\t        dossier_view = dossier_bridge.build_view(vin, dossier, live_status)\n119\t    except Exception:  # noqa: BLE001 -- the job page must still render\n120\t        dossier_view = {\"verdict\": None, \"open_work\": [], \"codes\": [],\n121\t                        \"code_counts\": {}, \"attempted\": []}\n122\t    active_codes = [c[\"code\"] for c in dossier_view.get(\"codes\", [])\n123\t                    if c.get(\"status\") == \"ACTIVE\"]\n124\t    try:\n125\t        case_prefill = cases_bridge.prefill(vin, active_codes)\n126\t    except Exception:  # noqa: BLE001 -- case memory must never 500 the job page\n127\t        case_prefill = None\n128\t\n129\t    # --- display-only reshaping of job_view for this render (fix #11/#13):\n130\t    # active (non-deleted) hypotheses ranked by net evidence with the\n131\t    # leading one pinned first; deleted ones split out for an Undo row.\n132\t    # ``jobs_bridge.suggested_hypotheses`` already dedupes+ranks its own\n133\t    # list, so the suggestions themselves need no further work here --\n134\t    # job.html just slices the first 3 off for \"top\" vs. \"Show N more\".\n135\t    # Never mutates the stored job; this dict is built fresh per request.\n136\t    hyps = list((job_view.get(\"job\") or {}).get(\"hypotheses\") or [])\n137\t    active_hyps = [h for h in hyps if not h.get(\"deleted\")]\n138\t    deleted_hyps = [h for h in hyps if h.get(\"deleted\")]\n139\t    active_hyps.sort(\n140\t        key=lambda h: (len(h.get(\"evidence_for\") or []) - len(h.get(\"evidence_against\") or [])),\n141\t        reverse=True,\n142\t    )\n143\t    if job_view.get(\"job\"):\n144\t        job_view[\"job\"][\"hypotheses\"] = active_hyps\n145\t    job_view[\"deleted_hypotheses\"] = deleted_hyps\n146\t\n147\t    # Toast/flash state from a mutating route's redirect (fix #5) -- read\n148\t    # straight off the query string so this works with zero JavaScript;\n149\t    # job.js upgrades the same params into a nicer dismissable toast.\n150\t    qp = request.query_params\n151\t    flash_msg = qp.get(\"msg\") or \"\"\n152\t    flash_kind = qp.get(\"mk\") or \"ok\"\n153\t    confirm_pending = qp.get(\"confirm\") or \"\"\n154\t    undo_hyp = qp.get(\"undo_hyp\") or \"\"\n155\t\n156\t    # `view` carries the full dossier view -- the shape _verdict_card.html,\n157\t    # _codes_table.html and _open_work.html already expect everywhere else\n158\t    # they're included; `job_view` carries the Job-specific data only\n159\t    # job.html itself reads.\n160\t    response = web_routes._page(request, \"job.html\", vin=vin, bar=bar, view=dossier_view,\n161\t                                job_view=job_view, case_prefill=case_prefill,\n162\t                                active_codes=active_codes, tab=\"job\", step=step,\n163\t                                flash_msg=flash_msg, flash_kind=flash_kind,\n164\t                                confirm_pending=confirm_pending, undo_hyp=undo_hyp,\n165\t                                systems_taxonomy=SYSTEMS_TAXONOMY, **extra)\n166\t    web_routes._set_active_vehicle(response, vin)\n167\t    return response\n168\t\n169\t\n170\t@router.get(\"/v/{vin}/job\", response_class=HTMLResponse)\n171\tdef job_page(request: Request, vin: str, tools_step: str = \"\", step: str = \"\") -> HTMLResponse:\n172\t    \"\"\"The current (or most recent) job for this vehicle, one step per\n173\t    screen -- ``step`` is the only query param this page reads to pick\n174\t    which of the 12 steps is the full screen (default: the flow's own\n175\t    current step, resolved inside job.html itself).\"\"\"\n176\t    return _job_page(request, vin, tools_step=tools_step, step=step)\n177\t\n178\t\n179\t@router.get(\"/v/{vin}/job/{job_id}\", response_class=HTMLResponse)\n180\tdef job_page_one(request: Request, vin: str, job_id: str, tools_step: str = \"\",\n181\t                 step: str = \"\") -> HTMLResponse:\n182\t    \"\"\"One specific job by id -- e.g. a closed case from this car's history.\"\"\"\n183\t    return _job_page(request, vin, job_id=job_id, tools_step=tools_step, step=step)\n184\t\n185\t\n186\t@router.post(\"/v/{vin}/job/open\", response_class=HTMLResponse)\n187\tasync def job_open(request: Request, vin: str,\n188\t                   technician: str = Form(default=\"\"),\n189\t                   complaint: str = Form(default=\"\")) -> RedirectResponse:\n190\t    \"\"\"Step 1: open a new case for this vehicle, in the driver's own words.\"\"\"\n191\t    jobs_bridge.open_job(vin, technician=technician, complaint=complaint)\n192\t    return _step_redirect(vin, \"1\", msg=\"Case opened.\", mk=\"ok\")\n193\t\n194\t\n195\t@router.post(\"/v/{vin}/job/{job_id}/hypotheses\", response_class=HTMLResponse)\n196\tasync def hypothesis_add(request: Request, vin: str, job_id: str,\n197\t                         text: str = Form(...), system: str = Form(default=\"\"),\n198\t                         next_test: str = Form(default=\"\"),\n199\t                         likelihood: str = Form(default=\"\"),\n200\t                         codes: str = Form(default=\"\"),\n201\t                         by: str = Form(default=\"\"),\n202\t                         step: str = Form(default=\"7\")) -> RedirectResponse:\n203\t    \"\"\"Step 7: add a hypothesis by hand (fix #12: System is a taxonomy pick,\n204\t    Linked codes a multi-select of open DTCs, Likelihood Low/Med/High).\"\"\"\n205\t    code_list = [c.strip() for c in codes.split(\",\") if c.strip()]\n206\t    likelihood_val = likelihood.strip().lower() or None\n207\t    try:\n208\t        hyp = jobs_bridge.add_hypothesis(job_id, text, system=system, next_test=next_test,\n209\t                                         codes=code_list or None, likelihood=likelihood_val,\n210\t                                         by=by.strip() or None)\n211\t    except BridgeError as exc:\n212\t        return _step_redirect(vin, step, anchor=\"add-hypothesis\", msg=str(exc), mk=\"err\")\n213\t    return _step_redirect(vin, step, anchor=f\"hyp-{hyp['id']}\", msg=\"Hypothesis added.\", mk=\"ok\")\n214\t\n215\t\n216\t@router.get(\"/v/{vin}/job/{job_id}/hypotheses/similar\")\n217\tdef hypothesis_similar(vin: str, job_id: str, text: str = \"\", system: str = \"\") -> dict[str, Any]:\n218\t    \"\"\"Fix #11's \"Similar to ... -- merge?\" prompt, read live as the tech\n219\t    types (job.js debounces this) -- thin pass-through to\n220\t    ``jobs_bridge.check_similar``, the real token-overlap check against the\n221\t    job on file, so the prompt is never a client-side guess. No JS -> no\n222\t    prompt, no behaviour change: the manual-add form still saves a new\n223\t    hypothesis either way.\"\"\"\n224\t    try:\n225\t        match = jobs_bridge.check_similar(job_id, text, system)\n226\t    except Exception:  # noqa: BLE001 -- a hint must never 500\n227\t        match = None\n228\t    if not match:\n229\t        return {\"similar\": None}\n230\t    return {\"similar\": {\"id\": match[\"id\"], \"text\": match[\"text\"]}}\n231\t\n232\t\n233\t@router.post(\"/v/{vin}/job/{job_id}/hypotheses/suggested\", response_class=HTMLResponse)\n234\tasync def hypothesis_add_suggested(request: Request, vin: str, job_id: str,\n235\t                                   text: str = Form(...), system: str = Form(default=\"\"),\n236\t                                   next_test: str = Form(default=\"\"),\n237\t                                   evidence_for: str = Form(default=\"[]\"),\n238\t                                   evidence_against: str = Form(default=\"[]\"),\n239\t                                   step: str = Form(default=\"7\")\n240\t                                   ) -> RedirectResponse:\n241\t    \"\"\"Step 7: promote one of the auto-suggested hypotheses, with its real\n242\t    evidence attached in the same step -- the refs travel as a hidden JSON\n243\t    field rather than being retyped, so nothing here can invent evidence\n244\t    that was not already shown on the page.\"\"\"\n245\t    suggestion = {\n246\t        \"text\": text, \"system\": system, \"next_test\": next_test,\n247\t        \"evidence_for\": json.loads(evidence_for) if evidence_for.strip() else [],\n248\t        \"evidence_against\": json.loads(evidence_against) if evidence_against.strip() else [],\n249\t    }\n250\t    hyp = jobs_bridge.add_suggested_hypothesis(job_id, suggestion)\n251\t    return _step_redirect(vin, step, anchor=f\"hyp-{hyp['id']}\",\n252\t                          msg=\"Hypothesis added from suggestion.\", mk=\"ok\")\n253\t\n254\t\n255\t@router.post(\"/v/{vin}/job/{job_id}/hypotheses/{hyp_id}/status\", response_class=HTMLResponse)\n256\tasync def hypothesis_set_status(request: Request, vin: str, job_id: str, hyp_id: str,\n257\t                                status: str = Form(...), step: str = Form(default=\"7\"),\n258\t                                ack: str = Form(default=\"\"),\n259\t                                by: str = Form(default=\"\")) -> RedirectResponse:\n260\t    \"\"\"Step 7: the status buttons -- open / supported / refuted / confirmed.\n261\t\n262\t    Fix #1: ``jobs_bridge.set_hypothesis`` itself enforces the path (open ->\n263\t    supported -> confirmed, refuted from any state) and the confirm gate\n264\t    (>=1 passed/failed test evidence_for, 0 unresolved evidence_against),\n265\t    raising ``jobs_bridge.RuleViolation`` -- caught below and shown inline\n266\t    (the 409 {detail, next_test} contract, rendered as this HTML form's own\n267\t    toast), never a 500 and never silently accepted. ``confirmed``\n268\t    additionally needs a second tap (``ack=1``): the first tap just\n269\t    redirects back with ``confirm=<hyp_id>`` so job.html renders the\n270\t    evidence-summary panel job.js promotes into a modal -- its own \"confirm\n271\t    again\" button is what actually sends ``ack=1``; if the gate would have\n272\t    refused anyway, that second POST catches the same RuleViolation. ``by``\n273\t    (who) rides along so the engine can stamp confirmed_by/at.\"\"\"\n274\t    if status == \"confirmed\" and ack != \"1\":\n275\t        return _step_redirect(vin, step, anchor=f\"hyp-{hyp_id}\", extra=f\"confirm={hyp_id}\")\n276\t\n277\t    # Job UX run 2, R8: Undo on a status-change toast, same posture as\n278\t    # Delete's own undo below -- remember the status this hypothesis was\n279\t    # on *before* this call so a toast click can put it straight back.\n280\t    old_status = \"\"\n281\t    try:\n282\t        old_job = jobs_bridge.get_job(job_id)\n283\t        old_hyp = next((h for h in (old_job.get(\"hypotheses\") or []) if h.get(\"id\") == hyp_id), None)\n284\t        old_status = (old_hyp or {}).get(\"status\") or \"\"\n285\t    except Exception:  # noqa: BLE001 -- the undo hint is never load-bearing\n286\t        old_status = \"\"\n287\t\n288\t    try:\n289\t        jobs_bridge.set_hypothesis(job_id, hyp_id, status=status, by=by.strip() or None)\n290\t    except jobs_bridge.RuleViolation as exc:\n291\t        return _step_redirect(vin, step, anchor=f\"hyp-{hyp_id}\",\n292\t                              msg=_rule_violation_msg(exc), mk=\"err\")\n293\t    except BridgeError as exc:\n294\t        return _step_redirect(vin, step, anchor=f\"hyp-{hyp_id}\", msg=str(exc), mk=\"err\")\n295\t    undo_extra = (f\"undo_status={quote(hyp_id)}:{quote(old_status)}\"\n296\t                 if old_status and old_status != status else \"\")\n297\t    return _step_redirect(vin, step, anchor=f\"hyp-{hyp_id}\", msg=f\"Status set to {status}.\",\n298\t                          mk=\"ok\", extra=undo_extra)\n299\t\n300\t\n301\t@router.post(\"/v/{vin}/job/{job_id}/hypotheses/{hyp_id}/next_test\", response_class=HTMLResponse)\n302\tasync def hypothesis_set_next_test(request: Request, vin: str, job_id: str, hyp_id: str,\n303\t                                   next_test: str = Form(default=\"\"),\n304\t                                   step: str = Form(default=\"7\")) -> RedirectResponse:\n305\t    jobs_bridge.set_hypothesis(job_id, hyp_id, next_test=next_test)\n306\t    return _step_redirect(vin, step, anchor=f\"hyp-{hyp_id}\", msg=\"Saved.\", mk=\"ok\")\n307\t\n308\t\n309\t@router.post(\"/v/{vin}/job/{job_id}/hypotheses/{hyp_id}/edit\", response_class=HTMLResponse)\n310\tasync def hypothesis_edit(request: Request, vin: str, job_id: str, hyp_id: str,\n311\t                          text: str = Form(default=\"\"), system: str = Form(default=\"\"),\n312\t                          next_test: str = Form(default=\"\"),\n313\t                          likelihood: str = Form(default=\"\"),\n314\t                          codes: str = Form(default=\"\"),\n315\t                          by: str = Form(default=\"\"),\n316\t                          step: str = Form(default=\"7\")) -> RedirectResponse:\n317\t    \"\"\"Fix #2: Edit -- any hypothesis field except status/evidence, which go\n318\t    through their own gated routes so editing can never route around the\n319\t    confirm gate.\"\"\"\n320\t    kw: dict[str, Any] = {}\n321\t    if text.strip():\n322\t        kw[\"text\"] = text\n323\t    if system:\n324\t        kw[\"system\"] = system\n325\t    if next_test:\n326\t        kw[\"next_test\"] = next_test\n327\t    if likelihood:\n328\t        kw[\"likelihood\"] = likelihood.strip().lower()\n329\t    if codes.strip():\n330\t        kw[\"codes\"] = [c.strip() for c in codes.split(\",\") if c.strip()]\n331\t    if not kw:\n332\t        return _step_redirect(vin, step, anchor=f\"hyp-{hyp_id}\", msg=\"Nothing to save.\", mk=\"warn\")\n333\t    try:\n334\t        jobs_bridge.edit_hypothesis(job_id, hyp_id, by=by.strip() or None, **kw)\n335\t    except BridgeError as exc:\n336\t        return _step_redirect(vin, step, anchor=f\"hyp-{hyp_id}\", msg=str(exc), mk=\"err\")\n337\t    return _step_redirect(vin, step, anchor=f\"hyp-{hyp_id}\", msg=\"Hypothesis updated.\", mk=\"ok\")\n338\t\n339\t\n340\t@router.post(\"/v/{vin}/job/{job_id}/hypotheses/{hyp_id}/evidence\", response_class=HTMLResponse)\n341\tasync def hypothesis_evidence(request: Request, vin: str, job_id: str, hyp_id: str,\n342\t                              side: str = Form(default=\"for\"),\n343\t                              kind: str = Form(default=\"observation\"),\n344\t                              ref_id: str = Form(default=\"\"),\n345\t                              label: str = Form(...),\n346\t                              op: str = Form(default=\"add\"),\n347\t                              by: str = Form(default=\"\"),\n348\t                              step: str = Form(default=\"7\")) -> RedirectResponse:\n349\t    \"\"\"Fix #2: + Evidence for / + Evidence against, and the remove side of\n350\t    the same picker -- thin pass-through to ``jobs_bridge.add_evidence``/\n351\t    ``remove_evidence``, which is what the confirm gate itself reads, so an\n352\t    item linked here is real evidence for fix #1 the moment it's added.\"\"\"\n353\t    side = side if side in (\"for\", \"against\") else \"for\"\n354\t    if op == \"remove\":\n355\t        try:\n356\t            jobs_bridge.remove_evidence(job_id, hyp_id, side, ref_id or label,\n357\t                                        ref_kind=kind or None, by=by.strip() or None)\n358\t        except BridgeError as exc:\n359\t            return _step_redirect(vin, step, anchor=f\"hyp-{hyp_id}\", msg=str(exc), mk=\"err\")\n360\t        return _step_redirect(vin, step, anchor=f\"hyp-{hyp_id}\", msg=\"Evidence removed.\",\n361\t                              mk=\"ok\", extra=f\"undo_ev={hyp_id}:{side}:{quote(label)}\")\n362\t\n363\t    ref = {\"kind\": kind or \"observation\", \"id\": ref_id or label, \"label\": label}\n364\t    try:\n365\t        jobs_bridge.add_evidence(job_id, hyp_id, side, ref, by=by.strip() or None)\n366\t    except BridgeError as exc:\n367\t        return _step_redirect(vin, step, anchor=f\"hyp-{hyp_id}\", msg=str(exc), mk=\"err\")\n368\t    return _step_redirect(vin, step, anchor=f\"hyp-{hyp_id}\",\n369\t                          msg=f\"Evidence {'for' if side == 'for' else 'against'} added.\", mk=\"ok\")\n370\t\n371\t\n372\t@router.post(\"/v/{vin}/job/{job_id}/hypotheses/{hyp_id}/delete\", response_class=HTMLResponse)\n373\tasync def hypothesis_delete(request: Request, vin: str, job_id: str, hyp_id: str,\n374\t                            by: str = Form(default=\"\"),\n375\t                            step: str = Form(default=\"7\")) -> RedirectResponse:\n376\t    \"\"\"Fix #2: Delete, soft (``jobs_bridge.delete_hypothesis``) -- the card\n377\t    itself stays on the audit trail; the undo offered in the toast is\n378\t    :func:`hypothesis_undelete` below.\"\"\"\n379\t    try:\n380\t        jobs_bridge.delete_hypothesis(job_id, hyp_id, by=by.strip() or None)\n381\t    except BridgeError as exc:\n382\t        return _step_redirect(vin, step, anchor=\"hypotheses\", msg=str(exc), mk=\"err\")\n383\t    return _step_redirect(vin, step, anchor=\"hypotheses\", msg=\"Hypothesis deleted.\", mk=\"ok\",\n384\t                          extra=f\"undo_hyp={hyp_id}\")\n385\t\n386\t\n387\t@router.post(\"/v/{vin}/job/{job_id}/hypotheses/{hyp_id}/undelete\", response_class=HTMLResponse)\n388\tasync def hypothesis_undelete(request: Request, vin: str, job_id: str, hyp_id: str,\n389\t                              by: str = Form(default=\"\"),\n390\t                              step: str = Form(default=\"7\")) -> RedirectResponse:\n391\t    try:\n392\t        jobs_bridge.undelete_hypothesis(job_id, hyp_id, by=by.strip() or None)\n393\t    except BridgeError as exc:\n394\t        return _step_redirect(vin, step, anchor=f\"hyp-{hyp_id}\", msg=str(exc), mk=\"err\")\n395\t    return _step_redirect(vin, step, anchor=f\"hyp-{hyp_id}\", msg=\"Hypothesis restored.\", mk=\"ok\")\n396\t\n397\t\n398\t@router.post(\"/v/{vin}/job/{job_id}/actions\", response_class=HTMLResponse)\n399\tasync def action_add(request: Request, vin: str, job_id: str,\n400\t                     kind: str = Form(...), text: str = Form(...),\n401\t                     step: str = Form(default=\"9\")) -> RedirectResponse:\n402\t    \"\"\"Step 9: record one repair action -- test, inspection, repair, part,\n403\t    clear, or a free-text note.\"\"\"\n404\t    jobs_bridge.add_action(job_id, kind, text)\n405\t    return _step_redirect(vin, step, anchor=\"actions\", msg=\"Action recorded.\", mk=\"ok\")\n406\t\n407\t\n408\t@router.post(\"/v/{vin}/job/{job_id}/tools-review\", response_class=HTMLResponse)\n409\tasync def tools_review_add(request: Request, vin: str, job_id: str) -> RedirectResponse:\n410\t    \"\"\"Step 12: the mandatory \"tools used\" review -- what was actually used\n411\t    at release, right/wrong/unsure with a reason, anything missing, and\n412\t    what he'd buy next time. Field names are dynamic (one triplet per\n413\t    recommended tool, keyed by tool key) because the recommended-tool list\n414\t    itself is dynamic, so this reads the raw form rather than a fixed\n415\t    Pydantic/Form model -- same reasoning job_page's tools panel is built\n416\t    for a variable-length list.\n417\t    \"\"\"\n418\t    form = await request.form()\n419\t\n420\t    def _get(key: str) -> str:\n421\t        v = form.get(key)\n422\t        return str(v).strip() if v is not None else \"\"\n423\t\n424\t    step = _get(\"step\") or \"diagnostics\"\n425\t    tools_used: list[dict[str, Any]] = []\n426\t    for key in form.keys():\n427\t        if key.startswith(\"used__\") and _get(key):\n428\t            tool_key = key[len(\"used__\"):]\n429\t            tools_used.append({\n430\t                \"tool\": tool_key,\n431\t                \"was_right\": _get(f\"right__{tool_key}\") or \"unsure\",\n432\t                \"note\": _get(f\"note__{tool_key}\"),\n433\t            })\n434\t    for i in range(1, 4):\n435\t        name = _get(f\"extra{i}_name\")\n436\t        if name:\n437\t            tools_used.append({\n438\t                \"tool\": name,\n439\t                \"was_right\": _get(f\"extra{i}_right\") or \"unsure\",\n440\t                \"note\": _get(f\"extra{i}_note\"),\n441\t            })\n442\t\n443\t    missing_tools = [m.strip() for m in _get(\"missing_tools\").split(\",\") if m.strip()]\n444\t\n445\t    would_buy: list[dict[str, Any]] = []\n446\t    for i in range(1, 4):\n447\t        name = _get(f\"buy{i}_name\")\n448\t        if name:\n449\t            would_buy.append({\"name\": name, \"why\": _get(f\"buy{i}_why\")})\n450\t\n451\t    time_min_raw = _get(\"time_min\")\n452\t    time_min = float(time_min_raw) if time_min_raw else None\n453\t\n454\t    jobs_bridge.add_tool_usage(vin, step, job_id, by=_get(\"by\"), tools_used=tools_used,\n455\t                               missing_tools=missing_tools, would_buy=would_buy,\n456\t                               time_min=time_min)\n457\t    return _step_redirect(vin, \"12\", anchor=\"outcome\", msg=\"Tools review saved.\", mk=\"ok\")\n458\t\n459\t\n460\t@router.post(\"/v/{vin}/job/{job_id}/close\", response_class=HTMLResponse)\n461\tasync def job_close(request: Request, vin: str, job_id: str,\n462\t                    outcome: str = Form(...),\n463\t                    codes_returned: str = Form(default=\"\"),\n464\t                    verdict: str = Form(default=\"\"),\n465\t                    tools_review_skip_reason: str = Form(default=\"\")) -> HTMLResponse:\n466\t    \"\"\"Step 12: close the case. Outcome is required -- a job can never be\n467\t    closed with no stated result. Also gated on the tools-used review\n468\t    (see ``jobs_bridge.close_job``) -- ``tools_review_skip_reason`` lets a\n469\t    mechanic close without filling the review, but only by stating why.\"\"\"\n470\t    codes = [c.strip() for c in codes_returned.split(\",\") if c.strip()]\n471\t    error = None\n472\t    try:\n473\t        jobs_bridge.close_job(job_id, outcome, codes_returned=codes or None,\n474\t                              verdict=verdict or None,\n475\t                              tools_review_skip_reason=tools_review_skip_reason)\n476\t    except BridgeError as exc:\n477\t        error = str(exc)\n478\t    # Rendered directly (no redirect) -- the close form lives on step 12's\n479\t    # screen, so that's the screen the re-render must show, regardless of\n480\t    # the flow's own current-step opinion, or a refusal would render onto\n481\t    # whatever step happens to be current and never be seen.\n482\t    return _job_page(request, vin, job_id=job_id, close_error=error, step=\"12\")\n483\t\n484\t\n485\t__all__ = [\"router\"]\n486\t"}]},"uuid":"f6716f36-ab18-41d7-9851-ea1bb15e57a5","timestamp":"2026-10-08T23:40:27.968Z","toolUseResult":{"type":"text","file":{"filePath":"C:\\Users\\User\\mcp-servers\\cuore\\web\\jobs_routes.py","content":"\"\"\"Web-form face of the Job (case) workflow.\n\nSame posture as ``cuore.web.dossier_routes``: a second router on the same\napp reusing ``cuore.web.routes``'s own page/dossier helpers, so rendering\nstays identical to every other ``/v/{vin}`` page. Every form here degrades\nwith no JavaScript -- a stepper of plain GET/POST/redirect forms, same\nconvention as ``/v/{vin}/dealer`` and ``/v/{vin}/notes``.\n\nJob UX pass (docs/research/JOB_UX_FIXES_2026-10-08.md), 2026-10-08: every\nmutating route below now redirects to ``?step=<the step it lives on>#<row\nanchor>`` with a ``msg``/``mk`` (message/kind) query pair a toast reads --\nnever to a different tab, never to a different step (fix #5).\n\n``cuore.services.jobs_bridge`` now carries the real guided-diagnostics\nengine: ``edit_hypothesis``/``delete_hypothesis``/``undelete_hypothesis``/\n``add_evidence``/``remove_evidence``/``resolve_evidence``/\n``add_test_evidence``/``check_similar``/``step_registry``, and\n``set_hypothesis`` enforces the confirm gate (open -> supported ->\nconfirmed, refuted from any state; confirm needs >=1 passed/failed test\nresult and 0 unresolved evidence_against -- fix #1) by raising\n``jobs_bridge.RuleViolation`` *unconverted* -- this module's only job is to\ncatch that (never let it 500) and redirect back to the same card with its\n``reason``/``next_test`` shown inline, per the 409 {detail, next_test}\ncontract. Every route below goes through ``jobs_bridge`` only -- no direct\n``mes.jobs`` import here.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport json\nfrom typing import Any\nfrom urllib.parse import quote\n\nfrom fastapi import APIRouter, Depends, Form, Request\nfrom fastapi.responses import HTMLResponse, RedirectResponse\n\nfrom .. import bootstrap  # noqa: F401  -- side effect: puts `mes` on sys.path\nfrom ..api.deps import require_token\nfrom ..services import cases_bridge, dossier_bridge, jobs_bridge, tools_kb_bridge\nfrom ..services.errors import BridgeError\nfrom . import routes as web_routes\n\nrouter = APIRouter(include_in_schema=False, dependencies=[Depends(require_token)])\n\ntry:  # fix #12: System picker is a taxonomy select, not free text\n    from mes import systems as _mes_systems\nexcept Exception:  # noqa: BLE001 -- the manual hypothesis form must still render\n    _mes_systems = None\n\n\ndef _systems_taxonomy() -> list[str]:\n    if _mes_systems is None:\n        return []\n    try:\n        return sorted({v.get(\"label\", k) for k, v in _mes_systems.systems().items()})\n    except Exception:  # noqa: BLE001\n        return []\n\n\nSYSTEMS_TAXONOMY: list[str] = _systems_taxonomy()\n\n\ndef _rule_violation_msg(exc: \"jobs_bridge.RuleViolation\") -> str:\n    \"\"\"One line out of a caught ``jobs_bridge.RuleViolation`` -- its own\n    ``reason`` plus ``next_test`` when there is one, exactly what the toast\n    shows (fix #1's 409 {detail, next_test} contract, rendered inline\n    instead of as a raw HTTP body since this route serves an HTML form).\"\"\"\n    reason = getattr(exc, \"reason\", None) or str(exc) or \"That wasn't allowed.\"\n    next_test = getattr(exc, \"next_test\", \"\") or \"\"\n    return f\"{reason} Next: {next_test}\" if next_test else reason\n\n\ndef _step_redirect(vin: str, step: str = \"\", anchor: str = \"\", msg: str = \"\",\n                   mk: str = \"ok\", extra: str = \"\") -> RedirectResponse:\n    \"\"\"Every mutating route's one exit: back to the *same* step, never a\n    different tab or step (fix #5) -- optionally with a one-line toast\n    message/kind and any extra query the receiving page wants (e.g.\n    ``confirm=<hyp_id>`` for the confirm-summary panel).\"\"\"\n    parts = []\n    if step:\n        parts.append(f\"step={quote(str(step))}\")\n    if msg:\n        parts.append(f\"msg={quote(msg)}\")\n        parts.append(f\"mk={quote(mk)}\")\n    if extra:\n        parts.append(extra)\n    qs = (\"?\" + \"&\".join(parts)) if parts else \"\"\n    frag = f\"#{anchor}\" if anchor else \"\"\n    return RedirectResponse(url=f\"/v/{vin}/job{qs}{frag}\", status_code=303)\n\n\n@router.post(\"/tools-kb/inventory-form\", response_class=HTMLResponse)\nasync def tools_inventory_form(status: str = Form(...), tool: str = Form(...),\n                               return_to: str = Form(default=\"/\")) -> RedirectResponse:\n    \"\"\"The \"I have this / I don't\" button pair on the tools panel -- a\n    garage-wide owned/not-owned list (``cuore.services.tools_kb_bridge``),\n    not tied to any one vehicle, so it lives here rather than under\n    ``/v/{vin}/...`` even though the tools panel itself renders on\n    vehicle-scoped pages (job.html, maintenance.html).\"\"\"\n    tools_kb_bridge.inventory_set(tool, status)\n    return RedirectResponse(url=return_to or \"/\", status_code=303)\n\n\ndef _job_page(request: Request, vin: str, job_id: str = \"\", tools_step: str = \"\",\n             step: str = \"\", **extra: Any) -> HTMLResponse:\n    dossier = web_routes._dossier(vin)\n    bar = web_routes._vehicle_bar(vin, dossier)\n    job_view = jobs_bridge.build_job_view(vin, job_id or None, tools_step=tools_step or None)\n    # Run 2, #9: _vehicle_bar falls back to \"(unnamed vehicle)\" straight\n    # off dossier.identity; job_view[\"vehicle\"] already carries\n    # jobs_bridge._vehicle_name's richer resolution (shop_bridge corpus\n    # name, then a WMI decode) -- the same fix bench_routes.py applies to\n    # its own bar, so the Job tab's banner stops disagreeing with Bench's.\n    if job_view.get(\"vehicle\"):\n        bar[\"name\"] = job_view[\"vehicle\"]\n    live_status = web_routes._status_strip()\n    try:\n        dossier_view = dossier_bridge.build_view(vin, dossier, live_status)\n    except Exception:  # noqa: BLE001 -- the job page must still render\n        dossier_view = {\"verdict\": None, \"open_work\": [], \"codes\": [],\n                        \"code_counts\": {}, \"attempted\": []}\n    active_codes = [c[\"code\"] for c in dossier_view.get(\"codes\", [])\n                    if c.get(\"status\") == \"ACTIVE\"]\n    try:\n        case_prefill = cases_bridge.prefill(vin, active_codes)\n    except Exception:  # noqa: BLE001 -- case memory must never 500 the job page\n        case_prefill = None\n\n    # --- display-only reshaping of job_view for this render (fix #11/#13):\n    # active (non-deleted) hypotheses ranked by net evidence with the\n    # leading one pinned first; deleted ones split out for an Undo row.\n    # ``jobs_bridge.suggested_hypotheses`` already dedupes+ranks its own\n    # list, so the suggestions themselves need no further work here --\n    # job.html just slices the first 3 off for \"top\" vs. \"Show N more\".\n    # Never mutates the stored job; this dict is built fresh per request.\n    hyps = list((job_view.get(\"job\") or {}).get(\"hypotheses\") or [])\n    active_hyps = [h for h in hyps if not h.get(\"deleted\")]\n    deleted_hyps = [h for h in hyps if h.get(\"deleted\")]\n    active_hyps.sort(\n        key=lambda h: (len(h.get(\"evidence_for\") or []) - len(h.get(\"evidence_against\") or [])),\n        reverse=True,\n    )\n    if job_view.get(\"job\"):\n        job_view[\"job\"][\"hypotheses\"] = active_hyps\n    job_view[\"deleted_hypotheses\"] = deleted_hyps\n\n    # Toast/flash state from a mutating route's redirect (fix #5) -- read\n    # straight off the query string so this works with zero JavaScript;\n    # job.js upgrades the same params into a nicer dismissable toast.\n    qp = request.query_params\n    flash_msg = qp.get(\"msg\") or \"\"\n    flash_kind = qp.get(\"mk\") or \"ok\"\n    confirm_pending = qp.get(\"confirm\") or \"\"\n    undo_hyp = qp.get(\"undo_hyp\") or \"\"\n\n    # `view` carries the full dossier view -- the shape _verdict_card.html,\n    # _codes_table.html and _open_work.html already expect everywhere else\n    # they're included; `job_view` carries the Job-specific data only\n    # job.html itself reads.\n    response = web_routes._page(request, \"job.html\", vin=vin, bar=bar, view=dossier_view,\n                                job_view=job_view, case_prefill=case_prefill,\n                                active_codes=active_codes, tab=\"job\", step=step,\n                                flash_msg=flash_msg, flash_kind=flash_kind,\n                                confirm_pending=confirm_pending, undo_hyp=undo_hyp,\n                                systems_taxonomy=SYSTEMS_TAXONOMY, **extra)\n    web_routes._set_active_vehicle(response, vin)\n    return response\n\n\n@router.get(\"/v/{vin}/job\", response_class=HTMLResponse)\ndef job_page(request: Request, vin: str, tools_step: str = \"\", step: str = \"\") -> HTMLResponse:\n    \"\"\"The current (or most recent) job for this vehicle, one step per\n    screen -- ``step`` is the only query param this page reads to pick\n    which of the 12 steps is the full screen (default: the flow's own\n    current step, resolved inside job.html itself).\"\"\"\n    return _job_page(request, vin, tools_step=tools_step, step=step)\n\n\n@router.get(\"/v/{vin}/job/{job_id}\", response_class=HTMLResponse)\ndef job_page_one(request: Request, vin: str, job_id: str, tools_step: str = \"\",\n                 step: str = \"\") -> HTMLResponse:\n    \"\"\"One specific job by id -- e.g. a closed case from this car's history.\"\"\"\n    return _job_page(request, vin, job_id=job_id, tools_step=tools_step, step=step)\n\n\n@router.post(\"/v/{vin}/job/open\", response_class=HTMLResponse)\nasync def job_open(request: Request, vin: str,\n                   technician: str = Form(default=\"\"),\n                   complaint: str = Form(default=\"\")) -> RedirectResponse:\n    \"\"\"Step 1: open a new case for this vehicle, in the driver's own words.\"\"\"\n    jobs_bridge.open_job(vin, technician=technician, complaint=complaint)\n    return _step_redirect(vin, \"1\", msg=\"Case opened.\", mk=\"ok\")\n\n\n@router.post(\"/v/{vin}/job/{job_id}/hypotheses\", response_class=HTMLResponse)\nasync def hypothesis_add(request: Request, vin: str, job_id: str,\n                         text: str = Form(...), system: str = Form(default=\"\"),\n                         next_test: str = Form(default=\"\"),\n                         likelihood: str = Form(default=\"\"),\n                         codes: str = Form(default=\"\"),\n                         by: str = Form(default=\"\"),\n                         step: str = Form(default=\"7\")) -> RedirectResponse:\n    \"\"\"Step 7: add a hypothesis by hand (fix #12: System is a taxonomy pick,\n    Linked codes a multi-select of open DTCs, Likelihood Low/Med/High).\"\"\"\n    code_list = [c.strip() for c in codes.split(\",\") if c.strip()]\n    likelihood_val = likelihood.strip().lower() or None\n    try:\n        hyp = jobs_bridge.add_hypothesis(job_id, text, system=system, next_test=next_test,\n                                         codes=code_list or None, likelihood=likelihood_val,\n                                         by=by.strip() or None)\n    except BridgeError as exc:\n        return _step_redirect(vin, step, anchor=\"add-hypothesis\", msg=str(exc), mk=\"err\")\n    return _step_redirect(vin, step, anchor=f\"hyp-{hyp['id']}\", msg=\"Hypothesis added.\", mk=\"ok\")\n\n\n@router.get(\"/v/{vin}/job/{job_id}/hypotheses/similar\")\ndef hypothesis_similar(vin: str, job_id: str, text: str = \"\", system: str = \"\") -> dict[str, Any]:\n    \"\"\"Fix #11's \"Similar to ... -- merge?\" prompt, read live as the tech\n    types (job.js debounces this) -- thin pass-through to\n    ``jobs_bridge.check_similar``, the real token-overlap check against the\n    job on file, so the prompt is never a client-side guess. No JS -> no\n    prompt, no behaviour change: the manual-add form still saves a new\n    hypothesis either way.\"\"\"\n    try:\n        match = jobs_bridge.check_similar(job_id, text, system)\n    except Exception:  # noqa: BLE001 -- a hint must never 500\n        match = None\n    if not match:\n        return {\"similar\": None}\n    return {\"similar\": {\"id\": match[\"id\"], \"text\": match[\"text\"]}}\n\n\n@router.post(\"/v/{vin}/job/{job_id}/hypotheses/suggested\", response_class=HTMLResponse)\nasync def hypothesis_add_suggested(request: Request, vin: str, job_id: str,\n                                   text: str = Form(...), system: str = Form(default=\"\"),\n                                   next_test: str = Form(default=\"\"),\n                                   evidence_for: str = Form(default=\"[]\"),\n                                   evidence_against: str = Form(default=\"[]\"),\n                                   step: str = Form(default=\"7\")\n                                   ) -> RedirectResponse:\n    \"\"\"Step 7: promote one of the auto-suggested hypotheses, with its real\n    evidence attached in the same step -- the refs travel as a hidden JSON\n    field rather than being retyped, so nothing here can invent evidence\n    that was not already shown on the page.\"\"\"\n    suggestion = {\n        \"text\": text, \"system\": system, \"next_test\": next_test,\n        \"evidence_for\": json.loads(evidence_for) if evidence_for.strip() else [],\n        \"evidence_against\": json.loads(evidence_against) if evidence_against.strip() else [],\n    }\n    hyp = jobs_bridge.add_suggested_hypothesis(job_id, suggestion)\n    return _step_redirect(vin, step, anchor=f\"hyp-{hyp['id']}\",\n                          msg=\"Hypothesis added from suggestion.\", mk=\"ok\")\n\n\n@router.post(\"/v/{vin}/job/{job_id}/hypotheses/{hyp_id}/status\", response_class=HTMLResponse)\nasync def hypothesis_set_status(request: Request, vin: str, job_id: str, hyp_id: str,\n                                status: str = Form(...), step: str = Form(default=\"7\"),\n                                ack: str = Form(default=\"\"),\n                                by: str = Form(default=\"\")) -> RedirectResponse:\n    \"\"\"Step 7: the status buttons -- open / supported / refuted / confirmed.\n\n    Fix #1: ``jobs_bridge.set_hypothesis`` itself enforces the path (open ->\n    supported -> confirmed, refuted from any state) and the confirm gate\n    (>=1 passed/failed test evidence_for, 0 unresolved evidence_against),\n    raising ``jobs_bridge.RuleViolation`` -- caught below and shown inline\n    (the 409 {detail, next_test} contract, rendered as this HTML form's own\n    toast), never a 500 and never silently accepted. ``confirmed``\n    additionally needs a second tap (``ack=1``): the first tap just\n    redirects back with ``confirm=<hyp_id>`` so job.html renders the\n    evidence-summary panel job.js promotes into a modal -- its own \"confirm\n    again\" button is what actually sends ``ack=1``; if the gate would have\n    refused anyway, that second POST catches the same RuleViolation. ``by``\n    (who) rides along so the engine can stamp confirmed_by/at.\"\"\"\n    if status == \"confirmed\" and ack != \"1\":\n        return _step_redirect(vin, step, anchor=f\"hyp-{hyp_id}\", extra=f\"confirm={hyp_id}\")\n\n    # Job UX run 2, R8: Undo on a status-change toast, same posture as\n    # Delete's own undo below -- remember the status this hypothesis was\n    # on *before* this call so a toast click can put it straight back.\n    old_status = \"\"\n    try:\n        old_job = jobs_bridge.get_job(job_id)\n        old_hyp = next((h for h in (old_job.get(\"hypotheses\") or []) if h.get(\"id\") == hyp_id), None)\n        old_status = (old_hyp or {}).get(\"status\") or \"\"\n    except Exception:  # noqa: BLE001 -- the undo hint is never load-bearing\n        old_status = \"\"\n\n    try:\n        jobs_bridge.set_hypothesis(job_id, hyp_id, status=status, by=by.strip() or None)\n    except jobs_bridge.RuleViolation as exc:\n        return _step_redirect(vin, step, anchor=f\"hyp-{hyp_id}\",\n                              msg=_rule_violation_msg(exc), mk=\"err\")\n    except BridgeError as exc:\n        return _step_redirect(vin, step, anchor=f\"hyp-{hyp_id}\", msg=str(exc), mk=\"err\")\n    undo_extra = (f\"undo_status={quote(hyp_id)}:{quote(old_status)}\"\n                 if old_status and old_status != status else \"\")\n    return _step_redirect(vin, step, anchor=f\"hyp-{hyp_id}\", msg=f\"Status set to {status}.\",\n                          mk=\"ok\", extra=undo_extra)\n\n\n@router.post(\"/v/{vin}/job/{job_id}/hypotheses/{hyp_id}/next_test\", response_class=HTMLResponse)\nasync def hypothesis_set_next_test(request: Request, vin: str, job_id: str, hyp_id: str,\n                                   next_test: str = Form(default=\"\"),\n                                   step: str = Form(default=\"7\")) -> RedirectResponse:\n    jobs_bridge.set_hypothesis(job_id, hyp_id, next_test=next_test)\n    return _step_redirect(vin, step, anchor=f\"hyp-{hyp_id}\", msg=\"Saved.\", mk=\"ok\")\n\n\n@router.post(\"/v/{vin}/job/{job_id}/hypotheses/{hyp_id}/edit\", response_class=HTMLResponse)\nasync def hypothesis_edit(request: Request, vin: str, job_id: str, hyp_id: str,\n                          text: str = Form(default=\"\"), system: str = Form(default=\"\"),\n                          next_test: str = Form(default=\"\"),\n                          likelihood: str = Form(default=\"\"),\n                          codes: str = Form(default=\"\"),\n                          by: str = Form(default=\"\"),\n                          step: str = Form(default=\"7\")) -> RedirectResponse:\n    \"\"\"Fix #2: Edit -- any hypothesis field except status/evidence, which go\n    through their own gated routes so editing can never route around the\n    confirm gate.\"\"\"\n    kw: dict[str, Any] = {}\n    if text.strip():\n        kw[\"text\"] = text\n    if system:\n        kw[\"system\"] = system\n    if next_test:\n        kw[\"next_test\"] = next_test\n    if likelihood:\n        kw[\"likelihood\"] = likelihood.strip().lower()\n    if codes.strip():\n        kw[\"codes\"] = [c.strip() for c in codes.split(\",\") if c.strip()]\n    if not kw:\n        return _step_redirect(vin, step, anchor=f\"hyp-{hyp_id}\", msg=\"Nothing to save.\", mk=\"warn\")\n    try:\n        jobs_bridge.edit_hypothesis(job_id, hyp_id, by=by.strip() or None, **kw)\n    except BridgeError as exc:\n        return _step_redirect(vin, step, anchor=f\"hyp-{hyp_id}\", msg=str(exc), mk=\"err\")\n    return _step_redirect(vin, step, anchor=f\"hyp-{hyp_id}\", msg=\"Hypothesis updated.\", mk=\"ok\")\n\n\n@router.post(\"/v/{vin}/job/{job_id}/hypotheses/{hyp_id}/evidence\", response_class=HTMLResponse)\nasync def hypothesis_evidence(request: Request, vin: str, job_id: str, hyp_id: str,\n                              side: str = Form(default=\"for\"),\n                              kind: str = Form(default=\"observation\"),\n                              ref_id: str = Form(default=\"\"),\n                              label: str = Form(...),\n                              op: str = Form(default=\"add\"),\n                              by: str = Form(default=\"\"),\n                              step: str = Form(default=\"7\")) -> RedirectResponse:\n    \"\"\"Fix #2: + Evidence for / + Evidence against, and the remove side of\n    the same picker -- thin pass-through to ``jobs_bridge.add_evidence``/\n    ``remove_evidence``, which is what the confirm gate itself reads, so an\n    item linked here is real evidence for fix #1 the moment it's added.\"\"\"\n    side = side if side in (\"for\", \"against\") else \"for\"\n    if op == \"remove\":\n        try:\n            jobs_bridge.remove_evidence(job_id, hyp_id, side, ref_id or label,\n                                        ref_kind=kind or None, by=by.strip() or None)\n        except BridgeError as exc:\n            return _step_redirect(vin, step, anchor=f\"hyp-{hyp_id}\", msg=str(exc), mk=\"err\")\n        return _step_redirect(vin, step, anchor=f\"hyp-{hyp_id}\", msg=\"Evidence removed.\",\n                              mk=\"ok\", extra=f\"undo_ev={hyp_id}:{side}:{quote(label)}\")\n\n    ref = {\"kind\": kind or \"observation\", \"id\": ref_id or label, \"label\": label}\n    try:\n        jobs_bridge.add_evidence(job_id, hyp_id, side, ref, by=by.strip() or None)\n    except BridgeError as exc:\n        return _step_redirect(vin, step, anchor=f\"hyp-{hyp_id}\", msg=str(exc), mk=\"err\")\n    return _step_redirect(vin, step, anchor=f\"hyp-{hyp_id}\",\n                          msg=f\"Evidence {'for' if side == 'for' else 'against'} added.\", mk=\"ok\")\n\n\n@router.post(\"/v/{vin}/job/{job_id}/hypotheses/{hyp_id}/delete\", response_class=HTMLResponse)\nasync def hypothesis_delete(request: Request, vin: str, job_id: str, hyp_id: str,\n                            by: str = Form(default=\"\"),\n                            step: str = Form(default=\"7\")) -> RedirectResponse:\n    \"\"\"Fix #2: Delete, soft (``jobs_bridge.delete_hypothesis``) -- the card\n    itself stays on the audit trail; the undo offered in the toast is\n    :func:`hypothesis_undelete` below.\"\"\"\n    try:\n        jobs_bridge.delete_hypothesis(job_id, hyp_id, by=by.strip() or None)\n    except BridgeError as exc:\n        return _step_redirect(vin, step, anchor=\"hypotheses\", msg=str(exc), mk=\"err\")\n    return _step_redirect(vin, step, anchor=\"hypotheses\", msg=\"Hypothesis deleted.\", mk=\"ok\",\n                          extra=f\"undo_hyp={hyp_id}\")\n\n\n@router.post(\"/v/{vin}/job/{job_id}/hypotheses/{hyp_id}/undelete\", response_class=HTMLResponse)\nasync def hypothesis_undelete(request: Request, vin: str, job_id: str, hyp_id: str,\n                              by: str = Form(default=\"\"),\n                              step: str = Form(default=\"7\")) -> RedirectResponse:\n    try:\n        jobs_bridge.undelete_hypothesis(job_id, hyp_id, by=by.strip() or None)\n    except BridgeError as exc:\n        return _step_redirect(vin, step, anchor=f\"hyp-{hyp_id}\", msg=str(exc), mk=\"err\")\n    return _step_redirect(vin, step, anchor=f\"hyp-{hyp_id}\", msg=\"Hypothesis restored.\", mk=\"ok\")\n\n\n@router.post(\"/v/{vin}/job/{job_id}/actions\", response_class=HTMLResponse)\nasync def action_add(request: Request, vin: str, job_id: str,\n                     kind: str = Form(...), text: str = Form(...),\n                     step: str = Form(default=\"9\")) -> RedirectResponse:\n    \"\"\"Step 9: record one repair action -- test, inspection, repair, part,\n    clear, or a free-text note.\"\"\"\n    jobs_bridge.add_action(job_id, kind, text)\n    return _step_redirect(vin, step, anchor=\"actions\", msg=\"Action recorded.\", mk=\"ok\")\n\n\n@router.post(\"/v/{vin}/job/{job_id}/tools-review\", response_class=HTMLResponse)\nasync def tools_review_add(request: Request, vin: str, job_id: str) -> RedirectResponse:\n    \"\"\"Step 12: the mandatory \"tools used\" review -- what was actually used\n    at release, right/wrong/unsure with a reason, anything missing, and\n    what he'd buy next time. Field names are dynamic (one triplet per\n    recommended tool, keyed by tool key) because the recommended-tool list\n    itself is dynamic, so this reads the raw form rather than a fixed\n    Pydantic/Form model -- same reasoning job_page's tools panel is built\n    for a variable-length list.\n    \"\"\"\n    form = await request.form()\n\n    def _get(key: str) -> str:\n        v = form.get(key)\n        return str(v).strip() if v is not None else \"\"\n\n    step = _get(\"step\") or \"diagnostics\"\n    tools_used: list[dict[str, Any]] = []\n    for key in form.keys():\n        if key.startswith(\"used__\") and _get(key):\n            tool_key = key[len(\"used__\"):]\n            tools_used.append({\n                \"tool\": tool_key,\n                \"was_right\": _get(f\"right__{tool_key}\") or \"unsure\",\n                \"note\": _get(f\"note__{tool_key}\"),\n            })\n    for i in range(1, 4):\n        name = _get(f\"extra{i}_name\")\n        if name:\n            tools_used.append({\n                \"tool\": name,\n                \"was_right\": _get(f\"extra{i}_right\") or \"unsure\",\n                \"note\": _get(f\"extra{i}_note\"),\n            })\n\n    missing_tools = [m.strip() for m in _get(\"missing_tools\").split(\",\") if m.strip()]\n\n    would_buy: list[dict[str, Any]] = []\n    for i in range(1, 4):\n        name = _get(f\"buy{i}_name\")\n        if name:\n            would_buy.append({\"name\": name, \"why\": _get(f\"buy{i}_why\")})\n\n    time_min_raw = _get(\"time_min\")\n    time_min = float(time_min_raw) if time_min_raw else None\n\n    jobs_bridge.add_tool_usage(vin, step, job_id, by=_get(\"by\"), tools_used=tools_used,\n                               missing_tools=missing_tools, would_buy=would_buy,\n                               time_min=time_min)\n    return _step_redirect(vin, \"12\", anchor=\"outcome\", msg=\"Tools review saved.\", mk=\"ok\")\n\n\n@router.post(\"/v/{vin}/job/{job_id}/close\", response_class=HTMLResponse)\nasync def job_close(request: Request, vin: str, job_id: str,\n                    outcome: str = Form(...),\n                    codes_returned: str = Form(default=\"\"),\n                    verdict: str = Form(default=\"\"),\n                    tools_review_skip_reason: str = Form(default=\"\")) -> HTMLResponse:\n    \"\"\"Step 12: close the case. Outcome is required -- a job can never be\n    closed with no stated result. Also gated on the tools-used review\n    (see ``jobs_bridge.close_job``) -- ``tools_review_skip_reason`` lets a\n    mechanic close without filling the review, but only by stating why.\"\"\"\n    codes = [c.strip() for c in codes_returned.split(\",\") if c.strip()]\n    error = None\n    try:\n        jobs_bridge.close_job(job_id, outcome, codes_returned=codes or None,\n                              verdict=verdict or None,\n                              tools_review_skip_reason=tools_review_skip_reason)\n    except BridgeError as exc:\n        error = str(exc)\n    # Rendered directly (no redirect) -- the close form lives on step 12's\n    # screen, so that's the screen the re-render must show, regardless of\n    # the flow's own current-step opinion, or a refusal would render onto\n    # whatever step happens to be current and never be seen.\n    return _job_page(request, vin, job_id=job_id, close_error=error, step=\"12\")\n\n\n__all__ = [\"router\"]\n","numLines":486,"startLine":1,"totalLines":486}},"sourceToolAssistantUUID":"216bb5df-3d15-42fb-a208-79b031d895f4","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
{"parentUuid":"f6716f36-ab18-41d7-9851-ea1bb15e57a5","isSidechain":true,"agentId":"ad3b2406af84b2e4d","message":{"model":"claude-sonnet-5","id":"msg_011CfqertjDtq5FvUHFsAfMn","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01Xn8HE3VbfgjUhKFBx6YV6z","name":"Read","input":{"file_path":"C:\\Users\\User\\mcp-servers\\cuore\\web\\templates\\bench.html"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":4621,"cache_read_input_tokens":56797,"cache_creation":{"ephemeral_5m_input_tokens":4621,"ephemeral_1h_input_tokens":0},"output_tokens":4,"service_tier":"standard","inference_geo":"not_available"},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_01Xn8HE3VbfgjUhKFBx6YV6z":{"file_path":"C:\\Users\\User\\mcp-servers\\cuore\\web\\templates\\bench.html"}},"apiBlockIndex":2,"requestId":"req_011CfqertUbTTc9n9sMdNA5B","attributionAgent":"general-purpose","type":"assistant","uuid":"a7bca4cf-8b1a-41b9-9739-879725e72f1f","timestamp":"2026-10-08T23:40:28.118Z","effort":"high","perTurnEffort":null,"userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
{"parentUuid":"a7bca4cf-8b1a-41b9-9739-879725e72f1f","isSidechain":true,"promptId":"c88cddde-d9ec-4df1-89bf-4cd0fc5db786","agentId":"ad3b2406af84b2e4d","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Xn8HE3VbfgjUhKFBx6YV6z","type":"tool_result","content":"1\t{# The bench: what to do to this car right now. cuore/services/bench_bridge.py\n2\t   already boiled the dossier down to a resume summary, a verdict sentence\n3\t   and a small task roster (each with procedure, pass criteria,\n4\t   preconditions and parts/tools already resolved) -- this template's only\n5\t   job is to lay those out small enough that the resume card and first task\n6\t   are on-screen on a 400x800 phone with no scrolling. See that module's own\n7\t   docstring for where each field comes from; nothing here recomputes a\n8\t   verdict, a part number, a tool's have/not-have status, or a pass\n9\t   criterion. #}\n10\t{% extends \"base.html\" %}\n11\t{% block title %}{{ bench.vehicle }} &mdash; Bench &middot; {{ bench.progress.done }}/{{ bench.progress.total }} &middot; {{ bench.verdict.state or \"NO_DATA\" }}{% endblock %}\n12\t\n13\t{# Standard persistent vehicle hero + tab strip, same include every other\n14\t   /v/{vin}/* page uses (BENCH_UX_SPEC_2026-10-08.md F16: one tab bar across\n15\t   every view, not just the dossier). _vbar.html shows the full hero (image,\n16\t   verdict headline, figures) for tab == \"bench\"/\"report\" -- see that\n17\t   module's own docstring -- and includes _vtabs.html itself at the end, so\n18\t   nothing else here needs to. #}\n19\t{% block vehiclebar %}{% include \"_vbar.html\" %}{% endblock %}\n20\t\n21\t{% block content %}\n22\t<style>\n23\t/* Scoped to .bench -- no shared rule touched, so this page can be tuned\n24\t   without risking any other page's layout. Uses the same custom\n25\t   properties cuore.css already defines (colours/radius/mono/sans), so\n26\t   light/dark/marque theming is inherited for free. */\n27\t.bench { display: flex; flex-direction: column; gap: 10px; max-width: 100%; }\n28\t.bench-complaint {\n29\t  margin: 4px 0 0; font-size: 14px; font-style: italic; color: var(--ink-2);\n30\t  overflow-wrap: anywhere;\n31\t}\n32\t.bench-next-action {\n33\t  margin: 0; font-size: 20px; line-height: 1.3; font-weight: 600;\n34\t  color: var(--ink); overflow-wrap: anywhere;\n35\t}\n36\t.bench-case-hint { margin: 0; }\n37\t\n38\t/* Item 17: the one blocker/next-action banner on the whole page. */\n39\t.bench-blocker-banner {\n40\t  display: flex; align-items: flex-start; gap: 8px; padding: 10px;\n41\t  background: var(--sev-chronic-bg); border: 1px solid var(--sev-chronic);\n42\t  border-radius: var(--radius);\n43\t}\n44\t.bench-blocker-banner:not(.is-blocker) {\n45\t  background: var(--surface-2); border-color: var(--rule);\n46\t}\n47\t.bench-blocker-banner .bench-next-action { flex: 1 1 auto; }\n48\t\n49\t/* Resume card (A1) */\n50\t.bench-resume {\n51\t  background: var(--raised); border: 1px solid var(--rule);\n52\t  border-radius: var(--radius); padding: 10px; display: flex;\n53\t  flex-direction: column; gap: 4px; max-width: 100%;\n54\t}\n55\t.bench-resume-row { display: flex; flex-wrap: wrap; gap: 8px; align-items: baseline; font-size: 13px; }\n56\t.bench-resume-progress { font-weight: 650; }\n57\t.bench-resume-stale { color: var(--sev-returned); font-weight: 650; }\n58\t.bench-resume-changes { margin: 0; padding-left: 18px; font-size: 13px; }\n59\t.bench-resume-next { margin: 2px 0 0; font-weight: 600; }\n60\t\n61\t/* Fuel gate + readiness (C10) */\n62\t.bench-gates { display: flex; flex-wrap: wrap; gap: 8px; }\n63\t.bench-gate {\n64\t  flex: 1 1 160px; background: var(--surface-2); border: 1px solid var(--rule);\n65\t  border-radius: var(--radius); padding: 8px; font-size: 12px;\n66\t}\n67\t.bench-gate h4 { margin: 0 0 4px; font-size: 12px; }\n68\t.bench-gate.out { border-color: var(--sev-returned); }\n69\t\n70\t.bench-actions { display: flex; flex-direction: column; gap: 10px; }\n71\t.bench-job-shared { font-size: 12px; overflow-wrap: anywhere; }\n72\t.bench-card {\n73\t  display: flex; gap: 10px; align-items: flex-start;\n74\t  background: var(--raised); border: 1px solid var(--rule);\n75\t  border-radius: var(--radius); padding: 10px; max-width: 100%;\n76\t}\n77\t.bench-card[data-state=\"blocked\"] { border-color: var(--sev-chronic); }\n78\t.bench-card[data-state=\"done\"] { opacity: 0.85; }\n79\t.bench-check {\n80\t  flex: none; display: flex; flex-direction: column; align-items: center;\n81\t  justify-content: center; gap: 2px; min-width: 48px; min-height: 48px;\n82\t}\n83\t.bench-checkbox-real { width: 28px; height: 28px; cursor: pointer; }\n84\t.bench-check-label { font-size: 12px; color: var(--ink-3); }\n85\t.bench-card-body { flex: 1 1 auto; min-width: 0; display: flex; flex-direction: column; gap: 6px; }\n86\t.bench-card-text {\n87\t  font-size: 15px; display: flex; align-items: center; gap: 6px;\n88\t  overflow-wrap: anywhere; cursor: pointer; min-height: 44px;\n89\t}\n90\t.bench-state-badge { font-size: 10px; margin-left: auto; }\n91\t.bench-state-badge.state-ready { color: var(--ok); background: var(--ok-bg); }\n92\t.bench-state-badge.state-blocked { color: var(--sev-returned); background: var(--sev-returned-bg); }\n93\t.bench-state-badge.state-done { color: var(--ink-3); background: var(--surface-2); }\n94\t.bench-bulletin { align-self: flex-start; white-space: normal; max-width: 100%; }\n95\t.bench-parts, .bench-tools { font-size: 12px; overflow-wrap: anywhere; }\n96\t.bench-part { margin-right: 6px; }\n97\t.bench-tool {\n98\t  margin-right: 4px; margin-bottom: 4px; display: inline-block;\n99\t  white-space: normal; max-width: 100%; overflow-wrap: anywhere;\n100\t}\n101\t.bench-tool.ok { color: var(--ok); background: var(--ok-bg); }\n102\t.bench-tool.not-ok { color: var(--sev-returned); background: var(--sev-returned-bg); }\n103\t\n104\t.bench-card-detail { display: flex; flex-direction: column; gap: 4px; padding-top: 4px; font-size: 13px; }\n105\t.bench-preconditions { display: flex; flex-wrap: wrap; gap: 6px; }\n106\t.bench-precondition.ok { color: var(--ok); background: var(--ok-bg); }\n107\t.bench-precondition.not-ok { color: var(--sev-returned); background: var(--sev-returned-bg); }\n108\t.bench-pass-line { font-weight: 600; }\n109\t.bench-inspect-steps { margin: 0; padding-left: 18px; }\n110\t.bench-outcome-fields { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; padding-top: 4px; }\n111\t.bench-outcome-fields select, .bench-outcome-fields input[type=\"text\"] { min-height: 48px; }\n112\t.bench-outcome-fields input[type=\"text\"] { flex: 1 1 140px; min-width: 0; }\n113\t.bench-outcome-fields .btn { min-height: 48px; min-width: 48px; }\n114\t.bench-done-summary { margin: 0; }\n115\t\n116\t.bench-shortcuts { display: flex; flex-wrap: wrap; gap: 6px; }\n117\t.bench-shortcut {\n118\t  white-space: normal; text-decoration: none; min-height: 44px;\n119\t  display: inline-flex; align-items: center;\n120\t}\n121\t.bench-shortcut.v-active { color: var(--sev-returned); background: var(--sev-returned-bg); }\n122\t.bench-shortcut.v-cleared-unverified { color: var(--sev-chronic); background: var(--sev-chronic-bg); }\n123\t.bench-legend { margin: 2px 0 0; }\n124\t.bench-legend .chip { margin-right: 2px; }\n125\t\n126\t.bench-why { margin: 0; }\n127\t.bench-why summary { cursor: pointer; font-size: 13px; }\n128\t\n129\t.bench-links { display: flex; gap: 8px; flex-wrap: wrap; padding-top: 4px; }\n130\t.bench-links .btn { min-height: 48px; display: inline-flex; align-items: center; }\n131\t</style>\n132\t\n133\t<div class=\"bench\" data-vin=\"{{ vin }}\">\n134\t\n135\t  {% if bench.complaint %}\n136\t    <p class=\"bench-complaint\">&ldquo;{{ bench.complaint }}&rdquo;</p>\n137\t  {% endif %}\n138\t\n139\t  {# Item 17: the blocker/next-action sentence shown ONCE, as a banner --\n140\t     icon, one-line action (class kept as \"bench-next-action\" so it is\n141\t     never mistaken for -- or buried inside -- a collapsed disclosure),\n142\t     \"Why?\" for the full sentence + verdict basis. Replaces the old\n143\t     resume-card line + bare headline + separate \"Why {{state}}?\" block,\n144\t     which repeated this same sentence 3 times (JOB_UX_FIXES item 17). #}\n145\t  {% if bench.blocker_banner %}\n146\t    <div class=\"bench-blocker-banner{{ ' is-blocker' if bench.blocker_banner.is_blocker }}\">\n147\t      {% if icon is defined %}{{ icon(bench.blocker_banner.icon, size=\"s\") }}{% endif %}\n148\t      <p class=\"bench-next-action\">{{ bench.blocker_banner.action }}</p>\n149\t      {% if bench.blocker_banner.why != bench.blocker_banner.action or bench.blocker_banner.basis %}\n150\t        <details class=\"bench-why\">\n151\t          <summary>Why?</summary>\n152\t          <p class=\"small muted\" style=\"margin:4px 0 0\">{{ bench.blocker_banner.why }}</p>\n153\t          {% if bench.blocker_banner.basis %}\n154\t            <ul class=\"small muted\">\n155\t              {% for b in bench.blocker_banner.basis %}<li>{{ b }}</li>{% endfor %}\n156\t            </ul>\n157\t          {% endif %}\n158\t        </details>\n159\t      {% endif %}\n160\t    </div>\n161\t  {% endif %}\n162\t\n163\t  {% if bench.case_hint %}\n164\t    <p class=\"bench-case-hint small muted\">{{ bench.case_hint }}</p>\n165\t  {% endif %}\n166\t\n167\t  {# Bench order (item 17): status line (vbar) -> blocker banner (above) ->\n168\t     the 3 next-action cards -> resume details -> fuel gate/readiness ->\n169\t     job-level parts/tools -> codes row -> links. #}\n170\t  <div class=\"bench-actions\">\n171\t    {% for a in bench.next_actions %}\n172\t      <div class=\"bench-card\" id=\"task-{{ a.step_id }}\" data-task-id=\"{{ a.step_id }}\" data-state=\"{{ a.state|lower }}\">\n173\t        <form method=\"post\" action=\"{{ a.href_tick }}\" class=\"bench-check\">\n174\t          <input type=\"hidden\" name=\"step_id\" value=\"{{ a.step_id }}\">\n175\t          <input type=\"checkbox\" id=\"chk-{{ a.step_id }}\" name=\"done\" value=\"1\"\n176\t                 class=\"bench-checkbox-real\" {% if a.done %}checked{% endif %}\n177\t                 aria-label=\"{{ (t('mark_done') if t is defined else 'Mark done') }}: {{ a.text }}\"\n178\t                 form=\"form-{{ a.step_id }}\">\n179\t          <label for=\"chk-{{ a.step_id }}\" class=\"bench-check-label\">{{ t('mark_done') if t is defined else 'Mark done' }}</label>\n180\t        </form>\n181\t        <div class=\"bench-card-body\">\n182\t          <details>\n183\t            <summary class=\"bench-card-text\">\n184\t              {% if icon is defined %}{{ icon(a.icon, size=\"s\") }}{% endif %}\n185\t              <span>{{ a.text }}</span>\n186\t              <span class=\"chip plain bench-state-badge state-{{ a.state|lower }}\">{{ a.state }}{% if a.blocked_reason %}: {{ a.blocked_reason }}{% endif %}</span>\n187\t            </summary>\n188\t            <div class=\"bench-card-detail\">\n189\t              {% if a.preconditions %}\n190\t                <div class=\"bench-preconditions\">\n191\t                  {% for p in a.preconditions %}\n192\t                    <span class=\"chip plain bench-precondition {{ 'ok' if p.ok else 'not-ok' }}\">\n193\t                      {{ p.label }}: {{ 'ok' if p.ok else 'blocked' }}\n194\t                      {% if not p.ok and p.fix_href %} &mdash; <a href=\"{{ p.fix_href }}\">{{ p.fix_label }}</a>{% endif %}\n195\t                      {% if not p.ok and p.fix_text %} &mdash; {{ p.fix_text }}{% endif %}\n196\t                    </span>\n197\t                  {% endfor %}\n198\t                </div>\n199\t              {% endif %}\n200\t              <p style=\"margin:0\"><b>Procedure:</b>\n201\t                {{ a.detail.procedure.test or \"UNKNOWN -- no sourced procedure for this step yet; confirm on the car / service manual\" }}</p>\n202\t              {% if a.detail.procedure.tools %}\n203\t                <p class=\"small muted\" style=\"margin:0\">Tool: {{ a.detail.procedure.tools }}</p>\n204\t              {% endif %}\n205\t              <p class=\"bench-pass-line\" style=\"margin:0\">Pass = {{ a.detail.pass_line }}</p>\n206\t              {% if a.detail.if_abnormal %}\n207\t                <p class=\"small muted\" style=\"margin:0\">If abnormal: {{ a.detail.if_abnormal }}</p>\n208\t              {% endif %}\n209\t              {% if a.detail.doc %}\n210\t                <p class=\"small\" style=\"margin:0\">Doc:\n211\t                  {% if a.detail.doc.href %}<a href=\"{{ a.detail.doc.href }}\">{{ a.detail.doc.id }}</a>{% else %}{{ a.detail.doc.id }}{% endif %}\n212\t                  {% if a.detail.doc.title %} &mdash; {{ a.detail.doc.title }}{% endif %}</p>\n213\t              {% endif %}\n214\t              {% if a.detail.inspect_steps %}\n215\t                <ul class=\"bench-inspect-steps small muted\">\n216\t                  {% for s in a.detail.inspect_steps %}\n217\t                    <li>{{ s.element }}: {{ s.what }} ({{ s.how }}) &mdash; {{ s.source }}</li>\n218\t                  {% endfor %}\n219\t                </ul>\n220\t              {% endif %}\n221\t\n222\t              <form method=\"post\" action=\"{{ a.href_tick }}\" id=\"form-{{ a.step_id }}\" class=\"bench-outcome-fields\">\n223\t                <input type=\"hidden\" name=\"step_id\" value=\"{{ a.step_id }}\">\n224\t                <select name=\"outcome\">\n225\t                  <option value=\"ok\" {% if a.outcome == 'ok' %}selected{% endif %}>OK</option>\n226\t                  <option value=\"fault_found\" {% if a.outcome == 'fault_found' %}selected{% endif %}>Fault found</option>\n227\t                  <option value=\"skipped\" {% if a.outcome == 'skipped' %}selected{% endif %}>Skipped</option>\n228\t                </select>\n229\t                <input type=\"text\" name=\"note\" placeholder=\"finding / reason\" value=\"{{ a.note or '' }}\">\n230\t                <button type=\"submit\" class=\"btn\">Save</button>\n231\t              </form>\n232\t              {% if a.done %}\n233\t                <p class=\"bench-done-summary small muted\">Done {{ a.done_at }}{% if a.done_by %} by {{ a.done_by }}{% endif %}\n234\t                  {% if a.outcome %} &mdash; {{ a.outcome|replace('_', ' ') }}{% endif %}{% if a.note %}: {{ a.note }}{% endif %}</p>\n235\t              {% endif %}\n236\t            </div>\n237\t          </details>\n238\t          {% if a.bulletin %}\n239\t            <span class=\"chip plain bench-bulletin\">{{ a.bulletin.id }}</span>\n240\t          {% endif %}\n241\t          {% if a.parts %}\n242\t            <div class=\"bench-parts muted\">\n243\t              {% for p in a.parts %}\n244\t                <span class=\"bench-part\">{{ p.name }}{% if p.number %} &middot;\n245\t                  <span class=\"mono\">{{ p.number }}</span>{% endif %}</span>\n246\t              {% endfor %}\n247\t            </div>\n248\t          {% endif %}\n249\t          {% if a.tools %}\n250\t            <div class=\"bench-tools\">\n251\t              {% for tl in a.tools %}\n252\t                <span class=\"chip plain bench-tool {{ 'ok' if tl.have == 'owned' else ('not-ok' if tl.have == 'not_owned' else '') }}\">\n253\t                  {{ tl.name }} &mdash;\n254\t                  {{ \"have\" if tl.have == \"owned\" else (\"not owned\" if tl.have == \"not_owned\" else \"unknown: ask\") }}\n255\t                </span>\n256\t              {% endfor %}\n257\t            </div>\n258\t          {% endif %}\n259\t        </div>\n260\t      </div>\n261\t    {% else %}\n262\t      <p class=\"muted small\">{{ t('nothing_open') if t is defined else 'Nothing open on the checklist.' }}</p>\n263\t    {% endfor %}\n264\t  </div>\n265\t\n266\t  {# A1/A2: resume details -- last scan, what changed, N of M done. The\n267\t     next-action sentence itself lives solely in the banner above now\n268\t     (item 17), so this card no longer repeats it. #}\n269\t  <div class=\"bench-resume\">\n270\t    <div class=\"bench-resume-row\">\n271\t      <span>last scan {{ bench.resume.last_scan_relative }}</span>\n272\t      {% if bench.scan_stale %}\n273\t        <span class=\"bench-resume-stale\">&middot; stale (&gt; 24 h)</span>\n274\t      {% endif %}\n275\t      <span class=\"bench-resume-progress\">&middot; {{ bench.progress.done }} of {{ bench.progress.total }} done</span>\n276\t      {# Item 9: bench_bridge.scanner_label()/LABELS -- never the raw MES\n277\t         state enum (the persistent per-tab banner in _vbar.html shows the\n278\t         same word for every other /v/ page; this is the Bench's own). #}\n279\t      <span class=\"muted\">&middot; Scanner: {{ bench.scanner_label }}</span>\n280\t    </div>\n281\t    {% if bench.resume.changed %}\n282\t      <ul class=\"bench-resume-changes\">\n283\t        {% for c in bench.resume.changed %}<li>{{ c }}</li>{% endfor %}\n284\t      </ul>\n285\t    {% elif not bench.resume.is_first_visit %}\n286\t      <p class=\"small muted\" style=\"margin:0\">nothing changed since your last visit</p>\n287\t    {% endif %}\n288\t  </div>\n289\t\n290\t  {# C10: live fuel gate + readiness panel #}\n291\t  <div class=\"bench-gates\">\n292\t    <div class=\"bench-gate {{ 'out' if bench.fuel_gate.in_window == False }}\">\n293\t      <h4>Fuel gate (EVAP needs 15&ndash;85%)</h4>\n294\t      {% if bench.fuel_gate.level is not none %}\n295\t        <p style=\"margin:0\">{{ bench.fuel_gate.level }}%\n296\t          {% if bench.fuel_gate.in_window %} &mdash; in window\n297\t          {% else %} &mdash; {{ bench.fuel_gate.direction }} window{% endif %}</p>\n298\t        {% if bench.fuel_gate.litres_to_target is not none %}\n299\t          <p class=\"small muted\" style=\"margin:0\">burn ~{{ bench.fuel_gate.litres_to_target }} L to reach 85%</p>\n300\t        {% else %}\n301\t          <p class=\"small muted\" style=\"margin:0\">litres to burn: UNKNOWN (no sourced tank capacity)</p>\n302\t        {% endif %}\n303\t      {% else %}\n304\t        <p class=\"small muted\" style=\"margin:0\">UNKNOWN &mdash; no fuel reading on file</p>\n305\t      {% endif %}\n306\t    </div>\n307\t    <div class=\"bench-gate\">\n308\t      <h4>Readiness</h4>\n309\t      {% if bench.readiness.monitors %}\n310\t        <p style=\"margin:0\">{{ bench.readiness.monitors|selectattr(\"complete\")|list|length }}/{{ bench.readiness.monitors|length }} complete</p>\n311\t        <p class=\"small muted\" style=\"margin:0\">read {{ bench.readiness.at }}</p>\n312\t      {% else %}\n313\t        <p class=\"small muted\" style=\"margin:0\">{{ bench.readiness.note or \"no readiness read yet\" }}</p>\n314\t      {% endif %}\n315\t    </div>\n316\t  </div>\n317\t\n318\t  {# B6: shared parts/tools at job level #}\n319\t  {% if bench.job_parts or bench.job_tools %}\n320\t    <div class=\"bench-job-shared\">\n321\t      {% if bench.job_parts %}\n322\t        <div class=\"bench-parts muted\">\n323\t          <b>Parts for this job:</b>\n324\t          {% for p in bench.job_parts %}\n325\t            <span class=\"bench-part\">{{ p.name }}{% if p.number %} &middot;\n326\t              <span class=\"mono\">{{ p.number }}</span>{% endif %}</span>\n327\t          {% endfor %}\n328\t        </div>\n329\t      {% endif %}\n330\t      {% if bench.job_tools %}\n331\t        <div class=\"bench-tools\">\n332\t          <b>Tools for this job:</b>\n333\t          {% for tl in bench.job_tools %}\n334\t            <span class=\"chip plain bench-tool {{ 'ok' if tl.have == 'owned' else ('not-ok' if tl.have == 'not_owned' else '') }}\">\n335\t              {{ tl.name }} &mdash;\n336\t              {{ \"have\" if tl.have == \"owned\" else (\"not owned\" if tl.have == \"not_owned\" else \"unknown: ask\") }}\n337\t            </span>\n338\t          {% endfor %}\n339\t        </div>\n340\t      {% endif %}\n341\t    </div>\n342\t  {% endif %}\n343\t\n344\t  {% if bench.shortcuts %}\n345\t    <div class=\"bench-shortcuts\">\n346\t      {% for s in bench.shortcuts %}\n347\t        <a class=\"chip plain bench-shortcut v-{{ s.status|lower|replace('_', '-') }}\"\n348\t           href=\"{{ s.href }}\"\n349\t           title=\"{{ s.description or 'no description on file' }} &mdash; {{ s.status_label }}{% if s.addressed_by %} &mdash; addressed by: {{ s.addressed_by }}{% endif %}\">{{ s.code }}</a>\n350\t      {% endfor %}\n351\t    </div>\n352\t    <p class=\"small muted bench-legend\">Legend:\n353\t      {% for l in bench.legend %}<span class=\"chip plain {{ l.css }}\">{{ l.label }}</span>{% endfor %}\n354\t    </p>\n355\t  {% endif %}\n356\t\n357\t  <div class=\"bench-links\">\n358\t    <a class=\"btn\" href=\"/v/{{ vin }}/job\">{{ t('job') if t is defined else 'Job' }}</a>\n359\t    <a class=\"btn\" href=\"/v/{{ vin }}/liveboard\">{{ t('live_board') if t is defined else 'Live board' }}</a>\n360\t    <a class=\"btn\" href=\"/v/{{ vin }}/dossier\">{{ t('full_dossier') if t is defined else 'Full dossier' }}</a>\n361\t  </div>\n362\t</div>\n363\t{% endblock %}\n364\t"}]},"uuid":"a6bf975e-f5ee-4f13-b136-6883c7aa9da7","timestamp":"2026-10-08T23:40:28.193Z","toolUseResult":{"type":"text","file":{"filePath":"C:\\Users\\User\\mcp-servers\\cuore\\web\\templates\\bench.html","content":"{# The bench: what to do to this car right now. cuore/services/bench_bridge.py\n   already boiled the dossier down to a resume summary, a verdict sentence\n   and a small task roster (each with procedure, pass criteria,\n   preconditions and parts/tools already resolved) -- this template's only\n   job is to lay those out small enough that the resume card and first task\n   are on-screen on a 400x800 phone with no scrolling. See that module's own\n   docstring for where each field comes from; nothing here recomputes a\n   verdict, a part number, a tool's have/not-have status, or a pass\n   criterion. #}\n{% extends \"base.html\" %}\n{% block title %}{{ bench.vehicle }} &mdash; Bench &middot; {{ bench.progress.done }}/{{ bench.progress.total }} &middot; {{ bench.verdict.state or \"NO_DATA\" }}{% endblock %}\n\n{# Standard persistent vehicle hero + tab strip, same include every other\n   /v/{vin}/* page uses (BENCH_UX_SPEC_2026-10-08.md F16: one tab bar across\n   every view, not just the dossier). _vbar.html shows the full hero (image,\n   verdict headline, figures) for tab == \"bench\"/\"report\" -- see that\n   module's own docstring -- and includes _vtabs.html itself at the end, so\n   nothing else here needs to. #}\n{% block vehiclebar %}{% include \"_vbar.html\" %}{% endblock %}\n\n{% block content %}\n<style>\n/* Scoped to .bench -- no shared rule touched, so this page can be tuned\n   without risking any other page's layout. Uses the same custom\n   properties cuore.css already defines (colours/radius/mono/sans), so\n   light/dark/marque theming is inherited for free. */\n.bench { display: flex; flex-direction: column; gap: 10px; max-width: 100%; }\n.bench-complaint {\n  margin: 4px 0 0; font-size: 14px; font-style: italic; color: var(--ink-2);\n  overflow-wrap: anywhere;\n}\n.bench-next-action {\n  margin: 0; font-size: 20px; line-height: 1.3; font-weight: 600;\n  color: var(--ink); overflow-wrap: anywhere;\n}\n.bench-case-hint { margin: 0; }\n\n/* Item 17: the one blocker/next-action banner on the whole page. */\n.bench-blocker-banner {\n  display: flex; align-items: flex-start; gap: 8px; padding: 10px;\n  background: var(--sev-chronic-bg); border: 1px solid var(--sev-chronic);\n  border-radius: var(--radius);\n}\n.bench-blocker-banner:not(.is-blocker) {\n  background: var(--surface-2); border-color: var(--rule);\n}\n.bench-blocker-banner .bench-next-action { flex: 1 1 auto; }\n\n/* Resume card (A1) */\n.bench-resume {\n  background: var(--raised); border: 1px solid var(--rule);\n  border-radius: var(--radius); padding: 10px; display: flex;\n  flex-direction: column; gap: 4px; max-width: 100%;\n}\n.bench-resume-row { display: flex; flex-wrap: wrap; gap: 8px; align-items: baseline; font-size: 13px; }\n.bench-resume-progress { font-weight: 650; }\n.bench-resume-stale { color: var(--sev-returned); font-weight: 650; }\n.bench-resume-changes { margin: 0; padding-left: 18px; font-size: 13px; }\n.bench-resume-next { margin: 2px 0 0; font-weight: 600; }\n\n/* Fuel gate + readiness (C10) */\n.bench-gates { display: flex; flex-wrap: wrap; gap: 8px; }\n.bench-gate {\n  flex: 1 1 160px; background: var(--surface-2); border: 1px solid var(--rule);\n  border-radius: var(--radius); padding: 8px; font-size: 12px;\n}\n.bench-gate h4 { margin: 0 0 4px; font-size: 12px; }\n.bench-gate.out { border-color: var(--sev-returned); }\n\n.bench-actions { display: flex; flex-direction: column; gap: 10px; }\n.bench-job-shared { font-size: 12px; overflow-wrap: anywhere; }\n.bench-card {\n  display: flex; gap: 10px; align-items: flex-start;\n  background: var(--raised); border: 1px solid var(--rule);\n  border-radius: var(--radius); padding: 10px; max-width: 100%;\n}\n.bench-card[data-state=\"blocked\"] { border-color: var(--sev-chronic); }\n.bench-card[data-state=\"done\"] { opacity: 0.85; }\n.bench-check {\n  flex: none; display: flex; flex-direction: column; align-items: center;\n  justify-content: center; gap: 2px; min-width: 48px; min-height: 48px;\n}\n.bench-checkbox-real { width: 28px; height: 28px; cursor: pointer; }\n.bench-check-label { font-size: 12px; color: var(--ink-3); }\n.bench-card-body { flex: 1 1 auto; min-width: 0; display: flex; flex-direction: column; gap: 6px; }\n.bench-card-text {\n  font-size: 15px; display: flex; align-items: center; gap: 6px;\n  overflow-wrap: anywhere; cursor: pointer; min-height: 44px;\n}\n.bench-state-badge { font-size: 10px; margin-left: auto; }\n.bench-state-badge.state-ready { color: var(--ok); background: var(--ok-bg); }\n.bench-state-badge.state-blocked { color: var(--sev-returned); background: var(--sev-returned-bg); }\n.bench-state-badge.state-done { color: var(--ink-3); background: var(--surface-2); }\n.bench-bulletin { align-self: flex-start; white-space: normal; max-width: 100%; }\n.bench-parts, .bench-tools { font-size: 12px; overflow-wrap: anywhere; }\n.bench-part { margin-right: 6px; }\n.bench-tool {\n  margin-right: 4px; margin-bottom: 4px; display: inline-block;\n  white-space: normal; max-width: 100%; overflow-wrap: anywhere;\n}\n.bench-tool.ok { color: var(--ok); background: var(--ok-bg); }\n.bench-tool.not-ok { color: var(--sev-returned); background: var(--sev-returned-bg); }\n\n.bench-card-detail { display: flex; flex-direction: column; gap: 4px; padding-top: 4px; font-size: 13px; }\n.bench-preconditions { display: flex; flex-wrap: wrap; gap: 6px; }\n.bench-precondition.ok { color: var(--ok); background: var(--ok-bg); }\n.bench-precondition.not-ok { color: var(--sev-returned); background: var(--sev-returned-bg); }\n.bench-pass-line { font-weight: 600; }\n.bench-inspect-steps { margin: 0; padding-left: 18px; }\n.bench-outcome-fields { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; padding-top: 4px; }\n.bench-outcome-fields select, .bench-outcome-fields input[type=\"text\"] { min-height: 48px; }\n.bench-outcome-fields input[type=\"text\"] { flex: 1 1 140px; min-width: 0; }\n.bench-outcome-fields .btn { min-height: 48px; min-width: 48px; }\n.bench-done-summary { margin: 0; }\n\n.bench-shortcuts { display: flex; flex-wrap: wrap; gap: 6px; }\n.bench-shortcut {\n  white-space: normal; text-decoration: none; min-height: 44px;\n  display: inline-flex; align-items: center;\n}\n.bench-shortcut.v-active { color: var(--sev-returned); background: var(--sev-returned-bg); }\n.bench-shortcut.v-cleared-unverified { color: var(--sev-chronic); background: var(--sev-chronic-bg); }\n.bench-legend { margin: 2px 0 0; }\n.bench-legend .chip { margin-right: 2px; }\n\n.bench-why { margin: 0; }\n.bench-why summary { cursor: pointer; font-size: 13px; }\n\n.bench-links { display: flex; gap: 8px; flex-wrap: wrap; padding-top: 4px; }\n.bench-links .btn { min-height: 48px; display: inline-flex; align-items: center; }\n</style>\n\n<div class=\"bench\" data-vin=\"{{ vin }}\">\n\n  {% if bench.complaint %}\n    <p class=\"bench-complaint\">&ldquo;{{ bench.complaint }}&rdquo;</p>\n  {% endif %}\n\n  {# Item 17: the blocker/next-action sentence shown ONCE, as a banner --\n     icon, one-line action (class kept as \"bench-next-action\" so it is\n     never mistaken for -- or buried inside -- a collapsed disclosure),\n     \"Why?\" for the full sentence + verdict basis. Replaces the old\n     resume-card line + bare headline + separate \"Why {{state}}?\" block,\n     which repeated this same sentence 3 times (JOB_UX_FIXES item 17). #}\n  {% if bench.blocker_banner %}\n    <div class=\"bench-blocker-banner{{ ' is-blocker' if bench.blocker_banner.is_blocker }}\">\n      {% if icon is defined %}{{ icon(bench.blocker_banner.icon, size=\"s\") }}{% endif %}\n      <p class=\"bench-next-action\">{{ bench.blocker_banner.action }}</p>\n      {% if bench.blocker_banner.why != bench.blocker_banner.action or bench.blocker_banner.basis %}\n        <details class=\"bench-why\">\n          <summary>Why?</summary>\n          <p class=\"small muted\" style=\"margin:4px 0 0\">{{ bench.blocker_banner.why }}</p>\n          {% if bench.blocker_banner.basis %}\n            <ul class=\"small muted\">\n              {% for b in bench.blocker_banner.basis %}<li>{{ b }}</li>{% endfor %}\n            </ul>\n          {% endif %}\n        </details>\n      {% endif %}\n    </div>\n  {% endif %}\n\n  {% if bench.case_hint %}\n    <p class=\"bench-case-hint small muted\">{{ bench.case_hint }}</p>\n  {% endif %}\n\n  {# Bench order (item 17): status line (vbar) -> blocker banner (above) ->\n     the 3 next-action cards -> resume details -> fuel gate/readiness ->\n     job-level parts/tools -> codes row -> links. #}\n  <div class=\"bench-actions\">\n    {% for a in bench.next_actions %}\n      <div class=\"bench-card\" id=\"task-{{ a.step_id }}\" data-task-id=\"{{ a.step_id }}\" data-state=\"{{ a.state|lower }}\">\n        <form method=\"post\" action=\"{{ a.href_tick }}\" class=\"bench-check\">\n          <input type=\"hidden\" name=\"step_id\" value=\"{{ a.step_id }}\">\n          <input type=\"checkbox\" id=\"chk-{{ a.step_id }}\" name=\"done\" value=\"1\"\n                 class=\"bench-checkbox-real\" {% if a.done %}checked{% endif %}\n                 aria-label=\"{{ (t('mark_done') if t is defined else 'Mark done') }}: {{ a.text }}\"\n                 form=\"form-{{ a.step_id }}\">\n          <label for=\"chk-{{ a.step_id }}\" class=\"bench-check-label\">{{ t('mark_done') if t is defined else 'Mark done' }}</label>\n        </form>\n        <div class=\"bench-card-body\">\n          <details>\n            <summary class=\"bench-card-text\">\n              {% if icon is defined %}{{ icon(a.icon, size=\"s\") }}{% endif %}\n              <span>{{ a.text }}</span>\n              <span class=\"chip plain bench-state-badge state-{{ a.state|lower }}\">{{ a.state }}{% if a.blocked_reason %}: {{ a.blocked_reason }}{% endif %}</span>\n            </summary>\n            <div class=\"bench-card-detail\">\n              {% if a.preconditions %}\n                <div class=\"bench-preconditions\">\n                  {% for p in a.preconditions %}\n                    <span class=\"chip plain bench-precondition {{ 'ok' if p.ok else 'not-ok' }}\">\n                      {{ p.label }}: {{ 'ok' if p.ok else 'blocked' }}\n                      {% if not p.ok and p.fix_href %} &mdash; <a href=\"{{ p.fix_href }}\">{{ p.fix_label }}</a>{% endif %}\n                      {% if not p.ok and p.fix_text %} &mdash; {{ p.fix_text }}{% endif %}\n                    </span>\n                  {% endfor %}\n                </div>\n              {% endif %}\n              <p style=\"margin:0\"><b>Procedure:</b>\n                {{ a.detail.procedure.test or \"UNKNOWN -- no sourced procedure for this step yet; confirm on the car / service manual\" }}</p>\n              {% if a.detail.procedure.tools %}\n                <p class=\"small muted\" style=\"margin:0\">Tool: {{ a.detail.procedure.tools }}</p>\n              {% endif %}\n              <p class=\"bench-pass-line\" style=\"margin:0\">Pass = {{ a.detail.pass_line }}</p>\n              {% if a.detail.if_abnormal %}\n                <p class=\"small muted\" style=\"margin:0\">If abnormal: {{ a.detail.if_abnormal }}</p>\n              {% endif %}\n              {% if a.detail.doc %}\n                <p class=\"small\" style=\"margin:0\">Doc:\n                  {% if a.detail.doc.href %}<a href=\"{{ a.detail.doc.href }}\">{{ a.detail.doc.id }}</a>{% else %}{{ a.detail.doc.id }}{% endif %}\n                  {% if a.detail.doc.title %} &mdash; {{ a.detail.doc.title }}{% endif %}</p>\n              {% endif %}\n              {% if a.detail.inspect_steps %}\n                <ul class=\"bench-inspect-steps small muted\">\n                  {% for s in a.detail.inspect_steps %}\n                    <li>{{ s.element }}: {{ s.what }} ({{ s.how }}) &mdash; {{ s.source }}</li>\n                  {% endfor %}\n                </ul>\n              {% endif %}\n\n              <form method=\"post\" action=\"{{ a.href_tick }}\" id=\"form-{{ a.step_id }}\" class=\"bench-outcome-fields\">\n                <input type=\"hidden\" name=\"step_id\" value=\"{{ a.step_id }}\">\n                <select name=\"outcome\">\n                  <option value=\"ok\" {% if a.outcome == 'ok' %}selected{% endif %}>OK</option>\n                  <option value=\"fault_found\" {% if a.outcome == 'fault_found' %}selected{% endif %}>Fault found</option>\n                  <option value=\"skipped\" {% if a.outcome == 'skipped' %}selected{% endif %}>Skipped</option>\n                </select>\n                <input type=\"text\" name=\"note\" placeholder=\"finding / reason\" value=\"{{ a.note or '' }}\">\n                <button type=\"submit\" class=\"btn\">Save</button>\n              </form>\n              {% if a.done %}\n                <p class=\"bench-done-summary small muted\">Done {{ a.done_at }}{% if a.done_by %} by {{ a.done_by }}{% endif %}\n                  {% if a.outcome %} &mdash; {{ a.outcome|replace('_', ' ') }}{% endif %}{% if a.note %}: {{ a.note }}{% endif %}</p>\n              {% endif %}\n            </div>\n          </details>\n          {% if a.bulletin %}\n            <span class=\"chip plain bench-bulletin\">{{ a.bulletin.id }}</span>\n          {% endif %}\n          {% if a.parts %}\n            <div class=\"bench-parts muted\">\n              {% for p in a.parts %}\n                <span class=\"bench-part\">{{ p.name }}{% if p.number %} &middot;\n                  <span class=\"mono\">{{ p.number }}</span>{% endif %}</span>\n              {% endfor %}\n            </div>\n          {% endif %}\n          {% if a.tools %}\n            <div class=\"bench-tools\">\n              {% for tl in a.tools %}\n                <span class=\"chip plain bench-tool {{ 'ok' if tl.have == 'owned' else ('not-ok' if tl.have == 'not_owned' else '') }}\">\n                  {{ tl.name }} &mdash;\n                  {{ \"have\" if tl.have == \"owned\" else (\"not owned\" if tl.have == \"not_owned\" else \"unknown: ask\") }}\n                </span>\n              {% endfor %}\n            </div>\n          {% endif %}\n        </div>\n      </div>\n    {% else %}\n      <p class=\"muted small\">{{ t('nothing_open') if t is defined else 'Nothing open on the checklist.' }}</p>\n    {% endfor %}\n  </div>\n\n  {# A1/A2: resume details -- last scan, what changed, N of M done. The\n     next-action sentence itself lives solely in the banner above now\n     (item 17), so this card no longer repeats it. #}\n  <div class=\"bench-resume\">\n    <div class=\"bench-resume-row\">\n      <span>last scan {{ bench.resume.last_scan_relative }}</span>\n      {% if bench.scan_stale %}\n        <span class=\"bench-resume-stale\">&middot; stale (&gt; 24 h)</span>\n      {% endif %}\n      <span class=\"bench-resume-progress\">&middot; {{ bench.progress.done }} of {{ bench.progress.total }} done</span>\n      {# Item 9: bench_bridge.scanner_label()/LABELS -- never the raw MES\n         state enum (the persistent per-tab banner in _vbar.html shows the\n         same word for every other /v/ page; this is the Bench's own). #}\n      <span class=\"muted\">&middot; Scanner: {{ bench.scanner_label }}</span>\n    </div>\n    {% if bench.resume.changed %}\n      <ul class=\"bench-resume-changes\">\n        {% for c in bench.resume.changed %}<li>{{ c }}</li>{% endfor %}\n      </ul>\n    {% elif not bench.resume.is_first_visit %}\n      <p class=\"small muted\" style=\"margin:0\">nothing changed since your last visit</p>\n    {% endif %}\n  </div>\n\n  {# C10: live fuel gate + readiness panel #}\n  <div class=\"bench-gates\">\n    <div class=\"bench-gate {{ 'out' if bench.fuel_gate.in_window == False }}\">\n      <h4>Fuel gate (EVAP needs 15&ndash;85%)</h4>\n      {% if bench.fuel_gate.level is not none %}\n        <p style=\"margin:0\">{{ bench.fuel_gate.level }}%\n          {% if bench.fuel_gate.in_window %} &mdash; in window\n          {% else %} &mdash; {{ bench.fuel_gate.direction }} window{% endif %}</p>\n        {% if bench.fuel_gate.litres_to_target is not none %}\n          <p class=\"small muted\" style=\"margin:0\">burn ~{{ bench.fuel_gate.litres_to_target }} L to reach 85%</p>\n        {% else %}\n          <p class=\"small muted\" style=\"margin:0\">litres to burn: UNKNOWN (no sourced tank capacity)</p>\n        {% endif %}\n      {% else %}\n        <p class=\"small muted\" style=\"margin:0\">UNKNOWN &mdash; no fuel reading on file</p>\n      {% endif %}\n    </div>\n    <div class=\"bench-gate\">\n      <h4>Readiness</h4>\n      {% if bench.readiness.monitors %}\n        <p style=\"margin:0\">{{ bench.readiness.monitors|selectattr(\"complete\")|list|length }}/{{ bench.readiness.monitors|length }} complete</p>\n        <p class=\"small muted\" style=\"margin:0\">read {{ bench.readiness.at }}</p>\n      {% else %}\n        <p class=\"small muted\" style=\"margin:0\">{{ bench.readiness.note or \"no readiness read yet\" }}</p>\n      {% endif %}\n    </div>\n  </div>\n\n  {# B6: shared parts/tools at job level #}\n  {% if bench.job_parts or bench.job_tools %}\n    <div class=\"bench-job-shared\">\n      {% if bench.job_parts %}\n        <div class=\"bench-parts muted\">\n          <b>Parts for this job:</b>\n          {% for p in bench.job_parts %}\n            <span class=\"bench-part\">{{ p.name }}{% if p.number %} &middot;\n              <span class=\"mono\">{{ p.number }}</span>{% endif %}</span>\n          {% endfor %}\n        </div>\n      {% endif %}\n      {% if bench.job_tools %}\n        <div class=\"bench-tools\">\n          <b>Tools for this job:</b>\n          {% for tl in bench.job_tools %}\n            <span class=\"chip plain bench-tool {{ 'ok' if tl.have == 'owned' else ('not-ok' if tl.have == 'not_owned' else '') }}\">\n              {{ tl.name }} &mdash;\n              {{ \"have\" if tl.have == \"owned\" else (\"not owned\" if tl.have == \"not_owned\" else \"unknown: ask\") }}\n            </span>\n          {% endfor %}\n        </div>\n      {% endif %}\n    </div>\n  {% endif %}\n\n  {% if bench.shortcuts %}\n    <div class=\"bench-shortcuts\">\n      {% for s in bench.shortcuts %}\n        <a class=\"chip plain bench-shortcut v-{{ s.status|lower|replace('_', '-') }}\"\n           href=\"{{ s.href }}\"\n           title=\"{{ s.description or 'no description on file' }} &mdash; {{ s.status_label }}{% if s.addressed_by %} &mdash; addressed by: {{ s.addressed_by }}{% endif %}\">{{ s.code }}</a>\n      {% endfor %}\n    </div>\n    <p class=\"small muted bench-legend\">Legend:\n      {% for l in bench.legend %}<span class=\"chip plain {{ l.css }}\">{{ l.label }}</span>{% endfor %}\n    </p>\n  {% endif %}\n\n  <div class=\"bench-links\">\n    <a class=\"btn\" href=\"/v/{{ vin }}/job\">{{ t('job') if t is defined else 'Job' }}</a>\n    <a class=\"btn\" href=\"/v/{{ vin }}/liveboard\">{{ t('live_board') if t is defined else 'Live board' }}</a>\n    <a class=\"btn\" href=\"/v/{{ vin }}/dossier\">{{ t('full_dossier') if t is defined else 'Full dossier' }}</a>\n  </div>\n</div>\n{% endblock %}\n","numLines":364,"startLine":1,"totalLines":364}},"sourceToolAssistantUUID":"a7bca4cf-8b1a-41b9-9739-879725e72f1f","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
{"parentUuid":"a6bf975e-f5ee-4f13-b136-6883c7aa9da7","isSidechain":true,"agentId":"ad3b2406af84b2e4d","message":{"model":"claude-sonnet-5","id":"msg_011CfqertjDtq5FvUHFsAfMn","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01Bah6JEfezMpRwgqzLe7js6","name":"Read","input":{"file_path":"C:\\Users\\User\\mcp-servers\\cuore\\web\\bench_routes.py"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":4621,"cache_read_input_tokens":56797,"cache_creation":{"ephemeral_5m_input_tokens":4621,"ephemeral_1h_input_tokens":0},"output_tokens":4,"service_tier":"standard","inference_geo":"not_available"},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_01Bah6JEfezMpRwgqzLe7js6":{"file_path":"C:\\Users\\User\\mcp-servers\\cuore\\web\\bench_routes.py"}},"apiBlockIndex":3,"requestId":"req_011CfqertUbTTc9n9sMdNA5B","attributionAgent":"general-purpose","type":"assistant","uuid":"f6a4208c-3758-4e50-b360-1f8ce14d2bbb","timestamp":"2026-10-08T23:40:28.567Z","effort":"high","perTurnEffort":null,"userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
{"parentUuid":"f6a4208c-3758-4e50-b360-1f8ce14d2bbb","isSidechain":true,"promptId":"c88cddde-d9ec-4df1-89bf-4cd0fc5db786","agentId":"ad3b2406af84b2e4d","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Bah6JEfezMpRwgqzLe7js6","type":"tool_result","content":"1\t\"\"\"The bench: ``GET /v/{vin}``, the screen a mechanic sees the instant a car\n2\tlands on the lift.\n3\t\n4\tKept as its own router, same posture as ``cuore/web/dossier_routes.py``\n5\t(see that file's own docstring): the old dossier owned ``/v/{vin}`` until\n6\tthis landed, and still owns everything else under ``/v/{vin}/*`` --\n7\t``cuore/web/routes.py``'s own ``/v/{vin}`` handler was moved to\n8\t``/v/{vin}/dossier`` to make room for this one, rather than this file\n9\treaching into that module's handler.\n10\t\n11\t``POST /v/{vin}/bench/done`` is this file's own form target -- separate\n12\tfrom the dossier's shared ``POST /v/{vin}/checklist`` (still used by the\n13\tfull dossier's open-work cards) because the bench's \"Mark done\" captures an\n14\toutcome (BENCH_UX_SPEC_2026-10-08.md B5: OK / fault found / skipped, with a\n15\tone-line note) that the older route does not accept. Both routes write the\n16\tsame ``cuore.live.checklists`` store, so a step ticked from either page\n17\tagrees with the other; a fault-found note is additionally filed as a\n18\tmechanic note (``mes.notes`` via ``mes_bridge.add_note``) so it shows up in\n19\tthe dossier's own History.\n20\t\"\"\"\n21\t\n22\tfrom __future__ import annotations\n23\t\n24\tfrom typing import Optional\n25\t\n26\tfrom fastapi import Depends, Form, Request\n27\tfrom fastapi.responses import HTMLResponse, RedirectResponse\n28\tfrom fastapi import APIRouter\n29\t\n30\tfrom ..api.deps import require_token\n31\tfrom ..live import checklists as checklist_store\n32\tfrom ..services import bench_bridge, cache, dossier_bridge, mes_bridge\n33\tfrom ..services.errors import BadRequest\n34\tfrom . import routes as web_routes\n35\t\n36\trouter = APIRouter(include_in_schema=False, dependencies=[Depends(require_token)])\n37\t\n38\t#: Mirrors ``cuore.api.checklists._OUTCOMES`` -- kept as a separate literal\n39\t#: (not imported) so this HTML form route has no dependency on the JSON API\n40\t#: module; the vocabulary is tiny and documented in both places.\n41\t_OUTCOMES = {\"ok\", \"fault_found\", \"skipped\"}\n42\t\n43\t\n44\t@router.get(\"/v/{vin}\", response_class=HTMLResponse)\n45\tdef bench_page(request: Request, vin: str) -> HTMLResponse:\n46\t    \"\"\"What to do right now: the resume card, the task roster (each with\n47\t    procedure, pass criteria, preconditions and parts/tools already\n48\t    resolved), the live fuel gate and readiness panel, and jump-off points\n49\t    to the codes, the job and the full dossier.\n50\t\n51\t    ``bar``/``view`` are computed the same way every other ``/v/{vin}/*``\n52\t    page does (``web_routes._vehicle_bar`` over the same cached workup) so\n53\t    this page's ``{% include \"_vbar.html\" %}`` -- the persistent hero +\n54\t    tab strip every other vehicle page already uses -- renders identically\n55\t    here (BENCH_UX_SPEC_2026-10-08.md F16). ``_vbar.html``'s own docstring\n56\t    names the Bench as one of the two pages its hero was built for, so\n57\t    reusing it rather than keeping a bespoke status line is the integration\n58\t    that module was already waiting on.\n59\t    \"\"\"\n60\t    dossier = cache.get_or_build(\n61\t        (\"workup\", vin, mes_bridge.newest_mtime(vin)),\n62\t        lambda: mes_bridge.workup(vin=vin))\n63\t    view = dossier_bridge.build_view(vin, dossier, None)\n64\t    bar = web_routes._vehicle_bar(vin, dossier)\n65\t    bench = bench_bridge.build_bench(vin)\n66\t    # _vehicle_bar falls back to \"(unnamed vehicle)\" straight off\n67\t    # dossier[\"identity\"]; bench_bridge's own resolution additionally tries\n68\t    # shop_bridge (corpus name, then a WMI decode) before giving up, which is\n69\t    # exactly the one-display-name-per-vehicle fix BENCH_UX_SPEC_2026-10-08.md\n70\t    # A3 asks for -- reuse it here so the shared hero never regresses to the\n71\t    # placeholder this VIN's own dossier.identity has no \"vehicle\" field for.\n72\t    bar[\"name\"] = bench[\"vehicle\"]\n73\t    response = web_routes._page(request, \"bench.html\", vin=vin, bench=bench,\n74\t                                bar=bar, view=view, tab=\"bench\")\n75\t    web_routes._set_active_vehicle(response, vin)\n76\t    return response\n77\t\n78\t\n79\t@router.post(\"/v/{vin}/bench/done\")\n80\tdef bench_mark_done(vin: str, step_id: str = Form(...),\n81\t                    done: Optional[str] = Form(None), outcome: str = Form(\"\"),\n82\t                    note: str = Form(\"\"), by: str = Form(\"\")) -> RedirectResponse:\n83\t    \"\"\"Mark (or un-mark) one bench task, with an outcome.\n84\t\n85\t    ``done`` follows plain HTML checkbox semantics: present (``\"1\"``) only\n86\t    when the box was checked on submit, absent entirely when it was not --\n87\t    so un-checking the box and pressing Save is the bench's own \"undo\": the\n88\t    step goes back to not-done and ``cuore.live.checklists.set_step``\n89\t    already clears its outcome/note when ``done`` is false.\n90\t\n91\t    A step id is only meaningful in the context of the vehicle whose\n92\t    open-work cards named it -- same validation\n93\t    ``cuore.api.checklists.set_checklist_step`` already applies, reused here\n94\t    so a step id this VIN's dossier does not expose is a 400, not a silent\n95\t    no-op.\n96\t    \"\"\"\n97\t    dossier = mes_bridge.workup(vin=vin)\n98\t    valid = dossier_bridge.checklist_step_ids(vin, dossier)\n99\t    if step_id not in valid:\n100\t        raise BadRequest(f\"unknown checklist step id {step_id!r} for this vehicle\")\n101\t\n102\t    is_done = done == \"1\"\n103\t    clean_outcome = outcome.strip() or None\n104\t    if is_done and clean_outcome and clean_outcome not in _OUTCOMES:\n105\t        raise BadRequest(f\"outcome must be one of {sorted(_OUTCOMES)}, got {clean_outcome!r}\")\n106\t\n107\t    checklist_store.set_step(vin, step_id, is_done, by=by, outcome=clean_outcome, note=note)\n108\t\n109\t    if is_done and clean_outcome == \"fault_found\" and note.strip():\n110\t        try:\n111\t            mes_bridge.add_note(vin, note.strip(), target_kind=\"tree_step\",\n112\t                                target_id=step_id, author=by or \"technician\",\n113\t                                tags=[\"bench\", \"finding\"])\n114\t        except Exception:  # noqa: BLE001 -- the checklist write must still succeed\n115\t            pass\n116\t\n117\t    return RedirectResponse(f\"/v/{vin}#task-{step_id}\", status_code=303)\n118\t\n119\t\n120\t__all__ = [\"router\"]\n121\t"}]},"uuid":"768e8150-63aa-40f5-ac39-892d8b154b3c","timestamp":"2026-10-08T23:40:28.608Z","toolUseResult":{"type":"text","file":{"filePath":"C:\\Users\\User\\mcp-servers\\cuore\\web\\bench_routes.py","content":"\"\"\"The bench: ``GET /v/{vin}``, the screen a mechanic sees the instant a car\nlands on the lift.\n\nKept as its own router, same posture as ``cuore/web/dossier_routes.py``\n(see that file's own docstring): the old dossier owned ``/v/{vin}`` until\nthis landed, and still owns everything else under ``/v/{vin}/*`` --\n``cuore/web/routes.py``'s own ``/v/{vin}`` handler was moved to\n``/v/{vin}/dossier`` to make room for this one, rather than this file\nreaching into that module's handler.\n\n``POST /v/{vin}/bench/done`` is this file's own form target -- separate\nfrom the dossier's shared ``POST /v/{vin}/checklist`` (still used by the\nfull dossier's open-work cards) because the bench's \"Mark done\" captures an\noutcome (BENCH_UX_SPEC_2026-10-08.md B5: OK / fault found / skipped, with a\none-line note) that the older route does not accept. Both routes write the\nsame ``cuore.live.checklists`` store, so a step ticked from either page\nagrees with the other; a fault-found note is additionally filed as a\nmechanic note (``mes.notes`` via ``mes_bridge.add_note``) so it shows up in\nthe dossier's own History.\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom typing import Optional\n\nfrom fastapi import Depends, Form, Request\nfrom fastapi.responses import HTMLResponse, RedirectResponse\nfrom fastapi import APIRouter\n\nfrom ..api.deps import require_token\nfrom ..live import checklists as checklist_store\nfrom ..services import bench_bridge, cache, dossier_bridge, mes_bridge\nfrom ..services.errors import BadRequest\nfrom . import routes as web_routes\n\nrouter = APIRouter(include_in_schema=False, dependencies=[Depends(require_token)])\n\n#: Mirrors ``cuore.api.checklists._OUTCOMES`` -- kept as a separate literal\n#: (not imported) so this HTML form route has no dependency on the JSON API\n#: module; the vocabulary is tiny and documented in both places.\n_OUTCOMES = {\"ok\", \"fault_found\", \"skipped\"}\n\n\n@router.get(\"/v/{vin}\", response_class=HTMLResponse)\ndef bench_page(request: Request, vin: str) -> HTMLResponse:\n    \"\"\"What to do right now: the resume card, the task roster (each with\n    procedure, pass criteria, preconditions and parts/tools already\n    resolved), the live fuel gate and readiness panel, and jump-off points\n    to the codes, the job and the full dossier.\n\n    ``bar``/``view`` are computed the same way every other ``/v/{vin}/*``\n    page does (``web_routes._vehicle_bar`` over the same cached workup) so\n    this page's ``{% include \"_vbar.html\" %}`` -- the persistent hero +\n    tab strip every other vehicle page already uses -- renders identically\n    here (BENCH_UX_SPEC_2026-10-08.md F16). ``_vbar.html``'s own docstring\n    names the Bench as one of the two pages its hero was built for, so\n    reusing it rather than keeping a bespoke status line is the integration\n    that module was already waiting on.\n    \"\"\"\n    dossier = cache.get_or_build(\n        (\"workup\", vin, mes_bridge.newest_mtime(vin)),\n        lambda: mes_bridge.workup(vin=vin))\n    view = dossier_bridge.build_view(vin, dossier, None)\n    bar = web_routes._vehicle_bar(vin, dossier)\n    bench = bench_bridge.build_bench(vin)\n    # _vehicle_bar falls back to \"(unnamed vehicle)\" straight off\n    # dossier[\"identity\"]; bench_bridge's own resolution additionally tries\n    # shop_bridge (corpus name, then a WMI decode) before giving up, which is\n    # exactly the one-display-name-per-vehicle fix BENCH_UX_SPEC_2026-10-08.md\n    # A3 asks for -- reuse it here so the shared hero never regresses to the\n    # placeholder this VIN's own dossier.identity has no \"vehicle\" field for.\n    bar[\"name\"] = bench[\"vehicle\"]\n    response = web_routes._page(request, \"bench.html\", vin=vin, bench=bench,\n                                bar=bar, view=view, tab=\"bench\")\n    web_routes._set_active_vehicle(response, vin)\n    return response\n\n\n@router.post(\"/v/{vin}/bench/done\")\ndef bench_mark_done(vin: str, step_id: str = Form(...),\n                    done: Optional[str] = Form(None), outcome: str = Form(\"\"),\n                    note: str = Form(\"\"), by: str = Form(\"\")) -> RedirectResponse:\n    \"\"\"Mark (or un-mark) one bench task, with an outcome.\n\n    ``done`` follows plain HTML checkbox semantics: present (``\"1\"``) only\n    when the box was checked on submit, absent entirely when it was not --\n    so un-checking the box and pressing Save is the bench's own \"undo\": the\n    step goes back to not-done and ``cuore.live.checklists.set_step``\n    already clears its outcome/note when ``done`` is false.\n\n    A step id is only meaningful in the context of the vehicle whose\n    open-work cards named it -- same validation\n    ``cuore.api.checklists.set_checklist_step`` already applies, reused here\n    so a step id this VIN's dossier does not expose is a 400, not a silent\n    no-op.\n    \"\"\"\n    dossier = mes_bridge.workup(vin=vin)\n    valid = dossier_bridge.checklist_step_ids(vin, dossier)\n    if step_id not in valid:\n        raise BadRequest(f\"unknown checklist step id {step_id!r} for this vehicle\")\n\n    is_done = done == \"1\"\n    clean_outcome = outcome.strip() or None\n    if is_done and clean_outcome and clean_outcome not in _OUTCOMES:\n        raise BadRequest(f\"outcome must be one of {sorted(_OUTCOMES)}, got {clean_outcome!r}\")\n\n    checklist_store.set_step(vin, step_id, is_done, by=by, outcome=clean_outcome, note=note)\n\n    if is_done and clean_outcome == \"fault_found\" and note.strip():\n        try:\n            mes_bridge.add_note(vin, note.strip(), target_kind=\"tree_step\",\n                                target_id=step_id, author=by or \"technician\",\n                                tags=[\"bench\", \"finding\"])\n        except Exception:  # noqa: BLE001 -- the checklist write must still succeed\n            pass\n\n    return RedirectResponse(f\"/v/{vin}#task-{step_id}\", status_code=303)\n\n\n__all__ = [\"router\"]\n","numLines":121,"startLine":1,"totalLines":121}},"sourceToolAssistantUUID":"f6a4208c-3758-4e50-b360-1f8ce14d2bbb","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
{"parentUuid":"768e8150-63aa-40f5-ac39-892d8b154b3c","isSidechain":true,"agentId":"ad3b2406af84b2e4d","message":{"model":"claude-sonnet-5","id":"msg_011CfqertjDtq5FvUHFsAfMn","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_013Cky3cjYU2bup2ozFCjxfA","name":"Read","input":{"file_path":"C:\\Users\\User\\mcp-servers\\cuore\\services\\bench_bridge.py"},"caller":{"type":"direct"}}],"container":null,"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":4621,"cache_read_input_tokens":56797,"output_tokens":306,"output_tokens_details":{"thinking_tokens":12},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":0,"ephemeral_5m_input_tokens":4621},"inference_geo":"not_available","iterations":[{"input_tokens":2,"output_tokens":306,"cache_read_input_tokens":56797,"cache_creation_input_tokens":4621,"cache_creation":{"ephemeral_5m_input_tokens":4621,"ephemeral_1h_input_tokens":0},"type":"message"}],"speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_013Cky3cjYU2bup2ozFCjxfA":{"file_path":"C:\\Users\\User\\mcp-servers\\cuore\\services\\bench_bridge.py"}},"apiBlockIndex":4,"requestId":"req_011CfqertUbTTc9n9sMdNA5B","attributionAgent":"general-purpose","type":"assistant","uuid":"0ee70306-3db1-4788-9340-b608b3fe1a49","timestamp":"2026-10-08T23:40:28.964Z","effort":"high","perTurnEffort":null,"userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
{"parentUuid":"0ee70306-3db1-4788-9340-b608b3fe1a49","isSidechain":true,"promptId":"c88cddde-d9ec-4df1-89bf-4cd0fc5db786","agentId":"ad3b2406af84b2e4d","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_013Cky3cjYU2bup2ozFCjxfA","type":"tool_result","content":"1\t\"\"\"Data for the bench page: \"what am I doing to this car, right now\".\n2\t\n3\t``cuore/web/routes.py``'s old ``/v/{vin}`` was the full dossier -- verdict,\n4\tevery code, every bulletin, every freeze frame, all at once. That page still\n5\texists (moved to ``/v/{vin}/dossier``); this module backs the thing a\n6\tmechanic actually wants the instant the car is on the lift: a resume\n7\tsummary of what changed since the last visit, the verdict's own next-action\n8\tsentence, the tasks to go do about it (with procedure, pass criteria, parts\n9\tand tools each one needs already resolved), live preconditions, the fuel\n10\tgate and readiness panel, and a couple of jump-off points (codes, the job,\n11\tthe full dossier) -- nothing that needs scrolling to reach on a 400x800\n12\tscreen.\n13\t\n14\t``build_bench`` is the only entry point. It composes bridges that already\n15\texist -- ``dossier_bridge.build_view`` for the verdict/open-work/codes/\n16\tbulletins/freeze-frames, ``mes_bridge.fault_tree`` for sourced procedure\n17\tsteps, ``electrical_bridge`` for electrical/physical inspect steps,\n18\t``known_good_bridge`` for expected readings, ``parts_bridge``/\n19\t``tools_kb_bridge`` for what a step needs, ``cuore.live.ops``/``checklists``\n20\tfor live status and the shop-ticked checklist, ``shop_bridge``/\n21\t``cases_bridge`` for the header line and the case hint -- and invents no new\n22\tdiagnosis of its own. See BENCH_UX_SPEC_2026-10-08.md for the walkthrough\n23\tthis module answers.\n24\t\"\"\"\n25\t\n26\tfrom __future__ import annotations\n27\t\n28\timport json\n29\timport re\n30\timport threading\n31\tfrom collections import Counter\n32\tfrom datetime import datetime\n33\tfrom pathlib import Path\n34\tfrom typing import Any\n35\t\n36\tfrom . import cache, dossier_bridge, known_good_bridge, mes_bridge, parts_bridge, tools_kb_bridge\n37\tfrom .errors import BadRequest\n38\tfrom ..live import checklists as checklist_store\n39\tfrom ..live.config import state_dir\n40\t\n41\ttry:\n42\t    from . import cases_bridge\n43\texcept Exception:  # noqa: BLE001 -- the bench must still render without it\n44\t    cases_bridge = None\n45\t\n46\ttry:\n47\t    from . import shop_bridge\n48\texcept Exception:  # noqa: BLE001\n49\t    shop_bridge = None\n50\t\n51\ttry:\n52\t    from . import electrical_bridge\n53\texcept Exception:  # noqa: BLE001\n54\t    electrical_bridge = None\n55\t\n56\ttry:\n57\t    from ..live import ops as live_ops\n58\texcept Exception:  # noqa: BLE001\n59\t    live_ops = None\n60\t\n61\t\n62\t#: Capped the same way the spec caps each bench card: 3 next actions, each\n63\t#: with at most 3 parts and 4 tools.\n64\t_MAX_ACTIONS = 3\n65\t_MAX_PARTS = 3\n66\t_MAX_TOOLS = 4\n67\t_MAX_SHORTCUTS = 6\n68\t_MAX_INSPECT_STEPS = 4\n69\t\n70\t#: Hours since the newest scan/session before the bench flags it stale\n71\t#: (BENCH_UX_SPEC_2026-10-08.md A2) -- a stale read silently invalidates the\n72\t#: whole checklist, so this is surfaced on the bench itself, not just in the\n73\t#: dossier footer.\n74\t_STALE_HOURS = 24.0\n75\t\n76\t#: Family key (lowercased, as ``dossier_bridge.FAMILY_STEPS``/the generic\n77\t#: SAE-range rules spell it) -> icon registry key, for the bench card's own\n78\t#: pictogram. Anything not listed here falls back to a generic glyph --\n79\t#: never a 500 for a family this table doesn't know about yet.\n80\tFAMILY_ICON: dict[str, str] = {\n81\t    \"evap\": \"sys_evap\", \"network\": \"sys_network\", \"misfire\": \"sys_ignition\",\n82\t    \"fuel_trim\": \"sys_fuel\", \"cooling\": \"sys_cooling\",\n83\t    \"engine_management\": \"sys_engine_management\",\n84\t    \"transmission_driveline\": \"sys_transmission_driveline\", \"adas\": \"sys_adas_sensors\",\n85\t    \"chassis\": \"sys_suspension\", \"body\": \"sys_body_comfort\",\n86\t    \"powertrain_other\": \"sys_engine_management\",\n87\t}\n88\t\n89\t#: The chip colour legend rendered once below the DTC shortcut chips\n90\t#: (BENCH_UX_SPEC_2026-10-08.md D11) -- kept here, not guessed per-chip in\n91\t#: the template, so the legend and the chip classes can never drift apart.\n92\t_STATUS_LEGEND = [\n93\t    {\"label\": \"Active\", \"css\": \"v-active\"},\n94\t    {\"label\": \"Cleared, unverified\", \"css\": \"v-cleared-unverified\"},\n95\t]\n96\t\n97\t#: JOB_UX_FIXES_2026-10-08.md item 9: a single source of human labels for\n98\t#: every raw enum this module's own output otherwise carries, so a template\n99\t#: never has to show (or re-invent a translation for) a bare value like\n100\t#: ``not_running`` or a verdict ``blocker`` key. Every other enum this page\n101\t#: shows (verdict state/label, tool ``have``) is already human-labelled at\n102\t#: its own source (dossier_bridge/tools_kb_bridge) -- this dict only covers\n103\t#: the two that weren't: the live MES/scanner state, and the one-line\n104\t#: action for each ``blocker`` key :func:`_fuel_gate`/the verdict compute.\n105\tLABELS: dict[str, dict[str, str]] = {\n106\t    \"mes_state\": {\n107\t        \"connected\": \"Connected\", \"disconnected\": \"Disconnected\",\n108\t        \"not_running\": \"Not running\", \"unknown\": \"Unknown\",\n109\t    },\n110\t    \"blocker\": {\n111\t        \"fuel out of window\": \"Burn fuel to 15-85 %, then run a drive cycle.\",\n112\t        \"awaiting drive cycle\": \"Run a drive cycle, then read readiness.\",\n113\t        \"active faults\": \"Open the codes and start the first test below.\",\n114\t    },\n115\t}\n116\t\n117\t\n118\tdef scanner_label(live_status: dict[str, Any]) -> str:\n119\t    \"\"\"\"Connected\" / \"Not running\" / ... -- never the raw MES state enum,\n120\t    never \"MES ?\" for an unreadable strip.\"\"\"\n121\t    if live_status.get(\"error\"):\n122\t        return \"Unknown\"\n123\t    return LABELS[\"mes_state\"].get(live_status.get(\"mes_state\"), \"Unknown\")\n124\t\n125\t\n126\tdef _blocker_banner(verdict: dict[str, Any]) -> dict[str, Any] | None:\n127\t    \"\"\"The ONE banner the bench shows for \"what do I do right now\" (item\n128\t    17): an icon, a short one-line action, and the verdict's own full\n129\t    sentence + basis behind \"Why?\". ``None`` only when there is no\n130\t    next_action sentence at all (should not happen in practice).\n131\t\n132\t    A true blocker (fuel out of window / awaiting drive cycle / active\n133\t    faults) gets the warning icon and the curated short action from\n134\t    :data:`LABELS`; a clean/no-data verdict still gets ONE line (the\n135\t    verdict's own sentence verbatim -- it is already short), just with a\n136\t    neutral icon, so this is the only place that sentence is ever shown on\n137\t    the bench page.\"\"\"\n138\t    next_action = verdict.get(\"next_action\")\n139\t    if not next_action:\n140\t        return None\n141\t    key = verdict.get(\"blocker\")\n142\t    is_blocker = key not in (None, \"none\", \"no data\")\n143\t    return {\n144\t        \"icon\": \"symptom_warning_message\" if is_blocker else \"status_verified\",\n145\t        \"is_blocker\": is_blocker,\n146\t        \"action\": LABELS[\"blocker\"].get(key, next_action) if is_blocker else next_action,\n147\t        \"why\": next_action,\n148\t        \"basis\": verdict.get(\"basis\") or [],\n149\t    }\n150\t\n151\t\n152\t# --- small helpers ----------------------------------------------------------\n153\t\n154\t\n155\tdef _parse_full_ts(ts: str | None) -> datetime | None:\n156\t    if not ts:\n157\t        return None\n158\t    try:\n159\t        return datetime.strptime(str(ts)[:19], \"%Y-%m-%d %H:%M:%S\")\n160\t    except ValueError:\n161\t        return None\n162\t\n163\t\n164\tdef _relative_time(ts: str | None) -> str | None:\n165\t    \"\"\"\"2 h ago\" / \"3 d ago\" -- never a bare ISO stamp on the resume card.\"\"\"\n166\t    dt = _parse_full_ts(ts)\n167\t    if dt is None:\n168\t        return None\n169\t    secs = max(0.0, (datetime.now() - dt).total_seconds())\n170\t    hours = secs / 3600\n171\t    if hours < 1:\n172\t        return f\"{max(1, int(secs // 60))} min ago\"\n173\t    if hours < 48:\n174\t        return f\"{hours:.0f} h ago\"\n175\t    return f\"{hours / 24:.0f} d ago\"\n176\t\n177\t\n178\tdef _hours_since(ts: str | None) -> float | None:\n179\t    dt = _parse_full_ts(ts)\n180\t    if dt is None:\n181\t        return None\n182\t    return max(0.0, (datetime.now() - dt).total_seconds() / 3600)\n183\t\n184\t\n185\t# --- per-VIN visit tracking, for the resume card's \"what changed\" ----------\n186\t#\n187\t# A small JSON file beside checklists.json/addresses.json, same posture as\n188\t# cuore.live.checklists -- one file, one lock, read-modify-write. Kept here\n189\t# rather than in cuore.live because this is purely a bench-rendering\n190\t# convenience (the previous visit's snapshot), not shop-of-record state.\n191\t\n192\t_VISIT_LOCK = threading.Lock()\n193\t\n194\t\n195\tdef _visits_path() -> Path:\n196\t    # A SUBdirectory, not a file directly under state_dir(): bench_visits.json\n197\t    # is pure bench-rendering bookkeeping (the previous visit's snapshot),\n198\t    # not shop-of-record state -- but dossier_bridge._state_fingerprint()\n199\t    # folds the mtime of every *direct* file under state_dir() into its own\n200\t    # expensive-build cache key, so a file written on every single bench\n201\t    # page load (this one) would invalidate that cache on every single bench\n202\t    # page load too, defeating it completely. iterdir() is not recursive, so\n203\t    # a subdirectory's contents are invisible to that scan.\n204\t    d = state_dir() / \"bench\"\n205\t    try:\n206\t        d.mkdir(parents=True, exist_ok=True)\n207\t    except OSError:\n208\t        pass\n209\t    return d / \"visits.json\"\n210\t\n211\t\n212\tdef _load_visits() -> dict[str, Any]:\n213\t    try:\n214\t        return json.loads(_visits_path().read_text(encoding=\"utf-8\"))\n215\t    except (OSError, ValueError):\n216\t        return {}\n217\t\n218\t\n219\tdef _save_visits(data: dict[str, Any]) -> None:\n220\t    try:\n221\t        _visits_path().write_text(json.dumps(data, indent=2), encoding=\"utf-8\")\n222\t    except OSError:\n223\t        pass\n224\t\n225\t\n226\tdef _record_visit(vin: str, snapshot: dict[str, Any]) -> dict[str, Any] | None:\n227\t    \"\"\"Store this visit's snapshot for ``vin``, returning the PREVIOUS one\n228\t    (``None`` on this vehicle's first bench view).\"\"\"\n229\t    with _VISIT_LOCK:\n230\t        data = _load_visits()\n231\t        previous = data.get(vin)\n232\t        data[vin] = {**snapshot, \"at\": datetime.now().isoformat(timespec=\"seconds\")}\n233\t        _save_visits(data)\n234\t        return previous\n235\t\n236\t\n237\tdef _resume_changes(previous: dict[str, Any] | None, active_codes: list[str],\n238\t                    cleared_codes: list[str], last_read: str | None) -> list[str]:\n239\t    if previous is None:\n240\t        return []\n241\t    changes: list[str] = []\n242\t    new_active = sorted(set(active_codes) - set(previous.get(\"active_codes\") or []))\n243\t    new_cleared = sorted(set(cleared_codes) - set(previous.get(\"cleared_codes\") or []))\n244\t    if new_active:\n245\t        changes.append((\"New code: \" if len(new_active) == 1 else \"New codes: \")\n246\t                       + \", \".join(new_active))\n247\t    if new_cleared:\n248\t        changes.append((\"Cleared: \" if len(new_cleared) == 1 else \"Cleared: \")\n249\t                       + \", \".join(new_cleared))\n250\t    if last_read and previous.get(\"last_read\") and last_read != previous.get(\"last_read\"):\n251\t        changes.append(f\"New record logged ({last_read})\")\n252\t    return changes\n253\t\n254\t\n255\t# --- live status, read fresh for this page (ops.status() is cheap: no I/O\n256\t#    to the car, just the registry/lock file/MES process state) ------------\n257\t\n258\t\n259\tdef _live_status() -> dict[str, Any]:\n260\t    if live_ops is None:\n261\t        return {\"error\": \"live ops unavailable\"}\n262\t    try:\n263\t        s = live_ops.status()\n264\t        return {\n265\t            \"port\": s.get(\"port\"),\n266\t            \"mes_state\": (s.get(\"mes\") or {}).get(\"state\"),\n267\t            \"lock_holder\": (s.get(\"lock\") or {}).get(\"process\"),\n268\t            \"error\": None,\n269\t        }\n270\t    except Exception as exc:  # noqa: BLE001 -- a broken strip must never 500 the bench\n271\t        return {\"error\": str(exc)}\n272\t\n273\t\n274\tdef _preconditions(text: str, live_status: dict[str, Any],\n275\t                   fuel_blocked: bool) -> list[dict[str, Any]]:\n276\t    \"\"\"Per-task live preconditions with a one-click fix link\n277\t    (BENCH_UX_SPEC_2026-10-08.md C9): MES running for an actuator test\n278\t    (-> /live), the car connected for a readiness/verify/live-channel read\n279\t    (-> /tools), fuel in window for that same verify step (text only, no\n280\t    link -- there is nothing to click, only fuel to burn).\"\"\"\n281\t    low = (text or \"\").lower()\n282\t    out: list[dict[str, Any]] = []\n283\t    if \"actuator\" in low or \"koeo\" in low:\n284\t        out.append({\n285\t            \"label\": \"MES running\", \"ok\": live_status.get(\"mes_state\") == \"connected\",\n286\t            \"fix_href\": \"/live\", \"fix_label\": \"Open Live\", \"fix_text\": None,\n287\t        })\n288\t    needs_car = any(k in low for k in\n289\t                    (\"readiness\", \"verify\", \"mode $06\", \"slvt\", \"live channel\"))\n290\t    if needs_car:\n291\t        out.append({\n292\t            \"label\": \"Car connected\", \"ok\": dossier_bridge.live_available(live_status),\n293\t            \"fix_href\": \"/tools\", \"fix_label\": \"Tools\", \"fix_text\": None,\n294\t        })\n295\t        if fuel_blocked:\n296\t            out.append({\n297\t                \"label\": \"Fuel in window\", \"ok\": False,\n298\t                \"fix_href\": None, \"fix_label\": None,\n299\t                \"fix_text\": \"burn fuel into the 15-85% window\",\n300\t            })\n301\t    return out\n302\t\n303\t\n304\tdef _task_state(done: bool, preconditions: list[dict[str, Any]]) -> tuple[str, str | None]:\n305\t    if done:\n306\t        return \"DONE\", None\n307\t    unmet = next((p for p in preconditions if not p[\"ok\"]), None)\n308\t    if unmet is not None:\n309\t        return \"BLOCKED\", unmet[\"label\"]\n310\t    return \"READY\", None\n311\t\n312\t\n313\t# --- procedure detail: the fault tree's own step, plus electrical/physical\n314\t#    inspect steps, for the task's own expandable body --------------------\n315\t\n316\t\n317\tdef _tree_candidates(vin: str, codes: list[str], mtime: float) -> list[dict[str, Any]]:\n318\t    \"\"\"Every fault-tree :class:`mes.faulttree.Step` (as a dict) applicable to\n319\t    this card's codes -- steps plus verification, from every tree that\n320\t    matches.\n321\t\n322\t    Memoised on ``(vin, codes, mtime)`` -- same posture as\n323\t    ``cuore.services.cache`` everywhere else in this app -- because\n324\t    ``mes_bridge.fault_tree`` annotates against this VIN's own FES-log\n325\t    evidence, which re-parses every log for the vehicle on every call;\n326\t    without this, every single bench page load repeated that full parse,\n327\t    which is both slow for a mechanic reloading the page and (observed\n328\t    directly) slow enough to break the 400px screenshot check's fixed\n329\t    render-wait budget.\n330\t    \"\"\"\n331\t    if not codes:\n332\t        return []\n333\t\n334\t    def _build() -> list[dict[str, Any]]:\n335\t        try:\n336\t            result = mes_bridge.fault_tree(\",\".join(codes), vin=vin)\n337\t        except Exception:  # noqa: BLE001\n338\t            return []\n339\t        out: list[dict[str, Any]] = []\n340\t        for t in result.get(\"trees\") or []:\n341\t            out.extend(t.get(\"steps\") or [])\n342\t            out.extend(t.get(\"verification\") or [])\n343\t        return out\n344\t\n345\t    return cache.get_or_build((\"bench_tree_candidates\", vin, tuple(codes), mtime), _build)\n346\t\n347\t\n348\tdef _match_tree_step(candidates: list[dict[str, Any]], ref: str | None,\n349\t                     text: str) -> dict[str, Any] | None:\n350\t    \"\"\"The step in ``candidates`` this open-work step is transcribed from,\n351\t    matched first by bulletin number (exact, when the step cites one), else\n352\t    by keyword overlap with the step's own text. ``None`` when nothing\n353\t    matches well enough -- the detail panel then says so honestly instead\n354\t    of guessing.\"\"\"\n355\t    if not candidates:\n356\t        return None\n357\t    if ref:\n358\t        for c in candidates:\n359\t            if ref in (c.get(\"source\") or \"\"):\n360\t                return c\n361\t    words = set(re.findall(r\"[a-z]{4,}\", (text or \"\").lower()))\n362\t    best, best_score = None, 0\n363\t    for c in candidates:\n364\t        blob = f\"{c.get('title', '')} {c.get('test', '')}\".lower()\n365\t        score = len(words & set(re.findall(r\"[a-z]{4,}\", blob)))\n366\t        if score > best_score:\n367\t            best, best_score = c, score\n368\t    return best if best_score >= 2 else None\n369\t\n370\t\n371\tdef _action_doc(ref: str | None, ref_href: str | None,\n372\t                bulletins_by_id: dict[str, Any]) -> dict[str, Any] | None:\n373\t    if not ref:\n374\t        return None\n375\t    entry = bulletins_by_id.get(ref) or {}\n376\t    return {\"id\": ref, \"href\": ref_href, \"title\": entry.get(\"title\"),\n377\t            \"action\": entry.get(\"action\")}\n378\t\n379\t\n380\tdef _inspect_steps(codes: list[str]) -> list[dict[str, Any]]:\n381\t    \"\"\"Electrical/physical inspect steps for this step's family -- element,\n382\t    what to check, how, and the source -- when ``mes.electrical`` has a\n383\t    curated path for this code. ``[]`` otherwise, never invented.\"\"\"\n384\t    if electrical_bridge is None or not codes:\n385\t        return []\n386\t    try:\n387\t        path = electrical_bridge.path_for_code(codes[0])\n388\t    except Exception:  # noqa: BLE001\n389\t        return []\n390\t    return (path or {}).get(\"inspect_steps\") or []\n391\t\n392\t\n393\tdef _action_detail(candidates: list[dict[str, Any]], inspect_steps: list[dict[str, Any]],\n394\t                   ref: str | None, ref_href: str | None, text: str,\n395\t                   bulletins_by_id: dict[str, Any]) -> dict[str, Any]:\n396\t    match = _match_tree_step(candidates, ref, text)\n397\t    if match:\n398\t        procedure = {\"test\": match.get(\"test\"), \"tools\": match.get(\"tools\"),\n399\t                     \"source\": match.get(\"source\"), \"caution\": match.get(\"caution\")}\n400\t        pass_line = match.get(\"expect\") or None\n401\t        if_abnormal = match.get(\"if_abnormal\")\n402\t    else:\n403\t        procedure = {\"test\": None, \"tools\": None, \"source\": ref, \"caution\": None}\n404\t        pass_line = None\n405\t        if_abnormal = None\n406\t    return {\n407\t        \"procedure\": procedure,\n408\t        \"pass_line\": pass_line or (\"UNKNOWN -- no sourced pass criterion for this \"\n409\t                                   \"step yet; confirm on the car / service manual\"),\n410\t        \"if_abnormal\": if_abnormal,\n411\t        \"doc\": _action_doc(ref, ref_href, bulletins_by_id),\n412\t        \"inspect_steps\": inspect_steps[:_MAX_INSPECT_STEPS],\n413\t    }\n414\t\n415\t\n416\t# --- parts/tools, job-level and per-task --------------------------------\n417\t\n418\t\n419\tdef _family_parts(vin: str, codes: list[str]) -> list[dict[str, Any]]:\n420\t    \"\"\"Up to :data:`_MAX_PARTS` parts for a family's codes, deduplicated by\n421\t    part key, each shaped ``{name, number, confidence}``. ``number`` and\n422\t    ``confidence`` come off the first OEM row a part carries, falling back\n423\t    to the first aftermarket row -- never invented when neither exists.\"\"\"\n424\t    seen: dict[str, dict[str, Any]] = {}\n425\t    for code in codes:\n426\t        if len(seen) >= _MAX_PARTS:\n427\t            break\n428\t        try:\n429\t            rows = parts_bridge.parts_for_code(code, vin=vin)\n430\t        except Exception:  # noqa: BLE001\n431\t            rows = []\n432\t        for p in rows:\n433\t            key = p.get(\"key\")\n434\t            if not key or key in seen:\n435\t                continue\n436\t            oem = p.get(\"oem\") or []\n437\t            aftermarket = p.get(\"aftermarket\") or []\n438\t            src = oem[0] if oem else (aftermarket[0] if aftermarket else {})\n439\t            seen[key] = {\"name\": p.get(\"name\"), \"number\": src.get(\"number\"),\n440\t                        \"confidence\": src.get(\"confidence\", \"UNKNOWN\")}\n441\t            if len(seen) >= _MAX_PARTS:\n442\t                break\n443\t    return list(seen.values())\n444\t\n445\t\n446\tdef _family_tools(family: str) -> list[dict[str, Any]]:\n447\t    \"\"\"Up to :data:`_MAX_TOOLS` tools for this family, shaped\n448\t    ``{name, have}`` -- ``tools_kb_bridge.recommend`` already resolves\n449\t    ``have`` against the shop's own inventory. ``[]`` for a family\n450\t    ``mes.tools_kb`` has no job-tools table for yet (most of the generic\n451\t    families) -- never a guess at what tool a car needs.\"\"\"\n452\t    try:\n453\t        rows = tools_kb_bridge.recommend((family or \"\").lower())\n454\t    except Exception:  # noqa: BLE001\n455\t        return []\n456\t    out = []\n457\t    for r in rows[:_MAX_TOOLS]:\n458\t        info = r.get(\"tool_info\") or {}\n459\t        out.append({\"name\": info.get(\"name\") or info.get(\"key\"), \"have\": r.get(\"have\")})\n460\t    return out\n461\t\n462\t\n463\tdef _hoist_shared(actions: list[dict[str, Any]]) -> tuple[list[dict[str, Any]],\n464\t                                                           list[dict[str, Any]]]:\n465\t    \"\"\"Pull parts/tools common to every visible task up to job level\n466\t    (BENCH_UX_SPEC_2026-10-08.md B6) -- each task then shows only what it\n467\t    uniquely needs. A no-op with 0 or 1 tasks: nothing is \"shared\" yet.\"\"\"\n468\t    n = len(actions)\n469\t    if n <= 1:\n470\t        return [], []\n471\t    part_counts = Counter(p[\"number\"] or p[\"name\"] for a in actions for p in a[\"parts\"])\n472\t    tool_counts = Counter(t[\"name\"] for a in actions for t in a[\"tools\"])\n473\t    shared_parts = {k for k, c in part_counts.items() if c == n}\n474\t    shared_tools = {k for k, c in tool_counts.items() if c == n}\n475\t    job_parts: list[dict[str, Any]] = []\n476\t    job_tools: list[dict[str, Any]] = []\n477\t    seen_p: set[str] = set()\n478\t    seen_t: set[str] = set()\n479\t    for a in actions:\n480\t        for p in a[\"parts\"]:\n481\t            key = p[\"number\"] or p[\"name\"]\n482\t            if key in shared_parts and key not in seen_p:\n483\t                seen_p.add(key)\n484\t                job_parts.append(p)\n485\t        for t in a[\"tools\"]:\n486\t            if t[\"name\"] in shared_tools and t[\"name\"] not in seen_t:\n487\t                seen_t.add(t[\"name\"])\n488\t                job_tools.append(t)\n489\t        a[\"parts\"] = [p for p in a[\"parts\"] if (p[\"number\"] or p[\"name\"]) not in shared_parts]\n490\t        a[\"tools\"] = [t for t in a[\"tools\"] if t[\"name\"] not in shared_tools]\n491\t    return job_parts, job_tools\n492\t\n493\t\n494\t# --- the task list itself ----------------------------------------------\n495\t\n496\t\n497\tdef _next_actions(vin: str, open_work: list[dict[str, Any]],\n498\t                  codes_by_base: dict[str, str], checklist: dict[str, Any],\n499\t                  live_status: dict[str, Any], fuel_blocked: bool,\n500\t                  bulletins_by_id: dict[str, Any], mtime: float) -> list[dict[str, Any]]:\n501\t    \"\"\"The top :data:`_MAX_ACTIONS` open-work steps across every family,\n502\t    ACTIVE families first (any of that family's codes currently ACTIVE in\n503\t    the code table), then in the same order\n504\t    ``dossier_bridge._build_open_work`` already put the cards in (curated\n505\t    families, then the generic ones) -- a stable sort preserves that\n506\t    ordering within each of the two groups.\n507\t\n508\t    Unlike the old selection, a step already ticked still occupies its slot\n509\t    (BENCH_UX_SPEC_2026-10-08.md B8: a fixed roster with READY/BLOCKED/DONE\n510\t    states, not a shifting top-3-unchecked list) -- otherwise a task marked\n511\t    done would vanish from the bench the instant it was ticked, and \"undo\"\n512\t    would have nowhere to act.\n513\t    \"\"\"\n514\t    def is_active(card: dict[str, Any]) -> bool:\n515\t        return any(codes_by_base.get(c) == \"ACTIVE\" for c in card.get(\"codes\") or [])\n516\t\n517\t    ordered = sorted(open_work, key=lambda c: 0 if is_active(c) else 1)\n518\t\n519\t    actions: list[dict[str, Any]] = []\n520\t    for card in ordered:\n521\t        if len(actions) >= _MAX_ACTIONS:\n522\t            return actions\n523\t        family = card.get(\"family\") or \"\"\n524\t        codes = card.get(\"codes\") or []\n525\t        # Computed once per CARD, not per step: every step in a card shares\n526\t        # the same codes, and both the fault-tree lookup (re-parses this\n527\t        # VIN's own FES logs to annotate against its evidence) and the\n528\t        # electrical path lookup are otherwise paid again for every step.\n529\t        candidates = _tree_candidates(vin, codes, mtime)\n530\t        inspect_steps = _inspect_steps(codes)\n531\t        parts = _family_parts(vin, codes)\n532\t        tools = _family_tools(family)\n533\t        for step in card.get(\"steps\") or []:\n534\t            entry = checklist.get(step[\"id\"]) or {}\n535\t            done = bool(entry.get(\"done\"))\n536\t            ref = step.get(\"ref\")\n537\t            preconditions = _preconditions(step[\"text\"], live_status, fuel_blocked)\n538\t            state, blocked_reason = _task_state(done, preconditions)\n539\t            actions.append({\n540\t                \"step_id\": step[\"id\"], \"family\": family, \"text\": step[\"text\"],\n541\t                \"bulletin\": ({\"id\": ref, \"href\": step.get(\"ref_href\")} if ref else None),\n542\t                \"parts\": list(parts),\n543\t                \"tools\": list(tools),\n544\t                \"done\": done, \"done_at\": entry.get(\"done_at\"),\n545\t                \"done_by\": entry.get(\"done_by\"), \"outcome\": entry.get(\"outcome\"),\n546\t                \"note\": entry.get(\"note\"),\n547\t                \"state\": state, \"blocked_reason\": blocked_reason,\n548\t                \"preconditions\": preconditions,\n549\t                \"detail\": _action_detail(candidates, inspect_steps, ref,\n550\t                                         step.get(\"ref_href\"), step[\"text\"], bulletins_by_id),\n551\t                \"href_tick\": f\"/v/{vin}/bench/done\",\n552\t                \"icon\": FAMILY_ICON.get(family.lower(), \"tools\"),\n553\t            })\n554\t            if len(actions) >= _MAX_ACTIONS:\n555\t                return actions\n556\t    return actions\n557\t\n558\t\n559\tdef _shortcuts(vin: str, codes: list[dict[str, Any]],\n560\t               open_work: list[dict[str, Any]]) -> list[dict[str, Any]]:\n561\t    \"\"\"Up to :data:`_MAX_SHORTCUTS` code-page links, active codes and\n562\t    cleared-but-unverified codes only -- a stale code is not worth a tap\n563\t    target on a screen this small. Each chip carries what its hover/title\n564\t    needs: meaning, status, and which open-work task addresses it\n565\t    (BENCH_UX_SPEC_2026-10-08.md D11).\"\"\"\n566\t    addressed_by: dict[str, str] = {}\n567\t    for card in open_work:\n568\t        for c in card.get(\"codes\") or []:\n569\t            addressed_by.setdefault(c, card.get(\"title\") or card.get(\"family\") or \"\")\n570\t\n571\t    out = []\n572\t    for row in codes:\n573\t        if row.get(\"status\") not in (\"ACTIVE\", \"CLEARED_UNVERIFIED\"):\n574\t            continue\n575\t        out.append({\n576\t            \"code\": row[\"code\"], \"href\": row[\"href\"], \"status\": row[\"status\"],\n577\t            \"status_label\": row.get(\"status_label\") or row[\"status\"],\n578\t            \"description\": row.get(\"description\") or None,\n579\t            \"addressed_by\": addressed_by.get(row[\"code\"]),\n580\t        })\n581\t        if len(out) >= _MAX_SHORTCUTS:\n582\t            break\n583\t    return out\n584\t\n585\t\n586\t# --- header bits ---------------------------------------------------------\n587\t\n588\t\n589\tdef _vehicle_name(vin: str, dossier: dict[str, Any]) -> str:\n590\t    \"\"\"Never \"(unnamed vehicle)\" -- ``shop_bridge.resolve_vehicle_name``\n591\t    already guarantees that (corpus name, then dossier identity, then a WMI\n592\t    decode, then the VIN itself); if that bridge is unavailable for any\n593\t    reason, fall back to the dossier's own identity field, then the VIN.\"\"\"\n594\t    if shop_bridge is not None:\n595\t        try:\n596\t            name = shop_bridge.resolve_vehicle_name(vin)\n597\t            if name:\n598\t                return name\n599\t        except Exception:  # noqa: BLE001\n600\t            pass\n601\t    return (dossier.get(\"identity\") or {}).get(\"vehicle\") or vin\n602\t\n603\t\n604\tdef _complaint(vin: str) -> str | None:\n605\t    if shop_bridge is None:\n606\t        return None\n607\t    try:\n608\t        visit = shop_bridge.current_visit_for_vin(vin)\n609\t    except Exception:  # noqa: BLE001\n610\t        return None\n611\t    return (visit or {}).get(\"complaint\") or None\n612\t\n613\t\n614\tdef _case_hint(vin: str, open_codes: list[str]) -> str | None:\n615\t    \"\"\"One line from ``cases_bridge.prefill`` -- only when a prior case\n616\t    actually matched; the honest \"no prior case on file\" summary\n617\t    ``mes.cases.prefill`` returns otherwise is not a hint worth a mechanic's\n618\t    attention.\"\"\"\n619\t    if cases_bridge is None:\n620\t        return None\n621\t    try:\n622\t        prefill = cases_bridge.prefill(vin, open_codes)\n623\t    except Exception:  # noqa: BLE001\n624\t        return None\n625\t    if not prefill.get(\"matched_case\"):\n626\t        return None\n627\t    return prefill.get(\"summary\")\n628\t\n629\t\n630\tdef _fuel_gate(vin: str, freeze_frames: list[dict[str, Any]]) -> dict[str, Any]:\n631\t    \"\"\"The live fuel gate (BENCH_UX_SPEC_2026-10-08.md C10): current fuel %,\n632\t    the 15-85% EVAP window, and litres to burn to reach 85% -- only when a\n633\t    sourced tank capacity exists for this VIN; ``None`` (UNKNOWN) otherwise,\n634\t    never a guessed number.\"\"\"\n635\t    status = dossier_bridge.fuel_status(freeze_frames)\n636\t    capacity = _tank_capacity_litres(vin)\n637\t    litres = None\n638\t    if (status[\"level\"] is not None and status[\"direction\"] == \"above\"\n639\t            and capacity is not None):\n640\t        litres = round((status[\"level\"] - status[\"window\"][1]) / 100.0 * capacity, 1)\n641\t    return {**status, \"tank_capacity_l\": capacity, \"litres_to_target\": litres}\n642\t\n643\t\n644\tdef _tank_capacity_litres(vin: str) -> float | None:\n645\t    \"\"\"Sourced tank capacity for this VIN (``mes.maintenance_specs`` /\n646\t    ``mes.service``), or ``None`` (UNKNOWN) -- this corpus carries no such\n647\t    spec today, so this always reads UNKNOWN in practice; kept as a real\n648\t    lookup (not a hardcoded None) so a future sourced spec picks it up for\n649\t    free.\"\"\"\n650\t    try:\n651\t        from mes import maintenance_specs  # local: optional, see module docstring\n652\t        getter = getattr(maintenance_specs, \"fuel_tank_capacity_l\", None)\n653\t        if callable(getter):\n654\t            return getter(vin)\n655\t    except Exception:  # noqa: BLE001\n656\t        pass\n657\t    return None\n658\t\n659\t\n660\tdef build_bench(vin: str) -> dict[str, Any]:\n661\t    \"\"\"Everything ``bench.html`` needs, computed once.\n662\t\n663\t    ``live_status`` is passed as ``None`` into ``dossier_bridge.build_view``\n664\t    -- the same choice ``flow_bridge.flow_state`` and\n665\t    ``shop_bridge._dossier_verdict`` already make from the service layer:\n666\t    it only affects whether the verdict's own action buttons render as\n667\t    enabled, never the verdict state itself (that comes from recorded\n668\t    observations), and the bench page does not render those buttons anyway.\n669\t    The bench's own precondition checks read a freshly computed live status\n670\t    instead (see :func:`_live_status`).\n671\t    \"\"\"\n672\t    vin = (vin or \"\").strip()\n673\t    if not vin:\n674\t        raise BadRequest(\"a VIN is required\")\n675\t\n676\t    mtime = mes_bridge.newest_mtime(vin)\n677\t    dossier = cache.get_or_build((\"workup\", vin, mtime), lambda: mes_bridge.workup(vin=vin))\n678\t    view = dossier_bridge.build_view(vin, dossier, None)\n679\t    identity = dossier.get(\"identity\") or {}\n680\t\n681\t    verdict_raw = view.get(\"verdict\") or {}\n682\t    verdict = {\n683\t        \"state\": verdict_raw.get(\"state\"),\n684\t        \"label\": verdict_raw.get(\"label\"),\n685\t        \"sentence\": verdict_raw.get(\"summary\"),\n686\t        \"next_action\": verdict_raw.get(\"next_action\"),\n687\t        \"blocker\": verdict_raw.get(\"blocker\"),\n688\t        \"basis\": verdict_raw.get(\"basis\") or [],\n689\t    }\n690\t\n691\t    codes = view.get(\"codes\") or []\n692\t    codes_by_base = {row[\"code\"]: row[\"status\"] for row in codes}\n693\t    open_work = view.get(\"open_work\") or []\n694\t    bulletins_by_id = {b[\"id\"]: b for b in view.get(\"bulletins\") or []}\n695\t    checklist = checklist_store.get(vin)\n696\t    live_status = _live_status()\n697\t    fuel_blocked = verdict[\"blocker\"] == \"fuel out of window\"\n698\t\n699\t    next_actions = _next_actions(vin, open_work, codes_by_base, checklist,\n700\t                                 live_status, fuel_blocked, bulletins_by_id, mtime)\n701\t    job_parts, job_tools = _hoist_shared(next_actions)\n702\t\n703\t    latest = view.get(\"latest\") or {}\n704\t    last_read = latest.get(\"session_short\") or latest.get(\"scan_short\")\n705\t\n706\t    cp = dossier.get(\"current_picture\") or {}\n707\t    scan_ts = (cp.get(\"latest_scan\") or {}).get(\"timestamp\")\n708\t    session_ts = (cp.get(\"latest_session\") or {}).get(\"timestamp\")\n709\t    newest_ts = max([t for t in (scan_ts, session_ts) if t], default=None)\n710\t    hours_since = _hours_since(newest_ts)\n711\t\n712\t    done_total = sum((c.get(\"progress\") or {}).get(\"done\", 0) for c in open_work)\n713\t    steps_total = sum((c.get(\"progress\") or {}).get(\"total\", 0) for c in open_work)\n714\t\n715\t    active_codes = sorted(r[\"code\"] for r in codes if r[\"status\"] == \"ACTIVE\")\n716\t    cleared_codes = sorted(r[\"code\"] for r in codes if r[\"status\"] == \"CLEARED_UNVERIFIED\")\n717\t    previous_visit = _record_visit(vin, {\n718\t        \"active_codes\": active_codes, \"cleared_codes\": cleared_codes,\n719\t        \"last_read\": last_read,\n720\t    })\n721\t    resume = {\n722\t        \"last_scan_relative\": _relative_time(newest_ts) or \"no scan on file\",\n723\t        \"last_scan_at\": newest_ts,\n724\t        \"changed\": _resume_changes(previous_visit, active_codes, cleared_codes, last_read),\n725\t        \"is_first_visit\": previous_visit is None,\n726\t        \"done\": done_total,\n727\t        \"total\": steps_total,\n728\t        \"next_action\": verdict[\"next_action\"],\n729\t    }\n730\t\n731\t    try:\n732\t        open_codes = mes_bridge.open_codes_for(dossier)\n733\t    except Exception:  # noqa: BLE001\n734\t        open_codes = []\n735\t\n736\t    return {\n737\t        \"vin\": vin,\n738\t        \"vehicle\": _vehicle_name(vin, dossier),\n739\t        \"vin_tail\": vin[-6:] if len(vin) >= 6 else vin,\n740\t        \"km\": identity.get(\"odometer_last_km\"),\n741\t        \"complaint\": _complaint(vin),\n742\t        \"verdict\": verdict,\n743\t        \"resume\": resume,\n744\t        \"progress\": {\"done\": done_total, \"total\": steps_total},\n745\t        \"scan_stale\": bool(hours_since is not None and hours_since > _STALE_HOURS),\n746\t        \"scan_hours_since\": hours_since,\n747\t        \"next_actions\": next_actions,\n748\t        \"job_parts\": job_parts,\n749\t        \"job_tools\": job_tools,\n750\t        \"open_codes_count\": (view.get(\"code_counts\") or {}).get(\"active\", 0),\n751\t        \"last_read\": last_read,\n752\t        \"shortcuts\": _shortcuts(vin, codes, open_work),\n753\t        \"legend\": _STATUS_LEGEND,\n754\t        \"case_hint\": _case_hint(vin, open_codes),\n755\t        \"fuel_gate\": _fuel_gate(vin, view.get(\"freeze_frames\") or []),\n756\t        \"readiness\": dossier_bridge.readiness_panel(vin, dossier),\n757\t        \"live_status\": live_status,\n758\t        \"scanner_label\": scanner_label(live_status),\n759\t        \"blocker_banner\": _blocker_banner(verdict),\n760\t    }\n761\t\n762\t\n763\t__all__ = [\"build_bench\", \"FAMILY_ICON\", \"LABELS\", \"scanner_label\"]\n764\t"}]},"uuid":"213e3668-4b3a-4fbe-b5e6-0f0d58eac91c","timestamp":"2026-10-08T23:40:29.239Z","toolUseResult":{"type":"text","file":{"filePath":"C:\\Users\\User\\mcp-servers\\cuore\\services\\bench_bridge.py","content":"\"\"\"Data for the bench page: \"what am I doing to this car, right now\".\n\n``cuore/web/routes.py``'s old ``/v/{vin}`` was the full dossier -- verdict,\nevery code, every bulletin, every freeze frame, all at once. That page still\nexists (moved to ``/v/{vin}/dossier``); this module backs the thing a\nmechanic actually wants the instant the car is on the lift: a resume\nsummary of what changed since the last visit, the verdict's own next-action\nsentence, the tasks to go do about it (with procedure, pass criteria, parts\nand tools each one needs already resolved), live preconditions, the fuel\ngate and readiness panel, and a couple of jump-off points (codes, the job,\nthe full dossier) -- nothing that needs scrolling to reach on a 400x800\nscreen.\n\n``build_bench`` is the only entry point. It composes bridges that already\nexist -- ``dossier_bridge.build_view`` for the verdict/open-work/codes/\nbulletins/freeze-frames, ``mes_bridge.fault_tree`` for sourced procedure\nsteps, ``electrical_bridge`` for electrical/physical inspect steps,\n``known_good_bridge`` for expected readings, ``parts_bridge``/\n``tools_kb_bridge`` for what a step needs, ``cuore.live.ops``/``checklists``\nfor live status and the shop-ticked checklist, ``shop_bridge``/\n``cases_bridge`` for the header line and the case hint -- and invents no new\ndiagnosis of its own. See BENCH_UX_SPEC_2026-10-08.md for the walkthrough\nthis module answers.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport json\nimport re\nimport threading\nfrom collections import Counter\nfrom datetime import datetime\nfrom pathlib import Path\nfrom typing import Any\n\nfrom . import cache, dossier_bridge, known_good_bridge, mes_bridge, parts_bridge, tools_kb_bridge\nfrom .errors import BadRequest\nfrom ..live import checklists as checklist_store\nfrom ..live.config import state_dir\n\ntry:\n    from . import cases_bridge\nexcept Exception:  # noqa: BLE001 -- the bench must still render without it\n    cases_bridge = None\n\ntry:\n    from . import shop_bridge\nexcept Exception:  # noqa: BLE001\n    shop_bridge = None\n\ntry:\n    from . import electrical_bridge\nexcept Exception:  # noqa: BLE001\n    electrical_bridge = None\n\ntry:\n    from ..live import ops as live_ops\nexcept Exception:  # noqa: BLE001\n    live_ops = None\n\n\n#: Capped the same way the spec caps each bench card: 3 next actions, each\n#: with at most 3 parts and 4 tools.\n_MAX_ACTIONS = 3\n_MAX_PARTS = 3\n_MAX_TOOLS = 4\n_MAX_SHORTCUTS = 6\n_MAX_INSPECT_STEPS = 4\n\n#: Hours since the newest scan/session before the bench flags it stale\n#: (BENCH_UX_SPEC_2026-10-08.md A2) -- a stale read silently invalidates the\n#: whole checklist, so this is surfaced on the bench itself, not just in the\n#: dossier footer.\n_STALE_HOURS = 24.0\n\n#: Family key (lowercased, as ``dossier_bridge.FAMILY_STEPS``/the generic\n#: SAE-range rules spell it) -> icon registry key, for the bench card's own\n#: pictogram. Anything not listed here falls back to a generic glyph --\n#: never a 500 for a family this table doesn't know about yet.\nFAMILY_ICON: dict[str, str] = {\n    \"evap\": \"sys_evap\", \"network\": \"sys_network\", \"misfire\": \"sys_ignition\",\n    \"fuel_trim\": \"sys_fuel\", \"cooling\": \"sys_cooling\",\n    \"engine_management\": \"sys_engine_management\",\n    \"transmission_driveline\": \"sys_transmission_driveline\", \"adas\": \"sys_adas_sensors\",\n    \"chassis\": \"sys_suspension\", \"body\": \"sys_body_comfort\",\n    \"powertrain_other\": \"sys_engine_management\",\n}\n\n#: The chip colour legend rendered once below the DTC shortcut chips\n#: (BENCH_UX_SPEC_2026-10-08.md D11) -- kept here, not guessed per-chip in\n#: the template, so the legend and the chip classes can never drift apart.\n_STATUS_LEGEND = [\n    {\"label\": \"Active\", \"css\": \"v-active\"},\n    {\"label\": \"Cleared, unverified\", \"css\": \"v-cleared-unverified\"},\n]\n\n#: JOB_UX_FIXES_2026-10-08.md item 9: a single source of human labels for\n#: every raw enum this module's own output otherwise carries, so a template\n#: never has to show (or re-invent a translation for) a bare value like\n#: ``not_running`` or a verdict ``blocker`` key. Every other enum this page\n#: shows (verdict state/label, tool ``have``) is already human-labelled at\n#: its own source (dossier_bridge/tools_kb_bridge) -- this dict only covers\n#: the two that weren't: the live MES/scanner state, and the one-line\n#: action for each ``blocker`` key :func:`_fuel_gate`/the verdict compute.\nLABELS: dict[str, dict[str, str]] = {\n    \"mes_state\": {\n        \"connected\": \"Connected\", \"disconnected\": \"Disconnected\",\n        \"not_running\": \"Not running\", \"unknown\": \"Unknown\",\n    },\n    \"blocker\": {\n        \"fuel out of window\": \"Burn fuel to 15-85 %, then run a drive cycle.\",\n        \"awaiting drive cycle\": \"Run a drive cycle, then read readiness.\",\n        \"active faults\": \"Open the codes and start the first test below.\",\n    },\n}\n\n\ndef scanner_label(live_status: dict[str, Any]) -> str:\n    \"\"\"\"Connected\" / \"Not running\" / ... -- never the raw MES state enum,\n    never \"MES ?\" for an unreadable strip.\"\"\"\n    if live_status.get(\"error\"):\n        return \"Unknown\"\n    return LABELS[\"mes_state\"].get(live_status.get(\"mes_state\"), \"Unknown\")\n\n\ndef _blocker_banner(verdict: dict[str, Any]) -> dict[str, Any] | None:\n    \"\"\"The ONE banner the bench shows for \"what do I do right now\" (item\n    17): an icon, a short one-line action, and the verdict's own full\n    sentence + basis behind \"Why?\". ``None`` only when there is no\n    next_action sentence at all (should not happen in practice).\n\n    A true blocker (fuel out of window / awaiting drive cycle / active\n    faults) gets the warning icon and the curated short action from\n    :data:`LABELS`; a clean/no-data verdict still gets ONE line (the\n    verdict's own sentence verbatim -- it is already short), just with a\n    neutral icon, so this is the only place that sentence is ever shown on\n    the bench page.\"\"\"\n    next_action = verdict.get(\"next_action\")\n    if not next_action:\n        return None\n    key = verdict.get(\"blocker\")\n    is_blocker = key not in (None, \"none\", \"no data\")\n    return {\n        \"icon\": \"symptom_warning_message\" if is_blocker else \"status_verified\",\n        \"is_blocker\": is_blocker,\n        \"action\": LABELS[\"blocker\"].get(key, next_action) if is_blocker else next_action,\n        \"why\": next_action,\n        \"basis\": verdict.get(\"basis\") or [],\n    }\n\n\n# --- small helpers ----------------------------------------------------------\n\n\ndef _parse_full_ts(ts: str | None) -> datetime | None:\n    if not ts:\n        return None\n    try:\n        return datetime.strptime(str(ts)[:19], \"%Y-%m-%d %H:%M:%S\")\n    except ValueError:\n        return None\n\n\ndef _relative_time(ts: str | None) -> str | None:\n    \"\"\"\"2 h ago\" / \"3 d ago\" -- never a bare ISO stamp on the resume card.\"\"\"\n    dt = _parse_full_ts(ts)\n    if dt is None:\n        return None\n    secs = max(0.0, (datetime.now() - dt).total_seconds())\n    hours = secs / 3600\n    if hours < 1:\n        return f\"{max(1, int(secs // 60))} min ago\"\n    if hours < 48:\n        return f\"{hours:.0f} h ago\"\n    return f\"{hours / 24:.0f} d ago\"\n\n\ndef _hours_since(ts: str | None) -> float | None:\n    dt = _parse_full_ts(ts)\n    if dt is None:\n        return None\n    return max(0.0, (datetime.now() - dt).total_seconds() / 3600)\n\n\n# --- per-VIN visit tracking, for the resume card's \"what changed\" ----------\n#\n# A small JSON file beside checklists.json/addresses.json, same posture as\n# cuore.live.checklists -- one file, one lock, read-modify-write. Kept here\n# rather than in cuore.live because this is purely a bench-rendering\n# convenience (the previous visit's snapshot), not shop-of-record state.\n\n_VISIT_LOCK = threading.Lock()\n\n\ndef _visits_path() -> Path:\n    # A SUBdirectory, not a file directly under state_dir(): bench_visits.json\n    # is pure bench-rendering bookkeeping (the previous visit's snapshot),\n    # not shop-of-record state -- but dossier_bridge._state_fingerprint()\n    # folds the mtime of every *direct* file under state_dir() into its own\n    # expensive-build cache key, so a file written on every single bench\n    # page load (this one) would invalidate that cache on every single bench\n    # page load too, defeating it completely. iterdir() is not recursive, so\n    # a subdirectory's contents are invisible to that scan.\n    d = state_dir() / \"bench\"\n    try:\n        d.mkdir(parents=True, exist_ok=True)\n    except OSError:\n        pass\n    return d / \"visits.json\"\n\n\ndef _load_visits() -> dict[str, Any]:\n    try:\n        return json.loads(_visits_path().read_text(encoding=\"utf-8\"))\n    except (OSError, ValueError):\n        return {}\n\n\ndef _save_visits(data: dict[str, Any]) -> None:\n    try:\n        _visits_path().write_text(json.dumps(data, indent=2), encoding=\"utf-8\")\n    except OSError:\n        pass\n\n\ndef _record_visit(vin: str, snapshot: dict[str, Any]) -> dict[str, Any] | None:\n    \"\"\"Store this visit's snapshot for ``vin``, returning the PREVIOUS one\n    (``None`` on this vehicle's first bench view).\"\"\"\n    with _VISIT_LOCK:\n        data = _load_visits()\n        previous = data.get(vin)\n        data[vin] = {**snapshot, \"at\": datetime.now().isoformat(timespec=\"seconds\")}\n        _save_visits(data)\n        return previous\n\n\ndef _resume_changes(previous: dict[str, Any] | None, active_codes: list[str],\n                    cleared_codes: list[str], last_read: str | None) -> list[str]:\n    if previous is None:\n        return []\n    changes: list[str] = []\n    new_active = sorted(set(active_codes) - set(previous.get(\"active_codes\") or []))\n    new_cleared = sorted(set(cleared_codes) - set(previous.get(\"cleared_codes\") or []))\n    if new_active:\n        changes.append((\"New code: \" if len(new_active) == 1 else \"New codes: \")\n                       + \", \".join(new_active))\n    if new_cleared:\n        changes.append((\"Cleared: \" if len(new_cleared) == 1 else \"Cleared: \")\n                       + \", \".join(new_cleared))\n    if last_read and previous.get(\"last_read\") and last_read != previous.get(\"last_read\"):\n        changes.append(f\"New record logged ({last_read})\")\n    return changes\n\n\n# --- live status, read fresh for this page (ops.status() is cheap: no I/O\n#    to the car, just the registry/lock file/MES process state) ------------\n\n\ndef _live_status() -> dict[str, Any]:\n    if live_ops is None:\n        return {\"error\": \"live ops unavailable\"}\n    try:\n        s = live_ops.status()\n        return {\n            \"port\": s.get(\"port\"),\n            \"mes_state\": (s.get(\"mes\") or {}).get(\"state\"),\n            \"lock_holder\": (s.get(\"lock\") or {}).get(\"process\"),\n            \"error\": None,\n        }\n    except Exception as exc:  # noqa: BLE001 -- a broken strip must never 500 the bench\n        return {\"error\": str(exc)}\n\n\ndef _preconditions(text: str, live_status: dict[str, Any],\n                   fuel_blocked: bool) -> list[dict[str, Any]]:\n    \"\"\"Per-task live preconditions with a one-click fix link\n    (BENCH_UX_SPEC_2026-10-08.md C9): MES running for an actuator test\n    (-> /live), the car connected for a readiness/verify/live-channel read\n    (-> /tools), fuel in window for that same verify step (text only, no\n    link -- there is nothing to click, only fuel to burn).\"\"\"\n    low = (text or \"\").lower()\n    out: list[dict[str, Any]] = []\n    if \"actuator\" in low or \"koeo\" in low:\n        out.append({\n            \"label\": \"MES running\", \"ok\": live_status.get(\"mes_state\") == \"connected\",\n            \"fix_href\": \"/live\", \"fix_label\": \"Open Live\", \"fix_text\": None,\n        })\n    needs_car = any(k in low for k in\n                    (\"readiness\", \"verify\", \"mode $06\", \"slvt\", \"live channel\"))\n    if needs_car:\n        out.append({\n            \"label\": \"Car connected\", \"ok\": dossier_bridge.live_available(live_status),\n            \"fix_href\": \"/tools\", \"fix_label\": \"Tools\", \"fix_text\": None,\n        })\n        if fuel_blocked:\n            out.append({\n                \"label\": \"Fuel in window\", \"ok\": False,\n                \"fix_href\": None, \"fix_label\": None,\n                \"fix_text\": \"burn fuel into the 15-85% window\",\n            })\n    return out\n\n\ndef _task_state(done: bool, preconditions: list[dict[str, Any]]) -> tuple[str, str | None]:\n    if done:\n        return \"DONE\", None\n    unmet = next((p for p in preconditions if not p[\"ok\"]), None)\n    if unmet is not None:\n        return \"BLOCKED\", unmet[\"label\"]\n    return \"READY\", None\n\n\n# --- procedure detail: the fault tree's own step, plus electrical/physical\n#    inspect steps, for the task's own expandable body --------------------\n\n\ndef _tree_candidates(vin: str, codes: list[str], mtime: float) -> list[dict[str, Any]]:\n    \"\"\"Every fault-tree :class:`mes.faulttree.Step` (as a dict) applicable to\n    this card's codes -- steps plus verification, from every tree that\n    matches.\n\n    Memoised on ``(vin, codes, mtime)`` -- same posture as\n    ``cuore.services.cache`` everywhere else in this app -- because\n    ``mes_bridge.fault_tree`` annotates against this VIN's own FES-log\n    evidence, which re-parses every log for the vehicle on every call;\n    without this, every single bench page load repeated that full parse,\n    which is both slow for a mechanic reloading the page and (observed\n    directly) slow enough to break the 400px screenshot check's fixed\n    render-wait budget.\n    \"\"\"\n    if not codes:\n        return []\n\n    def _build() -> list[dict[str, Any]]:\n        try:\n            result = mes_bridge.fault_tree(\",\".join(codes), vin=vin)\n        except Exception:  # noqa: BLE001\n            return []\n        out: list[dict[str, Any]] = []\n        for t in result.get(\"trees\") or []:\n            out.extend(t.get(\"steps\") or [])\n            out.extend(t.get(\"verification\") or [])\n        return out\n\n    return cache.get_or_build((\"bench_tree_candidates\", vin, tuple(codes), mtime), _build)\n\n\ndef _match_tree_step(candidates: list[dict[str, Any]], ref: str | None,\n                     text: str) -> dict[str, Any] | None:\n    \"\"\"The step in ``candidates`` this open-work step is transcribed from,\n    matched first by bulletin number (exact, when the step cites one), else\n    by keyword overlap with the step's own text. ``None`` when nothing\n    matches well enough -- the detail panel then says so honestly instead\n    of guessing.\"\"\"\n    if not candidates:\n        return None\n    if ref:\n        for c in candidates:\n            if ref in (c.get(\"source\") or \"\"):\n                return c\n    words = set(re.findall(r\"[a-z]{4,}\", (text or \"\").lower()))\n    best, best_score = None, 0\n    for c in candidates:\n        blob = f\"{c.get('title', '')} {c.get('test', '')}\".lower()\n        score = len(words & set(re.findall(r\"[a-z]{4,}\", blob)))\n        if score > best_score:\n            best, best_score = c, score\n    return best if best_score >= 2 else None\n\n\ndef _action_doc(ref: str | None, ref_href: str | None,\n                bulletins_by_id: dict[str, Any]) -> dict[str, Any] | None:\n    if not ref:\n        return None\n    entry = bulletins_by_id.get(ref) or {}\n    return {\"id\": ref, \"href\": ref_href, \"title\": entry.get(\"title\"),\n            \"action\": entry.get(\"action\")}\n\n\ndef _inspect_steps(codes: list[str]) -> list[dict[str, Any]]:\n    \"\"\"Electrical/physical inspect steps for this step's family -- element,\n    what to check, how, and the source -- when ``mes.electrical`` has a\n    curated path for this code. ``[]`` otherwise, never invented.\"\"\"\n    if electrical_bridge is None or not codes:\n        return []\n    try:\n        path = electrical_bridge.path_for_code(codes[0])\n    except Exception:  # noqa: BLE001\n        return []\n    return (path or {}).get(\"inspect_steps\") or []\n\n\ndef _action_detail(candidates: list[dict[str, Any]], inspect_steps: list[dict[str, Any]],\n                   ref: str | None, ref_href: str | None, text: str,\n                   bulletins_by_id: dict[str, Any]) -> dict[str, Any]:\n    match = _match_tree_step(candidates, ref, text)\n    if match:\n        procedure = {\"test\": match.get(\"test\"), \"tools\": match.get(\"tools\"),\n                     \"source\": match.get(\"source\"), \"caution\": match.get(\"caution\")}\n        pass_line = match.get(\"expect\") or None\n        if_abnormal = match.get(\"if_abnormal\")\n    else:\n        procedure = {\"test\": None, \"tools\": None, \"source\": ref, \"caution\": None}\n        pass_line = None\n        if_abnormal = None\n    return {\n        \"procedure\": procedure,\n        \"pass_line\": pass_line or (\"UNKNOWN -- no sourced pass criterion for this \"\n                                   \"step yet; confirm on the car / service manual\"),\n        \"if_abnormal\": if_abnormal,\n        \"doc\": _action_doc(ref, ref_href, bulletins_by_id),\n        \"inspect_steps\": inspect_steps[:_MAX_INSPECT_STEPS],\n    }\n\n\n# --- parts/tools, job-level and per-task --------------------------------\n\n\ndef _family_parts(vin: str, codes: list[str]) -> list[dict[str, Any]]:\n    \"\"\"Up to :data:`_MAX_PARTS` parts for a family's codes, deduplicated by\n    part key, each shaped ``{name, number, confidence}``. ``number`` and\n    ``confidence`` come off the first OEM row a part carries, falling back\n    to the first aftermarket row -- never invented when neither exists.\"\"\"\n    seen: dict[str, dict[str, Any]] = {}\n    for code in codes:\n        if len(seen) >= _MAX_PARTS:\n            break\n        try:\n            rows = parts_bridge.parts_for_code(code, vin=vin)\n        except Exception:  # noqa: BLE001\n            rows = []\n        for p in rows:\n            key = p.get(\"key\")\n            if not key or key in seen:\n                continue\n            oem = p.get(\"oem\") or []\n            aftermarket = p.get(\"aftermarket\") or []\n            src = oem[0] if oem else (aftermarket[0] if aftermarket else {})\n            seen[key] = {\"name\": p.get(\"name\"), \"number\": src.get(\"number\"),\n                        \"confidence\": src.get(\"confidence\", \"UNKNOWN\")}\n            if len(seen) >= _MAX_PARTS:\n                break\n    return list(seen.values())\n\n\ndef _family_tools(family: str) -> list[dict[str, Any]]:\n    \"\"\"Up to :data:`_MAX_TOOLS` tools for this family, shaped\n    ``{name, have}`` -- ``tools_kb_bridge.recommend`` already resolves\n    ``have`` against the shop's own inventory. ``[]`` for a family\n    ``mes.tools_kb`` has no job-tools table for yet (most of the generic\n    families) -- never a guess at what tool a car needs.\"\"\"\n    try:\n        rows = tools_kb_bridge.recommend((family or \"\").lower())\n    except Exception:  # noqa: BLE001\n        return []\n    out = []\n    for r in rows[:_MAX_TOOLS]:\n        info = r.get(\"tool_info\") or {}\n        out.append({\"name\": info.get(\"name\") or info.get(\"key\"), \"have\": r.get(\"have\")})\n    return out\n\n\ndef _hoist_shared(actions: list[dict[str, Any]]) -> tuple[list[dict[str, Any]],\n                                                           list[dict[str, Any]]]:\n    \"\"\"Pull parts/tools common to every visible task up to job level\n    (BENCH_UX_SPEC_2026-10-08.md B6) -- each task then shows only what it\n    uniquely needs. A no-op with 0 or 1 tasks: nothing is \"shared\" yet.\"\"\"\n    n = len(actions)\n    if n <= 1:\n        return [], []\n    part_counts = Counter(p[\"number\"] or p[\"name\"] for a in actions for p in a[\"parts\"])\n    tool_counts = Counter(t[\"name\"] for a in actions for t in a[\"tools\"])\n    shared_parts = {k for k, c in part_counts.items() if c == n}\n    shared_tools = {k for k, c in tool_counts.items() if c == n}\n    job_parts: list[dict[str, Any]] = []\n    job_tools: list[dict[str, Any]] = []\n    seen_p: set[str] = set()\n    seen_t: set[str] = set()\n    for a in actions:\n        for p in a[\"parts\"]:\n            key = p[\"number\"] or p[\"name\"]\n            if key in shared_parts and key not in seen_p:\n                seen_p.add(key)\n                job_parts.append(p)\n        for t in a[\"tools\"]:\n            if t[\"name\"] in shared_tools and t[\"name\"] not in seen_t:\n                seen_t.add(t[\"name\"])\n                job_tools.append(t)\n        a[\"parts\"] = [p for p in a[\"parts\"] if (p[\"number\"] or p[\"name\"]) not in shared_parts]\n        a[\"tools\"] = [t for t in a[\"tools\"] if t[\"name\"] not in shared_tools]\n    return job_parts, job_tools\n\n\n# --- the task list itself ----------------------------------------------\n\n\ndef _next_actions(vin: str, open_work: list[dict[str, Any]],\n                  codes_by_base: dict[str, str], checklist: dict[str, Any],\n                  live_status: dict[str, Any], fuel_blocked: bool,\n                  bulletins_by_id: dict[str, Any], mtime: float) -> list[dict[str, Any]]:\n    \"\"\"The top :data:`_MAX_ACTIONS` open-work steps across every family,\n    ACTIVE families first (any of that family's codes currently ACTIVE in\n    the code table), then in the same order\n    ``dossier_bridge._build_open_work`` already put the cards in (curated\n    families, then the generic ones) -- a stable sort preserves that\n    ordering within each of the two groups.\n\n    Unlike the old selection, a step already ticked still occupies its slot\n    (BENCH_UX_SPEC_2026-10-08.md B8: a fixed roster with READY/BLOCKED/DONE\n    states, not a shifting top-3-unchecked list) -- otherwise a task marked\n    done would vanish from the bench the instant it was ticked, and \"undo\"\n    would have nowhere to act.\n    \"\"\"\n    def is_active(card: dict[str, Any]) -> bool:\n        return any(codes_by_base.get(c) == \"ACTIVE\" for c in card.get(\"codes\") or [])\n\n    ordered = sorted(open_work, key=lambda c: 0 if is_active(c) else 1)\n\n    actions: list[dict[str, Any]] = []\n    for card in ordered:\n        if len(actions) >= _MAX_ACTIONS:\n            return actions\n        family = card.get(\"family\") or \"\"\n        codes = card.get(\"codes\") or []\n        # Computed once per CARD, not per step: every step in a card shares\n        # the same codes, and both the fault-tree lookup (re-parses this\n        # VIN's own FES logs to annotate against its evidence) and the\n        # electrical path lookup are otherwise paid again for every step.\n        candidates = _tree_candidates(vin, codes, mtime)\n        inspect_steps = _inspect_steps(codes)\n        parts = _family_parts(vin, codes)\n        tools = _family_tools(family)\n        for step in card.get(\"steps\") or []:\n            entry = checklist.get(step[\"id\"]) or {}\n            done = bool(entry.get(\"done\"))\n            ref = step.get(\"ref\")\n            preconditions = _preconditions(step[\"text\"], live_status, fuel_blocked)\n            state, blocked_reason = _task_state(done, preconditions)\n            actions.append({\n                \"step_id\": step[\"id\"], \"family\": family, \"text\": step[\"text\"],\n                \"bulletin\": ({\"id\": ref, \"href\": step.get(\"ref_href\")} if ref else None),\n                \"parts\": list(parts),\n                \"tools\": list(tools),\n                \"done\": done, \"done_at\": entry.get(\"done_at\"),\n                \"done_by\": entry.get(\"done_by\"), \"outcome\": entry.get(\"outcome\"),\n                \"note\": entry.get(\"note\"),\n                \"state\": state, \"blocked_reason\": blocked_reason,\n                \"preconditions\": preconditions,\n                \"detail\": _action_detail(candidates, inspect_steps, ref,\n                                         step.get(\"ref_href\"), step[\"text\"], bulletins_by_id),\n                \"href_tick\": f\"/v/{vin}/bench/done\",\n                \"icon\": FAMILY_ICON.get(family.lower(), \"tools\"),\n            })\n            if len(actions) >= _MAX_ACTIONS:\n                return actions\n    return actions\n\n\ndef _shortcuts(vin: str, codes: list[dict[str, Any]],\n               open_work: list[dict[str, Any]]) -> list[dict[str, Any]]:\n    \"\"\"Up to :data:`_MAX_SHORTCUTS` code-page links, active codes and\n    cleared-but-unverified codes only -- a stale code is not worth a tap\n    target on a screen this small. Each chip carries what its hover/title\n    needs: meaning, status, and which open-work task addresses it\n    (BENCH_UX_SPEC_2026-10-08.md D11).\"\"\"\n    addressed_by: dict[str, str] = {}\n    for card in open_work:\n        for c in card.get(\"codes\") or []:\n            addressed_by.setdefault(c, card.get(\"title\") or card.get(\"family\") or \"\")\n\n    out = []\n    for row in codes:\n        if row.get(\"status\") not in (\"ACTIVE\", \"CLEARED_UNVERIFIED\"):\n            continue\n        out.append({\n            \"code\": row[\"code\"], \"href\": row[\"href\"], \"status\": row[\"status\"],\n            \"status_label\": row.get(\"status_label\") or row[\"status\"],\n            \"description\": row.get(\"description\") or None,\n            \"addressed_by\": addressed_by.get(row[\"code\"]),\n        })\n        if len(out) >= _MAX_SHORTCUTS:\n            break\n    return out\n\n\n# --- header bits ---------------------------------------------------------\n\n\ndef _vehicle_name(vin: str, dossier: dict[str, Any]) -> str:\n    \"\"\"Never \"(unnamed vehicle)\" -- ``shop_bridge.resolve_vehicle_name``\n    already guarantees that (corpus name, then dossier identity, then a WMI\n    decode, then the VIN itself); if that bridge is unavailable for any\n    reason, fall back to the dossier's own identity field, then the VIN.\"\"\"\n    if shop_bridge is not None:\n        try:\n            name = shop_bridge.resolve_vehicle_name(vin)\n            if name:\n                return name\n        except Exception:  # noqa: BLE001\n            pass\n    return (dossier.get(\"identity\") or {}).get(\"vehicle\") or vin\n\n\ndef _complaint(vin: str) -> str | None:\n    if shop_bridge is None:\n        return None\n    try:\n        visit = shop_bridge.current_visit_for_vin(vin)\n    except Exception:  # noqa: BLE001\n        return None\n    return (visit or {}).get(\"complaint\") or None\n\n\ndef _case_hint(vin: str, open_codes: list[str]) -> str | None:\n    \"\"\"One line from ``cases_bridge.prefill`` -- only when a prior case\n    actually matched; the honest \"no prior case on file\" summary\n    ``mes.cases.prefill`` returns otherwise is not a hint worth a mechanic's\n    attention.\"\"\"\n    if cases_bridge is None:\n        return None\n    try:\n        prefill = cases_bridge.prefill(vin, open_codes)\n    except Exception:  # noqa: BLE001\n        return None\n    if not prefill.get(\"matched_case\"):\n        return None\n    return prefill.get(\"summary\")\n\n\ndef _fuel_gate(vin: str, freeze_frames: list[dict[str, Any]]) -> dict[str, Any]:\n    \"\"\"The live fuel gate (BENCH_UX_SPEC_2026-10-08.md C10): current fuel %,\n    the 15-85% EVAP window, and litres to burn to reach 85% -- only when a\n    sourced tank capacity exists for this VIN; ``None`` (UNKNOWN) otherwise,\n    never a guessed number.\"\"\"\n    status = dossier_bridge.fuel_status(freeze_frames)\n    capacity = _tank_capacity_litres(vin)\n    litres = None\n    if (status[\"level\"] is not None and status[\"direction\"] == \"above\"\n            and capacity is not None):\n        litres = round((status[\"level\"] - status[\"window\"][1]) / 100.0 * capacity, 1)\n    return {**status, \"tank_capacity_l\": capacity, \"litres_to_target\": litres}\n\n\ndef _tank_capacity_litres(vin: str) -> float | None:\n    \"\"\"Sourced tank capacity for this VIN (``mes.maintenance_specs`` /\n    ``mes.service``), or ``None`` (UNKNOWN) -- this corpus carries no such\n    spec today, so this always reads UNKNOWN in practice; kept as a real\n    lookup (not a hardcoded None) so a future sourced spec picks it up for\n    free.\"\"\"\n    try:\n        from mes import maintenance_specs  # local: optional, see module docstring\n        getter = getattr(maintenance_specs, \"fuel_tank_capacity_l\", None)\n        if callable(getter):\n            return getter(vin)\n    except Exception:  # noqa: BLE001\n        pass\n    return None\n\n\ndef build_bench(vin: str) -> dict[str, Any]:\n    \"\"\"Everything ``bench.html`` needs, computed once.\n\n    ``live_status`` is passed as ``None`` into ``dossier_bridge.build_view``\n    -- the same choice ``flow_bridge.flow_state`` and\n    ``shop_bridge._dossier_verdict`` already make from the service layer:\n    it only affects whether the verdict's own action buttons render as\n    enabled, never the verdict state itself (that comes from recorded\n    observations), and the bench page does not render those buttons anyway.\n    The bench's own precondition checks read a freshly computed live status\n    instead (see :func:`_live_status`).\n    \"\"\"\n    vin = (vin or \"\").strip()\n    if not vin:\n        raise BadRequest(\"a VIN is required\")\n\n    mtime = mes_bridge.newest_mtime(vin)\n    dossier = cache.get_or_build((\"workup\", vin, mtime), lambda: mes_bridge.workup(vin=vin))\n    view = dossier_bridge.build_view(vin, dossier, None)\n    identity = dossier.get(\"identity\") or {}\n\n    verdict_raw = view.get(\"verdict\") or {}\n    verdict = {\n        \"state\": verdict_raw.get(\"state\"),\n        \"label\": verdict_raw.get(\"label\"),\n        \"sentence\": verdict_raw.get(\"summary\"),\n        \"next_action\": verdict_raw.get(\"next_action\"),\n        \"blocker\": verdict_raw.get(\"blocker\"),\n        \"basis\": verdict_raw.get(\"basis\") or [],\n    }\n\n    codes = view.get(\"codes\") or []\n    codes_by_base = {row[\"code\"]: row[\"status\"] for row in codes}\n    open_work = view.get(\"open_work\") or []\n    bulletins_by_id = {b[\"id\"]: b for b in view.get(\"bulletins\") or []}\n    checklist = checklist_store.get(vin)\n    live_status = _live_status()\n    fuel_blocked = verdict[\"blocker\"] == \"fuel out of window\"\n\n    next_actions = _next_actions(vin, open_work, codes_by_base, checklist,\n                                 live_status, fuel_blocked, bulletins_by_id, mtime)\n    job_parts, job_tools = _hoist_shared(next_actions)\n\n    latest = view.get(\"latest\") or {}\n    last_read = latest.get(\"session_short\") or latest.get(\"scan_short\")\n\n    cp = dossier.get(\"current_picture\") or {}\n    scan_ts = (cp.get(\"latest_scan\") or {}).get(\"timestamp\")\n    session_ts = (cp.get(\"latest_session\") or {}).get(\"timestamp\")\n    newest_ts = max([t for t in (scan_ts, session_ts) if t], default=None)\n    hours_since = _hours_since(newest_ts)\n\n    done_total = sum((c.get(\"progress\") or {}).get(\"done\", 0) for c in open_work)\n    steps_total = sum((c.get(\"progress\") or {}).get(\"total\", 0) for c in open_work)\n\n    active_codes = sorted(r[\"code\"] for r in codes if r[\"status\"] == \"ACTIVE\")\n    cleared_codes = sorted(r[\"code\"] for r in codes if r[\"status\"] == \"CLEARED_UNVERIFIED\")\n    previous_visit = _record_visit(vin, {\n        \"active_codes\": active_codes, \"cleared_codes\": cleared_codes,\n        \"last_read\": last_read,\n    })\n    resume = {\n        \"last_scan_relative\": _relative_time(newest_ts) or \"no scan on file\",\n        \"last_scan_at\": newest_ts,\n        \"changed\": _resume_changes(previous_visit, active_codes, cleared_codes, last_read),\n        \"is_first_visit\": previous_visit is None,\n        \"done\": done_total,\n        \"total\": steps_total,\n        \"next_action\": verdict[\"next_action\"],\n    }\n\n    try:\n        open_codes = mes_bridge.open_codes_for(dossier)\n    except Exception:  # noqa: BLE001\n        open_codes = []\n\n    return {\n        \"vin\": vin,\n        \"vehicle\": _vehicle_name(vin, dossier),\n        \"vin_tail\": vin[-6:] if len(vin) >= 6 else vin,\n        \"km\": identity.get(\"odometer_last_km\"),\n        \"complaint\": _complaint(vin),\n        \"verdict\": verdict,\n        \"resume\": resume,\n        \"progress\": {\"done\": done_total, \"total\": steps_total},\n        \"scan_stale\": bool(hours_since is not None and hours_since > _STALE_HOURS),\n        \"scan_hours_since\": hours_since,\n        \"next_actions\": next_actions,\n        \"job_parts\": job_parts,\n        \"job_tools\": job_tools,\n        \"open_codes_count\": (view.get(\"code_counts\") or {}).get(\"active\", 0),\n        \"last_read\": last_read,\n        \"shortcuts\": _shortcuts(vin, codes, open_work),\n        \"legend\": _STATUS_LEGEND,\n        \"case_hint\": _case_hint(vin, open_codes),\n        \"fuel_gate\": _fuel_gate(vin, view.get(\"freeze_frames\") or []),\n        \"readiness\": dossier_bridge.readiness_panel(vin, dossier),\n        \"live_status\": live_status,\n        \"scanner_label\": scanner_label(live_status),\n        \"blocker_banner\": _blocker_banner(verdict),\n    }\n\n\n__all__ = [\"build_bench\", \"FAMILY_ICON\", \"LABELS\", \"scanner_label\"]\n","numLines":764,"startLine":1,"totalLines":764}},"sourceToolAssistantUUID":"0ee70306-3db1-4788-9340-b608b3fe1a49","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
