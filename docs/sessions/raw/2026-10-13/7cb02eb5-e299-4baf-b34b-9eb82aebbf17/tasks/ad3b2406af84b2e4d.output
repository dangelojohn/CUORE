\" (/v/{vin}/timeline)\n814\t * Appended section; everything above this line predates the timeline page.\n815\t * ========================================================================= */\n816\t\n817\t/* Per-code-family colours for cuore/web/timeline_svg.py. Same convention as\n818\t * the --sev-* / --ok ramp above: dark-first in :root, mirrored in the light\n819\t * media query and the explicit [data-theme=\"light\"] override, so the SVG's"}]},"uuid":"0c4d7c1e-db29-4d4c-86b3-1b48f2260e81","timestamp":"2026-10-08T23:45:48.609Z","toolUseResult":{"type":"text","file":{"filePath":"C:\\Users\\User\\mcp-servers\\cuore\\web\\static\\cuore.css","content":"/* ---------- ergonomics baseline (R10) ---------- */\n\nbody { font-size: 16px; }\n.small { font-size: 13px; }\ntable.codes-table td.n.mono, table.codes-table td.mono { font-size: 14px; }\n/* ...except the short last-seen date and the compact km figure, which are\n * labels rather than precision measurements and need the width back more\n * than they need the bump (title=\"\" carries the exact value on tap). */\ntable.codes-table td.lastseen-cell { font-size: 12px; }\ntable.codes-table td.kmcell { font-size: 12.5px; }\n.jump-chip, .vtabs a { min-height: 40px; }\n.btn { min-height: 44px; }\ninput[type=checkbox] + label, label.checkbox-label { min-height: 44px; display: inline-flex; align-items: center; }\n\n/* ---------- theme toggle persistence hook ---------- */\n/* data-theme is set/read by cuore.js; the actual palettes are the\n * :root[data-theme=\"light\"] / @media blocks already defined above. */\n\n@media (max-width: 400px) {\n  .vline .vname { max-width: 32%; }\n  .verdict-actions { flex-direction: column; }\n}\n\n\n/* Swipeable rows (tabs, section chips): no desktop-style scrollbar; they\n * still scroll by touch, trackpad and shift+wheel. */\n.vtabs, .jumprow { scrollbar-width: none; }\n.vtabs::-webkit-scrollbar, .jumprow::-webkit-scrollbar { display: none; }\n/* The strip's \"...\" details button must never be pushed off-screen. */\n.vbar .vmore { flex: none; margin-left: auto; }\n\n\n/* =========================================================================\n * TIMELINE -- \"Codes vs. what the driver notices\" (/v/{vin}/timeline)\n * Appended section; everything above this line predates the timeline page.\n * ========================================================================= */\n\n/* Per-code-family colours for cuore/web/timeline_svg.py. Same convention as\n * the --sev-* / --ok ramp above: dark-first in :root, mirrored in the light\n * media query and the explicit [data-theme=\"light\"] override, so the SVG's","numLines":40,"startLine":780,"totalLines":1577}},"sourceToolAssistantUUID":"8aefb467-363c-4f13-809d-7d536f834dee","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
