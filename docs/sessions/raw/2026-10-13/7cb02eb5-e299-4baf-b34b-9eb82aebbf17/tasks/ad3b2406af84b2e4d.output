{"parentUuid":"db39890f-cbff-4a35-9247-bcc20a7928f3","isSidechain":true,"agentId":"ad3b2406af84b2e4d","message":{"model":"claude-sonnet-5","id":"msg_011CfqfLHMmBRxxQ3o46sTZ8","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_016x7ER7PmAQ85i3mvVTsccB","name":"Read","input":{"file_path":"C:\\Users\\User\\mcp-servers\\cuore\\tests\\check_bench.py"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":9978,"cache_read_input_tokens":161654,"cache_creation":{"ephemeral_5m_input_tokens":9978,"ephemeral_1h_input_tokens":0},"output_tokens":7,"service_tier":"standard","inference_geo":"not_available"},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_016x7ER7PmAQ85i3mvVTsccB":{"file_path":"C:\\Users\\User\\mcp-servers\\cuore\\tests\\check_bench.py"}},"serverClassifierRequest":"58d36426-e2f0-43dc-a242-17c3cd99d8d3","apiBlockIndex":3,"requestId":"req_011CfqfLH7srPP613nJYZUpi","attributionAgent":"general-purpose","type":"assistant","uuid":"cc4009cd-899b-48aa-a1ed-e799105e6ae3","timestamp":"2026-10-08T23:46:47.631Z","effort":"high","perTurnEffort":null,"userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
{"parentUuid":"cc4009cd-899b-48aa-a1ed-e799105e6ae3","isSidechain":true,"promptId":"c88cddde-d9ec-4df1-89bf-4cd0fc5db786","agentId":"ad3b2406af84b2e4d","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_016x7ER7PmAQ85i3mvVTsccB","type":"tool_result","content":"1\t\"\"\"Smoke checks for the bench page (``GET /v/{vin}``, cuore/services/bench_bridge.py,\n2\tcuore/web/bench_routes.py, cuore/web/templates/bench.html).\n3\t\n4\tSame posture as ``cuore/tests/check_dossier_page.py``: ``CUORE_STATE_DIR``\n5\tpointed at a throwaway directory before cuore is imported, the Stelvio's\n6\treal corpus as the fixture (chronic P0455/P0440/P0456, cleared 2026-09-29,\n7\tnever re-verified -- see project_stelvio_evap.md). No mocks: the five checks\n8\tbelow all run against the real app and the real corpus.\n9\t\n10\tFive checks:\n11\t  1. ``GET /v/{vin}`` responds 200, the status line names the Stelvio (and\n12\t     never \"(unnamed vehicle)\"), and the old dossier still answers at\n13\t     ``/v/{vin}/dossier``.\n14\t  2. The verdict's ``next_action`` sentence mentions the 85% EVAP fuel\n15\t     ceiling and cites a real bulletin for this VIN.\n16\t  3. Exactly up to 3 next-action cards render, and at least one carries a\n17\t     real part number.\n18\t  4. ``/v/{vin}/dossier`` still responds 200 (the route this file's own\n19\t     sibling, check_dossier_page.py, now hits instead of the bare path).\n20\t  5. A 400px CDP screenshot: the first next-action card's bounding box top\n21\t     is inside the viewport (< 800px) and the page has no horizontal\n22\t     overflow at that width.\n23\t\n24\tRun:\n25\t    .venv/Scripts/python.exe cuore/tests/check_bench.py\n26\t\"\"\"\n27\t\n28\tfrom __future__ import annotations\n29\t\n30\timport itertools\n31\timport json\n32\timport os\n33\timport re\n34\timport socket\n35\timport subprocess\n36\timport sys\n37\timport tempfile\n38\timport time\n39\timport urllib.request\n40\tfrom pathlib import Path\n41\t\n42\tos.environ[\"CUORE_STATE_DIR\"] = tempfile.mkdtemp(prefix=\"cuore-check-bench-\")\n43\tos.environ.pop(\"CUORE_AUDIT_PATH\", None)\n44\t\n45\tROOT = Path(__file__).resolve().parents[2]\n46\tsys.path.insert(0, str(ROOT))\n47\t\n48\tfrom fastapi.testclient import TestClient  # noqa: E402\n49\t\n50\tfrom cuore.app import create_app  # noqa: E402\n51\tfrom cuore.live import checklists as checklist_store  # noqa: E402\n52\tfrom cuore.services import bench_bridge, mes_bridge  # noqa: E402\n53\t\n54\tVIN = \"ZASFAKPN5J7B88115\"  # the Stelvio -- real corpus, chronic P0455/P0440/P0456\n55\t\n56\tfailures: list[str] = []\n57\tchecks = 0\n58\t\n59\t\n60\tdef check(label: str, cond: bool, detail: str = \"\") -> None:\n61\t    global checks\n62\t    checks += 1\n63\t    if not cond:\n64\t        failures.append(f\"{label}{(' -- ' + detail) if detail else ''}\")\n65\t\n66\t\n67\tclient = TestClient(create_app())\n68\t\n69\t\n70\t# --- build_bench() directly ------------------------------------------------\n71\t\n72\tbench = bench_bridge.build_bench(VIN)\n73\tcheck(\"vehicle name is never the unnamed placeholder\",\n74\t      bench[\"vehicle\"] != \"(unnamed vehicle)\" and bool(bench[\"vehicle\"]), str(bench[\"vehicle\"]))\n75\tcheck(\"vehicle name names the Stelvio\", \"Stelvio\" in bench[\"vehicle\"], str(bench[\"vehicle\"]))\n76\tcheck(\"vin_tail is the VIN's last 6 characters\", bench[\"vin_tail\"] == VIN[-6:],\n77\t      str(bench[\"vin_tail\"]))\n78\tcheck(\"at most 3 next actions\", len(bench[\"next_actions\"]) <= 3,\n79\t      str(len(bench[\"next_actions\"])))\n80\tcheck(\"at most 6 shortcuts\", len(bench[\"shortcuts\"]) <= 6, str(len(bench[\"shortcuts\"])))\n81\t\n82\t\n83\t# --- 1. the real route: GET /v/{vin} is the bench, GET /v/{vin}/dossier is\n84\t#    still the full dossier -----------------------------------------------\n85\t\n86\tpage = client.get(f\"/v/{VIN}\")\n87\tcheck(\"bench page responds 200\", page.status_code == 200, str(page.status_code))\n88\tcheck(\"bench status line names the Stelvio\", \"Stelvio\" in page.text)\n89\tcheck(\"bench status line never shows the unnamed placeholder\",\n90\t      \"(unnamed vehicle)\" not in page.text)\n91\tcheck(\"bench status line carries the VIN tail\",\n92\t      VIN[-6:] in page.text, VIN[-6:])\n93\t\n94\tdossier_page = client.get(f\"/v/{VIN}/dossier\")\n95\tcheck(\"the old dossier still responds 200 at /v/{vin}/dossier\",\n96\t      dossier_page.status_code == 200, str(dossier_page.status_code))\n97\tcheck(\"the old dossier page still shows its own verdict card\",\n98\t      'class=\"chip-verdict' in dossier_page.text)\n99\tcheck(\"the bench page is not the same page as the dossier\",\n100\t      'id=\"verdict\"' not in page.text)\n101\t\n102\t\n103\t# --- 2. verdict.next_action mentions 85% and a real bulletin --------------\n104\t\n105\tnext_action = bench[\"verdict\"][\"next_action\"] or \"\"\n106\tcheck(\"next_action is a non-empty sentence\", bool(next_action.strip()), next_action)\n107\tcheck(\"next_action mentions the 85% EVAP fuel ceiling\", \"85\" in next_action, next_action)\n108\t\n109\tall_bulletins = {\n110\t    b for card in (bench_bridge.dossier_bridge.build_view(\n111\t        VIN, bench_bridge.mes_bridge.workup(vin=VIN), None)[\"open_work\"])\n112\t    for step in card.get(\"steps\", []) for b in [step.get(\"ref\")] if b\n113\t}\n114\tcheck(\"next_action cites one of this VIN's real bulletins\",\n115\t      any(b in next_action for b in all_bulletins), f\"{next_action!r} vs {all_bulletins}\")\n116\tcheck(\"next_action also appears on the rendered bench page\", next_action in page.text)\n117\t\n118\t\n119\t# --- 3. next-action cards carry at least one real part number -------------\n120\t\n121\tcheck(\"at least one next action is offered\", len(bench[\"next_actions\"]) > 0,\n122\t      str(bench[\"next_actions\"]))\n123\tany_part_number = (\n124\t    any(p.get(\"number\") for a in bench[\"next_actions\"] for p in a.get(\"parts\", []))\n125\t    or any(p.get(\"number\") for p in bench.get(\"job_parts\", [])))\n126\tcheck(\"at least one next action (or the job-level shared list) carries a real \"\n127\t      \"part number\", any_part_number,\n128\t      str([a.get(\"parts\") for a in bench[\"next_actions\"]] + [bench.get(\"job_parts\")]))\n129\tcheck(\"every rendered next-action card posts to the bench's own outcome-capturing \"\n130\t      \"route (2 forms per card: the checkbox, and the outcome Save button)\",\n131\t      page.text.count(f'action=\"/v/{VIN}/bench/done\"') == 2 * len(bench[\"next_actions\"]),\n132\t      str(page.text.count(f'action=\"/v/{VIN}/bench/done\"')))\n133\t\n134\tfor a in bench[\"next_actions\"]:\n135\t    check(f\"step {a['step_id']} text is on the page\", a[\"text\"] in page.text)\n136\t    for p in a.get(\"parts\", []):\n137\t        if p.get(\"number\"):\n138\t            check(f\"part number {p['number']} is on the page\", p[\"number\"] in page.text)\n139\tfor p in bench.get(\"job_parts\", []):\n140\t    if p.get(\"number\"):\n141\t        check(f\"job-level shared part number {p['number']} is on the page\",\n142\t              p[\"number\"] in page.text)\n143\t\n144\t\n145\t# --- ticking a real checklist step from the bench's own form works -------\n146\t\n147\tif bench[\"next_actions\"]:\n148\t    step_id = bench[\"next_actions\"][0][\"step_id\"]\n149\t    toggled = client.post(f\"/v/{VIN}/checklist\", data={\"step_id\": step_id, \"done\": \"1\"},\n150\t                          follow_redirects=False)\n151\t    check(\"ticking a step from the bench's own form is accepted\",\n152\t          toggled.status_code == 303, str(toggled.status_code))\n153\t    # leave it as we found it\n154\t    client.post(f\"/v/{VIN}/checklist\", data={\"step_id\": step_id, \"done\": \"0\"})\n155\t\n156\t\n157\t# --- BENCH_UX_SPEC_2026-10-08.md: the six check-list items ----------------\n158\t\n159\t# 1. resume card present with \"last scan\" and \"N of M done\"\n160\tcheck(\"the resume card shows 'last scan'\", \"last scan\" in page.text)\n161\tcheck(\"the resume card shows the N of M done progress\",\n162\t      f\"{bench['progress']['done']} of {bench['progress']['total']} done\" in page.text,\n163\t      f\"{bench['progress']}\")\n164\t\n165\t# 2. a task expands to show \"Pass =\" and a procedure step\n166\tsourced = next((a for a in bench[\"next_actions\"] if a[\"detail\"][\"procedure\"][\"test\"]), None)\n167\tcheck(\"at least one task has a sourced fault-tree procedure step\",\n168\t      sourced is not None, str([a[\"detail\"] for a in bench[\"next_actions\"]]))\n169\tif sourced:\n170\t    check(\"that task's procedure step text is on the page\",\n171\t          sourced[\"detail\"][\"procedure\"][\"test\"] in page.text)\n172\t    check('that task shows a \"Pass = ...\" line on the page',\n173\t          f\"Pass = {sourced['detail']['pass_line']}\" in page.text)\n174\t\n175\t# 3. mark done with outcome \"fault found\" stores the note and shows DONE\n176\tif bench[\"next_actions\"]:\n177\t    fault_step_id = bench[\"next_actions\"][0][\"step_id\"]\n178\t    finding = \"bench check: smoke test shows a leak at the recirculation line\"\n179\t    marked = client.post(f\"/v/{VIN}/bench/done\",\n180\t                         data={\"step_id\": fault_step_id, \"done\": \"1\",\n181\t                               \"outcome\": \"fault_found\", \"note\": finding, \"by\": \"check_bench\"},\n182\t                         follow_redirects=False)\n183\t    check(\"marking a task done with an outcome is accepted (303)\",\n184\t          marked.status_code == 303, str(marked.status_code))\n185\t    after_done = client.get(f\"/v/{VIN}\")\n186\t    check(\"the task row shows DONE after marking it done\",\n187\t          f'data-task-id=\"{fault_step_id}\" data-state=\"done\"' in after_done.text,\n188\t          after_done.text.count('data-state=\"done\"'))\n189\t    check(\"the fault-found finding note is shown on the page\",\n190\t          finding in after_done.text)\n191\t    notes_after = mes_bridge.notes(VIN)\n192\t    check(\"the fault-found finding was also filed as a mechanic note (mes.notes)\",\n193\t          any(finding in (n.get(\"text\") or \"\") for n in notes_after.get(\"notes\", [])),\n194\t          str(notes_after.get(\"notes\")))\n195\t\n196\t    # undo: un-ticking (no \"done\" field at all, matching real checkbox semantics)\n197\t    # clears the outcome/note and leaves the step not-done again.\n198\t    undone = client.post(f\"/v/{VIN}/bench/done\",\n199\t                         data={\"step_id\": fault_step_id, \"note\": \"\"},\n200\t                         follow_redirects=False)\n201\t    check(\"undoing a marked-done task is accepted (303)\",\n202\t          undone.status_code == 303, str(undone.status_code))\n203\t    check(\"undo cleared the stored outcome\",\n204\t          checklist_store.get(VIN).get(fault_step_id, {}).get(\"outcome\") is None,\n205\t          str(checklist_store.get(VIN).get(fault_step_id)))\n206\t\n207\t# 4. preconditions show MES status\n208\tmes_task = next((a for a in bench[\"next_actions\"]\n209\t                 if any(p[\"label\"] == \"MES running\" for p in a[\"preconditions\"])), None)\n210\tcheck(\"at least one task declares a live MES precondition\",\n211\t      mes_task is not None, str([a[\"preconditions\"] for a in bench[\"next_actions\"]]))\n212\tif mes_task:\n213\t    check(\"the MES running precondition is shown on the page\", \"MES running\" in page.text)\n214\t\n215\t# 5. every task row has a labelled checkbox and data-task-id\n216\tfor a in bench[\"next_actions\"]:\n217\t    check(f\"task row {a['step_id']} carries data-task-id\",\n218\t          f'data-task-id=\"{a[\"step_id\"]}\"' in page.text)\n219\t    check(f\"task row {a['step_id']} has a real checkbox input\",\n220\t          f'id=\"chk-{a[\"step_id\"]}\"' in page.text)\n221\t    check(f\"task row {a['step_id']}'s checkbox is labelled with its task title\",\n222\t          f'Mark done: {a[\"text\"]}' in page.text)\n223\t\n224\t# 6. title contains \"UNVERIFIED\"\n225\ttitle_match = re.search(r\"<title>(.*?)</title>\", page.text, re.DOTALL)\n226\tcheck(\"the page has a <title> tag\", title_match is not None)\n227\tif title_match:\n228\t    check(\"the <title> contains UNVERIFIED\", \"UNVERIFIED\" in title_match.group(1),\n229\t          title_match.group(1))\n230\t\n231\t\n232\t# --- 5. 400px CDP screenshot: first card's top < 800px, no overflow -------\n233\t\n234\tprint(\"=== 400px screenshot (cleanup via _edge_cleanup.kill_edge_profile) ===\")\n235\tEDGE_CANDIDATES = [\n236\t    r\"C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe\",\n237\t    r\"C:\\Program Files\\Microsoft\\Edge\\Application\\msedge.exe\",\n238\t]\n239\t\n240\t\n241\tdef find_edge() -> str:\n242\t    for candidate in EDGE_CANDIDATES:\n243\t        if Path(candidate).exists():\n244\t            return candidate\n245\t    return \"\"\n246\t\n247\t\n248\tdef free_port() -> int:\n249\t    s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)\n250\t    s.bind((\"127.0.0.1\", 0))\n251\t    port = s.getsockname()[1]\n252\t    s.close()\n253\t    return port\n254\t\n255\t\n256\tclass CDP:\n257\t    def __init__(self, ws_url: str) -> None:\n258\t        from websockets.sync.client import connect\n259\t        self.ws = connect(ws_url, max_size=None, open_timeout=20)\n260\t        self._ids = itertools.count(1)\n261\t\n262\t    def send(self, method: str, params: dict | None = None, timeout: float = 20):\n263\t        msg_id = next(self._ids)\n264\t        self.ws.send(json.dumps({\"id\": msg_id, \"method\": method, \"params\": params or {}}))\n265\t        deadline = time.time() + timeout\n266\t        while time.time() < deadline:\n267\t            raw = self.ws.recv(timeout=max(0.1, deadline - time.time()))\n268\t            msg = json.loads(raw)\n269\t            if msg.get(\"id\") == msg_id:\n270\t                if \"error\" in msg:\n271\t                    raise RuntimeError(f\"CDP {method} failed: {msg['error']}\")\n272\t                return msg.get(\"result\", {})\n273\t        raise TimeoutError(f\"CDP {method} timed out waiting for response\")\n274\t\n275\t    def close(self) -> None:\n276\t        try:\n277\t            self.ws.close()\n278\t        except Exception:\n279\t            pass\n280\t\n281\t\n282\tdef wait_for_devtools(port: int, timeout: float = 20) -> None:\n283\t    deadline = time.time() + timeout\n284\t    last_err: Exception | None = None\n285\t    while time.time() < deadline:\n286\t        try:\n287\t            with urllib.request.urlopen(f\"http://127.0.0.1:{port}/json/version\", timeout=2) as r:\n288\t                json.loads(r.read().decode(\"utf-8\"))\n289\t                return\n290\t        except Exception as exc:  # noqa: BLE001\n291\t            last_err = exc\n292\t            time.sleep(0.2)\n293\t    raise RuntimeError(f\"headless Edge devtools endpoint never came up: {last_err}\")\n294\t\n295\t\n296\tdef open_target(port: int, url: str) -> dict:\n297\t    req = urllib.request.Request(f\"http://127.0.0.1:{port}/json/new?{url}\", method=\"PUT\")\n298\t    with urllib.request.urlopen(req, timeout=10) as r:\n299\t        return json.loads(r.read().decode(\"utf-8\"))\n300\t\n301\t\n302\tdef wait_for_port(port: int, timeout: float = 15.0) -> bool:\n303\t    deadline = time.monotonic() + timeout\n304\t    while time.monotonic() < deadline:\n305\t        try:\n306\t            with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:\n307\t                s.settimeout(0.3)\n308\t                s.connect((\"127.0.0.1\", port))\n309\t                return True\n310\t        except OSError:\n311\t            time.sleep(0.2)\n312\t    return False\n313\t\n314\t\n315\tdef wait_for_navigation(cdp: \"CDP\", url: str, timeout: float = 15.0) -> bool:\n316\t    \"\"\"Poll until the tab has actually navigated to ``url`` (not still\n317\t    ``about:blank``) and ``document.readyState`` is \"complete\". A fixed\n318\t    short sleep after ``/json/new?<url>`` is NOT enough in this environment\n319\t    -- a cold headless-Edge tab observably takes several seconds (not the\n320\t    ~1.5s this check used to assume) before ``location.href`` moves off\n321\t    ``about:blank``, independent of how fast the server itself answers\n322\t    (confirmed separately: the server's own response lands in well under a\n323\t    second). Polling, not a longer fixed guess, is what actually restores\n324\t    the strict downstream geometry checks reliably.\"\"\"\n325\t    deadline = time.time() + timeout\n326\t    while time.time() < deadline:\n327\t        val = cdp.send(\"Runtime.evaluate\", {\n328\t            \"expression\": (\"JSON.stringify({href: location.href, \"\n329\t                           \"ready: document.readyState})\"),\n330\t            \"returnByValue\": True,\n331\t        })\n332\t        try:\n333\t            state = json.loads(val.get(\"result\", {}).get(\"value\") or \"{}\")\n334\t        except ValueError:\n335\t            state = {}\n336\t        if state.get(\"href\", \"about:blank\") != \"about:blank\" and state.get(\"ready\") == \"complete\":\n337\t            return True\n338\t        time.sleep(0.3)\n339\t    return False\n340\t\n341\t\n342\tedge = find_edge()\n343\tserver_dir = tempfile.mkdtemp(prefix=\"cuore-check-bench-server-\")\n344\tport = free_port()\n345\tenv = dict(os.environ)\n346\tenv[\"CUORE_STATE_DIR\"] = server_dir\n347\t\n348\t_SERVER_SNIPPET = f\"\"\"\n349\timport sys\n350\tsys.path.insert(0, {str(ROOT)!r})\n351\tfrom cuore.app import create_app\n352\timport uvicorn\n353\t\n354\tapp = create_app()\n355\tuvicorn.run(app, host=\"127.0.0.1\", port={port}, log_level=\"warning\")\n356\t\"\"\"\n357\t\n358\tif not edge:\n359\t    check(\"headless Edge is available for the screenshot check\", False, str(EDGE_CANDIDATES))\n360\telse:\n361\t    server_proc = subprocess.Popen(\n362\t        [sys.executable, \"-c\", _SERVER_SNIPPET],\n363\t        cwd=str(ROOT), env=env,\n364\t        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,\n365\t    )\n366\t    try:\n367\t        up = wait_for_port(port)\n368\t        check(\"uvicorn came up on the free port\", up, f\"port {port}\")\n369\t        if up:\n370\t            # Warm the bench's own caches (mes_bridge.workup + dossier_bridge's\n371\t            # memoised core) in this freshly spawned, cold process BEFORE\n372\t            # Edge ever navigates -- building the Stelvio's 17-log workup and\n373\t            # resolving parts/tools for 3 next actions easily outruns the\n374\t            # 1.7s this check waits before reading document.readyState below,\n375\t            # which otherwise reads the pre-navigation about:blank document\n376\t            # (readyState \"complete\" trivially, body empty) rather than the\n377\t            # real page. check_screens.py hits the same thing and warms the\n378\t            # same way (its own seed POST, then a sleep) before measuring.\n379\t            try:\n380\t                urllib.request.urlopen(f\"http://127.0.0.1:{port}/v/{VIN}\", timeout=25)\n381\t            except Exception as exc:  # noqa: BLE001\n382\t                check(\"warming the bench page on the screenshot server\", False, str(exc))\n383\t            time.sleep(0.5)\n384\t            devtools_port = free_port()\n385\t            profile_dir = Path(tempfile.mkdtemp(prefix=\"cuore-edge-bench-\"))\n386\t            edge_proc = subprocess.Popen(\n387\t                [edge, \"--headless=new\", f\"--remote-debugging-port={devtools_port}\",\n388\t                 f\"--user-data-dir={profile_dir}\", \"--no-first-run\", \"--window-size=400,800\",\n389\t                 \"about:blank\"],\n390\t                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,\n391\t            )\n392\t            try:\n393\t                wait_for_devtools(devtools_port)\n394\t                url = f\"http://127.0.0.1:{port}/v/{VIN}\"\n395\t                target = open_target(devtools_port, url)\n396\t                cdp = CDP(target[\"webSocketDebuggerUrl\"])\n397\t                try:\n398\t                    cdp.send(\"Page.enable\")\n399\t                    cdp.send(\"Runtime.enable\")\n400\t                    navigated = wait_for_navigation(cdp, url)\n401\t                    cdp.send(\"Emulation.setDeviceMetricsOverride\", {\n402\t                        \"width\": 400, \"height\": 800, \"deviceScaleFactor\": 1, \"mobile\": True,\n403\t                    })\n404\t                    time.sleep(0.5)\n405\t\n406\t                    nav = cdp.send(\"Runtime.evaluate\", {\n407\t                        \"expression\": \"document.readyState\", \"returnByValue\": True})\n408\t                    check(\"bench page loaded in the headless browser\",\n409\t                          navigated and nav.get(\"result\", {}).get(\"value\") in (\"complete\", \"interactive\"),\n410\t                          str(nav))\n411\t\n412\t                    overflow = cdp.send(\"Runtime.evaluate\", {\n413\t                        \"expression\": (\n414\t                            \"JSON.stringify({sw: document.documentElement.scrollWidth, \"\n415\t                            \"cw: document.documentElement.clientWidth})\"),\n416\t                        \"returnByValue\": True,\n417\t                    })\n418\t                    dims = json.loads(overflow.get(\"result\", {}).get(\"value\", \"{}\"))\n419\t                    sw, cw = dims.get(\"sw\", 0), dims.get(\"cw\", 0)\n420\t                    check(\"no page-level horizontal overflow at 400px\",\n421\t                         sw <= cw + 1, f\"scrollWidth={sw} clientWidth={cw}\")\n422\t\n423\t                    rect = cdp.send(\"Runtime.evaluate\", {\n424\t                        \"expression\": (\n425\t                            \"(() => { const el = document.querySelector('.bench-card'); \"\n426\t                            \"if (!el) return JSON.stringify(null); \"\n427\t                            \"const r = el.getBoundingClientRect(); \"\n428\t                            \"return JSON.stringify({top: r.top, left: r.left, right: r.right}); \"\n429\t                            \"})()\"),\n430\t                        \"returnByValue\": True,\n431\t                    })\n432\t                    card_rect = json.loads(rect.get(\"result\", {}).get(\"value\", \"null\"))\n433\t                    check(\"the first next-action card is present on the page\",\n434\t                          card_rect is not None, str(card_rect))\n435\t                    if card_rect is not None:\n436\t                        # Strict stopwatch check (matches check_stopwatch.py): the\n437\t                        # Bench's shared {% include \"_vbar.html\" %} hero now renders\n438\t                        # a COMPACT hero for tab == \"bench\" (image band capped at\n439\t                        # 18vh, no tagline, no key-figures row -- see _vbar.html and\n440\t                        # cuore.css's \"Bench compact hero\" section) specifically so\n441\t                        # the resume card and first next-action card land back\n442\t                        # on-screen at 400x800 with no scrolling. The full,\n443\t                        # taller hero (image/tagline/key-figures) is report-only.\n444\t                        check(\"the first next-action card's top is within the \"\n445\t                             \"first 800px viewport (no scrolling at 400x800)\",\n446\t                             card_rect[\"top\"] < 800, str(card_rect))\n447\t                        check(\"the first next-action card does not overflow horizontally\",\n448\t                             card_rect[\"right\"] <= 400 + 1, str(card_rect))\n449\t\n450\t                    resume_rect = cdp.send(\"Runtime.evaluate\", {\n451\t                        \"expression\": (\n452\t                            \"(() => { const el = document.querySelector('.bench-resume'); \"\n453\t                            \"if (!el) return JSON.stringify(null); \"\n454\t                            \"const r = el.getBoundingClientRect(); \"\n455\t                            \"return JSON.stringify({top: r.top}); })()\"),\n456\t                        \"returnByValue\": True,\n457\t                    })\n458\t                    resume_box = json.loads(resume_rect.get(\"result\", {}).get(\"value\", \"null\"))\n459\t                    check(\"the resume card is present on the page\", resume_box is not None,\n460\t                         str(resume_box))\n461\t                    if resume_box is not None:\n462\t                        # The actual P1 fix (BENCH_UX_SPEC A1): the resume card\n463\t                        # itself -- not the task list -- is what should be reached\n464\t                        # with minimal scrolling, right under the hero + tab strip.\n465\t                        check(\"the resume card sits right under the hero/tab strip, \"\n466\t                             \"not buried under the task list\",\n467\t                             resume_box[\"top\"] < 1300, str(resume_box))\n468\t\n469\t                    shot = cdp.send(\"Page.captureScreenshot\", {\"format\": \"png\"})\n470\t                    data_b64 = shot.get(\"data\", \"\")\n471\t                    check(\"a 400px screenshot of the bench was captured\",\n472\t                         bool(data_b64), f\"{len(data_b64)} bytes of base64\")\n473\t                finally:\n474\t                    cdp.close()\n475\t            except Exception as exc:  # noqa: BLE001\n476\t                check(\"headless Edge measured the bench page over CDP\", False,\n477\t                     f\"{type(exc).__name__}: {exc}\")\n478\t            finally:\n479\t                edge_proc.terminate()\n480\t                try:\n481\t                    edge_proc.wait(timeout=5)\n482\t                except Exception:\n483\t                    edge_proc.kill()\n484\t                from _edge_cleanup import kill_edge_profile\n485\t                kill_edge_profile(profile_dir)\n486\t    finally:\n487\t        server_proc.terminate()\n488\t        try:\n489\t            server_proc.wait(timeout=5)\n490\t        except Exception:\n491\t            server_proc.kill()\n492\t\n493\t\n494\t# --- report ------------------------------------------------------------------\n495\t\n496\tprint()\n497\tif failures:\n498\t    print(f\"{len(failures)}/{checks} check(s) failed:\")\n499\t    for f in failures:\n500\t        print(f\"  - {f}\")\n501\t    sys.exit(1)\n502\tprint(f\"all {checks} checks passed\")\n503\t"}]},"uuid":"1fe29086-3ab8-4058-b6eb-f9813362bf6b","timestamp":"2026-10-08T23:46:47.678Z","toolUseResult":{"type":"text","file":{"filePath":"C:\\Users\\User\\mcp-servers\\cuore\\tests\\check_bench.py","content":"\"\"\"Smoke checks for the bench page (``GET /v/{vin}``, cuore/services/bench_bridge.py,\ncuore/web/bench_routes.py, cuore/web/templates/bench.html).\n\nSame posture as ``cuore/tests/check_dossier_page.py``: ``CUORE_STATE_DIR``\npointed at a throwaway directory before cuore is imported, the Stelvio's\nreal corpus as the fixture (chronic P0455/P0440/P0456, cleared 2026-09-29,\nnever re-verified -- see project_stelvio_evap.md). No mocks: the five checks\nbelow all run against the real app and the real corpus.\n\nFive checks:\n  1. ``GET /v/{vin}`` responds 200, the status line names the Stelvio (and\n     never \"(unnamed vehicle)\"), and the old dossier still answers at\n     ``/v/{vin}/dossier``.\n  2. The verdict's ``next_action`` sentence mentions the 85% EVAP fuel\n     ceiling and cites a real bulletin for this VIN.\n  3. Exactly up to 3 next-action cards render, and at least one carries a\n     real part number.\n  4. ``/v/{vin}/dossier`` still responds 200 (the route this file's own\n     sibling, check_dossier_page.py, now hits instead of the bare path).\n  5. A 400px CDP screenshot: the first next-action card's bounding box top\n     is inside the viewport (< 800px) and the page has no horizontal\n     overflow at that width.\n\nRun:\n    .venv/Scripts/python.exe cuore/tests/check_bench.py\n\"\"\"\n\nfrom __future__ import annotations\n\nimport itertools\nimport json\nimport os\nimport re\nimport socket\nimport subprocess\nimport sys\nimport tempfile\nimport time\nimport urllib.request\nfrom pathlib import Path\n\nos.environ[\"CUORE_STATE_DIR\"] = tempfile.mkdtemp(prefix=\"cuore-check-bench-\")\nos.environ.pop(\"CUORE_AUDIT_PATH\", None)\n\nROOT = Path(__file__).resolve().parents[2]\nsys.path.insert(0, str(ROOT))\n\nfrom fastapi.testclient import TestClient  # noqa: E402\n\nfrom cuore.app import create_app  # noqa: E402\nfrom cuore.live import checklists as checklist_store  # noqa: E402\nfrom cuore.services import bench_bridge, mes_bridge  # noqa: E402\n\nVIN = \"ZASFAKPN5J7B88115\"  # the Stelvio -- real corpus, chronic P0455/P0440/P0456\n\nfailures: list[str] = []\nchecks = 0\n\n\ndef check(label: str, cond: bool, detail: str = \"\") -> None:\n    global checks\n    checks += 1\n    if not cond:\n        failures.append(f\"{label}{(' -- ' + detail) if detail else ''}\")\n\n\nclient = TestClient(create_app())\n\n\n# --- build_bench() directly ------------------------------------------------\n\nbench = bench_bridge.build_bench(VIN)\ncheck(\"vehicle name is never the unnamed placeholder\",\n      bench[\"vehicle\"] != \"(unnamed vehicle)\" and bool(bench[\"vehicle\"]), str(bench[\"vehicle\"]))\ncheck(\"vehicle name names the Stelvio\", \"Stelvio\" in bench[\"vehicle\"], str(bench[\"vehicle\"]))\ncheck(\"vin_tail is the VIN's last 6 characters\", bench[\"vin_tail\"] == VIN[-6:],\n      str(bench[\"vin_tail\"]))\ncheck(\"at most 3 next actions\", len(bench[\"next_actions\"]) <= 3,\n      str(len(bench[\"next_actions\"])))\ncheck(\"at most 6 shortcuts\", len(bench[\"shortcuts\"]) <= 6, str(len(bench[\"shortcuts\"])))\n\n\n# --- 1. the real route: GET /v/{vin} is the bench, GET /v/{vin}/dossier is\n#    still the full dossier -----------------------------------------------\n\npage = client.get(f\"/v/{VIN}\")\ncheck(\"bench page responds 200\", page.status_code == 200, str(page.status_code))\ncheck(\"bench status line names the Stelvio\", \"Stelvio\" in page.text)\ncheck(\"bench status line never shows the unnamed placeholder\",\n      \"(unnamed vehicle)\" not in page.text)\ncheck(\"bench status line carries the VIN tail\",\n      VIN[-6:] in page.text, VIN[-6:])\n\ndossier_page = client.get(f\"/v/{VIN}/dossier\")\ncheck(\"the old dossier still responds 200 at /v/{vin}/dossier\",\n      dossier_page.status_code == 200, str(dossier_page.status_code))\ncheck(\"the old dossier page still shows its own verdict card\",\n      'class=\"chip-verdict' in dossier_page.text)\ncheck(\"the bench page is not the same page as the dossier\",\n      'id=\"verdict\"' not in page.text)\n\n\n# --- 2. verdict.next_action mentions 85% and a real bulletin --------------\n\nnext_action = bench[\"verdict\"][\"next_action\"] or \"\"\ncheck(\"next_action is a non-empty sentence\", bool(next_action.strip()), next_action)\ncheck(\"next_action mentions the 85% EVAP fuel ceiling\", \"85\" in next_action, next_action)\n\nall_bulletins = {\n    b for card in (bench_bridge.dossier_bridge.build_view(\n        VIN, bench_bridge.mes_bridge.workup(vin=VIN), None)[\"open_work\"])\n    for step in card.get(\"steps\", []) for b in [step.get(\"ref\")] if b\n}\ncheck(\"next_action cites one of this VIN's real bulletins\",\n      any(b in next_action for b in all_bulletins), f\"{next_action!r} vs {all_bulletins}\")\ncheck(\"next_action also appears on the rendered bench page\", next_action in page.text)\n\n\n# --- 3. next-action cards carry at least one real part number -------------\n\ncheck(\"at least one next action is offered\", len(bench[\"next_actions\"]) > 0,\n      str(bench[\"next_actions\"]))\nany_part_number = (\n    any(p.get(\"number\") for a in bench[\"next_actions\"] for p in a.get(\"parts\", []))\n    or any(p.get(\"number\") for p in bench.get(\"job_parts\", [])))\ncheck(\"at least one next action (or the job-level shared list) carries a real \"\n      \"part number\", any_part_number,\n      str([a.get(\"parts\") for a in bench[\"next_actions\"]] + [bench.get(\"job_parts\")]))\ncheck(\"every rendered next-action card posts to the bench's own outcome-capturing \"\n      \"route (2 forms per card: the checkbox, and the outcome Save button)\",\n      page.text.count(f'action=\"/v/{VIN}/bench/done\"') == 2 * len(bench[\"next_actions\"]),\n      str(page.text.count(f'action=\"/v/{VIN}/bench/done\"')))\n\nfor a in bench[\"next_actions\"]:\n    check(f\"step {a['step_id']} text is on the page\", a[\"text\"] in page.text)\n    for p in a.get(\"parts\", []):\n        if p.get(\"number\"):\n            check(f\"part number {p['number']} is on the page\", p[\"number\"] in page.text)\nfor p in bench.get(\"job_parts\", []):\n    if p.get(\"number\"):\n        check(f\"job-level shared part number {p['number']} is on the page\",\n              p[\"number\"] in page.text)\n\n\n# --- ticking a real checklist step from the bench's own form works -------\n\nif bench[\"next_actions\"]:\n    step_id = bench[\"next_actions\"][0][\"step_id\"]\n    toggled = client.post(f\"/v/{VIN}/checklist\", data={\"step_id\": step_id, \"done\": \"1\"},\n                          follow_redirects=False)\n    check(\"ticking a step from the bench's own form is accepted\",\n          toggled.status_code == 303, str(toggled.status_code))\n    # leave it as we found it\n    client.post(f\"/v/{VIN}/checklist\", data={\"step_id\": step_id, \"done\": \"0\"})\n\n\n# --- BENCH_UX_SPEC_2026-10-08.md: the six check-list items ----------------\n\n# 1. resume card present with \"last scan\" and \"N of M done\"\ncheck(\"the resume card shows 'last scan'\", \"last scan\" in page.text)\ncheck(\"the resume card shows the N of M done progress\",\n      f\"{bench['progress']['done']} of {bench['progress']['total']} done\" in page.text,\n      f\"{bench['progress']}\")\n\n# 2. a task expands to show \"Pass =\" and a procedure step\nsourced = next((a for a in bench[\"next_actions\"] if a[\"detail\"][\"procedure\"][\"test\"]), None)\ncheck(\"at least one task has a sourced fault-tree procedure step\",\n      sourced is not None, str([a[\"detail\"] for a in bench[\"next_actions\"]]))\nif sourced:\n    check(\"that task's procedure step text is on the page\",\n          sourced[\"detail\"][\"procedure\"][\"test\"] in page.text)\n    check('that task shows a \"Pass = ...\" line on the page',\n          f\"Pass = {sourced['detail']['pass_line']}\" in page.text)\n\n# 3. mark done with outcome \"fault found\" stores the note and shows DONE\nif bench[\"next_actions\"]:\n    fault_step_id = bench[\"next_actions\"][0][\"step_id\"]\n    finding = \"bench check: smoke test shows a leak at the recirculation line\"\n    marked = client.post(f\"/v/{VIN}/bench/done\",\n                         data={\"step_id\": fault_step_id, \"done\": \"1\",\n                               \"outcome\": \"fault_found\", \"note\": finding, \"by\": \"check_bench\"},\n                         follow_redirects=False)\n    check(\"marking a task done with an outcome is accepted (303)\",\n          marked.status_code == 303, str(marked.status_code))\n    after_done = client.get(f\"/v/{VIN}\")\n    check(\"the task row shows DONE after marking it done\",\n          f'data-task-id=\"{fault_step_id}\" data-state=\"done\"' in after_done.text,\n          after_done.text.count('data-state=\"done\"'))\n    check(\"the fault-found finding note is shown on the page\",\n          finding in after_done.text)\n    notes_after = mes_bridge.notes(VIN)\n    check(\"the fault-found finding was also filed as a mechanic note (mes.notes)\",\n          any(finding in (n.get(\"text\") or \"\") for n in notes_after.get(\"notes\", [])),\n          str(notes_after.get(\"notes\")))\n\n    # undo: un-ticking (no \"done\" field at all, matching real checkbox semantics)\n    # clears the outcome/note and leaves the step not-done again.\n    undone = client.post(f\"/v/{VIN}/bench/done\",\n                         data={\"step_id\": fault_step_id, \"note\": \"\"},\n                         follow_redirects=False)\n    check(\"undoing a marked-done task is accepted (303)\",\n          undone.status_code == 303, str(undone.status_code))\n    check(\"undo cleared the stored outcome\",\n          checklist_store.get(VIN).get(fault_step_id, {}).get(\"outcome\") is None,\n          str(checklist_store.get(VIN).get(fault_step_id)))\n\n# 4. preconditions show MES status\nmes_task = next((a for a in bench[\"next_actions\"]\n                 if any(p[\"label\"] == \"MES running\" for p in a[\"preconditions\"])), None)\ncheck(\"at least one task declares a live MES precondition\",\n      mes_task is not None, str([a[\"preconditions\"] for a in bench[\"next_actions\"]]))\nif mes_task:\n    check(\"the MES running precondition is shown on the page\", \"MES running\" in page.text)\n\n# 5. every task row has a labelled checkbox and data-task-id\nfor a in bench[\"next_actions\"]:\n    check(f\"task row {a['step_id']} carries data-task-id\",\n          f'data-task-id=\"{a[\"step_id\"]}\"' in page.text)\n    check(f\"task row {a['step_id']} has a real checkbox input\",\n          f'id=\"chk-{a[\"step_id\"]}\"' in page.text)\n    check(f\"task row {a['step_id']}'s checkbox is labelled with its task title\",\n          f'Mark done: {a[\"text\"]}' in page.text)\n\n# 6. title contains \"UNVERIFIED\"\ntitle_match = re.search(r\"<title>(.*?)</title>\", page.text, re.DOTALL)\ncheck(\"the page has a <title> tag\", title_match is not None)\nif title_match:\n    check(\"the <title> contains UNVERIFIED\", \"UNVERIFIED\" in title_match.group(1),\n          title_match.group(1))\n\n\n# --- 5. 400px CDP screenshot: first card's top < 800px, no overflow -------\n\nprint(\"=== 400px screenshot (cleanup via _edge_cleanup.kill_edge_profile) ===\")\nEDGE_CANDIDATES = [\n    r\"C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe\",\n    r\"C:\\Program Files\\Microsoft\\Edge\\Application\\msedge.exe\",\n]\n\n\ndef find_edge() -> str:\n    for candidate in EDGE_CANDIDATES:\n        if Path(candidate).exists():\n            return candidate\n    return \"\"\n\n\ndef free_port() -> int:\n    s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)\n    s.bind((\"127.0.0.1\", 0))\n    port = s.getsockname()[1]\n    s.close()\n    return port\n\n\nclass CDP:\n    def __init__(self, ws_url: str) -> None:\n        from websockets.sync.client import connect\n        self.ws = connect(ws_url, max_size=None, open_timeout=20)\n        self._ids = itertools.count(1)\n\n    def send(self, method: str, params: dict | None = None, timeout: float = 20):\n        msg_id = next(self._ids)\n        self.ws.send(json.dumps({\"id\": msg_id, \"method\": method, \"params\": params or {}}))\n        deadline = time.time() + timeout\n        while time.time() < deadline:\n            raw = self.ws.recv(timeout=max(0.1, deadline - time.time()))\n            msg = json.loads(raw)\n            if msg.get(\"id\") == msg_id:\n                if \"error\" in msg:\n                    raise RuntimeError(f\"CDP {method} failed: {msg['error']}\")\n                return msg.get(\"result\", {})\n        raise TimeoutError(f\"CDP {method} timed out waiting for response\")\n\n    def close(self) -> None:\n        try:\n            self.ws.close()\n        except Exception:\n            pass\n\n\ndef wait_for_devtools(port: int, timeout: float = 20) -> None:\n    deadline = time.time() + timeout\n    last_err: Exception | None = None\n    while time.time() < deadline:\n        try:\n            with urllib.request.urlopen(f\"http://127.0.0.1:{port}/json/version\", timeout=2) as r:\n                json.loads(r.read().decode(\"utf-8\"))\n                return\n        except Exception as exc:  # noqa: BLE001\n            last_err = exc\n            time.sleep(0.2)\n    raise RuntimeError(f\"headless Edge devtools endpoint never came up: {last_err}\")\n\n\ndef open_target(port: int, url: str) -> dict:\n    req = urllib.request.Request(f\"http://127.0.0.1:{port}/json/new?{url}\", method=\"PUT\")\n    with urllib.request.urlopen(req, timeout=10) as r:\n        return json.loads(r.read().decode(\"utf-8\"))\n\n\ndef wait_for_port(port: int, timeout: float = 15.0) -> bool:\n    deadline = time.monotonic() + timeout\n    while time.monotonic() < deadline:\n        try:\n            with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:\n                s.settimeout(0.3)\n                s.connect((\"127.0.0.1\", port))\n                return True\n        except OSError:\n            time.sleep(0.2)\n    return False\n\n\ndef wait_for_navigation(cdp: \"CDP\", url: str, timeout: float = 15.0) -> bool:\n    \"\"\"Poll until the tab has actually navigated to ``url`` (not still\n    ``about:blank``) and ``document.readyState`` is \"complete\". A fixed\n    short sleep after ``/json/new?<url>`` is NOT enough in this environment\n    -- a cold headless-Edge tab observably takes several seconds (not the\n    ~1.5s this check used to assume) before ``location.href`` moves off\n    ``about:blank``, independent of how fast the server itself answers\n    (confirmed separately: the server's own response lands in well under a\n    second). Polling, not a longer fixed guess, is what actually restores\n    the strict downstream geometry checks reliably.\"\"\"\n    deadline = time.time() + timeout\n    while time.time() < deadline:\n        val = cdp.send(\"Runtime.evaluate\", {\n            \"expression\": (\"JSON.stringify({href: location.href, \"\n                           \"ready: document.readyState})\"),\n            \"returnByValue\": True,\n        })\n        try:\n            state = json.loads(val.get(\"result\", {}).get(\"value\") or \"{}\")\n        except ValueError:\n            state = {}\n        if state.get(\"href\", \"about:blank\") != \"about:blank\" and state.get(\"ready\") == \"complete\":\n            return True\n        time.sleep(0.3)\n    return False\n\n\nedge = find_edge()\nserver_dir = tempfile.mkdtemp(prefix=\"cuore-check-bench-server-\")\nport = free_port()\nenv = dict(os.environ)\nenv[\"CUORE_STATE_DIR\"] = server_dir\n\n_SERVER_SNIPPET = f\"\"\"\nimport sys\nsys.path.insert(0, {str(ROOT)!r})\nfrom cuore.app import create_app\nimport uvicorn\n\napp = create_app()\nuvicorn.run(app, host=\"127.0.0.1\", port={port}, log_level=\"warning\")\n\"\"\"\n\nif not edge:\n    check(\"headless Edge is available for the screenshot check\", False, str(EDGE_CANDIDATES))\nelse:\n    server_proc = subprocess.Popen(\n        [sys.executable, \"-c\", _SERVER_SNIPPET],\n        cwd=str(ROOT), env=env,\n        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,\n    )\n    try:\n        up = wait_for_port(port)\n        check(\"uvicorn came up on the free port\", up, f\"port {port}\")\n        if up:\n            # Warm the bench's own caches (mes_bridge.workup + dossier_bridge's\n            # memoised core) in this freshly spawned, cold process BEFORE\n            # Edge ever navigates -- building the Stelvio's 17-log workup and\n            # resolving parts/tools for 3 next actions easily outruns the\n            # 1.7s this check waits before reading document.readyState below,\n            # which otherwise reads the pre-navigation about:blank document\n            # (readyState \"complete\" trivially, body empty) rather than the\n            # real page. check_screens.py hits the same thing and warms the\n            # same way (its own seed POST, then a sleep) before measuring.\n            try:\n                urllib.request.urlopen(f\"http://127.0.0.1:{port}/v/{VIN}\", timeout=25)\n            except Exception as exc:  # noqa: BLE001\n                check(\"warming the bench page on the screenshot server\", False, str(exc))\n            time.sleep(0.5)\n            devtools_port = free_port()\n            profile_dir = Path(tempfile.mkdtemp(prefix=\"cuore-edge-bench-\"))\n            edge_proc = subprocess.Popen(\n                [edge, \"--headless=new\", f\"--remote-debugging-port={devtools_port}\",\n                 f\"--user-data-dir={profile_dir}\", \"--no-first-run\", \"--window-size=400,800\",\n                 \"about:blank\"],\n                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,\n            )\n            try:\n                wait_for_devtools(devtools_port)\n                url = f\"http://127.0.0.1:{port}/v/{VIN}\"\n                target = open_target(devtools_port, url)\n                cdp = CDP(target[\"webSocketDebuggerUrl\"])\n                try:\n                    cdp.send(\"Page.enable\")\n                    cdp.send(\"Runtime.enable\")\n                    navigated = wait_for_navigation(cdp, url)\n                    cdp.send(\"Emulation.setDeviceMetricsOverride\", {\n                        \"width\": 400, \"height\": 800, \"deviceScaleFactor\": 1, \"mobile\": True,\n                    })\n                    time.sleep(0.5)\n\n                    nav = cdp.send(\"Runtime.evaluate\", {\n                        \"expression\": \"document.readyState\", \"returnByValue\": True})\n                    check(\"bench page loaded in the headless browser\",\n                          navigated and nav.get(\"result\", {}).get(\"value\") in (\"complete\", \"interactive\"),\n                          str(nav))\n\n                    overflow = cdp.send(\"Runtime.evaluate\", {\n                        \"expression\": (\n                            \"JSON.stringify({sw: document.documentElement.scrollWidth, \"\n                            \"cw: document.documentElement.clientWidth})\"),\n                        \"returnByValue\": True,\n                    })\n                    dims = json.loads(overflow.get(\"result\", {}).get(\"value\", \"{}\"))\n                    sw, cw = dims.get(\"sw\", 0), dims.get(\"cw\", 0)\n                    check(\"no page-level horizontal overflow at 400px\",\n                         sw <= cw + 1, f\"scrollWidth={sw} clientWidth={cw}\")\n\n                    rect = cdp.send(\"Runtime.evaluate\", {\n                        \"expression\": (\n                            \"(() => { const el = document.querySelector('.bench-card'); \"\n                            \"if (!el) return JSON.stringify(null); \"\n                            \"const r = el.getBoundingClientRect(); \"\n                            \"return JSON.stringify({top: r.top, left: r.left, right: r.right}); \"\n                            \"})()\"),\n                        \"returnByValue\": True,\n                    })\n                    card_rect = json.loads(rect.get(\"result\", {}).get(\"value\", \"null\"))\n                    check(\"the first next-action card is present on the page\",\n                          card_rect is not None, str(card_rect))\n                    if card_rect is not None:\n                        # Strict stopwatch check (matches check_stopwatch.py): the\n                        # Bench's shared {% include \"_vbar.html\" %} hero now renders\n                        # a COMPACT hero for tab == \"bench\" (image band capped at\n                        # 18vh, no tagline, no key-figures row -- see _vbar.html and\n                        # cuore.css's \"Bench compact hero\" section) specifically so\n                        # the resume card and first next-action card land back\n                        # on-screen at 400x800 with no scrolling. The full,\n                        # taller hero (image/tagline/key-figures) is report-only.\n                        check(\"the first next-action card's top is within the \"\n                             \"first 800px viewport (no scrolling at 400x800)\",\n                             card_rect[\"top\"] < 800, str(card_rect))\n                        check(\"the first next-action card does not overflow horizontally\",\n                             card_rect[\"right\"] <= 400 + 1, str(card_rect))\n\n                    resume_rect = cdp.send(\"Runtime.evaluate\", {\n                        \"expression\": (\n                            \"(() => { const el = document.querySelector('.bench-resume'); \"\n                            \"if (!el) return JSON.stringify(null); \"\n                            \"const r = el.getBoundingClientRect(); \"\n                            \"return JSON.stringify({top: r.top}); })()\"),\n                        \"returnByValue\": True,\n                    })\n                    resume_box = json.loads(resume_rect.get(\"result\", {}).get(\"value\", \"null\"))\n                    check(\"the resume card is present on the page\", resume_box is not None,\n                         str(resume_box))\n                    if resume_box is not None:\n                        # The actual P1 fix (BENCH_UX_SPEC A1): the resume card\n                        # itself -- not the task list -- is what should be reached\n                        # with minimal scrolling, right under the hero + tab strip.\n                        check(\"the resume card sits right under the hero/tab strip, \"\n                             \"not buried under the task list\",\n                             resume_box[\"top\"] < 1300, str(resume_box))\n\n                    shot = cdp.send(\"Page.captureScreenshot\", {\"format\": \"png\"})\n                    data_b64 = shot.get(\"data\", \"\")\n                    check(\"a 400px screenshot of the bench was captured\",\n                         bool(data_b64), f\"{len(data_b64)} bytes of base64\")\n                finally:\n                    cdp.close()\n            except Exception as exc:  # noqa: BLE001\n                check(\"headless Edge measured the bench page over CDP\", False,\n                     f\"{type(exc).__name__}: {exc}\")\n            finally:\n                edge_proc.terminate()\n                try:\n                    edge_proc.wait(timeout=5)\n                except Exception:\n                    edge_proc.kill()\n                from _edge_cleanup import kill_edge_profile\n                kill_edge_profile(profile_dir)\n    finally:\n        server_proc.terminate()\n        try:\n            server_proc.wait(timeout=5)\n        except Exception:\n            server_proc.kill()\n\n\n# --- report ------------------------------------------------------------------\n\nprint()\nif failures:\n    print(f\"{len(failures)}/{checks} check(s) failed:\")\n    for f in failures:\n        print(f\"  - {f}\")\n    sys.exit(1)\nprint(f\"all {checks} checks passed\")\n","numLines":503,"startLine":1,"totalLines":503}},"sourceToolAssistantUUID":"cc4009cd-899b-48aa-a1ed-e799105e6ae3","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
