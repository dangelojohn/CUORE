rical_path_for`` is a Jinja global registered by\r","-   cuore/web/electrical_routes.py as a side effect of importing it (same\r","-   pattern as timeline_routes's ``code_feel`` / media_routes's\r","-   ``media_strip``) -- guarded here so every page that includes this\r","-   partial still renders before app.py wires that router in. #}\r","-{% set elec = electrical_path_for(vin, code) if electrical_path_for is defined and code else None %}\r","-{% if elec %}\r","-<link rel=\"stylesheet\" href=\"{{ static_url('electrical.css') }}\">\r","-<div class=\"panel elec-path-card\">\r","-  <h3>Electrical path for {{ elec.code }}</h3>\r","-  {% if elec.found %}\r","-    <div class=\"elec-stepper\">\r","-      {% for hop in elec.path %}\r","-        <div class=\"elec-hop\">\r","-          <div class=\"elec-hop-role\">{{ hop.role }}</div>\r","-          <div class=\"elec-hop-label\">{{ hop.label }}</div>\r","-          <div class=\"small muted\">{{ (hop.location or {}).description }}</div>\r","-          <div class=\"elec-hop-chips\">\r","-            <span class=\"chip plain sm\">{{ (hop.location or {}).confidence or hop.confidence }} confidence</span>\r","-            {% if hop.condition %}\r","-              <span class=\"chip {{ 'ok' if hop.condition == 'ok' else ('status-active' if hop.condition == 'not_found' else 'status-cleared_unverified') }} sm\">{{ hop.condition|replace(\"_\", \" \") }}</span>\r","-            {% else %}\r","-              <span class=\"chip plain sm\">never inspected</span>\r","-            {% endif %}\r","-          </div>\r","-        </div>\r","-        {% if not loop.last %}<div class=\"elec-hop-arrow\" aria-hidden=\"true\">&rarr;</div>{% endif %}\r","-      {% endfor %}\r","-    </div>\r","-\r","-    {% if elec.systems_interaction %}\r","-      <h4 class=\"small\">How each system interacts with this</h4>\r","-      <ul class=\"small\">\r","-        {% for s in elec.systems_interaction %}\r","-          <li><b>{{ s.system }}</b>: {{ s.how }}\r","-            <span class=\"muted\">[{{ s.confidence }} confidence, source: {{ s.source }}]</span></li>\r","-        {% endfor %}\r","-      </ul>\r","-    {% endif %}\r","-  {% else %}\r","-    <p class=\"muted small\">No electrical path known yet for {{ elec.code }}.</p>\r","-  {% endif %}\r","-  <p><a class=\"btn\" href=\"{{ elec.layout_href }}\">Open in layout &rarr;</a></p>\r","-</div>\r","-{% endif %}\r","+{# One code's electrical path as a horizontal stepper: fuse -> connector ->","+   component -> ground (or whatever role sequence the bridge returns), each","+   hop with its location, confidence chip and latest inspection condition,","+   plus \"how each system interacts with this problem\" and a link back into","+   the full layout diagram, pre-filtered to this code.","+","+   Included by code.html and report.html. Context expected: vin, code.","+   ``electrical_path_for`` is a Jinja global registered by","+   cuore/web/electrical_routes.py as a side effect of importing it (same","+   pattern as timeline_routes's ``code_feel`` / media_routes's","+   ``media_strip``) -- guarded here so every page that includes this","+   partial still renders before app.py wires that router in. #}","+{% set elec = electrical_path_for(vin, code) if electrical_path_for is defined and code else None %}","+{% if elec %}","+<link rel=\"stylesheet\" href=\"{{ static_url('electrical.css') }}\">","+<div class=\"panel elec-path-card\">","+  <h3>Electrical path for {{ elec.code }}</h3>","+  {% if elec.found %}","+    <div class=\"elec-stepper\">","+      {% for hop in elec.path %}","+        <div class=\"elec-hop\">","+          <div class=\"elec-hop-role\">{{ hop.role }}</div>","+          <div class=\"elec-hop-label\">{{ hop.label }}</div>","+          <div class=\"small muted\">{{ (hop.location or {}).description }}</div>","+          <div class=\"elec-hop-chips\">","+            <span class=\"chip plain sm\">{{ (hop.location or {}).confidence or hop.confidence }} confidence</span>","+            {% if hop.condition %}","+              <span class=\"chip {{ 'ok' if hop.condition == 'ok' else ('status-active' if hop.condition == 'not_found' else 'status-cleared_unverified') }} sm\">{{ hop.condition|replace(\"_\", \" \") }}</span>","+            {% else %}","+              <span class=\"chip plain sm\">never inspected</span>","+            {% endif %}","+          </div>","+        </div>","+        {% if not loop.last %}<div class=\"elec-hop-arrow\" aria-hidden=\"true\">&rarr;</div>{% endif %}","+      {% endfor %}","+    </div>","+","+    {% if elec.systems_interaction %}","+      <h4>How each system interacts with this</h4>","+      <ul class=\"small\">","+        {% for s in elec.systems_interaction %}","+          <li><b>{{ s.system }}</b>: {{ s.how }}","+            <span class=\"muted\">[{{ s.confidence }} confidence, source: {{ s.source }}]</span></li>","+        {% endfor %}","+      </ul>","+    {% endif %}","+  {% else %}","+    <p class=\"muted small\">No electrical path known yet for {{ elec.code }}.</p>","+  {% endif %}","+  <p><a class=\"btn\" href=\"{{ elec.layout_href }}\">Open in layout &rarr;</a></p>","+</div>","+{% endif %}"]}]}],"moreFiles":0,"changedFiles":["C:\\Users\\User\\mcp-servers\\cuore\\web\\templates\\_electrical_path.html"],"shared":true}},"serverClassifierContext":{"request":"f1ab7407-a162-4fa7-8725-2d745efbed05","context":{"git_state":{"cwd":"/c/Users/User/mcp-servers","root":null,"branch":null,"default_branch":null,"status":null,"visibility":null,"error":"pending"},"live_cwd":"/c/Users/User/mcp-servers","platform":"windows"}},"sourceToolAssistantUUID":"dd001f6e-fef2-4204-889f-460a436b7ee3","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
