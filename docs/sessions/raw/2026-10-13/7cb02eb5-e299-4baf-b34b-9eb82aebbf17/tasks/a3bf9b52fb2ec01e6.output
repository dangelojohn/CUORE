2.0t\",\n   331\t        \"date\": None,\n   332\t        \"reputation\": \"medium\",\n   333\t        \"verified_at\": VERIFIED_AT,\n   334\t        \"verified_how\": \"youtube_oembed\",\n   335\t    },\n   336\t    {\n   337\t        \"id\": \"yt-12v-battery-giulia\",\n   338\t        \"keys\": [\"battery_12v\"],\n   339\t        \"title\": \"🍀 Alfa Romeo Giulia Battery Replacement 🍀\",\n   340\t        \"url\": \"https://www.youtube.com/watch?v=RvVCRASmRc8\",\n   341\t        \"source\": \"youtube\",\n   342\t        \"kind\": \"how_to_video\",\n   343\t        \"covers\": \"12V battery swap on a Giulia, same procedure/location as the Stelvio.\",\n   344\t        \"vehicle_fit\": \"giulia_2.0t\",\n   345\t        \"date\": None,\n   346\t        \"reputation\": \"medium\",\n   347\t        \"verified_at\": VERIFIED_AT,\n   348\t        \"verified_how\": \"youtube_oembed\",\n   349\t    },\n   350\t\n   351\t    # --- tpms ----------------------------------------------------------------\n   352\t    {\n   353\t        \"id\": \"yt-tpms-reset-giulia\",\n   354\t        \"keys\": [\"tpms\"],\n   355\t        \"title\": \"How to Reset Tire Pressure on an Alfa Romeo Giulia\",\n   356\t        \"url\": \"https://www.youtube.com/shorts/aZozbSTK_ec\",\n   357\t        \"source\": \"youtube\",\n   358\t        \"kind\": \"how_to_video\",\n   359\t        \"covers\": \"In-cluster/infotainment menu walk to reset the TPMS pressure warning \"\n   360\t                  \"on a Giulia; same menu path as the Stelvio.\",\n   361\t        \"vehicle_fit\": \"giulia_2.0t\",\n   362\t        \"date\": None,\n   363\t        \"reputation\": \"medium\",\n   364\t        \"verified_at\": VERIFIED_AT,\n   365\t        \"verified_how\": \"youtube_oembed\",\n   366\t    },\n   367\t\n   368\t    # --- zf8hp_fluid -----------------------------------------------------\n   369\t    {\n   370\t        \"id\": \"yt-zf8hp-transmission-service\",\n   371\t        \"keys\": [\"zf8hp_fluid\"],\n   372\t        \"title\": \"Alfa Romeo Gulia/Stelvio transmission service\",\n   373\t        \"url\": \"https://www.youtube.com/watch?v=PcCrAYIjLTU\",\n   374\t        \"source\": \"youtube\",\n   375\t        \"kind\": \"how_to_video\",\n   376\t        \"covers\": \"ZF 8HP fluid/filter service on the shared Giulia/Stelvio AWD drivetrain.\",\n   377\t        \"vehicle_fit\": \"giorgio\",\n   378\t        \"date\": None,\n   379\t        \"reputation\": \"medium\",\n   380\t        \"verified_at\": VERIFIED_AT,\n   381\t        \"verified_how\": \"youtube_oembed\",\n   382\t    },\n   383\t)\n   384\t\n   385\t\n   386\tdef _norm(key: str) -> str:\n   387\t    return (key or \"\").strip()\n   388\t\n   389\t\n   390\tdef for_code(code: str) -> list[dict[str, Any]]:\n   391\t    \"\"\"All entries tagged with this exact DTC (e.g. ``\"P0455\"``).\"\"\"\n   392\t    key = _norm(code).upper()\n   393\t    return [e for e in LINKS if key in e[\"keys\"]]\n   394\t\n   395\t\n   396\tdef for_family(family: str) -> list[dict[str, Any]]:\n   397\t    \"\"\"All entries tagged with this fault family (e.g. ``\"EVAP\"``).\"\"\"\n   398\t    key = _norm(family)\n   399\t    return [e for e in LINKS if key in e[\"keys\"]]\n   400\t\n   401\t\n   402\tdef for_job(job: str) -> list[dict[str, Any]]:\n   403\t    \"\"\"All entries tagged with this service job (e.g. ``\"oil_change\"``).\"\"\"\n   404\t    key = _norm(job)\n   405\t    return [e for e in LINKS if key in e[\"keys\"]]\n   406\t\n   407\t\n   408\tdef all() -> list[dict[str, Any]]:\n   409\t    \"\"\"Every tabulated entry, unfiltered.\"\"\"\n   410\t    return list(LINKS)","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"serverClassifierContext":{"request":"afe7373a-de45-485e-8bca-6886794d66c7","context":{"git_state":{"cwd":"/c/Users/User/mcp-servers","root":null,"branch":null,"default_branch":null,"status":null,"visibility":null,"error":"pending"},"live_cwd":"/c/Users/User/mcp-servers","platform":"