\n   178\t        \"reputation\": \"medium\",\n   179\t        \"verified_at\": VERIFIED_AT,\n   180\t        \"verified_how\": \"youtube_oembed\",\n   181\t    },\n   182\t    {\n   183\t        \"id\": \"yt-spark-plug-2018-stelvio\",\n   184\t        \"keys\": [\"spark_plugs\"],\n   185\t        \"title\": \"How to Change Spark Plugs on a 2018 Alfa Romeo Stelvio\",\n   186\t        \"url\": \"https://www.youtube.com/watch?v=ACzj-N1VvDk\",\n   187\t        \"source\": \"youtube\",\n   188\t        \"kind\": \"how_to_video\",\n   189\t        \"covers\": \"Spark plug change on a 2018 Stelvio -- same model year as this car.\",\n   190\t        \"vehicle_fit\": \"stelvio_2.0t\",\n   191\t        \"date\": None,\n   192\t        \"reputation\": \"medium\",\n   193\t        \"verified_at\": VERIFIED_AT,\n   194\t        \"verified_how\": \"youtube_oembed\",\n   195\t    },\n   196\t\n   197\t    # --- cabin_air_filter -----------------------------------------------\n   198\t    {\n   199\t        \"id\": \"yt-cabin-filter-30min\",\n   200\t        \"keys\": [\"cabin_air_filter\"],\n   201\t        \"title\": \"Alfa Romeo Stelvio HVAC Cabin Filter Replacement | 30 Minutes of Fun\",\n   202\t        \"url\": \"https://www.youtube.com/watch?v=QmrlOwPSvYQ\",\n   203\t        \"source\": \"youtube\",\n   204\t        \"kind\": \"how_to_video\",\n   205\t        \"covers\": \"Full teardown of the awkward Stelvio cabin filter box behind the \"\n   206\t                  \"passenger footwell panel.\",\n   207\t        \"vehicle_fit\": \"stelvio_2.0t\",\n   208\t        \"date\": None,\n   209\t        \"reputation\": \"medium\",\n   210\t        \"verified_at\": VERIFIED_AT,\n   211\t        \"verified_how\": \"youtube_oembed\",\n   212\t    },\n   213\t    {\n   214\t        \"id\": \"yt-cabin-filter-alfatech\",\n   215\t        \"keys\": [\"cabin_air_filter\"],\n   216\t        \"title\": \"Alfa Romeo Stelvio cabin air filter replacement\",\n   217\t        \"url\": \"https:/