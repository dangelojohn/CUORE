{"parentUuid":"d7be14bc-5d32-440d-bace-eb1ea8563661","isSidechain":true,"agentId":"aa1325351951d62ee","message":{"model":"claude-sonnet-5","id":"msg_011CfoztPafVNP2sdJ8Wf3C9","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01EQX3u84FcTBqZCL6xfPiHQ","name":"Read","input":{"file_path":"C:\\Users\\User\\mcp-servers\\cuore\\web\\timeline_svg.py"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":5692,"cache_read_input_tokens":57205,"cache_creation":{"ephemeral_5m_input_tokens":5692,"ephemeral_1h_input_tokens":0},"output_tokens":2,"service_tier":"standard","inference_geo":"not_available"},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_01EQX3u84FcTBqZCL6xfPiHQ":{"file_path":"C:\\Users\\User\\mcp-servers\\cuore\\web\\timeline_svg.py"}},"serverClassifierRequest":"0b8ef2c8-be20-4314-8b45-92c5c2b29bde","apiBlockIndex":1,"requestId":"req_011CfoztPLXKVq3E86KZpSeM","attributionAgent":"general-purpose","type":"assistant","uuid":"03767f0d-0297-4d07-a75b-f7e841e63281","timestamp":"2026-10-08T02:41:55.223Z","effort":"high","perTurnEffort":null,"userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
{"parentUuid":"03767f0d-0297-4d07-a75b-f7e841e63281","isSidechain":true,"promptId":"bbc43356-430e-40a9-a14e-41404b640377","agentId":"aa1325351951d62ee","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01EQX3u84FcTBqZCL6xfPiHQ","type":"tool_result","content":"1\t\"\"\"Server-side inline SVG for the codes-vs-symptoms swimlane timeline.\n2\t\n3\tSame posture as :mod:`cuore.web.dashboard_charts` (its docstring explains\n4\twhy): no JS, no CDN, no charting library. Colour comes from the CSS custom\n5\tproperties in ``cuore.css`` -- the ``--sev-*``/``--ok``/``--ink*`` ramp plus\n6\tthe ``--fam-*`` per-family palette appended there for this page -- so the\n7\tchart reads correctly in both themes without this module knowing which is\n8\tactive.\n9\t\n10\tVisual grammar (shown in full in the legend, so nothing here is colour-only):\n11\t\n12\t* Each code-family lane (mil/evap/network/body/chassis/engine_other) is drawn\n13\t  in that family's own colour. *State* is carried by line **style**, not\n14\t  colour, on top of that: solid = present/active, dashed = cleared but the\n15\t  gap since has not been verified clean, dotted = stale (never re-seen,\n16\t  no clear on record), thick = returned -- the sighting right after a\n17\t  dashed gap. This is derived per-lane by grouping that lane's flat event\n18\t  list by ``label`` (the only code-identity signal the contract gives a\n19\t  lane) and walking it in time order; see ``_bar_segments``.\n20\t* Markers: circle = a session's read of that code (filled = present, hollow\n21\t  = read clean); triangle = a clear, drawn with the vertical dash-dot line\n22\t  that already crosses every lane; diamond = a repair/part/actuator test\n23\t  (filled green = completed, hollow amber = failed, by keyword match on the\n24\t  event's own text -- the contract carries no separate completed/failed\n25\t  field); square = a mechanic note; a filled star = a drivability symptom,\n26\t  an amber star = a smell/refuel/warning-light symptom, a hollow green\n27\t  circle = \"drives normally\". Severity is still the colour-outline fallback\n28\t  (red active/amber warn/green ok/grey stale) for anything that does not\n29\t  fit one of the shapes above.\n30\t* The ``conditions`` lane is its own mini line graph rather than markers:\n31\t  fuel % as a polyline on the left scale with the 15-85% EVAP window shaded\n32\t  and out-of-window points highlighted amber, engine temperature as a\n33\t  dashed polyline on a right-hand scale. Both are read out of each event's\n34\t  free-text ``label``/``detail`` by regex -- the contract gives conditions\n35\t  no structured numeric fields.\n36\t* A thin secondary axis runs along the top: interpolated odometer when\n37\t  ``axis=\"time\"``, interpolated dates when ``axis=\"odometer\"`` (both linear\n38\t  across ``tl[\"range\"]``). Light dotted month gridlines and a solid \"today\"\n39\t  line are drawn on the time axis only -- projecting \"today\" onto an\n40\t  odometer axis would be extrapolation past the data, not a reading of it.\n41\t\n42\tEvery text node is escaped. An empty or malformed timeline still renders a\n43\tsmall, well-formed \"no data\" SVG rather than an empty or broken one.\n44\t\"\"\"\n45\t\n46\tfrom __future__ import annotations\n47\t\n48\timport re\n49\tfrom datetime import datetime, timedelta\n50\tfrom typing import Any, Optional\n51\tfrom xml.sax.saxutils import escape as _esc\n52\t\n53\t_SVG_NS = 'xmlns=\"http://www.w3.org/2000/svg\"'\n54\t\n55\t# --- shared row geometry -----------------------------------------------\n56\t# ``lane_layout()`` hands the page the same numbers so the sticky HTML label\n57\t# column (outside the horizontally-scrolling SVG) lines up with each row.\n58\tROW_H = 26\n59\tCONDITIONS_ROW_H = 64\n60\tSEC_AXIS_Y = 12\n61\tTOP_PAD = 96       # secondary axis + the (now large) legend, wrapped to ~3 rows\n62\tAXIS_H = 28\n63\tMARGIN_L = 50      # room for the conditions lane's left (fuel %) scale\n64\tMARGIN_R = 46      # room for the conditions lane's right (temp) scale\n65\tDAY_PX = 22        # minimum px per day on the time axis before it scrolls\n66\t\n67\t_FAMILY_COLOR: dict[str, str] = {\n68\t    \"mil\":          \"var(--fam-mil)\",\n69\t    \"evap\":         \"var(--fam-evap)\",\n70\t    \"network\":      \"var(--fam-network)\",\n71\t    \"body\":         \"var(--fam-body)\",\n72\t    \"chassis\":      \"var(--fam-chassis)\",\n73\t    \"engine_other\": \"var(--fam-engine)\",\n74\t}\n75\t\n76\t#: fallback severity -> (shape, colour, legend label), used for any point\n77\t#: event that is not one of the special-cased shapes below.\n78\t_SEVERITY_STYLE: dict[str, tuple[str, str, str]] = {\n79\t    \"active\":     (\"circle\",  \"var(--sev-returned)\", \"active\"),\n80\t    \"cleared\":    (\"square\",  \"var(--ink-3)\",         \"cleared\"),\n81\t    \"info\":       (\"circle\",  \"var(--ink-3)\",         \"note\"),\n82\t    \"symptom\":    (\"star\",    \"var(--sev-returned)\",  \"symptom reported\"),\n83\t    \"no_symptom\": (\"ring\",    \"var(--ok)\",             \"drives normally\"),\n84\t    \"work\":       (\"diamond\", \"var(--sev-cleared)\",    \"work done\"),\n85\t    \"warn\":       (\"diamond\", \"var(--sev-chronic)\",    \"condition (warn)\"),\n86\t}\n87\t_DEFAULT_STYLE = (\"ring\", \"var(--ink-3)\", \"unknown\")\n88\t\n89\t_FUEL_RE = re.compile(r\"fuel[^0-9]{0,12}(\\d{1,3}(?:\\.\\d+)?)\\s*%\", re.IGNORECASE)\n90\t_TEMP_RE = re.compile(r\"(-?\\d{1,3}(?:\\.\\d+)?)\\s*(?:deg(?:ree)?s?)?\\s*°?\\s*c\\b\", re.IGNORECASE)\n91\t\n92\t_DRIVABILITY_WORDS = (\"hard_start\", \"hard start\", \"rough_idle\", \"rough idle\",\n93\t                      \"hesitation\", \"loss_of_power\", \"loss of power\", \"noise\",\n94\t                      \"vibration\")\n95\t_WARNING_WORDS = (\"fuel_smell\", \"fuel smell\", \"hard_to_refuel\", \"hard to refuel\",\n96\t                  \"warning_message\", \"warning message\", \"mil_on\", \"mil on\")\n97\t\n98\t# --- small helpers ---------------------------------------------------------\n99\t\n100\t\n101\tdef _parse_dt(ts: Any) -> Optional[datetime]:\n102\t    if not ts:\n103\t        return None\n104\t    s = str(ts).strip().replace(\" \", \"T\")[:19]\n105\t    try:\n106\t        return datetime.fromisoformat(s)\n107\t    except ValueError:\n108\t        return None\n109\t\n110\t\n111\tdef _to_float(v: Any) -> Optional[float]:\n112\t    return float(v) if isinstance(v, (int, float)) else None\n113\t\n114\t\n115\tdef _now() -> datetime:\n116\t    return datetime.now()\n117\t\n118\t\n119\tdef _no_data_svg(message: str = \"No timeline data for this vehicle yet.\") -> str:\n120\t    w, h = 600, 90\n121\t    return (\n122\t        f'<svg {_SVG_NS} viewBox=\"0 0 {w} {h}\" width=\"100%\" '\n123\t        f'role=\"img\" aria-label=\"Timeline: {_esc(message)}\">'\n124\t        f'<title>Timeline</title>'\n125\t        f'<text x=\"{w/2}\" y=\"{h/2}\" text-anchor=\"middle\" dominant-baseline=\"middle\" '\n126\t        f'fill=\"var(--ink-3)\" font-size=\"13\" font-family=\"var(--sans), sans-serif\">'\n127\t        f'{_esc(message)}</text></svg>'\n128\t    )\n129\t\n130\t\n131\tdef _marker(x: float, y: float, shape: str, color: str, r: float = 5.2,\n132\t           filled: bool = True) -> str:\n133\t    if shape == \"circle\":\n134\t        if filled:\n135\t            return f'<circle cx=\"{x:.1f}\" cy=\"{y:.1f}\" r=\"{r:.1f}\" fill=\"{color}\"/>'\n136\t        return (f'<circle cx=\"{x:.1f}\" cy=\"{y:.1f}\" r=\"{r:.1f}\" fill=\"none\" '\n137\t                f'stroke=\"{color}\" stroke-width=\"1.8\"/>')\n138\t    if shape == \"square\":\n139\t        s = r * 1.6\n140\t        return (f'<rect x=\"{x - s/2:.1f}\" y=\"{y - s/2:.1f}\" width=\"{s:.1f}\" '\n141\t                f'height=\"{s:.1f}\" fill=\"{color}\"/>')\n142\t    if shape == \"diamond\":\n143\t        s = r * 1.25\n144\t        pts = f\"{x:.1f},{y-s:.1f} {x+s:.1f},{y:.1f} {x:.1f},{y+s:.1f} {x-s:.1f},{y:.1f}\"\n145\t        if filled:\n146\t            return f'<polygon points=\"{pts}\" fill=\"{color}\"/>'\n147\t        return f'<polygon points=\"{pts}\" fill=\"none\" stroke=\"{color}\" stroke-width=\"1.8\"/>'\n148\t    if shape == \"triangle\":\n149\t        s = r * 1.3\n150\t        pts = f\"{x:.1f},{y-s:.1f} {x-s:.1f},{y+s*0.8:.1f} {x+s:.1f},{y+s*0.8:.1f}\"\n151\t        return f'<polygon points=\"{pts}\" fill=\"{color}\"/>'\n152\t    if shape == \"star\":\n153\t        return _star(x, y, r * 1.15, color)\n154\t    # ring: hollow -- \"drives normally\" / unknown fallback\n155\t    return (f'<circle cx=\"{x:.1f}\" cy=\"{y:.1f}\" r=\"{r * 0.85:.1f}\" fill=\"none\" '\n156\t            f'stroke=\"{color}\" stroke-width=\"1.8\"/>')\n157\t\n158\t\n159\tdef _star(cx: float, cy: float, r: float, color: str) -> str:\n160\t    \"\"\"A filled 5-point star -- the drivability/warning symptom mark.\"\"\"\n161\t    import math\n162\t    pts = []\n163\t    for i in range(10):\n164\t        ang = -math.pi / 2 + i * math.pi / 5\n165\t        rad = r if i % 2 == 0 else r * 0.42\n166\t        pts.append(f\"{cx + rad * math.cos(ang):.1f},{cy + rad * math.sin(ang):.1f}\")\n167\t    return f'<polygon points=\"{\" \".join(pts)}\" fill=\"{color}\"/>'\n168\t\n169\t\n170\tdef _wrap(inner: str, href: Optional[str], title: str) -> str:\n171\t    body = f\"{inner}<title>{_esc(title)}</title>\"\n172\t    if href:\n173\t        return f'<a href=\"{_esc(href)}\">{body}</a>'\n174\t    return f\"<g>{body}</g>\"\n175\t\n176\t\n177\tdef _symptom_shape(ev: dict[str, Any]) -> tuple[str, str, str]:\n178\t    \"\"\"Which mark a 'symptoms' lane event gets: hollow green circle for\n179\t    \"drives normally\", filled red star for a drivability complaint, amber\n180\t    star for a smell/refuel/warning-light report. The contract's event dict\n181\t    carries no separate tag field, so this reads the same free text a human\n182\t    filed the symptom with.\"\"\"\n183\t    if ev.get(\"severity\") == \"no_symptom\":\n184\t        return \"ring\", \"var(--ok)\", \"drives normally\"\n185\t    text = f\"{ev.get('label') or ''} {ev.get('detail') or ''}\".lower()\n186\t    if any(w in text for w in _WARNING_WORDS):\n187\t        return \"star\", \"var(--sev-chronic)\", \"symptom (smell/refuel/warning)\"\n188\t    return \"star\", \"var(--sev-returned)\", \"symptom (drivability)\"\n189\t\n190\t\n191\tdef _work_shape(ev: dict[str, Any]) -> tuple[str, str, str, bool]:\n192\t    \"\"\"Diamond for a repair/part/actuator test: filled green = completed,\n193\t    hollow amber = failed -- by keyword match, same reason as above.\"\"\"\n194\t    text = f\"{ev.get('label') or ''} {ev.get('detail') or ''}\".lower()\n195\t    if \"fail\" in text or \"not complete\" in text or \"incomplete\" in text:\n196\t        return \"diamond\", \"var(--sev-chronic)\", \"repair/test (failed)\", False\n197\t    return \"diamond\", \"var(--ok)\", \"repair/test (completed)\", True\n198\t\n199\t\n200\t# --- derived bar-state segments (solid/dashed/dotted/thick) ----------------\n201\t\n202\t_STALE_AFTER = timedelta(days=45)\n203\t\n204\t\n205\tdef _bar_segments(events: list[dict[str, Any]], now_dt: datetime\n206\t                  ) -> list[tuple[datetime, datetime, str, dict[str, Any]]]:\n207\t    \"\"\"One lane's flat event list -> drawable ``(start, end, style, event)``\n208\t    segments. Grouped by ``label`` (the code) because that is the only\n209\t    code-identity signal a lane's events carry; an event with no label is\n210\t    its own singleton group so it still renders on its own.\"\"\"\n211\t    groups: dict[Any, list[dict[str, Any]]] = {}\n212\t    for e in events:\n213\t        groups.setdefault(e.get(\"label\") or id(e), []).append(e)\n214\t\n215\t    segments: list[tuple[datetime, datetime, str, dict[str, Any]]] = []\n216\t    for evs in groups.values():\n217\t        evs = sorted(evs, key=lambda e: _parse_dt(e.get(\"t\")) or now_dt)\n218\t        prev_was_clear = False\n219\t        for i, e in enumerate(evs):\n220\t            t0 = _parse_dt(e.get(\"t\"))\n221\t            if t0 is None:\n222\t                continue\n223\t            t_end = _parse_dt(e.get(\"t_end\"))\n224\t            severity = e.get(\"severity\")\n225\t            if severity == \"cleared\":\n226\t                gap_start = t_end or t0\n227\t                if t_end:\n228\t                    segments.append((t0, t_end, \"solid\", e))\n229\t                nxt = evs[i + 1] if i + 1 < len(evs) else None\n230\t                gap_end = (_parse_dt(nxt.get(\"t\")) if nxt else None) or now_dt\n231\t                if gap_end > gap_start:\n232\t                    segments.append((gap_start, gap_end, \"dashed\", e))\n233\t                prev_was_clear = True\n234\t            elif severity == \"active\":\n235\t                end = t_end or now_dt\n236\t                style = \"thick\" if prev_was_clear else \"solid\"\n237\t                if not t_end and (now_dt - t0) > _STALE_AFTER:\n238\t                    mid = min(t0 + timedelta(days=7), now_dt)\n239\t                    segments.append((t0, mid, style, e))\n240\t                    if now_dt > mid:\n241\t                        segments.append((mid, now_dt, \"dotted\", e))\n242\t                else:\n243\t                    segments.append((t0, end, style, e))\n244\t                prev_was_clear = False\n245\t            else:\n246\t                # Not a presence/clear event (e.g. a plain \"info\" read) --\n247\t                # left to the point-marker fallback in the caller.\n248\t                prev_was_clear = False\n249\t    return segments\n250\t\n251\t\n252\t_STYLE_DASH = {\"solid\": None, \"thick\": None, \"dashed\": \"10,6\", \"dotted\": \"1.8,5\"}\n253\t_STYLE_LABEL = {\"solid\": \"active\", \"thick\": \"returned after clear\",\n254\t               \"dashed\": \"cleared (unverified)\", \"dotted\": \"stale (not seen since)\"}\n255\t\n256\t\n257\t# --- conditions mini line-graph lane ---------------------------------------\n258\t\n259\t\n260\tdef _conditions_series(events: list[dict[str, Any]]) -> tuple[list[tuple[datetime, float]],\n261\t                                                                list[tuple[datetime, float]]]:\n262\t    fuel: list[tuple[datetime, float]] = []\n263\t    temp: list[tuple[datetime, float]] = []\n264\t    for e in events:\n265\t        t = _parse_dt(e.get(\"t\"))\n266\t        if t is None:\n267\t            continue\n268\t        text = f\"{e.get('label') or ''} {e.get('detail') or ''}\"\n269\t        if (m := _FUEL_RE.search(text)):\n270\t            try:\n271\t                fuel.append((t, float(m.group(1))))\n272\t            except ValueError:\n273\t                pass\n274\t        if (m := _TEMP_RE.search(text)):\n275\t            try:\n276\t                temp.append((t, float(m.group(1))))\n277\t            except ValueError:\n278\t                pass\n279\t    fuel.sort(key=lambda p: p[0])\n280\t    temp.sort(key=lambda p: p[0])\n281\t    return fuel, temp\n282\t\n283\t\n284\tdef _render_conditions_row(events: list[dict[str, Any]], y_top: float, row_h: float,\n285\t                          xf, esc=_esc) -> str:\n286\t    \"\"\"The conditions lane: fuel% polyline + 15-85% band on the left scale,\n287\t    engine-temp dashed polyline on a right-hand scale. Falls back to plain\n288\t    markers (via the caller) when neither series has any points.\"\"\"\n289\t    fuel, temp = _conditions_series(events)\n290\t    parts: list[str] = []\n291\t    plot_top, plot_bot = y_top + 3, y_top + row_h - 3\n292\t\n293\t    def fy(pct: float) -> float:\n294\t        pct = max(0.0, min(100.0, pct))\n295\t        return plot_bot - pct / 100.0 * (plot_bot - plot_top)\n296\t\n297\t    if fuel:\n298\t        band_top, band_bot = fy(85), fy(15)\n299\t        parts.append(f'<rect x=\"{xf.margin_l:.1f}\" y=\"{band_top:.1f}\" '\n300\t                     f'width=\"{xf.plot_w:.1f}\" height=\"{band_bot - band_top:.1f}\" '\n301\t                     f'fill=\"var(--ok-bg)\" opacity=\"0.55\"><title>EVAP monitor window: '\n302\t                     f'fuel 15-85%</title></rect>')\n303\t        pts = [(xf(t), fy(v)) for t, v in fuel]\n304\t        pts = [(x, y) for x, y in pts if x is not None]\n305\t        if pts:\n306\t            d = \" \".join(f'{\"M\" if i == 0 else \"L\"}{x:.1f},{y:.1f}' for i, (x, y) in enumerate(pts))\n307\t            parts.append(f'<path d=\"{d}\" fill=\"none\" stroke=\"var(--fam-evap)\" stroke-width=\"1.6\"/>')\n308\t        for t, v in fuel:\n309\t            x = xf(t)\n310\t            if x is None:\n311\t                continue\n312\t            out_of_band = v < 15 or v > 85\n313\t            color = \"var(--sev-chronic)\" if out_of_band else \"var(--fam-evap)\"\n314\t            parts.append(f'<circle cx=\"{x:.1f}\" cy=\"{fy(v):.1f}\" r=\"{3.2 if out_of_band else 2.4:.1f}\" '\n315\t                         f'fill=\"{color}\"><title>Fuel {v:g}%'\n316\t                         f'{\" -- outside the 15-85% EVAP window\" if out_of_band else \"\"}</title></circle>')\n317\t        parts.append(f'<text x=\"{xf.margin_l - 6:.1f}\" y=\"{plot_top + 8:.1f}\" text-anchor=\"end\" '\n318\t                     f'font-size=\"9.5\" fill=\"var(--fam-evap)\" font-family=\"var(--sans), sans-serif\">Fuel %</text>')\n319\t\n320\t    if temp:\n321\t        tvals = [v for _, v in temp]\n322\t        tlo, thi = min(tvals + [0.0]), max(tvals + [90.0])\n323\t        if thi == tlo:\n324\t            thi = tlo + 1.0\n325\t\n326\t        def ty(v: float) -> float:\n327\t            return plot_bot - (v - tlo) / (thi - tlo) * (plot_bot - plot_top)\n328\t\n329\t        pts = [(xf(t), ty(v)) for t, v in temp]\n330\t        pts = [(x, y) for x, y in pts if x is not None]\n331\t        if pts:\n332\t            d = \" \".join(f'{\"M\" if i == 0 else \"L\"}{x:.1f},{y:.1f}' for i, (x, y) in enumerate(pts))\n333\t            parts.append(f'<path d=\"{d}\" fill=\"none\" stroke=\"var(--fam-chassis)\" '\n334\t                         f'stroke-width=\"1.4\" stroke-dasharray=\"5,3\"/>')\n335\t            for t, v in temp:\n336\t                x = xf(t)\n337\t                if x is None:\n338\t                    continue\n339\t                parts.append(f'<circle cx=\"{x:.1f}\" cy=\"{ty(v):.1f}\" r=\"2.2\" fill=\"var(--fam-chassis)\">'\n340\t                             f'<title>Engine temp {v:g} C</title></circle>')\n341\t        parts.append(f'<text x=\"{xf.margin_l + xf.plot_w + 6:.1f}\" y=\"{plot_top + 8:.1f}\" '\n342\t                     f'font-size=\"9.5\" fill=\"var(--fam-chassis)\" '\n343\t                     f'font-family=\"var(--sans), sans-serif\">Temp C</text>')\n344\t\n345\t    return \"\".join(parts)\n346\t\n347\t\n348\t# --- lane partitioning -------------------------------------------------\n349\t\n350\t\n351\tdef _plot_lanes(tl: dict[str, Any]) -> list[dict[str, Any]]:\n352\t    return [r for r in (tl.get(\"lanes\") or []) if (r.get(\"kind\") or \"bars\") != \"lines\"\n353\t            and r.get(\"id\") != \"clears\"]\n354\t\n355\t\n356\tdef _line_lanes(tl: dict[str, Any]) -> list[dict[str, Any]]:\n357\t    return [r for r in (tl.get(\"lanes\") or []) if (r.get(\"kind\") or \"\") == \"lines\"\n358\t            or r.get(\"id\") == \"clears\"]\n359\t\n360\t\n361\tdef _row_height(lane: dict[str, Any]) -> int:\n362\t    return CONDITIONS_ROW_H if lane.get(\"id\") == \"conditions\" else ROW_H\n363\t\n364\t\n365\tdef lane_layout(tl: dict[str, Any]) -> list[dict[str, Any]]:\n366\t    \"\"\"Row geometry for the sticky HTML label column: one entry per plotted\n367\t    lane, in the same top-offset/height units ``render()`` draws at.\"\"\"\n368\t    rows = _plot_lanes(tl)\n369\t    out, top = [], TOP_PAD\n370\t    for r in rows:\n371\t        h = _row_height(r)\n372\t        out.append({\"id\": r.get(\"id\"), \"label\": r.get(\"label\") or r.get(\"id\") or \"\",\n373\t                     \"top\": top, \"height\": h})\n374\t        top += h\n375\t    return out\n376\t\n377\t\n378\tdef _event_value(ev: dict[str, Any], axis: str) -> Any:\n379\t    return ev.get(\"odo\") if axis == \"odometer\" else ev.get(\"t\")\n380\t\n381\t\n382\t# --- the public entry point -------------------------------------------\n383\t\n384\t\n385\tclass _Scale:\n386\t    \"\"\"A callable time/odometer -> x mapper that also carries the plot's\n387\t    own margin/width, so ``_render_conditions_row`` can draw its band and\n388\t    axis labels without a separate parameter list.\"\"\"\n389\t\n390\t    def __init__(self, xf, margin_l: float, plot_w: float):\n391\t        self._xf = xf\n392\t        self.margin_l = margin_l\n393\t        self.plot_w = plot_w\n394\t\n395\t    def __call__(self, raw: Any) -> Optional[float]:\n396\t        return self._xf(raw)\n397\t\n398\t\n399\tdef render(tl: dict[str, Any], axis: str = \"time\", width: int = 920) -> str:\n400\t    \"\"\"The swimlane plot (no row labels -- see module docstring).\"\"\"\n401\t    axis = axis if axis in (\"time\", \"odometer\") else \"time\"\n402\t    rows = _plot_lanes(tl)\n403\t    line_rows = _line_lanes(tl)\n404\t    if not rows:\n405\t        return _no_data_svg()\n406\t    now_dt = _now()\n407\t    rng = tl.get(\"range\") or {}\n408\t\n409\t    # --- establish the axis range, and a start<->end interpolator for the\n410\t    # secondary (top) axis, which is always the *other* unit. -------------\n411\t    t_lo = _parse_dt(rng.get(\"start\"))\n412\t    t_hi = _parse_dt(rng.get(\"end\"))\n413\t    o_lo = _to_float(rng.get(\"odo_start\"))\n414\t    o_hi = _to_float(rng.get(\"odo_end\"))\n415\t    all_t = [d for d in (t_lo, t_hi) if d is not None]\n416\t    all_o = [v for v in (o_lo, o_hi) if v is not None]\n417\t    for r in rows + line_rows:\n418\t        for e in r.get(\"events\") or []:\n419\t            for raw in (e.get(\"t\"), e.get(\"t_end\")):\n420\t                if (d := _parse_dt(raw)) is not None:\n421\t                    all_t.append(d)\n422\t            if (v := _to_float(e.get(\"odo\"))) is not None:\n423\t                all_o.append(v)\n424\t\n425\t    if axis == \"time\":\n426\t        if not all_t:\n427\t            return _no_data_svg()\n428\t        lo, hi = min(all_t), max(all_t)\n429\t        if hi == lo:\n430\t            hi = lo + timedelta(days=1)\n431\t        span = (hi - lo).total_seconds() or 1.0\n432\t        span_days = max(1.0, span / 86400.0)\n433\t        min_plot_w = span_days * DAY_PX\n434\t\n435\t        def xf(raw: Any) -> Optional[float]:\n436\t            d = raw if isinstance(raw, datetime) else _parse_dt(raw)\n437\t            if d is None:\n438\t                return None\n439\t            return margin_l + (d - lo).total_seconds() / span * plot_w\n440\t\n441\t        axis_vals, axis_text = [lo, lo + (hi - lo) / 2, hi], None\n442\t    else:\n443\t        if not all_o:\n444\t            return _no_data_svg(\"No odometer-tagged events for this vehicle yet.\")\n445\t        lo, hi = min(all_o), max(all_o)\n446\t        if hi == lo:\n447\t            hi = lo + 1.0\n448\t        span = (hi - lo) or 1.0\n449\t        min_plot_w = 0.0\n450\t\n451\t        def xf(raw: Any) -> Optional[float]:\n452\t            v = raw if isinstance(raw, (int, float)) else _to_float(raw)\n453\t            if v is None:\n454\t                return None\n455\t            return margin_l + (v - lo) / span * plot_w\n456\t\n457\t        axis_vals, axis_text = [lo, lo + (hi - lo) / 2, hi], None\n458\t\n459\t    margin_l, margin_r = MARGIN_L, MARGIN_R\n460\t    width = max(int(width), int(min_plot_w + margin_l + margin_r), 400)\n461\t    plot_w = width - margin_l - margin_r\n462\t    layout = lane_layout(tl)\n463\t    plot_top = TOP_PAD\n464\t    plot_bottom = layout[-1][\"top\"] + layout[-1][\"height\"] if layout else TOP_PAD\n465\t    height = plot_bottom + AXIS_H + 10\n466\t    scale = _Scale(xf, margin_l, plot_w)\n467\t\n468\t    def _interp_odo_for_time(x_val: Any) -> Optional[float]:\n469\t        \"\"\"Project a time-axis value onto the odometer secondary axis,\n470\t        linearly across the vehicle's overall range. None when the range\n471\t        does not carry both ends of both units (the odometer-axis case\n472\t        does the inverse projection inline, where it is used).\"\"\"\n473\t        if t_lo is None or t_hi is None or o_lo is None or o_hi is None or t_hi == t_lo:\n474\t            return None\n475\t        d = x_val if isinstance(x_val, datetime) else _parse_dt(x_val)\n476\t        if d is None:\n477\t            return None\n478\t        frac = (d - t_lo).total_seconds() / (t_hi - t_lo).total_seconds()\n479\t        return o_lo + frac * (o_hi - o_lo)\n480\t\n481\t    parts: list[str] = [\n482\t        f'<svg {_SVG_NS} viewBox=\"0 0 {width} {height}\" width=\"{width}\" height=\"{height}\" '\n483\t        f'role=\"img\" aria-label=\"Codes vs. what the driver notices, {len(rows)} lanes\">',\n484\t        f'<title>Codes vs. what the driver notices</title>',\n485\t    ]\n486\t\n487\t    # --- secondary axis along the top --------------------------------\n488\t    if axis == \"time\" and o_lo is not None and o_hi is not None and t_lo and t_hi and t_hi != t_lo:\n489\t        for val, anchor in zip((lo, lo + (hi - lo) / 2, hi), (\"start\", \"middle\", \"end\")):\n490\t            x = xf(val)\n491\t            km = _interp_odo_for_time(val)\n492\t            if x is None or km is None:\n493\t                continue\n494\t            parts.append(f'<text x=\"{x:.1f}\" y=\"{SEC_AXIS_Y:.1f}\" text-anchor=\"{anchor}\" '\n495\t                         f'font-size=\"10\" fill=\"var(--ink-3)\" font-family=\"var(--mono), monospace\">'\n496\t                         f'{km:,.0f} km</text>')\n497\t    elif axis == \"odometer\" and t_lo and t_hi and o_lo is not None and o_hi is not None and o_hi != o_lo:\n498\t        for val, anchor in zip((lo, lo + (hi - lo) / 2, hi), (\"start\", \"middle\", \"end\")):\n499\t            x = xf(val)\n500\t            if x is None:\n501\t                continue\n502\t            frac = (val - o_lo) / (o_hi - o_lo)\n503\t            d = t_lo + (t_hi - t_lo) * frac\n504\t            parts.append(f'<text x=\"{x:.1f}\" y=\"{SEC_AXIS_Y:.1f}\" text-anchor=\"{anchor}\" '\n505\t                         f'font-size=\"10\" fill=\"var(--ink-3)\" font-family=\"var(--sans), sans-serif\">'\n506\t                         f'{_esc(d.date().isoformat())}</text>')\n507\t\n508\t    # --- month gridlines + today (time axis only) -----------------------\n509\t    if axis == \"time\":\n510\t        cur = lo.replace(day=1)\n511\t        if cur < lo:\n512\t            pass\n513\t        months_drawn = 0\n514\t        while cur <= hi and months_drawn < 60:\n515\t            if cur >= lo:\n516\t                x = xf(cur)\n517\t                if x is not None:\n518\t                    parts.append(f'<line x1=\"{x:.1f}\" y1=\"{plot_top:.1f}\" x2=\"{x:.1f}\" '\n519\t                                 f'y2=\"{plot_bottom:.1f}\" stroke=\"var(--rule-soft)\" '\n520\t                                 f'stroke-width=\"1\" stroke-dasharray=\"1,3\"/>')\n521\t            months_drawn += 1\n522\t            cur = (cur.replace(day=28) + timedelta(days=4)).replace(day=1)\n523\t        if lo <= now_dt <= hi:\n524\t            x = xf(now_dt)\n525\t            if x is not None:\n526\t                parts.append(f'<line x1=\"{x:.1f}\" y1=\"{plot_top - 10:.1f}\" x2=\"{x:.1f}\" '\n527\t                             f'y2=\"{plot_bottom:.1f}\" stroke=\"var(--ink)\" stroke-width=\"1.3\"/>')\n528\t                parts.append(f'<text x=\"{x + 3:.1f}\" y=\"{plot_top - 2:.1f}\" font-size=\"9.5\" '\n529\t                             f'fill=\"var(--ink)\" font-family=\"var(--sans), sans-serif\">today</text>')\n530\t\n531\t    # --- legend (every symbol, wraps across rows) ------------------------\n532\t    legend_entries: list[tuple[str, str, str, bool]] = [\n533\t        (\"line-solid\", \"var(--ink-2)\", \"active\", True),\n534\t        (\"line-dashed\", \"var(--ink-2)\", \"cleared (unverified)\", True),\n535\t        (\"line-dotted\", \"var(--ink-2)\", \"stale (not seen since)\", True),\n536\t        (\"line-thick\", \"var(--ink-2)\", \"returned after clear\", True),\n537\t        (\"circle\", \"var(--sev-returned)\", \"code read (present)\", True),\n538\t        (\"circle\", \"var(--ink-3)\", \"code read (clean)\", False),\n539\t        (\"line-dashdot\", \"var(--ink-3)\", \"clear\", True),\n540\t        (\"diamond\", \"var(--ok)\", \"repair/test completed\", True),\n541\t        (\"diamond\", \"var(--sev-chronic)\", \"repair/test failed\", False),\n542\t        (\"square\", \"var(--ink-3)\", \"mechanic note\", True),\n543\t        (\"star\", \"var(--sev-returned)\", \"symptom: drivability\", True),\n544\t        (\"star\", \"var(--sev-chronic)\", \"symptom: smell/refuel/warning\", True),\n545\t        (\"ring\", \"var(--ok)\", \"drives normally\", True),\n546\t    ]\n547\t    fam_used = {r.get(\"id\") for r in rows if r.get(\"id\") in _FAMILY_COLOR}\n548\t    for fid in fam_used:\n549\t        legend_entries.append((\"square\", _FAMILY_COLOR[fid], next(\n550\t            (r.get(\"label\") for r in rows if r.get(\"id\") == fid), fid), True))\n551\t\n552\t    # Wrapped to a fixed, screen-sized width regardless of the chart's own\n553\t    # (potentially multi-thousand-pixel, for a multi-year \"all\" range) total\n554\t    # width -- otherwise the legend would stretch across the whole scrollable\n555\t    # canvas and never wrap within anything a person could actually see.\n556\t    legend_wrap_r = margin_l + min(width - margin_l - margin_r, 900)\n557\t    lx, ly = margin_l, 30\n558\t    for shape, color, label, filled in legend_entries:\n559\t        text = _esc(label)\n560\t        needed = 24 + 6.1 * len(label) + 14\n561\t        if lx + needed > legend_wrap_r and lx > margin_l:\n562\t            lx, ly = margin_l, ly + 15\n563\t        if shape.startswith(\"line-\"):\n564\t            dash = {\"line-solid\": None, \"line-dashed\": \"6,3\", \"line-dotted\": \"1.6,3\",\n565\t                   \"line-thick\": None, \"line-dashdot\": \"6,2,2,2\"}[shape]\n566\t            sw = 3.4 if shape == \"line-thick\" else 2.0\n567\t            dash_attr = f' stroke-dasharray=\"{dash}\"' if dash else \"\"\n568\t            parts.append(f'<line x1=\"{lx:.1f}\" y1=\"{ly:.1f}\" x2=\"{lx+16:.1f}\" y2=\"{ly:.1f}\" '\n569\t                         f'stroke=\"{color}\" stroke-width=\"{sw}\"{dash_attr}/>')\n570\t        else:\n571\t            parts.append(_marker(lx + 7, ly, shape, color, r=4.6, filled=filled))\n572\t        parts.append(f'<text x=\"{lx + 20:.1f}\" y=\"{ly + 3.5:.1f}\" font-size=\"10.5\" '\n573\t                     f'fill=\"var(--ink-2)\" font-family=\"var(--sans), sans-serif\">{text}</text>')\n574\t        lx += needed\n575\t\n576\t    # --- cross-cutting \"clear\" lines, drawn under everything else --------\n577\t    for lr in line_rows:\n578\t        for e in lr.get(\"events\") or []:\n579\t            x = xf(_event_value(e, axis))\n580\t            if x is None:\n581\t                continue\n582\t            label = _esc(str(e.get(\"label\") or lr.get(\"label\") or \"clear\"))\n583\t            detail = _esc(str(e.get(\"detail\") or \"\"))\n584\t            title = f\"{label}: {detail}\" if detail else label\n585\t            inner = (f'<line x1=\"{x:.1f}\" y1=\"{plot_top:.1f}\" x2=\"{x:.1f}\" y2=\"{plot_bottom:.1f}\" '\n586\t                     f'stroke=\"var(--ink-3)\" stroke-width=\"1.4\" stroke-dasharray=\"6,2,2,2\" opacity=\"0.85\"/>'\n587\t                     f'{_marker(x, plot_top - 6, \"triangle\", \"var(--ink-3)\", r=4.0)}'\n588\t                     f'<text x=\"{x+6:.1f}\" y=\"{plot_top - 3:.1f}\" font-size=\"9\" fill=\"var(--ink-3)\" '\n589\t                     f'font-family=\"var(--sans), sans-serif\">cleared</text>')\n590\t            parts.append(_wrap(inner, e.get(\"href\"), title))\n591\t\n592\t    # --- rows -----------------------------------------------------------\n593\t    for row_meta, row in zip(layout, rows):\n594\t        y_top, row_h = row_meta[\"top\"], row_meta[\"height\"]\n595\t        y = y_top + row_h / 2\n596\t        lane_id = row.get(\"id\") or \"\"\n597\t        kind = row.get(\"kind\") or \"bars\"\n598\t        events = row.get(\"events\") or []\n599\t        parts.append(f'<line x1=\"{margin_l:.1f}\" y1=\"{y_top + row_h - 1:.1f}\" '\n600\t                     f'x2=\"{width - margin_r:.1f}\" y2=\"{y_top + row_h - 1:.1f}\" '\n601\t                     f'stroke=\"var(--rule-soft)\" stroke-width=\"1\"/>')\n602\t\n603\t        if lane_id == \"conditions\":\n604\t            parts.append(_render_conditions_row(events, y_top, row_h, scale))\n605\t            continue\n606\t\n607\t        if kind == \"bars\":\n608\t            fam_color = _FAMILY_COLOR.get(lane_id, \"var(--ink-2)\")\n609\t            bar_h = row_h - 10\n610\t            drawn_points: set[int] = set()\n611\t            for (t0, t1, style, e) in _bar_segments(events, now_dt):\n612\t                x0 = xf(t0 if axis == \"time\" else e.get(\"odo\"))\n613\t                x1 = xf(t1 if axis == \"time\" else e.get(\"odo\"))\n614\t                if x0 is None or x1 is None:\n615\t                    continue\n616\t                dash = _STYLE_DASH.get(style)\n617\t                # Dashed/dotted read as *gaps* (a code clear not yet verified, or\n618\t                # a sighting with nothing since) so they get a visibly thinner\n619\t                # track than a real presence bar -- a full-height bar with a tiny\n620\t                # dash pattern just reads as a solid block with slits in it.\n621\t                if style in (\"dashed\", \"dotted\"):\n622\t                    sw = max(3.0, bar_h * 0.4)\n623\t                elif style == \"thick\":\n624\t                    sw = bar_h * 1.6\n625\t                else:\n626\t                    sw = bar_h\n627\t                if x1 - x0 < 1.5:\n628\t                    # zero-width segment -- a bare marker instead of a bar\n629\t                    filled = e.get(\"severity\") == \"active\"\n630\t                    inner = _marker((x0 + x1) / 2, y, \"circle\", fam_color, r=5.0, filled=filled)\n631\t                else:\n632\t                    dash_attr = f' stroke-dasharray=\"{dash}\"' if dash else \"\"\n633\t                    inner = (f'<line x1=\"{x0:.1f}\" y1=\"{y:.1f}\" x2=\"{x1:.1f}\" y2=\"{y:.1f}\" '\n634\t                             f'stroke=\"{fam_color}\" stroke-width=\"{sw:.1f}\" '\n635\t                             f'stroke-linecap=\"butt\"{dash_attr}/>')\n636\t                    label_text = str(e.get(\"label\") or \"\")\n637\t                    if label_text and (x1 - x0) > 7 * len(label_text) + 6:\n638\t                        parts.append(f'<text x=\"{(x0+x1)/2:.1f}\" y=\"{y - bar_h/2 - 3:.1f}\" '\n639\t                                     f'text-anchor=\"middle\" font-size=\"9.5\" fill=\"var(--ink-2)\" '\n640\t                                     f'font-family=\"var(--mono), monospace\">{_esc(label_text)}</text>')\n641\t                    count = e.get(\"count\")\n642\t                    if isinstance(count, (int, float)) and count:\n643\t                        parts.append(f'<text x=\"{x1 + 4:.1f}\" y=\"{y + 3:.1f}\" font-size=\"9.5\" '\n644\t                                     f'fill=\"var(--ink-3)\" font-family=\"var(--mono), monospace\">'\n645\t                                     f'x{count:g}</text>')\n646\t                label_txt = str(e.get(\"label\") or lane_id)\n647\t                title = f\"{label_txt} -- {_STYLE_LABEL.get(style, style)}\"\n648\t                if e.get(\"detail\"):\n649\t                    title += f\" ({e['detail']})\"\n650\t                parts.append(_wrap(inner, e.get(\"href\"), title))\n651\t        else:  # \"points\" lanes: symptoms / notes / work / anything else\n652\t            for e in events:\n653\t                x = xf(_event_value(e, axis))\n654\t                if x is None:\n655\t                    continue\n656\t                if lane_id == \"symptoms\":\n657\t                    shape, color, style_label = _symptom_shape(e)\n658\t                    filled = True\n659\t                elif lane_id == \"work\":\n660\t                    shape, color, style_label, filled = _work_shape(e)\n661\t                else:\n662\t                    shape, color, style_label = _SEVERITY_STYLE.get(\n663\t                        e.get(\"severity\") or \"\", _DEFAULT_STYLE)\n664\t                    filled = True\n665\t                label = str(e.get(\"label\") or \"\")\n666\t                detail = str(e.get(\"detail\") or \"\")\n667\t                title = f\"{label or style_label}: {detail}\" if detail else (label or style_label)\n668\t                parts.append(_wrap(_marker(x, y, shape, color, filled=filled), e.get(\"href\"), title))\n669\t\n670\t    # --- bottom (primary) axis ------------------------------------------\n671\t    axis_y = plot_bottom + 18\n672\t    parts.append(f'<line x1=\"{margin_l:.1f}\" y1=\"{plot_bottom:.1f}\" '\n673\t                 f'x2=\"{width - margin_r:.1f}\" y2=\"{plot_bottom:.1f}\" stroke=\"var(--rule)\"/>')\n674\t    if axis == \"time\":\n675\t        labels = [d.date().isoformat() for d in axis_vals]\n676\t    else:\n677\t        labels = [f\"{v:,.0f} km\" for v in axis_vals]\n678\t    for val, text, anchor in zip(axis_vals, labels, (\"start\", \"middle\", \"end\")):\n679\t        x = xf(val)\n680\t        if x is None:\n681\t            continue\n682\t        parts.append(f'<text x=\"{x:.1f}\" y=\"{axis_y:.1f}\" text-anchor=\"{anchor}\" font-size=\"10\" '\n683\t                     f'fill=\"var(--ink-3)\" font-family=\"var(--sans), sans-serif\">{_esc(text)}</text>')\n684\t\n685\t    parts.append(\"</svg>\")\n686\t    return \"\".join(parts)\n687\t\n688\t\n689\tdef sparkline(occurrences: list[float], symptoms: list[float],\n690\t             width: int = 110, height: int = 26) -> str:\n691\t    \"\"\"Small bar+dot chart for one correlation-table row: occurrence counts\n692\t    per period as grey bars, symptom-report counts over the same periods\n693\t    overlaid as red dots. Either list may be empty.\"\"\"\n694\t    n = max(len(occurrences), len(symptoms), 1)\n695\t    occ = (list(occurrences) + [0] * n)[:n]\n696\t    sym = (list(symptoms) + [0] * n)[:n]\n697\t    max_occ = max(occ) or 1\n698\t    max_sym = max(sym) or 1\n699\t    bw = width / n\n700\t    base = height - 4\n701\t    parts = [f'<svg {_SVG_NS} viewBox=\"0 0 {width} {height}\" width=\"{width}\" height=\"{height}\" '\n702\t            f'role=\"img\" aria-label=\"occurrences and symptom reports over time\">'\n703\t            f'<title>Occurrences (bars) vs. symptom reports (dots) over time</title>']\n704\t    for i in range(n):\n705\t        bh = (occ[i] / max_occ) * (height - 10)\n706\t        x = i * bw + 1\n707\t        parts.append(f'<rect x=\"{x:.1f}\" y=\"{base - bh:.1f}\" width=\"{max(1.0, bw - 2):.1f}\" '\n708\t                     f'height=\"{bh:.1f}\" fill=\"var(--ink-3)\" rx=\"1\">'\n709\t                     f'<title>{occ[i]:g} occurrence(s)</title></rect>')\n710\t        if sym[i]:\n711\t            cy = base - (sym[i] / max_sym) * (height - 10)\n712\t            parts.append(f'<circle cx=\"{x + bw/2:.1f}\" cy=\"{cy:.1f}\" r=\"2.6\" fill=\"var(--sev-returned)\">'\n713\t                         f'<title>{sym[i]:g} symptom report(s)</title></circle>')\n714\t    parts.append(\"</svg>\")\n715\t    return \"\".join(parts)\n716\t\n717\t\n718\t__all__ = [\"render\", \"lane_layout\", \"sparkline\", \"ROW_H\", \"CONDITIONS_ROW_H\", \"TOP_PAD\"]\n719\t"}]},"uuid":"77cffea5-d021-4ec2-8377-c83d28b8bb95","timestamp":"2026-10-08T02:41:55.613Z","toolUseResult":{"type":"text","file":{"filePath":"C:\\Users\\User\\mcp-servers\\cuore\\web\\timeline_svg.py","content":"\"\"\"Server-side inline SVG for the codes-vs-symptoms swimlane timeline.\n\nSame posture as :mod:`cuore.web.dashboard_charts` (its docstring explains\nwhy): no JS, no CDN, no charting library. Colour comes from the CSS custom\nproperties in ``cuore.css`` -- the ``--sev-*``/``--ok``/``--ink*`` ramp plus\nthe ``--fam-*`` per-family palette appended there for this page -- so the\nchart reads correctly in both themes without this module knowing which is\nactive.\n\nVisual grammar (shown in full in the legend, so nothing here is colour-only):\n\n* Each code-family lane (mil/evap/network/body/chassis/engine_other) is drawn\n  in that family's own colour. *State* is carried by line **style**, not\n  colour, on top of that: solid = present/active, dashed = cleared but the\n  gap since has not been verified clean, dotted = stale (never re-seen,\n  no clear on record), thick = returned -- the sighting right after a\n  dashed gap. This is derived per-lane by grouping that lane's flat event\n  list by ``label`` (the only code-identity signal the contract gives a\n  lane) and walking it in time order; see ``_bar_segments``.\n* Markers: circle = a session's read of that code (filled = present, hollow\n  = read clean); triangle = a clear, drawn with the vertical dash-dot line\n  that already crosses every lane; diamond = a repair/part/actuator test\n  (filled green = completed, hollow amber = failed, by keyword match on the\n  event's own text -- the contract carries no separate completed/failed\n  field); square = a mechanic note; a filled star = a drivability symptom,\n  an amber star = a smell/refuel/warning-light symptom, a hollow green\n  circle = \"drives normally\". Severity is still the colour-outline fallback\n  (red active/amber warn/green ok/grey stale) for anything that does not\n  fit one of the shapes above.\n* The ``conditions`` lane is its own mini line graph rather than markers:\n  fuel % as a polyline on the left scale with the 15-85% EVAP window shaded\n  and out-of-window points highlighted amber, engine temperature as a\n  dashed polyline on a right-hand scale. Both are read out of each event's\n  free-text ``label``/``detail`` by regex -- the contract gives conditions\n  no structured numeric fields.\n* A thin secondary axis runs along the top: interpolated odometer when\n  ``axis=\"time\"``, interpolated dates when ``axis=\"odometer\"`` (both linear\n  across ``tl[\"range\"]``). Light dotted month gridlines and a solid \"today\"\n  line are drawn on the time axis only -- projecting \"today\" onto an\n  odometer axis would be extrapolation past the data, not a reading of it.\n\nEvery text node is escaped. An empty or malformed timeline still renders a\nsmall, well-formed \"no data\" SVG rather than an empty or broken one.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport re\nfrom datetime import datetime, timedelta\nfrom typing import Any, Optional\nfrom xml.sax.saxutils import escape as _esc\n\n_SVG_NS = 'xmlns=\"http://www.w3.org/2000/svg\"'\n\n# --- shared row geometry -----------------------------------------------\n# ``lane_layout()`` hands the page the same numbers so the sticky HTML label\n# column (outside the horizontally-scrolling SVG) lines up with each row.\nROW_H = 26\nCONDITIONS_ROW_H = 64\nSEC_AXIS_Y = 12\nTOP_PAD = 96       # secondary axis + the (now large) legend, wrapped to ~3 rows\nAXIS_H = 28\nMARGIN_L = 50      # room for the conditions lane's left (fuel %) scale\nMARGIN_R = 46      # room for the conditions lane's right (temp) scale\nDAY_PX = 22        # minimum px per day on the time axis before it scrolls\n\n_FAMILY_COLOR: dict[str, str] = {\n    \"mil\":          \"var(--fam-mil)\",\n    \"evap\":         \"var(--fam-evap)\",\n    \"network\":      \"var(--fam-network)\",\n    \"body\":         \"var(--fam-body)\",\n    \"chassis\":      \"var(--fam-chassis)\",\n    \"engine_other\": \"var(--fam-engine)\",\n}\n\n#: fallback severity -> (shape, colour, legend label), used for any point\n#: event that is not one of the special-cased shapes below.\n_SEVERITY_STYLE: dict[str, tuple[str, str, str]] = {\n    \"active\":     (\"circle\",  \"var(--sev-returned)\", \"active\"),\n    \"cleared\":    (\"square\",  \"var(--ink-3)\",         \"cleared\"),\n    \"info\":       (\"circle\",  \"var(--ink-3)\",         \"note\"),\n    \"symptom\":    (\"star\",    \"var(--sev-returned)\",  \"symptom reported\"),\n    \"no_symptom\": (\"ring\",    \"var(--ok)\",             \"drives normally\"),\n    \"work\":       (\"diamond\", \"var(--sev-cleared)\",    \"work done\"),\n    \"warn\":       (\"diamond\", \"var(--sev-chronic)\",    \"condition (warn)\"),\n}\n_DEFAULT_STYLE = (\"ring\", \"var(--ink-3)\", \"unknown\")\n\n_FUEL_RE = re.compile(r\"fuel[^0-9]{0,12}(\\d{1,3}(?:\\.\\d+)?)\\s*%\", re.IGNORECASE)\n_TEMP_RE = re.compile(r\"(-?\\d{1,3}(?:\\.\\d+)?)\\s*(?:deg(?:ree)?s?)?\\s*°?\\s*c\\b\", re.IGNORECASE)\n\n_DRIVABILITY_WORDS = (\"hard_start\", \"hard start\", \"rough_idle\", \"rough idle\",\n                      \"hesitation\", \"loss_of_power\", \"loss of power\", \"noise\",\n                      \"vibration\")\n_WARNING_WORDS = (\"fuel_smell\", \"fuel smell\", \"hard_to_refuel\", \"hard to refuel\",\n                  \"warning_message\", \"warning message\", \"mil_on\", \"mil on\")\n\n# --- small helpers ---------------------------------------------------------\n\n\ndef _parse_dt(ts: Any) -> Optional[datetime]:\n    if not ts:\n        return None\n    s = str(ts).strip().replace(\" \", \"T\")[:19]\n    try:\n        return datetime.fromisoformat(s)\n    except ValueError:\n        return None\n\n\ndef _to_float(v: Any) -> Optional[float]:\n    return float(v) if isinstance(v, (int, float)) else None\n\n\ndef _now() -> datetime:\n    return datetime.now()\n\n\ndef _no_data_svg(message: str = \"No timeline data for this vehicle yet.\") -> str:\n    w, h = 600, 90\n    return (\n        f'<svg {_SVG_NS} viewBox=\"0 0 {w} {h}\" width=\"100%\" '\n        f'role=\"img\" aria-label=\"Timeline: {_esc(message)}\">'\n        f'<title>Timeline</title>'\n        f'<text x=\"{w/2}\" y=\"{h/2}\" text-anchor=\"middle\" dominant-baseline=\"middle\" '\n        f'fill=\"var(--ink-3)\" font-size=\"13\" font-family=\"var(--sans), sans-serif\">'\n        f'{_esc(message)}</text></svg>'\n    )\n\n\ndef _marker(x: float, y: float, shape: str, color: str, r: float = 5.2,\n           filled: bool = True) -> str:\n    if shape == \"circle\":\n        if filled:\n            return f'<circle cx=\"{x:.1f}\" cy=\"{y:.1f}\" r=\"{r:.1f}\" fill=\"{color}\"/>'\n        return (f'<circle cx=\"{x:.1f}\" cy=\"{y:.1f}\" r=\"{r:.1f}\" fill=\"none\" '\n                f'stroke=\"{color}\" stroke-width=\"1.8\"/>')\n    if shape == \"square\":\n        s = r * 1.6\n        return (f'<rect x=\"{x - s/2:.1f}\" y=\"{y - s/2:.1f}\" width=\"{s:.1f}\" '\n                f'height=\"{s:.1f}\" fill=\"{color}\"/>')\n    if shape == \"diamond\":\n        s = r * 1.25\n        pts = f\"{x:.1f},{y-s:.1f} {x+s:.1f},{y:.1f} {x:.1f},{y+s:.1f} {x-s:.1f},{y:.1f}\"\n        if filled:\n            return f'<polygon points=\"{pts}\" fill=\"{color}\"/>'\n        return f'<polygon points=\"{pts}\" fill=\"none\" stroke=\"{color}\" stroke-width=\"1.8\"/>'\n    if shape == \"triangle\":\n        s = r * 1.3\n        pts = f\"{x:.1f},{y-s:.1f} {x-s:.1f},{y+s*0.8:.1f} {x+s:.1f},{y+s*0.8:.1f}\"\n        return f'<polygon points=\"{pts}\" fill=\"{color}\"/>'\n    if shape == \"star\":\n        return _star(x, y, r * 1.15, color)\n    # ring: hollow -- \"drives normally\" / unknown fallback\n    return (f'<circle cx=\"{x:.1f}\" cy=\"{y:.1f}\" r=\"{r * 0.85:.1f}\" fill=\"none\" '\n            f'stroke=\"{color}\" stroke-width=\"1.8\"/>')\n\n\ndef _star(cx: float, cy: float, r: float, color: str) -> str:\n    \"\"\"A filled 5-point star -- the drivability/warning symptom mark.\"\"\"\n    import math\n    pts = []\n    for i in range(10):\n        ang = -math.pi / 2 + i * math.pi / 5\n        rad = r if i % 2 == 0 else r * 0.42\n        pts.append(f\"{cx + rad * math.cos(ang):.1f},{cy + rad * math.sin(ang):.1f}\")\n    return f'<polygon points=\"{\" \".join(pts)}\" fill=\"{color}\"/>'\n\n\ndef _wrap(inner: str, href: Optional[str], title: str) -> str:\n    body = f\"{inner}<title>{_esc(title)}</title>\"\n    if href:\n        return f'<a href=\"{_esc(href)}\">{body}</a>'\n    return f\"<g>{body}</g>\"\n\n\ndef _symptom_shape(ev: dict[str, Any]) -> tuple[str, str, str]:\n    \"\"\"Which mark a 'symptoms' lane event gets: hollow green circle for\n    \"drives normally\", filled red star for a drivability complaint, amber\n    star for a smell/refuel/warning-light report. The contract's event dict\n    carries no separate tag field, so this reads the same free text a human\n    filed the symptom with.\"\"\"\n    if ev.get(\"severity\") == \"no_symptom\":\n        return \"ring\", \"var(--ok)\", \"drives normally\"\n    text = f\"{ev.get('label') or ''} {ev.get('detail') or ''}\".lower()\n    if any(w in text for w in _WARNING_WORDS):\n        return \"star\", \"var(--sev-chronic)\", \"symptom (smell/refuel/warning)\"\n    return \"star\", \"var(--sev-returned)\", \"symptom (drivability)\"\n\n\ndef _work_shape(ev: dict[str, Any]) -> tuple[str, str, str, bool]:\n    \"\"\"Diamond for a repair/part/actuator test: filled green = completed,\n    hollow amber = failed -- by keyword match, same reason as above.\"\"\"\n    text = f\"{ev.get('label') or ''} {ev.get('detail') or ''}\".lower()\n    if \"fail\" in text or \"not complete\" in text or \"incomplete\" in text:\n        return \"diamond\", \"var(--sev-chronic)\", \"repair/test (failed)\", False\n    return \"diamond\", \"var(--ok)\", \"repair/test (completed)\", True\n\n\n# --- derived bar-state segments (solid/dashed/dotted/thick) ----------------\n\n_STALE_AFTER = timedelta(days=45)\n\n\ndef _bar_segments(events: list[dict[str, Any]], now_dt: datetime\n                  ) -> list[tuple[datetime, datetime, str, dict[str, Any]]]:\n    \"\"\"One lane's flat event list -> drawable ``(start, end, style, event)``\n    segments. Grouped by ``label`` (the code) because that is the only\n    code-identity signal a lane's events carry; an event with no label is\n    its own singleton group so it still renders on its own.\"\"\"\n    groups: dict[Any, list[dict[str, Any]]] = {}\n    for e in events:\n        groups.setdefault(e.get(\"label\") or id(e), []).append(e)\n\n    segments: list[tuple[datetime, datetime, str, dict[str, Any]]] = []\n    for evs in groups.values():\n        evs = sorted(evs, key=lambda e: _parse_dt(e.get(\"t\")) or now_dt)\n        prev_was_clear = False\n        for i, e in enumerate(evs):\n            t0 = _parse_dt(e.get(\"t\"))\n            if t0 is None:\n                continue\n            t_end = _parse_dt(e.get(\"t_end\"))\n            severity = e.get(\"severity\")\n            if severity == \"cleared\":\n                gap_start = t_end or t0\n                if t_end:\n                    segments.append((t0, t_end, \"solid\", e))\n                nxt = evs[i + 1] if i + 1 < len(evs) else None\n                gap_end = (_parse_dt(nxt.get(\"t\")) if nxt else None) or now_dt\n                if gap_end > gap_start:\n                    segments.append((gap_start, gap_end, \"dashed\", e))\n                prev_was_clear = True\n            elif severity == \"active\":\n                end = t_end or now_dt\n                style = \"thick\" if prev_was_clear else \"solid\"\n                if not t_end and (now_dt - t0) > _STALE_AFTER:\n                    mid = min(t0 + timedelta(days=7), now_dt)\n                    segments.append((t0, mid, style, e))\n                    if now_dt > mid:\n                        segments.append((mid, now_dt, \"dotted\", e))\n                else:\n                    segments.append((t0, end, style, e))\n                prev_was_clear = False\n            else:\n                # Not a presence/clear event (e.g. a plain \"info\" read) --\n                # left to the point-marker fallback in the caller.\n                prev_was_clear = False\n    return segments\n\n\n_STYLE_DASH = {\"solid\": None, \"thick\": None, \"dashed\": \"10,6\", \"dotted\": \"1.8,5\"}\n_STYLE_LABEL = {\"solid\": \"active\", \"thick\": \"returned after clear\",\n               \"dashed\": \"cleared (unverified)\", \"dotted\": \"stale (not seen since)\"}\n\n\n# --- conditions mini line-graph lane ---------------------------------------\n\n\ndef _conditions_series(events: list[dict[str, Any]]) -> tuple[list[tuple[datetime, float]],\n                                                                list[tuple[datetime, float]]]:\n    fuel: list[tuple[datetime, float]] = []\n    temp: list[tuple[datetime, float]] = []\n    for e in events:\n        t = _parse_dt(e.get(\"t\"))\n        if t is None:\n            continue\n        text = f\"{e.get('label') or ''} {e.get('detail') or ''}\"\n        if (m := _FUEL_RE.search(text)):\n            try:\n                fuel.append((t, float(m.group(1))))\n            except ValueError:\n                pass\n        if (m := _TEMP_RE.search(text)):\n            try:\n                temp.append((t, float(m.group(1))))\n            except ValueError:\n                pass\n    fuel.sort(key=lambda p: p[0])\n    temp.sort(key=lambda p: p[0])\n    return fuel, temp\n\n\ndef _render_conditions_row(events: list[dict[str, Any]], y_top: float, row_h: float,\n                          xf, esc=_esc) -> str:\n    \"\"\"The conditions lane: fuel% polyline + 15-85% band on the left scale,\n    engine-temp dashed polyline on a right-hand scale. Falls back to plain\n    markers (via the caller) when neither series has any points.\"\"\"\n    fuel, temp = _conditions_series(events)\n    parts: list[str] = []\n    plot_top, plot_bot = y_top + 3, y_top + row_h - 3\n\n    def fy(pct: float) -> float:\n        pct = max(0.0, min(100.0, pct))\n        return plot_bot - pct / 100.0 * (plot_bot - plot_top)\n\n    if fuel:\n        band_top, band_bot = fy(85), fy(15)\n        parts.append(f'<rect x=\"{xf.margin_l:.1f}\" y=\"{band_top:.1f}\" '\n                     f'width=\"{xf.plot_w:.1f}\" height=\"{band_bot - band_top:.1f}\" '\n                     f'fill=\"var(--ok-bg)\" opacity=\"0.55\"><title>EVAP monitor window: '\n                     f'fuel 15-85%</title></rect>')\n        pts = [(xf(t), fy(v)) for t, v in fuel]\n        pts = [(x, y) for x, y in pts if x is not None]\n        if pts:\n            d = \" \".join(f'{\"M\" if i == 0 else \"L\"}{x:.1f},{y:.1f}' for i, (x, y) in enumerate(pts))\n            parts.append(f'<path d=\"{d}\" fill=\"none\" stroke=\"var(--fam-evap)\" stroke-width=\"1.6\"/>')\n        for t, v in fuel:\n            x = xf(t)\n            if x is None:\n                continue\n            out_of_band = v < 15 or v > 85\n            color = \"var(--sev-chronic)\" if out_of_band else \"var(--fam-evap)\"\n            parts.append(f'<circle cx=\"{x:.1f}\" cy=\"{fy(v):.1f}\" r=\"{3.2 if out_of_band else 2.4:.1f}\" '\n                         f'fill=\"{color}\"><title>Fuel {v:g}%'\n                         f'{\" -- outside the 15-85% EVAP window\" if out_of_band else \"\"}</title></circle>')\n        parts.append(f'<text x=\"{xf.margin_l - 6:.1f}\" y=\"{plot_top + 8:.1f}\" text-anchor=\"end\" '\n                     f'font-size=\"9.5\" fill=\"var(--fam-evap)\" font-family=\"var(--sans), sans-serif\">Fuel %</text>')\n\n    if temp:\n        tvals = [v for _, v in temp]\n        tlo, thi = min(tvals + [0.0]), max(tvals + [90.0])\n        if thi == tlo:\n            thi = tlo + 1.0\n\n        def ty(v: float) -> float:\n            return plot_bot - (v - tlo) / (thi - tlo) * (plot_bot - plot_top)\n\n        pts = [(xf(t), ty(v)) for t, v in temp]\n        pts = [(x, y) for x, y in pts if x is not None]\n        if pts:\n            d = \" \".join(f'{\"M\" if i == 0 else \"L\"}{x:.1f},{y:.1f}' for i, (x, y) in enumerate(pts))\n            parts.append(f'<path d=\"{d}\" fill=\"none\" stroke=\"var(--fam-chassis)\" '\n                         f'stroke-width=\"1.4\" stroke-dasharray=\"5,3\"/>')\n            for t, v in temp:\n                x = xf(t)\n                if x is None:\n                    continue\n                parts.append(f'<circle cx=\"{x:.1f}\" cy=\"{ty(v):.1f}\" r=\"2.2\" fill=\"var(--fam-chassis)\">'\n                             f'<title>Engine temp {v:g} C</title></circle>')\n        parts.append(f'<text x=\"{xf.margin_l + xf.plot_w + 6:.1f}\" y=\"{plot_top + 8:.1f}\" '\n                     f'font-size=\"9.5\" fill=\"var(--fam-chassis)\" '\n                     f'font-family=\"var(--sans), sans-serif\">Temp C</text>')\n\n    return \"\".join(parts)\n\n\n# --- lane partitioning -------------------------------------------------\n\n\ndef _plot_lanes(tl: dict[str, Any]) -> list[dict[str, Any]]:\n    return [r for r in (tl.get(\"lanes\") or []) if (r.get(\"kind\") or \"bars\") != \"lines\"\n            and r.get(\"id\") != \"clears\"]\n\n\ndef _line_lanes(tl: dict[str, Any]) -> list[dict[str, Any]]:\n    return [r for r in (tl.get(\"lanes\") or []) if (r.get(\"kind\") or \"\") == \"lines\"\n            or r.get(\"id\") == \"clears\"]\n\n\ndef _row_height(lane: dict[str, Any]) -> int:\n    return CONDITIONS_ROW_H if lane.get(\"id\") == \"conditions\" else ROW_H\n\n\ndef lane_layout(tl: dict[str, Any]) -> list[dict[str, Any]]:\n    \"\"\"Row geometry for the sticky HTML label column: one entry per plotted\n    lane, in the same top-offset/height units ``render()`` draws at.\"\"\"\n    rows = _plot_lanes(tl)\n    out, top = [], TOP_PAD\n    for r in rows:\n        h = _row_height(r)\n        out.append({\"id\": r.get(\"id\"), \"label\": r.get(\"label\") or r.get(\"id\") or \"\",\n                     \"top\": top, \"height\": h})\n        top += h\n    return out\n\n\ndef _event_value(ev: dict[str, Any], axis: str) -> Any:\n    return ev.get(\"odo\") if axis == \"odometer\" else ev.get(\"t\")\n\n\n# --- the public entry point -------------------------------------------\n\n\nclass _Scale:\n    \"\"\"A callable time/odometer -> x mapper that also carries the plot's\n    own margin/width, so ``_render_conditions_row`` can draw its band and\n    axis labels without a separate parameter list.\"\"\"\n\n    def __init__(self, xf, margin_l: float, plot_w: float):\n        self._xf = xf\n        self.margin_l = margin_l\n        self.plot_w = plot_w\n\n    def __call__(self, raw: Any) -> Optional[float]:\n        return self._xf(raw)\n\n\ndef render(tl: dict[str, Any], axis: str = \"time\", width: int = 920) -> str:\n    \"\"\"The swimlane plot (no row labels -- see module docstring).\"\"\"\n    axis = axis if axis in (\"time\", \"odometer\") else \"time\"\n    rows = _plot_lanes(tl)\n    line_rows = _line_lanes(tl)\n    if not rows:\n        return _no_data_svg()\n    now_dt = _now()\n    rng = tl.get(\"range\") or {}\n\n    # --- establish the axis range, and a start<->end interpolator for the\n    # secondary (top) axis, which is always the *other* unit. -------------\n    t_lo = _parse_dt(rng.get(\"start\"))\n    t_hi = _parse_dt(rng.get(\"end\"))\n    o_lo = _to_float(rng.get(\"odo_start\"))\n    o_hi = _to_float(rng.get(\"odo_end\"))\n    all_t = [d for d in (t_lo, t_hi) if d is not None]\n    all_o = [v for v in (o_lo, o_hi) if v is not None]\n    for r in rows + line_rows:\n        for e in r.get(\"events\") or []:\n            for raw in (e.get(\"t\"), e.get(\"t_end\")):\n                if (d := _parse_dt(raw)) is not None:\n                    all_t.append(d)\n            if (v := _to_float(e.get(\"odo\"))) is not None:\n                all_o.append(v)\n\n    if axis == \"time\":\n        if not all_t:\n            return _no_data_svg()\n        lo, hi = min(all_t), max(all_t)\n        if hi == lo:\n            hi = lo + timedelta(days=1)\n        span = (hi - lo).total_seconds() or 1.0\n        span_days = max(1.0, span / 86400.0)\n        min_plot_w = span_days * DAY_PX\n\n        def xf(raw: Any) -> Optional[float]:\n            d = raw if isinstance(raw, datetime) else _parse_dt(raw)\n            if d is None:\n                return None\n            return margin_l + (d - lo).total_seconds() / span * plot_w\n\n        axis_vals, axis_text = [lo, lo + (hi - lo) / 2, hi], None\n    else:\n        if not all_o:\n            return _no_data_svg(\"No odometer-tagged events for this vehicle yet.\")\n        lo, hi = min(all_o), max(all_o)\n        if hi == lo:\n            hi = lo + 1.0\n        span = (hi - lo) or 1.0\n        min_plot_w = 0.0\n\n        def xf(raw: Any) -> Optional[float]:\n            v = raw if isinstance(raw, (int, float)) else _to_float(raw)\n            if v is None:\n                return None\n            return margin_l + (v - lo) / span * plot_w\n\n        axis_vals, axis_text = [lo, lo + (hi - lo) / 2, hi], None\n\n    margin_l, margin_r = MARGIN_L, MARGIN_R\n    width = max(int(width), int(min_plot_w + margin_l + margin_r), 400)\n    plot_w = width - margin_l - margin_r\n    layout = lane_layout(tl)\n    plot_top = TOP_PAD\n    plot_bottom = layout[-1][\"top\"] + layout[-1][\"height\"] if layout else TOP_PAD\n    height = plot_bottom + AXIS_H + 10\n    scale = _Scale(xf, margin_l, plot_w)\n\n    def _interp_odo_for_time(x_val: Any) -> Optional[float]:\n        \"\"\"Project a time-axis value onto the odometer secondary axis,\n        linearly across the vehicle's overall range. None when the range\n        does not carry both ends of both units (the odometer-axis case\n        does the inverse projection inline, where it is used).\"\"\"\n        if t_lo is None or t_hi is None or o_lo is None or o_hi is None or t_hi == t_lo:\n            return None\n        d = x_val if isinstance(x_val, datetime) else _parse_dt(x_val)\n        if d is None:\n            return None\n        frac = (d - t_lo).total_seconds() / (t_hi - t_lo).total_seconds()\n        return o_lo + frac * (o_hi - o_lo)\n\n    parts: list[str] = [\n        f'<svg {_SVG_NS} viewBox=\"0 0 {width} {height}\" width=\"{width}\" height=\"{height}\" '\n        f'role=\"img\" aria-label=\"Codes vs. what the driver notices, {len(rows)} lanes\">',\n        f'<title>Codes vs. what the driver notices</title>',\n    ]\n\n    # --- secondary axis along the top --------------------------------\n    if axis == \"time\" and o_lo is not None and o_hi is not None and t_lo and t_hi and t_hi != t_lo:\n        for val, anchor in zip((lo, lo + (hi - lo) / 2, hi), (\"start\", \"middle\", \"end\")):\n            x = xf(val)\n            km = _interp_odo_for_time(val)\n            if x is None or km is None:\n                continue\n            parts.append(f'<text x=\"{x:.1f}\" y=\"{SEC_AXIS_Y:.1f}\" text-anchor=\"{anchor}\" '\n                         f'font-size=\"10\" fill=\"var(--ink-3)\" font-family=\"var(--mono), monospace\">'\n                         f'{km:,.0f} km</text>')\n    elif axis == \"odometer\" and t_lo and t_hi and o_lo is not None and o_hi is not None and o_hi != o_lo:\n        for val, anchor in zip((lo, lo + (hi - lo) / 2, hi), (\"start\", \"middle\", \"end\")):\n            x = xf(val)\n            if x is None:\n                continue\n            frac = (val - o_lo) / (o_hi - o_lo)\n            d = t_lo + (t_hi - t_lo) * frac\n            parts.append(f'<text x=\"{x:.1f}\" y=\"{SEC_AXIS_Y:.1f}\" text-anchor=\"{anchor}\" '\n                         f'font-size=\"10\" fill=\"var(--ink-3)\" font-family=\"var(--sans), sans-serif\">'\n                         f'{_esc(d.date().isoformat())}</text>')\n\n    # --- month gridlines + today (time axis only) -----------------------\n    if axis == \"time\":\n        cur = lo.replace(day=1)\n        if cur < lo:\n            pass\n        months_drawn = 0\n        while cur <= hi and months_drawn < 60:\n            if cur >= lo:\n                x = xf(cur)\n                if x is not None:\n                    parts.append(f'<line x1=\"{x:.1f}\" y1=\"{plot_top:.1f}\" x2=\"{x:.1f}\" '\n                                 f'y2=\"{plot_bottom:.1f}\" stroke=\"var(--rule-soft)\" '\n                                 f'stroke-width=\"1\" stroke-dasharray=\"1,3\"/>')\n            months_drawn += 1\n            cur = (cur.replace(day=28) + timedelta(days=4)).replace(day=1)\n        if lo <= now_dt <= hi:\n            x = xf(now_dt)\n            if x is not None:\n                parts.append(f'<line x1=\"{x:.1f}\" y1=\"{plot_top - 10:.1f}\" x2=\"{x:.1f}\" '\n                             f'y2=\"{plot_bottom:.1f}\" stroke=\"var(--ink)\" stroke-width=\"1.3\"/>')\n                parts.append(f'<text x=\"{x + 3:.1f}\" y=\"{plot_top - 2:.1f}\" font-size=\"9.5\" '\n                             f'fill=\"var(--ink)\" font-family=\"var(--sans), sans-serif\">today</text>')\n\n    # --- legend (every symbol, wraps across rows) ------------------------\n    legend_entries: list[tuple[str, str, str, bool]] = [\n        (\"line-solid\", \"var(--ink-2)\", \"active\", True),\n        (\"line-dashed\", \"var(--ink-2)\", \"cleared (unverified)\", True),\n        (\"line-dotted\", \"var(--ink-2)\", \"stale (not seen since)\", True),\n        (\"line-thick\", \"var(--ink-2)\", \"returned after clear\", True),\n        (\"circle\", \"var(--sev-returned)\", \"code read (present)\", True),\n        (\"circle\", \"var(--ink-3)\", \"code read (clean)\", False),\n        (\"line-dashdot\", \"var(--ink-3)\", \"clear\", True),\n        (\"diamond\", \"var(--ok)\", \"repair/test completed\", True),\n        (\"diamond\", \"var(--sev-chronic)\", \"repair/test failed\", False),\n        (\"square\", \"var(--ink-3)\", \"mechanic note\", True),\n        (\"star\", \"var(--sev-returned)\", \"symptom: drivability\", True),\n        (\"star\", \"var(--sev-chronic)\", \"symptom: smell/refuel/warning\", True),\n        (\"ring\", \"var(--ok)\", \"drives normally\", True),\n    ]\n    fam_used = {r.get(\"id\") for r in rows if r.get(\"id\") in _FAMILY_COLOR}\n    for fid in fam_used:\n        legend_entries.append((\"square\", _FAMILY_COLOR[fid], next(\n            (r.get(\"label\") for r in rows if r.get(\"id\") == fid), fid), True))\n\n    # Wrapped to a fixed, screen-sized width regardless of the chart's own\n    # (potentially multi-thousand-pixel, for a multi-year \"all\" range) total\n    # width -- otherwise the legend would stretch across the whole scrollable\n    # canvas and never wrap within anything a person could actually see.\n    legend_wrap_r = margin_l + min(width - margin_l - margin_r, 900)\n    lx, ly = margin_l, 30\n    for shape, color, label, filled in legend_entries:\n        text = _esc(label)\n        needed = 24 + 6.1 * len(label) + 14\n        if lx + needed > legend_wrap_r and lx > margin_l:\n            lx, ly = margin_l, ly + 15\n        if shape.startswith(\"line-\"):\n            dash = {\"line-solid\": None, \"line-dashed\": \"6,3\", \"line-dotted\": \"1.6,3\",\n                   \"line-thick\": None, \"line-dashdot\": \"6,2,2,2\"}[shape]\n            sw = 3.4 if shape == \"line-thick\" else 2.0\n            dash_attr = f' stroke-dasharray=\"{dash}\"' if dash else \"\"\n            parts.append(f'<line x1=\"{lx:.1f}\" y1=\"{ly:.1f}\" x2=\"{lx+16:.1f}\" y2=\"{ly:.1f}\" '\n                         f'stroke=\"{color}\" stroke-width=\"{sw}\"{dash_attr}/>')\n        else:\n            parts.append(_marker(lx + 7, ly, shape, color, r=4.6, filled=filled))\n        parts.append(f'<text x=\"{lx + 20:.1f}\" y=\"{ly + 3.5:.1f}\" font-size=\"10.5\" '\n                     f'fill=\"var(--ink-2)\" font-family=\"var(--sans), sans-serif\">{text}</text>')\n        lx += needed\n\n    # --- cross-cutting \"clear\" lines, drawn under everything else --------\n    for lr in line_rows:\n        for e in lr.get(\"events\") or []:\n            x = xf(_event_value(e, axis))\n            if x is None:\n                continue\n            label = _esc(str(e.get(\"label\") or lr.get(\"label\") or \"clear\"))\n            detail = _esc(str(e.get(\"detail\") or \"\"))\n            title = f\"{label}: {detail}\" if detail else label\n            inner = (f'<line x1=\"{x:.1f}\" y1=\"{plot_top:.1f}\" x2=\"{x:.1f}\" y2=\"{plot_bottom:.1f}\" '\n                     f'stroke=\"var(--ink-3)\" stroke-width=\"1.4\" stroke-dasharray=\"6,2,2,2\" opacity=\"0.85\"/>'\n                     f'{_marker(x, plot_top - 6, \"triangle\", \"var(--ink-3)\", r=4.0)}'\n                     f'<text x=\"{x+6:.1f}\" y=\"{plot_top - 3:.1f}\" font-size=\"9\" fill=\"var(--ink-3)\" '\n                     f'font-family=\"var(--sans), sans-serif\">cleared</text>')\n            parts.append(_wrap(inner, e.get(\"href\"), title))\n\n    # --- rows -----------------------------------------------------------\n    for row_meta, row in zip(layout, rows):\n        y_top, row_h = row_meta[\"top\"], row_meta[\"height\"]\n        y = y_top + row_h / 2\n        lane_id = row.get(\"id\") or \"\"\n        kind = row.get(\"kind\") or \"bars\"\n        events = row.get(\"events\") or []\n        parts.append(f'<line x1=\"{margin_l:.1f}\" y1=\"{y_top + row_h - 1:.1f}\" '\n                     f'x2=\"{width - margin_r:.1f}\" y2=\"{y_top + row_h - 1:.1f}\" '\n                     f'stroke=\"var(--rule-soft)\" stroke-width=\"1\"/>')\n\n        if lane_id == \"conditions\":\n            parts.append(_render_conditions_row(events, y_top, row_h, scale))\n            continue\n\n        if kind == \"bars\":\n            fam_color = _FAMILY_COLOR.get(lane_id, \"var(--ink-2)\")\n            bar_h = row_h - 10\n            drawn_points: set[int] = set()\n            for (t0, t1, style, e) in _bar_segments(events, now_dt):\n                x0 = xf(t0 if axis == \"time\" else e.get(\"odo\"))\n                x1 = xf(t1 if axis == \"time\" else e.get(\"odo\"))\n                if x0 is None or x1 is None:\n                    continue\n                dash = _STYLE_DASH.get(style)\n                # Dashed/dotted read as *gaps* (a code clear not yet verified, or\n                # a sighting with nothing since) so they get a visibly thinner\n                # track than a real presence bar -- a full-height bar with a tiny\n                # dash pattern just reads as a solid block with slits in it.\n                if style in (\"dashed\", \"dotted\"):\n                    sw = max(3.0, bar_h * 0.4)\n                elif style == \"thick\":\n                    sw = bar_h * 1.6\n                else:\n                    sw = bar_h\n                if x1 - x0 < 1.5:\n                    # zero-width segment -- a bare marker instead of a bar\n                    filled = e.get(\"severity\") == \"active\"\n                    inner = _marker((x0 + x1) / 2, y, \"circle\", fam_color, r=5.0, filled=filled)\n                else:\n                    dash_attr = f' stroke-dasharray=\"{dash}\"' if dash else \"\"\n                    inner = (f'<line x1=\"{x0:.1f}\" y1=\"{y:.1f}\" x2=\"{x1:.1f}\" y2=\"{y:.1f}\" '\n                             f'stroke=\"{fam_color}\" stroke-width=\"{sw:.1f}\" '\n                             f'stroke-linecap=\"butt\"{dash_attr}/>')\n                    label_text = str(e.get(\"label\") or \"\")\n                    if label_text and (x1 - x0) > 7 * len(label_text) + 6:\n                        parts.append(f'<text x=\"{(x0+x1)/2:.1f}\" y=\"{y - bar_h/2 - 3:.1f}\" '\n                                     f'text-anchor=\"middle\" font-size=\"9.5\" fill=\"var(--ink-2)\" '\n                                     f'font-family=\"var(--mono), monospace\">{_esc(label_text)}</text>')\n                    count = e.get(\"count\")\n                    if isinstance(count, (int, float)) and count:\n                        parts.append(f'<text x=\"{x1 + 4:.1f}\" y=\"{y + 3:.1f}\" font-size=\"9.5\" '\n                                     f'fill=\"var(--ink-3)\" font-family=\"var(--mono), monospace\">'\n                                     f'x{count:g}</text>')\n                label_txt = str(e.get(\"label\") or lane_id)\n                title = f\"{label_txt} -- {_STYLE_LABEL.get(style, style)}\"\n                if e.get(\"detail\"):\n                    title += f\" ({e['detail']})\"\n                parts.append(_wrap(inner, e.get(\"href\"), title))\n        else:  # \"points\" lanes: symptoms / notes / work / anything else\n            for e in events:\n                x = xf(_event_value(e, axis))\n                if x is None:\n                    continue\n                if lane_id == \"symptoms\":\n                    shape, color, style_label = _symptom_shape(e)\n                    filled = True\n                elif lane_id == \"work\":\n                    shape, color, style_label, filled = _work_shape(e)\n                else:\n                    shape, color, style_label = _SEVERITY_STYLE.get(\n                        e.get(\"severity\") or \"\", _DEFAULT_STYLE)\n                    filled = True\n                label = str(e.get(\"label\") or \"\")\n                detail = str(e.get(\"detail\") or \"\")\n                title = f\"{label or style_label}: {detail}\" if detail else (label or style_label)\n                parts.append(_wrap(_marker(x, y, shape, color, filled=filled), e.get(\"href\"), title))\n\n    # --- bottom (primary) axis ------------------------------------------\n    axis_y = plot_bottom + 18\n    parts.append(f'<line x1=\"{margin_l:.1f}\" y1=\"{plot_bottom:.1f}\" '\n                 f'x2=\"{width - margin_r:.1f}\" y2=\"{plot_bottom:.1f}\" stroke=\"var(--rule)\"/>')\n    if axis == \"time\":\n        labels = [d.date().isoformat() for d in axis_vals]\n    else:\n        labels = [f\"{v:,.0f} km\" for v in axis_vals]\n    for val, text, anchor in zip(axis_vals, labels, (\"start\", \"middle\", \"end\")):\n        x = xf(val)\n        if x is None:\n            continue\n        parts.append(f'<text x=\"{x:.1f}\" y=\"{axis_y:.1f}\" text-anchor=\"{anchor}\" font-size=\"10\" '\n                     f'fill=\"var(--ink-3)\" font-family=\"var(--sans), sans-serif\">{_esc(text)}</text>')\n\n    parts.append(\"</svg>\")\n    return \"\".join(parts)\n\n\ndef sparkline(occurrences: list[float], symptoms: list[float],\n             width: int = 110, height: int = 26) -> str:\n    \"\"\"Small bar+dot chart for one correlation-table row: occurrence counts\n    per period as grey bars, symptom-report counts over the same periods\n    overlaid as red dots. Either list may be empty.\"\"\"\n    n = max(len(occurrences), len(symptoms), 1)\n    occ = (list(occurrences) + [0] * n)[:n]\n    sym = (list(symptoms) + [0] * n)[:n]\n    max_occ = max(occ) or 1\n    max_sym = max(sym) or 1\n    bw = width / n\n    base = height - 4\n    parts = [f'<svg {_SVG_NS} viewBox=\"0 0 {width} {height}\" width=\"{width}\" height=\"{height}\" '\n            f'role=\"img\" aria-label=\"occurrences and symptom reports over time\">'\n            f'<title>Occurrences (bars) vs. symptom reports (dots) over time</title>']\n    for i in range(n):\n        bh = (occ[i] / max_occ) * (height - 10)\n        x = i * bw + 1\n        parts.append(f'<rect x=\"{x:.1f}\" y=\"{base - bh:.1f}\" width=\"{max(1.0, bw - 2):.1f}\" '\n                     f'height=\"{bh:.1f}\" fill=\"var(--ink-3)\" rx=\"1\">'\n                     f'<title>{occ[i]:g} occurrence(s)</title></rect>')\n        if sym[i]:\n            cy = base - (sym[i] / max_sym) * (height - 10)\n            parts.append(f'<circle cx=\"{x + bw/2:.1f}\" cy=\"{cy:.1f}\" r=\"2.6\" fill=\"var(--sev-returned)\">'\n                         f'<title>{sym[i]:g} symptom report(s)</title></circle>')\n    parts.append(\"</svg>\")\n    return \"\".join(parts)\n\n\n__all__ = [\"render\", \"lane_layout\", \"sparkline\", \"ROW_H\", \"CONDITIONS_ROW_H\", \"TOP_PAD\"]\n","numLines":719,"startLine":1,"totalLines":719}},"sourceToolAssistantUUID":"03767f0d-0297-4d07-a75b-f7e841e63281","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
{"parentUuid":"77cffea5-d021-4ec2-8377-c83d28b8bb95","isSidechain":true,"agentId":"aa1325351951d62ee","message":{"model":"claude-sonnet-5","id":"msg_011CfoztPafVNP2sdJ8Wf3C9","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01Y729KjvYh93orDsChY4HhW","name":"Read","input":{"file_path":"C:\\Users\\User\\mcp-servers\\cuore\\web\\timeline_routes.py"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":5692,"cache_read_input_tokens":57205,"cache_creation":{"ephemeral_5m_input_tokens":5692,"ephemeral_1h_input_tokens":0},"output_tokens":2,"service_tier":"standard","inference_geo":"not_available"},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_01Y729KjvYh93orDsChY4HhW":{"file_path":"C:\\Users\\User\\mcp-servers\\cuore\\web\\timeline_routes.py"}},"serverClassifierRequest":"0b8ef2c8-be20-4314-8b45-92c5c2b29bde","apiBlockIndex":2,"requestId":"req_011CfoztPLXKVq3E86KZpSeM","attributionAgent":"general-purpose","type":"assistant","uuid":"fa87d8e4-d117-4a96-a2d6-1a8061c6eda1","timestamp":"2026-10-08T02:41:55.723Z","effort":"high","perTurnEffort":null,"userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
{"parentUuid":"fa87d8e4-d117-4a96-a2d6-1a8061c6eda1","isSidechain":true,"promptId":"bbc43356-430e-40a9-a14e-41404b640377","agentId":"aa1325351951d62ee","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Y729KjvYh93orDsChY4HhW","type":"tool_result","content":"1\t\"\"\"``GET /v/{vin}/timeline``: \"Codes vs. what the driver notices\".\n2\t\n3\tSame posture as :mod:`cuore.web.dashboard_routes` and :mod:`cuore.web.\n4\tservice_routes` (both built the same way, concurrently with other agents):\n5\ta separate router, reusing ``_dossier``/``_vehicle_bar``/``_page``/\n6\t``_set_active_vehicle`` from :mod:`cuore.web.routes` by import rather than\n7\tduplicating that plumbing.\n8\t\n9\tThe data contract lives in ``cuore.services.timeline_bridge``\n10\t(``build_timeline(vin)``, ``code_feel(vin, code)``), built in parallel by\n11\tanother agent and not necessarily present yet. Every call into it is\n12\twrapped and falls back to ``_FIXTURE`` (built to the exact shape the\n13\tcontract specifies) so this page, and ``code.html``'s feel card, are\n14\tdevelopable and testable before that module lands. Once it exists, nothing\n15\there needs to change -- the lazy import just starts succeeding.\n16\t\n17\tNot registered on the app here -- ``app.py`` is owned by another agent\n18\twhile this was built. The two lines needed there:\n19\t\n20\t    ``from .web import timeline_routes``\n21\t    ``app.include_router(timeline_routes.router)``\n22\t\n23\t(next to the other ``web`` router imports/includes.)\n24\t\"\"\"\n25\t\n26\tfrom __future__ import annotations\n27\t\n28\tfrom datetime import datetime, timedelta\n29\tfrom typing import Any, Optional\n30\tfrom urllib.parse import quote\n31\t\n32\tfrom fastapi import APIRouter, Depends, Request\n33\tfrom fastapi.responses import HTMLResponse, RedirectResponse\n34\t\n35\tfrom ..services import cache, mes_bridge\n36\tfrom ..services.errors import BridgeError\n37\tfrom ..api.deps import require_token\n38\tfrom . import timeline_svg\n39\tfrom .routes import _dossier, _page, _set_active_vehicle, _vehicle_bar\n40\tfrom .routes import templates as _shared_templates\n41\t\n42\trouter = APIRouter(include_in_schema=False, dependencies=[Depends(require_token)])\n43\t\n44\tSYMPTOM_TAGS = [\"drives_normally\", \"mil_on\", \"fuel_smell\", \"hard_start\", \"rough_idle\",\n45\t               \"hesitation\", \"loss_of_power\", \"hard_to_refuel\", \"noise\", \"vibration\",\n46\t               \"warning_message\", \"other\"]\n47\tCONDITION_TAGS = [\"cold_start\", \"hot\", \"just_refuelled\", \"highway\", \"city\", \"idle\", \"rain\"]\n48\t\n49\t_RANGE_DAYS = {\"1y\": 365, \"90d\": 90, \"30d\": 30}\n50\t\n51\t\n52\t# --- fixture: the exact shape cuore.services.timeline_bridge.build_timeline\n53\t# will return, used until that module lands (or for any VIN it does not yet\n54\t# cover). ---------------------------------------------------------------\n55\t\n56\tdef _fixture_timeline(vin: str) -> dict[str, Any]:\n57\t    return {\n58\t        \"vin\": vin,\n59\t        \"range\": {\"start\": \"2025-09-24T00:00:00\", \"end\": \"2026-10-04T11:16:00\",\n60\t                  \"odo_start\": 115790, \"odo_end\": 142290},\n61\t        \"lanes\": [\n62\t            {\"id\": \"mil\", \"label\": \"MIL\", \"kind\": \"bars\", \"events\": [\n63\t                {\"t\": \"2025-09-24T00:00:00\", \"t_end\": \"2026-08-27T00:00:00\", \"odo\": 115800,\n64\t                 \"label\": \"MIL\", \"detail\": \"lamp on, EVAP family\", \"severity\": \"active\",\n65\t                 \"href\": None, \"count\": 11},\n66\t            ]},\n67\t            {\"id\": \"evap\", \"label\": \"EVAP\", \"kind\": \"bars\", \"events\": [\n68\t                {\"t\": \"2025-09-24T00:00:00\", \"t_end\": \"2026-08-27T00:00:00\", \"odo\": 115800,\n69\t                 \"label\": \"P0456\", \"detail\": \"EVAP small leak\", \"severity\": \"cleared\",\n70\t                 \"href\": f\"/v/{vin}/code/P0456\", \"count\": 11},\n71\t            ]},\n72\t            {\"id\": \"network\", \"label\": \"Network\", \"kind\": \"bars\", \"events\": [\n73\t                {\"t\": \"2026-01-15T00:00:00\", \"t_end\": None, \"odo\": 128000,\n74\t                 \"label\": \"U0100\", \"detail\": \"lost comms with ECM\", \"severity\": \"active\",\n75\t                 \"href\": f\"/v/{vin}/code/U0100\", \"count\": 2},\n76\t            ]},\n77\t            {\"id\": \"body\", \"label\": \"Body\", \"kind\": \"bars\", \"events\": []},\n78\t            {\"id\": \"chassis\", \"label\": \"Chassis\", \"kind\": \"bars\", \"events\": []},\n79\t            {\"id\": \"engine_other\", \"label\": \"Engine (other)\", \"kind\": \"bars\", \"events\": []},\n80\t            {\"id\": \"clears\", \"label\": \"Clears\", \"kind\": \"lines\", \"events\": [\n81\t                {\"t\": \"2026-08-27T00:00:00\", \"t_end\": None, \"odo\": 138000,\n82\t                 \"label\": \"cleared\", \"detail\": \"P0440/P0455/P0456 cleared (MultiEcuScan)\",\n83\t                 \"severity\": \"cleared\", \"href\": None},\n84\t            ]},\n85\t            {\"id\": \"symptoms\", \"label\": \"Symptoms\", \"kind\": \"points\", \"events\": []},\n86\t            {\"id\": \"notes\", \"label\": \"Notes\", \"kind\": \"points\", \"events\": []},\n87\t            {\"id\": \"work\", \"label\": \"Work\", \"kind\": \"points\", \"events\": [\n88\t                {\"t\": \"2026-09-15T21:18:00\", \"t_end\": None, \"odo\": 138900,\n89\t                 \"label\": \"Evaporation control valve\", \"detail\": \"FAILED TO EXECUTE (engine running)\",\n90\t                 \"severity\": \"work\", \"href\": None},\n91\t                {\"t\": \"2026-09-15T21:30:00\", \"t_end\": None, \"odo\": 138900,\n92\t                 \"label\": \"Evaporation control valve\", \"detail\": \"completed, key-on engine-off\",\n93\t                 \"severity\": \"work\", \"href\": None},\n94\t            ]},\n95\t            {\"id\": \"conditions\", \"label\": \"Conditions\", \"kind\": \"points\", \"events\": [\n96\t                {\"t\": \"2025-09-24T00:00:00\", \"t_end\": None, \"odo\": 115800,\n97\t                 \"label\": \"freeze frame\", \"detail\": \"fuel 93.7%, engine temp 89 C\",\n98\t                 \"severity\": \"warn\", \"href\": None},\n99\t            ]},\n100\t        ],\n101\t        \"correlation\": [\n102\t            {\"family\": \"EVAP\", \"codes\": [\"P0440\", \"P0455\", \"P0456\"], \"occurrences\": 11,\n103\t             \"symptom_reports_near\": 0, \"by_tag\": {}, \"drives_normally_near\": 0,\n104\t             \"window_days\": 7, \"verdict\": \"no reported symptom\"},\n105\t            {\"family\": \"NETWORK\", \"codes\": [\"U0100\", \"U0101\"], \"occurrences\": 2,\n106\t             \"symptom_reports_near\": 0, \"by_tag\": {}, \"drives_normally_near\": 0,\n107\t             \"window_days\": 7, \"verdict\": \"no reported symptom\"},\n108\t        ],\n109\t        \"findings\": [\n110\t            \"EVAP (P0440/P0455/P0456) has set 11 times over 26,500 km with no symptom \"\n111\t            \"ever reported near a sighting -- consistent with the TSB 18-030-17 \"\n112\t            \"calibration read, not a drivability complaint.\",\n113\t            \"No driver symptom report exists in the log for this vehicle yet -- use the \"\n114\t            \"symptom form below after every drive, including 'drives normally'.\",\n115\t        ],\n116\t        \"symptom_tags\": SYMPTOM_TAGS,\n117\t        \"conditions\": CONDITION_TAGS,\n118\t    }\n119\t\n120\t\n121\tdef _fixture_code_feel(vin: str, code: str) -> dict[str, Any]:\n122\t    code = (code or \"\").upper()\n123\t    if code in (\"P0456\", \"P0440\", \"P0455\"):\n124\t        return {\n125\t            \"feel\": {\n126\t                \"feel\": \"Usually nothing -- EVAP small/large leaks are almost always silent \"\n127\t                        \"to the driver.\",\n128\t                \"expect\": [\"no drivability change\", \"MIL after 2 failed drive cycles\"],\n129\t                \"not_expected\": [\"rough idle\", \"loss of power\", \"stalling\"],\n130\t                \"mil\": \"check-engine light after two failed drives of the EVAP monitor\",\n131\t                \"notes\": \"A fuel-smell report alongside this code is unusual and worth a \"\n132\t                         \"real leak check rather than assuming it is this code.\",\n133\t                \"confidence\": \"high\", \"source\": \"mes/dtc_feel.yaml\",\n134\t            },\n135\t            \"pattern\": {\"occurrences\": 11, \"symptom_reports_near\": 0, \"by_tag\": {},\n136\t                       \"drives_normally_near\": 0},\n137\t        }\n138\t    return {\"feel\": None, \"pattern\": {\"occurrences\": 0, \"symptom_reports_near\": 0,\n139\t                                      \"by_tag\": {}, \"drives_normally_near\": 0}}\n140\t\n141\t\n142\tdef _bridge():\n143\t    \"\"\"``cuore.services.timeline_bridge``, or ``None`` if it has not landed.\"\"\"\n144\t    try:\n145\t        from ..services import timeline_bridge\n146\t        return timeline_bridge\n147\t    except ImportError:\n148\t        return None\n149\t\n150\t\n151\tdef _timeline(vin: str) -> dict[str, Any]:\n152\t    bridge = _bridge()\n153\t    if bridge is None:\n154\t        return _fixture_timeline(vin)\n155\t    return cache.get_or_build(\n156\t        (\"timeline\", vin, mes_bridge.newest_mtime(vin)),\n157\t        lambda: bridge.build_timeline(vin))\n158\t\n159\t\n160\tdef _code_feel_data(vin: str, code: str) -> dict[str, Any]:\n161\t    bridge = _bridge()\n162\t    if bridge is None:\n163\t        return _fixture_code_feel(vin, code)\n164\t    try:\n165\t        return bridge.code_feel(vin, code)\n166\t    except Exception:  # noqa: BLE001 -- a knowledge-table miss must never 500 a code page\n167\t        return {\"feel\": None, \"pattern\": None}\n168\t\n169\t\n170\t_shared_templates.env.globals[\"code_feel\"] = _code_feel_data\n171\t\n172\t\n173\t# --- range/zoom filtering ---------------------------------------------\n174\t\n175\tdef _parse_dt(ts: Any) -> Optional[datetime]:\n176\t    if not ts:\n177\t        return None\n178\t    s = str(ts).strip().replace(\" \", \"T\")[:19]\n179\t    try:\n180\t        return datetime.fromisoformat(s)\n181\t    except ValueError:\n182\t        return None\n183\t\n184\t\n185\tdef _apply_range(tl: dict[str, Any], range_key: str) -> dict[str, Any]:\n186\t    \"\"\"Zoom presets (?range=1y|90d|30d) filter every lane's events to a\n187\t    window before the newest timestamp in the timeline, and narrow\n188\t    ``range`` to match -- otherwise the chart's axis would still span the\n189\t    whole car even though the events on it had been cut down to a month.\"\"\"\n190\t    days = _RANGE_DAYS.get(range_key)\n191\t    if not days:\n192\t        return tl\n193\t    stamps = [d for lane in tl.get(\"lanes\", []) for e in lane.get(\"events\", [])\n194\t              for raw in (e.get(\"t\"), e.get(\"t_end\")) if (d := _parse_dt(raw))]\n195\t    if not stamps:\n196\t        return tl\n197\t    newest = max(stamps)\n198\t    cutoff = newest - timedelta(days=days)\n199\t\n200\t    new_lanes, odos = [], []\n201\t    for lane in tl.get(\"lanes\", []):\n202\t        kept = []\n203\t        for e in lane.get(\"events\", []):\n204\t            t_d, te_d = _parse_dt(e.get(\"t\")), _parse_dt(e.get(\"t_end\"))\n205\t            if (t_d and t_d >= cutoff) or (te_d and te_d >= cutoff):\n206\t                kept.append(e)\n207\t                if isinstance(e.get(\"odo\"), (int, float)):\n208\t                    odos.append(e[\"odo\"])\n209\t        new_lanes.append({**lane, \"events\": kept})\n210\t\n211\t    new_range = dict(tl.get(\"range\") or {})\n212\t    new_range[\"start\"] = cutoff.isoformat()\n213\t    new_range[\"end\"] = newest.isoformat()\n214\t    if odos:\n215\t        new_range[\"odo_start\"], new_range[\"odo_end\"] = min(odos), max(odos)\n216\t    return {**tl, \"lanes\": new_lanes, \"range\": new_range}\n217\t\n218\t\n219\t# --- correlation-row sparklines -----------------------------------------\n220\t\n221\tdef _month_buckets(tl: dict[str, Any]) -> list[datetime]:\n222\t    rng = tl.get(\"range\") or {}\n223\t    lo, hi = _parse_dt(rng.get(\"start\")), _parse_dt(rng.get(\"end\"))\n224\t    if not lo or not hi:\n225\t        return []\n226\t    months, cur, end = [], lo.replace(day=1), hi.replace(day=1)\n227\t    while cur <= end and len(months) < 36:\n228\t        months.append(cur)\n229\t        cur = (cur.replace(day=28) + timedelta(days=4)).replace(day=1)\n230\t    return months or [lo]\n231\t\n232\t\n233\tdef _bucket_counts(events: list[dict[str, Any]], months: list[datetime]) -> list[int]:\n234\t    counts = [0] * len(months)\n235\t    for e in events:\n236\t        d = _parse_dt(e.get(\"t\"))\n237\t        if d is None:\n238\t            continue\n239\t        for i in range(len(months) - 1, -1, -1):\n240\t            if d >= months[i]:\n241\t                counts[i] += 1\n242\t                break\n243\t    return counts\n244\t\n245\t\n246\tdef _attach_sparklines(tl: dict[str, Any]) -> None:\n247\t    \"\"\"Mutates each ``correlation`` row in place, adding ``row[\"spark\"]``:\n248\t    a tiny inline SVG (occurrence bars + symptom-report dots per month).\n249\t    A visual at-a-glance companion to the row's own scalar counts, not a\n250\t    re-derivation of them -- it buckets straight from the timeline's own\n251\t    lanes, which the correlation table's numbers were computed from too.\"\"\"\n252\t    months = _month_buckets(tl)\n253\t    if not months:\n254\t        for row in tl.get(\"correlation\", []):\n255\t            row[\"spark\"] = \"\"\n256\t        return\n257\t    bar_events, symptom_events = [], []\n258\t    for lane in tl.get(\"lanes\", []):\n259\t        if lane.get(\"id\") == \"symptoms\":\n260\t            symptom_events = [e for e in lane.get(\"events\", []) if e.get(\"severity\") == \"symptom\"]\n261\t        elif (lane.get(\"kind\") or \"bars\") == \"bars\":\n262\t            bar_events += lane.get(\"events\", [])\n263\t    sym_counts = _bucket_counts(symptom_events, months)\n264\t    for row in tl.get(\"correlation\", []):\n265\t        codes = set(row.get(\"codes\") or [])\n266\t        # A bars-lane event's ``label`` is sometimes a single code and\n267\t        # sometimes a \"/\"-joined set of codes that set together in one\n268\t        # session (see cuore.services.timeline_bridge's \"network\" lane) --\n269\t        # match on overlap, not equality, so a family's sparkline still\n270\t        # picks those up.\n271\t        matched = [e for e in bar_events\n272\t                  if set(str(e.get(\"label\") or \"\").split(\"/\")) & codes]\n273\t        occ_counts = _bucket_counts(matched, months)\n274\t        row[\"spark\"] = timeline_svg.sparkline(occ_counts, sym_counts)\n275\t\n276\t\n277\tdef _verdict_class(verdict: str) -> str:\n278\t    v = (verdict or \"\").lower()\n279\t    if \"co-occur\" in v or \"co occur\" in v:\n280\t        return \"chronic\"   # amber\n281\t    return \"plain\"         # grey-neutral\n282\t\n283\t\n284\t# --- the page ------------------------------------------------------------\n285\t\n286\t\n287\t@router.get(\"/v/{vin}/timeline\", response_class=HTMLResponse)\n288\tdef timeline_page(request: Request, vin: str, axis: str = \"time\",\n289\t                  range: str = \"all\", saved: str = \"\", error: str = \"\") -> HTMLResponse:\n290\t    \"\"\"Swimlane timeline: every code family's presence beside every\n291\t    recorded driver symptom, note and repair -- so \"does this car actually\n292\t    feel wrong\" can be read off against \"what the logs say\" at a glance.\"\"\"\n293\t    axis = axis if axis in (\"time\", \"odometer\") else \"time\"\n294\t    dossier = _dossier(vin)\n295\t    tl = _timeline(vin)\n296\t    tl = _apply_range(tl, range)\n297\t    _attach_sparklines(tl)\n298\t    for row in tl.get(\"correlation\", []):\n299\t        row[\"verdict_class\"] = _verdict_class(row.get(\"verdict\", \"\"))\n300\t\n301\t    svg = timeline_svg.render(tl, axis=axis, width=1000)\n302\t    layout = timeline_svg.lane_layout(tl)\n303\t\n304\t    response = _page(request, \"timeline.html\", vin=vin, tl=tl, svg=svg, layout=layout,\n305\t                     axis=axis, range_key=range, bar=_vehicle_bar(vin, dossier),\n306\t                     tab=\"timeline\", saved=bool(saved), symptom_error=error,\n307\t                     symptom_tags=tl.get(\"symptom_tags\") or SYMPTOM_TAGS,\n308\t                     condition_tags=tl.get(\"conditions\") or CONDITION_TAGS,\n309\t                     note_redirect=f\"/v/{vin}/timeline\",\n310\t                     now_local=datetime.now().strftime(\"%Y-%m-%dT%H:%M\"))\n311\t    _set_active_vehicle(response, vin)\n312\t    return response\n313\t\n314\t\n315\t# --- symptom entry --------------------------------------------------------\n316\t\n317\tdef _save_symptom(vin: str, data: dict[str, Any]) -> Optional[str]:\n318\t    \"\"\"Record one symptom report. Returns an error string, or ``None`` on\n319\t    success. The contract names the JSON route\n320\t    (``POST /api/vehicles/{vin}/symptoms``) that another agent is building\n321\t    in ``cuore.api``; this form posts internally to the bridge function\n322\t    rather than making an HTTP call to itself. The exact function name was\n323\t    not pinned down in the contract handed to this page, so this tries the\n324\t    plausible candidates and fails soft (with a clear message) until the\n325\t    real one lands -- nothing here needs to change once it does, as long as\n326\t    it is named one of these or added as a fourth alias.\"\"\"\n327\t    bridge = _bridge()\n328\t    if bridge is None:\n329\t        return \"symptom recording is not available yet (timeline_bridge is not built)\"\n330\t    fn = (getattr(bridge, \"add_symptom\", None) or getattr(bridge, \"record_symptom\", None)\n331\t          or getattr(bridge, \"log_symptom\", None))\n332\t    if fn is None:\n333\t        return \"symptom recording is not available yet (no add/record/log_symptom on timeline_bridge)\"\n334\t    try:\n335\t        fn(vin, **data)\n336\t    except BridgeError as exc:\n337\t        return str(exc)\n338\t    except Exception as exc:  # noqa: BLE001 -- a bad form post must redirect, not 500\n339\t        return str(exc)\n340\t    return None\n341\t\n342\t\n343\t@router.post(\"/v/{vin}/symptoms\", response_class=HTMLResponse)\n344\tasync def symptoms_submit(request: Request, vin: str) -> RedirectResponse:\n345\t    \"\"\"The symptom form's target. Degrades like every other form in this\n346\t    app (``/v/{vin}/notes``, ``/v/{vin}/gate``): parallel checkbox fields,\n347\t    no JavaScript required, redirects back with a flash rather than\n348\t    re-rendering so a reload cannot double-submit.\"\"\"\n349\t    form = await request.form()\n350\t    redirect_base = str(form.get(\"redirect_to\", \"\") or f\"/v/{vin}/timeline\")\n351\t    if not redirect_base.startswith(\"/\") or redirect_base.startswith(\"//\"):\n352\t        redirect_base = f\"/v/{vin}/timeline\"\n353\t\n354\t    at = str(form.get(\"at\", \"\")).strip() or datetime.now().isoformat(timespec=\"minutes\")\n355\t    reporter = str(form.get(\"reporter\", \"driver\")).strip() or \"driver\"\n356\t    tags = [t.strip() for t in form.getlist(\"tags\") if t.strip()]\n357\t    conditions = [c.strip() for c in form.getlist(\"conditions\") if c.strip()]\n358\t    text = str(form.get(\"text\", \"\")).strip()\n359\t    odometer_raw = str(form.get(\"odometer_km\", \"\")).strip()\n360\t\n361\t    error = None\n362\t    if reporter not in (\"driver\", \"mechanic\"):\n363\t        error = \"reporter must be 'driver' or 'mechanic'\"\n364\t    elif not tags:\n365\t        error = \"pick at least one tag -- 'Drives normally' counts as evidence too\"\n366\t\n367\t    odometer_km: Optional[float] = None\n368\t    if error is None and odometer_raw:\n369\t        try:\n370\t            odometer_km = float(odometer_raw)\n371\t        except ValueError:\n372\t            error = f\"odometer must be a number, got {odometer_raw!r}\"\n373\t\n374\t    if error is None:\n375\t        payload: dict[str, Any] = {\"at\": at, \"reporter\": reporter, \"tags\": tags,\n376\t                                   \"conditions\": conditions}\n377\t        if odometer_km is not None:\n378\t            payload[\"odometer_km\"] = odometer_km\n379\t        if text:\n380\t            payload[\"text\"] = text\n381\t        error = _save_symptom(vin, payload)\n382\t\n383\t    sep = \"&\" if \"?\" in redirect_base else \"?\"\n384\t    url = f\"{redirect_base}{sep}{'saved=1' if error is None else 'error=' + quote(error)}\"\n385\t    return RedirectResponse(url=url, status_code=303)\n386\t\n387\t\n388\t__all__ = [\"router\"]\n389\t"}]},"uuid":"2512f263-64e2-415c-9e03-2e1969eb92d1","timestamp":"2026-10-08T02:41:55.742Z","toolUseResult":{"type":"text","file":{"filePath":"C:\\Users\\User\\mcp-servers\\cuore\\web\\timeline_routes.py","content":"\"\"\"``GET /v/{vin}/timeline``: \"Codes vs. what the driver notices\".\n\nSame posture as :mod:`cuore.web.dashboard_routes` and :mod:`cuore.web.\nservice_routes` (both built the same way, concurrently with other agents):\na separate router, reusing ``_dossier``/``_vehicle_bar``/``_page``/\n``_set_active_vehicle`` from :mod:`cuore.web.routes` by import rather than\nduplicating that plumbing.\n\nThe data contract lives in ``cuore.services.timeline_bridge``\n(``build_timeline(vin)``, ``code_feel(vin, code)``), built in parallel by\nanother agent and not necessarily present yet. Every call into it is\nwrapped and falls back to ``_FIXTURE`` (built to the exact shape the\ncontract specifies) so this page, and ``code.html``'s feel card, are\ndevelopable and testable before that module lands. Once it exists, nothing\nhere needs to change -- the lazy import just starts succeeding.\n\nNot registered on the app here -- ``app.py`` is owned by another agent\nwhile this was built. The two lines needed there:\n\n    ``from .web import timeline_routes``\n    ``app.include_router(timeline_routes.router)``\n\n(next to the other ``web`` router imports/includes.)\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom datetime import datetime, timedelta\nfrom typing import Any, Optional\nfrom urllib.parse import quote\n\nfrom fastapi import APIRouter, Depends, Request\nfrom fastapi.responses import HTMLResponse, RedirectResponse\n\nfrom ..services import cache, mes_bridge\nfrom ..services.errors import BridgeError\nfrom ..api.deps import require_token\nfrom . import timeline_svg\nfrom .routes import _dossier, _page, _set_active_vehicle, _vehicle_bar\nfrom .routes import templates as _shared_templates\n\nrouter = APIRouter(include_in_schema=False, dependencies=[Depends(require_token)])\n\nSYMPTOM_TAGS = [\"drives_normally\", \"mil_on\", \"fuel_smell\", \"hard_start\", \"rough_idle\",\n               \"hesitation\", \"loss_of_power\", \"hard_to_refuel\", \"noise\", \"vibration\",\n               \"warning_message\", \"other\"]\nCONDITION_TAGS = [\"cold_start\", \"hot\", \"just_refuelled\", \"highway\", \"city\", \"idle\", \"rain\"]\n\n_RANGE_DAYS = {\"1y\": 365, \"90d\": 90, \"30d\": 30}\n\n\n# --- fixture: the exact shape cuore.services.timeline_bridge.build_timeline\n# will return, used until that module lands (or for any VIN it does not yet\n# cover). ---------------------------------------------------------------\n\ndef _fixture_timeline(vin: str) -> dict[str, Any]:\n    return {\n        \"vin\": vin,\n        \"range\": {\"start\": \"2025-09-24T00:00:00\", \"end\": \"2026-10-04T11:16:00\",\n                  \"odo_start\": 115790, \"odo_end\": 142290},\n        \"lanes\": [\n            {\"id\": \"mil\", \"label\": \"MIL\", \"kind\": \"bars\", \"events\": [\n                {\"t\": \"2025-09-24T00:00:00\", \"t_end\": \"2026-08-27T00:00:00\", \"odo\": 115800,\n                 \"label\": \"MIL\", \"detail\": \"lamp on, EVAP family\", \"severity\": \"active\",\n                 \"href\": None, \"count\": 11},\n            ]},\n            {\"id\": \"evap\", \"label\": \"EVAP\", \"kind\": \"bars\", \"events\": [\n                {\"t\": \"2025-09-24T00:00:00\", \"t_end\": \"2026-08-27T00:00:00\", \"odo\": 115800,\n                 \"label\": \"P0456\", \"detail\": \"EVAP small leak\", \"severity\": \"cleared\",\n                 \"href\": f\"/v/{vin}/code/P0456\", \"count\": 11},\n            ]},\n            {\"id\": \"network\", \"label\": \"Network\", \"kind\": \"bars\", \"events\": [\n                {\"t\": \"2026-01-15T00:00:00\", \"t_end\": None, \"odo\": 128000,\n                 \"label\": \"U0100\", \"detail\": \"lost comms with ECM\", \"severity\": \"active\",\n                 \"href\": f\"/v/{vin}/code/U0100\", \"count\": 2},\n            ]},\n            {\"id\": \"body\", \"label\": \"Body\", \"kind\": \"bars\", \"events\": []},\n            {\"id\": \"chassis\", \"label\": \"Chassis\", \"kind\": \"bars\", \"events\": []},\n            {\"id\": \"engine_other\", \"label\": \"Engine (other)\", \"kind\": \"bars\", \"events\": []},\n            {\"id\": \"clears\", \"label\": \"Clears\", \"kind\": \"lines\", \"events\": [\n                {\"t\": \"2026-08-27T00:00:00\", \"t_end\": None, \"odo\": 138000,\n                 \"label\": \"cleared\", \"detail\": \"P0440/P0455/P0456 cleared (MultiEcuScan)\",\n                 \"severity\": \"cleared\", \"href\": None},\n            ]},\n            {\"id\": \"symptoms\", \"label\": \"Symptoms\", \"kind\": \"points\", \"events\": []},\n            {\"id\": \"notes\", \"label\": \"Notes\", \"kind\": \"points\", \"events\": []},\n            {\"id\": \"work\", \"label\": \"Work\", \"kind\": \"points\", \"events\": [\n                {\"t\": \"2026-09-15T21:18:00\", \"t_end\": None, \"odo\": 138900,\n                 \"label\": \"Evaporation control valve\", \"detail\": \"FAILED TO EXECUTE (engine running)\",\n                 \"severity\": \"work\", \"href\": None},\n                {\"t\": \"2026-09-15T21:30:00\", \"t_end\": None, \"odo\": 138900,\n                 \"label\": \"Evaporation control valve\", \"detail\": \"completed, key-on engine-off\",\n                 \"severity\": \"work\", \"href\": None},\n            ]},\n            {\"id\": \"conditions\", \"label\": \"Conditions\", \"kind\": \"points\", \"events\": [\n                {\"t\": \"2025-09-24T00:00:00\", \"t_end\": None, \"odo\": 115800,\n                 \"label\": \"freeze frame\", \"detail\": \"fuel 93.7%, engine temp 89 C\",\n                 \"severity\": \"warn\", \"href\": None},\n            ]},\n        ],\n        \"correlation\": [\n            {\"family\": \"EVAP\", \"codes\": [\"P0440\", \"P0455\", \"P0456\"], \"occurrences\": 11,\n             \"symptom_reports_near\": 0, \"by_tag\": {}, \"drives_normally_near\": 0,\n             \"window_days\": 7, \"verdict\": \"no reported symptom\"},\n            {\"family\": \"NETWORK\", \"codes\": [\"U0100\", \"U0101\"], \"occurrences\": 2,\n             \"symptom_reports_near\": 0, \"by_tag\": {}, \"drives_normally_near\": 0,\n             \"window_days\": 7, \"verdict\": \"no reported symptom\"},\n        ],\n        \"findings\": [\n            \"EVAP (P0440/P0455/P0456) has set 11 times over 26,500 km with no symptom \"\n            \"ever reported near a sighting -- consistent with the TSB 18-030-17 \"\n            \"calibration read, not a drivability complaint.\",\n            \"No driver symptom report exists in the log for this vehicle yet -- use the \"\n            \"symptom form below after every drive, including 'drives normally'.\",\n        ],\n        \"symptom_tags\": SYMPTOM_TAGS,\n        \"conditions\": CONDITION_TAGS,\n    }\n\n\ndef _fixture_code_feel(vin: str, code: str) -> dict[str, Any]:\n    code = (code or \"\").upper()\n    if code in (\"P0456\", \"P0440\", \"P0455\"):\n        return {\n            \"feel\": {\n                \"feel\": \"Usually nothing -- EVAP small/large leaks are almost always silent \"\n                        \"to the driver.\",\n                \"expect\": [\"no drivability change\", \"MIL after 2 failed drive cycles\"],\n                \"not_expected\": [\"rough idle\", \"loss of power\", \"stalling\"],\n                \"mil\": \"check-engine light after two failed drives of the EVAP monitor\",\n                \"notes\": \"A fuel-smell report alongside this code is unusual and worth a \"\n                         \"real leak check rather than assuming it is this code.\",\n                \"confidence\": \"high\", \"source\": \"mes/dtc_feel.yaml\",\n            },\n            \"pattern\": {\"occurrences\": 11, \"symptom_reports_near\": 0, \"by_tag\": {},\n                       \"drives_normally_near\": 0},\n        }\n    return {\"feel\": None, \"pattern\": {\"occurrences\": 0, \"symptom_reports_near\": 0,\n                                      \"by_tag\": {}, \"drives_normally_near\": 0}}\n\n\ndef _bridge():\n    \"\"\"``cuore.services.timeline_bridge``, or ``None`` if it has not landed.\"\"\"\n    try:\n        from ..services import timeline_bridge\n        return timeline_bridge\n    except ImportError:\n        return None\n\n\ndef _timeline(vin: str) -> dict[str, Any]:\n    bridge = _bridge()\n    if bridge is None:\n        return _fixture_timeline(vin)\n    return cache.get_or_build(\n        (\"timeline\", vin, mes_bridge.newest_mtime(vin)),\n        lambda: bridge.build_timeline(vin))\n\n\ndef _code_feel_data(vin: str, code: str) -> dict[str, Any]:\n    bridge = _bridge()\n    if bridge is None:\n        return _fixture_code_feel(vin, code)\n    try:\n        return bridge.code_feel(vin, code)\n    except Exception:  # noqa: BLE001 -- a knowledge-table miss must never 500 a code page\n        return {\"feel\": None, \"pattern\": None}\n\n\n_shared_templates.env.globals[\"code_feel\"] = _code_feel_data\n\n\n# --- range/zoom filtering ---------------------------------------------\n\ndef _parse_dt(ts: Any) -> Optional[datetime]:\n    if not ts:\n        return None\n    s = str(ts).strip().replace(\" \", \"T\")[:19]\n    try:\n        return datetime.fromisoformat(s)\n    except ValueError:\n        return None\n\n\ndef _apply_range(tl: dict[str, Any], range_key: str) -> dict[str, Any]:\n    \"\"\"Zoom presets (?range=1y|90d|30d) filter every lane's events to a\n    window before the newest timestamp in the timeline, and narrow\n    ``range`` to match -- otherwise the chart's axis would still span the\n    whole car even though the events on it had been cut down to a month.\"\"\"\n    days = _RANGE_DAYS.get(range_key)\n    if not days:\n        return tl\n    stamps = [d for lane in tl.get(\"lanes\", []) for e in lane.get(\"events\", [])\n              for raw in (e.get(\"t\"), e.get(\"t_end\")) if (d := _parse_dt(raw))]\n    if not stamps:\n        return tl\n    newest = max(stamps)\n    cutoff = newest - timedelta(days=days)\n\n    new_lanes, odos = [], []\n    for lane in tl.get(\"lanes\", []):\n        kept = []\n        for e in lane.get(\"events\", []):\n            t_d, te_d = _parse_dt(e.get(\"t\")), _parse_dt(e.get(\"t_end\"))\n            if (t_d and t_d >= cutoff) or (te_d and te_d >= cutoff):\n                kept.append(e)\n                if isinstance(e.get(\"odo\"), (int, float)):\n                    odos.append(e[\"odo\"])\n        new_lanes.append({**lane, \"events\": kept})\n\n    new_range = dict(tl.get(\"range\") or {})\n    new_range[\"start\"] = cutoff.isoformat()\n    new_range[\"end\"] = newest.isoformat()\n    if odos:\n        new_range[\"odo_start\"], new_range[\"odo_end\"] = min(odos), max(odos)\n    return {**tl, \"lanes\": new_lanes, \"range\": new_range}\n\n\n# --- correlation-row sparklines -----------------------------------------\n\ndef _month_buckets(tl: dict[str, Any]) -> list[datetime]:\n    rng = tl.get(\"range\") or {}\n    lo, hi = _parse_dt(rng.get(\"start\")), _parse_dt(rng.get(\"end\"))\n    if not lo or not hi:\n        return []\n    months, cur, end = [], lo.replace(day=1), hi.replace(day=1)\n    while cur <= end and len(months) < 36:\n        months.append(cur)\n        cur = (cur.replace(day=28) + timedelta(days=4)).replace(day=1)\n    return months or [lo]\n\n\ndef _bucket_counts(events: list[dict[str, Any]], months: list[datetime]) -> list[int]:\n    counts = [0] * len(months)\n    for e in events:\n        d = _parse_dt(e.get(\"t\"))\n        if d is None:\n            continue\n        for i in range(len(months) - 1, -1, -1):\n            if d >= months[i]:\n                counts[i] += 1\n                break\n    return counts\n\n\ndef _attach_sparklines(tl: dict[str, Any]) -> None:\n    \"\"\"Mutates each ``correlation`` row in place, adding ``row[\"spark\"]``:\n    a tiny inline SVG (occurrence bars + symptom-report dots per month).\n    A visual at-a-glance companion to the row's own scalar counts, not a\n    re-derivation of them -- it buckets straight from the timeline's own\n    lanes, which the correlation table's numbers were computed from too.\"\"\"\n    months = _month_buckets(tl)\n    if not months:\n        for row in tl.get(\"correlation\", []):\n            row[\"spark\"] = \"\"\n        return\n    bar_events, symptom_events = [], []\n    for lane in tl.get(\"lanes\", []):\n        if lane.get(\"id\") == \"symptoms\":\n            symptom_events = [e for e in lane.get(\"events\", []) if e.get(\"severity\") == \"symptom\"]\n        elif (lane.get(\"kind\") or \"bars\") == \"bars\":\n            bar_events += lane.get(\"events\", [])\n    sym_counts = _bucket_counts(symptom_events, months)\n    for row in tl.get(\"correlation\", []):\n        codes = set(row.get(\"codes\") or [])\n        # A bars-lane event's ``label`` is sometimes a single code and\n        # sometimes a \"/\"-joined set of codes that set together in one\n        # session (see cuore.services.timeline_bridge's \"network\" lane) --\n        # match on overlap, not equality, so a family's sparkline still\n        # picks those up.\n        matched = [e for e in bar_events\n                  if set(str(e.get(\"label\") or \"\").split(\"/\")) & codes]\n        occ_counts = _bucket_counts(matched, months)\n        row[\"spark\"] = timeline_svg.sparkline(occ_counts, sym_counts)\n\n\ndef _verdict_class(verdict: str) -> str:\n    v = (verdict or \"\").lower()\n    if \"co-occur\" in v or \"co occur\" in v:\n        return \"chronic\"   # amber\n    return \"plain\"         # grey-neutral\n\n\n# --- the page ------------------------------------------------------------\n\n\n@router.get(\"/v/{vin}/timeline\", response_class=HTMLResponse)\ndef timeline_page(request: Request, vin: str, axis: str = \"time\",\n                  range: str = \"all\", saved: str = \"\", error: str = \"\") -> HTMLResponse:\n    \"\"\"Swimlane timeline: every code family's presence beside every\n    recorded driver symptom, note and repair -- so \"does this car actually\n    feel wrong\" can be read off against \"what the logs say\" at a glance.\"\"\"\n    axis = axis if axis in (\"time\", \"odometer\") else \"time\"\n    dossier = _dossier(vin)\n    tl = _timeline(vin)\n    tl = _apply_range(tl, range)\n    _attach_sparklines(tl)\n    for row in tl.get(\"correlation\", []):\n        row[\"verdict_class\"] = _verdict_class(row.get(\"verdict\", \"\"))\n\n    svg = timeline_svg.render(tl, axis=axis, width=1000)\n    layout = timeline_svg.lane_layout(tl)\n\n    response = _page(request, \"timeline.html\", vin=vin, tl=tl, svg=svg, layout=layout,\n                     axis=axis, range_key=range, bar=_vehicle_bar(vin, dossier),\n                     tab=\"timeline\", saved=bool(saved), symptom_error=error,\n                     symptom_tags=tl.get(\"symptom_tags\") or SYMPTOM_TAGS,\n                     condition_tags=tl.get(\"conditions\") or CONDITION_TAGS,\n                     note_redirect=f\"/v/{vin}/timeline\",\n                     now_local=datetime.now().strftime(\"%Y-%m-%dT%H:%M\"))\n    _set_active_vehicle(response, vin)\n    return response\n\n\n# --- symptom entry --------------------------------------------------------\n\ndef _save_symptom(vin: str, data: dict[str, Any]) -> Optional[str]:\n    \"\"\"Record one symptom report. Returns an error string, or ``None`` on\n    success. The contract names the JSON route\n    (``POST /api/vehicles/{vin}/symptoms``) that another agent is building\n    in ``cuore.api``; this form posts internally to the bridge function\n    rather than making an HTTP call to itself. The exact function name was\n    not pinned down in the contract handed to this page, so this tries the\n    plausible candidates and fails soft (with a clear message) until the\n    real one lands -- nothing here needs to change once it does, as long as\n    it is named one of these or added as a fourth alias.\"\"\"\n    bridge = _bridge()\n    if bridge is None:\n        return \"symptom recording is not available yet (timeline_bridge is not built)\"\n    fn = (getattr(bridge, \"add_symptom\", None) or getattr(bridge, \"record_symptom\", None)\n          or getattr(bridge, \"log_symptom\", None))\n    if fn is None:\n        return \"symptom recording is not available yet (no add/record/log_symptom on timeline_bridge)\"\n    try:\n        fn(vin, **data)\n    except BridgeError as exc:\n        return str(exc)\n    except Exception as exc:  # noqa: BLE001 -- a bad form post must redirect, not 500\n        return str(exc)\n    return None\n\n\n@router.post(\"/v/{vin}/symptoms\", response_class=HTMLResponse)\nasync def symptoms_submit(request: Request, vin: str) -> RedirectResponse:\n    \"\"\"The symptom form's target. Degrades like every other form in this\n    app (``/v/{vin}/notes``, ``/v/{vin}/gate``): parallel checkbox fields,\n    no JavaScript required, redirects back with a flash rather than\n    re-rendering so a reload cannot double-submit.\"\"\"\n    form = await request.form()\n    redirect_base = str(form.get(\"redirect_to\", \"\") or f\"/v/{vin}/timeline\")\n    if not redirect_base.startswith(\"/\") or redirect_base.startswith(\"//\"):\n        redirect_base = f\"/v/{vin}/timeline\"\n\n    at = str(form.get(\"at\", \"\")).strip() or datetime.now().isoformat(timespec=\"minutes\")\n    reporter = str(form.get(\"reporter\", \"driver\")).strip() or \"driver\"\n    tags = [t.strip() for t in form.getlist(\"tags\") if t.strip()]\n    conditions = [c.strip() for c in form.getlist(\"conditions\") if c.strip()]\n    text = str(form.get(\"text\", \"\")).strip()\n    odometer_raw = str(form.get(\"odometer_km\", \"\")).strip()\n\n    error = None\n    if reporter not in (\"driver\", \"mechanic\"):\n        error = \"reporter must be 'driver' or 'mechanic'\"\n    elif not tags:\n        error = \"pick at least one tag -- 'Drives normally' counts as evidence too\"\n\n    odometer_km: Optional[float] = None\n    if error is None and odometer_raw:\n        try:\n            odometer_km = float(odometer_raw)\n        except ValueError:\n            error = f\"odometer must be a number, got {odometer_raw!r}\"\n\n    if error is None:\n        payload: dict[str, Any] = {\"at\": at, \"reporter\": reporter, \"tags\": tags,\n                                   \"conditions\": conditions}\n        if odometer_km is not None:\n            payload[\"odometer_km\"] = odometer_km\n        if text:\n            payload[\"text\"] = text\n        error = _save_symptom(vin, payload)\n\n    sep = \"&\" if \"?\" in redirect_base else \"?\"\n    url = f\"{redirect_base}{sep}{'saved=1' if error is None else 'error=' + quote(error)}\"\n    return RedirectResponse(url=url, status_code=303)\n\n\n__all__ = [\"router\"]\n","numLines":389,"startLine":1,"totalLines":389}},"sourceToolAssistantUUID":"fa87d8e4-d117-4a96-a2d6-1a8061c6eda1","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
{"parentUuid":"2512f263-64e2-415c-9e03-2e1969eb92d1","isSidechain":true,"agentId":"aa1325351951d62ee","message":{"model":"claude-sonnet-5","id":"msg_011CfoztPafVNP2sdJ8Wf3C9","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01FzQtBTx8mna4PuFZsw6GXs","name":"Read","input":{"file_path":"C:\\Users\\User\\mcp-servers\\cuore\\web\\templates\\_vbar.html"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":5692,"cache_read_input_tokens":57205,"cache_creation":{"ephemeral_5m_input_tokens":5692,"ephemeral_1h_input_tokens":0},"output_tokens":2,"service_tier":"standard","inference_geo":"not_available"},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_01FzQtBTx8mna4PuFZsw6GXs":{"file_path":"C:\\Users\\User\\mcp-servers\\cuore\\web\\templates\\_vbar.html"}},"serverClassifierRequest":"0b8ef2c8-be20-4314-8b45-92c5c2b29bde","apiBlockIndex":3,"requestId":"req_011CfoztPLXKVq3E86KZpSeM","attributionAgent":"general-purpose","type":"assistant","uuid":"d1adb5a6-eb75-4bae-b49c-1ef20552348d","timestamp":"2026-10-08T02:41:56.223Z","effort":"high","perTurnEffort":null,"userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
{"parentUuid":"d1adb5a6-eb75-4bae-b49c-1ef20552348d","isSidechain":true,"promptId":"bbc43356-430e-40a9-a14e-41404b640377","agentId":"aa1325351951d62ee","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01FzQtBTx8mna4PuFZsw6GXs","type":"tool_result","content":"1\t{# Sticky vehicle context. Included by every /v/ page so which car you are\n2\t   looking at never scrolls out of sight -- and, per the mechanic-UX review,\n3\t   merged with the live-link chip so a vehicle page shows only ONE sticky\n4\t   strip (plus the tab row) instead of two. Full VIN, log counts and the\n5\t   date range move behind the \"...\" tap so the visible line stays short\n6\t   enough to read at a glance, gloves on.\n7\t\n8\t   Context expected: bar (vin, name, logs, first_log, last_log, odo_first,\n9\t   odo_last, odo_span, ecus), tab (which tab is active), live_strip (set for\n10\t   every page by routes.py's _page() helper -- already in scope here via\n11\t   Jinja's include-shares-context, no route change needed). #}\n12\t<div class=\"vbar\">\n13\t  <div class=\"vline\">\n14\t    <span class=\"vname\" title=\"{{ bar.name }}\">{{ bar.name }}</span>\n15\t    <span class=\"vin-tail mono\" title=\"{{ bar.vin }}\">&hellip;{{ bar.vin[-6:] }}</span>\n16\t    {% if bar.odo_last is not none %}\n17\t      <span class=\"mono vkm\">{{ \"{:,}\".format(bar.odo_last|int) }} km</span>\n18\t    {% endif %}\n19\t    {% if live_strip %}\n20\t      {% if live_strip.error %}\n21\t        <span class=\"chip plain\" title=\"{{ live_strip.error }}\">MES ?</span>\n22\t      {% else %}\n23\t        <span class=\"chip {{ 'ok' if live_strip.mes_state != 'connected' else 'returned' }}\"\n24\t              title=\"MES {{ live_strip.mes_state or 'unknown' }}\">MES {{ (live_strip.mes_state or '?')|truncate(10, True, '') }}</span>\n25\t        <span class=\"chip plain\" title=\"{{ live_strip.buses_verified }}/{{ live_strip.buses_total }} buses verified\">\n26\t          Live {{ live_strip.buses_verified }}/{{ live_strip.buses_total }}</span>\n27\t      {% endif %}\n28\t    {% endif %}\n29\t    <details class=\"vmore\">\n30\t      <summary aria-label=\"More vehicle details\">&hellip;</summary>\n31\t      <div class=\"vmore-panel\">\n32\t        <div class=\"small\">Full VIN <span class=\"mono\">{{ bar.vin }}</span></div>\n33\t        {% if bar.odo_first is not none and bar.odo_last is not none %}\n34\t          <div class=\"small\">{{ \"{:,}\".format(bar.odo_first|int) }} &rarr;\n35\t            {{ \"{:,}\".format(bar.odo_last|int) }} km{% if bar.odo_span %}\n36\t            <span class=\"muted\">({{ \"{:,}\".format(bar.odo_span|int) }} km span)</span>{% endif %}</div>\n37\t        {% endif %}\n38\t        {% if bar.logs %}\n39\t          <div class=\"small\"><b>{{ bar.logs }}</b> logs{% if bar.first_log %}\n40\t            &middot; {{ bar.first_log }} &rarr; {{ bar.last_log }}{% endif %}</div>\n41\t        {% endif %}\n42\t        {% if bar.ecus %}<div class=\"small\">{{ bar.ecus|length }} ECU{{ \"s\" if bar.ecus|length != 1 }}</div>{% endif %}\n43\t        {% if live_strip and not live_strip.error %}\n44\t          <div class=\"small mono\">{{ live_strip.port or 'no port' }}{% if live_strip.baud %}@{{ live_strip.baud }}{% endif %}\n45\t            &middot; cable {{ live_strip.cable or 'none' }}</div>\n46\t          {% if live_strip.lock_holder and live_strip.lock_holder != 'cuore' %}\n47\t            <div class=\"small\">held by {{ live_strip.lock_holder }}</div>\n48\t          {% endif %}\n49\t        {% endif %}\n50\t        <div class=\"small\"><a href=\"/live\">Live link &rarr;</a></div>\n51\t      </div>\n52\t    </details>\n53\t  </div>\n54\t  <div class=\"vtabs\">\n55\t    <a href=\"/v/{{ bar.vin }}\" {% if tab == \"dossier\" %}class=\"on\"{% endif %}>Dossier</a>\n56\t    <a href=\"/v/{{ bar.vin }}/timeline\" {% if tab == \"timeline\" %}class=\"on\"{% endif %}>Timeline</a>\n57\t    <a href=\"/v/{{ bar.vin }}/media\" {% if tab == \"media\" %}class=\"on\"{% endif %}>Media</a>\n58\t    <a href=\"/v/{{ bar.vin }}/parts\" {% if tab == \"parts\" %}class=\"on\"{% endif %}>Parts</a>\n59\t    <a href=\"/v/{{ bar.vin }}/dashboard\" {% if tab == \"dashboard\" %}class=\"on\"{% endif %}>Dashboard</a>\n60\t    <a href=\"/v/{{ bar.vin }}/gauges\" {% if tab == \"gauges\" %}class=\"on\"{% endif %}>Gauges</a>\n61\t    <a href=\"/v/{{ bar.vin }}/codes\" {% if tab == \"codes\" %}class=\"on\"{% endif %}>Codes</a>\n62\t    <a href=\"/v/{{ bar.vin }}/tree\" {% if tab == \"tree\" %}class=\"on\"{% endif %}>Fault tree</a>\n63\t    <a href=\"/v/{{ bar.vin }}/gate\" {% if tab == \"gate\" %}class=\"on\"{% endif %}>Evidence gate</a>\n64\t    <a href=\"/v/{{ bar.vin }}/service-hub\" {% if tab == \"service-hub\" %}class=\"on\"{% endif %}>Service</a>\n65\t    <a href=\"/v/{{ bar.vin }}/report\" {% if tab == \"report\" %}class=\"on\"{% endif %}>Report</a>\n66\t    {% set _fb_open = feedback_open_count(bar.vin) if feedback_open_count is defined else 0 %}\n67\t    <a href=\"/v/{{ bar.vin }}/inbox\" {% if tab == \"inbox\" %}class=\"on\"{% endif %}>Inbox{% if _fb_open %} <span class=\"chip chronic\">{{ _fb_open }}</span>{% endif %}</a>\n68\t    <a href=\"/logs?vin={{ bar.vin }}\">Logs</a>\n69\t  </div>\n70\t</div>\n71\t"}]},"uuid":"c315e209-d5a4-4092-8603-c18a59d69f77","timestamp":"2026-10-08T02:41:56.251Z","toolUseResult":{"type":"text","file":{"filePath":"C:\\Users\\User\\mcp-servers\\cuore\\web\\templates\\_vbar.html","content":"{# Sticky vehicle context. Included by every /v/ page so which car you are\n   looking at never scrolls out of sight -- and, per the mechanic-UX review,\n   merged with the live-link chip so a vehicle page shows only ONE sticky\n   strip (plus the tab row) instead of two. Full VIN, log counts and the\n   date range move behind the \"...\" tap so the visible line stays short\n   enough to read at a glance, gloves on.\n\n   Context expected: bar (vin, name, logs, first_log, last_log, odo_first,\n   odo_last, odo_span, ecus), tab (which tab is active), live_strip (set for\n   every page by routes.py's _page() helper -- already in scope here via\n   Jinja's include-shares-context, no route change needed). #}\n<div class=\"vbar\">\n  <div class=\"vline\">\n    <span class=\"vname\" title=\"{{ bar.name }}\">{{ bar.name }}</span>\n    <span class=\"vin-tail mono\" title=\"{{ bar.vin }}\">&hellip;{{ bar.vin[-6:] }}</span>\n    {% if bar.odo_last is not none %}\n      <span class=\"mono vkm\">{{ \"{:,}\".format(bar.odo_last|int) }} km</span>\n    {% endif %}\n    {% if live_strip %}\n      {% if live_strip.error %}\n        <span class=\"chip plain\" title=\"{{ live_strip.error }}\">MES ?</span>\n      {% else %}\n        <span class=\"chip {{ 'ok' if live_strip.mes_state != 'connected' else 'returned' }}\"\n              title=\"MES {{ live_strip.mes_state or 'unknown' }}\">MES {{ (live_strip.mes_state or '?')|truncate(10, True, '') }}</span>\n        <span class=\"chip plain\" title=\"{{ live_strip.buses_verified }}/{{ live_strip.buses_total }} buses verified\">\n          Live {{ live_strip.buses_verified }}/{{ live_strip.buses_total }}</span>\n      {% endif %}\n    {% endif %}\n    <details class=\"vmore\">\n      <summary aria-label=\"More vehicle details\">&hellip;</summary>\n      <div class=\"vmore-panel\">\n        <div class=\"small\">Full VIN <span class=\"mono\">{{ bar.vin }}</span></div>\n        {% if bar.odo_first is not none and bar.odo_last is not none %}\n          <div class=\"small\">{{ \"{:,}\".format(bar.odo_first|int) }} &rarr;\n            {{ \"{:,}\".format(bar.odo_last|int) }} km{% if bar.odo_span %}\n            <span class=\"muted\">({{ \"{:,}\".format(bar.odo_span|int) }} km span)</span>{% endif %}</div>\n        {% endif %}\n        {% if bar.logs %}\n          <div class=\"small\"><b>{{ bar.logs }}</b> logs{% if bar.first_log %}\n            &middot; {{ bar.first_log }} &rarr; {{ bar.last_log }}{% endif %}</div>\n        {% endif %}\n        {% if bar.ecus %}<div class=\"small\">{{ bar.ecus|length }} ECU{{ \"s\" if bar.ecus|length != 1 }}</div>{% endif %}\n        {% if live_strip and not live_strip.error %}\n          <div class=\"small mono\">{{ live_strip.port or 'no port' }}{% if live_strip.baud %}@{{ live_strip.baud }}{% endif %}\n            &middot; cable {{ live_strip.cable or 'none' }}</div>\n          {% if live_strip.lock_holder and live_strip.lock_holder != 'cuore' %}\n            <div class=\"small\">held by {{ live_strip.lock_holder }}</div>\n          {% endif %}\n        {% endif %}\n        <div class=\"small\"><a href=\"/live\">Live link &rarr;</a></div>\n      </div>\n    </details>\n  </div>\n  <div class=\"vtabs\">\n    <a href=\"/v/{{ bar.vin }}\" {% if tab == \"dossier\" %}class=\"on\"{% endif %}>Dossier</a>\n    <a href=\"/v/{{ bar.vin }}/timeline\" {% if tab == \"timeline\" %}class=\"on\"{% endif %}>Timeline</a>\n    <a href=\"/v/{{ bar.vin }}/media\" {% if tab == \"media\" %}class=\"on\"{% endif %}>Media</a>\n    <a href=\"/v/{{ bar.vin }}/parts\" {% if tab == \"parts\" %}class=\"on\"{% endif %}>Parts</a>\n    <a href=\"/v/{{ bar.vin }}/dashboard\" {% if tab == \"dashboard\" %}class=\"on\"{% endif %}>Dashboard</a>\n    <a href=\"/v/{{ bar.vin }}/gauges\" {% if tab == \"gauges\" %}class=\"on\"{% endif %}>Gauges</a>\n    <a href=\"/v/{{ bar.vin }}/codes\" {% if tab == \"codes\" %}class=\"on\"{% endif %}>Codes</a>\n    <a href=\"/v/{{ bar.vin }}/tree\" {% if tab == \"tree\" %}class=\"on\"{% endif %}>Fault tree</a>\n    <a href=\"/v/{{ bar.vin }}/gate\" {% if tab == \"gate\" %}class=\"on\"{% endif %}>Evidence gate</a>\n    <a href=\"/v/{{ bar.vin }}/service-hub\" {% if tab == \"service-hub\" %}class=\"on\"{% endif %}>Service</a>\n    <a href=\"/v/{{ bar.vin }}/report\" {% if tab == \"report\" %}class=\"on\"{% endif %}>Report</a>\n    {% set _fb_open = feedback_open_count(bar.vin) if feedback_open_count is defined else 0 %}\n    <a href=\"/v/{{ bar.vin }}/inbox\" {% if tab == \"inbox\" %}class=\"on\"{% endif %}>Inbox{% if _fb_open %} <span class=\"chip chronic\">{{ _fb_open }}</span>{% endif %}</a>\n    <a href=\"/logs?vin={{ bar.vin }}\">Logs</a>\n  </div>\n</div>\n","numLines":71,"startLine":1,"totalLines":71}},"sourceToolAssistantUUID":"d1adb5a6-eb75-4bae-b49c-1ef20552348d","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
