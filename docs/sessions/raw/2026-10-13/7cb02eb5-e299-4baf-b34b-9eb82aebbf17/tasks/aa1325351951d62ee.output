{"parentUuid":"1dbe1a01-18c8-4ffd-bdbb-40fbf7e4b206","isSidechain":true,"agentId":"aa1325351951d62ee","message":{"model":"claude-sonnet-5","id":"msg_011Cfp1qssnobYb8ajmWnAL5","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01PuDgYUhYV2GBTn6PFke7F8","name":"Read","input":{"file_path":"C:\\Users\\User\\mcp-servers\\cuore\\web\\systems_routes.py"},"caller":{"type":"direct"}}],"container":null,"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2526,"cache_read_input_tokens":216449,"output_tokens":3413,"output_tokens_details":{"thinking_tokens":3337},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":0,"ephemeral_5m_input_tokens":2526},"inference_geo":"not_available","iterations":[{"input_tokens":2,"output_tokens":3413,"cache_read_input_tokens":216449,"cache_creation_input_tokens":2526,"cache_creation":{"ephemeral_5m_input_tokens":2526,"ephemeral_1h_input_tokens":0},"type":"message"}],"speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_01PuDgYUhYV2GBTn6PFke7F8":{"file_path":"C:\\Users\\User\\mcp-servers\\cuore\\web\\systems_routes.py"}},"serverClassifierRequest":"7beebf91-7334-4bbc-a193-ff82205579f4","apiBlockIndex":1,"requestId":"req_011Cfp1qsZwdVvbdrQsqKteW","attributionAgent":"general-purpose","type":"assistant","uuid":"72fb2018-3f5d-436e-97c4-d3dc34de61ef","timestamp":"2026-10-08T02:55:05.848Z","effort":"high","perTurnEffort":null,"userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
{"parentUuid":"72fb2018-3f5d-436e-97c4-d3dc34de61ef","isSidechain":true,"promptId":"3342c1ff-c5f9-4e53-bd51-6ef6ca81bd4f","agentId":"aa1325351951d62ee","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01PuDgYUhYV2GBTn6PFke7F8","type":"tool_result","content":"1\t\"\"\"``GET /v/{vin}/systems``: the cross-system dependency view -- which\n2\tsystems may sit upstream of a given code's family, and where this\n3\tvehicle's own history corroborates that (or merely guesses at it).\n4\t\n5\tSame posture as :mod:`cuore.web.timeline_routes`/:mod:`cuore.web.\n6\tparts_routes` (both built the same way, concurrently with other agents):\n7\ta separate router, reusing ``_dossier``/``_page``/``_set_active_vehicle``/\n8\t``_vehicle_bar`` from :mod:`cuore.web.routes` by import rather than\n9\tduplicating that plumbing.\n10\t\n11\tThe data contract lives in ``cuore.services.systems_bridge``\n12\t(``systems()``, ``systems_for_code(code, description=\"\")``,\n13\t``correlate(vin)``), built in parallel by another agent and not\n14\tnecessarily present yet. Every call into it is wrapped and falls back to\n15\ta fixture built to the exact shape the contract specifies, so this page --\n16\tand the ``_system_badge.html`` chips on ``code.html``/``vehicle.html``/\n17\t``report.html`` -- are developable and testable before that module lands.\n18\tOnce it exists, nothing here needs to change -- the lazy import just\n19\tstarts succeeding.\n20\t\n21\tRegisters two Jinja globals the same way :mod:`cuore.web.timeline_routes`\n22\tregisters ``code_feel`` and :mod:`cuore.web.parts_routes` registers\n23\t``parts_for`` -- on both ``Jinja2Templates`` instances this feature's\n24\tpages use (``cuore.web.routes``'s, for ``code.html``/``vehicle.html``/\n25\t``report.html``, and ``cuore.web.service_routes``'s, the same\n26\ttwo-environments wrinkle :mod:`cuore.web.experience_globals` already\n27\tdocuments and works around):\n28\t\n29\t* ``systems_for_code(code, description=\"\")`` -- the badge list for one code.\n30\t* ``system_label(key)`` -- a system key's display label, for anywhere a\n31\t  badge or table only has the bare key (falls back to a title-cased key\n32\t  for one this page has never seen).\n33\t\n34\tNot registered on the app here -- ``app.py`` is owned by another agent\n35\twhile this was built. The two lines needed there (next to the other\n36\t``web`` router imports/includes):\n37\t\n38\t    ``from .web import systems_routes``\n39\t    ``app.include_router(systems_routes.router)``\n40\t\"\"\"\n41\t\n42\tfrom __future__ import annotations\n43\t\n44\timport importlib\n45\tfrom typing import Any\n46\t\n47\tfrom fastapi import APIRouter, Depends, Request\n48\tfrom fastapi.responses import HTMLResponse\n49\t\n50\tfrom ..api.deps import require_token\n51\tfrom . import systems_svg\n52\tfrom .routes import _dossier, _page, _set_active_vehicle, _vehicle_bar\n53\tfrom .routes import templates as _shared_templates\n54\t\n55\trouter = APIRouter(include_in_schema=False, dependencies=[Depends(require_token)])\n56\t\n57\t#: depends_on confidence -> edge line style, the same three buckets\n58\t#: systems_svg.py draws (solid covers both CONFIRMED and CORROBORATED).\n59\tCONFIDENCE_STYLE: dict[str, str] = {\n60\t    \"CONFIRMED\": \"solid\", \"CORROBORATED\": \"solid\",\n61\t    \"SINGLE-SOURCE\": \"dashed\", \"UNKNOWN\": \"dotted\",\n62\t}\n63\t#: role/confidence combinations the badge treats as \"not yet nailed down\" --\n64\t#: these get a trailing \"?\" on the badge rather than a second colour.\n65\t_LOW_CONFIDENCE = {\"SINGLE-SOURCE\", \"UNKNOWN\"}\n66\t\n67\tSTATUS_LABEL = systems_svg.STATUS_TEXT\n68\t#: status -> the existing status-chip CSS class (cuore.css already defines\n69\t#: .chip.status-active/.status-cleared_unverified/.status-stale and the\n70\t#: plain .chip.ok -- no new classes needed here).\n71\tSTATUS_CHIP_CLASS = {\"active\": \"status-active\", \"unverified\": \"status-cleared_unverified\",\n72\t                     \"ok\": \"ok\", \"stale\": \"status-stale\"}\n73\t\n74\t\n75\t# --- fixture: the exact shape cuore.services.systems_bridge will return ---\n76\t\n77\tdef _fixture_systems() -> list[dict[str, Any]]:\n78\t    return [\n79\t        {\"key\": \"electrical\", \"label\": \"Electrical\",\n80\t         \"components\": [\"battery\", \"grounds\", \"body wiring harness\"],\n81\t         \"live_channels\": [{\"name\": \"Battery voltage\", \"band\": \"12.4-14.8V running, >12.0V key-on\"}],\n82\t         \"maintenance_items\": [\"battery/ground inspection\"], \"parts\": [],\n83\t         \"depends_on\": []},\n84\t        {\"key\": \"network\", \"label\": \"Network (CAN/comms)\",\n85\t         \"components\": [\"CAN bus\", \"ECM connector\", \"gateway module\"],\n86\t         \"live_channels\": [{\"name\": \"Bus activity\", \"band\": \"no sustained silence\"}],\n87\t         \"maintenance_items\": [], \"parts\": [],\n88\t         \"depends_on\": [{\"system\": \"electrical\",\n89\t                          \"why\": \"lost comms often traces to connector corrosion or a voltage sag\",\n90\t                          \"confidence\": \"CORROBORATED\", \"source\": \"MES session logs + mechanic notes\"}]},\n91\t        {\"key\": \"body\", \"label\": \"Body\",\n92\t         \"components\": [\"BCM\", \"door/lamp modules\"], \"live_channels\": [],\n93\t         \"maintenance_items\": [], \"parts\": [], \"depends_on\": []},\n94\t        {\"key\": \"evap\", \"label\": \"EVAP\",\n95\t         \"components\": [\"purge valve\", \"vent valve\", \"fuel cap\", \"NVLD\"],\n96\t         \"live_channels\": [{\"name\": \"Fuel level\", \"band\": \"15-85% for the EVAP monitor window\"}],\n97\t         \"maintenance_items\": [\"fuel cap seal inspection\"], \"parts\": [\"evap_purge_valve\"],\n98\t         \"depends_on\": [{\"system\": \"electrical\",\n99\t                          \"why\": \"the purge valve solenoid is switched through the body wiring harness\",\n100\t                          \"confidence\": \"SINGLE-SOURCE\", \"source\": \"mechanic note, 2026-09-15\"}]},\n101\t        {\"key\": \"engine\", \"label\": \"Engine (other)\",\n102\t         \"components\": [\"ECM\", \"sensors\"], \"live_channels\": [],\n103\t         \"maintenance_items\": [], \"parts\": [],\n104\t         \"depends_on\": [{\"system\": \"network\",\n105\t                          \"why\": \"an ECM address loss blocks every engine PID\",\n106\t                          \"confidence\": \"CONFIRMED\", \"source\": \"OBD-II architecture\"}]},\n107\t        {\"key\": \"chassis\", \"label\": \"Chassis\",\n108\t         \"components\": [\"ABS/traction modules\"], \"live_channels\": [],\n109\t         \"maintenance_items\": [], \"parts\": [],\n110\t         \"depends_on\": [{\"system\": \"electrical\",\n111\t                          \"why\": \"speculative -- not yet corroborated on this car\",\n112\t                          \"confidence\": \"UNKNOWN\", \"source\": \"none yet\"}]},\n113\t    ]\n114\t\n115\t\n116\tdef _fixture_systems_for_code(code: str, description: str = \"\") -> list[dict[str, Any]]:\n117\t    c = (code or \"\").upper()\n118\t    if c.startswith(\"P04\"):\n119\t        return [{\"system\": \"evap\", \"role\": \"primary\", \"confidence\": \"CONFIRMED\", \"source\": \"DTC prefix table\"},\n120\t                {\"system\": \"electrical\", \"role\": \"upstream\", \"confidence\": \"SINGLE-SOURCE\",\n121\t                 \"source\": \"systems depends_on graph\"}]\n122\t    if c.startswith(\"U0\"):\n123\t        return [{\"system\": \"network\", \"role\": \"primary\", \"confidence\": \"CONFIRMED\", \"source\": \"DTC prefix table\"},\n124\t                {\"system\": \"electrical\", \"role\": \"upstream\", \"confidence\": \"CORROBORATED\",\n125\t                 \"source\": \"systems depends_on graph\"}]\n126\t    if c.startswith(\"P03\"):\n127\t        return [{\"system\": \"engine\", \"role\": \"primary\", \"confidence\": \"CONFIRMED\", \"source\": \"DTC prefix table\"}]\n128\t    if c.startswith(\"B\"):\n129\t        return [{\"system\": \"body\", \"role\": \"primary\", \"confidence\": \"CONFIRMED\", \"source\": \"DTC prefix table\"}]\n130\t    if c.startswith(\"C\"):\n131\t        return [{\"system\": \"chassis\", \"role\": \"primary\", \"confidence\": \"CONFIRMED\", \"source\": \"DTC prefix table\"},\n132\t                {\"system\": \"electrical\", \"role\": \"upstream\", \"confidence\": \"UNKNOWN\",\n133\t                 \"source\": \"systems depends_on graph\"}]\n134\t    return []\n135\t\n136\t\n137\tdef _fixture_correlate(vin: str) -> dict[str, Any]:\n138\t    return {\n139\t        \"by_system\": [\n140\t            {\"system\": \"evap\", \"codes\": [\"P0440\", \"P0455\", \"P0456\"], \"sessions\": 11,\n141\t             \"first\": \"2025-09-24\", \"last\": \"2026-08-27\", \"status\": \"active\"},\n142\t            {\"system\": \"network\", \"codes\": [\"U0100\"], \"sessions\": 2,\n143\t             \"first\": \"2026-01-15\", \"last\": \"2026-01-15\", \"status\": \"unverified\"},\n144\t            {\"system\": \"electrical\", \"codes\": [], \"sessions\": 0, \"first\": None, \"last\": None, \"status\": \"stale\"},\n145\t            {\"system\": \"engine\", \"codes\": [], \"sessions\": 0, \"first\": None, \"last\": None, \"status\": \"ok\"},\n146\t            {\"system\": \"chassis\", \"codes\": [], \"sessions\": 0, \"first\": None, \"last\": None, \"status\": \"stale\"},\n147\t            {\"system\": \"body\", \"codes\": [], \"sessions\": 0, \"first\": None, \"last\": None, \"status\": \"stale\"},\n148\t        ],\n149\t        \"co_occurrence\": [\n150\t            {\"a\": \"evap\", \"b\": \"electrical\", \"sessions_together\": 0, \"sessions_a\": 11, \"sessions_b\": 0,\n151\t             \"lift\": 1.0, \"reading\": \"no electrical-system session on file yet to corroborate against\"},\n152\t        ],\n153\t        \"chains\": [\n154\t            {\"issue\": \"EVAP leak codes (P0440/P0455/P0456) will not verify clean\",\n155\t             \"possible_upstream\": [\n156\t                 {\"system\": \"electrical\", \"why\": \"purge valve solenoid control circuit\",\n157\t                  \"evidence\": \"TSB 18-030-17 (ECM calibration) is the leading verdict for this car; \"\n158\t                              \"no electrical fault has been corroborated on it yet\"},\n159\t             ]},\n160\t        ],\n161\t        \"findings\": [\n162\t            \"EVAP is the only system with an active, unverified-clean code on this car -- every \"\n163\t            \"other system is stale (no live or session data) rather than confirmed clean.\",\n164\t        ],\n165\t    }\n166\t\n167\t\n168\tdef _bridge():\n169\t    \"\"\"``cuore.services.systems_bridge``, or ``None`` if it has not landed.\"\"\"\n170\t    try:\n171\t        from ..services import systems_bridge\n172\t        return systems_bridge\n173\t    except ImportError:\n174\t        return None\n175\t\n176\t\n177\tdef _systems() -> list[dict[str, Any]]:\n178\t    bridge = _bridge()\n179\t    if bridge is None:\n180\t        return _fixture_systems()\n181\t    try:\n182\t        return bridge.systems() or []\n183\t    except Exception:  # noqa: BLE001 -- a knowledge-table miss must never 500 a page\n184\t        return _fixture_systems()\n185\t\n186\t\n187\tdef _systems_for_code(code: str, description: str = \"\") -> list[dict[str, Any]]:\n188\t    bridge = _bridge()\n189\t    if bridge is None:\n190\t        return _fixture_systems_for_code(code, description)\n191\t    try:\n192\t        return bridge.systems_for_code(code, description) or []\n193\t    except Exception:  # noqa: BLE001\n194\t        return []\n195\t\n196\t\n197\tdef _correlate(vin: str) -> dict[str, Any]:\n198\t    bridge = _bridge()\n199\t    if bridge is None:\n200\t        return _fixture_correlate(vin)\n201\t    try:\n202\t        return bridge.correlate(vin) or {}\n203\t    except Exception:  # noqa: BLE001\n204\t        return _fixture_correlate(vin)\n205\t\n206\t\n207\tdef _system_label(key: str) -> str:\n208\t    for s in _systems():\n209\t        if s.get(\"key\") == key:\n210\t            return s.get(\"label\") or key\n211\t    return (key or \"\").replace(\"_\", \" \").title()\n212\t\n213\t\n214\t_shared_templates.env.globals[\"systems_for_code\"] = _systems_for_code\n215\t_shared_templates.env.globals[\"system_label\"] = _system_label\n216\t\n217\tfor _module_name in (\"service_routes\", \"drivetrain_routes\", \"timeline_routes\"):\n218\t    try:\n219\t        _mod = importlib.import_module(f\".{_module_name}\", __package__)\n220\t        _tmpl = getattr(_mod, \"templates\", None) or getattr(_mod, \"_shared_templates\", None)\n221\t        if _tmpl is not None and _tmpl is not _shared_templates:\n222\t            _tmpl.env.globals[\"systems_for_code\"] = _systems_for_code\n223\t            _tmpl.env.globals[\"system_label\"] = _system_label\n224\t    except Exception:  # noqa: BLE001 -- import-time side effect, must never raise\n225\t        pass\n226\t\n227\t\n228\t# --- the page's view model --------------------------------------------------\n229\t\n230\tdef _build_view(vin: str) -> dict[str, Any]:\n231\t    systems = _systems()\n232\t    corr = _correlate(vin)\n233\t    by_system = {r.get(\"system\"): r for r in (corr.get(\"by_system\") or [])}\n234\t    labels = {s.get(\"key\"): s.get(\"label\") or s.get(\"key\") for s in systems}\n235\t\n236\t    nodes, cards = [], []\n237\t    for s in systems:\n238\t        key = s.get(\"key\")\n239\t        row = by_system.get(key) or {}\n240\t        status = row.get(\"status\") or \"stale\"\n241\t        codes = row.get(\"codes\") or []\n242\t        nodes.append({\"key\": key, \"label\": s.get(\"label\") or key,\n243\t                     \"status\": status, \"code_count\": len(codes)})\n244\t        cards.append({\n245\t            \"key\": key, \"label\": s.get(\"label\") or key,\n246\t            \"status\": status, \"status_label\": STATUS_LABEL.get(status, status),\n247\t            \"status_chip_class\": STATUS_CHIP_CLASS.get(status, \"status-stale\"),\n248\t            \"codes\": codes, \"sessions\": row.get(\"sessions\"),\n249\t            \"first\": row.get(\"first\"), \"last\": row.get(\"last\"),\n250\t            \"components\": s.get(\"components\") or [],\n251\t            \"live_channels\": s.get(\"live_channels\") or [],\n252\t            \"maintenance_items\": s.get(\"maintenance_items\") or [],\n253\t            \"depends_on\": [\n254\t                {**dep, \"confidence\": (dep.get(\"confidence\") or \"UNKNOWN\").upper(),\n255\t                 \"system_label\": labels.get(dep.get(\"system\"), dep.get(\"system\"))}\n256\t                for dep in (s.get(\"depends_on\") or [])\n257\t            ],\n258\t        })\n259\t\n260\t    edges = []\n261\t    for s in systems:\n262\t        for dep in s.get(\"depends_on\") or []:\n263\t            conf = (dep.get(\"confidence\") or \"UNKNOWN\").upper()\n264\t            edges.append({\"a\": s.get(\"key\"), \"b\": dep.get(\"system\"), \"confidence\": conf,\n265\t                         \"style\": CONFIDENCE_STYLE.get(conf, \"dotted\"),\n266\t                         \"why\": dep.get(\"why\"), \"source\": dep.get(\"source\")})\n267\t\n268\t    co_occurrence = [\n269\t        {**row, \"a_label\": labels.get(row.get(\"a\"), row.get(\"a\")),\n270\t         \"b_label\": labels.get(row.get(\"b\"), row.get(\"b\"))}\n271\t        for row in (corr.get(\"co_occurrence\") or [])\n272\t    ]\n273\t\n274\t    chains = []\n275\t    for ch in corr.get(\"chains\") or []:\n276\t        upstream = [{**u, \"system_label\": labels.get(u.get(\"system\"), u.get(\"system\"))}\n277\t                   for u in (ch.get(\"possible_upstream\") or [])]\n278\t        chains.append({**ch, \"possible_upstream\": upstream})\n279\t\n280\t    return {\n281\t        \"nodes\": nodes, \"edges\": edges, \"cards\": cards,\n282\t        \"co_occurrence\": co_occurrence, \"chains\": chains,\n283\t        \"findings\": corr.get(\"findings\") or [],\n284\t    }\n285\t\n286\t\n287\t# --- the page ---------------------------------------------------------------\n288\t\n289\t\n290\t@router.get(\"/v/{vin}/systems\", response_class=HTMLResponse)\n291\tdef systems_page(request: Request, vin: str) -> HTMLResponse:\n292\t    \"\"\"The dependency graph: which systems may sit upstream of which codes,\n293\t    and what this vehicle's own history does and does not corroborate.\"\"\"\n294\t    dossier = _dossier(vin)\n295\t    view = _build_view(vin)\n296\t    svg = systems_svg.render(view[\"nodes\"], view[\"edges\"])\n297\t    response = _page(request, \"systems.html\", vin=vin, bar=_vehicle_bar(vin, dossier),\n298\t                     tab=\"systems\", view=view, svg=svg)\n299\t    _set_active_vehicle(response, vin)\n300\t    return response\n301\t\n302\t\n303\t__all__ = [\"router\"]\n304\t"}]},"uuid":"5613f6be-935a-4068-80e2-460e0445203f","timestamp":"2026-10-08T02:55:05.873Z","toolUseResult":{"type":"text","file":{"filePath":"C:\\Users\\User\\mcp-servers\\cuore\\web\\systems_routes.py","content":"\"\"\"``GET /v/{vin}/systems``: the cross-system dependency view -- which\nsystems may sit upstream of a given code's family, and where this\nvehicle's own history corroborates that (or merely guesses at it).\n\nSame posture as :mod:`cuore.web.timeline_routes`/:mod:`cuore.web.\nparts_routes` (both built the same way, concurrently with other agents):\na separate router, reusing ``_dossier``/``_page``/``_set_active_vehicle``/\n``_vehicle_bar`` from :mod:`cuore.web.routes` by import rather than\nduplicating that plumbing.\n\nThe data contract lives in ``cuore.services.systems_bridge``\n(``systems()``, ``systems_for_code(code, description=\"\")``,\n``correlate(vin)``), built in parallel by another agent and not\nnecessarily present yet. Every call into it is wrapped and falls back to\na fixture built to the exact shape the contract specifies, so this page --\nand the ``_system_badge.html`` chips on ``code.html``/``vehicle.html``/\n``report.html`` -- are developable and testable before that module lands.\nOnce it exists, nothing here needs to change -- the lazy import just\nstarts succeeding.\n\nRegisters two Jinja globals the same way :mod:`cuore.web.timeline_routes`\nregisters ``code_feel`` and :mod:`cuore.web.parts_routes` registers\n``parts_for`` -- on both ``Jinja2Templates`` instances this feature's\npages use (``cuore.web.routes``'s, for ``code.html``/``vehicle.html``/\n``report.html``, and ``cuore.web.service_routes``'s, the same\ntwo-environments wrinkle :mod:`cuore.web.experience_globals` already\ndocuments and works around):\n\n* ``systems_for_code(code, description=\"\")`` -- the badge list for one code.\n* ``system_label(key)`` -- a system key's display label, for anywhere a\n  badge or table only has the bare key (falls back to a title-cased key\n  for one this page has never seen).\n\nNot registered on the app here -- ``app.py`` is owned by another agent\nwhile this was built. The two lines needed there (next to the other\n``web`` router imports/includes):\n\n    ``from .web import systems_routes``\n    ``app.include_router(systems_routes.router)``\n\"\"\"\n\nfrom __future__ import annotations\n\nimport importlib\nfrom typing import Any\n\nfrom fastapi import APIRouter, Depends, Request\nfrom fastapi.responses import HTMLResponse\n\nfrom ..api.deps import require_token\nfrom . import systems_svg\nfrom .routes import _dossier, _page, _set_active_vehicle, _vehicle_bar\nfrom .routes import templates as _shared_templates\n\nrouter = APIRouter(include_in_schema=False, dependencies=[Depends(require_token)])\n\n#: depends_on confidence -> edge line style, the same three buckets\n#: systems_svg.py draws (solid covers both CONFIRMED and CORROBORATED).\nCONFIDENCE_STYLE: dict[str, str] = {\n    \"CONFIRMED\": \"solid\", \"CORROBORATED\": \"solid\",\n    \"SINGLE-SOURCE\": \"dashed\", \"UNKNOWN\": \"dotted\",\n}\n#: role/confidence combinations the badge treats as \"not yet nailed down\" --\n#: these get a trailing \"?\" on the badge rather than a second colour.\n_LOW_CONFIDENCE = {\"SINGLE-SOURCE\", \"UNKNOWN\"}\n\nSTATUS_LABEL = systems_svg.STATUS_TEXT\n#: status -> the existing status-chip CSS class (cuore.css already defines\n#: .chip.status-active/.status-cleared_unverified/.status-stale and the\n#: plain .chip.ok -- no new classes needed here).\nSTATUS_CHIP_CLASS = {\"active\": \"status-active\", \"unverified\": \"status-cleared_unverified\",\n                     \"ok\": \"ok\", \"stale\": \"status-stale\"}\n\n\n# --- fixture: the exact shape cuore.services.systems_bridge will return ---\n\ndef _fixture_systems() -> list[dict[str, Any]]:\n    return [\n        {\"key\": \"electrical\", \"label\": \"Electrical\",\n         \"components\": [\"battery\", \"grounds\", \"body wiring harness\"],\n         \"live_channels\": [{\"name\": \"Battery voltage\", \"band\": \"12.4-14.8V running, >12.0V key-on\"}],\n         \"maintenance_items\": [\"battery/ground inspection\"], \"parts\": [],\n         \"depends_on\": []},\n        {\"key\": \"network\", \"label\": \"Network (CAN/comms)\",\n         \"components\": [\"CAN bus\", \"ECM connector\", \"gateway module\"],\n         \"live_channels\": [{\"name\": \"Bus activity\", \"band\": \"no sustained silence\"}],\n         \"maintenance_items\": [], \"parts\": [],\n         \"depends_on\": [{\"system\": \"electrical\",\n                          \"why\": \"lost comms often traces to connector corrosion or a voltage sag\",\n                          \"confidence\": \"CORROBORATED\", \"source\": \"MES session logs + mechanic notes\"}]},\n        {\"key\": \"body\", \"label\": \"Body\",\n         \"components\": [\"BCM\", \"door/lamp modules\"], \"live_channels\": [],\n         \"maintenance_items\": [], \"parts\": [], \"depends_on\": []},\n        {\"key\": \"evap\", \"label\": \"EVAP\",\n         \"components\": [\"purge valve\", \"vent valve\", \"fuel cap\", \"NVLD\"],\n         \"live_channels\": [{\"name\": \"Fuel level\", \"band\": \"15-85% for the EVAP monitor window\"}],\n         \"maintenance_items\": [\"fuel cap seal inspection\"], \"parts\": [\"evap_purge_valve\"],\n         \"depends_on\": [{\"system\": \"electrical\",\n                          \"why\": \"the purge valve solenoid is switched through the body wiring harness\",\n                          \"confidence\": \"SINGLE-SOURCE\", \"source\": \"mechanic note, 2026-09-15\"}]},\n        {\"key\": \"engine\", \"label\": \"Engine (other)\",\n         \"components\": [\"ECM\", \"sensors\"], \"live_channels\": [],\n         \"maintenance_items\": [], \"parts\": [],\n         \"depends_on\": [{\"system\": \"network\",\n                          \"why\": \"an ECM address loss blocks every engine PID\",\n                          \"confidence\": \"CONFIRMED\", \"source\": \"OBD-II architecture\"}]},\n        {\"key\": \"chassis\", \"label\": \"Chassis\",\n         \"components\": [\"ABS/traction modules\"], \"live_channels\": [],\n         \"maintenance_items\": [], \"parts\": [],\n         \"depends_on\": [{\"system\": \"electrical\",\n                          \"why\": \"speculative -- not yet corroborated on this car\",\n                          \"confidence\": \"UNKNOWN\", \"source\": \"none yet\"}]},\n    ]\n\n\ndef _fixture_systems_for_code(code: str, description: str = \"\") -> list[dict[str, Any]]:\n    c = (code or \"\").upper()\n    if c.startswith(\"P04\"):\n        return [{\"system\": \"evap\", \"role\": \"primary\", \"confidence\": \"CONFIRMED\", \"source\": \"DTC prefix table\"},\n                {\"system\": \"electrical\", \"role\": \"upstream\", \"confidence\": \"SINGLE-SOURCE\",\n                 \"source\": \"systems depends_on graph\"}]\n    if c.startswith(\"U0\"):\n        return [{\"system\": \"network\", \"role\": \"primary\", \"confidence\": \"CONFIRMED\", \"source\": \"DTC prefix table\"},\n                {\"system\": \"electrical\", \"role\": \"upstream\", \"confidence\": \"CORROBORATED\",\n                 \"source\": \"systems depends_on graph\"}]\n    if c.startswith(\"P03\"):\n        return [{\"system\": \"engine\", \"role\": \"primary\", \"confidence\": \"CONFIRMED\", \"source\": \"DTC prefix table\"}]\n    if c.startswith(\"B\"):\n        return [{\"system\": \"body\", \"role\": \"primary\", \"confidence\": \"CONFIRMED\", \"source\": \"DTC prefix table\"}]\n    if c.startswith(\"C\"):\n        return [{\"system\": \"chassis\", \"role\": \"primary\", \"confidence\": \"CONFIRMED\", \"source\": \"DTC prefix table\"},\n                {\"system\": \"electrical\", \"role\": \"upstream\", \"confidence\": \"UNKNOWN\",\n                 \"source\": \"systems depends_on graph\"}]\n    return []\n\n\ndef _fixture_correlate(vin: str) -> dict[str, Any]:\n    return {\n        \"by_system\": [\n            {\"system\": \"evap\", \"codes\": [\"P0440\", \"P0455\", \"P0456\"], \"sessions\": 11,\n             \"first\": \"2025-09-24\", \"last\": \"2026-08-27\", \"status\": \"active\"},\n            {\"system\": \"network\", \"codes\": [\"U0100\"], \"sessions\": 2,\n             \"first\": \"2026-01-15\", \"last\": \"2026-01-15\", \"status\": \"unverified\"},\n            {\"system\": \"electrical\", \"codes\": [], \"sessions\": 0, \"first\": None, \"last\": None, \"status\": \"stale\"},\n            {\"system\": \"engine\", \"codes\": [], \"sessions\": 0, \"first\": None, \"last\": None, \"status\": \"ok\"},\n            {\"system\": \"chassis\", \"codes\": [], \"sessions\": 0, \"first\": None, \"last\": None, \"status\": \"stale\"},\n            {\"system\": \"body\", \"codes\": [], \"sessions\": 0, \"first\": None, \"last\": None, \"status\": \"stale\"},\n        ],\n        \"co_occurrence\": [\n            {\"a\": \"evap\", \"b\": \"electrical\", \"sessions_together\": 0, \"sessions_a\": 11, \"sessions_b\": 0,\n             \"lift\": 1.0, \"reading\": \"no electrical-system session on file yet to corroborate against\"},\n        ],\n        \"chains\": [\n            {\"issue\": \"EVAP leak codes (P0440/P0455/P0456) will not verify clean\",\n             \"possible_upstream\": [\n                 {\"system\": \"electrical\", \"why\": \"purge valve solenoid control circuit\",\n                  \"evidence\": \"TSB 18-030-17 (ECM calibration) is the leading verdict for this car; \"\n                              \"no electrical fault has been corroborated on it yet\"},\n             ]},\n        ],\n        \"findings\": [\n            \"EVAP is the only system with an active, unverified-clean code on this car -- every \"\n            \"other system is stale (no live or session data) rather than confirmed clean.\",\n        ],\n    }\n\n\ndef _bridge():\n    \"\"\"``cuore.services.systems_bridge``, or ``None`` if it has not landed.\"\"\"\n    try:\n        from ..services import systems_bridge\n        return systems_bridge\n    except ImportError:\n        return None\n\n\ndef _systems() -> list[dict[str, Any]]:\n    bridge = _bridge()\n    if bridge is None:\n        return _fixture_systems()\n    try:\n        return bridge.systems() or []\n    except Exception:  # noqa: BLE001 -- a knowledge-table miss must never 500 a page\n        return _fixture_systems()\n\n\ndef _systems_for_code(code: str, description: str = \"\") -> list[dict[str, Any]]:\n    bridge = _bridge()\n    if bridge is None:\n        return _fixture_systems_for_code(code, description)\n    try:\n        return bridge.systems_for_code(code, description) or []\n    except Exception:  # noqa: BLE001\n        return []\n\n\ndef _correlate(vin: str) -> dict[str, Any]:\n    bridge = _bridge()\n    if bridge is None:\n        return _fixture_correlate(vin)\n    try:\n        return bridge.correlate(vin) or {}\n    except Exception:  # noqa: BLE001\n        return _fixture_correlate(vin)\n\n\ndef _system_label(key: str) -> str:\n    for s in _systems():\n        if s.get(\"key\") == key:\n            return s.get(\"label\") or key\n    return (key or \"\").replace(\"_\", \" \").title()\n\n\n_shared_templates.env.globals[\"systems_for_code\"] = _systems_for_code\n_shared_templates.env.globals[\"system_label\"] = _system_label\n\nfor _module_name in (\"service_routes\", \"drivetrain_routes\", \"timeline_routes\"):\n    try:\n        _mod = importlib.import_module(f\".{_module_name}\", __package__)\n        _tmpl = getattr(_mod, \"templates\", None) or getattr(_mod, \"_shared_templates\", None)\n        if _tmpl is not None and _tmpl is not _shared_templates:\n            _tmpl.env.globals[\"systems_for_code\"] = _systems_for_code\n            _tmpl.env.globals[\"system_label\"] = _system_label\n    except Exception:  # noqa: BLE001 -- import-time side effect, must never raise\n        pass\n\n\n# --- the page's view model --------------------------------------------------\n\ndef _build_view(vin: str) -> dict[str, Any]:\n    systems = _systems()\n    corr = _correlate(vin)\n    by_system = {r.get(\"system\"): r for r in (corr.get(\"by_system\") or [])}\n    labels = {s.get(\"key\"): s.get(\"label\") or s.get(\"key\") for s in systems}\n\n    nodes, cards = [], []\n    for s in systems:\n        key = s.get(\"key\")\n        row = by_system.get(key) or {}\n        status = row.get(\"status\") or \"stale\"\n        codes = row.get(\"codes\") or []\n        nodes.append({\"key\": key, \"label\": s.get(\"label\") or key,\n                     \"status\": status, \"code_count\": len(codes)})\n        cards.append({\n            \"key\": key, \"label\": s.get(\"label\") or key,\n            \"status\": status, \"status_label\": STATUS_LABEL.get(status, status),\n            \"status_chip_class\": STATUS_CHIP_CLASS.get(status, \"status-stale\"),\n            \"codes\": codes, \"sessions\": row.get(\"sessions\"),\n            \"first\": row.get(\"first\"), \"last\": row.get(\"last\"),\n            \"components\": s.get(\"components\") or [],\n            \"live_channels\": s.get(\"live_channels\") or [],\n            \"maintenance_items\": s.get(\"maintenance_items\") or [],\n            \"depends_on\": [\n                {**dep, \"confidence\": (dep.get(\"confidence\") or \"UNKNOWN\").upper(),\n                 \"system_label\": labels.get(dep.get(\"system\"), dep.get(\"system\"))}\n                for dep in (s.get(\"depends_on\") or [])\n            ],\n        })\n\n    edges = []\n    for s in systems:\n        for dep in s.get(\"depends_on\") or []:\n            conf = (dep.get(\"confidence\") or \"UNKNOWN\").upper()\n            edges.append({\"a\": s.get(\"key\"), \"b\": dep.get(\"system\"), \"confidence\": conf,\n                         \"style\": CONFIDENCE_STYLE.get(conf, \"dotted\"),\n                         \"why\": dep.get(\"why\"), \"source\": dep.get(\"source\")})\n\n    co_occurrence = [\n        {**row, \"a_label\": labels.get(row.get(\"a\"), row.get(\"a\")),\n         \"b_label\": labels.get(row.get(\"b\"), row.get(\"b\"))}\n        for row in (corr.get(\"co_occurrence\") or [])\n    ]\n\n    chains = []\n    for ch in corr.get(\"chains\") or []:\n        upstream = [{**u, \"system_label\": labels.get(u.get(\"system\"), u.get(\"system\"))}\n                   for u in (ch.get(\"possible_upstream\") or [])]\n        chains.append({**ch, \"possible_upstream\": upstream})\n\n    return {\n        \"nodes\": nodes, \"edges\": edges, \"cards\": cards,\n        \"co_occurrence\": co_occurrence, \"chains\": chains,\n        \"findings\": corr.get(\"findings\") or [],\n    }\n\n\n# --- the page ---------------------------------------------------------------\n\n\n@router.get(\"/v/{vin}/systems\", response_class=HTMLResponse)\ndef systems_page(request: Request, vin: str) -> HTMLResponse:\n    \"\"\"The dependency graph: which systems may sit upstream of which codes,\n    and what this vehicle's own history does and does not corroborate.\"\"\"\n    dossier = _dossier(vin)\n    view = _build_view(vin)\n    svg = systems_svg.render(view[\"nodes\"], view[\"edges\"])\n    response = _page(request, \"systems.html\", vin=vin, bar=_vehicle_bar(vin, dossier),\n                     tab=\"systems\", view=view, svg=svg)\n    _set_active_vehicle(response, vin)\n    return response\n\n\n__all__ = [\"router\"]\n","numLines":304,"startLine":1,"totalLines":304}},"sourceToolAssistantUUID":"72fb2018-3f5d-436e-97c4-d3dc34de61ef","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
