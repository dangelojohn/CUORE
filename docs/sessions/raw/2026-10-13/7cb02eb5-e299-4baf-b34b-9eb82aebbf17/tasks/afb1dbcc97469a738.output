{"parentUuid":"a979db65-f88f-4e6b-9b59-9cd86b8634a2","isSidechain":true,"agentId":"afb1dbcc97469a738","message":{"model":"claude-sonnet-5","id":"msg_011Cg1AoRXZUQPrvH3wXncjS","type":"message","role":"assistant","content":[{"type":"thinking","thinking":"","signature":""}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1506,"cache_read_input_tokens":65597,"cache_creation":{"ephemeral_5m_input_tokens":1506,"ephemeral_1h_input_tokens":0},"output_tokens":2,"service_tier":"standard","inference_geo":"global"},"input_transformations":[],"diagnostics":null,"context_management":null},"serverClassifierRequest":"be15c36f-4cee-43d5-a7cb-a747fbf100de","apiBlockIndex":0,"requestId":"req_011Cg1AoRHuu7vRcWv23mwdf","attributionAgent":"general-purpose","type":"assistant","uuid":"21d7674f-26d1-40c4-81b2-f09d3ac5b71e","timestamp":"2026-10-14T00:18:27.927Z","effort":"high","perTurnEffort":null,"userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
{"parentUuid":"21d7674f-26d1-40c4-81b2-f09d3ac5b71e","isSidechain":true,"agentId":"afb1dbcc97469a738","message":{"model":"claude-sonnet-5","id":"msg_011Cg1AoRXZUQPrvH3wXncjS","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_017dPdwqggB6TPLyyA6AS87v","name":"Read","input":{"file_path":"C:\\Users\\User\\mcp-servers\\cuore\\services\\dossier_bridge.py"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1506,"cache_read_input_tokens":65597,"cache_creation":{"ephemeral_5m_input_tokens":1506,"ephemeral_1h_input_tokens":0},"output_tokens":2,"service_tier":"standard","inference_geo":"global"},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_017dPdwqggB6TPLyyA6AS87v":{"file_path":"C:\\Users\\User\\mcp-servers\\cuore\\services\\dossier_bridge.py"}},"serverClassifierRequest":"be15c36f-4cee-43d5-a7cb-a747fbf100de","apiBlockIndex":1,"requestId":"req_011Cg1AoRHuu7vRcWv23mwdf","attributionAgent":"general-purpose","type":"assistant","uuid":"4fab9b88-4c29-41f2-b981-0809c705542b","timestamp":"2026-10-14T00:18:28.578Z","effort":"high","perTurnEffort":null,"userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
{"parentUuid":"4fab9b88-4c29-41f2-b981-0809c705542b","isSidechain":true,"promptId":"99516295-3962-40e1-8d55-7c7b80de287f","agentId":"afb1dbcc97469a738","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017dPdwqggB6TPLyyA6AS87v","type":"tool_result","content":"1\t\"\"\"Turns the raw workup dossier into the redesigned dossier page's contract.\n2\t\n3\tMECHANIC_UX_REVIEW.md's R1/R4/R5/R6/R7/R8/R9 all boil down to the same\n4\tcomplaint: the knowledge in ``mes.workup`` is already senior-technician-grade\n5\t(family findings, chronic/returned classification, TSB cross-reference) but\n6\tthe page made the mechanic excavate it from prose and raw dicts. Nothing here\n7\tre-derives that knowledge -- it only reshapes what ``mes_bridge.workup``\n8\talready returns (plus what the live link has observed) into the verdict,\n9\tchecklists, code table, freeze-frame flags, deduplicated bulletins and\n10\trunnable blind-spot actions the template needs, so there is exactly one\n11\tplace that decides what a status chip or a checklist step means.\n12\t\n13\t``build_view`` is the only entry point. Everything else is a private helper.\n14\t\n15\tLike every other file under ``cuore/services``, this is a *_bridge.py module,\n16\tso it is allowed to import ``mes_bridge`` (never the ``mes`` package itself --\n17\tnothing here needs to; the workup dict already carries what ``mes`` computed)\n18\tand the small read-only ``cuore.live`` surfaces (``store`` for live\n19\tobservations, ``checklists`` for shop-ticked steps).\n20\t\"\"\"\n21\t\n22\tfrom __future__ import annotations\n23\t\n24\timport re\n25\tfrom datetime import datetime\n26\tfrom typing import Any\n27\t\n28\tfrom . import cache, mes_bridge\n29\tfrom .errors import BridgeError\n30\tfrom ..live import checklists as checklist_store\n31\tfrom ..live import config as live_config\n32\tfrom ..live import store as live_store\n33\t\n34\t#: EVAP monitor runs at 15-85% fuel; cited wherever a freeze frame needs\n35\t#: flagging. Matches the window ``mes`` itself states in verdict/fault-tree\n36\t#: text -- not re-derived, just applied to one more surface.\n37\t_EVAP_FUEL_WINDOW = (15.0, 85.0)\n38\t_EVAP_CODES = {\"P0440\", \"P0441\", \"P0455\", \"P0456\", \"P1CEA\"}\n39\t\n40\t_SYSTEM_BY_LETTER = {\"P\": \"engine\", \"C\": \"chassis\", \"B\": \"body\", \"U\": \"network\"}\n41\t\n42\t_STATUS_LABEL = {\"ACTIVE\": \"Active\", \"CLEARED_UNVERIFIED\": \"Cleared, unverified\",\n43\t                \"STALE\": \"Stale\"}\n44\t\n45\t#: Freeze-frame parameters worth a mechanic's first glance, in the order\n46\t#: they should appear. Everything else still rides along in ``all``.\n47\t_KEY_FRAME_PARAMS = [\"Fuel level\", \"Engine temperature\", \"Odometer\",\n48\t                     \"Vehicle speed\", \"Engine speed\", \"Air temperature\"]\n49\t\n50\t#: One checklist per family this corpus's fault trees and TSBs recognise\n51\t#: today. Transcribed once, here, from the family finding's own \"reading\"\n52\t#: text and the EVAP/network fault trees -- see MECHANIC_UX_REVIEW.md R4.\n53\t#: Keeping this as a table (not free-text parsing of ``reading``) is what\n54\t#: makes checklist step ids stable across a wording change in ``mes``.\n55\tFAMILY_STEPS: dict[str, list[dict[str, Any]]] = {\n56\t    \"EVAP\": [\n57\t        {\"id\": \"evap-1\", \"text\": \"Inspect the recirculation-line quick-connect\",\n58\t         \"ref\": \"S2125000002\"},\n59\t        {\"id\": \"evap-2\", \"text\": \"Run the purge/vent valve KOEO actuator test\",\n60\t         \"ref\": None},\n61\t        {\"id\": \"evap-3\", \"text\": \"Check hose routing\", \"ref\": \"9100325\"},\n62\t        {\"id\": \"evap-4\", \"text\": \"Inspect the canister/ESIM\", \"ref\": \"9100471\"},\n63\t        {\"id\": \"evap-5\", \"text\": \"Run a smoke test to localise the leak\",\n64\t         \"ref\": None},\n65\t        {\"id\": \"evap-6\", \"text\": \"Verify with SLVT or Mode $06\",\n66\t         \"ref\": \"18-048-23\"},\n67\t    ],\n68\t    \"network\": [\n69\t        {\"id\": \"network-1\", \"text\": \"Check the supply: F82 fuse and BCM feeds\",\n70\t         \"ref\": \"S1808000005\"},\n71\t        {\"id\": \"network-2\",\n72\t         \"text\": \"Inspect connectors/grounds: XY201, G003A/B\",\n73\t         \"ref\": \"S2008000032\"},\n74\t        {\"id\": \"network-3\",\n75\t         \"text\": \"Inspect connector terminals for spread/backed-out pins\",\n76\t         \"ref\": \"S1708000262\"},\n77\t    ],\n78\t}\n79\t\n80\t_FAMILY_TITLES = {\n81\t    \"EVAP\": \"EVAP: one system fault\",\n82\t    \"network\": \"Network: one power/bus event, not {n} separate faults\",\n83\t}\n84\t\n85\t#: EVAP was the first job this cuore app diagnosed, so it (and the network\n86\t#: cascade) got a hand-curated ``FAMILY_STEPS`` table above. Every other\n87\t#: family this car's history can throw -- misfire, fuel trim, cooling, body,\n88\t#: chassis, ADAS, or anything else SAE's DTC-prefix convention covers --\n89\t#: still needs an open-work card; :func:`_build_open_work` builds those\n90\t#: generically, grouping codes by the family below and pulling steps live\n91\t#: from ``mes_bridge.fault_tree`` (``mes.faulttree.tree_for`` -- the\n92\t#: hand-written tree when one exists, else a sourced generated one) instead\n93\t#: of a second hand-maintained step table. Patterns are checked in order;\n94\t#: the first match wins. Generalised from the same SAE J2012 prefix-range\n95\t#: convention ``mes.systems._sae_fallback`` already uses.\n96\t_GENERIC_FAMILY_RULES: tuple[tuple[re.Pattern, str, str], ...] = (\n97\t    (re.compile(r\"^P030[0-9]$\"), \"misfire\", \"Misfire\"),\n98\t    (re.compile(r\"^P017[0-5]$\"), \"fuel_trim\", \"Fuel trim\"),\n99\t    (re.compile(r\"^P01(0[0-9]|1[0-9]|2[0-9])$\"), \"cooling\",\n100\t     \"Cooling / intake sensors\"),\n101\t    (re.compile(r\"^P0[67][0-9]{2}$\"), \"engine_management\", \"Engine management\"),\n102\t    (re.compile(r\"^P0[89][0-9]{2}$\"), \"transmission_driveline\",\n103\t     \"Transmission / driveline\"),\n104\t    (re.compile(r\"^C(141B|141C)$\"), \"adas\", \"ADAS (camera/radar)\"),\n105\t    (re.compile(r\"^C[0-9A-F]{4}$\"), \"chassis\", \"Chassis (brakes/steering/suspension)\"),\n106\t    (re.compile(r\"^B[0-9A-F]{4}$\"), \"body\", \"Body / comfort\"),\n107\t    (re.compile(r\"^U[0-9A-F]{4}$\"), \"network\", \"Network / communication\"),\n108\t    (re.compile(r\"^P[0-9A-F]{4}$\"), \"powertrain_other\", \"Powertrain (other)\"),\n109\t)\n110\t\n111\t\n112\tdef _generic_family_for(base: str) -> tuple[str, str] | None:\n113\t    \"\"\"``(family_key, family_label)`` for a code with no hand-curated\n114\t    ``FAMILY_STEPS`` entry, or ``None`` for something that isn't a\n115\t    recognisable P/B/C/U code at all.\"\"\"\n116\t    for pattern, key, label in _GENERIC_FAMILY_RULES:\n117\t        if pattern.match(base):\n118\t            return key, label\n119\t    return None\n120\t\n121\t\n122\tdef _history_codes(dossier: dict[str, Any]) -> set[str]:\n123\t    \"\"\"Every base code present anywhere in this car's own history -- the\n124\t    same ``chronic``/``returned_after_clear``/``seen_once`` buckets the code\n125\t    table reads -- so a generic open-work card can be offered for a family\n126\t    the TSB family-finding rule above doesn't recognise.\"\"\"\n127\t    history = dossier.get(\"history\") or {}\n128\t    out: set[str] = set()\n129\t    for bucket in (\"chronic\", \"returned_after_clear\", \"seen_once\"):\n130\t        for rec in history.get(bucket, []):\n131\t            b = _base(rec.get(\"dtc\", \"\"))\n132\t            if b:\n133\t                out.add(b)\n134\t    return out\n135\t\n136\t\n137\tdef _generic_tree_steps(code: str, vin: str) -> list[dict[str, Any]]:\n138\t    \"\"\"The first tree's steps for one code, via ``mes_bridge.fault_tree`` --\n139\t    the hand-written tree when ``mes.faulttree.tree_for`` has one, else its\n140\t    sourced generated tree. Never raises: a lookup failure just means no\n141\t    generic card gets built for that code.\"\"\"\n142\t    try:\n143\t        result = mes_bridge.fault_tree(code, vin=vin)\n144\t    except Exception:\n145\t        return []\n146\t    trees = result.get(\"trees\") or []\n147\t    return trees[0].get(\"steps\") or [] if trees else []\n148\t\n149\t\n150\t# --- small shared helpers --------------------------------------------------\n151\t\n152\t\n153\tdef _base(code: str) -> str:\n154\t    \"\"\"\"P0440-00\" -> \"P0440\". Same rule as ``mes.knowledge.base_code``,\n155\t    reimplemented here rather than imported so this module never touches the\n156\t    ``mes`` package directly.\"\"\"\n157\t    code = (code or \"\").strip().upper()\n158\t    return code.split(\"-\", 1)[0] if \"-\" in code else code\n159\t\n160\t\n161\tdef _slug(text: str) -> str:\n162\t    return re.sub(r\"[^A-Za-z0-9]+\", \"-\", (text or \"\").strip()).strip(\"-\")\n163\t\n164\t\n165\tdef _parse_ts(ts: str | None) -> datetime | None:\n166\t    if not ts:\n167\t        return None\n168\t    try:\n169\t        return datetime.strptime(str(ts)[:19], \"%Y-%m-%d %H:%M:%S\")\n170\t    except ValueError:\n171\t        return None\n172\t\n173\t\n174\tdef _short_date(ts: str | None, with_time: bool = False) -> str | None:\n175\t    dt = _parse_ts(ts)\n176\t    if dt is None:\n177\t        return None\n178\t    fmt = \"%d %b %H:%M\" if with_time else \"%d %b\"\n179\t    if dt.year != datetime.now().year:\n180\t        fmt += \" '%y\"\n181\t    return dt.strftime(fmt)\n182\t\n183\t\n184\tdef _num(display: Any) -> float | None:\n185\t    \"\"\"Pull the leading number out of a display string like \"93.73 %\".\"\"\"\n186\t    if display is None:\n187\t        return None\n188\t    m = re.match(r\"\\s*(-?\\d+(?:\\.\\d+)?)\", str(display))\n189\t    return float(m.group(1)) if m else None\n190\t\n191\t\n192\tdef _state_fingerprint() -> float:\n193\t    \"\"\"Newest mtime across this app's mutable state files.\n194\t\n195\t    Checklists, jobs, shop visits, symptoms, notes, dealer results, tool\n196\t    usage, live observations and the rest are all flat files sitting\n197\t    directly under one shared directory -- every ``mes.*``/``cuore.live``\n198\t    state module mirrors ``cuore.live.config.state_dir()`` (see each\n199\t    module's own ``state_dir()`` docstring). Folded into\n200\t    :func:`build_view`'s cache key so a ticked checklist step or a freshly\n201\t    logged symptom invalidates the cached open-work/freeze-frame/attempted\n202\t    build the same way a new MES log invalidates ``mes_bridge.newest_mtime``\n203\t    -- no separate invalidation hook, same reasoning as ``cuore.services.cache``\n204\t    itself.\n205\t    \"\"\"\n206\t    try:\n207\t        d = live_config.state_dir()\n208\t        return max((p.stat().st_mtime for p in d.iterdir() if p.is_file()), default=0.0)\n209\t    except OSError:\n210\t        return 0.0\n211\t\n212\t\n213\tdef live_available(live_status: dict[str, Any] | None) -> bool:\n214\t    \"\"\"Is the adapter reachable right now -- a port configured, and neither\n215\t    MultiEcuScan nor another process holding it.\n216\t\n217\t    Same read ``base.html``'s live strip and ``/live`` already make of\n218\t    ``live_ops.status()``: ``mes_state == \"connected\"`` means MES has the\n219\t    port, and a ``lock_holder`` other than this process means something else\n220\t    does. Used both to grey out the dossier's own action buttons and by\n221\t    ``/v/{vin}/verify`` to decide whether it is safe to actually read.\n222\t    \"\"\"\n223\t    if not live_status or live_status.get(\"error\"):\n224\t        return False\n225\t    if not live_status.get(\"port\"):\n226\t        return False\n227\t    if live_status.get(\"mes_state\") == \"connected\":\n228\t        return False\n229\t    holder = live_status.get(\"lock_holder\")\n230\t    if holder and holder != \"cuore\":\n231\t        return False\n232\t    return True\n233\t\n234\t\n235\t# --- the last clear ---------------------------------------------------------\n236\t\n237\t\n238\tdef _clear_info(dossier: dict[str, Any]\n239\t                ) -> tuple[str | None, str | None, dict[str, Any] | None]:\n240\t    \"\"\"(cleared_at full timestamp, cleared_by file, the clear_assessment dict).\n241\t\n242\t    ``current_picture.clear_assessment`` comes from two different shapes in\n243\t    ``mes.workup``: a scan-based clear carries its own ``cleared_at``/\n244\t    ``source``; a clear inside the anchored FES session itself carries\n245\t    neither, because *that session* is the clear -- so its timestamp/file are\n246\t    read off ``latest_session`` instead.\n247\t    \"\"\"\n248\t    cp = dossier.get(\"current_picture\") or {}\n249\t    ca = cp.get(\"clear_assessment\")\n250\t    if not ca:\n251\t        return None, None, None\n252\t    cleared_at = ca.get(\"cleared_at\")\n253\t    cleared_by = ca.get(\"source\")\n254\t    if not cleared_at:\n255\t        latest = cp.get(\"latest_session\") or {}\n256\t        cleared_at = latest.get(\"timestamp\")\n257\t        cleared_by = latest.get(\"file\")\n258\t    return cleared_at, cleared_by, ca\n259\t\n260\t\n261\t# --- readiness, read from the car -------------------------------------------\n262\t\n263\t\n264\tdef _latest_readiness(vin: str, after: str | None) -> dict[str, Any] | None:\n265\t    \"\"\"The newest readiness observation from the car itself, after ``after``.\n266\t\n267\t    A read taken before the clear says nothing about the car now -- the same\n268\t    reasoning ``mes.verdict._last_clear`` already applies to live DTC reads.\n269\t    \"\"\"\n270\t    try:\n271\t        obs = live_store.recent_observations(200, vin=vin, kind=\"readiness\")\n272\t    except Exception:  # noqa: BLE001 -- a broken store must never break the verdict\n273\t        return None\n274\t    best = None\n275\t    for o in obs:\n276\t        if not live_store.is_from_car(o):\n277\t            continue\n278\t        at = o.get(\"at\") or \"\"\n279\t        if after and at <= after:\n280\t            continue\n281\t        if best is None or at > (best.get(\"at\") or \"\"):\n282\t            best = o\n283\t    return best\n284\t\n285\t\n286\tdef readiness_result(raw: dict[str, Any]) -> dict[str, Any]:\n287\t    \"\"\"Shape a live ``ops.obd_readiness()`` read for ``/v/{vin}/verify``.\n288\t\n289\t    ``verify.html`` destructures ``result.at`` / ``result.evap_monitor`` /\n290\t    ``result.all_complete`` / ``result.monitors`` explicitly (never the raw\n291\t    dict) -- this is the one place that produces that flat shape from the\n292\t    nested ``since_clear``/``monitors`` payload ``ops.obd_readiness``\n293\t    returns, so the page and the verdict's own ``readiness`` sub-object\n294\t    agree on what \"the EVAP monitor is complete\" means.\n295\t    \"\"\"\n296\t    since = raw.get(\"since_clear\") or {}\n297\t    monitors = since.get(\"monitors\") or []\n298\t    evap = next((m for m in monitors if m.get(\"monitor\") == \"Evaporative system\"), None)\n299\t    return {\n300\t        \"at\": datetime.now().isoformat(timespec=\"seconds\"),\n301\t        \"evap_monitor\": bool(evap and evap.get(\"complete\")),\n302\t        \"all_complete\": bool(since.get(\"all_complete\")),\n303\t        \"monitors\": [{\"name\": m.get(\"monitor\"), \"complete\": bool(m.get(\"complete\"))}\n304\t                     for m in monitors],\n305\t    }\n306\t\n307\t\n308\tdef fuel_status(freeze_frames: list[dict[str, Any]]) -> dict[str, Any]:\n309\t    \"\"\"Current fuel % and EVAP-window state, for the bench's live fuel gate.\n310\t\n311\t    Reads the same EVAP freeze-frame \"Fuel level\" reading the verdict's own\n312\t    ``next_action`` sentence already quotes (:func:`_fuel_out_of_window`\n313\t    scans the same frames but only returns a value when the reading is\n314\t    flagged out-of-window) -- never a second, disagreeing number. ``level``\n315\t    is ``None`` (UNKNOWN) when no EVAP freeze frame carries a fuel reading;\n316\t    nothing here is ever invented.\n317\t    \"\"\"\n318\t    lo, hi = _EVAP_FUEL_WINDOW\n319\t    for ff in freeze_frames:\n320\t        for p in ff.get(\"key\") or []:\n321\t            if p.get(\"name\") != \"Fuel level\":\n322\t                continue\n323\t            level = _num(p.get(\"value\"))\n324\t            if level is None:\n325\t                continue\n326\t            in_window = lo <= level <= hi\n327\t            direction = None if in_window else (\"below\" if level < lo else \"above\")\n328\t            return {\"level\": level, \"window\": [lo, hi], \"in_window\": in_window,\n329\t                    \"direction\": direction}\n330\t    return {\"level\": None, \"window\": [lo, hi], \"in_window\": None, \"direction\": None}\n331\t\n332\t\n333\tdef readiness_panel(vin: str, dossier: dict[str, Any]) -> dict[str, Any]:\n334\t    \"\"\"The bench's monitor-readiness panel: the latest from-car readiness\n335\t    observation since the last clear, or an honest \"no readiness read yet\".\n336\t\n337\t    Reuses :func:`_latest_readiness` -- the same observation the verdict\n338\t    itself reads -- so the bench panel and the verdict can never disagree\n339\t    about what the car's own monitors last said.\n340\t    \"\"\"\n341\t    cleared_at, _cleared_by, _ca = _clear_info(dossier)\n342\t    obs = _latest_readiness(vin, cleared_at)\n343\t    if obs is None:\n344\t        return {\"at\": None, \"monitors\": [], \"all_complete\": None,\n345\t                \"note\": \"no readiness read yet\"}\n346\t    data = obs.get(\"data\") or {}\n347\t    since = data.get(\"since_clear\") or {}\n348\t    monitors = since.get(\"monitors\") or []\n349\t    return {\n350\t        \"at\": obs.get(\"at\"),\n351\t        \"monitors\": [{\"name\": m.get(\"monitor\"), \"complete\": bool(m.get(\"complete\"))}\n352\t                     for m in monitors],\n353\t        \"all_complete\": bool(since.get(\"all_complete\")) if monitors else None,\n354\t        \"note\": None if monitors else \"readiness read, but no monitor list decoded\",\n355\t    }\n356\t\n357\t\n358\tdef _evap_from_readiness(obs: dict[str, Any] | None) -> dict[str, Any] | None:\n359\t    if obs is None:\n360\t        return None\n361\t    data = obs.get(\"data\") or {}\n362\t    since = data.get(\"since_clear\") or {}\n363\t    monitors = since.get(\"monitors\") or []\n364\t    evap = next((m for m in monitors if m.get(\"monitor\") == \"Evaporative system\"), None)\n365\t    if not monitors:\n366\t        state = None\n367\t    elif evap is None:\n368\t        state = \"not_supported\"\n369\t    else:\n370\t        state = \"complete\" if evap.get(\"complete\") else \"incomplete\"\n371\t    return {\"at\": obs.get(\"at\"), \"evap_monitor\": state,\n372\t            \"all_complete\": bool(since.get(\"all_complete\"))}\n373\t\n374\t\n375\t# --- verdict -----------------------------------------------------------------\n376\t\n377\t\n378\tdef _verdict_actions(vin: str, enabled: bool) -> list[dict[str, Any]]:\n379\t    hint = \"\" if enabled else \"connect the car (ELM327 on COM3)\"\n380\t    return [\n381\t        {\"label\": \"Verify repair\", \"kind\": \"readiness\", \"href\": f\"/v/{vin}/verify\",\n382\t         \"enabled\": enabled, \"hint\": hint},\n383\t        {\"label\": \"EVAP fault tree\", \"kind\": \"link\", \"href\": f\"/v/{vin}/tree\",\n384\t         \"enabled\": True, \"hint\": \"\"},\n385\t        {\"label\": \"Evidence gate\", \"kind\": \"link\", \"href\": f\"/v/{vin}/gate\",\n386\t         \"enabled\": True, \"hint\": \"\"},\n387\t    ]\n388\t\n389\t\n390\tdef _verdict_summary(state: str, open_work: list[dict[str, Any]],\n391\t                     cleared_at: str | None, dossier: dict[str, Any]) -> str:\n392\t    if open_work:\n393\t        codes = open_work[0][\"codes\"][:3]\n394\t    else:\n395\t        chronic = (dossier.get(\"history\") or {}).get(\"chronic\") or []\n396\t        codes = sorted({_base(r.get(\"dtc\", \"\")) for r in chronic})[:3]\n397\t    code_str = \"/\".join(codes) if codes else \"the logged codes\"\n398\t    cleared_short = _short_date(cleared_at) if cleared_at else None\n399\t\n400\t    if state == \"NO_DATA\":\n401\t        return \"No MES logs on file for this vehicle.\"\n402\t    if state == \"ACTIVE_FAULTS\":\n403\t        return f\"{code_str} active now -- not cleared, not resolved.\"\n404\t    if state == \"VERIFIED_CLEAN\":\n405\t        return f\"{code_str} cleared {cleared_short}; EVAP monitor ran clean. Repair verified.\"\n406\t    return f\"{code_str} cleared {cleared_short}; monitors have not re-run. Not proof of repair.\"\n407\t\n408\t\n409\tdef _build_verdict(vin: str, dossier: dict[str, Any], live_status: dict[str, Any] | None,\n410\t                   open_work: list[dict[str, Any]]) -> dict[str, Any]:\n411\t    identity = dossier.get(\"identity\") or {}\n412\t    enabled = live_available(live_status)\n413\t\n414\t    if not identity.get(\"log_count\"):\n415\t        return {\"state\": \"NO_DATA\", \"label\": \"No data\",\n416\t                \"summary\": \"No MES logs on file for this vehicle.\",\n417\t                \"basis\": [\"no logs matched this VIN\"],\n418\t                \"cleared_at\": None, \"cleared_by\": None, \"readiness\": None,\n419\t                \"actions\": _verdict_actions(vin, enabled)}\n420\t\n421\t    cp = dossier.get(\"current_picture\") or {}\n422\t    history = dossier.get(\"history\") or {}\n423\t    cleared_at, cleared_by, clear_assessment = _clear_info(dossier)\n424\t\n425\t    basis: list[str] = []\n426\t    active = False\n427\t\n428\t    latest_session = cp.get(\"latest_session\") or {}\n429\t    if (cleared_at and latest_session.get(\"timestamp\")\n430\t            and latest_session.get(\"timestamp\") > cleared_at\n431\t            and latest_session.get(\"dtcs\")):\n432\t        active = True\n433\t        basis.append(f\"newest session ({latest_session['timestamp']}) holds DTCs \"\n434\t                     f\"after the {cleared_at} clear\")\n435\t\n436\t    latest_scan = cp.get(\"latest_scan\") or {}\n437\t    if (cleared_at and latest_scan.get(\"timestamp\")\n438\t            and latest_scan.get(\"timestamp\") > cleared_at\n439\t            and latest_scan.get(\"modules_with_faults\")):\n440\t        active = True\n441\t        basis.append(f\"newest scan ({latest_scan['timestamp']}) holds DTCs \"\n442\t                     f\"after the {cleared_at} clear\")\n443\t\n444\t    returned_in_session = (clear_assessment or {}).get(\"codes_returned_in_session\") or []\n445\t    if returned_in_session:\n446\t        active = True\n447\t        basis.append(\"codes returned in the clearing session: \"\n448\t                     + \", \".join(returned_in_session))\n449\t\n450\t    uncleared = (clear_assessment or {}).get(\"codes_that_would_not_clear\") or []\n451\t    if uncleared:\n452\t        active = True\n453\t        basis.append(\"codes would not clear: \" + \", \".join(uncleared))\n454\t\n455\t    if history.get(\"returned_after_clear\"):\n456\t        active = True\n457\t        basis.append(\"returned after a clear: \" + \", \".join(\n458\t            sorted(_base(r.get(\"dtc\", \"\")) for r in history[\"returned_after_clear\"])))\n459\t\n460\t    readiness = None\n461\t    if cleared_at:\n462\t        readiness = _evap_from_readiness(_latest_readiness(vin, cleared_at))\n463\t\n464\t    if active:\n465\t        state, label = \"ACTIVE_FAULTS\", \"Active faults\"\n466\t    elif cleared_at is None:\n467\t        if history.get(\"chronic\"):\n468\t            state, label = \"ACTIVE_FAULTS\", \"Active faults\"\n469\t            basis.append(\"chronic codes on file and no clear recorded\")\n470\t        else:\n471\t            state, label = \"NO_DATA\", \"No data\"\n472\t            basis.append(\"no open codes and no clear on file\")\n473\t    elif readiness and readiness.get(\"evap_monitor\") == \"complete\":\n474\t        state, label = \"VERIFIED_CLEAN\", \"Verified clean\"\n475\t        basis.append(f\"EVAP monitor complete on a live read at {readiness['at']}, \"\n476\t                     f\"no code has returned since the {cleared_at} clear\")\n477\t    else:\n478\t        state, label = \"UNVERIFIED_REPAIR\", \"Unverified repair\"\n479\t        basis.append(f\"last clear {cleared_at} ({cleared_by or 'unknown source'}); \"\n480\t                     f\"no code has returned\")\n481\t        if readiness is None:\n482\t            basis.append(\"no readiness read from the car since the clear\")\n483\t        else:\n484\t            basis.append(f\"readiness read at {readiness['at']} -- EVAP monitor \"\n485\t                         f\"{readiness.get('evap_monitor') or 'unknown'}\")\n486\t\n487\t    return {\n488\t        \"state\": state, \"label\": label,\n489\t        \"summary\": _verdict_summary(state, open_work, cleared_at, dossier),\n490\t        \"basis\": basis,\n491\t        \"cleared_at\": cleared_at.split(\" \")[0] if cleared_at else None,\n492\t        \"cleared_by\": cleared_by,\n493\t        \"readiness\": readiness,\n494\t        \"actions\": _verdict_actions(vin, enabled),\n495\t    }\n496\t\n497\t\n498\t# --- verdict.next_action -- the one-sentence \"what do I do right now\" -------\n499\t#\n500\t# Added for the bench page (cuore/services/bench_bridge.py): a mechanic\n501\t# landing on a car should not have to read the verdict's basis list and the\n502\t# open-work cards to work out what to actually do next. Nothing here is a\n503\t# new judgement -- it just combines the verdict state already computed above\n504\t# with the same fuel-out-of-window flag :func:`_build_freeze_frames` already\n505\t# derives and the same open-work steps :func:`_build_open_work` already\n506\t# orders, into the one sentence (plus a short ``blocker`` label and the\n507\t# ``next_step_id`` it points at) the bench page's headline needs.\n508\t\n509\t\n510\tdef _first_unchecked_step(open_work: list[dict[str, Any]]\n511\t                          ) -> tuple[dict[str, Any] | None, dict[str, Any] | None]:\n512\t    \"\"\"The first not-yet-done step across every open-work card, in the same\n513\t    order the cards themselves are already in (curated families first, then\n514\t    the generic ones) -- ``(card, step)``, or ``(None, None)`` if every step\n515\t    on file is ticked.\"\"\"\n516\t    for card in open_work:\n517\t        for step in card.get(\"steps\") or []:\n518\t            if not step.get(\"done\"):\n519\t                return card, step\n520\t    return None, None\n521\t\n522\t\n523\tdef _step_bit(step: dict[str, Any] | None) -> str | None:\n524\t    \"\"\"\"<step text> (<bulletin>)\" -- the fragment both the ACTIVE_FAULTS and\n525\t    fuel-blocked UNVERIFIED_REPAIR sentences below quote verbatim.\"\"\"\n526\t    if step is None:\n527\t        return None\n528\t    bulletin = step.get(\"ref\") or \"no bulletin on file\"\n529\t    return f\"{step['text']} ({bulletin})\"\n530\t\n531\t\n532\tdef _fuel_out_of_window(freeze_frames: list[dict[str, Any]]\n533\t                        ) -> tuple[float, str, float] | None:\n534\t    \"\"\"``(level, \"above\"/\"below\", threshold)`` for the first EVAP freeze-frame\n535\t    fuel reading outside :data:`_EVAP_FUEL_WINDOW` -- the same flag\n536\t    :func:`_build_freeze_frames` already set on that reading -- or ``None``\n537\t    when no freeze frame carries that flag.\"\"\"\n538\t    lo, hi = _EVAP_FUEL_WINDOW\n539\t    for ff in freeze_frames:\n540\t        for p in ff.get(\"key\") or []:\n541\t            if p.get(\"name\") != \"Fuel level\" or not p.get(\"flag\"):\n542\t                continue\n543\t            level = _num(p.get(\"value\"))\n544\t            if level is None:\n545\t                continue\n546\t            return level, (\"below\" if level < lo else \"above\"), (lo if level < lo else hi)\n547\t    return None\n548\t\n549\t\n550\tdef _verdict_next_action(verdict: dict[str, Any], open_work: list[dict[str, Any]],\n551\t                         freeze_frames: list[dict[str, Any]]\n552\t                         ) -> tuple[str, str, str | None]:\n553\t    \"\"\"``(next_action sentence, blocker label, next_step_id)`` for one\n554\t    verdict. Never raises -- a missing open-work step or freeze frame just\n555\t    means a shorter sentence, not a broken one.\"\"\"\n556\t    state = verdict.get(\"state\")\n557\t    _card, step = _first_unchecked_step(open_work)\n558\t    step_id = step.get(\"id\") if step else None\n559\t    bit = _step_bit(step)\n560\t\n561\t    if state == \"UNVERIFIED_REPAIR\":\n562\t        fuel = _fuel_out_of_window(freeze_frames)\n563\t        if fuel is not None:\n564\t            level, direction, threshold = fuel\n565\t            sentence = (f\"Cannot verify yet: the EVAP monitor will not run {direction} \"\n566\t                       f\"{threshold:g} % fuel (set at {level:g} %). Burn fuel into the \"\n567\t                       f\"{_EVAP_FUEL_WINDOW[0]:g}-{_EVAP_FUEL_WINDOW[1]:g} % window, then \"\n568\t                       f\"complete a drive cycle.\")\n569\t            if bit:\n570\t                sentence += f\" Meanwhile: {bit}.\"\n571\t            return sentence, \"fuel out of window\", step_id\n572\t        sentence = (\"Cannot verify yet: no readiness read since the clear. Read \"\n573\t                    \"readiness once the drive cycle completes.\")\n574\t        if bit:\n575\t            sentence += f\" Meanwhile: {bit}.\"\n576\t        return sentence, \"awaiting drive cycle\", step_id\n577\t\n578\t    if state == \"ACTIVE_FAULTS\":\n579\t        if bit:\n580\t            return f\"Start with {bit}.\", \"active faults\", step_id\n581\t        return \"Active faults on file -- open the codes to begin.\", \"active faults\", None\n582\t\n583\t    if state == \"VERIFIED_CLEAN\":\n584\t        readiness = verdict.get(\"readiness\") or {}\n585\t        date = _short_date(readiness.get(\"at\")) or verdict.get(\"cleared_at\") or \"the last read\"\n586\t        return f\"Verified by readiness read on {date}: release.\", \"none\", None\n587\t\n588\t    return \"Read the car.\", \"no data\", None\n589\t\n590\t\n591\t# --- open work (family findings as a checklist) -----------------------------\n592\t\n593\t\n594\tdef _family_refs(codes: list[str], per_code: dict[str, Any],\n595\t                 reading: str) -> list[dict[str, Any]]:\n596\t    seen: dict[str, dict[str, Any]] = {}\n597\t    for code in codes:\n598\t        for b in per_code.get(code, []):\n599\t            num = b.get(\"bulletin\")\n600\t            if num and num not in seen:\n601\t                seen[num] = {\"label\": num, \"href\": f\"#tsb-{_slug(num)}\"}\n602\t    for doc in re.findall(r\"docs/\\S+?\\.md\", reading or \"\"):\n603\t        if doc not in seen:\n604\t            seen[doc] = {\"label\": doc, \"href\": None}\n605\t    return list(seen.values())\n606\t\n607\t\n608\tdef _build_open_work(vin: str, dossier: dict[str, Any],\n609\t                     checklist: dict[str, Any]) -> list[dict[str, Any]]:\n610\t    tsb = dossier.get(\"tsb_matches\") or {}\n611\t    findings = tsb.get(\"family_findings\") or []\n612\t    per_code = tsb.get(\"per_code\") or {}\n613\t    cards = []\n614\t    covered_codes: set[str] = set()\n615\t    for f in findings:\n616\t        family = f.get(\"family\") or \"\"\n617\t        steps_def = FAMILY_STEPS.get(family)\n618\t        if not steps_def:\n619\t            continue  # no checklist table for this family yet\n620\t        codes = [c.upper() for c in (f.get(\"codes\") or [])]\n621\t        covered_codes.update(codes)\n622\t        steps = []\n623\t        done = 0\n624\t        for s in steps_def:\n625\t            st = checklist.get(s[\"id\"]) or {}\n626\t            is_done = bool(st.get(\"done\"))\n627\t            done += int(is_done)\n628\t            steps.append({\n629\t                \"id\": s[\"id\"], \"text\": s[\"text\"], \"ref\": s[\"ref\"],\n630\t                \"ref_href\": f\"#tsb-{_slug(s['ref'])}\" if s[\"ref\"] else None,\n631\t                \"done\": is_done, \"done_at\": st.get(\"done_at\"),\n632\t                \"done_by\": st.get(\"done_by\"),\n633\t            })\n634\t        title = _FAMILY_TITLES.get(family, f\"{family}: one system fault\")\n635\t        if \"{n}\" in title:\n636\t            title = title.format(n=len(codes))\n637\t        cards.append({\n638\t            \"family\": family, \"title\": title, \"codes\": codes, \"steps\": steps,\n639\t            \"refs\": _family_refs(codes, per_code, f.get(\"reading\", \"\")),\n640\t            \"progress\": {\"done\": done, \"total\": len(steps_def)},\n641\t        })\n642\t\n643\t    # Every other family this car's own history shows, grouped by the\n644\t    # generic SAE-range classification above, with steps pulled live from\n645\t    # mes.faulttree via mes_bridge.fault_tree -- so EVAP keeps being the\n646\t    # richest, hand-curated example, but a misfire, fuel-trim, cooling,\n647\t    # body, chassis or ADAS code (or any other family) still gets a\n648\t    # sourced, actionable card instead of nothing.\n649\t    remaining = sorted(_history_codes(dossier) - covered_codes)\n650\t    groups: dict[str, list[str]] = {}\n651\t    labels: dict[str, str] = {}\n652\t    for code in remaining:\n653\t        fam = _generic_family_for(code)\n654\t        if fam is None:\n655\t            continue\n656\t        key, label = fam\n657\t        groups.setdefault(key, []).append(code)\n658\t        labels[key] = label\n659\t    for family_key in sorted(groups):\n660\t        codes = sorted(set(groups[family_key]))\n661\t        tree_steps = _generic_tree_steps(codes[0], vin)[:6]\n662\t        if not tree_steps:\n663\t            continue\n664\t        steps = []\n665\t        done = 0\n666\t        for i, s in enumerate(tree_steps):\n667\t            step_id = f\"{family_key}-{i + 1}\"\n668\t            st = checklist.get(step_id) or {}\n669\t            is_done = bool(st.get(\"done\"))\n670\t            done += int(is_done)\n671\t            text = s.get(\"title\") or s.get(\"test\") or \"Step\"\n672\t            if s.get(\"test\") and s.get(\"test\") != text:\n673\t                text = f\"{text}: {s['test']}\"\n674\t            steps.append({\n675\t                \"id\": step_id, \"text\": text, \"ref\": s.get(\"source\"),\n676\t                \"ref_href\": None,\n677\t                \"done\": is_done, \"done_at\": st.get(\"done_at\"),\n678\t                \"done_by\": st.get(\"done_by\"),\n679\t            })\n680\t        label = labels.get(family_key, family_key)\n681\t        title = (f\"{label}: one open issue\" if len(codes) == 1\n682\t                 else f\"{label}: {len(codes)} codes, one system\")\n683\t        cards.append({\n684\t            \"family\": family_key, \"title\": title, \"codes\": codes,\n685\t            \"steps\": steps, \"refs\": [],\n686\t            \"progress\": {\"done\": done, \"total\": len(steps)},\n687\t            \"generic\": True,\n688\t        })\n689\t    return cards\n690\t\n691\t\n692\tdef _family_map(dossier: dict[str, Any]) -> dict[str, str]:\n693\t    out: dict[str, str] = {}\n694\t    for f in (dossier.get(\"tsb_matches\") or {}).get(\"family_findings\", []):\n695\t        for c in f.get(\"codes\", []):\n696\t            out[c.upper()] = f.get(\"family\")\n697\t    return out\n698\t\n699\t\n700\t# --- the code table -----------------------------------------------------------\n701\t\n702\t\n703\tdef _code_status(base: str, last_seen: str | None, cleared_at: str | None,\n704\t                 codes_cleared: set[str], codes_returned: set[str],\n705\t                 codes_uncleared: set[str], last_findings: set[str],\n706\t                 last_findings_ts: str | None, recent_ts: list[str]) -> str:\n707\t    if base in codes_returned or base in codes_uncleared:\n708\t        return \"ACTIVE\"\n709\t    if cleared_at and last_seen and last_seen > cleared_at:\n710\t        return \"ACTIVE\"\n711\t    if base in last_findings and not (cleared_at and last_findings_ts\n712\t                                      and cleared_at >= last_findings_ts):\n713\t        return \"ACTIVE\"\n714\t    if cleared_at and base in codes_cleared and (not last_seen or last_seen <= cleared_at):\n715\t        return \"CLEARED_UNVERIFIED\"\n716\t    if cleared_at is None and last_seen and last_seen in recent_ts[:3]:\n717\t        return \"ACTIVE\"\n718\t    return \"STALE\"\n719\t\n720\t\n721\tdef _code_rows(vin: str, dossier: dict[str, Any], cleared_at: str | None,\n722\t              clear_assessment: dict[str, Any] | None, recent_ts: list[str],\n723\t              family_map: dict[str, str]\n724\t              ) -> tuple[list[dict[str, Any]], dict[str, int]]:\n725\t    history = dossier.get(\"history\") or {}\n726\t    cp = dossier.get(\"current_picture\") or {}\n727\t    last_findings_session = cp.get(\"last_session_with_findings\") or {}\n728\t    last_findings = {_base(d.get(\"code\") or d.get(\"dtc\") or \"\")\n729\t                     for d in last_findings_session.get(\"dtcs\", [])}\n730\t    last_findings_ts = last_findings_session.get(\"timestamp\")\n731\t\n732\t    codes_cleared = {_base(c) for c in (clear_assessment or {}).get(\"codes_cleared\", [])}\n733\t    codes_returned = {_base(c) for c in\n734\t                      (clear_assessment or {}).get(\"codes_returned_in_session\", [])}\n735\t    codes_uncleared = {_base(c) for c in\n736\t                       (clear_assessment or {}).get(\"codes_that_would_not_clear\", [])}\n737\t\n738\t    rows: list[dict[str, Any]] = []\n739\t    for bucket in (\"chronic\", \"returned_after_clear\", \"seen_once\"):\n740\t        for rec in history.get(bucket, []):\n741\t            full = rec.get(\"dtc\", \"\")\n742\t            base = _base(full)\n743\t            last_seen = rec.get(\"last_seen\")\n744\t            status = _code_status(base, last_seen, cleared_at, codes_cleared,\n745\t                                  codes_returned, codes_uncleared, last_findings,\n746\t                                  last_findings_ts, recent_ts)\n747\t            distance = rec.get(\"distance_span_km\")\n748\t            rows.append({\n749\t                \"code\": base, \"dtc\": full,\n750\t                \"description\": (rec.get(\"descriptions\") or [\"\"])[0],\n751\t                \"system\": _SYSTEM_BY_LETTER.get(base[:1], base[:1] if base else None),\n752\t                \"bucket\": bucket,\n753\t                \"status\": status, \"status_label\": _STATUS_LABEL[status],\n754\t                \"sessions\": rec.get(\"sessions\"),\n755\t                \"last_seen_short\": _short_date(last_seen),\n756\t                \"last_seen\": last_seen, \"first_seen\": rec.get(\"first_seen\"),\n757\t                \"distance_km\": round(distance) if distance is not None else None,\n758\t                \"href\": f\"/v/{vin}/code/{base}\",\n759\t                \"family\": family_map.get(base),\n760\t            })\n761\t\n762\t    counts = {\"chronic\": 0, \"seen_once\": 0, \"returned_after_clear\": 0,\n763\t             \"active\": 0, \"stale\": 0}\n764\t    for r in rows:\n765\t        counts[r[\"bucket\"]] = counts.get(r[\"bucket\"], 0) + 1\n766\t        if r[\"status\"] == \"ACTIVE\":\n767\t            counts[\"active\"] += 1\n768\t        elif r[\"status\"] == \"STALE\":\n769\t            counts[\"stale\"] += 1\n770\t    return rows, counts\n771\t\n772\t\n773\t# --- already attempted -------------------------------------------------------\n774\t\n775\t\n776\tdef _build_attempted(vin: str) -> list[dict[str, Any]]:\n777\t    try:\n778\t        data = mes_bridge.actuator_history(vin=vin)\n779\t    except BridgeError:\n780\t        return []\n781\t    note = data.get(\"note\")\n782\t    groups: dict[tuple[str, str], dict[str, Any]] = {}\n783\t    for r in data.get(\"runs\", []):\n784\t        key = (r.get(\"operation\"), r.get(\"outcome\"))\n785\t        g = groups.setdefault(key, {\"operation\": r.get(\"operation\"),\n786\t                                    \"kind\": r.get(\"kind\"), \"outcome\": r.get(\"outcome\"),\n787\t                                    \"reason\": None, \"rows\": []})\n788\t        g[\"rows\"].append(r)\n789\t        if r.get(\"reason\") and not g[\"reason\"]:\n790\t            g[\"reason\"] = r.get(\"reason\")\n791\t\n792\t    out = []\n793\t    for g in groups.values():\n794\t        times = sorted(r.get(\"timestamp\") for r in g[\"rows\"] if r.get(\"timestamp\"))\n795\t        reason = g[\"reason\"]\n796\t        footnote = note if (reason and note and \"engine running\" in reason.lower()) else None\n797\t        out.append({\n798\t            \"operation\": g[\"operation\"], \"kind\": g[\"kind\"], \"outcome\": g[\"outcome\"],\n799\t            \"count\": len(g[\"rows\"]),\n800\t            \"first_short\": _short_date(times[0]) if times else None,\n801\t            \"last_short\": _short_date(times[-1]) if times else None,\n802\t            \"reason\": reason, \"reason_chip\": reason, \"footnote\": footnote,\n803\t            \"rows\": g[\"rows\"],\n804\t        })\n805\t    out.sort(key=lambda g: (g[\"outcome\"] != \"FAILED TO EXECUTE\", g[\"operation\"] or \"\"))\n806\t    return out\n807\t\n808\t\n809\t# --- freeze frames -------------------------------------------------------------\n810\t\n811\t\n812\tdef _build_freeze_frames(vin: str, dossier: dict[str, Any]) -> list[dict[str, Any]]:\n813\t    cp = dossier.get(\"current_picture\") or {}\n814\t    target_ts = ((cp.get(\"last_session_with_findings\") or {}).get(\"timestamp\")\n815\t                or (cp.get(\"latest_session\") or {}).get(\"timestamp\"))\n816\t    if not target_ts:\n817\t        return []\n818\t    try:\n819\t        data = mes_bridge.freeze_frames(vin=vin)\n820\t    except BridgeError:\n821\t        return []\n822\t\n823\t    odo_last = (dossier.get(\"identity\") or {}).get(\"odometer_last_km\")\n824\t    out = []\n825\t    for f in data.get(\"frames\", []):\n826\t        if f.get(\"timestamp\") != target_ts:\n827\t            continue\n828\t        ff = f.get(\"freeze_frame\") or {}\n829\t        base = _base(f.get(\"dtc\", \"\"))\n830\t        key = []\n831\t        for name in _KEY_FRAME_PARAMS:\n832\t            if name not in ff:\n833\t                continue\n834\t            value = ff[name]\n835\t            flag = None\n836\t            if name == \"Fuel level\" and base in _EVAP_CODES:\n837\t                level = _num(value)\n838\t                lo, hi = _EVAP_FUEL_WINDOW\n839\t                if level is not None and (level < lo or level > hi):\n840\t                    bound = f\"below {lo:g} %\" if level < lo else f\"above {hi:g} %\"\n841\t                    flag = f\"{bound}: EVAP monitor could not run\"\n842\t            key.append({\"name\": name, \"value\": value, \"flag\": flag})\n843\t        odo_frame = _num(ff.get(\"Odometer\"))\n844\t        set_km_ago = (round(odo_last - odo_frame)\n845\t                     if odo_last is not None and odo_frame is not None else None)\n846\t        out.append({\n847\t            \"code\": f.get(\"dtc\"), \"key\": key, \"set_km_ago\": set_km_ago,\n848\t            \"all\": [{\"name\": n, \"value\": v} for n, v in ff.items()],\n849\t        })\n850\t    return out\n851\t\n852\t\n853\t# --- blind spots as actions ----------------------------------------------------\n854\t\n855\t\n856\tdef _blind_spot_action(vin: str, closes_it: str, enabled: bool) -> dict[str, Any]:\n857\t    low = (closes_it or \"\").lower()\n858\t    hint = \"\" if enabled else \"connect the car (ELM327 on COM3)\"\n859\t    if \"read_readiness\" in low:\n860\t        return {\"label\": \"Read readiness\", \"kind\": \"readiness\",\n861\t                \"href\": f\"/v/{vin}/verify\", \"enabled\": enabled, \"hint\": hint}\n862\t    if \"read_permanent_dtcs\" in low:\n863\t        return {\"label\": \"Read permanent DTCs\", \"kind\": \"permanent\", \"href\": None,\n864\t                \"enabled\": enabled, \"hint\": hint}\n865\t    if \"mode06\" in low or \"send_raw\" in low:\n866\t        return {\"label\": \"Read Mode $06\", \"kind\": \"mode06\", \"href\": None,\n867\t                \"enabled\": enabled, \"hint\": hint}\n868\t    if \"already closed\" in low:\n869\t        return {\"label\": \"Answered\", \"kind\": \"link\", \"href\": f\"/v/{vin}/dealer\",\n870\t                \"enabled\": True, \"hint\": \"\"}\n871\t    if \"witech\" in low or \"dealer\" in low:\n872\t        return {\"label\": \"Dealer / wiTECH\", \"kind\": \"dealer\", \"href\": f\"/v/{vin}/dealer\",\n873\t                \"enabled\": True, \"hint\": \"\"}\n874\t    return {\"label\": \"Manual check\", \"kind\": \"manual\", \"href\": None,\n875\t            \"enabled\": True, \"hint\": \"\"}\n876\t\n877\t\n878\tdef _build_blind_spots(vin: str, dossier: dict[str, Any],\n879\t                       live_status: dict[str, Any] | None) -> list[dict[str, Any]]:\n880\t    enabled = live_available(live_status)\n881\t    out = []\n882\t    for bs in dossier.get(\"blind_spots\", []):\n883\t        out.append({\n884\t            \"question\": bs.get(\"question\", \"\"),\n885\t            \"why\": bs.get(\"why_unknown\", \"\"),\n886\t            \"action\": _blind_spot_action(vin, bs.get(\"closes_it\", \"\"), enabled),\n887\t        })\n888\t    return out\n889\t\n890\t\n891\t# --- bulletins, deduplicated ---------------------------------------------------\n892\t\n893\t\n894\tdef _supersedes(action: str) -> str | None:\n895\t    m = re.search(r\"[Ss]upersed(?:es|ed)\\s+([A-Za-z0-9.\\-]+)\", action or \"\")\n896\t    return m.group(1).rstrip(\".\") if m else None\n897\t\n898\t\n899\tdef _build_bulletins(dossier: dict[str, Any],\n900\t                     open_work: list[dict[str, Any]]) -> list[dict[str, Any]]:\n901\t    tsb = dossier.get(\"tsb_matches\") or {}\n902\t    per_code = tsb.get(\"per_code\") or {}\n903\t    relevant = {c for card in open_work for c in card[\"codes\"]}\n904\t\n905\t    by_num: dict[str, dict[str, Any]] = {}\n906\t    for code, matches in per_code.items():\n907\t        for b in matches:\n908\t            num = b.get(\"bulletin\")\n909\t            if not num:\n910\t                continue\n911\t            entry = by_num.setdefault(num, {\n912\t                \"id\": num, \"anchor\": f\"tsb-{_slug(num)}\", \"title\": b.get(\"title\"),\n913\t                \"action\": b.get(\"action\"), \"caution\": b.get(\"caution\"),\n914\t                \"codes\": set(), \"superseded\": _supersedes(b.get(\"action\", \"\")),\n915\t                \"source\": b.get(\"source\"), \"relevance\": 0,\n916\t            })\n917\t            entry[\"codes\"].update(b.get(\"dtcs\") or [code])\n918\t            if code.upper() in relevant:\n919\t                entry[\"relevance\"] += 1\n920\t\n921\t    out = []\n922\t    for entry in by_num.values():\n923\t        entry[\"codes\"] = sorted(entry[\"codes\"])\n924\t        out.append(entry)\n925\t    out.sort(key=lambda e: (-e[\"relevance\"], e[\"id\"]))\n926\t    return out\n927\t\n928\t\n929\t# --- latest session/scan -------------------------------------------------------\n930\t\n931\t\n932\tdef _build_latest(dossier: dict[str, Any]) -> dict[str, Any]:\n933\t    cp = dossier.get(\"current_picture\") or {}\n934\t    ls = cp.get(\"latest_session\") or {}\n935\t    sc = cp.get(\"latest_scan\") or {}\n936\t    return {\n937\t        \"session_short\": _short_date(ls.get(\"timestamp\"), with_time=True),\n938\t        \"session_file\": ls.get(\"file\"), \"ecu\": ls.get(\"ecu\"),\n939\t        \"scan_short\": (_short_date(sc.get(\"timestamp\"), with_time=True)\n940\t                       if sc.get(\"timestamp\") else None),\n941\t        \"scan_file\": sc.get(\"file\"),\n942\t    }\n943\t\n944\t\n945\t# --- checklist step ids, for the API's validation ----------------------------\n946\t\n947\t\n948\tdef checklist_step_ids(vin: str, dossier: dict[str, Any]) -> set[str]:\n949\t    \"\"\"Every checklist step id this vehicle's open-work cards expose.\n950\t\n951\t    Used by the checklist API to reject a step id that is not actually on\n952\t    this car's dossier -- a step id is only meaningful in the context of the\n953\t    family finding it belongs to.\n954\t\n955\t    This used to call ``_build_open_work(vin, dossier, {})`` fresh every\n956\t    time -- a second, uncached re-evaluation of the fault tree per code\n957\t    (``_generic_tree_steps`` -> ``mes_bridge.fault_tree`` -> real FES\n958\t    parsing) on top of the one ``build_view`` already pays for and caches.\n959\t    The checklist dict passed in only ever flips each step's own\n960\t    ``done``/``done_at``/``done_by``, never which step ids exist (see\n961\t    ``_build_open_work``'s body), so this is a pure function of\n962\t    ``(vin, dossier)`` and can share ``build_view``'s own\n963\t    ``dossier_view_core`` cache entry instead of building a second,\n964\t    checklist-blind copy of the same open-work list -- correct because the\n965\t    cache key (vin, newest MES-log mtime, newest state-file mtime) is the\n966\t    same staleness criteria either caller needs: a new log or any state\n967\t    file change invalidates it, same as ``build_view`` itself. Called from\n968\t    request paths that never built that core (e.g. checklist POST\n969\t    handlers), so it still has to build it the first time; callers that\n970\t    already called ``build_view`` this request (or the last one, if nothing\n971\t    changed) get a cache hit instead of a second fault-tree pass.\n972\t    \"\"\"\n973\t    core = cache.get_or_build(\n974\t        (\"dossier_view_core\", vin, mes_bridge.newest_mtime(vin), _state_fingerprint()),\n975\t        lambda: _build_view_core(vin, dossier),\n976\t    )\n977\t    return {s[\"id\"] for card in core[\"open_work\"] for s in card[\"steps\"]}\n978\t\n979\t\n980\t# --- the one entry point -----------------------------------------------------\n981\t\n982\t\n983\tdef _build_view_core(vin: str, dossier: dict[str, Any]) -> dict[str, Any]:\n984\t    \"\"\"Everything :func:`build_view` needs except the verdict and blind\n985\t    spots, which also read ``live_status`` and are cheap enough (no file\n986\t    I/O beyond what ``dossier`` already carries) to compute fresh on every\n987\t    call. Split out purely so it can be memoised -- see ``build_view``.\n988\t    \"\"\"\n989\t    checklist = checklist_store.get(vin)\n990\t    open_work = _build_open_work(vin, dossier, checklist)\n991\t\n992\t    family_map = _family_map(dossier)\n993\t    try:\n994\t        recent_ts = [e.get(\"timestamp\") for e in\n995\t                    mes_bridge.list_logs(vin=vin, limit=3)[\"logs\"]]\n996\t    except BridgeError:\n997\t        recent_ts = []\n998\t    cleared_at, _cleared_by, clear_assessment = _clear_info(dossier)\n999\t    codes, code_counts = _code_rows(vin, dossier, cleared_at, clear_assessment,\n1000\t                                    recent_ts, family_map)\n1001\t\n1002\t    return {\n1003\t        \"open_work\": open_work,\n1004\t        \"codes\": codes,\n1005\t        \"code_counts\": code_counts,\n1006\t        \"attempted\": _build_attempted(vin),\n1007\t        \"freeze_frames\": _build_freeze_frames(vin, dossier),\n1008\t        \"bulletins\": _build_bulletins(dossier, open_work),\n1009\t        \"latest\": _build_latest(dossier),\n1010\t        \"provenance_note\": dossier.get(\"provenance_note\", \"\"),\n1011\t    }\n1012\t\n1013\t\n1014\tdef build_view(vin: str, dossier: dict[str, Any],\n1015\t              live_status: dict[str, Any] | None) -> dict[str, Any]:\n1016\t    \"\"\"Everything the redesigned dossier page needs, computed once.\n1017\t\n1018\t    ``dossier`` is the workup dict (``mes_bridge.workup(vin=vin)``);\n1019\t    ``live_status`` is the same shape ``base.html``'s live strip already\n1020\t    renders (``port``, ``mes_state``, ``lock_holder``, ...), or ``None`` when\n1021\t    the caller has not computed it. Nothing here mutates either argument or\n1022\t    touches the car -- nothing here writes anything at all.\n1023\t\n1024\t    The dossier, job and flow pages between them call this several times\n1025\t    per render (the Job page alone calls it twice: once for its own\n1026\t    suggested-hypothesis evidence, once for the page body) and the open-work\n1027\t    cards alone re-evaluate a fault tree per code, parsing FES logs directly\n1028\t    -- seconds of work on a real corpus. Everything but the verdict and\n1029\t    blind spots is pulled from :func:`_build_view_core`, memoised on (vin,\n1030\t    newest MES-log mtime, newest state-file mtime) exactly like\n1031\t    ``cuore.web.routes._dossier`` already memoises the workup itself, so a\n1032\t    second call in the same request (or the next request, until a log or a\n1033\t    state file changes) costs a dict lookup instead of a re-evaluation. The\n1034\t    verdict and blind spots stay outside that cache because they depend on\n1035\t    ``live_status``, which varies request to request and is not part of the\n1036\t    key.\n1037\t    \"\"\"\n1038\t    core = cache.get_or_build(\n1039\t        (\"dossier_view_core\", vin, mes_bridge.newest_mtime(vin), _state_fingerprint()),\n1040\t        lambda: _build_view_core(vin, dossier),\n1041\t    )\n1042\t    verdict = _build_verdict(vin, dossier, live_status, core[\"open_work\"])\n1043\t    next_action, blocker, next_step_id = _verdict_next_action(\n1044\t        verdict, core[\"open_work\"], core[\"freeze_frames\"])\n1045\t    verdict[\"next_action\"] = next_action\n1046\t    verdict[\"blocker\"] = blocker\n1047\t    verdict[\"next_step_id\"] = next_step_id\n1048\t    blind_spots = _build_blind_spots(vin, dossier, live_status)\n1049\t    return {\"verdict\": verdict, \"blind_spots\": blind_spots, **core}\n1050\t\n1051\t\n1052\t__all__ = [\"build_view\", \"checklist_step_ids\", \"live_available\", \"readiness_result\",\n1053\t           \"fuel_status\", \"readiness_panel\", \"FAMILY_STEPS\"]\n1054\t"}]},"uuid":"ec49bdf7-68d9-4e35-8983-08498dd41ce9","timestamp":"2026-10-14T00:18:28.868Z","toolUseResult":{"type":"text","file":{"filePath":"C:\\Users\\User\\mcp-servers\\cuore\\services\\dossier_bridge.py","content":"\"\"\"Turns the raw workup dossier into the redesigned dossier page's contract.\n\nMECHANIC_UX_REVIEW.md's R1/R4/R5/R6/R7/R8/R9 all boil down to the same\ncomplaint: the knowledge in ``mes.workup`` is already senior-technician-grade\n(family findings, chronic/returned classification, TSB cross-reference) but\nthe page made the mechanic excavate it from prose and raw dicts. Nothing here\nre-derives that knowledge -- it only reshapes what ``mes_bridge.workup``\nalready returns (plus what the live link has observed) into the verdict,\nchecklists, code table, freeze-frame flags, deduplicated bulletins and\nrunnable blind-spot actions the template needs, so there is exactly one\nplace that decides what a status chip or a checklist step means.\n\n``build_view`` is the only entry point. Everything else is a private helper.\n\nLike every other file under ``cuore/services``, this is a *_bridge.py module,\nso it is allowed to import ``mes_bridge`` (never the ``mes`` package itself --\nnothing here needs to; the workup dict already carries what ``mes`` computed)\nand the small read-only ``cuore.live`` surfaces (``store`` for live\nobservations, ``checklists`` for shop-ticked steps).\n\"\"\"\n\nfrom __future__ import annotations\n\nimport re\nfrom datetime import datetime\nfrom typing import Any\n\nfrom . import cache, mes_bridge\nfrom .errors import BridgeError\nfrom ..live import checklists as checklist_store\nfrom ..live import config as live_config\nfrom ..live import store as live_store\n\n#: EVAP monitor runs at 15-85% fuel; cited wherever a freeze frame needs\n#: flagging. Matches the window ``mes`` itself states in verdict/fault-tree\n#: text -- not re-derived, just applied to one more surface.\n_EVAP_FUEL_WINDOW = (15.0, 85.0)\n_EVAP_CODES = {\"P0440\", \"P0441\", \"P0455\", \"P0456\", \"P1CEA\"}\n\n_SYSTEM_BY_LETTER = {\"P\": \"engine\", \"C\": \"chassis\", \"B\": \"body\", \"U\": \"network\"}\n\n_STATUS_LABEL = {\"ACTIVE\": \"Active\", \"CLEARED_UNVERIFIED\": \"Cleared, unverified\",\n                \"STALE\": \"Stale\"}\n\n#: Freeze-frame parameters worth a mechanic's first glance, in the order\n#: they should appear. Everything else still rides along in ``all``.\n_KEY_FRAME_PARAMS = [\"Fuel level\", \"Engine temperature\", \"Odometer\",\n                     \"Vehicle speed\", \"Engine speed\", \"Air temperature\"]\n\n#: One checklist per family this corpus's fault trees and TSBs recognise\n#: today. Transcribed once, here, from the family finding's own \"reading\"\n#: text and the EVAP/network fault trees -- see MECHANIC_UX_REVIEW.md R4.\n#: Keeping this as a table (not free-text parsing of ``reading``) is what\n#: makes checklist step ids stable across a wording change in ``mes``.\nFAMILY_STEPS: dict[str, list[dict[str, Any]]] = {\n    \"EVAP\": [\n        {\"id\": \"evap-1\", \"text\": \"Inspect the recirculation-line quick-connect\",\n         \"ref\": \"S2125000002\"},\n        {\"id\": \"evap-2\", \"text\": \"Run the purge/vent valve KOEO actuator test\",\n         \"ref\": None},\n        {\"id\": \"evap-3\", \"text\": \"Check hose routing\", \"ref\": \"9100325\"},\n        {\"id\": \"evap-4\", \"text\": \"Inspect the canister/ESIM\", \"ref\": \"9100471\"},\n        {\"id\": \"evap-5\", \"text\": \"Run a smoke test to localise the leak\",\n         \"ref\": None},\n        {\"id\": \"evap-6\", \"text\": \"Verify with SLVT or Mode $06\",\n         \"ref\": \"18-048-23\"},\n    ],\n    \"network\": [\n        {\"id\": \"network-1\", \"text\": \"Check the supply: F82 fuse and BCM feeds\",\n         \"ref\": \"S1808000005\"},\n        {\"id\": \"network-2\",\n         \"text\": \"Inspect connectors/grounds: XY201, G003A/B\",\n         \"ref\": \"S2008000032\"},\n        {\"id\": \"network-3\",\n         \"text\": \"Inspect connector terminals for spread/backed-out pins\",\n         \"ref\": \"S1708000262\"},\n    ],\n}\n\n_FAMILY_TITLES = {\n    \"EVAP\": \"EVAP: one system fault\",\n    \"network\": \"Network: one power/bus event, not {n} separate faults\",\n}\n\n#: EVAP was the first job this cuore app diagnosed, so it (and the network\n#: cascade) got a hand-curated ``FAMILY_STEPS`` table above. Every other\n#: family this car's history can throw -- misfire, fuel trim, cooling, body,\n#: chassis, ADAS, or anything else SAE's DTC-prefix convention covers --\n#: still needs an open-work card; :func:`_build_open_work` builds those\n#: generically, grouping codes by the family below and pulling steps live\n#: from ``mes_bridge.fault_tree`` (``mes.faulttree.tree_for`` -- the\n#: hand-written tree when one exists, else a sourced generated one) instead\n#: of a second hand-maintained step table. Patterns are checked in order;\n#: the first match wins. Generalised from the same SAE J2012 prefix-range\n#: convention ``mes.systems._sae_fallback`` already uses.\n_GENERIC_FAMILY_RULES: tuple[tuple[re.Pattern, str, str], ...] = (\n    (re.compile(r\"^P030[0-9]$\"), \"misfire\", \"Misfire\"),\n    (re.compile(r\"^P017[0-5]$\"), \"fuel_trim\", \"Fuel trim\"),\n    (re.compile(r\"^P01(0[0-9]|1[0-9]|2[0-9])$\"), \"cooling\",\n     \"Cooling / intake sensors\"),\n    (re.compile(r\"^P0[67][0-9]{2}$\"), \"engine_management\", \"Engine management\"),\n    (re.compile(r\"^P0[89][0-9]{2}$\"), \"transmission_driveline\",\n     \"Transmission / driveline\"),\n    (re.compile(r\"^C(141B|141C)$\"), \"adas\", \"ADAS (camera/radar)\"),\n    (re.compile(r\"^C[0-9A-F]{4}$\"), \"chassis\", \"Chassis (brakes/steering/suspension)\"),\n    (re.compile(r\"^B[0-9A-F]{4}$\"), \"body\", \"Body / comfort\"),\n    (re.compile(r\"^U[0-9A-F]{4}$\"), \"network\", \"Network / communication\"),\n    (re.compile(r\"^P[0-9A-F]{4}$\"), \"powertrain_other\", \"Powertrain (other)\"),\n)\n\n\ndef _generic_family_for(base: str) -> tuple[str, str] | None:\n    \"\"\"``(family_key, family_label)`` for a code with no hand-curated\n    ``FAMILY_STEPS`` entry, or ``None`` for something that isn't a\n    recognisable P/B/C/U code at all.\"\"\"\n    for pattern, key, label in _GENERIC_FAMILY_RULES:\n        if pattern.match(base):\n            return key, label\n    return None\n\n\ndef _history_codes(dossier: dict[str, Any]) -> set[str]:\n    \"\"\"Every base code present anywhere in this car's own history -- the\n    same ``chronic``/``returned_after_clear``/``seen_once`` buckets the code\n    table reads -- so a generic open-work card can be offered for a family\n    the TSB family-finding rule above doesn't recognise.\"\"\"\n    history = dossier.get(\"history\") or {}\n    out: set[str] = set()\n    for bucket in (\"chronic\", \"returned_after_clear\", \"seen_once\"):\n        for rec in history.get(bucket, []):\n            b = _base(rec.get(\"dtc\", \"\"))\n            if b:\n                out.add(b)\n    return out\n\n\ndef _generic_tree_steps(code: str, vin: str) -> list[dict[str, Any]]:\n    \"\"\"The first tree's steps for one code, via ``mes_bridge.fault_tree`` --\n    the hand-written tree when ``mes.faulttree.tree_for`` has one, else its\n    sourced generated tree. Never raises: a lookup failure just means no\n    generic card gets built for that code.\"\"\"\n    try:\n        result = mes_bridge.fault_tree(code, vin=vin)\n    except Exception:\n        return []\n    trees = result.get(\"trees\") or []\n    return trees[0].get(\"steps\") or [] if trees else []\n\n\n# --- small shared helpers --------------------------------------------------\n\n\ndef _base(code: str) -> str:\n    \"\"\"\"P0440-00\" -> \"P0440\". Same rule as ``mes.knowledge.base_code``,\n    reimplemented here rather than imported so this module never touches the\n    ``mes`` package directly.\"\"\"\n    code = (code or \"\").strip().upper()\n    return code.split(\"-\", 1)[0] if \"-\" in code else code\n\n\ndef _slug(text: str) -> str:\n    return re.sub(r\"[^A-Za-z0-9]+\", \"-\", (text or \"\").strip()).strip(\"-\")\n\n\ndef _parse_ts(ts: str | None) -> datetime | None:\n    if not ts:\n        return None\n    try:\n        return datetime.strptime(str(ts)[:19], \"%Y-%m-%d %H:%M:%S\")\n    except ValueError:\n        return None\n\n\ndef _short_date(ts: str | None, with_time: bool = False) -> str | None:\n    dt = _parse_ts(ts)\n    if dt is None:\n        return None\n    fmt = \"%d %b %H:%M\" if with_time else \"%d %b\"\n    if dt.year != datetime.now().year:\n        fmt += \" '%y\"\n    return dt.strftime(fmt)\n\n\ndef _num(display: Any) -> float | None:\n    \"\"\"Pull the leading number out of a display string like \"93.73 %\".\"\"\"\n    if display is None:\n        return None\n    m = re.match(r\"\\s*(-?\\d+(?:\\.\\d+)?)\", str(display))\n    return float(m.group(1)) if m else None\n\n\ndef _state_fingerprint() -> float:\n    \"\"\"Newest mtime across this app's mutable state files.\n\n    Checklists, jobs, shop visits, symptoms, notes, dealer results, tool\n    usage, live observations and the rest are all flat files sitting\n    directly under one shared directory -- every ``mes.*``/``cuore.live``\n    state module mirrors ``cuore.live.config.state_dir()`` (see each\n    module's own ``state_dir()`` docstring). Folded into\n    :func:`build_view`'s cache key so a ticked checklist step or a freshly\n    logged symptom invalidates the cached open-work/freeze-frame/attempted\n    build the same way a new MES log invalidates ``mes_bridge.newest_mtime``\n    -- no separate invalidation hook, same reasoning as ``cuore.services.cache``\n    itself.\n    \"\"\"\n    try:\n        d = live_config.state_dir()\n        return max((p.stat().st_mtime for p in d.iterdir() if p.is_file()), default=0.0)\n    except OSError:\n        return 0.0\n\n\ndef live_available(live_status: dict[str, Any] | None) -> bool:\n    \"\"\"Is the adapter reachable right now -- a port configured, and neither\n    MultiEcuScan nor another process holding it.\n\n    Same read ``base.html``'s live strip and ``/live`` already make of\n    ``live_ops.status()``: ``mes_state == \"connected\"`` means MES has the\n    port, and a ``lock_holder`` other than this process means something else\n    does. Used both to grey out the dossier's own action buttons and by\n    ``/v/{vin}/verify`` to decide whether it is safe to actually read.\n    \"\"\"\n    if not live_status or live_status.get(\"error\"):\n        return False\n    if not live_status.get(\"port\"):\n        return False\n    if live_status.get(\"mes_state\") == \"connected\":\n        return False\n    holder = live_status.get(\"lock_holder\")\n    if holder and holder != \"cuore\":\n        return False\n    return True\n\n\n# --- the last clear ---------------------------------------------------------\n\n\ndef _clear_info(dossier: dict[str, Any]\n                ) -> tuple[str | None, str | None, dict[str, Any] | None]:\n    \"\"\"(cleared_at full timestamp, cleared_by file, the clear_assessment dict).\n\n    ``current_picture.clear_assessment`` comes from two different shapes in\n    ``mes.workup``: a scan-based clear carries its own ``cleared_at``/\n    ``source``; a clear inside the anchored FES session itself carries\n    neither, because *that session* is the clear -- so its timestamp/file are\n    read off ``latest_session`` instead.\n    \"\"\"\n    cp = dossier.get(\"current_picture\") or {}\n    ca = cp.get(\"clear_assessment\")\n    if not ca:\n        return None, None, None\n    cleared_at = ca.get(\"cleared_at\")\n    cleared_by = ca.get(\"source\")\n    if not cleared_at:\n        latest = cp.get(\"latest_session\") or {}\n        cleared_at = latest.get(\"timestamp\")\n        cleared_by = latest.get(\"file\")\n    return cleared_at, cleared_by, ca\n\n\n# --- readiness, read from the car -------------------------------------------\n\n\ndef _latest_readiness(vin: str, after: str | None) -> dict[str, Any] | None:\n    \"\"\"The newest readiness observation from the car itself, after ``after``.\n\n    A read taken before the clear says nothing about the car now -- the same\n    reasoning ``mes.verdict._last_clear`` already applies to live DTC reads.\n    \"\"\"\n    try:\n        obs = live_store.recent_observations(200, vin=vin, kind=\"readiness\")\n    except Exception:  # noqa: BLE001 -- a broken store must never break the verdict\n        return None\n    best = None\n    for o in obs:\n        if not live_store.is_from_car(o):\n            continue\n        at = o.get(\"at\") or \"\"\n        if after and at <= after:\n            continue\n        if best is None or at > (best.get(\"at\") or \"\"):\n            best = o\n    return best\n\n\ndef readiness_result(raw: dict[str, Any]) -> dict[str, Any]:\n    \"\"\"Shape a live ``ops.obd_readiness()`` read for ``/v/{vin}/verify``.\n\n    ``verify.html`` destructures ``result.at`` / ``result.evap_monitor`` /\n    ``result.all_complete`` / ``result.monitors`` explicitly (never the raw\n    dict) -- this is the one place that produces that flat shape from the\n    nested ``since_clear``/``monitors`` payload ``ops.obd_readiness``\n    returns, so the page and the verdict's own ``readiness`` sub-object\n    agree on what \"the EVAP monitor is complete\" means.\n    \"\"\"\n    since = raw.get(\"since_clear\") or {}\n    monitors = since.get(\"monitors\") or []\n    evap = next((m for m in monitors if m.get(\"monitor\") == \"Evaporative system\"), None)\n    return {\n        \"at\": datetime.now().isoformat(timespec=\"seconds\"),\n        \"evap_monitor\": bool(evap and evap.get(\"complete\")),\n        \"all_complete\": bool(since.get(\"all_complete\")),\n        \"monitors\": [{\"name\": m.get(\"monitor\"), \"complete\": bool(m.get(\"complete\"))}\n                     for m in monitors],\n    }\n\n\ndef fuel_status(freeze_frames: list[dict[str, Any]]) -> dict[str, Any]:\n    \"\"\"Current fuel % and EVAP-window state, for the bench's live fuel gate.\n\n    Reads the same EVAP freeze-frame \"Fuel level\" reading the verdict's own\n    ``next_action`` sentence already quotes (:func:`_fuel_out_of_window`\n    scans the same frames but only returns a value when the reading is\n    flagged out-of-window) -- never a second, disagreeing number. ``level``\n    is ``None`` (UNKNOWN) when no EVAP freeze frame carries a fuel reading;\n    nothing here is ever invented.\n    \"\"\"\n    lo, hi = _EVAP_FUEL_WINDOW\n    for ff in freeze_frames:\n        for p in ff.get(\"key\") or []:\n            if p.get(\"name\") != \"Fuel level\":\n                continue\n            level = _num(p.get(\"value\"))\n            if level is None:\n                continue\n            in_window = lo <= level <= hi\n            direction = None if in_window else (\"below\" if level < lo else \"above\")\n            return {\"level\": level, \"window\": [lo, hi], \"in_window\": in_window,\n                    \"direction\": direction}\n    return {\"level\": None, \"window\": [lo, hi], \"in_window\": None, \"direction\": None}\n\n\ndef readiness_panel(vin: str, dossier: dict[str, Any]) -> dict[str, Any]:\n    \"\"\"The bench's monitor-readiness panel: the latest from-car readiness\n    observation since the last clear, or an honest \"no readiness read yet\".\n\n    Reuses :func:`_latest_readiness` -- the same observation the verdict\n    itself reads -- so the bench panel and the verdict can never disagree\n    about what the car's own monitors last said.\n    \"\"\"\n    cleared_at, _cleared_by, _ca = _clear_info(dossier)\n    obs = _latest_readiness(vin, cleared_at)\n    if obs is None:\n        return {\"at\": None, \"monitors\": [], \"all_complete\": None,\n                \"note\": \"no readiness read yet\"}\n    data = obs.get(\"data\") or {}\n    since = data.get(\"since_clear\") or {}\n    monitors = since.get(\"monitors\") or []\n    return {\n        \"at\": obs.get(\"at\"),\n        \"monitors\": [{\"name\": m.get(\"monitor\"), \"complete\": bool(m.get(\"complete\"))}\n                     for m in monitors],\n        \"all_complete\": bool(since.get(\"all_complete\")) if monitors else None,\n        \"note\": None if monitors else \"readiness read, but no monitor list decoded\",\n    }\n\n\ndef _evap_from_readiness(obs: dict[str, Any] | None) -> dict[str, Any] | None:\n    if obs is None:\n        return None\n    data = obs.get(\"data\") or {}\n    since = data.get(\"since_clear\") or {}\n    monitors = since.get(\"monitors\") or []\n    evap = next((m for m in monitors if m.get(\"monitor\") == \"Evaporative system\"), None)\n    if not monitors:\n        state = None\n    elif evap is None:\n        state = \"not_supported\"\n    else:\n        state = \"complete\" if evap.get(\"complete\") else \"incomplete\"\n    return {\"at\": obs.get(\"at\"), \"evap_monitor\": state,\n            \"all_complete\": bool(since.get(\"all_complete\"))}\n\n\n# --- verdict -----------------------------------------------------------------\n\n\ndef _verdict_actions(vin: str, enabled: bool) -> list[dict[str, Any]]:\n    hint = \"\" if enabled else \"connect the car (ELM327 on COM3)\"\n    return [\n        {\"label\": \"Verify repair\", \"kind\": \"readiness\", \"href\": f\"/v/{vin}/verify\",\n         \"enabled\": enabled, \"hint\": hint},\n        {\"label\": \"EVAP fault tree\", \"kind\": \"link\", \"href\": f\"/v/{vin}/tree\",\n         \"enabled\": True, \"hint\": \"\"},\n        {\"label\": \"Evidence gate\", \"kind\": \"link\", \"href\": f\"/v/{vin}/gate\",\n         \"enabled\": True, \"hint\": \"\"},\n    ]\n\n\ndef _verdict_summary(state: str, open_work: list[dict[str, Any]],\n                     cleared_at: str | None, dossier: dict[str, Any]) -> str:\n    if open_work:\n        codes = open_work[0][\"codes\"][:3]\n    else:\n        chronic = (dossier.get(\"history\") or {}).get(\"chronic\") or []\n        codes = sorted({_base(r.get(\"dtc\", \"\")) for r in chronic})[:3]\n    code_str = \"/\".join(codes) if codes else \"the logged codes\"\n    cleared_short = _short_date(cleared_at) if cleared_at else None\n\n    if state == \"NO_DATA\":\n        return \"No MES logs on file for this vehicle.\"\n    if state == \"ACTIVE_FAULTS\":\n        return f\"{code_str} active now -- not cleared, not resolved.\"\n    if state == \"VERIFIED_CLEAN\":\n        return f\"{code_str} cleared {cleared_short}; EVAP monitor ran clean. Repair verified.\"\n    return f\"{code_str} cleared {cleared_short}; monitors have not re-run. Not proof of repair.\"\n\n\ndef _build_verdict(vin: str, dossier: dict[str, Any], live_status: dict[str, Any] | None,\n                   open_work: list[dict[str, Any]]) -> dict[str, Any]:\n    identity = dossier.get(\"identity\") or {}\n    enabled = live_available(live_status)\n\n    if not identity.get(\"log_count\"):\n        return {\"state\": \"NO_DATA\", \"label\": \"No data\",\n                \"summary\": \"No MES logs on file for this vehicle.\",\n                \"basis\": [\"no logs matched this VIN\"],\n                \"cleared_at\": None, \"cleared_by\": None, \"readiness\": None,\n                \"actions\": _verdict_actions(vin, enabled)}\n\n    cp = dossier.get(\"current_picture\") or {}\n    history = dossier.get(\"history\") or {}\n    cleared_at, cleared_by, clear_assessment = _clear_info(dossier)\n\n    basis: list[str] = []\n    active = False\n\n    latest_session = cp.get(\"latest_session\") or {}\n    if (cleared_at and latest_session.get(\"timestamp\")\n            and latest_session.get(\"timestamp\") > cleared_at\n            and latest_session.get(\"dtcs\")):\n        active = True\n        basis.append(f\"newest session ({latest_session['timestamp']}) holds DTCs \"\n                     f\"after the {cleared_at} clear\")\n\n    latest_scan = cp.get(\"latest_scan\") or {}\n    if (cleared_at and latest_scan.get(\"timestamp\")\n            and latest_scan.get(\"timestamp\") > cleared_at\n            and latest_scan.get(\"modules_with_faults\")):\n        active = True\n        basis.append(f\"newest scan ({latest_scan['timestamp']}) holds DTCs \"\n                     f\"after the {cleared_at} clear\")\n\n    returned_in_session = (clear_assessment or {}).get(\"codes_returned_in_session\") or []\n    if returned_in_session:\n        active = True\n        basis.append(\"codes returned in the clearing session: \"\n                     + \", \".join(returned_in_session))\n\n    uncleared = (clear_assessment or {}).get(\"codes_that_would_not_clear\") or []\n    if uncleared:\n        active = True\n        basis.append(\"codes would not clear: \" + \", \".join(uncleared))\n\n    if history.get(\"returned_after_clear\"):\n        active = True\n        basis.append(\"returned after a clear: \" + \", \".join(\n            sorted(_base(r.get(\"dtc\", \"\")) for r in history[\"returned_after_clear\"])))\n\n    readiness = None\n    if cleared_at:\n        readiness = _evap_from_readiness(_latest_readiness(vin, cleared_at))\n\n    if active:\n        state, label = \"ACTIVE_FAULTS\", \"Active faults\"\n    elif cleared_at is None:\n        if history.get(\"chronic\"):\n            state, label = \"ACTIVE_FAULTS\", \"Active faults\"\n            basis.append(\"chronic codes on file and no clear recorded\")\n        else:\n            state, label = \"NO_DATA\", \"No data\"\n            basis.append(\"no open codes and no clear on file\")\n    elif readiness and readiness.get(\"evap_monitor\") == \"complete\":\n        state, label = \"VERIFIED_CLEAN\", \"Verified clean\"\n        basis.append(f\"EVAP monitor complete on a live read at {readiness['at']}, \"\n                     f\"no code has returned since the {cleared_at} clear\")\n    else:\n        state, label = \"UNVERIFIED_REPAIR\", \"Unverified repair\"\n        basis.append(f\"last clear {cleared_at} ({cleared_by or 'unknown source'}); \"\n                     f\"no code has returned\")\n        if readiness is None:\n            basis.append(\"no readiness read from the car since the clear\")\n        else:\n            basis.append(f\"readiness read at {readiness['at']} -- EVAP monitor \"\n                         f\"{readiness.get('evap_monitor') or 'unknown'}\")\n\n    return {\n        \"state\": state, \"label\": label,\n        \"summary\": _verdict_summary(state, open_work, cleared_at, dossier),\n        \"basis\": basis,\n        \"cleared_at\": cleared_at.split(\" \")[0] if cleared_at else None,\n        \"cleared_by\": cleared_by,\n        \"readiness\": readiness,\n        \"actions\": _verdict_actions(vin, enabled),\n    }\n\n\n# --- verdict.next_action -- the one-sentence \"what do I do right now\" -------\n#\n# Added for the bench page (cuore/services/bench_bridge.py): a mechanic\n# landing on a car should not have to read the verdict's basis list and the\n# open-work cards to work out what to actually do next. Nothing here is a\n# new judgement -- it just combines the verdict state already computed above\n# with the same fuel-out-of-window flag :func:`_build_freeze_frames` already\n# derives and the same open-work steps :func:`_build_open_work` already\n# orders, into the one sentence (plus a short ``blocker`` label and the\n# ``next_step_id`` it points at) the bench page's headline needs.\n\n\ndef _first_unchecked_step(open_work: list[dict[str, Any]]\n                          ) -> tuple[dict[str, Any] | None, dict[str, Any] | None]:\n    \"\"\"The first not-yet-done step across every open-work card, in the same\n    order the cards themselves are already in (curated families first, then\n    the generic ones) -- ``(card, step)``, or ``(None, None)`` if every step\n    on file is ticked.\"\"\"\n    for card in open_work:\n        for step in card.get(\"steps\") or []:\n            if not step.get(\"done\"):\n                return card, step\n    return None, None\n\n\ndef _step_bit(step: dict[str, Any] | None) -> str | None:\n    \"\"\"\"<step text> (<bulletin>)\" -- the fragment both the ACTIVE_FAULTS and\n    fuel-blocked UNVERIFIED_REPAIR sentences below quote verbatim.\"\"\"\n    if step is None:\n        return None\n    bulletin = step.get(\"ref\") or \"no bulletin on file\"\n    return f\"{step['text']} ({bulletin})\"\n\n\ndef _fuel_out_of_window(freeze_frames: list[dict[str, Any]]\n                        ) -> tuple[float, str, float] | None:\n    \"\"\"``(level, \"above\"/\"below\", threshold)`` for the first EVAP freeze-frame\n    fuel reading outside :data:`_EVAP_FUEL_WINDOW` -- the same flag\n    :func:`_build_freeze_frames` already set on that reading -- or ``None``\n    when no freeze frame carries that flag.\"\"\"\n    lo, hi = _EVAP_FUEL_WINDOW\n    for ff in freeze_frames:\n        for p in ff.get(\"key\") or []:\n            if p.get(\"name\") != \"Fuel level\" or not p.get(\"flag\"):\n                continue\n            level = _num(p.get(\"value\"))\n            if level is None:\n                continue\n            return level, (\"below\" if level < lo else \"above\"), (lo if level < lo else hi)\n    return None\n\n\ndef _verdict_next_action(verdict: dict[str, Any], open_work: list[dict[str, Any]],\n                         freeze_frames: list[dict[str, Any]]\n                         ) -> tuple[str, str, str | None]:\n    \"\"\"``(next_action sentence, blocker label, next_step_id)`` for one\n    verdict. Never raises -- a missing open-work step or freeze frame just\n    means a shorter sentence, not a broken one.\"\"\"\n    state = verdict.get(\"state\")\n    _card, step = _first_unchecked_step(open_work)\n    step_id = step.get(\"id\") if step else None\n    bit = _step_bit(step)\n\n    if state == \"UNVERIFIED_REPAIR\":\n        fuel = _fuel_out_of_window(freeze_frames)\n        if fuel is not None:\n            level, direction, threshold = fuel\n            sentence = (f\"Cannot verify yet: the EVAP monitor will not run {direction} \"\n                       f\"{threshold:g} % fuel (set at {level:g} %). Burn fuel into the \"\n                       f\"{_EVAP_FUEL_WINDOW[0]:g}-{_EVAP_FUEL_WINDOW[1]:g} % window, then \"\n                       f\"complete a drive cycle.\")\n            if bit:\n                sentence += f\" Meanwhile: {bit}.\"\n            return sentence, \"fuel out of window\", step_id\n        sentence = (\"Cannot verify yet: no readiness read since the clear. Read \"\n                    \"readiness once the drive cycle completes.\")\n        if bit:\n            sentence += f\" Meanwhile: {bit}.\"\n        return sentence, \"awaiting drive cycle\", step_id\n\n    if state == \"ACTIVE_FAULTS\":\n        if bit:\n            return f\"Start with {bit}.\", \"active faults\", step_id\n        return \"Active faults on file -- open the codes to begin.\", \"active faults\", None\n\n    if state == \"VERIFIED_CLEAN\":\n        readiness = verdict.get(\"readiness\") or {}\n        date = _short_date(readiness.get(\"at\")) or verdict.get(\"cleared_at\") or \"the last read\"\n        return f\"Verified by readiness read on {date}: release.\", \"none\", None\n\n    return \"Read the car.\", \"no data\", None\n\n\n# --- open work (family findings as a checklist) -----------------------------\n\n\ndef _family_refs(codes: list[str], per_code: dict[str, Any],\n                 reading: str) -> list[dict[str, Any]]:\n    seen: dict[str, dict[str, Any]] = {}\n    for code in codes:\n        for b in per_code.get(code, []):\n            num = b.get(\"bulletin\")\n            if num and num not in seen:\n                seen[num] = {\"label\": num, \"href\": f\"#tsb-{_slug(num)}\"}\n    for doc in re.findall(r\"docs/\\S+?\\.md\", reading or \"\"):\n        if doc not in seen:\n            seen[doc] = {\"label\": doc, \"href\": None}\n    return list(seen.values())\n\n\ndef _build_open_work(vin: str, dossier: dict[str, Any],\n                     checklist: dict[str, Any]) -> list[dict[str, Any]]:\n    tsb = dossier.get(\"tsb_matches\") or {}\n    findings = tsb.get(\"family_findings\") or []\n    per_code = tsb.get(\"per_code\") or {}\n    cards = []\n    covered_codes: set[str] = set()\n    for f in findings:\n        family = f.get(\"family\") or \"\"\n        steps_def = FAMILY_STEPS.get(family)\n        if not steps_def:\n            continue  # no checklist table for this family yet\n        codes = [c.upper() for c in (f.get(\"codes\") or [])]\n        covered_codes.update(codes)\n        steps = []\n        done = 0\n        for s in steps_def:\n            st = checklist.get(s[\"id\"]) or {}\n            is_done = bool(st.get(\"done\"))\n            done += int(is_done)\n            steps.append({\n                \"id\": s[\"id\"], \"text\": s[\"text\"], \"ref\": s[\"ref\"],\n                \"ref_href\": f\"#tsb-{_slug(s['ref'])}\" if s[\"ref\"] else None,\n                \"done\": is_done, \"done_at\": st.get(\"done_at\"),\n                \"done_by\": st.get(\"done_by\"),\n            })\n        title = _FAMILY_TITLES.get(family, f\"{family}: one system fault\")\n        if \"{n}\" in title:\n            title = title.format(n=len(codes))\n        cards.append({\n            \"family\": family, \"title\": title, \"codes\": codes, \"steps\": steps,\n            \"refs\": _family_refs(codes, per_code, f.get(\"reading\", \"\")),\n            \"progress\": {\"done\": done, \"total\": len(steps_def)},\n        })\n\n    # Every other family this car's own history shows, grouped by the\n    # generic SAE-range classification above, with steps pulled live from\n    # mes.faulttree via mes_bridge.fault_tree -- so EVAP keeps being the\n    # richest, hand-curated example, but a misfire, fuel-trim, cooling,\n    # body, chassis or ADAS code (or any other family) still gets a\n    # sourced, actionable card instead of nothing.\n    remaining = sorted(_history_codes(dossier) - covered_codes)\n    groups: dict[str, list[str]] = {}\n    labels: dict[str, str] = {}\n    for code in remaining:\n        fam = _generic_family_for(code)\n        if fam is None:\n            continue\n        key, label = fam\n        groups.setdefault(key, []).append(code)\n        labels[key] = label\n    for family_key in sorted(groups):\n        codes = sorted(set(groups[family_key]))\n        tree_steps = _generic_tree_steps(codes[0], vin)[:6]\n        if not tree_steps:\n            continue\n        steps = []\n        done = 0\n        for i, s in enumerate(tree_steps):\n            step_id = f\"{family_key}-{i + 1}\"\n            st = checklist.get(step_id) or {}\n            is_done = bool(st.get(\"done\"))\n            done += int(is_done)\n            text = s.get(\"title\") or s.get(\"test\") or \"Step\"\n            if s.get(\"test\") and s.get(\"test\") != text:\n                text = f\"{text}: {s['test']}\"\n            steps.append({\n                \"id\": step_id, \"text\": text, \"ref\": s.get(\"source\"),\n                \"ref_href\": None,\n                \"done\": is_done, \"done_at\": st.get(\"done_at\"),\n                \"done_by\": st.get(\"done_by\"),\n            })\n        label = labels.get(family_key, family_key)\n        title = (f\"{label}: one open issue\" if len(codes) == 1\n                 else f\"{label}: {len(codes)} codes, one system\")\n        cards.append({\n            \"family\": family_key, \"title\": title, \"codes\": codes,\n            \"steps\": steps, \"refs\": [],\n            \"progress\": {\"done\": done, \"total\": len(steps)},\n            \"generic\": True,\n        })\n    return cards\n\n\ndef _family_map(dossier: dict[str, Any]) -> dict[str, str]:\n    out: dict[str, str] = {}\n    for f in (dossier.get(\"tsb_matches\") or {}).get(\"family_findings\", []):\n        for c in f.get(\"codes\", []):\n            out[c.upper()] = f.get(\"family\")\n    return out\n\n\n# --- the code table -----------------------------------------------------------\n\n\ndef _code_status(base: str, last_seen: str | None, cleared_at: str | None,\n                 codes_cleared: set[str], codes_returned: set[str],\n                 codes_uncleared: set[str], last_findings: set[str],\n                 last_findings_ts: str | None, recent_ts: list[str]) -> str:\n    if base in codes_returned or base in codes_uncleared:\n        return \"ACTIVE\"\n    if cleared_at and last_seen and last_seen > cleared_at:\n        return \"ACTIVE\"\n    if base in last_findings and not (cleared_at and last_findings_ts\n                                      and cleared_at >= last_findings_ts):\n        return \"ACTIVE\"\n    if cleared_at and base in codes_cleared and (not last_seen or last_seen <= cleared_at):\n        return \"CLEARED_UNVERIFIED\"\n    if cleared_at is None and last_seen and last_seen in recent_ts[:3]:\n        return \"ACTIVE\"\n    return \"STALE\"\n\n\ndef _code_rows(vin: str, dossier: dict[str, Any], cleared_at: str | None,\n              clear_assessment: dict[str, Any] | None, recent_ts: list[str],\n              family_map: dict[str, str]\n              ) -> tuple[list[dict[str, Any]], dict[str, int]]:\n    history = dossier.get(\"history\") or {}\n    cp = dossier.get(\"current_picture\") or {}\n    last_findings_session = cp.get(\"last_session_with_findings\") or {}\n    last_findings = {_base(d.get(\"code\") or d.get(\"dtc\") or \"\")\n                     for d in last_findings_session.get(\"dtcs\", [])}\n    last_findings_ts = last_findings_session.get(\"timestamp\")\n\n    codes_cleared = {_base(c) for c in (clear_assessment or {}).get(\"codes_cleared\", [])}\n    codes_returned = {_base(c) for c in\n                      (clear_assessment or {}).get(\"codes_returned_in_session\", [])}\n    codes_uncleared = {_base(c) for c in\n                       (clear_assessment or {}).get(\"codes_that_would_not_clear\", [])}\n\n    rows: list[dict[str, Any]] = []\n    for bucket in (\"chronic\", \"returned_after_clear\", \"seen_once\"):\n        for rec in history.get(bucket, []):\n            full = rec.get(\"dtc\", \"\")\n            base = _base(full)\n            last_seen = rec.get(\"last_seen\")\n            status = _code_status(base, last_seen, cleared_at, codes_cleared,\n                                  codes_returned, codes_uncleared, last_findings,\n                                  last_findings_ts, recent_ts)\n            distance = rec.get(\"distance_span_km\")\n            rows.append({\n                \"code\": base, \"dtc\": full,\n                \"description\": (rec.get(\"descriptions\") or [\"\"])[0],\n                \"system\": _SYSTEM_BY_LETTER.get(base[:1], base[:1] if base else None),\n                \"bucket\": bucket,\n                \"status\": status, \"status_label\": _STATUS_LABEL[status],\n                \"sessions\": rec.get(\"sessions\"),\n                \"last_seen_short\": _short_date(last_seen),\n                \"last_seen\": last_seen, \"first_seen\": rec.get(\"first_seen\"),\n                \"distance_km\": round(distance) if distance is not None else None,\n                \"href\": f\"/v/{vin}/code/{base}\",\n                \"family\": family_map.get(base),\n            })\n\n    counts = {\"chronic\": 0, \"seen_once\": 0, \"returned_after_clear\": 0,\n             \"active\": 0, \"stale\": 0}\n    for r in rows:\n        counts[r[\"bucket\"]] = counts.get(r[\"bucket\"], 0) + 1\n        if r[\"status\"] == \"ACTIVE\":\n            counts[\"active\"] += 1\n        elif r[\"status\"] == \"STALE\":\n            counts[\"stale\"] += 1\n    return rows, counts\n\n\n# --- already attempted -------------------------------------------------------\n\n\ndef _build_attempted(vin: str) -> list[dict[str, Any]]:\n    try:\n        data = mes_bridge.actuator_history(vin=vin)\n    except BridgeError:\n        return []\n    note = data.get(\"note\")\n    groups: dict[tuple[str, str], dict[str, Any]] = {}\n    for r in data.get(\"runs\", []):\n        key = (r.get(\"operation\"), r.get(\"outcome\"))\n        g = groups.setdefault(key, {\"operation\": r.get(\"operation\"),\n                                    \"kind\": r.get(\"kind\"), \"outcome\": r.get(\"outcome\"),\n                                    \"reason\": None, \"rows\": []})\n        g[\"rows\"].append(r)\n        if r.get(\"reason\") and not g[\"reason\"]:\n            g[\"reason\"] = r.get(\"reason\")\n\n    out = []\n    for g in groups.values():\n        times = sorted(r.get(\"timestamp\") for r in g[\"rows\"] if r.get(\"timestamp\"))\n        reason = g[\"reason\"]\n        footnote = note if (reason and note and \"engine running\" in reason.lower()) else None\n        out.append({\n            \"operation\": g[\"operation\"], \"kind\": g[\"kind\"], \"outcome\": g[\"outcome\"],\n            \"count\": len(g[\"rows\"]),\n            \"first_short\": _short_date(times[0]) if times else None,\n            \"last_short\": _short_date(times[-1]) if times else None,\n            \"reason\": reason, \"reason_chip\": reason, \"footnote\": footnote,\n            \"rows\": g[\"rows\"],\n        })\n    out.sort(key=lambda g: (g[\"outcome\"] != \"FAILED TO EXECUTE\", g[\"operation\"] or \"\"))\n    return out\n\n\n# --- freeze frames -------------------------------------------------------------\n\n\ndef _build_freeze_frames(vin: str, dossier: dict[str, Any]) -> list[dict[str, Any]]:\n    cp = dossier.get(\"current_picture\") or {}\n    target_ts = ((cp.get(\"last_session_with_findings\") or {}).get(\"timestamp\")\n                or (cp.get(\"latest_session\") or {}).get(\"timestamp\"))\n    if not target_ts:\n        return []\n    try:\n        data = mes_bridge.freeze_frames(vin=vin)\n    except BridgeError:\n        return []\n\n    odo_last = (dossier.get(\"identity\") or {}).get(\"odometer_last_km\")\n    out = []\n    for f in data.get(\"frames\", []):\n        if f.get(\"timestamp\") != target_ts:\n            continue\n        ff = f.get(\"freeze_frame\") or {}\n        base = _base(f.get(\"dtc\", \"\"))\n        key = []\n        for name in _KEY_FRAME_PARAMS:\n            if name not in ff:\n                continue\n            value = ff[name]\n            flag = None\n            if name == \"Fuel level\" and base in _EVAP_CODES:\n                level = _num(value)\n                lo, hi = _EVAP_FUEL_WINDOW\n                if level is not None and (level < lo or level > hi):\n                    bound = f\"below {lo:g} %\" if level < lo else f\"above {hi:g} %\"\n                    flag = f\"{bound}: EVAP monitor could not run\"\n            key.append({\"name\": name, \"value\": value, \"flag\": flag})\n        odo_frame = _num(ff.get(\"Odometer\"))\n        set_km_ago = (round(odo_last - odo_frame)\n                     if odo_last is not None and odo_frame is not None else None)\n        out.append({\n            \"code\": f.get(\"dtc\"), \"key\": key, \"set_km_ago\": set_km_ago,\n            \"all\": [{\"name\": n, \"value\": v} for n, v in ff.items()],\n        })\n    return out\n\n\n# --- blind spots as actions ----------------------------------------------------\n\n\ndef _blind_spot_action(vin: str, closes_it: str, enabled: bool) -> dict[str, Any]:\n    low = (closes_it or \"\").lower()\n    hint = \"\" if enabled else \"connect the car (ELM327 on COM3)\"\n    if \"read_readiness\" in low:\n        return {\"label\": \"Read readiness\", \"kind\": \"readiness\",\n                \"href\": f\"/v/{vin}/verify\", \"enabled\": enabled, \"hint\": hint}\n    if \"read_permanent_dtcs\" in low:\n        return {\"label\": \"Read permanent DTCs\", \"kind\": \"permanent\", \"href\": None,\n                \"enabled\": enabled, \"hint\": hint}\n    if \"mode06\" in low or \"send_raw\" in low:\n        return {\"label\": \"Read Mode $06\", \"kind\": \"mode06\", \"href\": None,\n                \"enabled\": enabled, \"hint\": hint}\n    if \"already closed\" in low:\n        return {\"label\": \"Answered\", \"kind\": \"link\", \"href\": f\"/v/{vin}/dealer\",\n                \"enabled\": True, \"hint\": \"\"}\n    if \"witech\" in low or \"dealer\" in low:\n        return {\"label\": \"Dealer / wiTECH\", \"kind\": \"dealer\", \"href\": f\"/v/{vin}/dealer\",\n                \"enabled\": True, \"hint\": \"\"}\n    return {\"label\": \"Manual check\", \"kind\": \"manual\", \"href\": None,\n            \"enabled\": True, \"hint\": \"\"}\n\n\ndef _build_blind_spots(vin: str, dossier: dict[str, Any],\n                       live_status: dict[str, Any] | None) -> list[dict[str, Any]]:\n    enabled = live_available(live_status)\n    out = []\n    for bs in dossier.get(\"blind_spots\", []):\n        out.append({\n            \"question\": bs.get(\"question\", \"\"),\n            \"why\": bs.get(\"why_unknown\", \"\"),\n            \"action\": _blind_spot_action(vin, bs.get(\"closes_it\", \"\"), enabled),\n        })\n    return out\n\n\n# --- bulletins, deduplicated ---------------------------------------------------\n\n\ndef _supersedes(action: str) -> str | None:\n    m = re.search(r\"[Ss]upersed(?:es|ed)\\s+([A-Za-z0-9.\\-]+)\", action or \"\")\n    return m.group(1).rstrip(\".\") if m else None\n\n\ndef _build_bulletins(dossier: dict[str, Any],\n                     open_work: list[dict[str, Any]]) -> list[dict[str, Any]]:\n    tsb = dossier.get(\"tsb_matches\") or {}\n    per_code = tsb.get(\"per_code\") or {}\n    relevant = {c for card in open_work for c in card[\"codes\"]}\n\n    by_num: dict[str, dict[str, Any]] = {}\n    for code, matches in per_code.items():\n        for b in matches:\n            num = b.get(\"bulletin\")\n            if not num:\n                continue\n            entry = by_num.setdefault(num, {\n                \"id\": num, \"anchor\": f\"tsb-{_slug(num)}\", \"title\": b.get(\"title\"),\n                \"action\": b.get(\"action\"), \"caution\": b.get(\"caution\"),\n                \"codes\": set(), \"superseded\": _supersedes(b.get(\"action\", \"\")),\n                \"source\": b.get(\"source\"), \"relevance\": 0,\n            })\n            entry[\"codes\"].update(b.get(\"dtcs\") or [code])\n            if code.upper() in relevant:\n                entry[\"relevance\"] += 1\n\n    out = []\n    for entry in by_num.values():\n        entry[\"codes\"] = sorted(entry[\"codes\"])\n        out.append(entry)\n    out.sort(key=lambda e: (-e[\"relevance\"], e[\"id\"]))\n    return out\n\n\n# --- latest session/scan -------------------------------------------------------\n\n\ndef _build_latest(dossier: dict[str, Any]) -> dict[str, Any]:\n    cp = dossier.get(\"current_picture\") or {}\n    ls = cp.get(\"latest_session\") or {}\n    sc = cp.get(\"latest_scan\") or {}\n    return {\n        \"session_short\": _short_date(ls.get(\"timestamp\"), with_time=True),\n        \"session_file\": ls.get(\"file\"), \"ecu\": ls.get(\"ecu\"),\n        \"scan_short\": (_short_date(sc.get(\"timestamp\"), with_time=True)\n                       if sc.get(\"timestamp\") else None),\n        \"scan_file\": sc.get(\"file\"),\n    }\n\n\n# --- checklist step ids, for the API's validation ----------------------------\n\n\ndef checklist_step_ids(vin: str, dossier: dict[str, Any]) -> set[str]:\n    \"\"\"Every checklist step id this vehicle's open-work cards expose.\n\n    Used by the checklist API to reject a step id that is not actually on\n    this car's dossier -- a step id is only meaningful in the context of the\n    family finding it belongs to.\n\n    This used to call ``_build_open_work(vin, dossier, {})`` fresh every\n    time -- a second, uncached re-evaluation of the fault tree per code\n    (``_generic_tree_steps`` -> ``mes_bridge.fault_tree`` -> real FES\n    parsing) on top of the one ``build_view`` already pays for and caches.\n    The checklist dict passed in only ever flips each step's own\n    ``done``/``done_at``/``done_by``, never which step ids exist (see\n    ``_build_open_work``'s body), so this is a pure function of\n    ``(vin, dossier)`` and can share ``build_view``'s own\n    ``dossier_view_core`` cache entry instead of building a second,\n    checklist-blind copy of the same open-work list -- correct because the\n    cache key (vin, newest MES-log mtime, newest state-file mtime) is the\n    same staleness criteria either caller needs: a new log or any state\n    file change invalidates it, same as ``build_view`` itself. Called from\n    request paths that never built that core (e.g. checklist POST\n    handlers), so it still has to build it the first time; callers that\n    already called ``build_view`` this request (or the last one, if nothing\n    changed) get a cache hit instead of a second fault-tree pass.\n    \"\"\"\n    core = cache.get_or_build(\n        (\"dossier_view_core\", vin, mes_bridge.newest_mtime(vin), _state_fingerprint()),\n        lambda: _build_view_core(vin, dossier),\n    )\n    return {s[\"id\"] for card in core[\"open_work\"] for s in card[\"steps\"]}\n\n\n# --- the one entry point -----------------------------------------------------\n\n\ndef _build_view_core(vin: str, dossier: dict[str, Any]) -> dict[str, Any]:\n    \"\"\"Everything :func:`build_view` needs except the verdict and blind\n    spots, which also read ``live_status`` and are cheap enough (no file\n    I/O beyond what ``dossier`` already carries) to compute fresh on every\n    call. Split out purely so it can be memoised -- see ``build_view``.\n    \"\"\"\n    checklist = checklist_store.get(vin)\n    open_work = _build_open_work(vin, dossier, checklist)\n\n    family_map = _family_map(dossier)\n    try:\n        recent_ts = [e.get(\"timestamp\") for e in\n                    mes_bridge.list_logs(vin=vin, limit=3)[\"logs\"]]\n    except BridgeError:\n        recent_ts = []\n    cleared_at, _cleared_by, clear_assessment = _clear_info(dossier)\n    codes, code_counts = _code_rows(vin, dossier, cleared_at, clear_assessment,\n                                    recent_ts, family_map)\n\n    return {\n        \"open_work\": open_work,\n        \"codes\": codes,\n        \"code_counts\": code_counts,\n        \"attempted\": _build_attempted(vin),\n        \"freeze_frames\": _build_freeze_frames(vin, dossier),\n        \"bulletins\": _build_bulletins(dossier, open_work),\n        \"latest\": _build_latest(dossier),\n        \"provenance_note\": dossier.get(\"provenance_note\", \"\"),\n    }\n\n\ndef build_view(vin: str, dossier: dict[str, Any],\n              live_status: dict[str, Any] | None) -> dict[str, Any]:\n    \"\"\"Everything the redesigned dossier page needs, computed once.\n\n    ``dossier`` is the workup dict (``mes_bridge.workup(vin=vin)``);\n    ``live_status`` is the same shape ``base.html``'s live strip already\n    renders (``port``, ``mes_state``, ``lock_holder``, ...), or ``None`` when\n    the caller has not computed it. Nothing here mutates either argument or\n    touches the car -- nothing here writes anything at all.\n\n    The dossier, job and flow pages between them call this several times\n    per render (the Job page alone calls it twice: once for its own\n    suggested-hypothesis evidence, once for the page body) and the open-work\n    cards alone re-evaluate a fault tree per code, parsing FES logs directly\n    -- seconds of work on a real corpus. Everything but the verdict and\n    blind spots is pulled from :func:`_build_view_core`, memoised on (vin,\n    newest MES-log mtime, newest state-file mtime) exactly like\n    ``cuore.web.routes._dossier`` already memoises the workup itself, so a\n    second call in the same request (or the next request, until a log or a\n    state file changes) costs a dict lookup instead of a re-evaluation. The\n    verdict and blind spots stay outside that cache because they depend on\n    ``live_status``, which varies request to request and is not part of the\n    key.\n    \"\"\"\n    core = cache.get_or_build(\n        (\"dossier_view_core\", vin, mes_bridge.newest_mtime(vin), _state_fingerprint()),\n        lambda: _build_view_core(vin, dossier),\n    )\n    verdict = _build_verdict(vin, dossier, live_status, core[\"open_work\"])\n    next_action, blocker, next_step_id = _verdict_next_action(\n        verdict, core[\"open_work\"], core[\"freeze_frames\"])\n    verdict[\"next_action\"] = next_action\n    verdict[\"blocker\"] = blocker\n    verdict[\"next_step_id\"] = next_step_id\n    blind_spots = _build_blind_spots(vin, dossier, live_status)\n    return {\"verdict\": verdict, \"blind_spots\": blind_spots, **core}\n\n\n__all__ = [\"build_view\", \"checklist_step_ids\", \"live_available\", \"readiness_result\",\n           \"fuel_status\", \"readiness_panel\", \"FAMILY_STEPS\"]\n","numLines":1054,"startLine":1,"totalLines":1054}},"sourceToolAssistantUUID":"4fab9b88-4c29-41f2-b981-0809c705542b","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
{"parentUuid":"ec49bdf7-68d9-4e35-8983-08498dd41ce9","isSidechain":true,"agentId":"afb1dbcc97469a738","message":{"model":"claude-sonnet-5","id":"msg_011Cg1AoRXZUQPrvH3wXncjS","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01EMZhB5JnYuZtXTfcDn5dXf","name":"Read","input":{"file_path":"C:\\Users\\User\\mcp-servers\\cuore\\live\\store.py"},"caller":{"type":"direct"}}],"container":null,"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1506,"cache_read_input_tokens":65597,"output_tokens":256,"output_tokens_details":{"thinking_tokens":110},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":0,"ephemeral_5m_input_tokens":1506},"inference_geo":"global","iterations":[{"input_tokens":2,"output_tokens":256,"cache_read_input_tokens":65597,"cache_creation_input_tokens":1506,"cache_creation":{"ephemeral_5m_input_tokens":1506,"ephemeral_1h_input_tokens":0},"type":"message"}],"speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_01EMZhB5JnYuZtXTfcDn5dXf":{"file_path":"C:\\Users\\User\\mcp-servers\\cuore\\live\\store.py"}},"serverClassifierRequest":"be15c36f-4cee-43d5-a7cb-a747fbf100de","apiBlockIndex":2,"requestId":"req_011Cg1AoRHuu7vRcWv23mwdf","attributionAgent":"general-purpose","type":"assistant","uuid":"ea1ea5d1-9037-4d25-8403-9d2540efb026","timestamp":"2026-10-14T00:18:28.881Z","effort":"high","perTurnEffort":null,"userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
{"parentUuid":"ea1ea5d1-9037-4d25-8403-9d2540efb026","isSidechain":true,"promptId":"99516295-3962-40e1-8d55-7c7b80de287f","agentId":"afb1dbcc97469a738","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01EMZhB5JnYuZtXTfcDn5dXf","type":"tool_result","content":"1\t\"\"\"Small persistent state: address confirmations per VIN.\n2\t\n3\tA JSON file beside the lock file. Phase 3 replaces this with the SQLite store\n4\tfrom the spec; the interface stays.\n5\t\"\"\"\n6\t\n7\tfrom __future__ import annotations\n8\t\n9\timport json\n10\timport threading\n11\tfrom datetime import datetime\n12\tfrom pathlib import Path\n13\tfrom typing import Any\n14\t\n15\tfrom .config import state_dir\n16\t\n17\t_LOCK = threading.Lock()\n18\t\n19\t\n20\tdef path() -> Path:\n21\t    return state_dir() / \"addresses.json\"\n22\t\n23\t\n24\tdef _load() -> dict[str, Any]:\n25\t    try:\n26\t        return json.loads(path().read_text(encoding=\"utf-8\"))\n27\t    except (OSError, ValueError):\n28\t        return {}\n29\t\n30\t\n31\tdef _save(data: dict[str, Any]) -> None:\n32\t    try:\n33\t        path().write_text(json.dumps(data, indent=2), encoding=\"utf-8\")\n34\t    except OSError:\n35\t        pass\n36\t\n37\t\n38\tdef confirmed_targets(vin: str) -> dict[str, int]:\n39\t    \"\"\"``{module_code: target}`` confirmed on this VIN.\"\"\"\n40\t    with _LOCK:\n41\t        entry = _load().get(vin, {})\n42\t    return {code: int(rec[\"target\"], 16) for code, rec in entry.items()}\n43\t\n44\t\n45\tdef confirm_target(vin: str, code: str, target: int, source: str = \"discover\") -> None:\n46\t    with _LOCK:\n47\t        data = _load()\n48\t        data.setdefault(vin, {})[code] = {\n49\t            \"target\": f\"{target:02X}\", \"source\": source,\n50\t            \"at\": datetime.now().isoformat(timespec=\"seconds\")}\n51\t        _save(data)\n52\t\n53\t\n54\tdef all_confirmations() -> dict[str, Any]:\n55\t    with _LOCK:\n56\t        return _load()\n57\t\n58\t\n59\t# --- observations: what the car said, when, so the evidence gate can cite it --\n60\t\n61\tdef observations_path() -> Path:\n62\t    import os\n63\t    env = os.environ.get(\"MES_LIVE_OBSERVATIONS\")\n64\t    return Path(env) if env else state_dir() / \"observations.jsonl\"\n65\t\n66\t\n67\tdef record_observation(kind: str, data: dict[str, Any], *, vin: str = \"\",\n68\t                       bus: str = \"\", cable: str = \"\", stream: str = \"\") -> None:\n69\t    \"\"\"Append one observation. Never raises; the read itself must not fail on I/O.\n70\t\n71\t    ``stream`` names what produced it (``serial COM3@115200``, ``scripted``,\n72\t    ``playback ...``). Only serial observations are evidence about a car;\n73\t    anything else is a test or a replay and :func:`is_from_car` says so.\n74\t    \"\"\"\n75\t    entry = {\"at\": datetime.now().isoformat(timespec=\"seconds\"), \"kind\": kind,\n76\t             \"vin\": vin or \"\", \"bus\": bus, \"cable\": cable, \"stream\": stream,\n77\t             \"data\": data}\n78\t    try:\n79\t        with _LOCK:\n80\t            with observations_path().open(\"a\", encoding=\"utf-8\") as f:\n81\t                f.write(json.dumps(entry, default=str) + \"\\n\")\n82\t    except OSError:\n83\t        pass\n84\t\n85\t\n86\tdef is_from_car(entry: dict[str, Any]) -> bool:\n87\t    \"\"\"True only for an observation read from a real serial link.\"\"\"\n88\t    s = str(entry.get(\"stream\") or \"\")\n89\t    return s.startswith(\"serial\") or s.startswith(\"recording(serial\")\n90\t\n91\t\n92\tdef recent_observations(n: int = 50, vin: str = \"\", kind: str = \"\") -> list[dict[str, Any]]:\n93\t    p = observations_path()\n94\t    if not p.exists():\n95\t        return []\n96\t    out: list[dict[str, Any]] = []\n97\t    try:\n98\t        lines = p.read_text(encoding=\"utf-8\").splitlines()\n99\t    except OSError:\n100\t        return []\n101\t    for line in lines:\n102\t        try:\n103\t            obj = json.loads(line)\n104\t        except ValueError:\n105\t            continue\n106\t        if vin and obj.get(\"vin\") != vin:  # untagged reads never match a named car\n107\t            continue\n108\t        if kind and obj.get(\"kind\") != kind:\n109\t            continue\n110\t        out.append(obj)\n111\t    return out[-n:]\n112\t\n113\t\n114\t__all__ = [\"path\", \"confirmed_targets\", \"confirm_target\", \"all_confirmations\",\n115\t           \"observations_path\", \"record_observation\", \"recent_observations\", \"is_from_car\"]\n116\t"}]},"uuid":"1c71e219-73ab-4f90-8e91-57b67da057cc","timestamp":"2026-10-14T00:18:28.927Z","toolUseResult":{"type":"text","file":{"filePath":"C:\\Users\\User\\mcp-servers\\cuore\\live\\store.py","content":"\"\"\"Small persistent state: address confirmations per VIN.\n\nA JSON file beside the lock file. Phase 3 replaces this with the SQLite store\nfrom the spec; the interface stays.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport json\nimport threading\nfrom datetime import datetime\nfrom pathlib import Path\nfrom typing import Any\n\nfrom .config import state_dir\n\n_LOCK = threading.Lock()\n\n\ndef path() -> Path:\n    return state_dir() / \"addresses.json\"\n\n\ndef _load() -> dict[str, Any]:\n    try:\n        return json.loads(path().read_text(encoding=\"utf-8\"))\n    except (OSError, ValueError):\n        return {}\n\n\ndef _save(data: dict[str, Any]) -> None:\n    try:\n        path().write_text(json.dumps(data, indent=2), encoding=\"utf-8\")\n    except OSError:\n        pass\n\n\ndef confirmed_targets(vin: str) -> dict[str, int]:\n    \"\"\"``{module_code: target}`` confirmed on this VIN.\"\"\"\n    with _LOCK:\n        entry = _load().get(vin, {})\n    return {code: int(rec[\"target\"], 16) for code, rec in entry.items()}\n\n\ndef confirm_target(vin: str, code: str, target: int, source: str = \"discover\") -> None:\n    with _LOCK:\n        data = _load()\n        data.setdefault(vin, {})[code] = {\n            \"target\": f\"{target:02X}\", \"source\": source,\n            \"at\": datetime.now().isoformat(timespec=\"seconds\")}\n        _save(data)\n\n\ndef all_confirmations() -> dict[str, Any]:\n    with _LOCK:\n        return _load()\n\n\n# --- observations: what the car said, when, so the evidence gate can cite it --\n\ndef observations_path() -> Path:\n    import os\n    env = os.environ.get(\"MES_LIVE_OBSERVATIONS\")\n    return Path(env) if env else state_dir() / \"observations.jsonl\"\n\n\ndef record_observation(kind: str, data: dict[str, Any], *, vin: str = \"\",\n                       bus: str = \"\", cable: str = \"\", stream: str = \"\") -> None:\n    \"\"\"Append one observation. Never raises; the read itself must not fail on I/O.\n\n    ``stream`` names what produced it (``serial COM3@115200``, ``scripted``,\n    ``playback ...``). Only serial observations are evidence about a car;\n    anything else is a test or a replay and :func:`is_from_car` says so.\n    \"\"\"\n    entry = {\"at\": datetime.now().isoformat(timespec=\"seconds\"), \"kind\": kind,\n             \"vin\": vin or \"\", \"bus\": bus, \"cable\": cable, \"stream\": stream,\n             \"data\": data}\n    try:\n        with _LOCK:\n            with observations_path().open(\"a\", encoding=\"utf-8\") as f:\n                f.write(json.dumps(entry, default=str) + \"\\n\")\n    except OSError:\n        pass\n\n\ndef is_from_car(entry: dict[str, Any]) -> bool:\n    \"\"\"True only for an observation read from a real serial link.\"\"\"\n    s = str(entry.get(\"stream\") or \"\")\n    return s.startswith(\"serial\") or s.startswith(\"recording(serial\")\n\n\ndef recent_observations(n: int = 50, vin: str = \"\", kind: str = \"\") -> list[dict[str, Any]]:\n    p = observations_path()\n    if not p.exists():\n        return []\n    out: list[dict[str, Any]] = []\n    try:\n        lines = p.read_text(encoding=\"utf-8\").splitlines()\n    except OSError:\n        return []\n    for line in lines:\n        try:\n            obj = json.loads(line)\n        except ValueError:\n            continue\n        if vin and obj.get(\"vin\") != vin:  # untagged reads never match a named car\n            continue\n        if kind and obj.get(\"kind\") != kind:\n            continue\n        out.append(obj)\n    return out[-n:]\n\n\n__all__ = [\"path\", \"confirmed_targets\", \"confirm_target\", \"all_confirmations\",\n           \"observations_path\", \"record_observation\", \"recent_observations\", \"is_from_car\"]\n","numLines":116,"startLine":1,"totalLines":116}},"sourceToolAssistantUUID":"ea1ea5d1-9037-4d25-8403-9d2540efb026","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
