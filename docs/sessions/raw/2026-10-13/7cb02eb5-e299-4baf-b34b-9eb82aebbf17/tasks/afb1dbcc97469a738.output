{"parentUuid":"51e2c5df-f156-4348-9669-7ca5feee3ad5","isSidechain":true,"agentId":"afb1dbcc97469a738","message":{"model":"claude-sonnet-5","id":"msg_011Cg1BGuGBKb7g82VN2yTgg","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01QJdP66HKaTSupu32Dz4v6X","name":"Read","input":{"file_path":"C:\\Users\\User\\mcp-servers\\cuore\\services\\tests_bridge.py"},"caller":{"type":"direct"}}],"container":null,"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":9803,"cache_read_input_tokens":150784,"output_tokens":295,"output_tokens_details":{"thinking_tokens":218},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":0,"ephemeral_5m_input_tokens":9803},"inference_geo":"global","iterations":[{"input_tokens":2,"output_tokens":295,"cache_read_input_tokens":150784,"cache_creation_input_tokens":9803,"cache_creation":{"ephemeral_5m_input_tokens":9803,"ephemeral_1h_input_tokens":0},"type":"message"}],"speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_01QJdP66HKaTSupu32Dz4v6X":{"file_path":"C:\\Users\\User\\mcp-servers\\cuore\\services\\tests_bridge.py"}},"serverClassifierRequest":"d57a35f3-a77e-47c2-b3e9-7e69e499e667","apiBlockIndex":1,"requestId":"req_011Cg1BGu1YJVLtoy9VhHFHE","attributionAgent":"general-purpose","type":"assistant","uuid":"fcdd08e4-d5bd-459b-b366-3330f524b59a","timestamp":"2026-10-14T00:24:41.150Z","effort":"high","perTurnEffort":null,"userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
{"parentUuid":"fcdd08e4-d5bd-459b-b366-3330f524b59a","isSidechain":true,"promptId":"df226819-4f0d-4979-bf53-3ffca405c7dd","agentId":"afb1dbcc97469a738","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01QJdP66HKaTSupu32Dz4v6X","type":"tool_result","content":"1\t\"\"\"The Tests surface: a catalogue of every mechanic test (:mod:`mes.mechanic_tests`)\n2\tgrouped by category, each with this vehicle's latest recorded result and a\n3\trelevance ranking against its open codes and its job's open hypotheses.\n4\t\n5\tSame posture as :mod:`cuore.services.liveboard_bridge`: one bridge module,\n6\tread-mostly, the single place ``cuore`` touches :mod:`mes.mechanic_tests` and\n7\t:mod:`mes.jobs` for this feature. Results are written through the existing\n8\tchecklist result store (:mod:`cuore.live.checklists`), keyed\n9\t``step_id = \"test:<test_id>\"`` so they already flow into the job's\n10\thypothesis evidence path the same way a job-page test row does (see\n11\t:mod:`cuore.api.checklists`'s own ``/result`` route, and\n12\t:func:`cuore.services.jobs_bridge.add_test_evidence`) -- :mod:`cuore.api.tests`\n13\tcalls that same function, never a second copy of the auto-attach logic.\n14\t\n15\tNothing here writes to the car. ``bench_bridge.build_bench`` is read for its\n16\t``fuel_gate`` only, to flag the EVAP fuel-level verification window on the\n17\ttests it actually affects (the ESIM/EVAP monitor-verification family) --\n18\tsame blocker the bench page itself already shows.\n19\t\"\"\"\n20\t\n21\tfrom __future__ import annotations\n22\t\n23\tfrom typing import Any, Optional\n24\t\n25\tfrom .. import bootstrap  # noqa: F401  -- side effect: puts `mes` on sys.path\n26\tfrom ..live import checklists as checklist_store\n27\tfrom . import cache, mes_bridge\n28\tfrom .errors import BadRequest\n29\t\n30\tfrom mes import mechanic_tests  # noqa: E402\n31\t\n32\ttry:\n33\t    from mes import jobs as jobs_mod  # noqa: E402\n34\texcept Exception:  # noqa: BLE001 -- the tests page must still render\n35\t    jobs_mod = None\n36\t\n37\ttry:\n38\t    from . import bench_bridge\n39\texcept Exception:  # noqa: BLE001 -- blocker awareness is a nice-to-have\n40\t    bench_bridge = None\n41\t\n42\t#: Step-id prefix for a test result in the checklist store -- see module\n43\t#: docstring. Every write/read against ``checklist_store`` for this feature\n44\t#: goes through :func:`_step_id`, never a hand-built string.\n45\t_STEP_PREFIX = \"test:\"\n46\t\n47\t#: The family this catalogue's EVAP tests (``evap_smoke``, ``esim_vacuum_test_a``,\n48\t#: ``purge_vent_actuation``) share with the bench's own fuel-window blocker --\n49\t#: shown as a caution on these specific tests, not a generic banner on every\n50\t#: test.\n51\t_EVAP_MONITOR_TEST_IDS = (\"evap_smoke\", \"esim_vacuum_test_a\", \"purge_vent_actuation\")\n52\t\n53\tRESULT_COUNT_KEYS = (\"pass\", \"fail\", \"inconclusive\", \"not_possible\", \"not_done\")\n54\t\n55\t\n56\tdef step_id(test_id: str) -> str:\n57\t    return f\"{_STEP_PREFIX}{test_id}\"\n58\t\n59\t\n60\tdef test_id_from_step(step: str) -> Optional[str]:\n61\t    \"\"\"The test id a ``\"test:<id>\"`` step id names, or ``None`` if ``step``\n62\t    is not one of this feature's step ids.\"\"\"\n63\t    if not step.startswith(_STEP_PREFIX):\n64\t        return None\n65\t    return step[len(_STEP_PREFIX):]\n66\t\n67\t\n68\tdef _cached_dossier(vin: str) -> dict[str, Any]:\n69\t    mtime = mes_bridge.newest_mtime(vin)\n70\t    return cache.get_or_build((\"workup\", vin, mtime), lambda: mes_bridge.workup(vin=vin))\n71\t\n72\t\n73\tdef _open_codes(vin: str, dossier: dict[str, Any]) -> list[str]:\n74\t    try:\n75\t        return mes_bridge.open_codes_for(dossier)\n76\t    except Exception:  # noqa: BLE001 -- relevance ranking is best-effort\n77\t        return []\n78\t\n79\t\n80\tdef _open_hypotheses(vin: str) -> list[dict[str, Any]]:\n81\t    if jobs_mod is None:\n82\t        return []\n83\t    try:\n84\t        job = jobs_mod.current(vin)\n85\t    except Exception:  # noqa: BLE001\n86\t        return []\n87\t    if job is None:\n88\t        return []\n89\t    return [h for h in job.get(\"hypotheses\", [])\n90\t           if h.get(\"status\") == \"open\" and not h.get(\"deleted\")]\n91\t\n92\t\n93\tdef open_hypotheses_for_form(vin: str) -> list[dict[str, Any]]:\n94\t    \"\"\"``{id, text, system}`` for every open hypothesis on this VIN's\n95\t    current job -- the select list the result form offers.\"\"\"\n96\t    return [{\"id\": h[\"id\"], \"text\": h.get(\"text\") or \"\", \"system\": h.get(\"system\") or \"\"}\n97\t           for h in _open_hypotheses(vin)]\n98\t\n99\t\n100\tdef _fuel_gate(vin: str) -> dict[str, Any]:\n101\t    if bench_bridge is None:\n102\t        return {}\n103\t    try:\n104\t        return bench_bridge.build_bench(vin).get(\"fuel_gate\") or {}\n105\t    except Exception:  # noqa: BLE001 -- blocker awareness must never 500 the page\n106\t        return {}\n107\t\n108\t\n109\tdef _result_entry(vin: str, test_id: str) -> dict[str, Any]:\n110\t    entry = checklist_store.get(vin).get(step_id(test_id)) or {}\n111\t    result = entry.get(\"result\")\n112\t    return {\n113\t        \"result\": result or \"not_done\",\n114\t        \"value\": entry.get(\"value\"),\n115\t        \"unit\": entry.get(\"unit\") or \"\",\n116\t        \"reason\": entry.get(\"reason\") or \"\",\n117\t        \"hypothesis_id\": entry.get(\"hypothesis_id\"),\n118\t        \"when\": entry.get(\"done_at\"),\n119\t        \"by\": entry.get(\"done_by\") or \"\",\n120\t        \"media_ids\": entry.get(\"media_ids\") or [],\n121\t    }\n122\t\n123\t\n124\tdef _base_code(code: str) -> str:\n125\t    code = (code or \"\").strip().upper()\n126\t    return code[:5] if len(code) >= 5 else code\n127\t\n128\t\n129\tdef _why_for(t: dict[str, Any], open_codes: list[str],\n130\t            open_hyps: list[dict[str, Any]]) -> list[str]:\n131\t    why: list[str] = []\n132\t    bases = [_base_code(c) for c in open_codes if c]\n133\t    for rel in t[\"related_codes\"]:\n134\t        rel_u = rel.strip().upper()\n135\t        matched = sorted({c for c, b in zip(open_codes, bases) if b.startswith(rel_u)})\n136\t        if matched:\n137\t            why.append(f\"open code {', '.join(matched)}\")\n138\t    for h in open_hyps:\n139\t        if (h.get(\"system\") or \"\").strip().lower() in t[\"systems\"]:\n140\t            why.append(f\"open hypothesis: {h.get('text') or h['id']}\")\n141\t    return why\n142\t\n143\t\n144\tdef build_tests_view(vin: str) -> dict[str, Any]:\n145\t    \"\"\"Everything ``tests.html`` needs: the full catalogue, each test's\n146\t    latest result, relevance ranking, and category/summary counts.\"\"\"\n147\t    vin = (vin or \"\").strip()\n148\t    if not vin:\n149\t        raise BadRequest(\"a VIN is required\")\n150\t\n151\t    dossier = _cached_dossier(vin)\n152\t    open_codes = _open_codes(vin, dossier)\n153\t    open_hyps = _open_hypotheses(vin)\n154\t    fuel_gate = _fuel_gate(vin)\n155\t    fuel_blocked = fuel_gate.get(\"in_window\") is False\n156\t\n157\t    code_test_ids = {t[\"id\"] for t in mechanic_tests.tests_for_codes(open_codes)}\n158\t    hyp_systems = [h.get(\"system\") or \"\" for h in open_hyps if h.get(\"system\")]\n159\t    sys_test_ids = {t[\"id\"] for t in mechanic_tests.tests_for_systems(hyp_systems)} if hyp_systems else set()\n160\t    recommended_ids = code_test_ids | sys_test_ids\n161\t\n162\t    rows: list[dict[str, Any]] = []\n163\t    counts = {k: 0 for k in RESULT_COUNT_KEYS}\n164\t    for t in mechanic_tests.all_tests():\n165\t        rid = t[\"id\"]\n166\t        latest = _result_entry(vin, rid)\n167\t        counts[latest[\"result\"]] = counts.get(latest[\"result\"], 0) + 1\n168\t        blocker = None\n169\t        if fuel_blocked and rid in _EVAP_MONITOR_TEST_IDS:\n170\t            blocker = {\n171\t                \"reason\": \"fuel out of window\",\n172\t                \"window\": fuel_gate.get(\"window\"),\n173\t                \"level\": fuel_gate.get(\"level\"),\n174\t                \"direction\": fuel_gate.get(\"direction\"),\n175\t            }\n176\t        rows.append({\n177\t            **t,\n178\t            \"step_id\": step_id(rid),\n179\t            \"latest_result\": latest,\n180\t            \"recommended\": rid in recommended_ids,\n181\t            \"why\": _why_for(t, open_codes, open_hyps) if rid in recommended_ids else [],\n182\t            \"blocker\": blocker,\n183\t        })\n184\t\n185\t    rows.sort(key=lambda r: (0 if r[\"recommended\"] else 1, r[\"category\"], r[\"name\"]))\n186\t    categories = sorted({t[\"category\"] for t in mechanic_tests.all_tests()})\n187\t\n188\t    return {\n189\t        \"vin\": vin,\n190\t        \"tests\": rows,\n191\t        \"categories\": categories,\n192\t        \"counts\": counts,\n193\t        \"total\": len(rows),\n194\t        \"open_codes\": open_codes,\n195\t        \"open_hypotheses\": open_hypotheses_for_form(vin),\n196\t        \"fuel_gate\": fuel_gate,\n197\t    }\n198\t\n199\t\n200\tdef record_result(vin: str, test_id: str, result: Optional[str], *, reason: str = \"\",\n201\t                  value: Optional[float] = None, unit: str = \"\",\n202\t                  hypothesis_id: Optional[str] = None, supports: str = \"for\",\n203\t                  by: str = \"\") -> dict[str, Any]:\n204\t    \"\"\"Store one test's result and, when it names a hypothesis and the\n205\t    result is pass/fail, auto-attach it as evidence -- the same contract\n206\t    ``cuore.api.checklists``'s ``/result`` route already uses\n207\t    (:func:`cuore.services.jobs_bridge.add_test_evidence`), reused here\n208\t    rather than duplicated. ``supports`` is \"for\"/\"against\", exactly as\n209\t    that route's own field -- the caller (the result form) decides which\n210\t    side of the hypothesis this result counts toward; a plain pass/fail is\n211\t    not itself for/against any particular hypothesis without the tech\n212\t    saying so.\"\"\"\n213\t    if mechanic_tests.test(test_id) is None:\n214\t        raise BadRequest(f\"unknown test id {test_id!r}\")\n215\t    if result is not None and result not in mechanic_tests.POSTABLE_RESULTS:\n216\t        raise BadRequest(\"result must be one of: \"\n217\t                         + \", \".join(mechanic_tests.POSTABLE_RESULTS) + \", or null\")\n218\t    if supports not in (\"for\", \"against\"):\n219\t        raise BadRequest(\"supports must be 'for' or 'against'\")\n220\t    sid = step_id(test_id)\n221\t    entry = checklist_store.set_result(vin, sid, result, reason=reason, value=value,\n222\t                                       unit=unit, hypothesis_id=hypothesis_id, by=by)\n223\t    if hypothesis_id and result in (\"pass\", \"fail\"):\n224\t        t = mechanic_tests.test(test_id)\n225\t        label = f\"{t['name']}: {result}\"\n226\t        if value is not None:\n227\t            label += f\" {value:g}{unit}\"\n228\t        try:\n229\t            from . import jobs_bridge\n230\t            jobs_bridge.add_test_evidence(vin, hypothesis_id, sid, label, result,\n231\t                                          supports=supports, by=by)\n232\t        except Exception:  # noqa: BLE001 -- the result must still save\n233\t            pass\n234\t    return {\"vin\": vin, \"test_id\": test_id, \"step_id\": sid, **entry}\n235\t\n236\t\n237\t__all__ = [\"build_tests_view\", \"record_result\", \"step_id\", \"test_id_from_step\",\n238\t          \"open_hypotheses_for_form\", \"RESULT_COUNT_KEYS\"]\n239\t"}]},"uuid":"74cd6121-ca44-4899-8e83-d0a8bf8e7d5c","timestamp":"2026-10-14T00:24:41.204Z","toolUseResult":{"type":"text","file":{"filePath":"C:\\Users\\User\\mcp-servers\\cuore\\services\\tests_bridge.py","content":"\"\"\"The Tests surface: a catalogue of every mechanic test (:mod:`mes.mechanic_tests`)\ngrouped by category, each with this vehicle's latest recorded result and a\nrelevance ranking against its open codes and its job's open hypotheses.\n\nSame posture as :mod:`cuore.services.liveboard_bridge`: one bridge module,\nread-mostly, the single place ``cuore`` touches :mod:`mes.mechanic_tests` and\n:mod:`mes.jobs` for this feature. Results are written through the existing\nchecklist result store (:mod:`cuore.live.checklists`), keyed\n``step_id = \"test:<test_id>\"`` so they already flow into the job's\nhypothesis evidence path the same way a job-page test row does (see\n:mod:`cuore.api.checklists`'s own ``/result`` route, and\n:func:`cuore.services.jobs_bridge.add_test_evidence`) -- :mod:`cuore.api.tests`\ncalls that same function, never a second copy of the auto-attach logic.\n\nNothing here writes to the car. ``bench_bridge.build_bench`` is read for its\n``fuel_gate`` only, to flag the EVAP fuel-level verification window on the\ntests it actually affects (the ESIM/EVAP monitor-verification family) --\nsame blocker the bench page itself already shows.\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom typing import Any, Optional\n\nfrom .. import bootstrap  # noqa: F401  -- side effect: puts `mes` on sys.path\nfrom ..live import checklists as checklist_store\nfrom . import cache, mes_bridge\nfrom .errors import BadRequest\n\nfrom mes import mechanic_tests  # noqa: E402\n\ntry:\n    from mes import jobs as jobs_mod  # noqa: E402\nexcept Exception:  # noqa: BLE001 -- the tests page must still render\n    jobs_mod = None\n\ntry:\n    from . import bench_bridge\nexcept Exception:  # noqa: BLE001 -- blocker awareness is a nice-to-have\n    bench_bridge = None\n\n#: Step-id prefix for a test result in the checklist store -- see module\n#: docstring. Every write/read against ``checklist_store`` for this feature\n#: goes through :func:`_step_id`, never a hand-built string.\n_STEP_PREFIX = \"test:\"\n\n#: The family this catalogue's EVAP tests (``evap_smoke``, ``esim_vacuum_test_a``,\n#: ``purge_vent_actuation``) share with the bench's own fuel-window blocker --\n#: shown as a caution on these specific tests, not a generic banner on every\n#: test.\n_EVAP_MONITOR_TEST_IDS = (\"evap_smoke\", \"esim_vacuum_test_a\", \"purge_vent_actuation\")\n\nRESULT_COUNT_KEYS = (\"pass\", \"fail\", \"inconclusive\", \"not_possible\", \"not_done\")\n\n\ndef step_id(test_id: str) -> str:\n    return f\"{_STEP_PREFIX}{test_id}\"\n\n\ndef test_id_from_step(step: str) -> Optional[str]:\n    \"\"\"The test id a ``\"test:<id>\"`` step id names, or ``None`` if ``step``\n    is not one of this feature's step ids.\"\"\"\n    if not step.startswith(_STEP_PREFIX):\n        return None\n    return step[len(_STEP_PREFIX):]\n\n\ndef _cached_dossier(vin: str) -> dict[str, Any]:\n    mtime = mes_bridge.newest_mtime(vin)\n    return cache.get_or_build((\"workup\", vin, mtime), lambda: mes_bridge.workup(vin=vin))\n\n\ndef _open_codes(vin: str, dossier: dict[str, Any]) -> list[str]:\n    try:\n        return mes_bridge.open_codes_for(dossier)\n    except Exception:  # noqa: BLE001 -- relevance ranking is best-effort\n        return []\n\n\ndef _open_hypotheses(vin: str) -> list[dict[str, Any]]:\n    if jobs_mod is None:\n        return []\n    try:\n        job = jobs_mod.current(vin)\n    except Exception:  # noqa: BLE001\n        return []\n    if job is None:\n        return []\n    return [h for h in job.get(\"hypotheses\", [])\n           if h.get(\"status\") == \"open\" and not h.get(\"deleted\")]\n\n\ndef open_hypotheses_for_form(vin: str) -> list[dict[str, Any]]:\n    \"\"\"``{id, text, system}`` for every open hypothesis on this VIN's\n    current job -- the select list the result form offers.\"\"\"\n    return [{\"id\": h[\"id\"], \"text\": h.get(\"text\") or \"\", \"system\": h.get(\"system\") or \"\"}\n           for h in _open_hypotheses(vin)]\n\n\ndef _fuel_gate(vin: str) -> dict[str, Any]:\n    if bench_bridge is None:\n        return {}\n    try:\n        return bench_bridge.build_bench(vin).get(\"fuel_gate\") or {}\n    except Exception:  # noqa: BLE001 -- blocker awareness must never 500 the page\n        return {}\n\n\ndef _result_entry(vin: str, test_id: str) -> dict[str, Any]:\n    entry = checklist_store.get(vin).get(step_id(test_id)) or {}\n    result = entry.get(\"result\")\n    return {\n        \"result\": result or \"not_done\",\n        \"value\": entry.get(\"value\"),\n        \"unit\": entry.get(\"unit\") or \"\",\n        \"reason\": entry.get(\"reason\") or \"\",\n        \"hypothesis_id\": entry.get(\"hypothesis_id\"),\n        \"when\": entry.get(\"done_at\"),\n        \"by\": entry.get(\"done_by\") or \"\",\n        \"media_ids\": entry.get(\"media_ids\") or [],\n    }\n\n\ndef _base_code(code: str) -> str:\n    code = (code or \"\").strip().upper()\n    return code[:5] if len(code) >= 5 else code\n\n\ndef _why_for(t: dict[str, Any], open_codes: list[str],\n            open_hyps: list[dict[str, Any]]) -> list[str]:\n    why: list[str] = []\n    bases = [_base_code(c) for c in open_codes if c]\n    for rel in t[\"related_codes\"]:\n        rel_u = rel.strip().upper()\n        matched = sorted({c for c, b in zip(open_codes, bases) if b.startswith(rel_u)})\n        if matched:\n            why.append(f\"open code {', '.join(matched)}\")\n    for h in open_hyps:\n        if (h.get(\"system\") or \"\").strip().lower() in t[\"systems\"]:\n            why.append(f\"open hypothesis: {h.get('text') or h['id']}\")\n    return why\n\n\ndef build_tests_view(vin: str) -> dict[str, Any]:\n    \"\"\"Everything ``tests.html`` needs: the full catalogue, each test's\n    latest result, relevance ranking, and category/summary counts.\"\"\"\n    vin = (vin or \"\").strip()\n    if not vin:\n        raise BadRequest(\"a VIN is required\")\n\n    dossier = _cached_dossier(vin)\n    open_codes = _open_codes(vin, dossier)\n    open_hyps = _open_hypotheses(vin)\n    fuel_gate = _fuel_gate(vin)\n    fuel_blocked = fuel_gate.get(\"in_window\") is False\n\n    code_test_ids = {t[\"id\"] for t in mechanic_tests.tests_for_codes(open_codes)}\n    hyp_systems = [h.get(\"system\") or \"\" for h in open_hyps if h.get(\"system\")]\n    sys_test_ids = {t[\"id\"] for t in mechanic_tests.tests_for_systems(hyp_systems)} if hyp_systems else set()\n    recommended_ids = code_test_ids | sys_test_ids\n\n    rows: list[dict[str, Any]] = []\n    counts = {k: 0 for k in RESULT_COUNT_KEYS}\n    for t in mechanic_tests.all_tests():\n        rid = t[\"id\"]\n        latest = _result_entry(vin, rid)\n        counts[latest[\"result\"]] = counts.get(latest[\"result\"], 0) + 1\n        blocker = None\n        if fuel_blocked and rid in _EVAP_MONITOR_TEST_IDS:\n            blocker = {\n                \"reason\": \"fuel out of window\",\n                \"window\": fuel_gate.get(\"window\"),\n                \"level\": fuel_gate.get(\"level\"),\n                \"direction\": fuel_gate.get(\"direction\"),\n            }\n        rows.append({\n            **t,\n            \"step_id\": step_id(rid),\n            \"latest_result\": latest,\n            \"recommended\": rid in recommended_ids,\n            \"why\": _why_for(t, open_codes, open_hyps) if rid in recommended_ids else [],\n            \"blocker\": blocker,\n        })\n\n    rows.sort(key=lambda r: (0 if r[\"recommended\"] else 1, r[\"category\"], r[\"name\"]))\n    categories = sorted({t[\"category\"] for t in mechanic_tests.all_tests()})\n\n    return {\n        \"vin\": vin,\n        \"tests\": rows,\n        \"categories\": categories,\n        \"counts\": counts,\n        \"total\": len(rows),\n        \"open_codes\": open_codes,\n        \"open_hypotheses\": open_hypotheses_for_form(vin),\n        \"fuel_gate\": fuel_gate,\n    }\n\n\ndef record_result(vin: str, test_id: str, result: Optional[str], *, reason: str = \"\",\n                  value: Optional[float] = None, unit: str = \"\",\n                  hypothesis_id: Optional[str] = None, supports: str = \"for\",\n                  by: str = \"\") -> dict[str, Any]:\n    \"\"\"Store one test's result and, when it names a hypothesis and the\n    result is pass/fail, auto-attach it as evidence -- the same contract\n    ``cuore.api.checklists``'s ``/result`` route already uses\n    (:func:`cuore.services.jobs_bridge.add_test_evidence`), reused here\n    rather than duplicated. ``supports`` is \"for\"/\"against\", exactly as\n    that route's own field -- the caller (the result form) decides which\n    side of the hypothesis this result counts toward; a plain pass/fail is\n    not itself for/against any particular hypothesis without the tech\n    saying so.\"\"\"\n    if mechanic_tests.test(test_id) is None:\n        raise BadRequest(f\"unknown test id {test_id!r}\")\n    if result is not None and result not in mechanic_tests.POSTABLE_RESULTS:\n        raise BadRequest(\"result must be one of: \"\n                         + \", \".join(mechanic_tests.POSTABLE_RESULTS) + \", or null\")\n    if supports not in (\"for\", \"against\"):\n        raise BadRequest(\"supports must be 'for' or 'against'\")\n    sid = step_id(test_id)\n    entry = checklist_store.set_result(vin, sid, result, reason=reason, value=value,\n                                       unit=unit, hypothesis_id=hypothesis_id, by=by)\n    if hypothesis_id and result in (\"pass\", \"fail\"):\n        t = mechanic_tests.test(test_id)\n        label = f\"{t['name']}: {result}\"\n        if value is not None:\n            label += f\" {value:g}{unit}\"\n        try:\n            from . import jobs_bridge\n            jobs_bridge.add_test_evidence(vin, hypothesis_id, sid, label, result,\n                                          supports=supports, by=by)\n        except Exception:  # noqa: BLE001 -- the result must still save\n            pass\n    return {\"vin\": vin, \"test_id\": test_id, \"step_id\": sid, **entry}\n\n\n__all__ = [\"build_tests_view\", \"record_result\", \"step_id\", \"test_id_from_step\",\n          \"open_hypotheses_for_form\", \"RESULT_COUNT_KEYS\"]\n","numLines":239,"startLine":1,"totalLines":239}},"sourceToolAssistantUUID":"fcdd08e4-d5bd-459b-b366-3330f524b59a","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
