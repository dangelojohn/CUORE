{"parentUuid":"ee648a5c-4002-4139-833b-de3a3e210226","isSidechain":true,"agentId":"afb1dbcc97469a738","message":{"model":"claude-sonnet-5","id":"msg_011Cg1Bk1AskYWcD9tSv3CF9","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01U94MfxSGWBRTyZ4UZyqPnZ","name":"Edit","input":{"replace_all":false,"file_path":"C:\\Users\\User\\mcp-servers\\cuore\\services\\dossier_bridge.py","old_string":"def _evap_from_readiness(obs: dict[str, Any] | None) -> dict[str, Any] | None:\n    if obs is None:\n        return None\n    data = obs.get(\"data\") or {}\n    since = data.get(\"since_clear\") or {}\n    monitors = since.get(\"monitors\") or []\n    evap = next((m for m in monitors if m.get(\"monitor\") == \"Evaporative system\"), None)\n    if not monitors:\n        state = None\n    elif evap is None:\n        state = \"not_supported\"\n    else:\n        state = \"complete\" if evap.get(\"complete\") else \"incomplete\"\n    return {\"at\": obs.get(\"at\"), \"evap_monitor\": state,\n            \"all_complete\": bool(since.get(\"all_complete\"))}","new_string":"def _evap_from_readiness(obs: dict[str, Any] | None) -> dict[str, Any] | None:\n    if obs is None:\n        return None\n    data = obs.get(\"data\") or {}\n    since = data.get(\"since_clear\") or {}\n    monitors = since.get(\"monitors\") or []\n    evap = next((m for m in monitors if m.get(\"monitor\") == \"Evaporative system\"), None)\n    if not monitors:\n        state = None\n    elif evap is None:\n        state = \"not_supported\"\n    else:\n        state = \"complete\" if evap.get(\"complete\") else \"incomplete\"\n    return {\"at\": obs.get(\"at\"), \"evap_monitor\": state,\n            \"all_complete\": bool(since.get(\"all_complete\")),\n            \"mil_on\": since.get(\"mil_on\")}\n\n\n# --- DTCs read directly from the car -----------------------------------------\n\n\ndef _latest_live_dtcs(vin: str, after: str | None) -> dict[str, dict[str, Any]]:\n    \"\"\"``{\"stored\"|\"pending\"|\"permanent\": {\"at\":..., \"dtcs\": [base codes]}}``\n    -- the newest *from-car* ``obd_dtcs`` observation of each inner kind,\n    after ``after`` (the last clear). A read taken before the clear says\n    nothing about the car now, same reasoning as :func:`_latest_readiness`.\n    Never raises -- a broken store must never break the verdict.\"\"\"\n    try:\n        obs = live_store.recent_observations(300, vin=vin, kind=\"obd_dtcs\")\n    except Exception:  # noqa: BLE001\n        return {}\n    best: dict[str, dict[str, Any]] = {}\n    for o in obs:\n        if not live_store.is_from_car(o):\n            continue\n        at = o.get(\"at\") or \"\"\n        if after and at <= after:\n            continue\n        data = o.get(\"data\") or {}\n        inner = data.get(\"kind\")\n        if not inner:\n            continue\n        if inner not in best or at > best[inner][\"at\"]:\n            best[inner] = {\"at\": at, \"dtcs\": [_base(c) for c in data.get(\"dtcs\") or []]}\n    return best\n\n\n# --- module DTCs (UDS 0x19), read directly from the car ----------------------\n\n\ndef _module_dtc_state(flags: dict[str, Any]) -> str | None:\n    \"\"\"ACTIVE (currently failed or pending), HISTORY (confirmed/matured at\n    some point but not currently failing or pending), or ``None`` (not run\n    this cycle, or no meaningful bit set -- never listed as a fault).\"\"\"\n    if flags.get(\"testFailed\") or flags.get(\"pendingDTC\"):\n        return \"ACTIVE\"\n    if flags.get(\"confirmedDTC\") or flags.get(\"testFailedSinceLastClear\"):\n        return \"HISTORY\"\n    return None\n\n\ndef _live_module_dtcs(vin: str, after: str | None) -> list[dict[str, Any]]:\n    \"\"\"Every base code this car's own modules (UDS 0x19, one ECU per\n    observation) reported ACTIVE or HISTORY on a from-car read after\n    ``after``, newest read per (ecu, code) winning. Never raises.\"\"\"\n    try:\n        obs = live_store.recent_observations(500, vin=vin, kind=\"module_dtcs\")\n    except Exception:  # noqa: BLE001\n        return []\n    best: dict[tuple[str, str], dict[str, Any]] = {}\n    for o in obs:\n        if not live_store.is_from_car(o):\n            continue\n        at = o.get(\"at\") or \"\"\n        if after and at <= after:\n            continue\n        data = o.get(\"data\") or {}\n        ecu = data.get(\"ecu\") or \"\"\n        for d in data.get(\"dtcs\") or []:\n            code = _base(d.get(\"code\") or \"\")\n            if not code:\n                continue\n            state = _module_dtc_state(d.get(\"flags\") or {})\n            if state is None:\n                continue\n            key = (ecu, code)\n            if key not in best or at > best[key][\"at\"]:\n                best[key] = {\"ecu\": ecu, \"code\": code, \"state\": state, \"at\": at,\n                            \"status\": d.get(\"status\")}\n    return sorted(best.values(), key=lambda r: (r[\"ecu\"], r[\"code\"]))\n\n\n# --- freeze frames read directly from the car (Mode 02 sweep) ---------------\n\n\ndef _build_live_freeze_frames(vin: str, after: str | None) -> dict[str, Any] | None:\n    \"\"\"The latest from-car Mode 02 sweep, one row per PID, or ``None`` when\n    nothing has been read since the clear. Reads the ``freeze_frame``\n    observation kind :func:`cuore.live.ops.obd_freeze_frame` records.\"\"\"\n    try:\n        obs = live_store.recent_observations(1000, vin=vin, kind=\"freeze_frame\")\n    except Exception:  # noqa: BLE001\n        return None\n    frames: dict[str, dict[str, Any]] = {}\n    latest_at: str | None = None\n    for o in obs:\n        if not live_store.is_from_car(o):\n            continue\n        at = o.get(\"at\") or \"\"\n        if after and at <= after:\n            continue\n        data = o.get(\"data\") or {}\n        pid = data.get(\"pid\")\n        if not pid:\n            continue\n        by_ecu = data.get(\"by_ecu\") or {}\n        first = next(iter(by_ecu.values()), None)\n        if not first:\n            continue\n        entry = {\"pid\": pid, \"name\": data.get(\"name\") or first.get(\"name\") or pid,\n                 \"value\": first.get(\"value\"), \"unit\": first.get(\"unit\"),\n                 \"dtc\": first.get(\"dtc\")}\n        if pid not in frames or at > frames[pid].get(\"_at\", \"\"):\n            entry[\"_at\"] = at\n            frames[pid] = entry\n        if latest_at is None or at > latest_at:\n            latest_at = at\n    if not frames:\n        return None\n    for e in frames.values():\n        e.pop(\"_at\", None)\n    params = sorted(frames.values(), key=lambda p: p[\"pid\"])\n    at_short = (latest_at[:16].replace(\"T\", \" \") if latest_at else None)\n    return {\"at\": latest_at, \"at_short\": at_short, \"params\": params}\n\n\n# --- Mode $06, read directly from the car ------------------------------------\n\n_MODE06_FRIENDLY = {\"3A\": \"large-leak test\", \"3C\": \"small-leak test (0.020\\\")\"}\n\n\ndef _mode06_fail_label(mid: str, name: str, value: Any, unit: str | None,\n                       min_: Any, date_short: str | None) -> str:\n    unit = unit or \"\"\n\n    def fmt(v: Any) -> str:\n        if isinstance(v, (int, float)):\n            s = f\"{v:g}\"\n            return f\"{s} {unit}\".strip()\n        return str(v)\n    return f\"Mode 06 {name}: FAIL {fmt(value)} vs min {fmt(min_)} (car, {date_short})\"\n\n\ndef _build_mode06_view(vin: str, after: str | None) -> dict[str, Any] | None:\n    \"\"\"The latest from-car Mode $06 read since the clear, shaped into a\n    flat list of MID/TID rows plus the failing EVAP rows as ready-made\n    evidence items -- never auto-attached, just offered.\"\"\"\n    try:\n        obs = live_store.recent_observations(50, vin=vin, kind=\"mode06\")\n    except Exception:  # noqa: BLE001\n        return None\n    best = None\n    for o in obs:\n        if not live_store.is_from_car(o):\n            continue\n        at = o.get(\"at\") or \"\"\n        if after and at <= after:\n            continue\n        if best is None or at > (best.get(\"at\") or \"\"):\n            best = o\n    if best is None:\n        return None\n    data = best.get(\"data\") or {}\n    results = data.get(\"results\") or {}\n    at = best.get(\"at\")\n    date_short = at[:10] if at else None\n    rows: list[dict[str, Any]] = []\n    fails: list[dict[str, Any]] = []\n    for mid, r in sorted(results.items()):\n        for entries in (r.get(\"by_ecu\") or {}).values():\n            for e in entries:\n                name = (e.get(\"mid_name\") or f\"MID {mid}\").replace(\"EVAP monitor \", \"EVAP \")\n                row = {\"mid\": mid, \"tid\": e.get(\"tid\"), \"name\": name,\n                      \"value\": e.get(\"value\"), \"unit\": e.get(\"unit\"),\n                      \"min\": e.get(\"min\"), \"max\": e.get(\"max\"),\n                      \"passed\": e.get(\"passed\")}\n                rows.append(row)\n                if e.get(\"passed\") is False and \"EVAP\" in name.upper():\n                    label = _mode06_fail_label(mid, name, e.get(\"value\"), e.get(\"unit\"),\n                                               e.get(\"min\"), date_short)\n                    fails.append({\"mid\": mid, \"name\": name, \"value\": e.get(\"value\"),\n                                 \"unit\": e.get(\"unit\"), \"min\": e.get(\"min\"),\n                                 \"label\": label,\n                                 \"friendly\": _MODE06_FRIENDLY.get(mid, name.lower())})\n    return {\"at\": at, \"at_short\": date_short, \"rows\": rows, \"fails\": fails,\n           \"fail_count\": len(fails)}"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1805,"cache_read_input_tokens":185513,"cache_creation":{"ephemeral_5m_input_tokens":1805,"ephemeral_1h_input_tokens":0},"output_tokens":3,"service_tier":"standard","inference_geo":"global"},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_01U94MfxSGWBRTyZ4UZyqPnZ":{"file_path":"C:\\Users\\User\\mcp-servers\\cuore\\services\\dossier_bridge.py","old_string":"def _evap_from_readiness(obs: dict[str, Any] | None) -> dict[str, Any] | None:\n    if obs is None:\n        return None\n    data = obs.get(\"data\") or {}\n    since = data.get(\"since_clear\") or {}\n    monitors = since.get(\"monitors\") or []\n    evap = next((m for m in monitors if m.get(\"monitor\") == \"Evaporative system\"), None)\n    if not monitors:\n        state = None\n    elif evap is None:\n        state = \"not_supported\"\n    else:\n        state = \"complete\" if evap.get(\"complete\") else \"incomplete\"\n    return {\"at\": obs.get(\"at\"), \"evap_monitor\": state,\n            \"all_complete\": bool(since.get(\"all_complete\"))}","new_string":"def _evap_from_readiness(obs: dict[str, Any] | None) -> dict[str, Any] | None:\n    if obs is None:\n        return None\n    data = obs.get(\"data\") or {}\n    since = data.get(\"since_clear\") or {}\n    monitors = since.get(\"monitors\") or []\n    evap = next((m for m in monitors if m.get(\"monitor\") == \"Evaporative system\"), None)\n    if not monitors:\n        state = None\n    elif evap is None:\n        state = \"not_supported\"\n    else:\n        state = \"complete\" if evap.get(\"complete\") else \"incomplete\"\n    return {\"at\": obs.get(\"at\"), \"evap_monitor\": state,\n            \"all_complete\": bool(since.get(\"all_complete\")),\n            \"mil_on\": since.get(\"mil_on\")}\n\n\n# --- DTCs read directly from the car -----------------------------------------\n\n\ndef _latest_live_dtcs(vin: str, after: str | None) -> dict[str, dict[str, Any]]:\n    \"\"\"``{\"stored\"|\"pending\"|\"permanent\": {\"at\":..., \"dtcs\": [base codes]}}``\n    -- the newest *from-car* ``obd_dtcs`` observation of each inner kind,\n    after ``after`` (the last clear). A read taken before the clear says\n    nothing about the car now, same reasoning as :func:`_latest_readiness`.\n    Never raises -- a broken store must never break the verdict.\"\"\"\n    try:\n        obs = live_store.recent_observations(300, vin=vin, kind=\"obd_dtcs\")\n    except Exception:  # noqa: BLE001\n        return {}\n    best: dict[str, dict[str, Any]] = {}\n    for o in obs:\n        if not live_store.is_from_car(o):\n            continue\n        at = o.get(\"at\") or \"\"\n        if after and at <= after:\n            continue\n        data = o.get(\"data\") or {}\n        inner = data.get(\"kind\")\n        if not inner:\n            continue\n        if inner not in best or at > best[inner][\"at\"]:\n            best[inner] = {\"at\": at, \"dtcs\": [_base(c) for c in data.get(\"dtcs\") or []]}\n    return best\n\n\n# --- module DTCs (UDS 0x19), read directly from the car ----------------------\n\n\ndef _module_dtc_state(flags: dict[str, Any]) -> str | None:\n    \"\"\"ACTIVE (currently failed or pending), HISTORY (confirmed/matured at\n    some point but not currently failing or pending), or ``None`` (not run\n    this cycle, or no meaningful bit set -- never listed as a fault).\"\"\"\n    if flags.get(\"testFailed\") or flags.get(\"pendingDTC\"):\n        return \"ACTIVE\"\n    if flags.get(\"confirmedDTC\") or flags.get(\"testFailedSinceLastClear\"):\n        return \"HISTORY\"\n    return None\n\n\ndef _live_module_dtcs(vin: str, after: str | None) -> list[dict[str, Any]]:\n    \"\"\"Every base code this car's own modules (UDS 0x19, one ECU per\n    observation) reported ACTIVE or HISTORY on a from-car read after\n    ``after``, newest read per (ecu, code) winning. Never raises.\"\"\"\n    try:\n        obs = live_store.recent_observations(500, vin=vin, kind=\"module_dtcs\")\n    except Exception:  # noqa: BLE001\n        return []\n    best: dict[tuple[str, str], dict[str, Any]] = {}\n    for o in obs:\n        if not live_store.is_from_car(o):\n            continue\n        at = o.get(\"at\") or \"\"\n        if after and at <= after:\n            continue\n        data = o.get(\"data\") or {}\n        ecu = data.get(\"ecu\") or \"\"\n        for d in data.get(\"dtcs\") or []:\n            code = _base(d.get(\"code\") or \"\")\n            if not code:\n                continue\n            state = _module_dtc_state(d.get(\"flags\") or {})\n            if state is None:\n                continue\n            key = (ecu, code)\n            if key not in best or at > best[key][\"at\"]:\n                best[key] = {\"ecu\": ecu, \"code\": code, \"state\": state, \"at\": at,\n                            \"status\": d.get(\"status\")}\n    return sorted(best.values(), key=lambda r: (r[\"ecu\"], r[\"code\"]))\n\n\n# --- freeze frames read directly from the car (Mode 02 sweep) ---------------\n\n\ndef _build_live_freeze_frames(vin: str, after: str | None) -> dict[str, Any] | None:\n    \"\"\"The latest from-car Mode 02 sweep, one row per PID, or ``None`` when\n    nothing has been read since the clear. Reads the ``freeze_frame``\n    observation kind :func:`cuore.live.ops.obd_freeze_frame` records.\"\"\"\n    try:\n        obs = live_store.recent_observations(1000, vin=vin, kind=\"freeze_frame\")\n    except Exception:  # noqa: BLE001\n        return None\n    frames: dict[str, dict[str, Any]] = {}\n    latest_at: str | None = None\n    for o in obs:\n        if not live_store.is_from_car(o):\n            continue\n        at = o.get(\"at\") or \"\"\n        if after and at <= after:\n            continue\n        data = o.get(\"data\") or {}\n        pid = data.get(\"pid\")\n        if not pid:\n            continue\n        by_ecu = data.get(\"by_ecu\") or {}\n        first = next(iter(by_ecu.values()), None)\n        if not first:\n            continue\n        entry = {\"pid\": pid, \"name\": data.get(\"name\") or first.get(\"name\") or pid,\n                 \"value\": first.get(\"value\"), \"unit\": first.get(\"unit\"),\n                 \"dtc\": first.get(\"dtc\")}\n        if pid not in frames or at > frames[pid].get(\"_at\", \"\"):\n            entry[\"_at\"] = at\n            frames[pid] = entry\n        if latest_at is None or at > latest_at:\n            latest_at = at\n    if not frames:\n        return None\n    for e in frames.values():\n        e.pop(\"_at\", None)\n    params = sorted(frames.values(), key=lambda p: p[\"pid\"])\n    at_short = (latest_at[:16].replace(\"T\", \" \") if latest_at else None)\n    return {\"at\": latest_at, \"at_short\": at_short, \"params\": params}\n\n\n# --- Mode $06, read directly from the car ------------------------------------\n\n_MODE06_FRIENDLY = {\"3A\": \"large-leak test\", \"3C\": \"small-leak test (0.020\\\")\"}\n\n\ndef _mode06_fail_label(mid: str, name: str, value: Any, unit: str | None,\n                       min_: Any, date_short: str | None) -> str:\n    unit = unit or \"\"\n\n    def fmt(v: Any) -> str:\n        if isinstance(v, (int, float)):\n            s = f\"{v:g}\"\n            return f\"{s} {unit}\".strip()\n        return str(v)\n    return f\"Mode 06 {name}: FAIL {fmt(value)} vs min {fmt(min_)} (car, {date_short})\"\n\n\ndef _build_mode06_view(vin: str, after: str | None) -> dict[str, Any] | None:\n    \"\"\"The latest from-car Mode $06 read since the clear, shaped into a\n    flat list of MID/TID rows plus the failing EVAP rows as ready-made\n    evidence items -- never auto-attached, just offered.\"\"\"\n    try:\n        obs = live_store.recent_observations(50, vin=vin, kind=\"mode06\")\n    except Exception:  # noqa: BLE001\n        return None\n    best = None\n    for o in obs:\n        if not live_store.is_from_car(o):\n            continue\n        at = o.get(\"at\") or \"\"\n        if after and at <= after:\n            continue\n        if best is None or at > (best.get(\"at\") or \"\"):\n            best = o\n    if best is None:\n        return None\n    data = best.get(\"data\") or {}\n    results = data.get(\"results\") or {}\n    at = best.get(\"at\")\n    date_short = at[:10] if at else None\n    rows: list[dict[str, Any]] = []\n    fails: list[dict[str, Any]] = []\n    for mid, r in sorted(results.items()):\n        for entries in (r.get(\"by_ecu\") or {}).values():\n            for e in entries:\n                name = (e.get(\"mid_name\") or f\"MID {mid}\").replace(\"EVAP monitor \", \"EVAP \")\n                row = {\"mid\": mid, \"tid\": e.get(\"tid\"), \"name\": name,\n                      \"value\": e.get(\"value\"), \"unit\": e.get(\"unit\"),\n                      \"min\": e.get(\"min\"), \"max\": e.get(\"max\"),\n                      \"passed\": e.get(\"passed\")}\n                rows.append(row)\n                if e.get(\"passed\") is False and \"EVAP\" in name.upper():\n                    label = _mode06_fail_label(mid, name, e.get(\"value\"), e.get(\"unit\"),\n                                               e.get(\"min\"), date_short)\n                    fails.append({\"mid\": mid, \"name\": name, \"value\": e.get(\"value\"),\n                                 \"unit\": e.get(\"unit\"), \"min\": e.get(\"min\"),\n                                 \"label\": label,\n                                 \"friendly\": _MODE06_FRIENDLY.get(mid, name.lower())})\n    return {\"at\": at, \"at_short\": date_short, \"rows\": rows, \"fails\": fails,\n           \"fail_count\": len(fails)}"}},"serverClassifierRequest":"ac692294-9c12-4724-9336-7255108741d1","apiBlockIndex":2,"requestId":"req_011Cg1BjzwzFpsSH8cC9x2GC","attributionAgent":"general-purpose","type":"assistant","uuid":"fc0b6f26-9967-4c3b-8bfa-ba4b87f9c43c","timestamp":"2026-10-14T00:31:11.968Z","effort":"high","perTurnEffort":null,"userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
{"parentUuid":"fc0b6f26-9967-4c3b-8bfa-ba4b87f9c43c","isSidechain":true,"promptId":"df226819-4f0d-4979-bf53-3ffca405c7dd","agentId":"afb1dbcc97469a738","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01U94MfxSGWBRTyZ4UZyqPnZ","type":"tool_result","content":"The file C:\\Users\\User\\mcp-servers\\cuore\\services\\dossier_bridge.py has been updated successfully. (file state is current in your context — no need to Read it back)"}]},"uuid":"657521d7-0450-4e5b-b4b3-1f3b04582b8a","timestamp":"2026-10-14T00:31:12.533Z","toolUseResult":{"filePath":"C:\\Users\\User\\mcp-servers\\cuore\\services\\dossier_bridge.py","oldString":"def _evap_from_readiness(obs: dict[str, Any] | None) -> dict[str, Any] | None:\n    if obs is None:\n        return None\n    data = obs.get(\"data\") or {}\n    since = data.get(\"since_clear\") or {}\n    monitors = since.get(\"monitors\") or []\n    evap = next((m for m in monitors if m.get(\"monitor\") == \"Evaporative system\"), None)\n    if not monitors:\n        state = None\n    elif evap is None:\n        state = \"not_supported\"\n    else:\n        state = \"complete\" if evap.get(\"complete\") else \"incomplete\"\n    return {\"at\": obs.get(\"at\"), \"evap_monitor\": state,\n            \"all_complete\": bool(since.get(\"all_complete\"))}","newString":"def _evap_from_readiness(obs: dict[str, Any] | None) -> dict[str, Any] | None:\n    if obs is None:\n        return None\n    data = obs.get(\"data\") or {}\n    since = data.get(\"since_clear\") or {}\n    monitors = since.get(\"monitors\") or []\n    evap = next((m for m in monitors if m.get(\"monitor\") == \"Evaporative system\"), None)\n    if not monitors:\n        state = None\n    elif evap is None:\n        state = \"not_supported\"\n    else:\n        state = \"complete\" if evap.get(\"complete\") else \"incomplete\"\n    return {\"at\": obs.get(\"at\"), \"evap_monitor\": state,\n            \"all_complete\": bool(since.get(\"all_complete\")),\n            \"mil_on\": since.get(\"mil_on\")}\n\n\n# --- DTCs read directly from the car -----------------------------------------\n\n\ndef _latest_live_dtcs(vin: str, after: str | None) -> dict[str, dict[str, Any]]:\n    \"\"\"``{\"stored\"|\"pending\"|\"permanent\": {\"at\":..., \"dtcs\": [base codes]}}``\n    -- the newest *from-car* ``obd_dtcs`` observation of each inner kind,\n    after ``after`` (the last clear). A read taken before the clear says\n    nothing about the car now, same reasoning as :func:`_latest_readiness`.\n    Never raises -- a broken store must never break the verdict.\"\"\"\n    try:\n        obs = live_store.recent_observations(300, vin=vin, kind=\"obd_dtcs\")\n    except Exception:  # noqa: BLE001\n        return {}\n    best: dict[str, dict[str, Any]] = {}\n    for o in obs:\n        if not live_store.is_from_car(o):\n            continue\n        at = o.get(\"at\") or \"\"\n        if after and at <= after:\n            continue\n        data = o.get(\"data\") or {}\n        inner = data.get(\"kind\")\n        if not inner:\n            continue\n        if inner not in best or at > best[inner][\"at\"]:\n            best[inner] = {\"at\": at, \"dtcs\": [_base(c) for c in data.get(\"dtcs\") or []]}\n    return best\n\n\n# --- module DTCs (UDS 0x19), read directly from the car ----------------------\n\n\ndef _module_dtc_state(flags: dict[str, Any]) -> str | None:\n    \"\"\"ACTIVE (currently failed or pending), HISTORY (confirmed/matured at\n    some point but not currently failing or pending), or ``None`` (not run\n    this cycle, or no meaningful bit set -- never listed as a fault).\"\"\"\n    if flags.get(\"testFailed\") or flags.get(\"pendingDTC\"):\n        return \"ACTIVE\"\n    if flags.get(\"confirmedDTC\") or flags.get(\"testFailedSinceLastClear\"):\n        return \"HISTORY\"\n    return None\n\n\ndef _live_module_dtcs(vin: str, after: str | None) -> list[dict[str, Any]]:\n    \"\"\"Every base code this car's own modules (UDS 0x19, one ECU per\n    observation) reported ACTIVE or HISTORY on a from-car read after\n    ``after``, newest read per (ecu, code) winning. Never raises.\"\"\"\n    try:\n        obs = live_store.recent_observations(500, vin=vin, kind=\"module_dtcs\")\n    except Exception:  # noqa: BLE001\n        return []\n    best: dict[tuple[str, str], dict[str, Any]] = {}\n    for o in obs:\n        if not live_store.is_from_car(o):\n            continue\n        at = o.get(\"at\") or \"\"\n        if after and at <= after:\n            continue\n        data = o.get(\"data\") or {}\n        ecu = data.get(\"ecu\") or \"\"\n        for d in data.get(\"dtcs\") or []:\n            code = _base(d.get(\"code\") or \"\")\n            if not code:\n                continue\n            state = _module_dtc_state(d.get(\"flags\") or {})\n            if state is None:\n                continue\n            key = (ecu, code)\n            if key not in best or at > best[key][\"at\"]:\n                best[key] = {\"ecu\": ecu, \"code\": code, \"state\": state, \"at\": at,\n                            \"status\": d.get(\"status\")}\n    return sorted(best.values(), key=lambda r: (r[\"ecu\"], r[\"code\"]))\n\n\n# --- freeze frames read directly from the car (Mode 02 sweep) ---------------\n\n\ndef _build_live_freeze_frames(vin: str, after: str | None) -> dict[str, Any] | None:\n    \"\"\"The latest from-car Mode 02 sweep, one row per PID, or ``None`` when\n    nothing has been read since the clear. Reads the ``freeze_frame``\n    observation kind :func:`cuore.live.ops.obd_freeze_frame` records.\"\"\"\n    try:\n        obs = live_store.recent_observations(1000, vin=vin, kind=\"freeze_frame\")\n    except Exception:  # noqa: BLE001\n        return None\n    frames: dict[str, dict[str, Any]] = {}\n    latest_at: str | None = None\n    for o in obs:\n        if not live_store.is_from_car(o):\n            continue\n        at = o.get(\"at\") or \"\"\n        if after and at <= after:\n            continue\n        data = o.get(\"data\") or {}\n        pid = data.get(\"pid\")\n        if not pid:\n            continue\n        by_ecu = data.get(\"by_ecu\") or {}\n        first = next(iter(by_ecu.values()), None)\n        if not first:\n            continue\n        entry = {\"pid\": pid, \"name\": data.get(\"name\") or first.get(\"name\") or pid,\n                 \"value\": first.get(\"value\"), \"unit\": first.get(\"unit\"),\n                 \"dtc\": first.get(\"dtc\")}\n        if pid not in frames or at > frames[pid].get(\"_at\", \"\"):\n            entry[\"_at\"] = at\n            frames[pid] = entry\n        if latest_at is None or at > latest_at:\n            latest_at = at\n    if not frames:\n        return None\n    for e in frames.values():\n        e.pop(\"_at\", None)\n    params = sorted(frames.values(), key=lambda p: p[\"pid\"])\n    at_short = (latest_at[:16].replace(\"T\", \" \") if latest_at else None)\n    return {\"at\": latest_at, \"at_short\": at_short, \"params\": params}\n\n\n# --- Mode $06, read directly from the car ------------------------------------\n\n_MODE06_FRIENDLY = {\"3A\": \"large-leak test\", \"3C\": \"small-leak test (0.020\\\")\"}\n\n\ndef _mode06_fail_label(mid: str, name: str, value: Any, unit: str | None,\n                       min_: Any, date_short: str | None) -> str:\n    unit = unit or \"\"\n\n    def fmt(v: Any) -> str:\n        if isinstance(v, (int, float)):\n            s = f\"{v:g}\"\n            return f\"{s} {unit}\".strip()\n        return str(v)\n    return f\"Mode 06 {name}: FAIL {fmt(value)} vs min {fmt(min_)} (car, {date_short})\"\n\n\ndef _build_mode06_view(vin: str, after: str | None) -> dict[str, Any] | None:\n    \"\"\"The latest from-car Mode $06 read since the clear, shaped into a\n    flat list of MID/TID rows plus the failing EVAP rows as ready-made\n    evidence items -- never auto-attached, just offered.\"\"\"\n    try:\n        obs = live_store.recent_observations(50, vin=vin, kind=\"mode06\")\n    except Exception:  # noqa: BLE001\n        return None\n    best = None\n    for o in obs:\n        if not live_store.is_from_car(o):\n            continue\n        at = o.get(\"at\") or \"\"\n        if after and at <= after:\n            continue\n        if best is None or at > (best.get(\"at\") or \"\"):\n            best = o\n    if best is None:\n        return None\n    data = best.get(\"data\") or {}\n    results = data.get(\"results\") or {}\n    at = best.get(\"at\")\n    date_short = at[:10] if at else None\n    rows: list[dict[str, Any]] = []\n    fails: list[dict[str, Any]] = []\n    for mid, r in sorted(results.items()):\n        for entries in (r.get(\"by_ecu\") or {}).values():\n            for e in entries:\n                name = (e.get(\"mid_name\") or f\"MID {mid}\").replace(\"EVAP monitor \", \"EVAP \")\n                row = {\"mid\": mid, \"tid\": e.get(\"tid\"), \"name\": name,\n                      \"value\": e.get(\"value\"), \"unit\": e.get(\"unit\"),\n                      \"min\": e.get(\"min\"), \"max\": e.get(\"max\"),\n                      \"passed\": e.get(\"passed\")}\n                rows.append(row)\n                if e.get(\"passed\") is False and \"EVAP\" in name.upper():\n                    label = _mode06_fail_label(mid, name, e.get(\"value\"), e.get(\"unit\"),\n                                               e.get(\"min\"), date_short)\n                    fails.append({\"mid\": mid, \"name\": name, \"value\": e.get(\"value\"),\n                                 \"unit\": e.get(\"unit\"), \"min\": e.get(\"min\"),\n                                 \"label\": label,\n                                 \"friendly\": _MODE06_FRIENDLY.get(mid, name.lower())})\n    return {\"at\": at, \"at_short\": date_short, \"rows\": rows, \"fails\": fails,\n           \"fail_count\": len(fails)}","originalFile":null,"structuredPatch":[{"oldStart":369,"oldLines":9,"newStart":369,"newLines":190,"lines":["     else:","         state = \"complete\