{"parentUuid":"6f57ab2d-1910-44c1-88b0-3b45467bc364","isSidechain":true,"promptId":"6a5490e7-db98-4c8e-ab2a-d6269cfe62dd","agentId":"afb1dbcc97469a738","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Qr9MVTuv1YTNRogreAL1oE","type":"tool_result","content":"1\t\"\"\"The operations both surfaces call: HTTP routes and MCP tools are wrappers over these.\n2\t\n3\tEvery function returns a plain dict, opens the adapter for exactly its own\n4\toperation through :func:`link`, and names the bus and cable it used. Errors\n5\tare :class:`LiveError` subclasses; the surfaces decide how to render them.\n6\t\"\"\"\n7\t\n8\tfrom __future__ import annotations\n9\t\n10\timport re\n11\tfrom datetime import datetime\n12\tfrom pathlib import Path\n13\tfrom typing import Any, Optional\n14\t\n15\timport serial.tools.list_ports\n16\t\n17\tfrom . import audit\n18\tfrom . import capture as capture_mod\n19\tfrom . import store\n20\tfrom . import uds as uds_mod\n21\tfrom .addressing import MODULES, by_code, on_bus\n22\tfrom .buses import BUSES, CAN_C, Bus, routes_for\n23\tfrom .config import mes_folders, mes_interfaces, mes_registry, resolve_port\n24\tfrom .errors import BadCommand, LiveError, Refused\n25\tfrom .framing import adapter_error, no_data\n26\tfrom .obd import (decode_obd_dtcs, decode_pid, decode_readiness, decode_supported_pids,\n27\t                  dtc_from_two_bytes, evap_verdict, resolve_pid, PIDS_BY_HEX)\n28\tfrom .transport import DEFAULT_TIMEOUT, AdapterLink, Session, link\n29\t\n30\t_MODE03_NOTE = (\"Mode 03 returns emissions-related powertrain codes only. Body, chassis and \"\n31\t                \"network faults are UDS 3-byte codes; use module DTC reads for those.\")\n32\t\n33\t\n34\tdef _bus(key: str) -> Bus:\n35\t    bus = BUSES.get((key or \"can_c\").lower())\n36\t    if bus is None:\n37\t        raise BadCommand(f\"unknown bus {key!r}; one of {list(BUSES)}\")\n38\t    return bus\n39\t\n40\t\n41\tdef _stamp(sess: Session, out: dict[str, Any]) -> dict[str, Any]:\n42\t    out.setdefault(\"bus\", sess.bus.key)\n43\t    out.setdefault(\"cable\", sess.link.cable)\n44\t    auto = getattr(sess, \"auto_verified\", None)\n45\t    if auto:\n46\t        out.setdefault(\"auto_verified\", auto)\n47\t    return out\n48\t\n49\t\n50\tdef _observe(sess: Session, kind: str, out: dict[str, Any], vin: str = \"\") -> dict[str, Any]:\n51\t    \"\"\"Stamp and persist a result as an observation the evidence gate can cite.\"\"\"\n52\t    _stamp(sess, out)\n53\t    v = vin or getattr(sess.link, \"vin\", \"\") or \"\"\n54\t    store.record_observation(kind, out, vin=v, bus=sess.bus.key, cable=sess.link.cable,\n55\t                             stream=sess.stream.describe)\n56\t    return out\n57\t\n58\t\n59\t# --- status and configuration -------------------------------------------------\n60\t\n61\tdef status() -> dict[str, Any]:\n62\t    return link().status()\n63\t\n64\t\n65\tdef ports() -> dict[str, Any]:\n66\t    mes_port = (mes_registry().get(\"Interface 0 Port\") or \"\").upper()\n67\t    found = [{\"device\": p.device, \"description\": p.description, \"hwid\": p.hwid,\n68\t              \"mes_interface_0\": p.device.upper() == mes_port}\n69\t             for p in serial.tools.list_ports.comports()]\n70\t    return {\"ports\": found, \"mes_port\": mes_port or None}\n71\t\n72\t\n73\tdef mes_settings() -> dict[str, Any]:\n74\t    reg = mes_registry()\n75\t    if not reg:\n76\t        return {\"error\": \"HKLM\\\\SOFTWARE\\\\Multiecuscan not found\"}\n77\t    return {\"interfaces\": mes_interfaces(reg), \"folders\": mes_folders(reg),\n78\t            \"last_selection\": reg.get(\"Last Selection\"),\n79\t            \"recent_vehicles\": reg.get(\"Recent Vehicles\"),\n80\t            \"ui_language\": reg.get(\"UI Language\"), \"data_language\": reg.get(\"Data Language\"),\n81\t            \"all_keys\": sorted(reg.keys())}\n82\t\n83\t\n84\tdef set_cable(cable: str) -> dict[str, Any]:\n85\t    return link().set_cable(cable)\n86\t\n87\t\n88\tdef cable_state() -> dict[str, Any]:\n89\t    return link().cable_state()\n90\t"}]},"uuid":"583890bc-8ada-4502-b0d7-401cad6cc609","timestamp":"2026-10-14T00:22:07.800Z","toolUseResult":{"type":"text","file":{"filePath":"C:\\Users\\User\\mcp-servers\\cuore\\live\\ops.py","content":"\"\"\"The operations both surfaces call: HTTP routes and MCP tools are wrappers over these.\n\nEvery function returns a plain dict, opens the adapter for exactly its own\noperation through :func:`link`, and names the bus and cable it used. Errors\nare :class:`LiveError` subclasses; the surfaces decide how to render them.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport re\nfrom datetime import datetime\nfrom pathlib import Path\nfrom typing import Any, Optional\n\nimport serial.tools.list_ports\n\nfrom . import audit\nfrom . import capture as capture_mod\nfrom . import store\nfrom . import uds as uds_mod\nfrom .addressing import MODULES, by_code, on_bus\nfrom .buses import BUSES, CAN_C, Bus, routes_for\nfrom .config import mes_folders, mes_interfaces, mes_registry, resolve_port\nfrom .errors import BadCommand, LiveError, Refused\nfrom .framing import adapter_error, no_data\nfrom .obd import (decode_obd_dtcs, decode_pid, decode_readiness, decode_supported_pids,\n                  dtc_from_two_bytes, evap_verdict, resolve_pid, PIDS_BY_HEX)\nfrom .transport import DEFAULT_TIMEOUT, AdapterLink, Session, link\n\n_MODE03_NOTE = (\"Mode 03 returns emissions-related powertrain codes only. Body, chassis and \"\n                \"network faults are UDS 3-byte codes; use module DTC reads for those.\")\n\n\ndef _bus(key: str) -> Bus:\n    bus = BUSES.get((key or \"can_c\").lower())\n    if bus is None:\n        raise BadCommand(f\"unknown bus {key!r}; one of {list(BUSES)}\")\n    return bus\n\n\ndef _stamp(sess: Session, out: dict[str, Any]) -> dict[str, Any]:\n    out.setdefault(\"bus\", sess.bus.key)\n    out.setdefault(\"cable\", sess.link.cable)\n    auto = getattr(sess, \"auto_verified\", None)\n    if auto:\n        out.setdefault(\"auto_verified\", auto)\n    return out\n\n\ndef _observe(sess: Session, kind: str, out: dict[str, Any], vin: str = \"\") -> dict[str, Any]:\n    \"\"\"Stamp and persist a result as an observation the evidence gate can cite.\"\"\"\n    _stamp(sess, out)\n    v = vin or getattr(sess.link, \"vin\", \"\") or \"\"\n    store.record_observation(kind, out, vin=v, bus=sess.bus.key, cable=sess.link.cable,\n                             stream=sess.stream.describe)\n    return out\n\n\n# --- status and configuration -------------------------------------------------\n\ndef status() -> dict[str, Any]:\n    return link().status()\n\n\ndef ports() -> dict[str, Any]:\n    mes_port = (mes_registry().get(\"Interface 0 Port\") or \"\").upper()\n    found = [{\"device\": p.device, \"description\": p.description, \"hwid\": p.hwid,\n              \"mes_interface_0\": p.device.upper() == mes_port}\n             for p in serial.tools.list_ports.comports()]\n    return {\"ports\": found, \"mes_port\": mes_port or None}\n\n\ndef mes_settings() -> dict[str, Any]:\n    reg = mes_registry()\n    if not reg:\n        return {\"error\": \"HKLM\\\\SOFTWARE\\\\Multiecuscan not found\"}\n    return {\"interfaces\": mes_interfaces(reg), \"folders\": mes_folders(reg),\n            \"last_selection\": reg.get(\"Last Selection\"),\n            \"recent_vehicles\": reg.get(\"Recent Vehicles\"),\n            \"ui_language\": reg.get(\"UI Language\"), \"data_language\": reg.get(\"Data Language\"),\n            \"all_keys\": sorted(reg.keys())}\n\n\ndef set_cable(cable: str) -> dict[str, Any]:\n    return link().set_cable(cable)\n\n\ndef cable_state() -> dict[str, Any]:\n    return link().cable_state()\n","numLines":90,"startLine":1,"totalLines":1097}},"sourceToolAssistantUUID":"6f57ab2d-1910-44c1-88b0-3b45467bc364","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
