{"parentUuid":"3354b013-9073-4241-97de-a851af593d30","isSidechain":true,"agentId":"afb1dbcc97469a738","message":{"model":"claude-sonnet-5","id":"msg_011Cg1BAc7sMQ14c5qp9ki57","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01MDnvCTbGbyx9bgJAGakM2U","name":"Read","input":{"file_path":"C:\\Users\\User\\mcp-servers\\cuore\\services\\jobs_bridge.py","offset":1,"limit":260},"caller":{"type":"direct"}}],"container":null,"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":3412,"cache_read_input_tokens":132489,"output_tokens":297,"output_tokens_details":{"thinking_tokens":175},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":0,"ephemeral_5m_input_tokens":3412},"inference_geo":"global","iterations":[{"input_tokens":2,"output_tokens":297,"cache_read_input_tokens":132489,"cache_creation_input_tokens":3412,"cache_creation":{"ephemeral_5m_input_tokens":3412,"ephemeral_1h_input_tokens":0},"type":"message"}],"speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_01MDnvCTbGbyx9bgJAGakM2U":{"file_path":"C:\\Users\\User\\mcp-servers\\cuore\\services\\jobs_bridge.py","offset":1,"limit":260}},"serverClassifierRequest":"d9034dde-802b-442f-aacb-834179d33c16","apiBlockIndex":1,"requestId":"req_011Cg1BAbrzQKQCtyxNkhxyw","attributionAgent":"general-purpose","type":"assistant","uuid":"6014c3d1-8148-41d2-bc63-8675d38c6213","timestamp":"2026-10-14T00:23:15.831Z","effort":"high","perTurnEffort":null,"userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
{"parentUuid":"6014c3d1-8148-41d2-bc63-8675d38c6213","isSidechain":true,"promptId":"6a5490e7-db98-4c8e-ab2a-d6269cfe62dd","agentId":"afb1dbcc97469a738","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01MDnvCTbGbyx9bgJAGakM2U","type":"tool_result","content":"1\t\"\"\"Assembles the Job page: one case per shop visit, aligning driver input,\n2\tmechanic input, test results and malfunctions into one logical flow.\n3\t\n4\tThis is the only module that imports :mod:`mes.jobs` directly, same posture\n5\tas every other ``*_bridge.py`` here. ``build_job_view`` is the single entry\n6\tpoint: it resolves which job is \"current\" for a VIN, then gathers real\n7\tevidence already sitting in the other bridges (the dossier's verdict and\n8\topen-work, the mechanic-vs-driver timeline's symptoms, technician notes,\n9\tmedia and feedback counts, dealer results, electrical inspections, systems\n10\tcorrelation chains) into one shape the template renders, plus a short list\n11\tof *suggested* hypotheses pre-filled with real evidence_for/against refs --\n12\tnever an invented one. Writing (opening a job, adding a hypothesis/action,\n13\tattaching evidence, closing) is thin pass-through to :mod:`mes.jobs`, which\n14\tdoes the validation.\n15\t\"\"\"\n16\t\n17\tfrom __future__ import annotations\n18\t\n19\timport re\n20\tfrom typing import Any, Optional\n21\t\n22\t#: Stopwords stripped before token-overlap similarity (``similar_existing``,\n23\t#: JOB_UX_FIXES_2026-10-08.md #11) -- short connective words that would\n24\t#: otherwise inflate the overlap between two otherwise-unrelated hypotheses.\n25\t_STOPWORDS = {\"the\", \"a\", \"an\", \"of\", \"to\", \"and\", \"or\", \"in\", \"on\", \"at\",\n26\t             \"for\", \"with\", \"is\", \"that\", \"this\", \"it\", \"its\"}\n27\t\n28\tfrom .. import bootstrap  # noqa: F401  -- side effect: puts `mes` on sys.path\n29\tfrom . import cache, dossier_bridge, mes_bridge, timeline_bridge, tools_kb_bridge\n30\tfrom .errors import BadRequest, NotFound\n31\t\n32\tfrom mes import jobs as jobs_mod  # noqa: E402\n33\tfrom mes import tools_kb  # noqa: E402\n34\tfrom mes.jobs import RuleViolation  # noqa: E402 -- re-exported for cuore.api.jobs\n35\t\n36\ttry:\n37\t    from . import electrical_bridge\n38\texcept Exception:  # noqa: BLE001 -- the job page must render without it\n39\t    electrical_bridge = None\n40\t\n41\ttry:\n42\t    from . import systems_bridge\n43\texcept Exception:  # noqa: BLE001\n44\t    systems_bridge = None\n45\t\n46\ttry:\n47\t    from . import media_bridge\n48\texcept Exception:  # noqa: BLE001\n49\t    media_bridge = None\n50\t\n51\ttry:\n52\t    from . import feedback_bridge\n53\texcept Exception:  # noqa: BLE001\n54\t    feedback_bridge = None\n55\t\n56\ttry:\n57\t    from mes import shop as shop_mod\n58\texcept Exception:  # noqa: BLE001 -- the job page must still render\n59\t    shop_mod = None\n60\t\n61\ttry:\n62\t    from mes import systems as systems_mod\n63\texcept Exception:  # noqa: BLE001 -- the job page must still render\n64\t    systems_mod = None\n65\t\n66\t\n67\tdef _sys_key(text: Optional[str]) -> str:\n68\t    \"\"\"A hypothesis/suggestion/open-work-card ``system``/``family`` string,\n69\t    resolved to its canonical ``mes.systems`` key wherever that module\n70\t    recognises it (``mes.systems.normalize_system`` -- the single shared\n71\t    taxonomy, see mes.systems' own module docstring), else just lowered/\n72\t    stripped so two spellings of the same unrecognised string still\n73\t    compare equal. Never raises -- a knowledge-table issue here must not\n74\t    break the job page.\"\"\"\n75\t    text = (text or \"\").strip()\n76\t    if not text:\n77\t        return \"\"\n78\t    if systems_mod is not None:\n79\t        try:\n80\t            norm = systems_mod.normalize_system(text)\n81\t        except Exception:  # noqa: BLE001\n82\t            norm = None\n83\t        if norm:\n84\t            return norm\n85\t    return text.lower()\n86\t\n87\t\n88\t# --- small ref builders -------------------------------------------------\n89\t\n90\t\n91\tdef _ref(kind: str, id_: Any, label: str) -> dict[str, Any]:\n92\t    return {\"kind\": kind, \"id\": id_, \"label\": label}\n93\t\n94\t\n95\t# --- suggested hypotheses, built only from real data ---------------------\n96\t\n97\t\n98\tdef _evap_suggestions(vin: str, view: dict[str, Any]) -> list[dict[str, Any]]:\n99\t    \"\"\"The two EVAP hypotheses this corpus's own fault tree/bulletins\n100\t    distinguish: a signal-path fault at the ESIM, vs. an ECM calibration\n101\t    issue the TSBs describe. Only offered when the dossier's open-work\n102\t    already names an EVAP family card -- no family, no suggestion.\"\"\"\n103\t    evap_card = next((c for c in view.get(\"open_work\", []) if c.get(\"family\") == \"EVAP\"), None)\n104\t    if evap_card is None:\n105\t        return []\n106\t\n107\t    freeze_frames = view.get(\"freeze_frames\", [])\n108\t    attempted = view.get(\"attempted\", [])\n109\t    bulletins = view.get(\"bulletins\", [])\n110\t\n111\t    fuel_flag_evidence = [\n112\t        _ref(\"freeze_frame\", f[\"code\"], f\"{f['code']} freeze frame: {k['flag']}\")\n113\t        for f in freeze_frames for k in f.get(\"key\", []) if k.get(\"flag\")\n114\t    ]\n115\t    esim_step = next((s for s in evap_card.get(\"steps\", []) if s[\"id\"] == \"evap-4\"), None)\n116\t    esim_evidence_for = list(fuel_flag_evidence)\n117\t    if esim_step is not None and esim_step.get(\"done\"):\n118\t        esim_evidence_for.append(_ref(\"inspection\", \"evap-4\",\n119\t                                      \"ESIM/canister inspection logged done\"))\n120\t    actuator_evidence = [\n121\t        _ref(\"actuator\", a[\"operation\"],\n122\t             f\"{a['operation']}: {a['outcome']} x{a['count']}\")\n123\t        for a in attempted if \"evapor\" in (a.get(\"operation\") or \"\").lower()\n124\t    ]\n125\t    esim_evidence_for += actuator_evidence\n126\t\n127\t    calibration_bulletins = [b for b in bulletins\n128\t                             if \"calib\" in (b.get(\"title\") or \"\").lower()\n129\t                             or \"calib\" in (b.get(\"action\") or \"\").lower()]\n130\t    calib_evidence_for = [\n131\t        _ref(\"bulletin\", b[\"id\"], f\"{b['id']}: {b['title']}\") for b in calibration_bulletins\n132\t    ]\n133\t    dealer_results = mes_bridge.dealer_results(vin).get(\"results\", [])\n134\t    slvt = [r for r in dealer_results if r.get(\"kind\") == \"slvt\"]\n135\t    calib_evidence_for += [\n136\t        _ref(\"dealer\", r.get(\"at\"), f\"SLVT {r['data'].get('result')}: {r['data'].get('detail') or ''}\".strip(\": \"))\n137\t        for r in slvt if (r.get(\"data\") or {}).get(\"result\") == \"fail\"\n138\t    ]\n139\t    calib_evidence_against = [\n140\t        _ref(\"dealer\", r.get(\"at\"), f\"SLVT {r['data'].get('result')}: {r['data'].get('detail') or ''}\".strip(\": \"))\n141\t        for r in slvt if (r.get(\"data\") or {}).get(\"result\") == \"pass\"\n142\t    ]\n143\t\n144\t    history = view.get(\"codes\", [])\n145\t    returned = [r for r in history if r.get(\"bucket\") == \"returned_after_clear\"]\n146\t    returned_evidence = [\n147\t        _ref(\"code\", r[\"code\"], f\"{r['code']} returned after clear ({r.get('last_seen_short')})\")\n148\t        for r in returned\n149\t    ]\n150\t\n151\t    out = [\n152\t        {\"text\": \"EVAP: ESIM signal path\", \"system\": \"EVAP\",\n153\t         \"evidence_for\": esim_evidence_for, \"evidence_against\": [],\n154\t         \"next_test\": \"Smoke test the recirculation line and canister/ESIM \"\n155\t                      \"connector under light vacuum.\"},\n156\t        {\"text\": \"EVAP: ECM calibration\", \"system\": \"EVAP\",\n157\t         \"evidence_for\": calib_evidence_for + returned_evidence,\n158\t         \"evidence_against\": calib_evidence_against,\n159\t         \"next_test\": \"Check PCM calibration level against the latest EVAP \"\n160\t                      \"TSB before condemning hardware (SLVT or Mode $06).\"},\n161\t    ]\n162\t    return out\n163\t\n164\t\n165\tdef _network_suggestions(view: dict[str, Any]) -> list[dict[str, Any]]:\n166\t    net_card = next((c for c in view.get(\"open_work\", []) if c.get(\"family\") == \"network\"\n167\t                     or c.get(\"family\") == \"NETWORK\"), None)\n168\t    if net_card is None:\n169\t        return []\n170\t    refs = [_ref(\"bulletin\", r[\"label\"], r[\"label\"]) for r in net_card.get(\"refs\", []) if r.get(\"label\")]\n171\t    return [{\"text\": \"Network: power/ground or bus event\", \"system\": \"network\",\n172\t            \"evidence_for\": refs, \"evidence_against\": [],\n173\t            \"next_test\": \"Check F82 fuse/BCM supply and the connectors/grounds \"\n174\t                         \"this fault tree cites before chasing individual codes.\"}]\n175\t\n176\t\n177\t#: EVAP and network each got a hand-written hypothesis builder above,\n178\t#: because they're this app's first, richest examples. Every other family\n179\t#: dossier_bridge's generic open-work builder can produce (misfire,\n180\t#: fuel_trim, cooling, body, chassis, adas, etc.) still deserves a\n181\t#: hypothesis per code -- built the same way, from real evidence, just\n182\t#: without a bespoke pair of ESIM/calibration-style hypotheses hand-written\n183\t#: for it. Skipped here so the two curated builders above keep owning their\n184\t#: own families rather than being duplicated.\n185\t_CURATED_FAMILIES = {\"EVAP\", \"network\"}\n186\t\n187\t\n188\tdef _hypothesis_for_code(family: str, code: str,\n189\t                         steps: list[dict[str, Any]]) -> tuple[str, str]:\n190\t    \"\"\"``(hypothesis text, next_test)`` for one code, built only from the\n191\t    real steps its own generated fault tree already produced -- see\n192\t    ``dossier_bridge._generic_tree_steps`` (``mes.faulttree.tree_for``).\n193\t    Never invents a branch beyond re-labelling a real step's own text.\"\"\"\n194\t    swap_step = next(\n195\t        (s for s in steps if \"swap\" in (s.get(\"text\") or \"\").lower()), None)\n196\t    if family == \"misfire\":\n197\t        m = re.match(r\"^P030([1-4])$\", code)\n198\t        cyl = f\" cylinder {m.group(1)}\" if m else \"\"\n199\t        text = f\"{code}: coil or plug{cyl} (swap test)\"\n200\t        next_test = swap_step[\"text\"] if swap_step else (\n201\t            steps[0][\"text\"] if steps else \"\")\n202\t        return text, next_test\n203\t    lead = swap_step or (steps[0] if steps else None)\n204\t    if lead is None:\n205\t        return f\"{code}: {family} fault\", \"\"\n206\t    short = (lead[\"text\"].split(\":\", 1)[0] if \":\" in lead[\"text\"]\n207\t             else lead[\"text\"])\n208\t    return f\"{code}: {short}\", lead[\"text\"]\n209\t\n210\t\n211\tdef _generic_family_suggestions(vin: str, view: dict[str, Any]\n212\t                                ) -> list[dict[str, Any]]:\n213\t    \"\"\"One hypothesis per code for every open-work family dossier_bridge\n214\t    generated generically (i.e. everything that isn't EVAP/network), each\n215\t    pre-filled with real evidence: freeze frames and returned-after-clear\n216\t    history for that exact code, logged-done steps from the same card, and\n217\t    any bulletin that names the code -- the same evidence_for/against\n218\t    discipline as the EVAP/network builders, just applied to whichever\n219\t    family this car's own history actually has open.\"\"\"\n220\t    freeze_frames = view.get(\"freeze_frames\", [])\n221\t    codes_hist = view.get(\"codes\", [])\n222\t    bulletins = view.get(\"bulletins\", [])\n223\t    out: list[dict[str, Any]] = []\n224\t    for card in view.get(\"open_work\", []):\n225\t        family = card.get(\"family\") or \"\"\n226\t        if family in _CURATED_FAMILIES or not card.get(\"generic\"):\n227\t            continue\n228\t        steps = card.get(\"steps\", [])\n229\t        done_steps = [s for s in steps if s.get(\"done\")]\n230\t        for code in card.get(\"codes\", []):\n231\t            evidence_for = [\n232\t                _ref(\"freeze_frame\", f[\"code\"], f\"{f['code']} freeze frame\")\n233\t                for f in freeze_frames if f.get(\"code\", \"\").startswith(code)\n234\t            ]\n235\t            evidence_for += [\n236\t                _ref(\"inspection\", s[\"id\"], f\"{s['text']} -- logged done\")\n237\t                for s in done_steps\n238\t            ]\n239\t            evidence_for += [\n240\t                _ref(\"bulletin\", b[\"id\"], f\"{b['id']}: {b.get('title', '')}\")\n241\t                for b in bulletins if code in (b.get(\"codes\") or [])\n242\t            ]\n243\t            evidence_for += [\n244\t                _ref(\"code\", r[\"code\"],\n245\t                     f\"{r['code']} returned after clear ({r.get('last_seen_short')})\")\n246\t                for r in codes_hist\n247\t                if r.get(\"code\") == code and r.get(\"bucket\") == \"returned_after_clear\"\n248\t            ]\n249\t            text, next_test = _hypothesis_for_code(family, code, steps)\n250\t            out.append({\"text\": text, \"system\": family,\n251\t                       \"evidence_for\": evidence_for, \"evidence_against\": [],\n252\t                       \"next_test\": next_test})\n253\t    return out\n254\t\n255\t\n256\tdef suggested_hypotheses(vin: str, view: dict[str, Any]) -> list[dict[str, Any]]:\n257\t    \"\"\"Hypotheses this car's own fault tree/bulletins already point at, each\n258\t    pre-filled with real evidence_for/against refs -- never invented. The\n259\t    mechanic adds whichever apply via the job page's form; nothing here\n260\t    writes anything."}]},"uuid":"63b976b3-b638-4f5b-9f9b-9977406af64b","timestamp":"2026-10-14T00:23:15.890Z","toolUseResult":{"type":"text","file":{"filePath":"C:\\Users\\User\\mcp-servers\\cuore\\services\\jobs_bridge.py","content":"\"\"\"Assembles the Job page: one case per shop visit, aligning driver input,\nmechanic input, test results and malfunctions into one logical flow.\n\nThis is the only module that imports :mod:`mes.jobs` directly, same posture\nas every other ``*_bridge.py`` here. ``build_job_view`` is the single entry\npoint: it resolves which job is \"current\" for a VIN, then gathers real\nevidence already sitting in the other bridges (the dossier's verdict and\nopen-work, the mechanic-vs-driver timeline's symptoms, technician notes,\nmedia and feedback counts, dealer results, electrical inspections, systems\ncorrelation chains) into one shape the template renders, plus a short list\nof *suggested* hypotheses pre-filled with real evidence_for/against refs --\nnever an invented one. Writing (opening a job, adding a hypothesis/action,\nattaching evidence, closing) is thin pass-through to :mod:`mes.jobs`, which\ndoes the validation.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport re\nfrom typing import Any, Optional\n\n#: Stopwords stripped before token-overlap similarity (``similar_existing``,\n#: JOB_UX_FIXES_2026-10-08.md #11) -- short connective words that would\n#: otherwise inflate the overlap between two otherwise-unrelated hypotheses.\n_STOPWORDS = {\"the\", \"a\", \"an\", \"of\", \"to\", \"and\", \"or\", \"in\", \"on\", \"at\",\n             \"for\", \"with\", \"is\", \"that\", \"this\", \"it\", \"its\"}\n\nfrom .. import bootstrap  # noqa: F401  -- side effect: puts `mes` on sys.path\nfrom . import cache, dossier_bridge, mes_bridge, timeline_bridge, tools_kb_bridge\nfrom .errors import BadRequest, NotFound\n\nfrom mes import jobs as jobs_mod  # noqa: E402\nfrom mes import tools_kb  # noqa: E402\nfrom mes.jobs import RuleViolation  # noqa: E402 -- re-exported for cuore.api.jobs\n\ntry:\n    from . import electrical_bridge\nexcept Exception:  # noqa: BLE001 -- the job page must render without it\n    electrical_bridge = None\n\ntry:\n    from . import systems_bridge\nexcept Exception:  # noqa: BLE001\n    systems_bridge = None\n\ntry:\n    from . import media_bridge\nexcept Exception:  # noqa: BLE001\n    media_bridge = None\n\ntry:\n    from . import feedback_bridge\nexcept Exception:  # noqa: BLE001\n    feedback_bridge = None\n\ntry:\n    from mes import shop as shop_mod\nexcept Exception:  # noqa: BLE001 -- the job page must still render\n    shop_mod = None\n\ntry:\n    from mes import systems as systems_mod\nexcept Exception:  # noqa: BLE001 -- the job page must still render\n    systems_mod = None\n\n\ndef _sys_key(text: Optional[str]) -> str:\n    \"\"\"A hypothesis/suggestion/open-work-card ``system``/``family`` string,\n    resolved to its canonical ``mes.systems`` key wherever that module\n    recognises it (``mes.systems.normalize_system`` -- the single shared\n    taxonomy, see mes.systems' own module docstring), else just lowered/\n    stripped so two spellings of the same unrecognised string still\n    compare equal. Never raises -- a knowledge-table issue here must not\n    break the job page.\"\"\"\n    text = (text or \"\").strip()\n    if not text:\n        return \"\"\n    if systems_mod is not None:\n        try:\n            norm = systems_mod.normalize_system(text)\n        except Exception:  # noqa: BLE001\n            norm = None\n        if norm:\n            return norm\n    return text.lower()\n\n\n# --- small ref builders -------------------------------------------------\n\n\ndef _ref(kind: str, id_: Any, label: str) -> dict[str, Any]:\n    return {\"kind\": kind, \"id\": id_, \"label\": label}\n\n\n# --- suggested hypotheses, built only from real data ---------------------\n\n\ndef _evap_suggestions(vin: str, view: dict[str, Any]) -> list[dict[str, Any]]:\n    \"\"\"The two EVAP hypotheses this corpus's own fault tree/bulletins\n    distinguish: a signal-path fault at the ESIM, vs. an ECM calibration\n    issue the TSBs describe. Only offered when the dossier's open-work\n    already names an EVAP family card -- no family, no suggestion.\"\"\"\n    evap_card = next((c for c in view.get(\"open_work\", []) if c.get(\"family\") == \"EVAP\"), None)\n    if evap_card is None:\n        return []\n\n    freeze_frames = view.get(\"freeze_frames\", [])\n    attempted = view.get(\"attempted\", [])\n    bulletins = view.get(\"bulletins\", [])\n\n    fuel_flag_evidence = [\n        _ref(\"freeze_frame\", f[\"code\"], f\"{f['code']} freeze frame: {k['flag']}\")\n        for f in freeze_frames for k in f.get(\"key\", []) if k.get(\"flag\")\n    ]\n    esim_step = next((s for s in evap_card.get(\"steps\", []) if s[\"id\"] == \"evap-4\"), None)\n    esim_evidence_for = list(fuel_flag_evidence)\n    if esim_step is not None and esim_step.get(\"done\"):\n        esim_evidence_for.append(_ref(\"inspection\", \"evap-4\",\n                                      \"ESIM/canister inspection logged done\"))\n    actuator_evidence = [\n        _ref(\"actuator\", a[\"operation\"],\n             f\"{a['operation']}: {a['outcome']} x{a['count']}\")\n        for a in attempted if \"evapor\" in (a.get(\"operation\") or \"\").lower()\n    ]\n    esim_evidence_for += actuator_evidence\n\n    calibration_bulletins = [b for b in bulletins\n                             if \"calib\" in (b.get(\"title\") or \"\").lower()\n                             or \"calib\" in (b.get(\"action\") or \"\").lower()]\n    calib_evidence_for = [\n        _ref(\"bulletin\", b[\"id\"], f\"{b['id']}: {b['title']}\") for b in calibration_bulletins\n    ]\n    dealer_results = mes_bridge.dealer_results(vin).get(\"results\", [])\n    slvt = [r for r in dealer_results if r.get(\"kind\") == \"slvt\"]\n    calib_evidence_for += [\n        _ref(\"dealer\", r.get(\"at\"), f\"SLVT {r['data'].get('result')}: {r['data'].get('detail') or ''}\".strip(\": \"))\n        for r in slvt if (r.get(\"data\") or {}).get(\"result\") == \"fail\"\n    ]\n    calib_evidence_against = [\n        _ref(\"dealer\", r.get(\"at\"), f\"SLVT {r['data'].get('result')}: {r['data'].get('detail') or ''}\".strip(\": \"))\n        for r in slvt if (r.get(\"data\") or {}).get(\"result\") == \"pass\"\n    ]\n\n    history = view.get(\"codes\", [])\n    returned = [r for r in history if r.get(\"bucket\") == \"returned_after_clear\"]\n    returned_evidence = [\n        _ref(\"code\", r[\"code\"], f\"{r['code']} returned after clear ({r.get('last_seen_short')})\")\n        for r in returned\n    ]\n\n    out = [\n        {\"text\": \"EVAP: ESIM signal path\", \"system\": \"EVAP\",\n         \"evidence_for\": esim_evidence_for, \"evidence_against\": [],\n         \"next_test\": \"Smoke test the recirculation line and canister/ESIM \"\n                      \"connector under light vacuum.\"},\n        {\"text\": \"EVAP: ECM calibration\", \"system\": \"EVAP\",\n         \"evidence_for\": calib_evidence_for + returned_evidence,\n         \"evidence_against\": calib_evidence_against,\n         \"next_test\": \"Check PCM calibration level against the latest EVAP \"\n                      \"TSB before condemning hardware (SLVT or Mode $06).\"},\n    ]\n    return out\n\n\ndef _network_suggestions(view: dict[str, Any]) -> list[dict[str, Any]]:\n    net_card = next((c for c in view.get(\"open_work\", []) if c.get(\"family\") == \"network\"\n                     or c.get(\"family\") == \"NETWORK\"), None)\n    if net_card is None:\n        return []\n    refs = [_ref(\"bulletin\", r[\"label\"], r[\"label\"]) for r in net_card.get(\"refs\", []) if r.get(\"label\")]\n    return [{\"text\": \"Network: power/ground or bus event\", \"system\": \"network\",\n            \"evidence_for\": refs, \"evidence_against\": [],\n            \"next_test\": \"Check F82 fuse/BCM supply and the connectors/grounds \"\n                         \"this fault tree cites before chasing individual codes.\"}]\n\n\n#: EVAP and network each got a hand-written hypothesis builder above,\n#: because they're this app's first, richest examples. Every other family\n#: dossier_bridge's generic open-work builder can produce (misfire,\n#: fuel_trim, cooling, body, chassis, adas, etc.) still deserves a\n#: hypothesis per code -- built the same way, from real evidence, just\n#: without a bespoke pair of ESIM/calibration-style hypotheses hand-written\n#: for it. Skipped here so the two curated builders above keep owning their\n#: own families rather than being duplicated.\n_CURATED_FAMILIES = {\"EVAP\", \"network\"}\n\n\ndef _hypothesis_for_code(family: str, code: str,\n                         steps: list[dict[str, Any]]) -> tuple[str, str]:\n    \"\"\"``(hypothesis text, next_test)`` for one code, built only from the\n    real steps its own generated fault tree already produced -- see\n    ``dossier_bridge._generic_tree_steps`` (``mes.faulttree.tree_for``).\n    Never invents a branch beyond re-labelling a real step's own text.\"\"\"\n    swap_step = next(\n        (s for s in steps if \"swap\" in (s.get(\"text\") or \"\").lower()), None)\n    if family == \"misfire\":\n        m = re.match(r\"^P030([1-4])$\", code)\n        cyl = f\" cylinder {m.group(1)}\" if m else \"\"\n        text = f\"{code}: coil or plug{cyl} (swap test)\"\n        next_test = swap_step[\"text\"] if swap_step else (\n            steps[0][\"text\"] if steps else \"\")\n        return text, next_test\n    lead = swap_step or (steps[0] if steps else None)\n    if lead is None:\n        return f\"{code}: {family} fault\", \"\"\n    short = (lead[\"text\"].split(\":\", 1)[0] if \":\" in lead[\"text\"]\n             else lead[\"text\"])\n    return f\"{code}: {short}\", lead[\"text\"]\n\n\ndef _generic_family_suggestions(vin: str, view: dict[str, Any]\n                                ) -> list[dict[str, Any]]:\n    \"\"\"One hypothesis per code for every open-work family dossier_bridge\n    generated generically (i.e. everything that isn't EVAP/network), each\n    pre-filled with real evidence: freeze frames and returned-after-clear\n    history for that exact code, logged-done steps from the same card, and\n    any bulletin that names the code -- the same evidence_for/against\n    discipline as the EVAP/network builders, just applied to whichever\n    family this car's own history actually has open.\"\"\"\n    freeze_frames = view.get(\"freeze_frames\", [])\n    codes_hist = view.get(\"codes\", [])\n    bulletins = view.get(\"bulletins\", [])\n    out: list[dict[str, Any]] = []\n    for card in view.get(\"open_work\", []):\n        family = card.get(\"family\") or \"\"\n        if family in _CURATED_FAMILIES or not card.get(\"generic\"):\n            continue\n        steps = card.get(\"steps\", [])\n        done_steps = [s for s in steps if s.get(\"done\")]\n        for code in card.get(\"codes\", []):\n            evidence_for = [\n                _ref(\"freeze_frame\", f[\"code\"], f\"{f['code']} freeze frame\")\n                for f in freeze_frames if f.get(\"code\", \"\").startswith(code)\n            ]\n            evidence_for += [\n                _ref(\"inspection\", s[\"id\"], f\"{s['text']} -- logged done\")\n                for s in done_steps\n            ]\n            evidence_for += [\n                _ref(\"bulletin\", b[\"id\"], f\"{b['id']}: {b.get('title', '')}\")\n                for b in bulletins if code in (b.get(\"codes\") or [])\n            ]\n            evidence_for += [\n                _ref(\"code\", r[\"code\"],\n                     f\"{r['code']} returned after clear ({r.get('last_seen_short')})\")\n                for r in codes_hist\n                if r.get(\"code\") == code and r.get(\"bucket\") == \"returned_after_clear\"\n            ]\n            text, next_test = _hypothesis_for_code(family, code, steps)\n            out.append({\"text\": text, \"system\": family,\n                       \"evidence_for\": evidence_for, \"evidence_against\": [],\n                       \"next_test\": next_test})\n    return out\n\n\ndef suggested_hypotheses(vin: str, view: dict[str, Any]) -> list[dict[str, Any]]:\n    \"\"\"Hypotheses this car's own fault tree/bulletins already point at, each\n    pre-filled with real evidence_for/against refs -- never invented. The\n    mechanic adds whichever apply via the job page's form; nothing here\n    writes anything.","numLines":260,"startLine":1,"totalLines":895}},"sourceToolAssistantUUID":"6014c3d1-8148-41d2-bc63-8675d38c6213","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
