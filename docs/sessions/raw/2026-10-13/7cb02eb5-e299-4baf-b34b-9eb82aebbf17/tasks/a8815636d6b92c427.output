lUseResult":{"stdout":"__init__.py\n__pycache__\ndashboard_charts.py\ndashboard_routes.py\ndossier_routes.py\ndrivetrain_routes.py\nexperience_globals.py\ninbox_routes.py\nlabels_routes.py\nlive_dashboard_routes.py\nmedia_routes.py\nparts_routes.py\nreport_pdf.py\nreport_routes.py\nroutes.py\nservice_routes.py\nstatic\ntemplates\ntimeline_routes.py\ntimeline_svg.py\ntools_routes.py\n---\n_experience.html\n_feedback_panel.html\n_media_attach.html\n_notes.html\n_part_card.html\n_symptom_form.html\n_vbar.html\nbase.html\nbrakes_tires.html\ncode.html\ncodes.html\ncoverage.html\ndashboard.html\ndealer.html\ndrivetrain_section.html\nerror.html\ngate.html\ninbox.html\nindex.html\nlabels.html\nlive.html\nlive_dashboard.html\nlive_module.html\nlive_vs_log.html\nlogs.html\nmaintenance.html\nmedia.html\nmodules.html\nnotes.html\noil_change.html\nparts.html\nrecording.html\nrecordings.html\nreport.html\nservice.html\nservice_hub.html\ntimeline.html\ntools.html\ntorque.html\ntree.html\nvehicle.html\nverify.html\n---\n__pycache__\n_edge_cleanup.py\ncheck_actuate.py\ncheck_api.py\ncheck_clear.py\ncheck_coverage.py\ncheck_dashboard_page.py\ncheck_dealer_page.py\ncheck_detail.py\ncheck_dossier_page.py\ncheck_dossier_view.py\ncheck_drivetrain_page.py\ncheck_dtc_detail.py\ncheck_experience_page.py\ncheck_feedback.py\ncheck_feedback_page.py\ncheck_labels.py\ncheck_learn.py\ncheck_live.py\ncheck_live_dashboard_page.py\ncheck_live_data.py\ncheck_live_ui_api.py\ncheck_live_vs_log.py\ncheck_live_widgets.py\ncheck_maintenance_page.py\ncheck_media.py\ncheck_media_page.py\ncheck_mode06.py\ncheck_notes_page.py\ncheck_parts_page.py","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"serverClassifierContext":{"request":"56f53923-5ceb-4769-8249-3e13316837c4","context":{"git_state":{"cwd":"/c/Users/User/mcp-servers","root":null,"branch":null,"default_branch":null,"status":null,"visibility":null,"error":"pending"},"live_cwd":"/c/Users/User/mcp-servers","platform":"windows"}}