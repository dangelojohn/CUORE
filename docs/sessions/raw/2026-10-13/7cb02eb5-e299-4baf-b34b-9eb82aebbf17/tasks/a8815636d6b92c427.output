hat would the driver feel?</h3>\n  {% if cf.feel %}\n    <p class=\"feel-sentence\" id=\"fb-feel-{{ code }}\" data-fact=\"feel|{{ code }}\">{{ cf.feel.feel }}</p>\n    {% if cf.feel.expect or cf.feel.not_expected %}\n    <div class=\"feel-tags\">\n      {% for x in cf.feel.expect %}<span class=\"chip expect\">{{ x }}</span>{% endfor %}\n      {% for x in cf.feel.not_expected %}<span class=\"chip not-expect\">{{ x }}</span>{% endfor %}\n    </div>\n    {% endif %}\n    {% if cf.feel.mil %}<p class=\"small\">MIL: {{ cf.feel.mil }}</p>{% endif %}\n    {% if cf.feel.notes %}<p class=\"small muted\">{{ cf.feel.notes }}</p>{% endif %}\n    <p class=\"small muted\">Confidence: {{ cf.feel.confidence }}\n      {% if cf.feel.source %} &middot; source: <span class=\"mono\">{{ cf.feel.source }}</span>{% endif %}</p>\n  {% else %}\n    <p class=\"muted\">Not in the knowledge table: use the service manual (TechAuthority).</p>\n  {% endif %}\n  {% if cf.pattern %}\n    <p class=\"small muted\">This car: {{ cf.pattern.occurrences }} occurrence(s),\n      {{ cf.pattern.symptom_reports_near }} symptom report(s) nearby\n      {% if cf.pattern.drives_normally_near %}, {{ cf.pattern.drives_normally_near }} \"drives normally\" report(s) nearby{% endif %}.</p>\n  {% endif %}\n</div>\n\n{# Family is not in this page's own context -- derived from the code's own\n   prefix, the same coarse grouping cuore.services.timeline_bridge's fixture\n   families use (EVAP, network, body, chassis, misfire). Approximate on\n   purpose: it only widens the experience-link search, never narrows what\n   this page reports about the code itself. #}\n{% set _c = code|upper %}\n{% if _c.startswith(\"P04\") %}{% set _family = \"EVAP\" %}\n{% elif _c.startswith(\"P03\") %}{% set _family = \"misfire\" %}\n{% elif _c.startswith(\"U0\") %}{% set _family = \"network\" %}\n{% elif _c.startswith(\"B\") %}{% set _family = \"body\" %}\n{% elif _c.startswith(\"C\") %}{% set _family = \"chassis\" %}\n{% else %}{% set _family = None %}{% endif %}\n{% set exp = experience_links(code=code, family=_family) if experience_links is defined else {\"links\": [], \"count\": 0} %}\n{% include \"_experience.html\" %}\n\n{# parts_for is a Jinja global registered by cuore/web/parts_routes.py as a\n   side effect of importing it (see that module's docstring) -- guarded here\n   so this page still renders before app.py wires that router in. #}\n{% set _code_parts = parts_for(code=code) if parts_for is defined else [] %}\n{% if _code_parts %}\n<h2>Parts for {{ code }}</h2>\n{% for part in _code_parts %}\n  {% set p = part %}\n  {% set compact = True %}\n  {% include \"_part_card.html\" %}\n{% endfor %}\n{% endif %}\n\n{% for r in records %}\n<div class=\"panel\">\n  <h3>{{ r.dtc }}\n    <span class=\"chip {{ r.severity }}\">{{ r.severity }}</span></h3>\n  {% if r.descriptions %}\n  <p class=\"lede\">{{ r.descriptions|join(\", \") }}</p>\n  {% elif r.mes_description %}\n  <p class=\"lede\">{{ r.mes_description.text }}\n    <span class=\"chip plain\">{{ r.mes_description.source }}</span></p>\n  {% endif %}\n\n  <div class=\"tw\">\n  <table>\n    <tr><td class=\"k\">Module</td><td>{{ r.modules|join(\", \") }}</td></tr>\n    <tr><td class=\"k\">Sessions</td><td class=\"n\">{{ r.sessions }}</td></tr>\n    <tr><td class=\"k\">First seen</td><td class=\"mono\">{{ r.first_seen }}</td></tr>\n    <tr><td class=\"k\">Last seen</td><td class=\"mono\">{{ r.last_seen }}</td></tr>\n    {% if r.odometer_first_km is defined and r.odometer_first_km is not none %}\n    <tr><td class=\"k\">Odometer</td>\n        <td class=\"mono\">{{ \"{:,}\".format(r.odometer_first_km|int) }} &rarr;\n            {{ \"{:,}\".format(r.odometer_last_km|int) }} km\n            {% if r.distance_span_km %}\n              <b>({{ \"{:,}\".format(r.distance_span_km|int) }} km span)</b>\n            {% endif %}</td></tr>\n    {% endif %}\n    <tr><td class=\"k\">Statuses seen</td><td>{{ r.statuses_seen|join(\", \") }}</td></tr>\n    {% if r.assessment %}\n    <tr><td class=\"k\">Assessment</td><td><b>{{ r.assessment }}</b></td></tr>\n    {% endif %}\n  </table>\n  </div>\n\n  <h3>Every occurrence</h3>\n  <div class=\"tw\">\n  <table>\n    <thead><tr><th>When</th><th>Status</th><th class=\"n\">Odometer</th><th>File</th></tr></thead>\n    <tbody>\n    {% for o in r.occurrences %}\n      <tr>\n        <td class=\"mono small\">{{ o.timestamp }}</td>\n        <td><span class=\"chip plain\">{{ o.status }}</span></td>\n        <td class=\"n\">{% if o.odometer_km %}{{ \"{:,.0f}\".format(o.odometer_km) }} km{% else %}—{% endif %}</td>\n        <td class=\"mono small muted\">{{ o.file }}</td>\n      </tr>\n    {% endfor %}\n    </tbody>\n  </table>\n  </div>\n</div>\n{% else %}\n  <div class=\"panel\"><p class=\"muted\">No record of this code in real logs.</p></div>\n{% endfor %}\n\n<h2>Freeze frames</h2>\n{% if frames.count %}\n  <p class=\"lede\">The conditions captured when the code set. <b>A clear destroys\n  this</b>, which is why it is worth reading before offering one.</p>\n  {% for f in frames.frames %}\n    <div class=\"panel tight\">\n      <div style=\"padding:10px 14px\">\n        <h3 style=\"margin:0\" class=\"mono\">{{ f.dtc }}\n          <span class=\"chip plain\">{{ f.status }}</span></h3>\n        <div class=\"small muted\">{{ f.timestamp }} &middot; {{ f.ecu }} &middot;\n          <span class=\"mono\">{{ f.file }}</span></div>\n      </div>\n      <div class=\"tw\">\n      <table>\n        {% for k, v in f.freeze_frame.items() %}\n          <tr><td class=\"k\">{{ k }}</td><td class=\"mono\">{{ v }}</td></tr>\n        {% endfor %}\n      </table>\n      </div>\n    </div>\n  {% endfor %}\n{% else %}\n  <div class=\"panel\"><p class=\"muted\">No freeze frame captured for this code.</p></div>\n{% endif %}\n\n<p><a class=\"btn\" href=\"/v/{{ vin }}/tree?codes={{ code|urlencode }}\">Fault tree for {{ code }} &rarr;</a>\n   <a class=\"btn\" href=\"/v/{{ vin }}/gate?codes={{ code|urlencode }}\">Take it to the gate &rarr;</a></p>\n\n<h2>Log a symptom</h2>\n{% include \"_symptom_form.html\" %}\n\n<h2>Notes on {{ code }}</h2>\n{% include \"_notes.html\" %}\n\n{% endblock %}\n","structuredPatch":[{"oldStart":10,"oldLines":6,"newStart":10,"newLines":8,"lines":[" {% set badges = systems_for_code(code) if systems_for_code is defined else [] %}"," {% include \"_system_badge.html\" %}"," ","+{% include \"_electrical_path.html\" %}","+"," {% set target_kind = \"code\" %}{% set target_id = code %}"," {% include \"_media_attach.html\" %}"," "]}],"userModified":false,"replaceAll":false},"serverClassifierContext":{"request":"479da37b-bae2-4692-bbcc-97f132ad8eea","context":{"git_state":{"cwd":"/c/Users/User/mcp-servers","root":null,"branch":null,"default_branch":null,"status":null,"visibility":null,"error":"pending"},"live_cwd":"/c/Users/User/mcp-servers","platform":"windows"}},"sourceToolAssistantUUID":"374d63e2-9a2e-441d-a0d1-e2b72a8101b6","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
