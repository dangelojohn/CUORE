.location or {}).description }}</div>\n          <div class=\"elec-hop-chips\">\n            <span class=\"chip plain sm\">{{ (hop.location or {}).confidence or hop.confidence }} confidence</span>\n            {% if hop.condition %}\n              <span class=\"chip {{ 'ok' if hop.condition == 'ok' else ('status-active' if hop.condition == 'not_found' else 'status-cleared_unverified') }} sm\">{{ hop.condition|replace(\"_\", \" \") }}</span>\n            {% else %}\n              <span class=\"chip plain sm\">never inspected</span>\n            {% endif %}\n          </div>\n        </div>\n        {% if not loop.last %}<div class=\"elec-hop-arrow\" aria-hidden=\"true\">&rarr;</div>{% endif %}\n      {% endfor %}\n    </div>\n\n    {% if elec.systems_interaction %}\n      <h4 class=\"small\">How each system interacts with this</h4>\n      <ul class=\"small\">\n        {% for s in elec.systems_interaction %}\n          <li><b>{{ s.system }}</b>: {{ s.how }}\n            <span class=\"muted\">[{{ s.confidence }} confidence, source: {{ s.source }}]</span></li>\n        {% endfor %}\n      </ul>\n    {% endif %}\n  {% else %}\n    <p class=\"muted small\">No electrical path known yet for {{ elec.code }}.</p>\n  {% endif %}\n  <p><a class=\"btn\" href=\"{{ elec.layout_href }}\">Open in layout &rarr;</a></p>\n</div>\n{% endif %}\n","structuredPatch":[],"originalFile":null,"userModified":false},"serverClassifierContext":{"request":"e64adbf0-6a11-4756-9c7c-70d4afd2e7d1","context":{"git_state":{"cwd":"/c/Users/User/mcp-servers","root":null,"branch":null,"default_branch":null,"status":null,"visibility":null,"error":"pending"},"live_cwd":"/c/Users/User/mcp-servers","platform":"windows"}},"sourceToolAssistantUUID":"be1413fd-d8b4-4c36-bd49-09e4dc31ed46","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
