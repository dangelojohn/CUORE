d_hypothesis\": {\"en\": \"Add a hypothesis\", \"it\": \"Aggiungi un'ipotesi\"},\ncuore/web/i18n.py:539:    \"add_hypothesis_collapsed\": {\"en\": \"+ Add a hypothesis\", \"it\": \"+ Aggiungi un'ipotesi\"},\ncuore/web/jobs_routes.py:15:engine: ``edit_hypothesis``/``delete_hypothesis``/``undelete_hypothesis``/\ncuore/web/jobs_routes.py:208:        hyp = jobs_bridge.add_hypothesis(job_id, text, system=system, next_test=next_test,\ncuore/web/jobs_routes.py:334:        jobs_bridge.edit_hypothesis(job_id, hyp_id, by=by.strip() or None, **kw)\nmes-log-mcp/server.py:1148:def job_add_hypothesis(job_id: str, text: str, system: str = \"\", next_test: str = \"\",\nmes-log-mcp/server.py:1155:        return jobs_mod.add_hypothesis(job_id, text, system=system, next_test=next_test,\nmes-log-mcp/server.py:1186:def job_edit_hypothesis(job_id: str, hyp_id: str, text: str = \"\", system: str = \"\",\nmes-log-mcp/server.py:1194:        return jobs_mod.edit_hypothesis(job_id, hyp_id, text=text or None, system=system or None,","is_error":false}]},"uuid":"64fe0105-457f-4b3f-86f2-2b92caad1542","timestamp":"2026-10-08T23:51:58.995Z","toolUseResult":{"stdout":"cuore/api/jobs.py:106:def add_hypothesis(job_id: str, body: HypothesisAdd) -> dict[str, Any]:\ncuore/api/jobs.py:107:    return jobs_bridge.add_hypothesis(job_id, body.text, system=body.system,\ncuore/api/jobs.py:136:def edit_hypothesis(job_id: str, hyp_id: str, body: HypothesisEdit) -> dict[str, Any]:\ncuore/api/jobs.py:137:    return jobs_bridge.edit_hypothesis(job_id, hyp_id, text=body.text, system=body.system,\ncuore/services/jobs_bridge.py:569:def add_hypothesis(job_id: str, text: str, *, system: str = \"\",\ncuore/services/jobs_bridge.py:574:        return jobs_mod.add_hypothesis(job_id, text, system=system, next_test=next_test,\ncuore/services/jobs_bridge.py:598:def edit_hypothesis(job_id: str, hyp_id: str, *, text: Optional[str] = None,\ncuore/services/jobs_bridge.py:604:        return jobs_mod.edit_hypothesis(job_id, hyp_id, t