 -- \"at\" is set only when one exists, so this is also the","+    # \"was this reading actually taken from the car\" check a demo/replay","+    # source can never satisfy.","+    readiness_from_car = bool(panel.get(\"at\"))","+    panel_monitors = {m.get(\"name\"): bool(m.get(\"complete\"))","+                      for m in (panel.get(\"monitors\") or []) if m.get(\"name\")}","+","     out: dict[str, dict[str, Any]] = {}","     for key in all_systems:","         row = by_system.get(key) or {}"]},{"oldStart":179,"oldLines":7,"newStart":192,"newLines":12,"lines":["         if \"ACTIVE\" in statuses:","             state = \"ACTIVE\"","         elif \"CLEARED_UNVERIFIED\" in statuses:","-            state = \"VERIFIED_CLEAN\" if verdict_state == \"VERIFIED_CLEAN\" else \"CLEARED_UNVERIFIED\"","+            state = \"CLEARED_UNVERIFIED\"","+            if readiness_from_car:","+                monitor_names = systems_mod.monitors_for_system(key)","+                seen = [panel_monitors[n] for n in monitor_names if n in panel_monitors]","+                if seen and all(seen):","+                    state = \"VERIFIED_CLEAN\"","         elif \"STALE\" in statuses:","             state = \"STALE\"","         else:"]}],"userModified":false,"replaceAll":false},"serverClassifierContext":{"request":"a8bacd5d-5976-4c8d-9b56-125d9c9ab470","context":{"git_state":{"cwd":"/c/Users/User/mcp-servers","root":null,"branch":null,"default_branch":null,"status":null,"visibility":null,"error":"pending"},"live_cwd":"/c/Users/User/mcp-servers","platform":"windows"}},"sourceToolAssistantUUID":"73265b00-9a84-47a1-b744-3465c3501693","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
