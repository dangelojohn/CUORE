n634:    \"security_immobiliser\": _system(\n672:    \"infotainment_cluster\": _system(\n709:    \"lighting\": _system(\n730:    \"wheels_tpms\": _system(\n752:    \"restraints\": _system(","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"sourceToolAssistantUUID":"771cea63-c688-4854-b771-777a893d39f3","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
