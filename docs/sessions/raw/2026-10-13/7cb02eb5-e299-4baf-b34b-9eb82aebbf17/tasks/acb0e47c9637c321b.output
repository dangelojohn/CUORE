{"parentUuid":"4418b641-0576-4d01-8c64-c125c003c54c","isSidechain":true,"agentId":"acb0e47c9637c321b","message":{"model":"claude-sonnet-5","id":"msg_011CfqfKvqyyxdUz8f1ULLEN","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01EwYJxckLh1ijahAECikWiY","name":"Read","input":{"file_path":"C:\\Users\\User\\mcp-servers\\cuore\\services\\jobs_bridge.py","offset":60,"limit":340},"caller":{"type":"direct"}}],"container":null,"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1755,"cache_read_input_tokens":116927,"output_tokens":121,"output_tokens_details":{"thinking_tokens":0},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":0,"ephemeral_5m_input_tokens":1755},"inference_geo":"not_available","iterations":[{"input_tokens":2,"output_tokens":121,"cache_read_input_tokens":116927,"cache_creation_input_tokens":1755,"cache_creation":{"ephemeral_5m_input_tokens":1755,"ephemeral_1h_input_tokens":0},"type":"message"}],"speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_01EwYJxckLh1ijahAECikWiY":{"file_path":"C:\\Users\\User\\mcp-servers\\cuore\\services\\jobs_bridge.py","offset":60,"limit":340}},"serverClassifierRequest":"c4a19419-ca09-4c8a-b48f-3f1e6d472773","apiBlockIndex":0,"requestId":"req_011CfqfKvcLfYLhsGAxT6XTR","attributionAgent":"general-purpose","type":"assistant","uuid":"5f7f8893-fadf-47a0-a86d-e01a388221d3","timestamp":"2026-10-08T23:46:35.083Z","effort":"high","perTurnEffort":null,"userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
{"parentUuid":"5f7f8893-fadf-47a0-a86d-e01a388221d3","isSidechain":true,"promptId":"c88cddde-d9ec-4df1-89bf-4cd0fc5db786","agentId":"acb0e47c9637c321b","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01EwYJxckLh1ijahAECikWiY","type":"tool_result","content":"60\t\n61\t\n62\t# --- small ref builders -------------------------------------------------\n63\t\n64\t\n65\tdef _ref(kind: str, id_: Any, label: str) -> dict[str, Any]:\n66\t    return {\"kind\": kind, \"id\": id_, \"label\": label}\n67\t\n68\t\n69\t# --- suggested hypotheses, built only from real data ---------------------\n70\t\n71\t\n72\tdef _evap_suggestions(vin: str, view: dict[str, Any]) -> list[dict[str, Any]]:\n73\t    \"\"\"The two EVAP hypotheses this corpus's own fault tree/bulletins\n74\t    distinguish: a signal-path fault at the ESIM, vs. an ECM calibration\n75\t    issue the TSBs describe. Only offered when the dossier's open-work\n76\t    already names an EVAP family card -- no family, no suggestion.\"\"\"\n77\t    evap_card = next((c for c in view.get(\"open_work\", []) if c.get(\"family\") == \"EVAP\"), None)\n78\t    if evap_card is None:\n79\t        return []\n80\t\n81\t    freeze_frames = view.get(\"freeze_frames\", [])\n82\t    attempted = view.get(\"attempted\", [])\n83\t    bulletins = view.get(\"bulletins\", [])\n84\t\n85\t    fuel_flag_evidence = [\n86\t        _ref(\"freeze_frame\", f[\"code\"], f\"{f['code']} freeze frame: {k['flag']}\")\n87\t        for f in freeze_frames for k in f.get(\"key\", []) if k.get(\"flag\")\n88\t    ]\n89\t    esim_step = next((s for s in evap_card.get(\"steps\", []) if s[\"id\"] == \"evap-4\"), None)\n90\t    esim_evidence_for = list(fuel_flag_evidence)\n91\t    if esim_step is not None and esim_step.get(\"done\"):\n92\t        esim_evidence_for.append(_ref(\"inspection\", \"evap-4\",\n93\t                                      \"ESIM/canister inspection logged done\"))\n94\t    actuator_evidence = [\n95\t        _ref(\"actuator\", a[\"operation\"],\n96\t             f\"{a['operation']}: {a['outcome']} x{a['count']}\")\n97\t        for a in attempted if \"evapor\" in (a.get(\"operation\") or \"\").lower()\n98\t    ]\n99\t    esim_evidence_for += actuator_evidence\n100\t\n101\t    calibration_bulletins = [b for b in bulletins\n102\t                             if \"calib\" in (b.get(\"title\") or \"\").lower()\n103\t                             or \"calib\" in (b.get(\"action\") or \"\").lower()]\n104\t    calib_evidence_for = [\n105\t        _ref(\"bulletin\", b[\"id\"], f\"{b['id']}: {b['title']}\") for b in calibration_bulletins\n106\t    ]\n107\t    dealer_results = mes_bridge.dealer_results(vin).get(\"results\", [])\n108\t    slvt = [r for r in dealer_results if r.get(\"kind\") == \"slvt\"]\n109\t    calib_evidence_for += [\n110\t        _ref(\"dealer\", r.get(\"at\"), f\"SLVT {r['data'].get('result')}: {r['data'].get('detail') or ''}\".strip(\": \"))\n111\t        for r in slvt if (r.get(\"data\") or {}).get(\"result\") == \"fail\"\n112\t    ]\n113\t    calib_evidence_against = [\n114\t        _ref(\"dealer\", r.get(\"at\"), f\"SLVT {r['data'].get('result')}: {r['data'].get('detail') or ''}\".strip(\": \"))\n115\t        for r in slvt if (r.get(\"data\") or {}).get(\"result\") == \"pass\"\n116\t    ]\n117\t\n118\t    history = view.get(\"codes\", [])\n119\t    returned = [r for r in history if r.get(\"bucket\") == \"returned_after_clear\"]\n120\t    returned_evidence = [\n121\t        _ref(\"code\", r[\"code\"], f\"{r['code']} returned after clear ({r.get('last_seen_short')})\")\n122\t        for r in returned\n123\t    ]\n124\t\n125\t    out = [\n126\t        {\"text\": \"EVAP: ESIM signal path\", \"system\": \"EVAP\",\n127\t         \"evidence_for\": esim_evidence_for, \"evidence_against\": [],\n128\t         \"next_test\": \"Smoke test the recirculation line and canister/ESIM \"\n129\t                      \"connector under light vacuum.\"},\n130\t        {\"text\": \"EVAP: ECM calibration\", \"system\": \"EVAP\",\n131\t         \"evidence_for\": calib_evidence_for + returned_evidence,\n132\t         \"evidence_against\": calib_evidence_against,\n133\t         \"next_test\": \"Check PCM calibration level against the latest EVAP \"\n134\t                      \"TSB before condemning hardware (SLVT or Mode $06).\"},\n135\t    ]\n136\t    return out\n137\t\n138\t\n139\tdef _network_suggestions(view: dict[str, Any]) -> list[dict[str, Any]]:\n140\t    net_card = next((c for c in view.get(\"open_work\", []) if c.get(\"family\") == \"network\"\n141\t                     or c.get(\"family\") == \"NETWORK\"), None)\n142\t    if net_card is None:\n143\t        return []\n144\t    refs = [_ref(\"bulletin\", r[\"label\"], r[\"label\"]) for r in net_card.get(\"refs\", []) if r.get(\"label\")]\n145\t    return [{\"text\": \"Network: power/ground or bus event\", \"system\": \"network\",\n146\t            \"evidence_for\": refs, \"evidence_against\": [],\n147\t            \"next_test\": \"Check F82 fuse/BCM supply and the connectors/grounds \"\n148\t                         \"this fault tree cites before chasing individual codes.\"}]\n149\t\n150\t\n151\t#: EVAP and network each got a hand-written hypothesis builder above,\n152\t#: because they're this app's first, richest examples. Every other family\n153\t#: dossier_bridge's generic open-work builder can produce (misfire,\n154\t#: fuel_trim, cooling, body, chassis, adas, etc.) still deserves a\n155\t#: hypothesis per code -- built the same way, from real evidence, just\n156\t#: without a bespoke pair of ESIM/calibration-style hypotheses hand-written\n157\t#: for it. Skipped here so the two curated builders above keep owning their\n158\t#: own families rather than being duplicated.\n159\t_CURATED_FAMILIES = {\"EVAP\", \"network\"}\n160\t\n161\t\n162\tdef _hypothesis_for_code(family: str, code: str,\n163\t                         steps: list[dict[str, Any]]) -> tuple[str, str]:\n164\t    \"\"\"``(hypothesis text, next_test)`` for one code, built only from the\n165\t    real steps its own generated fault tree already produced -- see\n166\t    ``dossier_bridge._generic_tree_steps`` (``mes.faulttree.tree_for``).\n167\t    Never invents a branch beyond re-labelling a real step's own text.\"\"\"\n168\t    swap_step = next(\n169\t        (s for s in steps if \"swap\" in (s.get(\"text\") or \"\").lower()), None)\n170\t    if family == \"misfire\":\n171\t        m = re.match(r\"^P030([1-4])$\", code)\n172\t        cyl = f\" cylinder {m.group(1)}\" if m else \"\"\n173\t        text = f\"{code}: coil or plug{cyl} (swap test)\"\n174\t        next_test = swap_step[\"text\"] if swap_step else (\n175\t            steps[0][\"text\"] if steps else \"\")\n176\t        return text, next_test\n177\t    lead = swap_step or (steps[0] if steps else None)\n178\t    if lead is None:\n179\t        return f\"{code}: {family} fault\", \"\"\n180\t    short = (lead[\"text\"].split(\":\", 1)[0] if \":\" in lead[\"text\"]\n181\t             else lead[\"text\"])\n182\t    return f\"{code}: {short}\", lead[\"text\"]\n183\t\n184\t\n185\tdef _generic_family_suggestions(vin: str, view: dict[str, Any]\n186\t                                ) -> list[dict[str, Any]]:\n187\t    \"\"\"One hypothesis per code for every open-work family dossier_bridge\n188\t    generated generically (i.e. everything that isn't EVAP/network), each\n189\t    pre-filled with real evidence: freeze frames and returned-after-clear\n190\t    history for that exact code, logged-done steps from the same card, and\n191\t    any bulletin that names the code -- the same evidence_for/against\n192\t    discipline as the EVAP/network builders, just applied to whichever\n193\t    family this car's own history actually has open.\"\"\"\n194\t    freeze_frames = view.get(\"freeze_frames\", [])\n195\t    codes_hist = view.get(\"codes\", [])\n196\t    bulletins = view.get(\"bulletins\", [])\n197\t    out: list[dict[str, Any]] = []\n198\t    for card in view.get(\"open_work\", []):\n199\t        family = card.get(\"family\") or \"\"\n200\t        if family in _CURATED_FAMILIES or not card.get(\"generic\"):\n201\t            continue\n202\t        steps = card.get(\"steps\", [])\n203\t        done_steps = [s for s in steps if s.get(\"done\")]\n204\t        for code in card.get(\"codes\", []):\n205\t            evidence_for = [\n206\t                _ref(\"freeze_frame\", f[\"code\"], f\"{f['code']} freeze frame\")\n207\t                for f in freeze_frames if f.get(\"code\", \"\").startswith(code)\n208\t            ]\n209\t            evidence_for += [\n210\t                _ref(\"inspection\", s[\"id\"], f\"{s['text']} -- logged done\")\n211\t                for s in done_steps\n212\t            ]\n213\t            evidence_for += [\n214\t                _ref(\"bulletin\", b[\"id\"], f\"{b['id']}: {b.get('title', '')}\")\n215\t                for b in bulletins if code in (b.get(\"codes\") or [])\n216\t            ]\n217\t            evidence_for += [\n218\t                _ref(\"code\", r[\"code\"],\n219\t                     f\"{r['code']} returned after clear ({r.get('last_seen_short')})\")\n220\t                for r in codes_hist\n221\t                if r.get(\"code\") == code and r.get(\"bucket\") == \"returned_after_clear\"\n222\t            ]\n223\t            text, next_test = _hypothesis_for_code(family, code, steps)\n224\t            out.append({\"text\": text, \"system\": family,\n225\t                       \"evidence_for\": evidence_for, \"evidence_against\": [],\n226\t                       \"next_test\": next_test})\n227\t    return out\n228\t\n229\t\n230\tdef suggested_hypotheses(vin: str, view: dict[str, Any]) -> list[dict[str, Any]]:\n231\t    \"\"\"Hypotheses this car's own fault tree/bulletins already point at, each\n232\t    pre-filled with real evidence_for/against refs -- never invented. The\n233\t    mechanic adds whichever apply via the job page's form; nothing here\n234\t    writes anything.\n235\t\n236\t    Also folds in the newest liveboard snapshot, if one exists\n237\t    (``cuore.live.ui_store`` snapshots with ``layout == \"liveboard\"``): any\n238\t    channel it reads outside its sourced known-good range becomes one more\n239\t    evidence_for ref on whichever suggestion's ``system`` that channel's own\n240\t    ``mes.systems`` mapping names (``cuore.services.liveboard_bridge.\n241\t    channel_system``/``evaluate`` -- never a band invented here). No\n242\t    liveboard snapshot, or nothing out of range in it, changes nothing.\n243\t    \"\"\"\n244\t    out = (_evap_suggestions(vin, view) + _network_suggestions(view)\n245\t          + _generic_family_suggestions(vin, view))\n246\t    _augment_with_liveboard(out)\n247\t    return rank_suggestions(dedupe_suggestions(out))\n248\t\n249\t\n250\tdef _augment_with_liveboard(out: list[dict[str, Any]]) -> None:\n251\t    \"\"\"Mutates ``out`` in place: any liveboard channel reading outside its\n252\t    known-good range becomes one more evidence_for ref on whichever\n253\t    suggestion's ``system`` that channel maps to. No snapshot, or nothing\n254\t    out of range, changes nothing -- every early-out below is a no-op, not\n255\t    a skip of the caller's own dedupe/rank pass.\"\"\"\n256\t    try:\n257\t        from ..live import ui_store\n258\t        from . import liveboard_bridge\n259\t    except Exception:  # noqa: BLE001 -- live-data wiring is a nice-to-have here\n260\t        return\n261\t    try:\n262\t        snap = next((s for s in ui_store.list_snapshots(200)\n263\t                    if s.get(\"layout\") == \"liveboard\"), None)\n264\t    except Exception:  # noqa: BLE001\n265\t        snap = None\n266\t    if snap is None:\n267\t        return\n268\t    raw_values = {cid: v.get(\"value\") for cid, v in (snap.get(\"values\") or {}).items()\n269\t                 if isinstance(v, dict) and v.get(\"value\") is not None}\n270\t    if not raw_values:\n271\t        return\n272\t    try:\n273\t        recs = liveboard_bridge.snapshot_recommendations(raw_values)\n274\t    except Exception:  # noqa: BLE001\n275\t        return\n276\t    for rec in recs:\n277\t        if rec[\"level\"] not in (\"excessive\", \"moderate\"):\n278\t            continue\n279\t        sys_key = liveboard_bridge.channel_system(rec[\"id\"])\n280\t        if not sys_key:\n281\t            continue\n282\t        unit = f\" {rec['unit']}\" if rec.get(\"unit\") else \"\"\n283\t        ref = _ref(\"live\", snap[\"id\"], f\"{rec['name']} {rec['value']:g}{unit}: {rec['level']}\")\n284\t        for s in out:\n285\t            if (s.get(\"system\") or \"\").strip().lower() == sys_key.lower():\n286\t                if ref not in s[\"evidence_for\"]:\n287\t                    s[\"evidence_for\"].append(ref)\n288\t\n289\t\n290\t# --- dedupe + rank (JOB_UX_FIXES_2026-10-08.md #11) -----------------------\n291\t\n292\t\n293\tdef dedupe_suggestions(suggestions: list[dict[str, Any]]) -> list[dict[str, Any]]:\n294\t    \"\"\"Merge suggestions that share the same (non-empty) ``next_test`` into\n295\t    one card listing the affected codes -- e.g. 8 per-code \"Upstream check\"\n296\t    suggestions the generic family builder produced for one fault tree step\n297\t    become one \"Upstream check: network: B1029, B102E, ...\" card. A\n298\t    suggestion with no ``next_test`` (nothing to key the merge on) is never\n299\t    merged, even if another suggestion also has none.\n300\t    \"\"\"\n301\t    groups: dict[str, list[dict[str, Any]]] = {}\n302\t    order: list[str] = []\n303\t    for i, s in enumerate(suggestions):\n304\t        key = (s.get(\"next_test\") or \"\").strip() or f\"__single__{i}\"\n305\t        groups.setdefault(key, []).append(s)\n306\t        if key not in order:\n307\t            order.append(key)\n308\t\n309\t    merged: list[dict[str, Any]] = []\n310\t    for key in order:\n311\t        group = groups[key]\n312\t        if len(group) == 1:\n313\t            merged.append(group[0])\n314\t            continue\n315\t        codes: list[str] = []\n316\t        for s in group:\n317\t            code = (s.get(\"text\") or \"\").split(\":\", 1)[0].strip()\n318\t            if code and code not in codes:\n319\t                codes.append(code)\n320\t        system = group[0].get(\"system\", \"\")\n321\t        label = f\"Upstream check: {system}\" if system else \"Upstream check\"\n322\t        evidence_for: list[dict[str, Any]] = []\n323\t        evidence_against: list[dict[str, Any]] = []\n324\t        for s in group:\n325\t            for ref in s.get(\"evidence_for\", []):\n326\t                if ref not in evidence_for:\n327\t                    evidence_for.append(ref)\n328\t            for ref in s.get(\"evidence_against\", []):\n329\t                if ref not in evidence_against:\n330\t                    evidence_against.append(ref)\n331\t        merged.append({\n332\t            \"text\": f\"{label}: {', '.join(codes)}\" if codes else label,\n333\t            \"system\": system, \"codes\": codes,\n334\t            \"evidence_for\": evidence_for, \"evidence_against\": evidence_against,\n335\t            \"next_test\": key, \"merged_count\": len(group),\n336\t        })\n337\t    return merged\n338\t\n339\t\n340\t_LIKELIHOOD_RANK = {\"high\": 0, \"med\": 1, \"low\": 2, None: 3}\n341\t\n342\t\n343\tdef rank_suggestions(suggestions: list[dict[str, Any]]) -> list[dict[str, Any]]:\n344\t    \"\"\"Rank by the amount of evidence supporting a suggestion (most first),\n345\t    then by its stated likelihood, high before low before unstated.\"\"\"\n346\t    return sorted(\n347\t        suggestions,\n348\t        key=lambda s: (-len(s.get(\"evidence_for\") or []),\n349\t                       _LIKELIHOOD_RANK.get(s.get(\"likelihood\"), 3)),\n350\t    )\n351\t\n352\t\n353\tdef grouped_suggestions(vin: str, view: dict[str, Any], *,\n354\t                        top_n: int = 3) -> dict[str, list[dict[str, Any]]]:\n355\t    \"\"\":func:`suggested_hypotheses`'s own output, already deduped and\n356\t    ranked, split into the top ``top_n`` cards and the rest -- \"Show N\n357\t    more\" on the job page (#11).\"\"\"\n358\t    ranked = suggested_hypotheses(vin, view)\n359\t    return {\"top\": ranked[:top_n], \"rest\": ranked[top_n:]}\n360\t\n361\t\n362\tdef _tokens(text: str) -> set[str]:\n363\t    return {w for w in re.findall(r\"[a-z0-9]+\", (text or \"\").lower())\n364\t           if w not in _STOPWORDS}\n365\t\n366\t\n367\tdef similar_existing(job: Optional[dict[str, Any]], text: str,\n368\t                     system: str = \"\") -> Optional[dict[str, Any]]:\n369\t    \"\"\"The most similar existing (non-deleted) hypothesis already on this\n370\t    job to a proposed new one, by token overlap -- for the \"Similar to ...\n371\t    -- merge?\" prompt (#11). ``None`` when there is no job, the proposed\n372\t    text has no real tokens, or nothing scores >= 0.5 overlap (the overlap\n373\t    fraction is shared tokens over the smaller of the two token sets, so a\n374\t    short phrase fully contained in a longer one still counts).\"\"\"\n375\t    if not job:\n376\t        return None\n377\t    new_tokens = _tokens(text)\n378\t    if not new_tokens:\n379\t        return None\n380\t    best: Optional[dict[str, Any]] = None\n381\t    best_score = 0.0\n382\t    for h in job.get(\"hypotheses\", []):\n383\t        if h.get(\"deleted\"):\n384\t            continue\n385\t        h_tokens = _tokens(h.get(\"text\", \"\"))\n386\t        if not h_tokens:\n387\t            continue\n388\t        overlap = len(new_tokens & h_tokens) / min(len(new_tokens), len(h_tokens))\n389\t        if overlap > best_score:\n390\t            best_score, best = overlap, h\n391\t    return best if best is not None and best_score >= 0.5 else None\n392\t\n393\t\n394\t# --- gathering the rest of the stepper's \"auto-gathered evidence\" --------\n395\t\n396\t\n397\tdef _cached_workup(vin: str) -> dict[str, Any]:\n398\t    \"\"\"The same memoised workup ``cuore.web.routes._dossier`` builds for the\n399\t    dossier page, keyed identically (vin, newest MES-log mtime) so the two"}]},"uuid":"3ac500f5-f2bc-47c1-81e0-ca784b5c5034","timestamp":"2026-10-08T23:46:35.122Z","toolUseResult":{"type":"text","file":{"filePath":"C:\\Users\\User\\mcp-servers\\cuore\\services\\jobs_bridge.py","content":"\n\n# --- small ref builders -------------------------------------------------\n\n\ndef _ref(kind: str, id_: Any, label: str) -> dict[str, Any]:\n    return {\"kind\": kind, \"id\": id_, \"label\": label}\n\n\n# --- suggested hypotheses, built only from real data ---------------------\n\n\ndef _evap_suggestions(vin: str, view: dict[str, Any]) -> list[dict[str, Any]]:\n    \"\"\"The two EVAP hypotheses this corpus's own fault tree/bulletins\n    distinguish: a signal-path fault at the ESIM, vs. an ECM calibration\n    issue the TSBs describe. Only offered when the dossier's open-work\n    already names an EVAP family card -- no family, no suggestion.\"\"\"\n    evap_card = next((c for c in view.get(\"open_work\", []) if c.get(\"family\") == \"EVAP\"), None)\n    if evap_card is None:\n        return []\n\n    freeze_frames = view.get(\"freeze_frames\", [])\n    attempted = view.get(\"attempted\", [])\n    bulletins = view.get(\"bulletins\", [])\n\n    fuel_flag_evidence = [\n        _ref(\"freeze_frame\", f[\"code\"], f\"{f['code']} freeze frame: {k['flag']}\")\n        for f in freeze_frames for k in f.get(\"key\", []) if k.get(\"flag\")\n    ]\n    esim_step = next((s for s in evap_card.get(\"steps\", []) if s[\"id\"] == \"evap-4\"), None)\n    esim_evidence_for = list(fuel_flag_evidence)\n    if esim_step is not None and esim_step.get(\"done\"):\n        esim_evidence_for.append(_ref(\"inspection\", \"evap-4\",\n                                      \"ESIM/canister inspection logged done\"))\n    actuator_evidence = [\n        _ref(\"actuator\", a[\"operation\"],\n             f\"{a['operation']}: {a['outcome']} x{a['count']}\")\n        for a in attempted if \"evapor\" in (a.get(\"operation\") or \"\").lower()\n    ]\n    esim_evidence_for += actuator_evidence\n\n    calibration_bulletins = [b for b in bulletins\n                             if \"calib\" in (b.get(\"title\") or \"\").lower()\n                             or \"calib\" in (b.get(\"action\") or \"\").lower()]\n    calib_evidence_for = [\n        _ref(\"bulletin\", b[\"id\"], f\"{b['id']}: {b['title']}\") for b in calibration_bulletins\n    ]\n    dealer_results = mes_bridge.dealer_results(vin).get(\"results\", [])\n    slvt = [r for r in dealer_results if r.get(\"kind\") == \"slvt\"]\n    calib_evidence_for += [\n        _ref(\"dealer\", r.get(\"at\"), f\"SLVT {r['data'].get('result')}: {r['data'].get('detail') or ''}\".strip(\": \"))\n        for r in slvt if (r.get(\"data\") or {}).get(\"result\") == \"fail\"\n    ]\n    calib_evidence_against = [\n        _ref(\"dealer\", r.get(\"at\"), f\"SLVT {r['data'].get('result')}: {r['data'].get('detail') or ''}\".strip(\": \"))\n        for r in slvt if (r.get(\"data\") or {}).get(\"result\") == \"pass\"\n    ]\n\n    history = view.get(\"codes\", [])\n    returned = [r for r in history if r.get(\"bucket\") == \"returned_after_clear\"]\n    returned_evidence = [\n        _ref(\"code\", r[\"code\"], f\"{r['code']} returned after clear ({r.get('last_seen_short')})\")\n        for r in returned\n    ]\n\n    out = [\n        {\"text\": \"EVAP: ESIM signal path\", \"system\": \"EVAP\",\n         \"evidence_for\": esim_evidence_for, \"evidence_against\": [],\n         \"next_test\": \"Smoke test the recirculation line and canister/ESIM \"\n                      \"connector under light vacuum.\"},\n        {\"text\": \"EVAP: ECM calibration\", \"system\": \"EVAP\",\n         \"evidence_for\": calib_evidence_for + returned_evidence,\n         \"evidence_against\": calib_evidence_against,\n         \"next_test\": \"Check PCM calibration level against the latest EVAP \"\n                      \"TSB before condemning hardware (SLVT or Mode $06).\"},\n    ]\n    return out\n\n\ndef _network_suggestions(view: dict[str, Any]) -> list[dict[str, Any]]:\n    net_card = next((c for c in view.get(\"open_work\", []) if c.get(\"family\") == \"network\"\n                     or c.get(\"family\") == \"NETWORK\"), None)\n    if net_card is None:\n        return []\n    refs = [_ref(\"bulletin\", r[\"label\"], r[\"label\"]) for r in net_card.get(\"refs\", []) if r.get(\"label\")]\n    return [{\"text\": \"Network: power/ground or bus event\", \"system\": \"network\",\n            \"evidence_for\": refs, \"evidence_against\": [],\n            \"next_test\": \"Check F82 fuse/BCM supply and the connectors/grounds \"\n                         \"this fault tree cites before chasing individual codes.\"}]\n\n\n#: EVAP and network each got a hand-written hypothesis builder above,\n#: because they're this app's first, richest examples. Every other family\n#: dossier_bridge's generic open-work builder can produce (misfire,\n#: fuel_trim, cooling, body, chassis, adas, etc.) still deserves a\n#: hypothesis per code -- built the same way, from real evidence, just\n#: without a bespoke pair of ESIM/calibration-style hypotheses hand-written\n#: for it. Skipped here so the two curated builders above keep owning their\n#: own families rather than being duplicated.\n_CURATED_FAMILIES = {\"EVAP\", \"network\"}\n\n\ndef _hypothesis_for_code(family: str, code: str,\n                         steps: list[dict[str, Any]]) -> tuple[str, str]:\n    \"\"\"``(hypothesis text, next_test)`` for one code, built only from the\n    real steps its own generated fault tree already produced -- see\n    ``dossier_bridge._generic_tree_steps`` (``mes.faulttree.tree_for``).\n    Never invents a branch beyond re-labelling a real step's own text.\"\"\"\n    swap_step = next(\n        (s for s in steps if \"swap\" in (s.get(\"text\") or \"\").lower()), None)\n    if family == \"misfire\":\n        m = re.match(r\"^P030([1-4])$\", code)\n        cyl = f\" cylinder {m.group(1)}\" if m else \"\"\n        text = f\"{code}: coil or plug{cyl} (swap test)\"\n        next_test = swap_step[\"text\"] if swap_step else (\n            steps[0][\"text\"] if steps else \"\")\n        return text, next_test\n    lead = swap_step or (steps[0] if steps else None)\n    if lead is None:\n        return f\"{code}: {family} fault\", \"\"\n    short = (lead[\"text\"].split(\":\", 1)[0] if \":\" in lead[\"text\"]\n             else lead[\"text\"])\n    return f\"{code}: {short}\", lead[\"text\"]\n\n\ndef _generic_family_suggestions(vin: str, view: dict[str, Any]\n                                ) -> list[dict[str, Any]]:\n    \"\"\"One hypothesis per code for every open-work family dossier_bridge\n    generated generically (i.e. everything that isn't EVAP/network), each\n    pre-filled with real evidence: freeze frames and returned-after-clear\n    history for that exact code, logged-done steps from the same card, and\n    any bulletin that names the code -- the same evidence_for/against\n    discipline as the EVAP/network builders, just applied to whichever\n    family this car's own history actually has open.\"\"\"\n    freeze_frames = view.get(\"freeze_frames\", [])\n    codes_hist = view.get(\"codes\", [])\n    bulletins = view.get(\"bulletins\", [])\n    out: list[dict[str, Any]] = []\n    for card in view.get(\"open_work\", []):\n        family = card.get(\"family\") or \"\"\n        if family in _CURATED_FAMILIES or not card.get(\"generic\"):\n            continue\n        steps = card.get(\"steps\", [])\n        done_steps = [s for s in steps if s.get(\"done\")]\n        for code in card.get(\"codes\", []):\n            evidence_for = [\n                _ref(\"freeze_frame\", f[\"code\"], f\"{f['code']} freeze frame\")\n                for f in freeze_frames if f.get(\"code\", \"\").startswith(code)\n            ]\n            evidence_for += [\n                _ref(\"inspection\", s[\"id\"], f\"{s['text']} -- logged done\")\n                for s in done_steps\n            ]\n            evidence_for += [\n                _ref(\"bulletin\", b[\"id\"], f\"{b['id']}: {b.get('title', '')}\")\n                for b in bulletins if code in (b.get(\"codes\") or [])\n            ]\n            evidence_for += [\n                _ref(\"code\", r[\"code\"],\n                     f\"{r['code']} returned after clear ({r.get('last_seen_short')})\")\n                for r in codes_hist\n                if r.get(\"code\") == code and r.get(\"bucket\") == \"returned_after_clear\"\n            ]\n            text, next_test = _hypothesis_for_code(family, code, steps)\n            out.append({\"text\": text, \"system\": family,\n                       \"evidence_for\": evidence_for, \"evidence_against\": [],\n                       \"next_test\": next_test})\n    return out\n\n\ndef suggested_hypotheses(vin: str, view: dict[str, Any]) -> list[dict[str, Any]]:\n    \"\"\"Hypotheses this car's own fault tree/bulletins already point at, each\n    pre-filled with real evidence_for/against refs -- never invented. The\n    mechanic adds whichever apply via the job page's form; nothing here\n    writes anything.\n\n    Also folds in the newest liveboard snapshot, if one exists\n    (``cuore.live.ui_store`` snapshots with ``layout == \"liveboard\"``): any\n    channel it reads outside its sourced known-good range becomes one more\n    evidence_for ref on whichever suggestion's ``system`` that channel's own\n    ``mes.systems`` mapping names (``cuore.services.liveboard_bridge.\n    channel_system``/``evaluate`` -- never a band invented here). No\n    liveboard snapshot, or nothing out of range in it, changes nothing.\n    \"\"\"\n    out = (_evap_suggestions(vin, view) + _network_suggestions(view)\n          + _generic_family_suggestions(vin, view))\n    _augment_with_liveboard(out)\n    return rank_suggestions(dedupe_suggestions(out))\n\n\ndef _augment_with_liveboard(out: list[dict[str, Any]]) -> None:\n    \"\"\"Mutates ``out`` in place: any liveboard channel reading outside its\n    known-good range becomes one more evidence_for ref on whichever\n    suggestion's ``system`` that channel maps to. No snapshot, or nothing\n    out of range, changes nothing -- every early-out below is a no-op, not\n    a skip of the caller's own dedupe/rank pass.\"\"\"\n    try:\n        from ..live import ui_store\n        from . import liveboard_bridge\n    except Exception:  # noqa: BLE001 -- live-data wiring is a nice-to-have here\n        return\n    try:\n        snap = next((s for s in ui_store.list_snapshots(200)\n                    if s.get(\"layout\") == \"liveboard\"), None)\n    except Exception:  # noqa: BLE001\n        snap = None\n    if snap is None:\n        return\n    raw_values = {cid: v.get(\"value\") for cid, v in (snap.get(\"values\") or {}).items()\n                 if isinstance(v, dict) and v.get(\"value\") is not None}\n    if not raw_values:\n        return\n    try:\n        recs = liveboard_bridge.snapshot_recommendations(raw_values)\n    except Exception:  # noqa: BLE001\n        return\n    for rec in recs:\n        if rec[\"level\"] not in (\"excessive\", \"moderate\"):\n            continue\n        sys_key = liveboard_bridge.channel_system(rec[\"id\"])\n        if not sys_key:\n            continue\n        unit = f\" {rec['unit']}\" if rec.get(\"unit\") else \"\"\n        ref = _ref(\"live\", snap[\"id\"], f\"{rec['name']} {rec['value']:g}{unit}: {rec['level']}\")\n        for s in out:\n            if (s.get(\"system\") or \"\").strip().lower() == sys_key.lower():\n                if ref not in s[\"evidence_for\"]:\n                    s[\"evidence_for\"].append(ref)\n\n\n# --- dedupe + rank (JOB_UX_FIXES_2026-10-08.md #11) -----------------------\n\n\ndef dedupe_suggestions(suggestions: list[dict[str, Any]]) -> list[dict[str, Any]]:\n    \"\"\"Merge suggestions that share the same (non-empty) ``next_test`` into\n    one card listing the affected codes -- e.g. 8 per-code \"Upstream check\"\n    suggestions the generic family builder produced for one fault tree step\n    become one \"Upstream check: network: B1029, B102E, ...\" card. A\n    suggestion with no ``next_test`` (nothing to key the merge on) is never\n    merged, even if another suggestion also has none.\n    \"\"\"\n    groups: dict[str, list[dict[str, Any]]] = {}\n    order: list[str] = []\n    for i, s in enumerate(suggestions):\n        key = (s.get(\"next_test\") or \"\").strip() or f\"__single__{i}\"\n        groups.setdefault(key, []).append(s)\n        if key not in order:\n            order.append(key)\n\n    merged: list[dict[str, Any]] = []\n    for key in order:\n        group = groups[key]\n        if len(group) == 1:\n            merged.append(group[0])\n            continue\n        codes: list[str] = []\n        for s in group:\n            code = (s.get(\"text\") or \"\").split(\":\", 1)[0].strip()\n            if code and code not in codes:\n                codes.append(code)\n        system = group[0].get(\"system\", \"\")\n        label = f\"Upstream check: {system}\" if system else \"Upstream check\"\n        evidence_for: list[dict[str, Any]] = []\n        evidence_against: list[dict[str, Any]] = []\n        for s in group:\n            for ref in s.get(\"evidence_for\", []):\n                if ref not in evidence_for:\n                    evidence_for.append(ref)\n            for ref in s.get(\"evidence_against\", []):\n                if ref not in evidence_against:\n                    evidence_against.append(ref)\n        merged.append({\n            \"text\": f\"{label}: {', '.join(codes)}\" if codes else label,\n            \"system\": system, \"codes\": codes,\n            \"evidence_for\": evidence_for, \"evidence_against\": evidence_against,\n            \"next_test\": key, \"merged_count\": len(group),\n        })\n    return merged\n\n\n_LIKELIHOOD_RANK = {\"high\": 0, \"med\": 1, \"low\": 2, None: 3}\n\n\ndef rank_suggestions(suggestions: list[dict[str, Any]]) -> list[dict[str, Any]]:\n    \"\"\"Rank by the amount of evidence supporting a suggestion (most first),\n    then by its stated likelihood, high before low before unstated.\"\"\"\n    return sorted(\n        suggestions,\n        key=lambda s: (-len(s.get(\"evidence_for\") or []),\n                       _LIKELIHOOD_RANK.get(s.get(\"likelihood\"), 3)),\n    )\n\n\ndef grouped_suggestions(vin: str, view: dict[str, Any], *,\n                        top_n: int = 3) -> dict[str, list[dict[str, Any]]]:\n    \"\"\":func:`suggested_hypotheses`'s own output, already deduped and\n    ranked, split into the top ``top_n`` cards and the rest -- \"Show N\n    more\" on the job page (#11).\"\"\"\n    ranked = suggested_hypotheses(vin, view)\n    return {\"top\": ranked[:top_n], \"rest\": ranked[top_n:]}\n\n\ndef _tokens(text: str) -> set[str]:\n    return {w for w in re.findall(r\"[a-z0-9]+\", (text or \"\").lower())\n           if w not in _STOPWORDS}\n\n\ndef similar_existing(job: Optional[dict[str, Any]], text: str,\n                     system: str = \"\") -> Optional[dict[str, Any]]:\n    \"\"\"The most similar existing (non-deleted) hypothesis already on this\n    job to a proposed new one, by token overlap -- for the \"Similar to ...\n    -- merge?\" prompt (#11). ``None`` when there is no job, the proposed\n    text has no real tokens, or nothing scores >= 0.5 overlap (the overlap\n    fraction is shared tokens over the smaller of the two token sets, so a\n    short phrase fully contained in a longer one still counts).\"\"\"\n    if not job:\n        return None\n    new_tokens = _tokens(text)\n    if not new_tokens:\n        return None\n    best: Optional[dict[str, Any]] = None\n    best_score = 0.0\n    for h in job.get(\"hypotheses\", []):\n        if h.get(\"deleted\"):\n            continue\n        h_tokens = _tokens(h.get(\"text\", \"\"))\n        if not h_tokens:\n            continue\n        overlap = len(new_tokens & h_tokens) / min(len(new_tokens), len(h_tokens))\n        if overlap > best_score:\n            best_score, best = overlap, h\n    return best if best is not None and best_score >= 0.5 else None\n\n\n# --- gathering the rest of the stepper's \"auto-gathered evidence\" --------\n\n\ndef _cached_workup(vin: str) -> dict[str, Any]:\n    \"\"\"The same memoised workup ``cuore.web.routes._dossier`` builds for the\n    dossier page, keyed identically (vin, newest MES-log mtime) so the two","numLines":340,"startLine":60,"totalLines":869}},"sourceToolAssistantUUID":"5f7f8893-fadf-47a0-a86d-e01a388221d3","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
