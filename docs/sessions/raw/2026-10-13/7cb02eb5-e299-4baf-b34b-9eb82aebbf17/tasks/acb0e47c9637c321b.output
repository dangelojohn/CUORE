{"parentUuid":"4ec2de84-c716-4ce3-815e-7dfdf8fb47a8","isSidechain":true,"agentId":"acb0e47c9637c321b","message":{"model":"claude-sonnet-5","id":"msg_011Cfqgfy56F74LCeLYiWjKk","type":"message","role":"assistant","content":[{"type":"text","text":"Let's continue with `systems_map_bridge.py`'s `system_states()` while that test runs. First, re-read the current file since it was modified by another agent."}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1237,"cache_read_input_tokens":226093,"cache_creation":{"ephemeral_5m_input_tokens":1237,"ephemeral_1h_input_tokens":0},"output_tokens":3,"service_tier":"standard","inference_geo":"not_available"},"input_transformations":[],"diagnostics":null,"context_management":null},"serverClassifierRequest":"e92bb1ba-3e17-4b2b-86c2-9cf8738882f1","apiBlockIndex":0,"requestId":"req_011Cfqgfxmytc9VM6ArPZzoW","attributionAgent":"general-purpose","type":"assistant","uuid":"9f7f9a2a-ddb7-4d80-8b9b-2bb0c0138f5c","timestamp":"2026-10-09T00:04:12.953Z","effort":"high","perTurnEffort":null,"userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
{"parentUuid":"9f7f9a2a-ddb7-4d80-8b9b-2bb0c0138f5c","isSidechain":true,"agentId":"acb0e47c9637c321b","message":{"model":"claude-sonnet-5","id":"msg_011Cfqgfy56F74LCeLYiWjKk","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01HFKbA4xCHuqsWh5MSY4qTh","name":"Read","input":{"file_path":"C:\\Users\\User\\mcp-servers\\cuore\\services\\systems_map_bridge.py"},"caller":{"type":"direct"}}],"container":null,"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1237,"cache_read_input_tokens":226093,"output_tokens":129,"output_tokens_details":{"thinking_tokens":0},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":0,"ephemeral_5m_input_tokens":1237},"inference_geo":"not_available","iterations":[{"input_tokens":2,"output_tokens":129,"cache_read_input_tokens":226093,"cache_creation_input_tokens":1237,"cache_creation":{"ephemeral_5m_input_tokens":1237,"ephemeral_1h_input_tokens":0},"type":"message"}],"speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_01HFKbA4xCHuqsWh5MSY4qTh":{"file_path":"C:\\Users\\User\\mcp-servers\\cuore\\services\\systems_map_bridge.py"}},"serverClassifierRequest":"e92bb1ba-3e17-4b2b-86c2-9cf8738882f1","apiBlockIndex":1,"requestId":"req_011Cfqgfxmytc9VM6ArPZzoW","attributionAgent":"general-purpose","type":"assistant","uuid":"44e9c806-9412-409b-b969-68f1b26c9a6e","timestamp":"2026-10-09T00:04:13.284Z","effort":"high","perTurnEffort":null,"userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
{"parentUuid":"44e9c806-9412-409b-b969-68f1b26c9a6e","isSidechain":true,"promptId":"a52e3861-ecd8-45c9-a2f4-07d75e01d791","agentId":"acb0e47c9637c321b","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01HFKbA4xCHuqsWh5MSY4qTh","type":"tool_result","content":"1\t\"\"\"``GET /api/systems/{vin}/state`` -- live per-system state, hot edges and\n2\tthe session timeline for the Systems map overlay (Phase 2 of the dive-in\n3\tplan, ``docs/research/SYSTEMS_DIVE_IN_PLAN_2026-10-08.md``).\n4\t\n5\tThree view-model pieces, each a thin derivation of data another bridge (or\n6\t``mes`` itself) already sources -- nothing here invents a system key, a\n7\tconfidence level or a status word that isn't already one of the existing\n8\tvocabularies:\n9\t\n10\t* :func:`system_states` -- per system key: ``state`` (one of\n11\t  ``ALLOWED_STATES``), ``open_code_count`` and ``codes``. Built the same way\n12\t  ``cuore.services.system_detail_bridge._dossier_codes_map`` already does\n13\t  (``mes_bridge.workup`` + ``dossier_bridge.build_view`` for the per-code\n14\t  ACTIVE/CLEARED_UNVERIFIED/STALE vocabulary -- the only place in\n15\t  ``cuore.services`` that computes it, per\n16\t  ``grep -l \"CLEARED_UNVERIFIED\" cuore/services``), aggregated up to\n17\t  whichever system ``systems_bridge.correlate``'s own ``by_system`` row\n18\t  already groups that code under. ``VERIFIED_CLEAN`` borrows the whole-car\n19\t  verdict (``dossier_bridge.build_view``'s own ``verdict.state``) only when\n20\t  a system's own open codes are all CLEARED_UNVERIFIED and the car-level\n21\t  verdict already reports a monitor-confirmed clean; ``NO_DATA`` is a\n22\t  system with no codes in this car's corpus at all.\n23\t* :func:`edges` -- co-occurrence pairs from ``systems_bridge.correlate``\n24\t  merged with the dependency table from ``systems_bridge.systems()``, so\n25\t  every edge the map can draw carries ``lift``/``sessions_together`` (0/None\n26\t  when the corpus has no evidence yet) alongside ``confidence``/``source``.\n27\t  Never worded \"depends on\": a pure co-occurrence pair with no dependency\n28\t  edge gets ``kind=\"co-occurrence\"`` and a plain \"corpus co-occurrence\"\n29\t  source, no prose ``why`` at all.\n30\t* :func:`sessions` -- one row per session (MES log file) ordered by time,\n31\t  each the systems that session's codes implicated, built the same way\n32\t  ``mes.systems.correlate`` builds its own internal (never-returned)\n33\t  ``session_systems``: ``mes.analysis.dtc_history`` occurrences grouped by\n34\t  file, primary systems via the public ``mes.systems.systems_for_code``.\n35\t\n36\tRead-only: nothing here writes state.\n37\t\"\"\"\n38\t\n39\tfrom __future__ import annotations\n40\t\n41\tfrom typing import Any\n42\t\n43\tfrom .. import bootstrap  # noqa: F401 -- side effect: puts `mes` on sys.path\n44\t\n45\tfrom datetime import datetime\n46\t\n47\tfrom . import dossier_bridge, mes_bridge, systems_bridge\n48\t\n49\tfrom mes import analysis as analysis_mod  # noqa: E402\n50\tfrom mes import systems as systems_mod  # noqa: E402\n51\t\n52\tfrom ..live import poller as poller_mod  # noqa: E402\n53\t\n54\ttry:\n55\t    from . import liveboard_bridge\n56\texcept Exception:  # noqa: BLE001 -- the map's state must still render without it\n57\t    liveboard_bridge = None\n58\t\n59\ttry:\n60\t    from . import bench_bridge\n61\texcept Exception:  # noqa: BLE001\n62\t    bench_bridge = None\n63\t\n64\ttry:\n65\t    from . import jobs_bridge\n66\texcept Exception:  # noqa: BLE001\n67\t    jobs_bridge = None\n68\t\n69\t#: The map's five-state vocabulary -- a superset of the per-code\n70\t#: ACTIVE/CLEARED_UNVERIFIED/STALE words dossier_bridge already uses, plus\n71\t#: NO_DATA (never any code) and VERIFIED_CLEAN (borrowed from the car-level\n72\t#: verdict, see system_states' docstring).\n73\tALLOWED_STATES = (\"ACTIVE\", \"CLEARED_UNVERIFIED\", \"STALE\", \"NO_DATA\", \"VERIFIED_CLEAN\")\n74\t\n75\t#: Same wording ``systems_mod._dep``'s own UNKNOWN-confidence note uses --\n76\t#: restated here (not imported, that note is a private module constant) so\n77\t#: an edge with no sourced confidence still names the real reason plainly.\n78\t_UNKNOWN_SOURCE = \"not established in any source checked -- use the service manual (TechAuthority)\"\n79\t\n80\t\n81\t# --- small helpers -----------------------------------------------------------\n82\t\n83\tdef _all_systems() -> dict[str, dict[str, Any]]:\n84\t    try:\n85\t        raw = systems_bridge.systems()\n86\t    except Exception:  # noqa: BLE001 -- a knowledge-table miss must never 500\n87\t        raw = {}\n88\t    if isinstance(raw, dict):\n89\t        return raw\n90\t    return {s.get(\"key\"): s for s in (raw or []) if s.get(\"key\")}\n91\t\n92\t\n93\tdef _correlate(vin: str) -> dict[str, Any]:\n94\t    try:\n95\t        corr = systems_bridge.correlate(vin)\n96\t    except Exception:  # noqa: BLE001\n97\t        return {}\n98\t    if not isinstance(corr, dict) or corr.get(\"error\"):\n99\t        return {}\n100\t    return corr\n101\t\n102\t\n103\tdef _dossier_view(vin: str) -> dict[str, Any]:\n104\t    try:\n105\t        dossier = mes_bridge.workup(vin=vin)\n106\t        return dossier_bridge.build_view(vin, dossier, None) or {}\n107\t    except Exception:  # noqa: BLE001\n108\t        return {}\n109\t\n110\t\n111\tdef _edge_kind(dep: dict[str, Any]) -> str:\n112\t    \"\"\"\"electrical supply\" vs \"functional\" vs \"UNKNOWN\" -- same reading as\n113\t    ``system_detail_bridge._edge_kind``, from the edge's own\n114\t    ``technical.carries`` note, never a guess beyond that note's words.\"\"\"\n115\t    if dep.get(\"system\") == \"electrical_supply\":\n116\t        return \"electrical supply\"\n117\t    carries = ((dep.get(\"technical\") or {}).get(\"carries\") or \"\").lower()\n118\t    if any(w in carries for w in (\"volt\", \"supply\", \"ground\", \"current\", \"12 v\", \"amp\")):\n119\t        return \"electrical supply\"\n120\t    if carries or dep.get(\"why\"):\n121\t        return \"functional\"\n122\t    return \"UNKNOWN\"\n123\t\n124\t\n125\t# --- 1. per-system state -------------------------------------------------------\n126\t\n127\tdef system_states(vin: str) -> dict[str, dict[str, Any]]:\n128\t    \"\"\"Every system key (even one with zero data for this VIN) ->\n129\t    ``{state, open_code_count, codes}``. ``codes`` is the list of base DTCs\n130\t    this VIN's corpus assigns to the system as a primary (see\n131\t    ``systems_bridge.correlate``'s own ``by_system`` rows).\"\"\"\n132\t    all_systems = _all_systems()\n133\t    corr = _correlate(vin)\n134\t    by_system = {r.get(\"system\"): r for r in (corr.get(\"by_system\") or [])}\n135\t    view = _dossier_view(vin)\n136\t    dossier_codes = {r.get(\"code\"): r for r in (view.get(\"codes\") or [])}\n137\t    verdict_state = (view.get(\"verdict\") or {}).get(\"state\")\n138\t\n139\t    out: dict[str, dict[str, Any]] = {}\n140\t    for key in all_systems:\n141\t        row = by_system.get(key) or {}\n142\t        statuses: list[str] = []\n143\t        codes_out: list[str] = []\n144\t        for full in row.get(\"codes\") or []:\n145\t            base = systems_mod.base_code(full)\n146\t            codes_out.append(base)\n147\t            drow = dossier_codes.get(base) or {}\n148\t            statuses.append(drow.get(\"status\") or \"STALE\")\n149\t\n150\t        if \"ACTIVE\" in statuses:\n151\t            state = \"ACTIVE\"\n152\t        elif \"CLEARED_UNVERIFIED\" in statuses:\n153\t            state = \"VERIFIED_CLEAN\" if verdict_state == \"VERIFIED_CLEAN\" else \"CLEARED_UNVERIFIED\"\n154\t        elif \"STALE\" in statuses:\n155\t            state = \"STALE\"\n156\t        else:\n157\t            state = \"NO_DATA\"\n158\t\n159\t        out[key] = {\n160\t            \"state\": state,\n161\t            \"open_code_count\": sum(1 for s in statuses if s in (\"ACTIVE\", \"CLEARED_UNVERIFIED\")),\n162\t            \"codes\": codes_out,\n163\t        }\n164\t    return out\n165\t\n166\t\n167\t# --- 2. edges ------------------------------------------------------------------\n168\t\n169\tdef edges(vin: str) -> list[dict[str, Any]]:\n170\t    \"\"\"Every dependency edge from the systems graph, plus every corpus\n171\t    co-occurrence pair with no matching dependency edge -- each carrying\n172\t    ``lift``/``sessions_together`` (0/None with no corpus evidence) and\n173\t    ``confidence``/``source``/``kind``. No prose ``why`` field: nothing here\n174\t    is ever worded \"depends on\".\"\"\"\n175\t    all_systems = _all_systems()\n176\t    corr = _correlate(vin)\n177\t    co_by_pair: dict[frozenset, dict[str, Any]] = {}\n178\t    for row in corr.get(\"co_occurrence\") or []:\n179\t        a, b = row.get(\"a\"), row.get(\"b\")\n180\t        if a and b:\n181\t            co_by_pair[frozenset((a, b))] = row\n182\t\n183\t    out: list[dict[str, Any]] = []\n184\t    seen_pairs: set[frozenset] = set()\n185\t\n186\t    for a_key, rec in all_systems.items():\n187\t        for dep in rec.get(\"depends_on\") or []:\n188\t            b_key = dep.get(\"system\")\n189\t            if not b_key:\n190\t                continue\n191\t            pair = frozenset((a_key, b_key))\n192\t            co = co_by_pair.get(pair)\n193\t            out.append({\n194\t                \"a\": a_key, \"b\": b_key,\n195\t                \"lift\": co.get(\"lift\") if co else None,\n196\t                \"sessions_together\": co.get(\"sessions_together\") if co else 0,\n197\t                \"confidence\": (dep.get(\"confidence\") or \"UNKNOWN\").upper(),\n198\t                \"source\": dep.get(\"source\") or _UNKNOWN_SOURCE,\n199\t                \"kind\": _edge_kind(dep),\n200\t            })\n201\t            seen_pairs.add(pair)\n202\t\n203\t    for pair, row in co_by_pair.items():\n204\t        if pair in seen_pairs:\n205\t            continue\n206\t        out.append({\n207\t            \"a\": row.get(\"a\"), \"b\": row.get(\"b\"),\n208\t            \"lift\": row.get(\"lift\"),\n209\t            \"sessions_together\": row.get(\"sessions_together\") or 0,\n210\t            \"confidence\": \"UNKNOWN\",\n211\t            \"source\": \"corpus co-occurrence, this VIN only -- not a dependency\",\n212\t            \"kind\": \"co-occurrence\",\n213\t        })\n214\t    return out\n215\t\n216\t\n217\t# --- 3. session timeline --------------------------------------------------------\n218\t\n219\tdef sessions(vin: str) -> list[dict[str, Any]]:\n220\t    \"\"\"One row per session (MES log file) this VIN's corpus has, ordered by\n221\t    time: ``{id, when, systems_fired}``. Rebuilt from the same inputs\n222\t    ``mes.systems.correlate`` uses for its own internal ``session_systems``\n223\t    (that function never returns the per-session shape, only aggregates).\"\"\"\n224\t    try:\n225\t        history = analysis_mod.dtc_history(vin=vin)\n226\t    except Exception:  # noqa: BLE001\n227\t        history = {}\n228\t    if not history:\n229\t        return []\n230\t\n231\t    session_codes: dict[str, set[str]] = {}\n232\t    session_when: dict[str, str] = {}\n233\t    for code, rec in history.items():\n234\t        for occ in rec.occurrences:\n235\t            fname = occ.get(\"file\")\n236\t            if not fname:\n237\t                continue\n238\t            session_codes.setdefault(fname, set()).add(code)\n239\t            ts = occ.get(\"timestamp\")\n240\t            if ts and (fname not in session_when or ts < session_when[fname]):\n241\t                session_when[fname] = ts\n242\t\n243\t    rows: list[dict[str, Any]] = []\n244\t    for fname, codes in session_codes.items():\n245\t        fired: set[str] = set()\n246\t        for code in codes:\n247\t            descr = (history[code].descriptions or [\"\"])[0]\n248\t            for entry in systems_mod.systems_for_code(code, descr):\n249\t                if entry.get(\"role\") == \"primary\" and entry.get(\"system\") != \"UNKNOWN\":\n250\t                    fired.add(entry[\"system\"])\n251\t        rows.append({\"id\": fname, \"when\": session_when.get(fname),\n252\t                     \"systems_fired\": sorted(fired)})\n253\t    rows.sort(key=lambda r: r.get(\"when\") or \"\")\n254\t    return rows\n255\t\n256\t\n257\t# --- the whole view model -------------------------------------------------------\n258\t\n259\tdef build_state(vin: str) -> dict[str, Any]:\n260\t    \"\"\"Everything ``GET /api/systems/{vin}/state`` returns.\"\"\"\n261\t    return {\"systems\": system_states(vin), \"edges\": edges(vin), \"sessions\": sessions(vin)}\n262\t\n263\t\n264\t# ===========================================================================\n265\t# 4. live overlay -- Phase 4 (GET /api/systems/{vin}/live)\n266\t# ===========================================================================\n267\t#\n268\t# Everything below reuses the Live board's own wiring instead of growing a\n269\t# second one: ``liveboard_bridge.evaluate``'s ok/moderate/excessive/unknown\n270\t# vocabulary for the grade, ``liveboard_bridge.channel_system`` for which\n271\t# system a channel belongs to (``mes.systems.SYSTEMS[*][\"live_channels\"]``,\n272\t# first system to claim a channel wins -- never re-decided here), and the\n273\t# process-wide ``cuore.live.poller`` the Live board's own SSE route already\n274\t# reads. ``\"none\"`` is this overlay's own word, not the Live board's --\n275\t# the Live board itself only ever renders while a session is already\n276\t# active, so it never needed a \"nothing to grade\" grade.\n277\t\n278\t#: Same ranking the Live board itself piles excessive-first with\n279\t#: (``liveboard_bridge._LEVEL_ORDER``), restated here (not imported, that\n280\t#: ordering is a private module constant) plus \"none\" ranked last of all --\n281\t#: no live session beats \"unknown\", it's simply not graded.\n282\t_LIVE_GRADE_RANK: dict[str, int] = {\"excessive\": 0, \"moderate\": 1, \"unknown\": 2,\n283\t                                    \"ok\": 3, \"none\": 4}\n284\t\n285\t\n286\tdef _live_channels_by_system() -> dict[str, list[str]]:\n287\t    \"\"\"system key -> the ``can_c`` live channel ids it owns, the same\n288\t    first-claim ownership :func:`liveboard_bridge.channel_system` already\n289\t    decides -- grouped the other way round, never re-decided here.\"\"\"\n290\t    out: dict[str, list[str]] = {}\n291\t    if liveboard_bridge is None:\n292\t        return out\n293\t    try:\n294\t        from ..live import channels as channels_mod\n295\t        channels = [c.id for c in channels_mod.available_channels() if c.bus == \"can_c\"]\n296\t    except Exception:  # noqa: BLE001\n297\t        return out\n298\t    for cid in channels:\n299\t        sys_key = liveboard_bridge.channel_system(cid)\n300\t        if sys_key:\n301\t            out.setdefault(sys_key, []).append(cid)\n302\t    return out\n303\t\n304\t\n305\tdef _scanner_label(active: bool) -> str:\n306\t    \"\"\"\"Scanner: Connected\" / \"Scanner: Not running\" -- the same human\n307\t    vocabulary ``cuore.services.bench_bridge.LABELS[\"mes_state\"]`` already\n308\t    speaks for the live strip elsewhere on this app, never a new word\n309\t    invented for this overlay. ``active`` is the live poller's own\n310\t    ``is_active()`` -- a live-data session genuinely polling the car, not\n311\t    the (distinct) MultiEcuScan-connected state ``bench_bridge`` itself\n312\t    tracks.\"\"\"\n313\t    labels = bench_bridge.LABELS[\"mes_state\"] if bench_bridge else {}\n314\t    key = \"connected\" if active else \"not_running\"\n315\t    return f\"Scanner: {labels.get(key, 'Unknown')}\"\n316\t\n317\t\n318\tdef _on_new_live_codes(vin: str) -> None:\n319\t    \"\"\"A brand-new live code never writes to the car -- it only wakes the\n320\t    two other surfaces so Bench, Job and Systems agree on it:\n321\t\n322\t    * the Job page's own suggestion pipeline\n323\t      (:func:`cuore.services.jobs_bridge.suggested_hypotheses`) is called\n324\t      here, not re-implemented -- it is already what builds the hypothesis\n325\t      ledger's suggested cards from this car's current dossier view, so\n326\t      calling it is what \"wakes\" that ledger rather than a parallel\n327\t      DTC-to-hypothesis builder living in this module too.\n328\t    * :func:`cuore.services.bench_bridge.regenerate_for_live_codes` drops\n329\t      Bench's small memo cache so its next-action is rebuilt rather than\n330\t      served stale.\n331\t\n332\t    Best-effort only: a hiccup in either must never break\n333\t    ``GET /api/systems/{vin}/live`` itself.\n334\t    \"\"\"\n335\t    try:\n336\t        if jobs_bridge is not None:\n337\t            jobs_bridge.suggested_hypotheses(vin, _dossier_view(vin))\n338\t    except Exception:  # noqa: BLE001\n339\t        pass\n340\t    try:\n341\t        if bench_bridge is not None:\n342\t            bench_bridge.regenerate_for_live_codes(vin)\n343\t    except Exception:  # noqa: BLE001\n344\t        pass\n345\t\n346\t\n347\tdef new_live_codes(vin: str) -> list[dict[str, Any]]:\n348\t    \"\"\"DTCs the live poller's Monitor-DTCs read (Mode 03/07) currently\n349\t    carries that this VIN's own :func:`system_states` does not carry yet --\n350\t    i.e. a code the car just threw, before any MES log backs it.\n351\t\n352\t    Each entry: ``{\"code\", \"systems\" (the mes.systems primary-role systems\n353\t    for that code), \"since\" (the poller's own ``dtc_snapshot()``\n354\t    first-seen timestamp for it, this session)}``. Never reports the same\n355\t    code twice across calls within one \"new\" window is not tracked here --\n356\t    a code already present in :func:`system_states` (true once the car's\n357\t    own corpus/dossier has picked it up) simply stops qualifying as new.\n358\t\n359\t    Calling this (whenever it finds anything) also runs\n360\t    :func:`_on_new_live_codes` once per call with results -- see that\n361\t    function's own docstring.\n362\t    \"\"\"\n363\t    poller = poller_mod.poller()\n364\t    live = poller.dtc_snapshot()\n365\t    codes = live.get(\"codes\") or []\n366\t    if not codes:\n367\t        return []\n368\t\n369\t    known: set[str] = set()\n370\t    for row in system_states(vin).values():\n371\t        known.update(row.get(\"codes\") or [])\n372\t\n373\t    first_seen = live.get(\"first_seen\") or {}\n374\t    now_iso = datetime.now().isoformat(timespec=\"seconds\")\n375\t    out: list[dict[str, Any]] = []\n376\t    seen_here: set[str] = set()\n377\t    for code in codes:\n378\t        base = systems_mod.base_code(code)\n379\t        if base in known or base in seen_here:\n380\t            continue\n381\t        seen_here.add(base)\n382\t        systems_hit = sorted({\n383\t            e[\"system\"] for e in systems_mod.systems_for_code(base, \"\")\n384\t            if e.get(\"role\") == \"primary\" and e.get(\"system\") not in (None, \"UNKNOWN\")\n385\t        })\n386\t        out.append({\"code\": base, \"systems\": systems_hit,\n387\t                   \"since\": first_seen.get(code) or now_iso})\n388\t\n389\t    if out:\n390\t        _on_new_live_codes(vin)\n391\t    return out\n392\t\n393\t\n394\tdef live_state(vin: str) -> dict[str, Any]:\n395\t    \"\"\"``GET /api/systems/{vin}/live``'s whole body: an honest scanner\n396\t    status, every system key's worst live colour grade (plus the value/\n397\t    unit/channel backing that grade), and any brand-new DTC the live\n398\t    poller has just seen (see :func:`new_live_codes`).\n399\t\n400\t    No live session running: every system grades ``\"none\"`` and\n401\t    ``scanner`` names it plainly (:func:`_scanner_label`) -- never a\n402\t    fabricated \"ok\".\n403\t    \"\"\"\n404\t    poller = poller_mod.poller()\n405\t    active = poller.is_active()\n406\t    scanner = _scanner_label(active)\n407\t\n408\t    all_systems = _all_systems()\n409\t    by_system = _live_channels_by_system()\n410\t    systems_out: dict[str, dict[str, Any]] = {}\n411\t\n412\t    snap_channels: dict[str, Any] = {}\n413\t    if active and liveboard_bridge is not None:\n414\t        snap_channels = poller.snapshot().get(\"channels\", {})\n415\t\n416\t    for key in all_systems:\n417\t        best: tuple[int, str, str, Any, str] | None = None\n418\t        if active and liveboard_bridge is not None:\n419\t            for cid in by_system.get(key, []):\n420\t                row = snap_channels.get(cid)\n421\t                if row is None or row.get(\"value\") is None:\n422\t                    continue\n423\t                ev = liveboard_bridge.evaluate(cid, row[\"value\"])\n424\t                rank = _LIVE_GRADE_RANK.get(ev[\"level\"], 9)\n425\t                if best is None or rank < best[0]:\n426\t                    best = (rank, ev[\"level\"], cid, row[\"value\"], row.get(\"unit\", \"\"))\n427\t        if best is None:\n428\t            systems_out[key] = {\"grade\": \"none\", \"value\": None, \"unit\": None, \"channel\": None}\n429\t        else:\n430\t            _, grade, cid, value, unit = best\n431\t            systems_out[key] = {\"grade\": grade, \"value\": value, \"unit\": unit, \"channel\": cid}\n432\t\n433\t    new_codes = new_live_codes(vin) if active else []\n434\t\n435\t    return {\"active\": active, \"scanner\": scanner, \"systems\": systems_out,\n436\t            \"new_codes\": new_codes}\n437\t\n438\t\n439\t__all__ = [\"ALLOWED_STATES\", \"system_states\", \"edges\", \"sessions\", \"build_state\",\n440\t          \"new_live_codes\", \"live_state\"]\n441\t"}]},"uuid":"a0b451dc-7758-4f7c-8fc1-5c8c89b0037f","timestamp":"2026-10-09T00:04:13.326Z","toolUseResult":{"type":"text","file":{"filePath":"C:\\Users\\User\\mcp-servers\\cuore\\services\\systems_map_bridge.py","content":"\"\"\"``GET /api/systems/{vin}/state`` -- live per-system state, hot edges and\nthe session timeline for the Systems map overlay (Phase 2 of the dive-in\nplan, ``docs/research/SYSTEMS_DIVE_IN_PLAN_2026-10-08.md``).\n\nThree view-model pieces, each a thin derivation of data another bridge (or\n``mes`` itself) already sources -- nothing here invents a system key, a\nconfidence level or a status word that isn't already one of the existing\nvocabularies:\n\n* :func:`system_states` -- per system key: ``state`` (one of\n  ``ALLOWED_STATES``), ``open_code_count`` and ``codes``. Built the same way\n  ``cuore.services.system_detail_bridge._dossier_codes_map`` already does\n  (``mes_bridge.workup`` + ``dossier_bridge.build_view`` for the per-code\n  ACTIVE/CLEARED_UNVERIFIED/STALE vocabulary -- the only place in\n  ``cuore.services`` that computes it, per\n  ``grep -l \"CLEARED_UNVERIFIED\" cuore/services``), aggregated up to\n  whichever system ``systems_bridge.correlate``'s own ``by_system`` row\n  already groups that code under. ``VERIFIED_CLEAN`` borrows the whole-car\n  verdict (``dossier_bridge.build_view``'s own ``verdict.state``) only when\n  a system's own open codes are all CLEARED_UNVERIFIED and the car-level\n  verdict already reports a monitor-confirmed clean; ``NO_DATA`` is a\n  system with no codes in this car's corpus at all.\n* :func:`edges` -- co-occurrence pairs from ``systems_bridge.correlate``\n  merged with the dependency table from ``systems_bridge.systems()``, so\n  every edge the map can draw carries ``lift``/``sessions_together`` (0/None\n  when the corpus has no evidence yet) alongside ``confidence``/``source``.\n  Never worded \"depends on\": a pure co-occurrence pair with no dependency\n  edge gets ``kind=\"co-occurrence\"`` and a plain \"corpus co-occurrence\"\n  source, no prose ``why`` at all.\n* :func:`sessions` -- one row per session (MES log file) ordered by time,\n  each the systems that session's codes implicated, built the same way\n  ``mes.systems.correlate`` builds its own internal (never-returned)\n  ``session_systems``: ``mes.analysis.dtc_history`` occurrences grouped by\n  file, primary systems via the public ``mes.systems.systems_for_code``.\n\nRead-only: nothing here writes state.\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom typing import Any\n\nfrom .. import bootstrap  # noqa: F401 -- side effect: puts `mes` on sys.path\n\nfrom datetime import datetime\n\nfrom . import dossier_bridge, mes_bridge, systems_bridge\n\nfrom mes import analysis as analysis_mod  # noqa: E402\nfrom mes import systems as systems_mod  # noqa: E402\n\nfrom ..live import poller as poller_mod  # noqa: E402\n\ntry:\n    from . import liveboard_bridge\nexcept Exception:  # noqa: BLE001 -- the map's state must still render without it\n    liveboard_bridge = None\n\ntry:\n    from . import bench_bridge\nexcept Exception:  # noqa: BLE001\n    bench_bridge = None\n\ntry:\n    from . import jobs_bridge\nexcept Exception:  # noqa: BLE001\n    jobs_bridge = None\n\n#: The map's five-state vocabulary -- a superset of the per-code\n#: ACTIVE/CLEARED_UNVERIFIED/STALE words dossier_bridge already uses, plus\n#: NO_DATA (never any code) and VERIFIED_CLEAN (borrowed from the car-level\n#: verdict, see system_states' docstring).\nALLOWED_STATES = (\"ACTIVE\", \"CLEARED_UNVERIFIED\", \"STALE\", \"NO_DATA\", \"VERIFIED_CLEAN\")\n\n#: Same wording ``systems_mod._dep``'s own UNKNOWN-confidence note uses --\n#: restated here (not imported, that note is a private module constant) so\n#: an edge with no sourced confidence still names the real reason plainly.\n_UNKNOWN_SOURCE = \"not established in any source checked -- use the service manual (TechAuthority)\"\n\n\n# --- small helpers -----------------------------------------------------------\n\ndef _all_systems() -> dict[str, dict[str, Any]]:\n    try:\n        raw = systems_bridge.systems()\n    except Exception:  # noqa: BLE001 -- a knowledge-table miss must never 500\n        raw = {}\n    if isinstance(raw, dict):\n        return raw\n    return {s.get(\"key\"): s for s in (raw or []) if s.get(\"key\")}\n\n\ndef _correlate(vin: str) -> dict[str, Any]:\n    try:\n        corr = systems_bridge.correlate(vin)\n    except Exception:  # noqa: BLE001\n        return {}\n    if not isinstance(corr, dict) or corr.get(\"error\"):\n        return {}\n    return corr\n\n\ndef _dossier_view(vin: str) -> dict[str, Any]:\n    try:\n        dossier = mes_bridge.workup(vin=vin)\n        return dossier_bridge.build_view(vin, dossier, None) or {}\n    except Exception:  # noqa: BLE001\n        return {}\n\n\ndef _edge_kind(dep: dict[str, Any]) -> str:\n    \"\"\"\"electrical supply\" vs \"functional\" vs \"UNKNOWN\" -- same reading as\n    ``system_detail_bridge._edge_kind``, from the edge's own\n    ``technical.carries`` note, never a guess beyond that note's words.\"\"\"\n    if dep.get(\"system\") == \"electrical_supply\":\n        return \"electrical supply\"\n    carries = ((dep.get(\"technical\") or {}).get(\"carries\") or \"\").lower()\n    if any(w in carries for w in (\"volt\", \"supply\", \"ground\", \"current\", \"12 v\", \"amp\")):\n        return \"electrical supply\"\n    if carries or dep.get(\"why\"):\n        return \"functional\"\n    return \"UNKNOWN\"\n\n\n# --- 1. per-system state -------------------------------------------------------\n\ndef system_states(vin: str) -> dict[str, dict[str, Any]]:\n    \"\"\"Every system key (even one with zero data for this VIN) ->\n    ``{state, open_code_count, codes}``. ``codes`` is the list of base DTCs\n    this VIN's corpus assigns to the system as a primary (see\n    ``systems_bridge.correlate``'s own ``by_system`` rows).\"\"\"\n    all_systems = _all_systems()\n    corr = _correlate(vin)\n    by_system = {r.get(\"system\"): r for r in (corr.get(\"by_system\") or [])}\n    view = _dossier_view(vin)\n    dossier_codes = {r.get(\"code\"): r for r in (view.get(\"codes\") or [])}\n    verdict_state = (view.get(\"verdict\") or {}).get(\"state\")\n\n    out: dict[str, dict[str, Any]] = {}\n    for key in all_systems:\n        row = by_system.get(key) or {}\n        statuses: list[str] = []\n        codes_out: list[str] = []\n        for full in row.get(\"codes\") or []:\n            base = systems_mod.base_code(full)\n            codes_out.append(base)\n            drow = dossier_codes.get(base) or {}\n            statuses.append(drow.get(\"status\") or \"STALE\")\n\n        if \"ACTIVE\" in statuses:\n            state = \"ACTIVE\"\n        elif \"CLEARED_UNVERIFIED\" in statuses:\n            state = \"VERIFIED_CLEAN\" if verdict_state == \"VERIFIED_CLEAN\" else \"CLEARED_UNVERIFIED\"\n        elif \"STALE\" in statuses:\n            state = \"STALE\"\n        else:\n            state = \"NO_DATA\"\n\n        out[key] = {\n            \"state\": state,\n            \"open_code_count\": sum(1 for s in statuses if s in (\"ACTIVE\", \"CLEARED_UNVERIFIED\")),\n            \"codes\": codes_out,\n        }\n    return out\n\n\n# --- 2. edges ------------------------------------------------------------------\n\ndef edges(vin: str) -> list[dict[str, Any]]:\n    \"\"\"Every dependency edge from the systems graph, plus every corpus\n    co-occurrence pair with no matching dependency edge -- each carrying\n    ``lift``/``sessions_together`` (0/None with no corpus evidence) and\n    ``confidence``/``source``/``kind``. No prose ``why`` field: nothing here\n    is ever worded \"depends on\".\"\"\"\n    all_systems = _all_systems()\n    corr = _correlate(vin)\n    co_by_pair: dict[frozenset, dict[str, Any]] = {}\n    for row in corr.get(\"co_occurrence\") or []:\n        a, b = row.get(\"a\"), row.get(\"b\")\n        if a and b:\n            co_by_pair[frozenset((a, b))] = row\n\n    out: list[dict[str, Any]] = []\n    seen_pairs: set[frozenset] = set()\n\n    for a_key, rec in all_systems.items():\n        for dep in rec.get(\"depends_on\") or []:\n            b_key = dep.get(\"system\")\n            if not b_key:\n                continue\n            pair = frozenset((a_key, b_key))\n            co = co_by_pair.get(pair)\n            out.append({\n                \"a\": a_key, \"b\": b_key,\n                \"lift\": co.get(\"lift\") if co else None,\n                \"sessions_together\": co.get(\"sessions_together\") if co else 0,\n                \"confidence\": (dep.get(\"confidence\") or \"UNKNOWN\").upper(),\n                \"source\": dep.get(\"source\") or _UNKNOWN_SOURCE,\n                \"kind\": _edge_kind(dep),\n            })\n            seen_pairs.add(pair)\n\n    for pair, row in co_by_pair.items():\n        if pair in seen_pairs:\n            continue\n        out.append({\n            \"a\": row.get(\"a\"), \"b\": row.get(\"b\"),\n            \"lift\": row.get(\"lift\"),\n            \"sessions_together\": row.get(\"sessions_together\") or 0,\n            \"confidence\": \"UNKNOWN\",\n            \"source\": \"corpus co-occurrence, this VIN only -- not a dependency\",\n            \"kind\": \"co-occurrence\",\n        })\n    return out\n\n\n# --- 3. session timeline --------------------------------------------------------\n\ndef sessions(vin: str) -> list[dict[str, Any]]:\n    \"\"\"One row per session (MES log file) this VIN's corpus has, ordered by\n    time: ``{id, when, systems_fired}``. Rebuilt from the same inputs\n    ``mes.systems.correlate`` uses for its own internal ``session_systems``\n    (that function never returns the per-session shape, only aggregates).\"\"\"\n    try:\n        history = analysis_mod.dtc_history(vin=vin)\n    except Exception:  # noqa: BLE001\n        history = {}\n    if not history:\n        return []\n\n    session_codes: dict[str, set[str]] = {}\n    session_when: dict[str, str] = {}\n    for code, rec in history.items():\n        for occ in rec.occurrences:\n            fname = occ.get(\"file\")\n            if not fname:\n                continue\n            session_codes.setdefault(fname, set()).add(code)\n            ts = occ.get(\"timestamp\")\n            if ts and (fname not in session_when or ts < session_when[fname]):\n                session_when[fname] = ts\n\n    rows: list[dict[str, Any]] = []\n    for fname, codes in session_codes.items():\n        fired: set[str] = set()\n        for code in codes:\n            descr = (history[code].descriptions or [\"\"])[0]\n            for entry in systems_mod.systems_for_code(code, descr):\n                if entry.get(\"role\") == \"primary\" and entry.get(\"system\") != \"UNKNOWN\":\n                    fired.add(entry[\"system\"])\n        rows.append({\"id\": fname, \"when\": session_when.get(fname),\n                     \"systems_fired\": sorted(fired)})\n    rows.sort(key=lambda r: r.get(\"when\") or \"\")\n    return rows\n\n\n# --- the whole view model -------------------------------------------------------\n\ndef build_state(vin: str) -> dict[str, Any]:\n    \"\"\"Everything ``GET /api/systems/{vin}/state`` returns.\"\"\"\n    return {\"systems\": system_states(vin), \"edges\": edges(vin), \"sessions\": sessions(vin)}\n\n\n# ===========================================================================\n# 4. live overlay -- Phase 4 (GET /api/systems/{vin}/live)\n# ===========================================================================\n#\n# Everything below reuses the Live board's own wiring instead of growing a\n# second one: ``liveboard_bridge.evaluate``'s ok/moderate/excessive/unknown\n# vocabulary for the grade, ``liveboard_bridge.channel_system`` for which\n# system a channel belongs to (``mes.systems.SYSTEMS[*][\"live_channels\"]``,\n# first system to claim a channel wins -- never re-decided here), and the\n# process-wide ``cuore.live.poller`` the Live board's own SSE route already\n# reads. ``\"none\"`` is this overlay's own word, not the Live board's --\n# the Live board itself only ever renders while a session is already\n# active, so it never needed a \"nothing to grade\" grade.\n\n#: Same ranking the Live board itself piles excessive-first with\n#: (``liveboard_bridge._LEVEL_ORDER``), restated here (not imported, that\n#: ordering is a private module constant) plus \"none\" ranked last of all --\n#: no live session beats \"unknown\", it's simply not graded.\n_LIVE_GRADE_RANK: dict[str, int] = {\"excessive\": 0, \"moderate\": 1, \"unknown\": 2,\n                                    \"ok\": 3, \"none\": 4}\n\n\ndef _live_channels_by_system() -> dict[str, list[str]]:\n    \"\"\"system key -> the ``can_c`` live channel ids it owns, the same\n    first-claim ownership :func:`liveboard_bridge.channel_system` already\n    decides -- grouped the other way round, never re-decided here.\"\"\"\n    out: dict[str, list[str]] = {}\n    if liveboard_bridge is None:\n        return out\n    try:\n        from ..live import channels as channels_mod\n        channels = [c.id for c in channels_mod.available_channels() if c.bus == \"can_c\"]\n    except Exception:  # noqa: BLE001\n        return out\n    for cid in channels:\n        sys_key = liveboard_bridge.channel_system(cid)\n        if sys_key:\n            out.setdefault(sys_key, []).append(cid)\n    return out\n\n\ndef _scanner_label(active: bool) -> str:\n    \"\"\"\"Scanner: Connected\" / \"Scanner: Not running\" -- the same human\n    vocabulary ``cuore.services.bench_bridge.LABELS[\"mes_state\"]`` already\n    speaks for the live strip elsewhere on this app, never a new word\n    invented for this overlay. ``active`` is the live poller's own\n    ``is_active()`` -- a live-data session genuinely polling the car, not\n    the (distinct) MultiEcuScan-connected state ``bench_bridge`` itself\n    tracks.\"\"\"\n    labels = bench_bridge.LABELS[\"mes_state\"] if bench_bridge else {}\n    key = \"connected\" if active else \"not_running\"\n    return f\"Scanner: {labels.get(key, 'Unknown')}\"\n\n\ndef _on_new_live_codes(vin: str) -> None:\n    \"\"\"A brand-new live code never writes to the car -- it only wakes the\n    two other surfaces so Bench, Job and Systems agree on it:\n\n    * the Job page's own suggestion pipeline\n      (:func:`cuore.services.jobs_bridge.suggested_hypotheses`) is called\n      here, not re-implemented -- it is already what builds the hypothesis\n      ledger's suggested cards from this car's current dossier view, so\n      calling it is what \"wakes\" that ledger rather than a parallel\n      DTC-to-hypothesis builder living in this module too.\n    * :func:`cuore.services.bench_bridge.regenerate_for_live_codes` drops\n      Bench's small memo cache so its next-action is rebuilt rather than\n      served stale.\n\n    Best-effort only: a hiccup in either must never break\n    ``GET /api/systems/{vin}/live`` itself.\n    \"\"\"\n    try:\n        if jobs_bridge is not None:\n            jobs_bridge.suggested_hypotheses(vin, _dossier_view(vin))\n    except Exception:  # noqa: BLE001\n        pass\n    try:\n        if bench_bridge is not None:\n            bench_bridge.regenerate_for_live_codes(vin)\n    except Exception:  # noqa: BLE001\n        pass\n\n\ndef new_live_codes(vin: str) -> list[dict[str, Any]]:\n    \"\"\"DTCs the live poller's Monitor-DTCs read (Mode 03/07) currently\n    carries that this VIN's own :func:`system_states` does not carry yet --\n    i.e. a code the car just threw, before any MES log backs it.\n\n    Each entry: ``{\"code\", \"systems\" (the mes.systems primary-role systems\n    for that code), \"since\" (the poller's own ``dtc_snapshot()``\n    first-seen timestamp for it, this session)}``. Never reports the same\n    code twice across calls within one \"new\" window is not tracked here --\n    a code already present in :func:`system_states` (true once the car's\n    own corpus/dossier has picked it up) simply stops qualifying as new.\n\n    Calling this (whenever it finds anything) also runs\n    :func:`_on_new_live_codes` once per call with results -- see that\n    function's own docstring.\n    \"\"\"\n    poller = poller_mod.poller()\n    live = poller.dtc_snapshot()\n    codes = live.get(\"codes\") or []\n    if not codes:\n        return []\n\n    known: set[str] = set()\n    for row in system_states(vin).values():\n        known.update(row.get(\"codes\") or [])\n\n    first_seen = live.get(\"first_seen\") or {}\n    now_iso = datetime.now().isoformat(timespec=\"seconds\")\n    out: list[dict[str, Any]] = []\n    seen_here: set[str] = set()\n    for code in codes:\n        base = systems_mod.base_code(code)\n        if base in known or base in seen_here:\n            continue\n        seen_here.add(base)\n        systems_hit = sorted({\n            e[\"system\"] for e in systems_mod.systems_for_code(base, \"\")\n            if e.get(\"role\") == \"primary\" and e.get(\"system\") not in (None, \"UNKNOWN\")\n        })\n        out.append({\"code\": base, \"systems\": systems_hit,\n                   \"since\": first_seen.get(code) or now_iso})\n\n    if out:\n        _on_new_live_codes(vin)\n    return out\n\n\ndef live_state(vin: str) -> dict[str, Any]:\n    \"\"\"``GET /api/systems/{vin}/live``'s whole body: an honest scanner\n    status, every system key's worst live colour grade (plus the value/\n    unit/channel backing that grade), and any brand-new DTC the live\n    poller has just seen (see :func:`new_live_codes`).\n\n    No live session running: every system grades ``\"none\"`` and\n    ``scanner`` names it plainly (:func:`_scanner_label`) -- never a\n    fabricated \"ok\".\n    \"\"\"\n    poller = poller_mod.poller()\n    active = poller.is_active()\n    scanner = _scanner_label(active)\n\n    all_systems = _all_systems()\n    by_system = _live_channels_by_system()\n    systems_out: dict[str, dict[str, Any]] = {}\n\n    snap_channels: dict[str, Any] = {}\n    if active and liveboard_bridge is not None:\n        snap_channels = poller.snapshot().get(\"channels\", {})\n\n    for key in all_systems:\n        best: tuple[int, str, str, Any, str] | None = None\n        if active and liveboard_bridge is not None:\n            for cid in by_system.get(key, []):\n                row = snap_channels.get(cid)\n                if row is None or row.get(\"value\") is None:\n                    continue\n                ev = liveboard_bridge.evaluate(cid, row[\"value\"])\n                rank = _LIVE_GRADE_RANK.get(ev[\"level\"], 9)\n                if best is None or rank < best[0]:\n                    best = (rank, ev[\"level\"], cid, row[\"value\"], row.get(\"unit\", \"\"))\n        if best is None:\n            systems_out[key] = {\"grade\": \"none\", \"value\": None, \"unit\": None, \"channel\": None}\n        else:\n            _, grade, cid, value, unit = best\n            systems_out[key] = {\"grade\": grade, \"value\": value, \"unit\": unit, \"channel\": cid}\n\n    new_codes = new_live_codes(vin) if active else []\n\n    return {\"active\": active, \"scanner\": scanner, \"systems\": systems_out,\n            \"new_codes\": new_codes}\n\n\n__all__ = [\"ALLOWED_STATES\", \"system_states\", \"edges\", \"sessions\", \"build_state\",\n          \"new_live_codes\", \"live_state\"]\n","numLines":441,"startLine":1,"totalLines":441}},"sourceToolAssistantUUID":"44e9c806-9412-409b-b969-68f1b26c9a6e","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
