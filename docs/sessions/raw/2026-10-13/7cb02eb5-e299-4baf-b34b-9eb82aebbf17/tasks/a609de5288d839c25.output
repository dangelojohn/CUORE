{"parentUuid":"6b7cd534-ecfb-4913-8c2a-abfb73217547","isSidechain":true,"agentId":"a609de5288d839c25","message":{"model":"claude-sonnet-5","id":"msg_011CfqFySAaEcGscabpWLXUy","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01FXke4xm9iypuJnyX7aNThg","name":"Read","input":{"file_path":"C:\\Users\\User\\mcp-servers\\cuore\\tests\\check_theme.py"},"caller":{"type":"direct"}}],"container":null,"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1303,"cache_read_input_tokens":111728,"output_tokens":75,"output_tokens_details":{"thinking_tokens":0},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":0,"ephemeral_5m_input_tokens":1303},"inference_geo":"not_available","iterations":[{"input_tokens":2,"output_tokens":75,"cache_read_input_tokens":111728,"cache_creation_input_tokens":1303,"cache_creation":{"ephemeral_5m_input_tokens":1303,"ephemeral_1h_input_tokens":0},"type":"message"}],"speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_01FXke4xm9iypuJnyX7aNThg":{"file_path":"C:\\Users\\User\\mcp-servers\\cuore\\tests\\check_theme.py"}},"serverClassifierRequest":"5fa1f390-dfd8-43fd-9338-c0bb4f179df4","apiBlockIndex":0,"requestId":"req_011CfqFyRtTnHLj37th28fp7","attributionAgent":"general-purpose","type":"assistant","uuid":"0c77ce3d-3425-401e-8424-0ebd80a6fe10","timestamp":"2026-10-08T18:40:19.591Z","effort":"high","perTurnEffort":null,"userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
{"parentUuid":"0c77ce3d-3425-401e-8424-0ebd80a6fe10","isSidechain":true,"promptId":"b3340351-6fa9-464b-9a18-f32c9f337aa6","agentId":"a609de5288d839c25","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01FXke4xm9iypuJnyX7aNThg","type":"tool_result","content":"1\t\"\"\"Checks for the Emphasis pass (cuore.css's appended \"Emphasis pass\"\n2\tsection, on top of the Marque theme below it; _vbar.html's hero band;\n3\tjob.html's .step-title headings).\n4\t\n5\tSame posture as check_jobs_page.py: a real uvicorn server on a throwaway\n6\tCUORE_STATE_DIR, the Stelvio (VIN below, real corpus) as the fixture vehicle,\n7\theadless Edge driven over CDP for anything that needs actual layout (font\n8\tsize, overflow, element presence) rather than just HTML text.\n9\t\n10\tFour checks, matching the owner's brief exactly:\n11\t  1. Body computed font-size is >= 17px (job page).\n12\t  2. The hero shows the verdict state text (.hero-verdict-state, non-empty)\n13\t     on both the job page and the dossier page.\n14\t  3. The hero's key-figures row renders at least two figures\n15\t     (.hero-figure) for VIN ZASFAKPN5J7B88115.\n16\t  4. No page-level horizontal overflow at 400px on the job page.\n17\t\n18\tAlso writes two screenshots to the scratchpad for a one-time visual read:\n19\tjob_1400.png (wide, dark) and job_400.png (narrow) -- capped at two per the\n20\tlow-memory environment; Edge is always killed via _edge_cleanup after.\n21\t\n22\tRun:\n23\t    .venv/Scripts/python.exe cuore/tests/check_theme.py\n24\t\"\"\"\n25\t\n26\tfrom __future__ import annotations\n27\t\n28\timport base64\n29\timport itertools\n30\timport json\n31\timport os\n32\timport socket\n33\timport subprocess\n34\timport sys\n35\timport tempfile\n36\timport time\n37\timport urllib.parse\n38\timport urllib.request\n39\tfrom pathlib import Path\n40\t\n41\tos.environ[\"CUORE_STATE_DIR\"] = tempfile.mkdtemp(prefix=\"cuore-check-theme-\")\n42\tos.environ.pop(\"CUORE_AUDIT_PATH\", None)\n43\t\n44\tROOT = Path(__file__).resolve().parents[2]\n45\tsys.path.insert(0, str(ROOT))\n46\t\n47\tVIN = \"ZASFAKPN5J7B88115\"  # the Stelvio -- real corpus, chronic P0455/P0440/P0456\n48\t\n49\tEDGE_CANDIDATES = [\n50\t    r\"C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe\",\n51\t    r\"C:\\Program Files\\Microsoft\\Edge\\Application\\msedge.exe\",\n52\t]\n53\tSCRATCHPAD = Path(r\"C:\\Users\\User\\AppData\\Local\\Temp\\claude\\C--Users-User\"\n54\t                  r\"\\7cb02eb5-e299-4baf-b34b-9eb82aebbf17\\scratchpad\")\n55\t\n56\tfailures: list[str] = []\n57\tchecks = 0\n58\t\n59\t\n60\tdef check(label: str, cond: bool, detail: str = \"\") -> None:\n61\t    global checks\n62\t    checks += 1\n63\t    if not cond:\n64\t        failures.append(f\"{label}{(' -- ' + detail) if detail else ''}\")\n65\t\n66\t\n67\tdef find_edge() -> str:\n68\t    for candidate in EDGE_CANDIDATES:\n69\t        if Path(candidate).exists():\n70\t            return candidate\n71\t    return \"\"\n72\t\n73\t\n74\tdef free_port() -> int:\n75\t    s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)\n76\t    s.bind((\"127.0.0.1\", 0))\n77\t    port = s.getsockname()[1]\n78\t    s.close()\n79\t    return port\n80\t\n81\t\n82\tclass CDP:\n83\t    def __init__(self, ws_url: str) -> None:\n84\t        from websockets.sync.client import connect\n85\t        self.ws = connect(ws_url, max_size=None, open_timeout=20)\n86\t        self._ids = itertools.count(1)\n87\t\n88\t    def send(self, method: str, params: dict | None = None, timeout: float = 20):\n89\t        msg_id = next(self._ids)\n90\t        self.ws.send(json.dumps({\"id\": msg_id, \"method\": method, \"params\": params or {}}))\n91\t        deadline = time.time() + timeout\n92\t        while time.time() < deadline:\n93\t            raw = self.ws.recv(timeout=max(0.1, deadline - time.time()))\n94\t            msg = json.loads(raw)\n95\t            if msg.get(\"id\") == msg_id:\n96\t                if \"error\" in msg:\n97\t                    raise RuntimeError(f\"CDP {method} failed: {msg['error']}\")\n98\t                return msg.get(\"result\", {})\n99\t        raise TimeoutError(f\"CDP {method} timed out waiting for response\")\n100\t\n101\t    def close(self) -> None:\n102\t        try:\n103\t            self.ws.close()\n104\t        except Exception:\n105\t            pass\n106\t\n107\t    def eval_value(self, expr: str):\n108\t        out = self.send(\"Runtime.evaluate\", {\"expression\": expr, \"returnByValue\": True})\n109\t        return out.get(\"result\", {}).get(\"value\")\n110\t\n111\t\n112\tdef wait_for_devtools(port: int, timeout: float = 20) -> None:\n113\t    deadline = time.time() + timeout\n114\t    last_err: Exception | None = None\n115\t    while time.time() < deadline:\n116\t        try:\n117\t            with urllib.request.urlopen(f\"http://127.0.0.1:{port}/json/version\", timeout=2) as r:\n118\t                json.loads(r.read().decode(\"utf-8\"))\n119\t                return\n120\t        except Exception as exc:  # noqa: BLE001\n121\t            last_err = exc\n122\t            time.sleep(0.2)\n123\t    raise RuntimeError(f\"headless Edge devtools endpoint never came up: {last_err}\")\n124\t\n125\t\n126\tdef open_target(port: int, url: str) -> dict:\n127\t    req = urllib.request.Request(f\"http://127.0.0.1:{port}/json/new?{url}\", method=\"PUT\")\n128\t    with urllib.request.urlopen(req, timeout=10) as r:\n129\t        return json.loads(r.read().decode(\"utf-8\"))\n130\t\n131\t\n132\tdef wait_for_port(port: int, timeout: float = 15.0) -> bool:\n133\t    deadline = time.monotonic() + timeout\n134\t    while time.monotonic() < deadline:\n135\t        try:\n136\t            with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:\n137\t                s.settimeout(0.3)\n138\t                s.connect((\"127.0.0.1\", port))\n139\t                return True\n140\t        except OSError:\n141\t            time.sleep(0.2)\n142\t    return False\n143\t\n144\t\n145\tdef navigate(devtools_port: int, url: str, width: int, height: int,\n146\t            dark: bool = False) -> CDP:\n147\t    target = open_target(devtools_port, \"about:blank\")\n148\t    cdp = CDP(target[\"webSocketDebuggerUrl\"])\n149\t    cdp.send(\"Page.enable\")\n150\t    cdp.send(\"Runtime.enable\")\n151\t    # Headless Edge's default prefers-color-scheme is light, which would\n152\t    # otherwise silently flip the whole body (below the always-dark hero\n153\t    # band) to the light palette -- force dark so the dark palette (the\n154\t    # one this pass actually changes) is what gets measured/screenshotted.\n155\t    if dark:\n156\t        cdp.send(\"Emulation.setEmulatedMedia\",\n157\t                {\"features\": [{\"name\": \"prefers-color-scheme\", \"value\": \"dark\"}]})\n158\t    cdp.send(\"Page.navigate\", {\"url\": url})\n159\t    time.sleep(1.2)\n160\t    cdp.send(\"Emulation.setDeviceMetricsOverride\", {\n161\t        \"width\": width, \"height\": height, \"deviceScaleFactor\": 1, \"mobile\": width < 768,\n162\t    })\n163\t    time.sleep(0.5)\n164\t    return cdp\n165\t\n166\t\n167\tedge = find_edge()\n168\tif not edge:\n169\t    print(\"headless Edge not found -- cannot run the layout checks\")\n170\t    sys.exit(1)\n171\t\n172\tserver_dir = tempfile.mkdtemp(prefix=\"cuore-check-theme-server-\")\n173\tport = free_port()\n174\tenv = dict(os.environ)\n175\tenv[\"CUORE_STATE_DIR\"] = server_dir\n176\t\n177\t_SERVER_SNIPPET = f\"\"\"\n178\timport sys\n179\tsys.path.insert(0, {str(ROOT)!r})\n180\tfrom cuore.app import create_app\n181\timport uvicorn\n182\t\n183\tapp = create_app()\n184\tuvicorn.run(app, host=\"127.0.0.1\", port={port}, log_level=\"warning\")\n185\t\"\"\"\n186\t\n187\tserver_proc = subprocess.Popen(\n188\t    [sys.executable, \"-c\", _SERVER_SNIPPET],\n189\t    cwd=str(ROOT), env=env,\n190\t    stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,\n191\t)\n192\ttry:\n193\t    if not wait_for_port(port):\n194\t        print(\"uvicorn never came up -- aborting\")\n195\t        sys.exit(1)\n196\t\n197\t    # Seed a job so the job page's flow bar / verdict render for real.\n198\t    data = urllib.parse.urlencode(\n199\t        {\"technician\": \"tester\", \"complaint\": \"CEL, smells like gas\"}).encode()\n200\t    try:\n201\t        urllib.request.urlopen(\n202\t            urllib.request.Request(f\"http://127.0.0.1:{port}/v/{VIN}/job/open\",\n203\t                                   data=data, method=\"POST\"), timeout=10)\n204\t    except Exception as exc:  # noqa: BLE001\n205\t        print(f\"warning: seeding the job failed ({exc}); checks continue regardless\")\n206\t\n207\t    time.sleep(0.3)\n208\t    devtools_port = free_port()\n209\t    profile_dir = Path(tempfile.mkdtemp(prefix=\"cuore-edge-theme-\"))\n210\t    edge_proc = subprocess.Popen(\n211\t        [edge, \"--headless=new\", f\"--remote-debugging-port={devtools_port}\",\n212\t         f\"--user-data-dir={profile_dir}\", \"--no-first-run\", \"--window-size=400,1400\",\n213\t         \"about:blank\"],\n214\t        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,\n215\t    )\n216\t    try:\n217\t        wait_for_devtools(devtools_port)\n218\t        SCRATCHPAD.mkdir(parents=True, exist_ok=True)\n219\t\n220\t        job_url = f\"http://127.0.0.1:{port}/v/{VIN}/job\"\n221\t        dossier_url = f\"http://127.0.0.1:{port}/v/{VIN}\"\n222\t\n223\t        # --- job page at 1400px: checks 1-3, plus the wide screenshot ----\n224\t        cdp = navigate(devtools_port, job_url, 1400, 1800, dark=True)\n225\t        try:\n226\t            fs = cdp.eval_value(\"parseFloat(getComputedStyle(document.body).fontSize)\")\n227\t            check(\"body computed font-size is >= 17px\", fs is not None and fs >= 17, str(fs))\n228\t\n229\t            job_state = cdp.eval_value(\n230\t                \"(function(){var e=document.querySelector('.hero-verdict-state');\"\n231\t                \"return e?e.textContent.trim():null;})()\")\n232\t\n233\t            fig_count = cdp.eval_value(\n234\t                \"document.querySelectorAll('.hero-figure').length\")\n235\t            check(f\"hero key-figures row renders >= 2 figures for {VIN}\",\n236\t                  fig_count is not None and fig_count >= 2, str(fig_count))\n237\t\n238\t            shot = cdp.send(\"Page.captureScreenshot\", {\"format\": \"png\"})\n239\t            wide_path = SCRATCHPAD / \"job_1400.png\"\n240\t            wide_path.write_bytes(base64.b64decode(shot[\"data\"]))\n241\t            check(\"screenshot job_1400.png captured\",\n242\t                  wide_path.exists() and wide_path.stat().st_size > 0, str(wide_path))\n243\t        finally:\n244\t            cdp.close()\n245\t\n246\t        # --- dossier page: other half of check 2 -------------------------\n247\t        cdp = navigate(devtools_port, dossier_url, 1400, 1800)\n248\t        try:\n249\t            dossier_state = cdp.eval_value(\n250\t                \"(function(){var e=document.querySelector('.hero-verdict-state');\"\n251\t                \"return e?e.textContent.trim():null;})()\")\n252\t        finally:\n253\t            cdp.close()\n254\t\n255\t        check(\"hero shows the verdict state text on the job and dossier pages\",\n256\t              bool(job_state) and bool(dossier_state),\n257\t              f\"job={job_state!r} dossier={dossier_state!r}\")\n258\t\n259\t        # --- job page at 400px: check 4, plus the narrow screenshot ------\n260\t        cdp = navigate(devtools_port, job_url, 400, 1400)\n261\t        try:\n262\t            dims = json.loads(cdp.eval_value(\n263\t                \"JSON.stringify({sw: document.documentElement.scrollWidth, \"\n264\t                \"cw: document.documentElement.clientWidth})\"))\n265\t            sw, cw = dims.get(\"sw\", 0), dims.get(\"cw\", 0)\n266\t            check(\"no horizontal overflow at 400px on the job page\",\n267\t                  sw <= cw + 1, f\"scrollWidth={sw} clientWidth={cw}\")\n268\t\n269\t            shot = cdp.send(\"Page.captureScreenshot\", {\"format\": \"png\"})\n270\t            narrow_path = SCRATCHPAD / \"job_400.png\"\n271\t            narrow_path.write_bytes(base64.b64decode(shot[\"data\"]))\n272\t            check(\"screenshot job_400.png captured\",\n273\t                  narrow_path.exists() and narrow_path.stat().st_size > 0, str(narrow_path))\n274\t        finally:\n275\t            cdp.close()\n276\t    finally:\n277\t        edge_proc.terminate()\n278\t        try:\n279\t            edge_proc.wait(timeout=5)\n280\t        except Exception:\n281\t            edge_proc.kill()\n282\t        from _edge_cleanup import kill_edge_profile\n283\t        kill_edge_profile(profile_dir)\n284\tfinally:\n285\t    server_proc.terminate()\n286\t    try:\n287\t        server_proc.wait(timeout=5)\n288\t    except Exception:\n289\t        server_proc.kill()\n290\t\n291\t\n292\t# --- report ------------------------------------------------------------------\n293\t\n294\tprint()\n295\tif failures:\n296\t    print(f\"{len(failures)}/{checks} check(s) failed:\")\n297\t    for f in failures:\n298\t        print(f\"  - {f}\")\n299\t    sys.exit(1)\n300\tprint(f\"all {checks} checks passed\")\n301\t"}]},"uuid":"0e98f85b-42e5-435c-a733-2bd11fe76b7f","timestamp":"2026-10-08T18:40:19.624Z","toolUseResult":{"type":"text","file":{"filePath":"C:\\Users\\User\\mcp-servers\\cuore\\tests\\check_theme.py","content":"\"\"\"Checks for the Emphasis pass (cuore.css's appended \"Emphasis pass\"\nsection, on top of the Marque theme below it; _vbar.html's hero band;\njob.html's .step-title headings).\n\nSame posture as check_jobs_page.py: a real uvicorn server on a throwaway\nCUORE_STATE_DIR, the Stelvio (VIN below, real corpus) as the fixture vehicle,\nheadless Edge driven over CDP for anything that needs actual layout (font\nsize, overflow, element presence) rather than just HTML text.\n\nFour checks, matching the owner's brief exactly:\n  1. Body computed font-size is >= 17px (job page).\n  2. The hero shows the verdict state text (.hero-verdict-state, non-empty)\n     on both the job page and the dossier page.\n  3. The hero's key-figures row renders at least two figures\n     (.hero-figure) for VIN ZASFAKPN5J7B88115.\n  4. No page-level horizontal overflow at 400px on the job page.\n\nAlso writes two screenshots to the scratchpad for a one-time visual read:\njob_1400.png (wide, dark) and job_400.png (narrow) -- capped at two per the\nlow-memory environment; Edge is always killed via _edge_cleanup after.\n\nRun:\n    .venv/Scripts/python.exe cuore/tests/check_theme.py\n\"\"\"\n\nfrom __future__ import annotations\n\nimport base64\nimport itertools\nimport json\nimport os\nimport socket\nimport subprocess\nimport sys\nimport tempfile\nimport time\nimport urllib.parse\nimport urllib.request\nfrom pathlib import Path\n\nos.environ[\"CUORE_STATE_DIR\"] = tempfile.mkdtemp(prefix=\"cuore-check-theme-\")\nos.environ.pop(\"CUORE_AUDIT_PATH\", None)\n\nROOT = Path(__file__).resolve().parents[2]\nsys.path.insert(0, str(ROOT))\n\nVIN = \"ZASFAKPN5J7B88115\"  # the Stelvio -- real corpus, chronic P0455/P0440/P0456\n\nEDGE_CANDIDATES = [\n    r\"C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe\",\n    r\"C:\\Program Files\\Microsoft\\Edge\\Application\\msedge.exe\",\n]\nSCRATCHPAD = Path(r\"C:\\Users\\User\\AppData\\Local\\Temp\\claude\\C--Users-User\"\n                  r\"\\7cb02eb5-e299-4baf-b34b-9eb82aebbf17\\scratchpad\")\n\nfailures: list[str] = []\nchecks = 0\n\n\ndef check(label: str, cond: bool, detail: str = \"\") -> None:\n    global checks\n    checks += 1\n    if not cond:\n        failures.append(f\"{label}{(' -- ' + detail) if detail else ''}\")\n\n\ndef find_edge() -> str:\n    for candidate in EDGE_CANDIDATES:\n        if Path(candidate).exists():\n            return candidate\n    return \"\"\n\n\ndef free_port() -> int:\n    s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)\n    s.bind((\"127.0.0.1\", 0))\n    port = s.getsockname()[1]\n    s.close()\n    return port\n\n\nclass CDP:\n    def __init__(self, ws_url: str) -> None:\n        from websockets.sync.client import connect\n        self.ws = connect(ws_url, max_size=None, open_timeout=20)\n        self._ids = itertools.count(1)\n\n    def send(self, method: str, params: dict | None = None, timeout: float = 20):\n        msg_id = next(self._ids)\n        self.ws.send(json.dumps({\"id\": msg_id, \"method\": method, \"params\": params or {}}))\n        deadline = time.time() + timeout\n        while time.time() < deadline:\n            raw = self.ws.recv(timeout=max(0.1, deadline - time.time()))\n            msg = json.loads(raw)\n            if msg.get(\"id\") == msg_id:\n                if \"error\" in msg:\n                    raise RuntimeError(f\"CDP {method} failed: {msg['error']}\")\n                return msg.get(\"result\", {})\n        raise TimeoutError(f\"CDP {method} timed out waiting for response\")\n\n    def close(self) -> None:\n        try:\n            self.ws.close()\n        except Exception:\n            pass\n\n    def eval_value(self, expr: str):\n        out = self.send(\"Runtime.evaluate\", {\"expression\": expr, \"returnByValue\": True})\n        return out.get(\"result\", {}).get(\"value\")\n\n\ndef wait_for_devtools(port: int, timeout: float = 20) -> None:\n    deadline = time.time() + timeout\n    last_err: Exception | None = None\n    while time.time() < deadline:\n        try:\n            with urllib.request.urlopen(f\"http://127.0.0.1:{port}/json/version\", timeout=2) as r:\n                json.loads(r.read().decode(\"utf-8\"))\n                return\n        except Exception as exc:  # noqa: BLE001\n            last_err = exc\n            time.sleep(0.2)\n    raise RuntimeError(f\"headless Edge devtools endpoint never came up: {last_err}\")\n\n\ndef open_target(port: int, url: str) -> dict:\n    req = urllib.request.Request(f\"http://127.0.0.1:{port}/json/new?{url}\", method=\"PUT\")\n    with urllib.request.urlopen(req, timeout=10) as r:\n        return json.loads(r.read().decode(\"utf-8\"))\n\n\ndef wait_for_port(port: int, timeout: float = 15.0) -> bool:\n    deadline = time.monotonic() + timeout\n    while time.monotonic() < deadline:\n        try:\n            with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:\n                s.settimeout(0.3)\n                s.connect((\"127.0.0.1\", port))\n                return True\n        except OSError:\n            time.sleep(0.2)\n    return False\n\n\ndef navigate(devtools_port: int, url: str, width: int, height: int,\n            dark: bool = False) -> CDP:\n    target = open_target(devtools_port, \"about:blank\")\n    cdp = CDP(target[\"webSocketDebuggerUrl\"])\n    cdp.send(\"Page.enable\")\n    cdp.send(\"Runtime.enable\")\n    # Headless Edge's default prefers-color-scheme is light, which would\n    # otherwise silently flip the whole body (below the always-dark hero\n    # band) to the light palette -- force dark so the dark palette (the\n    # one this pass actually changes) is what gets measured/screenshotted.\n    if dark:\n        cdp.send(\"Emulation.setEmulatedMedia\",\n                {\"features\": [{\"name\": \"prefers-color-scheme\", \"value\": \"dark\"}]})\n    cdp.send(\"Page.navigate\", {\"url\": url})\n    time.sleep(1.2)\n    cdp.send(\"Emulation.setDeviceMetricsOverride\", {\n        \"width\": width, \"height\": height, \"deviceScaleFactor\": 1, \"mobile\": width < 768,\n    })\n    time.sleep(0.5)\n    return cdp\n\n\nedge = find_edge()\nif not edge:\n    print(\"headless Edge not found -- cannot run the layout checks\")\n    sys.exit(1)\n\nserver_dir = tempfile.mkdtemp(prefix=\"cuore-check-theme-server-\")\nport = free_port()\nenv = dict(os.environ)\nenv[\"CUORE_STATE_DIR\"] = server_dir\n\n_SERVER_SNIPPET = f\"\"\"\nimport sys\nsys.path.insert(0, {str(ROOT)!r})\nfrom cuore.app import create_app\nimport uvicorn\n\napp = create_app()\nuvicorn.run(app, host=\"127.0.0.1\", port={port}, log_level=\"warning\")\n\"\"\"\n\nserver_proc = subprocess.Popen(\n    [sys.executable, \"-c\", _SERVER_SNIPPET],\n    cwd=str(ROOT), env=env,\n    stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,\n)\ntry:\n    if not wait_for_port(port):\n        print(\"uvicorn never came up -- aborting\")\n        sys.exit(1)\n\n    # Seed a job so the job page's flow bar / verdict render for real.\n    data = urllib.parse.urlencode(\n        {\"technician\": \"tester\", \"complaint\": \"CEL, smells like gas\"}).encode()\n    try:\n        urllib.request.urlopen(\n            urllib.request.Request(f\"http://127.0.0.1:{port}/v/{VIN}/job/open\",\n                                   data=data, method=\"POST\"), timeout=10)\n    except Exception as exc:  # noqa: BLE001\n        print(f\"warning: seeding the job failed ({exc}); checks continue regardless\")\n\n    time.sleep(0.3)\n    devtools_port = free_port()\n    profile_dir = Path(tempfile.mkdtemp(prefix=\"cuore-edge-theme-\"))\n    edge_proc = subprocess.Popen(\n        [edge, \"--headless=new\", f\"--remote-debugging-port={devtools_port}\",\n         f\"--user-data-dir={profile_dir}\", \"--no-first-run\", \"--window-size=400,1400\",\n         \"about:blank\"],\n        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,\n    )\n    try:\n        wait_for_devtools(devtools_port)\n        SCRATCHPAD.mkdir(parents=True, exist_ok=True)\n\n        job_url = f\"http://127.0.0.1:{port}/v/{VIN}/job\"\n        dossier_url = f\"http://127.0.0.1:{port}/v/{VIN}\"\n\n        # --- job page at 1400px: checks 1-3, plus the wide screenshot ----\n        cdp = navigate(devtools_port, job_url, 1400, 1800, dark=True)\n        try:\n            fs = cdp.eval_value(\"parseFloat(getComputedStyle(document.body).fontSize)\")\n            check(\"body computed font-size is >= 17px\", fs is not None and fs >= 17, str(fs))\n\n            job_state = cdp.eval_value(\n                \"(function(){var e=document.querySelector('.hero-verdict-state');\"\n                \"return e?e.textContent.trim():null;})()\")\n\n            fig_count = cdp.eval_value(\n                \"document.querySelectorAll('.hero-figure').length\")\n            check(f\"hero key-figures row renders >= 2 figures for {VIN}\",\n                  fig_count is not None and fig_count >= 2, str(fig_count))\n\n            shot = cdp.send(\"Page.captureScreenshot\", {\"format\": \"png\"})\n            wide_path = SCRATCHPAD / \"job_1400.png\"\n            wide_path.write_bytes(base64.b64decode(shot[\"data\"]))\n            check(\"screenshot job_1400.png captured\",\n                  wide_path.exists() and wide_path.stat().st_size > 0, str(wide_path))\n        finally:\n            cdp.close()\n\n        # --- dossier page: other half of check 2 -------------------------\n        cdp = navigate(devtools_port, dossier_url, 1400, 1800)\n        try:\n            dossier_state = cdp.eval_value(\n                \"(function(){var e=document.querySelector('.hero-verdict-state');\"\n                \"return e?e.textContent.trim():null;})()\")\n        finally:\n            cdp.close()\n\n        check(\"hero shows the verdict state text on the job and dossier pages\",\n              bool(job_state) and bool(dossier_state),\n              f\"job={job_state!r} dossier={dossier_state!r}\")\n\n        # --- job page at 400px: check 4, plus the narrow screenshot ------\n        cdp = navigate(devtools_port, job_url, 400, 1400)\n        try:\n            dims = json.loads(cdp.eval_value(\n                \"JSON.stringify({sw: document.documentElement.scrollWidth, \"\n                \"cw: document.documentElement.clientWidth})\"))\n            sw, cw = dims.get(\"sw\", 0), dims.get(\"cw\", 0)\n            check(\"no horizontal overflow at 400px on the job page\",\n                  sw <= cw + 1, f\"scrollWidth={sw} clientWidth={cw}\")\n\n            shot = cdp.send(\"Page.captureScreenshot\", {\"format\": \"png\"})\n            narrow_path = SCRATCHPAD / \"job_400.png\"\n            narrow_path.write_bytes(base64.b64decode(shot[\"data\"]))\n            check(\"screenshot job_400.png captured\",\n                  narrow_path.exists() and narrow_path.stat().st_size > 0, str(narrow_path))\n        finally:\n            cdp.close()\n    finally:\n        edge_proc.terminate()\n        try:\n            edge_proc.wait(timeout=5)\n        except Exception:\n            edge_proc.kill()\n        from _edge_cleanup import kill_edge_profile\n        kill_edge_profile(profile_dir)\nfinally:\n    server_proc.terminate()\n    try:\n        server_proc.wait(timeout=5)\n    except Exception:\n        server_proc.kill()\n\n\n# --- report ------------------------------------------------------------------\n\nprint()\nif failures:\n    print(f\"{len(failures)}/{checks} check(s) failed:\")\n    for f in failures:\n        print(f\"  - {f}\")\n    sys.exit(1)\nprint(f\"all {checks} checks passed\")\n","numLines":301,"startLine":1,"totalLines":301}},"sourceToolAssistantUUID":"0c77ce3d-3425-401e-8424-0ebd80a6fe10","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
