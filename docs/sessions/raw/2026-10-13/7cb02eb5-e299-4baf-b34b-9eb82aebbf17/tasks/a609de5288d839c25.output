_brief.html:20:    <p class=\"feel-sentence\" id=\"fb-feel-{{ code }}\" data-fact=\"feel|{{ code }}\">{{ cf.feel.feel }}</p>\ncuore/web/templates/_codes_table.html:16:                id=\"fb-{{ c.code }}\" data-fact=\"codes|{{ c.code }}\">\ncuore/web/templates/_feedback_panel.html:2:   feedback.js enhances every element carrying data-fact with its own\ncuore/web/templates/_open_work.html:26:              id=\"fb-{{ s.id }}\" data-fact=\"checklist|{{ s.id }}\">\ncuore/web/templates/_verdict_card.html:2:  <div class=\"verdict-card v-{{ vstate }}\" id=\"verdict\" data-fact=\"verdict|\">\ncuore/web/templates/maintenance.html:118:              data-fact=\"parts|{{ p.part_number or p.name }}\">{{ p.part_number or \"UNKNOWN — use the service manual (TechAuthority)\" }}</td>\ncuore/web/templates/parts.html:28:  <div id=\"fb-part-{{ part.key or part.name }}\" data-fact=\"parts|{{ part.key or part.name }}\">\ncuore/web/templates/service_hub.html:20:  <div class=\"panel\" id=\"fb-{{ c.key }}\" data-fact=\"service|{{ c.key }}\">\ncuore/web/templates/timeline.html:13:        data-fact=\"findings|{{ loop.index }}\">{{ f }}</li>{% endfor %}\ncuore/web/templates/tools.html:7:<p class=\"lede\" data-fact=\"page|tools-overview\">Every cuore operation in one place: what it does, when to use\ncuore/web/templates/vehicle.html:89:                id=\"fb-{{ s.id }}\" data-fact=\"checklist|{{ s.id }}\">\ncuore/web/templates/vehicle.html:235:        <div class=\"bulletin-card\" id=\"{{ b.anchor }}\" data-fact=\"bulletins|{{ b.id }}\">","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"serverClassifierContext":{"request":"3d4ba3e6-c24a-4d80-a398-9d1ffea861cd","context":{"git_state":{"cwd":"/c/Users/User/mcp-servers","root":null,"branch":null,"default_branch":null,"status":null,"visibility":null,"error":"pending"},"live_cwd":"/c/Users/User/mcp-servers","platform":"windows"}},"sourceToolAssistantUUID":"fe103264-5f0a-48c6-a6e7-b92539c01eff","userType":"external","entrypo