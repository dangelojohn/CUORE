\"\n223:        # --- job page at 1400px: checks 1-3, plus the wide screenshot ----\n255:        check(\"hero shows the verdict state text on the job and dossier pages\",\n257:              f\"job={job_state!r} dossier={dossier_state!r}\")\n259:        # --- job page at 400px: check 4, plus the narrow screenshot ------\n266:            check(\"no horizontal overflow at 400px on the job page\",","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"serverClassifierContext":{"request":"f48e8172-432f-4ca9-b8dd-b60664c24168","context":{"git_state":{"cwd":"/c/Users/User/mcp-servers","root":null,"branch":null,"default_branch":null,"status":null,"visibility":null,"error":"pending"},"live_cwd":"/c/Users/User/mcp-servers","platform":"windows"}},"sourceToolAssistantUUID":"f422706f-ea21-4818-aa16-b2edc4a14a3c","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
