{"parentUuid":"886d7c0e-34d1-4753-bdbb-514ffb32634d","isSidechain":true,"promptId":"bbc43356-430e-40a9-a14e-41404b640377","agentId":"afed32e1361f5dde3","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014Vp6h6UAmuCsUJ7sGCYb5C","type":"tool_result","content":"1\t\"\"\"The live-data channel model: a registry of everything the poller can sample.\n2\t\n3\tA channel is ``{id, name, unit, source}``. Four source kinds:\n4\t\n5\t* ``pid``    -- a Mode 01 PID (hex), decoded by :func:`obd.decode_pid`.\n6\t* ``did``    -- a module code + UDS DID (hex) + CarScanner formula, evaluated\n7\t  with :func:`readall.eval_formula`. Every catalogued DID for ECM, TCM, BCM,\n8\t  IPC and RFHUB (:func:`did_catalog.all_dids`) is included, at its recorded\n9\t  confidence. A DID whose formula answers with several named fields (the\n10\t  RFHUB tire DIDs: ``pressure=...; temp=...``) is expanded into one channel\n11\t  per field, sharing the one DID read.\n12\t* ``computed`` -- an arithmetic expression over other channel ids, evaluated\n13\t  by the small safe evaluator below (no ``eval()`` anywhere in this module).\n14\t* ``battery``  -- adapter ``ATRV``.\n15\t\n16\t:func:`available_channels` returns the whole registry; :func:`presets`\n17\tgroups channel ids for one-click starts on this car.\n18\t\"\"\"\n19\t\n20\tfrom __future__ import annotations\n21\t\n22\timport re\n23\tfrom dataclasses import dataclass\n24\tfrom typing import Any, Optional\n25\t\n26\tfrom . import did_catalog\n27\tfrom .addressing import by_code\n28\tfrom .errors import BadCommand\n29\tfrom .obd import PIDS_BY_HEX\n30\t\n31\tFAST_HZ = 5.0\n32\tMED_HZ = 1.0\n33\tSLOW_HZ = 0.5\n34\t\n35\t#: PIDs worth sampling quickly -- the ones that change fast enough to matter\n36\t#: for a live dashboard (RPM, speed, throttle).\n37\t_FAST_PIDS = {\"engine_rpm\", \"vehicle_speed\", \"throttle_position\"}\n38\t#: Slow-moving readings: temperatures, ambient/barometric pressure, fuel level.\n39\t_SLOW_PIDS = {\"engine_coolant_temp\", \"intake_air_temp\", \"ambient_air_temp\",\n40\t             \"barometric_pressure\", \"fuel_level\", \"engine_oil_temp\"}\n41\t\n42\t#: Modules whose catalogued DIDs are worth exposing as channels.\n43\tDID_MODULES: tuple[str, ...] = (\"ECM\", \"TCM\", \"BCM\", \"IPC\", \"RFHUB\")\n44\t\n45\t\n46\t@dataclass(frozen=True)\n47\tclass Channel:\n48\t    id: str\n49\t    name: str\n50\t    unit: str\n51\t    kind: str                       # \"pid\" | \"did\" | \"computed\" | \"battery\"\n52\t    bus: str                        # \"can_c\" | \"can_ihs\" | \"can_ch\" | \"\"\n53\t    confidence: str\n54\t    default_rate_hz: float\n55\t    pid: str = \"\"\n56\t    module: str = \"\"\n57\t    did: int = 0\n58\t    formula: str = \"\"\n59\t    field: str = \"\"                 # sub-field name for a multi-field DID formula\n60\t    expr: str = \"\"\n61\t    depends_on: tuple[str, ...] = ()\n62\t    note: str = \"\"\n63\t\n64\t    def to_dict(self) -> dict[str, Any]:\n65\t        out: dict[str, Any] = {\n66\t            \"id\": self.id, \"name\": self.name, \"unit\": self.unit, \"kind\": self.kind,\n67\t            \"bus\": self.bus, \"confidence\": self.confidence,\n68\t            \"default_rate_hz\": self.default_rate_hz,\n69\t        }\n70\t        if self.kind == \"pid\":\n71\t            out[\"pid\"] = self.pid\n72\t        elif self.kind == \"did\":\n73\t            out[\"module\"] = self.module\n74\t            out[\"did\"] = f\"{self.did:04X}\"\n75\t            if self.formula:\n76\t                out[\"formula\"] = self.formula\n77\t            if self.field:\n78\t                out[\"field\"] = self.field\n79\t        elif self.kind == \"computed\":\n80\t            out[\"expr\"] = self.expr\n81\t            out[\"depends_on\"] = list(self.depends_on)\n82\t        if self.note:\n83\t            out[\"note\"] = self.note\n84\t        return out\n85\t\n86\t\n87\tdef _slug(name: str) -> str:\n88\t    s = re.sub(r\"[^a-z0-9]+\", \"_\", name.strip().lower()).strip(\"_\")\n89\t    return s or \"field\"\n90\t\n91\t\n92\tdef _pid_rate(name: str) -> float:\n93\t    if name in _FAST_PIDS:\n94\t        return FAST_HZ\n95\t    if name in _SLOW_PIDS:\n96\t        return SLOW_HZ\n97\t    return MED_HZ\n98\t\n99\t\n100\tdef _pid_channels() -> list[Channel]:\n101\t    return [\n102\t        Channel(id=spec.name, name=spec.name.replace(\"_\", \" \"), unit=spec.unit,\n103\t               kind=\"pid\", bus=\"can_c\", confidence=\"legislated\",\n104\t               default_rate_hz=_pid_rate(spec.name), pid=spec.pid,\n105\t               note=spec.description)\n106\t        for spec in PIDS_BY_HEX.values()\n107\t    ]\n108\t\n109\t\n110\tdef _battery_channel() -> Channel:\n111\t    return Channel(id=\"battery_voltage\", name=\"battery voltage\", unit=\"V\",\n112\t                   kind=\"battery\", bus=\"can_c\", confidence=\"legislated\",\n113\t                   default_rate_hz=SLOW_HZ)\n114\t\n115\t\n116\tdef _multi_field_names(formula: str) -> Optional[list[str]]:\n117\t    \"\"\"Field names of a real multi-field formula (``a=...; b=...``).\n118\t\n119\t    Distinguishes an actual multi-clause CarScanner formula from the\n120\t    ``\"multi-field\"`` sentinel some catalog rows use in place of a real,\n121\t    machine-parseable formula (e.g. the BCM IBS composite DID, whose fields\n122\t    are only described in prose) -- those get a single undecoded channel.\n123\t    \"\"\"\n124\t    if not formula or formula == \"multi-field\":\n125\t        return None\n126\t    if \";\" not in formula and \"=\" not in formula:\n127\t        return None\n128\t    names: list[str] = []\n129\t    for clause in formula.split(\";\"):\n130\t        clause = clause.strip()\n131\t        if not clause or \"=\" not in clause:\n132\t            return None\n133\t        name, _, _expr = clause.partition(\"=\")\n134\t        name = name.strip()\n135\t        if not name:\n136\t            return None\n137\t        names.append(name)\n138\t    return names or None\n139\t\n140\t\n141\tdef _did_channels() -> list[Channel]:\n142\t    out: list[Channel] = []\n143\t    for code in DID_MODULES:\n144\t        ecu = by_code(code)\n145\t        bus = ecu.bus_key if ecu else \"can_c\"\n146\t        for spec in did_catalog.all_dids(code, include_diesel=False):\n147\t            base_id = f\"{code.lower()}_{spec.did:04x}\"\n148\t            fields = _multi_field_names(spec.formula)\n149\t            if fields:\n150\t                for fname in fields:\n151\t                    out.append(Channel(\n152\t                        id=f\"{base_id}_{_slug(fname)}\", name=f\"{spec.name} ({fname})\",\n153\t                        unit=spec.unit, kind=\"did\", bus=bus, confidence=spec.confidence,\n154\t                        default_rate_hz=MED_HZ, module=code, did=spec.did,\n155\t                        formula=spec.formula, field=fname, note=spec.note))\n156\t            else:\n157\t                formula = \"\" if spec.formula == \"multi-field\" else spec.formula\n158\t                out.append(Channel(\n159\t                    id=base_id, name=spec.name, unit=spec.unit, kind=\"did\", bus=bus,\n160\t                    confidence=spec.confidence, default_rate_hz=MED_HZ, module=code,\n161\t                    did=spec.did, formula=formula, note=spec.note))\n162\t    return out\n163\t\n164\t\n165\tdef _computed_channels() -> list[Channel]:\n166\t    return [\n167\t        Channel(id=\"boost\", name=\"boost (MAP - baro)\", unit=\"kPa\", kind=\"computed\",\n168\t               bus=\"can_c\", confidence=\"computed\", default_rate_hz=MED_HZ,\n169\t               expr=\"intake_map - barometric_pressure\",\n170\t               depends_on=(\"intake_map\", \"barometric_pressure\"),\n171\t               note=\"derived from the two legislated PIDs; compare against the \"\n172\t                    \"unverified ECM boost DID 195A\"),\n173\t    ]\n174\t\n175\t\n176\tdef _builtin_channels() -> list[Channel]:\n177\t    return _pid_channels() + _did_channels() + [_battery_channel()] + _computed_channels()\n178\t\n179\t\n180\tdef builtin_channel_ids() -> set[str]:\n181\t    \"\"\"Ids of every channel this project ships with -- excludes saved custom channels.\n182\t\n183\t    :mod:`ui_store` uses this (not :func:`registry`) to decide whether a\n184\t    submitted custom channel id collides with something built-in -- as\n185\t    opposed to an existing custom channel of the same id simply being\n186\t    re-saved, which must be allowed.\n187\t    \"\"\"\n188\t    return {c.id for c in _builtin_channels()}\n189\t\n190\t\n191\tdef available_channels() -> list[Channel]:\n192\t    \"\"\"Every channel this project knows how to sample, including saved custom ones.\"\"\"\n193\t    from . import ui_store  # local: ui_store imports this module; avoid a cycle at import time\n194\t    return _builtin_channels() + ui_store.load_custom_channels()\n195\t\n196\t\n197\t_REGISTRY: Optional[dict[str, Channel]] = None\n198\t\n199\t\n200\tdef registry() -> dict[str, Channel]:\n201\t    global _REGISTRY\n202\t    if _REGISTRY is None:\n203\t        _REGISTRY = {c.id: c for c in available_channels()}\n204\t    return _REGISTRY\n205\t\n206\t\n207\tdef invalidate_registry() -> None:\n208\t    \"\"\"Force the next :func:`registry`/:func:`by_id` call to recompute.\n209\t\n210\t    Called after custom channels are saved so a running dashboard sees new\n211\t    custom channels (and formula/expr edits to existing ones) without a\n212\t    process restart.\n213\t    \"\"\"\n214\t    global _REGISTRY\n215\t    _REGISTRY = None\n216\t\n217\t\n218\tdef by_id(channel_id: str) -> Channel:\n219\t    ch = registry().get(channel_id)\n220\t    if ch is None:\n221\t        raise BadCommand(f\"unknown channel id {channel_id!r}\")\n222\t    return ch\n223\t\n224\t\n225\t#: One-click starts. Every id here must resolve through :func:`by_id`; a\n226\t#: mismatch would be a bug in this file, not caller input, so it is not\n227\t#: guarded -- :func:`resolve_channels` raising KeyError on a typo here during\n228\t#: development is preferable to silently dropping a channel from a preset.\n229\tPRESETS: dict[str, tuple[str, ...]] = {\n230\t    \"engine_basics\": (\"engine_rpm\", \"vehicle_speed\", \"engine_coolant_temp\",\n231\t                      \"intake_air_temp\", \"absolute_load\", \"throttle_position\",\n232\t                      \"battery_voltage\"),\n233\t    \"boost\": (\"intake_map\", \"barometric_pressure\", \"boost\", \"ecm_195a\"),\n234\t    \"evap_job\": (\"commanded_evap_purge\", \"fuel_level\", \"evap_vapor_pressure\",\n235\t                \"evap_vapor_pressure_abs\", \"engine_coolant_temp\", \"intake_air_temp\"),\n236\t    \"transmission\": (\"tcm_04fe\", \"tcm_0518\"),\n237\t    \"tpms\": (\"rfhub_40b1_pressure\", \"rfhub_40b1_temp\", \"rfhub_40b2_pressure\",\n238\t            \"rfhub_40b2_temp\", \"rfhub_40b3_pressure\", \"rfhub_40b3_temp\",\n239\t            \"rfhub_40b4_pressure\", \"rfhub_40b4_temp\"),\n240\t}\n241\t\n242\t\n243\tdef presets() -> dict[str, list[dict[str, Any]]]:\n244\t    reg = registry()\n245\t    return {name: [reg[cid].to_dict() for cid in ids if cid in reg]\n246\t            for name, ids in PRESETS.items()}\n247\t\n248\t\n249\tdef resolve_channels(channel_ids: Optional[list[str]] = None, preset: str = \"\") -> list[Channel]:\n250\t    \"\"\"``channel_ids`` and/or a named preset, deduplicated, computed channels'\n251\t    dependencies pulled in automatically so they are always polled too.\"\"\"\n252\t    chosen: list[str] = []\n253\t    if preset:\n254\t        if preset not in PRESETS:\n255\t            raise BadCommand(f\"unknown preset {preset!r}; one of {sorted(PRESETS)}\")\n256\t        chosen.extend(PRESETS[preset])\n257\t    for cid in (channel_ids or []):\n258\t        if cid not in chosen:\n259\t            chosen.append(cid)\n260\t    if not chosen:"}]},"uuid":"c9179fe4-c57e-4e13-b36b-2b09201bfdd1","timestamp":"2026-10-08T02:42:08.969Z","toolUseResult":{"type":"text","file":{"filePath":"C:\\Users\\User\\mcp-servers\\cuore\\live\\channels.py","content":"\"\"\"The live-data channel model: a registry of everything the poller can sample.\n\nA channel is ``{id, name, unit, source}``. Four source kinds:\n\n* ``pid``    -- a Mode 01 PID (hex), decoded by :func:`obd.decode_pid`.\n* ``did``    -- a module code + UDS DID (hex) + CarScanner formula, evaluated\n  with :func:`readall.eval_formula`. Every catalogued DID for ECM, TCM, BCM,\n  IPC and RFHUB (:func:`did_catalog.all_dids`) is included, at its recorded\n  confidence. A DID whose formula answers with several named fields (the\n  RFHUB tire DIDs: ``pressure=...; temp=...``) is expanded into one channel\n  per field, sharing the one DID read.\n* ``computed`` -- an arithmetic expression over other channel ids, evaluated\n  by the small safe evaluator below (no ``eval()`` anywhere in this module).\n* ``battery``  -- adapter ``ATRV``.\n\n:func:`available_channels` returns the whole registry; :func:`presets`\ngroups channel ids for one-click starts on this car.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport re\nfrom dataclasses import dataclass\nfrom typing import Any, Optional\n\nfrom . import did_catalog\nfrom .addressing import by_code\nfrom .errors import BadCommand\nfrom .obd import PIDS_BY_HEX\n\nFAST_HZ = 5.0\nMED_HZ = 1.0\nSLOW_HZ = 0.5\n\n#: PIDs worth sampling quickly -- the ones that change fast enough to matter\n#: for a live dashboard (RPM, speed, throttle).\n_FAST_PIDS = {\"engine_rpm\", \"vehicle_speed\", \"throttle_position\"}\n#: Slow-moving readings: temperatures, ambient/barometric pressure, fuel level.\n_SLOW_PIDS = {\"engine_coolant_temp\", \"intake_air_temp\", \"ambient_air_temp\",\n             \"barometric_pressure\", \"fuel_level\", \"engine_oil_temp\"}\n\n#: Modules whose catalogued DIDs are worth exposing as channels.\nDID_MODULES: tuple[str, ...] = (\"ECM\", \"TCM\", \"BCM\", \"IPC\", \"RFHUB\")\n\n\n@dataclass(frozen=True)\nclass Channel:\n    id: str\n    name: str\n    unit: str\n    kind: str                       # \"pid\" | \"did\" | \"computed\" | \"battery\"\n    bus: str                        # \"can_c\" | \"can_ihs\" | \"can_ch\" | \"\"\n    confidence: str\n    default_rate_hz: float\n    pid: str = \"\"\n    module: str = \"\"\n    did: int = 0\n    formula: str = \"\"\n    field: str = \"\"                 # sub-field name for a multi-field DID formula\n    expr: str = \"\"\n    depends_on: tuple[str, ...] = ()\n    note: str = \"\"\n\n    def to_dict(self) -> dict[str, Any]:\n        out: dict[str, Any] = {\n            \"id\": self.id, \"name\": self.name, \"unit\": self.unit, \"kind\": self.kind,\n            \"bus\": self.bus, \"confidence\": self.confidence,\n            \"default_rate_hz\": self.default_rate_hz,\n        }\n        if self.kind == \"pid\":\n            out[\"pid\"] = self.pid\n        elif self.kind == \"did\":\n            out[\"module\"] = self.module\n            out[\"did\"] = f\"{self.did:04X}\"\n            if self.formula:\n                out[\"formula\"] = self.formula\n            if self.field:\n                out[\"field\"] = self.field\n        elif self.kind == \"computed\":\n            out[\"expr\"] = self.expr\n            out[\"depends_on\"] = list(self.depends_on)\n        if self.note:\n            out[\"note\"] = self.note\n        return out\n\n\ndef _slug(name: str) -> str:\n    s = re.sub(r\"[^a-z0-9]+\", \"_\", name.strip().lower()).strip(\"_\")\n    return s or \"field\"\n\n\ndef _pid_rate(name: str) -> float:\n    if name in _FAST_PIDS:\n        return FAST_HZ\n    if name in _SLOW_PIDS:\n        return SLOW_HZ\n    return MED_HZ\n\n\ndef _pid_channels() -> list[Channel]:\n    return [\n        Channel(id=spec.name, name=spec.name.replace(\"_\", \" \"), unit=spec.unit,\n               kind=\"pid\", bus=\"can_c\", confidence=\"legislated\",\n               default_rate_hz=_pid_rate(spec.name), pid=spec.pid,\n               note=spec.description)\n        for spec in PIDS_BY_HEX.values()\n    ]\n\n\ndef _battery_channel() -> Channel:\n    return Channel(id=\"battery_voltage\", name=\"battery voltage\", unit=\"V\",\n                   kind=\"battery\", bus=\"can_c\", confidence=\"legislated\",\n                   default_rate_hz=SLOW_HZ)\n\n\ndef _multi_field_names(formula: str) -> Optional[list[str]]:\n    \"\"\"Field names of a real multi-field formula (``a=...; b=...``).\n\n    Distinguishes an actual multi-clause CarScanner formula from the\n    ``\"multi-field\"`` sentinel some catalog rows use in place of a real,\n    machine-parseable formula (e.g. the BCM IBS composite DID, whose fields\n    are only described in prose) -- those get a single undecoded channel.\n    \"\"\"\n    if not formula or formula == \"multi-field\":\n        return None\n    if \";\" not in formula and \"=\" not in formula:\n        return None\n    names: list[str] = []\n    for clause in formula.split(\";\"):\n        clause = clause.strip()\n        if not clause or \"=\" not in clause:\n            return None\n        name, _, _expr = clause.partition(\"=\")\n        name = name.strip()\n        if not name:\n            return None\n        names.append(name)\n    return names or None\n\n\ndef _did_channels() -> list[Channel]:\n    out: list[Channel] = []\n    for code in DID_MODULES:\n        ecu = by_code(code)\n        bus = ecu.bus_key if ecu else \"can_c\"\n        for spec in did_catalog.all_dids(code, include_diesel=False):\n            base_id = f\"{code.lower()}_{spec.did:04x}\"\n            fields = _multi_field_names(spec.formula)\n            if fields:\n                for fname in fields:\n                    out.append(Channel(\n                        id=f\"{base_id}_{_slug(fname)}\", name=f\"{spec.name} ({fname})\",\n                        unit=spec.unit, kind=\"did\", bus=bus, confidence=spec.confidence,\n                        default_rate_hz=MED_HZ, module=code, did=spec.did,\n                        formula=spec.formula, field=fname, note=spec.note))\n            else:\n                formula = \"\" if spec.formula == \"multi-field\" else spec.formula\n                out.append(Channel(\n                    id=base_id, name=spec.name, unit=spec.unit, kind=\"did\", bus=bus,\n                    confidence=spec.confidence, default_rate_hz=MED_HZ, module=code,\n                    did=spec.did, formula=formula, note=spec.note))\n    return out\n\n\ndef _computed_channels() -> list[Channel]:\n    return [\n        Channel(id=\"boost\", name=\"boost (MAP - baro)\", unit=\"kPa\", kind=\"computed\",\n               bus=\"can_c\", confidence=\"computed\", default_rate_hz=MED_HZ,\n               expr=\"intake_map - barometric_pressure\",\n               depends_on=(\"intake_map\", \"barometric_pressure\"),\n               note=\"derived from the two legislated PIDs; compare against the \"\n                    \"unverified ECM boost DID 195A\"),\n    ]\n\n\ndef _builtin_channels() -> list[Channel]:\n    return _pid_channels() + _did_channels() + [_battery_channel()] + _computed_channels()\n\n\ndef builtin_channel_ids() -> set[str]:\n    \"\"\"Ids of every channel this project ships with -- excludes saved custom channels.\n\n    :mod:`ui_store` uses this (not :func:`registry`) to decide whether a\n    submitted custom channel id collides with something built-in -- as\n    opposed to an existing custom channel of the same id simply being\n    re-saved, which must be allowed.\n    \"\"\"\n    return {c.id for c in _builtin_channels()}\n\n\ndef available_channels() -> list[Channel]:\n    \"\"\"Every channel this project knows how to sample, including saved custom ones.\"\"\"\n    from . import ui_store  # local: ui_store imports this module; avoid a cycle at import time\n    return _builtin_channels() + ui_store.load_custom_channels()\n\n\n_REGISTRY: Optional[dict[str, Channel]] = None\n\n\ndef registry() -> dict[str, Channel]:\n    global _REGISTRY\n    if _REGISTRY is None:\n        _REGISTRY = {c.id: c for c in available_channels()}\n    return _REGISTRY\n\n\ndef invalidate_registry() -> None:\n    \"\"\"Force the next :func:`registry`/:func:`by_id` call to recompute.\n\n    Called after custom channels are saved so a running dashboard sees new\n    custom channels (and formula/expr edits to existing ones) without a\n    process restart.\n    \"\"\"\n    global _REGISTRY\n    _REGISTRY = None\n\n\ndef by_id(channel_id: str) -> Channel:\n    ch = registry().get(channel_id)\n    if ch is None:\n        raise BadCommand(f\"unknown channel id {channel_id!r}\")\n    return ch\n\n\n#: One-click starts. Every id here must resolve through :func:`by_id`; a\n#: mismatch would be a bug in this file, not caller input, so it is not\n#: guarded -- :func:`resolve_channels` raising KeyError on a typo here during\n#: development is preferable to silently dropping a channel from a preset.\nPRESETS: dict[str, tuple[str, ...]] = {\n    \"engine_basics\": (\"engine_rpm\", \"vehicle_speed\", \"engine_coolant_temp\",\n                      \"intake_air_temp\", \"absolute_load\", \"throttle_position\",\n                      \"battery_voltage\"),\n    \"boost\": (\"intake_map\", \"barometric_pressure\", \"boost\", \"ecm_195a\"),\n    \"evap_job\": (\"commanded_evap_purge\", \"fuel_level\", \"evap_vapor_pressure\",\n                \"evap_vapor_pressure_abs\", \"engine_coolant_temp\", \"intake_air_temp\"),\n    \"transmission\": (\"tcm_04fe\", \"tcm_0518\"),\n    \"tpms\": (\"rfhub_40b1_pressure\", \"rfhub_40b1_temp\", \"rfhub_40b2_pressure\",\n            \"rfhub_40b2_temp\", \"rfhub_40b3_pressure\", \"rfhub_40b3_temp\",\n            \"rfhub_40b4_pressure\", \"rfhub_40b4_temp\"),\n}\n\n\ndef presets() -> dict[str, list[dict[str, Any]]]:\n    reg = registry()\n    return {name: [reg[cid].to_dict() for cid in ids if cid in reg]\n            for name, ids in PRESETS.items()}\n\n\ndef resolve_channels(channel_ids: Optional[list[str]] = None, preset: str = \"\") -> list[Channel]:\n    \"\"\"``channel_ids`` and/or a named preset, deduplicated, computed channels'\n    dependencies pulled in automatically so they are always polled too.\"\"\"\n    chosen: list[str] = []\n    if preset:\n        if preset not in PRESETS:\n            raise BadCommand(f\"unknown preset {preset!r}; one of {sorted(PRESETS)}\")\n        chosen.extend(PRESETS[preset])\n    for cid in (channel_ids or []):\n        if cid not in chosen:\n            chosen.append(cid)\n    if not chosen:","numLines":260,"startLine":1,"totalLines":430}},"sourceToolAssistantUUID":"886d7c0e-34d1-4753-bdbb-514ffb32634d","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
