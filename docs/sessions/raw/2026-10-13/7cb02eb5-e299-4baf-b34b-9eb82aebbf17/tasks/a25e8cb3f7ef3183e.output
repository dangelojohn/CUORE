e same","-# description/fault-tree/parts(UNKNOWN) fallback the report page uses.","-","-occ_u1736 = web_routes._live_code_occurrences(VIN, \"U1736\")","-check(\"U1736: live occurrences carry the IPC ACTIVE read\",","-     any(o[\"module\"] == \"IPC\" and o[\"state\"] == \"ACTIVE\" for o in occ_u1736),","-     occ_u1736)","-check(\"U1736: live occurrences carry the BCM HISTORY read\",","-     any(o[\"module\"] == \"BCM\" and o[\"state\"] == \"HISTORY\" for o in occ_u1736),","-     occ_u1736)","-","-occ_b10aa = web_routes._live_code_occurrences(VIN, \"B10AA\")","-check(\"B10AA: live occurrences carry the BCM HISTORY read\",","-     any(o[\"module\"] == \"BCM\" and o[\"state\"] == \"HISTORY\" for o in occ_b10aa),","-     occ_b10aa)","-","-for code in (\"U1736\", \"B10AA\"):","-    r = client.get(f\"/v/{VIN}/code/{code}\")","-    check(f\"{code}: code page never 500s\", r.status_code != 500, r.status_code)","-    check(f\"{code}: code page renders 200 (live occurrence stands in for \"","-         \"the missing FES-log history)\", r.status_code == 200, r.status_code)","-    if r.status_code != 200:","-        continue","-    text = r.text","-    check(f\"{code}: page marks itself live-only (no FES log on file)\",","-         \"live-only\" in text.lower())","-    check(f\"{code}: page shows at least one live occurrence's module\",","-         any(ecu in text for ecu in (\"BCM\", \"IPC\", \"ECM\", \"RFHUB\")))","-    check(f\"{code}: page shows a fault-tree next step or an explicit UNKNOWN\",","-         \"Fault-tree next step\" in text)","-    check(f\"{code}: page carries a parts line, real or explicit UNKNOWN/TechAuthority\",","-         \"TechAuthority\" in text or \"Parts for\" in text)","-","-# A code neither logged nor ever read live on this car is still a 404 -- the","-# live-occurrence fallback must never swallow a genuinely unknown code.","-r = client.get(f\"/v/{VIN}/code/P9999\")","-check(\"a code with no log history and no live occurrence is still a 404\",","- 