Mode 03/07/0A) read","-    of ``code_upper`` this car has on file, newest first -- the live","-    stand-in for FES-log history when no log on file has ever carried the","-    code (e.g. B10AA, U1736: read live on 2026-10-13, never logged to a","-    file). ``[]`` on any failure, or when the code was never read live --","-    never raises, and an empty result is exactly what tells the caller to","-    fall back to the ordinary 404.","-    \"\"\"","-    try:","-        from ..live import store as live_store","-    except Exception:  # noqa: BLE001 -- optional dependency","-        return []","-","-    out: list[dict[str, Any]] = []","-","-    try:","-        module_obs = live_store.recent_observations(1000, vin=vin, kind=\"module_dtcs\")","-    except Exception:  # noqa: BLE001","-        module_obs = []","-    for o in module_obs:","-        if not live_store.is_from_car(o):","-            continue","-        data = o.get(\"data\") or {}","-        ecu = data.get(\"ecu\") or \"?\"","-        at = o.get(\"at\") or \"\"","-        for d in data.get(\"dtcs\") or []:","-            full = str(d.get(\"code\") or \"\").strip().upper()","-            base, _, suffix = full.partition(\"-\")","-            if base != code_upper:","-                continue","-            flags = d.get(\"flags\") or {}","-            state = _module_dtc_state(flags)","-            out.append({\"at\": at, \"module\": ecu, \"code\": full,","-                       \"status\": d.get(\"status\"), \"flags\": flags, \"state\": state,","-                       \"state_class\": {\"ACTIVE\": \"status-active\",","-                                       \"HISTORY\": \"chronic\"}.get(state, \"plain\"),","-                       \"failure_type\": _code_failure_type(suffix)})","-","-    try:","-        obd_obs = live_store.recent_observations(300, vin=vin, kind=\"obd_dtcs\")","-    except Exception:  # noqa: BLE001","-        obd_obs = []","-    for o in obd_obs:","-        if not live_store.is_from_car(o):","-            continue","-        data = o.get(\"data\") or {}","-        at = o.get(\"at\") or \"\"","-        inner = str(data.get(\"kind\") or \"\")","-        for c in data.get(\"dtcs\") or []:","-            full = str(c).strip().upper()","-            base = full.split(\"-\", 1)[0]","-            if base != code_upper:","-                continue","-            out.append({\"at\": at, \"module\": f\"OBD ({inner})\" if inner else \"OBD\",","-                       \"code\": full, \"status\": None, \"flags\": {},","-                       \"state\": inner.upper() if inner else None,","-                       \"state_class\": \"plain\", \"failure_type\": {}})","-","-    out.sort(key=lambda r: r.get(\"at\") or \"\", reverse=True)","-    return out","-","-"," @router.get(\"/v/{vin}/code/{code}\", response_class=HTMLResponse)"," def code_detail(request: Request, vin: str, code: str) -> HTMLResponse:","-    \"\"\"One code's complete life, with its freeze frames beside it.","-","-    A code with no FES-log history still renders here, rather than 404ing,","-    when this car's own live module (UDS 0x19) or OBD read ever reported","-    it -- e.g. U1736, B10AA, read live on 2026-10-13 but never logged to a","-    file. The live occurrence(s) stand in for the log-history table, with","-    the same description/fault-tree/parts(UNKNOWN) fallback blocks the","-    report page (``report_routes._fixes_fallback``/``_parts_section``)","-    already uses for exactly this situation. Only a code neither logged","-    nor ever read live on this car is still a 404.","-    \"\"\"","+    \"\"\"One code's complete life, with its freeze frames beside it.\"\"\"","     dossier = _dossier(vin)","-    code_upper = code.strip().upper()","-    live_only = False","-    live_occurrences: list[dict[str, Any]] = []","-    description: dict[str, Any] = {}","-    fault_tree_steps: list[dict[str, Any]] = []","-    try:","-        history = mes_bridge.dtc_history(code, vin=vin)","-    except Brid