}\n  <ol>\n    {% for s in fault_tree_steps %}\n    <li>{{ s.text }}{% if s.ref %} <span class=\"muted small\">({{ s.ref }})</span>{% endif %}</li>\n    {% endfor %}\n  </ol>\n  {% else %}\n  <p class=\"muted\">UNKNOWN -- use the service manual (TechAuthority)</p>\n  {% endif %}\n</div>\n{% endif %}\n\n{# parts_for is a Jinja global registered by cuore/web/parts_routes.py as a\n   side effect of importing it (see that module's docstring) -- guarded here\n   so this page still renders before app.py wires that router in. Scoped to\n   live_only so an ordinary FES-logged code with no catalogued part keeps its\n   current (silent) behaviour -- only a code only ever read live gets this\n   explicit UNKNOWN line, matching the report page's own parts fallback. #}\n{% if live_only and not (parts_for is defined and parts_for(code=code)) %}\n<h2>Parts for {{ code }}</h2>\n<p class=\"muted\">UNKNOWN -- use the service manual (TechAuthority)</p>\n{% endif %}\n\n<h2>Freeze frames</h2>"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":3825,"cache_read_input_tokens":114556,"cache_creation":{"ephemeral_5m_input_tokens":3825,"ephemeral_1h_input_tokens":0},"output_tokens":7,"service_tier":"standard","inference_geo":"global"},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_01UjPfd13fdTrNx9UtQucDZJ":{"file_path":"C:\\Users\\User\\mcp-servers\\cuore\\web\\templates\\code.html","old_string":"{% else %}\n  <div class=\"panel\"><p class=\"muted\">No record of this code in real logs.</p></div>\n{% endfor %}\n\n<h2>Freeze frames</h2>","new_string":"{% else %}\n  <div class=\"panel\"><p class=\"muted\">\n    {% if live_only %}No FES-log history for this code -- see the live occurrences below.\n    {% else %}No record of this code in real logs.{% endif %}\n  </p></div>\n{% endfor %}\n\n{% if live_only %}\n<div class=\"panel\">\n  <h3>{{ code }} <span class=\"chip plain\">live-only -- no FES log on file</span></h3>\n  {% if description.text %}\n  <p class=\"lede\">{{ description.text }}\n    {% if description.source and description.source != \"none\" %}<span class=\"chip plain\">{{ description.source }}</span>{% endif %}</p>\n  {% endif %}\n\n  <h3>Every live occurrence</h3>\n  <div class=\"tw\">\n  <table>\n    <thead><tr><th>When</th><th>Module</th><th>Code</th><th>State</th><th class=\"n\">Status</th><th>Failure type</th></tr></thead>\n    <tbody>\n    {% for o in live_occurrences %}\n      <tr>\n        <td class=\"mono small\">{{ o.at }}</td>\n        <td>{{ o.module }}</td>\n        <td class=\"mono\">{{ o.code }}</td>\n        <td>{% if o.state %}<span class=\"chip {{ o.state_class }}\">{{ o.state }}</span>{% else %}&mdash;{% endif %}</td>\n        <td class=\"n mono small\">{% if o.status is not none %}{{ o.status }}{% else %}&mdash;{% endif %}</td>\n        <td>{{ o.failure_type.text if o.failure_type else \"\" }}</td>\n      </tr>\n    {% endfor %}\n    </tbody>\n  </table>\n  </div>\n\n  <h3>Fault-tree next step</h3>\n  {% if fault_tree_steps %}\n  <ol>\n    {% for s in fault_tree_steps %}\n    <li>{{ s.text }}{% if s.ref %} <span class=\"muted small\">({{ s.ref }})</span>{% endif %}</li>\n    {% endfor %}\n  </ol>\n  {% else %}\n  <p class=\"muted\">UNKNOWN -- use the service manual (TechAuthority)</p>\n  {% endif %}\n</div>\n{% endif %}\n\n{# parts_for is a Jinja global registered by cuore/web/parts_routes.py as a\n   side effect of importing it (see that module's docstring) -- guarded here\n   so this page still renders before app.py wires that router in. Scoped to\n   live_only so an ordinary FES-logged code with no catalogued part keeps its\n   current (silent) behaviour -- only a code only ever read live gets this\n   explicit UNKNOWN line, matching the report page's own parts fallback. #}\n{% if live_only and not (parts_for is defined and parts_for(code=code)) %}\n<h2>Parts fo