tion %}","+  <p class=\"lede\">{{ r.mes_description.text }}","+    <span class=\"chip plain\">{{ r.mes_description.source }}</span></p>","+  {% endif %}","+","+  <div class=\"tw\">","+  <table>","+    <tr><td class=\"k\">Module</td><td>{{ r.modules|join(\", \") }}</td></tr>","+    <tr><td class=\"k\">Sessions</td><td class=\"n\">{{ r.sessions }}</td></tr>","+    <tr><td class=\"k\">First seen</td><td class=\"mono\">{{ r.first_seen }}</td></tr>","+    <tr><td class=\"k\">Last seen</td><td class=\"mono\">{{ r.last_seen }}</td></tr>","+    {% if r.odometer_first_km is defined and r.odometer_first_km is not none %}","+    <tr><td class=\"k\">Odometer</td>","+        <td class=\"mono\">{{ \"{:,}\".format(r.odometer_first_km|int) }} &rarr;","+            {{ \"{:,}\".format(r.odometer_last_km|int) }} km","+            {% if r.distance_span_km %}","+              <b>({{ \"{:,}\".format(r.distance_span_km|int) }} km span)</b>","+            {% endif %}</td></tr>","+    {% endif %}","+    <tr><td class=\"k\">Statuses seen</td><td>{{ r.statuses_seen|join(\", \") }}</td></tr>","+    {% if r.assessment %}","+    <tr><td class=\"k\">Assessment</td><td><b>{{ r.assessment }}</b></td></tr>","+    {% endif %}","+  </table>","+  </div>","+","+  <h3>Every occurrence</h3>","+  <div class=\"tw\">","+  <table>","+    <thead><tr><th>When</th><th>Status</th><th class=\"n\">Odometer</th><th>File</th></tr></thead>","+    <tbody>","+    {% for o in r.occurrences %}","+      <tr>","+        <td class=\"mono small\">{{ o.timestamp }}</td>","+        <td><span class=\"chip plain\">{{ o.status }}</span></td>","+        <td class=\"n\">{% if o.odometer_km %}{{ \"{:,.0f}\".format(o.odometer_km) }} km{% else %}—{% endif %}</td>","+        <td class=\"mono small muted\">{{ o.file }}</td>","+      </tr>","+    {% endfor %}","+    </tbody>","+  </table>","+  </div>","+</div>","+{% else %}","+  <div class=\"panel\"><p class=\"muted\">No record of this code in real logs.</p></div>","+{% endfor %}","+","+<