15\"  # the Stelvio"," "]},{"oldStart":128,"oldLines":6,"newStart":129,"newLines":49,"lines":["          \"for at least one module code with no catalogued part\",","          \"UNKNOWN\" in body and \"TechAuthority\" in body)"," ","+# === Code page: live-only codes with no FES-log history ===================","+# U1736 and B10AA were read live (UDS 0x19, the same 2026-10-13 sweep seeded","+# above) but never logged to an FES file -- cuore/web/routes.py's code page","+# used to 404 them outright. They must now render, with the live","+# occurrence(s) standing in for the log history and the same","+# description/fault-tree/parts(UNKNOWN) fallback the report page uses.","+","+occ_u1736 = web_routes._live_code_occurrences(VIN, \"U1736\")","+check(\"U1736: live occurrences carry the IPC ACTIVE read\",","+     any(o[\"module\"] == \"IPC\" and o[\"state\"] == \"ACTIVE\" for o in occ_u1736),","+     occ_u1736)","+check(\"U1736: live occurrences carry the BCM HISTORY read\",","+     any(o[\"module\"] == \"BCM\" and o[\"state\"] == \"HISTORY\" for o in occ_u1736),","+     occ_u1736)","+","+occ_b10aa = web_routes._live_code_occurrences(VIN, \"B10AA\")","+check(\"B10AA: live occurrences carry the BCM HISTORY read\",","+     any(o[\"module\"] == \"BCM\" and o[\"state\"] == \"HISTORY\" for o in occ_b10aa),","+     occ_b10aa)","+","+for code in (\"U1736\", \"B10AA\"):","+    r = client.get(f\"/v/{VIN}/code/{code}\")","+    check(f\"{code}: code page never 500s\", r.status_code != 500, r.status_code)","+    check(f\"{code}: code page renders 200 (live occurrence stands in for \"","+         \"the missing FES-log history)\", r.status_code == 200, r.status_code)","+    if r.status_code != 200:","+        continue","+    text = r.text","+    check(f\"{code}: page marks itself live-only (no FES log on file)\",","+         \"live-only\" in text.lower())","+    check(f\"{code}: page shows at least one live occurrence's module\",","+         any(ecu in text for ecu in (\"BCM\", \"IPC\", \"ECM\", \"RFHUB\")))","+    check(f\"{code}: page shows a fault-tree next step or an explicit UNKNOWN\",","+         \"Fault-tree next step\" in text)","+    check(f\"{code}: page carries a parts line, real or explicit UNKNOWN/TechAuthority\",","+         \"TechAuthority\" in text or \"Parts for\" in text)","+","+# A code neither logged nor ever read live on this car is still a 404 -- the","+# live-occurrence fallback must never swallow a genuinely unknown code.","+r = client.get(f\"/v/{VIN}/code/P9999\")","+check(\"a code with no log history and no live occurrence is still a 404\",","+     r.status_code == 404, r.status_code)","+"," print(f\"checks run: {checks}\")"," if failures:","     print(f\"FAILURES: {len(failures)}\")"]}]},{"filePath":"C:\\Users\\User\\mcp-servers\\cuore\\web\\routes.py","hunks":[{"oldStart":396,"oldLines":22,"newStart":396,"newLines":180,"lines":["     return response"," "," ","+#: same honest-never-invented text the report page uses (``report_routes.","+#: _UNKNOWN_TEXT``) -- kept as a second literal rather than imported from","+#: there because ``report_routes`` imports this module at load time","+#: (``from . import routes as web_routes``), so the reverse import would","+#: be circular.","+_CODE_UNKNOWN_TEXT = \"UNKNOWN -- use the service manual (TechAuthority)\"","+","+","+def _module_dtc_state(flags: dict[str, Any]) -> str | None:","+    \"\"\"ACTIVE, HISTORY, or ``None`` -- same rule as ``dossier_bridge.","+    _module_dtc_state``, reimplemented here for the same reason ``_base``","+    is reimplemented there: one fewer cross-module private import.\"\"\"","+    if flags.get(\"testFailed\") or flags.get(\"pendingDTC\"):","+        return \"ACTIVE\"","+    if flags.get(\"confirmedDTC\") or flags.get(\"testFailedSinceLastClear\"):","+        return \"HISTORY\"","+    return None","+","+","+def _code_failure_type(suffix: str) -> dict[str, Any]:","+    \"\"\"The decoded meaning of one failure-type-byte suffix (``mes.dtc``),","+    or an honest ``UNKNOWN`` -- never invented, never raises.\"\"\"","+    if not suffix:","+        return {\"text\": _CODE_UNKNOWN_TEXT, \"confidence\": \"UNKNOWN\"}","+    try:","+        from mes import dtc as dtc_mod","+    except Exception:  # noqa: BLE001 -- optional dependency","+        return {\"text\": _CODE_UNKNOWN_TEXT, \"confidence\": \"UNKNOWN\"}","+    try:","+        ft = dtc_mod.failure_type(suffix)","+    except Exception:  # noqa: BLE001","+        ft = None","+    if ft is None:","+        return {\"text\": _CODE_UNKNOWN_TEXT, \"confidence\": \"UNKNOWN\"}","+    d = ft.to_dict()","+    return {\"text\": d.get(\"text\") or d.get(\"meaning\") or _CODE_UNKNOWN_TEXT,","+            \"confidence\": d.get(\"confidence\", \"UNKNOWN\"), \"source\": d.get(\"source\")}","+","+","+def _code_description_fallback(code: str) -> dict[str, Any]:","+    \"\"\"This platform's sourced description for ``code``, or an honest","+    ``UNKNOWN`` -- never invented, never raises. Covers a code never seen","+    in an FES log (a module code read only live, e.g. B10AA, U1736).\"\"\"","+    try:","+        from mes import dtc_descriptions","+    except Exception:  # noqa: BLE001 -- optional dependency","+        return {\"code\": code, \"text\": _CODE_UNKNOWN_TEXT, \"source\": \"none\", \"confidence\": \"UNKNOWN\"}","+    try:","+        return dtc_descriptions.code_description(code)","+    except Exception:  # noqa: BLE001 -- this page must never 500 on this","+        return {\"code\": code, \"text\": _CODE_UNKNOWN_TEXT, \"source\": \"none\", \"confidence\": \"UNKNOWN\"}","+","+","+def _code_fault_tree_steps(vin: str, code: str) -> list[dict[str, Any]]:","+    \"\"\"Up to the first tree's first 6 steps for ``code`` (``mes_bridge.","+    fault_tree``, the same source the report's own fallback entry uses),","+    or ``[]`` when no tree covers it -- the template shows an explicit","+    UNKNOWN line in that case, never a silently-missing section.\"\"\"","+    try:","+        result = mes_bridge.fault_tree(code, vin=vin)","+    except Exception:  # noqa: BLE001 -- this page must never 500 on this","+        result = {}","+    steps: list[dict[str, Any]] = []","+    for t in (result.get(\"trees\") or [])[:1]:","+        for s in (t.get(\"steps\") or [])[:6]:","+            steps.append({\"text\": s.get(\"title\") or s.get(\"test\") or \"Step\",","+                         \"ref\": s.get(\"source\")})","+    return steps","+","+","+def _live_code_occurrences(vin: str, code_upper: str) -> list[dict[str, Any]]:","+    \"\"\"Every from-car module (UDS 0x19) or generic OBD (Mode 03/07/0A) read","+    of ``code_upper`` this car has on file, newest first -- the live","+    stand-in for FES-log history when no log on file has ever carried the","+    code (e.g. B10AA, U1736: read live on 2026-10-13, never logged to a","+    file). ``[]`` on any failure, or when the code was never read live --","+    never raises, and an empty result is exactly what tells the caller to","+    fall back to the ordinary 404.","+    \"\"\"","+    try:","+        from ..live import store as live_store","+    except Exception:  # noqa: BLE001 -- optional dependency","+        return []","+","+    out: list[dict[str, Any]] = []","+","+    try:","+        module_obs = live_store.recent_observations(1000, vin=vin, kind=\"module_dtcs\")","+    except Exception:  # noqa: BLE001","+        module_obs = []","+    for o in module_obs:","+        if not live_store.is_from_car(o):","+            continue","+        data = o.get(\"data\") or {}","+        ecu = data.get(\"ecu\") or \"?\"","+        at = o.get(\"at\") or \"\"","+        for d in data.get(\"dtcs\") or []:","+            full = str(d.get(\"code\") or \"\").strip().upper()","+            base, _, suffix = full.partition(\"-\")","+            if base != code_upper:","+                continue","+            flags = d.get(\"flags\") or {}","+            state = _module_dtc_state(flags)","+            out.append({\"at\": at, \"module\": ecu, \"code\": full,","+                       \"status\": d.get(\"status\"), \"flags\": flags, \"state\": state,","+                       \"state_class\": {\"ACTIVE\": \"status-active\",","+                                       \"HISTORY\": \"chronic\"}.get(state, \"plain\"),","+                       \"failure_type\": _code_failure_type(suffix)})","+","+    try:","+        obd_obs = live_store.recent_observations(300, vin=vin, kind=\"obd_dtcs\")","+    except Exception:  # noqa: BLE001","+        obd_obs = []","+    for o in obd_obs:","+        if not live_store.is_from_car(o):","+            continue","+        data = o.get(\"data\") or {}","+        at = o.get(\"at\") or \"\"","+        inner = str(data.get(\"kind\") or \"\")","+        for c in data.get(\"dtcs\") or []:","+            full = str(c).strip().upper()","+            base = full.split(\"-\", 1)[0]","+            if base != code_upper:","+                continue","+            out.append({\"at\": at, \"module\": f\"OBD ({inner})\" if inner else \"OBD\",","+                       \"code\": full, \"status\": None, \"flags\": {},","+                       \"state\": inner.upper() if inner else None,","+                       \"state_class\": \"plain\", \"failure_type\": {}})","+","+    out.sort(key=lambda r: r.get(\"at\") or \"\", reverse=True)","+    return out","+","+"," @router.get(\"/v/{vin}/code/{code}\", response_class=HTMLResponse)"," def code_detail(request: Request, vin: str, code: str) -> HTMLResponse:","-    \"\"\"One code's complete life, with its freeze frames beside it.\"\"\"","+    \"\"\"One code's complete life, with its freeze frames beside it.","+","+    A code with no FES-log history still renders here, rather than 404ing,","+    when this car's own live module (UDS 0x19) or OBD read ever reported","+    it -- e.g. U1736, B10AA, read live on 2026-10-13 but never logged to a","+    file. The live occurrence(s) stand in for the log-history table, with","+    the same description/fault-tree/parts(UNKNOWN) fallback blocks the","+    report page (``report_routes._fixes_fallback``/``_parts_section``)","+    already uses for exactly this situation. Only a code neither logged","+    nor ever read live on this car is still a 404.","+    \"\"\"","     dossier = _dossier(vin)","-    history = mes_bridge.dtc_history(code, vin=vin)","+    code_upper = code.strip().upper()","+    live_only = False","+    live_occurrences: list[dict[str, Any]] = []","+    description: dict[str, Any] = {}","+    fault_tree_steps: list[dict[str, Any]] = []","+    try:","+        history = mes_bridge.dtc_history(code, vin=vin)","+    except BridgeError:","+        live_occurrences = _live_code_occurrences(vin, code_upper)","+        if not live_occurrences:","+            raise","+        live_only = True","+        history = {\"code\": code_upper, \"matches\": []}","+        description = _code_description_fallback(code_upper)","+        fault_tree_steps = _code_fault_tree_steps(vin, code_upper)","     try:","         frames = mes_bridge.freeze_frames(code=code, vin=vin)","     except BridgeError:","         frames = {\"count\": 0, \"frames\": []}","-    code_upper = code.upper()","     code_notes = mes_bridge.notes(vin, target_kind=\"code\", target_id=code_upper)[\"notes\"]","     response = _page(request, \"code.html\", vin=vin, code=code_upper,","                      records=history[\"matches\"], frames=frames,","                      notes_list=code_notes, note_target_kind=\"code\",","                      note_target_id=code_upper, note_redirect=f\"/v/{vin}/code/{code_upper}\",","                      note_kind_locked=True,","+                     live_only=live_only, live_occurrences=live_occurrences,","+                     description=description, fault_tree_steps=fault_tree_steps,","                      bar=_vehicle_bar(vin, dossier), tab=\"codes\")","     _set_active_vehicle(response, vin)","     return response"]}]},{"filePath":"C:\\Users\\User\\mcp-servers\\cuore\\web\\templates\\code.html","hunks":[{"oldStart":71,"oldLines":9,"newStart":71,"newLines":63,"lines":["   </div>"," </div>"," {% else %}","-  <div class=\"panel\"><p class=\"muted\">No record of this code in real logs.</p></div>","+  <div class=\"panel\"><p class=\"muted\">","+    {% if live_only %}No FES-log history for this code -- see the live occurrences below.","+    {% else %}No record of this code in real logs.{% endif %}","+  </p></div>"," {% endfor %}"," ","+{% if live_only %}","+<div class=\"panel\">","+  <h3>{{ code }} <span class=\"chip plain\">live-only -- no FES log on file</span></h3>","+  {% if description.text %}","+  <p class=\"lede\">{{ description.text }}","+    {% if description.source and description.source != \"none\" %}<span class=\"chip plain\">{{ description.source }}</span>{% endif %}</p>","+  {% endif %}","+","+  <h3>Every live occurrence</h3>","+  <div class=\"tw\">","+  <table>","+    <thead><tr><th>When</th><th>Module</th><th>Code</th><th>State</th><th class=\"n\">Status</th><th>Failure type</th></tr></thead>","+    <tbody>","+    {% for o in live_occurrences %}","+      <tr>","+        <td class=\"mono small\">{{ o.at }}</td>","+        <td>{{ o.module }}</td>","+        <td class=\"mono\">{{ o.code }}</td>","+        <td>{% if o.state %}<span class=\"chip {{ o.state_class }}\">{{ o.state }}</span>{% else %}&mdash;{% endif %}</td>","+        <td class=\"n mono small\">{% if o.status is not none %}{{ o.status }}{% else %}&mdash;{% endif %}</td>","+        <td>{{ o.failure_type.text if o.failure_type else \"\" }}</td>","+      </tr>","+    {% endfor %}","+    </tbody>","+  </table>","+  </div>","+","+  <h3>Fault-tree next step</h3>","+  {% if fault_tree_steps %}","+  <ol>","+    {% for s in fault_tree_steps %}","+    <li>{{ s.text }}{% if s.ref %} <span class=\"muted small\">({{ s.ref }})</span>{% endif %}</li>","+    {% endfor %}","+  </ol>","+  {% else %}","+  <p class=\"muted\">UNKNOWN -- use the service manual (TechAuthority)</p>","+  {% endif %}","+</div>","+{% endif %}","+","+{# parts_for is a Jinja global registered by cuore/web/parts_routes.py as a","+   side effect of importing it (see that module's docstring) -- guarded here","+   so this page still renders before app.py wires that router in. Scoped to","+   live_only so an ordinary FES-logged code with no catalogued part keeps its","+   current (silent) behaviour -- only a code only ever read live gets this","+   explicit UNKNOWN line, matching the report page's own parts fallback. #}","+{% if live_only and not (parts_for is defined and parts_for(code=code)) %}","+<h2>Parts for {{ code }}</h2>","+<p class=\"muted\">UNKNOWN -- use the service manual (TechAuthority)</p>","+{% endif %}","+"," <h2>Freeze frames</h2>"," {% if frames.count %}","   <p class=\"lede\">The conditions captured when the code set. <b>A clear destroys"]}]}],"moreFiles":0,"changedFiles":["C:\\Users\\User\\mcp-servers\\cuore\\tests\\check_report_coverage.py","C:\\Users\\User\\mcp-servers\\cuore\\web\\routes.py","C:\\Users\\User\\mcp-servers\\cuore\\web\\templates\\code.html"]}},"serverClassifierContext":{"request":"56e145be-86d9-4559-9f82-8075f6834bce","context":{"git_state":{"cwd":"/c/Users/User/mcp-servers","root":null,"branch":null,"default_branch":null,"status":null,"visibility":null,"error":"pending"},"live_cwd":"/c/Users/User/mcp-servers","platform":"windows"}},"sourceToolAssistantUUID":"5b3c7735-271e-486d-a194-87a5190e7804","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
