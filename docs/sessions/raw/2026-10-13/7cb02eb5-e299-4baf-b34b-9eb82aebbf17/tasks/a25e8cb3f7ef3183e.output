{"parentUuid":"1730f85f-8bd2-4c5e-b3ff-81607f00b87f","isSidechain":true,"agentId":"a25e8cb3f7ef3183e","message":{"model":"claude-sonnet-5","id":"msg_011Cg1c1aS5zG3WNzqDFKvin","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01DueQVvM3P1D65LFerUsYpG","name":"Read","input":{"file_path":"C:\\Users\\User\\mcp-servers\\cuore\\web\\report_routes.py"},"caller":{"type":"direct"}}],"container":null,"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":940,"cache_read_input_tokens":67204,"output_tokens":74,"output_tokens_details":{"thinking_tokens":0},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":0,"ephemeral_5m_input_tokens":940},"inference_geo":"global","iterations":[{"input_tokens":2,"output_tokens":74,"cache_read_input_tokens":67204,"cache_creation_input_tokens":940,"cache_creation":{"ephemeral_5m_input_tokens":940,"ephemeral_1h_input_tokens":0},"type":"message"}],"speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_01DueQVvM3P1D65LFerUsYpG":{"file_path":"C:\\Users\\User\\mcp-servers\\cuore\\web\\report_routes.py"}},"serverClassifierRequest":"165eead5-fe16-46d6-931c-50bf19053c8b","apiBlockIndex":0,"requestId":"req_011Cg1c1aBTdCvuG4SpANHfU","attributionAgent":"general-purpose","type":"assistant","uuid":"3e4a92df-381c-474e-b4fa-18a4edf20adc","timestamp":"2026-10-14T05:49:01.425Z","effort":"high","perTurnEffort":null,"userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
{"parentUuid":"3e4a92df-381c-474e-b4fa-18a4edf20adc","isSidechain":true,"promptId":"5cd953ab-0c8e-4107-8a17-c18cdc70a8f3","agentId":"a25e8cb3f7ef3183e","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01DueQVvM3P1D65LFerUsYpG","type":"tool_result","content":"1\t\"\"\"Printable and PDF reports: what the mechanic hands to the owner or files\n2\twith the job.\n3\t\n4\tA third client of the same bridges every other ``/v/`` page uses --\n5\t``dossier_bridge.build_view``, ``timeline_bridge``, ``experience_bridge`` --\n6\tnever a second source of truth. Nothing here invents a fix: a report's\n7\t\"possible fixes\" section is exactly the open-work checklist steps and\n8\tbulletin actions the dossier already carries, each with its own source and\n9\tconfidence. Parts and media are read lazily because neither is guaranteed to\n10\tbe wired on every install; a missing one means a skipped section, not a 500.\n11\t\"\"\"\n12\t\n13\tfrom __future__ import annotations\n14\t\n15\tfrom datetime import datetime, timezone\n16\tfrom typing import Any\n17\t\n18\tfrom fastapi import APIRouter, Depends, Request\n19\tfrom fastapi.responses import HTMLResponse, Response\n20\t\n21\tfrom ..api.deps import require_token\n22\tfrom ..services import dossier_bridge, experience_bridge, mes_bridge, timeline_bridge\n23\tfrom ..services.errors import BridgeError, NotFound\n24\tfrom . import report_pdf\n25\tfrom . import routes as web_routes\n26\t\n27\trouter = APIRouter(include_in_schema=False, dependencies=[Depends(require_token)])\n28\t\n29\t\n30\t# --- lazy, optional data sources -------------------------------------------\n31\t\n32\t\n33\tdef _parts_for_code(code: str) -> list[dict[str, Any]]:\n34\t    \"\"\"Parts for one code, or ``[]`` -- the parts bridge may not be wired.\"\"\"\n35\t    try:\n36\t        from ..services import parts_bridge\n37\t    except Exception:  # noqa: BLE001 -- optional dependency\n38\t        return []\n39\t    try:\n40\t        return list(parts_bridge.parts_for_code(code) or [])\n41\t    except Exception:  # noqa: BLE001 -- a report must never 500 on this\n42\t        return []\n43\t\n44\t\n45\tdef _cases_for(vin: str, codes: list[str]) -> list[dict[str, Any]]:\n46\t    \"\"\"Prior cases for this vehicle's model matching these codes, or ``[]``\n47\t    -- the cases bridge may not be wired (``cases_api`` is not registered\n48\t    on ``app.py`` yet; see ``cuore/api/cases.py``).\"\"\"\n49\t    try:\n50\t        from ..services import cases_bridge\n51\t    except Exception:  # noqa: BLE001 -- optional dependency\n52\t        return []\n53\t    try:\n54\t        return list(cases_bridge.match(vin, codes).get(\"matches\") or [])\n55\t    except Exception:  # noqa: BLE001 -- a report must never 500 on this\n56\t        return []\n57\t\n58\t\n59\tdef _photos_for(vin: str, limit: int = 6) -> list[dict[str, Any]]:\n60\t    \"\"\"Up to ``limit`` media rows for this vehicle, or ``[]`` -- the media\n61\t    library may not be wired.\"\"\"\n62\t    try:\n63\t        from ..live import media as media_mod\n64\t    except Exception:  # noqa: BLE001 -- optional dependency\n65\t        return []\n66\t    try:\n67\t        rows = media_mod.search(vin=vin) or []\n68\t    except Exception:  # noqa: BLE001\n69\t        return []\n70\t    return list(rows[:limit])\n71\t\n72\t\n73\t_UNKNOWN_TEXT = \"UNKNOWN -- use the service manual (TechAuthority)\"\n74\t\n75\t\n76\tdef _code_description(code: str) -> dict[str, Any]:\n77\t    \"\"\"This platform's sourced description for ``code`` (``mes.dtc_descriptions``),\n78\t    or an honest ``UNKNOWN`` -- never invented, never raises. Covers a code the\n79\t    report's own tables never got a description for because it was never seen\n80\t    in an FES log (a module code read only live, e.g. B10AA).\"\"\"\n81\t    try:\n82\t        from mes import dtc_descriptions\n83\t    except Exception:  # noqa: BLE001 -- optional dependency\n84\t        return {\"code\": code, \"text\": _UNKNOWN_TEXT, \"source\": \"none\", \"confidence\": \"UNKNOWN\"}\n85\t    try:\n86\t        return dtc_descriptions.code_description(code)\n87\t    except Exception:  # noqa: BLE001 -- a report must never 500 on this\n88\t        return {\"code\": code, \"text\": _UNKNOWN_TEXT, \"source\": \"none\", \"confidence\": \"UNKNOWN\"}\n89\t\n90\t\n91\tdef _live_code_suffixes(vin: str) -> dict[str, str]:\n92\t    \"\"\"Base code -> newest-seen failure-type-byte suffix (\"4A\", \"86\", ...),\n93\t    read straight off this car's own live module-DTC (UDS 0x19) observations\n94\t    -- the one place the full \"CODE-FTB\" token still survives;\n95\t    ``dossier_bridge``'s own ``live_module_dtcs`` already strips it down to\n96\t    the base code. ``{}`` on any failure -- never raises.\"\"\"\n97\t    try:\n98\t        from ..live import store as live_store\n99\t    except Exception:  # noqa: BLE001 -- optional dependency\n100\t        return {}\n101\t    try:\n102\t        obs = live_store.recent_observations(500, vin=vin, kind=\"module_dtcs\")\n103\t    except Exception:  # noqa: BLE001\n104\t        return {}\n105\t    best: dict[str, tuple[str, str]] = {}\n106\t    for o in obs:\n107\t        at = o.get(\"at\") or \"\"\n108\t        data = o.get(\"data\") or {}\n109\t        for d in data.get(\"dtcs\") or []:\n110\t            full = str(d.get(\"code\") or \"\")\n111\t            if \"-\" not in full:\n112\t                continue\n113\t            base, _, suffix = full.partition(\"-\")\n114\t            base = base.strip().upper()\n115\t            if not base or not suffix:\n116\t                continue\n117\t            if base not in best or at > best[base][0]:\n118\t                best[base] = (at, suffix)\n119\t    return {k: v[1] for k, v in best.items()}\n120\t\n121\t\n122\tdef _failure_type_text(suffix: str | None) -> dict[str, Any]:\n123\t    \"\"\"The decoded meaning of one failure-type-byte suffix (``mes.dtc``), or\n124\t    an honest ``UNKNOWN`` -- never invented, never raises.\"\"\"\n125\t    if not suffix:\n126\t        return {\"text\": _UNKNOWN_TEXT, \"confidence\": \"UNKNOWN\"}\n127\t    try:\n128\t        from mes import dtc as dtc_mod\n129\t    except Exception:  # noqa: BLE001 -- optional dependency\n130\t        return {\"text\": _UNKNOWN_TEXT, \"confidence\": \"UNKNOWN\"}\n131\t    try:\n132\t        ft = dtc_mod.failure_type(suffix)\n133\t    except Exception:  # noqa: BLE001\n134\t        ft = None\n135\t    if ft is None:\n136\t        return {\"text\": _UNKNOWN_TEXT, \"confidence\": \"UNKNOWN\"}\n137\t    d = ft.to_dict()\n138\t    return {\"text\": d.get(\"text\") or d.get(\"meaning\") or _UNKNOWN_TEXT,\n139\t            \"confidence\": d.get(\"confidence\", \"UNKNOWN\"), \"source\": d.get(\"source\")}\n140\t\n141\t\n142\tdef _all_report_codes(view: dict[str, Any]) -> list[str]:\n143\t    \"\"\"Every base code currently known for this car, for the \"Possible\n144\t    fixes\"/\"Parts for the open codes\" sections -- the Codes table (sourced\n145\t    from this car's MES-log history) unioned with this car's own live\n146\t    module (UDS 0x19) reads, ACTIVE or HISTORY alike, so a code seen live\n147\t    but never logged to an FES file (e.g. B10AA, read only live) is never\n148\t    silently dropped the way a loop over ``view[\"codes\"]`` alone would drop\n149\t    it.\"\"\"\n150\t    codes = {c[\"code\"] for c in (view.get(\"codes\") or [])}\n151\t    codes.update(m[\"code\"] for m in (view.get(\"live_module_dtcs\") or []))\n152\t    return sorted(codes)\n153\t\n154\t\n155\tdef _codes_covered_by_open_work(view: dict[str, Any]) -> set[str]:\n156\t    return {c for card in (view.get(\"open_work\") or []) for c in card.get(\"codes\", [])}\n157\t\n158\t\n159\tdef _fixes_fallback(vin: str, view: dict[str, Any],\n160\t                    all_codes: list[str]) -> list[dict[str, Any]]:\n161\t    \"\"\"One entry per live code the open-work cards do not already cover --\n162\t    a sourced fault-tree step sequence (``mes_bridge.fault_tree``, the same\n163\t    source ``dossier_bridge``'s own generic open-work cards use) when one\n164\t    exists, else an explicit UNKNOWN line, never a silently-missing code.\n165\t\n166\t    In practice this only ever fires for a code read live but never logged\n167\t    to an FES file *and* not covered by the hand-curated EVAP/network\n168\t    family steps either (e.g. B10AA, HISTORY-state only, read live on\n169\t    2026-10-13) -- every code this car's MES-log history or an ACTIVE live\n170\t    module read already earns an open-work card for.\n171\t    \"\"\"\n172\t    covered = _codes_covered_by_open_work(view)\n173\t    suffixes = _live_code_suffixes(vin)\n174\t    out: list[dict[str, Any]] = []\n175\t    for code in all_codes:\n176\t        if code in covered:\n177\t            continue\n178\t        description = _code_description(code)\n179\t        failure_type = _failure_type_text(suffixes.get(code))\n180\t        try:\n181\t            result = mes_bridge.fault_tree(code, vin=vin)\n182\t        except Exception:  # noqa: BLE001 -- a report must never 500 on this\n183\t            result = {}\n184\t        trees = result.get(\"trees\") or []\n185\t        steps = []\n186\t        for t in trees[:1]:\n187\t            for s in (t.get(\"steps\") or [])[:6]:\n188\t                steps.append({\"text\": s.get(\"title\") or s.get(\"test\") or \"Step\",\n189\t                             \"ref\": s.get(\"source\")})\n190\t        out.append({\"code\": code, \"description\": description,\n191\t                   \"failure_type\": failure_type, \"steps\": steps})\n192\t    return out\n193\t\n194\t\n195\t# --- shared context ---------------------------------------------------------\n196\t\n197\t\n198\tdef _stamp(bar: dict[str, Any]) -> dict[str, Any]:\n199\t    now = datetime.now(timezone.utc)\n200\t    return {\n201\t        \"generated\": now.strftime(\"%Y-%m-%d %H:%M UTC\"),\n202\t        \"data_through\": bar.get(\"last_log\") or \"no logs on file\",\n203\t    }\n204\t\n205\t\n206\tdef _feels_for_open_work(vin: str, open_work: list[dict[str, Any]]) -> list[dict[str, Any]]:\n207\t    \"\"\"\"What the driver would feel\" per open code family, next to this car's\n208\t    own symptom-correlation pattern for that code.\"\"\"\n209\t    out = []\n210\t    for card in open_work:\n211\t        for code in card.get(\"codes\", []):\n212\t            try:\n213\t                feel = timeline_bridge.code_feel(vin, code)\n214\t            except Exception:  # noqa: BLE001\n215\t                continue\n216\t            out.append({\"family\": card.get(\"family\"), \"family_title\": card.get(\"title\"),\n217\t                       **feel})\n218\t    return out\n219\t\n220\t\n221\tdef _experience_for(open_work: list[dict[str, Any]], codes: list[dict[str, Any]]\n222\t                    ) -> list[dict[str, Any]]:\n223\t    out = []\n224\t    seen_families: set[str] = set()\n225\t    for card in open_work:\n226\t        fam = card.get(\"family\")\n227\t        if not fam or fam in seen_families:\n228\t            continue\n229\t        seen_families.add(fam)\n230\t        res = experience_bridge.links_for(family=fam)\n231\t        if res.get(\"links\"):\n232\t            out.append({\"label\": card.get(\"title\") or fam, \"links\": res[\"links\"]})\n233\t    for c in codes:\n234\t        res = experience_bridge.links_for(code=c[\"code\"])\n235\t        if res.get(\"links\"):\n236\t            out.append({\"label\": c[\"code\"], \"links\": res[\"links\"]})\n237\t    return out\n238\t\n239\t\n240\tdef _parts_section(codes: list[str]) -> list[dict[str, Any]]:\n241\t    \"\"\"One group per code -- module codes (U/B) wired in the same way a\n242\t    P-code already is, never silently skipped: a code with nothing in\n243\t    ``mes.parts`` still gets a row here, marked ``unknown``, so the report\n244\t    says \"UNKNOWN -- use the service manual (TechAuthority)\" for it rather\n245\t    than making it look like the question was never asked.\"\"\"\n246\t    out = []\n247\t    for code in codes:\n248\t        rows = _parts_for_code(code)\n249\t        out.append({\"code\": code, \"parts\": rows, \"unknown\": not rows})\n250\t    return out\n251\t\n252\t\n253\tdef _report_context(vin: str) -> dict[str, Any]:\n254\t    dossier = web_routes._dossier(vin)\n255\t    bar = web_routes._vehicle_bar(vin, dossier)\n256\t    live_status = web_routes._status_strip()\n257\t    view = dossier_bridge.build_view(vin, dossier, live_status)\n258\t\n259\t    try:\n260\t        notes = mes_bridge.notes(vin, target_kind=\"vehicle\")[\"notes\"]\n261\t    except BridgeError:\n262\t        notes = []\n263\t\n264\t    try:\n265\t        timeline = timeline_bridge.build_timeline(vin)\n266\t        correlation_findings = timeline.get(\"findings\") or []\n267\t    except Exception:  # noqa: BLE001 -- a report must still render\n268\t        correlation_findings = []\n269\t\n270\t    all_codes = _all_report_codes(view)\n271\t\n272\t    return {\n273\t        \"vin\": vin,\n274\t        \"bar\": bar,\n275\t        \"view\": view,\n276\t        \"stamp\": _stamp(bar),\n277\t        \"feels\": _feels_for_open_work(vin, view[\"open_work\"]),\n278\t        \"correlation_findings\": correlation_findings,\n279\t        \"parts\": _parts_section(all_codes),\n280\t        \"fixes_fallback\": _fixes_fallback(vin, view, all_codes),\n281\t        \"experience\": _experience_for(view[\"open_work\"], view[\"codes\"]),\n282\t        \"notes\": notes,\n283\t        \"photos\": _photos_for(vin, 6),\n284\t        \"cases\": _cases_for(vin, [c[\"code\"] for c in view[\"codes\"]]),\n285\t    }\n286\t\n287\t\n288\tdef _code_report_context(vin: str, code: str) -> dict[str, Any]:\n289\t    code_upper = code.strip().upper()\n290\t    dossier = web_routes._dossier(vin)\n291\t    bar = web_routes._vehicle_bar(vin, dossier)\n292\t    live_status = web_routes._status_strip()\n293\t    view = dossier_bridge.build_view(vin, dossier, live_status)\n294\t\n295\t    history = mes_bridge.dtc_history(code_upper, vin=vin)  # raises NotFound -> 404\n296\t\n297\t    try:\n298\t        feel = timeline_bridge.code_feel(vin, code_upper)\n299\t    except Exception:  # noqa: BLE001\n300\t        feel = None\n301\t\n302\t    row = next((c for c in view[\"codes\"] if c[\"code\"] == code_upper), None)\n303\t    family = row.get(\"family\") if row else None\n304\t    card = next((c for c in view[\"open_work\"] if c.get(\"family\") == family), None) if family else None\n305\t    bulletins = [b for b in view[\"bulletins\"] if code_upper in (b.get(\"codes\") or [])]\n306\t    frames = [f for f in view[\"freeze_frames\"] if f.get(\"code\") == code_upper]\n307\t\n308\t    try:\n309\t        notes = mes_bridge.notes(vin, target_kind=\"code\", target_id=code_upper)[\"notes\"]\n310\t    except BridgeError:\n311\t        notes = []\n312\t\n313\t    exp = experience_bridge.links_for(code=code_upper)\n314\t    if family:\n315\t        fam_exp = experience_bridge.links_for(family=family)\n316\t        exp = {\"links\": (exp.get(\"links\") or []) + (fam_exp.get(\"links\") or [])}\n317\t\n318\t    return {\n319\t        \"vin\": vin, \"code\": code_upper, \"bar\": bar, \"view\": view,\n320\t        \"stamp\": _stamp(bar), \"row\": row, \"feel\": feel, \"card\": card,\n321\t        \"bulletins\": bulletins, \"frames\": frames, \"notes\": notes,\n322\t        \"parts\": _parts_for_code(code_upper), \"experience\": exp.get(\"links\") or [],\n323\t        \"history\": history,\n324\t    }\n325\t\n326\t\n327\t# --- routes ------------------------------------------------------------------\n328\t\n329\t\n330\t@router.get(\"/v/{vin}/report\", response_class=HTMLResponse)\n331\tdef report(request: Request, vin: str) -> HTMLResponse:\n332\t    \"\"\"The printable report: same page, on screen or on paper. ``print.css``\n333\t    does the rest.\"\"\"\n334\t    ctx = _report_context(vin)\n335\t    response = web_routes._page(request, \"report.html\", tab=\"report\", **ctx)\n336\t    web_routes._set_active_vehicle(response, vin)\n337\t    return response\n338\t\n339\t\n340\t@router.get(\"/v/{vin}/report.pdf\")\n341\tdef report_pdf_route(vin: str, size: str = \"letter\") -> Response:\n342\t    ctx = _report_context(vin)\n343\t    pdf_bytes = report_pdf.build_vehicle_pdf(ctx, size=size)\n344\t    return Response(content=pdf_bytes, media_type=\"application/pdf\",\n345\t                    headers={\"Content-Disposition\": f'inline; filename=\"{vin}-report.pdf\"'})\n346\t\n347\t\n348\t@router.get(\"/v/{vin}/code/{code}/report.pdf\")\n349\tdef code_report_pdf(vin: str, code: str, size: str = \"letter\") -> Response:\n350\t    \"\"\"One code, \"problem and possible fixes\" -- a 404 for a code with no\n351\t    history on this VIN, same as every other code page.\"\"\"\n352\t    ctx = _code_report_context(vin, code)\n353\t    pdf_bytes = report_pdf.build_code_pdf(ctx, size=size)\n354\t    code_upper = ctx[\"code\"]\n355\t    return Response(content=pdf_bytes, media_type=\"application/pdf\",\n356\t                    headers={\"Content-Disposition\":\n357\t                             f'inline; filename=\"{vin}-{code_upper}-report.pdf\"'})\n358\t\n359\t\n360\t__all__ = [\"router\"]\n361\t"}]},"uuid":"dd281c82-967c-4107-99f1-3af665ed7802","timestamp":"2026-10-14T05:49:01.456Z","toolUseResult":{"type":"text","file":{"filePath":"C:\\Users\\User\\mcp-servers\\cuore\\web\\report_routes.py","content":"\"\"\"Printable and PDF reports: what the mechanic hands to the owner or files\nwith the job.\n\nA third client of the same bridges every other ``/v/`` page uses --\n``dossier_bridge.build_view``, ``timeline_bridge``, ``experience_bridge`` --\nnever a second source of truth. Nothing here invents a fix: a report's\n\"possible fixes\" section is exactly the open-work checklist steps and\nbulletin actions the dossier already carries, each with its own source and\nconfidence. Parts and media are read lazily because neither is guaranteed to\nbe wired on every install; a missing one means a skipped section, not a 500.\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom datetime import datetime, timezone\nfrom typing import Any\n\nfrom fastapi import APIRouter, Depends, Request\nfrom fastapi.responses import HTMLResponse, Response\n\nfrom ..api.deps import require_token\nfrom ..services import dossier_bridge, experience_bridge, mes_bridge, timeline_bridge\nfrom ..services.errors import BridgeError, NotFound\nfrom . import report_pdf\nfrom . import routes as web_routes\n\nrouter = APIRouter(include_in_schema=False, dependencies=[Depends(require_token)])\n\n\n# --- lazy, optional data sources -------------------------------------------\n\n\ndef _parts_for_code(code: str) -> list[dict[str, Any]]:\n    \"\"\"Parts for one code, or ``[]`` -- the parts bridge may not be wired.\"\"\"\n    try:\n        from ..services import parts_bridge\n    except Exception:  # noqa: BLE001 -- optional dependency\n        return []\n    try:\n        return list(parts_bridge.parts_for_code(code) or [])\n    except Exception:  # noqa: BLE001 -- a report must never 500 on this\n        return []\n\n\ndef _cases_for(vin: str, codes: list[str]) -> list[dict[str, Any]]:\n    \"\"\"Prior cases for this vehicle's model matching these codes, or ``[]``\n    -- the cases bridge may not be wired (``cases_api`` is not registered\n    on ``app.py`` yet; see ``cuore/api/cases.py``).\"\"\"\n    try:\n        from ..services import cases_bridge\n    except Exception:  # noqa: BLE001 -- optional dependency\n        return []\n    try:\n        return list(cases_bridge.match(vin, codes).get(\"matches\") or [])\n    except Exception:  # noqa: BLE001 -- a report must never 500 on this\n        return []\n\n\ndef _photos_for(vin: str, limit: int = 6) -> list[dict[str, Any]]:\n    \"\"\"Up to ``limit`` media rows for this vehicle, or ``[]`` -- the media\n    library may not be wired.\"\"\"\n    try:\n        from ..live import media as media_mod\n    except Exception:  # noqa: BLE001 -- optional dependency\n        return []\n    try:\n        rows = media_mod.search(vin=vin) or []\n    except Exception:  # noqa: BLE001\n        return []\n    return list(rows[:limit])\n\n\n_UNKNOWN_TEXT = \"UNKNOWN -- use the service manual (TechAuthority)\"\n\n\ndef _code_description(code: str) -> dict[str, Any]:\n    \"\"\"This platform's sourced description for ``code`` (``mes.dtc_descriptions``),\n    or an honest ``UNKNOWN`` -- never invented, never raises. Covers a code the\n    report's own tables never got a description for because it was never seen\n    in an FES log (a module code read only live, e.g. B10AA).\"\"\"\n    try:\n        from mes import dtc_descriptions\n    except Exception:  # noqa: BLE001 -- optional dependency\n        return {\"code\": code, \"text\": _UNKNOWN_TEXT, \"source\": \"none\", \"confidence\": \"UNKNOWN\"}\n    try:\n        return dtc_descriptions.code_description(code)\n    except Exception:  # noqa: BLE001 -- a report must never 500 on this\n        return {\"code\": code, \"text\": _UNKNOWN_TEXT, \"source\": \"none\", \"confidence\": \"UNKNOWN\"}\n\n\ndef _live_code_suffixes(vin: str) -> dict[str, str]:\n    \"\"\"Base code -> newest-seen failure-type-byte suffix (\"4A\", \"86\", ...),\n    read straight off this car's own live module-DTC (UDS 0x19) observations\n    -- the one place the full \"CODE-FTB\" token still survives;\n    ``dossier_bridge``'s own ``live_module_dtcs`` already strips it down to\n    the base code. ``{}`` on any failure -- never raises.\"\"\"\n    try:\n        from ..live import store as live_store\n    except Exception:  # noqa: BLE001 -- optional dependency\n        return {}\n    try:\n        obs = live_store.recent_observations(500, vin=vin, kind=\"module_dtcs\")\n    except Exception:  # noqa: BLE001\n        return {}\n    best: dict[str, tuple[str, str]] = {}\n    for o in obs:\n        at = o.get(\"at\") or \"\"\n        data = o.get(\"data\") or {}\n        for d in data.get(\"dtcs\") or []:\n            full = str(d.get(\"code\") or \"\")\n            if \"-\" not in full:\n                continue\n            base, _, suffix = full.partition(\"-\")\n            base = base.strip().upper()\n            if not base or not suffix:\n                continue\n            if base not in best or at > best[base][0]:\n                best[base] = (at, suffix)\n    return {k: v[1] for k, v in best.items()}\n\n\ndef _failure_type_text(suffix: str | None) -> dict[str, Any]:\n    \"\"\"The decoded meaning of one failure-type-byte suffix (``mes.dtc``), or\n    an honest ``UNKNOWN`` -- never invented, never raises.\"\"\"\n    if not suffix:\n        return {\"text\": _UNKNOWN_TEXT, \"confidence\": \"UNKNOWN\"}\n    try:\n        from mes import dtc as dtc_mod\n    except Exception:  # noqa: BLE001 -- optional dependency\n        return {\"text\": _UNKNOWN_TEXT, \"confidence\": \"UNKNOWN\"}\n    try:\n        ft = dtc_mod.failure_type(suffix)\n    except Exception:  # noqa: BLE001\n        ft = None\n    if ft is None:\n        return {\"text\": _UNKNOWN_TEXT, \"confidence\": \"UNKNOWN\"}\n    d = ft.to_dict()\n    return {\"text\": d.get(\"text\") or d.get(\"meaning\") or _UNKNOWN_TEXT,\n            \"confidence\": d.get(\"confidence\", \"UNKNOWN\"), \"source\": d.get(\"source\")}\n\n\ndef _all_report_codes(view: dict[str, Any]) -> list[str]:\n    \"\"\"Every base code currently known for this car, for the \"Possible\n    fixes\"/\"Parts for the open codes\" sections -- the Codes table (sourced\n    from this car's MES-log history) unioned with this car's own live\n    module (UDS 0x19) reads, ACTIVE or HISTORY alike, so a code seen live\n    but never logged to an FES file (e.g. B10AA, read only live) is never\n    silently dropped the way a loop over ``view[\"codes\"]`` alone would drop\n    it.\"\"\"\n    codes = {c[\"code\"] for c in (view.get(\"codes\") or [])}\n    codes.update(m[\"code\"] for m in (view.get(\"live_module_dtcs\") or []))\n    return sorted(codes)\n\n\ndef _codes_covered_by_open_work(view: dict[str, Any]) -> set[str]:\n    return {c for card in (view.get(\"open_work\") or []) for c in card.get(\"codes\", [])}\n\n\ndef _fixes_fallback(vin: str, view: dict[str, Any],\n                    all_codes: list[str]) -> list[dict[str, Any]]:\n    \"\"\"One entry per live code the open-work cards do not already cover --\n    a sourced fault-tree step sequence (``mes_bridge.fault_tree``, the same\n    source ``dossier_bridge``'s own generic open-work cards use) when one\n    exists, else an explicit UNKNOWN line, never a silently-missing code.\n\n    In practice this only ever fires for a code read live but never logged\n    to an FES file *and* not covered by the hand-curated EVAP/network\n    family steps either (e.g. B10AA, HISTORY-state only, read live on\n    2026-10-13) -- every code this car's MES-log history or an ACTIVE live\n    module read already earns an open-work card for.\n    \"\"\"\n    covered = _codes_covered_by_open_work(view)\n    suffixes = _live_code_suffixes(vin)\n    out: list[dict[str, Any]] = []\n    for code in all_codes:\n        if code in covered:\n            continue\n        description = _code_description(code)\n        failure_type = _failure_type_text(suffixes.get(code))\n        try:\n            result = mes_bridge.fault_tree(code, vin=vin)\n        except Exception:  # noqa: BLE001 -- a report must never 500 on this\n            result = {}\n        trees = result.get(\"trees\") or []\n        steps = []\n        for t in trees[:1]:\n            for s in (t.get(\"steps\") or [])[:6]:\n                steps.append({\"text\": s.get(\"title\") or s.get(\"test\") or \"Step\",\n                             \"ref\": s.get(\"source\")})\n        out.append({\"code\": code, \"description\": description,\n                   \"failure_type\": failure_type, \"steps\": steps})\n    return out\n\n\n# --- shared context ---------------------------------------------------------\n\n\ndef _stamp(bar: dict[str, Any]) -> dict[str, Any]:\n    now = datetime.now(timezone.utc)\n    return {\n        \"generated\": now.strftime(\"%Y-%m-%d %H:%M UTC\"),\n        \"data_through\": bar.get(\"last_log\") or \"no logs on file\",\n    }\n\n\ndef _feels_for_open_work(vin: str, open_work: list[dict[str, Any]]) -> list[dict[str, Any]]:\n    \"\"\"\"What the driver would feel\" per open code family, next to this car's\n    own symptom-correlation pattern for that code.\"\"\"\n    out = []\n    for card in open_work:\n        for code in card.get(\"codes\", []):\n            try:\n                feel = timeline_bridge.code_feel(vin, code)\n            except Exception:  # noqa: BLE001\n                continue\n            out.append({\"family\": card.get(\"family\"), \"family_title\": card.get(\"title\"),\n                       **feel})\n    return out\n\n\ndef _experience_for(open_work: list[dict[str, Any]], codes: list[dict[str, Any]]\n                    ) -> list[dict[str, Any]]:\n    out = []\n    seen_families: set[str] = set()\n    for card in open_work:\n        fam = card.get(\"family\")\n        if not fam or fam in seen_families:\n            continue\n        seen_families.add(fam)\n        res = experience_bridge.links_for(family=fam)\n        if res.get(\"links\"):\n            out.append({\"label\": card.get(\"title\") or fam, \"links\": res[\"links\"]})\n    for c in codes:\n        res = experience_bridge.links_for(code=c[\"code\"])\n        if res.get(\"links\"):\n            out.append({\"label\": c[\"code\"], \"links\": res[\"links\"]})\n    return out\n\n\ndef _parts_section(codes: list[str]) -> list[dict[str, Any]]:\n    \"\"\"One group per code -- module codes (U/B) wired in the same way a\n    P-code already is, never silently skipped: a code with nothing in\n    ``mes.parts`` still gets a row here, marked ``unknown``, so the report\n    says \"UNKNOWN -- use the service manual (TechAuthority)\" for it rather\n    than making it look like the question was never asked.\"\"\"\n    out = []\n    for code in codes:\n        rows = _parts_for_code(code)\n        out.append({\"code\": code, \"parts\": rows, \"unknown\": not rows})\n    return out\n\n\ndef _report_context(vin: str) -> dict[str, Any]:\n    dossier = web_routes._dossier(vin)\n    bar = web_routes._vehicle_bar(vin, dossier)\n    live_status = web_routes._status_strip()\n    view = dossier_bridge.build_view(vin, dossier, live_status)\n\n    try:\n        notes = mes_bridge.notes(vin, target_kind=\"vehicle\")[\"notes\"]\n    except BridgeError:\n        notes = []\n\n    try:\n        timeline = timeline_bridge.build_timeline(vin)\n        correlation_findings = timeline.get(\"findings\") or []\n    except Exception:  # noqa: BLE001 -- a report must still render\n        correlation_findings = []\n\n    all_codes = _all_report_codes(view)\n\n    return {\n        \"vin\": vin,\n        \"bar\": bar,\n        \"view\": view,\n        \"stamp\": _stamp(bar),\n        \"feels\": _feels_for_open_work(vin, view[\"open_work\"]),\n        \"correlation_findings\": correlation_findings,\n        \"parts\": _parts_section(all_codes),\n        \"fixes_fallback\": _fixes_fallback(vin, view, all_codes),\n        \"experience\": _experience_for(view[\"open_work\"], view[\"codes\"]),\n        \"notes\": notes,\n        \"photos\": _photos_for(vin, 6),\n        \"cases\": _cases_for(vin, [c[\"code\"] for c in view[\"codes\"]]),\n    }\n\n\ndef _code_report_context(vin: str, code: str) -> dict[str, Any]:\n    code_upper = code.strip().upper()\n    dossier = web_routes._dossier(vin)\n    bar = web_routes._vehicle_bar(vin, dossier)\n    live_status = web_routes._status_strip()\n    view = dossier_bridge.build_view(vin, dossier, live_status)\n\n    history = mes_bridge.dtc_history(code_upper, vin=vin)  # raises NotFound -> 404\n\n    try:\n        feel = timeline_bridge.code_feel(vin, code_upper)\n    except Exception:  # noqa: BLE001\n        feel = None\n\n    row = next((c for c in view[\"codes\"] if c[\"code\"] == code_upper), None)\n    family = row.get(\"family\") if row else None\n    card = next((c for c in view[\"open_work\"] if c.get(\"family\") == family), None) if family else None\n    bulletins = [b for b in view[\"bulletins\"] if code_upper in (b.get(\"codes\") or [])]\n    frames = [f for f in view[\"freeze_frames\"] if f.get(\"code\") == code_upper]\n\n    try:\n        notes = mes_bridge.notes(vin, target_kind=\"code\", target_id=code_upper)[\"notes\"]\n    except BridgeError:\n        notes = []\n\n    exp = experience_bridge.links_for(code=code_upper)\n    if family:\n        fam_exp = experience_bridge.links_for(family=family)\n        exp = {\"links\": (exp.get(\"links\") or []) + (fam_exp.get(\"links\") or [])}\n\n    return {\n        \"vin\": vin, \"code\": code_upper, \"bar\": bar, \"view\": view,\n        \"stamp\": _stamp(bar), \"row\": row, \"feel\": feel, \"card\": card,\n        \"bulletins\": bulletins, \"frames\": frames, \"notes\": notes,\n        \"parts\": _parts_for_code(code_upper), \"experience\": exp.get(\"links\") or [],\n        \"history\": history,\n    }\n\n\n# --- routes ------------------------------------------------------------------\n\n\n@router.get(\"/v/{vin}/report\", response_class=HTMLResponse)\ndef report(request: Request, vin: str) -> HTMLResponse:\n    \"\"\"The printable report: same page, on screen or on paper. ``print.css``\n    does the rest.\"\"\"\n    ctx = _report_context(vin)\n    response = web_routes._page(request, \"report.html\", tab=\"report\", **ctx)\n    web_routes._set_active_vehicle(response, vin)\n    return response\n\n\n@router.get(\"/v/{vin}/report.pdf\")\ndef report_pdf_route(vin: str, size: str = \"letter\") -> Response:\n    ctx = _report_context(vin)\n    pdf_bytes = report_pdf.build_vehicle_pdf(ctx, size=size)\n    return Response(content=pdf_bytes, media_type=\"application/pdf\",\n                    headers={\"Content-Disposition\": f'inline; filename=\"{vin}-report.pdf\"'})\n\n\n@router.get(\"/v/{vin}/code/{code}/report.pdf\")\ndef code_report_pdf(vin: str, code: str, size: str = \"letter\") -> Response:\n    \"\"\"One code, \"problem and possible fixes\" -- a 404 for a code with no\n    history on this VIN, same as every other code page.\"\"\"\n    ctx = _code_report_context(vin, code)\n    pdf_bytes = report_pdf.build_code_pdf(ctx, size=size)\n    code_upper = ctx[\"code\"]\n    return Response(content=pdf_bytes, media_type=\"application/pdf\",\n                    headers={\"Content-Disposition\":\n                             f'inline; filename=\"{vin}-{code_upper}-report.pdf\"'})\n\n\n__all__ = [\"router\"]\n","numLines":361,"startLine":1,"totalLines":361}},"sourceToolAssistantUUID":"3e4a92df-381c-474e-b4fa-18a4edf20adc","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
