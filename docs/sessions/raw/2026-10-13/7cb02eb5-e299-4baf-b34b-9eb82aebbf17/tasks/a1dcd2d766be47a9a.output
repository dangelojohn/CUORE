{"parentUuid":"c8ca19b4-7b75-4916-be41-2e4b5ce44914","isSidechain":true,"agentId":"a1dcd2d766be47a9a","message":{"model":"claude-sonnet-5","id":"msg_011CfooB5rPnc2guRZ2m5PnB","type":"message","role":"assistant","content":[{"type":"thinking","thinking":"","signature":""}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":3673,"cache_read_input_tokens":81752,"cache_creation":{"ephemeral_5m_input_tokens":3673,"ephemeral_1h_input_tokens":0},"output_tokens":7,"service_tier":"standard","inference_geo":"not_available"},"input_transformations":[],"diagnostics":null,"context_management":null},"serverClassifierRequest":"f023dab9-613a-4d97-a124-dcac6e98d1f8","apiBlockIndex":0,"requestId":"req_011CfooB5YHJWz16nk8jQNx5","attributionAgent":"general-purpose","type":"assistant","uuid":"84583f0e-e5a3-48ce-84f5-949bc9a57b2d","timestamp":"2026-10-08T00:08:28.787Z","effort":"high","perTurnEffort":null,"userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
{"parentUuid":"84583f0e-e5a3-48ce-84f5-949bc9a57b2d","isSidechain":true,"agentId":"a1dcd2d766be47a9a","message":{"model":"claude-sonnet-5","id":"msg_011CfooB5rPnc2guRZ2m5PnB","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01Q97Gv7dxfuMV7G7NYNvLG3","name":"Read","input":{"file_path":"C:\\Users\\User\\mcp-servers\\mes-log-mcp\\mes\\service_specs.py"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":3673,"cache_read_input_tokens":81752,"cache_creation":{"ephemeral_5m_input_tokens":3673,"ephemeral_1h_input_tokens":0},"output_tokens":7,"service_tier":"standard","inference_geo":"not_available"},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_01Q97Gv7dxfuMV7G7NYNvLG3":{"file_path":"C:\\Users\\User\\mcp-servers\\mes-log-mcp\\mes\\service_specs.py"}},"serverClassifierRequest":"f023dab9-613a-4d97-a124-dcac6e98d1f8","apiBlockIndex":1,"requestId":"req_011CfooB5YHJWz16nk8jQNx5","attributionAgent":"general-purpose","type":"assistant","uuid":"a88d4484-f4ff-4977-bc26-71a1b33aa639","timestamp":"2026-10-08T00:08:29.475Z","effort":"high","perTurnEffort":null,"userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
{"parentUuid":"a88d4484-f4ff-4977-bc26-71a1b33aa639","isSidechain":true,"promptId":"01b24783-2d87-4e75-9b89-4a104a7211fd","agentId":"a1dcd2d766be47a9a","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Q97Gv7dxfuMV7G7NYNvLG3","type":"tool_result","content":"1\t\"\"\"Reference data: 2018 Alfa Romeo Stelvio 2.0T (US) service specs.\n2\t\n3\tRead-only reference data -- nothing here touches the corpus or the car. It\n4\tbacks :mod:`mes.service` (the oil-change / general-service / brakes-wheels-\n5\ttyres ledger) and cuore's service pages. Every leaf value carries where it\n6\tcame from and how sure we are of it, because a torque spec a mechanic\n7\ttrusts wrongly is worse than one plainly marked unknown.\n8\t\n9\tConfidence levels (never invented -- an absent value is recorded as\n10\tUNKNOWN, never guessed):\n11\t\n12\t* ``CONFIRMED``     -- an actual manufacturer document (owner's manual,\n13\t                       Mopar/FCA parts catalog, FCA/Alfa service\n14\t                       information, TechAuthority excerpt).\n15\t* ``CORROBORATED``  -- two independent non-manufacturer sources agree.\n16\t* ``SINGLE_SOURCE`` -- exactly one source found, not cross-checked.\n17\t* ``UNKNOWN``       -- nothing credible found. ``value`` is ``None``, never\n18\t                       a placeholder number -- ``notes`` always points at\n19\t                       the service manual.\n20\t\n21\tThe 2018 Giulia 2.0T shares this car's GME-T4 MultiAir engine (sales code\n22\tEC2) and much of its running gear, so a fair amount of this is corroborated\n23\tfrom Giulia-specific sources. Every row that leans on Giulia sourcing says\n24\tso in ``platform_note`` -- it is offered as corroboration, not silently\n25\tfolded in as if it were Stelvio-specific.\n26\t\n27\tResearch pass done 2026-09-26 by web search against public sources (Mopar/\n28\tFCA parts listings, vehicleinfo.mopar.com, stelvioforum.com,\n29\tgiuliaforums.com, alfaowner.com, alfabb.com, parts/tool sites) plus this\n30\trepo's own ``docs/reference/ZF8HP_SERVICE_DATA.md``, which traces to actual\n31\tFCA/Alfa OEM service information for this platform. No paywalled FCA/\n32\tStellantis TechAuthority document was reached directly -- every value that\n33\tnames TechAuthority as its authority is a pointer to go get it, not a claim\n34\tthat document was actually read.\n35\t\n36\tSee ``docs/reference/STELVIO_20T_SERVICE_SPECS.md`` for the human-readable\n37\twriteup with the same data and full source links.\n38\t\"\"\"\n39\t\n40\tfrom __future__ import annotations\n41\t\n42\tfrom typing import Any, Iterable, Optional\n43\t\n44\tCONFIRMED = \"CONFIRMED\"\n45\tCORROBORATED = \"CORROBORATED\"\n46\tSINGLE_SOURCE = \"SINGLE-SOURCE\"\n47\tUNKNOWN = \"UNKNOWN\"\n48\t\n49\tCONFIDENCE_LEVELS = (CONFIRMED, CORROBORATED, SINGLE_SOURCE, UNKNOWN)\n50\t\n51\tTECHAUTHORITY = \"use the service manual (TechAuthority)\"\n52\t\n53\tVEHICLE = (\"2018 Alfa Romeo Stelvio 2.0T (GU), 2.0L GME-T4 MultiAir turbo, \"\n54\t          \"sales code EC2, US market, Q4 AWD, ZF 8HP automatic\")\n55\t\n56\tNM_PER_LBFT = 1.35582\n57\tLBFT_PER_NM = 0.737562149\n58\t\n59\t\n60\tdef nm_to_lbft(nm: Optional[float]) -> Optional[float]:\n61\t    if nm is None:\n62\t        return None\n63\t    return round(nm * LBFT_PER_NM, 1)\n64\t\n65\t\n66\tdef lbft_to_nm(lbft: Optional[float]) -> Optional[float]:\n67\t    if lbft is None:\n68\t        return None\n69\t    return round(lbft * NM_PER_LBFT, 1)\n70\t\n71\t\n72\t# --- oil service -------------------------------------------------------------\n73\t\n74\tOIL_SPEC: dict[str, dict[str, Any]] = {\n75\t    \"viscosity\": {\n76\t        \"value\": \"0W-30\", \"unit\": None,\n77\t        \"source\": \"https://bobistheoilguy.com/forums/threads/alfa-romeo-giulia-oil-fiat-spec-9-55535-gs1.344407/\",\n78\t        \"confidence\": CORROBORATED,\n79\t        \"notes\": \"0W-30 full synthetic is what the US 2.0T manuals call \"\n80\t                 \"for. Owners report 5W-40 (the Euro 'Selenia' spec \"\n81\t                 \"sharing this engine) is also approved and commonly used \"\n82\t                 \"in warmer climates -- SINGLE-SOURCE for that \"\n83\t                 \"substitution; treat 0W-30 as the primary US spec and \"\n84\t                 \"confirm against the filler-cap/owner's-manual sticker \"\n85\t                 \"on this specific car.\",\n86\t        \"platform_note\": \"Giulia-sourced; same engine as this Stelvio.\",\n87\t    },\n88\t    \"spec_approval\": {\n89\t        \"value\": \"FCA/Mopar MS-13340, API SN (2017-2018 build); \"\n90\t                 \"historically also cited as Fiat 9.55535-GS1\",\n91\t        \"unit\": None,\n92\t        \"source\": \"https://www.giuliaforums.com/threads/giulia-2-0l-oil-specifications-sn-versus-sn-plus-and-ms13340.50969/\",\n93\t        \"confidence\": CORROBORATED,\n94\t        \"notes\": \"Two independent threads (giuliaforums MS-13340 \"\n95\t                 \"discussion, bobistheoilguy 9.55535-GS1 thread) describe \"\n96\t                 \"the same spec: 2017-2018 MY calls for API SN meeting \"\n97\t                 \"MS-13340 / 9.55535-GS1 in 0W-30; 2019+ manuals move to \"\n98\t                 \"SN PLUS. Do NOT use MS-12633 (Pennzoil 0W-40 SN) -- that \"\n99\t                 \"is the Quadrifoglio/SRT-shared V6 spec, not this \"\n100\t                 \"engine's.\",\n101\t        \"platform_note\": \"Giulia-sourced; same engine as this Stelvio.\",\n102\t    },\n103\t    \"capacity_with_filter_qt\": {\n104\t        \"value\": 5.5, \"unit\": \"qt\", \"value_l\": 5.2,\n105\t        \"source\": \"https://www.amsoil.com/lookup/auto-and-light-truck/2018/alfa-romeo/stelvio/2-0l-4-cyl-engine-code-n-ec2-n-turbo/\",\n106\t        \"confidence\": SINGLE_SOURCE,\n107\t        \"notes\": \"AMSOIL's VIN/engine-code lookup tool, keyed to this \"\n108\t                 \"exact engine code (N) and sales code (EC2) -- a \"\n109\t                 \"parts-fitment lookup, not a manufacturer document, so \"\n110\t                 \"kept at SINGLE-SOURCE despite being VIN-specific. \"\n111\t                 \"Disregard aggregator pages quoting a wider 5.5-7.4 qt \"\n112\t                 \"range -- that clearly blends the 2.0T and the 2.9L V6 \"\n113\t                 \"into one page.\",\n114\t        \"platform_note\": None,\n115\t    },\n116\t}\n117\t\n118\tOIL_FILTER_PARTS: list[dict[str, Any]] = [\n119\t    {\"brand\": \"Mopar\", \"part_no\": \"4892339 (suffix revised over \"\n120\t     \"production -- BE / AB / AC seen; reported as 'same filter, revised \"\n121\t     \"part number')\",\n122\t     \"source\": \"https://www.giuliaforums.com/threads/oil-filter-2-0-part-number-change.49369/\",\n123\t     \"confidence\": SINGLE_SOURCE,\n124\t     \"notes\": \"The 2.0L-engine cartridge filter. Do NOT use 68191349AA/\"\n125\t              \"AC -- that family is the 3.0L/3.2L/3.6L V6 filter and \"\n126\t              \"appears repeatedly in search noise for this query. Confirm \"\n127\t              \"the exact current suffix against this VIN at a Mopar parts \"\n128\t              \"counter before ordering.\"},\n129\t    {\"brand\": \"(aftermarket cross-reference)\", \"part_no\": None,\n130\t     \"source\": None, \"confidence\": UNKNOWN,\n131\t     \"notes\": \"No confidently-sourced Mann/Bosch/K&N cross-reference for \"\n132\t              \"the 2.0L cartridge filter turned up in this research pass \"\n133\t              \"(a Magneti Marelli OEM-equivalent was mentioned on one \"\n134\t              \"forum without a part number). Cross-reference the Mopar \"\n135\t              \"4892339 number at a parts counter (RockAuto, FCP Euro) \"\n136\t              \"rather than guessing a Mann/Bosch number here.\"},\n137\t]\n138\t\n139\tDRAIN_PLUG = {\n140\t    \"part_no\": None, \"source\": None, \"confidence\": UNKNOWN,\n141\t    \"notes\": \"No separate drain-plug part number found. One source \"\n142\t             \"(see the drain-plug torque row) describes the 2.0T plug as \"\n143\t             \"having a built-in/captive rubber gasket rather than using a \"\n144\t             \"separate crush washer -- if true, replacing the whole plug \"\n145\t             \"may be the only way to renew the seal. \" + TECHAUTHORITY,\n146\t}\n147\t\n148\tDRAIN_PLUG_WASHER = {\n149\t    \"part_no\": None, \"reusable\": None, \"source\": None, \"confidence\": UNKNOWN,\n150\t    \"notes\": \"See DRAIN_PLUG -- SINGLE-SOURCE reports a captive gasket, \"\n151\t             \"not a separate washer. A washer part number (670050349) is \"\n152\t             \"documented for the Quadrifoglio V6, not the 2.0T -- do not \"\n153\t             \"assume it fits. Confirm plug design either from \"\n154\t             \"TechAuthority or by inspecting the removed plug.\",\n155\t}\n156\t\n157\tSERVICE_INTERVAL = {\n158\t    \"miles\": 8000, \"months\": 12,\n159\t    \"km\": round(8000 * 1.60934),\n160\t    \"source\": \"https://www.giuliaforums.com/threads/oil-change-frequency.47281/\",\n161\t    \"confidence\": CORROBORATED,\n162\t    \"notes\": \"8,000 miles / 12 months (whichever comes first) with full \"\n163\t             \"synthetic is the figure repeated across Costa Oil Change \"\n164\t             \"model-year guides and the giuliaforums/stelvioforum 'Oil \"\n165\t             \"Change Frequency' threads for both the Stelvio and Giulia \"\n166\t             \"2.0T. Conventional oil is explicitly NOT approved for this \"\n167\t             \"turbo engine. Owners report shortening to 5,000-6,000 miles \"\n168\t             \"for short-trip/stop-and-go/hard driving. MANUFACTURER LIMIT \"\n169\t             \"(CONFIRMED, 2018 Stelvio US owner's manual, Maintenance Plan \"\n170\t             \"note 3): the interval is set by the dash oil-change indicator \"\n171\t             \"and must never exceed 1 year / 10,000 miles (16,000 km); \"\n172\t             \"severe duty (dusty/off-road, mostly idling or very low RPM) \"\n173\t             \"4,000 miles (6,500 km). The 8,000 mi figure above is the \"\n174\t             \"conservative shop interval, inside the FCA limit.\",\n175\t    \"manufacturer_max\": {\"miles\": 10000, \"km\": 16000, \"months\": 12,\n176\t                         \"severe_duty_miles\": 4000, \"severe_duty_km\": 6500,\n177\t                         \"confidence\": CONFIRMED, \"source\": \"https://vehicleinfo.mopar.com/assets/publications/en-us/Alfa_Romeo/2018/Stelvio/P124461_18_GU_OM_EN_USC_DIGITAL_2nd_V2.pdf\"},\n178\t    \"oil_life_system\": {\n179\t        \"present\": True,\n180\t        \"behavior\": \"Algorithmic oil-life / service-due monitor driving \"\n181\t                    \"the cluster reminder, on top of the fixed interval \"\n182\t                    \"above -- described as an onboard oil-degradation \"\n183\t                    \"monitor that can trigger the reminder earlier based \"\n184\t                    \"on actual driving conditions. Treat the fixed \"\n185\t                    \"interval as the floor, the dash reminder as the \"\n186\t                    \"ceiling, whichever comes first.\",\n187\t        \"reset_methods\": [\n188\t            \"MES (MultiEcuScan) -- reported as the fastest/most reliable \"\n189\t            \"method, clears both the cluster reminder and day/mile \"\n190\t            \"counter in seconds.\",\n191\t            \"wiTECH (dealer tool) -- IPC module, Misc Functions, \"\n192\t            \"Maintenance Reset, follow prompts.\",\n193\t            \"Accelerator-pedal method (no tool) -- ignition on/engine \"\n194\t            \"off, fully depress and release the accelerator pedal slowly \"\n195\t            \"3 times (some cluster software revisions reportedly need \"\n196\t            \"4-6 pumps), 1 second apart, then start the engine. \"\n197\t            \"Unofficial and reported inconsistent across software \"\n198\t            \"revisions.\",\n199\t        ],\n200\t        \"source\": \"https://www.stelvioforum.com/threads/alfa-romeo-stelvio-giulia-oil-change-maintenance-reset.19336/\",\n201\t        \"confidence\": SINGLE_SOURCE,\n202\t    },\n203\t}\n204\t\n205\t\n206\t# --- torque library ----------------------------------------------------------\n207\t#\n208\t# One row per fastener/job. ``categories`` lets one fastener appear on more\n209\t# than one job's checklist (the wheel lug bolt matters to \"oil_change\" --\n210\t# because a tech often rotates tyres at the same visit -- as well as\n211\t# \"wheels\" and both brake categories).\n212\t\n213\tTORQUES: list[dict[str, Any]] = []\n214\t\n215\t\n216\tdef _torque(key: str, component: str, categories: Iterable[str],\n217\t            value: Optional[float], unit: Optional[str], *,\n218\t            value_range: Optional[tuple[float, float]] = None,\n219\t            angle: Optional[str] = None, single_use: bool = False,\n220\t            source: Optional[str] = None, confidence: str = UNKNOWN,\n221\t            notes: str = \"\", platform_note: Optional[str] = None,\n222\t            display: Optional[str] = None) -> None:\n223\t    if confidence not in CONFIDENCE_LEVELS:\n224\t        raise ValueError(f\"bad confidence {confidence!r}\")\n225\t    value_nm = value if unit == \"Nm\" else (lbft_to_nm(value) if unit == \"lb-ft\" else None)\n226\t    value_lbft = value if unit == \"lb-ft\" else (nm_to_lbft(value) if unit == \"Nm\" else None)\n227\t    if not notes and confidence == UNKNOWN:\n228\t        notes = TECHAUTHORITY\n229\t    TORQUES.append({\n230\t        \"key\": key,\n231\t        \"component\": component,\n232\t        \"categories\": tuple(categories),\n233\t        \"value\": value,\n234\t        \"unit\": unit,\n235\t        \"value_nm\": value_nm,\n236\t        \"value_lbft\": value_lbft,\n237\t        \"value_range\": value_range,\n238\t        \"display\": display or (f\"{value} {unit}\" if value is not None else \"UNKNOWN\"),\n239\t        \"angle\": angle,\n240\t        \"single_use\": single_use,\n241\t        \"source\": source,\n242\t        \"confidence\": confidence,\n243\t        \"notes\": notes.strip(),\n244\t        \"platform_note\": platform_note,\n245\t    })\n246\t\n247\t\n248\t# oil change / wheels ---------------------------------------------------------\n249\t_torque(\"drain_plug\", \"Oil drain plug\", [\"oil_change\"], 20, \"Nm\",\n250\t        source=\"https://www.stelvioforum.com/threads/oil-drain-bolt-torque-for-the-2-0t-multiair-280-bhp-engine.12917/\",\n251\t        confidence=SINGLE_SOURCE,\n252\t        notes=\"Reported for the 2.0T MultiAir drain plug, described by \"\n253\t              \"this source as having a built-in rubber gasket. Low torque \"\n254\t              \"for a drain plug -- easy to overtighten past this into the \"\n255\t              \"pan threads; use a torque wrench, not feel.\")\n256\t\n257\t_torque(\"filter_cap\", \"Oil filter housing cap (cartridge filter)\",\n258\t        [\"oil_change\"], 25, \"Nm\",\n259\t        source=\"https://www.alfaowner.com/threads/multiair-oil-filter-torque-setting.1116586/\",\n260\t        confidence=SINGLE_SOURCE,\n261\t        notes=\"This engine uses a cartridge filter under a screw-on \"\n262\t              \"plastic housing cap with its own O-ring, not a spin-on \"\n263\t              \"canister. Do not overtighten -- the housing is plastic.\",\n264\t        platform_note=\"Giulia-sourced (2016 MY reference in the thread).\")\n265\t\n266\t_torque(\"wheel_lug\", \"Wheel lug bolts\",\n267\t        [\"oil_change\", \"wheels\", \"brakes_front\", \"brakes_rear\",\n268\t         \"wheel_bearing\"],\n269\t        121, \"Nm\", value_range=(120.7, 122.0),\n270\t        source=\"https://www.alfaowner.com/threads/wheel-bolt-torque-settings.1071610/\",\n271\t        confidence=CORROBORATED,\n272\t        notes=\"Bolts threaded into the hub, NOT nuts on studs -- \"\n273\t              \"confirmed by all sources. Two independent threads \"\n274\t              \"(alfaowner 'Wheel bolt torque settings', stelvioforum \"\n275\t              \"'Stelvio Veloce wheel bolt torque setting') land at \"\n276\t              \"89-90 ft-lb (~121-122 Nm); use that. A third alfaowner \"\n277\t              \"thread reports 110 Nm/81 ft-lb for '14mm bolts', possibly \"\n278\t              \"a different bolt/thread size on a different wheel option \"\n279\t              \"-- confirm which bolt is fitted before trusting either \"\n280\t              \"figure; this is a safety-critical fastener. Torque in a \"\n281\t              \"star/cross pattern, snug then final torque.\")\n282\t\n283\t_torque(\"spark_plug\", \"Spark plugs\", [\"oil_change\", \"spark_plugs\"],\n284\t        19.5, \"Nm\", value_range=(19, 20),\n285\t        source=\"https://www.giuliaforums.com/threads/inconsistent-spark-plug-torque-specs-2-0l.64916/\",\n286\t        confidence=CORROBORATED,\n287\t        notes=\"Two figures close enough to treat as agreeing within \"\n288\t              \"rounding: ~20 Nm and 168 in-lb/14 ft-lb (~19 Nm). The \"\n289\t              \"thread's own title ('Inconsistent spark plug torque specs \"\n290\t              \"2.0L') flags that published specs vary by source/year -- \"\n291\t              \"do not stack this with anti-seize unless the plug maker \"\n292\t              \"calls for it; seat torque affects thread depth into the \"\n293\t              \"aluminum head on this engine.\",\n294\t        platform_note=\"Giulia-sourced; same engine as this Stelvio.\")\n295\t\n296\t_torque(\"undertray\", \"Undertray / belly-pan / splash-shield fasteners\",\n297\t        [\"oil_change\", \"undertray\"], None, \"Nm\", confidence=UNKNOWN,\n298\t        notes=\"No sourced torque spec found. Typically plastic push-pin/\"\n299\t              \"screw retainers with no meaningful torque value (hand-\"\n300\t              \"tight); any metal bolts holding structural shield brackets \"\n301\t              \"should follow TechAuthority.\")\n302\t\n303\t# brakes -----------------------------------------------------------------\n304\t_torque(\"caliper_slider_front\", \"Brake caliper guide/slide pin bolt, front\",\n305\t        [\"brakes_front\"], 30, \"Nm\",\n306\t        source=\"https://www.giuliaforums.com/threads/brake-guide-bolt-torque-spec.52844/\",\n307\t        confidence=CORROBORATED,\n308\t        notes=\"Reported consistently (~22 ft-lb / 30 Nm) for the single \"\n309\t              \"guide-pin bolt (between the alignment pins) on Brembo-\"\n310\t              \"fitted cars. Apply medium-strength (blue) threadlocker per \"\n311\t              \"source -- reusable bolt, but refresh threadlocker each \"\n312\t              \"time it's disturbed.\",\n313\t        platform_note=\"Giulia-sourced, Brembo-fitted cars.\")\n314\t\n315\t_torque(\"caliper_bracket_front\", \"Brake caliper bracket/carrier-to-knuckle \"\n316\t                                  \"bolt, front\", [\"brakes_front\"],\n317\t        None, \"Nm\", confidence=UNKNOWN,\n318\t        notes=\"Conflicting forum reports: one 2018 2.0L thread settled on \"\n319\t              \"~57 ft-lb (~77 Nm) with threadlocker after testing 55 then \"\n320\t              \"60 ft-lb by feel; a separate thread quotes 77 ft-lb \"\n321\t              \"(~104 Nm) outright. These do not agree closely enough to \"\n322\t              \"treat as corroborating, and neither traces to a \"\n323\t              \"manufacturer document -- do not pick one. \" + TECHAUTHORITY\n324\t              + \"; this bolt clamps the whole caliper assembly to the \"\n325\t                \"knuckle.\")\n326\t\n327\t_torque(\"caliper_slider_rear\", \"Brake caliper guide/slide pin bolt, rear\",\n328\t        [\"brakes_rear\"], 27, \"Nm\", value_range=(26, 28),\n329\t        source=\"https://www.giuliaforums.com/threads/2018-2-0l-caliper-bolt-torque.58102/\",\n330\t        confidence=SINGLE_SOURCE,\n331\t        notes=\"From one 2018 2.0L thread (~20 ft-lb / 27 Nm), read via a \"\n332\t              \"search-engine summary only -- the full thread was behind a \"\n333\t              \"paywall during this research pass, so treat as \"\n334\t              \"lower-confidence than a normal SINGLE-SOURCE. It is also \"\n335\t              \"unclear whether this figure is the guide pin, the bracket \"\n336\t              \"bolt, or both -- confirm which fastener it covers. Rear \"\n337\t              \"caliper also carries the electric parking brake actuator: \"\n338\t              \"put the EPB into service mode before loosening (see \"\n339\t              \"BRAKE_SPEC['epb_service_mode']).\",\n340\t        platform_note=\"Giulia-sourced.\")\n341\t\n342\t_torque(\"caliper_bracket_rear\", \"Brake caliper bracket/carrier-to-knuckle \"\n343\t                                 \"bolt, rear\", [\"brakes_rear\"],\n344\t        None, \"Nm\", confidence=UNKNOWN,\n345\t        notes=\"Not distinguished from the rear guide-pin figure in any \"\n346\t              \"source found. \" + TECHAUTHORITY)\n347\t\n348\t_torque(\"rotor_retaining_screw\", \"Rotor retaining screw\",\n349\t        [\"brakes_front\", \"brakes_rear\"], None, \"Nm\", confidence=UNKNOWN,\n350\t        notes=\"Confirmed as an M10 x 1.25 thread (~16.4mm length) from \"\n351\t              \"parts listings, but no torque value found. These screws \"\n352\t              \"are low-torque and easy to snap/strip -- do not guess; \"\n353\t              \"use TechAuthority.\")\n354\t\n355\t# ignition ------------------------------------------------------------------\n356\t_torque(\"coil_pack_bolt\", \"Ignition coil pack retaining bolt/screw\",\n357\t        [\"spark_plugs\", \"coils\"], None, \"Nm\", confidence=UNKNOWN,\n358\t        notes=\"No sourced torque value found.\")\n359\t\n360\t# EVAP ------------------------------------------------------------------\n361\t_torque(\"evap_canister_mount\", \"EVAP canister / ESIM mounting bolts\",\n362\t        [\"evap\"], None, \"Nm\", confidence=UNKNOWN,\n363\t        notes=\"No sourced torque value found. Forum how-tos describe \"\n364\t              \"removing 'the bolts holding the canister in' without \"\n365\t              \"giving a spec. Directly relevant to the current EVAP \"\n366\t              \"(P0440/P0455/P0456) diagnosis on this VIN.\")\n367\t\n368\t_torque(\"evap_esim_mount\", \"EVAP ESIM / leak-detection pump mounting \"\n369\t                            \"fasteners\", [\"evap\"], None, \"Nm\",\n370\t        confidence=UNKNOWN,\n371\t        notes=\"Not distinguished from the canister mounting bolts in any \"\n372\t              \"source found. \" + TECHAUTHORITY)\n373\t\n374\t_torque(\"evap_purge_valve_mount\", \"EVAP purge valve/solenoid mounting \"\n375\t                                   \"bracket bolt\", [\"evap\"],\n376\t        None, \"Nm\", confidence=UNKNOWN,\n377\t        notes=\"No sourced torque value found.\")\n378\t\n379\t# electrical / battery ------------------------------------------------------\n380\t_torque(\"battery_terminal\", \"Battery terminal clamp bolts\", [\"battery\"],\n381\t        None, \"Nm\", confidence=UNKNOWN,\n382\t        notes=\"No vehicle-specific value found. Do not substitute a \"\n383\t              \"generic terminal-bolt range -- confirm against \"\n384\t              \"TechAuthority; overtightening cracks the terminal post.\")\n385\t\n386\t_torque(\"battery_hold_down\", \"Battery hold-down clamp bolt\", [\"battery\"],\n387\t        None, \"Nm\", confidence=UNKNOWN,\n388\t        notes=\"No sourced torque value found.\")\n389\t\n390\t# suspension ------------------------------------------------------------------\n391\t_torque(\"sway_bar_link_front\", \"Sway bar (stabilizer) end link nut, front\",\n392\t        [\"suspension\"], None, \"Nm\", confidence=UNKNOWN,\n393\t        notes=\"No sourced torque value found.\")\n394\t\n395\t_torque(\"sway_bar_link_rear\", \"Sway bar (stabilizer) end link nut, rear\",\n396\t        [\"suspension\"], None, \"Nm\", confidence=UNKNOWN,\n397\t        notes=\"No sourced torque value found.\")\n398\t\n399\t_torque(\"tie_rod_end\", \"Tie rod end nut\", [\"suspension\"],\n400\t        92.5, \"Nm\", value_range=(90, 95),\n401\t        source=\"https://www.alfabb.com/threads/steering-tie-rod-torque-specs.179364/\",\n402\t        confidence=SINGLE_SOURCE,\n403\t        notes=\"Source thread title references the INNER tie rod (to the \"\n404\t              \"steering rack), which may not be the same joint as the \"\n405\t              \"OUTER tie rod end (to the knuckle) a suspension job \"\n406\t              \"usually disturbs -- confirm which joint this covers. If a \"\n407\t              \"castellated nut with a cotter pin, torque to the low end \"\n408\t              \"of the range and continue to the next pin slot rather \"\n409\t              \"than backing off.\")\n410\t\n411\t_torque(\"upper_control_arm\", \"Upper control arm to knuckle bolt\",\n412\t        [\"suspension\"], None, \"Nm\", confidence=UNKNOWN,\n413\t        notes=\"No sourced value. Fact-check 2026-09-26: the 51 Nm previously listed was \"\n414\t              \"attributed to a go-parts.com article that publishes no torque figure (it \"\n415\t              \"says specs must come from the factory service manual). \" + TECHAUTHORITY)\n416\t\n417\t_torque(\"strut_to_lca\", \"Front strut to lower control arm bolt\",\n418\t        [\"suspension\"], None, \"Nm\", single_use=True, confidence=UNKNOWN,\n419\t        notes=\"No sourced value. Fact-check 2026-09-26: the '60 Nm + 135 deg' previously \"\n420\t              \"listed was attributed to a go-parts.com article that contains no torque \"\n421\t              \"spec; it must not be used on this structural bolt. Treat the bolt as \"\n422\t              \"single-use until the service manual says otherwise. \" + TECHAUTHORITY)\n423\t\n424\t_torque(\"lower_control_arm_knuckle\", \"Lower control arm to knuckle bolt\",\n425\t        [\"suspension\"], None, \"Nm\", confidence=UNKNOWN,\n426\t        notes=\"Not distinguished from the strut-to-LCA bolt in any source \"\n427\t              \"found; the underlying search summary explicitly states \"\n428\t              \"verified Giulia/Stelvio torque specs here are not readily \"\n429\t              \"public. \" + TECHAUTHORITY)\n430\t\n431\t_torque(\"lower_control_arm_subframe\", \"Lower control arm to subframe bolt\",\n432\t        [\"suspension\"], None, \"Nm\", confidence=UNKNOWN,\n433\t        notes=\"No sourced torque value found. Many platforms specify \"\n434\t              \"this bolt be torqued at curb/ride height (suspension \"\n435\t              \"loaded) rather than on a lift -- confirm procedure before \"\n436\t              \"assuming a lift torque is valid.\")\n437\t\n438\t_torque(\"wheel_bearing_hub_nut\", \"Wheel bearing/hub retaining nut or bolts\",\n439\t        [\"wheel_bearing\"], None, \"Nm\", confidence=UNKNOWN, single_use=True,\n440\t        notes=\"No sourced torque value found. Hub nuts on many AWD \"\n441\t              \"platforms are single-use, high (200+ Nm) torque-to-yield \"\n442\t              \"fasteners -- treat as single-use until confirmed \"\n443\t              \"otherwise. \" + TECHAUTHORITY)\n444\t\n445\t# driveline (ZF 8HP, transfer case, differential) ----------------------------\n446\t_torque(\"transmission_pan_bolts\", \"ZF 8HP transmission pan/filter \"\n447\t                                   \"assembly bolts (13x)\", [\"transmission\"],\n448\t        10, \"Nm\",\n449\t        source=\"docs/reference/ZF8HP_SERVICE_DATA.md\",\n450\t        confidence=CONFIRMED,\n451\t        notes=\"From this repo's own ZF8HP_SERVICE_DATA.md, sourced to \"\n452\t              \"FCA/Alfa OEM service information for this exact vehicle \"\n453\t              \"(ZF doc 1087.754.107c + FCA text): 13 bolts at 10 N*m \"\n454\t              \"(89 in-lb). Pan and filter are one integrated, non-\"\n455\t              \"separately-serviceable assembly; the pan gasket is \"\n456\t              \"reusable if undamaged. This is the PAN bolt torque, not \"\n457\t              \"the drain/fill plug below.\")\n458\t\n459\t_torque(\"transmission_drain_plug\", \"ZF 8HP transmission fluid drain plug\",\n460\t        [\"transmission\"], None, \"Nm\", confidence=UNKNOWN,\n461\t        notes=\"Not found. The ZF 8HP pan/filter is an integrated \"\n462\t              \"assembly with no conventional dipstick service; a \"\n463\t              \"separate drain plug (if this pan variant has one) was not \"\n464\t              \"identified in this research pass -- see \"\n465\t              \"transmission_pan_bolts above for the related, confirmed \"\n466\t              \"spec. \" + TECHAUTHORITY)\n467\t\n468\t_torque(\"transmission_fill_plug\", \"ZF 8HP transmission fluid fill/level \"\n469\t                                   \"plug\", [\"transmission\"],\n470\t        None, \"Nm\", confidence=UNKNOWN,\n471\t        notes=\"Not found. ZF 8HP fill is a temperature-controlled \"\n472\t              \"level-plug procedure (fluid must be 30-50 C at the fill \"\n473\t              \"hole per FCA/ZF service info in \"\n474\t              \"docs/reference/ZF8HP_SERVICE_DATA.md), not a simple \"\n475\t              \"fill-to-plug -- see that document for the procedure. \"\n476\t              + TECHAUTHORITY)\n477\t\n478\t_torque(\"transfer_case_drain_plug\", \"Transfer case (Q4 power transfer \"\n479\t                                     \"unit) drain plug\", [\"transfer_case\"],\n480\t        None, \"Nm\", confidence=UNKNOWN,\n481\t        notes=\"A stelvioforum thread asking this exact question cites \"\n482\t              \"the rear differential's 26 Nm as known but leaves the \"\n483\t              \"transfer case as an open question for the poster -- this \"\n484\t              \"is an unresolved question in the community, not a settled \"\n485\t              \"value. Do not assume 'probably the same as the diff' -- \"\n486\t              \"that is speculation, not a source.\")\n487\t\n488\t_torque(\"transfer_case_fill_plug\", \"Transfer case (Q4 power transfer \"\n489\t                                    \"unit) fill plug\", [\"transfer_case\"],\n490\t        None, \"Nm\", confidence=UNKNOWN,\n491\t        notes=\"Same as transfer_case_drain_plug -- open question, not \"\n492\t              \"sourced.\")\n493\t\n494\t_torque(\"rear_diff_drain_plug\", \"Rear differential (rear axle) drain plug\",\n495\t        [\"differential\"], 26, \"Nm\",\n496\t        source=\"https://www.stelvioforum.com/threads/transfer-case-drain-fill-plug-torque-specs.24693/\",\n497\t        confidence=SINGLE_SOURCE,\n498\t        notes=\"Stated as known/given by the original poster in a thread \"\n499\t              \"actually asking about the transfer case (see \"\n500\t              \"transfer_case_drain_plug); not independently corroborated \"\n501\t              \"elsewhere in this research pass.\")\n502\t\n503\t_torque(\"rear_diff_fill_plug\", \"Rear differential (rear axle) fill plug\",\n504\t        [\"differential\"], 26, \"Nm\",\n505\t        source=\"https://www.stelvioforum.com/threads/transfer-case-drain-fill-plug-torque-specs.24693/\",\n506\t        confidence=SINGLE_SOURCE,\n507\t        notes=\"Same source as rear_diff_drain_plug; drain and fill plugs \"\n508\t              \"are commonly the same fastener spec on this style of axle \"\n509\t              \"but that has not been independently confirmed as true \"\n510\t              \"here.\")\n511\t\n512\t\n513\t# Safety net, not a per-row habit to maintain by hand: every UNKNOWN torque\n514\t# row must point at TechAuthority (the module's own stated invariant, see the\n515\t# docstring), even one written with a specific enough ``notes`` string that\n516\t# the author forgot to say so explicitly. Idempotent -- running this twice\n517\t# does not double up the pointer.\n518\tfor _row in TORQUES:\n519\t    if _row[\"confidence\"] == UNKNOWN and TECHAUTHORITY not in (_row.get(\"notes\") or \"\"):\n520\t        _row[\"notes\"] = (_row[\"notes\"] + \" \" if _row[\"notes\"] else \"\") + TECHAUTHORITY\n521\tdel _row\n522\t\n523\t\n524\tCATEGORIES: tuple[str, ...] = (\n525\t    \"oil_change\", \"wheels\", \"brakes_front\", \"brakes_rear\", \"spark_plugs\",\n526\t    \"coils\", \"evap\", \"undertray\", \"battery\", \"suspension\", \"transmission\",\n527\t    \"transfer_case\", \"differential\", \"wheel_bearing\",\n528\t)\n529\t\n530\tCATEGORY_LABELS: dict[str, str] = {\n531\t    \"oil_change\": \"Oil change\",\n532\t    \"wheels\": \"Wheels / tyres\",\n533\t    \"brakes_front\": \"Brakes, front\",\n534\t    \"brakes_rear\": \"Brakes, rear\",\n535\t    \"spark_plugs\": \"Spark plugs\",\n536\t    \"coils\": \"Ignition coils\",\n537\t    \"evap\": \"EVAP system\",\n538\t    \"undertray\": \"Undertray / splash shields\",\n539\t    \"battery\": \"Battery\",\n540\t    \"suspension\": \"Suspension\",\n541\t    \"transmission\": \"Transmission (ZF 8HP)\",\n542\t    \"transfer_case\": \"Transfer case (Q4)\",\n543\t    \"differential\": \"Rear differential\",\n544\t    \"wheel_bearing\": \"Wheel bearing / hub\",\n545\t}\n546\t\n547\t\n548\tdef torques_for_category(category: str) -> list[dict[str, Any]]:\n549\t    \"\"\"Every torque row tagged with ``category``, in table order.\"\"\"\n550\t    return [dict(t) for t in TORQUES if category in t[\"categories\"]]\n551\t\n552\t\n553\tdef torques_for_categories(categories: Iterable[str]) -> list[dict[str, Any]]:\n554\t    \"\"\"Union of :func:`torques_for_category` over several categories,\n555\t    de-duplicated by key, in first-seen order.\"\"\"\n556\t    seen: set[str] = set()\n557\t    out: list[dict[str, Any]] = []\n558\t    for cat in categories:\n559\t        for row in torques_for_category(cat):\n560\t            if row[\"key\"] in seen:\n561\t                continue\n562\t            seen.add(row[\"key\"])\n563\t            out.append(row)\n564\t    return out\n565\t\n566\t\n567\tdef checklist_for(categories: Any) -> list[dict[str, Any]]:\n568\t    \"\"\"``torques_for_category``/``torques_for_categories`` unified: accepts\n569\t    either a single category string or an iterable of them.\"\"\"\n570\t    if isinstance(categories, str):\n571\t        return torques_for_category(categories)\n572\t    return torques_for_categories(categories)\n573\t\n574\t\n575\tdef search_torques(q: str = \"\", category: str = \"\") -> list[dict[str, Any]]:\n576\t    \"\"\"Torque rows matching a free-text query and/or a category filter.\n577\t\n578\t    Backs the searchable ``/v/{vin}/torque`` page and its JSON mirror.\n579\t    UNKNOWN rows are never excluded -- the point of the page is that a\n580\t    missing spec stays visible with a TechAuthority pointer, not that it\n581\t    disappears.\n582\t    \"\"\"\n583\t    q = (q or \"\").strip().lower()\n584\t    category = (category or \"\").strip()\n585\t    rows = torques_for_category(category) if category else [dict(t) for t in TORQUES]\n586\t    if not q:\n587\t        return rows\n588\t    out = []\n589\t    for row in rows:\n590\t        haystack = \" \".join([\n591\t            row.get(\"component\", \"\"), row.get(\"notes\", \"\") or \"\",\n592\t            \" \".join(row.get(\"categories\", ())),\n593\t            row.get(\"platform_note\") or \"\",\n594\t        ]).lower()\n595\t        if q in haystack:\n596\t            out.append(row)\n597\t    return out\n598\t\n599\t\n600\tdef torque_by_key(key: str) -> Optional[dict[str, Any]]:\n601\t    for t in TORQUES:\n602\t        if t[\"key\"] == key:\n603\t            return dict(t)\n604\t    return None\n605\t\n606\t\n607\t# alias kept for callers that think in terms of a single lookup-by-id\n608\tget_torque = torque_by_key\n609\t\n610\t\n611\t# --- brakes / wheels / tyres -------------------------------------------------\n612\t\n613\tBRAKE_SPEC: dict[str, dict[str, Any]] = {\n614\t    \"pad_min_mm\": {\n615\t        \"front\": {\"value\": None, \"source\": None, \"confidence\": UNKNOWN,\n616\t                  \"notes\": \"No FCA-specific minimum pad thickness found; \"\n617\t                           \"forum chatter cites a generic industry \"\n618\t                           \"rule-of-thumb (~2-3 mm), not a manufacturer \"\n619\t                           \"spec. This car also has an electronic \"\n620\t                           \"pad-wear sensor on the inner pad. \"\n621\t                           + TECHAUTHORITY},\n622\t        \"rear\": {\"value\": None, \"source\": None, \"confidence\": UNKNOWN,\n623\t                 \"notes\": \"Same as front -- no sourced FCA figure. \"\n624\t                          + TECHAUTHORITY},\n625\t    },\n626\t    \"rotor_new_mm\": {\n627\t        \"front\": {\"value\": 28, \"diameter_mm\": 330, \"source\":\n628\t                  \"https://www.go-parts.com/garage/disc-brake-rotor-alfa-romeo-giulia-alfa-romeo-stelvio-2018-2025\",\n629\t                  \"confidence\": SINGLE_SOURCE,\n630\t                  \"notes\": \"Aftermarket parts-site aggregation, not a \"\n631\t                           \"manufacturer document.\"},\n632\t        \"rear\": {\"value\": 22, \"diameter_mm\": 320, \"source\":\n633\t                 \"https://www.go-parts.com/garage/disc-brake-rotor-alfa-romeo-giulia-alfa-romeo-stelvio-2018-2025\",\n634\t                 \"confidence\": SINGLE_SOURCE,\n635\t                 \"notes\": \"Same source as front.\"},\n636\t    },\n637\t    \"rotor_min_mm\": {\n638\t        \"front\": {\"value\": 25.5, \"source\": \"https://www.go-parts.com/garage/disc-brake-rotor-alfa-romeo-giulia-alfa-romeo-stelvio-2018-2025\",\n639\t                  \"confidence\": SINGLE_SOURCE,\n640\t                  \"notes\": \"Discard/minimum-machining thickness; single \"\n641\t                           \"aftermarket-aggregator source, not \"\n642\t                           \"cross-checked. The rotor's own cast-in \"\n643\t                           \"'MIN TH' marking is the most reliable check \"\n644\t                           \"on the actual part.\"},\n645\t        \"rear\": {\"value\": None, \"source\": None, \"confidence\": UNKNOWN,\n646\t                 \"notes\": \"No widely-published rear minimum found -- the \"\n647\t                          \"source that gave the front figure explicitly \"\n648\t                          \"says so. Read the cast-in MIN TH marking off \"\n649\t                          \"the physical rotor. \" + TECHAUTHORITY},\n650\t    },\n651\t    \"rotor_runout_max_mm\": {\n652\t        \"value\": None, \"source\": None, \"confidence\": UNKNOWN,\n653\t        \"notes\": \"Not found in this research pass. \" + TECHAUTHORITY,\n654\t    },\n655\t    \"fluid_spec\": {\n656\t        \"value\": \"DOT 4\", \"source\": \"forum consensus (stelvioforum, alfabb, giuliaforums); no \"\n657\t                                   \"FCA document located\", \"confidence\": SINGLE_SOURCE,\n658\t        \"notes\": \"Forum consensus across stelvioforum/alfabb/giuliaforums \"\n659\t                 \"threads; no Mopar/FCA document located specifying this \"\n660\t                 \"explicitly for this VIN -- confirm against the \"\n661\t                 \"reservoir cap markings on this specific car. FCA has \"\n662\t                 \"specified DOT 4 Low Viscosity on some contemporaneous \"\n663\t                 \"EPB-equipped platforms, which is not necessarily \"\n664\t                 \"interchangeable with plain DOT 4 even though both meet \"\n665\t                 \"the DOT 4 boiling-point floor.\",\n666\t    },\n667\t    \"fluid_change_interval\": {\n668\t        \"miles\": None, \"months\": 24, \"source\": \"https://vehicleinfo.mopar.com/assets/publications/en-us/Alfa_Romeo/2018/Stelvio/P124461_18_GU_OM_EN_USC_DIGITAL_2nd_V2.pdf\",\n669\t        \"confidence\": CONFIRMED,\n670\t        \"notes\": \"2018 Stelvio US owner's manual, Maintenance Plan note 6: \"\n671\t                 \"'The brake fluid replacement has to be done every two \"\n672\t                 \"years, irrespective of the mileage.' (Corrected \"\n673\t                 \"2026-09-26; previously listed as a forum rule of thumb.)\",\n674\t    },\n675\t    \"oe_tire_size\": {\n676\t        \"base_18in\": {\"value\": \"235/60R18\", \"source\": \"wheel-size.com; tiresize.com\",\n677\t                      \"confidence\": CORROBORATED,\n678\t                      \"notes\": \"Multiple independent tyre-fitment \"\n679\t                               \"databases (wheel-size.com, tiresize.com) \"\n680\t                               \"agree. Read this VIN's actual fitment off \"\n681\t                               \"the door-jamb placard rather than \"\n682\t                               \"assuming from trim level.\"},\n683\t        \"ti_19in\": {\"value\": \"235/55R19, load/speed index 101V\",\n684\t                    \"source\": \"wheel-size.com; tiresize.com\", \"confidence\": CORROBORATED,\n685\t                    \"notes\": \"Ti/19-inch-wheel option. A staggered \"\n686\t                             \"front/rear fitment applies to the \"\n687\t                             \"Quadrifoglio, not the base 2.0T -- confirm \"\n688\t                             \"this VIN's actual wheel/tyre fitment before \"\n689\t                             \"assuming a square (rotatable) set.\"},\n690\t    },\n691\t    \"tire_pressure_kpa\": {\n692\t        \"front\": {\"value\": 207, \"psi\": 30, \"source\": \"HaynesPro-sourced aggregator, 19-inch \"\n693\t                                                       \"fitment only; not re-findable\",\n694\t                  \"confidence\": SINGLE_SOURCE,\n695\t                  \"notes\": \"Reported for the 19-inch fitment \"\n696\t                           \"(HaynesPro-sourced aggregator); the official \"\n697\t                           \"Mopar owner's-manual placard PDF found during \"\n698\t                           \"research was image-based with no extractable \"\n699\t                           \"text, so this could not be confirmed directly \"\n700\t                           \"against the manufacturer document. READ THE \"\n701\t                           \"ACTUAL DOOR-JAMB PLACARD on this VIN -- \"\n702\t                           \"pressure varies by wheel/tyre option and \"\n703\t                           \"load, and no reliable figure was found for \"\n704\t                           \"the 18-inch base fitment specifically.\"},\n705\t        \"rear\": {\"value\": 228, \"psi\": 33, \"source\": \"HaynesPro-sourced aggregator, 19-inch \"\n706\t                                                      \"fitment only; not re-findable\",\n707\t                 \"confidence\": SINGLE_SOURCE,\n708\t                 \"notes\": \"Same caveat as front.\"},\n709\t    },\n710\t    \"rotation_pattern\": {\n711\t        \"value\": \"Base 2.0T (square, non-staggered 18in or 19in Ti \"\n712\t                 \"fitment): standard front-to-rear rotation. Staggered \"\n713\t                 \"fitments (Quadrifoglio and any car actually fitted with \"\n714\t                 \"different front/rear sizes): DO NOT ROTATE.\",\n715\t        \"source\": \"inferred from tyre-fitment databases; no FCA rotation guidance located\",\n716\t        \"confidence\": SINGLE_SOURCE,\n717\t        \"notes\": \"Inferred from consistent single-tyre-size listings \"\n718\t                 \"across fitment databases for the base 2.0T -- no \"\n719\t                 \"explicit FCA rotation-pattern statement found. Confirm \"\n720\t                 \"this VIN's actual fitment (matching vs. staggered) \"\n721\t                 \"before rotating.\",\n722\t    },\n723\t    \"epb_service_mode\": {\n724\t        \"present\": True,\n725\t        \"note\": \"Rear brakes use an electric parking brake (EPB) with a \"\n726\t                \"motorized caliper piston. Reported procedure: \"\n727\t                \"infotainment Settings > Passive Safety > Brake Service \"\n728\t                \"Mode, ignition on/engine off, in Park with the foot \"\n729\t                \"brake released; the screen confirms once the actuators \"\n730\t                \"retract. No wiTECH/scan tool is reported as required for \"\n731\t                \"a routine pad change via this menu path; MultiEcuScan's \"\n732\t                \"own coverage of an equivalent routine was not confirmed \"\n733\t                \"in this research pass. Never force the rear piston back \"\n734\t                \"mechanically without service mode active -- it can strip \"\n735\t                \"the actuator's gears/spindle. Press pistons straight \"\n736\t                \"back (do not rotate -- tears the seal); if the battery \"\n737\t                \"is disconnected while the caliper is off, pump the \"\n738\t                \"brake pedal before reconnecting to avoid setting fault \"\n739\t                \"codes.\",\n740\t        \"source\": \"https://www.servicereset.net/\",\n741\t        \"confidence\": SINGLE_SOURCE,\n742\t    },\n743\t}\n744\t\n745\tTPMS_DIDS = {\n746\t    \"module\": \"RFHUB\",\n747\t    \"dids\": {\"FL\": 0x40B1, \"FR\": 0x40B2, \"RL\": 0x40B3, \"RR\": 0x40B4},\n748\t    \"note\": \"Live TPMS pressure/temperature can be read from the RFHUB \"\n749\t            \"over UDS at DIDs 40B1-40B4 (one per corner); see \"\n750\t            \"cuore/live/addressing.py and cuore/live/did_catalog.py. This \"\n751\t            \"module only documents the mapping -- it performs no live \"\n752\t            \"reads itself; the brakes/wheels/tyres page shows the latest \"\n753\t            \"matching observation from mes.live_obs, read-only, if one \"\n754\t            \"exists.\",\n755\t}\n756\t\n757\t\n758\tdef oil_change_specs() -> dict[str, Any]:\n759\t    \"\"\"Everything the oil-change checklist needs, bundled with sources.\"\"\"\n760\t    return {\n761\t        \"oil\": OIL_SPEC,\n762\t        \"filters\": OIL_FILTER_PARTS,\n763\t        \"drain_plug\": DRAIN_PLUG,\n764\t        \"drain_plug_washer\": DRAIN_PLUG_WASHER,\n765\t        \"interval\": SERVICE_INTERVAL,\n766\t        \"torques\": torques_for_category(\"oil_change\"),\n767\t    }\n768\t\n769\t\n770\tdef brake_wheel_tire_specs() -> dict[str, Any]:\n771\t    \"\"\"Everything the brakes/wheels/tyres checklist needs, with sources.\"\"\"\n772\t    return {\n773\t        \"brake\": BRAKE_SPEC,\n774\t        \"tpms\": TPMS_DIDS,\n775\t        \"torques\": torques_for_categories([\"brakes_front\", \"brakes_rear\",\n776\t                                           \"wheels\", \"wheel_bearing\"]),\n777\t    }\n778\t\n779\t\n780\t__all__ = [\n781\t    \"CONFIRMED\", \"CORROBORATED\", \"SINGLE_SOURCE\", \"UNKNOWN\",\n782\t    \"CONFIDENCE_LEVELS\", \"TECHAUTHORITY\", \"VEHICLE\", \"OIL_SPEC\",\n783\t    \"OIL_FILTER_PARTS\", \"DRAIN_PLUG\", \"DRAIN_PLUG_WASHER\",\n784\t    \"SERVICE_INTERVAL\", \"TORQUES\", \"CATEGORIES\", \"CATEGORY_LABELS\",\n785\t    \"BRAKE_SPEC\", \"TPMS_DIDS\", \"torques_for_category\",\n786\t    \"torques_for_categories\", \"checklist_for\", \"search_torques\",\n787\t    \"torque_by_key\", \"get_torque\", \"oil_change_specs\",\n788\t    \"brake_wheel_tire_specs\", \"nm_to_lbft\", \"lbft_to_nm\",\n789\t]\n790\t"}]},"uuid":"eb4b4e8b-1174-4565-9751-bfd2d7216546","timestamp":"2026-10-08T00:08:29.909Z","toolUseResult":{"type":"text","file":{"filePath":"C:\\Users\\User\\mcp-servers\\mes-log-mcp\\mes\\service_specs.py","content":"\"\"\"Reference data: 2018 Alfa Romeo Stelvio 2.0T (US) service specs.\n\nRead-only reference data -- nothing here touches the corpus or the car. It\nbacks :mod:`mes.service` (the oil-change / general-service / brakes-wheels-\ntyres ledger) and cuore's service pages. Every leaf value carries where it\ncame from and how sure we are of it, because a torque spec a mechanic\ntrusts wrongly is worse than one plainly marked unknown.\n\nConfidence levels (never invented -- an absent value is recorded as\nUNKNOWN, never guessed):\n\n* ``CONFIRMED``     -- an actual manufacturer document (owner's manual,\n                       Mopar/FCA parts catalog, FCA/Alfa service\n                       information, TechAuthority excerpt).\n* ``CORROBORATED``  -- two independent non-manufacturer sources agree.\n* ``SINGLE_SOURCE`` -- exactly one source found, not cross-checked.\n* ``UNKNOWN``       -- nothing credible found. ``value`` is ``None``, never\n                       a placeholder number -- ``notes`` always points at\n                       the service manual.\n\nThe 2018 Giulia 2.0T shares this car's GME-T4 MultiAir engine (sales code\nEC2) and much of its running gear, so a fair amount of this is corroborated\nfrom Giulia-specific sources. Every row that leans on Giulia sourcing says\nso in ``platform_note`` -- it is offered as corroboration, not silently\nfolded in as if it were Stelvio-specific.\n\nResearch pass done 2026-09-26 by web search against public sources (Mopar/\nFCA parts listings, vehicleinfo.mopar.com, stelvioforum.com,\ngiuliaforums.com, alfaowner.com, alfabb.com, parts/tool sites) plus this\nrepo's own ``docs/reference/ZF8HP_SERVICE_DATA.md``, which traces to actual\nFCA/Alfa OEM service information for this platform. No paywalled FCA/\nStellantis TechAuthority document was reached directly -- every value that\nnames TechAuthority as its authority is a pointer to go get it, not a claim\nthat document was actually read.\n\nSee ``docs/reference/STELVIO_20T_SERVICE_SPECS.md`` for the human-readable\nwriteup with the same data and full source links.\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom typing import Any, Iterable, Optional\n\nCONFIRMED = \"CONFIRMED\"\nCORROBORATED = \"CORROBORATED\"\nSINGLE_SOURCE = \"SINGLE-SOURCE\"\nUNKNOWN = \"UNKNOWN\"\n\nCONFIDENCE_LEVELS = (CONFIRMED, CORROBORATED, SINGLE_SOURCE, UNKNOWN)\n\nTECHAUTHORITY = \"use the service manual (TechAuthority)\"\n\nVEHICLE = (\"2018 Alfa Romeo Stelvio 2.0T (GU), 2.0L GME-T4 MultiAir turbo, \"\n          \"sales code EC2, US market, Q4 AWD, ZF 8HP automatic\")\n\nNM_PER_LBFT = 1.35582\nLBFT_PER_NM = 0.737562149\n\n\ndef nm_to_lbft(nm: Optional[float]) -> Optional[float]:\n    if nm is None:\n        return None\n    return round(nm * LBFT_PER_NM, 1)\n\n\ndef lbft_to_nm(lbft: Optional[float]) -> Optional[float]:\n    if lbft is None:\n        return None\n    return round(lbft * NM_PER_LBFT, 1)\n\n\n# --- oil service -------------------------------------------------------------\n\nOIL_SPEC: dict[str, dict[str, Any]] = {\n    \"viscosity\": {\n        \"value\": \"0W-30\", \"unit\": None,\n        \"source\": \"https://bobistheoilguy.com/forums/threads/alfa-romeo-giulia-oil-fiat-spec-9-55535-gs1.344407/\",\n        \"confidence\": CORROBORATED,\n        \"notes\": \"0W-30 full synthetic is what the US 2.0T manuals call \"\n                 \"for. Owners report 5W-40 (the Euro 'Selenia' spec \"\n                 \"sharing this engine) is also approved and commonly used \"\n                 \"in warmer climates -- SINGLE-SOURCE for that \"\n                 \"substitution; treat 0W-30 as the primary US spec and \"\n                 \"confirm against the filler-cap/owner's-manual sticker \"\n                 \"on this specific car.\",\n        \"platform_note\": \"Giulia-sourced; same engine as this Stelvio.\",\n    },\n    \"spec_approval\": {\n        \"value\": \"FCA/Mopar MS-13340, API SN (2017-2018 build); \"\n                 \"historically also cited as Fiat 9.55535-GS1\",\n        \"unit\": None,\n        \"source\": \"https://www.giuliaforums.com/threads/giulia-2-0l-oil-specifications-sn-versus-sn-plus-and-ms13340.50969/\",\n        \"confidence\": CORROBORATED,\n        \"notes\": \"Two independent threads (giuliaforums MS-13340 \"\n                 \"discussion, bobistheoilguy 9.55535-GS1 thread) describe \"\n                 \"the same spec: 2017-2018 MY calls for API SN meeting \"\n                 \"MS-13340 / 9.55535-GS1 in 0W-30; 2019+ manuals move to \"\n                 \"SN PLUS. Do NOT use MS-12633 (Pennzoil 0W-40 SN) -- that \"\n                 \"is the Quadrifoglio/SRT-shared V6 spec, not this \"\n                 \"engine's.\",\n        \"platform_note\": \"Giulia-sourced; same engine as this Stelvio.\",\n    },\n    \"capacity_with_filter_qt\": {\n        \"value\": 5.5, \"unit\": \"qt\", \"value_l\": 5.2,\n        \"source\": \"https://www.amsoil.com/lookup/auto-and-light-truck/2018/alfa-romeo/stelvio/2-0l-4-cyl-engine-code-n-ec2-n-turbo/\",\n        \"confidence\": SINGLE_SOURCE,\n        \"notes\": \"AMSOIL's VIN/engine-code lookup tool, keyed to this \"\n                 \"exact engine code (N) and sales code (EC2) -- a \"\n                 \"parts-fitment lookup, not a manufacturer document, so \"\n                 \"kept at SINGLE-SOURCE despite being VIN-specific. \"\n                 \"Disregard aggregator pages quoting a wider 5.5-7.4 qt \"\n                 \"range -- that clearly blends the 2.0T and the 2.9L V6 \"\n                 \"into one page.\",\n        \"platform_note\": None,\n    },\n}\n\nOIL_FILTER_PARTS: list[dict[str, Any]] = [\n    {\"brand\": \"Mopar\", \"part_no\": \"4892339 (suffix revised over \"\n     \"production -- BE / AB / AC seen; reported as 'same filter, revised \"\n     \"part number')\",\n     \"source\": \"https://www.giuliaforums.com/threads/oil-filter-2-0-part-number-change.49369/\",\n     \"confidence\": SINGLE_SOURCE,\n     \"notes\": \"The 2.0L-engine cartridge filter. Do NOT use 68191349AA/\"\n              \"AC -- that family is the 3.0L/3.2L/3.6L V6 filter and \"\n              \"appears repeatedly in search noise for this query. Confirm \"\n              \"the exact current suffix against this VIN at a Mopar parts \"\n              \"counter before ordering.\"},\n    {\"brand\": \"(aftermarket cross-reference)\", \"part_no\": None,\n     \"source\": None, \"confidence\": UNKNOWN,\n     \"notes\": \"No confidently-sourced Mann/Bosch/K&N cross-reference for \"\n              \"the 2.0L cartridge filter turned up in this research pass \"\n              \"(a Magneti Marelli OEM-equivalent was mentioned on one \"\n              \"forum without a part number). Cross-reference the Mopar \"\n              \"4892339 number at a parts counter (RockAuto, FCP Euro) \"\n              \"rather than guessing a Mann/Bosch number here.\"},\n]\n\nDRAIN_PLUG = {\n    \"part_no\": None, \"source\": None, \"confidence\": UNKNOWN,\n    \"notes\": \"No separate drain-plug part number found. One source \"\n             \"(see the drain-plug torque row) describes the 2.0T plug as \"\n             \"having a built-in/captive rubber gasket rather than using a \"\n             \"separate crush washer -- if true, replacing the whole plug \"\n             \"may be the only way to renew the seal. \" + TECHAUTHORITY,\n}\n\nDRAIN_PLUG_WASHER = {\n    \"part_no\": None, \"reusable\": None, \"source\": None, \"confidence\": UNKNOWN,\n    \"notes\": \"See DRAIN_PLUG -- SINGLE-SOURCE reports a captive gasket, \"\n             \"not a separate washer. A washer part number (670050349) is \"\n             \"documented for the Quadrifoglio V6, not the 2.0T -- do not \"\n             \"assume it fits. Confirm plug design either from \"\n             \"TechAuthority or by inspecting the removed plug.\",\n}\n\nSERVICE_INTERVAL = {\n    \"miles\": 8000, \"months\": 12,\n    \"km\": round(8000 * 1.60934),\n    \"source\": \"https://www.giuliaforums.com/threads/oil-change-frequency.47281/\",\n    \"confidence\": CORROBORATED,\n    \"notes\": \"8,000 miles / 12 months (whichever comes first) with full \"\n             \"synthetic is the figure repeated across Costa Oil Change \"\n             \"model-year guides and the giuliaforums/stelvioforum 'Oil \"\n             \"Change Frequency' threads for both the Stelvio and Giulia \"\n             \"2.0T. Conventional oil is explicitly NOT approved for this \"\n             \"turbo engine. Owners report shortening to 5,000-6,000 miles \"\n             \"for short-trip/stop-and-go/hard driving. MANUFACTURER LIMIT \"\n             \"(CONFIRMED, 2018 Stelvio US owner's manual, Maintenance Plan \"\n             \"note 3): the interval is set by the dash oil-change indicator \"\n             \"and must never exceed 1 year / 10,000 miles (16,000 km); \"\n             \"severe duty (dusty/off-road, mostly idling or very low RPM) \"\n             \"4,000 miles (6,500 km). The 8,000 mi figure above is the \"\n             \"conservative shop interval, inside the FCA limit.\",\n    \"manufacturer_max\": {\"miles\": 10000, \"km\": 16000, \"months\": 12,\n                         \"severe_duty_miles\": 4000, \"severe_duty_km\": 6500,\n                         \"confidence\": CONFIRMED, \"source\": \"https://vehicleinfo.mopar.com/assets/publications/en-us/Alfa_Romeo/2018/Stelvio/P124461_18_GU_OM_EN_USC_DIGITAL_2nd_V2.pdf\"},\n    \"oil_life_system\": {\n        \"present\": True,\n        \"behavior\": \"Algorithmic oil-life / service-due monitor driving \"\n                    \"the cluster reminder, on top of the fixed interval \"\n                    \"above -- described as an onboard oil-degradation \"\n                    \"monitor that can trigger the reminder earlier based \"\n                    \"on actual driving conditions. Treat the fixed \"\n                    \"interval as the floor, the dash reminder as the \"\n                    \"ceiling, whichever comes first.\",\n        \"reset_methods\": [\n            \"MES (MultiEcuScan) -- reported as the fastest/most reliable \"\n            \"method, clears both the cluster reminder and day/mile \"\n            \"counter in seconds.\",\n            \"wiTECH (dealer tool) -- IPC module, Misc Functions, \"\n            \"Maintenance Reset, follow prompts.\",\n            \"Accelerator-pedal method (no tool) -- ignition on/engine \"\n            \"off, fully depress and release the accelerator pedal slowly \"\n            \"3 times (some cluster software revisions reportedly need \"\n            \"4-6 pumps), 1 second apart, then start the engine. \"\n            \"Unofficial and reported inconsistent across software \"\n            \"revisions.\",\n        ],\n        \"source\": \"https://www.stelvioforum.com/threads/alfa-romeo-stelvio-giulia-oil-change-maintenance-reset.19336/\",\n        \"confidence\": SINGLE_SOURCE,\n    },\n}\n\n\n# --- torque library ----------------------------------------------------------\n#\n# One row per fastener/job. ``categories`` lets one fastener appear on more\n# than one job's checklist (the wheel lug bolt matters to \"oil_change\" --\n# because a tech often rotates tyres at the same visit -- as well as\n# \"wheels\" and both brake categories).\n\nTORQUES: list[dict[str, Any]] = []\n\n\ndef _torque(key: str, component: str, categories: Iterable[str],\n            value: Optional[float], unit: Optional[str], *,\n            value_range: Optional[tuple[float, float]] = None,\n            angle: Optional[str] = None, single_use: bool = False,\n            source: Optional[str] = None, confidence: str = UNKNOWN,\n            notes: str = \"\", platform_note: Optional[str] = None,\n            display: Optional[str] = None) -> None:\n    if confidence not in CONFIDENCE_LEVELS:\n        raise ValueError(f\"bad confidence {confidence!r}\")\n    value_nm = value if unit == \"Nm\" else (lbft_to_nm(value) if unit == \"lb-ft\" else None)\n    value_lbft = value if unit == \"lb-ft\" else (nm_to_lbft(value) if unit == \"Nm\" else None)\n    if not notes and confidence == UNKNOWN:\n        notes = TECHAUTHORITY\n    TORQUES.append({\n        \"key\": key,\n        \"component\": component,\n        \"categories\": tuple(categories),\n        \"value\": value,\n        \"unit\": unit,\n        \"value_nm\": value_nm,\n        \"value_lbft\": value_lbft,\n        \"value_range\": value_range,\n        \"display\": display or (f\"{value} {unit}\" if value is not None else \"UNKNOWN\"),\n        \"angle\": angle,\n        \"single_use\": single_use,\n        \"source\": source,\n        \"confidence\": confidence,\n        \"notes\": notes.strip(),\n        \"platform_note\": platform_note,\n    })\n\n\n# oil change / wheels ---------------------------------------------------------\n_torque(\"drain_plug\", \"Oil drain plug\", [\"oil_change\"], 20, \"Nm\",\n        source=\"https://www.stelvioforum.com/threads/oil-drain-bolt-torque-for-the-2-0t-multiair-280-bhp-engine.12917/\",\n        confidence=SINGLE_SOURCE,\n        notes=\"Reported for the 2.0T MultiAir drain plug, described by \"\n              \"this source as having a built-in rubber gasket. Low torque \"\n              \"for a drain plug -- easy to overtighten past this into the \"\n              \"pan threads; use a torque wrench, not feel.\")\n\n_torque(\"filter_cap\", \"Oil filter housing cap (cartridge filter)\",\n        [\"oil_change\"], 25, \"Nm\",\n        source=\"https://www.alfaowner.com/threads/multiair-oil-filter-torque-setting.1116586/\",\n        confidence=SINGLE_SOURCE,\n        notes=\"This engine uses a cartridge filter under a screw-on \"\n              \"plastic housing cap with its own O-ring, not a spin-on \"\n              \"canister. Do not overtighten -- the housing is plastic.\",\n        platform_note=\"Giulia-sourced (2016 MY reference in the thread).\")\n\n_torque(\"wheel_lug\", \"Wheel lug bolts\",\n        [\"oil_change\", \"wheels\", \"brakes_front\", \"brakes_rear\",\n         \"wheel_bearing\"],\n        121, \"Nm\", value_range=(120.7, 122.0),\n        source=\"https://www.alfaowner.com/threads/wheel-bolt-torque-settings.1071610/\",\n        confidence=CORROBORATED,\n        notes=\"Bolts threaded into the hub, NOT nuts on studs -- \"\n              \"confirmed by all sources. Two independent threads \"\n              \"(alfaowner 'Wheel bolt torque settings', stelvioforum \"\n              \"'Stelvio Veloce wheel bolt torque setting') land at \"\n              \"89-90 ft-lb (~121-122 Nm); use that. A third alfaowner \"\n              \"thread reports 110 Nm/81 ft-lb for '14mm bolts', possibly \"\n              \"a different bolt/thread size on a different wheel option \"\n              \"-- confirm which bolt is fitted before trusting either \"\n              \"figure; this is a safety-critical fastener. Torque in a \"\n              \"star/cross pattern, snug then final torque.\")\n\n_torque(\"spark_plug\", \"Spark plugs\", [\"oil_change\", \"spark_plugs\"],\n        19.5, \"Nm\", value_range=(19, 20),\n        source=\"https://www.giuliaforums.com/threads/inconsistent-spark-plug-torque-specs-2-0l.64916/\",\n        confidence=CORROBORATED,\n        notes=\"Two figures close enough to treat as agreeing within \"\n              \"rounding: ~20 Nm and 168 in-lb/14 ft-lb (~19 Nm). The \"\n              \"thread's own title ('Inconsistent spark plug torque specs \"\n              \"2.0L') flags that published specs vary by source/year -- \"\n              \"do not stack this with anti-seize unless the plug maker \"\n              \"calls for it; seat torque affects thread depth into the \"\n              \"aluminum head on this engine.\",\n        platform_note=\"Giulia-sourced; same engine as this Stelvio.\")\n\n_torque(\"undertray\", \"Undertray / belly-pan / splash-shield fasteners\",\n        [\"oil_change\", \"undertray\"], None, \"Nm\", confidence=UNKNOWN,\n        notes=\"No sourced torque spec found. Typically plastic push-pin/\"\n              \"screw retainers with no meaningful torque value (hand-\"\n              \"tight); any metal bolts holding structural shield brackets \"\n              \"should follow TechAuthority.\")\n\n# brakes -----------------------------------------------------------------\n_torque(\"caliper_slider_front\", \"Brake caliper guide/slide pin bolt, front\",\n        [\"brakes_front\"], 30, \"Nm\",\n        source=\"https://www.giuliaforums.com/threads/brake-guide-bolt-torque-spec.52844/\",\n        confidence=CORROBORATED,\n        notes=\"Reported consistently (~22 ft-lb / 30 Nm) for the single \"\n              \"guide-pin bolt (between the alignment pins) on Brembo-\"\n              \"fitted cars. Apply medium-strength (blue) threadlocker per \"\n              \"source -- reusable bolt, but refresh threadlocker each \"\n              \"time it's disturbed.\",\n        platform_note=\"Giulia-sourced, Brembo-fitted cars.\")\n\n_torque(\"caliper_bracket_front\", \"Brake caliper bracket/carrier-to-knuckle \"\n                                  \"bolt, front\", [\"brakes_front\"],\n        None, \"Nm\", confidence=UNKNOWN,\n        notes=\"Conflicting forum reports: one 2018 2.0L thread settled on \"\n              \"~57 ft-lb (~77 Nm) with threadlocker after testing 55 then \"\n              \"60 ft-lb by feel; a separate thread quotes 77 ft-lb \"\n              \"(~104 Nm) outright. These do not agree closely enough to \"\n              \"treat as corroborating, and neither traces to a \"\n              \"manufacturer document -- do not pick one. \" + TECHAUTHORITY\n              + \"; this bolt clamps the whole caliper assembly to the \"\n                \"knuckle.\")\n\n_torque(\"caliper_slider_rear\", \"Brake caliper guide/slide pin bolt, rear\",\n        [\"brakes_rear\"], 27, \"Nm\", value_range=(26, 28),\n        source=\"https://www.giuliaforums.com/threads/2018-2-0l-caliper-bolt-torque.58102/\",\n        confidence=SINGLE_SOURCE,\n        notes=\"From one 2018 2.0L thread (~20 ft-lb / 27 Nm), read via a \"\n              \"search-engine summary only -- the full thread was behind a \"\n              \"paywall during this research pass, so treat as \"\n              \"lower-confidence than a normal SINGLE-SOURCE. It is also \"\n              \"unclear whether this figure is the guide pin, the bracket \"\n              \"bolt, or both -- confirm which fastener it covers. Rear \"\n              \"caliper also carries the electric parking brake actuator: \"\n              \"put the EPB into service mode before loosening (see \"\n              \"BRAKE_SPEC['epb_service_mode']).\",\n        platform_note=\"Giulia-sourced.\")\n\n_torque(\"caliper_bracket_rear\", \"Brake caliper bracket/carrier-to-knuckle \"\n                                 \"bolt, rear\", [\"brakes_rear\"],\n        None, \"Nm\", confidence=UNKNOWN,\n        notes=\"Not distinguished from the rear guide-pin figure in any \"\n              \"source found. \" + TECHAUTHORITY)\n\n_torque(\"rotor_retaining_screw\", \"Rotor retaining screw\",\n        [\"brakes_front\", \"brakes_rear\"], None, \"Nm\", confidence=UNKNOWN,\n        notes=\"Confirmed as an M10 x 1.25 thread (~16.4mm length) from \"\n              \"parts listings, but no torque value found. These screws \"\n              \"are low-torque and easy to snap/strip -- do not guess; \"\n              \"use TechAuthority.\")\n\n# ignition ------------------------------------------------------------------\n_torque(\"coil_pack_bolt\", \"Ignition coil pack retaining bolt/screw\",\n        [\"spark_plugs\", \"coils\"], None, \"Nm\", confidence=UNKNOWN,\n        notes=\"No sourced torque value found.\")\n\n# EVAP ------------------------------------------------------------------\n_torque(\"evap_canister_mount\", \"EVAP canister / ESIM mounting bolts\",\n        [\"evap\"], None, \"Nm\", confidence=UNKNOWN,\n        notes=\"No sourced torque value found. Forum how-tos describe \"\n              \"removing 'the bolts holding the canister in' without \"\n              \"giving a spec. Directly relevant to the current EVAP \"\n              \"(P0440/P0455/P0456) diagnosis on this VIN.\")\n\n_torque(\"evap_esim_mount\", \"EVAP ESIM / leak-detection pump mounting \"\n                            \"fasteners\", [\"evap\"], None, \"Nm\",\n        confidence=UNKNOWN,\n        notes=\"Not distinguished from the canister mounting bolts in any \"\n              \"source found. \" + TECHAUTHORITY)\n\n_torque(\"evap_purge_valve_mount\", \"EVAP purge valve/solenoid mounting \"\n                                   \"bracket bolt\", [\"evap\"],\n        None, \"Nm\", confidence=UNKNOWN,\n        notes=\"No sourced torque value found.\")\n\n# electrical / battery ------------------------------------------------------\n_torque(\"battery_terminal\", \"Battery terminal clamp bolts\", [\"battery\"],\n        None, \"Nm\", confidence=UNKNOWN,\n        notes=\"No vehicle-specific value found. Do not substitute a \"\n              \"generic terminal-bolt range -- confirm against \"\n              \"TechAuthority; overtightening cracks the terminal post.\")\n\n_torque(\"battery_hold_down\", \"Battery hold-down clamp bolt\", [\"battery\"],\n        None, \"Nm\", confidence=UNKNOWN,\n        notes=\"No sourced torque value found.\")\n\n# suspension ------------------------------------------------------------------\n_torque(\"sway_bar_link_front\", \"Sway bar (stabilizer) end link nut, front\",\n        [\"suspension\"], None, \"Nm\", confidence=UNKNOWN,\n        notes=\"No sourced torque value found.\")\n\n_torque(\"sway_bar_link_rear\", \"Sway bar (stabilizer) end link nut, rear\",\n        [\"suspension\"], None, \"Nm\", confidence=UNKNOWN,\n        notes=\"No sourced torque value found.\")\n\n_torque(\"tie_rod_end\", \"Tie rod end nut\", [\"suspension\"],\n        92.5, \"Nm\", value_range=(90, 95),\n        source=\"https://www.alfabb.com/threads/steering-tie-rod-torque-specs.179364/\",\n        confidence=SINGLE_SOURCE,\n        notes=\"Source thread title references the INNER tie rod (to the \"\n              \"steering rack), which may not be the same joint as the \"\n              \"OUTER tie rod end (to the knuckle) a suspension job \"\n              \"usually disturbs -- confirm which joint this covers. If a \"\n              \"castellated nut with a cotter pin, torque to the low end \"\n              \"of the range and continue to the next pin slot rather \"\n              \"than backing off.\")\n\n_torque(\"upper_control_arm\", \"Upper control arm to knuckle bolt\",\n        [\"suspension\"], None, \"Nm\", confidence=UNKNOWN,\n        notes=\"No sourced value. Fact-check 2026-09-26: the 51 Nm previously listed was \"\n              \"attributed to a go-parts.com article that publishes no torque figure (it \"\n              \"says specs must come from the factory service manual). \" + TECHAUTHORITY)\n\n_torque(\"strut_to_lca\", \"Front strut to lower control arm bolt\",\n        [\"suspension\"], None, \"Nm\", single_use=True, confidence=UNKNOWN,\n        notes=\"No sourced value. Fact-check 2026-09-26: the '60 Nm + 135 deg' previously \"\n              \"listed was attributed to a go-parts.com article that contains no torque \"\n              \"spec; it must not be used on this structural bolt. Treat the bolt as \"\n              \"single-use until the service manual says otherwise. \" + TECHAUTHORITY)\n\n_torque(\"lower_control_arm_knuckle\", \"Lower control arm to knuckle bolt\",\n        [\"suspension\"], None, \"Nm\", confidence=UNKNOWN,\n        notes=\"Not distinguished from the strut-to-LCA bolt in any source \"\n              \"found; the underlying search summary explicitly states \"\n              \"verified Giulia/Stelvio torque specs here are not readily \"\n              \"public. \" + TECHAUTHORITY)\n\n_torque(\"lower_control_arm_subframe\", \"Lower control arm to subframe bolt\",\n        [\"suspension\"], None, \"Nm\", confidence=UNKNOWN,\n        notes=\"No sourced torque value found. Many platforms specify \"\n              \"this bolt be torqued at curb/ride height (suspension \"\n              \"loaded) rather than on a lift -- confirm procedure before \"\n              \"assuming a lift torque is valid.\")\n\n_torque(\"wheel_bearing_hub_nut\", \"Wheel bearing/hub retaining nut or bolts\",\n        [\"wheel_bearing\"], None, \"Nm\", confidence=UNKNOWN, single_use=True,\n        notes=\"No sourced torque value found. Hub nuts on many AWD \"\n              \"platforms are single-use, high (200+ Nm) torque-to-yield \"\n              \"fasteners -- treat as single-use until confirmed \"\n              \"otherwise. \" + TECHAUTHORITY)\n\n# driveline (ZF 8HP, transfer case, differential) ----------------------------\n_torque(\"transmission_pan_bolts\", \"ZF 8HP transmission pan/filter \"\n                                   \"assembly bolts (13x)\", [\"transmission\"],\n        10, \"Nm\",\n        source=\"docs/reference/ZF8HP_SERVICE_DATA.md\",\n        confidence=CONFIRMED,\n        notes=\"From this repo's own ZF8HP_SERVICE_DATA.md, sourced to \"\n              \"FCA/Alfa OEM service information for this exact vehicle \"\n              \"(ZF doc 1087.754.107c + FCA text): 13 bolts at 10 N*m \"\n              \"(89 in-lb). Pan and filter are one integrated, non-\"\n              \"separately-serviceable assembly; the pan gasket is \"\n              \"reusable if undamaged. This is the PAN bolt torque, not \"\n              \"the drain/fill plug below.\")\n\n_torque(\"transmission_drain_plug\", \"ZF 8HP transmission fluid drain plug\",\n        [\"transmission\"], None, \"Nm\", confidence=UNKNOWN,\n        notes=\"Not found. The ZF 8HP pan/filter is an integrated \"\n              \"assembly with no conventional dipstick service; a \"\n              \"separate drain plug (if this pan variant has one) was not \"\n              \"identified in this research pass -- see \"\n              \"transmission_pan_bolts above for the related, confirmed \"\n              \"spec. \" + TECHAUTHORITY)\n\n_torque(\"transmission_fill_plug\", \"ZF 8HP transmission fluid fill/level \"\n                                   \"plug\", [\"transmission\"],\n        None, \"Nm\", confidence=UNKNOWN,\n        notes=\"Not found. ZF 8HP fill is a temperature-controlled \"\n              \"level-plug procedure (fluid must be 30-50 C at the fill \"\n              \"hole per FCA/ZF service info in \"\n              \"docs/reference/ZF8HP_SERVICE_DATA.md), not a simple \"\n              \"fill-to-plug -- see that document for the procedure. \"\n              + TECHAUTHORITY)\n\n_torque(\"transfer_case_drain_plug\", \"Transfer case (Q4 power transfer \"\n                                     \"unit) drain plug\", [\"transfer_case\"],\n        None, \"Nm\", confidence=UNKNOWN,\n        notes=\"A stelvioforum thread asking this exact question cites \"\n              \"the rear differential's 26 Nm as known but leaves the \"\n              \"transfer case as an open question for the poster -- this \"\n              \"is an unresolved question in the community, not a settled \"\n              \"value. Do not assume 'probably the same as the diff' -- \"\n              \"that is speculation, not a source.\")\n\n_torque(\"transfer_case_fill_plug\", \"Transfer case (Q4 power transfer \"\n                                    \"unit) fill plug\", [\"transfer_case\"],\n        None, \"Nm\", confidence=UNKNOWN,\n        notes=\"Same as transfer_case_drain_plug -- open question, not \"\n              \"sourced.\")\n\n_torque(\"rear_diff_drain_plug\", \"Rear differential (rear axle) drain plug\",\n        [\"differential\"], 26, \"Nm\",\n        source=\"https://www.stelvioforum.com/threads/transfer-case-drain-fill-plug-torque-specs.24693/\",\n        confidence=SINGLE_SOURCE,\n        notes=\"Stated as known/given by the original poster in a thread \"\n              \"actually asking about the transfer case (see \"\n              \"transfer_case_drain_plug); not independently corroborated \"\n              \"elsewhere in this research pass.\")\n\n_torque(\"rear_diff_fill_plug\", \"Rear differential (rear axle) fill plug\",\n        [\"differential\"], 26, \"Nm\",\n        source=\"https://www.stelvioforum.com/threads/transfer-case-drain-fill-plug-torque-specs.24693/\",\n        confidence=SINGLE_SOURCE,\n        notes=\"Same source as rear_diff_drain_plug; drain and fill plugs \"\n              \"are commonly the same fastener spec on this style of axle \"\n              \"but that has not been independently confirmed as true \"\n              \"here.\")\n\n\n# Safety net, not a per-row habit to maintain by hand: every UNKNOWN torque\n# row must point at TechAuthority (the module's own stated invariant, see the\n# docstring), even one written with a specific enough ``notes`` string that\n# the author forgot to say so explicitly. Idempotent -- running this twice\n# does not double up the pointer.\nfor _row in TORQUES:\n    if _row[\"confidence\"] == UNKNOWN and TECHAUTHORITY not in (_row.get(\"notes\") or \"\"):\n        _row[\"notes\"] = (_row[\"notes\"] + \" \" if _row[\"notes\"] else \"\") + TECHAUTHORITY\ndel _row\n\n\nCATEGORIES: tuple[str, ...] = (\n    \"oil_change\", \"wheels\", \"brakes_front\", \"brakes_rear\", \"spark_plugs\",\n    \"coils\", \"evap\", \"undertray\", \"battery\", \"suspension\", \"transmission\",\n    \"transfer_case\", \"differential\", \"wheel_bearing\",\n)\n\nCATEGORY_LABELS: dict[str, str] = {\n    \"oil_change\": \"Oil change\",\n    \"wheels\": \"Wheels / tyres\",\n    \"brakes_front\": \"Brakes, front\",\n    \"brakes_rear\": \"Brakes, rear\",\n    \"spark_plugs\": \"Spark plugs\",\n    \"coils\": \"Ignition coils\",\n    \"evap\": \"EVAP system\",\n    \"undertray\": \"Undertray / splash shields\",\n    \"battery\": \"Battery\",\n    \"suspension\": \"Suspension\",\n    \"transmission\": \"Transmission (ZF 8HP)\",\n    \"transfer_case\": \"Transfer case (Q4)\",\n    \"differential\": \"Rear differential\",\n    \"wheel_bearing\": \"Wheel bearing / hub\",\n}\n\n\ndef torques_for_category(category: str) -> list[dict[str, Any]]:\n    \"\"\"Every torque row tagged with ``category``, in table order.\"\"\"\n    return [dict(t) for t in TORQUES if category in t[\"categories\"]]\n\n\ndef torques_for_categories(categories: Iterable[str]) -> list[dict[str, Any]]:\n    \"\"\"Union of :func:`torques_for_category` over several categories,\n    de-duplicated by key, in first-seen order.\"\"\"\n    seen: set[str] = set()\n    out: list[dict[str, Any]] = []\n    for cat in categories:\n        for row in torques_for_category(cat):\n            if row[\"key\"] in seen:\n                continue\n            seen.add(row[\"key\"])\n            out.append(row)\n    return out\n\n\ndef checklist_for(categories: Any) -> list[dict[str, Any]]:\n    \"\"\"``torques_for_category``/``torques_for_categories`` unified: accepts\n    either a single category string or an iterable of them.\"\"\"\n    if isinstance(categories, str):\n        return torques_for_category(categories)\n    return torques_for_categories(categories)\n\n\ndef search_torques(q: str = \"\", category: str = \"\") -> list[dict[str, Any]]:\n    \"\"\"Torque rows matching a free-text query and/or a category filter.\n\n    Backs the searchable ``/v/{vin}/torque`` page and its JSON mirror.\n    UNKNOWN rows are never excluded -- the point of the page is that a\n    missing spec stays visible with a TechAuthority pointer, not that it\n    disappears.\n    \"\"\"\n    q = (q or \"\").strip().lower()\n    category = (category or \"\").strip()\n    rows = torques_for_category(category) if category else [dict(t) for t in TORQUES]\n    if not q:\n        return rows\n    out = []\n    for row in rows:\n        haystack = \" \".join([\n            row.get(\"component\", \"\"), row.get(\"notes\", \"\") or \"\",\n            \" \".join(row.get(\"categories\", ())),\n            row.get(\"platform_note\") or \"\",\n        ]).lower()\n        if q in haystack:\n            out.append(row)\n    return out\n\n\ndef torque_by_key(key: str) -> Optional[dict[str, Any]]:\n    for t in TORQUES:\n        if t[\"key\"] == key:\n            return dict(t)\n    return None\n\n\n# alias kept for callers that think in terms of a single lookup-by-id\nget_torque = torque_by_key\n\n\n# --- brakes / wheels / tyres -------------------------------------------------\n\nBRAKE_SPEC: dict[str, dict[str, Any]] = {\n    \"pad_min_mm\": {\n        \"front\": {\"value\": None, \"source\": None, \"confidence\": UNKNOWN,\n                  \"notes\": \"No FCA-specific minimum pad thickness found; \"\n                           \"forum chatter cites a generic industry \"\n                           \"rule-of-thumb (~2-3 mm), not a manufacturer \"\n                           \"spec. This car also has an electronic \"\n                           \"pad-wear sensor on the inner pad. \"\n                           + TECHAUTHORITY},\n        \"rear\": {\"value\": None, \"source\": None, \"confidence\": UNKNOWN,\n                 \"notes\": \"Same as front -- no sourced FCA figure. \"\n                          + TECHAUTHORITY},\n    },\n    \"rotor_new_mm\": {\n        \"front\": {\"value\": 28, \"diameter_mm\": 330, \"source\":\n                  \"https://www.go-parts.com/garage/disc-brake-rotor-alfa-romeo-giulia-alfa-romeo-stelvio-2018-2025\",\n                  \"confidence\": SINGLE_SOURCE,\n                  \"notes\": \"Aftermarket parts-site aggregation, not a \"\n                           \"manufacturer document.\"},\n        \"rear\": {\"value\": 22, \"diameter_mm\": 320, \"source\":\n                 \"https://www.go-parts.com/garage/disc-brake-rotor-alfa-romeo-giulia-alfa-romeo-stelvio-2018-2025\",\n                 \"confidence\": SINGLE_SOURCE,\n                 \"notes\": \"Same source as front.\"},\n    },\n    \"rotor_min_mm\": {\n        \"front\": {\"value\": 25.5, \"source\": \"https://www.go-parts.com/garage/disc-brake-rotor-alfa-romeo-giulia-alfa-romeo-stelvio-2018-2025\",\n                  \"confidence\": SINGLE_SOURCE,\n                  \"notes\": \"Discard/minimum-machining thickness; single \"\n                           \"aftermarket-aggregator source, not \"\n                           \"cross-checked. The rotor's own cast-in \"\n                           \"'MIN TH' marking is the most reliable check \"\n                           \"on the actual part.\"},\n        \"rear\": {\"value\": None, \"source\": None, \"confidence\": UNKNOWN,\n                 \"notes\": \"No widely-published rear minimum found -- the \"\n                          \"source that gave the front figure explicitly \"\n                          \"says so. Read the cast-in MIN TH marking off \"\n                          \"the physical rotor. \" + TECHAUTHORITY},\n    },\n    \"rotor_runout_max_mm\": {\n        \"value\": None, \"source\": None, \"confidence\": UNKNOWN,\n        \"notes\": \"Not found in this research pass. \" + TECHAUTHORITY,\n    },\n    \"fluid_spec\": {\n        \"value\": \"DOT 4\", \"source\": \"forum consensus (stelvioforum, alfabb, giuliaforums); no \"\n                                   \"FCA document located\", \"confidence\": SINGLE_SOURCE,\n        \"notes\": \"Forum consensus across stelvioforum/alfabb/giuliaforums \"\n                 \"threads; no Mopar/FCA document located specifying this \"\n                 \"explicitly for this VIN -- confirm against the \"\n                 \"reservoir cap markings on this specific car. FCA has \"\n                 \"specified DOT 4 Low Viscosity on some contemporaneous \"\n                 \"EPB-equipped platforms, which is not necessarily \"\n                 \"interchangeable with plain DOT 4 even though both meet \"\n                 \"the DOT 4 boiling-point floor.\",\n    },\n    \"fluid_change_interval\": {\n        \"miles\": None, \"months\": 24, \"source\": \"https://vehicleinfo.mopar.com/assets/publications/en-us/Alfa_Romeo/2018/Stelvio/P124461_18_GU_OM_EN_USC_DIGITAL_2nd_V2.pdf\",\n        \"confidence\": CONFIRMED,\n        \"notes\": \"2018 Stelvio US owner's manual, Maintenance Plan note 6: \"\n                 \"'The brake fluid replacement has to be done every two \"\n                 \"years, irrespective of the mileage.' (Corrected \"\n                 \"2026-09-26; previously listed as a forum rule of thumb.)\",\n    },\n    \"oe_tire_size\": {\n        \"base_18in\": {\"value\": \"235/60R18\", \"source\": \"wheel-size.com; tiresize.com\",\n                      \"confidence\": CORROBORATED,\n                      \"notes\": \"Multiple independent tyre-fitment \"\n                               \"databases (wheel-size.com, tiresize.com) \"\n                               \"agree. Read this VIN's actual fitment off \"\n                               \"the door-jamb placard rather than \"\n                               \"assuming from trim level.\"},\n        \"ti_19in\": {\"value\": \"235/55R19, load/speed index 101V\",\n                    \"source\": \"wheel-size.com; tiresize.com\", \"confidence\": CORROBORATED,\n                    \"notes\": \"Ti/19-inch-wheel option. A staggered \"\n                             \"front/rear fitment applies to the \"\n                             \"Quadrifoglio, not the base 2.0T -- confirm \"\n                             \"this VIN's actual wheel/tyre fitment before \"\n                             \"assuming a square (rotatable) set.\"},\n    },\n    \"tire_pressure_kpa\": {\n        \"front\": {\"value\": 207, \"psi\": 30, \"source\": \"HaynesPro-sourced aggregator, 19-inch \"\n                                                       \"fitment only; not re-findable\",\n                  \"confidence\": SINGLE_SOURCE,\n                  \"notes\": \"Reported for the 19-inch fitment \"\n                           \"(HaynesPro-sourced aggregator); the official \"\n                           \"Mopar owner's-manual placard PDF found during \"\n                           \"research was image-based with no extractable \"\n                           \"text, so this could not be confirmed directly \"\n                           \"against the manufacturer document. READ THE \"\n                           \"ACTUAL DOOR-JAMB PLACARD on this VIN -- \"\n                           \"pressure varies by wheel/tyre option and \"\n                           \"load, and no reliable figure was found for \"\n                           \"the 18-inch base fitment specifically.\"},\n        \"rear\": {\"value\": 228, \"psi\": 33, \"source\": \"HaynesPro-sourced aggregator, 19-inch \"\n                                                      \"fitment only; not re-findable\",\n                 \"confidence\": SINGLE_SOURCE,\n                 \"notes\": \"Same caveat as front.\"},\n    },\n    \"rotation_pattern\": {\n        \"value\": \"Base 2.0T (square, non-staggered 18in or 19in Ti \"\n                 \"fitment): standard front-to-rear rotation. Staggered \"\n                 \"fitments (Quadrifoglio and any car actually fitted with \"\n                 \"different front/rear sizes): DO NOT ROTATE.\",\n        \"source\": \"inferred from tyre-fitment databases; no FCA rotation guidance located\",\n        \"confidence\": SINGLE_SOURCE,\n        \"notes\": \"Inferred from consistent single-tyre-size listings \"\n                 \"across fitment databases for the base 2.0T -- no \"\n                 \"explicit FCA rotation-pattern statement found. Confirm \"\n                 \"this VIN's actual fitment (matching vs. staggered) \"\n                 \"before rotating.\",\n    },\n    \"epb_service_mode\": {\n        \"present\": True,\n        \"note\": \"Rear brakes use an electric parking brake (EPB) with a \"\n                \"motorized caliper piston. Reported procedure: \"\n                \"infotainment Settings > Passive Safety > Brake Service \"\n                \"Mode, ignition on/engine off, in Park with the foot \"\n                \"brake released; the screen confirms once the actuators \"\n                \"retract. No wiTECH/scan tool is reported as required for \"\n                \"a routine pad change via this menu path; MultiEcuScan's \"\n                \"own coverage of an equivalent routine was not confirmed \"\n                \"in this research pass. Never force the rear piston back \"\n                \"mechanically without service mode active -- it can strip \"\n                \"the actuator's gears/spindle. Press pistons straight \"\n                \"back (do not rotate -- tears the seal); if the battery \"\n                \"is disconnected while the caliper is off, pump the \"\n                \"brake pedal before reconnecting to avoid setting fault \"\n                \"codes.\",\n        \"source\": \"https://www.servicereset.net/\",\n        \"confidence\": SINGLE_SOURCE,\n    },\n}\n\nTPMS_DIDS = {\n    \"module\": \"RFHUB\",\n    \"dids\": {\"FL\": 0x40B1, \"FR\": 0x40B2, \"RL\": 0x40B3, \"RR\": 0x40B4},\n    \"note\": \"Live TPMS pressure/temperature can be read from the RFHUB \"\n            \"over UDS at DIDs 40B1-40B4 (one per corner); see \"\n            \"cuore/live/addressing.py and cuore/live/did_catalog.py. This \"\n            \"module only documents the mapping -- it performs no live \"\n            \"reads itself; the brakes/wheels/tyres page shows the latest \"\n            \"matching observation from mes.live_obs, read-only, if one \"\n            \"exists.\",\n}\n\n\ndef oil_change_specs() -> dict[str, Any]:\n    \"\"\"Everything the oil-change checklist needs, bundled with sources.\"\"\"\n    return {\n        \"oil\": OIL_SPEC,\n        \"filters\": OIL_FILTER_PARTS,\n        \"drain_plug\": DRAIN_PLUG,\n        \"drain_plug_washer\": DRAIN_PLUG_WASHER,\n        \"interval\": SERVICE_INTERVAL,\n        \"torques\": torques_for_category(\"oil_change\"),\n    }\n\n\ndef brake_wheel_tire_specs() -> dict[str, Any]:\n    \"\"\"Everything the brakes/wheels/tyres checklist needs, with sources.\"\"\"\n    return {\n        \"brake\": BRAKE_SPEC,\n        \"tpms\": TPMS_DIDS,\n        \"torques\": torques_for_categories([\"brakes_front\", \"brakes_rear\",\n                                           \"wheels\", \"wheel_bearing\"]),\n    }\n\n\n__all__ = [\n    \"CONFIRMED\", \"CORROBORATED\", \"SINGLE_SOURCE\", \"UNKNOWN\",\n    \"CONFIDENCE_LEVELS\", \"TECHAUTHORITY\", \"VEHICLE\", \"OIL_SPEC\",\n    \"OIL_FILTER_PARTS\", \"DRAIN_PLUG\", \"DRAIN_PLUG_WASHER\",\n    \"SERVICE_INTERVAL\", \"TORQUES\", \"CATEGORIES\", \"CATEGORY_LABELS\",\n    \"BRAKE_SPEC\", \"TPMS_DIDS\", \"torques_for_category\",\n    \"torques_for_categories\", \"checklist_for\", \"search_torques\",\n    \"torque_by_key\", \"get_torque\", \"oil_change_specs\",\n    \"brake_wheel_tire_specs\", \"nm_to_lbft\", \"lbft_to_nm\",\n]\n","numLines":790,"startLine":1,"totalLines":790}},"sourceToolAssistantUUID":"a88d4484-f4ff-4977-bc26-71a1b33aa639","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
{"parentUuid":"eb4b4e8b-1174-4565-9751-bfd2d7216546","isSidechain":true,"agentId":"a1dcd2d766be47a9a","message":{"model":"claude-sonnet-5","id":"msg_011CfooB5rPnc2guRZ2m5PnB","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_013MRAfct7cRCucGREh7XvTr","name":"Read","input":{"file_path":"C:\\Users\\User\\mcp-servers\\mes-log-mcp\\mes\\maintenance_specs.py"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":3673,"cache_read_input_tokens":81752,"cache_creation":{"ephemeral_5m_input_tokens":3673,"ephemeral_1h_input_tokens":0},"output_tokens":7,"service_tier":"standard","inference_geo":"not_available"},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_013MRAfct7cRCucGREh7XvTr":{"file_path":"C:\\Users\\User\\mcp-servers\\mes-log-mcp\\mes\\maintenance_specs.py"}},"serverClassifierRequest":"f023dab9-613a-4d97-a124-dcac6e98d1f8","apiBlockIndex":2,"requestId":"req_011CfooB5YHJWz16nk8jQNx5","attributionAgent":"general-purpose","type":"assistant","uuid":"0e87496b-7715-4052-917f-400b2c10484f","timestamp":"2026-10-08T00:08:30.028Z","effort":"high","perTurnEffort":null,"userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
{"parentUuid":"0e87496b-7715-4052-917f-400b2c10484f","isSidechain":true,"promptId":"01b24783-2d87-4e75-9b89-4a104a7211fd","agentId":"a1dcd2d766be47a9a","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_013MRAfct7cRCucGREh7XvTr","type":"tool_result","content":"1\t\"\"\"Reference data: 2018 Alfa Romeo Stelvio 2.0T (US) routine maintenance items.\n2\t\n3\tRead-only reference data -- nothing here touches the corpus or the car. It\n4\tis the maintenance-item counterpart to ``mes.service_specs`` (torques,\n5\toil/brakes ledger specs) and ``mes.drivetrain_specs`` (ZF 8HP/Q4/differential\n6\tdeep dive): this module covers the recurring, mostly-owner-schedule items\n7\t(filters, spark plugs, coolant, brake fluid, belts, battery, wipers, fuel\n8\tfilter, PCV, throttle body, boost hoses, washer fluid, A/C service, power\n9\tsteering, hood/door lubrication).\n10\t\n11\tConfidence levels (never invented -- an absent value is recorded as\n12\tUNKNOWN, never guessed):\n13\t\n14\t* ``CONFIRMED``     -- an actual manufacturer document (owner's manual,\n15\t                       Mopar/FCA parts catalog, FCA/Alfa service\n16\t                       information, TechAuthority excerpt).\n17\t* ``CORROBORATED``  -- two independent non-manufacturer sources agree.\n18\t* ``SINGLE_SOURCE`` -- exactly one source found, not cross-checked.\n19\t* ``UNKNOWN``       -- nothing credible found. ``value`` is ``None``, never\n20\t                       a placeholder number -- ``notes``/``interval_note``\n21\t                       always points at the service manual.\n22\t\n23\tTorque values are NOT duplicated here -- ``torque_keys`` on each item points\n24\tinto ``mes.service_specs.TORQUES`` (e.g. ``spark_plug``) so there is exactly\n25\tone place a torque figure can drift out of date.\n26\t\n27\tSee ``docs/reference/STELVIO_20T_MAINTENANCE_SPECS.md`` for the\n28\thuman-readable writeup with the same data and full source links.\n29\t\"\"\"\n30\t\n31\tfrom __future__ import annotations\n32\t\n33\tfrom typing import Any, Optional\n34\t\n35\t# The 2018 US Stelvio owner's manual (the manufacturer document backing every\n36\t# CONFIRMED row below unless a row says otherwise), fetched directly from\n37\t# FCA/Mopar's own vehicle-info host. Its \"Maintenance Plan (2.0 T4 MAir\n38\t# Engine)\" table (pp. 213-217) and \"Fluid Capacities\" / \"Fluids And\n39\t# Lubricants\" tables (pp. 262-264) are the source for every OM_URL citation.\n40\tOM_URL = (\"https://vehicleinfo.mopar.com/assets/publications/en-us/\"\n41\t          \"Alfa_Romeo/2018/Stelvio/P124461_18_GU_OM_EN_USC_DIGITAL_2nd_V2.pdf\")\n42\t\n43\tCONFIRMED = \"CONFIRMED\"\n44\tCORROBORATED = \"CORROBORATED\"\n45\tSINGLE_SOURCE = \"SINGLE-SOURCE\"\n46\tUNKNOWN = \"UNKNOWN\"\n47\t\n48\tCONFIDENCE_LEVELS = (CONFIRMED, CORROBORATED, SINGLE_SOURCE, UNKNOWN)\n49\t\n50\tTECHAUTHORITY = \"use the service manual (TechAuthority)\"\n51\t\n52\tVEHICLE = (\"2018 Alfa Romeo Stelvio 2.0T (GU), 2.0L GME-T4 MultiAir turbo, \"\n53\t           \"sales code EC2, US market, Q4 AWD, ZF 8HP automatic\")\n54\t\n55\tCATEGORIES: tuple[str, ...] = (\n56\t    \"engine\", \"fluids\", \"filters\", \"ignition\", \"electrical\", \"body\",\n57\t)\n58\t\n59\tREQUIRED_KEYS: tuple[str, ...] = (\n60\t    \"key\", \"label\", \"category\",\n61\t    \"interval_miles\", \"interval_km\", \"interval_months\",\n62\t    \"interval_note\", \"interval_confidence\", \"interval_source\",\n63\t    \"parts\", \"fluid\", \"torque_keys\",\n64\t    \"procedure\", \"checks\", \"post_service\", \"notes\",\n65\t)\n66\t\n67\tITEM_ORDER: tuple[str, ...] = (\n68\t    \"engine_air_filter\", \"cabin_air_filter\", \"spark_plugs\",\n69\t    \"ignition_coils_inspect\", \"coolant\", \"brake_fluid\", \"drive_belt\",\n70\t    \"battery_12v\", \"wipers\", \"fuel_filter\", \"pcv_system\",\n71\t    \"throttle_body_clean\", \"intake_boost_hoses_inspect\", \"washer_fluid\",\n72\t    \"a_c_cabin_service\", \"power_steering\", \"hood_and_door_lubrication\",\n73\t)\n74\t\n75\t\n76\tITEMS: dict[str, dict[str, Any]] = {}\n77\t\n78\t\n79\tdef _part(name: Optional[str] = None, part_number: Optional[str] = None,\n80\t          confidence: str = UNKNOWN, source: Optional[str] = None,\n81\t          notes: str = \"\") -> dict[str, Any]:\n82\t    if confidence not in CONFIDENCE_LEVELS:\n83\t        raise ValueError(f\"bad confidence {confidence!r}\")\n84\t    if not notes and confidence == UNKNOWN:\n85\t        notes = TECHAUTHORITY\n86\t    return {\n87\t        \"name\": name, \"part_number\": part_number, \"confidence\": confidence,\n88\t        \"source\": source, \"notes\": notes.strip(),\n89\t    }\n90\t\n91\t\n92\tdef _fluid(spec: Optional[str] = None, capacity: Optional[float] = None,\n93\t           unit: Optional[str] = None, confidence: str = UNKNOWN,\n94\t           source: Optional[str] = None, notes: str = \"\") -> dict[str, Any]:\n95\t    if confidence not in CONFIDENCE_LEVELS:\n96\t        raise ValueError(f\"bad confidence {confidence!r}\")\n97\t    if not notes and confidence == UNKNOWN:\n98\t        notes = TECHAUTHORITY\n99\t    return {\n100\t        \"spec\": spec, \"capacity\": capacity, \"unit\": unit,\n101\t        \"confidence\": confidence, \"source\": source, \"notes\": notes.strip(),\n102\t    }\n103\t\n104\t\n105\tdef _item(key: str, label: str, category: str, *,\n106\t          interval_miles: Optional[int] = None,\n107\t          interval_km: Optional[int] = None,\n108\t          interval_months: Optional[int] = None,\n109\t          interval_note: str = \"\",\n110\t          interval_confidence: str = UNKNOWN,\n111\t          interval_source: Optional[str] = None,\n112\t          parts: Optional[list[dict[str, Any]]] = None,\n113\t          fluid: Optional[dict[str, Any]] = None,\n114\t          torque_keys: Optional[list[str]] = None,\n115\t          procedure: Optional[list[str]] = None,\n116\t          checks: Optional[list[str]] = None,\n117\t          post_service: Optional[list[str]] = None,\n118\t          notes: str = \"\") -> None:\n119\t    if category not in CATEGORIES:\n120\t        raise ValueError(f\"bad category {category!r}\")\n121\t    if interval_confidence not in CONFIDENCE_LEVELS:\n122\t        raise ValueError(f\"bad confidence {interval_confidence!r}\")\n123\t    if not interval_note and interval_confidence == UNKNOWN:\n124\t        interval_note = TECHAUTHORITY\n125\t    ITEMS[key] = {\n126\t        \"key\": key,\n127\t        \"label\": label,\n128\t        \"category\": category,\n129\t        \"interval_miles\": interval_miles,\n130\t        \"interval_km\": interval_km,\n131\t        \"interval_months\": interval_months,\n132\t        \"interval_note\": interval_note.strip(),\n133\t        \"interval_confidence\": interval_confidence,\n134\t        \"interval_source\": interval_source,\n135\t        \"parts\": parts or [],\n136\t        \"fluid\": fluid,\n137\t        \"torque_keys\": torque_keys or [],\n138\t        \"procedure\": procedure or [],\n139\t        \"checks\": checks or [],\n140\t        \"post_service\": post_service or [],\n141\t        \"notes\": notes.strip(),\n142\t    }\n143\t\n144\t\n145\t# --- items, in the specified order (initially UNKNOWN/None throughout;\n146\t#     filled in by the research pass below) ---------------------------------\n147\t\n148\t_item(\n149\t    \"engine_air_filter\", \"Engine air filter\", \"filters\",\n150\t    interval_miles=30000, interval_km=48000, interval_months=36,\n151\t    interval_confidence=CONFIRMED, interval_source=OM_URL,\n152\t    interval_note=(\n153\t        \"Owner's manual 'Maintenance Plan (2.0 T4 MAir Engine)' row \"\n154\t        \"'Replace air cleaner cartridge': mandatory at 30,000/60,000/90,000/\"\n155\t        \"120,000/150,000 miles (3/6/9/12/15 years) -- every 30,000 miles or \"\n156\t        \"3 years, whichever comes first. Severe-duty override (footnote, \"\n157\t        \"shared with the cabin filter): dusty-area use requires replacement \"\n158\t        \"every 10,000 miles (16,000 km) instead.\"),\n159\t    parts=[_part(\n160\t        name=\"Engine air filter (2.0L, non-Quadrifoglio)\",\n161\t        part_number=\"68301538AA\", confidence=CORROBORATED,\n162\t        source=\"https://www.moparonlineparts.com/sku/68301538aa.html\",\n163\t        notes=\"Cross-referenced consistently across Mopar Online Parts, \"\n164\t              \"madnessautoworks, AW Italian Auto Parts, and aftermarket \"\n165\t              \"equivalents (WIX WA11084, Champion CA12953, Fram XA10670, \"\n166\t              \"PurolatorAir A11523, Premium Guard PA99467) for 2018-2020 \"\n167\t              \"Stelvio/Giulia 2.0L non-QV. Confirm no running change for \"\n168\t              \"later model years at a parts counter by VIN.\")],\n169\t    procedure=[\"Release the air box clips/screws and lift the lid.\",\n170\t               \"Note the pleated element's orientation before removing it.\",\n171\t               \"Wipe out the air box; fit the new element the same way \"\n172\t               \"round.\",\n173\t               \"Reseat the lid and clips; confirm the intake duct/MAF \"\n174\t               \"connector is fully seated.\"],\n175\t    checks=[\"Filter element condition (oil/dust contamination -- heavy \"\n176\t            \"oiling can point at a recent intake leak or PCV oil-\"\n177\t            \"carryover)\", \"Air box and duct clips for cracks\"],\n178\t    post_service=[\"None required -- no relearn/adaptation needed for an \"\n179\t                  \"air filter change.\"],\n180\t    notes=\"The owner's manual has no row literally labelled 'engine air \"\n181\t          \"filter' -- this is its 'air cleaner cartridge' row.\",\n182\t)\n183\t\n184\t_item(\n185\t    \"cabin_air_filter\", \"Cabin air filter\", \"filters\",\n186\t    interval_miles=20000, interval_km=32000, interval_months=24,\n187\t    interval_confidence=CONFIRMED, interval_source=OM_URL,\n188\t    interval_note=(\n189\t        \"Owner's manual 'Replace the passenger compartment cleaner' row: \"\n190\t        \"MANDATORY at 20,000/40,000/60,000/80,000/100,000/120,000/140,000 \"\n191\t        \"miles (2/4/6/8/10/12/14 years) -- every 20,000 miles or 2 years. \"\n192\t        \"RECOMMENDED (not mandatory) check/replace at the intervening \"\n193\t        \"10,000-mile odd points (10k/30k/50k/70k/90k/110k/130k/150k). \"\n194\t        \"Severe-duty override (same footnote as the engine air filter): \"\n195\t        \"dusty-area use requires replacement every 10,000 miles \"\n196\t        \"(16,000 km).\"),\n197\t    parts=[_part(\n198\t        name=\"Cabin air filter\", part_number=\"68444656AA\",\n199\t        confidence=SINGLE_SOURCE,\n200\t        source=\"https://www.moparonlineparts.com/part-model/alfa-romeo-stelvio-cabin-air-filter.html\",\n201\t        notes=\"Three different Mopar part numbers turned up across \"\n202\t              \"retailer listings for nominally the same 2018-2025 Stelvio \"\n203\t              \"cabin filter -- 68444656AA, 68392124AA, and (a separate \"\n204\t              \"search) 68320112AA -- with no documented year/trim split. \"\n205\t              \"Confirm the correct number for this VIN at a Mopar parts \"\n206\t              \"counter before ordering.\")],\n207\t    procedure=[\"Locate the cabin filter housing (commonly behind the \"\n208\t               \"glovebox on this platform).\",\n209\t               \"Release the housing cover and slide the old filter out, \"\n210\t               \"noting airflow-direction arrows.\",\n211\t               \"Fit the new filter with the same orientation; reseat the \"\n212\t               \"cover.\"],\n213\t    checks=[\"Airflow-direction arrow orientation\", \"Debris/leaf litter in \"\n214\t            \"the housing\", \"Musty-odor complaints (may indicate a filter \"\n215\t            \"overdue for replacement or evaporator contamination)\"],\n216\t    post_service=[\"None required.\"],\n217\t    notes=\"\",\n218\t)\n219\t\n220\t_item(\n221\t    \"spark_plugs\", \"Spark plugs\", \"ignition\",\n222\t    interval_miles=30000, interval_km=48000, interval_months=None,\n223\t    interval_confidence=CONFIRMED, interval_source=OM_URL,\n224\t    interval_note=(\n225\t        \"Owner's manual 'Maintenance Plan' row 'Spark plug replacement': \"\n226\t        \"mandatory at 30,000/60,000/90,000/120,000/150,000 miles. Its own \"\n227\t        \"footnote: 'The spark plug change interval is mileage-based only. \"\n228\t        \"Yearly intervals do not apply.' -- deliberately no interval_months \"\n229\t        \"value here, not an oversight.\"),\n230\t    parts=[_part(\n231\t        name=\"Spark plug (2.0L, set of 4)\",\n232\t        part_number=\"NGK 90219 (ILZKR7G7G) / Mopar 68292346AA\",\n233\t        confidence=CORROBORATED,\n234\t        source=\"https://www.ngk.com/ngk-90219-ilzkr7g7g-laser-iridium-spark-plug\",\n235\t        notes=\"NGK's own listing plus multiple independent parts \"\n236\t              \"retailers (PartsGeek, Alfa Corsa, Eurocompulsion, \"\n237\t              \"madnessautoworks) agree on NGK 90219 / Mopar 68292346AA for \"\n238\t              \"the 2018-2024 2.0L. Gap: NGK's own spec sheet gives \"\n239\t              \"0.028 in (0.7 mm); a second, less authoritative listing \"\n240\t              \"gave 0.026 in -- plugs ship pre-gapped from the factory, \"\n241\t              \"verify with a gap tool before installing rather than \"\n242\t              \"trusting either figure blindly.\"),\n243\t    ],\n244\t    torque_keys=[\"spark_plug\"],\n245\t    procedure=[\"Remove the engine cover and disconnect each ignition coil \"\n246\t               \"connector.\",\n247\t               \"Remove the coil retaining bolt/screw and pull each coil \"\n248\t               \"straight up.\",\n249\t               \"Blow out the plug wells before removing plugs to keep \"\n250\t               \"debris out of the cylinder.\",\n251\t               \"Remove and inspect each plug; gap-check new plugs before \"\n252\t               \"installing even though they ship pre-gapped.\",\n253\t               \"Torque to spec (see mes.service_specs TORQUES['spark_plug'])\"\n254\t               \" and reinstall coils/connectors.\"],\n255\t    checks=[\"Electrode wear/color per cylinder (uneven wear across \"\n256\t            \"cylinders can point at a cylinder-specific issue)\",\n257\t            \"Thread condition in the aluminum head on removal\"],\n258\t    post_service=[\"No relearn required. Do not add anti-seize unless the \"\n259\t                  \"plug maker specifies it -- it changes effective seating \"\n260\t                  \"torque on this aluminum head (see the spark_plug torque \"\n261\t                  \"row's own notes in mes.service_specs).\"],\n262\t    notes=\"\",\n263\t)\n264\t\n265\t_item(\n266\t    \"ignition_coils_inspect\", \"Ignition coils (inspect)\", \"ignition\",\n267\t    interval_confidence=UNKNOWN,\n268\t    interval_note=(\n269\t        \"Not listed as a scheduled item anywhere in the 2018 US owner's \"\n270\t        \"manual maintenance plan -- coils on this engine are inspected/\"\n271\t        \"diagnosed on symptoms (misfire codes), not replaced on a fixed \"\n272\t        \"interval. \" + TECHAUTHORITY),\n273\t    torque_keys=[\"coil_pack_bolt\"],\n274\t    checks=[\"Misfire/DTC history per cylinder\",\n275\t            \"Coil boot condition and carbon tracking\",\n276\t            \"Spark plug well for oil intrusion (a common cause of coil \"\n277\t            \"boot arcing on MultiAir-family engines)\"],\n278\t    procedure=[\"Disconnect the coil connector and remove its retaining \"\n279\t               \"bolt/screw before pulling it straight up off the plug.\"],\n280\t    notes=\"No sourced part number for this pass; do not order a coil \"\n281\t          \"speculatively -- confirm the failing cylinder via live misfire \"\n282\t          \"counters first.\",\n283\t)\n284\t\n285\t_item(\n286\t    \"coolant\", \"Engine coolant\", \"fluids\",\n287\t    interval_miles=150000, interval_km=240000, interval_months=180,\n288\t    interval_confidence=CONFIRMED, interval_source=OM_URL,\n289\t    interval_note=(\n290\t        \"Owner's manual 'Maintenance Plan' marks a single mandatory \"\n291\t        \"coolant change at 150,000 miles (240,000 km) / 15 years -- a \"\n292\t        \"long-life OAT fill, not a periodic service item at normal \"\n293\t        \"intervals. The monthly/600-mile 'Periodic Checks' item is a \"\n294\t        \"level/top-off check only, not a change.\"),\n295\t    fluid=_fluid(\n296\t        spec=\"FCA/Alfa MS.90032 (CUNA NC956-16, ASTM D3306) OAT coolant, \"\n297\t             \"used at 50% concentration; NOT mixable with different-\"\n298\t             \"formulation coolants; a 60% product / 40% distilled-water \"\n299\t             \"mix is recommended for particularly harsh climates\",\n300\t        capacity=8.8, unit=\"L\", confidence=CONFIRMED, source=OM_URL,\n301\t        notes=\"Owner's manual 'Fluid Capacities' table: engine cooling \"\n302\t              \"system 2.3 US gal / 8.8 L. This is the ENGINE circuit only \"\n303\t              \"-- the water-cooled intercooler on this turbo engine has \"\n304\t              \"its OWN separate cooling circuit at 1.4 US gal / 5.25 L, \"\n305\t              \"not included in this figure. Independently, stelvioforum/\"\n306\t              \"Petronas Paraflu UP threads name the same MS.90032 spec, \"\n307\t              \"corroborating spec identity even though the manual is now \"\n308\t              \"the primary CONFIRMED source for both spec and capacity.\"),\n309\t    torque_keys=[],\n310\t    checks=[\"Level at the engine coolant reservoir (MIN/MAX)\",\n311\t            \"Level at the SEPARATE intercooler coolant reservoir\",\n312\t            \"Condition/color for contamination or oil intrusion\"],\n313\t    procedure=[\"Recover coolant into a clean container if reusing.\",\n314\t               \"Drain the engine circuit (drain point/plug not sourced \"\n315\t               \"this pass -- see notes).\",\n316\t               \"Refill with MS.90032-spec coolant only; do not mix \"\n317\t               \"formulations.\",\n318\t               \"Bleed per the correct procedure for this engine (not \"\n319\t               \"sourced this pass) and verify final level cold.\"],\n320\t    post_service=[\"No relearn needed. No sourced bleed procedure or \"\n321\t                  \"drain-plug location for the 2.0T engine circuit this \"\n322\t                  \"pass -- \" + TECHAUTHORITY],\n323\t    notes=\"Remember the intercooler circuit is a SEPARATE fill/bleed from \"\n324\t          \"the engine circuit on this engine.\",\n325\t)\n326\t\n327\t_item(\n328\t    \"brake_fluid\", \"Brake fluid\", \"fluids\",\n329\t    interval_months=24, interval_confidence=CONFIRMED, interval_source=OM_URL,\n330\t    interval_note=(\n331\t        \"Owner's manual footnote on the Maintenance Plan: 'The brake fluid \"\n332\t        \"replacement has to be done every two years, irrespective of the \"\n333\t        \"mileage.' No mileage bullet/mark appears in the table for this \"\n334\t        \"row -- it is purely calendar-based. This is a firmer source than \"\n335\t        \"mes.service_specs.BRAKE_SPEC['fluid_change_interval'], which is \"\n336\t        \"still recorded there as SINGLE-SOURCE forum-only; that module is \"\n337\t        \"out of scope for this pass and has not been updated to match.\"),\n338\t    fluid=_fluid(\n339\t        spec=\"DOT 4, FCA spec MS.90039\", capacity=0.9, unit=\"L\",\n340\t        confidence=CONFIRMED, source=OM_URL,\n341\t        notes=\"Owner's manual 'Fluids And Lubricants' table gives DOT 4 / \"\n342\t              \"MS.90039 explicitly. 'Fluid Capacities' table gives the \"\n343\t              \"hydraulic brake circuit at 0.9 US qt / 0.9 L -- reservoir + \"\n344\t              \"lines, not a drain-and-refill service quantity.\"),\n345\t    torque_keys=[],\n346\t    checks=[\"Fluid color/clarity\", \"Moisture content if a test kit is \"\n347\t            \"available\", \"Reservoir level vs MIN/MAX -- also monitored by \"\n348\t            \"the INSUFFICIENT BRAKE FLUID/ELECTRIC PARK BRAKE telltale per \"\n349\t            \"the owner's manual\"],\n350\t    post_service=[\"Bleed all four corners plus the ABS/ESC modulator. On \"\n351\t                  \"EPB-equipped rear calipers, put the EPB into service \"\n352\t                  \"mode before disturbing the rear circuit -- see \"\n353\t                  \"mes.service_specs.BRAKE_SPEC['epb_service_mode'].\"],\n354\t)\n355\t\n356\t_item(\n357\t    \"drive_belt\", \"Drive (serpentine) belt\", \"engine\",\n358\t    interval_miles=36000, interval_km=60000, interval_months=48,\n359\t    interval_confidence=CONFIRMED, interval_source=OM_URL,\n360\t    interval_note=(\n361\t        \"Owner's manual footnote on the Maintenance Plan: non-dusty areas, \"\n362\t        \"recommended max 36,000 miles (60,000 km), and regardless of \"\n363\t        \"mileage replace every 4 years. Dusty/demanding use (cold \"\n364\t        \"climates, town use, long periods of idling): advised max 18,000 \"\n365\t        \"miles (30,000 km), replace every 2 years regardless of mileage. \"\n366\t        \"This item's interval_miles/interval_km/interval_months record the \"\n367\t        \"NORMAL-duty figure; treat 18,000 mi / 30,000 km / 24 months as \"\n368\t        \"the floor for a car used hard.\"),\n369\t    parts=[_part(\n370\t        name=\"Accessory (serpentine) drive belt\", part_number=\"68326261AA\",\n371\t        confidence=SINGLE_SOURCE,\n372\t        source=\"https://awitalian.com/product/alfa-romeo-giulia-stelvio-serpentine-drive-belt-68326261aa/\",\n373\t        notes=\"Single aftermarket-retailer listing for the 2018-2022 2.0L; \"\n374\t              \"not cross-checked against a second retailer or a \"\n375\t              \"Mopar-direct listing this pass.\")],\n376\t    checks=[\"Visible cracking, glazing, or fraying\",\n377\t            \"Tensioner/idler pulley play and noise\",\n378\t            \"Correct routing per the underhood belt-routing decal\"],\n379\t    procedure=[\"Relieve the tensioner (per the underhood routing decal) \"\n380\t               \"and slip the belt off the accessory pulleys.\",\n381\t               \"Inspect the tensioner and idler pulleys for play/noise \"\n382\t               \"before reusing them.\",\n383\t               \"Route the new belt per the decal; release the tensioner \"\n384\t               \"slowly onto the belt.\"],\n385\t    post_service=[\"None required.\"],\n386\t)\n387\t\n388\t_item(\n389\t    \"battery_12v\", \"12V battery\", \"electrical\",\n390\t    interval_miles=10000, interval_km=16000, interval_months=12,\n391\t    interval_confidence=CONFIRMED, interval_source=OM_URL,\n392\t    interval_note=(\n393\t        \"Owner's manual 'Maintenance Plan' row 'Check battery charge \"\n394\t        \"status with the proper instrument' is MANDATORY at every one of \"\n395\t        \"the 10,000-mile/1-year columns -- i.e. every service visit. \"\n396\t        \"Outright battery REPLACEMENT has no fixed FCA interval -- it is \"\n397\t        \"condition/age driven (load-test failure), not scheduled.\"),\n398\t    parts=[_part(\n399\t        name=\"12V battery (factory-fit EFB standard; AGM on some builds/\"\n400\t             \"replacements; BCI Group 94R / H7)\",\n401\t        part_number=\"Mopar BBH8A001AA (AGM, reported to cross to Group \"\n402\t                     \"94R)\",\n403\t        confidence=SINGLE_SOURCE,\n404\t        source=\"https://www.stelvioforum.com/threads/mopar-replacement-battery.9201/\",\n405\t        notes=\"Group-size naming is inconsistent across sources (94R vs \"\n406\t              \"H7 vs 49/H8 all used loosely by different posters for what \"\n407\t              \"is described as the same physical battery) -- confirm \"\n408\t              \"physical dimensions/terminal layout against the battery \"\n409\t              \"actually fitted before ordering, not just a group code. If \"\n410\t              \"the car left the factory with AGM (Start/Stop-equipped), \"\n411\t              \"do not downgrade to a plain flooded/EFB battery on \"\n412\t              \"replacement.\")],\n413\t    torque_keys=[\"battery_terminal\", \"battery_hold_down\"],\n414\t    checks=[\"Charge status/state of health with a proper tester (owner's \"\n415\t            \"manual wording)\", \"Terminal corrosion/tightness\",\n416\t            \"Hold-down clamp secure\"],\n417\t    post_service=[\n418\t        \"No explicit 'register battery replacement' procedure was found \"\n419\t        \"for this platform: a stelvioforum thread ('Register Battery \"\n420\t        \"Replacement') reports MES/wiTECH have no such function here \"\n421\t        \"(unlike some other FCA-group platforms) -- the charging-system \"\n422\t        \"monitor recalibrates itself over a period of hours after \"\n423\t        \"reconnection, with no separate registration step to run.\",\n424\t        \"After any battery disconnect, expect to reset the clock and \"\n425\t        \"re-run any one-touch window/sunroof auto-up/down \"\n426\t        \"initialization.\",\n427\t    ],\n428\t    notes=(\n429\t        \"CORRECTION to the common assumption of a main+auxiliary battery \"\n430\t        \"pair on Start/Stop cars: research this pass (alfaowner.com \"\n431\t        \"'second battery location'; giuliaforums.com 'is there really a \"\n432\t        \"separate battery for start/stop') found this platform uses a \"\n433\t        \"SINGLE 12V battery (trunk-mounted, under the floor panel) for \"\n434\t        \"both normal electrical loads and the Start/Stop system -- no \"\n435\t        \"second/auxiliary battery is documented for the Stelvio. If a \"\n436\t        \"specific VIN is found to have one, that is new information to \"\n437\t        \"update here, not something to assume. Also note: this vehicle's \"\n438\t        \"own owner's manual uses the acronym 'IBS' for the unrelated \"\n439\t        \"'Integrated Brake System' -- do not confuse that with an \"\n440\t        \"'Intelligent Battery Sensor', a term used loosely for this kind \"\n441\t        \"of battery-monitor topic on other platforms but not confirmed to \"\n442\t        \"apply here by name.\"\n443\t    ),\n444\t)\n445\t\n446\t_item(\n447\t    \"wipers\", \"Wiper blades\", \"body\",\n448\t    interval_months=12, interval_confidence=CONFIRMED, interval_source=OM_URL,\n449\t    interval_note=(\n450\t        \"Owner's manual: 'The life of the windshield wiper blades varies \"\n451\t        \"according to the usage frequency. In any case, it is advised to \"\n452\t        \"replace the blades approximately once a year.' No mileage figure \"\n453\t        \"given.\"),\n454\t    parts=[\n455\t        _part(name=\"Front wiper blades (driver 26in/660mm, passenger \"\n456\t                    \"18in/460mm)\",\n457\t              part_number=None, confidence=CORROBORATED,\n458\t              source=\"https://autopadre.com/wiper-size/alfa-romeo-stelvio\",\n459\t              notes=\"Sizes corroborated across multiple independent \"\n460\t                    \"wiper-fitment databases (autopadre, \"\n461\t                    \"windshieldwipers.com, allwipersize.com, \"\n462\t                    \"wipersizechart.com) for 2018-2026. No confidently-\"\n463\t                    \"sourced Mopar OEM part number found this pass -- \"\n464\t                    \"candidates seen (68462474AA, 68357040AA) were listed \"\n465\t                    \"for a REAR wiper arm/blade assembly, not the front \"\n466\t                    \"blades, and were not clearly confirmed for this \"\n467\t                    \"model year. Confirm at a parts counter by VIN.\"),\n468\t        _part(name=\"Rear wiper blade (13in/330mm)\",\n469\t              part_number=None, confidence=CORROBORATED,\n470\t              source=\"https://autopadre.com/wiper-size/alfa-romeo-stelvio\",\n471\t              notes=\"Same corroboration as the front blades. \"\n472\t                    \"68462474AA/68357040AA were seen for a rear wiper arm/\"\n473\t                    \"blade listing but not confirmed for this VIN's model \"\n474\t                    \"year -- confirm before ordering.\"),\n475\t    ],\n476\t    checks=[\"Blade edge for cracking/tearing\", \"Chatter/streaking/noise\",\n477\t            \"Rain-sensor auto-wipe operation\"],\n478\t    procedure=[\"Activate the windshield-wiper 'service position' function \"\n479\t               \"(owner's manual) before replacing blades for easier \"\n480\t               \"access.\",\n481\t               \"Release the hook/pinch-tab retainer per blade type and \"\n482\t               \"slide the old blade off the arm.\",\n483\t               \"Fit the new blade until it clicks/locks; lower the arm \"\n484\t               \"back onto the glass.\"],\n485\t    post_service=[\"None.\"],\n486\t)\n487\t\n488\t_item(\n489\t    \"fuel_filter\", \"Fuel filter\", \"filters\",\n490\t    interval_confidence=CORROBORATED,\n491\t    interval_source=\"https://www.stelvioforum.com/threads/fuel-filter.10613/\",\n492\t    interval_note=(\n493\t        \"No separate serviceable fuel filter on the US gas 2.0T: forum \"\n494\t        \"consensus (independent stelvioforum threads 'Fuel Filter' and \"\n495\t        \"'Fuel Filter Service') describes an in-tank fuel filter 'sock' \"\n496\t        \"integrated into the fuel pump module -- non-serviceable except by \"\n497\t        \"replacing the whole module, and with no scheduled replacement \"\n498\t        \"interval. This is corroborated by the owner's manual itself, \"\n499\t        \"which lists a SEPARATE maintenance-plan row, 'Replace the \"\n500\t        \"additional fuel filter (if equipped)', mandatory every 10,000 \"\n501\t        \"miles -- the 'if equipped' phrasing implies that additional, \"\n502\t        \"serviceable filter is NOT fitted to every variant, and nothing \"\n503\t        \"in this research pass found evidence the US gas 2.0T carries it. \"\n504\t        \"Deliberately no interval_miles/km/months here -- this is a \"\n505\t        \"lifetime, non-serviceable-on-schedule item as best \"\n506\t        \"established, not an unresearched gap.\"),\n507\t    notes=\"Do not confuse this with the owner's manual's own 'additional \"\n508\t          \"fuel filter (if equipped)' row -- if a specific VIN is \"\n509\t          \"confirmed to have that filter fitted, its interval is every \"\n510\t          \"10,000 miles per the manual, which would supersede the note \"\n511\t          \"above for that car.\",\n512\t)\n513\t\n514\t_item(\n515\t    \"pcv_system\", \"PCV (crankcase ventilation) system\", \"engine\",\n516\t    interval_confidence=UNKNOWN,\n517\t    interval_note=(\n518\t        \"Not listed in the owner's manual maintenance plan -- no \"\n519\t        \"scheduled interval; PCV components on this engine are treated as \"\n520\t        \"inspect/replace-on-failure (oil consumption, rough idle, \"\n521\t        \"crankcase-pressure DTCs). \" + TECHAUTHORITY),\n522\t    parts=[_part(\n523\t        name=\"PCV valve/housing\", part_number=\"04893610AC\",\n524\t        confidence=SINGLE_SOURCE,\n525\t        source=\"https://www.alfaromeofiatpartsusa.com/oem-parts/mopar-genuine-oem-pcv-valve-alfa-romeo-giulia-stelvio-jeep-dodge-hornet-wrangler-compass-cherokee-4893610ac\",\n526\t        notes=\"Listed as a shared Mopar part across Giulia/Stelvio 2.0L \"\n527\t              \"(2018-2026) plus several Jeep/Dodge products -- plausible \"\n528\t              \"for a corporate-parts-bin PCV valve, but not independently \"\n529\t              \"cross-checked against a second retailer this pass. Do NOT \"\n530\t              \"use 68324751AA -- that is the 2.9L V6 (Quadrifoglio) PCV \"\n531\t              \"valve and housing, a different part for a different \"\n532\t              \"engine.\")],\n533\t    checks=[\"Oil residue/oil consumption pointing at PCV oil-carryover\",\n534\t            \"Rough/unstable idle or a lean DTC that could indicate a \"\n535\t            \"stuck-open valve or a split hose\",\n536\t            \"Crankcase breather hose condition\"],\n537\t)\n538\t\n539\t_item(\n540\t    \"throttle_body_clean\", \"Throttle body cleaning\", \"engine\",\n541\t    interval_confidence=UNKNOWN,\n542\t    interval_note=(\n543\t        \"No scheduled throttle-body-cleaning interval in the owner's \"\n544\t        \"manual -- this engine's factory maintenance plan does not list \"\n545\t        \"it. Aftermarket/forum guidance around 60,000 miles, or 'clean if \"\n546\t        \"symptomatic' (hesitation, carbon buildup), was found but not \"\n547\t        \"traced to a specific, checkable source -- treat as unsourced \"\n548\t        \"shop practice, not an OEM figure. \" + TECHAUTHORITY),\n549\t    checks=[\"Idle quality / hesitation complaints\",\n550\t            \"Visible carbon on the throttle plate and bore\"],\n551\t    post_service=[\"An electronic throttle body relearn/adaptation is \"\n552\t                  \"commonly required after cleaning or replacing the \"\n553\t                  \"throttle body on Alfa Romeo platforms generally -- \"\n554\t                  \"confirm the exact MES/wiTECH procedure before \"\n555\t                  \"returning the car; not independently verified against \"\n556\t                  \"a Stelvio-specific source this pass.\"],\n557\t)\n558\t\n559\t_item(\n560\t    \"intake_boost_hoses_inspect\", \"Intake / boost hoses (inspect)\", \"engine\",\n561\t    interval_confidence=UNKNOWN,\n562\t    interval_note=(\n563\t        \"No scheduled inspection interval for the intake/boost (charge-\"\n564\t        \"air) hoses in the owner's manual -- inspection is symptom-driven \"\n565\t        \"(underboost DTCs such as P0299/P0236, a whistling/whooshing \"\n566\t        \"noise, boost coming in later in the rev range). \"\n567\t        + TECHAUTHORITY),\n568\t    parts=[_part(\n569\t        name=\"Turbo-to-intercooler hose (a commonly cited failure point \"\n570\t             \"on this engine family)\",\n571\t        part_number=\"00500536260\", confidence=SINGLE_SOURCE,\n572\t        source=\"https://www.go-parts.com/garage/engine-intake-manifold-alfa-romeo-stelvio-quadrifoglio-alfa-romeo-giulia-2017-2024\",\n573\t        notes=\"Single aftermarket-parts-vendor article; plastic/rubber \"\n574\t              \"charge pipes on this engine are reported prone to cracking \"\n575\t              \"from heat and vibration. Not cross-checked against a Mopar \"\n576\t              \"listing this pass.\")],\n577\t    checks=[\"Flex/scrunch-test each hose by hand for cracks or soft \"\n578\t            \"spots\", \"Smoke test if a leak is suspected but not visible\",\n579\t            \"Clamp tightness at each joint\"],\n580\t)\n581\t\n582\t_item(\n583\t    \"washer_fluid\", \"Washer fluid\", \"fluids\",\n584\t    interval_miles=600, interval_km=1000, interval_months=1,\n585\t    interval_confidence=CONFIRMED, interval_source=OM_URL,\n586\t    interval_note=(\n587\t        \"Owner's manual 'Periodic Checks': check and top off windshield \"\n588\t        \"washer fluid level every month or every 600 miles (1,000 km) or \"\n589\t        \"before long trips. This is a TOP-OFF check, not a 'change' \"\n590\t        \"interval -- washer fluid is not periodically drained/replaced.\"),\n591\t    fluid=_fluid(\n592\t        spec=\"CUNA NC 956-11, FCA spec MS.90043; usable diluted or \"\n593\t             \"undiluted\", capacity=4.1, unit=\"L\", confidence=CONFIRMED,\n594\t        source=OM_URL,\n595\t        notes=\"Owner's manual 'Fluid Capacities' (1.1 US gal / 4.1 L) and \"\n596\t              \"'Fluids And Lubricants' (spec MS.90043) tables.\"),\n597\t    checks=[\"Reservoir level\", \"Nozzle spray pattern/aim\",\n598\t            \"Headlight washer operation, if equipped\"],\n599\t    post_service=[\"None.\"],\n600\t)\n601\t\n602\t_item(\n603\t    \"a_c_cabin_service\", \"A/C system / cabin service (R-1234yf)\", \"fluids\",\n604\t    interval_months=12, interval_confidence=CONFIRMED, interval_source=OM_URL,\n605\t    interval_note=(\n606\t        \"Owner's manual: 'To ensure the best possible performance, the \"\n607\t        \"air conditioning system must be checked and undergo maintenance \"\n608\t        \"at an authorized dealer at the beginning of the summer.' Annual, \"\n609\t        \"seasonal -- no mileage figure. The manual also warns not to use \"\n610\t        \"chemicals to clean the A/C system (may damage internal \"\n611\t        \"components, not covered by warranty) and to use only approved \"\n612\t        \"refrigerants/compressor lubricants.\"),\n613\t    fluid=_fluid(\n614\t        spec=\"R-1234yf refrigerant only -- NEVER R-134a or R-12, which \"\n615\t             \"are incompatible with this system's components\",\n616\t        capacity=535, unit=\"g\", confidence=CORROBORATED,\n617\t        source=\"https://top-refrigerants.com/en/r134a-r1234yf-vehicle-refrigerant-quantity-table\",\n618\t        notes=\"Refrigerant TYPE (R-1234yf) is CONFIRMED directly from the \"\n619\t              \"owner's manual's 'Fluids And Lubricants' table, which \"\n620\t              \"lists no charge weight. Charge weight (535 +/-20 g) is \"\n621\t              \"from an industry refrigerant-quantity reference (chassis \"\n622\t              \"code 949, MY 12.16 on), corroborated by a second \"\n623\t              \"aggregator (originaldiag.com) independently citing ~530 g \"\n624\t              \"-- neither is an FCA document, so this is CORROBORATED at \"\n625\t              \"the aggregator level, not CONFIRMED. Verify against the \"\n626\t              \"underhood A/C system label on this specific car before \"\n627\t              \"charging. Compressor oil type/amount not sourced this \"\n628\t              \"pass.\"),\n629\t    checks=[\"Cooling performance / vent temperature\",\n630\t            \"Refrigerant charge (dealer evacuate-and-weigh, not a sight \"\n631\t            \"glass)\",\n632\t            \"Cabin/pollen filter condition -- often serviced together, \"\n633\t            \"see the cabin_air_filter item\"],\n634\t    notes=\"Compressor oil type/amount not sourced this pass -- confirm \"\n635\t          \"via TechAuthority before opening the system.\",\n636\t)\n637\t\n638\t_item(\n639\t    \"power_steering\", \"Power steering (EPS)\", \"fluids\",\n640\t    interval_confidence=CONFIRMED, interval_source=OM_URL,\n641\t    interval_note=(\n642\t        \"Owner's manual 'Technical Specifications > Steering' states: \"\n643\t        \"'Rack and pinion with electric power steering.' No power-\"\n644\t        \"steering-fluid entry appears anywhere in the 'Fluids And \"\n645\t        \"Lubricants' or 'Fluid Capacities' tables (contrast with the \"\n646\t        \"brake/coolant/washer-fluid rows, which ARE listed there). THERE \"\n647\t        \"IS NO HYDRAULIC POWER-STEERING FLUID ON THIS CAR -- do not add \"\n648\t        \"or attempt to bleed one. The Enhanced Accident Response System \"\n649\t        \"procedure's own step, 'Cut off battery power to the ... Electric \"\n650\t        \"power steering', further confirms it is electrically, not \"\n651\t        \"hydraulically, actuated. No scheduled maintenance item -- \"\n652\t        \"deliberately no interval_miles/km/months here.\"),\n653\t    checks=[\"EPS-related warning lights/DTCs -- steering assist is tied \"\n654\t            \"to 12V system health; a weak/failing battery has been \"\n655\t            \"reported (stelvioforum) to cause intermittent 'power \"\n656\t            \"steering disabled' warnings on this platform\"],\n657\t    notes=\"Listed for completeness since 'power steering fluid' is \"\n658\t          \"commonly and incorrectly assumed to be a serviceable item on \"\n659\t          \"this car -- there is nothing to service.\",\n660\t)\n661\t\n662\t_item(\n663\t    \"hood_and_door_lubrication\", \"Hood and door hinge/latch lubrication\",\n664\t    \"body\",\n665\t    interval_miles=20000, interval_km=32000, interval_months=24,\n666\t    interval_confidence=CONFIRMED, interval_source=OM_URL,\n667\t    interval_note=(\n668\t        \"Owner's manual 'Maintenance Plan' row 'Check cleanliness of hood \"\n669\t        \"and luggage compartment locks, cleanliness and lubrication of \"\n670\t        \"linkage': mandatory at 20,000/40,000/60,000/80,000/100,000/\"\n671\t        \"120,000/140,000 miles (2/4/6/8/10/12/14 years) -- every 20,000 \"\n672\t        \"miles or 2 years. The manual's own wording covers the HOOD and \"\n673\t        \"LIFTGATE/LUGGAGE-COMPARTMENT lock linkage specifically -- it \"\n674\t        \"does NOT separately call out DOOR hinges/latches on this \"\n675\t        \"schedule; treat door-hinge lubrication as good practice, not a \"\n676\t        \"documented FCA interval. Under the manual's 'Heavy Usage' \"\n677\t        \"conditions (dusty roads, short cold-start trips, extended \"\n678\t        \"idling/long low-speed driving, long inactivity), this check is \"\n679\t        \"called out to be done 'more often than indicated in the \"\n680\t        \"Scheduled Servicing Plan' with no specific alternate mileage \"\n681\t        \"given.\"),\n682\t    procedure=[\"Clean the hood and liftgate/luggage-compartment lock \"\n683\t               \"mechanisms and strikers.\",\n684\t               \"Apply a light machine oil or lithium grease to the lock \"\n685\t               \"linkage and hinges (specific product not called out by \"\n686\t               \"the owner's manual).\",\n687\t               \"Cycle the hood/liftgate through several full open/close \"\n688\t               \"cycles to work lubricant into the mechanism.\"],\n689\t    checks=[\"Lock/latch operation (full engagement, no double-pull)\",\n690\t            \"Hinge squeak or binding\", \"Corrosion at the striker or \"\n691\t            \"latch\"],\n692\t    post_service=[\"None.\"],\n693\t    notes=\"See interval_note for the hood/liftgate-vs-door-hinge scope \"\n694\t          \"caveat -- door hinges specifically are not this manual's own \"\n695\t          \"documented item.\",\n696\t)\n697\t\n698\t\n699\tdef item(key: str) -> dict[str, Any]:\n700\t    \"\"\"Return the item dict for ``key``. Raises ``KeyError`` if unknown.\"\"\"\n701\t    return dict(ITEMS[key])\n702\t\n703\t\n704\tdef items_by_category() -> dict[str, list[dict[str, Any]]]:\n705\t    \"\"\"All items grouped by category, each group in ``ITEM_ORDER`` order.\"\"\"\n706\t    out: dict[str, list[dict[str, Any]]] = {c: [] for c in CATEGORIES}\n707\t    for key in ITEM_ORDER:\n708\t        row = ITEMS[key]\n709\t        out[row[\"category\"]].append(dict(row))\n710\t    return out\n711\t\n712\t\n713\t__all__ = [\n714\t    \"CONFIRMED\", \"CORROBORATED\", \"SINGLE_SOURCE\", \"UNKNOWN\",\n715\t    \"CONFIDENCE_LEVELS\", \"TECHAUTHORITY\", \"VEHICLE\", \"CATEGORIES\",\n716\t    \"REQUIRED_KEYS\", \"ITEM_ORDER\", \"ITEMS\", \"item\", \"items_by_category\",\n717\t]\n718\t"}]},"uuid":"b1bfee0b-edb2-437d-bcb6-b222fc85474b","timestamp":"2026-10-08T00:08:30.339Z","toolUseResult":{"type":"text","file":{"filePath":"C:\\Users\\User\\mcp-servers\\mes-log-mcp\\mes\\maintenance_specs.py","content":"\"\"\"Reference data: 2018 Alfa Romeo Stelvio 2.0T (US) routine maintenance items.\n\nRead-only reference data -- nothing here touches the corpus or the car. It\nis the maintenance-item counterpart to ``mes.service_specs`` (torques,\noil/brakes ledger specs) and ``mes.drivetrain_specs`` (ZF 8HP/Q4/differential\ndeep dive): this module covers the recurring, mostly-owner-schedule items\n(filters, spark plugs, coolant, brake fluid, belts, battery, wipers, fuel\nfilter, PCV, throttle body, boost hoses, washer fluid, A/C service, power\nsteering, hood/door lubrication).\n\nConfidence levels (never invented -- an absent value is recorded as\nUNKNOWN, never guessed):\n\n* ``CONFIRMED``     -- an actual manufacturer document (owner's manual,\n                       Mopar/FCA parts catalog, FCA/Alfa service\n                       information, TechAuthority excerpt).\n* ``CORROBORATED``  -- two independent non-manufacturer sources agree.\n* ``SINGLE_SOURCE`` -- exactly one source found, not cross-checked.\n* ``UNKNOWN``       -- nothing credible found. ``value`` is ``None``, never\n                       a placeholder number -- ``notes``/``interval_note``\n                       always points at the service manual.\n\nTorque values are NOT duplicated here -- ``torque_keys`` on each item points\ninto ``mes.service_specs.TORQUES`` (e.g. ``spark_plug``) so there is exactly\none place a torque figure can drift out of date.\n\nSee ``docs/reference/STELVIO_20T_MAINTENANCE_SPECS.md`` for the\nhuman-readable writeup with the same data and full source links.\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom typing import Any, Optional\n\n# The 2018 US Stelvio owner's manual (the manufacturer document backing every\n# CONFIRMED row below unless a row says otherwise), fetched directly from\n# FCA/Mopar's own vehicle-info host. Its \"Maintenance Plan (2.0 T4 MAir\n# Engine)\" table (pp. 213-217) and \"Fluid Capacities\" / \"Fluids And\n# Lubricants\" tables (pp. 262-264) are the source for every OM_URL citation.\nOM_URL = (\"https://vehicleinfo.mopar.com/assets/publications/en-us/\"\n          \"Alfa_Romeo/2018/Stelvio/P124461_18_GU_OM_EN_USC_DIGITAL_2nd_V2.pdf\")\n\nCONFIRMED = \"CONFIRMED\"\nCORROBORATED = \"CORROBORATED\"\nSINGLE_SOURCE = \"SINGLE-SOURCE\"\nUNKNOWN = \"UNKNOWN\"\n\nCONFIDENCE_LEVELS = (CONFIRMED, CORROBORATED, SINGLE_SOURCE, UNKNOWN)\n\nTECHAUTHORITY = \"use the service manual (TechAuthority)\"\n\nVEHICLE = (\"2018 Alfa Romeo Stelvio 2.0T (GU), 2.0L GME-T4 MultiAir turbo, \"\n           \"sales code EC2, US market, Q4 AWD, ZF 8HP automatic\")\n\nCATEGORIES: tuple[str, ...] = (\n    \"engine\", \"fluids\", \"filters\", \"ignition\", \"electrical\", \"body\",\n)\n\nREQUIRED_KEYS: tuple[str, ...] = (\n    \"key\", \"label\", \"category\",\n    \"interval_miles\", \"interval_km\", \"interval_months\",\n    \"interval_note\", \"interval_confidence\", \"interval_source\",\n    \"parts\", \"fluid\", \"torque_keys\",\n    \"procedure\", \"checks\", \"post_service\", \"notes\",\n)\n\nITEM_ORDER: tuple[str, ...] = (\n    \"engine_air_filter\", \"cabin_air_filter\", \"spark_plugs\",\n    \"ignition_coils_inspect\", \"coolant\", \"brake_fluid\", \"drive_belt\",\n    \"battery_12v\", \"wipers\", \"fuel_filter\", \"pcv_system\",\n    \"throttle_body_clean\", \"intake_boost_hoses_inspect\", \"washer_fluid\",\n    \"a_c_cabin_service\", \"power_steering\", \"hood_and_door_lubrication\",\n)\n\n\nITEMS: dict[str, dict[str, Any]] = {}\n\n\ndef _part(name: Optional[str] = None, part_number: Optional[str] = None,\n          confidence: str = UNKNOWN, source: Optional[str] = None,\n          notes: str = \"\") -> dict[str, Any]:\n    if confidence not in CONFIDENCE_LEVELS:\n        raise ValueError(f\"bad confidence {confidence!r}\")\n    if not notes and confidence == UNKNOWN:\n        notes = TECHAUTHORITY\n    return {\n        \"name\": name, \"part_number\": part_number, \"confidence\": confidence,\n        \"source\": source, \"notes\": notes.strip(),\n    }\n\n\ndef _fluid(spec: Optional[str] = None, capacity: Optional[float] = None,\n           unit: Optional[str] = None, confidence: str = UNKNOWN,\n           source: Optional[str] = None, notes: str = \"\") -> dict[str, Any]:\n    if confidence not in CONFIDENCE_LEVELS:\n        raise ValueError(f\"bad confidence {confidence!r}\")\n    if not notes and confidence == UNKNOWN:\n        notes = TECHAUTHORITY\n    return {\n        \"spec\": spec, \"capacity\": capacity, \"unit\": unit,\n        \"confidence\": confidence, \"source\": source, \"notes\": notes.strip(),\n    }\n\n\ndef _item(key: str, label: str, category: str, *,\n          interval_miles: Optional[int] = None,\n          interval_km: Optional[int] = None,\n          interval_months: Optional[int] = None,\n          interval_note: str = \"\",\n          interval_confidence: str = UNKNOWN,\n          interval_source: Optional[str] = None,\n          parts: Optional[list[dict[str, Any]]] = None,\n          fluid: Optional[dict[str, Any]] = None,\n          torque_keys: Optional[list[str]] = None,\n          procedure: Optional[list[str]] = None,\n          checks: Optional[list[str]] = None,\n          post_service: Optional[list[str]] = None,\n          notes: str = \"\") -> None:\n    if category not in CATEGORIES:\n        raise ValueError(f\"bad category {category!r}\")\n    if interval_confidence not in CONFIDENCE_LEVELS:\n        raise ValueError(f\"bad confidence {interval_confidence!r}\")\n    if not interval_note and interval_confidence == UNKNOWN:\n        interval_note = TECHAUTHORITY\n    ITEMS[key] = {\n        \"key\": key,\n        \"label\": label,\n        \"category\": category,\n        \"interval_miles\": interval_miles,\n        \"interval_km\": interval_km,\n        \"interval_months\": interval_months,\n        \"interval_note\": interval_note.strip(),\n        \"interval_confidence\": interval_confidence,\n        \"interval_source\": interval_source,\n        \"parts\": parts or [],\n        \"fluid\": fluid,\n        \"torque_keys\": torque_keys or [],\n        \"procedure\": procedure or [],\n        \"checks\": checks or [],\n        \"post_service\": post_service or [],\n        \"notes\": notes.strip(),\n    }\n\n\n# --- items, in the specified order (initially UNKNOWN/None throughout;\n#     filled in by the research pass below) ---------------------------------\n\n_item(\n    \"engine_air_filter\", \"Engine air filter\", \"filters\",\n    interval_miles=30000, interval_km=48000, interval_months=36,\n    interval_confidence=CONFIRMED, interval_source=OM_URL,\n    interval_note=(\n        \"Owner's manual 'Maintenance Plan (2.0 T4 MAir Engine)' row \"\n        \"'Replace air cleaner cartridge': mandatory at 30,000/60,000/90,000/\"\n        \"120,000/150,000 miles (3/6/9/12/15 years) -- every 30,000 miles or \"\n        \"3 years, whichever comes first. Severe-duty override (footnote, \"\n        \"shared with the cabin filter): dusty-area use requires replacement \"\n        \"every 10,000 miles (16,000 km) instead.\"),\n    parts=[_part(\n        name=\"Engine air filter (2.0L, non-Quadrifoglio)\",\n        part_number=\"68301538AA\", confidence=CORROBORATED,\n        source=\"https://www.moparonlineparts.com/sku/68301538aa.html\",\n        notes=\"Cross-referenced consistently across Mopar Online Parts, \"\n              \"madnessautoworks, AW Italian Auto Parts, and aftermarket \"\n              \"equivalents (WIX WA11084, Champion CA12953, Fram XA10670, \"\n              \"PurolatorAir A11523, Premium Guard PA99467) for 2018-2020 \"\n              \"Stelvio/Giulia 2.0L non-QV. Confirm no running change for \"\n              \"later model years at a parts counter by VIN.\")],\n    procedure=[\"Release the air box clips/screws and lift the lid.\",\n               \"Note the pleated element's orientation before removing it.\",\n               \"Wipe out the air box; fit the new element the same way \"\n               \"round.\",\n               \"Reseat the lid and clips; confirm the intake duct/MAF \"\n               \"connector is fully seated.\"],\n    checks=[\"Filter element condition (oil/dust contamination -- heavy \"\n            \"oiling can point at a recent intake leak or PCV oil-\"\n            \"carryover)\", \"Air box and duct clips for cracks\"],\n    post_service=[\"None required -- no relearn/adaptation needed for an \"\n                  \"air filter change.\"],\n    notes=\"The owner's manual has no row literally labelled 'engine air \"\n          \"filter' -- this is its 'air cleaner cartridge' row.\",\n)\n\n_item(\n    \"cabin_air_filter\", \"Cabin air filter\", \"filters\",\n    interval_miles=20000, interval_km=32000, interval_months=24,\n    interval_confidence=CONFIRMED, interval_source=OM_URL,\n    interval_note=(\n        \"Owner's manual 'Replace the passenger compartment cleaner' row: \"\n        \"MANDATORY at 20,000/40,000/60,000/80,000/100,000/120,000/140,000 \"\n        \"miles (2/4/6/8/10/12/14 years) -- every 20,000 miles or 2 years. \"\n        \"RECOMMENDED (not mandatory) check/replace at the intervening \"\n        \"10,000-mile odd points (10k/30k/50k/70k/90k/110k/130k/150k). \"\n        \"Severe-duty override (same footnote as the engine air filter): \"\n        \"dusty-area use requires replacement every 10,000 miles \"\n        \"(16,000 km).\"),\n    parts=[_part(\n        name=\"Cabin air filter\", part_number=\"68444656AA\",\n        confidence=SINGLE_SOURCE,\n        source=\"https://www.moparonlineparts.com/part-model/alfa-romeo-stelvio-cabin-air-filter.html\",\n        notes=\"Three different Mopar part numbers turned up across \"\n              \"retailer listings for nominally the same 2018-2025 Stelvio \"\n              \"cabin filter -- 68444656AA, 68392124AA, and (a separate \"\n              \"search) 68320112AA -- with no documented year/trim split. \"\n              \"Confirm the correct number for this VIN at a Mopar parts \"\n              \"counter before ordering.\")],\n    procedure=[\"Locate the cabin filter housing (commonly behind the \"\n               \"glovebox on this platform).\",\n               \"Release the housing cover and slide the old filter out, \"\n               \"noting airflow-direction arrows.\",\n               \"Fit the new filter with the same orientation; reseat the \"\n               \"cover.\"],\n    checks=[\"Airflow-direction arrow orientation\", \"Debris/leaf litter in \"\n            \"the housing\", \"Musty-odor complaints (may indicate a filter \"\n            \"overdue for replacement or evaporator contamination)\"],\n    post_service=[\"None required.\"],\n    notes=\"\",\n)\n\n_item(\n    \"spark_plugs\", \"Spark plugs\", \"ignition\",\n    interval_miles=30000, interval_km=48000, interval_months=None,\n    interval_confidence=CONFIRMED, interval_source=OM_URL,\n    interval_note=(\n        \"Owner's manual 'Maintenance Plan' row 'Spark plug replacement': \"\n        \"mandatory at 30,000/60,000/90,000/120,000/150,000 miles. Its own \"\n        \"footnote: 'The spark plug change interval is mileage-based only. \"\n        \"Yearly intervals do not apply.' -- deliberately no interval_months \"\n        \"value here, not an oversight.\"),\n    parts=[_part(\n        name=\"Spark plug (2.0L, set of 4)\",\n        part_number=\"NGK 90219 (ILZKR7G7G) / Mopar 68292346AA\",\n        confidence=CORROBORATED,\n        source=\"https://www.ngk.com/ngk-90219-ilzkr7g7g-laser-iridium-spark-plug\",\n        notes=\"NGK's own listing plus multiple independent parts \"\n              \"retailers (PartsGeek, Alfa Corsa, Eurocompulsion, \"\n              \"madnessautoworks) agree on NGK 90219 / Mopar 68292346AA for \"\n              \"the 2018-2024 2.0L. Gap: NGK's own spec sheet gives \"\n              \"0.028 in (0.7 mm); a second, less authoritative listing \"\n              \"gave 0.026 in -- plugs ship pre-gapped from the factory, \"\n              \"verify with a gap tool before installing rather than \"\n              \"trusting either figure blindly.\"),\n    ],\n    torque_keys=[\"spark_plug\"],\n    procedure=[\"Remove the engine cover and disconnect each ignition coil \"\n               \"connector.\",\n               \"Remove the coil retaining bolt/screw and pull each coil \"\n               \"straight up.\",\n               \"Blow out the plug wells before removing plugs to keep \"\n               \"debris out of the cylinder.\",\n               \"Remove and inspect each plug; gap-check new plugs before \"\n               \"installing even though they ship pre-gapped.\",\n               \"Torque to spec (see mes.service_specs TORQUES['spark_plug'])\"\n               \" and reinstall coils/connectors.\"],\n    checks=[\"Electrode wear/color per cylinder (uneven wear across \"\n            \"cylinders can point at a cylinder-specific issue)\",\n            \"Thread condition in the aluminum head on removal\"],\n    post_service=[\"No relearn required. Do not add anti-seize unless the \"\n                  \"plug maker specifies it -- it changes effective seating \"\n                  \"torque on this aluminum head (see the spark_plug torque \"\n                  \"row's own notes in mes.service_specs).\"],\n    notes=\"\",\n)\n\n_item(\n    \"ignition_coils_inspect\", \"Ignition coils (inspect)\", \"ignition\",\n    interval_confidence=UNKNOWN,\n    interval_note=(\n        \"Not listed as a scheduled item anywhere in the 2018 US owner's \"\n        \"manual maintenance plan -- coils on this engine are inspected/\"\n        \"diagnosed on symptoms (misfire codes), not replaced on a fixed \"\n        \"interval. \" + TECHAUTHORITY),\n    torque_keys=[\"coil_pack_bolt\"],\n    checks=[\"Misfire/DTC history per cylinder\",\n            \"Coil boot condition and carbon tracking\",\n            \"Spark plug well for oil intrusion (a common cause of coil \"\n            \"boot arcing on MultiAir-family engines)\"],\n    procedure=[\"Disconnect the coil connector and remove its retaining \"\n               \"bolt/screw before pulling it straight up off the plug.\"],\n    notes=\"No sourced part number for this pass; do not order a coil \"\n          \"speculatively -- confirm the failing cylinder via live misfire \"\n          \"counters first.\",\n)\n\n_item(\n    \"coolant\", \"Engine coolant\", \"fluids\",\n    interval_miles=150000, interval_km=240000, interval_months=180,\n    interval_confidence=CONFIRMED, interval_source=OM_URL,\n    interval_note=(\n        \"Owner's manual 'Maintenance Plan' marks a single mandatory \"\n        \"coolant change at 150,000 miles (240,000 km) / 15 years -- a \"\n        \"long-life OAT fill, not a periodic service item at normal \"\n        \"intervals. The monthly/600-mile 'Periodic Checks' item is a \"\n        \"level/top-off check only, not a change.\"),\n    fluid=_fluid(\n        spec=\"FCA/Alfa MS.90032 (CUNA NC956-16, ASTM D3306) OAT coolant, \"\n             \"used at 50% concentration; NOT mixable with different-\"\n             \"formulation coolants; a 60% product / 40% distilled-water \"\n             \"mix is recommended for particularly harsh climates\",\n        capacity=8.8, unit=\"L\", confidence=CONFIRMED, source=OM_URL,\n        notes=\"Owner's manual 'Fluid Capacities' table: engine cooling \"\n              \"system 2.3 US gal / 8.8 L. This is the ENGINE circuit only \"\n              \"-- the water-cooled intercooler on this turbo engine has \"\n              \"its OWN separate cooling circuit at 1.4 US gal / 5.25 L, \"\n              \"not included in this figure. Independently, stelvioforum/\"\n              \"Petronas Paraflu UP threads name the same MS.90032 spec, \"\n              \"corroborating spec identity even though the manual is now \"\n              \"the primary CONFIRMED source for both spec and capacity.\"),\n    torque_keys=[],\n    checks=[\"Level at the engine coolant reservoir (MIN/MAX)\",\n            \"Level at the SEPARATE intercooler coolant reservoir\",\n            \"Condition/color for contamination or oil intrusion\"],\n    procedure=[\"Recover coolant into a clean container if reusing.\",\n               \"Drain the engine circuit (drain point/plug not sourced \"\n               \"this pass -- see notes).\",\n               \"Refill with MS.90032-spec coolant only; do not mix \"\n               \"formulations.\",\n               \"Bleed per the correct procedure for this engine (not \"\n               \"sourced this pass) and verify final level cold.\"],\n    post_service=[\"No relearn needed. No sourced bleed procedure or \"\n                  \"drain-plug location for the 2.0T engine circuit this \"\n                  \"pass -- \" + TECHAUTHORITY],\n    notes=\"Remember the intercooler circuit is a SEPARATE fill/bleed from \"\n          \"the engine circuit on this engine.\",\n)\n\n_item(\n    \"brake_fluid\", \"Brake fluid\", \"fluids\",\n    interval_months=24, interval_confidence=CONFIRMED, interval_source=OM_URL,\n    interval_note=(\n        \"Owner's manual footnote on the Maintenance Plan: 'The brake fluid \"\n        \"replacement has to be done every two years, irrespective of the \"\n        \"mileage.' No mileage bullet/mark appears in the table for this \"\n        \"row -- it is purely calendar-based. This is a firmer source than \"\n        \"mes.service_specs.BRAKE_SPEC['fluid_change_interval'], which is \"\n        \"still recorded there as SINGLE-SOURCE forum-only; that module is \"\n        \"out of scope for this pass and has not been updated to match.\"),\n    fluid=_fluid(\n        spec=\"DOT 4, FCA spec MS.90039\", capacity=0.9, unit=\"L\",\n        confidence=CONFIRMED, source=OM_URL,\n        notes=\"Owner's manual 'Fluids And Lubricants' table gives DOT 4 / \"\n              \"MS.90039 explicitly. 'Fluid Capacities' table gives the \"\n              \"hydraulic brake circuit at 0.9 US qt / 0.9 L -- reservoir + \"\n              \"lines, not a drain-and-refill service quantity.\"),\n    torque_keys=[],\n    checks=[\"Fluid color/clarity\", \"Moisture content if a test kit is \"\n            \"available\", \"Reservoir level vs MIN/MAX -- also monitored by \"\n            \"the INSUFFICIENT BRAKE FLUID/ELECTRIC PARK BRAKE telltale per \"\n            \"the owner's manual\"],\n    post_service=[\"Bleed all four corners plus the ABS/ESC modulator. On \"\n                  \"EPB-equipped rear calipers, put the EPB into service \"\n                  \"mode before disturbing the rear circuit -- see \"\n                  \"mes.service_specs.BRAKE_SPEC['epb_service_mode'].\"],\n)\n\n_item(\n    \"drive_belt\", \"Drive (serpentine) belt\", \"engine\",\n    interval_miles=36000, interval_km=60000, interval_months=48,\n    interval_confidence=CONFIRMED, interval_source=OM_URL,\n    interval_note=(\n        \"Owner's manual footnote on the Maintenance Plan: non-dusty areas, \"\n        \"recommended max 36,000 miles (60,000 km), and regardless of \"\n        \"mileage replace every 4 years. Dusty/demanding use (cold \"\n        \"climates, town use, long periods of idling): advised max 18,000 \"\n        \"miles (30,000 km), replace every 2 years regardless of mileage. \"\n        \"This item's interval_miles/interval_km/interval_months record the \"\n        \"NORMAL-duty figure; treat 18,000 mi / 30,000 km / 24 months as \"\n        \"the floor for a car used hard.\"),\n    parts=[_part(\n        name=\"Accessory (serpentine) drive belt\", part_number=\"68326261AA\",\n        confidence=SINGLE_SOURCE,\n        source=\"https://awitalian.com/product/alfa-romeo-giulia-stelvio-serpentine-drive-belt-68326261aa/\",\n        notes=\"Single aftermarket-retailer listing for the 2018-2022 2.0L; \"\n              \"not cross-checked against a second retailer or a \"\n              \"Mopar-direct listing this pass.\")],\n    checks=[\"Visible cracking, glazing, or fraying\",\n            \"Tensioner/idler pulley play and noise\",\n            \"Correct routing per the underhood belt-routing decal\"],\n    procedure=[\"Relieve the tensioner (per the underhood routing decal) \"\n               \"and slip the belt off the accessory pulleys.\",\n               \"Inspect the tensioner and idler pulleys for play/noise \"\n               \"before reusing them.\",\n               \"Route the new belt per the decal; release the tensioner \"\n               \"slowly onto the belt.\"],\n    post_service=[\"None required.\"],\n)\n\n_item(\n    \"battery_12v\", \"12V battery\", \"electrical\",\n    interval_miles=10000, interval_km=16000, interval_months=12,\n    interval_confidence=CONFIRMED, interval_source=OM_URL,\n    interval_note=(\n        \"Owner's manual 'Maintenance Plan' row 'Check battery charge \"\n        \"status with the proper instrument' is MANDATORY at every one of \"\n        \"the 10,000-mile/1-year columns -- i.e. every service visit. \"\n        \"Outright battery REPLACEMENT has no fixed FCA interval -- it is \"\n        \"condition/age driven (load-test failure), not scheduled.\"),\n    parts=[_part(\n        name=\"12V battery (factory-fit EFB standard; AGM on some builds/\"\n             \"replacements; BCI Group 94R / H7)\",\n        part_number=\"Mopar BBH8A001AA (AGM, reported to cross to Group \"\n                     \"94R)\",\n        confidence=SINGLE_SOURCE,\n        source=\"https://www.stelvioforum.com/threads/mopar-replacement-battery.9201/\",\n        notes=\"Group-size naming is inconsistent across sources (94R vs \"\n              \"H7 vs 49/H8 all used loosely by different posters for what \"\n              \"is described as the same physical battery) -- confirm \"\n              \"physical dimensions/terminal layout against the battery \"\n              \"actually fitted before ordering, not just a group code. If \"\n              \"the car left the factory with AGM (Start/Stop-equipped), \"\n              \"do not downgrade to a plain flooded/EFB battery on \"\n              \"replacement.\")],\n    torque_keys=[\"battery_terminal\", \"battery_hold_down\"],\n    checks=[\"Charge status/state of health with a proper tester (owner's \"\n            \"manual wording)\", \"Terminal corrosion/tightness\",\n            \"Hold-down clamp secure\"],\n    post_service=[\n        \"No explicit 'register battery replacement' procedure was found \"\n        \"for this platform: a stelvioforum thread ('Register Battery \"\n        \"Replacement') reports MES/wiTECH have no such function here \"\n        \"(unlike some other FCA-group platforms) -- the charging-system \"\n        \"monitor recalibrates itself over a period of hours after \"\n        \"reconnection, with no separate registration step to run.\",\n        \"After any battery disconnect, expect to reset the clock and \"\n        \"re-run any one-touch window/sunroof auto-up/down \"\n        \"initialization.\",\n    ],\n    notes=(\n        \"CORRECTION to the common assumption of a main+auxiliary battery \"\n        \"pair on Start/Stop cars: research this pass (alfaowner.com \"\n        \"'second battery location'; giuliaforums.com 'is there really a \"\n        \"separate battery for start/stop') found this platform uses a \"\n        \"SINGLE 12V battery (trunk-mounted, under the floor panel) for \"\n        \"both normal electrical loads and the Start/Stop system -- no \"\n        \"second/auxiliary battery is documented for the Stelvio. If a \"\n        \"specific VIN is found to have one, that is new information to \"\n        \"update here, not something to assume. Also note: this vehicle's \"\n        \"own owner's manual uses the acronym 'IBS' for the unrelated \"\n        \"'Integrated Brake System' -- do not confuse that with an \"\n        \"'Intelligent Battery Sensor', a term used loosely for this kind \"\n        \"of battery-monitor topic on other platforms but not confirmed to \"\n        \"apply here by name.\"\n    ),\n)\n\n_item(\n    \"wipers\", \"Wiper blades\", \"body\",\n    interval_months=12, interval_confidence=CONFIRMED, interval_source=OM_URL,\n    interval_note=(\n        \"Owner's manual: 'The life of the windshield wiper blades varies \"\n        \"according to the usage frequency. In any case, it is advised to \"\n        \"replace the blades approximately once a year.' No mileage figure \"\n        \"given.\"),\n    parts=[\n        _part(name=\"Front wiper blades (driver 26in/660mm, passenger \"\n                    \"18in/460mm)\",\n              part_number=None, confidence=CORROBORATED,\n              source=\"https://autopadre.com/wiper-size/alfa-romeo-stelvio\",\n              notes=\"Sizes corroborated across multiple independent \"\n                    \"wiper-fitment databases (autopadre, \"\n                    \"windshieldwipers.com, allwipersize.com, \"\n                    \"wipersizechart.com) for 2018-2026. No confidently-\"\n                    \"sourced Mopar OEM part number found this pass -- \"\n                    \"candidates seen (68462474AA, 68357040AA) were listed \"\n                    \"for a REAR wiper arm/blade assembly, not the front \"\n                    \"blades, and were not clearly confirmed for this \"\n                    \"model year. Confirm at a parts counter by VIN.\"),\n        _part(name=\"Rear wiper blade (13in/330mm)\",\n              part_number=None, confidence=CORROBORATED,\n              source=\"https://autopadre.com/wiper-size/alfa-romeo-stelvio\",\n              notes=\"Same corroboration as the front blades. \"\n                    \"68462474AA/68357040AA were seen for a rear wiper arm/\"\n                    \"blade listing but not confirmed for this VIN's model \"\n                    \"year -- confirm before ordering.\"),\n    ],\n    checks=[\"Blade edge for cracking/tearing\", \"Chatter/streaking/noise\",\n            \"Rain-sensor auto-wipe operation\"],\n    procedure=[\"Activate the windshield-wiper 'service position' function \"\n               \"(owner's manual) before replacing blades for easier \"\n               \"access.\",\n               \"Release the hook/pinch-tab retainer per blade type and \"\n               \"slide the old blade off the arm.\",\n               \"Fit the new blade until it clicks/locks; lower the arm \"\n               \"back onto the glass.\"],\n    post_service=[\"None.\"],\n)\n\n_item(\n    \"fuel_filter\", \"Fuel filter\", \"filters\",\n    interval_confidence=CORROBORATED,\n    interval_source=\"https://www.stelvioforum.com/threads/fuel-filter.10613/\",\n    interval_note=(\n        \"No separate serviceable fuel filter on the US gas 2.0T: forum \"\n        \"consensus (independent stelvioforum threads 'Fuel Filter' and \"\n        \"'Fuel Filter Service') describes an in-tank fuel filter 'sock' \"\n        \"integrated into the fuel pump module -- non-serviceable except by \"\n        \"replacing the whole module, and with no scheduled replacement \"\n        \"interval. This is corroborated by the owner's manual itself, \"\n        \"which lists a SEPARATE maintenance-plan row, 'Replace the \"\n        \"additional fuel filter (if equipped)', mandatory every 10,000 \"\n        \"miles -- the 'if equipped' phrasing implies that additional, \"\n        \"serviceable filter is NOT fitted to every variant, and nothing \"\n        \"in this research pass found evidence the US gas 2.0T carries it. \"\n        \"Deliberately no interval_miles/km/months here -- this is a \"\n        \"lifetime, non-serviceable-on-schedule item as best \"\n        \"established, not an unresearched gap.\"),\n    notes=\"Do not confuse this with the owner's manual's own 'additional \"\n          \"fuel filter (if equipped)' row -- if a specific VIN is \"\n          \"confirmed to have that filter fitted, its interval is every \"\n          \"10,000 miles per the manual, which would supersede the note \"\n          \"above for that car.\",\n)\n\n_item(\n    \"pcv_system\", \"PCV (crankcase ventilation) system\", \"engine\",\n    interval_confidence=UNKNOWN,\n    interval_note=(\n        \"Not listed in the owner's manual maintenance plan -- no \"\n        \"scheduled interval; PCV components on this engine are treated as \"\n        \"inspect/replace-on-failure (oil consumption, rough idle, \"\n        \"crankcase-pressure DTCs). \" + TECHAUTHORITY),\n    parts=[_part(\n        name=\"PCV valve/housing\", part_number=\"04893610AC\",\n        confidence=SINGLE_SOURCE,\n        source=\"https://www.alfaromeofiatpartsusa.com/oem-parts/mopar-genuine-oem-pcv-valve-alfa-romeo-giulia-stelvio-jeep-dodge-hornet-wrangler-compass-cherokee-4893610ac\",\n        notes=\"Listed as a shared Mopar part across Giulia/Stelvio 2.0L \"\n              \"(2018-2026) plus several Jeep/Dodge products -- plausible \"\n              \"for a corporate-parts-bin PCV valve, but not independently \"\n              \"cross-checked against a second retailer this pass. Do NOT \"\n              \"use 68324751AA -- that is the 2.9L V6 (Quadrifoglio) PCV \"\n              \"valve and housing, a different part for a different \"\n              \"engine.\")],\n    checks=[\"Oil residue/oil consumption pointing at PCV oil-carryover\",\n            \"Rough/unstable idle or a lean DTC that could indicate a \"\n            \"stuck-open valve or a split hose\",\n            \"Crankcase breather hose condition\"],\n)\n\n_item(\n    \"throttle_body_clean\", \"Throttle body cleaning\", \"engine\",\n    interval_confidence=UNKNOWN,\n    interval_note=(\n        \"No scheduled throttle-body-cleaning interval in the owner's \"\n        \"manual -- this engine's factory maintenance plan does not list \"\n        \"it. Aftermarket/forum guidance around 60,000 miles, or 'clean if \"\n        \"symptomatic' (hesitation, carbon buildup), was found but not \"\n        \"traced to a specific, checkable source -- treat as unsourced \"\n        \"shop practice, not an OEM figure. \" + TECHAUTHORITY),\n    checks=[\"Idle quality / hesitation complaints\",\n            \"Visible carbon on the throttle plate and bore\"],\n    post_service=[\"An electronic throttle body relearn/adaptation is \"\n                  \"commonly required after cleaning or replacing the \"\n                  \"throttle body on Alfa Romeo platforms generally -- \"\n                  \"confirm the exact MES/wiTECH procedure before \"\n                  \"returning the car; not independently verified against \"\n                  \"a Stelvio-specific source this pass.\"],\n)\n\n_item(\n    \"intake_boost_hoses_inspect\", \"Intake / boost hoses (inspect)\", \"engine\",\n    interval_confidence=UNKNOWN,\n    interval_note=(\n        \"No scheduled inspection interval for the intake/boost (charge-\"\n        \"air) hoses in the owner's manual -- inspection is symptom-driven \"\n        \"(underboost DTCs such as P0299/P0236, a whistling/whooshing \"\n        \"noise, boost coming in later in the rev range). \"\n        + TECHAUTHORITY),\n    parts=[_part(\n        name=\"Turbo-to-intercooler hose (a commonly cited failure point \"\n             \"on this engine family)\",\n        part_number=\"00500536260\", confidence=SINGLE_SOURCE,\n        source=\"https://www.go-parts.com/garage/engine-intake-manifold-alfa-romeo-stelvio-quadrifoglio-alfa-romeo-giulia-2017-2024\",\n        notes=\"Single aftermarket-parts-vendor article; plastic/rubber \"\n              \"charge pipes on this engine are reported prone to cracking \"\n              \"from heat and vibration. Not cross-checked against a Mopar \"\n              \"listing this pass.\")],\n    checks=[\"Flex/scrunch-test each hose by hand for cracks or soft \"\n            \"spots\", \"Smoke test if a leak is suspected but not visible\",\n            \"Clamp tightness at each joint\"],\n)\n\n_item(\n    \"washer_fluid\", \"Washer fluid\", \"fluids\",\n    interval_miles=600, interval_km=1000, interval_months=1,\n    interval_confidence=CONFIRMED, interval_source=OM_URL,\n    interval_note=(\n        \"Owner's manual 'Periodic Checks': check and top off windshield \"\n        \"washer fluid level every month or every 600 miles (1,000 km) or \"\n        \"before long trips. This is a TOP-OFF check, not a 'change' \"\n        \"interval -- washer fluid is not periodically drained/replaced.\"),\n    fluid=_fluid(\n        spec=\"CUNA NC 956-11, FCA spec MS.90043; usable diluted or \"\n             \"undiluted\", capacity=4.1, unit=\"L\", confidence=CONFIRMED,\n        source=OM_URL,\n        notes=\"Owner's manual 'Fluid Capacities' (1.1 US gal / 4.1 L) and \"\n              \"'Fluids And Lubricants' (spec MS.90043) tables.\"),\n    checks=[\"Reservoir level\", \"Nozzle spray pattern/aim\",\n            \"Headlight washer operation, if equipped\"],\n    post_service=[\"None.\"],\n)\n\n_item(\n    \"a_c_cabin_service\", \"A/C system / cabin service (R-1234yf)\", \"fluids\",\n    interval_months=12, interval_confidence=CONFIRMED, interval_source=OM_URL,\n    interval_note=(\n        \"Owner's manual: 'To ensure the best possible performance, the \"\n        \"air conditioning system must be checked and undergo maintenance \"\n        \"at an authorized dealer at the beginning of the summer.' Annual, \"\n        \"seasonal -- no mileage figure. The manual also warns not to use \"\n        \"chemicals to clean the A/C system (may damage internal \"\n        \"components, not covered by warranty) and to use only approved \"\n        \"refrigerants/compressor lubricants.\"),\n    fluid=_fluid(\n        spec=\"R-1234yf refrigerant only -- NEVER R-134a or R-12, which \"\n             \"are incompatible with this system's components\",\n        capacity=535, unit=\"g\", confidence=CORROBORATED,\n        source=\"https://top-refrigerants.com/en/r134a-r1234yf-vehicle-refrigerant-quantity-table\",\n        notes=\"Refrigerant TYPE (R-1234yf) is CONFIRMED directly from the \"\n              \"owner's manual's 'Fluids And Lubricants' table, which \"\n              \"lists no charge weight. Charge weight (535 +/-20 g) is \"\n              \"from an industry refrigerant-quantity reference (chassis \"\n              \"code 949, MY 12.16 on), corroborated by a second \"\n              \"aggregator (originaldiag.com) independently citing ~530 g \"\n              \"-- neither is an FCA document, so this is CORROBORATED at \"\n              \"the aggregator level, not CONFIRMED. Verify against the \"\n              \"underhood A/C system label on this specific car before \"\n              \"charging. Compressor oil type/amount not sourced this \"\n              \"pass.\"),\n    checks=[\"Cooling performance / vent temperature\",\n            \"Refrigerant charge (dealer evacuate-and-weigh, not a sight \"\n            \"glass)\",\n            \"Cabin/pollen filter condition -- often serviced together, \"\n            \"see the cabin_air_filter item\"],\n    notes=\"Compressor oil type/amount not sourced this pass -- confirm \"\n          \"via TechAuthority before opening the system.\",\n)\n\n_item(\n    \"power_steering\", \"Power steering (EPS)\", \"fluids\",\n    interval_confidence=CONFIRMED, interval_source=OM_URL,\n    interval_note=(\n        \"Owner's manual 'Technical Specifications > Steering' states: \"\n        \"'Rack and pinion with electric power steering.' No power-\"\n        \"steering-fluid entry appears anywhere in the 'Fluids And \"\n        \"Lubricants' or 'Fluid Capacities' tables (contrast with the \"\n        \"brake/coolant/washer-fluid rows, which ARE listed there). THERE \"\n        \"IS NO HYDRAULIC POWER-STEERING FLUID ON THIS CAR -- do not add \"\n        \"or attempt to bleed one. The Enhanced Accident Response System \"\n        \"procedure's own step, 'Cut off battery power to the ... Electric \"\n        \"power steering', further confirms it is electrically, not \"\n        \"hydraulically, actuated. No scheduled maintenance item -- \"\n        \"deliberately no interval_miles/km/months here.\"),\n    checks=[\"EPS-related warning lights/DTCs -- steering assist is tied \"\n            \"to 12V system health; a weak/failing battery has been \"\n            \"reported (stelvioforum) to cause intermittent 'power \"\n            \"steering disabled' warnings on this platform\"],\n    notes=\"Listed for completeness since 'power steering fluid' is \"\n          \"commonly and incorrectly assumed to be a serviceable item on \"\n          \"this car -- there is nothing to service.\",\n)\n\n_item(\n    \"hood_and_door_lubrication\", \"Hood and door hinge/latch lubrication\",\n    \"body\",\n    interval_miles=20000, interval_km=32000, interval_months=24,\n    interval_confidence=CONFIRMED, interval_source=OM_URL,\n    interval_note=(\n        \"Owner's manual 'Maintenance Plan' row 'Check cleanliness of hood \"\n        \"and luggage compartment locks, cleanliness and lubrication of \"\n        \"linkage': mandatory at 20,000/40,000/60,000/80,000/100,000/\"\n        \"120,000/140,000 miles (2/4/6/8/10/12/14 years) -- every 20,000 \"\n        \"miles or 2 years. The manual's own wording covers the HOOD and \"\n        \"LIFTGATE/LUGGAGE-COMPARTMENT lock linkage specifically -- it \"\n        \"does NOT separately call out DOOR hinges/latches on this \"\n        \"schedule; treat door-hinge lubrication as good practice, not a \"\n        \"documented FCA interval. Under the manual's 'Heavy Usage' \"\n        \"conditions (dusty roads, short cold-start trips, extended \"\n        \"idling/long low-speed driving, long inactivity), this check is \"\n        \"called out to be done 'more often than indicated in the \"\n        \"Scheduled Servicing Plan' with no specific alternate mileage \"\n        \"given.\"),\n    procedure=[\"Clean the hood and liftgate/luggage-compartment lock \"\n               \"mechanisms and strikers.\",\n               \"Apply a light machine oil or lithium grease to the lock \"\n               \"linkage and hinges (specific product not called out by \"\n               \"the owner's manual).\",\n               \"Cycle the hood/liftgate through several full open/close \"\n               \"cycles to work lubricant into the mechanism.\"],\n    checks=[\"Lock/latch operation (full engagement, no double-pull)\",\n            \"Hinge squeak or binding\", \"Corrosion at the striker or \"\n            \"latch\"],\n    post_service=[\"None.\"],\n    notes=\"See interval_note for the hood/liftgate-vs-door-hinge scope \"\n          \"caveat -- door hinges specifically are not this manual's own \"\n          \"documented item.\",\n)\n\n\ndef item(key: str) -> dict[str, Any]:\n    \"\"\"Return the item dict for ``key``. Raises ``KeyError`` if unknown.\"\"\"\n    return dict(ITEMS[key])\n\n\ndef items_by_category() -> dict[str, list[dict[str, Any]]]:\n    \"\"\"All items grouped by category, each group in ``ITEM_ORDER`` order.\"\"\"\n    out: dict[str, list[dict[str, Any]]] = {c: [] for c in CATEGORIES}\n    for key in ITEM_ORDER:\n        row = ITEMS[key]\n        out[row[\"category\"]].append(dict(row))\n    return out\n\n\n__all__ = [\n    \"CONFIRMED\", \"CORROBORATED\", \"SINGLE_SOURCE\", \"UNKNOWN\",\n    \"CONFIDENCE_LEVELS\", \"TECHAUTHORITY\", \"VEHICLE\", \"CATEGORIES\",\n    \"REQUIRED_KEYS\", \"ITEM_ORDER\", \"ITEMS\", \"item\", \"items_by_category\",\n]\n","numLines":718,"startLine":1,"totalLines":718}},"sourceToolAssistantUUID":"0e87496b-7715-4052-917f-400b2c10484f","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
{"parentUuid":"b1bfee0b-edb2-437d-bcb6-b222fc85474b","isSidechain":true,"agentId":"a1dcd2d766be47a9a","message":{"model":"claude-sonnet-5","id":"msg_011CfooB5rPnc2guRZ2m5PnB","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01Dv4mAGApZqeB2MWw73mSSe","name":"Read","input":{"file_path":"C:\\Users\\User\\mcp-servers\\mes-log-mcp\\mes\\drivetrain_specs.py"},"caller":{"type":"direct"}}],"container":null,"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":3673,"cache_read_input_tokens":81752,"output_tokens":1176,"output_tokens_details":{"thinking_tokens":934},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":0,"ephemeral_5m_input_tokens":3673},"inference_geo":"not_available","iterations":[{"input_tokens":2,"output_tokens":1176,"cache_read_input_tokens":81752,"cache_creation_input_tokens":3673,"cache_creation":{"ephemeral_5m_input_tokens":3673,"ephemeral_1h_input_tokens":0},"type":"message"}],"speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_01Dv4mAGApZqeB2MWw73mSSe":{"file_path":"C:\\Users\\User\\mcp-servers\\mes-log-mcp\\mes\\drivetrain_specs.py"}},"serverClassifierRequest":"f023dab9-613a-4d97-a124-dcac6e98d1f8","apiBlockIndex":3,"requestId":"req_011CfooB5YHJWz16nk8jQNx5","attributionAgent":"general-purpose","type":"assistant","uuid":"6adcf8e1-a724-4deb-a3aa-2b493388c6d3","timestamp":"2026-10-08T00:08:30.471Z","effort":"high","perTurnEffort":null,"userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
{"parentUuid":"6adcf8e1-a724-4deb-a3aa-2b493388c6d3","isSidechain":true,"promptId":"01b24783-2d87-4e75-9b89-4a104a7211fd","agentId":"a1dcd2d766be47a9a","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Dv4mAGApZqeB2MWw73mSSe","type":"tool_result","content":"1\t\"\"\"Stelvio 2.0T (GU) drivetrain specs and torques -- pure stdlib data module.\n2\t\n3\tCompanion data to ``docs/reference/STELVIO_20T_DRIVETRAIN_SPECS.md``; read that\n4\tfile for prose, full sourcing detail and the \"what is UNKNOWN\" summary. Every\n5\trow here mirrors a row in that document.\n6\t\n7\tShape note\n8\t----------\n9\t``mes-log-mcp/mes/service_specs.py`` (the general oil-change / brakes /\n10\tsuspension torque ledger, written by another agent) existed by the time this\n11\tmodule was finished, so the ``TORQUES`` row shape here is copied field-for-\n12\tfield from its ``_torque()`` helper: ``key``, ``component``, ``categories``\n13\t(tuple), ``value``, ``unit`` (\"Nm\" or \"lb-ft\"), ``value_nm``, ``value_lbft``,\n14\t``value_range``, ``display``, ``angle``, ``single_use``, ``source``,\n15\t``confidence``, ``notes``, ``platform_note`` -- plus one addition this module\n16\tneeds and ``service_specs.py`` does not: a ``section`` key naming which of\n17\tthe five ``SECTIONS`` below the row belongs to. The four confidence\n18\tconstants and ``TECHAUTHORITY`` are redefined locally (identical string\n19\tvalues) rather than imported, so this module has no import-time dependency\n20\ton ``service_specs.py``.\n21\t\n22\t``service_specs.py`` already carries a handful of driveline rows under its\n23\town \"transmission\" / \"transfer_case\" / \"differential\" categories (it is the\n24\twhole-car service ledger, this module is the drivetrain-only deep dive) --\n25\twhere its research turned up something this module's own research pass had\n26\tmarked UNKNOWN (the rear differential plug torque, notably), that value is\n27\tfolded in here too, credited to its original source.\n28\t\n29\t``SPECS`` has no equivalent list in ``service_specs.py`` to match, so its\n30\tshape is this module's own: ``key``, ``component``, ``categories`` (tuple),\n31\t``value`` (str), ``unit``, ``source``, ``confidence``, ``notes``, ``section``.\n32\t\n33\tOrganisation\n34\t------------\n35\t``SECTIONS`` groups everything into five self-contained drivetrain areas,\n36\teach its own dict of ``{\"specs\": [...], \"torques\": [...], \"jobs\": {...}}``\n37\t(plus a few section-specific extras: ``dtcs``, ``tsbs``, ``issues``):\n38\t\n39\t    transmission   -- ZF 8HP50/75, including its cooling\n40\t    transfer_case  -- Magna Q4 active on-demand transfer case\n41\t    differentials  -- front and rear, as sub-dicts \"front\" / \"rear\", plus\n42\t                       section-level \"specs\"/\"torques\" combining both\n43\t    driveline      -- propshaft/driveshaft, CV axles, hub nuts\n44\t    mounts         -- engine and transmission mounts\n45\t\n46\t``SPECS``, ``TORQUES`` and ``JOBS`` below are flat views of the same rows\n47\t(every row carries its own ``section`` key), for callers that want one table\n48\trather than the sectioned view.\n49\t\"\"\"\n50\t\n51\tfrom __future__ import annotations\n52\t\n53\tfrom typing import Any, Iterable, Optional\n54\t\n55\tCONFIRMED = \"CONFIRMED\"\n56\tCORROBORATED = \"CORROBORATED\"\n57\tSINGLE_SOURCE = \"SINGLE-SOURCE\"\n58\tUNKNOWN = \"UNKNOWN\"\n59\t\n60\tCONFIDENCE_LEVELS = (CONFIRMED, CORROBORATED, SINGLE_SOURCE, UNKNOWN)\n61\t\n62\tTECHAUTHORITY = \"use the service manual (TechAuthority)\"\n63\t\n64\tVEHICLE = (\"2018 Alfa Romeo Stelvio 2.0T (GU), 2.0L GME-T4 turbo I4, sales \"\n65\t           \"code EC2, US market, Magna Q4 AWD, ZF 8HP50 automatic (MES: \"\n66\t           \"'ZF 8HP50/75')\")\n67\t\n68\tNM_PER_LBFT = 1.35582\n69\tLBFT_PER_NM = 0.737562149\n70\t\n71\t\n72\tdef nm_to_lbft(nm: Optional[float]) -> Optional[float]:\n73\t    if nm is None:\n74\t        return None\n75\t    return round(nm * LBFT_PER_NM, 1)\n76\t\n77\t\n78\tdef lbft_to_nm(lbft: Optional[float]) -> Optional[float]:\n79\t    if lbft is None:\n80\t        return None\n81\t    return round(lbft * NM_PER_LBFT, 1)\n82\t\n83\t\n84\t# ---------------------------------------------------------------------------\n85\t# TORQUES -- row shape matches service_specs.py's _torque() output exactly,\n86\t# plus a \"section\" key.\n87\t# ---------------------------------------------------------------------------\n88\t\n89\tTORQUES: list[dict[str, Any]] = []\n90\t\n91\t\n92\tdef _torque(section: str, key: str, component: str, categories: Iterable[str],\n93\t            value: Optional[float], unit: Optional[str], *,\n94\t            value_range: Optional[tuple[float, float]] = None,\n95\t            angle: Optional[str] = None, single_use: bool = False,\n96\t            source: Optional[str] = None, confidence: str = UNKNOWN,\n97\t            notes: str = \"\", platform_note: Optional[str] = None,\n98\t            display: Optional[str] = None) -> None:\n99\t    if confidence not in CONFIDENCE_LEVELS:\n100\t        raise ValueError(f\"bad confidence {confidence!r}\")\n101\t    value_nm = value if unit == \"Nm\" else (lbft_to_nm(value) if unit == \"lb-ft\" else None)\n102\t    value_lbft = value if unit == \"lb-ft\" else (nm_to_lbft(value) if unit == \"Nm\" else None)\n103\t    if not notes and confidence == UNKNOWN:\n104\t        notes = TECHAUTHORITY\n105\t    TORQUES.append({\n106\t        \"section\": section,\n107\t        \"key\": key,\n108\t        \"component\": component,\n109\t        \"categories\": tuple(categories),\n110\t        \"value\": value,\n111\t        \"unit\": unit,\n112\t        \"value_nm\": value_nm,\n113\t        \"value_lbft\": value_lbft,\n114\t        \"value_range\": value_range,\n115\t        \"display\": display or (f\"{value} {unit}\" if value is not None else \"UNKNOWN\"),\n116\t        \"angle\": angle,\n117\t        \"single_use\": single_use,\n118\t        \"source\": source,\n119\t        \"confidence\": confidence,\n120\t        \"notes\": notes.strip(),\n121\t        \"platform_note\": platform_note,\n122\t    })\n123\t\n124\t\n125\t# --- 1. transmission (ZF 8HP50/75) ------------------------------------------\n126\t\n127\t_torque(\"transmission\", \"transmission_pan_bolts\",\n128\t        \"ZF 8HP pan/filter assembly bolts (13x)\", [\"transmission\"],\n129\t        10, \"Nm\",\n130\t        source=\"docs/reference/ZF8HP_SERVICE_DATA.md (ZF doc 1087.754.107c)\",\n131\t        confidence=CONFIRMED,\n132\t        notes=\"Integrated pan/filter assembly, not separately serviceable; \"\n133\t              \"gasket reusable if undamaged. No bolt sequence stated in the \"\n134\t              \"source doc.\")\n135\t\n136\t_torque(\"transmission\", \"transmission_drain_plug\",\n137\t        \"ZF 8HP transmission fluid drain plug\", [\"transmission\"],\n138\t        None, \"Nm\", confidence=UNKNOWN,\n139\t        notes=\"Giorgio-specific value not found. \" + TECHAUTHORITY)\n140\t\n141\t_torque(\"transmission\", \"transmission_fill_plug\",\n142\t        \"ZF 8HP transmission fluid fill/level plug\", [\"transmission\"],\n143\t        None, \"Nm\", confidence=UNKNOWN,\n144\t        notes=\"Giorgio-specific value not found; the 4th-gen 8HP fill/level \"\n145\t              \"check requires an OEM scan-tool routine, not a manual \"\n146\t              \"plug-and-check, per docs/reference/ZF8HP_SERVICE_DATA.md #1. \"\n147\t              + TECHAUTHORITY)\n148\t\n149\t_torque(\"transmission\", \"bmw_mechatronics_bolts\",\n150\t        \"BMW G30 reference: mechatronics-to-transmission bolts M6x59/M6x20\",\n151\t        [\"transmission\"], 8, \"Nm\", single_use=True,\n152\t        source=\"docs/reference/ZF8HP_SERVICE_DATA.md (BMW G30 service info)\",\n153\t        confidence=CORROBORATED,\n154\t        notes=\"Sequence 1->17; screws replaced every time. BMW 8HP family -- \"\n155\t              \"NOT independently confirmed for Giorgio.\",\n156\t        platform_note=\"BMW G30, not Alfa-specific.\")\n157\t\n158\t_torque(\"transmission\", \"bmw_output_speed_sensor\",\n159\t        \"BMW G30 reference: output speed sensor\", [\"transmission\"],\n160\t        4, \"Nm\", angle=\"+12 deg\",\n161\t        source=\"docs/reference/ZF8HP_SERVICE_DATA.md (BMW G30 service info)\",\n162\t        confidence=CORROBORATED,\n163\t        notes=\"BMW 8HP family -- NOT independently confirmed for Giorgio.\",\n164\t        platform_note=\"BMW G30, not Alfa-specific.\")\n165\t\n166\t_torque(\"transmission\", \"bmw_pan_bolts\",\n167\t        \"BMW G30 reference: pan bolts M6 (13x)\", [\"transmission\"],\n168\t        10, \"Nm\", single_use=True,\n169\t        source=\"docs/reference/ZF8HP_SERVICE_DATA.md (BMW G30 service info)\",\n170\t        confidence=CORROBORATED,\n171\t        notes=\"Sequence 1->13; pan itself must be replaced each time it is \"\n172\t              \"released. BMW 8HP family -- NOT independently confirmed for \"\n173\t              \"Giorgio, whose pan/filter is documented as an integrated \"\n174\t              \"non-serviceable assembly in the FCA text.\",\n175\t        platform_note=\"BMW G30, not Alfa-specific.\")\n176\t\n177\t_torque(\"transmission\", \"bmw_drain_plug\",\n178\t        \"BMW G30 reference: drain plug M18\", [\"transmission\"],\n179\t        8, \"Nm\",\n180\t        source=\"docs/reference/ZF8HP_SERVICE_DATA.md (BMW G30 service info)\",\n181\t        confidence=CORROBORATED,\n182\t        notes=\"BMW 8HP family -- NOT independently confirmed for Giorgio.\",\n183\t        platform_note=\"BMW G30, not Alfa-specific.\")\n184\t\n185\t# --- 2. transfer case (Magna Q4) --------------------------------------------\n186\t\n187\t_torque(\"transfer_case\", \"transfer_case_drain_plug\",\n188\t        \"Transfer case (Q4) drain plug\", [\"transfer_case\"],\n189\t        None, \"Nm\", confidence=UNKNOWN,\n190\t        notes=\"A stelvioforum thread asking this exact question cites the \"\n191\t              \"rear differential's 26 Nm as known but leaves the transfer \"\n192\t              \"case itself as an open, unanswered question -- do not assume \"\n193\t              \"'probably the same as the diff', that is speculation, not a \"\n194\t              \"source. \" + TECHAUTHORITY,\n195\t        source=\"https://www.stelvioforum.com/threads/transfer-case-drain-fill-plug-torque-specs.24693/\")\n196\t\n197\t_torque(\"transfer_case\", \"transfer_case_fill_plug\",\n198\t        \"Transfer case (Q4) fill plug\", [\"transfer_case\"],\n199\t        None, \"Nm\", confidence=UNKNOWN,\n200\t        notes=\"Same open question as transfer_case_drain_plug. \" + TECHAUTHORITY,\n201\t        source=\"https://www.stelvioforum.com/threads/transfer-case-drain-fill-plug-torque-specs.24693/\")\n202\t\n203\t# --- 3. differentials --------------------------------------------------------\n204\t\n205\t_torque(\"differentials\", \"front_diff_drain_plug\",\n206\t        \"Front differential drain plug\", [\"differential\", \"front\"],\n207\t        None, \"Nm\", confidence=UNKNOWN,\n208\t        notes=\"Not found. \" + TECHAUTHORITY)\n209\t\n210\t_torque(\"differentials\", \"front_diff_fill_plug\",\n211\t        \"Front differential fill plug\", [\"differential\", \"front\"],\n212\t        None, \"Nm\", confidence=UNKNOWN,\n213\t        notes=\"Not found. \" + TECHAUTHORITY)\n214\t\n215\t_torque(\"differentials\", \"rear_diff_drain_plug\",\n216\t        \"Rear differential (rear axle) drain plug\", [\"differential\", \"rear\"],\n217\t        26, \"Nm\",\n218\t        source=\"https://www.stelvioforum.com/threads/transfer-case-drain-fill-plug-torque-specs.24693/\",\n219\t        confidence=SINGLE_SOURCE,\n220\t        notes=\"Stated as known/given by the original poster in a thread \"\n221\t              \"actually asking about the transfer case plug; not \"\n222\t              \"independently corroborated elsewhere.\")\n223\t\n224\t_torque(\"differentials\", \"rear_diff_fill_plug\",\n225\t        \"Rear differential (rear axle) fill plug\", [\"differential\", \"rear\"],\n226\t        26, \"Nm\",\n227\t        source=\"https://www.stelvioforum.com/threads/transfer-case-drain-fill-plug-torque-specs.24693/\",\n228\t        confidence=SINGLE_SOURCE,\n229\t        notes=\"Same source as rear_diff_drain_plug; drain and fill plugs \"\n230\t              \"are commonly the same fastener spec on this style of axle, \"\n231\t              \"but that has not been independently confirmed as true here.\")\n232\t\n233\t# --- 4. driveline (propshaft, CV axles, hub nuts) ---------------------------\n234\t\n235\t_torque(\"driveline\", \"propshaft_flange_nut\",\n236\t        \"Propshaft flange/centre-carrier nut\", [\"driveline\"],\n237\t        None, \"Nm\",\n238\t        source=\"none for the Giorgio platform -- use the service manual (TechAuthority)\",\n239\t        confidence=UNKNOWN,\n240\t        notes=\"DO NOT USE the 72-101 lb-ft figure that circulates online: fact-check \"\n241\t              \"(2026-09-26) traced it to the 1970s Alfa 2000 shop manual (10-14 m-kg), a \"\n242\t              \"different car and driveline, not the Stelvio's Q4 propshaft. Use the FCA \"\n243\t              \"service manual value for this VIN.\",\n244\t        display=\"UNKNOWN - use service manual\")\n245\t\n246\t_torque(\"driveline\", \"q4_central_m14_bolt\",\n247\t        \"Central M14 bolt, Q4 (4x4) versions\", [\"driveline\", \"mounts\"],\n248\t        None, \"Nm\", value_range=(124, 136),\n249\t        source=\"forum synthesis (alfaowner.com)\",\n250\t        confidence=SINGLE_SOURCE,\n251\t        notes=\"Location not independently confirmed -- possibly a \"\n252\t              \"front-driveline or subframe pivot fastener unique to AWD \"\n253\t              \"cars; may instead be an engine-mount-to-subframe pivot bolt \"\n254\t              \"(see the mounts section's identical entry). Not resolved \"\n255\t              \"which fastener this actually is.\",\n256\t        display=\"124-136 Nm\")\n257\t\n258\t_torque(\"driveline\", \"axle_hub_nut\",\n259\t        \"Front/rear axle (hub) nut\", [\"driveline\"],\n260\t        52, \"lb-ft\", angle=\"+47 deg\", single_use=True,\n261\t        source=\"stelvioforum.com forum synthesis\",\n262\t        confidence=SINGLE_SOURCE,\n263\t        notes=\"Torque-then-angle procedure; always fit a NEW nut.\")\n264\t\n265\t_torque(\"driveline\", \"hub_mount_bolts\",\n266\t        \"Front/rear hub mounting bolts\", [\"driveline\"],\n267\t        74, \"lb-ft\",\n268\t        source=\"forum synthesis (stelvioforum.com)\",\n269\t        confidence=SINGLE_SOURCE,\n270\t        notes=\"\")\n271\t\n272\t_torque(\"driveline\", \"wheel_lug_reference\",\n273\t        \"Wheel lug bolts (reference only, not a drivetrain fastener)\",\n274\t        [\"driveline\"], 89, \"lb-ft\",\n275\t        source=\"forum synthesis (giuliaforums.com/alfaowner.com)\",\n276\t        confidence=SINGLE_SOURCE,\n277\t        notes=\"Included for completeness only; see service_specs.py's own \"\n278\t              \"wheel_lug row (121 Nm / CORROBORATED) for the vetted figure \"\n279\t              \"used by the general service ledger -- the two were not \"\n280\t              \"reconciled against each other in this pass.\")\n281\t\n282\t# --- 5. mounts (engine and transmission) ------------------------------------\n283\t\n284\t_torque(\"mounts\", \"engine_mount_bolts\",\n285\t        \"Engine mount bolts into aluminium block\", [\"mounts\"],\n286\t        None, \"Nm\", value_range=(22, 27),\n287\t        source=\"forum synthesis (alfaowner.com)\",\n288\t        confidence=SINGLE_SOURCE,\n289\t        notes=\"\",\n290\t        display=\"22-27 Nm\")\n291\t\n292\t_torque(\"mounts\", \"longitudinal_mount_bolts\",\n293\t        \"Longitudinal mount (torque strut / dogbone) bolts\", [\"mounts\"],\n294\t        None, \"Nm\", value_range=(25, 31), single_use=True,\n295\t        source=\"forum synthesis (alfaowner.com); aftermarket install-\"\n296\t               \"instruction PDF (binary/encoded, not text-extractable this pass)\",\n297\t        confidence=SINGLE_SOURCE,\n298\t        notes=\"Alfa Romeo specifies the mount itself must be replaced on \"\n299\t              \"removal, not just the bolts.\",\n300\t        display=\"25-31 Nm\")\n301\t\n302\t_torque(\"mounts\", \"q4_central_m14_bolt_mounts\",\n303\t        \"Central M14 bolt, Q4 versions (mounts-context duplicate)\",\n304\t        [\"mounts\", \"driveline\"], None, \"Nm\", value_range=(124, 136),\n305\t        source=\"forum synthesis (alfaowner.com)\",\n306\t        confidence=SINGLE_SOURCE,\n307\t        notes=\"Same figure and same unresolved-location caveat as \"\n308\t              \"driveline's q4_central_m14_bolt -- kept here too since which \"\n309\t              \"section it truly belongs to was not resolved this pass.\",\n310\t        display=\"124-136 Nm\")\n311\t\n312\t_torque(\"mounts\", \"trans_mount_bracket_fasteners\",\n313\t        \"Transmission-bracket-to-transmission-case fasteners\", [\"mounts\"],\n314\t        None, \"Nm\", single_use=True,\n315\t        source=\"forum synthesis (alfaowner.com), citing an unidentified FCA TSB\",\n316\t        confidence=SINGLE_SOURCE,\n317\t        notes=\"Fasteners reported one-time-use per a referenced TSB for the \"\n318\t              \"2021 Stelvio; bulletin number not independently verified \"\n319\t              \"this pass, and no torque value was found. \" + TECHAUTHORITY)\n320\t\n321\t\n322\tdef torque_by_key(key: str) -> Optional[dict[str, Any]]:\n323\t    for t in TORQUES:\n324\t        if t[\"key\"] == key:\n325\t            return dict(t)\n326\t    return None\n327\t\n328\t\n329\tdef torques_for_section(section: str) -> list[dict[str, Any]]:\n330\t    return [dict(t) for t in TORQUES if t[\"section\"] == section]\n331\t\n332\t\n333\t# ---------------------------------------------------------------------------\n334\t# SPECS -- non-torque facts (fluids, capacities, intervals, DIDs, ...).\n335\t# No equivalent list exists in service_specs.py to match; shape is this\n336\t# module's own, but deliberately close (key/component/categories/confidence).\n337\t# ---------------------------------------------------------------------------\n338\t\n339\tSPECS: list[dict[str, Any]] = []\n340\t\n341\t\n342\tdef _spec(section: str, key: str, component: str, categories: Iterable[str],\n343\t          value: str, unit: str = \"\", *, source: str = \"\",\n344\t          confidence: str = UNKNOWN, notes: str = \"\") -> None:\n345\t    if confidence not in CONFIDENCE_LEVELS:\n346\t        raise ValueError(f\"bad confidence {confidence!r}\")\n347\t    if not notes and confidence == UNKNOWN:\n348\t        notes = TECHAUTHORITY\n349\t    SPECS.append({\n350\t        \"section\": section,\n351\t        \"key\": key,\n352\t        \"component\": component,\n353\t        \"categories\": tuple(categories),\n354\t        \"value\": value,\n355\t        \"unit\": unit,\n356\t        \"source\": source,\n357\t        \"confidence\": confidence,\n358\t        \"notes\": notes,\n359\t    })\n360\t\n361\t\n362\t# --- 1. transmission ---------------------------------------------------------\n363\t\n364\t_spec(\"transmission\", \"fluid_identity\", \"ZF 8HP transmission fluid\",\n365\t      [\"transmission\", \"fluid\"],\n366\t      \"ZF LifeguardFluid 8 / Mopar '8 & 9 Speed ATF', P/N 68218925AA -- \"\n367\t      \"NOT compatible with ATF+4 or any other current FCA ATF\", \"\",\n368\t      source=\"docs/reference/ZF8HP_SERVICE_DATA.md #1 (ZF doc 1087.754.107c); \"\n369\t             \"giuliaforums.com 'How-To: ZF 8HP50/75 Fluid and Filter Change'\",\n370\t      confidence=CORROBORATED,\n371\t      notes=\"Fluid identity/incompatibility CONFIRMED via repo doc; the \"\n372\t            \"Mopar part number itself is SINGLE-SOURCE.\")\n373\t\n374\t_spec(\"transmission\", \"dry_fill_capacity\", \"ZF 8HP overhaul dry fill\",\n375\t      [\"transmission\", \"fluid\"], \"9.0 (9.5 qt); +0.7 if cooler replaced\", \"L\",\n376\t      source=\"docs/reference/ZF8HP_SERVICE_DATA.md #1 (ZF doc 1087.754.107c, Table 1)\",\n377\t      confidence=CONFIRMED,\n378\t      notes=\"Poured through the side plug, unit tipped, before installation.\")\n379\t\n380\t_spec(\"transmission\", \"owner_manual_capacity\",\n381\t      \"ZF 8HP owner/service-manual capacity, 2.0 AWD\",\n382\t      [\"transmission\", \"fluid\"], \"9.3 (9.8 qt)\", \"L\",\n383\t      source=\"giuliatech.com/t/alfa-romeo-giulia-fluid-specs-and-capacities/91\",\n384\t      confidence=SINGLE_SOURCE,\n385\t      notes=\"Close to but not reconciled with the 9.0 L ZF dry-fill figure.\")\n386\t\n387\t_spec(\"transmission\", \"service_fill_quantity\",\n388\t      \"ZF 8HP service drain-and-fill (pan drop) quantity\",\n389\t      [\"transmission\", \"fluid\"],\n390\t      \"not established -- 'a few quarts' pan volume + 0.5 L overfill during level check\",\n391\t      \"L\", source=\"giuliaforums.com 'How-To' thread\", confidence=UNKNOWN,\n392\t      notes=\"Forum practice, not an OEM spec. \" + TECHAUTHORITY)\n393\t\n394\t_spec(\"transmission\", \"fill_temp_window\", \"ZF 8HP fill/level-check temperature window\",\n395\t      [\"transmission\", \"fluid\"], \"30-50 (86-122 F)\", \"°C\",\n396\t      source=\"docs/reference/ZF8HP_SERVICE_DATA.md #1\", confidence=CONFIRMED,\n397\t      notes=\"General 8HP family window; matches this car's family per ZF \"\n398\t            \"Table 1 and FCA OEM text.\")\n399\t\n400\t_spec(\"transmission\", \"level_check_procedure\", \"ZF 8HP level-check procedure\",\n401\t      [\"transmission\", \"fluid\"],\n402\t      \"ZF: engine running, P, 2000rpm 30s, idle, cycle P-R-D-1-2 >=10s dwell \"\n403\t      \"each, P, check temp+plug. FCA equivalent: fill, R 5s, D 5s, \"\n404\t      \"accelerate 2nd 5s, N@2000rpm 5s, P.\", \"\",\n405\t      source=\"docs/reference/ZF8HP_SERVICE_DATA.md #1 (ZF doc Section 5)\",\n406\t      confidence=CONFIRMED,\n407\t      notes=\"4th-gen 8HP (this box) requires an OEM scan-tool routine -- no \"\n408\t            \"manual plug procedure exists.\")\n409\t\n410\t_spec(\"transmission\", \"pan_filter\", \"ZF 8HP pan/filter\", [\"transmission\"],\n411\t      \"integrated assembly, not separately serviceable; gasket reusable if undamaged\",\n412\t      \"\", source=\"docs/reference/ZF8HP_SERVICE_DATA.md #1\", confidence=CONFIRMED)\n413\t\n414\t_spec(\"transmission\", \"interval_fca\", \"ZF 8HP service interval, FCA position\",\n415\t      [\"transmission\", \"interval\"], \"no FCA-published mileage number found this pass\",\n416\t      \"\", confidence=UNKNOWN,\n417\t      notes=\"The 2018 US owner's manual Maintenance Plan lists no automatic \"\n418\t            \"transmission fluid change (checked 2026-09-26). \" + TECHAUTHORITY)\n419\t\n420\t_spec(\"transmission\", \"interval_zf\", \"ZF 8HP service interval, ZF generic guidance\",\n421\t      [\"transmission\", \"interval\"], \"50000-75000\", \"mi\",\n422\t      source=\"forum synthesis (ZF-attributed)\", confidence=SINGLE_SOURCE,\n423\t      notes=\"Forum-attributed to ZF; not FCA/owner's-manual sourced.\")\n424\t\n425\t_spec(\"transmission\", \"interval_severe\", \"ZF 8HP severe-duty guidance\",\n426\t      [\"transmission\", \"interval\"], \"not found for this vehicle\", \"\",\n427\t      confidence=UNKNOWN, notes=TECHAUTHORITY)\n428\t\n429\t_spec(\"transmission\", \"adaptation_relearn\", \"ZF 8HP adaptation relearn after service\",\n430\t      [\"transmission\", \"adaptation\"],\n431\t      \"Fast Filling Adaptation + Standard Clutch Filling Adaptation via \"\n432\t      \"wiTECH; MES: QUICK LEARN / STATIC ADAPTATION (STADA) + separate \"\n433\t      \"RESET ADAPTIVE VALUES\", \"\",\n434\t      source=\"docs/reference/ZF8HP_SERVICE_DATA.md #5-7\", confidence=CONFIRMED,\n435\t      notes=\"Not required for a routine fluid+filter change; not required \"\n436\t            \"after a TCM/TCMA re-flash alone; NOT lost on battery \"\n437\t            \"disconnect (non-volatile EEPROM).\")\n438\t\n439\t_spec(\"transmission\", \"cooler\", \"ZF 8HP cooler\", [\"transmission\", \"cooling\"],\n440\t      \"oil-to-coolant heat exchanger with thermostatic element (keeps box \"\n441\t      \"warm for warm-up/emissions)\", \"\",\n442\t      source=\"docs/research/TRANSMISSION_ZF8HP_Q4.md #6\", confidence=CONFIRMED,\n443\t      notes=\"Track-only bypass is a modification, not a service step.\")\n444\t\n445\t_spec(\"transmission\", \"oil_temp_did\", \"Gearbox oil temperature -- live DID\",\n446\t      [\"transmission\", \"cooling\", \"live_data\"],\n447\t      \"TCM DID 04FE, header 18DA18F1, formula A-40\", \"°C\",\n448\t      source=\"docs/reference/GIORGIO_MODULE_MAP.md Table C; \"\n449\t             \"cuore/live/addressing.py:674-683; cuore/live/ops.py:485-496\",\n450\t      confidence=SINGLE_SOURCE,\n451\t      notes=\"Implemented as DidSpec(module='TCM', did=0x04FE, ...) in \"\n452\t            \"cuore/live/addressing.py. Read live via \"\n453\t            \"cuore.live.ops.module_did('TCM', '04FE', vin=<VIN>), or the \"\n454\t            \"obd2 MCP 'read_did' tool against module TCM, DID 0x04FE. \"\n455\t            \"Formula is UNVERIFIED on this 2.0T specifically (sourced from \"\n456\t            \"a 2.2D Giulia PID repo) -- confirm against this car's own scan.\")\n457\t\n458\tTRANSMISSION_DTCS: list[tuple[str, str]] = [\n459\t    (\"P1DB7-00\", \"TCC Performance (functional equivalent of P0741; \"\n460\t                 \"P0740/P0741/P0742 do not exist on 8HP)\"),\n461\t    (\"P0731-P0735,P0729,P076F,P07D9\", \"Per-gear ratio error, non-contiguous \"\n462\t                                       \"numbering (gears 1-8)\"),\n463\t    (\"P1D8F-P1D93,P1D96-P1D9F,P1DA0-P1DA8,P1D95\",\n464\t     \"Clutch-resolved ratio faults: single/pair/triplet/undetermined\"),\n465\t    (\"P1731\", \"Incorrect Gear Engaged; turbine slip > 300 RPM is the only \"\n466\t              \"published hard threshold\"),\n467\t    (\"P167A\", \"Calibration Mismatch (software vs Hydraulic ID in TCMA EEPROM)\"),\n468\t    (\"P1DC6\", \"TCM Not Programmed\"),\n469\t    (\"P0610,U3002-00\", \"VIN mismatch after TCM replacement\"),\n470\t    (\"P1500\", \"Vehicle configuration (PROXI) mismatch\"),\n471\t    (\"P07E4,P1DB2,P0716,P1B14,P0733,P1D90,P1DB7,P1B13\",\n472\t     \"Master 8HP shift-quality/valve-body TSB code set\"),\n473\t]\n474\t\n475\tTRANSMISSION_TSBS: list[dict[str, Any]] = [\n476\t    {\n477\t        \"number\": \"21-035-20\", \"date\": \"2020-05-08\",\n478\t        \"applies_to_this_car\": True,\n479\t        \"summary\": \"Flash: TCM Update. Applies explicitly to 2018 (GU) \"\n480\t                    \"Stelvio, 2.0L I4 DI Turbo (EC2), North America. Fixes \"\n481\t                    \"MIL w/ P0002-00, P026E-00, P1066-00, P26E4-00, \"\n482\t                    \"P2B61-00, P2BC1-00, U1008-00; transmission shift-\"\n483\t                    \"quality improvements; turbo coolant-pump after-run \"\n484\t                    \"update. Labor op 18-19-05-MX, 0.3 hr. PCM must also be \"\n485\t                    \"updated to latest at completion.\",\n486\t        \"source\": \"static.nhtsa.gov/odi/tsbs/2020/MC-10176569-9999.pdf (fetched directly)\",\n487\t        \"confidence\": CONFIRMED,\n488\t    },\n489\t    {\n490\t        \"number\": \"21-044-19\", \"date\": \"2019-12-17\",\n491\t        \"applies_to_this_car\": False,\n492\t        \"summary\": \"Flash: TCM Update. Applies to 2019 (GU) Stelvio built \"\n493\t                    \"on/before 2019-10-10 -- not this car's model year. Same \"\n494\t                    \"symptom/DTC set and shift-quality fix, prior software \"\n495\t                    \"revision. Labor op 18-19-05-MU.\",\n496\t        \"source\": \"static.nhtsa.gov/odi/tsbs/2019/MC-10170397-9999.pdf (fetched directly)\",\n497\t        \"confidence\": CONFIRMED,\n498\t    },\n499\t    {\n500\t        \"number\": \"S2621000003 REV. A\", \"date\": \"2026-03-09\",\n501\t        \"applies_to_this_car\": True,\n502\t        \"summary\": \"8HP master TSB, 2017-2026 Giulia (GA) and 2018-2026 \"\n503\t                    \"Stelvio (GU), covers 8HP45/50/70/75/90/95. Burnt-fluid \"\n504\t                    \"smell / fine metallic content normal. Valve body \"\n505\t                    \"replacement before transmission replacement. \"\n506\t                    \"P1B13/P1B14 -> check MPR cable. P0733 -> 21-029-25 \"\n507\t                    \"REV. A (8HP75 clutch-D repair, not this car's box size).\",\n508\t        \"source\": \"docs/reference/TSB_CATALOGUE.md #3\",\n509\t        \"confidence\": CONFIRMED,\n510\t    },\n511\t]\n512\t\n513\t# --- 2. transfer case ---------------------------------------------------------\n514\t\n515\t_spec(\"transfer_case\", \"behaviour\", \"Q4 transfer case behaviour\",\n516\t      [\"transfer_case\", \"architecture\"],\n517\t      \"rear-biased; 100% rear normally, on-demand up to 60% front via \"\n518\t      \"controlled clutch (not a centre differential)\", \"\",\n519\t      source=\"docs/research/TRANSMISSION_ZF8HP_Q4.md #5\", confidence=CONFIRMED)\n520\t\n521\t_spec(\"transfer_case\", \"actuator_architecture\", \"Q4 actuator architecture\",\n522\t      [\"transfer_case\", \"architecture\"],\n523\t      \"hypothesis: electric-motor-driven ball ramp applying a multi-plate \"\n524\t      \"wet clutch (Magna Active Transfer Case pattern, shared with BMW \"\n525\t      \"xDrive / Jeep Active Drive)\", \"\",\n526\t      source=\"docs/research/TRANSMISSION_ZF8HP_Q4.md #5\", confidence=UNKNOWN,\n527\t      notes=\"Resolve via MES DTCM parameter-name read per repo doc's method.\")\n528\t\n529\t_spec(\"transfer_case\", \"fluid_identity\", \"Q4 transfer case fluid\",\n530\t      [\"transfer_case\", \"fluid\"],\n531\t      \"Petronas Tutela Transmission Transfer Case (Q4) -- Tutela \"\n532\t      \"Transmission Hypoide Gear Oil, Synthetic SAE 75W, FIAT approval \"\n533\t      \"9.55550-DA11\", \"\",\n534\t      source=\"docs/research/TRANSMISSION_ZF8HP_Q4.md #5; giuliatech.com \"\n535\t             \"fluid-specs table (independent second source, same FIAT number)\",\n536\t      confidence=CORROBORATED,\n537\t      notes=\"Do not substitute ATF or generic 75W GL-5; friction \"\n538\t            \"characteristics matched to the clutch pack.\")\n539\t\n540\t_spec(\"transfer_case\", \"capacity\", \"Q4 transfer case capacity\",\n541\t      [\"transfer_case\", \"fluid\"],\n542\t      \"conflicting: ~1 L (repo doc) vs 0.7 L (giuliatech.com)\", \"L\",\n543\t      source=\"docs/research/TRANSMISSION_ZF8HP_Q4.md #5; giuliatech.com\",\n544\t      confidence=SINGLE_SOURCE,\n545\t      notes=\"Unreconciled -- confirm exact fill quantity at dealer parts \"\n546\t            \"counter by VIN or in TechAuthority before doing the job.\")\n547\t\n548\t_spec(\"transfer_case\", \"interval\", \"Q4 transfer case service interval\",\n549\t      [\"transfer_case\", \"interval\"], \"80000 mi (128000 km) / 8 years\", \"\",\n550\t      source=\"https://vehicleinfo.mopar.com/assets/publications/en-us/Alfa_Romeo/2018/Stelvio/P124461_18_GU_OM_EN_USC_DIGITAL_2nd_V2.pdf\", confidence=CONFIRMED,\n551\t      notes=\"2018 Stelvio US owner's manual, Maintenance Plan (2.0 T4 MAir), row \"\n552\t            \"'Replace transfer case oil (AWD models only)': one mandatory mark in the \"\n553\t            \"80k mi / 128k km / year-8 column (read from the PDF's column positions, \"\n554\t            \"2026-09-26). This car is past that mileage: due unless already done.\")\n555\t\n556\t_spec(\"transfer_case\", \"adj_routine\", \"DTCM ADJ routine\", [\"transfer_case\", \"adaptation\"],\n557\t      \"hypothesis: actuator position / clutch-clearance learn, drives to \"\n558\t      \"mechanical end stops and records encoder positions\", \"\",\n559\t      source=\"docs/research/TRANSMISSION_ZF8HP_Q4.md #5\", confidence=UNKNOWN,\n560\t      notes=\"Read the MES procedure text before running; do NOT run with \"\n561\t            \"vehicle on the ground or on a single-axle dyno.\")\n562\t\n563\t_spec(\"transfer_case\", \"torque_split_tuning\", \"Q4 torque-split calibration availability\",\n564\t      [\"transfer_case\", \"tuning\"],\n565\t      \"almost certainly not available -- no tool ecosystem lists a Giorgio DTCM\", \"\",\n566\t      source=\"docs/research/TRANSMISSION_ZF8HP_Q4.md #1, #5\", confidence=SINGLE_SOURCE)\n567\t\n568\tTRANSFER_CASE_DTCS: list[tuple[str, str]] = [\n569\t    (\"U0100-87\", \"Lost Comm with ECM -- observed as a bystander code from \"\n570\t                 \"whole-vehicle serial UDS sweeps on this exact car's own \"\n571\t                 \"scan (SCAN_2609041953), not a real fault\"),\n572\t    (\"U0102\", \"Lost Communication With Transfer Case Control Module/AWD on \"\n573\t              \"a RWD car -- configuration fault (AWD software on RWD \"\n574\t              \"vehicle) after ECM replace/flash; NOT applicable to a \"\n575\t              \"factory Q4 car, listed for completeness\"),\n576\t]\n577\t\n578\t# --- 3. differentials ---------------------------------------------------------\n579\t\n580\t_spec(\"differentials\", \"front_fluid_identity\", \"Front differential fluid\",\n581\t      [\"differential\", \"front\", \"fluid\"],\n582\t      \"SAE 75W-80, API GL-5, synthetic, FIAT approval 9.55550-DA10\", \"\",\n583\t      source=\"giuliatech.com fluid-specs table\", confidence=SINGLE_SOURCE)\n584\t\n585\t_spec(\"differentials\", \"front_capacity_20t\", \"Front differential capacity, 2.0T\",\n586\t      [\"differential\", \"front\", \"fluid\"], \"0.5\", \"L\",\n587\t      source=\"giuliatech.com\", confidence=SINGLE_SOURCE)\n588\t\n589\t_spec(\"differentials\", \"front_capacity_qv\", \"Front differential capacity, 2.9 QV (reference only)\",\n590\t      [\"differential\", \"front\", \"fluid\"], \"0.45\", \"L\",\n591\t      source=\"giuliatech.com\", confidence=SINGLE_SOURCE,\n592\t      notes=\"Reference only, not this car.\")\n593\t\n594\t_spec(\"differentials\", \"front_interval\", \"Front differential service interval\",\n595\t      [\"differential\", \"front\", \"interval\"],\n596\t      \"anecdotally lasts to ~100000 km without visible wear\", \"km\",\n597\t      source=\"forum synthesis (giuliaforums.com/stelvioforum.com)\",\n598\t      confidence=SINGLE_SOURCE, notes=\"Not an OEM schedule.\")\n599\t\n600\t_spec(\"differentials\", \"front_lsd_additive\", \"Front differential LSD additive\",\n601\t      [\"differential\", \"front\", \"fluid\"],\n602\t      \"not applicable -- fixed-ratio open unit on 2.0T Q4, no front LSD option found\",\n603\t      \"\", confidence=SINGLE_SOURCE,\n604\t      notes=\"Inference from architecture (Q4 clutch does front torque \"\n605\t            \"modulation, not a front LSD).\")\n606\t\n607\t_spec(\"differentials\", \"rear_fluid_identity_20t\",\n608\t      \"Rear differential fluid, 2.0T variants (195 open / 230-LSD / 210-eLSD)\",\n609\t      [\"differential\", \"rear\", \"fluid\"],\n610\t      \"SAE 75W-85, synthetic, FIAT approval 9.55550-DA9\", \"\",\n611\t      source=\"giuliatech.com fluid-specs table\", confidence=SINGLE_SOURCE)\n612\t\n613\t_spec(\"differentials\", \"rear_fluid_identity_qv\",\n614\t      \"Rear differential fluid, 2.9 QV torque-vectoring 230-TV (reference only)\",\n615\t      [\"differential\", \"rear\", \"fluid\"],\n616\t      \"SAE 75W-85, API GL-5, synthetic, FIAT approval 9.55550-DA8\", \"\",\n617\t      source=\"giuliatech.com\", confidence=SINGLE_SOURCE,\n618\t      notes=\"Reference only, not this car.\")\n619\t\n620\t_spec(\"differentials\", \"rear_capacity_20t\", \"Rear differential capacity, 2.0T variants\",\n621\t      [\"differential\", \"rear\", \"fluid\"],\n622\t      \"0.9-1.1 (varies by internal type: 195 / 230-LSD / 210-eLSD)\", \"L\",\n623\t      source=\"giuliatech.com\", confidence=SINGLE_SOURCE)\n624\t\n625\t_spec(\"differentials\", \"rear_capacity_qv\",\n626\t      \"Rear differential capacity, 2.9 QV TV (reference only)\",\n627\t      [\"differential\", \"rear\", \"fluid\"],\n628\t      \"main 0.8 + left TV 0.5 + right TV 0.6 (Giulia) or 0.61-0.68 (Stelvio); \"\n629\t      \"3-chamber unit\", \"L\",\n630\t      source=\"giuliatech.com\", confidence=SINGLE_SOURCE, notes=\"Reference only, not this car.\")\n631\t\n632\t_spec(\"differentials\", \"rear_interval\", \"Rear differential service interval\",\n633\t      [\"differential\", \"rear\", \"interval\"],\n634\t      \"~50000-60000 (rear wears faster than front per forum guidance)\", \"km\",\n635\t      source=\"forum synthesis\", confidence=SINGLE_SOURCE, notes=\"Not an OEM schedule.\")\n636\t\n637\t_spec(\"differentials\", \"rear_which_unit_fitted\",\n638\t      \"Rear differential trim/option (which unit is fitted to this VIN)\",\n639\t      [\"differential\", \"rear\", \"identification\"],\n640\t      \"depends on trim/options: open 195 / mechanical-LSD 230-LSD / \"\n641\t      \"electronic 210-eLSD; Ti Sport and Q4-package cars most likely carry \"\n642\t      \"the LSD/eLSD unit\", \"\",\n643\t      source=\"user-provided trim context; giuliatech.com option-code naming\",\n644\t      confidence=UNKNOWN,\n645\t      notes=\"Decode the build sheet / option codes, or confirm at a dealer \"\n646\t            \"parts counter by VIN, before ordering fluid or parts for THIS car.\")\n647\t\n648\t_spec(\"differentials\", \"rear_lsd_additive\", \"Rear differential LSD additive (230-LSD unit)\",\n649\t      [\"differential\", \"rear\", \"fluid\"],\n650\t      \"not found as a separate additive requirement; unconfirmed whether \"\n651\t      \"the listed fluid is already friction-modified\", \"\",\n652\t      confidence=UNKNOWN,\n653\t      notes=\"Do not assume a standard GL-5 is friction-safe for the LSD \"\n654\t            \"unit without checking. \" + TECHAUTHORITY)\n655\t\n656\t# --- 4. driveline --------------------------------------------------------------\n657\t\n658\t_spec(\"driveline\", \"propshaft_construction\", \"Propshaft material/construction\",\n659\t      [\"driveline\", \"identification\"],\n660\t      \"referenced as a carbon-fibre driveshaft on 2017-2025 Giulia/Stelvio \"\n661\t      \"by an aftermarket parts vendor (page body could not be fully retrieved)\",\n662\t      \"\", source=\"go-parts.com garage article (title/metadata only, HTTP 403 on body fetch)\",\n663\t      confidence=SINGLE_SOURCE,\n664\t      notes=\"Confirm construction (steel vs carbon-fibre, one- vs two-piece \"\n665\t            \"with centre bearing) against the parts catalogue for this VIN \"\n666\t            \"before ordering.\")\n667\t\n668\t_spec(\"driveline\", \"propshaft_centre_bearing\", \"Propshaft centre support bearing\",\n669\t      [\"driveline\", \"identification\"], \"not confirmed present or absent\", \"\",\n670\t      confidence=UNKNOWN)\n671\t\n672\t_spec(\"driveline\", \"front_flex_disc\", \"Front flex disc / coupling\",\n673\t      [\"driveline\", \"identification\"],\n674\t      \"bolts possibly torque-to-yield, requiring replacement\", \"\",\n675\t      source=\"forum synthesis (alfabb.com)\", confidence=SINGLE_SOURCE)\n676\t\n677\tDRIVELINE_ISSUES: list[tuple[str, str]] = [\n678\t    (\"front flex-disc bolts\", \"may be torque-to-yield; must be replaced, not reused\"),\n679\t    (\"PTU/stubshaft seal (9004150)\", \"if replacing the stubshaft for an ATX \"\n680\t                                     \"fluid leak, do NOT also replace the PTU seals\"),\n681\t    (\"no TSB addresses propshaft failure\", \"explicit finding from the full TSB corpus sweep\"),\n682\t]\n683\t\n684\t# --- 5. mounts -----------------------------------------------------------------\n685\t\n686\tMOUNTS_ISSUES: list[tuple[str, str]] = [\n687\t    (\"transmission mount clunk/vibration\",\n688\t     \"referenced as a common complaint by an aftermarket parts vendor's \"\n689\t     \"diagnostic guide for 2017-2025 Giulia/Stelvio/Grecale 2.0L (page body \"\n690\t     \"could not be retrieved, HTTP 403) -- treat as a plausible lead, not a \"\n691\t     \"confirmed failure pattern\"),\n692\t]\n693\t\n694\t\n695\tdef specs_for_section(section: str) -> list[dict[str, Any]]:\n696\t    return [dict(s) for s in SPECS if s[\"section\"] == section]\n697\t\n698\t\n699\t# ---------------------------------------------------------------------------\n700\t# JOBS -- job name -> ordered steps, each with an optional torque checkpoint\n701\t# (referencing a TORQUES row's \"key\").\n702\t# ---------------------------------------------------------------------------\n703\t\n704\tJOBS: dict[str, list[dict[str, Any]]] = {\n705\t    \"transmission_fluid_service\": [\n706\t        {\"step\": \"Confirm fluid identity: ZF LifeguardFluid 8 / Mopar 68218925AA only, never ATF+4.\",\n707\t         \"torque_ref\": None},\n708\t        {\"step\": \"Warm to 30-50C fill/level window; on this 4th-gen box, level check requires an OEM scan-tool routine.\",\n709\t         \"torque_ref\": None},\n710\t        {\"step\": \"Drop pan/filter (integrated assembly, not separately serviceable).\",\n711\t         \"torque_ref\": None},\n712\t        {\"step\": \"Reinstall pan/filter.\", \"torque_ref\": \"transmission_pan_bolts\"},\n713\t        {\"step\": \"Refill; forum practice overfills ~0.5 L and bleeds back at \"\n714\t                 \"the level-check plug (unverified shop practice, prefer the \"\n715\t                 \"OEM scan-tool fill routine).\", \"torque_ref\": None},\n716\t        {\"step\": \"Torque drain/fill plug.\", \"torque_ref\": \"transmission_drain_plug\"},\n717\t        {\"step\": \"Do NOT run an adaptation reset for a routine fluid-and-filter \"\n718\t                 \"change; not required per OEM text.\", \"torque_ref\": None},\n719\t        {\"step\": \"Clear DTCs, road test, re-scan; check for TSB 21-035-20 \"\n720\t                 \"before condemning hardware.\", \"torque_ref\": None},\n721\t    ],\n722\t    \"transfer_case_service\": [\n723\t        {\"step\": \"Confirm fluid: Tutela Transmission Transfer Case (Q4), SAE \"\n724\t                 \"75W, FIAT 9.55550-DA11. Do not substitute ATF or generic \"\n725\t                 \"75W GL-5.\", \"torque_ref\": None},\n726\t        {\"step\": \"Capacity is unreconciled (0.7 L vs ~1 L) -- confirm exact \"\n727\t                 \"quantity for this VIN before ordering fluid.\", \"torque_ref\": None},\n728\t        {\"step\": \"Torque drain/fill plug.\", \"torque_ref\": \"transfer_case_drain_plug\"},\n729\t        {\"step\": \"Before condemning transfer-case hardware for shudder/bind/\"\n730\t                 \"ratio DTCs, verify tyre circumference match within 1/8\\\" \"\n731\t                 \"across all four tyres (TSB S1821000001 REV. A).\", \"torque_ref\": None},\n732\t        {\"step\": \"If a DTCM ADJ (actuator learn) routine is called for, read \"\n733\t                 \"its MES procedure text first; never run with wheels on the \"\n734\t                 \"ground or on a single-axle dyno.\", \"torque_ref\": None},\n735\t    ],\n736\t    \"differential_service_front\": [\n737\t        {\"step\": \"Fluid: SAE 75W-80 GL-5 synthetic, FIAT 9.55550-DA10, ~0.5 L.\",\n738\t         \"torque_ref\": None},\n739\t        {\"step\": \"Torque fill/drain plug.\", \"torque_ref\": \"front_diff_fill_plug\"},\n740\t    ],\n741\t    \"differential_service_rear\": [\n742\t        {\"step\": \"Decode this VIN's rear differential type first (195 open / \"\n743\t                 \"230-LSD / 210-eLSD) -- fluid and any LSD-additive \"\n744\t                 \"requirement may differ.\", \"torque_ref\": None},\n745\t        {\"step\": \"Fluid: SAE 75W-85 synthetic, FIAT 9.55550-DA9, ~0.9-1.1 L \"\n746\t                 \"depending on internal type.\", \"torque_ref\": None},\n747\t        {\"step\": \"Do not assume a generic 75W-85/90 GL-5 is friction-safe for \"\n748\t                 \"a mechanical-LSD rear unit without checking for an LSD \"\n749\t                 \"additive requirement.\", \"torque_ref\": None},\n750\t        {\"step\": \"Torque fill/drain plug (26 Nm reported, SINGLE-SOURCE).\",\n751\t         \"torque_ref\": \"rear_diff_fill_plug\"},\n752\t    ],\n753\t    \"axle_propshaft_service\": [\n754\t        {\"step\": \"Confirm propshaft construction (material, one- vs two-piece, \"\n755\t                 \"centre bearing presence) against the parts catalogue for \"\n756\t                 \"this VIN before ordering.\", \"torque_ref\": None},\n757\t        {\"step\": \"Torque propshaft flange/centre-carrier nut (treat as \"\n758\t                 \"unconfirmed pending TechAuthority check).\",\n759\t         \"torque_ref\": \"propshaft_flange_nut\"},\n760\t        {\"step\": \"Always fit a NEW front/rear axle (hub) nut -- torque then angle.\",\n761\t         \"torque_ref\": \"axle_hub_nut\"},\n762\t        {\"step\": \"Torque hub mounting bolts.\", \"torque_ref\": \"hub_mount_bolts\"},\n763\t        {\"step\": \"If replacing the stubshaft for a fluid leak, do NOT replace \"\n764\t                 \"the PTU seals at the same time.\", \"torque_ref\": None},\n765\t        {\"step\": \"Check any flex-disc/coupling bolts for a torque-to-yield \"\n766\t                 \"callout before reusing them.\", \"torque_ref\": None},\n767\t        {\"step\": \"After any driveline disassembly on a Q4 car, verify tyre \"\n768\t                 \"circumference match (1/8\\\") before returning the car.\",\n769\t         \"torque_ref\": None},\n770\t    ],\n771\t    \"mount_replacement\": [\n772\t        {\"step\": \"Torque engine mount bolts to aluminium block.\",\n773\t         \"torque_ref\": \"engine_mount_bolts\"},\n774\t        {\"step\": \"Replace and torque longitudinal (dogbone) mount -- mount \"\n775\t                 \"itself is single-use, do not reinstall a removed mount.\",\n776\t         \"torque_ref\": \"longitudinal_mount_bolts\"},\n777\t        {\"step\": \"On Q4 cars, confirm exact location of the central M14 bolt \"\n778\t                 \"before relying on the 124-136 Nm figure (ambiguous between \"\n779\t                 \"engine-mount pivot and driveline flange).\",\n780\t         \"torque_ref\": \"q4_central_m14_bolt_mounts\"},\n781\t        {\"step\": \"Fit new transmission-mount-bracket fasteners; confirm actual \"\n782\t                 \"torque value in TechAuthority since none was found independently.\",\n783\t         \"torque_ref\": \"trans_mount_bracket_fasteners\"},\n784\t        {\"step\": \"Inspect this mount before condemning the transmission or \"\n785\t                 \"driveline on a clunk/vibration complaint.\", \"torque_ref\": None},\n786\t    ],\n787\t}\n788\t\n789\t# ---------------------------------------------------------------------------\n790\t# SECTIONS -- the five self-contained drivetrain areas required by the\n791\t# organisation requirement: each holds its own specs, torques and jobs.\n792\t# ---------------------------------------------------------------------------\n793\t\n794\tSECTIONS: dict[str, dict[str, Any]] = {\n795\t    \"transmission\": {\n796\t        \"specs\": specs_for_section(\"transmission\"),\n797\t        \"torques\": torques_for_section(\"transmission\"),\n798\t        \"dtcs\": TRANSMISSION_DTCS,\n799\t        \"tsbs\": TRANSMISSION_TSBS,\n800\t        \"jobs\": {\"transmission_fluid_service\": JOBS[\"transmission_fluid_service\"]},\n801\t    },\n802\t    \"transfer_case\": {\n803\t        \"specs\": specs_for_section(\"transfer_case\"),\n804\t        \"torques\": torques_for_section(\"transfer_case\"),\n805\t        \"dtcs\": TRANSFER_CASE_DTCS,\n806\t        \"jobs\": {\"transfer_case_service\": JOBS[\"transfer_case_service\"]},\n807\t    },\n808\t    \"differentials\": {\n809\t        \"front\": {\n810\t            \"specs\": [s for s in specs_for_section(\"differentials\") if \"front\" in s[\"categories\"]],\n811\t            \"torques\": [t for t in torques_for_section(\"differentials\") if \"front\" in t[\"categories\"]],\n812\t            \"jobs\": {\"differential_service_front\": JOBS[\"differential_service_front\"]},\n813\t        },\n814\t        \"rear\": {\n815\t            \"specs\": [s for s in specs_for_section(\"differentials\") if \"rear\" in s[\"categories\"]],\n816\t            \"torques\": [t for t in torques_for_section(\"differentials\") if \"rear\" in t[\"categories\"]],\n817\t            \"jobs\": {\"differential_service_rear\": JOBS[\"differential_service_rear\"]},\n818\t        },\n819\t        \"specs\": specs_for_section(\"differentials\"),\n820\t        \"torques\": torques_for_section(\"differentials\"),\n821\t        \"jobs\": {\n822\t            \"differential_service_front\": JOBS[\"differential_service_front\"],\n823\t            \"differential_service_rear\": JOBS[\"differential_service_rear\"],\n824\t        },\n825\t    },\n826\t    \"driveline\": {\n827\t        \"specs\": specs_for_section(\"driveline\"),\n828\t        \"torques\": torques_for_section(\"driveline\"),\n829\t        \"issues\": DRIVELINE_ISSUES,\n830\t        \"jobs\": {\"axle_propshaft_service\": JOBS[\"axle_propshaft_service\"]},\n831\t    },\n832\t    \"mounts\": {\n833\t        \"specs\": specs_for_section(\"mounts\"),\n834\t        \"torques\": torques_for_section(\"mounts\"),\n835\t        \"issues\": MOUNTS_ISSUES,\n836\t        \"jobs\": {\"mount_replacement\": JOBS[\"mount_replacement\"]},\n837\t    },\n838\t}\n839\t\n840\t\n841\tdef by_confidence(confidence: str) -> list[dict[str, Any]]:\n842\t    \"\"\"All SPECS/TORQUES rows at a given confidence level, e.g. 'UNKNOWN'.\"\"\"\n843\t    want = confidence.upper()\n844\t    return [row for row in SPECS + TORQUES if row[\"confidence\"] == want]\n845\t\n846\t\n847\tdef find(text: str) -> list[dict[str, Any]]:\n848\t    \"\"\"Case-insensitive search across SPECS and TORQUES component names.\"\"\"\n849\t    needle = text.lower()\n850\t    return [row for row in SPECS + TORQUES if needle in row[\"component\"].lower()]\n851\t\n852\t\n853\t__all__ = [\n854\t    \"CONFIRMED\", \"CORROBORATED\", \"SINGLE_SOURCE\", \"UNKNOWN\",\n855\t    \"CONFIDENCE_LEVELS\", \"TECHAUTHORITY\", \"VEHICLE\",\n856\t    \"SPECS\", \"TORQUES\", \"JOBS\", \"SECTIONS\",\n857\t    \"TRANSMISSION_DTCS\", \"TRANSMISSION_TSBS\", \"TRANSFER_CASE_DTCS\",\n858\t    \"DRIVELINE_ISSUES\", \"MOUNTS_ISSUES\",\n859\t    \"torque_by_key\", \"torques_for_section\", \"specs_for_section\",\n860\t    \"by_confidence\", \"find\", \"nm_to_lbft\", \"lbft_to_nm\",\n861\t]\n862\t"}]},"uuid":"111e19cf-f764-44ee-b5f1-136293e64c85","timestamp":"2026-10-08T00:08:30.787Z","toolUseResult":{"type":"text","file":{"filePath":"C:\\Users\\User\\mcp-servers\\mes-log-mcp\\mes\\drivetrain_specs.py","content":"\"\"\"Stelvio 2.0T (GU) drivetrain specs and torques -- pure stdlib data module.\n\nCompanion data to ``docs/reference/STELVIO_20T_DRIVETRAIN_SPECS.md``; read that\nfile for prose, full sourcing detail and the \"what is UNKNOWN\" summary. Every\nrow here mirrors a row in that document.\n\nShape note\n----------\n``mes-log-mcp/mes/service_specs.py`` (the general oil-change / brakes /\nsuspension torque ledger, written by another agent) existed by the time this\nmodule was finished, so the ``TORQUES`` row shape here is copied field-for-\nfield from its ``_torque()`` helper: ``key``, ``component``, ``categories``\n(tuple), ``value``, ``unit`` (\"Nm\" or \"lb-ft\"), ``value_nm``, ``value_lbft``,\n``value_range``, ``display``, ``angle``, ``single_use``, ``source``,\n``confidence``, ``notes``, ``platform_note`` -- plus one addition this module\nneeds and ``service_specs.py`` does not: a ``section`` key naming which of\nthe five ``SECTIONS`` below the row belongs to. The four confidence\nconstants and ``TECHAUTHORITY`` are redefined locally (identical string\nvalues) rather than imported, so this module has no import-time dependency\non ``service_specs.py``.\n\n``service_specs.py`` already carries a handful of driveline rows under its\nown \"transmission\" / \"transfer_case\" / \"differential\" categories (it is the\nwhole-car service ledger, this module is the drivetrain-only deep dive) --\nwhere its research turned up something this module's own research pass had\nmarked UNKNOWN (the rear differential plug torque, notably), that value is\nfolded in here too, credited to its original source.\n\n``SPECS`` has no equivalent list in ``service_specs.py`` to match, so its\nshape is this module's own: ``key``, ``component``, ``categories`` (tuple),\n``value`` (str), ``unit``, ``source``, ``confidence``, ``notes``, ``section``.\n\nOrganisation\n------------\n``SECTIONS`` groups everything into five self-contained drivetrain areas,\neach its own dict of ``{\"specs\": [...], \"torques\": [...], \"jobs\": {...}}``\n(plus a few section-specific extras: ``dtcs``, ``tsbs``, ``issues``):\n\n    transmission   -- ZF 8HP50/75, including its cooling\n    transfer_case  -- Magna Q4 active on-demand transfer case\n    differentials  -- front and rear, as sub-dicts \"front\" / \"rear\", plus\n                       section-level \"specs\"/\"torques\" combining both\n    driveline      -- propshaft/driveshaft, CV axles, hub nuts\n    mounts         -- engine and transmission mounts\n\n``SPECS``, ``TORQUES`` and ``JOBS`` below are flat views of the same rows\n(every row carries its own ``section`` key), for callers that want one table\nrather than the sectioned view.\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom typing import Any, Iterable, Optional\n\nCONFIRMED = \"CONFIRMED\"\nCORROBORATED = \"CORROBORATED\"\nSINGLE_SOURCE = \"SINGLE-SOURCE\"\nUNKNOWN = \"UNKNOWN\"\n\nCONFIDENCE_LEVELS = (CONFIRMED, CORROBORATED, SINGLE_SOURCE, UNKNOWN)\n\nTECHAUTHORITY = \"use the service manual (TechAuthority)\"\n\nVEHICLE = (\"2018 Alfa Romeo Stelvio 2.0T (GU), 2.0L GME-T4 turbo I4, sales \"\n           \"code EC2, US market, Magna Q4 AWD, ZF 8HP50 automatic (MES: \"\n           \"'ZF 8HP50/75')\")\n\nNM_PER_LBFT = 1.35582\nLBFT_PER_NM = 0.737562149\n\n\ndef nm_to_lbft(nm: Optional[float]) -> Optional[float]:\n    if nm is None:\n        return None\n    return round(nm * LBFT_PER_NM, 1)\n\n\ndef lbft_to_nm(lbft: Optional[float]) -> Optional[float]:\n    if lbft is None:\n        return None\n    return round(lbft * NM_PER_LBFT, 1)\n\n\n# ---------------------------------------------------------------------------\n# TORQUES -- row shape matches service_specs.py's _torque() output exactly,\n# plus a \"section\" key.\n# ---------------------------------------------------------------------------\n\nTORQUES: list[dict[str, Any]] = []\n\n\ndef _torque(section: str, key: str, component: str, categories: Iterable[str],\n            value: Optional[float], unit: Optional[str], *,\n            value_range: Optional[tuple[float, float]] = None,\n            angle: Optional[str] = None, single_use: bool = False,\n            source: Optional[str] = None, confidence: str = UNKNOWN,\n            notes: str = \"\", platform_note: Optional[str] = None,\n            display: Optional[str] = None) -> None:\n    if confidence not in CONFIDENCE_LEVELS:\n        raise ValueError(f\"bad confidence {confidence!r}\")\n    value_nm = value if unit == \"Nm\" else (lbft_to_nm(value) if unit == \"lb-ft\" else None)\n    value_lbft = value if unit == \"lb-ft\" else (nm_to_lbft(value) if unit == \"Nm\" else None)\n    if not notes and confidence == UNKNOWN:\n        notes = TECHAUTHORITY\n    TORQUES.append({\n        \"section\": section,\n        \"key\": key,\n        \"component\": component,\n        \"categories\": tuple(categories),\n        \"value\": value,\n        \"unit\": unit,\n        \"value_nm\": value_nm,\n        \"value_lbft\": value_lbft,\n        \"value_range\": value_range,\n        \"display\": display or (f\"{value} {unit}\" if value is not None else \"UNKNOWN\"),\n        \"angle\": angle,\n        \"single_use\": single_use,\n        \"source\": source,\n        \"confidence\": confidence,\n        \"notes\": notes.strip(),\n        \"platform_note\": platform_note,\n    })\n\n\n# --- 1. transmission (ZF 8HP50/75) ------------------------------------------\n\n_torque(\"transmission\", \"transmission_pan_bolts\",\n        \"ZF 8HP pan/filter assembly bolts (13x)\", [\"transmission\"],\n        10, \"Nm\",\n        source=\"docs/reference/ZF8HP_SERVICE_DATA.md (ZF doc 1087.754.107c)\",\n        confidence=CONFIRMED,\n        notes=\"Integrated pan/filter assembly, not separately serviceable; \"\n              \"gasket reusable if undamaged. No bolt sequence stated in the \"\n              \"source doc.\")\n\n_torque(\"transmission\", \"transmission_drain_plug\",\n        \"ZF 8HP transmission fluid drain plug\", [\"transmission\"],\n        None, \"Nm\", confidence=UNKNOWN,\n        notes=\"Giorgio-specific value not found. \" + TECHAUTHORITY)\n\n_torque(\"transmission\", \"transmission_fill_plug\",\n        \"ZF 8HP transmission fluid fill/level plug\", [\"transmission\"],\n        None, \"Nm\", confidence=UNKNOWN,\n        notes=\"Giorgio-specific value not found; the 4th-gen 8HP fill/level \"\n              \"check requires an OEM scan-tool routine, not a manual \"\n              \"plug-and-check, per docs/reference/ZF8HP_SERVICE_DATA.md #1. \"\n              + TECHAUTHORITY)\n\n_torque(\"transmission\", \"bmw_mechatronics_bolts\",\n        \"BMW G30 reference: mechatronics-to-transmission bolts M6x59/M6x20\",\n        [\"transmission\"], 8, \"Nm\", single_use=True,\n        source=\"docs/reference/ZF8HP_SERVICE_DATA.md (BMW G30 service info)\",\n        confidence=CORROBORATED,\n        notes=\"Sequence 1->17; screws replaced every time. BMW 8HP family -- \"\n              \"NOT independently confirmed for Giorgio.\",\n        platform_note=\"BMW G30, not Alfa-specific.\")\n\n_torque(\"transmission\", \"bmw_output_speed_sensor\",\n        \"BMW G30 reference: output speed sensor\", [\"transmission\"],\n        4, \"Nm\", angle=\"+12 deg\",\n        source=\"docs/reference/ZF8HP_SERVICE_DATA.md (BMW G30 service info)\",\n        confidence=CORROBORATED,\n        notes=\"BMW 8HP family -- NOT independently confirmed for Giorgio.\",\n        platform_note=\"BMW G30, not Alfa-specific.\")\n\n_torque(\"transmission\", \"bmw_pan_bolts\",\n        \"BMW G30 reference: pan bolts M6 (13x)\", [\"transmission\"],\n        10, \"Nm\", single_use=True,\n        source=\"docs/reference/ZF8HP_SERVICE_DATA.md (BMW G30 service info)\",\n        confidence=CORROBORATED,\n        notes=\"Sequence 1->13; pan itself must be replaced each time it is \"\n              \"released. BMW 8HP family -- NOT independently confirmed for \"\n              \"Giorgio, whose pan/filter is documented as an integrated \"\n              \"non-serviceable assembly in the FCA text.\",\n        platform_note=\"BMW G30, not Alfa-specific.\")\n\n_torque(\"transmission\", \"bmw_drain_plug\",\n        \"BMW G30 reference: drain plug M18\", [\"transmission\"],\n        8, \"Nm\",\n        source=\"docs/reference/ZF8HP_SERVICE_DATA.md (BMW G30 service info)\",\n        confidence=CORROBORATED,\n        notes=\"BMW 8HP family -- NOT independently confirmed for Giorgio.\",\n        platform_note=\"BMW G30, not Alfa-specific.\")\n\n# --- 2. transfer case (Magna Q4) --------------------------------------------\n\n_torque(\"transfer_case\", \"transfer_case_drain_plug\",\n        \"Transfer case (Q4) drain plug\", [\"transfer_case\"],\n        None, \"Nm\", confidence=UNKNOWN,\n        notes=\"A stelvioforum thread asking this exact question cites the \"\n              \"rear differential's 26 Nm as known but leaves the transfer \"\n              \"case itself as an open, unanswered question -- do not assume \"\n              \"'probably the same as the diff', that is speculation, not a \"\n              \"source. \" + TECHAUTHORITY,\n        source=\"https://www.stelvioforum.com/threads/transfer-case-drain-fill-plug-torque-specs.24693/\")\n\n_torque(\"transfer_case\", \"transfer_case_fill_plug\",\n        \"Transfer case (Q4) fill plug\", [\"transfer_case\"],\n        None, \"Nm\", confidence=UNKNOWN,\n        notes=\"Same open question as transfer_case_drain_plug. \" + TECHAUTHORITY,\n        source=\"https://www.stelvioforum.com/threads/transfer-case-drain-fill-plug-torque-specs.24693/\")\n\n# --- 3. differentials --------------------------------------------------------\n\n_torque(\"differentials\", \"front_diff_drain_plug\",\n        \"Front differential drain plug\", [\"differential\", \"front\"],\n        None, \"Nm\", confidence=UNKNOWN,\n        notes=\"Not found. \" + TECHAUTHORITY)\n\n_torque(\"differentials\", \"front_diff_fill_plug\",\n        \"Front differential fill plug\", [\"differential\", \"front\"],\n        None, \"Nm\", confidence=UNKNOWN,\n        notes=\"Not found. \" + TECHAUTHORITY)\n\n_torque(\"differentials\", \"rear_diff_drain_plug\",\n        \"Rear differential (rear axle) drain plug\", [\"differential\", \"rear\"],\n        26, \"Nm\",\n        source=\"https://www.stelvioforum.com/threads/transfer-case-drain-fill-plug-torque-specs.24693/\",\n        confidence=SINGLE_SOURCE,\n        notes=\"Stated as known/given by the original poster in a thread \"\n              \"actually asking about the transfer case plug; not \"\n              \"independently corroborated elsewhere.\")\n\n_torque(\"differentials\", \"rear_diff_fill_plug\",\n        \"Rear differential (rear axle) fill plug\", [\"differential\", \"rear\"],\n        26, \"Nm\",\n        source=\"https://www.stelvioforum.com/threads/transfer-case-drain-fill-plug-torque-specs.24693/\",\n        confidence=SINGLE_SOURCE,\n        notes=\"Same source as rear_diff_drain_plug; drain and fill plugs \"\n              \"are commonly the same fastener spec on this style of axle, \"\n              \"but that has not been independently confirmed as true here.\")\n\n# --- 4. driveline (propshaft, CV axles, hub nuts) ---------------------------\n\n_torque(\"driveline\", \"propshaft_flange_nut\",\n        \"Propshaft flange/centre-carrier nut\", [\"driveline\"],\n        None, \"Nm\",\n        source=\"none for the Giorgio platform -- use the service manual (TechAuthority)\",\n        confidence=UNKNOWN,\n        notes=\"DO NOT USE the 72-101 lb-ft figure that circulates online: fact-check \"\n              \"(2026-09-26) traced it to the 1970s Alfa 2000 shop manual (10-14 m-kg), a \"\n              \"different car and driveline, not the Stelvio's Q4 propshaft. Use the FCA \"\n              \"service manual value for this VIN.\",\n        display=\"UNKNOWN - use service manual\")\n\n_torque(\"driveline\", \"q4_central_m14_bolt\",\n        \"Central M14 bolt, Q4 (4x4) versions\", [\"driveline\", \"mounts\"],\n        None, \"Nm\", value_range=(124, 136),\n        source=\"forum synthesis (alfaowner.com)\",\n        confidence=SINGLE_SOURCE,\n        notes=\"Location not independently confirmed -- possibly a \"\n              \"front-driveline or subframe pivot fastener unique to AWD \"\n              \"cars; may instead be an engine-mount-to-subframe pivot bolt \"\n              \"(see the mounts section's identical entry). Not resolved \"\n              \"which fastener this actually is.\",\n        display=\"124-136 Nm\")\n\n_torque(\"driveline\", \"axle_hub_nut\",\n        \"Front/rear axle (hub) nut\", [\"driveline\"],\n        52, \"lb-ft\", angle=\"+47 deg\", single_use=True,\n        source=\"stelvioforum.com forum synthesis\",\n        confidence=SINGLE_SOURCE,\n        notes=\"Torque-then-angle procedure; always fit a NEW nut.\")\n\n_torque(\"driveline\", \"hub_mount_bolts\",\n        \"Front/rear hub mounting bolts\", [\"driveline\"],\n        74, \"lb-ft\",\n        source=\"forum synthesis (stelvioforum.com)\",\n        confidence=SINGLE_SOURCE,\n        notes=\"\")\n\n_torque(\"driveline\", \"wheel_lug_reference\",\n        \"Wheel lug bolts (reference only, not a drivetrain fastener)\",\n        [\"driveline\"], 89, \"lb-ft\",\n        source=\"forum synthesis (giuliaforums.com/alfaowner.com)\",\n        confidence=SINGLE_SOURCE,\n        notes=\"Included for completeness only; see service_specs.py's own \"\n              \"wheel_lug row (121 Nm / CORROBORATED) for the vetted figure \"\n              \"used by the general service ledger -- the two were not \"\n              \"reconciled against each other in this pass.\")\n\n# --- 5. mounts (engine and transmission) ------------------------------------\n\n_torque(\"mounts\", \"engine_mount_bolts\",\n        \"Engine mount bolts into aluminium block\", [\"mounts\"],\n        None, \"Nm\", value_range=(22, 27),\n        source=\"forum synthesis (alfaowner.com)\",\n        confidence=SINGLE_SOURCE,\n        notes=\"\",\n        display=\"22-27 Nm\")\n\n_torque(\"mounts\", \"longitudinal_mount_bolts\",\n        \"Longitudinal mount (torque strut / dogbone) bolts\", [\"mounts\"],\n        None, \"Nm\", value_range=(25, 31), single_use=True,\n        source=\"forum synthesis (alfaowner.com); aftermarket install-\"\n               \"instruction PDF (binary/encoded, not text-extractable this pass)\",\n        confidence=SINGLE_SOURCE,\n        notes=\"Alfa Romeo specifies the mount itself must be replaced on \"\n              \"removal, not just the bolts.\",\n        display=\"25-31 Nm\")\n\n_torque(\"mounts\", \"q4_central_m14_bolt_mounts\",\n        \"Central M14 bolt, Q4 versions (mounts-context duplicate)\",\n        [\"mounts\", \"driveline\"], None, \"Nm\", value_range=(124, 136),\n        source=\"forum synthesis (alfaowner.com)\",\n        confidence=SINGLE_SOURCE,\n        notes=\"Same figure and same unresolved-location caveat as \"\n              \"driveline's q4_central_m14_bolt -- kept here too since which \"\n              \"section it truly belongs to was not resolved this pass.\",\n        display=\"124-136 Nm\")\n\n_torque(\"mounts\", \"trans_mount_bracket_fasteners\",\n        \"Transmission-bracket-to-transmission-case fasteners\", [\"mounts\"],\n        None, \"Nm\", single_use=True,\n        source=\"forum synthesis (alfaowner.com), citing an unidentified FCA TSB\",\n        confidence=SINGLE_SOURCE,\n        notes=\"Fasteners reported one-time-use per a referenced TSB for the \"\n              \"2021 Stelvio; bulletin number not independently verified \"\n              \"this pass, and no torque value was found. \" + TECHAUTHORITY)\n\n\ndef torque_by_key(key: str) -> Optional[dict[str, Any]]:\n    for t in TORQUES:\n        if t[\"key\"] == key:\n            return dict(t)\n    return None\n\n\ndef torques_for_section(section: str) -> list[dict[str, Any]]:\n    return [dict(t) for t in TORQUES if t[\"section\"] == section]\n\n\n# ---------------------------------------------------------------------------\n# SPECS -- non-torque facts (fluids, capacities, intervals, DIDs, ...).\n# No equivalent list exists in service_specs.py to match; shape is this\n# module's own, but deliberately close (key/component/categories/confidence).\n# ---------------------------------------------------------------------------\n\nSPECS: list[dict[str, Any]] = []\n\n\ndef _spec(section: str, key: str, component: str, categories: Iterable[str],\n          value: str, unit: str = \"\", *, source: str = \"\",\n          confidence: str = UNKNOWN, notes: str = \"\") -> None:\n    if confidence not in CONFIDENCE_LEVELS:\n        raise ValueError(f\"bad confidence {confidence!r}\")\n    if not notes and confidence == UNKNOWN:\n        notes = TECHAUTHORITY\n    SPECS.append({\n        \"section\": section,\n        \"key\": key,\n        \"component\": component,\n        \"categories\": tuple(categories),\n        \"value\": value,\n        \"unit\": unit,\n        \"source\": source,\n        \"confidence\": confidence,\n        \"notes\": notes,\n    })\n\n\n# --- 1. transmission ---------------------------------------------------------\n\n_spec(\"transmission\", \"fluid_identity\", \"ZF 8HP transmission fluid\",\n      [\"transmission\", \"fluid\"],\n      \"ZF LifeguardFluid 8 / Mopar '8 & 9 Speed ATF', P/N 68218925AA -- \"\n      \"NOT compatible with ATF+4 or any other current FCA ATF\", \"\",\n      source=\"docs/reference/ZF8HP_SERVICE_DATA.md #1 (ZF doc 1087.754.107c); \"\n             \"giuliaforums.com 'How-To: ZF 8HP50/75 Fluid and Filter Change'\",\n      confidence=CORROBORATED,\n      notes=\"Fluid identity/incompatibility CONFIRMED via repo doc; the \"\n            \"Mopar part number itself is SINGLE-SOURCE.\")\n\n_spec(\"transmission\", \"dry_fill_capacity\", \"ZF 8HP overhaul dry fill\",\n      [\"transmission\", \"fluid\"], \"9.0 (9.5 qt); +0.7 if cooler replaced\", \"L\",\n      source=\"docs/reference/ZF8HP_SERVICE_DATA.md #1 (ZF doc 1087.754.107c, Table 1)\",\n      confidence=CONFIRMED,\n      notes=\"Poured through the side plug, unit tipped, before installation.\")\n\n_spec(\"transmission\", \"owner_manual_capacity\",\n      \"ZF 8HP owner/service-manual capacity, 2.0 AWD\",\n      [\"transmission\", \"fluid\"], \"9.3 (9.8 qt)\", \"L\",\n      source=\"giuliatech.com/t/alfa-romeo-giulia-fluid-specs-and-capacities/91\",\n      confidence=SINGLE_SOURCE,\n      notes=\"Close to but not reconciled with the 9.0 L ZF dry-fill figure.\")\n\n_spec(\"transmission\", \"service_fill_quantity\",\n      \"ZF 8HP service drain-and-fill (pan drop) quantity\",\n      [\"transmission\", \"fluid\"],\n      \"not established -- 'a few quarts' pan volume + 0.5 L overfill during level check\",\n      \"L\", source=\"giuliaforums.com 'How-To' thread\", confidence=UNKNOWN,\n      notes=\"Forum practice, not an OEM spec. \" + TECHAUTHORITY)\n\n_spec(\"transmission\", \"fill_temp_window\", \"ZF 8HP fill/level-check temperature window\",\n      [\"transmission\", \"fluid\"], \"30-50 (86-122 F)\", \"°C\",\n      source=\"docs/reference/ZF8HP_SERVICE_DATA.md #1\", confidence=CONFIRMED,\n      notes=\"General 8HP family window; matches this car's family per ZF \"\n            \"Table 1 and FCA OEM text.\")\n\n_spec(\"transmission\", \"level_check_procedure\", \"ZF 8HP level-check procedure\",\n      [\"transmission\", \"fluid\"],\n      \"ZF: engine running, P, 2000rpm 30s, idle, cycle P-R-D-1-2 >=10s dwell \"\n      \"each, P, check temp+plug. FCA equivalent: fill, R 5s, D 5s, \"\n      \"accelerate 2nd 5s, N@2000rpm 5s, P.\", \"\",\n      source=\"docs/reference/ZF8HP_SERVICE_DATA.md #1 (ZF doc Section 5)\",\n      confidence=CONFIRMED,\n      notes=\"4th-gen 8HP (this box) requires an OEM scan-tool routine -- no \"\n            \"manual plug procedure exists.\")\n\n_spec(\"transmission\", \"pan_filter\", \"ZF 8HP pan/filter\", [\"transmission\"],\n      \"integrated assembly, not separately serviceable; gasket reusable if undamaged\",\n      \"\", source=\"docs/reference/ZF8HP_SERVICE_DATA.md #1\", confidence=CONFIRMED)\n\n_spec(\"transmission\", \"interval_fca\", \"ZF 8HP service interval, FCA position\",\n      [\"transmission\", \"interval\"], \"no FCA-published mileage number found this pass\",\n      \"\", confidence=UNKNOWN,\n      notes=\"The 2018 US owner's manual Maintenance Plan lists no automatic \"\n            \"transmission fluid change (checked 2026-09-26). \" + TECHAUTHORITY)\n\n_spec(\"transmission\", \"interval_zf\", \"ZF 8HP service interval, ZF generic guidance\",\n      [\"transmission\", \"interval\"], \"50000-75000\", \"mi\",\n      source=\"forum synthesis (ZF-attributed)\", confidence=SINGLE_SOURCE,\n      notes=\"Forum-attributed to ZF; not FCA/owner's-manual sourced.\")\n\n_spec(\"transmission\", \"interval_severe\", \"ZF 8HP severe-duty guidance\",\n      [\"transmission\", \"interval\"], \"not found for this vehicle\", \"\",\n      confidence=UNKNOWN, notes=TECHAUTHORITY)\n\n_spec(\"transmission\", \"adaptation_relearn\", \"ZF 8HP adaptation relearn after service\",\n      [\"transmission\", \"adaptation\"],\n      \"Fast Filling Adaptation + Standard Clutch Filling Adaptation via \"\n      \"wiTECH; MES: QUICK LEARN / STATIC ADAPTATION (STADA) + separate \"\n      \"RESET ADAPTIVE VALUES\", \"\",\n      source=\"docs/reference/ZF8HP_SERVICE_DATA.md #5-7\", confidence=CONFIRMED,\n      notes=\"Not required for a routine fluid+filter change; not required \"\n            \"after a TCM/TCMA re-flash alone; NOT lost on battery \"\n            \"disconnect (non-volatile EEPROM).\")\n\n_spec(\"transmission\", \"cooler\", \"ZF 8HP cooler\", [\"transmission\", \"cooling\"],\n      \"oil-to-coolant heat exchanger with thermostatic element (keeps box \"\n      \"warm for warm-up/emissions)\", \"\",\n      source=\"docs/research/TRANSMISSION_ZF8HP_Q4.md #6\", confidence=CONFIRMED,\n      notes=\"Track-only bypass is a modification, not a service step.\")\n\n_spec(\"transmission\", \"oil_temp_did\", \"Gearbox oil temperature -- live DID\",\n      [\"transmission\", \"cooling\", \"live_data\"],\n      \"TCM DID 04FE, header 18DA18F1, formula A-40\", \"°C\",\n      source=\"docs/reference/GIORGIO_MODULE_MAP.md Table C; \"\n             \"cuore/live/addressing.py:674-683; cuore/live/ops.py:485-496\",\n      confidence=SINGLE_SOURCE,\n      notes=\"Implemented as DidSpec(module='TCM', did=0x04FE, ...) in \"\n            \"cuore/live/addressing.py. Read live via \"\n            \"cuore.live.ops.module_did('TCM', '04FE', vin=<VIN>), or the \"\n            \"obd2 MCP 'read_did' tool against module TCM, DID 0x04FE. \"\n            \"Formula is UNVERIFIED on this 2.0T specifically (sourced from \"\n            \"a 2.2D Giulia PID repo) -- confirm against this car's own scan.\")\n\nTRANSMISSION_DTCS: list[tuple[str, str]] = [\n    (\"P1DB7-00\", \"TCC Performance (functional equivalent of P0741; \"\n                 \"P0740/P0741/P0742 do not exist on 8HP)\"),\n    (\"P0731-P0735,P0729,P076F,P07D9\", \"Per-gear ratio error, non-contiguous \"\n                                       \"numbering (gears 1-8)\"),\n    (\"P1D8F-P1D93,P1D96-P1D9F,P1DA0-P1DA8,P1D95\",\n     \"Clutch-resolved ratio faults: single/pair/triplet/undetermined\"),\n    (\"P1731\", \"Incorrect Gear Engaged; turbine slip > 300 RPM is the only \"\n              \"published hard threshold\"),\n    (\"P167A\", \"Calibration Mismatch (software vs Hydraulic ID in TCMA EEPROM)\"),\n    (\"P1DC6\", \"TCM Not Programmed\"),\n    (\"P0610,U3002-00\", \"VIN mismatch after TCM replacement\"),\n    (\"P1500\", \"Vehicle configuration (PROXI) mismatch\"),\n    (\"P07E4,P1DB2,P0716,P1B14,P0733,P1D90,P1DB7,P1B13\",\n     \"Master 8HP shift-quality/valve-body TSB code set\"),\n]\n\nTRANSMISSION_TSBS: list[dict[str, Any]] = [\n    {\n        \"number\": \"21-035-20\", \"date\": \"2020-05-08\",\n        \"applies_to_this_car\": True,\n        \"summary\": \"Flash: TCM Update. Applies explicitly to 2018 (GU) \"\n                    \"Stelvio, 2.0L I4 DI Turbo (EC2), North America. Fixes \"\n                    \"MIL w/ P0002-00, P026E-00, P1066-00, P26E4-00, \"\n                    \"P2B61-00, P2BC1-00, U1008-00; transmission shift-\"\n                    \"quality improvements; turbo coolant-pump after-run \"\n                    \"update. Labor op 18-19-05-MX, 0.3 hr. PCM must also be \"\n                    \"updated to latest at completion.\",\n        \"source\": \"static.nhtsa.gov/odi/tsbs/2020/MC-10176569-9999.pdf (fetched directly)\",\n        \"confidence\": CONFIRMED,\n    },\n    {\n        \"number\": \"21-044-19\", \"date\": \"2019-12-17\",\n        \"applies_to_this_car\": False,\n        \"summary\": \"Flash: TCM Update. Applies to 2019 (GU) Stelvio built \"\n                    \"on/before 2019-10-10 -- not this car's model year. Same \"\n                    \"symptom/DTC set and shift-quality fix, prior software \"\n                    \"revision. Labor op 18-19-05-MU.\",\n        \"source\": \"static.nhtsa.gov/odi/tsbs/2019/MC-10170397-9999.pdf (fetched directly)\",\n        \"confidence\": CONFIRMED,\n    },\n    {\n        \"number\": \"S2621000003 REV. A\", \"date\": \"2026-03-09\",\n        \"applies_to_this_car\": True,\n        \"summary\": \"8HP master TSB, 2017-2026 Giulia (GA) and 2018-2026 \"\n                    \"Stelvio (GU), covers 8HP45/50/70/75/90/95. Burnt-fluid \"\n                    \"smell / fine metallic content normal. Valve body \"\n                    \"replacement before transmission replacement. \"\n                    \"P1B13/P1B14 -> check MPR cable. P0733 -> 21-029-25 \"\n                    \"REV. A (8HP75 clutch-D repair, not this car's box size).\",\n        \"source\": \"docs/reference/TSB_CATALOGUE.md #3\",\n        \"confidence\": CONFIRMED,\n    },\n]\n\n# --- 2. transfer case ---------------------------------------------------------\n\n_spec(\"transfer_case\", \"behaviour\", \"Q4 transfer case behaviour\",\n      [\"transfer_case\", \"architecture\"],\n      \"rear-biased; 100% rear normally, on-demand up to 60% front via \"\n      \"controlled clutch (not a centre differential)\", \"\",\n      source=\"docs/research/TRANSMISSION_ZF8HP_Q4.md #5\", confidence=CONFIRMED)\n\n_spec(\"transfer_case\", \"actuator_architecture\", \"Q4 actuator architecture\",\n      [\"transfer_case\", \"architecture\"],\n      \"hypothesis: electric-motor-driven ball ramp applying a multi-plate \"\n      \"wet clutch (Magna Active Transfer Case pattern, shared with BMW \"\n      \"xDrive / Jeep Active Drive)\", \"\",\n      source=\"docs/research/TRANSMISSION_ZF8HP_Q4.md #5\", confidence=UNKNOWN,\n      notes=\"Resolve via MES DTCM parameter-name read per repo doc's method.\")\n\n_spec(\"transfer_case\", \"fluid_identity\", \"Q4 transfer case fluid\",\n      [\"transfer_case\", \"fluid\"],\n      \"Petronas Tutela Transmission Transfer Case (Q4) -- Tutela \"\n      \"Transmission Hypoide Gear Oil, Synthetic SAE 75W, FIAT approval \"\n      \"9.55550-DA11\", \"\",\n      source=\"docs/research/TRANSMISSION_ZF8HP_Q4.md #5; giuliatech.com \"\n             \"fluid-specs table (independent second source, same FIAT number)\",\n      confidence=CORROBORATED,\n      notes=\"Do not substitute ATF or generic 75W GL-5; friction \"\n            \"characteristics matched to the clutch pack.\")\n\n_spec(\"transfer_case\", \"capacity\", \"Q4 transfer case capacity\",\n      [\"transfer_case\", \"fluid\"],\n      \"conflicting: ~1 L (repo doc) vs 0.7 L (giuliatech.com)\", \"L\",\n      source=\"docs/research/TRANSMISSION_ZF8HP_Q4.md #5; giuliatech.com\",\n      confidence=SINGLE_SOURCE,\n      notes=\"Unreconciled -- confirm exact fill quantity at dealer parts \"\n            \"counter by VIN or in TechAuthority before doing the job.\")\n\n_spec(\"transfer_case\", \"interval\", \"Q4 transfer case service interval\",\n      [\"transfer_case\", \"interval\"], \"80000 mi (128000 km) / 8 years\", \"\",\n      source=\"https://vehicleinfo.mopar.com/assets/publications/en-us/Alfa_Romeo/2018/Stelvio/P124461_18_GU_OM_EN_USC_DIGITAL_2nd_V2.pdf\", confidence=CONFIRMED,\n      notes=\"2018 Stelvio US owner's manual, Maintenance Plan (2.0 T4 MAir), row \"\n            \"'Replace transfer case oil (AWD models only)': one mandatory mark in the \"\n            \"80k mi / 128k km / year-8 column (read from the PDF's column positions, \"\n            \"2026-09-26). This car is past that mileage: due unless already done.\")\n\n_spec(\"transfer_case\", \"adj_routine\", \"DTCM ADJ routine\", [\"transfer_case\", \"adaptation\"],\n      \"hypothesis: actuator position / clutch-clearance learn, drives to \"\n      \"mechanical end stops and records encoder positions\", \"\",\n      source=\"docs/research/TRANSMISSION_ZF8HP_Q4.md #5\", confidence=UNKNOWN,\n      notes=\"Read the MES procedure text before running; do NOT run with \"\n            \"vehicle on the ground or on a single-axle dyno.\")\n\n_spec(\"transfer_case\", \"torque_split_tuning\", \"Q4 torque-split calibration availability\",\n      [\"transfer_case\", \"tuning\"],\n      \"almost certainly not available -- no tool ecosystem lists a Giorgio DTCM\", \"\",\n      source=\"docs/research/TRANSMISSION_ZF8HP_Q4.md #1, #5\", confidence=SINGLE_SOURCE)\n\nTRANSFER_CASE_DTCS: list[tuple[str, str]] = [\n    (\"U0100-87\", \"Lost Comm with ECM -- observed as a bystander code from \"\n                 \"whole-vehicle serial UDS sweeps on this exact car's own \"\n                 \"scan (SCAN_2609041953), not a real fault\"),\n    (\"U0102\", \"Lost Communication With Transfer Case Control Module/AWD on \"\n              \"a RWD car -- configuration fault (AWD software on RWD \"\n              \"vehicle) after ECM replace/flash; NOT applicable to a \"\n              \"factory Q4 car, listed for completeness\"),\n]\n\n# --- 3. differentials ---------------------------------------------------------\n\n_spec(\"differentials\", \"front_fluid_identity\", \"Front differential fluid\",\n      [\"differential\", \"front\", \"fluid\"],\n      \"SAE 75W-80, API GL-5, synthetic, FIAT approval 9.55550-DA10\", \"\",\n      source=\"giuliatech.com fluid-specs table\", confidence=SINGLE_SOURCE)\n\n_spec(\"differentials\", \"front_capacity_20t\", \"Front differential capacity, 2.0T\",\n      [\"differential\", \"front\", \"fluid\"], \"0.5\", \"L\",\n      source=\"giuliatech.com\", confidence=SINGLE_SOURCE)\n\n_spec(\"differentials\", \"front_capacity_qv\", \"Front differential capacity, 2.9 QV (reference only)\",\n      [\"differential\", \"front\", \"fluid\"], \"0.45\", \"L\",\n      source=\"giuliatech.com\", confidence=SINGLE_SOURCE,\n      notes=\"Reference only, not this car.\")\n\n_spec(\"differentials\", \"front_interval\", \"Front differential service interval\",\n      [\"differential\", \"front\", \"interval\"],\n      \"anecdotally lasts to ~100000 km without visible wear\", \"km\",\n      source=\"forum synthesis (giuliaforums.com/stelvioforum.com)\",\n      confidence=SINGLE_SOURCE, notes=\"Not an OEM schedule.\")\n\n_spec(\"differentials\", \"front_lsd_additive\", \"Front differential LSD additive\",\n      [\"differential\", \"front\", \"fluid\"],\n      \"not applicable -- fixed-ratio open unit on 2.0T Q4, no front LSD option found\",\n      \"\", confidence=SINGLE_SOURCE,\n      notes=\"Inference from architecture (Q4 clutch does front torque \"\n            \"modulation, not a front LSD).\")\n\n_spec(\"differentials\", \"rear_fluid_identity_20t\",\n      \"Rear differential fluid, 2.0T variants (195 open / 230-LSD / 210-eLSD)\",\n      [\"differential\", \"rear\", \"fluid\"],\n      \"SAE 75W-85, synthetic, FIAT approval 9.55550-DA9\", \"\",\n      source=\"giuliatech.com fluid-specs table\", confidence=SINGLE_SOURCE)\n\n_spec(\"differentials\", \"rear_fluid_identity_qv\",\n      \"Rear differential fluid, 2.9 QV torque-vectoring 230-TV (reference only)\",\n      [\"differential\", \"rear\", \"fluid\"],\n      \"SAE 75W-85, API GL-5, synthetic, FIAT approval 9.55550-DA8\", \"\",\n      source=\"giuliatech.com\", confidence=SINGLE_SOURCE,\n      notes=\"Reference only, not this car.\")\n\n_spec(\"differentials\", \"rear_capacity_20t\", \"Rear differential capacity, 2.0T variants\",\n      [\"differential\", \"rear\", \"fluid\"],\n      \"0.9-1.1 (varies by internal type: 195 / 230-LSD / 210-eLSD)\", \"L\",\n      source=\"giuliatech.com\", confidence=SINGLE_SOURCE)\n\n_spec(\"differentials\", \"rear_capacity_qv\",\n      \"Rear differential capacity, 2.9 QV TV (reference only)\",\n      [\"differential\", \"rear\", \"fluid\"],\n      \"main 0.8 + left TV 0.5 + right TV 0.6 (Giulia) or 0.61-0.68 (Stelvio); \"\n      \"3-chamber unit\", \"L\",\n      source=\"giuliatech.com\", confidence=SINGLE_SOURCE, notes=\"Reference only, not this car.\")\n\n_spec(\"differentials\", \"rear_interval\", \"Rear differential service interval\",\n      [\"differential\", \"rear\", \"interval\"],\n      \"~50000-60000 (rear wears faster than front per forum guidance)\", \"km\",\n      source=\"forum synthesis\", confidence=SINGLE_SOURCE, notes=\"Not an OEM schedule.\")\n\n_spec(\"differentials\", \"rear_which_unit_fitted\",\n      \"Rear differential trim/option (which unit is fitted to this VIN)\",\n      [\"differential\", \"rear\", \"identification\"],\n      \"depends on trim/options: open 195 / mechanical-LSD 230-LSD / \"\n      \"electronic 210-eLSD; Ti Sport and Q4-package cars most likely carry \"\n      \"the LSD/eLSD unit\", \"\",\n      source=\"user-provided trim context; giuliatech.com option-code naming\",\n      confidence=UNKNOWN,\n      notes=\"Decode the build sheet / option codes, or confirm at a dealer \"\n            \"parts counter by VIN, before ordering fluid or parts for THIS car.\")\n\n_spec(\"differentials\", \"rear_lsd_additive\", \"Rear differential LSD additive (230-LSD unit)\",\n      [\"differential\", \"rear\", \"fluid\"],\n      \"not found as a separate additive requirement; unconfirmed whether \"\n      \"the listed fluid is already friction-modified\", \"\",\n      confidence=UNKNOWN,\n      notes=\"Do not assume a standard GL-5 is friction-safe for the LSD \"\n            \"unit without checking. \" + TECHAUTHORITY)\n\n# --- 4. driveline --------------------------------------------------------------\n\n_spec(\"driveline\", \"propshaft_construction\", \"Propshaft material/construction\",\n      [\"driveline\", \"identification\"],\n      \"referenced as a carbon-fibre driveshaft on 2017-2025 Giulia/Stelvio \"\n      \"by an aftermarket parts vendor (page body could not be fully retrieved)\",\n      \"\", source=\"go-parts.com garage article (title/metadata only, HTTP 403 on body fetch)\",\n      confidence=SINGLE_SOURCE,\n      notes=\"Confirm construction (steel vs carbon-fibre, one- vs two-piece \"\n            \"with centre bearing) against the parts catalogue for this VIN \"\n            \"before ordering.\")\n\n_spec(\"driveline\", \"propshaft_centre_bearing\", \"Propshaft centre support bearing\",\n      [\"driveline\", \"identification\"], \"not confirmed present or absent\", \"\",\n      confidence=UNKNOWN)\n\n_spec(\"driveline\", \"front_flex_disc\", \"Front flex disc / coupling\",\n      [\"driveline\", \"identification\"],\n      \"bolts possibly torque-to-yield, requiring replacement\", \"\",\n      source=\"forum synthesis (alfabb.com)\", confidence=SINGLE_SOURCE)\n\nDRIVELINE_ISSUES: list[tuple[str, str]] = [\n    (\"front flex-disc bolts\", \"may be torque-to-yield; must be replaced, not reused\"),\n    (\"PTU/stubshaft seal (9004150)\", \"if replacing the stubshaft for an ATX \"\n                                     \"fluid leak, do NOT also replace the PTU seals\"),\n    (\"no TSB addresses propshaft failure\", \"explicit finding from the full TSB corpus sweep\"),\n]\n\n# --- 5. mounts -----------------------------------------------------------------\n\nMOUNTS_ISSUES: list[tuple[str, str]] = [\n    (\"transmission mount clunk/vibration\",\n     \"referenced as a common complaint by an aftermarket parts vendor's \"\n     \"diagnostic guide for 2017-2025 Giulia/Stelvio/Grecale 2.0L (page body \"\n     \"could not be retrieved, HTTP 403) -- treat as a plausible lead, not a \"\n     \"confirmed failure pattern\"),\n]\n\n\ndef specs_for_section(section: str) -> list[dict[str, Any]]:\n    return [dict(s) for s in SPECS if s[\"section\"] == section]\n\n\n# ---------------------------------------------------------------------------\n# JOBS -- job name -> ordered steps, each with an optional torque checkpoint\n# (referencing a TORQUES row's \"key\").\n# ---------------------------------------------------------------------------\n\nJOBS: dict[str, list[dict[str, Any]]] = {\n    \"transmission_fluid_service\": [\n        {\"step\": \"Confirm fluid identity: ZF LifeguardFluid 8 / Mopar 68218925AA only, never ATF+4.\",\n         \"torque_ref\": None},\n        {\"step\": \"Warm to 30-50C fill/level window; on this 4th-gen box, level check requires an OEM scan-tool routine.\",\n         \"torque_ref\": None},\n        {\"step\": \"Drop pan/filter (integrated assembly, not separately serviceable).\",\n         \"torque_ref\": None},\n        {\"step\": \"Reinstall pan/filter.\", \"torque_ref\": \"transmission_pan_bolts\"},\n        {\"step\": \"Refill; forum practice overfills ~0.5 L and bleeds back at \"\n                 \"the level-check plug (unverified shop practice, prefer the \"\n                 \"OEM scan-tool fill routine).\", \"torque_ref\": None},\n        {\"step\": \"Torque drain/fill plug.\", \"torque_ref\": \"transmission_drain_plug\"},\n        {\"step\": \"Do NOT run an adaptation reset for a routine fluid-and-filter \"\n                 \"change; not required per OEM text.\", \"torque_ref\": None},\n        {\"step\": \"Clear DTCs, road test, re-scan; check for TSB 21-035-20 \"\n                 \"before condemning hardware.\", \"torque_ref\": None},\n    ],\n    \"transfer_case_service\": [\n        {\"step\": \"Confirm fluid: Tutela Transmission Transfer Case (Q4), SAE \"\n                 \"75W, FIAT 9.55550-DA11. Do not substitute ATF or generic \"\n                 \"75W GL-5.\", \"torque_ref\": None},\n        {\"step\": \"Capacity is unreconciled (0.7 L vs ~1 L) -- confirm exact \"\n                 \"quantity for this VIN before ordering fluid.\", \"torque_ref\": None},\n        {\"step\": \"Torque drain/fill plug.\", \"torque_ref\": \"transfer_case_drain_plug\"},\n        {\"step\": \"Before condemning transfer-case hardware for shudder/bind/\"\n                 \"ratio DTCs, verify tyre circumference match within 1/8\\\" \"\n                 \"across all four tyres (TSB S1821000001 REV. A).\", \"torque_ref\": None},\n        {\"step\": \"If a DTCM ADJ (actuator learn) routine is called for, read \"\n                 \"its MES procedure text first; never run with wheels on the \"\n                 \"ground or on a single-axle dyno.\", \"torque_ref\": None},\n    ],\n    \"differential_service_front\": [\n        {\"step\": \"Fluid: SAE 75W-80 GL-5 synthetic, FIAT 9.55550-DA10, ~0.5 L.\",\n         \"torque_ref\": None},\n        {\"step\": \"Torque fill/drain plug.\", \"torque_ref\": \"front_diff_fill_plug\"},\n    ],\n    \"differential_service_rear\": [\n        {\"step\": \"Decode this VIN's rear differential type first (195 open / \"\n                 \"230-LSD / 210-eLSD) -- fluid and any LSD-additive \"\n                 \"requirement may differ.\", \"torque_ref\": None},\n        {\"step\": \"Fluid: SAE 75W-85 synthetic, FIAT 9.55550-DA9, ~0.9-1.1 L \"\n                 \"depending on internal type.\", \"torque_ref\": None},\n        {\"step\": \"Do not assume a generic 75W-85/90 GL-5 is friction-safe for \"\n                 \"a mechanical-LSD rear unit without checking for an LSD \"\n                 \"additive requirement.\", \"torque_ref\": None},\n        {\"step\": \"Torque fill/drain plug (26 Nm reported, SINGLE-SOURCE).\",\n         \"torque_ref\": \"rear_diff_fill_plug\"},\n    ],\n    \"axle_propshaft_service\": [\n        {\"step\": \"Confirm propshaft construction (material, one- vs two-piece, \"\n                 \"centre bearing presence) against the parts catalogue for \"\n                 \"this VIN before ordering.\", \"torque_ref\": None},\n        {\"step\": \"Torque propshaft flange/centre-carrier nut (treat as \"\n                 \"unconfirmed pending TechAuthority check).\",\n         \"torque_ref\": \"propshaft_flange_nut\"},\n        {\"step\": \"Always fit a NEW front/rear axle (hub) nut -- torque then angle.\",\n         \"torque_ref\": \"axle_hub_nut\"},\n        {\"step\": \"Torque hub mounting bolts.\", \"torque_ref\": \"hub_mount_bolts\"},\n        {\"step\": \"If replacing the stubshaft for a fluid leak, do NOT replace \"\n                 \"the PTU seals at the same time.\", \"torque_ref\": None},\n        {\"step\": \"Check any flex-disc/coupling bolts for a torque-to-yield \"\n                 \"callout before reusing them.\", \"torque_ref\": None},\n        {\"step\": \"After any driveline disassembly on a Q4 car, verify tyre \"\n                 \"circumference match (1/8\\\") before returning the car.\",\n         \"torque_ref\": None},\n    ],\n    \"mount_replacement\": [\n        {\"step\": \"Torque engine mount bolts to aluminium block.\",\n         \"torque_ref\": \"engine_mount_bolts\"},\n        {\"step\": \"Replace and torque longitudinal (dogbone) mount -- mount \"\n                 \"itself is single-use, do not reinstall a removed mount.\",\n         \"torque_ref\": \"longitudinal_mount_bolts\"},\n        {\"step\": \"On Q4 cars, confirm exact location of the central M14 bolt \"\n                 \"before relying on the 124-136 Nm figure (ambiguous between \"\n                 \"engine-mount pivot and driveline flange).\",\n         \"torque_ref\": \"q4_central_m14_bolt_mounts\"},\n        {\"step\": \"Fit new transmission-mount-bracket fasteners; confirm actual \"\n                 \"torque value in TechAuthority since none was found independently.\",\n         \"torque_ref\": \"trans_mount_bracket_fasteners\"},\n        {\"step\": \"Inspect this mount before condemning the transmission or \"\n                 \"driveline on a clunk/vibration complaint.\", \"torque_ref\": None},\n    ],\n}\n\n# ---------------------------------------------------------------------------\n# SECTIONS -- the five self-contained drivetrain areas required by the\n# organisation requirement: each holds its own specs, torques and jobs.\n# ---------------------------------------------------------------------------\n\nSECTIONS: dict[str, dict[str, Any]] = {\n    \"transmission\": {\n        \"specs\": specs_for_section(\"transmission\"),\n        \"torques\": torques_for_section(\"transmission\"),\n        \"dtcs\": TRANSMISSION_DTCS,\n        \"tsbs\": TRANSMISSION_TSBS,\n        \"jobs\": {\"transmission_fluid_service\": JOBS[\"transmission_fluid_service\"]},\n    },\n    \"transfer_case\": {\n        \"specs\": specs_for_section(\"transfer_case\"),\n        \"torques\": torques_for_section(\"transfer_case\"),\n        \"dtcs\": TRANSFER_CASE_DTCS,\n        \"jobs\": {\"transfer_case_service\": JOBS[\"transfer_case_service\"]},\n    },\n    \"differentials\": {\n        \"front\": {\n            \"specs\": [s for s in specs_for_section(\"differentials\") if \"front\" in s[\"categories\"]],\n            \"torques\": [t for t in torques_for_section(\"differentials\") if \"front\" in t[\"categories\"]],\n            \"jobs\": {\"differential_service_front\": JOBS[\"differential_service_front\"]},\n        },\n        \"rear\": {\n            \"specs\": [s for s in specs_for_section(\"differentials\") if \"rear\" in s[\"categories\"]],\n            \"torques\": [t for t in torques_for_section(\"differentials\") if \"rear\" in t[\"categories\"]],\n            \"jobs\": {\"differential_service_rear\": JOBS[\"differential_service_rear\"]},\n        },\n        \"specs\": specs_for_section(\"differentials\"),\n        \"torques\": torques_for_section(\"differentials\"),\n        \"jobs\": {\n            \"differential_service_front\": JOBS[\"differential_service_front\"],\n            \"differential_service_rear\": JOBS[\"differential_service_rear\"],\n        },\n    },\n    \"driveline\": {\n        \"specs\": specs_for_section(\"driveline\"),\n        \"torques\": torques_for_section(\"driveline\"),\n        \"issues\": DRIVELINE_ISSUES,\n        \"jobs\": {\"axle_propshaft_service\": JOBS[\"axle_propshaft_service\"]},\n    },\n    \"mounts\": {\n        \"specs\": specs_for_section(\"mounts\"),\n        \"torques\": torques_for_section(\"mounts\"),\n        \"issues\": MOUNTS_ISSUES,\n        \"jobs\": {\"mount_replacement\": JOBS[\"mount_replacement\"]},\n    },\n}\n\n\ndef by_confidence(confidence: str) -> list[dict[str, Any]]:\n    \"\"\"All SPECS/TORQUES rows at a given confidence level, e.g. 'UNKNOWN'.\"\"\"\n    want = confidence.upper()\n    return [row for row in SPECS + TORQUES if row[\"confidence\"] == want]\n\n\ndef find(text: str) -> list[dict[str, Any]]:\n    \"\"\"Case-insensitive search across SPECS and TORQUES component names.\"\"\"\n    needle = text.lower()\n    return [row for row in SPECS + TORQUES if needle in row[\"component\"].lower()]\n\n\n__all__ = [\n    \"CONFIRMED\", \"CORROBORATED\", \"SINGLE_SOURCE\", \"UNKNOWN\",\n    \"CONFIDENCE_LEVELS\", \"TECHAUTHORITY\", \"VEHICLE\",\n    \"SPECS\", \"TORQUES\", \"JOBS\", \"SECTIONS\",\n    \"TRANSMISSION_DTCS\", \"TRANSMISSION_TSBS\", \"TRANSFER_CASE_DTCS\",\n    \"DRIVELINE_ISSUES\", \"MOUNTS_ISSUES\",\n    \"torque_by_key\", \"torques_for_section\", \"specs_for_section\",\n    \"by_confidence\", \"find\", \"nm_to_lbft\", \"lbft_to_nm\",\n]\n","numLines":862,"startLine":1,"totalLines":862}},"sourceToolAssistantUUID":"6adcf8e1-a724-4deb-a3aa-2b493388c6d3","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
