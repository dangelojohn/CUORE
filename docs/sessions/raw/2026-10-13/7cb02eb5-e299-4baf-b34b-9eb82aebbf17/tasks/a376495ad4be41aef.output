wizard_summary_768\", 768, 1024)\n                        summary_js = (\"JSON.stringify({scan_id: (document.querySelector(\"\n                                     \"'.fscan')||{}).getAttribute('data-scan-id'), \"\n                                     \"open_in_scans_href: (document.querySelector(\"\n                                     \"'a[href*=\\\"/scans/\\\"]')||{}).getAttribute('href'), \"\n                                     \"counts_text: (document.querySelector('.fscan-counts')||{}).textContent||null})\")\n                        summ = ev(cdp, summary_js)\n                        report[\"measurements\"][\"wizard\"][\"summary\"] = json.loads(summ or \"{}\")\n                        log(\"wizard summary: \" + str(report[\"measurements\"][\"wizard\"][\"summary\"]))\n                        # follow \"Open in Scans\" link for real -- confirms the new\n                        # scan this wizard just captured is really browsable\n                        new_scan_id = report[\"measurements\"][\"wizard\"][\"summary\"].get(\"scan_id\")\n                        if new_scan_id:\n                            goto(cdp, f\"{BASE}/v/{VIN}/scans/{new_scan_id}\")\n                            time.sleep(0.3)\n                            landed_title = ev(cdp, \"document.title\")\n                            report[\"measurements\"][\"wizard\"][\"open_in_scans_lands_on\"] = landed_title\n                            log(f\"wizard: Open in Scans -> {landed_title!r}\")\n\n        # ---- F. Liveboard freeze-frame panel --------------------------------\n        goto(cdp, f\"{BASE}/v/{VIN}/liveboard\")\n        time.sleep(0.5)\n        click(\"#ff-start\")\n        deadline = time.time() + 10\n        while time.time() < deadline:\n            save_hidden = ev(cdp, \"(document.getElementById('ff-save')||{}).hidden\")\n            if save_hidden is False:\n                break\n            time.sleep(0.3)\n        ff_js = (\"JSON.stringify({status_text: (document.getElementById('ff-status')||{}).textContent||null, \"\n                \"save_hidden: (document.getElementById('ff-save')||{}).hidden, \"\n                \"discard_hidden: (document.getElementById('ff-discard')||{}).hidden, \"\n                \"tables_hidden: (document.getElementById('ff-tables')||{}).hidden})\")\n        ff_state = ev(cdp, ff_js)\n        report[\"measurements\"][\"liveboard_freeze_frame\"] = json.loads(ff_state or \"{}\")\n        log(\"freeze frame after Start: \" + str(report[\"measurements\"][\"liveboard_freeze_frame\"]))\n        shot(cdp, \"08_liveboard_freeze_frame_768\", 768, 1024)\n        if report[\"measurements\"][\"liveboard_freeze_frame\"].get(\"save_hidden\") is False:\n            click(\"#ff-save\")\n            time.sleep(1.0)\n            saved_js = (\"JSON.stringify({result_text: (document.getElementById('ff-result')||{}).textContent||null, \"\n                       \"has_open_in_scans_link: !!document.querySelector('#ff-result a')})\")\n            saved = ev(cdp, saved_js)\n            report[\"measurements\"][\"liveboard_freeze_frame\"][\"after_save\"] = json.loads(saved or \"{}\")\n            log(\"freeze frame after Save: \" + str(report[\"measurements\"][\"liveboard_freeze_frame\"][\"after_save\"]))\n        else:\n            click(\"#ff-discard\")\n            time.sleep(0.5)\n            report[\"measurements\"][\"liveboard_freeze_frame\"][\"discarded_no_save\"] = True\n\n        # ---- G. Job step 7 Mode 06 evidence picker --------------------------\n        http(\"POST\", f\"/v/{VIN}/job/open\",\n            {\"technician\": \"mech_review_4\", \"complaint\": \"CEL, fuel smell\"})\n        status7, body7 = http(\"GET\", f\"/v/{VIN}/job\")\n        m = re.search(rf\"/v/{VIN}/job/([A-Za-z0-9]+)/hypotheses\\\"\", body7)\n        job_id = m.group(1) if m else \"\"\n        report[\"measurements\"][\"job7\"] = {\"job_id\": job_id}\n        if job_id:\n            http(\"POST\", f\"/v/{VIN}/job/{job_id}/hypotheses\",\n                {\"text\": \"mech_review_4: cracked EVAP purge line\", \"system\": \"evap\", \"step\": \"7\"})\n            goto(cdp, f\"{BASE}/v/{VIN}/job?step=7\")\n            time.sleep(0.5)\n            opened = click(\"details.evidence-picker summary\")\n            time.sleep(0.3)\n            picker_js = (\"JSON.stringify(Array.from(document.querySelectorAll(\"\n                        \"'details.evidence-picker select.evidence-pick option'))\"\n                        \".map(o => o.value))\")\n            options = ev(cdp, picker_js)\n            opts = json.loads(options or \"[]\")\n            mode06_opts = [o for o in opts if o.startswith(\"measurement|mode06-\")]\n            report[\"measurements\"][\"job7\"].update({\n                \"evidence_picker_opened\": opened,\n                \"all_evidence_options\": opts,\n                \"mode06_options\": mode06_opts,\n            })\n            log(f\"job7 evidence picker mode06 options: {mode06_opts}\")\n            shot(cdp, \"09_job7_evidence_picker_768\", 768, 1024)\n\n        # ---- H. /m/{vin} History: add, edit, delete (soft), restore --------\n        add_status, add_body = http(\"POST\", f\"/m/{VIN}/add/fluids/engine_oil_topup\", {\"qty\": \"1.0\"})\n        # follow the redirect chain manually to find the new event id\n        hist_status, hist_body = http(\"GET\", f\"/m/{VIN}/history\")\n        ids = re.findall(rf\"/m/{VIN}/edit/([A-Za-z0-9_-]+)\", hist_body)\n        event_id = ids[0] if ids else \"\"\n        report[\"measurements\"][\"history\"] = {\"add_status\": add_status, \"event_id\": event_id}\n        if event_id:\n            goto(cdp, f\"{BASE}/m/{VIN}/history\")\n            time.sleep(0.3)\n            shot(cdp, \"10_history_before_edit_768\", 768, 1024)\n            goto(cdp, f\"{BASE}/m/{VIN}/edit/{event_id}\")\n            time.sleep(0.3)\n            ev(cdp, \"(() => { const el = document.querySelector('input[name=\\\"qty\\\"]'); \"\n                   \"if (el) { el.value = '2.5'; } return !!el; })()\")\n            click(\"form.m-form button[type=submit], form.m-form input[type=submit]\")\n            time.sleep(0.5)\n            confirm_title = ev(cdp, \"document.title\")\n            goto(cdp, f\"{BASE}/m/{VIN}/history\")\n            time.sleep(0.3)\n            edited_badge = ev(cdp, \"!!document.querySelector('.m-edited-badge')\")\n            report[\"measurements\"][\"history\"].update({\n                \"edit_confirm_title\": confirm_title, \"edited_badge_present_after_edit\": edited_badge})\n            log(f\"history edit: confirm_title={confirm_title!r} edited_badge={edited_badge}\")\n\n            goto(cdp, f\"{BASE}/m/{VIN}/edit/{event_id}\")\n            time.sleep(0.3)\n            clicked_delete = click(\"form.m-delete-form button\")\n            time.sleep(0.5)\n            deleted_title = ev(cdp, \"document.title\")\n            undo_present = ev(cdp, \"!!document.querySelector('.m-undo-btn')\")\n            report[\"measurements\"][\"history\"].update({\n                \"delete_clicked\": clicked_delete, \"deleted_page_title\": deleted_title,\n                \"undo_button_present\": undo_present})\n            log(f\"history delete: title={deleted_title!r} undo_present={undo_present}\")\n\n            click(\".m-undo-btn\")\n            time.sleep(0.5)\n            goto(cdp, f\"{BASE}/m/{VIN}/history\")\n            time.sleep(0.3)\n            restored_present = ev(cdp, \"document.body.innerText.includes('engine oil top-up') \"\n                                       \"|| document.body.innerText.toLowerCase().includes('oil top-up')\")\n            report[\"measurements\"][\"history\"][\"restored_visible_in_history\"] = restored_present\n            shot(cdp, \"11_history_after_restore_768\", 768, 1024)\n            log(f\"history restore: visible again = {restored_present}\")\n\n        print(\"CHECKPOINT_2_OK\")\n    finally:\n        if cdp is not None:\n            cdp.close()\n        try:\n            edge_proc.terminate()\n            edge_proc.wait(timeout=5)\n        except Exception:  # noqa: BLE001\n            try:\n                edge_proc.kill()\n            except Exception:  # noqa: BLE001\n                pass\n        sys.path.insert(0, str(ROOT / \"cuore\" / \"tests\"))\n        try:\n            from _edge_cleanup import kill_edge_profile  # noqa: E402\n            killed = kill_edge_profile(profile_dir)\n            log(f\"_edge_cleanup killed {killed} leftover msedge.exe process(es)\")\n        except Exception as exc:  # noqa: BLE001\n            log(f\"_edge_cleanup failed (non-fatal): {exc}\")\n        REPORT_PATH.write_text(json.dumps(report, indent=2, default=str), encoding=\"utf-8\")\n        log(f\"report written to {REPORT_PATH}\")\n        try:\n            server_proc.terminate()\n            server_proc.wait(timeout=5)\n        except Exception:  # noqa: BLE001\n            try:\n                server_proc.kill()\n            except Exception:  # noqa: BLE001\n                pass\n        log(\"server terminated, run complete\")","originalFile":null,"structuredPatch":[{"oldStart":502,"oldLines":8,"newStart":502,"newLines":206,"lines":["         overflow_check(cdp, \"health@768\")","         shot(cdp, \"05_health_768\", 768, 1024)","         log(f\"health report captured: {report['measurements']['health']}\")","-","         print(\"CHECKPOINT_1_OK\")","+","+        # ==================================================================","+        # CHECKPOINT 2","+        # ==================================================================","+","+        def click(sel: str) -> bool:","+            found = ev(cdp, f\"(() => {{ const el = document.querySelector({sel!r}); \"","+                           \"if (!el) return false; el.click(); return true; })()\")","+            return bool(found)","+","+        # ---- E. Guided scan wizard: idle -> pause_blue -> skip -> pause_grey","+        #        -> skip -> remove_cable -> continue -> summary -----------",