t = {\"findings\": [], \"measurements\": {}, \"screenshots\": []}\n\n\ndef log(msg: str) -> None:\n    print(f\"[review] {msg}\", flush=True)\n\n\n# --------------------------------------------------------------------------\n# 1. fresh CUORE_STATE_DIR, seeded with tonight's (2026-10-13) real lines only\n# --------------------------------------------------------------------------\n\nstate_dir = Path(tempfile.mkdtemp(prefix=\"cuore-mech-review-4-\"))\nseeded_lines = []\nif REAL_OBS.exists():\n    with REAL_OBS.open(\"r\", encoding=\"utf-8\") as f:\n        for line in f:\n            line = line.strip()\n            if not line:\n                continue\n            try:\n                obj = json.loads(line)\n            except ValueError:\n                continue\n            if str(obj.get(\"at\", \"\")).startswith(\"2026-10-13\"):\n                seeded_lines.append(line)\n(state_dir / \"observations.jsonl\").write_text(\"\\n\".join(seeded_lines) + \"\\n\", encoding=\"utf-8\")\nlog(f\"seeded {len(seeded_lines)} real 2026-10-13 lines into {state_dir / 'observations.jsonl'}\")\nreport[\"seed\"] = {\"state_dir\": str(state_dir), \"lines_seeded\": len(seeded_lines),\n                  \"source\": str(REAL_OBS)}\n\n# --------------------------------------------------------------------------\n# 2. server subprocess: CUORE_STATE_DIR + fake ops (check_fullscan.py's fakes)\n#    so the guided-scan wizard and the freeze-frame panel work without\n#    hardware, same posture the repo's own tests already use.\n# --------------------------------------------------------------------------\n\n\ndef free_port() -> int:\n    s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)\n    s.bind((\"127.0.0.1\", 0))\n    port = s.getsockname()[1]\n    s.close()\n    return port\n\n\nport = free_port()\nenv = dict(os.environ)\nenv[\"CUORE_STATE_DIR\"] = str(state_dir)\nenv.pop(\"CUORE_AUDIT_PATH\", None)\nenv.pop(\"MES_LIVE_OBSERVATIONS\", None)\n\nSERVER_SNIPPET = f'''\nimport sys\nsys.path.insert(0, {str(ROOT)!r})\n\nfrom cuore.live import addressing, interlock, ops\n\nVIN = {VIN!r}\nECM_HDR = \"18DAF110\"\n_SUPPORTED_PIDS = [f\"{{i:02X}}\" for i in range(1, 47)]\n_cable_box = {{\"cable\": \"none\"}}\n\n\ndef _fake_scan_modules(bus, vin=\"\", mask=0xFF, confirm=False, detail=True):\n    if bus == \"can_ihs\":\n        return {{\"bus\": bus, \"cable\": \"blue_a5\", \"modules\": [\n            {{\"ecu\": \"HVAC\", \"bus\": \"can_ihs\", \"mask\": \"FF\", \"dtcs\": [], \"codes\": []}},\n            {{\"ecu\": \"ETM\", \"bus\": \"can_ihs\", \"mask\": \"FF\", \"dtcs\": [], \"codes\": []}},\n        ]}}\n    if bus == \"can_ch\":\n        return {{\"bus\": bus, \"cable\": \"grey_a6\", \"modules\": [\n            {{\"ecu\": \"ABS\", \"bus\": \"can_ch\", \"mask\": \"FF\", \"dtcs\": [], \"codes\": []}},\n        ]}}\n    if bus == \"can_c\":\n        modules = [\n            {{\"ecu\": \"ECM\", \"bus\": \"can_c\", \"mask\": \"FF\", \"dtcs\": [], \"codes\": []}},\n            {{\"ecu\": \"TCM\", \"bus\": \"can_c\", \"mask\": \"FF\", \"dtcs\": [], \"codes\": []}},\n            {{\"ecu\": \"BCM\", \"bus\": \"can_c\", \"mask\": \"FF\", \"codes\": [\"U1713-2F\"],\n             \"dtcs\": [{{\"code\": \"U1713-2F\", \"raw\": \"17132F\", \"status\": 15,\n                       \"flags\": {{\"confirmedDTC\": True, \"testFailed\": True}}}}]}},\n        ]\n        return {{\"bus\": \"can_c\", \"cable\": \"none\", \"modules\": modules}}\n    return {{\"bus\": bus, \"cable\": \"none\",\n            \"modules\": [{{\"ecu\": m.code, \"skipped\": \"no confirmed address\"}} for m in addressing.on_bus(bus)]}}\n\n\ndef _fake_obd_dtcs(kind, **kw):\n    if kind == \"stored\":\n        return {{\"kind\": \"stored\", \"dtcs\": [\"P0440\"], \"by_ecu\": {{ECM_HDR: [\"P0440\"]}}, \"raw\": \"43\"}}\n    return {{\"kind\": kind, \"dtcs\": [], \"by_ecu\": {{}}, \"raw\": \"NO DATA\"}}\n\n\nops._poller_active_guard = lambda: None\ninterlock.mes_status = lambda: {{\"running\": False, \"pids\": [], \"state\": \"not_running\", \"label\": \"\"}}\nops.status = lambda: {{\"port\": \"COM3\", \"baud\": 115200}}\nops.cable_state = lambda: {{\"cable\": _cable_box[\"cable\"], \"buses\": {{}}}}\nops.set_cable = lambda c: (_cable_box.update(cable=c), {{\"cable\": c, \"buses\": {{}}}})[1]\nops.verify_bus = lambda bus, **kw: {{\"verified\": True, \"frames\": 12, \"bus\": bus, \"cable\": \"none\"}}\nops.probe = lambda **kw: {{\"port\": \"COM3\", \"baud\": 115200, \"stn_chip\": True, \"battery_voltage\": 12.6,\n                          \"identity\": {{\"STI\": \"STN1170 v4.3.2\"}}}}\nops.obd_vin = lambda **kw: {{\"vin\": VIN, \"ecu\": ECM_HDR, \"length_ok\": True, \"raw\": \"4902\"}}\nops.obd_dtcs = _fake_obd_dtcs\nops.obd_supported_pids = lambda **kw: {{\"by_ecu\": {{ECM_HDR: {{\"count\": len(_SUPPORTED_PIDS),\n                                        \"pids\": list(_SUPPORTED_PIDS), \"known_names\": []}}}}}}\nops.obd_freeze_frame = lambda pid, **kw: {{\"pid\": pid, \"name\": f\"name_{{pid}}\",\n                                          \"by_ecu\": {{ECM_HDR: {{\"value\": 1.23, \"unit\": \"u\"}}}}}}\nops.obd_pid = lambda pid, **kw: {{\"pid\": pid, \"name\": f\"name_{{pid}}\",\n                                  \"by_ecu\": {{ECM_HDR: {{\"value\": 4.56, \"unit\": \"u\"}}}}}}\nops.obd_readiness = lambda **kw: {{\"since_clear\": {{\"mil_on\": False}}, \"this_drive_cycle\": {{\"mil_on\": False}}}}\nops.obd_mode06 = lambda **kw: {{\"results\": {{}}}}\nops.scan_modules = _fake_scan_modules\nops.module_identity = lambda code, vin=\"\", confirm=False, **kw: {{\"ecu\": code, \"bus\": \"can_c\",\n                                   \"fields\": {{\"F190\": {{\"name\": \"VIN\", \"ascii\": VIN}}}}}}\nops.module_did = lambda code, did, vin=\"\", confirm=False, **kw: {{\"ecu\": code, \"bus\": \"can_c\",\n                                 \"did\": did, \"name\": \"x\", \"bytes\": [\"32\"]}}\nops.learned_dids = lambda vin=\"\": {{\"learned\": {{}}}}\n\nfrom cuore.app import create_app\nimport uvicorn\n\napp = create_app()\nuvicorn.run(app, host=\"127.0.0.1\", port={port}, log_level=\"warning\")\n'''\n\nserver_snippet_path = SCRATCH / \"server_snippet.py\"\nserver_snippet_path.write_text(SERVER_SNIPPET, encoding=\"utf-8\")\n\nserver_proc = subprocess.Popen(\n    [str(ROOT / \".venv\" / \"Scripts\" / \"python.exe\"), str(server_snippet_path)],\n    cwd=str(ROOT), env=env,\n    stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True,\n)\n\n\ndef wait_for_port(p: int, timeout: float = 20.0) -> bool:\n    deadline = time.monotonic() + timeout\n    while time.monotonic() < deadline:\n        try:\n            with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:\n                s.settimeout(0.3)\n                s.connect((\"127.0.0.1\", p))\n                return True\n        except OSError:\n            time.sleep(0.2)\n    return False\n\n\nup = wait_for_port(port)\nlog(f\"server up on port {port}: {up}\")\nif not up:\n    out = server_proc.stdout.read() if server_proc.stdout else \"\"\n    log(\"SERVER FAILED TO START:\\\\n\" + out[-4000:])\n    sys.exit(1)\n\nBASE = f\"http://127.0.0.1:{port}\"\n\n\ndef http(method: str, path: str, data: dict | None = None, timeout: float = 20) -> tuple[int, str]:\n    url = BASE + path\n    body = None\n    headers = {}\n    if data is not None:\n        body = urllib.parse.urlencode(data).encode(\"utf-8\")\n        headers[\"Content-Type\"] = \"application/x-www-form-urlencoded\"\n    req = urllib.request.Request(url, data=body, method=method, headers=headers)\n    try:\n        with urllib.request.urlopen(req, timeout=timeout) as r:\n            return r.status, r.read().decode(\"utf-8\", \"replace\")\n    except urllib.error.HTTPError as e:\n        return e.code, e.read().decode(\"utf-8\", \"replace\")\n\n\nimport urllib.parse  # noqa: E402\n\n# warm the Stelvio dossier cache before anything else touches it\nhttp(\"GET\", f\"/v/{VIN}\")\ntime.sleep(0.3)\nlog(\"warmed bench page\")\n","structu