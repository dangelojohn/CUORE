link, unlike driving the fetches through the page's own JS.\"\"\"\n    hrefs_json = ev(cdp, \"JSON.stringify(Array.from(document.querySelectorAll('a[href]'))\"\n                        \".map(a => a.getAttribute('href')).filter(h => h && !h.startsWith('mailto:')\"\n                        \"&& !h.startsWith('javascript:') && h != '#'))\")\n    hrefs = json.loads(hrefs_json or \"[]\")\n    results = []\n    for h in sorted(set(hrefs)):\n        url = h if h.startswith(\"http\") else BASE + h\n        try:\n            req = urllib.request.Request(url, method=\"GET\")\n            with urllib.request.urlopen(req, timeout=8) as r:\n                results.append({\"href\": h, \"status\": r.status})\n        except urllib.error.HTTPError as e:\n            results.append({\"href\": h, \"status\": e.code})\n        except Exception as exc:  # noqa: BLE001\n            results.append({\"href\": h, \"status\": -1, \"error\": str(exc)})\n    bad = [r for r in results if not (200 <= r.get(\"status\", 0) < 400)]\n    report[\"measurements\"].setdefault(\"dead_links\", {})[page_label] = {\n        \"total\": len(results), \"bad\": bad}\n    return {\"total\": len(results), \"bad\": bad}"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1628,"cache_read_input_tokens":223701,"cache_creation":{"ephemeral_5m_input_tokens":1628,"ephemeral_1h_input_tokens":0},"output_tokens":3,"service_tier":"standard","inference_geo":"global"},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_01UUhoCFZwKVtLTUbcLh9kUf":{"file_path":"C:\\Users\\User\\AppData\\Local\\Temp\\claude\\C--Users-User\\7cb02eb5-e299-4baf-b34b-9eb82aebbf17\\scratchpad\\review_run.py","old_string":"def dead_link_sweep(cdp: \"CDP\", page_label: str) -> dict:\n    \"\"\"Follow every unique same-origin <a href> once (fetch from the page\n    itself). Records non-2xx/3xx.