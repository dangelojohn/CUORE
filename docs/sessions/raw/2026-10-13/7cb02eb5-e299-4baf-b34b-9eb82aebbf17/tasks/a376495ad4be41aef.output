 \"ZASFAKPN5J7B88115\"  # the Stelvio -- real corpus, chronic P0455/P0440/P0456"," ","+# --- Last scan card fixture: one guided scan, dated 2026-10-13, so the","+# bench's own \"Scan n of 10\" chip reads \"Scan 1 of 10\" and the coverage line","+# matches the owner's own spec wording exactly. Hand-built and appended to a","+# throwaway observations.jsonl (CUORE_STATE_DIR above), same posture as","+# cuore/tests/check_scanlog.py's own fixture -- never COM3, never the real","+# C:\\ProgramData\\cuore\\observations.jsonl. -------------------------------","+","+SCAN_AT = datetime(2026, 10, 13, 9, 0, 0)","+SCAN_ID = \"SCAN_\" + SCAN_AT.strftime(\"%y%m%d%H%M\")","+","+","+def _write_obs(at: datetime, kind: str, data: dict, *, stream: str = \"serial COM3@115200\") -> None:","+    entry = {\"at\": at.strftime(\"%Y-%m-%dT%H:%M:%S\"), \"kind\": kind, \"vin\": VIN,","+             \"bus\": \"can_c\", \"cable\": \"none\", \"stream\": stream, \"data\": data}","+    with live_store.observations_path().open(\"a\", encoding=\"utf-8\") as f:","+        f.write(json.dumps(entry) + \"\\n\")","+","+","+_write_obs(SCAN_AT, \"obd_dtcs\",","+          {\"kind\": \"stored\", \"dtcs\": [\"P0455\"], \"by_ecu\": {\"18DAF110\": [\"P0455\"]}})","+_write_obs(SCAN_AT + timedelta(minutes=2), \"scan_coverage\", {","+    \"scan_id\": SCAN_ID, \"vin\": VIN, \"cable\": \"none\", \"buses_attempted\": [\"can_c\"],","+    \"duration_s\": 10.0, \"steps\": [],","+    \"coverage\": [{\"bus\": \"can_c\", \"module\": m, \"category\": \"answered\", \"why\": None,","+                 \"active\": 0, \"history\": 0, \"not_run\": 0}","+                for m in (\"ECM\", \"IPC\", \"TCM\", \"DTCM\", \"ESM\")],","+    \"counts\": {\"active\": 0, \"history\": 0, \"not_run\": 0},","+})","+"," failures: list[str] = []"," checks = 0"," "]}]}],"moreFiles":0,"changedFiles":["C:\\Users\\User\\mcp-servers\\cuore\\tests\\check_bench.py"],"shared":true}},"serverClassifierContext":{"request":"47f17f53-29d7-443e-98ec-fe0bf3020e1