 (each with its parts and tools already resolved), and jump-off\n    points to the codes, the job and the full dossier.\"\"\"\n    bench = bench_bridge.build_bench(vin)\n    response = web_routes._page(request, \"bench.html\", vin=vin, bench=bench,\n                                tab=\"bench\")\n    web_routes._set_active_vehicle(response, vin)\n    return response\n\n\n__all__ = [\"router\"]\n","structuredPatch":[],"originalFile":null,"userModified":false},"serverClassifierContext":{"request":"9c90aa10-cbbf-4c77-94d1-16d15dc2c97b","context":{"git_state":{"cwd":"/c/Users/User/mcp-servers","root":null,"branch":null,"default_branch":null,"status":null,"visibility":null,"error":"pending"},"live_cwd":"/c/Users/User/mcp-servers","platform":"windows"}},"sourceToolAssistantUUID":"d738dc9b-7016-4212-9ffd-512335bc733a","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
