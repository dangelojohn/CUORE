nt(1)\ndef send(method, params=None):\n    mid = next(ids)\n    ws.send(json.dumps({\"id\": mid, \"method\": method, \"params\": params or {}}))\n    deadline = time.time()+20\n    while time.time() < deadline:\n        raw = ws.recv(timeout=5)\n        msg = json.loads(raw)\n        if msg.get(\"id\") == mid:\n            return msg\n    raise TimeoutError()\n\nprint(send(\"Page.enable\"))\nprint(send(\"Runtime.enable\"))\ntime.sleep(1.5)\nprint(send(\"Emulation.setDeviceMetricsOverride\", {\"width\":400,\"height\":800,\"deviceScaleFactor\":1,\"mobile\":True}))\ntime.sleep(0.5)\nr1 = send(\"Runtime.evaluate\", {\"expression\":\"document.readyState\",\"returnByValue\":True})\nprint(\"readyState:\", r1)\nr2 = send(\"Runtime.evaluate\", {\"expression\":\"document.title\",\"returnByValue\":True})\nprint(\"title:\", r2)\nr3 = send(\"Runtime.evaluate\", {\"expression\":\"document.body.innerHTML.length\",\"returnByValue\":True})\nprint(\"bodylen:\", r3)\nr4 = send(\"Runtime.evaluate\", {\"expression\":\"document.querySelectorAll('.bench-card').length\",\"returnByValue\":True})\nprint(\"bench-card count:\", r4)\nr5 = send(\"Runtime.evaluate\", {\"expression\":\"document.body.innerHTML.slice(0,2000)\",\"returnByValue\":True})\nprint(\"snippet:\", r5)\nws.close()\nproc.terminate()\nEOF\n.venv/Scripts/python.exe /tmp/cdp_debug.py 2>&1 | tail -150\nkill %1 2>/dev/null\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1321,"cache_read_input_tokens":252298,"cache_creation":{"ephemeral_5m_input_tokens":1321,"ephemeral_1h_input_tokens":0},"output_tokens":3,"service_tier":"standard","inference_geo":"not_available"},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_01HCevazbVcGHkbTw3VRcWAG":{"command":"cd /c/Users/User/mcp-servers && .venv/Scripts/python.exe /tmp/run_server.py &\nsleep 2\ncat > /tmp/cdp_debug.py << 'EOF'\