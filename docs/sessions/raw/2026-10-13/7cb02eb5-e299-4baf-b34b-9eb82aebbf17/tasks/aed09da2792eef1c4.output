send(self, method, params=None, timeout=20):\n        mid = next(self._ids); self.ws.send(json.dumps({\"id\": mid, \"method\": method, \"params\": params or {}}))\n        deadline = time.time()+timeout\n        while time.time()<deadline:\n            raw = self.ws.recv(timeout=max(0.1, deadline-time.time())); msg = json.loads(raw)\n            if msg.get(\"id\")==mid:\n                if \"error\" in msg: raise RuntimeError(msg[\"error\"])\n                return msg.get(\"result\", {})\n        raise TimeoutError(method)\n\nedge = r\"C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe\"\nif not Path(edge).exists(): edge = r\"C:\\Program Files\\Microsoft\\Edge\\Application\\msedge.exe\"\nprofile_dir = Path(tempfile.mkdtemp(prefix=\"cuore-edge-debug-\"))\ndevtools_port = free_port()\nproc = subprocess.Popen([edge, \"--headless=new\", f\"--remote-debugging-port={devtools_port}\",\n    f\"--user-data-dir={profile_dir}\", \"--no-first-run\", \"--window-size=1400,1800\", \"about:blank\"],\n    stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)\ndeadline = time.time()+20\nwhile time.time()<deadline:\n    try:\n        urllib.request.urlopen(f\"http://127.0.0.1:{devtools_port}/json/version\", timeout=2); break\n    except Exception: time.sleep(0.2)\nreq = urllib.request.Request(f\"http://127.0.0.1:{devtools_port}/json/new?http://127.0.0.1:{PORT}/v/{VIN}\", method=\"PUT\")\nwith urllib.request.urlopen(req, timeout=10) as r:\n    target = json.loads(r.read().decode())\ncdp = CDP(target[\"webSocketDebuggerUrl\"])\ncdp.send(\"Page.enable\"); cdp.send(\"Runtime.enable\")\ntime.sleep(1.5)\nout = cdp.send(\"Runtime.evaluate\", {\"expression\": \"JSON.stringify({open: document.getElementById('sec-attempted').open, outer: document.getElementById('sec-attempted').outerHTML.slice(0,150)})\", \"returnByValue\": True})\nprint(out[\"result\"][\"value\"])\nout2 = cdp.send(\"Runtime.evaluate\", {\"expression\": \"JSON.stringify(Array.from(document.querySelectorAll('details.card-details')).map(d=>({id:d.id, open:d.open})))\", \"returnByValue\": True})\nprint(out2[\"result\"][\"value\"])\nproc.terminate()\ntry: proc.wait(timeout=5)\nexcept Exception: proc.kill()\nsys.path.insert(0, str(REPO / \"cuore\" / \"tests\"))\nfrom _edge_cleanup import kill_edge_profile\nkill_edge_profile(profile_dir)\nimport shutil\nshutil.rmtree(profile_dir, ignore_errors=True)\nos._exit(0)","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"serverClassifierContext":{"request":"102e7fb1-3329-48dc-a53e-848a9fecaa21","context":{"git_state":{"cwd":"/c/Users/User/mcp-servers","root":"/c/Users/User/mcp-servers","branch":"main","default_branch":null,"status":{"clean":false,"counts":{"staged":0,"modified":20,"untracked":null,"untracked_normal":7},"porcelain":null,"truncated":false},"visibility":{"origin":null,"push_remote":"origin","remotes":[{"name":"github","host":"github.com","remote":"dangelojohn/CUORE","visibility":"unknown"}],"visibility_cache":[]}},"live_cwd":"/c/Users/User/mcp-servers","platform":"windows"}},"sourceToolAssistantUUID":"254d8ac5-a596-46a8-b811-50e1a445fcee","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
