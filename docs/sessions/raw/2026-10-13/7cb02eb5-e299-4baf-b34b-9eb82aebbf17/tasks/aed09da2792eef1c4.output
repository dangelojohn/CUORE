{"parentUuid":"216dd10b-24b0-4837-aac1-b6874283c6dd","isSidechain":true,"agentId":"aed09da2792eef1c4","message":{"model":"claude-sonnet-5","id":"msg_011CfpyREZpgZ4zsZCavYfXL","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01ABMgPH89EYNuJSjpxqTrnv","name":"Read","input":{"file_path":"C:\\Users\\User\\mcp-servers\\cuore\\web\\i18n.py"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":22417,"cache_read_input_tokens":99422,"cache_creation":{"ephemeral_5m_input_tokens":22417,"ephemeral_1h_input_tokens":0},"output_tokens":8,"service_tier":"standard","inference_geo":"not_available"},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_01ABMgPH89EYNuJSjpxqTrnv":{"file_path":"C:\\Users\\User\\mcp-servers\\cuore\\web\\i18n.py"}},"serverClassifierRequest":"793af0ea-5dc5-4c8e-8f7e-ccb6b53c3797","apiBlockIndex":1,"requestId":"req_011CfpyREJBxuN9gRdxBx5Rn","attributionAgent":"general-purpose","type":"assistant","uuid":"45adfb7a-b042-40d8-b550-d13a75e9024f","timestamp":"2026-10-08T15:03:14.913Z","effort":"high","perTurnEffort":null,"userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
{"parentUuid":"45adfb7a-b042-40d8-b550-d13a75e9024f","isSidechain":true,"promptId":"c8683b5a-1bb3-40f7-aff9-33655508a2e2","agentId":"aed09da2792eef1c4","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01ABMgPH89EYNuJSjpxqTrnv","type":"tool_result","content":"1\t\"\"\"UI string dictionary + the ``t`` / ``lang`` Jinja globals.\n2\t\n3\tCUORE's mechanics mostly don't read English as a first language (see\n4\t``cuore/web/icons.py`` for the pictogram half of the same mitigation), so\n5\tevery page-chrome label collected here (headings and button text, grepped\n6\tfrom ``<h1>``-``<h3>`` and ``.btn`` across ``cuore/web/templates/*.html``)\n7\tgets a translation, not just English. DTC codes, part numbers and VINs are\n8\tnever put in here -- those are data, not UI chrome, and stay as-is wherever\n9\ta template renders them directly.\n10\t\n11\tLanguage model\n12\t---------------\n13\t``SUPPORTED_LANGS`` is the set actually filled in below (Italian, English\n14\ttoday); the dict shape -- one ``{lang: text}`` map per key -- is already\n15\tright for French/German/Spanish to be added later by just adding another\n16\tkey to each entry and that language's code to ``SUPPORTED_LANGS``, with no\n17\tchange to ``t()`` or the templates that call it.\n18\t\n19\t``DEFAULT_LANG`` is ``\"it\"``: most of this shop's mechanics default to\n20\tItalian, and an unset or unrecognised ``lang`` cookie should not silently\n21\tmean English. ``t(key, lang)`` looks up the requested language first and\n22\tonly falls back to English (never to Italian, and never to ``DEFAULT_LANG``\n23\tif that differs from the requested language) when that specific key has no\n24\ttranslation for it -- a half-translated page beats a page that 500s or\n25\tshows raw keys.\n26\t\n27\tRegistered as the Jinja globals ``t`` and ``lang`` on the same four\n28\ttemplate environments ``experience_globals`` / ``icons`` register against\n29\t(see those modules' docstrings for why four). Both are context-aware\n30\t(``jinja2.pass_context``) so they read the ``lang`` cookie straight off the\n31\tcurrent request rather than needing every route to pass it through\n32\texplicitly -- FastAPI's ``Jinja2Templates`` already puts ``request`` in\n33\tevery template's context, which is what makes that possible. Importing this\n34\tmodule is the side effect that does the registration; wiring it in is the\n35\tsame one-line ``from ..web import i18n  # noqa: F401`` move the other\n36\t``*_globals`` modules use -- left for the integration pass.\n37\t\n38\t``set_lang_cookie(response, lang)`` and ``pick_language_html(current)`` are\n39\tplain, router-free helpers (no FastAPI import here) for that same\n40\tintegration pass: the first sets the cookie on a response, the second\n41\trenders a 44px-tall Italiano/English chooser to drop in the header and on\n42\tfirst visit.\n43\t\"\"\"\n44\t\n45\tfrom __future__ import annotations\n46\t\n47\timport importlib\n48\tfrom html import escape\n49\tfrom typing import Any, Optional\n50\t\n51\ttry:  # pragma: no cover -- ships with Jinja2; keep the import optional anyway\n52\t    from jinja2 import pass_context\n53\texcept Exception:  # noqa: BLE001 -- must not stop this module from loading\n54\t    def pass_context(f):  # type: ignore[no-redef]\n55\t        return f\n56\t\n57\ttry:  # pragma: no cover -- ships with Jinja2\n58\t    from markupsafe import Markup\n59\texcept Exception:  # noqa: BLE001\n60\t    def Markup(s: str) -> str:  # type: ignore[no-redef]\n61\t        return s\n62\t\n63\t\n64\t#: Languages this module actually has translations for. Order matters only\n65\t#: for ``pick_language_html``'s button order. Extending to French/German/\n66\t#: Spanish later is: add \"fr\"/\"de\"/\"es\" here and fill that key in STRINGS --\n67\t#: nothing else changes.\n68\tSUPPORTED_LANGS: tuple[str, ...] = (\"it\", \"en\")\n69\t\n70\t#: Most CUORE mechanics' first language -- an unset/unknown cookie means\n71\t#: this, not English.\n72\tDEFAULT_LANG = \"it\"\n73\t\n74\t#: English is the one language every key is guaranteed to have, so it is\n75\t#: ``t()``'s fallback when the requested language's translation is missing\n76\t#: for that specific key (not when the *cookie* is merely unset -- that\n77\t#: case uses DEFAULT_LANG before t() is ever called, via lang_from_cookie).\n78\t_FALLBACK_LANG = \"en\"\n79\t\n80\tSTRINGS: dict[str, dict[str, str]] = {\n81\t    # -- the 12 flow-step headings ------------------------------------\n82\t    \"start\": {\"en\": \"Start\", \"it\": \"Avvio\"},\n83\t    \"complaint_symptoms\": {\"en\": \"Complaint & symptoms\", \"it\": \"Disturbo e sintomi\"},\n84\t    \"verdict\": {\"en\": \"Verdict\", \"it\": \"Verdetto\"},\n85\t    \"scan_codes\": {\"en\": \"Scan & codes\", \"it\": \"Scansione e codici\"},\n86\t    \"understand_fault\": {\"en\": \"Understand the fault\", \"it\": \"Comprendere il guasto\"},\n87\t    \"tests_inspections\": {\"en\": \"Tests & inspections\", \"it\": \"Prove e controlli\"},\n88\t    \"hypotheses\": {\"en\": \"Hypotheses\", \"it\": \"Ipotesi\"},\n89\t    \"plan_repair\": {\"en\": \"Plan the repair\", \"it\": \"Pianificare la riparazione\"},\n90\t    \"repair\": {\"en\": \"Repair\", \"it\": \"Riparazione\"},\n91\t    \"verify\": {\"en\": \"Verify\", \"it\": \"Verifica\"},\n92\t    \"document\": {\"en\": \"Document\", \"it\": \"Documentare\"},\n93\t    \"release\": {\"en\": \"Release\", \"it\": \"Rilascio\"},\n94\t\n95\t    # -- base chrome ------------------------------------------------------\n96\t    \"home\": {\"en\": \"Home\", \"it\": \"Home\"},\n97\t    \"menu\": {\"en\": \"Menu\", \"it\": \"Menu\"},\n98\t    \"toggle_theme\": {\"en\": \"Toggle dark/light theme\", \"it\": \"Cambia tema chiaro/scuro\"},\n99\t    \"print_page\": {\"en\": \"Print this page\", \"it\": \"Stampa questa pagina\"},\n100\t    \"vehicles\": {\"en\": \"Vehicles\", \"it\": \"Veicoli\"},\n101\t    \"modules\": {\"en\": \"Modules\", \"it\": \"Moduli\"},\n102\t    \"recordings\": {\"en\": \"Recordings\", \"it\": \"Registrazioni\"},\n103\t    \"logs\": {\"en\": \"Logs\", \"it\": \"Log\"},\n104\t    \"live_link\": {\"en\": \"Live link\", \"it\": \"Collegamento live\"},\n105\t    \"coverage\": {\"en\": \"Coverage\", \"it\": \"Copertura\"},\n106\t    \"tools\": {\"en\": \"Tools\", \"it\": \"Attrezzi\"},\n107\t\n108\t    # -- headings ----------------------------------------------------------\n109\t    \"adaptation_relearn\": {\"en\": \"Adaptation relearn\", \"it\": \"Riapprendimento adattivo\"},\n110\t    \"adapter\": {\"en\": \"Adapter\", \"it\": \"Adattatore\"},\n111\t    \"add_hypothesis\": {\"en\": \"Add a hypothesis\", \"it\": \"Aggiungi un'ipotesi\"},\n112\t    \"add_note\": {\"en\": \"Add a note\", \"it\": \"Aggiungi una nota\"},\n113\t    \"add_media\": {\"en\": \"Add photos, video, sounds or documents\", \"it\": \"Aggiungi foto, video, audio o documenti\"},\n114\t    \"alarms_markers\": {\"en\": \"Alarms & markers\", \"it\": \"Allarmi e segnalatori\"},\n115\t    \"already_attempted\": {\"en\": \"Already attempted\", \"it\": \"Già tentato\"},\n116\t    \"blind_spots\": {\"en\": \"Blind spots\", \"it\": \"Punti ciechi\"},\n117\t    \"brake_tyre_spec\": {\"en\": \"Brake / tyre specification\", \"it\": \"Specifiche freni / pneumatici\"},\n118\t    \"brakes_wheels_tyres\": {\"en\": \"Brakes, wheels & tyres\", \"it\": \"Freni, ruote e pneumatici\"},\n119\t    \"bulletins\": {\"en\": \"Bulletins\", \"it\": \"Bollettini\"},\n120\t    \"buses\": {\"en\": \"Buses\", \"it\": \"Bus dati\"},\n121\t    \"by_family\": {\"en\": \"By family\", \"it\": \"Per famiglia\"},\n122\t    \"cable\": {\"en\": \"Cable\", \"it\": \"Cavo\"},\n123\t    \"calibrate\": {\"en\": \"Calibrate\", \"it\": \"Calibrare\"},\n124\t    \"carried_forward\": {\"en\": \"Carried forward from last time\", \"it\": \"Riportato dalla volta precedente\"},\n125\t    \"checks\": {\"en\": \"Checks\", \"it\": \"Controlli\"},\n126\t    \"choose_job\": {\"en\": \"Choose a job\", \"it\": \"Scegli un lavoro\"},\n127\t    \"choose_job_category\": {\"en\": \"Choose a job category\", \"it\": \"Scegli una categoria di lavoro\"},\n128\t    \"choose_items_visit\": {\"en\": \"Choose items for this visit\", \"it\": \"Scegli gli elementi per questa visita\"},\n129\t    \"co_occurrence\": {\"en\": \"Co-occurrence\", \"it\": \"Co-occorrenza\"},\n130\t    \"code_timeline\": {\"en\": \"Code timeline\", \"it\": \"Cronologia dei codici\"},\n131\t    \"codes\": {\"en\": \"Codes\", \"it\": \"Codici\"},\n132\t    \"codes_vs_driver\": {\"en\": \"Codes vs. what the driver notices\", \"it\": \"Codici rispetto a ciò che nota il guidatore\"},\n133\t    \"columns\": {\"en\": \"Columns\", \"it\": \"Colonne\"},\n134\t    \"considerations_next\": {\"en\": \"Considerations for next time\", \"it\": \"Considerazioni per la prossima volta\"},\n135\t    \"corners\": {\"en\": \"Corners\", \"it\": \"Angoli (ruote)\"},\n136\t    \"corpus\": {\"en\": \"Corpus\", \"it\": \"Corpus\"},\n137\t    \"current_picture\": {\"en\": \"Current picture\", \"it\": \"Quadro attuale\"},\n138\t    \"custom_sheet_dims\": {\"en\": \"Custom sheet dimensions (mm)\", \"it\": \"Dimensioni foglio personalizzate (mm)\"},\n139\t    \"dtc_report\": {\"en\": \"DTC report\", \"it\": \"Rapporto DTC\"},\n140\t    \"dtcs_0x1902\": {\"en\": \"DTCs (0x19 02)\", \"it\": \"DTC (0x19 02)\"},\n141\t    \"dtcs_by_module\": {\"en\": \"DTCs by module\", \"it\": \"DTC per modulo\"},\n142\t    \"dashboard\": {\"en\": \"Dashboard\", \"it\": \"Cruscotto\"},\n143\t    \"dealer_results\": {\"en\": \"Dealer (wiTECH) results\", \"it\": \"Risultati concessionaria (wiTECH)\"},\n144\t    \"dependency_graph\": {\"en\": \"Dependency graph\", \"it\": \"Grafo delle dipendenze\"},\n145\t    \"discoveries\": {\"en\": \"Discoveries\", \"it\": \"Scoperte\"},\n146\t    \"discoveries_considerations\": {\"en\": \"Discoveries & considerations\", \"it\": \"Scoperte e considerazioni\"},\n147\t    \"drain_condition\": {\"en\": \"Drain & condition\", \"it\": \"Scarico e condizione\"},\n148\t    \"drive_cycle_counters\": {\"en\": \"Drive-cycle counters\", \"it\": \"Contatori ciclo di guida\"},\n149\t    \"due_status\": {\"en\": \"Due status\", \"it\": \"Stato scadenza\"},\n150\t    \"epb_rear\": {\"en\": \"Electric parking brake (rear)\", \"it\": \"Freno di stazionamento elettrico (posteriore)\"},\n151\t    \"electrical\": {\"en\": \"Electrical\", \"it\": \"Impianto elettrico\"},\n152\t    \"electrical_path\": {\"en\": \"Electrical path\", \"it\": \"Percorso elettrico\"},\n153\t    \"elements\": {\"en\": \"Elements\", \"it\": \"Elementi\"},\n154\t    \"every_code\": {\"en\": \"Every code this car has set\", \"it\": \"Ogni codice impostato da questa vettura\"},\n155\t    \"every_occurrence\": {\"en\": \"Every occurrence\", \"it\": \"Ogni occorrenza\"},\n156\t    \"everything_corpus\": {\"en\": \"Everything in the corpus\", \"it\": \"Tutto il corpus\"},\n157\t    \"evidence_gate\": {\"en\": \"Evidence gate\", \"it\": \"Soglia delle prove\"},\n158\t    \"excursions\": {\"en\": \"Excursions\", \"it\": \"Escursioni\"},\n159\t    \"fault_tree\": {\"en\": \"Fault tree\", \"it\": \"Albero dei guasti\"},\n160\t    \"filter\": {\"en\": \"Filter\", \"it\": \"Filtro\"},\n161\t    \"flash_check\": {\"en\": \"Flash check\", \"it\": \"Controllo flash\"},\n162\t    \"fluid\": {\"en\": \"Fluid\", \"it\": \"Fluido\"},\n163\t    \"fluid_condition\": {\"en\": \"Fluid condition\", \"it\": \"Condizione del fluido\"},\n164\t    \"freeze_frames\": {\"en\": \"Freeze frames\", \"it\": \"Fotogrammi congelati\"},\n165\t    \"front_differential\": {\"en\": \"Front differential\", \"it\": \"Differenziale anteriore\"},\n166\t    \"gauges\": {\"en\": \"Gauges\", \"it\": \"Strumenti\"},\n167\t    \"general_service\": {\"en\": \"General service\", \"it\": \"Tagliando generale\"},\n168\t    \"history\": {\"en\": \"History\", \"it\": \"Storico\"},\n169\t    \"identity_annex_c\": {\"en\": \"Identity (Annex C)\", \"it\": \"Identità (Allegato C)\"},\n170\t    \"inbox\": {\"en\": \"Inbox\", \"it\": \"Posta in arrivo\"},\n171\t    \"inspection_tag_fields\": {\"en\": \"Inspection tag fields\", \"it\": \"Campi etichetta ispezione\"},\n172\t    \"job\": {\"en\": \"Job\", \"it\": \"Lavoro\"},\n173\t    \"job_tag_fields\": {\"en\": \"Job tag fields\", \"it\": \"Campi etichetta lavoro\"},\n174\t    \"keyboard\": {\"en\": \"Keyboard\", \"it\": \"Tastiera\"},\n175\t    \"kind_template\": {\"en\": \"Kind & template\", \"it\": \"Tipo e modello\"},\n176\t    \"known_issues\": {\"en\": \"Known issues\", \"it\": \"Problemi noti\"},\n177\t    \"labels_printed\": {\"en\": \"Labels printed\", \"it\": \"Etichette stampate\"},\n178\t    \"last_90_days\": {\"en\": \"Last 90 days\", \"it\": \"Ultimi 90 giorni\"},\n179\t    \"last_maintenance_visit\": {\"en\": \"Last maintenance visit\", \"it\": \"Ultimo intervento di manutenzione\"},\n180\t    \"last_oil_change\": {\"en\": \"Last oil change\", \"it\": \"Ultimo cambio olio\"},\n181\t    \"latest_all_systems_scan\": {\"en\": \"Latest all-systems scan\", \"it\": \"Ultima scansione di tutti i sistemi\"},\n182\t    \"latest_session\": {\"en\": \"Latest session\", \"it\": \"Ultima sessione\"},\n183\t    \"legislated_obd\": {\"en\": \"Legislated OBD (CAN-C)\", \"it\": \"OBD legale (CAN-C)\"},\n184\t    \"live\": {\"en\": \"Live\", \"it\": \"Live\"},\n185\t    \"live_status\": {\"en\": \"Live status\", \"it\": \"Stato live\"},\n186\t    \"live_vs_log\": {\"en\": \"Live vs log\", \"it\": \"Live rispetto al log\"},\n187\t    \"log_symptom\": {\"en\": \"Log a symptom\", \"it\": \"Registra un sintomo\"},\n188\t    \"log_index\": {\"en\": \"Log index\", \"it\": \"Indice dei log\"},\n189\t    \"mes_and_lock\": {\"en\": \"MES and lock\", \"it\": \"MES e blocco\"},\n190\t    \"maintenance_reminder_fields\": {\"en\": \"Maintenance reminder fields\", \"it\": \"Campi promemoria manutenzione\"},\n191\t\n192\t    # -- buttons -------------------------------------------------------\n193\t    \"back_to_dossier\": {\"en\": \"Back to dossier\", \"it\": \"Torna al dossier\"},\n194\t    \"add_to_ledger\": {\"en\": \"Add to ledger\", \"it\": \"Aggiungi al registro\"},\n195\t    \"all\": {\"en\": \"All\", \"it\": \"Tutti\"},\n196\t    \"all_domains\": {\"en\": \"All domains\", \"it\": \"Tutti i domini\"},\n197\t    \"answer\": {\"en\": \"Answer\", \"it\": \"Rispondi\"},\n198\t    \"assess\": {\"en\": \"Assess\", \"it\": \"Valuta\"},\n199\t    \"back_to_tree\": {\"en\": \"Back to the tree\", \"it\": \"Torna all'albero\"},\n200\t    \"clear\": {\"en\": \"Clear\", \"it\": \"Pulisci\"},\n201\t    \"clear_filter\": {\"en\": \"Clear filter\", \"it\": \"Rimuovi filtro\"},\n202\t    \"close\": {\"en\": \"Close\", \"it\": \"Chiudi\"},\n203\t    \"close_case\": {\"en\": \"Close case\", \"it\": \"Chiudi il caso\"},\n204\t    \"connect\": {\"en\": \"Connect\", \"it\": \"Connetti\"},\n205\t    \"custom_channels\": {\"en\": \"Custom channels\", \"it\": \"Canali personalizzati\"},\n206\t    \"declare_cable\": {\"en\": \"Declare cable\", \"it\": \"Dichiara cavo\"},\n207\t    \"discard_session\": {\"en\": \"Discard this session\", \"it\": \"Scarta questa sessione\"},\n208\t    \"dismiss\": {\"en\": \"Dismiss\", \"it\": \"Ignora\"},\n209\t    \"download_pdf\": {\"en\": \"Download PDF\", \"it\": \"Scarica PDF\"},\n210\t    \"edit_layout\": {\"en\": \"Edit layout\", \"it\": \"Modifica layout\"},\n211\t    \"exclude_simulation\": {\"en\": \"Exclude simulation\", \"it\": \"Escludi simulazione\"},\n212\t    \"export\": {\"en\": \"Export\", \"it\": \"Esporta\"},\n213\t    \"find_excursions\": {\"en\": \"Find excursions\", \"it\": \"Trova escursioni\"},\n214\t    \"go_to_release\": {\"en\": \"Go to release\", \"it\": \"Vai al rilascio\"},\n215\t    \"hud\": {\"en\": \"HUD\", \"it\": \"HUD\"},\n216\t    \"hide\": {\"en\": \"Hide\", \"it\": \"Nascondi\"},\n217\t    \"i_dont\": {\"en\": \"I don't\", \"it\": \"Io no\"},\n218\t    \"i_have_this\": {\"en\": \"I have this\", \"it\": \"Io sì\"},\n219\t    \"import_\": {\"en\": \"Import\", \"it\": \"Importa\"},\n220\t    \"include_simulation\": {\"en\": \"Include simulation\", \"it\": \"Includi simulazione\"},\n221\t    \"load_checklist\": {\"en\": \"Load checklist\", \"it\": \"Carica lista di controllo\"},\n222\t    \"load_fields_checked\": {\"en\": \"Load fields for checked items\", \"it\": \"Carica campi per gli elementi selezionati\"},\n223\t    \"load_job\": {\"en\": \"Load job\", \"it\": \"Carica lavoro\"},\n224\t    \"mark\": {\"en\": \"Mark\", \"it\": \"Segna\"},\n225\t    \"mark_applied\": {\"en\": \"Mark applied\", \"it\": \"Segna come applicato\"},\n226\t    \"open_original\": {\"en\": \"Open original\", \"it\": \"Apri originale\"},\n227\t    \"pause_all\": {\"en\": \"Pause all\", \"it\": \"Pausa generale\"},\n228\t    \"print_test_grid\": {\"en\": \"Print test grid (plain paper)\", \"it\": \"Stampa griglia di prova (carta semplice)\"},\n229\t    \"probe_adapter\": {\"en\": \"Probe adapter\", \"it\": \"Adattatore sonda\"},\n230\t    \"read_dtcs\": {\"en\": \"Read DTCs\", \"it\": \"Leggi DTC\"},\n231\t    \"read_readiness\": {\"en\": \"Read readiness\", \"it\": \"Leggi readiness\"},\n232\t    \"read_with_confirmation\": {\"en\": \"Read with confirmation\", \"it\": \"Leggi con conferma\"},\n233\t    \"readiness\": {\"en\": \"Readiness\", \"it\": \"Readiness\"},\n234\t    \"record\": {\"en\": \"Record\", \"it\": \"Registra\"},\n235\t    \"record_dtc_report\": {\"en\": \"Record DTC report\", \"it\": \"Registra rapporto DTC\"},\n236\t    \"record_slvt\": {\"en\": \"Record SLVT\", \"it\": \"Registra SLVT\"},\n237\t    \"record_action\": {\"en\": \"Record action\", \"it\": \"Registra azione\"},\n238\t    \"record_brakes_wheels_tyres\": {\"en\": \"Record brakes/wheels/tyres service\", \"it\": \"Registra intervento freni/ruote/pneumatici\"},\n239\t    \"record_flash_check\": {\"en\": \"Record flash check\", \"it\": \"Registra controllo flash\"},\n240\t    \"record_inspection\": {\"en\": \"Record inspection\", \"it\": \"Registra ispezione\"},\n241\t    \"record_maintenance_visit\": {\"en\": \"Record maintenance visit\", \"it\": \"Registra intervento di manutenzione\"},\n242\t    \"record_oil_change\": {\"en\": \"Record oil change\", \"it\": \"Registra cambio olio\"},\n243\t    \"record_recall_status\": {\"en\": \"Record recall status\", \"it\": \"Registra stato richiamo\"},\n244\t    \"record_routine\": {\"en\": \"Record routine\", \"it\": \"Registra routine\"},\n245\t    \"record_service\": {\"en\": \"Record service\", \"it\": \"Registra intervento\"},\n246\t    \"registry_entry\": {\"en\": \"Registry entry\", \"it\": \"Voce di registro\"},\n247\t    \"release_car\": {\"en\": \"Release car\", \"it\": \"Rilascia la vettura\"},\n248\t    \"reopen\": {\"en\": \"Reopen\", \"it\": \"Riapri\"},\n249\t    \"route\": {\"en\": \"Route\", \"it\": \"Instrada\"},\n250\t    \"run_this_pass\": {\"en\": \"Run this pass\", \"it\": \"Esegui questo passaggio\"},\n251\t    \"save\": {\"en\": \"Save\", \"it\": \"Salva\"},\n252\t    \"save_as\": {\"en\": \"Save as\", \"it\": \"Salva come\"},\n253\t    \"save_calibration\": {\"en\": \"Save calibration\", \"it\": \"Salva calibrazione\"},\n254\t    \"save_inspection\": {\"en\": \"Save inspection\", \"it\": \"Salva ispezione\"},\n255\t    \"save_symptom_report\": {\"en\": \"Save symptom report\", \"it\": \"Salva segnalazione sintomo\"},\n256\t    \"save_tools_review\": {\"en\": \"Save tools review\", \"it\": \"Salva revisione attrezzi\"},\n257\t    \"search\": {\"en\": \"Search\", \"it\": \"Cerca\"},\n258\t    \"send\": {\"en\": \"Send\", \"it\": \"Invia\"},\n259\t    \"skip\": {\"en\": \"Skip\", \"it\": \"Salta\"},\n260\t    \"snapshot\": {\"en\": \"Snapshot\", \"it\": \"Istantanea\"},\n261\t    \"start_coverage_session\": {\"en\": \"Start coverage session\", \"it\": \"Avvia sessione di copertura\"},\n262\t    \"stop\": {\"en\": \"Stop\", \"it\": \"Stop\"},\n263\t    \"take_car_in\": {\"en\": \"Take this car in\", \"it\": \"Accetta la vettura\"},\n264\t    \"take_to_gate\": {\"en\": \"Take it to the gate\", \"it\": \"Portalo alla soglia delle prove\"},\n265\t    \"triggers\": {\"en\": \"Triggers\", \"it\": \"Trigger\"},\n266\t    \"update_preview\": {\"en\": \"Update preview\", \"it\": \"Aggiorna anteprima\"},\n267\t    \"upload\": {\"en\": \"Upload\", \"it\": \"Carica\"},\n268\t    \"vin\": {\"en\": \"VIN\", \"it\": \"VIN\"},\n269\t    \"verify_passive_listen\": {\"en\": \"Verify (passive listen)\", \"it\": \"Verifica (ascolto passivo)\"},\n270\t    \"voltage\": {\"en\": \"Voltage\", \"it\": \"Tensione\"},\n271\t    \"parts\": {\"en\": \"Parts\", \"it\": \"Ricambi\"},\n272\t\n273\t    # -- common automotive/diagnostic terms (kept here since they recur\n274\t    #    across many of the headings/buttons above and are easy to get\n275\t    #    wrong in Italian if translated ad hoc per page) ------------------\n276\t    \"fault\": {\"en\": \"Fault\", \"it\": \"Guasto\"},\n277\t    \"fault_code\": {\"en\": \"Fault code\", \"it\": \"Codice errore\"},\n278\t    \"symptoms\": {\"en\": \"Symptoms\", \"it\": \"Sintomi\"},\n279\t    \"smoke_test\": {\"en\": \"Smoke test\", \"it\": \"Prova fumo\"},\n280\t    \"purge_valve\": {\"en\": \"Purge valve\", \"it\": \"Valvola di spurgo\"},\n281\t    \"ecm\": {\"en\": \"Engine control module\", \"it\": \"Centralina motore\"},\n282\t    \"wiring_harness\": {\"en\": \"Wiring harness\", \"it\": \"Impianto elettrico\"},\n283\t\n284\t    # -- language chooser (used by pick_language_html below) -------------\n285\t    \"language\": {\"en\": \"Language\", \"it\": \"Lingua\"},\n286\t}\n287\t\n288\t\n289\tdef t(key: str, lang: str = DEFAULT_LANG) -> str:\n290\t    \"\"\"Translate ``key`` into ``lang``, falling back to English, then to\n291\t    the bare key if ``key`` isn't in STRINGS at all (never raises -- a\n292\t    missing translation must degrade, not break the page).\"\"\"\n293\t    entry = STRINGS.get(key)\n294\t    if not entry:\n295\t        return key\n296\t    use_lang = lang if lang in SUPPORTED_LANGS else DEFAULT_LANG\n297\t    val = entry.get(use_lang)\n298\t    if val:\n299\t        return val\n300\t    return entry.get(_FALLBACK_LANG, key)\n301\t\n302\t\n303\tdef lang_from_cookie(cookie_value: Optional[str]) -> str:\n304\t    \"\"\"Normalise a raw ``lang`` cookie value to a supported language,\n305\t    defaulting to :data:`DEFAULT_LANG` (\"it\") for anything missing or\n306\t    unrecognised.\"\"\"\n307\t    v = (cookie_value or \"\").strip().lower()\n308\t    return v if v in SUPPORTED_LANGS else DEFAULT_LANG\n309\t\n310\t\n311\tdef set_lang_cookie(response: Any, lang: str) -> Any:\n312\t    \"\"\"Router-free helper for the integration pass: set the ``lang``\n313\t    cookie on a (FastAPI/Starlette-shaped) ``response``. Degrades to a\n314\t    no-op rather than raising if ``response`` doesn't support\n315\t    ``set_cookie`` -- callers should still get their response object back\n316\t    either way.\"\"\"\n317\t    use_lang = lang if lang in SUPPORTED_LANGS else DEFAULT_LANG\n318\t    try:\n319\t        response.set_cookie(\"lang\", use_lang, max_age=60 * 60 * 24 * 365,\n320\t                             samesite=\"lax\")\n321\t    except Exception:  # noqa: BLE001 -- must never break the response\n322\t        pass\n323\t    return response\n324\t\n325\t\n326\tdef pick_language_html(current: str) -> Any:\n327\t    \"\"\"A tiny, dependency-free Italiano/English chooser: two 44px-tall\n328\t    buttons (comfortable touch targets for a shop floor), the current\n329\t    language marked with ``aria-pressed``/a ``lang-btn-active`` class. The\n330\t    integration pass drops this in the header and on first visit, and\n331\t    wires its buttons' ``data-lang`` to a small script that POSTs/redirects\n332\t    to whatever route calls :func:`set_lang_cookie`.\n333\t    \"\"\"\n334\t    cur = current if current in SUPPORTED_LANGS else DEFAULT_LANG\n335\t    buttons = ((\"it\", \"Italiano\"), (\"en\", \"English\"))\n336\t\n337\t    def _btn(code: str, label: str) -> str:\n338\t        active = cur == code\n339\t        cls = \"lang-btn lang-btn-active\" if active else \"lang-btn\"\n340\t        return (\n341\t            f'<button type=\"button\" class=\"{cls}\" data-lang=\"{code}\" '\n342\t            f'aria-pressed=\"{\"true\" if active else \"false\"}\" '\n343\t            f'style=\"height:44px;min-width:44px;\">{escape(label)}</button>'\n344\t        )\n345\t\n346\t    html = (\n347\t        '<span class=\"lang-picker\" role=\"group\" aria-label=\"Italiano / English\">'\n348\t        + \"\".join(_btn(code, label) for code, label in buttons)\n349\t        + \"</span>\"\n350\t    )\n351\t    return Markup(html)\n352\t\n353\t\n354\t@pass_context\n355\tdef _t_global(ctx: Any, key: str, lang: Optional[str] = None) -> str:\n356\t    if lang is None:\n357\t        lang = _ctx_lang(ctx)\n358\t    return t(key, lang)\n359\t\n360\t\n361\t@pass_context\n362\tdef _lang_global(ctx: Any) -> str:\n363\t    return _ctx_lang(ctx)\n364\t\n365\t\n366\tdef _ctx_lang(ctx: Any) -> str:\n367\t    try:\n368\t        request = ctx.get(\"request\")\n369\t        cookie = request.cookies.get(\"lang\") if request is not None else None\n370\t    except Exception:  # noqa: BLE001 -- template globals must never raise\n371\t        cookie = None\n372\t    return lang_from_cookie(cookie)\n373\t\n374\t\n375\tdef _register(templates: Any) -> None:\n376\t    templates.env.globals[\"t\"] = _t_global\n377\t    templates.env.globals[\"lang\"] = _lang_global\n378\t\n379\t\n380\tfor _module_name in (\"routes\", \"service_routes\", \"drivetrain_routes\", \"timeline_routes\"):\n381\t    try:\n382\t        _mod = importlib.import_module(f\".{_module_name}\", __package__)\n383\t        _tmpl = getattr(_mod, \"templates\", None) or getattr(_mod, \"_shared_templates\", None)\n384\t        if _tmpl is not None:\n385\t            _register(_tmpl)\n386\t    except Exception:  # noqa: BLE001 -- import-time side effect, must never raise\n387\t        pass\n388\t\n389\t\n390\t__all__ = [\n391\t    \"SUPPORTED_LANGS\", \"DEFAULT_LANG\", \"STRINGS\",\n392\t    \"t\", \"lang_from_cookie\", \"set_lang_cookie\", \"pick_language_html\",\n393\t]\n394\t"}]},"uuid":"19487739-4152-435f-8136-35541fbf997e","timestamp":"2026-10-08T15:03:14.939Z","toolUseResult":{"type":"text","file":{"filePath":"C:\\Users\\User\\mcp-servers\\cuore\\web\\i18n.py","content":"\"\"\"UI string dictionary + the ``t`` / ``lang`` Jinja globals.\n\nCUORE's mechanics mostly don't read English as a first language (see\n``cuore/web/icons.py`` for the pictogram half of the same mitigation), so\nevery page-chrome label collected here (headings and button text, grepped\nfrom ``<h1>``-``<h3>`` and ``.btn`` across ``cuore/web/templates/*.html``)\ngets a translation, not just English. DTC codes, part numbers and VINs are\nnever put in here -- those are data, not UI chrome, and stay as-is wherever\na template renders them directly.\n\nLanguage model\n---------------\n``SUPPORTED_LANGS`` is the set actually filled in below (Italian, English\ntoday); the dict shape -- one ``{lang: text}`` map per key -- is already\nright for French/German/Spanish to be added later by just adding another\nkey to each entry and that language's code to ``SUPPORTED_LANGS``, with no\nchange to ``t()`` or the templates that call it.\n\n``DEFAULT_LANG`` is ``\"it\"``: most of this shop's mechanics default to\nItalian, and an unset or unrecognised ``lang`` cookie should not silently\nmean English. ``t(key, lang)`` looks up the requested language first and\nonly falls back to English (never to Italian, and never to ``DEFAULT_LANG``\nif that differs from the requested language) when that specific key has no\ntranslation for it -- a half-translated page beats a page that 500s or\nshows raw keys.\n\nRegistered as the Jinja globals ``t`` and ``lang`` on the same four\ntemplate environments ``experience_globals`` / ``icons`` register against\n(see those modules' docstrings for why four). Both are context-aware\n(``jinja2.pass_context``) so they read the ``lang`` cookie straight off the\ncurrent request rather than needing every route to pass it through\nexplicitly -- FastAPI's ``Jinja2Templates`` already puts ``request`` in\nevery template's context, which is what makes that possible. Importing this\nmodule is the side effect that does the registration; wiring it in is the\nsame one-line ``from ..web import i18n  # noqa: F401`` move the other\n``*_globals`` modules use -- left for the integration pass.\n\n``set_lang_cookie(response, lang)`` and ``pick_language_html(current)`` are\nplain, router-free helpers (no FastAPI import here) for that same\nintegration pass: the first sets the cookie on a response, the second\nrenders a 44px-tall Italiano/English chooser to drop in the header and on\nfirst visit.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport importlib\nfrom html import escape\nfrom typing import Any, Optional\n\ntry:  # pragma: no cover -- ships with Jinja2; keep the import optional anyway\n    from jinja2 import pass_context\nexcept Exception:  # noqa: BLE001 -- must not stop this module from loading\n    def pass_context(f):  # type: ignore[no-redef]\n        return f\n\ntry:  # pragma: no cover -- ships with Jinja2\n    from markupsafe import Markup\nexcept Exception:  # noqa: BLE001\n    def Markup(s: str) -> str:  # type: ignore[no-redef]\n        return s\n\n\n#: Languages this module actually has translations for. Order matters only\n#: for ``pick_language_html``'s button order. Extending to French/German/\n#: Spanish later is: add \"fr\"/\"de\"/\"es\" here and fill that key in STRINGS --\n#: nothing else changes.\nSUPPORTED_LANGS: tuple[str, ...] = (\"it\", \"en\")\n\n#: Most CUORE mechanics' first language -- an unset/unknown cookie means\n#: this, not English.\nDEFAULT_LANG = \"it\"\n\n#: English is the one language every key is guaranteed to have, so it is\n#: ``t()``'s fallback when the requested language's translation is missing\n#: for that specific key (not when the *cookie* is merely unset -- that\n#: case uses DEFAULT_LANG before t() is ever called, via lang_from_cookie).\n_FALLBACK_LANG = \"en\"\n\nSTRINGS: dict[str, dict[str, str]] = {\n    # -- the 12 flow-step headings ------------------------------------\n    \"start\": {\"en\": \"Start\", \"it\": \"Avvio\"},\n    \"complaint_symptoms\": {\"en\": \"Complaint & symptoms\", \"it\": \"Disturbo e sintomi\"},\n    \"verdict\": {\"en\": \"Verdict\", \"it\": \"Verdetto\"},\n    \"scan_codes\": {\"en\": \"Scan & codes\", \"it\": \"Scansione e codici\"},\n    \"understand_fault\": {\"en\": \"Understand the fault\", \"it\": \"Comprendere il guasto\"},\n    \"tests_inspections\": {\"en\": \"Tests & inspections\", \"it\": \"Prove e controlli\"},\n    \"hypotheses\": {\"en\": \"Hypotheses\", \"it\": \"Ipotesi\"},\n    \"plan_repair\": {\"en\": \"Plan the repair\", \"it\": \"Pianificare la riparazione\"},\n    \"repair\": {\"en\": \"Repair\", \"it\": \"Riparazione\"},\n    \"verify\": {\"en\": \"Verify\", \"it\": \"Verifica\"},\n    \"document\": {\"en\": \"Document\", \"it\": \"Documentare\"},\n    \"release\": {\"en\": \"Release\", \"it\": \"Rilascio\"},\n\n    # -- base chrome ------------------------------------------------------\n    \"home\": {\"en\": \"Home\", \"it\": \"Home\"},\n    \"menu\": {\"en\": \"Menu\", \"it\": \"Menu\"},\n    \"toggle_theme\": {\"en\": \"Toggle dark/light theme\", \"it\": \"Cambia tema chiaro/scuro\"},\n    \"print_page\": {\"en\": \"Print this page\", \"it\": \"Stampa questa pagina\"},\n    \"vehicles\": {\"en\": \"Vehicles\", \"it\": \"Veicoli\"},\n    \"modules\": {\"en\": \"Modules\", \"it\": \"Moduli\"},\n    \"recordings\": {\"en\": \"Recordings\", \"it\": \"Registrazioni\"},\n    \"logs\": {\"en\": \"Logs\", \"it\": \"Log\"},\n    \"live_link\": {\"en\": \"Live link\", \"it\": \"Collegamento live\"},\n    \"coverage\": {\"en\": \"Coverage\", \"it\": \"Copertura\"},\n    \"tools\": {\"en\": \"Tools\", \"it\": \"Attrezzi\"},\n\n    # -- headings ----------------------------------------------------------\n    \"adaptation_relearn\": {\"en\": \"Adaptation relearn\", \"it\": \"Riapprendimento adattivo\"},\n    \"adapter\": {\"en\": \"Adapter\", \"it\": \"Adattatore\"},\n    \"add_hypothesis\": {\"en\": \"Add a hypothesis\", \"it\": \"Aggiungi un'ipotesi\"},\n    \"add_note\": {\"en\": \"Add a note\", \"it\": \"Aggiungi una nota\"},\n    \"add_media\": {\"en\": \"Add photos, video, sounds or documents\", \"it\": \"Aggiungi foto, video, audio o documenti\"},\n    \"alarms_markers\": {\"en\": \"Alarms & markers\", \"it\": \"Allarmi e segnalatori\"},\n    \"already_attempted\": {\"en\": \"Already attempted\", \"it\": \"Già tentato\"},\n    \"blind_spots\": {\"en\": \"Blind spots\", \"it\": \"Punti ciechi\"},\n    \"brake_tyre_spec\": {\"en\": \"Brake / tyre specification\", \"it\": \"Specifiche freni / pneumatici\"},\n    \"brakes_wheels_tyres\": {\"en\": \"Brakes, wheels & tyres\", \"it\": \"Freni, ruote e pneumatici\"},\n    \"bulletins\": {\"en\": \"Bulletins\", \"it\": \"Bollettini\"},\n    \"buses\": {\"en\": \"Buses\", \"it\": \"Bus dati\"},\n    \"by_family\": {\"en\": \"By family\", \"it\": \"Per famiglia\"},\n    \"cable\": {\"en\": \"Cable\", \"it\": \"Cavo\"},\n    \"calibrate\": {\"en\": \"Calibrate\", \"it\": \"Calibrare\"},\n    \"carried_forward\": {\"en\": \"Carried forward from last time\", \"it\": \"Riportato dalla volta precedente\"},\n    \"checks\": {\"en\": \"Checks\", \"it\": \"Controlli\"},\n    \"choose_job\": {\"en\": \"Choose a job\", \"it\": \"Scegli un lavoro\"},\n    \"choose_job_category\": {\"en\": \"Choose a job category\", \"it\": \"Scegli una categoria di lavoro\"},\n    \"choose_items_visit\": {\"en\": \"Choose items for this visit\", \"it\": \"Scegli gli elementi per questa visita\"},\n    \"co_occurrence\": {\"en\": \"Co-occurrence\", \"it\": \"Co-occorrenza\"},\n    \"code_timeline\": {\"en\": \"Code timeline\", \"it\": \"Cronologia dei codici\"},\n    \"codes\": {\"en\": \"Codes\", \"it\": \"Codici\"},\n    \"codes_vs_driver\": {\"en\": \"Codes vs. what the driver notices\", \"it\": \"Codici rispetto a ciò che nota il guidatore\"},\n    \"columns\": {\"en\": \"Columns\", \"it\": \"Colonne\"},\n    \"considerations_next\": {\"en\": \"Considerations for next time\", \"it\": \"Considerazioni per la prossima volta\"},\n    \"corners\": {\"en\": \"Corners\", \"it\": \"Angoli (ruote)\"},\n    \"corpus\": {\"en\": \"Corpus\", \"it\": \"Corpus\"},\n    \"current_picture\": {\"en\": \"Current picture\", \"it\": \"Quadro attuale\"},\n    \"custom_sheet_dims\": {\"en\": \"Custom sheet dimensions (mm)\", \"it\": \"Dimensioni foglio personalizzate (mm)\"},\n    \"dtc_report\": {\"en\": \"DTC report\", \"it\": \"Rapporto DTC\"},\n    \"dtcs_0x1902\": {\"en\": \"DTCs (0x19 02)\", \"it\": \"DTC (0x19 02)\"},\n    \"dtcs_by_module\": {\"en\": \"DTCs by module\", \"it\": \"DTC per modulo\"},\n    \"dashboard\": {\"en\": \"Dashboard\", \"it\": \"Cruscotto\"},\n    \"dealer_results\": {\"en\": \"Dealer (wiTECH) results\", \"it\": \"Risultati concessionaria (wiTECH)\"},\n    \"dependency_graph\": {\"en\": \"Dependency graph\", \"it\": \"Grafo delle dipendenze\"},\n    \"discoveries\": {\"en\": \"Discoveries\", \"it\": \"Scoperte\"},\n    \"discoveries_considerations\": {\"en\": \"Discoveries & considerations\", \"it\": \"Scoperte e considerazioni\"},\n    \"drain_condition\": {\"en\": \"Drain & condition\", \"it\": \"Scarico e condizione\"},\n    \"drive_cycle_counters\": {\"en\": \"Drive-cycle counters\", \"it\": \"Contatori ciclo di guida\"},\n    \"due_status\": {\"en\": \"Due status\", \"it\": \"Stato scadenza\"},\n    \"epb_rear\": {\"en\": \"Electric parking brake (rear)\", \"it\": \"Freno di stazionamento elettrico (posteriore)\"},\n    \"electrical\": {\"en\": \"Electrical\", \"it\": \"Impianto elettrico\"},\n    \"electrical_path\": {\"en\": \"Electrical path\", \"it\": \"Percorso elettrico\"},\n    \"elements\": {\"en\": \"Elements\", \"it\": \"Elementi\"},\n    \"every_code\": {\"en\": \"Every code this car has set\", \"it\": \"Ogni codice impostato da questa vettura\"},\n    \"every_occurrence\": {\"en\": \"Every occurrence\", \"it\": \"Ogni occorrenza\"},\n    \"everything_corpus\": {\"en\": \"Everything in the corpus\", \"it\": \"Tutto il corpus\"},\n    \"evidence_gate\": {\"en\": \"Evidence gate\", \"it\": \"Soglia delle prove\"},\n    \"excursions\": {\"en\": \"Excursions\", \"it\": \"Escursioni\"},\n    \"fault_tree\": {\"en\": \"Fault tree\", \"it\": \"Albero dei guasti\"},\n    \"filter\": {\"en\": \"Filter\", \"it\": \"Filtro\"},\n    \"flash_check\": {\"en\": \"Flash check\", \"it\": \"Controllo flash\"},\n    \"fluid\": {\"en\": \"Fluid\", \"it\": \"Fluido\"},\n    \"fluid_condition\": {\"en\": \"Fluid condition\", \"it\": \"Condizione del fluido\"},\n    \"freeze_frames\": {\"en\": \"Freeze frames\", \"it\": \"Fotogrammi congelati\"},\n    \"front_differential\": {\"en\": \"Front differential\", \"it\": \"Differenziale anteriore\"},\n    \"gauges\": {\"en\": \"Gauges\", \"it\": \"Strumenti\"},\n    \"general_service\": {\"en\": \"General service\", \"it\": \"Tagliando generale\"},\n    \"history\": {\"en\": \"History\", \"it\": \"Storico\"},\n    \"identity_annex_c\": {\"en\": \"Identity (Annex C)\", \"it\": \"Identità (Allegato C)\"},\n    \"inbox\": {\"en\": \"Inbox\", \"it\": \"Posta in arrivo\"},\n    \"inspection_tag_fields\": {\"en\": \"Inspection tag fields\", \"it\": \"Campi etichetta ispezione\"},\n    \"job\": {\"en\": \"Job\", \"it\": \"Lavoro\"},\n    \"job_tag_fields\": {\"en\": \"Job tag fields\", \"it\": \"Campi etichetta lavoro\"},\n    \"keyboard\": {\"en\": \"Keyboard\", \"it\": \"Tastiera\"},\n    \"kind_template\": {\"en\": \"Kind & template\", \"it\": \"Tipo e modello\"},\n    \"known_issues\": {\"en\": \"Known issues\", \"it\": \"Problemi noti\"},\n    \"labels_printed\": {\"en\": \"Labels printed\", \"it\": \"Etichette stampate\"},\n    \"last_90_days\": {\"en\": \"Last 90 days\", \"it\": \"Ultimi 90 giorni\"},\n    \"last_maintenance_visit\": {\"en\": \"Last maintenance visit\", \"it\": \"Ultimo intervento di manutenzione\"},\n    \"last_oil_change\": {\"en\": \"Last oil change\", \"it\": \"Ultimo cambio olio\"},\n    \"latest_all_systems_scan\": {\"en\": \"Latest all-systems scan\", \"it\": \"Ultima scansione di tutti i sistemi\"},\n    \"latest_session\": {\"en\": \"Latest session\", \"it\": \"Ultima sessione\"},\n    \"legislated_obd\": {\"en\": \"Legislated OBD (CAN-C)\", \"it\": \"OBD legale (CAN-C)\"},\n    \"live\": {\"en\": \"Live\", \"it\": \"Live\"},\n    \"live_status\": {\"en\": \"Live status\", \"it\": \"Stato live\"},\n    \"live_vs_log\": {\"en\": \"Live vs log\", \"it\": \"Live rispetto al log\"},\n    \"log_symptom\": {\"en\": \"Log a symptom\", \"it\": \"Registra un sintomo\"},\n    \"log_index\": {\"en\": \"Log index\", \"it\": \"Indice dei log\"},\n    \"mes_and_lock\": {\"en\": \"MES and lock\", \"it\": \"MES e blocco\"},\n    \"maintenance_reminder_fields\": {\"en\": \"Maintenance reminder fields\", \"it\": \"Campi promemoria manutenzione\"},\n\n    # -- buttons -------------------------------------------------------\n    \"back_to_dossier\": {\"en\": \"Back to dossier\", \"it\": \"Torna al dossier\"},\n    \"add_to_ledger\": {\"en\": \"Add to ledger\", \"it\": \"Aggiungi al registro\"},\n    \"all\": {\"en\": \"All\", \"it\": \"Tutti\"},\n    \"all_domains\": {\"en\": \"All domains\", \"it\": \"Tutti i domini\"},\n    \"answer\": {\"en\": \"Answer\", \"it\": \"Rispondi\"},\n    \"assess\": {\"en\": \"Assess\", \"it\": \"Valuta\"},\n    \"back_to_tree\": {\"en\": \"Back to the tree\", \"it\": \"Torna all'albero\"},\n    \"clear\": {\"en\": \"Clear\", \"it\": \"Pulisci\"},\n    \"clear_filter\": {\"en\": \"Clear filter\", \"it\": \"Rimuovi filtro\"},\n    \"close\": {\"en\": \"Close\", \"it\": \"Chiudi\"},\n    \"close_case\": {\"en\": \"Close case\", \"it\": \"Chiudi il caso\"},\n    \"connect\": {\"en\": \"Connect\", \"it\": \"Connetti\"},\n    \"custom_channels\": {\"en\": \"Custom channels\", \"it\": \"Canali personalizzati\"},\n    \"declare_cable\": {\"en\": \"Declare cable\", \"it\": \"Dichiara cavo\"},\n    \"discard_session\": {\"en\": \"Discard this session\", \"it\": \"Scarta questa sessione\"},\n    \"dismiss\": {\"en\": \"Dismiss\", \"it\": \"Ignora\"},\n    \"download_pdf\": {\"en\": \"Download PDF\", \"it\": \"Scarica PDF\"},\n    \"edit_layout\": {\"en\": \"Edit layout\", \"it\": \"Modifica layout\"},\n    \"exclude_simulation\": {\"en\": \"Exclude simulation\", \"it\": \"Escludi simulazione\"},\n    \"export\": {\"en\": \"Export\", \"it\": \"Esporta\"},\n    \"find_excursions\": {\"en\": \"Find excursions\", \"it\": \"Trova escursioni\"},\n    \"go_to_release\": {\"en\": \"Go to release\", \"it\": \"Vai al rilascio\"},\n    \"hud\": {\"en\": \"HUD\", \"it\": \"HUD\"},\n    \"hide\": {\"en\": \"Hide\", \"it\": \"Nascondi\"},\n    \"i_dont\": {\"en\": \"I don't\", \"it\": \"Io no\"},\n    \"i_have_this\": {\"en\": \"I have this\", \"it\": \"Io sì\"},\n    \"import_\": {\"en\": \"Import\", \"it\": \"Importa\"},\n    \"include_simulation\": {\"en\": \"Include simulation\", \"it\": \"Includi simulazione\"},\n    \"load_checklist\": {\"en\": \"Load checklist\", \"it\": \"Carica lista di controllo\"},\n    \"load_fields_checked\": {\"en\": \"Load fields for checked items\", \"it\": \"Carica campi per gli elementi selezionati\"},\n    \"load_job\": {\"en\": \"Load job\", \"it\": \"Carica lavoro\"},\n    \"mark\": {\"en\": \"Mark\", \"it\": \"Segna\"},\n    \"mark_applied\": {\"en\": \"Mark applied\", \"it\": \"Segna come applicato\"},\n    \"open_original\": {\"en\": \"Open original\", \"it\": \"Apri originale\"},\n    \"pause_all\": {\"en\": \"Pause all\", \"it\": \"Pausa generale\"},\n    \"print_test_grid\": {\"en\": \"Print test grid (plain paper)\", \"it\": \"Stampa griglia di prova (carta semplice)\"},\n    \"probe_adapter\": {\"en\": \"Probe adapter\", \"it\": \"Adattatore sonda\"},\n    \"read_dtcs\": {\"en\": \"Read DTCs\", \"it\": \"Leggi DTC\"},\n    \"read_readiness\": {\"en\": \"Read readiness\", \"it\": \"Leggi readiness\"},\n    \"read_with_confirmation\": {\"en\": \"Read with confirmation\", \"it\": \"Leggi con conferma\"},\n    \"readiness\": {\"en\": \"Readiness\", \"it\": \"Readiness\"},\n    \"record\": {\"en\": \"Record\", \"it\": \"Registra\"},\n    \"record_dtc_report\": {\"en\": \"Record DTC report\", \"it\": \"Registra rapporto DTC\"},\n    \"record_slvt\": {\"en\": \"Record SLVT\", \"it\": \"Registra SLVT\"},\n    \"record_action\": {\"en\": \"Record action\", \"it\": \"Registra azione\"},\n    \"record_brakes_wheels_tyres\": {\"en\": \"Record brakes/wheels/tyres service\", \"it\": \"Registra intervento freni/ruote/pneumatici\"},\n    \"record_flash_check\": {\"en\": \"Record flash check\", \"it\": \"Registra controllo flash\"},\n    \"record_inspection\": {\"en\": \"Record inspection\", \"it\": \"Registra ispezione\"},\n    \"record_maintenance_visit\": {\"en\": \"Record maintenance visit\", \"it\": \"Registra intervento di manutenzione\"},\n    \"record_oil_change\": {\"en\": \"Record oil change\", \"it\": \"Registra cambio olio\"},\n    \"record_recall_status\": {\"en\": \"Record recall status\", \"it\": \"Registra stato richiamo\"},\n    \"record_routine\": {\"en\": \"Record routine\", \"it\": \"Registra routine\"},\n    \"record_service\": {\"en\": \"Record service\", \"it\": \"Registra intervento\"},\n    \"registry_entry\": {\"en\": \"Registry entry\", \"it\": \"Voce di registro\"},\n    \"release_car\": {\"en\": \"Release car\", \"it\": \"Rilascia la vettura\"},\n    \"reopen\": {\"en\": \"Reopen\", \"it\": \"Riapri\"},\n    \"route\": {\"en\": \"Route\", \"it\": \"Instrada\"},\n    \"run_this_pass\": {\"en\": \"Run this pass\", \"it\": \"Esegui questo passaggio\"},\n    \"save\": {\"en\": \"Save\", \"it\": \"Salva\"},\n    \"save_as\": {\"en\": \"Save as\", \"it\": \"Salva come\"},\n    \"save_calibration\": {\"en\": \"Save calibration\", \"it\": \"Salva calibrazione\"},\n    \"save_inspection\": {\"en\": \"Save inspection\", \"it\": \"Salva ispezione\"},\n    \"save_symptom_report\": {\"en\": \"Save symptom report\", \"it\": \"Salva segnalazione sintomo\"},\n    \"save_tools_review\": {\"en\": \"Save tools review\", \"it\": \"Salva revisione attrezzi\"},\n    \"search\": {\"en\": \"Search\", \"it\": \"Cerca\"},\n    \"send\": {\"en\": \"Send\", \"it\": \"Invia\"},\n    \"skip\": {\"en\": \"Skip\", \"it\": \"Salta\"},\n    \"snapshot\": {\"en\": \"Snapshot\", \"it\": \"Istantanea\"},\n    \"start_coverage_session\": {\"en\": \"Start coverage session\", \"it\": \"Avvia sessione di copertura\"},\n    \"stop\": {\"en\": \"Stop\", \"it\": \"Stop\"},\n    \"take_car_in\": {\"en\": \"Take this car in\", \"it\": \"Accetta la vettura\"},\n    \"take_to_gate\": {\"en\": \"Take it to the gate\", \"it\": \"Portalo alla soglia delle prove\"},\n    \"triggers\": {\"en\": \"Triggers\", \"it\": \"Trigger\"},\n    \"update_preview\": {\"en\": \"Update preview\", \"it\": \"Aggiorna anteprima\"},\n    \"upload\": {\"en\": \"Upload\", \"it\": \"Carica\"},\n    \"vin\": {\"en\": \"VIN\", \"it\": \"VIN\"},\n    \"verify_passive_listen\": {\"en\": \"Verify (passive listen)\", \"it\": \"Verifica (ascolto passivo)\"},\n    \"voltage\": {\"en\": \"Voltage\", \"it\": \"Tensione\"},\n    \"parts\": {\"en\": \"Parts\", \"it\": \"Ricambi\"},\n\n    # -- common automotive/diagnostic terms (kept here since they recur\n    #    across many of the headings/buttons above and are easy to get\n    #    wrong in Italian if translated ad hoc per page) ------------------\n    \"fault\": {\"en\": \"Fault\", \"it\": \"Guasto\"},\n    \"fault_code\": {\"en\": \"Fault code\", \"it\": \"Codice errore\"},\n    \"symptoms\": {\"en\": \"Symptoms\", \"it\": \"Sintomi\"},\n    \"smoke_test\": {\"en\": \"Smoke test\", \"it\": \"Prova fumo\"},\n    \"purge_valve\": {\"en\": \"Purge valve\", \"it\": \"Valvola di spurgo\"},\n    \"ecm\": {\"en\": \"Engine control module\", \"it\": \"Centralina motore\"},\n    \"wiring_harness\": {\"en\": \"Wiring harness\", \"it\": \"Impianto elettrico\"},\n\n    # -- language chooser (used by pick_language_html below) -------------\n    \"language\": {\"en\": \"Language\", \"it\": \"Lingua\"},\n}\n\n\ndef t(key: str, lang: str = DEFAULT_LANG) -> str:\n    \"\"\"Translate ``key`` into ``lang``, falling back to English, then to\n    the bare key if ``key`` isn't in STRINGS at all (never raises -- a\n    missing translation must degrade, not break the page).\"\"\"\n    entry = STRINGS.get(key)\n    if not entry:\n        return key\n    use_lang = lang if lang in SUPPORTED_LANGS else DEFAULT_LANG\n    val = entry.get(use_lang)\n    if val:\n        return val\n    return entry.get(_FALLBACK_LANG, key)\n\n\ndef lang_from_cookie(cookie_value: Optional[str]) -> str:\n    \"\"\"Normalise a raw ``lang`` cookie value to a supported language,\n    defaulting to :data:`DEFAULT_LANG` (\"it\") for anything missing or\n    unrecognised.\"\"\"\n    v = (cookie_value or \"\").strip().lower()\n    return v if v in SUPPORTED_LANGS else DEFAULT_LANG\n\n\ndef set_lang_cookie(response: Any, lang: str) -> Any:\n    \"\"\"Router-free helper for the integration pass: set the ``lang``\n    cookie on a (FastAPI/Starlette-shaped) ``response``. Degrades to a\n    no-op rather than raising if ``response`` doesn't support\n    ``set_cookie`` -- callers should still get their response object back\n    either way.\"\"\"\n    use_lang = lang if lang in SUPPORTED_LANGS else DEFAULT_LANG\n    try:\n        response.set_cookie(\"lang\", use_lang, max_age=60 * 60 * 24 * 365,\n                             samesite=\"lax\")\n    except Exception:  # noqa: BLE001 -- must never break the response\n        pass\n    return response\n\n\ndef pick_language_html(current: str) -> Any:\n    \"\"\"A tiny, dependency-free Italiano/English chooser: two 44px-tall\n    buttons (comfortable touch targets for a shop floor), the current\n    language marked with ``aria-pressed``/a ``lang-btn-active`` class. The\n    integration pass drops this in the header and on first visit, and\n    wires its buttons' ``data-lang`` to a small script that POSTs/redirects\n    to whatever route calls :func:`set_lang_cookie`.\n    \"\"\"\n    cur = current if current in SUPPORTED_LANGS else DEFAULT_LANG\n    buttons = ((\"it\", \"Italiano\"), (\"en\", \"English\"))\n\n    def _btn(code: str, label: str) -> str:\n        active = cur == code\n        cls = \"lang-btn lang-btn-active\" if active else \"lang-btn\"\n        return (\n            f'<button type=\"button\" class=\"{cls}\" data-lang=\"{code}\" '\n            f'aria-pressed=\"{\"true\" if active else \"false\"}\" '\n            f'style=\"height:44px;min-width:44px;\">{escape(label)}</button>'\n        )\n\n    html = (\n        '<span class=\"lang-picker\" role=\"group\" aria-label=\"Italiano / English\">'\n        + \"\".join(_btn(code, label) for code, label in buttons)\n        + \"</span>\"\n    )\n    return Markup(html)\n\n\n@pass_context\ndef _t_global(ctx: Any, key: str, lang: Optional[str] = None) -> str:\n    if lang is None:\n        lang = _ctx_lang(ctx)\n    return t(key, lang)\n\n\n@pass_context\ndef _lang_global(ctx: Any) -> str:\n    return _ctx_lang(ctx)\n\n\ndef _ctx_lang(ctx: Any) -> str:\n    try:\n        request = ctx.get(\"request\")\n        cookie = request.cookies.get(\"lang\") if request is not None else None\n    except Exception:  # noqa: BLE001 -- template globals must never raise\n        cookie = None\n    return lang_from_cookie(cookie)\n\n\ndef _register(templates: Any) -> None:\n    templates.env.globals[\"t\"] = _t_global\n    templates.env.globals[\"lang\"] = _lang_global\n\n\nfor _module_name in (\"routes\", \"service_routes\", \"drivetrain_routes\", \"timeline_routes\"):\n    try:\n        _mod = importlib.import_module(f\".{_module_name}\", __package__)\n        _tmpl = getattr(_mod, \"templates\", None) or getattr(_mod, \"_shared_templates\", None)\n        if _tmpl is not None:\n            _register(_tmpl)\n    except Exception:  # noqa: BLE001 -- import-time side effect, must never raise\n        pass\n\n\n__all__ = [\n    \"SUPPORTED_LANGS\", \"DEFAULT_LANG\", \"STRINGS\",\n    \"t\", \"lang_from_cookie\", \"set_lang_cookie\", \"pick_language_html\",\n]\n","numLines":394,"startLine":1,"totalLines":394}},"sourceToolAssistantUUID":"45adfb7a-b042-40d8-b550-d13a75e9024f","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
