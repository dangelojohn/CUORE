diagnostic terms (kept here since they recur","     #    across many of the headings/buttons above and are easy to get"]}],"userModified":false,"replaceAll":false},"serverClassifierContext":{"request":"bcaf2adb-aaff-4482-a0ed-778a3d04d593","context":{"git_state":{"cwd":"/c/Users/User/mcp-servers","root":"/c/Users/User/mcp-servers","branch":"main","default_branch":null,"status":{"clean":false,"counts":{"staged":0,"modified":9,"untracked":null,"untracked_normal":4},"porcelain":null,"truncated":false},"visibility":{"origin":null,"push_remote":"origin","remotes":[{"name":"github","host":"github.com","remote":"dangelojohn/CUORE","visibility":"unknown"}],"visibility_cache":[]}},"live_cwd":"/c/Users/User/mcp-servers","platform":"windows"}},"sourceToolAssistantUUID":"348491ed-56d1-4696-a392-f7d80cc7be62","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
