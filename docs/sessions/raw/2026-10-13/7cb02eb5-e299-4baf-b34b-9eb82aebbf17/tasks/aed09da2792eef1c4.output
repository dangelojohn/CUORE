{"parentUuid":"0b317f31-9eab-45cc-b348-6ba7189ea8d8","isSidechain":true,"promptId":"c8683b5a-1bb3-40f7-aff9-33655508a2e2","agentId":"aed09da2792eef1c4","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Fjf272DN3PfEwQpMgLePaS","type":"tool_result","content":"1\t\"\"\"The only module in CUORE that imports :mod:`mes.cases`.\n2\t\n3\tThin pass-through, same posture as ``systems_bridge.py``/``feedback_bridge.py``:\n4\tevery route reaches case memory only through this file. Nothing here invents\n5\ta result -- ``match``/``prefill`` return exactly what ``mes.cases`` built from\n6\treal job/shop/tool-usage/service/symptom records, worded so a prior car's fix\n7\tis never presented as this car's answer.\n8\t\"\"\"\n9\t\n10\tfrom __future__ import annotations\n11\t\n12\tfrom typing import Any\n13\t\n14\tfrom .. import bootstrap  # noqa: F401  -- side effect: puts `mes` on sys.path\n15\tfrom .errors import BadRequest\n16\t\n17\tfrom mes import cases as cases_mod  # noqa: E402\n18\t\n19\t\n20\tdef _require_vin(vin: str) -> str:\n21\t    vin = (vin or \"\").strip()\n22\t    if not vin:\n23\t        raise BadRequest(\"a VIN is required\")\n24\t    return vin\n25\t\n26\t\n27\tdef match(vin: str, codes: list[str]) -> dict[str, Any]:\n28\t    \"\"\"Prior cases for this VIN's model, ranked by code/family overlap and\n29\t    outcome -- see ``mes.cases.match`` for the ranking and wording rules.\"\"\"\n30\t    vin = _require_vin(vin)\n31\t    rows = cases_mod.match(vin, codes or [])\n32\t    return {\"vin\": vin, \"codes\": [c.strip().upper() for c in (codes or []) if c.strip()],\n33\t           \"matches\": rows, \"count\": len(rows)}\n34\t\n35\t\n36\tdef prefill(vin: str, codes: list[str]) -> dict[str, Any]:\n37\t    \"\"\"A suggested starting point for a new job on this VIN, built from the\n38\t    best-matching prior case -- see ``mes.cases.prefill``.\"\"\"\n39\t    vin = _require_vin(vin)\n40\t    return cases_mod.prefill(vin, codes or [])\n41\t\n42\t\n43\tdef record_case(vin: str, job_id: str) -> dict[str, Any]:\n44\t    \"\"\"Build and persist a Case from one job. Exposed here so a caller that\n45\t    *can* edit ``mes/jobs.py``/``cuore/services/jobs_bridge.py`` (this task's\n46\t    scope excludes both) can wire this in on close; until then, nothing\n47\t    calls it automatically.\"\"\"\n48\t    vin = _require_vin(vin)\n49\t    job_id = (job_id or \"\").strip()\n50\t    if not job_id:\n51\t        raise BadRequest(\"a job_id is required\")\n52\t    try:\n53\t        return cases_mod.record_case(vin, job_id)\n54\t    except ValueError as exc:\n55\t        raise BadRequest(str(exc)) from exc\n56\t\n57\t\n58\t__all__ = [\"match\", \"prefill\", \"record_case\"]\n59\t"}]},"uuid":"ffee825c-6b36-4aac-ac4a-06546bb33abd","timestamp":"2026-10-08T15:03:10.547Z","toolUseResult":{"type":"text","file":{"filePath":"C:\\Users\\User\\mcp-servers\\cuore\\services\\cases_bridge.py","content":"\"\"\"The only module in CUORE that imports :mod:`mes.cases`.\n\nThin pass-through, same posture as ``systems_bridge.py``/``feedback_bridge.py``:\nevery route reaches case memory only through this file. Nothing here invents\na result -- ``match``/``prefill`` return exactly what ``mes.cases`` built from\nreal job/shop/tool-usage/service/symptom records, worded so a prior car's fix\nis never presented as this car's answer.\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom typing import Any\n\nfrom .. import bootstrap  # noqa: F401  -- side effect: puts `mes` on sys.path\nfrom .errors import BadRequest\n\nfrom mes import cases as cases_mod  # noqa: E402\n\n\ndef _require_vin(vin: str) -> str:\n    vin = (vin or \"\").strip()\n    if not vin:\n        raise BadRequest(\"a VIN is required\")\n    return vin\n\n\ndef match(vin: str, codes: list[str]) -> dict[str, Any]:\n    \"\"\"Prior cases for this VIN's model, ranked by code/family overlap and\n    outcome -- see ``mes.cases.match`` for the ranking and wording rules.\"\"\"\n    vin = _require_vin(vin)\n    rows = cases_mod.match(vin, codes or [])\n    return {\"vin\": vin, \"codes\": [c.strip().upper() for c in (codes or []) if c.strip()],\n           \"matches\": rows, \"count\": len(rows)}\n\n\ndef prefill(vin: str, codes: list[str]) -> dict[str, Any]:\n    \"\"\"A suggested starting point for a new job on this VIN, built from the\n    best-matching prior case -- see ``mes.cases.prefill``.\"\"\"\n    vin = _require_vin(vin)\n    return cases_mod.prefill(vin, codes or [])\n\n\ndef record_case(vin: str, job_id: str) -> dict[str, Any]:\n    \"\"\"Build and persist a Case from one job. Exposed here so a caller that\n    *can* edit ``mes/jobs.py``/``cuore/services/jobs_bridge.py`` (this task's\n    scope excludes both) can wire this in on close; until then, nothing\n    calls it automatically.\"\"\"\n    vin = _require_vin(vin)\n    job_id = (job_id or \"\").strip()\n    if not job_id:\n        raise BadRequest(\"a job_id is required\")\n    try:\n        return cases_mod.record_case(vin, job_id)\n    except ValueError as exc:\n        raise BadRequest(str(exc)) from exc\n\n\n__all__ = [\"match\", \"prefill\", \"record_case\"]\n","numLines":59,"startLine":1,"totalLines":59}},"sourceToolAssistantUUID":"0b317f31-9eab-45cc-b348-6ba7189ea8d8","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
{"parentUuid":"ffee825c-6b36-4aac-ac4a-06546bb33abd","isSidechain":true,"agentId":"aed09da2792eef1c4","message":{"model":"claude-sonnet-5","id":"msg_011CfpyQmn1GFPsd4cJjs53b","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01Jd4uBB3f3ihqeay5DJECjQ","name":"Read","input":{"file_path":"C:\\Users\\User\\mcp-servers\\cuore\\services\\flow_bridge.py"},"caller":{"type":"direct"}}],"container":null,"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":16504,"cache_read_input_tokens":82918,"output_tokens":478,"output_tokens_details":{"thinking_tokens":106},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":0,"ephemeral_5m_input_tokens":16504},"inference_geo":"not_available","iterations":[{"input_tokens":2,"output_tokens":478,"cache_read_input_tokens":82918,"cache_creation_input_tokens":16504,"cache_creation":{"ephemeral_5m_input_tokens":16504,"ephemeral_1h_input_tokens":0},"type":"message"}],"speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_01Jd4uBB3f3ihqeay5DJECjQ":{"file_path":"C:\\Users\\User\\mcp-servers\\cuore\\services\\flow_bridge.py"}},"serverClassifierRequest":"f78b0ee6-3100-4f3c-be9c-92c14033f6bb","apiBlockIndex":5,"requestId":"req_011CfpyQmUQWxgKYX93bWBni","attributionAgent":"general-purpose","type":"assistant","uuid":"28d3f342-3f5f-4adb-9193-eb0bc9c5aabf","timestamp":"2026-10-08T15:03:10.857Z","effort":"high","perTurnEffort":null,"userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
{"parentUuid":"28d3f342-3f5f-4adb-9193-eb0bc9c5aabf","isSidechain":true,"promptId":"c8683b5a-1bb3-40f7-aff9-33655508a2e2","agentId":"aed09da2792eef1c4","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Jd4uBB3f3ihqeay5DJECjQ","type":"tool_result","content":"1\t\"\"\"The mechanic flow: one fixed 12-step order laid over whatever real\n2\trecords exist for a VIN, so a technician (or the home page, for the car\n3\tpresently in the bay) can see \"what's next\" without hunting across pages.\n4\t\n5\tNothing here is a new source of truth -- it only reads :mod:`mes.shop` and\n6\t:mod:`mes.jobs` (both still landing, so imported lazily and degraded to\n7\t``None`` if either is missing or broken) plus the bridges that already\n8\tanswer the dossier/job/symptom/media/feedback questions, and folds them into\n9\tone ordered step list. Done/current/todo/blocked is derived from real\n10\trecords only -- never inferred from UI state.\n11\t\"\"\"\n12\t\n13\tfrom __future__ import annotations\n14\t\n15\tfrom typing import Any, Callable, Optional\n16\t\n17\tfrom .. import bootstrap  # noqa: F401  -- side effect: puts `mes` on sys.path\n18\tfrom . import cache, dossier_bridge, mes_bridge\n19\tfrom .errors import BadRequest\n20\t\n21\ttry:\n22\t    from . import timeline_bridge\n23\texcept Exception:  # noqa: BLE001 -- the flow must still render without it\n24\t    timeline_bridge = None\n25\t\n26\ttry:\n27\t    from ..live import store as live_store\n28\texcept Exception:  # noqa: BLE001\n29\t    live_store = None\n30\t\n31\t\n32\tdef _shop_mod() -> Any:\n33\t    \"\"\"``mes.shop`` is still landing -- import lazily, degrade to ``None``.\"\"\"\n34\t    try:\n35\t        from mes import shop as shop_mod\n36\t        return shop_mod\n37\t    except Exception:  # noqa: BLE001\n38\t        return None\n39\t\n40\t\n41\tdef _jobs_mod() -> Any:\n42\t    \"\"\"``mes.jobs`` likewise.\"\"\"\n43\t    try:\n44\t        from mes import jobs as jobs_mod\n45\t        return jobs_mod\n46\t    except Exception:  # noqa: BLE001\n47\t        return None\n48\t\n49\t\n50\t#: n, key, title, button_label -- href is built per-VIN in _href().\n51\t_STEPS: list[tuple[int, str, str, str]] = [\n52\t    (1, \"intake\", \"Intake\", \"Start intake\"),\n53\t    (2, \"symptoms\", \"Complaint & symptoms\", \"Record symptoms\"),\n54\t    (3, \"verdict\", \"Verdict\", \"Open verdict\"),\n55\t    (4, \"scan\", \"Scan & codes\", \"Scan the car\"),\n56\t    (5, \"understand\", \"Understand the fault\", \"Review the code\"),\n57\t    (6, \"tests\", \"Tests & inspections\", \"Run tests\"),\n58\t    (7, \"hypotheses\", \"Hypotheses\", \"Confirm hypothesis\"),\n59\t    (8, \"plan\", \"Plan the repair\", \"Plan the repair\"),\n60\t    (9, \"repair\", \"Repair\", \"Log repair\"),\n61\t    (10, \"verify\", \"Verify\", \"Read readiness\"),\n62\t    (11, \"document\", \"Document\", \"Print report\"),\n63\t    (12, \"release\", \"Release\", \"Release the car\"),\n64\t]\n65\t\n66\t#: Flow step n -> the shop's own job-stepper step number (1-7), used to pull\n67\t#: a learned average minutes out of ``mes.shop.board()``. Steps with no\n68\t#: direct counterpart (intake, verdict, understand, plan, release) get no\n69\t#: estimate rather than a misleading one.\n70\t_FLOW_TO_JOB_STEP = {2: 1, 4: 2, 6: 3, 7: 4, 9: 5, 10: 6, 11: 7}\n71\t\n72\t\n73\tdef _norm_ts(ts: Optional[str]) -> str:\n74\t    \"\"\"Normalize an ISO-ish timestamp (\"...T...\" or \"... ...\") to a\n75\t    space-separated, lexicographically-comparable form.\"\"\"\n76\t    return (ts or \"\").replace(\"T\", \" \")[:19]\n77\t\n78\t\n79\tdef _short_date(ts: Optional[str]) -> str:\n80\t    \"\"\"\"4 Oct\"-style date out of an ISO-ish timestamp, for a why-text that\n81\t    tells a mechanic how stale a piece of evidence is. ``\"\"`` when ``ts``\n82\t    does not parse -- never raises, since a why-string must still render.\"\"\"\n83\t    from datetime import datetime\n84\t\n85\t    norm = _norm_ts(ts)\n86\t    if not norm:\n87\t        return \"\"\n88\t    try:\n89\t        dt = datetime.fromisoformat(norm)\n90\t    except ValueError:\n91\t        return norm[:10]\n92\t    return f\"{dt.day} {dt.strftime('%b')}\"\n93\t\n94\t\n95\tdef _after(ts: Optional[str], since: Optional[str]) -> bool:\n96\t    if not ts or not since:\n97\t        return False\n98\t    return _norm_ts(ts) >= _norm_ts(since)\n99\t\n100\t\n101\tdef _href(template: str, vin: str) -> str:\n102\t    return template.format(vin=vin)\n103\t\n104\t\n105\tdef _step_averages(shop_mod: Any) -> dict[int, float]:\n106\t    if shop_mod is None:\n107\t        return {}\n108\t    try:\n109\t        return shop_mod.board().get(\"today\", {}).get(\"step_averages\", {}) or {}\n110\t    except Exception:  # noqa: BLE001 -- a broken board must never break the flow\n111\t        return {}\n112\t\n113\t\n114\tdef _symptoms(vin: str) -> list[dict[str, Any]]:\n115\t    if timeline_bridge is None:\n116\t        return []\n117\t    try:\n118\t        return timeline_bridge.symptoms(vin)[\"symptoms\"]\n119\t    except Exception:  # noqa: BLE001\n120\t        return []\n121\t\n122\t\n123\tdef _any_car_observation_after(vin: str, since: Optional[str]) -> bool:\n124\t    if live_store is None or not since:\n125\t        return False\n126\t    try:\n127\t        obs = live_store.recent_observations(200, vin=vin)\n128\t    except Exception:  # noqa: BLE001\n129\t        return False\n130\t    return any(live_store.is_from_car(o) and _after(o.get(\"at\"), since) for o in obs)\n131\t\n132\t\n133\tdef current_vehicle() -> Optional[str]:\n134\t    \"\"\"The VIN of the car currently in the bay -- the newest visit whose\n135\t    status is not ``\"out\"`` -- or ``None`` when nothing is in, or the shop\n136\t    board itself is not available yet. Lets the home page show *a* flow\n137\t    without the caller having to already know which VIN to ask for.\"\"\"\n138\t    shop_mod = _shop_mod()\n139\t    if shop_mod is None:\n140\t        return None\n141\t    try:\n142\t        visits = shop_mod.load()\n143\t    except Exception:  # noqa: BLE001\n144\t        return None\n145\t    open_visits = [v for v in visits if v.get(\"status\") != \"out\"]\n146\t    if not open_visits:\n147\t        return None\n148\t    return sorted(open_visits, key=lambda v: v.get(\"in_at\") or \"\")[-1].get(\"vin\")\n149\t\n150\t\n151\tdef flow_state(vin: str) -> dict[str, Any]:\n152\t    \"\"\"Everything the flow widget needs for this VIN, computed once.\"\"\"\n153\t    vin = (vin or \"\").strip()\n154\t    if not vin:\n155\t        raise BadRequest(\"a VIN is required\")\n156\t\n157\t    shop_mod = _shop_mod()\n158\t    jobs_mod = _jobs_mod()\n159\t\n160\t    visit = None\n161\t    if shop_mod is not None:\n162\t        try:\n163\t            visit = shop_mod.current(vin)\n164\t            if visit is None:\n165\t                visits_for_vin = shop_mod.load(vin)\n166\t                visit = visits_for_vin[-1] if visits_for_vin else None\n167\t        except Exception:  # noqa: BLE001\n168\t            visit = None\n169\t\n170\t    job = None\n171\t    if jobs_mod is not None:\n172\t        try:\n173\t            job = jobs_mod.current(vin)\n174\t            if job is None:\n175\t                jobs_for_vin = jobs_mod.load(vin)\n176\t                job = jobs_for_vin[-1] if jobs_for_vin else None\n177\t        except Exception:  # noqa: BLE001\n178\t            job = None\n179\t\n180\t    try:\n181\t        # Same cache key ``cuore.web.routes._dossier`` and\n182\t        # ``cuore.services.jobs_bridge._cached_workup`` use (vin, newest\n183\t        # MES-log mtime), so all three share one entry instead of each\n184\t        # re-running ``mes_bridge.workup`` -- seconds of FES re-parsing on a\n185\t        # real corpus.\n186\t        dossier = cache.get_or_build(\n187\t            (\"workup\", vin, mes_bridge.newest_mtime(vin)),\n188\t            lambda: mes_bridge.workup(vin=vin),\n189\t        )\n190\t    except Exception:  # noqa: BLE001\n191\t        dossier = {}\n192\t    try:\n193\t        dossier_view = dossier_bridge.build_view(vin, dossier, None)\n194\t    except Exception:  # noqa: BLE001\n195\t        dossier_view = {\"verdict\": None, \"open_work\": [], \"codes\": [],\n196\t                        \"attempted\": []}\n197\t\n198\t    verdict = dossier_view.get(\"verdict\") or {}\n199\t    step_averages = _step_averages(shop_mod)\n200\t\n201\t    in_at = visit.get(\"in_at\") if visit else None\n202\t    hypotheses = (job or {}).get(\"hypotheses\", [])\n203\t    actions = (job or {}).get(\"actions\", [])\n204\t\n205\t    # --- per-step done/why, independent of ordering -----------------------\n206\t\n207\t    done: dict[int, bool] = {}\n208\t    why: dict[int, str] = {}\n209\t\n210\t    done[1] = visit is not None\n211\t    why[1] = (f\"visit open (status: {visit['status']})\" if visit\n212\t             else \"no visit open for this VIN\")\n213\t\n214\t    symptoms = _symptoms(vin)\n215\t    done[2] = bool(symptoms)\n216\t    why[2] = (f\"{len(symptoms)} symptom report(s) on file\" if symptoms\n217\t             else \"no symptom recorded\")\n218\t\n219\t    cp = dossier.get(\"current_picture\") or {}\n220\t    identity = dossier.get(\"identity\") or {}\n221\t    latest_log_ts = ((cp.get(\"latest_session\") or {}).get(\"timestamp\")\n222\t                     or (cp.get(\"latest_scan\") or {}).get(\"timestamp\"))\n223\t    has_any_log = bool(identity.get(\"log_count\"))\n224\t    log_since_intake = has_any_log and (\n225\t        in_at is None or _after(latest_log_ts, in_at) or latest_log_ts is None)\n226\t    observed_since_intake = _any_car_observation_after(vin, in_at)\n227\t    # Evidence that predates intake still counts -- a VIN with any\n228\t    # session/scan on file has had its codes read, full stop. A read taken\n229\t    # since intake just upgrades the why-text to say so; it is never what\n230\t    # makes this step done versus not.\n231\t    done[4] = bool(has_any_log or observed_since_intake)\n232\t    if log_since_intake or observed_since_intake:\n233\t        why[4] = \"codes read since intake\"\n234\t    elif has_any_log:\n235\t        why[4] = (f\"codes from MES logs, newest {_short_date(latest_log_ts)}; \"\n236\t                 \"read the car again to refresh\")\n237\t    else:\n238\t        why[4] = \"no observation or MES log on file for this VIN\"\n239\t\n240\t    # step 3 (verdict) counts done whenever dossier_bridge actually produced\n241\t    # a verdict -- NO_DATA means none; anything else means one was computed,\n242\t    # even from evidence that predates intake. Never show \"verdict not\n243\t    # computed\" once a real verdict exists; its own summary sentence is the\n244\t    # why-text, so post-intake reads upgrade it automatically.\n245\t    verdict_state = verdict.get(\"state\")\n246\t    done[3] = bool(verdict_state) and verdict_state != \"NO_DATA\"\n247\t    why[3] = ((verdict.get(\"summary\") or \"verdict computed from codes on file\")\n248\t             if done[3] else \"no codes read yet; verdict not computed\")\n249\t\n250\t    done[5] = bool(hypotheses)\n251\t    why[5] = (f\"{len(hypotheses)} hypothesis(es) on file\" if hypotheses\n252\t             else \"no hypothesis recorded yet\")\n253\t\n254\t    attempted = dossier_view.get(\"attempted\") or []\n255\t    done[6] = bool(attempted) or observed_since_intake\n256\t    why[6] = (\"inspection, actuator run, or live observation on file\" if done[6]\n257\t             else \"no inspection, actuator run, or live observation since intake\")\n258\t\n259\t    confirmed = [h for h in hypotheses if h.get(\"status\") == \"confirmed\"]\n260\t    done[7] = bool(confirmed)\n261\t    why[7] = (\"a hypothesis confirmed\" if confirmed\n262\t             else \"no hypothesis confirmed yet\")\n263\t\n264\t    part_actions = [a for a in actions if a.get(\"kind\") == \"part\"]\n265\t    done[8] = bool(part_actions)\n266\t    why[8] = (\"parts/tools recorded on the job\" if part_actions\n267\t             else \"no parts or tools recorded on the job\")\n268\t\n269\t    repair_actions = [a for a in actions if a.get(\"kind\") == \"repair\"]\n270\t    done[9] = bool(repair_actions)\n271\t    why[9] = (\"a repair action recorded\" if repair_actions\n272\t             else \"no repair action recorded\")\n273\t\n274\t    done[10] = verdict.get(\"state\") == \"VERIFIED_CLEAN\"\n275\t    if done[10]:\n276\t        why[10] = \"verdict VERIFIED_CLEAN: readiness proves the repair\"\n277\t    elif verdict.get(\"state\") == \"UNVERIFIED_REPAIR\":\n278\t        why[10] = \"verdict UNVERIFIED_REPAIR: no readiness read since the clear\"\n279\t    else:\n280\t        why[10] = \"no readiness read proving the repair yet\"\n281\t\n282\t    release = (visit or {}).get(\"release\") or {}\n283\t    done[11] = bool(release.get(\"report_printed\") and release.get(\"labels_printed\"))\n284\t    why[11] = (\"report and labels printed\" if done[11]\n285\t              else \"report/labels not yet printed\")\n286\t\n287\t    done[12] = bool(visit) and visit.get(\"status\") == \"out\"\n288\t    why[12] = (\"visit released\" if done[12] else \"visit not yet released\")\n289\t\n290\t    # --- fold into ordered steps, pick current/blocked ---------------------\n291\t\n292\t    blocked_on_parts = bool(visit) and visit.get(\"status\") == \"waiting_parts\"\n293\t    first_not_done = next((n for n, *_ in _STEPS if not done[n]), 12)\n294\t\n295\t    steps: list[dict[str, Any]] = []\n296\t    for n, key, title, button_label in _STEPS:\n297\t        href_template = {\n298\t            1: \"/start\",\n299\t            2: \"/v/{vin}/job#step-2\",\n300\t            3: \"/v/{vin}\",\n301\t            4: \"/v/{vin}/codes\",\n302\t            5: \"/v/{vin}/job#step-5\",\n303\t            6: \"/v/{vin}/job#step-6\",\n304\t            7: \"/v/{vin}/job#step-7\",\n305\t            8: \"/v/{vin}/job#step-8\",\n306\t            9: \"/v/{vin}/job#step-9\",\n307\t            10: \"/v/{vin}/job#step-10\",\n308\t            11: \"/v/{vin}/job#step-11\",\n309\t            12: \"/v/{vin}/release\",\n310\t        }[n]\n311\t        href = _href(href_template, vin)\n312\t\n313\t        if n == first_not_done:\n314\t            status = \"blocked\" if blocked_on_parts else \"current\"\n315\t        elif done[n]:\n316\t            status = \"done\"\n317\t        else:\n318\t            status = \"todo\"\n319\t\n320\t        job_step = _FLOW_TO_JOB_STEP.get(n)\n321\t        est_min = step_averages.get(job_step) if job_step else None\n322\t\n323\t        steps.append({\n324\t            \"n\": n, \"key\": key, \"title\": title, \"href\": href,\n325\t            \"status\": status, \"why\": why[n], \"est_min\": est_min,\n326\t        })\n327\t\n328\t    current_n = first_not_done\n329\t    current_step = next(s for s in steps if s[\"n\"] == current_n)\n330\t    next_obj = {\"n\": current_step[\"n\"], \"title\": current_step[\"title\"],\n331\t               \"href\": current_step[\"href\"],\n332\t               \"button_label\": [b for a, _, _, b in _STEPS if a == current_n][0]}\n333\t\n334\t    blockers = [s[\"why\"] for s in steps if s[\"status\"] == \"blocked\"]\n335\t    if blocked_on_parts and why[first_not_done] not in blockers:\n336\t        blockers.append(\"waiting on parts\")\n337\t\n338\t    return {\n339\t        \"steps\": steps,\n340\t        \"current\": current_n,\n341\t        \"next\": next_obj,\n342\t        \"visit\": ({\"status\": visit[\"status\"],\n343\t                  \"minutes_in\": (None if not in_at else\n344\t                                round((_minutes_now(in_at)), 1)),\n345\t                  \"promised_at\": visit.get(\"promised_at\")}\n346\t                 if visit else None),\n347\t        \"job\": ({\"id\": job[\"id\"], \"status\": job[\"status\"]} if job else None),\n348\t        \"blockers\": blockers,\n349\t    }\n350\t\n351\t\n352\tdef _minutes_now(in_at: str) -> float:\n353\t    from datetime import datetime\n354\t    try:\n355\t        t0 = datetime.fromisoformat(in_at)\n356\t    except ValueError:\n357\t        return 0.0\n358\t    return (datetime.now() - t0).total_seconds() / 60.0\n359\t\n360\t\n361\t__all__ = [\"flow_state\", \"current_vehicle\"]\n362\t"}]},"uuid":"9bac5d00-f588-4f64-8d88-bb572d05351d","timestamp":"2026-10-08T15:03:10.895Z","toolUseResult":{"type":"text","file":{"filePath":"C:\\Users\\User\\mcp-servers\\cuore\\services\\flow_bridge.py","content":"\"\"\"The mechanic flow: one fixed 12-step order laid over whatever real\nrecords exist for a VIN, so a technician (or the home page, for the car\npresently in the bay) can see \"what's next\" without hunting across pages.\n\nNothing here is a new source of truth -- it only reads :mod:`mes.shop` and\n:mod:`mes.jobs` (both still landing, so imported lazily and degraded to\n``None`` if either is missing or broken) plus the bridges that already\nanswer the dossier/job/symptom/media/feedback questions, and folds them into\none ordered step list. Done/current/todo/blocked is derived from real\nrecords only -- never inferred from UI state.\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom typing import Any, Callable, Optional\n\nfrom .. import bootstrap  # noqa: F401  -- side effect: puts `mes` on sys.path\nfrom . import cache, dossier_bridge, mes_bridge\nfrom .errors import BadRequest\n\ntry:\n    from . import timeline_bridge\nexcept Exception:  # noqa: BLE001 -- the flow must still render without it\n    timeline_bridge = None\n\ntry:\n    from ..live import store as live_store\nexcept Exception:  # noqa: BLE001\n    live_store = None\n\n\ndef _shop_mod() -> Any:\n    \"\"\"``mes.shop`` is still landing -- import lazily, degrade to ``None``.\"\"\"\n    try:\n        from mes import shop as shop_mod\n        return shop_mod\n    except Exception:  # noqa: BLE001\n        return None\n\n\ndef _jobs_mod() -> Any:\n    \"\"\"``mes.jobs`` likewise.\"\"\"\n    try:\n        from mes import jobs as jobs_mod\n        return jobs_mod\n    except Exception:  # noqa: BLE001\n        return None\n\n\n#: n, key, title, button_label -- href is built per-VIN in _href().\n_STEPS: list[tuple[int, str, str, str]] = [\n    (1, \"intake\", \"Intake\", \"Start intake\"),\n    (2, \"symptoms\", \"Complaint & symptoms\", \"Record symptoms\"),\n    (3, \"verdict\", \"Verdict\", \"Open verdict\"),\n    (4, \"scan\", \"Scan & codes\", \"Scan the car\"),\n    (5, \"understand\", \"Understand the fault\", \"Review the code\"),\n    (6, \"tests\", \"Tests & inspections\", \"Run tests\"),\n    (7, \"hypotheses\", \"Hypotheses\", \"Confirm hypothesis\"),\n    (8, \"plan\", \"Plan the repair\", \"Plan the repair\"),\n    (9, \"repair\", \"Repair\", \"Log repair\"),\n    (10, \"verify\", \"Verify\", \"Read readiness\"),\n    (11, \"document\", \"Document\", \"Print report\"),\n    (12, \"release\", \"Release\", \"Release the car\"),\n]\n\n#: Flow step n -> the shop's own job-stepper step number (1-7), used to pull\n#: a learned average minutes out of ``mes.shop.board()``. Steps with no\n#: direct counterpart (intake, verdict, understand, plan, release) get no\n#: estimate rather than a misleading one.\n_FLOW_TO_JOB_STEP = {2: 1, 4: 2, 6: 3, 7: 4, 9: 5, 10: 6, 11: 7}\n\n\ndef _norm_ts(ts: Optional[str]) -> str:\n    \"\"\"Normalize an ISO-ish timestamp (\"...T...\" or \"... ...\") to a\n    space-separated, lexicographically-comparable form.\"\"\"\n    return (ts or \"\").replace(\"T\", \" \")[:19]\n\n\ndef _short_date(ts: Optional[str]) -> str:\n    \"\"\"\"4 Oct\"-style date out of an ISO-ish timestamp, for a why-text that\n    tells a mechanic how stale a piece of evidence is. ``\"\"`` when ``ts``\n    does not parse -- never raises, since a why-string must still render.\"\"\"\n    from datetime import datetime\n\n    norm = _norm_ts(ts)\n    if not norm:\n        return \"\"\n    try:\n        dt = datetime.fromisoformat(norm)\n    except ValueError:\n        return norm[:10]\n    return f\"{dt.day} {dt.strftime('%b')}\"\n\n\ndef _after(ts: Optional[str], since: Optional[str]) -> bool:\n    if not ts or not since:\n        return False\n    return _norm_ts(ts) >= _norm_ts(since)\n\n\ndef _href(template: str, vin: str) -> str:\n    return template.format(vin=vin)\n\n\ndef _step_averages(shop_mod: Any) -> dict[int, float]:\n    if shop_mod is None:\n        return {}\n    try:\n        return shop_mod.board().get(\"today\", {}).get(\"step_averages\", {}) or {}\n    except Exception:  # noqa: BLE001 -- a broken board must never break the flow\n        return {}\n\n\ndef _symptoms(vin: str) -> list[dict[str, Any]]:\n    if timeline_bridge is None:\n        return []\n    try:\n        return timeline_bridge.symptoms(vin)[\"symptoms\"]\n    except Exception:  # noqa: BLE001\n        return []\n\n\ndef _any_car_observation_after(vin: str, since: Optional[str]) -> bool:\n    if live_store is None or not since:\n        return False\n    try:\n        obs = live_store.recent_observations(200, vin=vin)\n    except Exception:  # noqa: BLE001\n        return False\n    return any(live_store.is_from_car(o) and _after(o.get(\"at\"), since) for o in obs)\n\n\ndef current_vehicle() -> Optional[str]:\n    \"\"\"The VIN of the car currently in the bay -- the newest visit whose\n    status is not ``\"out\"`` -- or ``None`` when nothing is in, or the shop\n    board itself is not available yet. Lets the home page show *a* flow\n    without the caller having to already know which VIN to ask for.\"\"\"\n    shop_mod = _shop_mod()\n    if shop_mod is None:\n        return None\n    try:\n        visits = shop_mod.load()\n    except Exception:  # noqa: BLE001\n        return None\n    open_visits = [v for v in visits if v.get(\"status\") != \"out\"]\n    if not open_visits:\n        return None\n    return sorted(open_visits, key=lambda v: v.get(\"in_at\") or \"\")[-1].get(\"vin\")\n\n\ndef flow_state(vin: str) -> dict[str, Any]:\n    \"\"\"Everything the flow widget needs for this VIN, computed once.\"\"\"\n    vin = (vin or \"\").strip()\n    if not vin:\n        raise BadRequest(\"a VIN is required\")\n\n    shop_mod = _shop_mod()\n    jobs_mod = _jobs_mod()\n\n    visit = None\n    if shop_mod is not None:\n        try:\n            visit = shop_mod.current(vin)\n            if visit is None:\n                visits_for_vin = shop_mod.load(vin)\n                visit = visits_for_vin[-1] if visits_for_vin else None\n        except Exception:  # noqa: BLE001\n            visit = None\n\n    job = None\n    if jobs_mod is not None:\n        try:\n            job = jobs_mod.current(vin)\n            if job is None:\n                jobs_for_vin = jobs_mod.load(vin)\n                job = jobs_for_vin[-1] if jobs_for_vin else None\n        except Exception:  # noqa: BLE001\n            job = None\n\n    try:\n        # Same cache key ``cuore.web.routes._dossier`` and\n        # ``cuore.services.jobs_bridge._cached_workup`` use (vin, newest\n        # MES-log mtime), so all three share one entry instead of each\n        # re-running ``mes_bridge.workup`` -- seconds of FES re-parsing on a\n        # real corpus.\n        dossier = cache.get_or_build(\n            (\"workup\", vin, mes_bridge.newest_mtime(vin)),\n            lambda: mes_bridge.workup(vin=vin),\n        )\n    except Exception:  # noqa: BLE001\n        dossier = {}\n    try:\n        dossier_view = dossier_bridge.build_view(vin, dossier, None)\n    except Exception:  # noqa: BLE001\n        dossier_view = {\"verdict\": None, \"open_work\": [], \"codes\": [],\n                        \"attempted\": []}\n\n    verdict = dossier_view.get(\"verdict\") or {}\n    step_averages = _step_averages(shop_mod)\n\n    in_at = visit.get(\"in_at\") if visit else None\n    hypotheses = (job or {}).get(\"hypotheses\", [])\n    actions = (job or {}).get(\"actions\", [])\n\n    # --- per-step done/why, independent of ordering -----------------------\n\n    done: dict[int, bool] = {}\n    why: dict[int, str] = {}\n\n    done[1] = visit is not None\n    why[1] = (f\"visit open (status: {visit['status']})\" if visit\n             else \"no visit open for this VIN\")\n\n    symptoms = _symptoms(vin)\n    done[2] = bool(symptoms)\n    why[2] = (f\"{len(symptoms)} symptom report(s) on file\" if symptoms\n             else \"no symptom recorded\")\n\n    cp = dossier.get(\"current_picture\") or {}\n    identity = dossier.get(\"identity\") or {}\n    latest_log_ts = ((cp.get(\"latest_session\") or {}).get(\"timestamp\")\n                     or (cp.get(\"latest_scan\") or {}).get(\"timestamp\"))\n    has_any_log = bool(identity.get(\"log_count\"))\n    log_since_intake = has_any_log and (\n        in_at is None or _after(latest_log_ts, in_at) or latest_log_ts is None)\n    observed_since_intake = _any_car_observation_after(vin, in_at)\n    # Evidence that predates intake still counts -- a VIN with any\n    # session/scan on file has had its codes read, full stop. A read taken\n    # since intake just upgrades the why-text to say so; it is never what\n    # makes this step done versus not.\n    done[4] = bool(has_any_log or observed_since_intake)\n    if log_since_intake or observed_since_intake:\n        why[4] = \"codes read since intake\"\n    elif has_any_log:\n        why[4] = (f\"codes from MES logs, newest {_short_date(latest_log_ts)}; \"\n                 \"read the car again to refresh\")\n    else:\n        why[4] = \"no observation or MES log on file for this VIN\"\n\n    # step 3 (verdict) counts done whenever dossier_bridge actually produced\n    # a verdict -- NO_DATA means none; anything else means one was computed,\n    # even from evidence that predates intake. Never show \"verdict not\n    # computed\" once a real verdict exists; its own summary sentence is the\n    # why-text, so post-intake reads upgrade it automatically.\n    verdict_state = verdict.get(\"state\")\n    done[3] = bool(verdict_state) and verdict_state != \"NO_DATA\"\n    why[3] = ((verdict.get(\"summary\") or \"verdict computed from codes on file\")\n             if done[3] else \"no codes read yet; verdict not computed\")\n\n    done[5] = bool(hypotheses)\n    why[5] = (f\"{len(hypotheses)} hypothesis(es) on file\" if hypotheses\n             else \"no hypothesis recorded yet\")\n\n    attempted = dossier_view.get(\"attempted\") or []\n    done[6] = bool(attempted) or observed_since_intake\n    why[6] = (\"inspection, actuator run, or live observation on file\" if done[6]\n             else \"no inspection, actuator run, or live observation since intake\")\n\n    confirmed = [h for h in hypotheses if h.get(\"status\") == \"confirmed\"]\n    done[7] = bool(confirmed)\n    why[7] = (\"a hypothesis confirmed\" if confirmed\n             else \"no hypothesis confirmed yet\")\n\n    part_actions = [a for a in actions if a.get(\"kind\") == \"part\"]\n    done[8] = bool(part_actions)\n    why[8] = (\"parts/tools recorded on the job\" if part_actions\n             else \"no parts or tools recorded on the job\")\n\n    repair_actions = [a for a in actions if a.get(\"kind\") == \"repair\"]\n    done[9] = bool(repair_actions)\n    why[9] = (\"a repair action recorded\" if repair_actions\n             else \"no repair action recorded\")\n\n    done[10] = verdict.get(\"state\") == \"VERIFIED_CLEAN\"\n    if done[10]:\n        why[10] = \"verdict VERIFIED_CLEAN: readiness proves the repair\"\n    elif verdict.get(\"state\") == \"UNVERIFIED_REPAIR\":\n        why[10] = \"verdict UNVERIFIED_REPAIR: no readiness read since the clear\"\n    else:\n        why[10] = \"no readiness read proving the repair yet\"\n\n    release = (visit or {}).get(\"release\") or {}\n    done[11] = bool(release.get(\"report_printed\") and release.get(\"labels_printed\"))\n    why[11] = (\"report and labels printed\" if done[11]\n              else \"report/labels not yet printed\")\n\n    done[12] = bool(visit) and visit.get(\"status\") == \"out\"\n    why[12] = (\"visit released\" if done[12] else \"visit not yet released\")\n\n    # --- fold into ordered steps, pick current/blocked ---------------------\n\n    blocked_on_parts = bool(visit) and visit.get(\"status\") == \"waiting_parts\"\n    first_not_done = next((n for n, *_ in _STEPS if not done[n]), 12)\n\n    steps: list[dict[str, Any]] = []\n    for n, key, title, button_label in _STEPS:\n        href_template = {\n            1: \"/start\",\n            2: \"/v/{vin}/job#step-2\",\n            3: \"/v/{vin}\",\n            4: \"/v/{vin}/codes\",\n            5: \"/v/{vin}/job#step-5\",\n            6: \"/v/{vin}/job#step-6\",\n            7: \"/v/{vin}/job#step-7\",\n            8: \"/v/{vin}/job#step-8\",\n            9: \"/v/{vin}/job#step-9\",\n            10: \"/v/{vin}/job#step-10\",\n            11: \"/v/{vin}/job#step-11\",\n            12: \"/v/{vin}/release\",\n        }[n]\n        href = _href(href_template, vin)\n\n        if n == first_not_done:\n            status = \"blocked\" if blocked_on_parts else \"current\"\n        elif done[n]:\n            status = \"done\"\n        else:\n            status = \"todo\"\n\n        job_step = _FLOW_TO_JOB_STEP.get(n)\n        est_min = step_averages.get(job_step) if job_step else None\n\n        steps.append({\n            \"n\": n, \"key\": key, \"title\": title, \"href\": href,\n            \"status\": status, \"why\": why[n], \"est_min\": est_min,\n        })\n\n    current_n = first_not_done\n    current_step = next(s for s in steps if s[\"n\"] == current_n)\n    next_obj = {\"n\": current_step[\"n\"], \"title\": current_step[\"title\"],\n               \"href\": current_step[\"href\"],\n               \"button_label\": [b for a, _, _, b in _STEPS if a == current_n][0]}\n\n    blockers = [s[\"why\"] for s in steps if s[\"status\"] == \"blocked\"]\n    if blocked_on_parts and why[first_not_done] not in blockers:\n        blockers.append(\"waiting on parts\")\n\n    return {\n        \"steps\": steps,\n        \"current\": current_n,\n        \"next\": next_obj,\n        \"visit\": ({\"status\": visit[\"status\"],\n                  \"minutes_in\": (None if not in_at else\n                                round((_minutes_now(in_at)), 1)),\n                  \"promised_at\": visit.get(\"promised_at\")}\n                 if visit else None),\n        \"job\": ({\"id\": job[\"id\"], \"status\": job[\"status\"]} if job else None),\n        \"blockers\": blockers,\n    }\n\n\ndef _minutes_now(in_at: str) -> float:\n    from datetime import datetime\n    try:\n        t0 = datetime.fromisoformat(in_at)\n    except ValueError:\n        return 0.0\n    return (datetime.now() - t0).total_seconds() / 60.0\n\n\n__all__ = [\"flow_state\", \"current_vehicle\"]\n","numLines":362,"startLine":1,"totalLines":362}},"sourceToolAssistantUUID":"28d3f342-3f5f-4adb-9193-eb0bc9c5aabf","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
