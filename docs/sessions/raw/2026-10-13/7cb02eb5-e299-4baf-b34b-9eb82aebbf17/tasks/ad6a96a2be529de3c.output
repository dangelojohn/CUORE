{"parentUuid":"7a7e7156-45a9-431a-9730-f6d63b4c39e6","isSidechain":true,"agentId":"ad6a96a2be529de3c","message":{"model":"claude-sonnet-5","id":"msg_011CfqBFw414ea5aXVGT5ESV","type":"message","role":"assistant","content":[{"type":"text","text":"Confirmed root cause for labels: `static_url` undefined on labels_routes' Jinja2Templates env. Now let's inspect static_version.py, icons.py, i18n.py registration pattern, and the three failing route modules."}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2323,"cache_read_input_tokens":64792,"cache_creation":{"ephemeral_5m_input_tokens":2323,"ephemeral_1h_input_tokens":0},"output_tokens":6,"service_tier":"standard","inference_geo":"not_available"},"input_transformations":[],"diagnostics":null,"context_management":null},"serverClassifierRequest":"05d5a197-4dd5-446d-9b45-9ca61df67259","apiBlockIndex":0,"requestId":"req_011CfqBFvodHnXBMEbcevAkK","attributionAgent":"general-purpose","type":"assistant","uuid":"a59c7870-d1b2-469b-a75c-1185642d4598","timestamp":"2026-10-08T17:38:29.451Z","effort":"high","perTurnEffort":null,"userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
{"parentUuid":"a59c7870-d1b2-469b-a75c-1185642d4598","isSidechain":true,"agentId":"ad6a96a2be529de3c","message":{"model":"claude-sonnet-5","id":"msg_011CfqBFw414ea5aXVGT5ESV","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_013VBp2prrAKqmAuotSe4UTY","name":"Read","input":{"file_path":"C:\\Users\\User\\mcp-servers\\cuore\\web\\static_version.py"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2323,"cache_read_input_tokens":64792,"cache_creation":{"ephemeral_5m_input_tokens":2323,"ephemeral_1h_input_tokens":0},"output_tokens":6,"service_tier":"standard","inference_geo":"not_available"},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_013VBp2prrAKqmAuotSe4UTY":{"file_path":"C:\\Users\\User\\mcp-servers\\cuore\\web\\static_version.py"}},"serverClassifierRequest":"05d5a197-4dd5-446d-9b45-9ca61df67259","apiBlockIndex":1,"requestId":"req_011CfqBFvodHnXBMEbcevAkK","attributionAgent":"general-purpose","type":"assistant","uuid":"ff90d0ce-6408-480b-b4fc-770ca9401a2a","timestamp":"2026-10-08T17:38:30.150Z","effort":"high","perTurnEffort":null,"userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
{"parentUuid":"ff90d0ce-6408-480b-b4fc-770ca9401a2a","isSidechain":true,"promptId":"14b8b90f-0c4b-47b6-b2bf-3803814525db","agentId":"ad6a96a2be529de3c","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_013VBp2prrAKqmAuotSe4UTY","type":"tool_result","content":"1\t\"\"\"Registers the ``static_url`` Jinja global on every template environment,\n2\tso a browser always loads the current CSS/JS instead of a stale cached copy.\n3\t\n4\t``static_url(path)`` returns ``\"/static/<path>?v=<hash>\"`` where the hash is\n5\tderived from that file's mtime on disk -- the URL changes exactly when the\n6\tfile changes, so a plain browser cache (no explicit no-cache headers) still\n7\trevalidates on a redeploy, and nothing has to bump a version number by hand.\n8\t\n9\tSame trick ``cuore.web.experience_globals`` and ``cuore.web.icons`` use for\n10\t``experience_links`` / ``icon``, applied to a longer module list: those two\n11\tonly register on the two ``Jinja2Templates`` instances their own features'\n12\tpages render through (``routes`` and ``service_routes``, found via\n13\t``drivetrain_routes`` and ``timeline_routes`` re-exporting ``routes``'s).\n14\t``static_url`` has to be safe on *every* page, and two more modules --\n15\t``labels_routes`` and ``media_routes`` -- build their own separate\n16\t``Jinja2Templates`` instance over the same template directory (see\n17\t``cuore.web.media_routes``'s own comment on this: \"each a separate\n18\tenvironment over the same template directory\"). Every page extends\n19\t``base.html``, which calls ``static_url`` for ``cuore.css``/``cuore.js`` etc,\n20\tso *all four* base instances need the global or those pages 500. Importing\n21\tthis module is the side effect that does the registration; nothing here is\n22\tcalled directly. ``cuore.app`` imports it at module load time (see its own\n23\timport list), so including that import is what wires this in.\n24\t\"\"\"\n25\t\n26\tfrom __future__ import annotations\n27\t\n28\timport hashlib\n29\timport importlib\n30\tfrom pathlib import Path\n31\tfrom typing import Any\n32\t\n33\tHERE = Path(__file__).resolve().parent\n34\tSTATIC_DIR = HERE / \"static\"\n35\t\n36\t\n37\tdef static_url(path: str) -> str:\n38\t    \"\"\"``\"cuore.css\"`` -> ``\"/static/cuore.css?v=<hash of its mtime+size>\"``.\n39\t\n40\t    Falls back to a plain, unversioned ``/static/<path>`` if the file can't\n41\t    be stat'd (missing file, odd permissions, ...) -- a template global must\n42\t    never 500 a page just because a cache-buster couldn't be computed.\n43\t    \"\"\"\n44\t    try:\n45\t        st = (STATIC_DIR / path).stat()\n46\t        digest = hashlib.sha1(f\"{st.st_mtime_ns}:{st.st_size}\".encode()).hexdigest()[:10]\n47\t        return f\"/static/{path}?v={digest}\"\n48\t    except OSError:\n49\t        return f\"/static/{path}\"\n50\t\n51\t\n52\tdef _register(templates: Any) -> None:\n53\t    templates.env.globals[\"static_url\"] = static_url\n54\t\n55\t\n56\t# The four distinct ``Jinja2Templates`` instances in this package (``routes``\n57\t# and ``service_routes``, plus ``labels_routes`` and ``media_routes`` which\n58\t# each build their own) -- ``drivetrain_routes``/``timeline_routes`` are\n59\t# listed too, defensively, in case either ever stops re-exporting\n60\t# ``routes``'s; registering the same global twice on one object is harmless.\n61\tfor _module_name in (\n62\t    \"routes\", \"service_routes\", \"drivetrain_routes\", \"timeline_routes\",\n63\t    \"labels_routes\", \"media_routes\",\n64\t):\n65\t    try:\n66\t        _mod = importlib.import_module(f\".{_module_name}\", __package__)\n67\t        _tmpl = getattr(_mod, \"templates\", None) or getattr(_mod, \"_shared_templates\", None)\n68\t        if _tmpl is not None:\n69\t            _register(_tmpl)\n70\t    except Exception:  # noqa: BLE001 -- import-time side effect, must never raise\n71\t        pass\n72\t\n73\t\n74\t__all__ = [\"static_url\", \"STATIC_DIR\"]\n75\t"}]},"uuid":"4bcbb04c-450f-41e2-8ae3-60bf7da5ef29","timestamp":"2026-10-08T17:38:30.166Z","toolUseResult":{"type":"text","file":{"filePath":"C:\\Users\\User\\mcp-servers\\cuore\\web\\static_version.py","content":"\"\"\"Registers the ``static_url`` Jinja global on every template environment,\nso a browser always loads the current CSS/JS instead of a stale cached copy.\n\n``static_url(path)`` returns ``\"/static/<path>?v=<hash>\"`` where the hash is\nderived from that file's mtime on disk -- the URL changes exactly when the\nfile changes, so a plain browser cache (no explicit no-cache headers) still\nrevalidates on a redeploy, and nothing has to bump a version number by hand.\n\nSame trick ``cuore.web.experience_globals`` and ``cuore.web.icons`` use for\n``experience_links`` / ``icon``, applied to a longer module list: those two\nonly register on the two ``Jinja2Templates`` instances their own features'\npages render through (``routes`` and ``service_routes``, found via\n``drivetrain_routes`` and ``timeline_routes`` re-exporting ``routes``'s).\n``static_url`` has to be safe on *every* page, and two more modules --\n``labels_routes`` and ``media_routes`` -- build their own separate\n``Jinja2Templates`` instance over the same template directory (see\n``cuore.web.media_routes``'s own comment on this: \"each a separate\nenvironment over the same template directory\"). Every page extends\n``base.html``, which calls ``static_url`` for ``cuore.css``/``cuore.js`` etc,\nso *all four* base instances need the global or those pages 500. Importing\nthis module is the side effect that does the registration; nothing here is\ncalled directly. ``cuore.app`` imports it at module load time (see its own\nimport list), so including that import is what wires this in.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport hashlib\nimport importlib\nfrom pathlib import Path\nfrom typing import Any\n\nHERE = Path(__file__).resolve().parent\nSTATIC_DIR = HERE / \"static\"\n\n\ndef static_url(path: str) -> str:\n    \"\"\"``\"cuore.css\"`` -> ``\"/static/cuore.css?v=<hash of its mtime+size>\"``.\n\n    Falls back to a plain, unversioned ``/static/<path>`` if the file can't\n    be stat'd (missing file, odd permissions, ...) -- a template global must\n    never 500 a page just because a cache-buster couldn't be computed.\n    \"\"\"\n    try:\n        st = (STATIC_DIR / path).stat()\n        digest = hashlib.sha1(f\"{st.st_mtime_ns}:{st.st_size}\".encode()).hexdigest()[:10]\n        return f\"/static/{path}?v={digest}\"\n    except OSError:\n        return f\"/static/{path}\"\n\n\ndef _register(templates: Any) -> None:\n    templates.env.globals[\"static_url\"] = static_url\n\n\n# The four distinct ``Jinja2Templates`` instances in this package (``routes``\n# and ``service_routes``, plus ``labels_routes`` and ``media_routes`` which\n# each build their own) -- ``drivetrain_routes``/``timeline_routes`` are\n# listed too, defensively, in case either ever stops re-exporting\n# ``routes``'s; registering the same global twice on one object is harmless.\nfor _module_name in (\n    \"routes\", \"service_routes\", \"drivetrain_routes\", \"timeline_routes\",\n    \"labels_routes\", \"media_routes\",\n):\n    try:\n        _mod = importlib.import_module(f\".{_module_name}\", __package__)\n        _tmpl = getattr(_mod, \"templates\", None) or getattr(_mod, \"_shared_templates\", None)\n        if _tmpl is not None:\n            _register(_tmpl)\n    except Exception:  # noqa: BLE001 -- import-time side effect, must never raise\n        pass\n\n\n__all__ = [\"static_url\", \"STATIC_DIR\"]\n","numLines":75,"startLine":1,"totalLines":75}},"sourceToolAssistantUUID":"ff90d0ce-6408-480b-b4fc-770ca9401a2a","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
{"parentUuid":"4bcbb04c-450f-41e2-8ae3-60bf7da5ef29","isSidechain":true,"agentId":"ad6a96a2be529de3c","message":{"model":"claude-sonnet-5","id":"msg_011CfqBFw414ea5aXVGT5ESV","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01YXwP1AoeyjY52HNU4wzMZE","name":"Read","input":{"file_path":"C:\\Users\\User\\mcp-servers\\cuore\\web\\icons.py"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2323,"cache_read_input_tokens":64792,"cache_creation":{"ephemeral_5m_input_tokens":2323,"ephemeral_1h_input_tokens":0},"output_tokens":6,"service_tier":"standard","inference_geo":"not_available"},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_01YXwP1AoeyjY52HNU4wzMZE":{"file_path":"C:\\Users\\User\\mcp-servers\\cuore\\web\\icons.py"}},"serverClassifierRequest":"05d5a197-4dd5-446d-9b45-9ca61df67259","apiBlockIndex":2,"requestId":"req_011CfqBFvodHnXBMEbcevAkK","attributionAgent":"general-purpose","type":"assistant","uuid":"b8d9d19e-c9f1-4e3a-95fa-fda4447d697d","timestamp":"2026-10-08T17:38:30.683Z","effort":"high","perTurnEffort":null,"userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
{"parentUuid":"b8d9d19e-c9f1-4e3a-95fa-fda4447d697d","isSidechain":true,"promptId":"14b8b90f-0c4b-47b6-b2bf-3803814525db","agentId":"ad6a96a2be529de3c","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01YXwP1AoeyjY52HNU4wzMZE","type":"tool_result","content":"1\t\"\"\"Pictogram registry + the ``icon`` Jinja global.\n2\t\n3\tCUORE's mechanics mostly don't read English (or the UI's current language)\n4\tas a first language, so the plan across the whole web app leans on small\n5\tline pictograms with a short label rather than paragraphs: see\n6\t``cuore/web/static/icons.svg`` for the sprite and ``icons.css`` for sizing.\n7\tThis module is the registry that ties a short key (``\"sys_fuel\"``,\n8\t``\"priority_p1\"``, ...) to a symbol in that sprite and to the bilingual\n9\tlabel shown next to (or instead of) it.\n10\t\n11\tThe symbol id in icons.svg is always ``\"i-\" + key`` -- the registry key\n12\tIS the symbol suffix, so there is no separate mapping to keep in sync; see\n13\t``cuore/tests/check_icons_i18n.py`` for the check that the two files agree.\n14\t\n15\t``icon(key, size=\"m\", label=None)`` returns ready-to-use markup::\n16\t\n17\t    <span class=\"ico ico-28\"><svg role=\"img\" aria-label=\"Fuel\">\n18\t      <use href=\"/static/icons.svg#i-sys_fuel\"></use></svg></span>\n19\t\n20\tRegistered as the Jinja global ``icon`` on every template environment that\n21\talready carries ``experience_links`` / ``flow_state_for`` -- same trick,\n22\tsame four route modules, same defensive \"must never 500 a page\" posture;\n23\tsee ``cuore/web/experience_globals.py``'s own docstring for why there are\n24\texactly four. Importing this module is the side effect that does the\n25\tregistration; nothing here is called directly. Wiring it in (so the global\n26\tactually exists at render time) is the same one-line\n27\t``from ..web import icons  # noqa: F401`` move used for the other\n28\t``*_globals`` modules -- left for the integration pass, not done here.\n29\t\"\"\"\n30\t\n31\tfrom __future__ import annotations\n32\t\n33\timport importlib\n34\tfrom html import escape\n35\tfrom typing import Any, Optional\n36\t\n37\ttry:  # pragma: no cover -- exercised indirectly; keep import optional\n38\t    from markupsafe import Markup\n39\texcept Exception:  # noqa: BLE001 -- markupsafe ships with Jinja2, but don't 500 without it\n40\t    def Markup(s: str) -> str:  # type: ignore[no-redef]\n41\t        return s\n42\t\n43\tfrom .static_version import static_url\n44\t\n45\t\n46\t#: key -> {\"symbol\": <icons.svg symbol suffix, == key>, \"label_en\": ..., \"label_it\": ...}\n47\t#: Grouped the same way icons.svg is grouped: flow steps, systems (keys taken\n48\t#: straight from mes-log-mcp/mes/systems.py's SYSTEMS dict), symptoms (keys\n49\t#: from mes-log-mcp/mes/symptoms.py's SYMPTOM_TAGS), statuses, priorities,\n50\t#: then the handful of misc glyphs (tools/parts/camera/...).\n51\tICONS: dict[str, dict[str, str]] = {\n52\t    # -- 12 flow steps --------------------------------------------------\n53\t    \"step_start\":       {\"symbol\": \"step_start\",       \"label_en\": \"Start\",            \"label_it\": \"Avvio\"},\n54\t    \"step_complaint\":   {\"symbol\": \"step_complaint\",   \"label_en\": \"Complaint\",        \"label_it\": \"Disturbo riferito\"},\n55\t    \"step_verdict\":     {\"symbol\": \"step_verdict\",     \"label_en\": \"Verdict\",          \"label_it\": \"Verdetto\"},\n56\t    \"step_scan\":        {\"symbol\": \"step_scan\",        \"label_en\": \"Scan\",             \"label_it\": \"Scansione\"},\n57\t    \"step_understand\":  {\"symbol\": \"step_understand\",  \"label_en\": \"Understand\",       \"label_it\": \"Comprendere\"},\n58\t    \"step_test\":        {\"symbol\": \"step_test\",        \"label_en\": \"Test\",             \"label_it\": \"Prova\"},\n59\t    \"step_hypothesis\":  {\"symbol\": \"step_hypothesis\",  \"label_en\": \"Hypothesis\",       \"label_it\": \"Ipotesi\"},\n60\t    \"step_plan\":        {\"symbol\": \"step_plan\",        \"label_en\": \"Plan\",             \"label_it\": \"Piano\"},\n61\t    \"step_repair\":      {\"symbol\": \"step_repair\",      \"label_en\": \"Repair\",           \"label_it\": \"Riparazione\"},\n62\t    \"step_verify\":      {\"symbol\": \"step_verify\",      \"label_en\": \"Verify\",           \"label_it\": \"Verifica\"},\n63\t    \"step_document\":    {\"symbol\": \"step_document\",    \"label_en\": \"Document\",         \"label_it\": \"Documentare\"},\n64\t    \"step_release\":     {\"symbol\": \"step_release\",     \"label_en\": \"Release\",          \"label_it\": \"Rilascio\"},\n65\t\n66\t    # -- 25 systems -------------------------------------------------------\n67\t    \"sys_electrical_supply\":      {\"symbol\": \"sys_electrical_supply\",      \"label_en\": \"Electrical supply\",      \"label_it\": \"Impianto elettrico\"},\n68\t    \"sys_network\":                {\"symbol\": \"sys_network\",                \"label_en\": \"Network / CAN\",          \"label_it\": \"Rete / CAN\"},\n69\t    \"sys_ignition\":                {\"symbol\": \"sys_ignition\",               \"label_en\": \"Ignition\",               \"label_it\": \"Accensione\"},\n70\t    \"sys_fuel\":                    {\"symbol\": \"sys_fuel\",                   \"label_en\": \"Fuel\",                   \"label_it\": \"Alimentazione\"},\n71\t    \"sys_evap\":                    {\"symbol\": \"sys_evap\",                   \"label_en\": \"EVAP\",                   \"label_it\": \"Valvola di spurgo (EVAP)\"},\n72\t    \"sys_air_intake_boost\":        {\"symbol\": \"sys_air_intake_boost\",       \"label_en\": \"Air intake / boost\",     \"label_it\": \"Aspirazione / sovralimentazione\"},\n73\t    \"sys_cooling\":                 {\"symbol\": \"sys_cooling\",                \"label_en\": \"Cooling\",                \"label_it\": \"Raffreddamento\"},\n74\t    \"sys_lubrication\":             {\"symbol\": \"sys_lubrication\",            \"label_en\": \"Lubrication\",             \"label_it\": \"Lubrificazione\"},\n75\t    \"sys_exhaust_emissions\":       {\"symbol\": \"sys_exhaust_emissions\",      \"label_en\": \"Exhaust / emissions\",    \"label_it\": \"Scarico / emissioni\"},\n76\t    \"sys_transmission_driveline\":  {\"symbol\": \"sys_transmission_driveline\", \"label_en\": \"Transmission / driveline\", \"label_it\": \"Trasmissione\"},\n77\t    \"sys_brakes_abs\":              {\"symbol\": \"sys_brakes_abs\",             \"label_en\": \"Brakes / ABS\",            \"label_it\": \"Freni / ABS\"},\n78\t    \"sys_steering\":                {\"symbol\": \"sys_steering\",               \"label_en\": \"Steering\",               \"label_it\": \"Sterzo\"},\n79\t    \"sys_suspension\":              {\"symbol\": \"sys_suspension\",             \"label_en\": \"Suspension\",             \"label_it\": \"Sospensioni\"},\n80\t    \"sys_body_comfort\":            {\"symbol\": \"sys_body_comfort\",           \"label_en\": \"Body / comfort\",         \"label_it\": \"Carrozzeria / comfort\"},\n81\t    \"sys_adas_sensors\":            {\"symbol\": \"sys_adas_sensors\",           \"label_en\": \"ADAS sensors\",           \"label_it\": \"Sensori ADAS\"},\n82\t    \"sys_hvac\":                    {\"symbol\": \"sys_hvac\",                   \"label_en\": \"HVAC\",                   \"label_it\": \"Climatizzazione\"},\n83\t    \"sys_pcv\":                     {\"symbol\": \"sys_pcv\",                    \"label_en\": \"PCV / breather\",         \"label_it\": \"Sfiato (PCV)\"},\n84\t    \"sys_engine_management\":       {\"symbol\": \"sys_engine_management\",      \"label_en\": \"Engine management\",      \"label_it\": \"Centralina motore\"},\n85\t    \"sys_valve_control\":           {\"symbol\": \"sys_valve_control\",          \"label_en\": \"Valve control\",          \"label_it\": \"Distribuzione\"},\n86\t    \"sys_starting_charging\":       {\"symbol\": \"sys_starting_charging\",      \"label_en\": \"Starting / charging\",    \"label_it\": \"Avviamento / ricarica\"},\n87\t    \"sys_security_immobiliser\":    {\"symbol\": \"sys_security_immobiliser\",   \"label_en\": \"Security / immobiliser\", \"label_it\": \"Antifurto / immobilizzatore\"},\n88\t    \"sys_infotainment_cluster\":    {\"symbol\": \"sys_infotainment_cluster\",   \"label_en\": \"Infotainment / cluster\", \"label_it\": \"Infotainment / quadro\"},\n89\t    \"sys_lighting\":                {\"symbol\": \"sys_lighting\",               \"label_en\": \"Lighting\",               \"label_it\": \"Illuminazione\"},\n90\t    \"sys_wheels_tpms\":             {\"symbol\": \"sys_wheels_tpms\",            \"label_en\": \"Wheels / TPMS\",          \"label_it\": \"Ruote / TPMS\"},\n91\t    \"sys_restraints\":              {\"symbol\": \"sys_restraints\",             \"label_en\": \"Restraints\",             \"label_it\": \"Sistemi di ritenuta\"},\n92\t\n93\t    # -- 12 symptoms --------------------------------------------------\n94\t    \"symptom_drives_normally\": {\"symbol\": \"symptom_drives_normally\", \"label_en\": \"Drives normally\",  \"label_it\": \"Guida normalmente\"},\n95\t    \"symptom_mil_on\":          {\"symbol\": \"symptom_mil_on\",          \"label_en\": \"Warning lamp on\",   \"label_it\": \"Spia accesa\"},\n96\t    \"symptom_fuel_smell\":      {\"symbol\": \"symptom_fuel_smell\",      \"label_en\": \"Fuel smell\",        \"label_it\": \"Odore di carburante\"},\n97\t    \"symptom_hard_start\":      {\"symbol\": \"symptom_hard_start\",      \"label_en\": \"Hard to start\",      \"label_it\": \"Difficoltà di avviamento\"},\n98\t    \"symptom_rough_idle\":      {\"symbol\": \"symptom_rough_idle\",      \"label_en\": \"Rough idle\",         \"label_it\": \"Minimo irregolare\"},\n99\t    \"symptom_hesitation\":      {\"symbol\": \"symptom_hesitation\",      \"label_en\": \"Hesitation\",         \"label_it\": \"Esitazione\"},\n100\t    \"symptom_loss_of_power\":   {\"symbol\": \"symptom_loss_of_power\",   \"label_en\": \"Loss of power\",      \"label_it\": \"Perdita di potenza\"},\n101\t    \"symptom_hard_to_refuel\":  {\"symbol\": \"symptom_hard_to_refuel\",  \"label_en\": \"Hard to refuel\",     \"label_it\": \"Difficoltà di rifornimento\"},\n102\t    \"symptom_noise\":           {\"symbol\": \"symptom_noise\",           \"label_en\": \"Noise\",              \"label_it\": \"Rumore\"},\n103\t    \"symptom_vibration\":       {\"symbol\": \"symptom_vibration\",       \"label_en\": \"Vibration\",          \"label_it\": \"Vibrazione\"},\n104\t    \"symptom_warning_message\": {\"symbol\": \"symptom_warning_message\", \"label_en\": \"Warning message\",    \"label_it\": \"Messaggio di avviso\"},\n105\t    \"symptom_other\":           {\"symbol\": \"symptom_other\",           \"label_en\": \"Other\",              \"label_it\": \"Altro\"},\n106\t\n107\t    # -- 5 statuses ------------------------------------------------------\n108\t    \"status_active\":              {\"symbol\": \"status_active\",              \"label_en\": \"Active\",               \"label_it\": \"Attivo\"},\n109\t    \"status_cleared_unverified\":  {\"symbol\": \"status_cleared_unverified\",  \"label_en\": \"Cleared, unverified\",  \"label_it\": \"Azzerato, non verificato\"},\n110\t    \"status_verified\":            {\"symbol\": \"status_verified\",            \"label_en\": \"Verified\",             \"label_it\": \"Verificato\"},\n111\t    \"status_stale\":                {\"symbol\": \"status_stale\",               \"label_en\": \"Stale\",                \"label_it\": \"Obsoleto\"},\n112\t    \"status_unknown\":              {\"symbol\": \"status_unknown\",             \"label_en\": \"Unknown\",              \"label_it\": \"Sconosciuto\"},\n113\t\n114\t    # -- 3 priorities ------------------------------------------------------\n115\t    \"priority_p1\": {\"symbol\": \"priority_p1\", \"label_en\": \"Priority 1\", \"label_it\": \"Priorità 1\"},\n116\t    \"priority_p2\": {\"symbol\": \"priority_p2\", \"label_en\": \"Priority 2\", \"label_it\": \"Priorità 2\"},\n117\t    \"priority_p3\": {\"symbol\": \"priority_p3\", \"label_en\": \"Priority 3\", \"label_it\": \"Priorità 3\"},\n118\t\n119\t    # -- misc ------------------------------------------------------------\n120\t    \"tools\":      {\"symbol\": \"tools\",      \"label_en\": \"Tools\",      \"label_it\": \"Attrezzi\"},\n121\t    \"parts\":      {\"symbol\": \"parts\",      \"label_en\": \"Parts\",      \"label_it\": \"Ricambi\"},\n122\t    \"camera\":     {\"symbol\": \"camera\",     \"label_en\": \"Camera\",     \"label_it\": \"Fotocamera\"},\n123\t    \"microphone\": {\"symbol\": \"microphone\", \"label_en\": \"Microphone\", \"label_it\": \"Microfono\"},\n124\t    \"photo\":      {\"symbol\": \"photo\",      \"label_en\": \"Photo\",      \"label_it\": \"Foto\"},\n125\t    \"pdf\":        {\"symbol\": \"pdf\",        \"label_en\": \"PDF\",        \"label_it\": \"PDF\"},\n126\t    \"label\":      {\"symbol\": \"label\",      \"label_en\": \"Label\",      \"label_it\": \"Etichetta\"},\n127\t}\n128\t\n129\t#: The step/system/symptom/status/priority key *lists* above, exposed so\n130\t#: cuore/tests/check_icons_i18n.py (and anything else) can assert coverage\n131\t#: without re-deriving them from ICONS' insertion order.\n132\tSTEP_KEYS: tuple[str, ...] = (\n133\t    \"step_start\", \"step_complaint\", \"step_verdict\", \"step_scan\",\n134\t    \"step_understand\", \"step_test\", \"step_hypothesis\", \"step_plan\",\n135\t    \"step_repair\", \"step_verify\", \"step_document\", \"step_release\",\n136\t)\n137\tSTATUS_KEYS: tuple[str, ...] = (\n138\t    \"status_active\", \"status_cleared_unverified\", \"status_verified\",\n139\t    \"status_stale\", \"status_unknown\",\n140\t)\n141\tPRIORITY_KEYS: tuple[str, ...] = (\"priority_p1\", \"priority_p2\", \"priority_p3\")\n142\t\n143\t_SIZE_PX = {\"s\": 20, \"m\": 28, \"l\": 40}\n144\t\n145\t\n146\tdef icon(key: str, size: str = \"m\", label: Optional[str] = None) -> Any:\n147\t    \"\"\"Render one pictogram as an inline ``<span class=\"ico ico-NN\">``.\n148\t\n149\t    Falls back to a bare, still-accessible span for an unknown key or size\n150\t    rather than raising -- this is a template global, and (per the house\n151\t    rule other ``*_globals`` modules follow) must never 500 a page.\n152\t    \"\"\"\n153\t    px = _SIZE_PX.get(size, _SIZE_PX[\"m\"])\n154\t    entry = ICONS.get(key)\n155\t    if entry is None:\n156\t        safe_label = escape(label or key)\n157\t        return Markup(\n158\t            f'<span class=\"ico ico-{px}\" role=\"img\" aria-label=\"{safe_label}\"></span>'\n159\t        )\n160\t    symbol = entry[\"symbol\"]\n161\t    text = label or entry.get(\"label_en\") or key\n162\t    safe_label = escape(text)\n163\t    return Markup(\n164\t        f'<span class=\"ico ico-{px}\">'\n165\t        f'<svg role=\"img\" aria-label=\"{safe_label}\">'\n166\t        f'<use href=\"{static_url(\"icons.svg\")}#i-{symbol}\"></use>'\n167\t        f'</svg></span>'\n168\t    )\n169\t\n170\t\n171\tdef _register(templates: Any) -> None:\n172\t    templates.env.globals[\"icon\"] = icon\n173\t\n174\t\n175\tfor _module_name in (\n176\t    \"routes\", \"service_routes\", \"media_routes\", \"labels_routes\", \"bench_routes\",\n177\t    \"timeline_routes\", \"drivetrain_routes\", \"jobs_routes\", \"shop_routes\",\n178\t    \"electrical_routes\", \"systems_routes\", \"modules_routes\", \"inbox_routes\",\n179\t    \"report_routes\", \"tools_routes\", \"parts_routes\",\n180\t):\n181\t    try:\n182\t        _mod = importlib.import_module(f\".{_module_name}\", __package__)\n183\t        _tmpl = getattr(_mod, \"templates\", None) or getattr(_mod, \"_shared_templates\", None)\n184\t        if _tmpl is not None:\n185\t            _register(_tmpl)\n186\t    except Exception:  # noqa: BLE001 -- import-time side effect, must never raise\n187\t        pass\n188\t\n189\t\n190\t__all__ = [\"ICONS\", \"STEP_KEYS\", \"STATUS_KEYS\", \"PRIORITY_KEYS\", \"icon\"]\n191\t"}]},"uuid":"95980406-c051-4ed3-b8c5-d3a6d9df9eda","timestamp":"2026-10-08T17:38:30.702Z","toolUseResult":{"type":"text","file":{"filePath":"C:\\Users\\User\\mcp-servers\\cuore\\web\\icons.py","content":"\"\"\"Pictogram registry + the ``icon`` Jinja global.\n\nCUORE's mechanics mostly don't read English (or the UI's current language)\nas a first language, so the plan across the whole web app leans on small\nline pictograms with a short label rather than paragraphs: see\n``cuore/web/static/icons.svg`` for the sprite and ``icons.css`` for sizing.\nThis module is the registry that ties a short key (``\"sys_fuel\"``,\n``\"priority_p1\"``, ...) to a symbol in that sprite and to the bilingual\nlabel shown next to (or instead of) it.\n\nThe symbol id in icons.svg is always ``\"i-\" + key`` -- the registry key\nIS the symbol suffix, so there is no separate mapping to keep in sync; see\n``cuore/tests/check_icons_i18n.py`` for the check that the two files agree.\n\n``icon(key, size=\"m\", label=None)`` returns ready-to-use markup::\n\n    <span class=\"ico ico-28\"><svg role=\"img\" aria-label=\"Fuel\">\n      <use href=\"/static/icons.svg#i-sys_fuel\"></use></svg></span>\n\nRegistered as the Jinja global ``icon`` on every template environment that\nalready carries ``experience_links`` / ``flow_state_for`` -- same trick,\nsame four route modules, same defensive \"must never 500 a page\" posture;\nsee ``cuore/web/experience_globals.py``'s own docstring for why there are\nexactly four. Importing this module is the side effect that does the\nregistration; nothing here is called directly. Wiring it in (so the global\nactually exists at render time) is the same one-line\n``from ..web import icons  # noqa: F401`` move used for the other\n``*_globals`` modules -- left for the integration pass, not done here.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport importlib\nfrom html import escape\nfrom typing import Any, Optional\n\ntry:  # pragma: no cover -- exercised indirectly; keep import optional\n    from markupsafe import Markup\nexcept Exception:  # noqa: BLE001 -- markupsafe ships with Jinja2, but don't 500 without it\n    def Markup(s: str) -> str:  # type: ignore[no-redef]\n        return s\n\nfrom .static_version import static_url\n\n\n#: key -> {\"symbol\": <icons.svg symbol suffix, == key>, \"label_en\": ..., \"label_it\": ...}\n#: Grouped the same way icons.svg is grouped: flow steps, systems (keys taken\n#: straight from mes-log-mcp/mes/systems.py's SYSTEMS dict), symptoms (keys\n#: from mes-log-mcp/mes/symptoms.py's SYMPTOM_TAGS), statuses, priorities,\n#: then the handful of misc glyphs (tools/parts/camera/...).\nICONS: dict[str, dict[str, str]] = {\n    # -- 12 flow steps --------------------------------------------------\n    \"step_start\":       {\"symbol\": \"step_start\",       \"label_en\": \"Start\",            \"label_it\": \"Avvio\"},\n    \"step_complaint\":   {\"symbol\": \"step_complaint\",   \"label_en\": \"Complaint\",        \"label_it\": \"Disturbo riferito\"},\n    \"step_verdict\":     {\"symbol\": \"step_verdict\",     \"label_en\": \"Verdict\",          \"label_it\": \"Verdetto\"},\n    \"step_scan\":        {\"symbol\": \"step_scan\",        \"label_en\": \"Scan\",             \"label_it\": \"Scansione\"},\n    \"step_understand\":  {\"symbol\": \"step_understand\",  \"label_en\": \"Understand\",       \"label_it\": \"Comprendere\"},\n    \"step_test\":        {\"symbol\": \"step_test\",        \"label_en\": \"Test\",             \"label_it\": \"Prova\"},\n    \"step_hypothesis\":  {\"symbol\": \"step_hypothesis\",  \"label_en\": \"Hypothesis\",       \"label_it\": \"Ipotesi\"},\n    \"step_plan\":        {\"symbol\": \"step_plan\",        \"label_en\": \"Plan\",             \"label_it\": \"Piano\"},\n    \"step_repair\":      {\"symbol\": \"step_repair\",      \"label_en\": \"Repair\",           \"label_it\": \"Riparazione\"},\n    \"step_verify\":      {\"symbol\": \"step_verify\",      \"label_en\": \"Verify\",           \"label_it\": \"Verifica\"},\n    \"step_document\":    {\"symbol\": \"step_document\",    \"label_en\": \"Document\",         \"label_it\": \"Documentare\"},\n    \"step_release\":     {\"symbol\": \"step_release\",     \"label_en\": \"Release\",          \"label_it\": \"Rilascio\"},\n\n    # -- 25 systems -------------------------------------------------------\n    \"sys_electrical_supply\":      {\"symbol\": \"sys_electrical_supply\",      \"label_en\": \"Electrical supply\",      \"label_it\": \"Impianto elettrico\"},\n    \"sys_network\":                {\"symbol\": \"sys_network\",                \"label_en\": \"Network / CAN\",          \"label_it\": \"Rete / CAN\"},\n    \"sys_ignition\":                {\"symbol\": \"sys_ignition\",               \"label_en\": \"Ignition\",               \"label_it\": \"Accensione\"},\n    \"sys_fuel\":                    {\"symbol\": \"sys_fuel\",                   \"label_en\": \"Fuel\",                   \"label_it\": \"Alimentazione\"},\n    \"sys_evap\":                    {\"symbol\": \"sys_evap\",                   \"label_en\": \"EVAP\",                   \"label_it\": \"Valvola di spurgo (EVAP)\"},\n    \"sys_air_intake_boost\":        {\"symbol\": \"sys_air_intake_boost\",       \"label_en\": \"Air intake / boost\",     \"label_it\": \"Aspirazione / sovralimentazione\"},\n    \"sys_cooling\":                 {\"symbol\": \"sys_cooling\",                \"label_en\": \"Cooling\",                \"label_it\": \"Raffreddamento\"},\n    \"sys_lubrication\":             {\"symbol\": \"sys_lubrication\",            \"label_en\": \"Lubrication\",             \"label_it\": \"Lubrificazione\"},\n    \"sys_exhaust_emissions\":       {\"symbol\": \"sys_exhaust_emissions\",      \"label_en\": \"Exhaust / emissions\",    \"label_it\": \"Scarico / emissioni\"},\n    \"sys_transmission_driveline\":  {\"symbol\": \"sys_transmission_driveline\", \"label_en\": \"Transmission / driveline\", \"label_it\": \"Trasmissione\"},\n    \"sys_brakes_abs\":              {\"symbol\": \"sys_brakes_abs\",             \"label_en\": \"Brakes / ABS\",            \"label_it\": \"Freni / ABS\"},\n    \"sys_steering\":                {\"symbol\": \"sys_steering\",               \"label_en\": \"Steering\",               \"label_it\": \"Sterzo\"},\n    \"sys_suspension\":              {\"symbol\": \"sys_suspension\",             \"label_en\": \"Suspension\",             \"label_it\": \"Sospensioni\"},\n    \"sys_body_comfort\":            {\"symbol\": \"sys_body_comfort\",           \"label_en\": \"Body / comfort\",         \"label_it\": \"Carrozzeria / comfort\"},\n    \"sys_adas_sensors\":            {\"symbol\": \"sys_adas_sensors\",           \"label_en\": \"ADAS sensors\",           \"label_it\": \"Sensori ADAS\"},\n    \"sys_hvac\":                    {\"symbol\": \"sys_hvac\",                   \"label_en\": \"HVAC\",                   \"label_it\": \"Climatizzazione\"},\n    \"sys_pcv\":                     {\"symbol\": \"sys_pcv\",                    \"label_en\": \"PCV / breather\",         \"label_it\": \"Sfiato (PCV)\"},\n    \"sys_engine_management\":       {\"symbol\": \"sys_engine_management\",      \"label_en\": \"Engine management\",      \"label_it\": \"Centralina motore\"},\n    \"sys_valve_control\":           {\"symbol\": \"sys_valve_control\",          \"label_en\": \"Valve control\",          \"label_it\": \"Distribuzione\"},\n    \"sys_starting_charging\":       {\"symbol\": \"sys_starting_charging\",      \"label_en\": \"Starting / charging\",    \"label_it\": \"Avviamento / ricarica\"},\n    \"sys_security_immobiliser\":    {\"symbol\": \"sys_security_immobiliser\",   \"label_en\": \"Security / immobiliser\", \"label_it\": \"Antifurto / immobilizzatore\"},\n    \"sys_infotainment_cluster\":    {\"symbol\": \"sys_infotainment_cluster\",   \"label_en\": \"Infotainment / cluster\", \"label_it\": \"Infotainment / quadro\"},\n    \"sys_lighting\":                {\"symbol\": \"sys_lighting\",               \"label_en\": \"Lighting\",               \"label_it\": \"Illuminazione\"},\n    \"sys_wheels_tpms\":             {\"symbol\": \"sys_wheels_tpms\",            \"label_en\": \"Wheels / TPMS\",          \"label_it\": \"Ruote / TPMS\"},\n    \"sys_restraints\":              {\"symbol\": \"sys_restraints\",             \"label_en\": \"Restraints\",             \"label_it\": \"Sistemi di ritenuta\"},\n\n    # -- 12 symptoms --------------------------------------------------\n    \"symptom_drives_normally\": {\"symbol\": \"symptom_drives_normally\", \"label_en\": \"Drives normally\",  \"label_it\": \"Guida normalmente\"},\n    \"symptom_mil_on\":          {\"symbol\": \"symptom_mil_on\",          \"label_en\": \"Warning lamp on\",   \"label_it\": \"Spia accesa\"},\n    \"symptom_fuel_smell\":      {\"symbol\": \"symptom_fuel_smell\",      \"label_en\": \"Fuel smell\",        \"label_it\": \"Odore di carburante\"},\n    \"symptom_hard_start\":      {\"symbol\": \"symptom_hard_start\",      \"label_en\": \"Hard to start\",      \"label_it\": \"Difficoltà di avviamento\"},\n    \"symptom_rough_idle\":      {\"symbol\": \"symptom_rough_idle\",      \"label_en\": \"Rough idle\",         \"label_it\": \"Minimo irregolare\"},\n    \"symptom_hesitation\":      {\"symbol\": \"symptom_hesitation\",      \"label_en\": \"Hesitation\",         \"label_it\": \"Esitazione\"},\n    \"symptom_loss_of_power\":   {\"symbol\": \"symptom_loss_of_power\",   \"label_en\": \"Loss of power\",      \"label_it\": \"Perdita di potenza\"},\n    \"symptom_hard_to_refuel\":  {\"symbol\": \"symptom_hard_to_refuel\",  \"label_en\": \"Hard to refuel\",     \"label_it\": \"Difficoltà di rifornimento\"},\n    \"symptom_noise\":           {\"symbol\": \"symptom_noise\",           \"label_en\": \"Noise\",              \"label_it\": \"Rumore\"},\n    \"symptom_vibration\":       {\"symbol\": \"symptom_vibration\",       \"label_en\": \"Vibration\",          \"label_it\": \"Vibrazione\"},\n    \"symptom_warning_message\": {\"symbol\": \"symptom_warning_message\", \"label_en\": \"Warning message\",    \"label_it\": \"Messaggio di avviso\"},\n    \"symptom_other\":           {\"symbol\": \"symptom_other\",           \"label_en\": \"Other\",              \"label_it\": \"Altro\"},\n\n    # -- 5 statuses ------------------------------------------------------\n    \"status_active\":              {\"symbol\": \"status_active\",              \"label_en\": \"Active\",               \"label_it\": \"Attivo\"},\n    \"status_cleared_unverified\":  {\"symbol\": \"status_cleared_unverified\",  \"label_en\": \"Cleared, unverified\",  \"label_it\": \"Azzerato, non verificato\"},\n    \"status_verified\":            {\"symbol\": \"status_verified\",            \"label_en\": \"Verified\",             \"label_it\": \"Verificato\"},\n    \"status_stale\":                {\"symbol\": \"status_stale\",               \"label_en\": \"Stale\",                \"label_it\": \"Obsoleto\"},\n    \"status_unknown\":              {\"symbol\": \"status_unknown\",             \"label_en\": \"Unknown\",              \"label_it\": \"Sconosciuto\"},\n\n    # -- 3 priorities ------------------------------------------------------\n    \"priority_p1\": {\"symbol\": \"priority_p1\", \"label_en\": \"Priority 1\", \"label_it\": \"Priorità 1\"},\n    \"priority_p2\": {\"symbol\": \"priority_p2\", \"label_en\": \"Priority 2\", \"label_it\": \"Priorità 2\"},\n    \"priority_p3\": {\"symbol\": \"priority_p3\", \"label_en\": \"Priority 3\", \"label_it\": \"Priorità 3\"},\n\n    # -- misc ------------------------------------------------------------\n    \"tools\":      {\"symbol\": \"tools\",      \"label_en\": \"Tools\",      \"label_it\": \"Attrezzi\"},\n    \"parts\":      {\"symbol\": \"parts\",      \"label_en\": \"Parts\",      \"label_it\": \"Ricambi\"},\n    \"camera\":     {\"symbol\": \"camera\",     \"label_en\": \"Camera\",     \"label_it\": \"Fotocamera\"},\n    \"microphone\": {\"symbol\": \"microphone\", \"label_en\": \"Microphone\", \"label_it\": \"Microfono\"},\n    \"photo\":      {\"symbol\": \"photo\",      \"label_en\": \"Photo\",      \"label_it\": \"Foto\"},\n    \"pdf\":        {\"symbol\": \"pdf\",        \"label_en\": \"PDF\",        \"label_it\": \"PDF\"},\n    \"label\":      {\"symbol\": \"label\",      \"label_en\": \"Label\",      \"label_it\": \"Etichetta\"},\n}\n\n#: The step/system/symptom/status/priority key *lists* above, exposed so\n#: cuore/tests/check_icons_i18n.py (and anything else) can assert coverage\n#: without re-deriving them from ICONS' insertion order.\nSTEP_KEYS: tuple[str, ...] = (\n    \"step_start\", \"step_complaint\", \"step_verdict\", \"step_scan\",\n    \"step_understand\", \"step_test\", \"step_hypothesis\", \"step_plan\",\n    \"step_repair\", \"step_verify\", \"step_document\", \"step_release\",\n)\nSTATUS_KEYS: tuple[str, ...] = (\n    \"status_active\", \"status_cleared_unverified\", \"status_verified\",\n    \"status_stale\", \"status_unknown\",\n)\nPRIORITY_KEYS: tuple[str, ...] = (\"priority_p1\", \"priority_p2\", \"priority_p3\")\n\n_SIZE_PX = {\"s\": 20, \"m\": 28, \"l\": 40}\n\n\ndef icon(key: str, size: str = \"m\", label: Optional[str] = None) -> Any:\n    \"\"\"Render one pictogram as an inline ``<span class=\"ico ico-NN\">``.\n\n    Falls back to a bare, still-accessible span for an unknown key or size\n    rather than raising -- this is a template global, and (per the house\n    rule other ``*_globals`` modules follow) must never 500 a page.\n    \"\"\"\n    px = _SIZE_PX.get(size, _SIZE_PX[\"m\"])\n    entry = ICONS.get(key)\n    if entry is None:\n        safe_label = escape(label or key)\n        return Markup(\n            f'<span class=\"ico ico-{px}\" role=\"img\" aria-label=\"{safe_label}\"></span>'\n        )\n    symbol = entry[\"symbol\"]\n    text = label or entry.get(\"label_en\") or key\n    safe_label = escape(text)\n    return Markup(\n        f'<span class=\"ico ico-{px}\">'\n        f'<svg role=\"img\" aria-label=\"{safe_label}\">'\n        f'<use href=\"{static_url(\"icons.svg\")}#i-{symbol}\"></use>'\n        f'</svg></span>'\n    )\n\n\ndef _register(templates: Any) -> None:\n    templates.env.globals[\"icon\"] = icon\n\n\nfor _module_name in (\n    \"routes\", \"service_routes\", \"media_routes\", \"labels_routes\", \"bench_routes\",\n    \"timeline_routes\", \"drivetrain_routes\", \"jobs_routes\", \"shop_routes\",\n    \"electrical_routes\", \"systems_routes\", \"modules_routes\", \"inbox_routes\",\n    \"report_routes\", \"tools_routes\", \"parts_routes\",\n):\n    try:\n        _mod = importlib.import_module(f\".{_module_name}\", __package__)\n        _tmpl = getattr(_mod, \"templates\", None) or getattr(_mod, \"_shared_templates\", None)\n        if _tmpl is not None:\n            _register(_tmpl)\n    except Exception:  # noqa: BLE001 -- import-time side effect, must never raise\n        pass\n\n\n__all__ = [\"ICONS\", \"STEP_KEYS\", \"STATUS_KEYS\", \"PRIORITY_KEYS\", \"icon\"]\n","numLines":191,"startLine":1,"totalLines":191}},"sourceToolAssistantUUID":"b8d9d19e-c9f1-4e3a-95fa-fda4447d697d","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
{"parentUuid":"95980406-c051-4ed3-b8c5-d3a6d9df9eda","isSidechain":true,"agentId":"ad6a96a2be529de3c","message":{"model":"claude-sonnet-5","id":"msg_011CfqBFw414ea5aXVGT5ESV","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01K3Wy1ekKgp3qa4DiR1nYhT","name":"Read","input":{"file_path":"C:\\Users\\User\\mcp-servers\\cuore\\web\\i18n.py"},"caller":{"type":"direct"}}],"container":null,"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2323,"cache_read_input_tokens":64792,"output_tokens":288,"output_tokens_details":{"thinking_tokens":0},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":0,"ephemeral_5m_input_tokens":2323},"inference_geo":"not_available","iterations":[{"input_tokens":2,"output_tokens":288,"cache_read_input_tokens":64792,"cache_creation_input_tokens":2323,"cache_creation":{"ephemeral_5m_input_tokens":2323,"ephemeral_1h_input_tokens":0},"type":"message"}],"speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_01K3Wy1ekKgp3qa4DiR1nYhT":{"file_path":"C:\\Users\\User\\mcp-servers\\cuore\\web\\i18n.py"}},"serverClassifierRequest":"05d5a197-4dd5-446d-9b45-9ca61df67259","apiBlockIndex":3,"requestId":"req_011CfqBFvodHnXBMEbcevAkK","attributionAgent":"general-purpose","type":"assistant","uuid":"97ea307a-081d-4aba-b2dd-5de3359993e6","timestamp":"2026-10-08T17:38:31.054Z","effort":"high","perTurnEffort":null,"userType":"external","entrypoint":"cli","cwd":"C:\\Users\\User\\mcp-servers","sessionId":"7cb02eb5-e299-4baf-b34b-9eb82aebbf17","version":"2.1.282","gitBranch":"HEAD","slug":"binary-splashing-comet"}
{"parentUuid":"97ea307a-081d-4aba-b2dd-5de3359993e6","isSidechain":true,"promptId":"14b8b90f-0c4b-47b6-b2bf-3803814525db","agentId":"ad6a96a2be529de3c","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01K3Wy1ekKgp3qa4DiR1nYhT","type":"tool_result","content":"1\t\"\"\"UI string dictionary + the ``t`` / ``lang`` Jinja globals.\n2\t\n3\tCUORE's mechanics mostly don't read English as a first language (see\n4\t``cuore/web/icons.py`` for the pictogram half of the same mitigation), so\n5\tevery page-chrome label collected here (headings and button text, grepped\n6\tfrom ``<h1>``-``<h3>`` and ``.btn`` across ``cuore/web/templates/*.html``)\n7\tgets a translation, not just English. DTC codes, part numbers and VINs are\n8\tnever put in here -- those are data, not UI chrome, and stay as-is wherever\n9\ta template renders them directly.\n10\t\n11\tLanguage model\n12\t---------------\n13\t``SUPPORTED_LANGS`` is the set actually filled in below (Italian, English\n14\ttoday); the dict shape -- one ``{lang: text}`` map per key -- is already\n15\tright for French/German/Spanish to be added later by just adding another\n16\tkey to each entry and that language's code to ``SUPPORTED_LANGS``, with no\n17\tchange to ``t()`` or the templates that call it.\n18\t\n19\t``DEFAULT_LANG`` is ``\"it\"``: most of this shop's mechanics default to\n20\tItalian, and an unset or unrecognised ``lang`` cookie should not silently\n21\tmean English. ``t(key, lang)`` looks up the requested language first and\n22\tonly falls back to English (never to Italian, and never to ``DEFAULT_LANG``\n23\tif that differs from the requested language) when that specific key has no\n24\ttranslation for it -- a half-translated page beats a page that 500s or\n25\tshows raw keys.\n26\t\n27\tRegistered as the Jinja globals ``t`` and ``lang`` on the same four\n28\ttemplate environments ``experience_globals`` / ``icons`` register against\n29\t(see those modules' docstrings for why four). Both are context-aware\n30\t(``jinja2.pass_context``) so they read the ``lang`` cookie straight off the\n31\tcurrent request rather than needing every route to pass it through\n32\texplicitly -- FastAPI's ``Jinja2Templates`` already puts ``request`` in\n33\tevery template's context, which is what makes that possible. Importing this\n34\tmodule is the side effect that does the registration; wiring it in is the\n35\tsame one-line ``from ..web import i18n  # noqa: F401`` move the other\n36\t``*_globals`` modules use -- left for the integration pass.\n37\t\n38\t``set_lang_cookie(response, lang)`` and ``pick_language_html(current)`` are\n39\tplain, router-free helpers (no FastAPI import here) for that same\n40\tintegration pass: the first sets the cookie on a response, the second\n41\trenders a 44px-tall Italiano/English chooser to drop in the header and on\n42\tfirst visit.\n43\t\"\"\"\n44\t\n45\tfrom __future__ import annotations\n46\t\n47\timport importlib\n48\tfrom html import escape\n49\tfrom typing import Any, Optional\n50\t\n51\ttry:  # pragma: no cover -- ships with Jinja2; keep the import optional anyway\n52\t    from jinja2 import pass_context\n53\texcept Exception:  # noqa: BLE001 -- must not stop this module from loading\n54\t    def pass_context(f):  # type: ignore[no-redef]\n55\t        return f\n56\t\n57\ttry:  # pragma: no cover -- ships with Jinja2\n58\t    from markupsafe import Markup\n59\texcept Exception:  # noqa: BLE001\n60\t    def Markup(s: str) -> str:  # type: ignore[no-redef]\n61\t        return s\n62\t\n63\t\n64\t#: Languages this module actually has translations for. Order matters only\n65\t#: for ``pick_language_html``'s button order. Extending to French/German/\n66\t#: Spanish later is: add \"fr\"/\"de\"/\"es\" here and fill that key in STRINGS --\n67\t#: nothing else changes.\n68\tSUPPORTED_LANGS: tuple[str, ...] = (\"it\", \"en\")\n69\t\n70\t#: The Italian language chooser has been removed from the UI (it did not\n71\t#: work); the app now always renders English regardless of any ``lang``\n72\t#: cookie. ``DEFAULT_LANG`` stays \"en\" rather than being deleted so the\n73\t#: rest of this module (and the still-present Italian strings below, kept\n74\t#: but unused) needs no further rewiring if a working chooser comes back.\n75\tDEFAULT_LANG = \"en\"\n76\t\n77\t#: English is the one language every key is guaranteed to have, so it is\n78\t#: ``t()``'s fallback when the requested language's translation is missing\n79\t#: for that specific key (not when the *cookie* is merely unset -- that\n80\t#: case uses DEFAULT_LANG before t() is ever called, via lang_from_cookie).\n81\t_FALLBACK_LANG = \"en\"\n82\t\n83\tSTRINGS: dict[str, dict[str, str]] = {\n84\t    # -- the 12 flow-step headings ------------------------------------\n85\t    \"start\": {\"en\": \"Start\", \"it\": \"Avvio\"},\n86\t    \"complaint_symptoms\": {\"en\": \"Complaint & symptoms\", \"it\": \"Disturbo e sintomi\"},\n87\t    \"verdict\": {\"en\": \"Verdict\", \"it\": \"Verdetto\"},\n88\t    \"scan_codes\": {\"en\": \"Scan & codes\", \"it\": \"Scansione e codici\"},\n89\t    \"understand_fault\": {\"en\": \"Understand the fault\", \"it\": \"Comprendere il guasto\"},\n90\t    \"tests_inspections\": {\"en\": \"Tests & inspections\", \"it\": \"Prove e controlli\"},\n91\t    \"hypotheses\": {\"en\": \"Hypotheses\", \"it\": \"Ipotesi\"},\n92\t    \"plan_repair\": {\"en\": \"Plan the repair\", \"it\": \"Pianificare la riparazione\"},\n93\t    \"repair\": {\"en\": \"Repair\", \"it\": \"Riparazione\"},\n94\t    \"verify\": {\"en\": \"Verify\", \"it\": \"Verifica\"},\n95\t    \"document\": {\"en\": \"Document\", \"it\": \"Documentare\"},\n96\t    \"release\": {\"en\": \"Release\", \"it\": \"Rilascio\"},\n97\t\n98\t    # -- base chrome ------------------------------------------------------\n99\t    \"home\": {\"en\": \"Home\", \"it\": \"Home\"},\n100\t    \"menu\": {\"en\": \"Menu\", \"it\": \"Menu\"},\n101\t    \"toggle_theme\": {\"en\": \"Toggle dark/light theme\", \"it\": \"Cambia tema chiaro/scuro\"},\n102\t    \"print_page\": {\"en\": \"Print this page\", \"it\": \"Stampa questa pagina\"},\n103\t    \"vehicles\": {\"en\": \"Vehicles\", \"it\": \"Veicoli\"},\n104\t    \"modules\": {\"en\": \"Modules\", \"it\": \"Moduli\"},\n105\t    \"recordings\": {\"en\": \"Recordings\", \"it\": \"Registrazioni\"},\n106\t    \"logs\": {\"en\": \"Logs\", \"it\": \"Log\"},\n107\t    \"live_link\": {\"en\": \"Live link\", \"it\": \"Collegamento live\"},\n108\t    \"coverage\": {\"en\": \"Coverage\", \"it\": \"Copertura\"},\n109\t    \"tools\": {\"en\": \"Tools\", \"it\": \"Attrezzi\"},\n110\t\n111\t    # -- headings ----------------------------------------------------------\n112\t    \"adaptation_relearn\": {\"en\": \"Adaptation relearn\", \"it\": \"Riapprendimento adattivo\"},\n113\t    \"adapter\": {\"en\": \"Adapter\", \"it\": \"Adattatore\"},\n114\t    \"add_hypothesis\": {\"en\": \"Add a hypothesis\", \"it\": \"Aggiungi un'ipotesi\"},\n115\t    \"add_note\": {\"en\": \"Add a note\", \"it\": \"Aggiungi una nota\"},\n116\t    \"add_media\": {\"en\": \"Add photos, video, sounds or documents\", \"it\": \"Aggiungi foto, video, audio o documenti\"},\n117\t    \"alarms_markers\": {\"en\": \"Alarms & markers\", \"it\": \"Allarmi e segnalatori\"},\n118\t    \"already_attempted\": {\"en\": \"Already attempted\", \"it\": \"Già tentato\"},\n119\t    \"blind_spots\": {\"en\": \"Blind spots\", \"it\": \"Punti ciechi\"},\n120\t    \"brake_tyre_spec\": {\"en\": \"Brake / tyre specification\", \"it\": \"Specifiche freni / pneumatici\"},\n121\t    \"brakes_wheels_tyres\": {\"en\": \"Brakes, wheels & tyres\", \"it\": \"Freni, ruote e pneumatici\"},\n122\t    \"bulletins\": {\"en\": \"Bulletins\", \"it\": \"Bollettini\"},\n123\t    \"buses\": {\"en\": \"Buses\", \"it\": \"Bus dati\"},\n124\t    \"by_family\": {\"en\": \"By family\", \"it\": \"Per famiglia\"},\n125\t    \"cable\": {\"en\": \"Cable\", \"it\": \"Cavo\"},\n126\t    \"calibrate\": {\"en\": \"Calibrate\", \"it\": \"Calibrare\"},\n127\t    \"carried_forward\": {\"en\": \"Carried forward from last time\", \"it\": \"Riportato dalla volta precedente\"},\n128\t    \"checks\": {\"en\": \"Checks\", \"it\": \"Controlli\"},\n129\t    \"choose_job\": {\"en\": \"Choose a job\", \"it\": \"Scegli un lavoro\"},\n130\t    \"choose_job_category\": {\"en\": \"Choose a job category\", \"it\": \"Scegli una categoria di lavoro\"},\n131\t    \"choose_items_visit\": {\"en\": \"Choose items for this visit\", \"it\": \"Scegli gli elementi per questa visita\"},\n132\t    \"co_occurrence\": {\"en\": \"Co-occurrence\", \"it\": \"Co-occorrenza\"},\n133\t    \"code_timeline\": {\"en\": \"Code timeline\", \"it\": \"Cronologia dei codici\"},\n134\t    \"codes\": {\"en\": \"Codes\", \"it\": \"Codici\"},\n135\t    \"codes_vs_driver\": {\"en\": \"Codes vs. what the driver notices\", \"it\": \"Codici rispetto a ciò che nota il guidatore\"},\n136\t    \"columns\": {\"en\": \"Columns\", \"it\": \"Colonne\"},\n137\t    \"considerations_next\": {\"en\": \"Considerations for next time\", \"it\": \"Considerazioni per la prossima volta\"},\n138\t    \"corners\": {\"en\": \"Corners\", \"it\": \"Angoli (ruote)\"},\n139\t    \"corpus\": {\"en\": \"Corpus\", \"it\": \"Corpus\"},\n140\t    \"current_picture\": {\"en\": \"Current picture\", \"it\": \"Quadro attuale\"},\n141\t    \"custom_sheet_dims\": {\"en\": \"Custom sheet dimensions (mm)\", \"it\": \"Dimensioni foglio personalizzate (mm)\"},\n142\t    \"dtc_report\": {\"en\": \"DTC report\", \"it\": \"Rapporto DTC\"},\n143\t    \"dtcs_0x1902\": {\"en\": \"DTCs (0x19 02)\", \"it\": \"DTC (0x19 02)\"},\n144\t    \"dtcs_by_module\": {\"en\": \"DTCs by module\", \"it\": \"DTC per modulo\"},\n145\t    \"dashboard\": {\"en\": \"Dashboard\", \"it\": \"Cruscotto\"},\n146\t    \"dealer_results\": {\"en\": \"Dealer (wiTECH) results\", \"it\": \"Risultati concessionaria (wiTECH)\"},\n147\t    \"dependency_graph\": {\"en\": \"Dependency graph\", \"it\": \"Grafo delle dipendenze\"},\n148\t    \"discoveries\": {\"en\": \"Discoveries\", \"it\": \"Scoperte\"},\n149\t    \"discoveries_considerations\": {\"en\": \"Discoveries & considerations\", \"it\": \"Scoperte e considerazioni\"},\n150\t    \"drain_condition\": {\"en\": \"Drain & condition\", \"it\": \"Scarico e condizione\"},\n151\t    \"drive_cycle_counters\": {\"en\": \"Drive-cycle counters\", \"it\": \"Contatori ciclo di guida\"},\n152\t    \"due_status\": {\"en\": \"Due status\", \"it\": \"Stato scadenza\"},\n153\t    \"epb_rear\": {\"en\": \"Electric parking brake (rear)\", \"it\": \"Freno di stazionamento elettrico (posteriore)\"},\n154\t    \"electrical\": {\"en\": \"Electrical\", \"it\": \"Impianto elettrico\"},\n155\t    \"electrical_path\": {\"en\": \"Electrical path\", \"it\": \"Percorso elettrico\"},\n156\t    \"elements\": {\"en\": \"Elements\", \"it\": \"Elementi\"},\n157\t    \"every_code\": {\"en\": \"Every code this car has set\", \"it\": \"Ogni codice impostato da questa vettura\"},\n158\t    \"every_occurrence\": {\"en\": \"Every occurrence\", \"it\": \"Ogni occorrenza\"},\n159\t    \"everything_corpus\": {\"en\": \"Everything in the corpus\", \"it\": \"Tutto il corpus\"},\n160\t    \"evidence_gate\": {\"en\": \"Evidence gate\", \"it\": \"Soglia delle prove\"},\n161\t    \"excursions\": {\"en\": \"Excursions\", \"it\": \"Escursioni\"},\n162\t    \"fault_tree\": {\"en\": \"Fault tree\", \"it\": \"Albero dei guasti\"},\n163\t    \"filter\": {\"en\": \"Filter\", \"it\": \"Filtro\"},\n164\t    \"flash_check\": {\"en\": \"Flash check\", \"it\": \"Controllo flash\"},\n165\t    \"fluid\": {\"en\": \"Fluid\", \"it\": \"Fluido\"},\n166\t    \"fluid_condition\": {\"en\": \"Fluid condition\", \"it\": \"Condizione del fluido\"},\n167\t    \"freeze_frames\": {\"en\": \"Freeze frames\", \"it\": \"Fotogrammi congelati\"},\n168\t    \"front_differential\": {\"en\": \"Front differential\", \"it\": \"Differenziale anteriore\"},\n169\t    \"gauges\": {\"en\": \"Gauges\", \"it\": \"Strumenti\"},\n170\t    \"general_service\": {\"en\": \"General service\", \"it\": \"Tagliando generale\"},\n171\t    \"history\": {\"en\": \"History\", \"it\": \"Storico\"},\n172\t    \"identity_annex_c\": {\"en\": \"Identity (Annex C)\", \"it\": \"Identità (Allegato C)\"},\n173\t    \"inbox\": {\"en\": \"Inbox\", \"it\": \"Posta in arrivo\"},\n174\t    \"inspection_tag_fields\": {\"en\": \"Inspection tag fields\", \"it\": \"Campi etichetta ispezione\"},\n175\t    \"job\": {\"en\": \"Job\", \"it\": \"Lavoro\"},\n176\t    \"job_tag_fields\": {\"en\": \"Job tag fields\", \"it\": \"Campi etichetta lavoro\"},\n177\t    \"keyboard\": {\"en\": \"Keyboard\", \"it\": \"Tastiera\"},\n178\t    \"kind_template\": {\"en\": \"Kind & template\", \"it\": \"Tipo e modello\"},\n179\t    \"known_issues\": {\"en\": \"Known issues\", \"it\": \"Problemi noti\"},\n180\t    \"labels_printed\": {\"en\": \"Labels printed\", \"it\": \"Etichette stampate\"},\n181\t    \"last_90_days\": {\"en\": \"Last 90 days\", \"it\": \"Ultimi 90 giorni\"},\n182\t    \"last_maintenance_visit\": {\"en\": \"Last maintenance visit\", \"it\": \"Ultimo intervento di manutenzione\"},\n183\t    \"last_oil_change\": {\"en\": \"Last oil change\", \"it\": \"Ultimo cambio olio\"},\n184\t    \"latest_all_systems_scan\": {\"en\": \"Latest all-systems scan\", \"it\": \"Ultima scansione di tutti i sistemi\"},\n185\t    \"latest_session\": {\"en\": \"Latest session\", \"it\": \"Ultima sessione\"},\n186\t    \"legislated_obd\": {\"en\": \"Legislated OBD (CAN-C)\", \"it\": \"OBD legale (CAN-C)\"},\n187\t    \"live\": {\"en\": \"Live\", \"it\": \"Live\"},\n188\t    \"live_status\": {\"en\": \"Live status\", \"it\": \"Stato live\"},\n189\t    \"live_vs_log\": {\"en\": \"Live vs log\", \"it\": \"Live rispetto al log\"},\n190\t    \"log_symptom\": {\"en\": \"Log a symptom\", \"it\": \"Registra un sintomo\"},\n191\t    \"log_index\": {\"en\": \"Log index\", \"it\": \"Indice dei log\"},\n192\t    \"mes_and_lock\": {\"en\": \"MES and lock\", \"it\": \"MES e blocco\"},\n193\t    \"maintenance_reminder_fields\": {\"en\": \"Maintenance reminder fields\", \"it\": \"Campi promemoria manutenzione\"},\n194\t\n195\t    # -- buttons -------------------------------------------------------\n196\t    \"back_to_dossier\": {\"en\": \"Back to dossier\", \"it\": \"Torna al dossier\"},\n197\t    \"add_to_ledger\": {\"en\": \"Add to ledger\", \"it\": \"Aggiungi al registro\"},\n198\t    \"all\": {\"en\": \"All\", \"it\": \"Tutti\"},\n199\t    \"all_domains\": {\"en\": \"All domains\", \"it\": \"Tutti i domini\"},\n200\t    \"answer\": {\"en\": \"Answer\", \"it\": \"Rispondi\"},\n201\t    \"assess\": {\"en\": \"Assess\", \"it\": \"Valuta\"},\n202\t    \"back_to_tree\": {\"en\": \"Back to the tree\", \"it\": \"Torna all'albero\"},\n203\t    \"clear\": {\"en\": \"Clear\", \"it\": \"Pulisci\"},\n204\t    \"clear_filter\": {\"en\": \"Clear filter\", \"it\": \"Rimuovi filtro\"},\n205\t    \"close\": {\"en\": \"Close\", \"it\": \"Chiudi\"},\n206\t    \"close_case\": {\"en\": \"Close case\", \"it\": \"Chiudi il caso\"},\n207\t    \"connect\": {\"en\": \"Connect\", \"it\": \"Connetti\"},\n208\t    \"custom_channels\": {\"en\": \"Custom channels\", \"it\": \"Canali personalizzati\"},\n209\t    \"declare_cable\": {\"en\": \"Declare cable\", \"it\": \"Dichiara cavo\"},\n210\t    \"discard_session\": {\"en\": \"Discard this session\", \"it\": \"Scarta questa sessione\"},\n211\t    \"dismiss\": {\"en\": \"Dismiss\", \"it\": \"Ignora\"},\n212\t    \"download_pdf\": {\"en\": \"Download PDF\", \"it\": \"Scarica PDF\"},\n213\t    \"edit_layout\": {\"en\": \"Edit layout\", \"it\": \"Modifica layout\"},\n214\t    \"exclude_simulation\": {\"en\": \"Exclude simulation\", \"it\": \"Escludi simulazione\"},\n215\t    \"export\": {\"en\": \"Export\", \"it\": \"Esporta\"},\n216\t    \"find_excursions\": {\"en\": \"Find excursions\", \"it\": \"Trova escursioni\"},\n217\t    \"go_to_release\": {\"en\": \"Go to release\", \"it\": \"Vai al rilascio\"},\n218\t    \"hud\": {\"en\": \"HUD\", \"it\": \"HUD\"},\n219\t    \"hide\": {\"en\": \"Hide\", \"it\": \"Nascondi\"},\n220\t    \"i_dont\": {\"en\": \"I don't\", \"it\": \"Io no\"},\n221\t    \"i_have_this\": {\"en\": \"I have this\", \"it\": \"Io sì\"},\n222\t    \"import_\": {\"en\": \"Import\", \"it\": \"Importa\"},\n223\t    \"include_simulation\": {\"en\": \"Include simulation\", \"it\": \"Includi simulazione\"},\n224\t    \"load_checklist\": {\"en\": \"Load checklist\", \"it\": \"Carica lista di controllo\"},\n225\t    \"load_fields_checked\": {\"en\": \"Load fields for checked items\", \"it\": \"Carica campi per gli elementi selezionati\"},\n226\t    \"load_job\": {\"en\": \"Load job\", \"it\": \"Carica lavoro\"},\n227\t    \"mark\": {\"en\": \"Mark\", \"it\": \"Segna\"},\n228\t    \"mark_applied\": {\"en\": \"Mark applied\", \"it\": \"Segna come applicato\"},\n229\t    \"open_original\": {\"en\": \"Open original\", \"it\": \"Apri originale\"},\n230\t    \"pause_all\": {\"en\": \"Pause all\", \"it\": \"Pausa generale\"},\n231\t    \"print_test_grid\": {\"en\": \"Print test grid (plain paper)\", \"it\": \"Stampa griglia di prova (carta semplice)\"},\n232\t    \"probe_adapter\": {\"en\": \"Probe adapter\", \"it\": \"Adattatore sonda\"},\n233\t    \"read_dtcs\": {\"en\": \"Read DTCs\", \"it\": \"Leggi DTC\"},\n234\t    \"read_readiness\": {\"en\": \"Read readiness\", \"it\": \"Leggi readiness\"},\n235\t    \"read_with_confirmation\": {\"en\": \"Read with confirmation\", \"it\": \"Leggi con conferma\"},\n236\t    \"readiness\": {\"en\": \"Readiness\", \"it\": \"Readiness\"},\n237\t    \"record\": {\"en\": \"Record\", \"it\": \"Registra\"},\n238\t    \"record_dtc_report\": {\"en\": \"Record DTC report\", \"it\": \"Registra rapporto DTC\"},\n239\t    \"record_slvt\": {\"en\": \"Record SLVT\", \"it\": \"Registra SLVT\"},\n240\t    \"record_action\": {\"en\": \"Record action\", \"it\": \"Registra azione\"},\n241\t    \"record_brakes_wheels_tyres\": {\"en\": \"Record brakes/wheels/tyres service\", \"it\": \"Registra intervento freni/ruote/pneumatici\"},\n242\t    \"record_flash_check\": {\"en\": \"Record flash check\", \"it\": \"Registra controllo flash\"},\n243\t    \"record_inspection\": {\"en\": \"Record inspection\", \"it\": \"Registra ispezione\"},\n244\t    \"record_maintenance_visit\": {\"en\": \"Record maintenance visit\", \"it\": \"Registra intervento di manutenzione\"},\n245\t    \"record_oil_change\": {\"en\": \"Record oil change\", \"it\": \"Registra cambio olio\"},\n246\t    \"record_recall_status\": {\"en\": \"Record recall status\", \"it\": \"Registra stato richiamo\"},\n247\t    \"record_routine\": {\"en\": \"Record routine\", \"it\": \"Registra routine\"},\n248\t    \"record_service\": {\"en\": \"Record service\", \"it\": \"Registra intervento\"},\n249\t    \"registry_entry\": {\"en\": \"Registry entry\", \"it\": \"Voce di registro\"},\n250\t    \"release_car\": {\"en\": \"Release car\", \"it\": \"Rilascia la vettura\"},\n251\t    \"reopen\": {\"en\": \"Reopen\", \"it\": \"Riapri\"},\n252\t    \"route\": {\"en\": \"Route\", \"it\": \"Instrada\"},\n253\t    \"run_this_pass\": {\"en\": \"Run this pass\", \"it\": \"Esegui questo passaggio\"},\n254\t    \"save\": {\"en\": \"Save\", \"it\": \"Salva\"},\n255\t    \"save_as\": {\"en\": \"Save as\", \"it\": \"Salva come\"},\n256\t    \"save_calibration\": {\"en\": \"Save calibration\", \"it\": \"Salva calibrazione\"},\n257\t    \"save_inspection\": {\"en\": \"Save inspection\", \"it\": \"Salva ispezione\"},\n258\t    \"save_symptom_report\": {\"en\": \"Save symptom report\", \"it\": \"Salva segnalazione sintomo\"},\n259\t    \"save_tools_review\": {\"en\": \"Save tools review\", \"it\": \"Salva revisione attrezzi\"},\n260\t    \"search\": {\"en\": \"Search\", \"it\": \"Cerca\"},\n261\t    \"send\": {\"en\": \"Send\", \"it\": \"Invia\"},\n262\t    \"skip\": {\"en\": \"Skip\", \"it\": \"Salta\"},\n263\t    \"snapshot\": {\"en\": \"Snapshot\", \"it\": \"Istantanea\"},\n264\t    \"start_coverage_session\": {\"en\": \"Start coverage session\", \"it\": \"Avvia sessione di copertura\"},\n265\t    \"stop\": {\"en\": \"Stop\", \"it\": \"Stop\"},\n266\t    \"take_car_in\": {\"en\": \"Take this car in\", \"it\": \"Accetta la vettura\"},\n267\t    \"take_to_gate\": {\"en\": \"Take it to the gate\", \"it\": \"Portalo alla soglia delle prove\"},\n268\t    \"triggers\": {\"en\": \"Triggers\", \"it\": \"Trigger\"},\n269\t    \"update_preview\": {\"en\": \"Update preview\", \"it\": \"Aggiorna anteprima\"},\n270\t    \"upload\": {\"en\": \"Upload\", \"it\": \"Carica\"},\n271\t    \"vin\": {\"en\": \"VIN\", \"it\": \"VIN\"},\n272\t    \"verify_passive_listen\": {\"en\": \"Verify (passive listen)\", \"it\": \"Verifica (ascolto passivo)\"},\n273\t    \"voltage\": {\"en\": \"Voltage\", \"it\": \"Tensione\"},\n274\t    \"parts\": {\"en\": \"Parts\", \"it\": \"Ricambi\"},\n275\t    \"full_dossier\": {\"en\": \"Full dossier\", \"it\": \"Dossier completo\"},\n276\t    \"mark_done\": {\"en\": \"Mark done\", \"it\": \"Segna fatto\"},\n277\t    \"nothing_open\": {\"en\": \"Nothing open on the checklist.\",\n278\t                     \"it\": \"Nessun elemento aperto nella lista di controllo.\"},\n279\t    \"have_it\": {\"en\": \"have\", \"it\": \"disponibile\"},\n280\t    \"need_it\": {\"en\": \"need\", \"it\": \"da procurare\"},\n281\t\n282\t    # -- common automotive/diagnostic terms (kept here since they recur\n283\t    #    across many of the headings/buttons above and are easy to get\n284\t    #    wrong in Italian if translated ad hoc per page) ------------------\n285\t    \"fault\": {\"en\": \"Fault\", \"it\": \"Guasto\"},\n286\t    \"fault_code\": {\"en\": \"Fault code\", \"it\": \"Codice errore\"},\n287\t    \"symptoms\": {\"en\": \"Symptoms\", \"it\": \"Sintomi\"},\n288\t    \"smoke_test\": {\"en\": \"Smoke test\", \"it\": \"Prova fumo\"},\n289\t    \"purge_valve\": {\"en\": \"Purge valve\", \"it\": \"Valvola di spurgo\"},\n290\t    \"ecm\": {\"en\": \"Engine control module\", \"it\": \"Centralina motore\"},\n291\t    \"wiring_harness\": {\"en\": \"Wiring harness\", \"it\": \"Impianto elettrico\"},\n292\t\n293\t    # -- language chooser (used by pick_language_html below) -------------\n294\t    \"language\": {\"en\": \"Language\", \"it\": \"Lingua\"},\n295\t\n296\t    # -- mechanic-review pass: status strip, tabs, job/intake/release,\n297\t    #    symptom form (see job.html, _flow_bar.html, _vtabs.html,\n298\t    #    _vbar.html, intake.html, release.html, _symptom_form.html) -------\n299\t    \"bench\": {\"en\": \"Bench\", \"it\": \"Banco\"},\n300\t    \"dossier\": {\"en\": \"Dossier\", \"it\": \"Dossier\"},\n301\t    \"systems\": {\"en\": \"Systems\", \"it\": \"Sistemi\"},\n302\t    \"report\": {\"en\": \"Report\", \"it\": \"Rapporto\"},\n303\t    \"timeline\": {\"en\": \"Timeline\", \"it\": \"Cronologia\"},\n304\t    \"media\": {\"en\": \"Media\", \"it\": \"Media\"},\n305\t    \"service\": {\"en\": \"Service\", \"it\": \"Assistenza\"},\n306\t    \"labels\": {\"en\": \"Labels\", \"it\": \"Etichette\"},\n307\t    \"more\": {\"en\": \"More\", \"it\": \"Altro\"},\n308\t    \"more_vehicle_tabs\": {\"en\": \"More vehicle tabs\", \"it\": \"Altre schede veicolo\"},\n309\t    \"more_vehicle_details\": {\"en\": \"More vehicle details\", \"it\": \"Altri dettagli veicolo\"},\n310\t    \"full_vin\": {\"en\": \"Full VIN\", \"it\": \"VIN completo\"},\n311\t    \"km_span\": {\"en\": \"km span\", \"it\": \"intervallo km\"},\n312\t    \"open_codes\": {\"en\": \"Open codes\", \"it\": \"Codici attivi\"},\n313\t    \"odometer_km\": {\"en\": \"Odometer km\", \"it\": \"Contachilometri km\"},\n314\t    \"fuel_at_code_set\": {\"en\": \"Fuel at code set\", \"it\": \"Carburante all'attivazione del codice\"},\n315\t    \"out_of_window\": {\"en\": \"out of window\", \"it\": \"fuori finestra\"},\n316\t    \"in_window\": {\"en\": \"in window\", \"it\": \"in finestra\"},\n317\t    \"next_label\": {\"en\": \"Next\", \"it\": \"Prossimo\"},\n318\t    \"not_yet\": {\"en\": \"Not yet\", \"it\": \"Non ancora\"},\n319\t    \"blocked_label\": {\"en\": \"blocker(s)\", \"it\": \"blocco/i\"},\n320\t\n321\t    \"steps_label\": {\"en\": \"Steps\", \"it\": \"Passaggi\"},\n322\t    \"step_word\": {\"en\": \"Step\", \"it\": \"Passo\"},\n323\t    \"of_word\": {\"en\": \"of\", \"it\": \"di\"},\n324\t    \"show_all_steps\": {\"en\": \"Show all steps\", \"it\": \"Mostra tutti i passaggi\"},\n325\t    \"job_complete\": {\"en\": \"Job complete.\", \"it\": \"Lavoro completato.\"},\n326\t    \"suggested_next\": {\"en\": \"Suggested next\", \"it\": \"Prossimo suggerito\"},\n327\t    \"ready_for_next_car\": {\"en\": \"Ready for the next car.\", \"it\": \"Pronta per la prossima vettura.\"},\n328\t    \"tools_away_start_next\": {\"en\": \"Tools away. Start the next Stelvio\",\n329\t                               \"it\": \"Attrezzi riposti. Avvia la prossima Stelvio\"},\n330\t\n331\t    \"job_lede\": {\"en\": \"The single workspace for this visit: the mechanic's flow, start to \"\n332\t                        \"release, one step per screen. Every section below is the same \"\n333\t                        \"partial used elsewhere in CUORE -- nothing here is a second copy of \"\n334\t                        \"the truth.\",\n335\t                 \"it\": \"Lo spazio di lavoro unico per questa visita: il percorso del \"\n336\t                       \"meccanico, dall'avvio al rilascio, un passaggio per schermata. Ogni \"\n337\t                       \"sezione qui sotto è lo stesso componente usato altrove in CUORE -- \"\n338\t                       \"qui non c'è una seconda copia della verità.\"},\n339\t    \"no_complaint_recorded\": {\"en\": \"(no complaint recorded)\", \"it\": \"(nessun disturbo registrato)\"},\n340\t    \"opened_label\": {\"en\": \"Opened\", \"it\": \"Aperto\"},\n341\t    \"by_label\": {\"en\": \"by\", \"it\": \"da\"},\n342\t    \"closed_label\": {\"en\": \"closed\", \"it\": \"chiuso\"},\n343\t    \"no_visit_open\": {\"en\": \"No visit open for this car yet.\", \"it\": \"Nessuna visita aperta per questa vettura.\"},\n344\t    \"start_intake\": {\"en\": \"Start intake\", \"it\": \"Avvia accettazione\"},\n345\t    \"no_symptom_reports\": {\"en\": \"No driver symptom reports yet.\",\n346\t                            \"it\": \"Nessuna segnalazione sintomo del guidatore.\"},\n347\t    \"symptom_reported\": {\"en\": \"symptom reported\", \"it\": \"sintomo segnalato\"},\n348\t    \"codes_on_file\": {\"en\": \"Codes on file\", \"it\": \"Codici archiviati\"},\n349\t    \"read_car_now\": {\"en\": \"Read the car now\", \"it\": \"Leggi la vettura ora\"},\n350\t    \"codes_explained\": {\"en\": \"Open codes, explained\", \"it\": \"Codici attivi, spiegati\"},\n351\t    \"no_active_codes\": {\"en\": \"No active codes to explain right now.\",\n352\t                         \"it\": \"Nessun codice attivo da spiegare al momento.\"},\n353\t    \"open_work_attachments\": {\"en\": \"Open work & attachments\", \"it\": \"Lavori aperti e allegati\"},\n354\t    \"evidence_for\": {\"en\": \"Evidence for:\", \"it\": \"Prove a favore:\"},\n355\t    \"evidence_against\": {\"en\": \"Evidence against:\", \"it\": \"Prove contrarie:\"},\n356\t    \"none_yet\": {\"en\": \"none yet\", \"it\": \"ancora nessuna\"},\n357\t    \"next_test_colon\": {\"en\": \"Next test:\", \"it\": \"Prossima prova:\"},\n358\t    \"no_hypotheses_yet\": {\"en\": \"No hypotheses on this case yet.\", \"it\": \"Ancora nessuna ipotesi su questo caso.\"},\n359\t    \"suggested_from_tree\": {\"en\": \"Suggested — from this car's own fault tree & bulletins\",\n360\t                             \"it\": \"Suggerite — dall'albero dei guasti e dai bollettini di questa vettura\"},\n361\t    \"suggested_label\": {\"en\": \"suggested\", \"it\": \"suggerita\"},\n362\t    \"hypothesis_label\": {\"en\": \"Hypothesis\", \"it\": \"Ipotesi\"},\n363\t    \"system_label\": {\"en\": \"System\", \"it\": \"Sistema\"},\n364\t    \"system_placeholder\": {\"en\": \"e.g. EVAP\", \"it\": \"es. EVAP\"},\n365\t    \"next_test_label\": {\"en\": \"Next test\", \"it\": \"Prossima prova\"},\n366\t    \"last_stelvio_codes\": {\"en\": \"Last Stelvio with these codes\", \"it\": \"Ultima Stelvio con questi codici\"},\n367\t    \"path_label\": {\"en\": \"Path\", \"it\": \"Percorso\"},\n368\t    \"tools_label\": {\"en\": \"Tools:\", \"it\": \"Attrezzi:\"},\n369\t    \"pitfalls\": {\"en\": \"Pitfalls\", \"it\": \"Insidie\"},\n370\t    \"status_open\": {\"en\": \"open\", \"it\": \"aperta\"},\n371\t    \"status_supported\": {\"en\": \"supported\", \"it\": \"supportata\"},\n372\t    \"status_refuted\": {\"en\": \"refuted\", \"it\": \"respinta\"},\n373\t    \"status_confirmed\": {\"en\": \"confirmed\", \"it\": \"confermata\"},\n374\t    \"kind_test\": {\"en\": \"test\", \"it\": \"prova\"},\n375\t    \"kind_inspection\": {\"en\": \"inspection\", \"it\": \"ispezione\"},\n376\t    \"kind_repair\": {\"en\": \"repair\", \"it\": \"riparazione\"},\n377\t    \"kind_part\": {\"en\": \"part\", \"it\": \"ricambio\"},\n378\t    \"kind_clear\": {\"en\": \"clear\", \"it\": \"azzera\"},\n379\t    \"kind_note\": {\"en\": \"note\", \"it\": \"nota\"},\n380\t    \"what_was_done\": {\"en\": \"what was done\", \"it\": \"cosa è stato fatto\"},\n381\t    \"record_an_action\": {\"en\": \"Record an action\", \"it\": \"Registra un'azione\"},\n382\t    \"no_actions_recorded\": {\"en\": \"No actions recorded yet.\", \"it\": \"Nessuna azione registrata ancora.\"},\n383\t    \"readiness_read_at\": {\"en\": \"Readiness read at:\", \"it\": \"Readiness letta il:\"},\n384\t    \"not_yet_read\": {\"en\": \"not yet read\", \"it\": \"non ancora letta\"},\n385\t    \"codes_returned_colon\": {\"en\": \"Codes returned:\", \"it\": \"Codici ritornati:\"},\n386\t    \"none_word\": {\"en\": \"none\", \"it\": \"nessuno\"},\n387\t    \"handover_report_pdf\": {\"en\": \"Handover report (PDF)\", \"it\": \"Rapporto di consegna (PDF)\"},\n388\t    \"open_count_suffix\": {\"en\": \"open\", \"it\": \"aperti\"},\n389\t    \"not_closed\": {\"en\": \"Not closed\", \"it\": \"Non chiuso\"},\n390\t    \"saved\": {\"en\": \"saved\", \"it\": \"salvato\"},\n391\t    \"required_before_closing\": {\"en\": \"required before closing\", \"it\": \"richiesto prima della chiusura\"},\n392\t    \"tools_review_hint\": {\"en\": \"Tick what you actually used, mark it right/wrong/unsure with a \"\n393\t                                 \"reason, note anything missing, and what you'd buy next time. \"\n394\t                                 \"This is what the next identical job on this car -- or any \"\n395\t                                 \"Stelvio -- sees first.\",\n396\t                           \"it\": \"Seleziona ciò che hai davvero usato, segna giusto/sbagliato/incerto \"\n397\t                                 \"con un motivo, annota cosa manca e cosa compreresti la prossima \"\n398\t                                 \"volta. Questo è ciò che il prossimo lavoro identico su questa \"\n399\t                                 \"vettura -- o su qualsiasi Stelvio -- vede per primo.\"},\n400\t    \"other_tools_used\": {\"en\": \"Other tools used (not in the list above)\",\n401\t                          \"it\": \"Altri attrezzi utilizzati (non nell'elenco sopra)\"},\n402\t    \"tool_name_placeholder\": {\"en\": \"tool name\", \"it\": \"nome attrezzo\"},\n403\t    \"note_why_placeholder\": {\"en\": \"note (why right/wrong)\", \"it\": \"nota (perché giusto/sbagliato)\"},\n404\t    \"yes_word\": {\"en\": \"yes\", \"it\": \"sì\"},\n405\t    \"no_word\": {\"en\": \"no\", \"it\": \"no\"},\n406\t    \"unsure_word\": {\"en\": \"unsure\", \"it\": \"incerto\"},\n407\t    \"missing_tools\": {\"en\": \"Missing tools (comma separated)\", \"it\": \"Attrezzi mancanti (separati da virgola)\"},\n408\t    \"would_buy_next_time\": {\"en\": \"Would buy next time\", \"it\": \"Da acquistare la prossima volta\"},\n409\t    \"tool_to_buy_placeholder\": {\"en\": \"tool to buy\", \"it\": \"attrezzo da acquistare\"},\n410\t    \"why_placeholder\": {\"en\": \"why\", \"it\": \"perché\"},\n411\t    \"minutes_spent\": {\"en\": \"Minutes spent\", \"it\": \"Minuti impiegati\"},\n412\t    \"by_initials_label\": {\"en\": \"By\", \"it\": \"Da\"},\n413\t    \"name_initials_placeholder\": {\"en\": \"name/initials\", \"it\": \"nome/iniziali\"},\n414\t    \"outcome_label\": {\"en\": \"Outcome\", \"it\": \"Esito\"},\n415\t    \"choose_placeholder\": {\"en\": \"(choose)\", \"it\": \"(scegli)\"},\n416\t    \"outcome_fixed\": {\"en\": \"fixed\", \"it\": \"risolto\"},\n417\t    \"outcome_not_fixed\": {\"en\": \"not_fixed\", \"it\": \"non risolto\"},\n418\t    \"outcome_deferred\": {\"en\": \"deferred\", \"it\": \"rinviato\"},\n419\t    \"codes_returned_field\": {\"en\": \"Codes returned (comma separated, if any)\",\n420\t                              \"it\": \"Codici ritornati (separati da virgola, se presenti)\"},\n421\t    \"verdict_closing_note\": {\"en\": \"Verdict / closing note\", \"it\": \"Verdetto / nota di chiusura\"},\n422\t    \"skip_tools_review_reason\": {\"en\": \"Skip tools review -- reason (required if not saved above)\",\n423\t                                  \"it\": \"Salta la revisione attrezzi -- motivo (richiesto se non salvata sopra)\"},\n424\t\n425\t    \"start_this_stelvio\": {\"en\": \"Start this Stelvio\", \"it\": \"Avvia questa Stelvio\"},\n426\t    \"not_started\": {\"en\": \"Not started\", \"it\": \"Non avviata\"},\n427\t    \"intake_lede\": {\"en\": \"One car, start to finish. Pick a VIN already in the corpus, or \"\n428\t                           \"type a new one, and this opens the visit and its case together \"\n429\t                           \"-- then drops straight into the job page to start the diagnostic \"\n430\t                           \"work.\",\n431\t                     \"it\": \"Una vettura, dall'inizio alla fine. Scegli un VIN già nel corpus, \"\n432\t                           \"o digitane uno nuovo, e questo apre la visita e il caso insieme \"\n433\t                           \"-- per poi passare direttamente alla pagina del lavoro e iniziare \"\n434\t                           \"la diagnosi.\"},\n435\t    \"vin_placeholder\": {\"en\": \"17-character VIN\", \"it\": \"VIN a 17 caratteri\"},\n436\t    \"complaint_label\": {\"en\": \"Complaint — the driver's own words\", \"it\": \"Disturbo — nelle parole del guidatore\"},\n437\t    \"technician_label\": {\"en\": \"Technician\", \"it\": \"Tecnico\"},\n438\t\n439\t    \"release_lede\": {\"en\": \"Advisory, not a gate — each item below with its evidence. \"\n440\t                            \"Release with one tap whenever the car is ready; if \"\n441\t                            \"verification isn't in yet, say why and it's recorded as \"\n442\t                            \"released unverified.\",\n443\t                      \"it\": \"Consultivo, non un blocco — ogni voce qui sotto con la sua \"\n444\t                            \"prova. Rilascia con un tocco quando la vettura è pronta; se la \"\n445\t                            \"verifica non è ancora arrivata, indica il motivo e verrà \"\n446\t                            \"registrata come rilasciata non verificata.\"},\n447\t    \"visit_label\": {\"en\": \"Visit\", \"it\": \"Visita\"},\n448\t    \"in_label\": {\"en\": \"In\", \"it\": \"Entrata\"},\n449\t    \"bay_label\": {\"en\": \"bay\", \"it\": \"baia\"},\n450\t    \"out_label\": {\"en\": \"out\", \"it\": \"uscita\"},\n451\t    \"verification\": {\"en\": \"Verification\", \"it\": \"Verifica\"},\n452\t    \"no_data_chip\": {\"en\": \"no data\", \"it\": \"nessun dato\"},\n453\t    \"no_dossier_verdict\": {\"en\": \"No dossier verdict available for this vehicle yet.\",\n454\t                            \"it\": \"Nessun verdetto dossier disponibile per questa vettura.\"},\n455\t    \"not_verified_note\": {\"en\": \"Not verified — releasing now records this car as released unverified.\",\n456\t                           \"it\": \"Non verificata — il rilascio ora registra questa vettura come rilasciata non verificata.\"},\n457\t    \"not_released\": {\"en\": \"Not released\", \"it\": \"Non rilasciata\"},\n458\t    \"report_printed\": {\"en\": \"Report printed\", \"it\": \"Rapporto stampato\"},\n459\t    \"print_labels_link\": {\"en\": \"Print labels\", \"it\": \"Stampa etichette\"},\n460\t    \"parts_logged\": {\"en\": \"Parts logged\", \"it\": \"Ricambi registrati\"},\n461\t    \"tools_reviewed\": {\"en\": \"Tools reviewed\", \"it\": \"Attrezzi revisionati\"},\n462\t    \"not_reviewed\": {\"en\": \"not reviewed\", \"it\": \"non revisionato\"},\n463\t    \"released_unverified\": {\"en\": \"Released unverified\", \"it\": \"Rilasciata non verificata\"},\n464\t    \"reason_colon\": {\"en\": \"Reason:\", \"it\": \"Motivo:\"},\n465\t    \"released_on\": {\"en\": \"Released\", \"it\": \"Rilasciata il\"},\n466\t    \"notes_label\": {\"en\": \"Notes\", \"it\": \"Note\"},\n467\t    \"reason_release_early\": {\"en\": \"Reason (if releasing before verification)\",\n468\t                              \"it\": \"Motivo (se rilasciata prima della verifica)\"},\n469\t    \"why_release_now_placeholder\": {\"en\": \"why release now\", \"it\": \"perché rilasciare ora\"},\n470\t    \"tools_away_h3\": {\"en\": \"Tools away\", \"it\": \"Attrezzi riposti\"},\n471\t    \"tools_away_advisory\": {\"en\": \"Advisory only — recording this never blocks moving on to the next car.\",\n472\t                             \"it\": \"Solo informativo — registrarlo non blocca mai il passaggio alla vettura successiva.\"},\n473\t    \"no_tool_review\": {\"en\": \"No tool-usage review on file for this car yet.\",\n474\t                        \"it\": \"Nessuna revisione d'uso attrezzi registrata per questa vettura.\"},\n475\t    \"put_away_suffix\": {\"en\": \"— put away\", \"it\": \"— riposto\"},\n476\t    \"location_placeholder\": {\"en\": \"location (optional)\", \"it\": \"posizione (opzionale)\"},\n477\t    \"available_opt\": {\"en\": \"available\", \"it\": \"disponibile\"},\n478\t    \"damaged_opt\": {\"en\": \"damaged\", \"it\": \"danneggiato\"},\n479\t    \"missing_opt\": {\"en\": \"missing\", \"it\": \"mancante\"},\n480\t    \"empty_opt\": {\"en\": \"empty\", \"it\": \"vuoto\"},\n481\t    \"loaned_opt\": {\"en\": \"loaned\", \"it\": \"prestato\"},\n482\t    \"restock_label\": {\"en\": \"Restock (consumables used up)\", \"it\": \"Riapprovvigionamento (consumabili esauriti)\"},\n483\t    \"restock_placeholder\": {\"en\": \"e.g. 2x EVAP smoke solution\", \"it\": \"es. 2x soluzione fumo EVAP\"},\n484\t\n485\t    \"symptom_q\": {\"en\": \"What did the driver feel?\", \"it\": \"Cosa ha percepito il guidatore?\"},\n486\t    \"conditions_label\": {\"en\": \"Conditions\", \"it\": \"Condizioni\"},\n487\t    \"reporter_label\": {\"en\": \"Reporter\", \"it\": \"Segnalatore\"},\n488\t    \"driver_opt\": {\"en\": \"Driver\", \"it\": \"Guidatore\"},\n489\t    \"mechanic_opt\": {\"en\": \"Mechanic\", \"it\": \"Meccanico\"},\n490\t    \"when_label\": {\"en\": \"When\", \"it\": \"Quando\"},\n491\t    \"odometer_optional\": {\"en\": \"Odometer (km, optional)\", \"it\": \"Contachilometri (km, opzionale)\"},\n492\t    \"edit_hint\": {\"en\": \"tap to edit\", \"it\": \"tocca per modificare\"},\n493\t    \"notes_optional\": {\"en\": \"Notes (optional)\", \"it\": \"Note (opzionale)\"},\n494\t    \"symptom_text_placeholder\": {\"en\": \"e.g. smelled fuel right after filling up, gone by the next morning\",\n495\t                                  \"it\": \"es. odore di carburante subito dopo il rifornimento, sparito entro il mattino dopo\"},\n496\t    \"recorded_label\": {\"en\": \"Recorded\", \"it\": \"Registrato\"},\n497\t    \"symptom_saved\": {\"en\": \"Symptom report saved.\", \"it\": \"Segnalazione sintomo salvata.\"},\n498\t    \"not_recorded_label\": {\"en\": \"Not recorded\", \"it\": \"Non registrato\"},\n499\t\n500\t    # per-tag labels for the symptom-report <select> (replaces the plain\n501\t    # key|replace(\"_\",\" \") humanisation with a real translation; \"Drives\n502\t    # normally\" itself stays a literal string in the template, not routed\n503\t    # through t(), so it reads identically regardless of language -- an\n504\t    # existing test (check_timeline_page.py) asserts that exact English\n505\t    # text with no language cookie set).\n506\t    \"symptom_mil_on\": {\"en\": \"MIL on\", \"it\": \"Spia MIL accesa\"},\n507\t    \"symptom_fuel_smell\": {\"en\": \"fuel smell\", \"it\": \"odore di carburante\"},\n508\t    \"symptom_hard_start\": {\"en\": \"hard start\", \"it\": \"avviamento difficile\"},\n509\t    \"symptom_rough_idle\": {\"en\": \"rough idle\", \"it\": \"minimo instabile\"},\n510\t    \"symptom_hesitation\": {\"en\": \"hesitation\", \"it\": \"esitazione\"},\n511\t    \"symptom_loss_of_power\": {\"en\": \"loss of power\", \"it\": \"perdita di potenza\"},\n512\t    \"symptom_hard_to_refuel\": {\"en\": \"hard to refuel\", \"it\": \"difficoltà di rifornimento\"},\n513\t    \"symptom_noise\": {\"en\": \"noise\", \"it\": \"rumore\"},\n514\t    \"symptom_vibration\": {\"en\": \"vibration\", \"it\": \"vibrazione\"},\n515\t    \"symptom_warning_message\": {\"en\": \"warning message\", \"it\": \"messaggio di avviso\"},\n516\t    \"symptom_other\": {\"en\": \"other\", \"it\": \"altro\"},\n517\t    \"cond_cold_start\": {\"en\": \"cold start\", \"it\": \"partenza a freddo\"},\n518\t    \"cond_hot\": {\"en\": \"hot\", \"it\": \"a caldo\"},\n519\t    \"cond_just_refuelled\": {\"en\": \"just refuelled\", \"it\": \"appena rifornita\"},\n520\t    \"cond_highway\": {\"en\": \"highway\", \"it\": \"autostrada\"},\n521\t    \"cond_city\": {\"en\": \"city\", \"it\": \"città\"},\n522\t    \"cond_idle\": {\"en\": \"idle\", \"it\": \"al minimo\"},\n523\t    \"cond_rain\": {\"en\": \"rain\", \"it\": \"pioggia\"},\n524\t}\n525\t\n526\t\n527\tdef t(key: str, lang: str = DEFAULT_LANG) -> str:\n528\t    \"\"\"Return the English text for ``key`` (or the bare key if ``key``\n529\t    isn't in STRINGS at all -- never raises, a missing translation must\n530\t    degrade, not break the page).\n531\t\n532\t    The language chooser has been removed (it did not work), so ``lang``\n533\t    -- whatever a caller or a leftover cookie passes -- is ignored; this\n534\t    always resolves to :data:`_FALLBACK_LANG` (\"en\"). The ``it`` entries\n535\t    in STRINGS are kept in place, unused, in case a working chooser comes\n536\t    back later.\"\"\"\n537\t    entry = STRINGS.get(key)\n538\t    if not entry:\n539\t        return key\n540\t    return entry.get(_FALLBACK_LANG, key)\n541\t\n542\t\n543\tdef lang_from_cookie(cookie_value: Optional[str]) -> str:\n544\t    \"\"\"Always returns :data:`DEFAULT_LANG` (\"en\") -- the ``lang`` cookie is\n545\t    no longer read now that the language chooser is gone. Kept (rather than\n546\t    removed) because it's still called from this module's own request-context\n547\t    plumbing below.\"\"\"\n548\t    return DEFAULT_LANG\n549\t\n550\t\n551\tdef set_lang_cookie(response: Any, lang: str) -> Any:\n552\t    \"\"\"Router-free helper for the integration pass: set the ``lang``\n553\t    cookie on a (FastAPI/Starlette-shaped) ``response``. Degrades to a\n554\t    no-op rather than raising if ``response`` doesn't support\n555\t    ``set_cookie`` -- callers should still get their response object back\n556\t    either way.\"\"\"\n557\t    use_lang = lang if lang in SUPPORTED_LANGS else DEFAULT_LANG\n558\t    try:\n559\t        response.set_cookie(\"lang\", use_lang, max_age=60 * 60 * 24 * 365,\n560\t                             samesite=\"lax\")\n561\t    except Exception:  # noqa: BLE001 -- must never break the response\n562\t        pass\n563\t    return response\n564\t\n565\t\n566\tdef pick_language_html(current: str) -> Any:\n567\t    \"\"\"A tiny, dependency-free Italiano/English chooser: two 44px-tall\n568\t    buttons (comfortable touch targets for a shop floor), the current\n569\t    language marked with ``aria-pressed``/a ``lang-btn-active`` class. The\n570\t    integration pass drops this in the header and on first visit, and\n571\t    wires its buttons' ``data-lang`` to a small script that POSTs/redirects\n572\t    to whatever route calls :func:`set_lang_cookie`.\n573\t    \"\"\"\n574\t    cur = current if current in SUPPORTED_LANGS else DEFAULT_LANG\n575\t    buttons = ((\"it\", \"Italiano\"), (\"en\", \"English\"))\n576\t\n577\t    def _btn(code: str, label: str) -> str:\n578\t        active = cur == code\n579\t        cls = \"lang-btn lang-btn-active\" if active else \"lang-btn\"\n580\t        return (\n581\t            f'<button type=\"button\" class=\"{cls}\" data-lang=\"{code}\" '\n582\t            f'aria-pressed=\"{\"true\" if active else \"false\"}\" '\n583\t            f'style=\"height:44px;min-width:44px;\">{escape(label)}</button>'\n584\t        )\n585\t\n586\t    html = (\n587\t        '<span class=\"lang-picker\" role=\"group\" aria-label=\"Italiano / English\">'\n588\t        + \"\".join(_btn(code, label) for code, label in buttons)\n589\t        + \"</span>\"\n590\t    )\n591\t    return Markup(html)\n592\t\n593\t\n594\t@pass_context\n595\tdef _t_global(ctx: Any, key: str, lang: Optional[str] = None) -> str:\n596\t    if lang is None:\n597\t        lang = _ctx_lang(ctx)\n598\t    return t(key, lang)\n599\t\n600\t\n601\t@pass_context\n602\tdef _lang_global(ctx: Any) -> str:\n603\t    return _ctx_lang(ctx)\n604\t\n605\t\n606\tdef _ctx_lang(ctx: Any) -> str:\n607\t    try:\n608\t        request = ctx.get(\"request\")\n609\t        cookie = request.cookies.get(\"lang\") if request is not None else None\n610\t    except Exception:  # noqa: BLE001 -- template globals must never raise\n611\t        cookie = None\n612\t    return lang_from_cookie(cookie)\n613\t\n614\t\n615\tdef _register(templates: Any) -> None:\n616\t    templates.env.globals[\"t\"] = _t_global\n617\t    templates.env.globals[\"lang\"] = _lang_global\n618\t\n619\t\n620\tfor _module_name in (\n621\t    \"routes\", \"service_routes\", \"media_routes\", \"labels_routes\", \"bench_routes\",\n622\t    \"timeline_routes\", \"drivetrain_routes\", \"jobs_routes\", \"shop_routes\",\n623\t    \"electrical_routes\", \"systems_routes\", \"modules_routes\", \"inbox_routes\",\n624\t    \"report_routes\", \"tools_routes\", \"parts_routes\",\n625\t):\n626\t    try:\n627\t        _mod = importlib.import_module(f\".{_module_name}\", __package__)\n628\t        _tmpl = getattr(_mod, \"templates\", None) or getattr(_mod, \"_shared_templates\", None)\n629\t        if _tmpl is not None:\n630\t            _register(_tmpl)\n631\t    except Exception:  # noqa: BLE001 -- import-time side effect, must never raise\n632\t        pass\n633\t\n634\t\n635\t__all__ = [\n636\t    \"SUPPORTED_LANGS\", \"DEFAULT_LANG\", \"STRINGS\",\n637\t    \"t\", \"lang_from_cookie\", \"set_lang_cookie\", \"pick_language_html\",\n638\t]\n639\t"}]},"uuid":"8876161d-e1fe-4d33-b156-45d70d80a1ce","timestamp":"2026-10-08T17:38:31.516Z","toolUseResult":{"type":"text","file":{"filePath":"C:\\Users\\User\\mcp-servers\\cuore\\web\\i18n.py","content":"\"\"\"UI string dictionary + the ``t`` / ``lang`` Jinja globals.\n\nCUORE's mechanics mostly don't read English as a first language (see\n``cuore/web/icons.py`` for the pictogram half of the same mitigation), so\nevery page-chrome label collected here (headings and button text, grepped\nfrom ``<h1>``-``<h3>`` and ``.btn`` across ``cuore/web/templates/*.html``)\ngets a translation, not just English. DTC codes, part numbers and VINs are\nnever put in here -- those are data, not UI chrome, and stay as-is wherever\na template renders them directly.\n\nLanguage model\n---------------\n``SUPPORTED_LANGS`` is the set actually filled in below (Italian, English\ntoday); the dict shape -- one ``{lang: text}`` map per key -- is already\nright for French/German/Spanish to be added later by just adding another\nkey to each entry and that language's code to ``SUPPORTED_LANGS``, with no\nchange to ``t()`` or the templates that call it.\n\n``DEFAULT_LANG`` is ``\"it\"``: most of this shop's mechanics default to\nItalian, and an unset or unrecognised ``lang`` cookie should not silently\nmean English. ``t(key, lang)`` looks up the requested language first and\nonly falls back to English (never to Italian, and never to ``DEFAULT_LANG``\nif that differs from the requested language) when that specific key has no\ntranslation for it -- a half-translated page beats a page that 500s or\nshows raw keys.\n\nRegistered as the Jinja globals ``t`` and ``lang`` on the same four\ntemplate environments ``experience_globals`` / ``icons`` register against\n(see those modules' docstrings for why four). Both are context-aware\n(``jinja2.pass_context``) so they read the ``lang`` cookie straight off the\ncurrent request rather than needing every route to pass it through\nexplicitly -- FastAPI's ``Jinja2Templates`` already puts ``request`` in\nevery template's context, which is what makes that possible. Importing this\nmodule is the side effect that does the registration; wiring it in is the\nsame one-line ``from ..web import i18n  # noqa: F401`` move the other\n``*_globals`` modules use -- left for the integration pass.\n\n``set_lang_cookie(response, lang)`` and ``pick_language_html(current)`` are\nplain, router-free helpers (no FastAPI import here) for that same\nintegration pass: the first sets the cookie on a response, the second\nrenders a 44px-tall Italiano/English chooser to drop in the header and on\nfirst visit.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport importlib\nfrom html import escape\nfrom typing import Any, Optional\n\ntry:  # pragma: no cover -- ships with Jinja2; keep the import optional anyway\n    from jinja2 import pass_context\nexcept Exception:  # noqa: BLE001 -- must not stop this module from loading\n    def pass_context(f):  # type: ignore[no-redef]\n        return f\n\ntry:  # pragma: no cover -- ships with Jinja2\n    from markupsafe import Markup\nexcept Exception:  # noqa: BLE001\n    def Markup(s: str) -> str:  # type: ignore[no-redef]\n        return s\n\n\n#: Languages this module actually has translations for. Order matters only\n#: for ``pick_language_html``'s button order. Extending to French/German/\n#: Spanish later is: add \"fr\"/\"de\"/\"es\" here and fill that key in STRINGS --\n#: nothing else changes.\nSUPPORTED_LANGS: tuple[str, ...] = (\"it\", \"en\")\n\n#: The Italian language chooser has been removed from the UI (it did not\n#: work); the app now always renders English regardless of any ``lang``\n#: cookie. ``DEFAULT_LANG`` stays \"en\" rather than being deleted so the\n#: rest of this module (and the still-present Italian strings below, kept\n#: but unused) needs no further rewiring if a working chooser comes back.\nDEFAULT_LANG = \"en\"\n\n#: English is the one language every key is guaranteed to have, so it is\n#: ``t()``'s fallback when the requested language's translation is missing\n#: for that specific key (not when the *cookie* is merely unset -- that\n#: case uses DEFAULT_LANG before t() is ever called, via lang_from_cookie).\n_FALLBACK_LANG = \"en\"\n\nSTRINGS: dict[str, dict[str, str]] = {\n    # -- the 12 flow-step headings ------------------------------------\n    \"start\": {\"en\": \"Start\", \"it\": \"Avvio\"},\n    \"complaint_symptoms\": {\"en\": \"Complaint & symptoms\", \"it\": \"Disturbo e sintomi\"},\n    \"verdict\": {\"en\": \"Verdict\", \"it\": \"Verdetto\"},\n    \"scan_codes\": {\"en\": \"Scan & codes\", \"it\": \"Scansione e codici\"},\n    \"understand_fault\": {\"en\": \"Understand the fault\", \"it\": \"Comprendere il guasto\"},\n    \"tests_inspections\": {\"en\": \"Tests & inspections\", \"it\": \"Prove e controlli\"},\n    \"hypotheses\": {\"en\": \"Hypotheses\", \"it\": \"Ipotesi\"},\n    \"plan_repair\": {\"en\": \"Plan the repair\", \"it\": \"Pianificare la riparazione\"},\n    \"repair\": {\"en\": \"Repair\", \"it\": \"Riparazione\"},\n    \"verify\": {\"en\": \"Verify\", \"it\": \"Verifica\"},\n    \"document\": {\"en\": \"Document\", \"it\": \"Documentare\"},\n    \"release\": {\"en\": \"Release\", \"it\": \"Rilascio\"},\n\n    # -- base chrome ------------------------------------------------------\n    \"home\": {\"en\": \"Home\", \"it\": \"Home\"},\n    \"menu\": {\"en\": \"Menu\", \"it\": \"Menu\"},\n    \"toggle_theme\": {\"en\": \"Toggle dark/light theme\", \"it\": \"Cambia tema chiaro/scuro\"},\n    \"print_page\": {\"en\": \"Print this page\", \"it\": \"Stampa questa pagina\"},\n    \"vehicles\": {\"en\": \"Vehicles\", \"it\": \"Veicoli\"},\n    \"modules\": {\"en\": \"Modules\", \"it\": \"Moduli\"},\n    \"recordings\": {\"en\": \"Recordings\", \"it\": \"Registrazioni\"},\n    \"logs\": {\"en\": \"Logs\", \"it\": \"Log\"},\n    \"live_link\": {\"en\": \"Live link\", \"it\": \"Collegamento live\"},\n    \"coverage\": {\"en\": \"Coverage\", \"it\": \"Copertura\"},\n    \"tools\": {\"en\": \"Tools\", \"it\": \"Attrezzi\"},\n\n    # -- headings ----------------------------------------------------------\n    \"adaptation_relearn\": {\"en\": \"Adaptation relearn\", \"it\": \"Riapprendimento adattivo\"},\n    \"adapter\": {\"en\": \"Adapter\", \"it\": \"Adattatore\"},\n    \"add_hypothesis\": {\"en\": \"Add a hypothesis\", \"it\": \"Aggiungi un'ipotesi\"},\n    \"add_note\": {\"en\": \"Add a note\", \"it\": \"Aggiungi una nota\"},\n    \"add_media\": {\"en\": \"Add photos, video, sounds or documents\", \"it\": \"Aggiungi foto, video, audio o documenti\"},\n    \"alarms_markers\": {\"en\": \"Alarms & markers\", \"it\": \"Allarmi e segnalatori\"},\n    \"already_attempted\": {\"en\": \"Already attempted\", \"it\": \"Già tentato\"},\n    \"blind_spots\": {\"en\": \"Blind spots\", \"it\": \"Punti ciechi\"},\n    \"brake_tyre_spec\": {\"en\": \"Brake / tyre specification\", \"it\": \"Specifiche freni / pneumatici\"},\n    \"brakes_wheels_tyres\": {\"en\": \"Brakes, wheels & tyres\", \"it\": \"Freni, ruote e pneumatici\"},\n    \"bulletins\": {\"en\": \"Bulletins\", \"it\": \"Bollettini\"},\n    \"buses\": {\"en\": \"Buses\", \"it\": \"Bus dati\"},\n    \"by_family\": {\"en\": \"By family\", \"it\": \"Per famiglia\"},\n    \"cable\": {\"en\": \"Cable\", \"it\": \"Cavo\"},\n    \"calibrate\": {\"en\": \"Calibrate\", \"it\": \"Calibrare\"},\n    \"carried_forward\": {\"en\": \"Carried forward from last time\", \"it\": \"Riportato dalla volta precedente\"},\n    \"checks\": {\"en\": \"Checks\", \"it\": \"Controlli\"},\n    \"choose_job\": {\"en\": \"Choose a job\", \"it\": \"Scegli un lavoro\"},\n    \"choose_job_category\": {\"en\": \"Choose a job category\", \"it\": \"Scegli una categoria di lavoro\"},\n    \"choose_items_visit\": {\"en\": \"Choose items for this visit\", \"it\": \"Scegli gli elementi per questa visita\"},\n    \"co_occurrence\": {\"en\": \"Co-occurrence\", \"it\": \"Co-occorrenza\"},\n    \"code_timeline\": {\"en\": \"Code timeline\", \"it\": \"Cronologia dei codici\"},\n    \"codes\": {\"en\": \"Codes\", \"it\": \"Codici\"},\n    \"codes_vs_driver\": {\"en\": \"Codes vs. what the driver notices\", \"it\": \"Codici rispetto a ciò che nota il guidatore\"},\n    \"columns\": {\"en\": \"Columns\", \"it\": \"Colonne\"},\n    \"considerations_next\": {\"en\": \"Considerations for next time\", \"it\": \"Considerazioni per la prossima volta\"},\n    \"corners\": {\"en\": \"Corners\", \"it\": \"Angoli (ruote)\"},\n    \"corpus\": {\"en\": \"Corpus\", \"it\": \"Corpus\"},\n    \"current_picture\": {\"en\": \"Current picture\", \"it\": \"Quadro attuale\"},\n    \"custom_sheet_dims\": {\"en\": \"Custom sheet dimensions (mm)\", \"it\": \"Dimensioni foglio personalizzate (mm)\"},\n    \"dtc_report\": {\"en\": \"DTC report\", \"it\": \"Rapporto DTC\"},\n    \"dtcs_0x1902\": {\"en\": \"DTCs (0x19 02)\", \"it\": \"DTC (0x19 02)\"},\n    \"dtcs_by_module\": {\"en\": \"DTCs by module\", \"it\": \"DTC per modulo\"},\n    \"dashboard\": {\"en\": \"Da