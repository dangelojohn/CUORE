# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtualenv - recreate with requirements.txt, do not commit
.venv/
venv/
env/

# Backups produced during development
*.bak
*.orig

# Local secrets and machine-specific config. Never commit tokens.
.env
.env.*
!.env.example
secrets.json
*.token

# Captured vehicle data may contain a customer VIN. Kept out of the repo by
# default; commit deliberately under data/ if a case needs to be shared.
scratch/
*.log

# OS noise
Thumbs.db
desktop.ini
.DS_Store

# --- Public-repo safety (the GitHub remote is PUBLIC) ---------------------
# Session transcripts / agent output hold credentials (NAS admin password) and
# personal e-mail addresses. Never commit them. (Files already committed stay
# tracked until removed from history by the owner.)
docs/sessions/raw/
**/transcript/
*.jsonl.gz
docs/sessions/archive-errors.log
# Parts catalogue (data, diagram art, part numbers) lives in C:\ProgramData\cuore only
parts_catalog/
**/parts_catalog/**/catalog.json
**/parts_catalog/**/img/
stelvio-*-catalogue.json
stelvio-*-diagram-rows.json
# Claude Code per-machine state
.claude/projects/
.claude/settings.local.json
# Credentials
*.cred
.cred
*.pem
*.pfx
id_rsa*

# Release builds (installer/build-release.ps1)
dist/

# Demo-only brand mark, rights not yet in writing
cuore/web/static/brand/ferrari-horse.svg
